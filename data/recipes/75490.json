  "ingredients": [
    "1 (16 ounce) package uncooked linguini pasta",
    "2 tablespoons olive oil",
    "1 teaspoon chili oil",
    "1.5 pounds medium shrimp, peeled and deveined",
    "1 pound sugar snap pea pods",
    "2 large cloves garlic, minced",
    "1.5 cups dry white wine",
    "0.33333334326744 cup chopped fresh basil",
    "1 tablespoon unsalted butter",
    "1 tablespoon fresh lemon juice"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, 8 to 10 minutes. Drain, reserving ¼ cup pasta water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat olive oil and chili oil in a wok over medium-high heat. Add shrimp, sugar snap peas, and garlic; cook and stir until shrimp are mostly opaque, about 2 minutes. Transfer shrimp mixture to a plate; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add wine to the wok; bring to a boil. Cook until reduced by ⅓. Return shrimp mixture to the wok; stir in reserved pasta water. Cook and stir until shrimp are opaque.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, stir in basil, butter, and lemon juice, then toss in linguine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
