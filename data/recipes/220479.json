  "ingredients": [
    "1 (12 ounce) package frozen shelled edamame (green soybeans)",
    "2 cloves garlic",
    "0.5 cup tahini",
    "0.5 cup water",
    "0.5 cup packed cilantro leaves",
    "0.25 cup lemon juice",
    "3 tablespoons extra-virgin olive oil",
    "1 teaspoon kosher salt",
    "0.75 teaspoon ground cumin",
    "0.125 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Place edamame into a large pot and cover with salted water. Bring to a simmer over medium-low heat and cook until tender, about 5 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée garlic in a food processor until minced. Add drained edamame, tahini, water, cilantro, lemon juice, olive oil, kosher salt, cumin, and cayenne pepper; blend until smooth.",
      "section": null,
