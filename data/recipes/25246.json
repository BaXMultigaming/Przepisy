  "ingredients": [
    "1 tablespoon olive oil",
    "1 tablespoon sesame seeds",
    "1 pound fresh green beans, cut into 2 inch pieces",
    "0.25 cup chicken broth",
    "0.25 teaspoon salt",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
