  "ingredients": [
    "2 tablespoons Vegetable oil",
    "2 large baking potatoes, cut into 1/2-inch thick slices",
    "salt and ground black pepper to taste",
    "0.5 pound ground beef",
    "1 (15 ounce) can black beans, drained",
    "2 tablespoons taco seasoning",
    "2 tablespoons water",
    "8 ounces shredded Cheddar cheese, divided",
    "0.25 cup shredded lettuce",
    "1 small tomato, chopped",
    "0.25 cup sour cream",
    "0.25 cup guacamole"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 2 tablespoons vegetable oil to a large bowl. Add potato slices to the bowl; toss to coat in oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange potato slices in a single layer on a baking sheet; sprinkle with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potato slices are golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat remaining 1 tablespoon vegetable oil in a skillet over medium heat; add ground beef. Brown, breaking into crumbles as it cooks, 8 to 10 minutes. Drain excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir black beans into ground beef, then stir in taco seasoning and water. Bring beef-bean mixture to a boil, then reduce heat to medium-low. Simmer until flavors have blended, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange potato slices on a serving platter; sprinkle with 1/2 Cheddar cheese. Top with meat-bean mixture; sprinkle with remaining 1/2 cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread lettuce over nachos; garnish with tomato. Dollop on sour cream and guacamole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x6g-D-Po1g1lN1cZLBWhSma79tc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/876203-ea27233a27f94eefa08952c456eb7243.jpg"
      ],
