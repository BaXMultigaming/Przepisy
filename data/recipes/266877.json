  "ingredients": [
    "0.25 cup black sesame seeds, crushed",
    "1.5 sticks salted butter",
    "1.5 cups white sugar",
    "2 eggs",
    "3 tablespoons black sesame paste",
    "1 teaspoon vanilla extract",
    "2.5 cups sifted all-purpose flour",
    "2.5 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1.25 cups milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 2 muffin tins with cupcake liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast sesame seeds in a dry frying pan over medium heat, stirring and tossing constantly, until fragrant, about 2 minutes. Omit this step if the seeds are already toasted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar in a large bowl using an electric mixer until creamy. Add toasted seeds, eggs, sesame paste, and vanilla extract. Beat until combined. Gradually beat in flour, baking powder, and salt. Add milk and beat for a few more minutes until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill cupcake liners with the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into a cupcake comes out clean, 16 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
