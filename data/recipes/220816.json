  "ingredients": [
    "1 cup fresh strawberries",
    "1 cup butter",
    "3.5 cups confectioners' sugar, sifted, divided",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Place strawberries in a blender; purée until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer strawberry purée to a saucepan over medium heat; bring to a boil, stirring often, until reduced by at least half, about 20 minutes. Remove from heat and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter with an electric mixer in a bowl until light and fluffy. Beat in 1 cup confectioners' sugar until combined. Beat 2 tablespoons cooled strawberry purée and vanilla extract into butter mixture until just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat in 1 cup confectioners' sugar until combined, followed by 2 tablespoons strawberry purée. Repeat this step once more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat remaining 1/2 cup confectioners' sugar into mixture until just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
