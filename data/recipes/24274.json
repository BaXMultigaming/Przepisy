  "ingredients": [
    "1 (6 ounce) package cherry-flavored gelatin mix (such as Jell-O®)",
    "0.75 cup boiling water",
    "1 (12 ounce) package fresh cranberries",
    "1 cup white sugar",
    "1 (8 ounce) can crushed pineapple, drained",
    "1 cup chopped pecans",
    "0.75 cup orange juice",
    "1 medium apple with peel, grated",
    "1 cup whipping cream",
    "1 (8 ounce) package cream cheese, softened"
  ],
  "steps": [
    {
      "text": "Stir gelatin into boiling water in a mixing bowl until dissolved; let cool, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, process cranberries in a food processor until finely chopped. Add sugar and process until dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cranberry mixture into cooled gelatin mixture. Stir in pineapple, pecans, orange juice, and apple until well combined. Cover and refrigerate for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to serve, beat cream in a chilled glass or metal bowl with an electric mixer until soft peaks form. Gradually beat in cream cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer 1/2 of the chilled cranberry mixture in a glass serving dish. Spread whipped cream mixture over top, then finish with remaining cranberry mixture.",
      "section": null,
      "name": null,
      "url": null,
