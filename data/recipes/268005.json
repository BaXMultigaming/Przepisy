  "ingredients": [
    "1 pound ground chicken",
    "0.5 cup chopped cilantro",
    "0.25 cup dry bread crumbs",
    "0.25 cup grated onion",
    "2 cloves garlic, grated",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 tablespoons vegetable oil",
    "0.25 cup peanut butter",
    "4 tablespoons sesame oil",
    "3 tablespoons white sugar",
    "2 tablespoons soy sauce",
    "2 tablespoons chopped peanuts, or to taste",
    "toothpicks"
  ],
  "steps": [
    {
      "text": "Mix chicken, cilantro, bread crumbs, onion, garlic, salt, and pepper; roll tablespoonfuls of the mixture into balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat. Add meatballs and cook until no longer pink in the center, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix peanut butter, sesame oil, sugar, and soy sauce together in a microwave-safe bowl. Microwave until sauce is heated through, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss meatballs with 1/2 of the sauce. Sprinkle with peanuts. Serve with toothpicks and remaining sauce for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
