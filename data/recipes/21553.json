  "ingredients": [
    "cooking spray",
    "1.5 pounds ground pork sausage",
    "1 (8 ounce) package refrigerated crescent roll dough",
    "2 cups mozzarella cheese",
    "4 eggs, beaten",
    "0.75 cup milk",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large, deep skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay crescent rolls flat on the bottom of the prepared dish. Combine cooked sausage, cheese, beaten eggs, milk, salt, and pepper in a large bowl; pour over crescent rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and rolls are cooked through, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
