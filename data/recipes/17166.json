  "ingredients": [
    "0.5 pound refrigerated cheese tortellini",
    "6 tablespoons olive oil",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried parsley",
    "0.25 teaspoon dried red pepper flakes",
    "2 tablespoons minced onion",
    "2 tablespoons minced green bell pepper",
    "1 tablespoon minced garlic",
    "7 ounces tomato sauce",
    "1 tablespoon white sugar",
    "0.5 teaspoon chicken soup base",
    "6 fluid ounces heavy cream",
    "0.5 cup white wine"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hDNaqv8pIjZQcvo2mouZCSUmJaM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17166-sauce-rosee-Step-01-eafd7900bdd1488a8550b53246d0759e.jpg"
      ],
      "image": "assets/images/17166/step_01.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil; stir in tortellini and return to a gentle boil. Cook uncovered, stirring occasionally, until tortellini float to the top and filling is hot, about 4 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large saucepan over medium-low heat. Stir basil, thyme, oregano, parsley, and red pepper flakes into hot oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aJvvtNFD-7o6lQatObO56ifmnx0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17166-sauce-rosee-Step-02-c4014c38d19e4893b0f95cc06e88bfa3.jpg"
      ],
      "image": "assets/images/17166/step_03.webp"
    },
    {
      "text": "Add onion, bell pepper, and garlic; cook and stir until onions are translucent, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-15f4y9AIerjx5a_7xFyeLWvot8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17166-sauce-rosee-Step-03-82973b70272e4c9ba0926779d78ff866.jpg"
      ],
      "image": "assets/images/17166/step_04.webp"
    },
    {
      "text": "Pour in tomato sauce and bring to a boil. Stir in sugar and chicken bouillon until dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a_uFmS74gNWUGvJCn5k_NXPk1K4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17166-sauce-rosee-Step-04-b683b9b38aa94a8f931be945d79ac928.jpg"
      ],
      "image": "assets/images/17166/step_05.webp"
    },
    {
      "text": "Reduce heat and stir in cream and wine; bring close to a boil, stirring constantly. Gently stir in tortellini and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ozh-buMQcpOpmUDd2T5lPV-T354=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17166-sauce-rosee-Step-05-0cdaece648db4c2aba422b09642708d3.jpg"
