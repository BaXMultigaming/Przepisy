  "ingredients": [
    "4 limes",
    "1 cup heavy whipping cream",
    "0.5 cup white sugar",
    "2 eggs",
    "3 egg yolks",
    "2 teaspoons ground ginger",
    "1 (9 inch) baked pie shell",
    "0.5 cup lime marmalade"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Zest 1 lime, then juice all 4 limes. Combine lime zest, juice, cream, sugar, eggs, egg yolks, and ginger in a large bowl. Whisk until well combined and pour into the prepared crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, about 45 minutes. Let cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat lime marmalade over low heat until melted. Remove from heat and cool slightly, about 5 minutes. Pour lime marmalade over the warm tart and spread out evenly. Allow to cool completely before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
