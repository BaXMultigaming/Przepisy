  "title": "Tahini Chicken Skewers",
  "description": "These marinated and grilled tahini chicken skewers are full of flavor, making them a perfect idea for a quick and easy summer BBQ dish.",
  "authors": [
    "Hannah Elliott"
  ],
  "date_published": "2020-06-19T00:36:22-04:00",
