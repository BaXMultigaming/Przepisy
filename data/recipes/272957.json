  "ingredients": [
    "8 cloves garlic, peeled and crushed",
    "0.5 cup soy sauce",
    "0.5 cup white sugar",
    "0.25 cup red wine vinegar",
    "2 tablespoons tahini",
    "1 tablespoon lemon juice",
    "2 teaspoons Sriracha sauce",
    "0.5 teaspoon coarse ground black pepper",
    "5 skinless, boneless chicken breasts, cut into 3/4-inch strips",
    "8 green onions, diced",
    "2 tablespoons toasted sesame seeds",
    "10 wooden skewers"
  ],
  "steps": [
    {
      "text": "Place garlic, soy sauce, sugar, red wine vinegar, tahini, lemon juice, Sriracha sauce, and pepper in a food processor. Blend well until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the marinade into a zip-top bag; add chicken, green onions, and toasted sesame seeds. Marinate in the refrigerator for at least 3 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place wooden skewers in a container filled with water and soak at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate. Thread chicken onto skewers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill chicken skewers until chicken is no longer pink in the center and juices run clear, about 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
