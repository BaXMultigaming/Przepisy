  "ingredients": [
    "1.3333330154419 cups water",
    "0.66666668653488 cup uncooked long grain white rice",
    "3 tablespoons vegetable oil",
    "2 medium onions, cut into wedges",
    "3 cloves garlic, chopped",
    "2 teaspoons salt",
    "0.5 tablespoon white sugar",
    "1 egg, beaten",
    "0.25 pound cooked crabmeat",
    "3 green onions, chopped",
    "1 tablespoon chopped cilantro",
    "0.5 cucumber, sliced",
    "1 lime, sliced"
  ],
  "steps": [
    {
      "text": "Place water and rice in a saucepan; bring to a boil. Reduce heat, cover, and simmer until water is absorbed, about 20 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a wok over medium heat. Cook and stir onions and garlic in hot oil until tender. Mix in cooked rice, salt, and sugar; cook, stirring occasionally, until well blended, about 5 minutes. Stir in beaten egg until rice is coated. Increase heat to high and mix in crabmeat, green onions, and cilantro. Cook and stir until crab is heated through, 2 to 5 minutes. Garnish with cucumber and lime slices to serve.",
      "section": null,
