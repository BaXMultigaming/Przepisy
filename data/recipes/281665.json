  "ingredients": [
    "1 stick butter",
    "0.5 cup white sugar",
    "1 large egg",
    "0.5 teaspoon almond extract",
    "0.5 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.5 cup almond flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1.25 cups apricot jam, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line an 8x8-inch baking dish with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and caster sugar together in a bowl until smooth; beat in egg, almond extract, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, almond flour, baking powder, and salt together in a bowl. Stir flour mixture into butter mixture until a smooth dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press 1/2 of the dough into the prepared baking dish. Spread apricot jam evenly over the dough. Drop remaining dough in small spoonfuls evenly over the jam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 25 minutes. Allow to cool before cutting into squares and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
