  "ingredients": [
    "1 (8 ounce) package dried spinach tortellini",
    "1 (8 ounce) package dried three-cheese tortellini",
    "1 cup grape tomatoes, halved",
    "1 (6 ounce) jar marinated artichoke hearts, drained and chopped",
    "1 (6 ounce) can sliced black olives, drained",
    "0.5 red onion, thinly sliced",
    "0.25 cup grated carrots",
    "1.5 cups oil and vinegar dressing"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in spinach and three-cheese tortellini and return to a boil. Cook, uncovered, stirring occasionally, until tortellini float to the top, pasta tender yet firm to the bite, and filling is hot, 10 to 11 minutes. Drain well; cool tortellini.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tortellini, grape tomatoes, artichoke hearts, olives, red onion, and carrots in a large bowl; toss with dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bowl with plastic wrap; refrigerate until chilled, at least 3 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
