  "ingredients": [
    "4 cups sauerkraut, drained",
    "1 onion, chopped",
    "1 apple - peeled, cored, and grated",
    "2 carrots, grated",
    "0.25 cup canola oil",
    "3 tablespoons sugar",
    "1 teaspoon caraway seeds, or more to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place sauerkraut in a colander and squeeze out all excess liquid using your hands; chop well.",
      "section": null,
