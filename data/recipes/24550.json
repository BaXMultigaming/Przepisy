  "ingredients": [
    "2 cups white sugar",
    "1 cup vegetable oil",
    "4 eggs",
    "2 teaspoons coconut extract",
    "3 cups all-purpose flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "1 cup buttermilk",
    "1 cup shredded coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat together sugar and vegetable oil. Beat in eggs and coconut extract. In a separate bowl, sift together flour, salt, baking powder and baking soda. Stir flour mixture into egg mixture alternately with buttermilk and coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 45 minutes, until a toothpick inserted into center of the loaf comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
