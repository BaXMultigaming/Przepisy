  "ingredients": [
    "1 pound ground beef",
    "0.5 onion, chopped",
    "1 (15 ounce) can spaghetti sauce",
    "1 (14.5 ounce) can diced tomatoes, drained",
    "salt and ground black pepper to taste",
    "1 cup shredded mozzarella cheese",
    "1 (8 ounce) package refrigerated crescent rolls",
    "1 tablespoon salted butter, melted",
    "2 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir ground beef and onion in a cast iron skillet over medium-high heat until beef is browned and crumbly, 5 to 7 minutes. Drain and discard grease. Return to medium heat, add spaghetti sauce and diced tomatoes, and season with salt and pepper. Cook until thoroughly heated. Sprinkle with mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll crescent dough and arrange triangles over cheese in the skillet. Brush with butter; sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
