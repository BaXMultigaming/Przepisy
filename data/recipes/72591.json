  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a medium baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together Cheddar cheese, mayonnaise, sour cream, flour, onion, lemon juice, and cayenne pepper in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange halibut steaks in the prepared baking dish and cover with Cheddar cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
