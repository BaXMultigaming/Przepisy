  "ingredients": [
    "1 cup honey",
    "0.66666668653488 cup coconut oil",
    "2 cups grated carrots",
    "2 eggs",
    "1 cup all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "3 cups quick-cooking oats",
    "1 cup raisins",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 2 cookie sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat honey and coconut oil in a large bowl with an electric mixer until creamy; beat in carrots and eggs until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, cinnamon, nutmeg, baking soda, and salt together in a large bowl; stir into carrot mixture until well combined. Stir in oats, raisins, and walnuts until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop large spoonfuls of dough 2 inches apart onto the prepared cookie sheets; flatten with a fork, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are golden, about 15 minutes. Cool on the cookie sheet for 1 minute before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
