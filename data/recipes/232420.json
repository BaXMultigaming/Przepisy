  "ingredients": [
    "2 tablespoons butter",
    "4 boneless pork chops",
    "1.25 cups water",
    "1 (6 ounce) package long grain and wild rice mix with herbs",
    "1 (15.25 ounce) can corn, undrained",
    "1 (14.5 ounce) can diced Italian-style tomatoes, undrained"
  ],
  "steps": [
    {
      "text": "Heat butter in a skillet over medium heat; cook pork chops in the melted butter until cooked through, 10 to 15 minutes. Remove pork chops from skillet and cut into bite-sized pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour water and long grain and wild rice mix with herbs into the same skillet; stir well. Layer pork chop pieces over rice. Pour corn over pork chops layer; top with tomatoes. Cover skillet and simmer until rice is tender and liquid is absorbed, 30 to 40 minutes.",
      "section": null,
