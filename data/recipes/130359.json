  "ingredients": [
    "0.5 cup packed brown sugar",
    "0.5 teaspoon salt",
    "1 cup canned pumpkin puree",
    "0.5 teaspoon ground cinnamon",
    "1 quart vanilla ice cream, softened",
    "2 (9 inch) prepared graham cracker crusts"
  ],
  "steps": [
    {
      "text": "In a large bowl, stir together the brown sugar, salt, pumpkin and cinnamon. Mix in the softened ice cream until well blended. Spoon into the pie crusts and place them in the freezer. Freeze for at least 3 hours before serving.",
