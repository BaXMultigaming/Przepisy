  "ingredients": [
    "1 cup butter",
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "1 egg",
    "1 cup vegetable oil",
    "1 teaspoon vanilla extract",
    "1 teaspoon baking soda",
    "3.5 cups all-purpose flour",
    "1 cup rolled oats",
    "0.5 cup flaked coconut",
    "1 cup crushed cornflakes cereal",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (170 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together butter, white sugar, and brown sugar in a mixing bowl until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in egg, oil, vanilla, baking soda, and flour until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in oats, coconut, cornflakes, and pecans until incorporated. Drop spoonfuls onto cookie sheets. If desired, sprinkle with white sugar before baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned and edges are set, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
