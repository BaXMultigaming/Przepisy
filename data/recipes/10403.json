  "ingredients": [
    "2 cups white sugar",
    "0.5 cup butter",
    "0.5 cup milk",
    "4 tablespoons unsweetened cocoa powder",
    "0.125 teaspoon salt",
    "3 cups quick cooking oats",
    "0.5 cup crunchy peanut butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, butter, milk, cocoa, and salt together in a saucepan over medium-high heat. Boil for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in oats, peanut butter, and vanilla. Drop by tablespoonfuls onto waxed paper. Allow to cool and harden, 30 to 45 minutes.",
