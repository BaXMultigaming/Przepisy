  "ingredients": [
    "3 pounds carrots, chopped",
    "6 cups chicken stock",
    "3 cloves garlic, chopped",
    "2 tablespoons dried dill weed",
    "0.25 pound butter",
    "1.5 teaspoons salt"
  ],
  "steps": [
    {
      "text": "In a medium-sized stockpot, over high heat, combine chicken stock, carrots, garlic, dill weed, salt, and butter. Bring to a boil, reduce heat and simmer for 30 minutes or until carrots are soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree soup in a blender; return to the stockpot and simmer for an additional 30 to 45 minutes. Season with additional dill or garlic if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
