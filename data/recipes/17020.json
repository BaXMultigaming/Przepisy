  "ingredients": [
    "1 (9 inch) unbaked pie shell",
    "2 eggs, beaten",
    "0.33329999446869 cup butter, melted",
    "1 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 tablespoon distilled white vinegar",
    "0.5 cup chopped pecans",
    "0.5 cup shredded coconut",
    "0.5 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium mixing bowl combine eggs, butter or margarine, sugar, vanilla extract, and vinegar. Beat until smooth. Stir in pecans, coconut, and raisins. Pour mixture into pastry shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 40 minutes. Cool before serving.",
