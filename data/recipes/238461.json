  "ingredients": [
    "1 cup vanilla-flavored coconut milk beverage (such as Silk®)",
    "2 tablespoons cocoa powder",
    "1 tablespoon white sugar",
    "0.25 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Stir coconut milk beverage, cocoa powder, sugar, vanilla extract, and cinnamon together in a saucepan over medium heat until cocoa and sugar are completely dissolved and mixture is heated through, 5 to 10 minutes. Pour hot cocoa into a mug.",
