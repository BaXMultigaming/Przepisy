  "ingredients": [
    "2 pounds ground beef",
    "1.5 cups dry bread crumbs",
    "1 egg",
    "1 cup steak sauce",
    "1 (1 ounce) package dry onion soup mix",
    "1 green bell pepper, chopped",
    "1 onion, chopped",
    "1 bunch fresh cilantro, chopped",
    "1 clove garlic, chopped",
    "15 slices thinly sliced ham",
    "10 slices Cheddar cheese",
    "2 cups chopped broccoli"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, combine ground beef, bread crumbs, egg, and steak sauce. Mix thoroughly. Blend in soup mix, green pepper, onion, cilantro, and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a large piece of aluminum foil, pat beef mixture into a thin, flat rectangle. Layer about 1/2 the ham on top of beef from end to end. Layer ham with Cheddar cheese. Layer cheese with remaining ham, then broccoli.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using the foil, roll meatloaf while pinching the ends. Keep aluminum foil around meat loaf and place on a medium baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
