  "ingredients": [
    "1.5 cups peanut butter",
    "1 cup butter, softened",
    "2 cups white sugar",
    "1 teaspoon boiling water",
    "0.5 teaspoon vanilla extract",
    "1.75 cups all-purpose flour",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the peanut butter, butter, and white sugar until smooth. Stir in the water and vanilla. Combine the flour and salt; stir into the peanut butter mixture. Drop by rounded spoonfuls onto an ungreased cookie sheet. Press down lightly using the tines of a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 to 15 minutes in the preheated oven. Let cookies cool completely before removing from baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
