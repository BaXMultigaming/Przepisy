  "ingredients": [
    "0.5 cup butter or margarine",
    "1 cup white sugar",
    "0.33333298563957 cup unsweetened cocoa powder",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.75 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8x8 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in medium sauce pan. Remove from heat, and stir in sugar and cocoa. Beat in the eggs one at a time, then stir in the vanilla. Combine the flour, baking powder, and salt; stir into the chocolate mixture until just blended. Fold in walnuts, if desired. Spread the batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 minutes in the preheated oven, or until a wooden pick inserted into the center comes out clean. Cool in pan on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
