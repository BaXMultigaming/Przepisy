  "ingredients": [
    "0.5 cup butter",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "2 egg whites",
    "0.66666668653488 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease two baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, sugar, and vanilla with an electric mixer in a large bowl until smooth. Add egg whites, one at a time, allowing each to blend into butter mixture before adding the next. Mix in flour until just incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop teaspoonfuls of dough onto ungreased baking sheets. Spread thinly with a spatula or the back of the spoon into 3-inch circles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned along the edges, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove baked wafers from the baking sheet one at a time using a spatula or kitchen turner. Roll each wafer around the handle of a wooden spoon until the edges overlap. Cool seam-side down on a wire rack until completely crisp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
