  "ingredients": [
    "1 pound thinly sliced pork loin",
    "salt and pepper to taste",
    "1 tablespoon unsalted butter",
    "1 tablespoon extra virgin olive oil",
    "1 cup chicken stock",
    "1 cup dry white wine",
    "3 tablespoons chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Season meat with salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, heat butter and olive oil over medium heat. When skillet is hot, place sliced pork loin into skillet; cook until browned, turning once. After both sides have browned nicely, add chicken stock ,and cook until liquid thickens.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in dry white wine, scraping the bottom of the pan. Reduce heat, and simmer until liquid is reduced by half. Remove from heat, and allow to cool slightly. Stir in cilantro. Spoon sauce over pork when serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
