  "ingredients": [
    "3.5 cups white sugar",
    "6 large eggs, beaten",
    "10 fresh peaches, pitted and chopped",
    "4 cups heavy cream",
    "2 cups half-and-half cream",
    "2 teaspoons vanilla extract",
    "0.75 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
