  "ingredients": [
    "6 tablespoons unsalted butter, softened",
    "0.25 cup olive oil",
    "1 tablespoon minced garlic",
    "1 tablespoon minced shallots",
    "2 tablespoons minced fresh chives",
    "salt and freshly ground black pepper to taste",
    "0.5 teaspoon paprika",
    "2 pounds large shrimp - peeled and deveined"
  ],
  "steps": [
    {
      "text": "Preheat grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together softened butter, olive oil, garlic, shallots, chives, salt, pepper, and paprika; add the shrimp, and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil grill grate. Cook the shrimp as close to the flame as possible for 2 to 3 minutes per side, or until opaque.",
