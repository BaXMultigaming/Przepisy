  "ingredients": [
    "1 (8 ounce) container fat-free plain yogurt",
    "0.33333334326744 cup crumbled feta cheese with basil and sun-dried tomatoes",
    "0.5 teaspoon lemon zest",
    "2 tablespoons fresh lemon juice",
    "2 teaspoons dried oregano",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon crushed dried rosemary",
    "1 pound skinless, boneless chicken breast halves - cut into 1 inch pieces",
    "1 large red onion, cut into wedges",
    "1 large green bell pepper, cut into 1 1/2 inch pieces"
  ],
  "steps": [
    {
      "text": "In a large shallow baking dish, mix the yogurt, feta cheese, lemon zest, lemon juice, oregano, salt, pepper, and rosemary. Place the chicken in the dish, and turn to coat. Cover, and marinate 3 hours in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thread the chicken, onion wedges, and green bell pepper pieces alternately onto skewers. Discard remaining yogurt mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill skewers on the prepared grill until the chicken is no longer pink and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
