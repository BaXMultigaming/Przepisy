  "ingredients": [
    "6 cups fresh marionberries",
    "0.75 cup white sugar",
    "6 tablespoons all-purpose flour",
    "1 tablespoon lemon juice",
    "1 (15 ounce) package pastry for a 9-inch double crust pie",
    "2 teaspoons water, or as needed",
    "2 teaspoons sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine marionberries, 3/4 cup sugar, flour, and lemon juice together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 pie crust in bottom of a 9-inch pie plate; add marionberry filling. Cover with remaining crust; crimp edges to seal. Brush pie lightly with water. Sprinkle remaining 2 teaspoons sugar on top. Cut 4 to 8 slits (1-inch) in top crust with a knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Reduce heat to 350 degrees F (175 degrees C); continue baking until crust golden, 45 to 50 minutes more. Let cool completely before serving, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
