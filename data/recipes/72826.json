  "ingredients": [
    "2 ounces Camembert cheese",
    "2 thick slices white bread",
    "1 tablespoon whole cranberry sauce",
    "1 dash balsamic vinegar",
    "1 tablespoon butter, softened"
  ],
  "steps": [
    {
      "text": "Spread Camembert cheese evenly onto one bread slice, then top with a thin layer of cranberry sauce. Drizzle balsamic vinegar and top with remaining bread slice. Spread butter on the outside of each bread slice.",
      "section": null,
      "name": null,
      "url": null,
