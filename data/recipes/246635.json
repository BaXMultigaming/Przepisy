  "ingredients": [
    "4 cups chopped cabbage",
    "3 carrots, peeled and chopped",
    "3 ribs celery, chopped",
    "0.5 cup apple cider vinegar",
    "0.25 cup white sugar",
    "1.5 teaspoons salt",
    "1 teaspoon ground black pepper",
    "1 cup mayonnaise",
    "3 tablespoons prepared horseradish",
    "2 tablespoons stone-ground mustard",
    "0.5 teaspoon chopped fresh parsley",
    "0.5 teaspoon celery seed",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon ground mustard"
  ],
  "steps": [
    {
      "text": "Combine cabbage, carrots, and celery in a large bowl. Whisk vinegar sugar, salt, and pepper together in a small bowl; pour over cabbage and stir until well coated. Refrigerate cabbage mixture for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mayonnaise, horseradish, and mustard together in a bowl; stir into cabbage mixture. Add parsley, celery seed, onion powder, and mustard; mix well. Refrigerate until chilled, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
