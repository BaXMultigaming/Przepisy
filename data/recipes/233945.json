  "ingredients": [
    "cooking spray",
    "0.5 cup pecan halves",
    "1 cup old-fashioned oats",
    "1 cup all-purpose flour",
    "0.25 cup brown sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup chilled unsalted butter, cut into cubes",
    "0.75 cup apricot preserves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray bottom and sides of an 8-inch square baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pulse pecans in a food processor until coarsely chopped, 3 to 5 times. Add oats, flour, brown sugar, cinnamon, baking soda, and salt; pulse 3 to 4 times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle butter cubes over the top of the flour-oat mixture. Pulse until butter is the size of small peas, 3 to 5 times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1/2 of oat mixture into the bottom of the prepared baking dish, pressing down lightly. Spread apricot preserves over oat mixture to 1/4-inch of the edge. Top with remaining oat mixture and press down lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden brown, 35 to 40 minutes. Cool before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
