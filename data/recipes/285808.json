  "ingredients": [
    "1 pint fresh strawberries",
    "0.75 cup sweetened condensed milk, divided",
    "4 ounces cold heavy cream",
    "2 cups granola, large chunks crumbled",
    "0.5 cup whipped cream (such as Reddi Wip®)"
  ],
  "steps": [
    {
      "text": "Stem strawberries and slice lengthwise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1/2 can condensed milk and heavy cream with an electric mixer until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip a fork into the remaining condensed milk and drizzle it on the inside of serving glasses or cups. Spoon some thickened cream mixture into each cup, then top with some strawberries and granola. Repeat the layer process until glasses are full, leaving some granola leftover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top each glass with whipped cream, then drizzle more condensed milk over top and sprinkle with remaining granola. Serve immediately.",
      "section": null,
