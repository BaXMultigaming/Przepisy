  "ingredients": [
    "1 pound bacon, chopped",
    "2 medium green bell peppers, chopped",
    "1 onion, chopped",
    "2 (16 ounce) packages frozen corn",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large, deep skillet over medium-high heat until evenly browned, but still soft. Stir in bell peppers and onion; cook until tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low. Stir in corn; cook until tender, about 15 minutes. Season with salt and black pepper. Do not drain drippings from bacon — that is the secret to the flavor.",
