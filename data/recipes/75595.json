  "ingredients": [
    "0.5 cup water",
    "0.5 cup granulated sugar",
    "2 cups orange juice",
    "1 tablespoon lemon juice",
    "1 (20 ounce) can crushed pineapple",
    "2 teaspoons freshly grated orange zest"
  ],
  "steps": [
    {
      "text": "In a medium saucepan, bring water and sugar to a simmer over medium high heat until sugar is dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a food processor, puree pineapple with its juice until smooth. Transfer to a metal bowl, and stir in syrup, lemon juice, orange juice, and orange zest. Freeze until slightly firm, but not frozen.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Process mixture again in the food processor or beat with an electric mixer until smooth. Transfer to a freezer container and freeze until firm, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
