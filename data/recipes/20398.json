  "ingredients": [
    "4 egg yolks",
    "4 tablespoons distilled white vinegar",
    "2 tablespoons white sugar",
    "0.75 teaspoon prepared mustard",
    "0.5 teaspoon salt",
    "16 large marshmallows, halved",
    "1 cup heavy whipping cream"
  ],
  "steps": [
    {
      "text": "On top of a double boiler, beat together the egg yolks, vinegar, sugar, mustard and salt. Cook over medium heat until mixture becomes thick. Remove from heat. Add the marshmallows to the mixture and stir until dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip 1/2 pint of the whipping cream until soft peaks form, and then fold it into the cooked ingredients. If mixture is too thick, thin it by adding a little cream or fruit juice. Add to your favorite fruit salad and use enough dressing to make it the consistency you desire.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Store dressing, tightly covered, in the refrigerator for a week or so.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
