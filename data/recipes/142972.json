  "ingredients": [
    "1 cup flat beer",
    "2 tablespoons butter",
    "2 tablespoons sugar",
    "1 teaspoon salt",
    "2.5 cups all-purpose flour",
    "2.25 teaspoons yeast",
    "1 tablespoon olive oil, for brushing"
  ],
  "steps": [
    {
      "text": "Place beer, butter, sugar, salt, flour, and yeast in a bread machine in the order recommended by the manufacturer. Select Dough setting and press Start.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove dough from bread machine when cycle is complete. Roll or press dough to cover a prepared pizza pan. Brush lightly with olive oil. Cover and let stand for about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread desired sauce and toppings on top of dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
