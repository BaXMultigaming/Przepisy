  "ingredients": [
    "4 (3 ounce) fillets salmon fillets, thawed if frozen",
    "2 tablespoons butter, melted",
    "2 tablespoons lemon juice",
    "1 dash Cajun seasoning",
    "1 (15.25 ounce) can whole kernel corn, drained",
    "1 (15 ounce) can black beans, drained",
    "1 tomato, diced",
    "0.25 cup diced red onion",
    "0.25 cup chopped fresh cilantro",
    "0.5 cup shredded mild Cheddar cheese",
    "8 corn tortillas, warmed",
    "0.5 cup sour cream",
    "0.5 cup guacamole"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the salmon: Place salmon fillets into a shallow baking dish. Whisk melted butter, lemon juice, and Cajun seasoning together in a small bowl; drizzle over salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake salmon in the preheated oven until until fish flakes easily with a fork, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the salmon is baking, make the salsa: Mix corn, black beans, tomato, red onion, and cilantro in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flake cooked salmon into smaller pieces with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide flaked salmon, salsa, and Cheddar cheese among warm tortillas. Wrap tortillas around filling and serve with sour cream and guacamole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
