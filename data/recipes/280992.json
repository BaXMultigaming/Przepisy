  "ingredients": [
    "1 teaspoon apple cider vinegar",
    "1 teaspoon soy sauce",
    "1 teaspoon salt",
    "0.5 teaspoon white sugar",
    "2 cups watermelon rind, peeled",
    "1 (16-ounce) Mason jar"
  ],
  "steps": [
    {
      "text": "Combine apple cider vinegar and soy sauce in a bowl. Stir in salt and sugar; continue mixing until completely dissolved.",
