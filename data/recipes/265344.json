  "ingredients": [
    "0.25 cup raw cashews",
    "1 ripe banana",
    "1 cup ice cubes",
    "3 ounces extra-firm tofu, pressed to remove water",
    "2 Medjool dates, pitted",
    "1 teaspoon mint extract",
    "1 teaspoon soy milk, or more as needed",
    "0.25 cup vegan chocolate chips"
  ],
  "steps": [
    {
      "text": "Place cashews in a bowl and cover with water. Soak for 1 to 3 hours. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soaked cashews, banana, ice cubes, tofu, dates, mint extract, and 1 teaspoon soy milk in a blender. Process until smooth. Add an additional teaspoon of soy milk only if needed, in order to keep the mixture as thick as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chocolate chips and pour into a bowl to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
