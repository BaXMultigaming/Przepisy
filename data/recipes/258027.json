  "ingredients": [
    "1 pound ground turkey",
    "0.5 cup Italian-style bread crumbs",
    "0.5 cup grated Parmesan cheese",
    "1 egg",
    "0.25 cup chopped fresh parsley",
    "0.5 teaspoon kosher salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix turkey, bread crumbs, Parmesan cheese, egg, parsley, and salt together in a large bowl. Form meat mixture with wet hands into balls about 1 1/2 inches in diameter without handling or packing too hard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned, about 20 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
