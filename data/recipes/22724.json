  "ingredients": [
    "0.5 cup butter",
    "1 (16 ounce) package brown sugar",
    "0.5 cup milk",
    "0.75 cup peanut butter",
    "1 teaspoon vanilla extract",
    "3.5 cups confectioners' sugar"
  ],
  "steps": [
