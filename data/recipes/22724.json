        "https://www.allrecipes.com/thmb/D4RYDWOqAEzZwgVY_uvBrLYdm10=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22724-easiest-peanut-butter-fudge-step-05-7d94cf5315dd4739bbca3927dde7a7fe.jpg"
