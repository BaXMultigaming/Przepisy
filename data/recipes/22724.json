      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SmHtvwKljTKTpu1ui2IbFTqolpo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22724-easiest-peanut-butter-fudge-step-04-5b8f944a41014a67a46622dfd598a77d.jpg"
      ],
      "image": "assets/images/22724/step_03.webp"
    },
    {
      "text": "Place confectioners' sugar in a large mixing bowl. Pour in peanut butter mixture and beat with an electric mixer until smooth.",
