      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E9GtkV0KUjKCl7Ih_EUmDGhKcUs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22724-easiest-peanut-butter-fudge-step-02-891e0ff6ef42440698370d45c8a756f8.jpg"
      ],
      "image": "assets/images/22724/step_02.webp"
    },
    {
      "text": "Remove the pot from heat; stir in peanut butter and vanilla.",
