  "ingredients": [
    "10 cups cold water, divided",
    "2 cinnamon sticks",
    "2 cups uncooked white rice",
    "1 cup almonds",
    "1 (14 ounce) can sweetened condensed milk",
    "6 cups ice"
  ],
  "steps": [
    {
      "text": "Bring 4 cups water to a boil. Add cinnamon sticks and let steep for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine rice and almonds in a blender; blend to the consistency of sand. Transfer to a bowl and mix in cinnamon water. Cover and let sit for 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain mixture through a fine-mesh sieve twice. Save cinnamon sticks but discard almond and rice solids. Add 6 cups cold water, sweetened condensed milk, and cinnamon sticks. Serve over ice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
