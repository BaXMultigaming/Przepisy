  "ingredients": [
    "15 cups plain popped popcorn",
    "1 cup dried cranberries",
    "1 cup chopped pecans",
    "0.5 cup candy-coated milk chocolate pieces (such as M&M's®)",
    "1.3333333730698 cups white sugar",
    "1 cup butter",
    "0.5 cup light corn syrup (such as Crown® Lily White)",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon vinegar"
  ],
  "steps": [
    {
      "text": "Line baking sheets with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine popcorn, cranberries, pecans, and chocolate pieces together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, butter, corn syrup, and vanilla extract together in a heavy saucepan; cook and stir over medium-high heat until boiling, about 5 minutes. Boil mixture for 2 minutes. Remove saucepan from heat and stir in vinegar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sugar mixture over popcorn mixture; mix until evenly coated. Spread coated popcorn mixture onto prepared baking sheets; cool. Break into pieces and store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
