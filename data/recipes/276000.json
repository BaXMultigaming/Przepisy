  "ingredients": [
    "1 sheet frozen puff pastry, thawed",
    "0.33333334326744 cup chocolate-hazelnut spread (such as Nutella®)",
    "3 tablespoons chopped hazelnuts, toasted",
    "1 egg",
    "1 tablespoon water"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place puff pastry on a very lightly floured surface and roll to a 9x12-inch rectangle. Cut into twelve 3-inch squares with a sharp knife. Place about 1 teaspoon chocolate-hazelnut spread in the center of each square; sprinkle with hazelnuts. Fold each square diagonally to form a triangle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together egg and water in a small bowl until well combined. Brush egg wash over the edges of each pastry triangle; press to seal. Arrange turnovers in a single layer in the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in batches in the preheated air fryer until well browned, 5 to 7 minutes per batch. Cool turnovers on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
