  "ingredients": [
    "2 eggs",
    "5 tablespoons white vinegar",
    "3 tablespoons evaporated milk, or more as needed",
    "8 teaspoons ground yellow mustard",
    "2 teaspoons all-purpose flour",
    "2 teaspoons white sugar",
    "1 teaspoon salt",
    "1 teaspoon margarine"
  ],
  "steps": [
    {
      "text": "Beat eggs, vinegar, evaporated milk, ground yellow mustard, flour, sugar, salt, and margarine together in a small pot until smooth; cook over low heat until simmering and slightly thickened, about 5 minutes. Cool to room temperature before storing in refrigerator.",
