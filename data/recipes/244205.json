  "ingredients": [
    "2 pounds red potatoes",
    "2 tablespoons extra-virgin olive oil",
    "0.5 cup extra-virgin olive oil",
    "1 tablespoon apple cider vinegar",
    "1 teaspoon kosher salt",
    "1 teaspoon ground black pepper",
    "1 clove garlic, chopped",
    "0.5 teaspoon white sugar",
    "6 slices cooked bacon, chopped",
    "4 green onions, chopped",
    "2 tablespoons minced fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a large bowl; add 2 tablespoons olive oil and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until tender, about 30 minutes. Cool, 10 to 15 minutes, cut into quarters, then place in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk ½ cup olive oil, vinegar, salt, black pepper, garlic, and sugar together in a bowl until smooth; pour over potatoes. Add bacon, green onions, and parsley; toss until evenly coated.",
