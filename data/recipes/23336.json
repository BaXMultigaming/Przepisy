  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 onion, diced",
    "2 cloves garlic, minced",
    "1 pound ground turkey",
    "3 (15 ounce) cans black beans, undrained",
    "1 (14.5 ounce) can crushed tomatoes",
    "1.5 tablespoons chili powder",
    "1 tablespoon dried oregano",
    "1 tablespoon dried basil leaves",
    "1 tablespoon red wine vinegar"
  ],
  "steps": [
    {
      "text": "Heat oil in a large heavy pot over medium heat. Add onion and garlic; cook and stir until onion has softened and turned translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d0aYv1fNYpxlkB8yqSyhGb6W19M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23336_FantasticBlackBeanChili_ddmfs_step1_4x3_2119-9485f2cdbb8b4a6e872705a147b8ebbf.jpg"
      ],
      "image": "assets/images/23336/step_01.webp"
    },
    {
      "text": "Add turkey; cook and stir until browned and crumbly, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c6px0YnWOD-QUNwc_dNaGKjCKcM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23336_FantasticBlackBeanChili_ddmfs_step2_4x3_2131-819426ba1a5c4759abf1c62d4972f5cf.jpg"
      ],
      "image": "assets/images/23336/step_02.webp"
    },
    {
      "text": "Stir in beans, tomatoes, chili powder, oregano, basil, and vinegar. Reduce heat to low, cover, and simmer until flavors are well blended, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gmjZOnD8Qc_KSv7yZRlQSe3rKu4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23336_FantasticBlackBeanChili_ddmfs_step3_4x3_2136-1e1f18685bdb46bb9a719c9c41a9ef41.jpg"
