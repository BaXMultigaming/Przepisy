  "ingredients": [
    "2 (4 ounce) containers applesauce",
    "0.5 cup butter, softened",
    "1 cup packed dark brown sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "3 cups oats",
    "1 cup dried cranberries",
    "0.75 cup white chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat applesauce, butter, brown sugar, eggs, and vanilla together in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, cinnamon, and salt together in a separate bowl; stir into the applesauce mixture. Fold oats, cranberries, and chocolate chips into the batter; drop by oversized spoonful onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden brown, about 15 minutes. Let cookies cool on pans for a few minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
