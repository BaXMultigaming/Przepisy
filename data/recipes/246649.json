  "ingredients": [
    "4 cups quinoa flakes",
    "2 cups almond flour",
    "0.25 teaspoon flax seeds",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1 cup honey",
    "1 cup applesauce",
    "1 cup chocolate chips",
    "2 eggs",
    "4 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine quinoa flakes, almond flour, flax seeds, baking powder, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix honey, applesauce, chocolate chips, eggs, and vanilla extract in another bowl. Add to quinoa flake mixture and mix well with your hands to combine. Press evenly on prepared baking sheet with your hands or a spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden, about 15 minutes. Cool for 20 minutes before cutting into 36 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
