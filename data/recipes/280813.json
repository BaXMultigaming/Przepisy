  "ingredients": [
    "5 cups water",
    "0.66666668653488 cup white sugar",
    "2 teaspoons lemon zest",
    "0.75 cup freshly squeezed lemon juice",
    "12 leaves fresh mint, or as needed",
    "1 lemon, cut into wedges",
    "1 fluid ounce raspberry-flavored liqueur (such as Chambord®)"
  ],
  "steps": [
    {
      "text": "Whisk water, sugar, and lemon zest together in a medium saucepan; bring to a boil over high heat. Boil and whisk for 5 minutes. Cool 10 minutes, then whisk in lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer lemon mixture to an 8x8-inch pan; freeze 1 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pan from freezer; stir with a fork to break up ice. Freeze 3 hours more. Scrape and mix ice into shavings with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve in chilled glasses; garnish with mint and lemon wedges. Top with raspberry-flavored liqueur.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
