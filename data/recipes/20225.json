  "ingredients": [
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "1.5 cups warm milk",
    "1 (8 ounce) jar dried beef, chopped",
    "1 pinch cayenne pepper",
    "bread, toasted"
  ],
