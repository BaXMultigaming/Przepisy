  "ingredients": [
    "1 cup margarine, softened",
    "0.5 cup packed brown sugar",
    "1 (15.25 ounce) package yellow cake mix",
    "0.25 cup water",
    "1 egg",
    "2 cups quick-cooking oatmeal",
    "1.25 cups chopped pecans",
    "3 tablespoons bourbon (such as Maker's Mark®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream margarine and brown sugar together in a bowl using an electric mixer. Add 1/2 of the cake mix, water, and egg; blend thoroughly. Stir in remaining cake mix, oats, pecans, and bourbon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter by teaspoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven on the top racks until edges are set and golden, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
