  "ingredients": [
    "1 pound ground beef",
    "0.25 cup all-purpose flour",
    "1 cube beef bouillon",
    "0.75 teaspoon salt",
    "1 pinch ground black pepper",
    "2.25 cups milk",
    "0.25 teaspoon Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Brown beef in a large skillet over medium high heat. Stir in flour, bouillon, salt and pepper. Saute all together for about 5 minutes or until flour is absorbed. Gradually stir in milk and Worcestershire sauce. Bring all to a simmer, stirring constantly. Cook until thickened, about 5 to 10 minutes. Serve hot!",
