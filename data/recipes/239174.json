  "title": "Black Bean and Walnut Burgers",
  "description": "Hearty and nutty, these black bean burgers are made with cooked sweet potato, walnuts, Fresno chile pepper, rolled oats, and flaxseed.",
  "authors": [
    "ademuri"
  ],
  "date_published": "2018-06-08T10:16:29-04:00",
