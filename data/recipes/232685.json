  "ingredients": [
    "1 teaspoon peanut oil",
    "3 andouille sausages, cut into cubes",
    "1 teaspoon Cajun seasoning",
    "4 (14 ounce) cans vegetable broth",
    "1 sweet potato, peeled and cubed",
    "1 (15.25 ounce) can whole kernel corn, drained"
  ],
  "steps": [
    {
      "text": "Heat peanut oil in a skillet over medium heat. Season andouille sausage with Cajun seasoning; cook in hot oil until browned, about 5 minutes. Drain excess grease from the skillet. Set sausage aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable broth in a saucepan over medium heat until warm; add sweet potato and bring to boil. Cook until potato is tender, about 10 minutes. Stir sausage and corn into the broth with the sweet potato. Bring the mixture to a boil and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
