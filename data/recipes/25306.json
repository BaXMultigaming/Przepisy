  "ingredients": [
    "1 pound spicy Italian sausage",
    "0.25 cup white wine",
    "0.5 onion, chopped",
    "0.5 cup sliced mushrooms",
    "0.5 green bell pepper, chopped",
    "0.25 cup red wine",
    "0.25 cup Italian seasoning",
    "1 teaspoon crushed red pepper",
    "6 bay leaves",
    "1 teaspoon dried oregano",
    "1 teaspoon onion powder",
    "1 teaspoon garlic powder",
    "1 teaspoon dried basil",
    "1 pinch dried rosemary",
    "1 teaspoon ground allspice",
    "1 teaspoon salt",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon dried sage",
    "0.5 teaspoon dried marjoram",
    "6 (8 ounce) cans tomato sauce",
    "2 (6 ounce) cans tomato paste",
    "0.25 cup brown sugar",
    "0.25 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Place sausage in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large pot combine white wine, onion, mushrooms and bell pepper. Cook on medium heat until vegetables are tender. Stir in red wine, Italian seasoning, crushed red pepper, bay leaves, oregano, onion powder, garlic powder, basil, rosemary, allspice, salt, thyme, sage, marjoram, tomato sauce, tomato paste and sausage. Reduce heat, cover and simmer for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in brown sugar and confectioners' sugar; simmer, uncovered, for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
