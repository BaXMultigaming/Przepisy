  "ingredients": [
    "1 (12 pound) bone-in ham, rump portion",
    "0.5 cup whole cloves",
    "1 cup packed brown sugar",
    "4 cups water, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place ham in a large roasting pan; press cloves into skin at 1- to 2-inch intervals.",
