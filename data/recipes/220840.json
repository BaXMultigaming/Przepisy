  "ingredients": [
    "0.25 cup seasoned rice vinegar",
    "1 teaspoon white sugar",
    "0.5 teaspoon vegetable oil",
    "0.25 teaspoon grated peeled ginger",
    "0.25 teaspoon salt",
    "1 cup sliced carrot",
    "2 tablespoons sliced green onion",
    "2 tablespoons minced red bell pepper",
    "0.5 cucumber - halved lengthwise, seeded, and sliced"
  ],
  "steps": [
    {
      "text": "Whisk rice vinegar, sugar, vegetable oil, ginger, and salt together in a bowl until sugar and salt are dissolved into a smooth dressing.",
