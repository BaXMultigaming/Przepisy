  "ingredients": [
    "1 pound ground pork",
    "1 onion, sliced",
    "2 carrots, peeled and sliced",
    "0.5 cup rice vinegar",
    "0.33333334326744 cup ketchup",
    "0.25 cup white sugar",
    "2 teaspoons soy sauce",
    "2 cups chopped broccoli",
    "1 green bell pepper, chopped"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over high heat. Add ground pork; cook and stir until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion and carrots; stir-fry over high heat, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix rice vinegar, ketchup, sugar, and soy sauce together in a bowl; stir into pork mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in broccoli and bell pepper; cover, reduce heat to medium, and cook until broccoli is tender, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
