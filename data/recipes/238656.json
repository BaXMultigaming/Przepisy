    "0.5 small head red cabbage, cored and thinly sliced",
    "2 sweet apples, cut into matchsticks",
    "1 small jicama, peeled and cut into matchsticks",
    "1 cup matchstick-cut carrots",
    "0.5 cup diced red onion",
