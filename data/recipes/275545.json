  "ingredients": [
    "1.5 pounds baby potatoes, halved",
    "0.5 teaspoon dried parsley",
    "0.25 teaspoon garlic powder",
    "salt and ground black pepper to taste",
    "1 tablespoon olive oil, or more as needed"
  ],
  "steps": [
    {
      "text": "Place a steamer insert into a saucepan and add enough water to reach the bottom of the steamer. Bring water to a boil. Add potatoes, cover, and steam until fork tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer potatoes to a bowl. Add parsley, garlic powder, salt, and pepper; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add potatoes to hot oil and cook, shaking the skillet occasionally, until potatoes are browned on all sides, about 10 minutes.",
      "section": null,
