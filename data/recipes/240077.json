  "ingredients": [
    "cooking spray",
    "4 cups cornbread mix (such as Marie Callender's®)",
    "1 tablespoon baking powder",
    "0.75 teaspoon pumpkin pie spice",
    "1 (15 ounce) can pumpkin puree",
    "1.5 cups water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Spray 21 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cornbread mix, baking powder, and pumpkin pie spice together in a large bowl. Add pumpkin puree and water to cornbread mixture; stir until batter is just-combined. Divide batter between prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
