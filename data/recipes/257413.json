  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "0.33333334326744 cup brown sugar",
    "1 pinch salt",
    "0.5 cup whole milk",
    "0.33333334326744 cup butter, melted",
    "1 teaspoon vanilla extract",
    "0.66666668653488 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Mix flour, white sugar, brown sugar, and salt together in a large bowl. Add milk, butter, and vanilla extract; stir with a wooden spoon until dough is combined. Fold in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out on a large piece of plastic wrap; roll into a log and wrap up tightly. Freeze until firm, about 1 hour. Cut dough with a wet knife; it will be sticky.",
      "section": null,
      "name": null,
      "url": null,
