  "ingredients": [
    "0.25 cup shortening, softened",
    "1 cup packed brown sugar",
    "1 egg",
    "0.5 cup hot coffee",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup raisins",
    "0.25 cup chopped nuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 13x9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat shortening and brown sugar with an electric mixer in a large bowl until smooth. Blend egg into the shortening mixture. Add hot coffee and stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, cinnamon, baking soda, and salt together in a separate bowl; stir into the shortening mixture. Fold raisins and chopped nuts into the batter; spread into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 18 to 20 minutes. Cool in the pan for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
