  "title": "Pan Fried Catfish Filets",
  "description": "Catfish rolled in cornmeal, cayenne pepper, onion powder and paprika, then fried in olive oil to a golden brown. Serve with lemon wedges.",
  "authors": [
    "EHOLT"
  ],
  "date_published": "2000-07-17T12:17:51-04:00",
