  "ingredients": [
    "1 cup cornmeal",
    "2 teaspoons ground cayenne pepper",
    "2 teaspoons paprika",
    "1 teaspoon onion powder",
    "0.33333334326744 cup extra virgin olive oil",
    "4 (4 ounce) fillets catfish",
    "1 cup milk",
    "4 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "In a mixing bowl, stir together cornmeal, cayenne pepper, paprika and onion powder. Mix well. Pour mixture onto a large sheet of waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk into a medium bowl. Dip catfish filets into milk and hold up and let the milk drip off. Roll the milk-soaked filet in the cornmeal mixture until completely covered. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry the garlic in the hot skillet, but do not burn. Add the coated catfish filets and cook for 5 to 7 minutes on each side, sprinkling salt on the fish after each turn. Cook until golden brown and fish flakes easily with a fork. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
