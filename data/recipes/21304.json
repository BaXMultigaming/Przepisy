  "ingredients": [
    "5 pounds potatoes, peeled",
    "1 onion",
    "3 eggs, beaten",
    "2.5 cups dry pancake mix",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper",
    "1 tablespoon vegetable oil"
  ],
  "steps": [
    {
      "text": "In a food processor grate potatoes and onion. In a large bowl combine potatoes, onions, eggs, pancake mix, salt and pepper.",
