  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "0.75 cup brown sugar",
    "0.5 cup unsweetened cocoa powder",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "1 cup water",
    "0.66666668653488 cup vegetable oil",
    "0.33333334326744 cup milk",
    "1 teaspoon vanilla extract",
    "0.5 cup confectioners' sugar",
    "3 tablespoons butter, softened",
    "2 tablespoons unsweetened cocoa powder",
    "1 tablespoon milk, or more to taste",
    "0.25 cup caramel ice cream topping, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the brownie cake layer: Stir flour, white sugar, brown sugar, cocoa powder, baking powder, and salt together in a large bowl. Pour in water, vegetable oil, milk, and vanilla extract; mix until well blended. Spread into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is dry and edges have started to pull away from the sides of the pan, about 30 minutes. Let cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the frosting: Stir confectioners' sugar, butter, and cocoa powder together in a bowl until smooth. Mix in enough milk to reach a spreading consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread frosting over cooled brownie cake layer; drizzle caramel topping on top. Cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
