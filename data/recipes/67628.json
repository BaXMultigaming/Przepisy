  "ingredients": [
    "1 pound cod fillets",
    "1 clove garlic, minced",
    "1 lemon, cut into wedges",
    "2 tablespoons butter, softened",
    "1 pinch salt and ground black pepper to taste",
    "2 tablespoons steak sauce",
    "4 hamburger buns, split and toasted",
    "2 tablespoons Ranch-style salad dressing"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fish fillets in a shallow baking dish. Sprinkle with garlic, then squeeze lemon juice over the top. Dot with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread steak sauce on the cut-side of the bottoms of buns. Top each with fish, then drizzle with ranch dressing. Cover with top buns to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
