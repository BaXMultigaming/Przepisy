        "https://www.allrecipes.com/thmb/rQaDRSjA9Wi9dRrR2IPaO1oQ00Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-229733-simple-roasted-butternut-squash-ddmfs-step-5-12c22d62e4614cd2b4b89e8e04c8bdd8.jpg"
