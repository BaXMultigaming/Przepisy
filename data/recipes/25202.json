  "ingredients": [
    "2 pounds beef chuck roast",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "4 ounces butter",
    "4 green onions, sliced (white parts only)",
    "4 tablespoons all-purpose flour",
    "1 (10.5 ounce) can condensed beef broth",
    "1 teaspoon prepared mustard",
    "1 (6 ounce) can sliced mushrooms, drained",
    "0.33333334326744 cup sour cream",
    "0.33333334326744 cup white wine",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Remove any fat and gristle from chuck roast; cut into strips ½-inch thick by 2-inches long. Season with ½ teaspoon salt and ½ teaspoon pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add beef and brown quickly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dfZ7t-7cyTi19cN2TuNH6ANNHs0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25202-beef-stroganoff-iii-ddmfs-step1-218-db058826c62e484b996c4809a280bdde.jpg"
      ],
      "image": "assets/images/25202/step_02.webp"
    },
    {
      "text": "Push beef to one side of the skillet. Add onions; cook and stir for 3 to 5 minutes, then push to the side with beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NJ0xhrOASIjxk6nWDmh21-7J870=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25202beef-stroganoff-iii-ddmfs-step2-219-54469acc908346fc8687281b14bc91a7.jpg"
      ],
      "image": "assets/images/25202/step_03.webp"
    },
    {
      "text": "Stir flour into pan juices on the empty side of the pan. Pour in beef broth and bring to a boil, stirring constantly. Reduce heat to low and stir in mustard. Cover and simmer until beef is tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OB_F21QC22Gl7UxlJiH19kH05kU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25202beef-stroganoff-iii-ddmfs-step3-220copy-0a4e17d5237440488419ad5fd19fdef6.jpg"
      ],
      "image": "assets/images/25202/step_04.webp"
    },
    {
      "text": "Five minutes before serving, stir in mushrooms, sour cream, and white wine. Cook until heated through; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5VtMuz2bNNU2H4MxlntwfTcCHGg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25202beef-stroganoff-iii-ddmfs-step4-0842_X-7c56fbd04fb64c99a6c0a4a2e02b1bef.jpg"
      ],
      "image": "assets/images/25202/step_05.webp"
    },
    {
      "text": "Enjoy served over hot cooked noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mSWde3PHTu-fDkbvWBw0D1JlS8U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25202beef-stroganoff-iii-ddmfs-3x4-233-0f26fa477e9c446b970a32502468efc6.jpg"
