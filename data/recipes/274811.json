  "ingredients": [
    "8 ounces halloumi cheese, sliced",
    "1 tablespoon Sriracha sauce",
    "2 teaspoons olive oil",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon black pepper"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Sriracha, olive oil, garlic powder, and black pepper in a shallow bowl. Dip each halloumi cheese slice into Sriracha mixture and let rest 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place each halloumi slice on the hot grill and cook for 3 minutes. Carefully flip slices and cook an additional 3 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
