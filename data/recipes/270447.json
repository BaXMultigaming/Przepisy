  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour and salt together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine shortening, confectioners' sugar, cherry juice, red food coloring, almond extract, and cherry flavoring in a large bowl. Add flour mixture and mix well. Stir in maraschino cherries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 1-inch balls. Arrange 2 inches apart on ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are light golden brown, 8 to 10 minutes. Immediately press a chocolate kiss into the top of each cookie. Transfer cookies to wire racks to cool completely.",
