  "ingredients": [
    "1 (9 inch) refrigerated rolled pie pastry",
    "0.75 cup white sugar",
    "0.33333334326744 cup all-purpose flour",
    "1 tablespoon lemon juice",
    "2 teaspoons grated lemon zest",
    "5 cups fresh blueberries",
    "0.75 cup rolled oats",
    "0.66666668653488 cup packed brown sugar",
    "0.5 cup all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "6 tablespoons cold unsalted butter, cut into pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the pie: Press pie pastry into the bottom and up the sides of a 9-inch pie plate to form a crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar and flour together in a large bowl. Mix in lemon juice and zest, then gently stir in blueberries. Pour mixture into crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the topping: Combine oats, brown sugar, flour, and cinnamon in a medium bowl. Cut in cold butter with two knives or a pastry blender until the mixture resembles coarse crumbs. Spread topping evenly over pie filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is bubbly and topping is golden brown, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and cool on a wire rack before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
