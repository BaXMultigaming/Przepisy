  "ingredients": [
    "1 quart oil for deep frying",
    "6 (6 ounce) fillets pork sirloin",
    "2 cups dry bread crumbs",
    "1 cup cake flour",
    "2 eggs",
    "0.25 cup milk",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place filets on a solid, level surface and pound with the smooth side of a meat mallet until ⅛- to ¼-inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread crumbs and flour in two separate shallow dishes, such as soup plates. Lightly beat eggs in a third shallow dish; add milk and lightly season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge filets in flour, patting lightly by hand. Dip into egg mixture, using a fork to hold filets; let excess drip off. Press into bread crumbs to coat both sides filets. Place breaded filets, unstacked, onto a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Deep fry filets until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
