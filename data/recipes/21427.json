  "title": "Vienna Schnitzel",
  "description": "This Vienna schnitzel recipe includes pounded pork filets breaded in cake flour, beaten eggs with milk, and bread crumbs and deep-fried to perfection.",
  "authors": [
    "FRANKHA"
  ],
  "date_published": "2000-03-26T17:21:27-05:00",
