        "https://www.allrecipes.com/thmb/vHKsakvxq2tepmQ_zEe-wKNxtq8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223597-old-fashioned-potato-cakes-DDMFS-034-4x3-step-02-90e5eae4c8cd44bf8b07a4bd03e81b2e.jpg"
