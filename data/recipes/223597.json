  "ingredients": [
    "2 cups mashed potatoes",
    "1 cup all-purpose flour",
    "1 onion, diced",
    "1 egg",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "0.5 cup vegetable oil, or as needed"
  ],
  "steps": [
