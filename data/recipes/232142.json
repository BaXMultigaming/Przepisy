  "ingredients": [
    "3 eggs",
    "2 cups cinnamon applesauce",
    "1 cup peanut butter",
    "0.5 cup brown sugar",
    "2 teaspoons vanilla extract",
    "3 cups rolled oats",
    "1 cup all-purpose flour",
    "1 cup flax seed meal",
    "0.5 cup whole wheat flour",
    "1.5 teaspoons baking soda",
    "1.5 teaspoons ground cinnamon",
    "2 apples - peeled, cored, and cut into small cubes"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, applesauce, peanut butter, brown sugar, and vanilla extract in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, all-purpose flour, flax seed meal, whole wheat flour, baking soda, and cinnamon in another bowl. Stir egg mixture into oat mixture and add apples; mix until evenly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into golf ball-sized balls and place 2 inches apart onto baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until cookies are golden, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
