  "ingredients": [
    "1 (8 ounce) bottle buffalo wing sauce",
    "1 (1 ounce) package ranch dressing mix",
    "1.5 tablespoons lemon pepper",
    "seasoned salt",
    "4 cups pumpkin seeds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line baking sheet with wax paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine buffalo sauce, ranch seasoning, lemon pepper, and salt in a small bowl. Toss pumpkin seeds in mixture until evenly coated. Spread on the prepared sheet in an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring every 15 minutes, until seeds are golden brown and crunchy, about 45 minutes.",
