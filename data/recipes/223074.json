    "publisher-tested"
  ],
  "ingredients": [
    "1 (10 ounce) fillet arctic char, rinsed and patted dry",
    "sea salt to taste",
    "1 lime, zested and juiced",
    "0.25 cup olive oil",
    "0.25 cup sherry wine",
    "3 sprigs rosemary, leaves stripped",
    "2 cloves garlic",
    "0.25 teaspoon cayenne pepper, or to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rkRalF93IWPvc-O8nHMDKCQT0_c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_223074_OhMyArticChar_Step1_14729-b2f7b3ff054c459fb8467d8a72a6da7a.jpg"
      ],
      "image": "assets/images/223074/step_01.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season arctic char with sea salt, place in the prepared baking dish, and sprinkle with lime zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UiewbW6SuEHQg72q7I6pzSh-q4Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_223074_OhMyArticChar_Step2_14731-0b30feb2d6ba40e7ad65f8880ad59d47.jpg"
      ],
      "image": "assets/images/223074/step_03.webp"
    },
    {
      "text": "Combine lime juice, olive oil, sherry, rosemary, and garlic in a food processor; pulse until garlic is finely chopped.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/94G3uQoutxCZixg5AYOXzt0RQd8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_223074_OhMyArticChar_Step3_14737-54ac028d45ff4dbeb06aa0060b381391.jpg"
      ],
      "image": "assets/images/223074/step_04.webp"
    },
    {
      "text": "Spread mixture over fish; season with cayenne pepper and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rZmwIrBGceNjC4vc3LYDKbi_NRU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_223074_OhMyArticChar_Step5_14742-9e9b71a546274919ac90593395a2fd42.jpg"
      ],
      "image": "assets/images/223074/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 12 to 15 minutes, basting with pan juices about halfway through. When fish is close to being fully cooked, switch the oven to broil. Cook until the top is browned, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l0eDS43GC_sXSwbxauKjt4VTY6Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_223074_OhMyArticChar_Step6_14749-997e3419eb00474c8dd16778bd8e220c.jpg"
      ],
      "image": "assets/images/223074/step_06.webp"
    }
