  "ingredients": [
    "0.5 cup butter, softened",
    "1 cup white sugar",
    "2 eggs, beaten",
    "1 cup sour cream",
    "1 teaspoon baking soda",
    "1.5 teaspoons baking powder",
    "1.5 cups all-purpose flour",
    "1 teaspoon vanilla extract",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix flour, baking powder, baking soda and chocolate chips. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream butter and sugar until light. Add eggs and mix thoroughly. Add sour cream and vanilla extract; mix well. Add flour mixture and mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into 9 inch pan and bake at 350 degrees F (175 degrees C) for 30 minutes or until golden brown and springy on the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
