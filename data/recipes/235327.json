  "ingredients": [
    "1 teaspoon paprika",
    "1 teaspoon dried oregano",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 (3.5 pound) eye of round roast",
    "6 Yukon Gold potatoes, peeled and quartered",
    "2 carrots, cut into 2-inch pieces",
    "2 stalks celery, diced",
    "2 sweet onions, diced",
    "1 cup beef broth",
    "0.5 cup Marsala wine",
    "1 (1.2 ounce) package dry beef gravy mix",
    "1 tablespoon all-purpose flour"
  ],
  "steps": [
    {
      "text": "Mix paprika, oregano, garlic powder, onion powder, salt, and black pepper together in a bowl; rub evenly over roast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5nuZQegFnCiIcCWP1y7U8kPW2XU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235327-SlowCookerEyeOfRoundRoastWithVegtables-ddmfs-step1-0032-4x3-3f2b6a54b98543d4a55586a2186bd770.jpg"
      ],
      "image": "assets/images/235327/step_01.webp"
    },
    {
      "text": "Arrange potatoes, carrots, celery, and onions in the bottom of a slow cooker. Place roast atop vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UUyVEKBq7KZv2DblPIdqJslIurE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235327-SlowCookerEyeOfRoundRoastWithVegtables-ddmfs-step2-0036-4x3-f3e3c38769ef432daed55ea8a2c21ed2.jpg"
      ],
      "image": "assets/images/235327/step_02.webp"
    },
    {
      "text": "Whisk beef broth, Marsala wine, and gravy mix together in a bowl; pour over roast and vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SzQSO4YPK9AH_Dg-L0Q6Uo26hAw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235327-SlowCookerEyeOfRoundRoastWithVegtables-ddmfs-step3-0038-4x3-236008df4bfa47c9abc47c1986bd0deb.jpg"
      ],
      "image": "assets/images/235327/step_03.webp"
    },
    {
      "text": "Cook on Low until meat is fully cooked and vegetables are tender, about 8 hours or on High for 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain sauce into a bowl and whisk with flour until thickened. Serve on the side of roast and vegetables.",
