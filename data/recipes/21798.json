  "ingredients": [
    "3 tablespoons butter",
    "0.75 cup minced onion",
    "3 tablespoons all-purpose flour",
    "2 teaspoons Worcestershire sauce",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 pounds crabmeat, flaked",
    "3.5 cups milk",
    "0.67 cup heavy cream"
  ],
  "steps": [
    {
      "text": "In a stockpot over medium heat, melt butter and saute onions until translucent. Whisk in flour and Worcestershire sauce until smooth. Season with salt and pepper. Thin with some of the milk if necessary. Add crabmeat and saute for 2 to 3 minutes. Whisk in milk and heavy cream. Heat and simmer 5 minutes.",
