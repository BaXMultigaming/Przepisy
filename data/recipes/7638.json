  "ingredients": [
    "0.5 cup butter, softened",
    "0.125 teaspoon salt",
    "4 cups confectioners' sugar",
    "2 egg yolks, beaten",
    "1 teaspoon vanilla extract",
    "2 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Cream butter until soft. Add salt and part of the sugar gradually, blending after each addition. Then add egg yolks and vanilla; blend well. Add remaining sugar, alternately with milk, until preferred consistency for spreading is reached, beating after each addition until smooth.",
