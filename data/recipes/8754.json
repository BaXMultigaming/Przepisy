  "ingredients": [
    "6 bone-in chicken breast halves",
    "1 pinch salt to taste",
    "1 cup apricot preserves",
    "1 tablespoon distilled white vinegar",
    "1 tablespoon brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
