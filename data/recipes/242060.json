  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 cup butter",
    "1 cup light brown sugar",
    "2 eggs, beaten",
    "1 cup chocolate chips",
    "1 cup quinoa flakes",
    "0.5 cup oat bran",
    "0.25 cup light cream"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a baking sheet with baking parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, and baking soda together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and brown sugar with an electric mixer in a large bowl until smooth. Beat 1 egg into butter mixture. Beat second egg into mixture along with the vanilla extract; add flour mixture and stir until it just forms a batter. Fold chocolate chips, quinoa flakes, oat bran, and cream through the batter to distribute throughout.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into small balls and arrange on prepared baking sheet with at least 2 inches between balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until lightly browned, about 10 minutes. Let cookies cool on pan for 10 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
