  "title": "Cordon Bleu Chicken Rolls",
  "description": "Breaded chicken stuffed with ham and cheese tastes extraordinary. This cordon bleu chicken recipe is the best with an easy cream sauce to boot.",
  "authors": [
    "Michelle"
  ],
  "date_published": "1999-05-10T16:14:53-04:00",
