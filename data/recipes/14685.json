        "https://www.allrecipes.com/thmb/7IfcnKPaCN1-rWNyDkO1ejSId9I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14685-slow-cooker-beef-stew-step-4-mfs-306-2bbee3ab787c4d1ab17621d901235e66.jpg"
