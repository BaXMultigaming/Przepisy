  "ingredients": [
    "4 boneless pork chops",
    "0.5 cup lemon juice",
    "0.5 cup Worcestershire sauce",
    "0.5 cup vegetable oil",
    "1 tablespoon minced garlic"
  ],
  "steps": [
    {
      "text": "Combine the pork chops, lemon juice, Worcestershire sauce, vegetable oil, and garlic in a large resealable plastic bag. Squeeze as much excess air from bag as possible. Marinate in refrigerator 4 to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat, and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the pork chops from the marinade directly to the grill. Discard the marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until the pork is no longer pink in the center, about 5 minutes per side. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
