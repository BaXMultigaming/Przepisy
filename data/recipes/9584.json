  "ingredients": [
    "2.25 cups all-purpose flour",
    "2 teaspoons ground ginger",
    "2 teaspoons baking soda",
    "0.5 teaspoon salt",
    "1 cup packed brown sugar",
    "0.75 cup unsalted butter, softened",
    "0.25 cup molasses",
    "1 large egg",
    "0.5 cup chopped crystallized ginger",
    "1.5 tablespoons minced fresh ginger root"
  ],
  "steps": [
    {
      "text": "Whisk flour, ginger, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter in a large bowl with an electric mixer until smooth and creamy. Mix in egg and molasses. Gradually stir in flour mixture with a wooden spoon. Stir in crystallized and fresh ginger. Cover and refrigerate for at least 2 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to bake, preheat the oven to 350 degrees F (175 degrees C). Roll chilled dough into 1-inch balls and place about 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 10 minutes. Remove from the oven and transfer to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
