  "ingredients": [
    "0.5 cup vegetable oil",
    "3 tablespoons red wine vinegar",
    "1 clove garlic, minced",
    "1 teaspoon dried basil",
    "0.125 teaspoon crushed red pepper flakes",
    "1 teaspoon salt",
    "6 ounces macaroni",
    "0.25 cup grated Parmesan cheese",
    "2 cups broccoli florets",
    "4 ounces sliced pepperoni sausage",
    "10 cherry tomatoes, halved",
    "0.5 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Cook pasta in a pot of boiling salted water until al dente. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large bowl, stir together oil, vinegar, garlic, basil, and salt and pepper. Toss with warm macaroni to coat well. Toss with Parmesan. Cover, and refrigerate 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add broccoli, pepperoni, and tomatoes; toss well. Sprinkle with mozzarella cheese, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
