  "ingredients": [
    "12 ounces tortilla chips",
    "1.5 cups shredded sharp Cheddar cheese",
    "2 cups cooked pulled pork",
    "0.75 cup barbeque sauce",
    "0.125 red onion, finely sliced",
    "0.5 cup diced bread-and-butter pickles"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread tortilla chips across the bottom of a sheet pan. Sprinkle with Cheddar cheese. Spread pulled pork evenly on top. Spoon BBQ sauce over pork and top with red onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, about 5 minutes. Top with chopped pickles and serve.",
