  "ingredients": [
    "2 tablespoons butter",
    "1 medium onion, chopped",
    "1 pound kohlrabi, peeled and cut into 1/2-inch dice",
    "2.5 cups vegetable broth",
    "2.5 cups milk",
    "1 large bay leaf",
    "salt and ground black pepper to taste",
    "0.25 cup uncooked orzo pasta"
  ],
  "steps": [
    {
      "text": "Melt butter in a large stockpot over medium-low heat. Cook and stir onion in melted butter until soft, about 10 minutes. Add kohlrabi; cook and stir for 2 minutes. Add broth, milk, and bay leaf; bring to a boil. Reduce the heat to low, cover, and simmer until kohlrabi is tender, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove and discard bay leaf. Blend soup with an immersion blender. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add orzo, cover, and simmer until orzo is tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
