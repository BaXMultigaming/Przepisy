  "ingredients": [
    "8 ounces cream cheese, softened",
    "4 jalapeno peppers, seeded and diced",
    "1 cup shredded cooked chicken",
    "1 green onion, chopped",
    "0.5 cup real bacon bits",
    "0.5 cup water",
    "1 cup shredded Cheddar cheese",
    "0.5 cup sour cream"
  ],
  "steps": [
    {
      "text": "Combine cream cheese, jalapeno peppers, chicken, green onion, bacon bits, and water in a multi-functional pressure cooker (such as Instant Pot®). Close and lock the lid. Select Manual; set timer for 5 minutes. Allow 10 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Add Cheddar cheese and sour cream. Stir until cheese is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer dip to a serving dish and garnish with additional jalapenos, bacon bits, and Cheddar cheese if desired.",
      "section": null,
      "name": null,
