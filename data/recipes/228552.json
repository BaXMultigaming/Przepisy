  "ingredients": [
    "1 cup brown sugar",
    "0.5 cup butter",
    "2 tablespoons light corn syrup",
    "0.25 cup pecan halves",
    "1 apple, sliced",
    "12 slices bread",
    "6 eggs, beaten",
    "1.5 cups milk",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat brown sugar, butter, and corn syrup in a saucepan over medium heat until thickened, about 5 minutes. Pour mixture into prepared baking dish and sprinkle with pecans. Arrange apple slices over pecans. Layer bread slices over apple in two layers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, milk, vanilla extract, almond extract, and salt in a bowl; pour over bread and allow to set for 1 hour at room temperature or cover and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Uncover and bake in preheated oven until fluffy and golden brown, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
