  "title": "Caramel French Toast",
  "description": "Apple slices and pecans are layered between a sweet and buttery caramel sauce and fluffy bread slices in this kid-pleasing breakfast treat.",
  "authors": [
    "mikeandjenn"
  ],
  "date_published": "2020-03-05T00:09:21-05:00",
