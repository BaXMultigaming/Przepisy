  "ingredients": [
    "2 Cornish game hens",
    "1 (10.75 ounce) can golden mushroom soup (such as Campbell's®), divided",
    "2 cups chopped baby portobello mushrooms",
    "1 large zucchini, chopped",
    "1 (7 ounce) jar pimento-stuffed green olives, drained and chopped",
    "1 teaspoon garlic salt"
  ],
  "steps": [
    {
      "text": "Coat hens with about 1/4 mushroom soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 3/4 mushroom soup, portobello mushrooms, zucchini, olives, and garlic salt in a bowl; stuff mixture inside hens. Arrange hens, breast-sides up, in a slow cooker. Spoon any remaining soup mixture over hens.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover slow cooker. Cook on High for 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
