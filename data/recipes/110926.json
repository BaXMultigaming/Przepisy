  "ingredients": [
    "1 cup almond flour",
    "1 teaspoon baking soda",
    "1 pinch salt",
    "4 eggs",
    "0.25 cup honey",
    "1 teaspoon vanilla extract",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to the manufacturer's instructions.",
      "section": null,
      "name": null,
