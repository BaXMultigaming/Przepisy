  "title": "Chinese Pepper Steak",
  "description": "This easy and delicious pepper steak recipe combines top sirloin beef with a sweet-and-savory soy sauce marinade, green pepper, onion, and tomatoes.",
  "authors": [
    "Kim"
  ],
  "date_published": "2020-06-18T23:37:04-04:00",
