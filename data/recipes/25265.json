  "ingredients": [
    "2 cups shredded potatoes",
    "1 cup shredded yellow squash",
    "0.5 cup chopped onion",
    "1 egg",
    "4 tablespoons self-rising flour",
    "0.25 teaspoon garlic salt",
    "salt and pepper to taste",
    "0.25 cup cooking oil"
  ],
  "steps": [
    {
      "text": "In a large bowl, combine potatoes, squash, onion, egg, flour, garlic salt, salt, and pepper. If the batter is too thin, add more flour; if too thick, add milk. Form batter into 3-inch patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bottom of a large skillet with just enough oil to cover the bottom of the pan, and heat over medium-high heat. Place patties in hot oil, and cook until golden brown on each side; drain on paper towels.",
      "section": null,
