  "ingredients": [
    "1.3333333730698 cups heavy cream",
    "0.5 cup powdered sugar",
    "0.33333334326744 cup unsweetened cocoa powder",
    "0.66666668653488 cup Philadelphia Whipped Cream Cheese KFT",
    "2 tablespoons powdered sugar",
    "0.5 teaspoon almond extract",
    "1 tablespoon grated chocolate"
