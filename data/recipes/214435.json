  "ingredients": [
    "1 (1 pound) package Hillshire Farm® Smoked Sausage",
    "1 (20 ounce) package refrigerated shredded hash brown potatoes",
    "2 cups shredded Cheddar cheese",
    "1 cup sour cream",
    "1 medium onion, chopped",
    "0.25 cup butter or margarine, melted",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly spray a 13x9-inch baking pan with a non-stick cooking spray. Cut sausage into 1/2-inch cubes. Combine all ingredients in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread mixture evenly in the prepared pan. Bake for 40 to 45 minutes or until lightly browned. Let stand 5 minutes before serving.",
      "section": null,
