  "ingredients": [
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.75 teaspoon salt",
    "3 tablespoons shortening",
    "0.75 cup milk"
  ],
  "steps": [
    {
      "text": "Whisk flour, baking powder, and salt together in a mixing bowl. Cut in shortening with a knife or pastry blender until mixture resembles fine crumbs. Stir milk into flour mixture until moistened. Dough will be pretty lumpy, but be sure to not over mix it!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by large spoonfuls onto any simmering stew. The dumplings should rest on top of vegetables and meat; it's okay if they stick out of the top a bit. Cook uncovered for 10 minutes; cover and cook another 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
