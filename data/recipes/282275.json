  "ingredients": [
    "2 tablespoons Country Crock® Spread",
    "6 cups fresh corn kernels",
    "0.5 teaspoon salt",
    "2 medium fresh jalapeno peppers, seeded and chopped",
    "2 cloves garlic, chopped",
    "1 teaspoon ground cumin",
    "0.25 cup mayonnaise",
    "0.25 cup chopped cilantro",
    "2 tablespoons grated cotija cheese",
    "2 tablespoons lime juice"
  ],
  "steps": [
    {
      "text": "Melt Country Crock in a large nonstick skillet over high heat. Working in batches if necessary to avoid overcrowding the skillet, add corn and salt. Cook and stir until slightly charred, about 5 minutes. Add jalapeños, garlic, and cumin; cook until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in mayonnaise, cilantro, cotija cheese, and lime juice. Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
