  "ingredients": [
    "15.25 ounces chocolate fudge cake mix (such as Betty Crocker®)",
    "0.5 cup salted butter, melted",
    "4 eggs, divided",
    "1 teaspoon vanilla extract",
    "1 (8 ounce) package cream cheese, softened",
    "5 tablespoons cocoa powder",
    "4 cups powdered sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cake mix, butter, 2 eggs, and vanilla extract in a bowl. Pat into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese, cocoa powder, and remaining eggs together in another bowl with an electric mixer. Beat in powdered sugar slowly. Pour over cake layer in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes. Let cool.",
      "section": null,
      "name": null,
