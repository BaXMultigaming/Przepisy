  "ingredients": [
    "0.5 cup flour",
    "1 teaspoon chopped fresh thyme",
    "0.75 teaspoon white sugar",
    "0.75 teaspoon salt, divided",
    "1 pinch fresh ground black pepper",
    "1.25 cups milk",
    "3 large eggs",
    "1 tablespoon lemon zest",
    "2 tablespoons butter",
    "1 pound fresh asparagus, trimmed and cut into 2-inch pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, thyme, sugar, 1/2 teaspoon salt, and pepper in a large bowl. Whisk in milk, then whisk in eggs and lemon zest until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a heavy skillet over medium heat. Add asparagus and remaining 1/4 teaspoon salt; cook, stirring occasionally, until asparagus is dark green and coated with butter, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer asparagus to the prepared pan and pour batter evenly over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is puffed and the edges are browned, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
