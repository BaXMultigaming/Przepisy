  "ingredients": [
    "0.25 cup chia seeds",
    "1 banana",
    "2 dates, pitted",
    "1 cup almond milk",
    "0.25 teaspoon ground cinnamon",
    "salt to taste",
    "0.25 cup fresh blueberries, or more to taste"
  ],
  "steps": [
    {
      "text": "Place chia seeds in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer banana and dates in a blender; add almond milk, cinnamon, and salt. Blend mixture until smooth and pour over chia seeds, stirring well. Let mixture sit until thickened, at least 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chia \"porridge\" and top with blueberries.",
      "section": null,
