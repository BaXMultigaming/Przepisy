  "ingredients": [
    "12 fresh figs, halved",
    "4 ounces herbed goat cheese (chevre)",
    "24 almonds",
    "1 tablespoon honey",
    "2 teaspoons balsamic vinegar"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler to high.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fig halves, cut sides-up, onto a baking sheet; top each fig with about ½ teaspoon goat cheese. Place 1 almond on each goat cheese dollop; push slightly into each fig.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until cheese is soft and almonds turn a rich shade of brown, 2 to 3 minutes. Cool for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange figs on a serving platter; drizzle with honey and balsamic vinegar. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
