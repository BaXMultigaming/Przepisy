  "ingredients": [
    "5 slices bacon",
    "0.5 cup slivered almonds",
    "0.25 cup butter",
    "1 (16 ounce) package frozen cut green beans"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet over medium-high heat. Cook until browned on one side, then turn over to cook on the other side. Add almonds to the skillet at this time; cook and stir until almonds are light golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove bacon to a paper towel-lined plate, leaving bacon drippings in the skillet. Crumble or chop bacon, then return to the skillet. Melt butter in with drippings. Add green beans; cook and stir until tender, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
