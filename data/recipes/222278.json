  "ingredients": [
    "3 pounds ground beef",
    "3 onions, minced, divided",
    "1 pound shredded pepperjack cheese",
    "1.5 cups bread crumbs",
    "4 eggs",
    "2 tomatoes, chopped and juices strained",
    "2 bunches cilantro, chopped",
    "3 limes, juiced, divided",
    "1 serrano chile pepper, minced, divided",
    "5 avocados, peeled and pitted",
    "salt and ground black pepper to taste",
    "12 hamburger buns",
    "1 head iceberg lettuce, cored and shredded"
  ],
  "steps": [
    {
      "text": "Combine ground beef, ½ onions, pepper Jack cheese, bread crumbs, and eggs in a bowl; form into 12 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tomatoes, ½ remaining onions, cilantro, ½ lime juice, and ½ serrano in a bowl; stir well. Cover pico de gallo; refrigerate to chill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash avocados, remaining ½ onions, remaining ½ lime juice, and remaining ½ serrano together in a bowl; season guacamole with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium-high heat. Add patties; cook to desired doneness, 3 to 5 minutes per side. An instant-read thermometer inserted into centers should read 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 burger on each bun; top with guacamole, shredded lettuce, and pico de gallo.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
