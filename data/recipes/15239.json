  "ingredients": [
    "1 (9 inch) pie shell",
    "1 cup pumpkin puree",
    "3 eggs",
    "1 tablespoon all-purpose flour",
    "0.25 cup packed light brown sugar",
    "0.5 cup white sugar",
    "0.5 teaspoon salt",
    "0.33331999182701 teaspoon ground nutmeg",
    "0.5 teaspoon ground cinnamon",
    "2 cups milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl combine pumpkin, eggs, flour, brown sugar, white sugar, salt, nutmeg, cinnamon, and milk. Beat until smooth. Pour into pastry-lined pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 50 minutes, or until set in center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
