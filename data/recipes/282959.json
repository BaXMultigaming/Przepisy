  "ingredients": [
    "1 tablespoon olive oil",
    "2 tablespoons chili powder",
    "2 teaspoons ground paprika",
    "1.5 teaspoons ground cumin",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "4 (5 ounce) boneless, skinless chicken thighs",
    "3 cups chicken stock",
    "1 chipotle pepper in adobo sauce, or more to taste",
    "0.25 cup tomato paste, or to taste"
  ],
  "steps": [
    {
      "text": "Place olive oil in the bottom of a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chili powder, paprika, cumin, garlic powder, onion powder, salt, and pepper together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub chicken thighs with some of the spice rub and place in the slow cooker. Cover with chicken broth. Add remaining spice mixture and chipotle pepper in adobo and stir until incorporated. Mix in tomato paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook until chicken is no longer pink in the centers and juices run clear, on Low, 7 to 8 hours, or High, 4 to 5 hours. An instant-read thermometer inserted into the center of a thigh should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When you're ready to serve, take chicken out and shred with forks. Place back in the sauce and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
