        "https://www.allrecipes.com/thmb/-z5B0xTYq99nHxB4v0ubG9ibgLk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-57947-Authentic-Huevos-Rancheros-gw-ddmfs-beauty-4x3-a9b4185d42ac4e0baabf54d311b551aa.jpg"
