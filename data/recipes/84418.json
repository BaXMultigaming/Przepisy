  "ingredients": [
    "2 cups cottage cheese",
    "3 eggs, beaten",
    "3 (10 ounce) packages chopped frozen spinach, thawed and squeezed dry",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground nutmeg",
    "1.5 cups shredded Cheddar cheese, divided"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease sides and bottom of an 8 inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the cottage cheese and eggs. Stir in spinach, salt, nutmeg, and 11/4 cups of shredded Cheddar cheese. Mix until well blended. Spread evenly into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 45 minutes, or until firm. Remove from oven, and sprinkle with remaining cheese. Allow to rest for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
