  "ingredients": [
    "1 pound fresh, ground pork sausage",
    "1 onion, thinly sliced",
    "1.5 cups Cheddar cheese, shredded",
    "4 slices bread",
    "6 eggs",
    "2 cups milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a skillet, brown the sausage, drain and place in a square casserole dish. Cover top of sausage with onion slices. Cover top of onion with cheese. Place 4 slices of bread on top of the cheese. Bread should fit exactly to cover top of the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix eggs and milk in a bowl and slowly pour over top of bread, mixture should fill dish almost to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated oven for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
