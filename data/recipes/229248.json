  "ingredients": [
    "1 pound lean ground beef",
    "1 small onion, chopped",
    "2 cloves garlic, minced",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 cup vegetable broth",
    "0.5 cup tomato-vegetable juice cocktail",
    "2 tablespoons sherry wine",
    "2 teaspoons Worcestershire sauce",
    "4 potatoes, peeled and diced",
    "1 (8 ounce) can whole kernel corn, drained",
    "1 cup frozen green peas, thawed",
    "1 cup diced carrots",
    "1 (4.5 ounce) can mushroom pieces and stems, drained",
    "1 teaspoon dried celery flakes",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon dried marjoram",
    "0.5 teaspoon dried thyme"
  ],
  "steps": [
    {
      "text": "Cook and stir ground beef, onion, and garlic in a skillet over medium heat until beef completely browned, about 10 minutes. Drain excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add mushroom soup, vegetable broth, tomato-vegetable juice, sherry, and Worcestershire sauce to a slow cooker; stir to combine. Add beef mixture; stir in potatoes, corn, peas, carrots, mushroom pieces, celery flakes, salt, black pepper, marjoram, and thyme. Cover slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until vegetables are tender and sauce is thickened, about 8 hours; or cook on High for 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
