  "ingredients": [
    "4 thick cut pork chops",
    "2 cups graham cracker crumbs",
    "1 teaspoon ground cinnamon",
    "1 teaspoon curry powder",
    "0.5 teaspoon dried rosemary",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse pork chops; pat dry. Combine graham cracker crumbs, cinnamon, curry powder, rosemary, salt, and black pepper in a large resealable plastic bag. Dip 1 pork chop in egg; allow excess to drip off. Place in plastic bag; shake to coat. Place pork chop in a 9x13-inch baking dish. Repeat with remaining pork chops, egg, and graham cracker mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until pork is no longer pink in the center, about 40 minutes. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
