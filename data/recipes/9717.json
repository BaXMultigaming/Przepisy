  "ingredients": [
    "8 egg whites",
    "1.75 cups white sugar",
    "2.5 cups hazelnuts, skinned and chopped",
    "2.5 cups chopped almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (160 degrees C). Grease cookies sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat egg whites until frothy. Add sugar and beat until mixture is thick and white. Stir in chopped almonds and chopped hazelnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into saucepan over low heat, stirring with a wooden spoon until thick and beige, about 10 minutes. Drop dough by teaspoonfuls onto cookie sheets about 1 inch apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake about 20 minutes, until cookies are dry to the touch. Let cool on wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
