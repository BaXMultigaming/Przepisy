  "ingredients": [
    "cooking spray",
    "1 pound fresh okra",
    "0.25 cup canola oil",
    "1 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate. Coat a grill basket with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Trim okra stems close to tops without piercing pods; place in a large bowl. Drizzle okra with oil; season with garlic powder, salt, and black pepper and toss to coat. Spread okra in the prepared grill basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, flipping frequently, until tender and browned in spots, 4 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
