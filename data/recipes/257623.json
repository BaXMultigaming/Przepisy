  "ingredients": [
    "6 honeydew wedges, cut into cubes",
    "1 cup water",
    "8 ice cubes",
    "2 tablespoons white sugar",
    "2 tablespoons hot water",
    "0.25 cup chocolate syrup"
  ],
  "steps": [
    {
      "text": "Place honeydew in a blender and top with 1 cup water. Blend until juice smooth, about 2 minutes. Add ice cubes and blend for 2 minutes more. Pour honeydew juice into 2 glasses.",
