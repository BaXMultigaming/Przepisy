  "ingredients": [
    "1.75 cups fresh figs",
    "3 eggs",
    "0.5 cup applesauce",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "0.25 cup flax seed meal",
    "1 teaspoon ground cinnamon",
    "1 teaspoon pumpkin pie spice",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "1 cup all-purpose flour",
    "1.25 cups old-fashioned oats"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 24 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ½ figs in a blender; blend until smooth. Chop remaining ½ figs with a knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, applesauce, white sugar, and brown sugar together in a bowl with an electric mixer until frothy; beat in blended and chopped figs, flaxseed meal, cinnamon, pumpkin pie spice, baking soda, and baking powder until blended. Gradually beat in flour with mixer on low speed; fold in oats until incorporated. Divide batter among the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
