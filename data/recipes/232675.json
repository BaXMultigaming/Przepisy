  "steps": [
    {
      "text": "Line a large baking sheet with 2 sheets aluminum foil, making sure the sheet is completely covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bacon strips 1/2-inch apart on the prepared baking sheet. Place in the cold oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the oven to 425 degrees F (220 degrees C). Cook bacon for 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
