  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup whole wheat pastry flour",
    "1 cup quick-cooking oats",
    "0.5 cup 5-grain hot cereal mix",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup butter, softened",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "2 eggs",
    "0.5 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk all-purpose flour, whole wheat pastry flour, oats, 5-grain cereal, baking powder, baking soda, and salt together in a bowl. Mix butter with white and brown sugar in a separate large bowl until mixture is smooth and creamy. Beat eggs into creamed mixture with an electric mixer until thoroughly combined. Gradually beat dry ingredients into moist ingredients to make a dough. Stir chocolate chips into dough. Drop batter by heaping teaspoonfuls onto prepared baking sheets, keeping cookies about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are lightly browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
