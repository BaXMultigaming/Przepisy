  "ingredients": [
    "0.5 cup salt",
    "0.5 teaspoon white sugar",
    "1 teaspoon dried oregano",
    "0.5 teaspoon celery seed",
    "0.5 teaspoon paprika",
    "0.25 teaspoon ground thyme",
    "1 pinch ground turmeric",
    "0.25 teaspoon curry powder",
    "1 teaspoon chili powder",
    "0.5 teaspoon dried marjoram",
    "1 teaspoon ground mustard"
  ],
  "steps": [
    {
      "text": "Pour the salt into a small mixing bowl. Whisk in the sugar, oregano, celery seed, paprika, thyme, turmeric, curry powder, chili powder, marjoram, and mustard until evenly blended. Store in a tightly sealed shaker jar.",
