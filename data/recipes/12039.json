  "ingredients": [
    "8 ounces pasta",
    "1 pound lean ground beef",
    "1 cup chopped onion",
    "2 cups chopped celery",
    "salt and ground black pepper to taste",
    "1 (10.75 ounce) can condensed tomato soup",
    "1 (8 ounce) can tomato sauce",
    "1 cup water",
    "2 cups shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in pasta and return to a boil. Cook pasta uncovered, stirring occasionally, until al dente. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook ground beef in a large skillet until no pink remains. Add onions and celery and cook until they are softened. Add salt and pepper to taste. Stir in tomato soup, tomato sauce, and water. Simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pasta and meat mixture in a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 to 30 minutes. Sprinkle with grated Cheddar cheese and continue to cook until cheese is melted, about 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
