  "title": "Easy Johnny Marzetti Casserole",
  "description": "An easy Johnny Marzetti pasta recipe with sautéed ground beef, onions, celery, tomato soup, tomato sauce, and lots of grated Cheddar cheese.",
  "authors": [
    "Marsha"
  ],
  "date_published": "1999-08-04T08:51:07-04:00",
