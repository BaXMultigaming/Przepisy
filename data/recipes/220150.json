  "ingredients": [
    "1 tablespoon soy sauce",
    "2 tablespoons water",
    "1 tablespoon white sugar",
    "2 pounds skinless, boneless chicken breast halves, cut into small pieces",
    "1 tablespoon vegetable oil",
    "5 green onions, sliced",
    "3 cloves garlic, chopped",
    "3 tablespoons vegetable oil",
    "2 (6 ounce) bags fresh baby spinach leaves",
    "1 cup thinly sliced fresh basil"
  ],
  "steps": [
    {
      "text": "Combine soy sauce, water, and sugar in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Marinate chicken in soy sauce mixture for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 tablespoon oil in a large skillet or wok over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir green onions in oil for 1 minute. Add garlic and cook and stir for 1 minute. Transfer to a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 3 tablespoons oil into the skillet. Cook and stir chicken and marinade until chicken is no longer pink in the center and juices run clear, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add spinach leaves to chicken. Cover for 4 minutes stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir green onion mixture into chicken and spinach; cook to reheat onions, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in basil and cook until heated, 1 to 2 minutes. Serve!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
