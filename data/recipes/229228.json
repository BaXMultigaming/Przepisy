  "ingredients": [
    "6 cups peeled and sliced Bosc pears",
    "1 tablespoon fresh lemon juice",
    "0.5 cup light brown sugar, packed",
    "3 tablespoons cornstarch",
    "0.75 teaspoon ground cinnamon",
    "0.125 teaspoon ground cloves",
    "0.5 cup shredded sharp Cheddar cheese",
    "0.5 cup all-purpose flour",
    "0.5 cup light brown sugar, packed",
    "0.25 cup unsalted butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Butter a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss pears with lemon juice in a bowl. Combine 1/2 cup light brown sugar, cornstarch, cinnamon, and cloves together in a separate bowl. Add sugar mixture to pear mixture; toss to coat. Transfer to the prepared casserole dish. Sprinkle pear mixture with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and 1/2 cup light brown sugar in a food processor; pulse to mix. Cut butter into flour mixture until crumb consistency. Sprinkle topping over Cheddar cheese layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
