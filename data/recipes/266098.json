  "ingredients": [
    "0.5 cup maida flour",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "1 pinch salt",
    "0.25 cup semolina flour",
    "0.5 cup mango puree",
    "1 tablespoon mango puree",
    "0.25 cup plain yogurt",
    "0.25 cup white sugar",
    "1 tablespoon olive oil",
    "0.25 teaspoon ground cardamom",
    "0.5 cup chilled mango puree",
    "0.25 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift maida flour, baking powder, baking soda, and salt into a bowl. Sift a second time. Add semolina flour and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 cup plus 1 tablespoon mango puree, yogurt, sugar, olive oil, and cardamom in a large bowl; beat well. Add flour mixture and mix well. Transfer batter to the prepared muffin tin, filling cups 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 25 to 30 minutes. Remove cupcakes from tin and allow to cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Frost cupcakes with chilled mango puree, sprinkle almonds on top, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
