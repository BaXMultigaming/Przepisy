  "ingredients": [
    "4 cups water",
    "1 (16 ounce) package dry elbow macaroni",
    "0.5 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.25 teaspoon freshly ground black pepper",
    "0.75 cup milk",
    "2 cups shredded Cheddar cheese",
    "1 cup shredded Gouda cheese",
    "0.5 cup crumbled cooked bacon"
  ],
  "steps": [
    {
      "text": "Combine water, macaroni, salt, garlic powder, onion powder, and pepper in a multi-functional pressure cooker (such as Instant Pot®); stir until well combined. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 6 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in milk, Cheddar, and Gouda gradually, alternating between a little of the milk and a handful of cheese at a time. Stir until the cheeses are melted. Stir in crumbled bacon and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
