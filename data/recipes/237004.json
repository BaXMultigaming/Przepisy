  "ingredients": [
    "0.5 cup white sugar, or less to taste",
    "1 tablespoon soy sauce",
    "2 teaspoons sesame seeds",
    "0.5 teaspoon dry mustard",
    "0.25 teaspoon kosher salt",
    "0.125 teaspoon garlic powder",
    "0.5 cup cider vinegar",
    "3 tablespoons water",
    "1 cup canola oil"
  ],
  "steps": [
    {
      "text": "Stir sugar, soy sauce, sesame seeds, mustard, salt, and garlic powder together in a jar with a tight-fitting lid; add vinegar and water, seal jar, and shake until the sugar is dissolved completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour oil into the jar. Seal again and shake until the oil is emulsified into the dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
