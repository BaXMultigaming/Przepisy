  "ingredients": [
    "2 large eggs",
    "2 tablespoons white vinegar",
    "0.5 teaspoon dry mustard powder",
    "0.25 teaspoon salt",
    "2 cups vegetable oil"
  ],
  "steps": [
    {
      "text": "Combine eggs, vinegar, mustard powder, and salt in the bowl of a food processor; pulse until blended. Pour oil in very slowly, with the processor running, until mayonnaise is smooth.",
