  "title": "The Best Caramel Apples",
  "description": "The best caramel apple recipe coats tart apples with rich, thick caramel. Sprinkle with nuts, crushed cookies, or whatever you desire for a sweet treat!",
  "authors": [
    "onlyxception"
  ],
  "date_published": "2020-03-05T00:09:16-05:00",
