  "ingredients": [
    "3 large carrots",
    "8 large strawberries",
    "1 large tomato",
    "1 large red bell pepper, stemmed and seeded",
    "1 medium apple",
    "1 medium lime, sliced",
    "1 (1 inch) piece fresh ginger"
  ],
  "steps": [
    {
      "text": "Place a collection container under the exit spout of a juicer; turn the juicer on. Place carrots into the feeding chute; insert the food pusher and gently guide carrots down the chute. Repeat with strawberries, tomato, bell pepper, apple, lime, and ginger. Turn off the juicer.",
