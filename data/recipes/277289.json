  "ingredients": [
    "aluminum foil",
    "cooking spray",
    "6 (29 ounce) cans yams in syrup, drained",
    "1.5 cups brown sugar",
    "2 tablespoons ground cinnamon",
    "1 teaspoon ground cloves",
    "1 teaspoon allspice",
    "0.25 cup heavy cream",
    "1 (10.5 ounce) package miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Coat two pieces aluminum foil with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash yams in a large bowl with a fork; add brown sugar, cinnamon, cloves, allspice, and heavy cream in the exact order, mixing well after each addition. Divide mixture between two 8-inch square baking dishes; divide marshmallows between each dish to cover. Cover with aluminum foil, coated-sides down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Remove foil; bake 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
