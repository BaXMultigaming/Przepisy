  "ingredients": [
    "cooking spray",
    "0.5 cup milk",
    "0.5 cup all-purpose flour",
    "2 eggs, lightly beaten",
    "0.25 teaspoon salt",
    "2 tablespoons butter, cut into 6 pieces",
    "0.5 cup grated sharp Cheddar cheese",
    "0.25 cup brown sugar",
    "0.25 teaspoon ground nutmeg",
    "1 pear, thinly sliced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray 6 custard cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk, flour, eggs, and salt in a bowl. Mix until batter is fully combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a piece of butter in each prepared cup. Sprinkle each cup with Cheddar cheese, brown sugar, and nutmeg; line each evenly with pear slices. Pour batter evenly into the prepared cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
