  "ingredients": [
    "0.75 cup water",
    "0.25 onion",
    "0.25 cup achiote paste",
    "1 orange, juiced",
    "2 limes, juiced",
    "2 tablespoons white vinegar",
    "1 clove garlic, peeled",
    "1 teaspoon oregano",
    "salt and ground black pepper to taste",
    "6 (4 ounce) fillets white fish fillets",
    "0.5 cup butter, melted",
    "12 ounces uncooked medium shrimp, peeled and deveined",
    "1 red onion, sliced",
    "2 habanero chiles, sliced",
    "1 cup water",
    "0.5 orange, juiced",
    "1 lime, juiced",
    "1 teaspoon salt",
    "1 teaspoon peppercorns",
    "1 teaspoon dried Mexican oregano"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ¾ cup water, ¼ onion, achiote paste, juice of 1 orange, juice of 2 limes, vinegar, garlic, 1 teaspoon Mexican oregano, salt, and black pepper in a blender; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season both sides of fish fillets with salt and black pepper; brush tops with melted butter. Place fillets in a baking dish; top with shrimp and cover with achiote sauce. Cover the baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fillets flake easily with a fork, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place 1 sliced red onion and habaneros in a glass bowl. Add 1 cup water, juice of ½ orange, and juice of 1 lime; stir well. Season with 1 teaspoon salt, peppercorns, and 1 teaspoon Mexican oregano.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve fish and shrimp with achiote sauce; top with habanero sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
