  "ingredients": [
    "1 teaspoon crushed dried rosemary",
    "1 teaspoon dried basil",
    "1 teaspoon minced garlic",
    "1 pinch black pepper",
    "2 tablespoons olive oil",
    "4 pork chops",
    "1 cup fresh lemon juice",
    "0.5 cup crumbled feta cheese with basil and sun-dried tomatoes"
  ],
  "steps": [
    {
      "text": "In a small bowl, stir together rosemary, basil, garlic, and pepper.",
      "section": null,
      "name": null,
