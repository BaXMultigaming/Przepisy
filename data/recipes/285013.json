  "ingredients": [
    "2 medium sweet potatoes",
    "1 cup water",
    "0.5 cup uncooked brown rice",
    "1 cup soy milk",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 450 degrees F (230 degrees C). Prick sweet potatoes several times with a fork and place onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are easily pierced with a fork, 50 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "At the same time, bring water and brown rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove sweet potatoes from the oven and remove skin when cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sweet potato flesh and cooked rice in a food processor. Add soy milk, maple syrup, cinnamon, nutmeg, and vanilla; process until smooth. Serve hot, warm, or chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
