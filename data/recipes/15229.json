  "title": "Thighs on Rice",
  "description": "Chicken thighs bake on a bed of rice ideally seasoned with chicken bouillon, butter and onion. A simple meal that simply tastes great.",
  "authors": [
    "Carol B"
  ],
  "date_published": "1999-07-01T12:29:16-04:00",
