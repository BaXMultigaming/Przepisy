  "ingredients": [
    "1 (9 inch) deep dish pie crust",
    "2 eggs, beaten",
    "0.5 cup milk",
    "0.5 cup mayonnaise",
    "1 teaspoon cornstarch",
    "1.5 cups shredded Swiss cheese",
    "0.5 pound imitation crabmeat",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine the eggs, milk, mayonnaise and cornstarch. Stir in the cheese, imitation crabmeat and pepper. Pour into the pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 35 to 40 minutes or until a knife inserted in the center comes out clean. Let cool slightly and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
