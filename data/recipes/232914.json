  "ingredients": [
    "1 teaspoon butter",
    "10 eggs",
    "1 (16 ounce) package cottage cheese",
    "1 (16 ounce) package shredded Monterey Jack cheese",
    "0.5 cup butter, melted",
    "0.5 cup all-purpose flour",
    "1 (10 ounce) package frozen chopped spinach - thawed, drained and squeezed dry",
    "2 (4.5 ounce) cans sliced mushrooms, drained",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with 1 teaspoon butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a large bowl. Add cottage cheese, Monterey Jack cheese, 1/2 cup melted butter, flour, spinach, mushrooms, baking powder, and salt; mix. Pour egg mixture into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until eggs are set and a knife inserted into the center comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
