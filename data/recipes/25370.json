  "ingredients": [
    "0.5 pound bacon",
    "1 pound ground round",
    "1 pound ground pork",
    "2 (16 ounce) cans whole peeled tomatoes, drained",
    "1 (28 ounce) can crushed tomatoes",
    "2 cups water",
    "1 (12 fluid ounce) can beer",
    "1 yellow onion, diced",
    "1 green bell pepper, diced",
    "8 Anaheim peppers, seeded and diced",
    "6 jalapeno peppers, seeded and chopped",
    "6 habanero peppers, seeded and chopped",
    "3 ounces tomato paste",
    "3 tablespoons chili powder",
    "1 ounce chile paste",
    "2 tablespoons beef bouillon granules",
    "1.5 tablespoons ground cumin",
    "1 tablespoon crushed red pepper flakes",
    "2 cloves garlic, minced",
    "2 (16 ounce) cans chili beans, drained"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large soup pot over medium-high heat until evenly browned. Drain on paper towels; chop. Drain excess drippings from the pot, leaving enough to coat the bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brown beef and pork in the same pot over medium-high heat. Stir in whole tomatoes, crushed tomatoes, water, beer, onion, bell pepper, Anaheims, jalapeños, habaneros, tomato paste, chili powder, chili paste, bouillon granules, cumin, pepper flakes, and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low; simmer, stirring occasionally, 45 to 60 minutes Stir in bacon and beans; simmer 30 minutes more.",
      "section": null,
