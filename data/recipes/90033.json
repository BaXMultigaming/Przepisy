  "ingredients": [
    "0.25 cup chopped pecans",
    "1 (8.5 ounce) package coleslaw mix",
    "0.5 cup matchstick-style shredded carrots",
    "1.5 cups red grapes",
    "0.25 cup crumbled feta cheese",
    "0.5 cup mayonnaise",
    "0.5 cup Ranch dressing",
    "1 tablespoon sugar"
