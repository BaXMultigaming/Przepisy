  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "4 teaspoons taco seasoning mix",
    "1 cup salsa",
    "1 cup shredded Cheddar cheese",
    "2 tablespoons sour cream"
  ],
  "steps": [
