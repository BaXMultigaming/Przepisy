  "title": "Grilled Mahi Mahi in Thai Coconut Sauce",
  "description": "Mahi mahi fillets are topped with a Thai-style coconut milk sauce in this quick and easy main dish recipe.",
  "authors": [
    "Chris Denzer"
  ],
  "date_published": "2019-04-02T02:57:44-04:00",
