  "ingredients": [
    "3 tablespoons olive oil",
    "2 cloves garlic, minced",
    "1 teaspoon salt",
    "1 cup bread crumbs",
    "0.5 cup Parmesan cheese",
    "1 tablespoon dried parsley",
    "2 pounds salmon fillets"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 500 degrees F (260 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat salmon fillets dry with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix olive oil, garlic, and salt together in a bowl. Let stand 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs, Parmesan cheese, and dried parsley in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat salmon on all sides with olive oil mixture using a pastry brush. Press salmon into the bread crumb mixture to coat on all sides. Place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until salmon flakes easily with a fork, about 10 minutes per inch at the thickest part of the salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
