  "ingredients": [
    "2.25 cups all-purpose flour",
    "0.75 cup white sugar",
    "3 tablespoons ground cinnamon",
    "1.25 tablespoons baking powder",
    "0.25 tablespoon salt",
    "0.75 cup whole milk",
    "2 tablespoons whole milk",
    "10 tablespoons unsalted butter, softened",
    "2 large eggs, beaten",
    "0.5 tablespoon vanilla extract",
    "1.875 cups all-purpose flour",
    "0.5 cup unsalted butter, melted",
    "0.25 cup white sugar",
    "2 tablespoons white sugar",
    "4.5 tablespoons brown sugar",
    "0.75 teaspoon pumpkin pie spice, or more to taste",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix then sift flour, sugar, cinnamon, baking powder, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix milk, butter, eggs, and vanilla extract together in a large bowl with an electric mixer. Carefully fold in flour until combined but slightly lumpy. Pour batter into the prepared muffin tins, leaving a little room at the top for muffins to rise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, melted butter, sugar, brown sugar, pumpkin pie spice, and salt for the topping in a bowl; mix until crumbly. Add a generous amount on top of each muffin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 20 to 30 minutes. Cool in the tin for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
