  "ingredients": [
    "2 (1 ounce) packages fruit flavored Jell-O® mix",
    "2 egg whites",
    "1 cup white sugar",
    "0.25 cup water",
    "0.125 teaspoon cream of tartar"
  ],
  "steps": [
    {
      "text": "In the top of a double boiler, combine gelatin, egg whites, sugar, water and cream of tartar. Using an electric mixer, beat icing over boiling water until soft peaks form. Remove from heat. Continue to beat until icing forms stiff peaks. Use to frost a completely cooled cake.",
