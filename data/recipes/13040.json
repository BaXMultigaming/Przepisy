  "ingredients": [
    "1 tablespoon butter",
    "0.5 cup finely diced onion",
    "1 teaspoon minced garlic",
    "1 (5 ounce) can chunk chicken",
    "0.5 cup chopped fresh green chile peppers",
    "1.5 teaspoons ground cumin",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1.25 cups half-and-half cream",
    "1 cup shredded Cheddar cheese",
    "0.25 cup sour cream"
  ],
  "steps": [
    {
      "text": "Melt butter in a large saucepan over medium-high heat. Sauté onion and garlic until translucent, 3 to 4 minutes. Add chicken, chiles, and cumin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until flavors are blended, about 1 minute. Stir in soup, and half-and-half until well combined. Continue to cook until heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle soup into bowls; top with cheese, and a dollop of sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
