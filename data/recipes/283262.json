  "ingredients": [
    "1 tablespoon olive oil",
    "1 medium zucchini, diced",
    "1 medium onion, minced",
    "1 large carrot, chopped",
    "1 stalk celery, chopped",
    "2 cloves garlic, minced",
    "salt and ground black pepper to taste",
    "6 cups vegetable stock",
    "1 (15.5 ounce) can chickpeas, rinsed and drained",
    "1 (14.5 ounce) can undrained diced tomatoes",
    "0.25 pound fresh green beans, trimmed",
    "0.5 cup uncooked ditalini pasta",
    "0.25 cup pesto"
  ],
  "steps": [
    {
      "text": "Heat oil in the bottom of a 4- or 6-quart slow cooker on High. Add zucchini, onion, carrot, celery, garlic, salt, and pepper; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in vegetable stock, chickpeas, undrained tomatoes, and green beans. Cover and cook on Low for 6 to 7 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add ditalini and cook for 1 more hour. Stir in pesto and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
