  "ingredients": [
    "4 skin-on chicken breast halves",
    "salt and ground black pepper to taste",
    "0.25 cup olive oil",
    "2 tablespoons dry ranch dressing mix",
    "2 carrots, peeled and cut in half lengthwise",
    "2 stalks celery, halved",
    "0.25 cup Buffalo wing sauce"
