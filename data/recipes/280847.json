  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken breasts with salt and pepper on both sides. Whisk olive oil and ranch powder together in a bowl until evenly combined. Brush both sides of the carrots and celery with the seasoned oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill chicken and celery for 5 minutes. Flip chicken over and baste with wing sauce. Add carrots to the grill and cook for 5 minutes. Flip everything over, baste chicken with remaining wing sauce, and cook for 5 minutes more.",
