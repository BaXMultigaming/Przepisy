  "ingredients": [
    "cooking spray",
    "1 pound golden beets",
    "2 tablespoons olive oil",
    "0.5 teaspoon dried sage",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon salt, or to taste",
    "0.25 teaspoon freshly ground black pepper",
    "1 teaspoon grated lemon zest"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a sheet pan with foil and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel beets, and cut into 1 1/2-inch chunks. Combine olive oil, sage, thyme, salt, and pepper in a large bowl. Add beets, and mix until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread beets out in a single layer on the prepared sheet pan and roast, flipping half way through, until the beets are tender and starting to turn golden brown, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven, put beets back into the bowl, and toss with lemon zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
