  "ingredients": [
    "6 chicken thighs",
    "6 slices bacon",
    "2 cloves garlic, roughly chopped",
    "2 green onions, chopped",
    "0.5 teaspoon grated ginger root",
    "1 (10 fluid ounce) bottle Russian-style salad dressing",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook chicken until well browned on both sides. Allow chicken to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap each thigh in a piece of bacon, and place in slow cooker. Sprinkle garlic and ginger over the chicken; top with Russian dressing. Cook on Low heat for 5 to 6 hours. Season to taste with salt and pepper.",
      "section": null,
