  "ingredients": [
    "4 cups chopped green tomatoes",
    "1 tablespoon salt",
    "2 cups white sugar",
    "0.5 cup butter",
    "2 eggs",
    "2 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chopped tomatoes in a bowl; sprinkle with 1 tablespoon salt. Set aside for 10 minutes. Transfer to a colander; rinse with cold water. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat sugar and butter together in a large bowl with an electric mixer until light and fluffy; beat in eggs, one at a time, beating well after each addition until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cinnamon, nutmeg, baking soda, and ¼ teaspoon salt in a bowl; stir in raisins and walnuts. Stir flour mixture into egg mixture until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir drained tomatoes into batter until well combined. Transfer batter to the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
