  "ingredients": [
    "1 pound beef top round steak, cut into 1/4-inch strips",
    "1 (8 ounce) package sliced fresh mushrooms",
    "1 cup chopped onion",
    "2 tablespoons Dijon mustard",
    "2 tablespoons chopped fresh parsley",
    "3 cloves garlic, minced",
    "0.5 teaspoon salt",
    "0.5 teaspoon dried dill",
    "0.5 teaspoon freshly ground black pepper",
    "0.33333334326744 cup all-purpose flour (spooned and leveled)",
    "1 cup fat-free reduced-sodium beef broth",
    "1 (8 ounce) container reduced-fat sour cream",
    "2 cups hot cooked egg noodles"
  ],
  "steps": [
    {
      "text": "Place steak, mushrooms, onion, mustard, parsley, garlic, salt, dill, and pepper into a 3-quart slow cooker; stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour into a small bowl; gradually add broth, stirring with a whisk until blended. Pour into the slow cooker; stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on High for 1 hour. Reduce the heat to Low and cook until steak is tender, 7 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn the slow cooker off and remove the lid. Allow stroganoff to stand for 10 minutes, then stir in sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve over hot egg noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
