  "ingredients": [
    "1 (9 inch) unbaked pie crust",
    "2 cups milk",
    "1 tablespoon all-purpose flour",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "4 eggs, beaten",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a 9-inch pie plate with pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, blend together the milk, flour, sugar, vanilla and eggs. Pour into pie shell. Sprinkle with nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until custard is set, about 35 minutes.",
