  "ingredients": [
    "1 tablespoon olive oil",
    "0.5 large onion, chopped",
    "1 pound peas",
    "0.5 pound kohlrabi, peeled and cut into small dice",
    "1 bunch fresh dill, chopped",
    "0.5 tablespoon seasoning blend (such as Vegeta®)",
    "water to cover"
  ],
  "steps": [
    {
      "text": "Heat oil in a saucepan over medium heat. Add onion and cook until wilted, about 3 minutes. Add peas and kohlrabi; stir to combine. Add dill and seasoning blend; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add water to cover vegetables and bring to a boil. Reduce heat and cover halfway with a lid. Cook until peas and kohlrabi are soft, about 20 minutes more. Cool to room temperature before serving.",
      "section": null,
      "name": null,
      "url": null,
