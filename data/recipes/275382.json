  "ingredients": [
    "cooking spray",
    "0.5 pound ground beef",
    "0.5 cup black beans, rinsed and drained",
    "0.33333334326744 cup water",
    "0.25 cup salsa",
    "2 tablespoons taco seasoning",
    "1 CAULIPOWER® Three Cheese Pizza",
    "0.25 cup shredded pepper Jack cheese",
    "0.25 cup sour cream",
    "1 tablespoon Mexican-style hot sauce",
    "1 cup shredded lettuce",
    "1 Roma tomato, diced",
    "1 jalapeno pepper, sliced",
    "2 tablespoons chopped fresh cilantro",
    "0.25 cup tortilla strips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a large skillet with cooking spray and place over medium-high heat. Cook ground beef in the hot skillet until browned, 5 to 7 minutes. Drain off grease. Add black beans, water, salsa, and taco seasoning; cook for about 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unwrap pizza and place on a baking sheet. Spread meat-bean mixture evenly over crust. Sprinkle with pepper Jack cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 to 12 minutes. Cool for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While pizza is baking, stir together sour cream and hot sauce in a small bowl. Transfer to a small zip-top bag and place in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top pizza with lettuce, tomato, jalapeño, cilantro, and tortilla strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Snip off a corner of the zip-top bag and drizzle sour cream-hot sauce mixture over pizza.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
