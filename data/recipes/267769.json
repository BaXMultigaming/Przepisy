  "ingredients": [
    "1 pound ground pork",
    "0.5 cup rolled oats",
    "1 small carrot, cut into 1-inch chunks",
    "2 tablespoons water",
    "2 teaspoons fish sauce",
    "3 cloves garlic, minced",
    "2 teaspoons lemongrass paste",
    "1 teaspoon minced fresh ginger root",
    "0.5 teaspoon salt",
    "0.5 teaspoon crushed red pepper flakes",
    "1 egg, lightly beaten",
    "1 tablespoon coconut oil",
    "1 (14 ounce) can unsweetened coconut milk",
    "2 tablespoons green curry paste",
    "1 tablespoon brown sugar",
    "1 teaspoon fish sauce",
    "salt to taste",
    "1 tablespoon lime juice",
    "0.25 cup cilantro, minced"
  ],
  "steps": [
    {
      "text": "Place pork in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place oats in a mini food processor or blender and pulse until coarsely ground, 5 to 10 seconds. Sprinkle on top of pork. Rinse out processor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine carrot, water, fish sauce, garlic, lemongrass paste, ginger, salt, and red pepper flakes in the food processor. Blend until no large chunks remain, 10 to 15 seconds. Pour mixture over pork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add egg to the bowl and mix ingredients until thoroughly combined. Roll meat mixture into 24 balls, roughly 1 1/2 inches in diameter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat coconut oil in a large skillet over medium heat. Brown meatballs lightly on all sides, 2 to 3 minutes per side. Transfer partially cooked meatballs to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk coconut milk, curry paste, brown sugar, and fish sauce together in the same skillet; bring to a simmer. Return meatballs to the skillet and simmer until no longer pink inside, 8 to 10 minutes. Season with salt and stir in lime juice. Remove from heat. Sprinkle meatballs with cilantro right before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
