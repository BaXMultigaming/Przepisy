  "ingredients": [
    "1 cup frozen sweet cherries",
    "0.5 cup almond milk",
    "0.5 cup crushed ice, or as needed",
    "1 lime, zested and juiced",
    "10 leaves fresh basil",
    "0.5 teaspoon almond extract",
    "1 tablespoon water, as needed"
  ],
  "steps": [
    {
      "text": "Combine cherries, almond milk, ½ cup crushed ice, lime zest, lime juice, basil, and almond extract in a blender; blend until cherries and basil are well incorporated and mixture is smooth. Add more crushed ice if you prefer a thicker consistency, or add water if you prefer a thinner consistency.",
