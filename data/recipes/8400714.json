  "ingredients": [
    "1.25 cups self-rising flour, or more as needed",
    "1 cup plain whole-milk Greek yogurt",
    "1 tablespoon bagel seasoning blend",
    "avocado oil cooking spray"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and yogurt in a large bowl and mixed until a soft dough forms. Turn out the mixture onto a lightly floured surface and knead the dough for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 4 equal pieces. Working with 1 piece at a time roll into a ball. From dough ball into a bagel shape, using your finger to create a small hole in the center. Set on the prepared baking sheet. Repeat with remaining dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow the bagels to rest for 15 minutes. Spray with cooking spray and sprinkle with everything bagel seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the bagels begin to brown, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
