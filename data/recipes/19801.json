  "ingredients": [
    "1.75 cups all-purpose flour, divided",
    "0.75 cup butter",
    "1 tablespoon white sugar",
    "8 cups diced rhubarb",
    "0.75 cup white sugar",
    "1 cup evaporated milk",
    "6 eggs, separated",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 ½ cups flour, butter, and 1 tablespoon sugar in a large bowl with an electric mixer until combined; press into the bottom of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm, about 15 minutes. Leave oven on. Cool crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining ¼ cup flour, rhubarb, 2 cups sugar, evaporated milk, and egg yolks; pour over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is set, about 1 hour. Leave oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a large glass, metal, or ceramic bowl with an electric mixer until foamy. Beat in remaining ¾ cup sugar and vanilla extract until stiff peaks form; spread meringue over rhubarb filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until meringue is golden brown, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
