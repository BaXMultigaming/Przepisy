    "Italian"
  ],
  "regions": [
    "Italian"
  ],
  "breadcrumbs": [],
  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "4 cups bread flour",
    "2 tablespoons bread flour",
    "0.25 teaspoon active dry yeast",
    "2 teaspoons kosher salt",
    "4 teaspoons extra-virgin olive oil, or more as needed",
    "1.667 cups water, at room temperature",
    "1 tablespoon minced fresh rosemary",
    "1 tablespoon flaky sea salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IMWr4T9f7a9owduM1k-_u5ALpgQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8443216-no-knead-big-bubble-focaccia-VAT-Ingredients-8c39f4ca8bb54667a389abefa04ce6c7.jpg"
      ],
      "image": "assets/images/8443216/step_01.webp"
    },
    {
      "text": "Stir yeast into bread flour in a bowl. Add salt, followed by 4 teaspoons oil, and water. Stir with a spoon until a wet, sticky dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OgVRtOU9CVPwVNuylMrSyk96Y_U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8443216-no-knead-big-bubble-focaccia-VAT-02-73589bd608f84e3ca79722ba98ffce40.jpg"
      ],
      "image": "assets/images/8443216/step_02.webp"
    },
    {
      "text": "Cover and let sit at room temperature for 12 to 14 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MX4KEXyY47tr-jUozLWCrSDgX8w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8443216-no-knead-big-bubble-focaccia-VAT-03-ae650e3e477d489d92f06d10675b9f54.jpg"
      ],
      "image": "assets/images/8443216/step_03.webp"
    },
    {
      "text": "Uncover dough and transfer to an oiled work surface. Using oiled hands, press and push the dough into a rectangle, 16x12 inches in size.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jEco7TV4na7fUebaxLpvtQrA9Oc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8443216-no-knead-big-bubble-focaccia-VAT-04-43e829e89d8343bca259ec4cb22be8a7.jpg"
      ],
      "image": "assets/images/8443216/step_04.webp"
    },
    {
      "text": "Fold dough into thirds horizontally; fold vertically into thirds. Transfer smooth side up into a generously oiled pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AX_CNP8uuhiiRuBDZvrhzc0HuKw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8443216-no-knead-big-bubble-focaccia-VAT-05-1-c08b87ee6c1046ee857f639b623ed9b0.jpg"
      ],
      "image": "assets/images/8443216/step_05.webp"
    },
    {
      "text": "Cover the pan with plastic wrap and let rest until almost doubled in size, for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6sZ-tEswsqWZACBu_BnTq1zIOR0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8443216-no-knead-big-bubble-focaccia-VAT-06-7fe4e5051a334a94aac33e2692693cb9.jpg"
      ],
      "image": "assets/images/8443216/step_06.webp"
    },
    {
      "text": "Using oiled hands, fold once more into thirds horizontally, then into thirds vertically to develop gluten structure.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RDmpG2m4RhCDtJYJhO3ixwLm-uY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8443216-no-knead-big-bubble-focaccia-VAT-07-151c9c9f450c4f748e22c0c51d69bf5e.jpg"
      ],
      "image": "assets/images/8443216/step_07.webp"
    },
    {
      "text": "Flip dough, smooth side up, on the pan; cover with plastic wrap and let rest for 1 hour more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tSeQZUxhlXxuQaU8XlrsfESunv8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8443216-no-knead-big-bubble-focaccia-VAT-08-c7c277d02dc24012a164857538ad96f4.jpg"
      ],
      "image": "assets/images/8443216/step_08.webp"
    },
    {
      "text": "Unwrap and stretch and fold dough once more in each direction using oiled hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cMnwhXPYMvrXCp_NVfS-3wIVA7Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8443216-no-knead-big-bubble-focaccia-VAT-09-960e07aba1b441c1ae0aef312f3f5bf6.jpg"
      ],
      "image": "assets/images/8443216/step_09.webp"
    },
    {
      "text": "Transfer, smooth-side up, into a generously oiled metal baking pan. Lightly drizzle with additional olive oil and stretch to fit the pan. Cover and let rest for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yNkZuFIXCy0FHKmGW3Bme6isMy0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8443216-no-knead-big-bubble-focaccia-VAT-10-4cdb7722911b4b9ebb02aadba23e2c21.jpg"
      ],
      "image": "assets/images/8443216/step_10.webp"
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Unwrap and poke holes in the top of the dough using oiled fingers if desired for the traditional focaccia look. Scatter over rosemary and flaky sea salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VP4oRDUym8LCrKNB4cXZQlJLEaQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8443216-no-knead-big-bubble-focaccia-VAT-12-d34b4e0689144b609e025b64494f3850.jpg"
      ],
      "image": "assets/images/8443216/step_11.webp"
    },
    {
      "text": "Bake in the center of the preheated oven until browned, about 30 minutes. Let cool in the pan for 10 minutes; transfer to a wire rack and let cool to room temperature, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yhnelvABfL2mZI3sXwoNfZYhknk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8443216-no-knead-big-bubble-focaccia-VAT-13-50c8e29c4e664d0796331a157835a9fc.jpg"
      ],
      "image": "assets/images/8443216/step_12.webp"
    },
    {
      "text": "Slice and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uf3d7ybvsbXOVqS00vXqf0_MOhI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8443216-no-knead-big-bubble-focaccia-VAT-hero-4x3-6d6b937187944e16b369be952d934471.jpg"
      ],
      "image": "assets/images/8443216/step_13.webp"
    }
  ],
