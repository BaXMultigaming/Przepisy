  "ingredients": [
    "2 (8 ounce) cans water chestnuts, drained",
    "0.33333334326744 cup soy sauce",
    "1 pound bacon, halved crosswise",
    "20 toothpicks, or as needed",
    "0.33333334326744 cup packed brown sugar",
    "0.33333334326744 cup mayonnaise",
    "0.33333334326744 cup chili sauce"
  ],
  "steps": [
    {
      "text": "Soak water chestnuts in a medium bowl with soy sauce for at least 3 hours; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap each water chestnut with a piece of bacon; secure with a toothpick and arrange in a shallow baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bacon is crisp, 25 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix together brown sugar, mayonnaise, and chili sauce in a small bowl until sauce is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve bacon-wrapped water chestnuts with sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
