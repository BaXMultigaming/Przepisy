  "ingredients": [
    "15 small new potatoes",
    "5 slices bacon, cut into thirds",
    "1 (1 ounce) package ranch dressing mix",
    "15 toothpicks"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for low heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap each potato with a piece of bacon and secure with a toothpick. Sprinkle each wrapped potato with powdered ranch dressing mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, turning potatoes several times to allow bacon to cook on all sides. Potatoes are done when bacon is crispy, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
