  "ingredients": [
    "1 cup all-purpose flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.5 cup white sugar",
    "0.25 cup butter",
    "0.5 cup milk",
    "2 cups fresh blackberries",
    "0.5 cup blackberry juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together in a bowl; set aside. Beat ½ cup sugar and butter together in a separate bowl until smooth; stir in flour mixture, alternating with milk, until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared baking dish. Spoon blackberries and blackberry juice on top; sprinkle with remaining ½ cup sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
