  "ingredients": [
    "1 pound Brussels sprouts, trimmed and halved",
    "2 tablespoons olive oil",
    "1 tablespoon minced fresh thyme",
    "salt and ground black pepper to taste",
    "1 cup fresh cranberries",
    "2 tablespoons pure maple syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss Brussels sprouts in a bowl with olive oil, thyme, salt, and black pepper. Transfer to the prepared baking sheet in an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven for 10 minutes; stir in cranberries. Continue cooking for 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer sprouts and cranberries to a serving bowl; drizzle with maple syrup and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
