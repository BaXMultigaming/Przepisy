  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix dark brown sugar and mustard together in a bowl. Place ham on a broiling pan rack. Spoon mustard mixture over both sides of the ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until browned on one side, about 5 minutes. Flip, pour on pineapple juice from the can, and continue to broil for about 5 minutes more, adding pineapple rings on top in the final 2 minutes of cooking. Watch carefully as it cooks fast.",
