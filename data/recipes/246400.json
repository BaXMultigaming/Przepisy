  "ingredients": [
    "2 eggs",
    "1.5 cups milk",
    "2.5 cups self-rising white cornmeal",
    "0.5 teaspoon salt",
    "3 tablespoons vegetable oil",
    "2 tablespoons shortening"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs together in a large bowl until light and frothy; stir in milk. Stir in cornmeal and salt. Add oil; stir until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place shortening in a 10-inch cast iron skillet; heat skillet in the preheated oven until shortening is liquefied, 2 to 3 minutes. Remove skillet and pour in batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return skillet to oven and bake until corn bread is lightly browned, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove skillet from oven immediately and cover with wooden cutting board. Use oven mitts to invert skillet and tip corn bread onto cutting board. Cut into 8 wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
