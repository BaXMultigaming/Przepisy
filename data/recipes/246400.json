  "title": "Cast Iron Corn Bread",
  "description": "This savory corn bread is made in the traditional Southern style: not too sweet and very dry. Perfect with butter and maple syrup.",
  "authors": [
    "tresbeau"
  ],
  "date_published": "2019-04-02T03:06:30-04:00",
