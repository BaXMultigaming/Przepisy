  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup flour, margarine, and confectioners' sugar in a large bowl; mix until a dough ball forms; press into bottom and up sides of a 9-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 ½ cups white sugar, egg yolks, milk, and 3 tablespoons flour in a saucepan over medium-high heat. Add rhubarb; cook, stirring constantly, until thickened. Pour filling into hot crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a large glass or metal bowl until foamy; gradually beat in remaining ¼ cup sugar until stiff peaks form. Spread meringue over rhubarb filling to completely cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
