  "ingredients": [
    "2 tablespoons olive oil",
    "0.25 cup finely chopped onion",
    "3 tablespoons minced garlic, or more to taste",
    "3 (14.5 ounce) cans tomato sauce",
    "1 (6 ounce) can tomato paste",
    "1 tablespoon red wine",
    "1 tablespoon balsamic vinegar",
    "1 tablespoon ground basil",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon dried cilantro",
    "1 teaspoon chili powder",
    "1 teaspoon ground paprika",
    "1 teaspoon ground oregano",
    "2 large bay leaves",
    "1 pinch white sugar",
    "1 pinch ground cinnamon"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large skillet over medium heat. Sauté onion and garlic in hot oil until soft, about 5 minutes. Transfer to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomato sauce and tomato paste to the slow cooker and set temperature to Low. Cook and stir until paste melts, 3 to 4 minutes. Add wine, vinegar, basil, salt, pepper, cilantro, chili powder, paprika, oregano, bay leaves, sugar, and cinnamon; stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook, stirring occasionally, until reduced, 6 to 8 hours. Remove bay leaves to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
