  "ingredients": [
    "0.25 cup butter",
    "4 large tart apples - peeled, cored and sliced 1/4 inch thick",
    "0.5 cup cold water",
    "2 teaspoons cornstarch",
    "0.5 cup brown sugar",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet or saucepan over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wuXaNyl5IWBJXlFRKYRPixDUNCQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21672-SauteedApples-ddmfs-Step1-0044-a703f739de574ead903ae64afe86392b.jpg"
      ],
      "image": "assets/images/21672/step_01.webp"
    },
    {
      "text": "Add apples and cook, stirring constantly, until almost tender, 6 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cBYGN9iCCKAudzvFX2f3KNenO5I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21672-SauteedApples-ddmfs-Step3-0048-170497cd54c9419e8b051047f3f16c72.jpg"
      ],
      "image": "assets/images/21672/step_02.webp"
    },
    {
      "text": "Mix water and cornstarch together in a small bowl until cornstarch is dissolved; pour over apples. Stir in brown sugar and cinnamon. Bring to a boil for 2 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1h4rSry_E_E_OqSCmPpDs7D0Gp8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21672-SauteedApples-ddmfs-Step4-0054-b13e259aa51d4bf393d9551e8ca6ebd1.jpg"
      ],
      "image": "assets/images/21672/step_03.webp"
    },
    {
      "text": "Remove from heat and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XuWvqN_RNbptO860C2qs3O41Un8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21672-SauteedApples-ddmfs-Step5-0055-00e1950fab834d7a9d988794925e1bc5.jpg"
