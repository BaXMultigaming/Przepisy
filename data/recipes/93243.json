  "ingredients": [
    "0.25 cup flour",
    "2 (.87 ounce) packages McCormick® Turkey Gravy Mix",
    "3 cups water",
    "1 cup turkey pan drippings, fat skimmed",
    "1 cup cooked, chopped turkey giblets"
  ],
  "steps": [
    {
      "text": "Whisk flour and gravy mix together in a large saucepan. Gradually whisk in water and pan drippings until smooth. Stir in giblets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook, stirring frequently, over medium-high heat until gravy comes to a boil. Reduce the heat to low and simmer, stirring occasionally, until thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat and serve. Gravy will continue to thicken as it stands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
