  "ingredients": [
    "0.5 cup butter, softened",
    "0.33333334326744 cup masa harina",
    "0.25 cup water",
    "1.5 cups frozen whole-kernel corn, thawed",
    "2 tablespoons heavy whipping cream",
    "0.33333334326744 cup white sugar",
    "0.25 cup cornmeal",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "boiling water for water bath"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter in a bowl with an electric mixer until creamy; beat in masa harina and ¼ cup water until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place corn in the bowl of a food processor; pulse until still a bit chunky. Stir into butter mixture until incorporated; stir in heavy cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, cornmeal, baking powder, and salt in a separate bowl; stir into corn mixture to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into an ungreased 8x8-inch baking pan; smooth top of batter. Cover the pan with aluminum foil, then place into a 9x13-inch baking dish. Add enough boiling water to the baking dish to come one-third up the sides of the baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 50 to 60 minutes. Cool for 10 minutes. Scoop servings using an ice cream scoop.",
      "section": null,
      "name": null,
      "url": null,
