  "ingredients": [
    "1 (6 ounce) container fresh raspberries",
    "2 tablespoons white sugar",
    "1 tablespoon sugar-free raspberry syrup (such as Torani®)",
    "6 packets stevia sweetener (such as Truvia®)",
    "1 teaspoon freshly squeezed lemon juice"
  ],
  "steps": [
    {
      "text": "Place raspberries in a small saucepan; mash with a potato masher. Stir in sugar, syrup, and stevia. Reduce heat to low and simmer until thick, stirring constantly, 10 to 12 minutes. Remove from heat and stir in lemon juice.",
