  "keywords": [],
  "ingredients": [
    "9 potatoes - peeled and cubed",
    "1.5 pounds ground beef",
    "1 (6 ounce) can tomato sauce",
    "2 tablespoons chopped fresh parsley",
    "1 dash Worcestershire sauce",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 (15 ounce) cans green beans, drained",
    "3 tablespoons water",
    "2 tablespoons all-purpose flour",
    "2 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes and water to cover in a large pot. Bring to a boil over high heat; lower heat and simmer until tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, brown ground beef in a large skillet over medium-high heat; drain excess fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomato sauce, parsley, Worcestershire sauce, salt, ground black pepper, and green beans to the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix water and flour together; stir into the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain and mash potatoes. Spread potatoes over beef mixture. Poke 2 to 3 vent holes through top to release steam as casserole bakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Brush milk over potatoes and bake 5 minutes longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
