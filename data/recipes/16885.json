  "title": "Mom&#39;s Shepherd&#39;s Pie",
  "description": "Shepherd&#39;s pie is easy and versatile. This recipe features a beefy filling with canned green beans and tomato sauce and a simple mashed potato topping.",
  "authors": [
    "Missy"
  ],
  "date_published": "2000-03-02T13:01:05-05:00",
  "date_modified": "2022-10-03T11:48:26-04:00",
