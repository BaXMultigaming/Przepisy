  "ingredients": [
    "0.5 cup shortening",
    "0.5 cup unsweetened cocoa powder",
    "1 cup white sugar",
    "1 egg",
    "1 cup buttermilk",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 teaspoon vanilla extract",
    "1.5 cups sifted all-purpose flour",
    "0.5 cup hot water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour an 8 inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan, melt together the shortening and cocoa. Remove from heat and stir in sugar and egg. Mix buttermilk with baking soda, salt and vanilla, then blend into chocolate mixture. Beat in flour. Stir in hot water. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 35 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
