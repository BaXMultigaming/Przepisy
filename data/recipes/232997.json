  "ingredients": [
    "5 tablespoons butter, melted",
    "1 teaspoon grated Parmesan cheese",
    "1 teaspoon oregano",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "5 thick slices day-old bread with crusts removed, cut into cubes"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter, Parmesan cheese, oregano, thyme, garlic powder, and salt together in a large, flat-bottomed bowl; add bread cubes and turn with a spatula to coat. Spread coated bread cubes onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden brown, 15 to 20 minutes. Cool croutons completely before storing in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
