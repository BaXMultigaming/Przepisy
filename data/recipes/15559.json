  "ingredients": [
    "1 teaspoon olive oil",
    "1 onion, chopped",
    "0.75 cup uncooked white rice",
    "2 cloves garlic, minced",
    "1 teaspoon salt",
    "1 teaspoon ground cumin",
    "0.25 teaspoon cayenne pepper",
    "1.5 cups low sodium, low fat vegetable broth",
    "3.5 cups canned black beans, drained"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GWJnTymIEDl27xSxfIvovXzdAak=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15559-Black-Beans-and-Rice-ddmfs-step-0-ec24b036d3c645a0bab5dad3e5e31410.jpg"
      ],
      "image": "assets/images/15559/step_01.webp"
    },
    {
      "text": "Heat oil in a saucepan over medium-high heat. Add onion; cook and stir until onion has softened, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XJ4-xjaimJq6xoFil33Ij4aUY-I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15559-Black-Beans-and-Rice-ddmfs-step-1-8ce67ef17d084776b685e3651600ccf6.jpg"
      ],
      "image": "assets/images/15559/step_02.webp"
    },
    {
      "text": "Add rice, garlic, salt, cumin, and cayenne. Cook and stir for 2 to 3 minutes to lightly toast the rice and warm the spices until fragrant.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MEasH5q6Sb8cxoTEjTmCEE7CaP4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15559-Black-Beans-and-Rice-ddmfs-step-2-b7e1cbe17e73488792d431df2df871d0.jpg"
      ],
      "image": "assets/images/15559/step_03.webp"
    },
    {
      "text": "Add vegetable broth and bring to a boil. Reduce heat to low, cover, and simmer until liquid is absorbed and rice is tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wg7MtddWuER6QmZqdjrktkwEh3g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15559-Black-Beans-and-Rice-ddmfs-step-3-60da306164ee481cb17a2f11f812db23.jpg"
      ],
      "image": "assets/images/15559/step_04.webp"
    },
    {
      "text": "Stir in black beans and cook until warmed through, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CtH5qItOYUR6KmO1llQseEcaPIg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15559-Black-Beans-and-Rice-ddmfs-step-4-9124fcc34c44430ebf8fb61fcd0e1864.jpg"
      ],
      "image": "assets/images/15559/step_05.webp"
