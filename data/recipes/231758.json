  "ingredients": [
    "2 cups water",
    "1 (6 ounce) can tomato paste",
    "2 tablespoons lemon juice",
    "2 tablespoons white sugar",
    "1 teaspoon salt, or to taste",
    "3 cups water, more if needed"
  ],
  "steps": [
    {
      "text": "Blend 2 cups water, tomato paste, lemon juice, sugar, and salt together in a blender until smooth; pour into a 1/2 gallon container. Stir 3 cups water into mixture. Refrigerate until thickened, about 1 hour. Add 1 more cup water if juice is too thick.",
