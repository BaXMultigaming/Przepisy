  "title": "Basic Ham and Bean Soup",
  "description": "This hearty ham and bean soup is packed with vegetables and gets an extra boost of flavor thanks to the addition of a ham hock, garlic, and mustard.",
  "authors": [
    "J A McConville"
  ],
  "date_published": "2000-04-24T16:17:18-04:00",
