  "ingredients": [
    "8 cups water",
    "1 pound dry great northern beans, sorted and rinsed",
    "0.5 teaspoon salt",
    "1 cup chopped carrots",
    "1 cup chopped onion",
    "0.5 stalk celery, chopped",
    "1 teaspoon minced garlic",
    "1 teaspoon mustard powder",
    "2 bay leaves",
    "1 ham hock",
    "2 cups chopped ham",
    "0.5 teaspoon ground white pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RIoPg343FM5lPI0-CxuUeKGYUmE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-17628-basic-ham-and-bean-soup-VAT-step-01-451f53c6c65b4b19b314dde830401b6c.jpg"
      ],
      "image": "assets/images/17628/step_01.webp"
    },
    {
      "text": "Place water and beans in a large pot; bring to a boil over high heat. Stir in salt and remove the pot from heat; cover, and let stand for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xv49BYJZMyWgKiS6nzzKb6RsyOs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-17628-basic-ham-and-bean-soup-VAT-step-02-bea0371462604dcba84eaad5e309e4e5.jpg"
      ],
      "image": "assets/images/17628/step_02.webp"
    },
    {
      "text": "Add carrots, onion, celery, garlic, mustard, and bay leaves to the pot with beans; stir well. Add ham hock and bring to a boil; reduce heat to low and simmer for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wHyO6YAQSJMRyMEyRwXwYfD_6nc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-17628-basic-ham-and-bean-soup-VAT-step-03-1d7065c9b4ec4e3f8adb86d4c3f66a3e.jpg"
      ],
      "image": "assets/images/17628/step_03.webp"
    },
    {
      "text": "Remove ham hock and discard. Stir in chopped ham and simmer until heated through, about 30 minutes. Season with ground white pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V0ZV2vnYt4at4-BeVTqdtP9QVGc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-17628-basic-ham-and-bean-soup-VAT-step-04-30018fd962e244318ce9d869d450e99b.jpg"
      ],
      "image": "assets/images/17628/step_04.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R2nvGgIPHI8oQCFw20p-2Oah4tU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17628-basic-ham-and-bean-soup-VAT-Beauty-4x3-ed6a1f7a5ff64d26adba47f7e60e3c54.jpg"
