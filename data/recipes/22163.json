  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "1 cup sour cream",
    "2 (16 ounce) cans refried beans",
    "1 (8 ounce) package shredded Cheddar cheese",
    "1 (8 ounce) package shredded Monterey Jack cheese",
    "0.25 cup chopped green onions",
    "2 tablespoons dried parsley",
    "0.5 (1 ounce) package taco seasoning mix",
    "5 drops hot pepper sauce"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IN0hTUDOtA0c8LFRwOVDezA3GSI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22163-HotBeanDip-ddmfs-Step1-3x4-8729-206b677346044aa8b3fc42d668cc1759.jpg"
      ],
      "image": "assets/images/22163/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese and sour cream together in a medium bowl until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q9nCmb0U9Rt4qKvDASELmZylO-4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22163-HotBeanDip-ddmfs-Step2-3x4-8733-b0f85fd04ebb4206bee62322c8025cde.jpg"
      ],
      "image": "assets/images/22163/step_03.webp"
    },
    {
      "text": "Mix in refried beans, 1/2 of the Cheddar cheese, 1/2 of the Monterey Jack cheese, green onions, parsley, taco seasoning, and hot pepper sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wRrcGo_9O4PeS_nFqROeGEDVxZc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22163-HotBeanDip-ddmfs-Step3-3x4-8735-32bfff33fecb4c2ab0fd35a4c17a3578.jpg"
      ],
      "image": "assets/images/22163/step_04.webp"
    },
    {
      "text": "Transfer mixture to an 8x12-inch baking dish and sprinkle remaining Cheddar and Monterey Jack over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/szSqgiCRwEFybjczUTF41AMwWpc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22163-HotBeanDip-ddmfs-Step4-3x4-8739-a78df1dc68874ded95a2f1df8433274b.jpg"
      ],
      "image": "assets/images/22163/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until dip is hot and bubbly and cheese is golden brown, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
