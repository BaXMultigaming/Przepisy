  "ingredients": [
    "2 pounds pork ribs, cut into 2-inch strips",
    "salt and ground black pepper to taste",
    "3 tablespoons vegetable oil",
    "2 onions, sliced",
    "1 cup water",
    "5 whole allspice berries",
    "2 bay leaves"
  ],
  "steps": [
    {
      "text": "Season pork ribs with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Cook ribs until evenly browned, about 5 minutes per side. Add onion; cook and stir until soft and translucent, 3 to 5 minutes. Pour in water; add allspice berries and bay leaves. Cover and simmer until flavors combine, about 40 minutes. Season with salt and pepper.",
