  "ingredients": [
    "2 cups crushed chocolate sandwich cookies (such as Oreo®)",
    "1 tablespoon butter, melted",
    "3 (8 ounce) packages fat-free cream cheese, softened",
    "0.75 cup white sugar",
    "3 eggs",
    "0.5 cup mashed banana",
    "1 teaspoon vanilla extract",
    "2.5 cups cold milk",
    "2 (3.4 ounce) packages instant vanilla pudding mix",
    "1 cup fat-free frozen whipped topping, thawed",
    "1 sliced banana, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cookie crumbs and butter together in a bowl. Press mixture into the bottom of a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese and sugar together in a bowl using an electric mixer until smooth and well blended. Add eggs 1 at a time, mixing after each addition. Stir in mashed banana and vanilla extract. Pour mixture into crust in the springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center is almost set, 50 to 60 minutes. Cool completely, at least 1 hour, before removing from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and pudding mix together in a bowl until thoroughly combined. Fold in whipped topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange sliced bananas on top of cooled cheesecake. Spread pudding mixture on top. Chill at least 3 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
