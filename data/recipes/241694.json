  "ingredients": [
    "1 pound ground beef",
    "3 (14.5 ounce) cans pork and beans, drained",
    "1 cup ketchup",
    "1 cup brown sugar",
    "0.5 cup cold water",
    "0.25 cup distilled white vinegar",
    "2 tablespoons mustard"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 13x9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix browned beef, pork and beans, cold water, white vinegar, and mustard together in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until beginning to dry around the edges, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
