  "ingredients": [
    "6 tablespoons olive oil",
    "1 tablespoon fresh lemon juice",
    "1 tablespoon chopped fresh parsley",
    "1 clove garlic, minced",
    "1 teaspoon dried basil",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "2 (6 ounce) fillets halibut"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XWBbr7ttTonwwAIa7c8BJmL13uA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25871-grilled-fish-steaks-ddmfs-4x3-step-01-f99c5e1c36eb4efc874dd97e6238c845.jpg"
      ],
      "image": "assets/images/25871/step_01.webp"
    },
    {
      "text": "Combine olive oil, lemon juice, parsley, garlic, basil, salt, and pepper together in a stainless steel or glass bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/629AEnTXmuljlsdN-CxdZpRxMCU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25871-grilled-fish-steaks-ddmfs-4x3-step-02-72f57f610b7f4f9dbb219e5e989fdaa2.jpg"
      ],
      "image": "assets/images/25871/step_02.webp"
    },
    {
      "text": "Place halibut fillets in a shallow glass dish or a resealable plastic bag; pour marinade over fish fillets. Cover or seal and place in the refrigerator for 1 hour, turning occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t7_fpI3jmQg-YMI1IRF4o5T7fas=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25871-grilled-fish-steaks-ddmfs-4x3-step-03-1df23289f5fb463d8fefd3de152f5d65.jpg"
      ],
      "image": "assets/images/25871/step_03.webp"
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate. Set grate 4 inches from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qGhI3QKb6iLBBdJf_oejlOD5w2E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25871-grilled-fish-steaks-ddmfs-4x3-step-04-ab12b4b6190348e38ba636d0b425ef9a.jpg"
      ],
      "image": "assets/images/25871/step_04.webp"
    },
    {
      "text": "Remove halibut fillets from marinade and drain off any excess. Cook on the preheated grill until fish flakes easily with a fork, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MByLK_8149J7nipj8IqAllfngas=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25871-grilled-fish-steaks-ddmfs-4x3-step-05-ddd855dae4c046d19f321de8afbe465b.jpg"
