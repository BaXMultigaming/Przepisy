  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup brown sugar",
    "2 teaspoons pumpkin pie spice",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "0.75 cup pumpkin puree",
    "2 eggs",
    "0.25 cup milk",
    "0.25 cup butter, softened",
    "1 cup confectioners' sugar, sifted",
    "0.25 teaspoon vanilla extract",
    "0.5 teaspoon pumpkin pie spice",
    "4 teaspoons milk, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, brown sugar, 2 teaspoons pumpkin pie spice, baking powder, salt, and baking soda together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pumpkin, eggs, milk, and butter into flour mixture; beat until completely incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon pumpkin mixture into a pastry bag fitted with a large star tip with a 1/2-inch opening. Pipe 3-inch circles onto prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 13 minutes. Remove doughnuts to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir confectioner's sugar, 1/2 teaspoon pumpkin pie spice, and vanilla together in a bowl. Gradually stir in enough milk to reach a glaze consistency. Brush glaze over doughnuts with a pastry brush or spoon over the tops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
