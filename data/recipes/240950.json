  "ingredients": [
    "3 large cucumbers - peeled, seeded, and cut into 1/4-inch chunks",
    "2 tablespoons kosher salt",
    "3 tablespoons butter",
    "0.5 teaspoon lemon juice",
    "0.5 teaspoon crushed dried mint",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place cucumbers in a shallow baking dish and sprinkle kosher salt over the top; toss to coat and let rest, 30 minutes to 1 hour. Drain cucumbers and discard any accumulated liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium-high heat. Cook and stir cucumbers in hot butter until cucumbers are heated through and color starts to change, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cucumbers to a serving dish; season with lemon juice, mint, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
