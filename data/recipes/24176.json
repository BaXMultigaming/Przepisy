  "ingredients": [
    "1 (7.5 ounce) package refrigerated buttermilk biscuit dough",
    "1 teaspoon dried oregano",
    "3 ounces mozzarella cheese, cut into 3/4 inch cubes",
    "2 tablespoons pizza sauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make an indentation in the top of each uncooked biscuit. Fill indentations with oregano and a mozzarella cube. Pinch the dough around the mozzarella cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the biscuits, pinched side down, on a medium, ungreased baking sheet. Cover with pizza sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 10 to 12 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
