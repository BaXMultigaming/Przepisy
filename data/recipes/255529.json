  "ingredients": [
    "cooking spray",
    "8 cups (1/2-inch) pieces peeled and seeded zucchini",
    "1 cup white sugar",
    "3 tablespoons all-purpose flour",
    "1 tablespoon lemon juice",
    "1 teaspoon apple pie spice",
    "0.75 teaspoon cream of tartar",
    "salt",
    "1.25 cups cake flour",
    "0.5 cup white sugar",
    "0.25 cup brown sugar",
    "2.5 teaspoons baking powder",
    "1 pinch salt",
    "0.5 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a pot of water to a boil; add zucchini. Cook until tender, about 5 minutes; drain. Place in a bowl of cold water until cool, about 5 minutes; drain. Transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1 cup white sugar, all-purpose flour, lemon juice, apple pie spice, cream of tartar, and salt into the zucchini gently until combined. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake flour, 1/2 cup white sugar, brown sugar, baking powder, and salt in a bowl. Sprinkle over batter. Drizzle melted butter on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
