  "ingredients": [
    "8 cups puffed wheat cereal",
    "0.33333334326744 cup unsalted butter",
    "1 cup packed brown sugar",
    "0.5 cup corn syrup",
    "2 tablespoons cocoa powder",
    "1 teaspoon vanilla extract"
  ],
