  "ingredients": [
    "1.5 cups old-fashioned rolled oats",
    "1.5 cups whole wheat flour",
    "2 teaspoons baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1.5 cups buttermilk",
    "1 cup milk",
    "0.33333334326744 cup white sugar",
    "0.25 cup vegetable oil",
    "1 egg",
    "0.5 cup raisins",
    "3 tablespoons chopped walnuts",
    "1 teaspoon vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Process oats in a food processor until finely ground. Mix oats, flour, baking soda, baking powder, salt, cinnamon, and nutmeg together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk buttermilk, milk, sugar, 1/4 cup vegetable oil, and egg in a separate bowl until smooth; mix into oat mixture until batter is well-mixed, about 30 strokes. Fold raisins and walnuts into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil a skillet or griddle and place over medium heat. Drop batter by large spoonfuls onto the griddle and cook until bubbles form and the edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 4 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
