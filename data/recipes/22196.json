  "ingredients": [
    "1 pound pork sausage",
    "1 (5.5 ounce) package seasoned croutons",
    "1.5 cups shredded Cheddar cheese",
    "1 cup shredded Swiss cheese",
    "1 cup shredded pepperjack cheese",
    "8 eggs",
    "1 pint half-and-half cream",
    "1.5 cups milk",
    "1.5 teaspoons dry mustard",
    "1 tablespoon minced onion",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Place sausage in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a lightly greased 9x13-inch baking dish, arrange croutons in a single layer. Layer with Cheddar cheese, Swiss cheese, and pepper Jack cheese. Top with the cooked sausage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat together eggs, half-and-half, milk, mustard, onion, salt, and pepper. Pour into the dish over sausage. Cover and refrigerate, 8 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "The next morning, preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 to 60 minutes. Let sit for 20 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
