  "title": "Zippy Egg Casserole",
  "description": "This egg casserole recipe has a little zip from pepper Jack cheese and sausage. It&#39;s made the night before for an easy breakfast the next day.",
  "authors": [
    "ANY14TNS"
  ],
  "date_published": "2000-06-23T10:37:23-04:00",
