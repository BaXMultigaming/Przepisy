  "ingredients": [
    "1 (21 ounce) can apple pie filling",
    "6 (8 inch) flour tortillas",
    "1 teaspoon ground cinnamon, or more to taste",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "0.5 cup water",
    "0.33300000429153 cup margarine"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon fruit evenly onto all tortillas and sprinkle with cinnamon. Roll up tortillas and place seam side down on a lightly greased 8x8-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring white sugar, brown sugar, water, and margarine to a boil in a medium saucepan. Reduce heat and simmer, stirring constantly, for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sauce evenly over tortillas; sprinkle with extra cinnamon on top to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
