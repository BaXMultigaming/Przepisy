  "ingredients": [
    "1.5 cups red wine",
    "0.5 cup soy sauce",
    "0.5 cup zesty Italian-style salad dressing",
    "2 tablespoons brown sugar",
    "2 teaspoons ground ginger",
    "2 cloves garlic, chopped",
    "1 teaspoon oregano",
    "1.25 pounds skinless, boneless chicken breast, cut into 1-inch slices"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir red wine, soy sauce, salad dressing, brown sugar, ground ginger, garlic, and oregano together in a bowl until the sugar dissolves completely. Add chicken and mix to coat. Pour into a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until chicken no longer pink in the center and the juices run clear, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
