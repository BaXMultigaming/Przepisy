  "ingredients": [
    "2 cooked boneless, skinless chicken breast halves, shredded",
    "0.5 head cabbage, finely shredded",
    "0.5 cup corn kernels",
    "0.25 cup chopped fresh cilantro",
    "2 green onions, chopped",
    "3 tablespoons sliced almonds",
    "0.5 cup mayonnaise",
    "2 tablespoons rice wine vinegar",
    "1.5 tablespoons lemon juice",
    "1 tablespoon white sugar",
    "2 teaspoons ground black pepper",
    "1 teaspoon salt",
    "1 teaspoon chile-garlic sauce (such as Sriracha®)",
    "1 teaspoon paprika",
    "1 teaspoon red pepper flakes",
    "0.5 teaspoon minced garlic",
    "0.5 teaspoon sesame oil",
    "0.5 teaspoon honey",
    "0.125 teaspoon ground ginger",
    "12 dinner rolls"
  ],
  "steps": [
    {
      "text": "Combine chicken, cabbage, corn, cilantro, green onions, and almonds in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, rice vinegar, lemon juice, sugar, black pepper, salt, chile-garlic sauce, paprika, red pepper flakes, garlic, sesame oil, honey, and ginger in a separate bowl until sugar has dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir dressing into chicken mixture to thoroughly coat salad with dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Hollow out dinner rolls to make small bowls; fill rolls with salad to serve.",
      "section": null,
