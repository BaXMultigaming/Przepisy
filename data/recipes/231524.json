  "ingredients": [
    "1 pound ground ham",
    "1 pound ground pork",
    "2 cups cracker crumbs",
    "1 cup milk",
    "2 eggs, lightly beaten",
    "1 cup brown sugar",
    "1 cup cider vinegar",
    "0.5 cup water",
    "1 tablespoon dry mustard"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ham and pork in a bowl; stir in cracker crumbs, milk, and eggs. Shape mixture into 14 small oval loaves. Place loaves into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, vinegar, water, and mustard in a bowl, stirring until brown sugar is dissolved; pour over ham loaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour; flip and bake until juices run clear and an instant-read meat thermometer inserted into centers reads 160 degrees F (70 degrees C), about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
