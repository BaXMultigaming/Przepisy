  "ingredients": [
    "cooking spray",
    "4 cups pancake mix (such as Bisquick®)",
    "4 large eggs",
    "2 cups whole milk",
    "1 cup sliced strawberries",
    "1 cup blueberries"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C). Generously spray a sheet pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/whU9anGe5xYWzP1mKsdbu6AgKt4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-283096-sheet-pan-pancakes-VAT-STEP-01-2c004f17370b43d5bfd78ed26df97c69.jpg"
      ],
      "image": "assets/images/283096/step_01.webp"
    },
    {
      "text": "Mix pancake mix, milk, and eggs together in a large bowl; let sit for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-XFeM950gPnCRpH2Vyn2pwkSVTo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-283096-sheet-pan-pancakes-VAT-STEP-02-6dd8790f9cd64728af1279a779457031.jpg"
      ],
      "image": "assets/images/283096/step_02.webp"
    },
    {
      "text": "Pour into the prepared sheet pan. Top with strawberries and blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tDp-ej7OWkgJ4wQGZQpIYbi5PSE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-283096-sheet-pan-pancakes-VAT-STEP-03-399b84f052164c1fb0591284f7559d0c.jpg"
      ],
      "image": "assets/images/283096/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until the center of the pancake is springy to the touch and a toothpick inserted in the middle comes out clean, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
