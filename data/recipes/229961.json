  "ingredients": [
    "1 cup butter",
    "1 pound cooked small salad shrimp",
    "2 sleeves buttery round crackers (such as Ritz®), crushed",
    "3 tablespoons lemon juice",
    "4 teaspoons garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Fold shrimp into melted butter to coat. Mix cracker crumbs, lemon juice, and garlic powder into shrimp; transfer into a 9-inch square baking dish. Cover dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
