  "ingredients": [
    "2.5 cups crispy rice cereal",
    "2 cups quick-cooking oats",
    "0.5 cup raisins",
    "0.5 cup packed brown sugar",
    "0.5 cup light corn syrup",
    "0.5 cup crunchy peanut butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "In a large bowl, stir together the rice cereal, oats, and raisins. Set aside. Grease a 9x13 inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the brown sugar and corn syrup in a small saucepan over medium heat. Heat just until boiling, then remove from heat and stir in peanut butter and vanilla until smooth. Pour over the cereal and oat mixture, and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press into the prepared pan using the back of a large spoon. Allow to cool, then cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
