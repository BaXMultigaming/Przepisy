  "ingredients": [
    "3 eggs, beaten",
    "0.75 cup white sugar",
    "3 teaspoons vanilla extract",
    "2 teaspoons anise extract",
    "0.75 cup butter, melted",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 cup anise seed"
  ],
  "steps": [
    {
      "text": "Preheat the pizzelle iron.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the eggs and sugar. Slowly add melted butter, vanilla, and anise extract, while mixing. Stir in the flour, baking powder, and anise seeds. If a thicker cookie is preferred, add 1/2 cup more flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop cookies by rounded tablespoons onto the center of the grid. Close the iron and cook until steaming stops. This could take 30 to 90 seconds, depending on the iron used.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
