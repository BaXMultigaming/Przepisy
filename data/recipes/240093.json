  "ingredients": [
    "0.75 pound mahi mahi fillets, diced, or more to taste",
    "0.33333334326744 cup lime juice",
    "0.33333334326744 cup lemon juice",
    "1 tablespoon minced jalapeno pepper",
    "0.5 teaspoon salt, or to taste",
    "1 pinch dried oregano",
    "1 pinch cayenne pepper",
    "0.5 cup diced avocados",
    "0.5 cup peeled and seeded diced cucumber",
    "0.5 cup diced orange segments",
    "0.5 cup chopped fresh chives",
    "2 tablespoons radishes, sliced",
    "1 tablespoon chopped cilantro",
    "1 tablespoon olive oil"
  ],
  "steps": [
    {
      "text": "Stir mahi mahi, lime juice, lemon juice, jalapeno pepper, salt, oregano, and cayenne pepper together in a bowl. Press down fish to completely immerse in liquid. Cover the bowl with plastic wrap and press plastic wrap down so that it is touching the fish. Refrigerate for at least 1 hour, or up to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir avocado, cucumber, orange, chives, radish, cilantro, and olive oil into mahi mahi mixture until completely coated. Season with salt.",
