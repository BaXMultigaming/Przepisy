  "steps": [
    {
      "text": "Cut the grapefruit in half, and set aside one half. Juice the remaining half, and combine with honey, cilantro, and orange extract. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Segment the reserved grapefruit, and combine with jicama, pears, oranges, apples, and mango in a large bowl. Pour cilantro dressing over the fruit, and stir to combine. Chill in the refrigerator for at least one hour before serving.",
