  "ingredients": [
    "cooking spray",
    "2 cups gluten-free oats, divided",
    "1 cup cooked and cooled quinoa",
    "0.5 cup applesauce",
    "2 eggs",
    "0.25 cup white sugar",
    "2 teaspoons vanilla extract",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.75 cup dark chocolate chips",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Spray a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 cup oats in a food processor; pulse 7 to 8 times. Add quinoa and pulse until finely chopped.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer oat and quinoa mixture to a large bowl. Add remaining 1 cup oats, applesauce, eggs, sugar, vanilla extract, baking soda, and salt; mix well to combine. Fold chocolate chips and pecans into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoons of batter onto the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 14 minutes. Let sit on the baking sheet for 1 to 2 minutes before moving to a wire rack to cool, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
