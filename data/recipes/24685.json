  "ingredients": [
    "3 pounds lean ground beef",
    "0.5 cup minced fresh chives",
    "4 ounces blue cheese, crumbled",
    "1.5 teaspoons salt",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon coarsely ground black pepper",
    "1 teaspoon dry mustard",
    "0.25 teaspoon hot pepper sauce",
    "12 hamburger buns, split"
  ],
  "steps": [
    {
      "text": "Mix ground beef, chives, blue cheese, salt, Worcestershire sauce, pepper, mustard, and hot pepper sauce together in a large bowl until well combined. Cover and refrigerate for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to cook, preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove beef mixture from the refrigerator; form into 12 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook patties on the preheated grill until an instant-read thermometer inserted into the center reads at least 160 degrees F (71 degrees C), about 5 minutes per side. Serve on hamburger buns.",
      "section": null,
      "name": null,
      "url": null,
