  "ingredients": [
    "3 cups self-rising flour",
    "2 tablespoons white sugar",
    "1 (12 fluid ounce) can or bottle beer",
    "0.5 cup shredded Cheddar cheese",
    "0.25 cup canned green chile peppers, chopped",
    "6 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together flour, sugar, beer, cheese and chilies. Spoon batter into prepared loaf pan; spread batter to evenly fill pan. Pour melted butter on top of loaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 50 to 60 minutes, until a toothpick inserted into center of loaf comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
