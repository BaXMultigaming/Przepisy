  "ingredients": [
    "3 tablespoons prepared Dijon-style mustard",
    "4 tablespoons honey",
    "2 cups broccoli florets",
    "1 cup shredded Cheddar cheese",
    "1 egg",
    "1 cup milk",
    "0.5 cup sifted all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon vegetable oil",
    "0.5 cup vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "To make the sauce: In a small bowl, stir together the mustard and honey. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chop florets into small pieces or pulse lightly in food processor. Toss in a mixing bowl with shredded cheese. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg and stir in the milk. Sift flour, baking powder, and salt together and combine them with the egg and milk mixture, beating well. Beat in 1/2 teaspoon oil as well. Pour mixture over broccoli and cheese and toss to coat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet or saucepan heat oil to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop broccoli mixture by spoonfuls into 375 degrees F (190 degrees C) oil and fry until golden brown. Serve with honey mustard sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
