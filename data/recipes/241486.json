  "ingredients": [
    "water, as needed",
    "3 carrots, sliced",
    "3 stalks celery, sliced",
    "2 small onions, sliced",
    "1.5 cups kosher salt",
    "1 cup brown sugar",
    "2 lemons, sliced",
    "1 large green bell pepper, sliced",
