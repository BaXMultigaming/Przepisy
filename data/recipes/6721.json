  "ingredients": [
    "6 cups bread flour",
    "1.75 cups warm water (110 degrees F/45 degrees C)",
    "0.75 cup unsweetened cocoa powder",
    "4.5 tablespoons white sugar",
    "1 tablespoon sunflower seed oil",
    "2 teaspoons salt",
    "1 (.25 ounce) package instant yeast"
  ],
  "steps": [
    {
      "text": "Combine flour, warm water, cocoa powder, sugar, sunflower oil, salt, and yeast in a large bowl. Stir everything with a wooden spoon until a soft dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer dough to a lightly floured surface; knead until smooth and elastic, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough in half. Roll each half into a ball and place on a baking sheet. Cut crisscross designs in the top of each ball, then cover with a kitchen towel. Let rise until double in size, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When dough has almost finished rising, preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the kitchen towel, and bake dough in the preheated oven for 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and transfer to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
