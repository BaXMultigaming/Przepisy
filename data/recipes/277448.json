  "ingredients": [
    "1 (9 ounce) package refrigerated tortellini",
    "0.5 cup sliced portobello mushrooms",
    "2 cloves garlic, minced",
    "3 tablespoons butter",
    "0.5 cup evaporated fat-free milk",
    "0.75 cup freshly grated Parmesan cheese",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil; stir in tortellini and return to a boil. Cook uncovered, stirring occasionally, until the tortellini float to the top and the filling is hot, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium-high heat. Add sliced mushrooms and saute until tender, about 5 minutes. Add garlic and cook until fragrant, about 30 seconds. Remove mixture to a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add evaporated milk to skillet and heat over medium-low heat until warm. Stir in Parmesan cheese until melted. Add cooked tortellini and toss to coat. Garnish with mushroom-garlic mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
