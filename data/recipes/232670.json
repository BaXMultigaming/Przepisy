  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "1 (8 ounce) package shredded extra-sharp white Cheddar cheese",
    "1 teaspoon grated horseradish, or more to taste",
    "0.5 teaspoon ground mustard"
