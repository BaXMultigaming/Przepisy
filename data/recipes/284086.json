  ],
  "steps": [
    {
      "text": "Whisk eggs with salt until completely combined and very foamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over low heat until bubbling. Add whisked eggs; cook, stirring frequently for even, moist curds, until thickened and creamy, but still shiny, 2 to 3 minutes.",
