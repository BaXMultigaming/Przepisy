  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "0.5 cup cashews",
    "aluminum foil",
    "1 cup chunky salsa",
    "1 small red bell pepper - cored, seeded, and chopped",
    "2 tablespoons nutritional yeast",
    "0.5 teaspoon ground turmeric",
    "0.25 teaspoon salt",
    "1 (13 ounce) package tortilla chips",
    "1 (15.25 ounce) can black bean chili (such as Amy's®)",
    "2 ripe avocados, peeled and cubed",
    "0.25 cup chopped fresh cilantro, or to taste",
    "0.5 lime, juiced",
    "1 pinch salt, or to taste",
    "1 cup pico de gallo",
    "2 tablespoons chopped fresh cilantro, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fR1AAmTAOZ2vNQ-SxqcIQk24Z7g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270237-vegan-loaded-nachos-VAT-step-01-8273b5b586474bca98d7ee24630d8c3c.jpg"
      ],
      "image": "assets/images/270237/step_01.webp"
    },
    {
      "text": "Place cashews in a bowl and cover with cold water. Soak for 4 hours. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BL-Z3iNKruUBugvX5_YGCDgI03s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270237-vegan-loaded-nachos-VAT-step-02-81276c07c54b4445abd47bbae1432d97.jpg"
      ],
      "image": "assets/images/270237/step_02.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_UjqMQoxuI7xDjryLb-50KbW_Ko=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270237-vegan-loaded-nachos-VAT-step-03-4f14e28b3e3645fa859d7f7fa15b7db7.jpg"
      ],
      "image": "assets/images/270237/step_03.webp"
    },
    {
      "text": "Combine drained cashews, salsa, bell pepper, nutritional yeast, turmeric, and 1 teaspoon salt in a high-speed blender; blend until smooth and slightly warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5QIFOfDiuHPpA7I28cDXyRoKdUs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270237-vegan-loaded-nachos-VAT-step-04-1-73eb7688a9454063bc2f51e09ef1c461.jpg"
      ],
      "image": "assets/images/270237/step_04.webp"
    },
    {
      "text": "Spread tortilla chips on the prepared baking sheet. Spoon chili all over chips and spoon cashew \"nacho\" cheese over chili.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MWryRCd-sgej7-LJXs5yOBzA940=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270237-vegan-loaded-nachos-VAT-step-05-f5b73cea43e544ddab9ba7be4d329990.jpg"
      ],
      "image": "assets/images/270237/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until hot, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a9ncWvE0yontF3OlgTUPYDXHln8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270237-vegan-loaded-nachos-VAT-step-06-4f55ab758ff34baabc1fd77601a3a1a6.jpg"
      ],
      "image": "assets/images/270237/step_06.webp"
    },
    {
      "text": "Meanwhile, place avocados, 1/4 cup cilantro, and lime juice in a bowl. Season with salt and mash with a fork until guacamole is mostly smooth but a little chunky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kelHDBZTXbPvCq52LCDCDtV7mt0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270237-vegan-loaded-nachos-VAT-step-07-544a1067ca234f33846693e0c34cb7a9.jpg"
      ],
      "image": "assets/images/270237/step_07.webp"
    },
    {
      "text": "Top nachos with guacamole and pico de gallo, and sprinkle with cilantro. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Kb-do_JPOUWNPv5bVFnaGlonQQo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270237-vegan-loaded-nachos-VAT-step-08-52b1653bd9ee448daa0db8cdf04c3f11.jpg"
      ],
      "image": "assets/images/270237/step_08.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V31wZGdXVkq4q6RMc_grVTu4aJ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270237-vegan-loaded-nachos-VAT-4x3-ea5b9e251033448ba9a1a1df9cbc520d.jpg"
      ],
      "image": "assets/images/270237/step_09.webp"
    }
  ],
