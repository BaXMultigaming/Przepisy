  "title": "Loaded Vegan Nachos",
  "description": "Baked vegan nachos loaded with spicy black beans are topped with vegan cashew cheese, salsa, guacamole, and cilantro for the ultimate vegan appetizer.",
  "authors": [
    "Shannan Labrador"
  ],
  "date_published": "2020-02-26T20:54:33-05:00",
  "date_modified": "2025-05-01T17:31:48-04:00",
