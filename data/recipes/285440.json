  "title": "Carrot Cake Cupcakes with Cream Cheese Frosting",
  "description": "These moist carrot cake cupcakes taste just like the cake! Top with a luscious homemade cream cheese frosting for a deliciously easy dessert.",
  "authors": [
    "Zepheera"
  ],
  "date_published": "2021-07-14T16:11:24-04:00",
