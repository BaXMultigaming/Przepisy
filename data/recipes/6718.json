  "ingredients": [
    "1 egg",
    "0.25 cup water",
    "0.5 cup evaporated skim milk",
    "1 teaspoon salt",
    "1.5 teaspoons canola oil",
    "3 cups bread flour",
    "1 teaspoon ground cardamom",
    "3 tablespoons white sugar",
    "1 teaspoon active dry yeast"
  ],
  "steps": [
    {
      "text": "Place all ingredients into bread machine in the proper order for your machine. Use the Dough cycle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "At end of the Dough cycle, remove dough from the machine. Place on a lightly floured board, and let it rest, covered, for about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into a loaf, and place it in a 9 x 5 inch greased bread pan. Cover, and let rise for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Just before baking, brush the top of the dough with a little milk, and slash a line down the center. Bake at 375 degrees F (190 degrees C) for 30 to 35 minutes. Remove from pan, and cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
