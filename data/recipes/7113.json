  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.75 cup white sugar",
    "1.25 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.125 teaspoon salt",
    "1 cup mashed bananas",
    "2 egg whites",
    "0.25 cup applesauce",
    "0.5 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Coat a 12-cup muffin tin with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking powder, baking soda, cinnamon, and salt together in a bowl. Mix in mashed banana, egg whites, and applesauce until just moistened. Stir in chocolate chips. Divide batter into muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
