  "ingredients": [
    "3.5 pounds chicken wings, tips on",
    "1 (28 ounce) can tomato sauce",
    "3 (10.75 ounce) cans tomato soup",
    "2 teaspoons ground cloves",
    "2 cloves garlic, crushed",
    "8 bay leaves",
    "1 teaspoon cayenne pepper",
    "salt and pepper to taste",
    "2 cups long grain rice, rinsed and drained",
    "4 cups water",
    "1 teaspoon cloves",
    "1.5 teaspoons salt",
    "2 teaspoons ground turmeric",
    "0.33333334326744 cup slivered almonds",
    "0.33333334326744 cup golden raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour tomato sauce and soup into a large roasting pan. Stir in cloves, garlic, bay leaves, cayenne, and salt and pepper. Take the tip of each chicken wing and bend it back, securing it under the joint where thigh and drummette are joined. Place wings in pan, and spoon sauce over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover pan, and bake in a preheated oven for 30 minutes. Reduce heat to 325 degrees F (165 degrees C), and bake until sauce is thick, about 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To prepare rice, combine rice, water, cloves, salt, turmeric, almonds, and raisins in a large saucepan over high heat. Bring to a boil. Reduce heat, and simmer until rice is cooked, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
