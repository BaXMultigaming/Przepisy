  "title": "Worcestershire Ribs",
  "description": "A simple Worcestershire sauce made with tomato paste, hot pepper sauce, and golden syrup adds sweet and spicy flavor to pork ribs as they finish baking.",
  "authors": [
    "Seafood Rick"
  ],
  "date_published": "2015-07-24T02:01:49-04:00",
