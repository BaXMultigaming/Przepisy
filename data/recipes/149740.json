  "ingredients": [
    "1.25 pounds pork spareribs",
    "0.5 cup tomato paste",
    "0.5 cup Worcestershire sauce",
    "0.25 cup golden syrup",
    "2 teaspoons hot pepper sauce (e.g. Tabasco™)",
    "1 sweet red pepper, seeded and cut into thin strips",
    "1 onion, thinly sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Cover a roasting pan with aluminum foil and place ribs into the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes, turning ribs halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the ribs are cooking, stir tomato paste, Worcestershire sauce, golden syrup, and hot pepper sauce together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove ribs from the oven and drain off fat. Drizzle sauce over ribs and bake for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle red pepper and onion over ribs and continue to bake until meat pulls away easily from the bone, about 10 more minutes. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
