  "ingredients": [
    "4 quarts water",
    "2 tablespoons salt",
    "1 head cauliflower, cut into bite-sized pieces",
    "1 cup mayonnaise",
    "0.5 cup thinly sliced celery",
    "3 slices cooked bacon, crumbled",
    "4 tablespoons minced onion",
    "3 tablespoons minced sweet pickles",
    "1 teaspoon spicy mustard, or to taste",
    "0.125 teaspoon ground turmeric",
    "2 hard-boiled eggs, diced",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring water and salt to a boil over medium-high heat. Add cauliflower; bring back to a boil. Cook for 3 minutes. Remove from heat and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cauliflower pieces onto a metal tray and freeze until cool, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine mayonnaise, celery, bacon, onion, pickles, mustard, and turmeric in a large bowl. Add cooled cauliflower and eggs; toss to combine. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
