  "ingredients": [
    "1 (8 ounce) package bulk pork sausage",
    "4 large hard-boiled eggs, peeled",
    "1 large egg",
    "0.5 cup Italian bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking pan with aluminum foil. Place a wire rack over the foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut and form pork sausage into 2-ounce patties. Place a hard-boiled egg in the center of each patty and press sausage around the egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat raw egg in a small bowl. Place bread crumbs in another bowl. Dip each patty into the egg; roll in the bread crumbs to coat. Place coated patties on the wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 20 to 22 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
