  "ingredients": [
    "cooking spray",
    "1 cup all-purpose flour, or more as needed",
    "1 cup quick-cooking oats",
    "0.5 cup brown sugar",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup cold unsalted butter, cubed",
    "1 large egg, beaten",
    "0.5 teaspoon almond extract",
    "0.75 cup apricot preserves",
    "0.25 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, oats, brown sugar, baking powder, and salt in a large bowl. Cut in butter until mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix almond extract into the beaten egg and stir into the crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press half of the crumb mixture into the prepared baking dish and spread apricot preserves over it. Top with the remaining crumbs, and gently press down. Sprinkle almonds evenly over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven, cool on a wire rack, and then cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
