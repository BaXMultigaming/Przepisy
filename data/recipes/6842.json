  "title": "Chinky's Bibingka",
  "description": "A specialty of the Philippines, this sweet bread is heavy with coconut milk. A grating of cheese cuts the sugar just a bit.",
  "authors": [
    "Chinky Viola"
  ],
  "date_published": "1998-08-13T06:04:23-04:00",
