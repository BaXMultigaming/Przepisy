  "title": "Italian Chicken Marinade",
  "description": "This Italian marinade for chicken breasts is incredibly simple to make with just three ingredients for tender, flavorsome grilled chicken.",
  "authors": [
    "Steve Harrity"
  ],
  "date_published": "1999-08-10T15:09:40-04:00",
