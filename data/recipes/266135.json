  "ingredients": [
    "1 pound small broccoli florets",
    "2 tablespoons olive oil",
    "sea salt to taste",
    "fresh ground black pepper to taste",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine broccoli florets and olive oil in a bowl and toss to lightly coat. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay a large sheet of aluminum foil on a flat work surface. Transfer broccoli to the center of the sheet and fold edges in to create a sealed packet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Remove packet from oven and open aluminum foil to expose broccoli. Sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return packet to the oven and continue baking until floret tips start to blacken and stalks are greenish-brown, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
