  "ingredients": [
    "2 cups panko bread crumbs",
    "1 tablespoon parsley flakes",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "0.5 teaspoon ground black pepper",
    "1 (1 pound) pork tenderloin, cut crosswise into 1/2-inch thick slices",
    "0.25 cup olive oil"
  ],
  "steps": [
    {
      "text": "Stir panko bread crumbs, parsley flakes, garlic powder, onion powder, and black pepper together in a bowl. Dip tenderloin slices in the crumb mixture to coat both sides.",
      "section": null,
      "name": null,
      "url": null,
