  "ingredients": [
    "0.25 cup white sugar",
    "0.25 cup water",
    "2 tablespoons ground coffee beans",
    "0.5 cup gold rum",
    "3 cups crushed ice",
    "1.25 cups freshly squeezed lemon juice",
    "5 ounces pineapple juice"
  ],
  "steps": [
    {
      "text": "Combine sugar and water in a large cocktail shaker; cover and shake until sugar dissolves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set a coffee filter in a sieve (or a pour-over coffee cone) set over a bowl or mug. Add coffee grounds to the filter; slowly pour a small amount of rum over grounds. Set aside to soak, about 1 minute. Slowly pour remaining rum over grounds until drips through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 1 ½ cups crushed ice, lemon juice, pineapple juice, and coffee-washed rum to cocktail shaker with simple syrup. Cover and shake until well chilled. Pour, unstrained, into 2 Collins or old-fashioned glasses; top with remaining crushed ice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
