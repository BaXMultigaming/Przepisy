  "ingredients": [
    "2.5 pounds fresh green beans, or more as needed, trimmed",
    "1 onion, minced",
    "3 tablespoons olive oil",
    "0.75 teaspoon salt",
    "0.25 teaspoon pepper",
    "0.25 cup grated Parmesan cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Brush a roasting pan with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beans and onion in the roasting pan. Drizzle on olive oil and sprinkle with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven, stirring only once or twice, until beans are tender-crisp, about 30 minutes. Top with Parmesan cheese. Serve immediately or once cooled to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
