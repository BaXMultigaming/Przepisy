  "ingredients": [
    "1 (14 ounce) package Hillshire Farm® Smoked Sausage, bias-sliced 1/2-inch thick",
    "3 tablespoons apple cider vinegar",
    "1 tablespoon minced shallot",
    "2 teaspoons honey",
    "1.5 teaspoons Dijon-style mustard",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.33333334326744 cup olive oil",
    "1.5 pounds Brussels sprouts, thinly sliced",
    "0.5 medium red onion, thinly sliced",
    "0.5 cup toasted walnuts, coarsely chopped",
    "0.5 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "In a large skillet, cook and stir sausage slices over medium heat about 5 minutes or until browned. Set aside to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For vinaigrette, in a small bowl, combine cider vinegar, shallot, honey, mustard, salt, and pepper. Slowly whisk in olive oil and beat until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine cooked sausage, Brussels sprouts, red onion, walnuts, and dried cranberries. Drizzle with vinaigrette. Gently toss.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve immediately or cover and chill up to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
