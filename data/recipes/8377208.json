  "ingredients": [
    "1 teaspoon olive oil",
    "0.25 cup chopped corned beef",
    "2 tablespoons minced onion",
    "3 large eggs, beaten",
    "1 slice Swiss cheese, cut into 4 pieces",
    "salt and freshly ground black pepper to taste",
    "4 slider buns, toasted"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a skillet over low heat. Add corned beef and onions and cook, stirring occasionally, until onion is translucent, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in eggs, and scramble until cooked, 2 to 3 minutes; don't overcook the eggs or they'll be rubbery.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Evenly portion out egg mixture over the bottom halves of the slider buns, add a piece of Swiss cheese, season with salt and pepper, and add the top halves of the buns. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
