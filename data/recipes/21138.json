  "ingredients": [
    "3 medium beets, peeled and cut into 1 inch cubes",
    "1 large turnip, peeled and cubed",
    "1 cup pearl onions, peeled",
    "0.25 cup olive oil",
    "0.5 teaspoon dried rosemary",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the beets and turnip in a 9x9 inch baking dish. Cut an X in the root end of the onions and place them in the dish. Drizzle the olive oil over the vegetables and add the rosemary and salt. Stir to coat the vegetables with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 1 hour, or until the vegetables are golden brown and tender. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
