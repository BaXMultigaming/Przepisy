  "ingredients": [
    "5 cups thinly sliced apples",
    "2 tablespoons lemon juice",
    "0.25 cup water",
    "0.5 cup all-purpose flour",
    "0.5 cup rolled oats",
    "1 cup packed brown sugar",
    "0.75 teaspoon ground nutmeg",
    "1 pinch salt",
    "0.5 cup butter, softened",
    "1 cup coarsely chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss apples with lemon juice and water in a shallow 2 quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine flour, oats, sugar, nutmeg, and salt. Mix to blend thoroughly. Cut in the butter or margarine until mixture resembles coarse crumbs. Mix in walnuts. Crumble over apples to cover completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 40 to 45 minutes until top is lightly browned. Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
