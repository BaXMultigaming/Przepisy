  "ingredients": [
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "1.25 cups vegetable oil",
    "3 large eggs",
    "0.25 cup orange juice",
    "1 teaspoon vanilla extract",
    "1 cup apple - peeled, cored, and chopped",
    "1 cup chopped walnuts",
    "1 cup flaked coconut",
    "1 cup white sugar",
    "0.5 cup buttermilk",
    "6 tablespoons unsalted butter",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 10-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, 2 cups sugar, 1 teaspoon baking soda, salt, and cinnamon together in a large bowl until well combined for cake. Make a well in center; add oil, eggs, orange juice, and vanilla extract. Mix until well combined. Stir in apple, walnuts, and coconut. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center of cake comes out clean, 75 to 90 minutes. Remove from the oven; poke holes all over cake with a chopstick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring 1 cup sugar, buttermilk, butter, and 1/2 teaspoon baking soda to a boil in a medium saucepan for glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour hot glaze over cake; let stand for 1 hour. Carefully turn cake out onto a serving plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
