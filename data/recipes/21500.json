  "ingredients": [
    "0.25 cup white wine",
    "0.25 cup white wine vinegar",
    "1 tablespoon shallots",
    "0.5 cup heavy cream",
    "0.75 cup butter",
    "24 sea scallops",
    "1 tablespoon olive oil",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine white wine, vinegar, and shallots in a medium saucepan over medium-high heat. Cook until about 1 tablespoon liquid remains in the pan. Stir in heavy cream; continue boiling until reduced by half. Stir in butter, 1 tablespoon at a time, until melted. Keep sauce warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven on broiler setting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush scallops with olive oil; sprinkle with salt and pepper. Place under the preheated broiler until scallops are opaque, with a bit of brown around the edges, about 2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a spoonful of sauce on each plate and top with 4 scallops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
