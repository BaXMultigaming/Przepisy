  "ingredients": [
    "1.5 tablespoons chopped shallot",
    "1 bay leaf",
    "6 black peppercorns",
    "0.25 cup white wine vinegar",
    "2 tablespoons dry white wine",
    "0.25 cup heavy cream",
    "1.5 cups cold butter, cut into 1/2 inch pieces"
  ],
  "steps": [
    {
      "text": "Place shallot, bay leaf, peppercorns, vinegar, and wine in a saucepan. Bring to a boil, then reduce heat to medium and continue simmering until only 2 tablespoons of liquid remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in heavy cream and bring to a simmer; simmer until the cream has reduced by half. Increase heat to medium-high, and rapidly whisk in the butter, piece, by piece until it has melted into the cream and thickened it. Strain the sauce through a mesh strainer to remove the spices. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
