  "ingredients": [
    "1 (9 inch) prepared graham cracker crust",
    "2 (8 ounce) packages lowfat cream cheese, softened",
    "0.5 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "2 eggs",
    "1 (8 ounce) container blueberry flavored yogurt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat the cream cheese, sugar and vanilla until smooth. Beat in eggs, one at a time. Stir in yogurt. Pour filling into crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 40 minutes, or until filling is set. Refrigerate at least 4 hours before serving.",
      "section": null,
