  "ingredients": [
    "4 large whole artichokes, top 1 inch and stems removed",
    "0.25 cup fresh lemon juice",
    "0.25 cup olive oil",
    "4 cloves garlic, cloves peeled and crushed",
    "kosher salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place artichokes stem-side down in a bowl and drizzle with lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VBmi0sMw2HW1taCP0mS8JtwuFhI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221071-simply-roasted-artichokes-step-1-0670-1-c375132b277e48c899fa9962e7ed4aa2.jpg"
      ],
      "image": "assets/images/221071/step_02.webp"
    },
    {
      "text": "Slightly separate the artichoke leaves with your hands. Insert a knife blade into the center of each artichoke to create a garlic clove-size space.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7y6Z7YDUbTKtZ9gzgfe2jEVHotQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221071-simply-roasted-artichokes-step-2-0671-1-a541e5c100be4e00ba7dbe8bd20ffaa8.jpg"
      ],
      "image": "assets/images/221071/step_03.webp"
    },
    {
      "text": "Drizzle each artichoke with olive oil and press 1 clove of garlic into the center of each artichoke; season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A8V3R2v1_NYMv7eQsrrtBg6rusw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221071-simply-roasted-artichokes-step-3-0673-1-bd61bae7aac44774bfef96f627e2eeb2.jpg"
      ],
      "image": "assets/images/221071/step_04.webp"
    },
    {
      "text": "Tightly wrap each artichoke twice with heavy-duty aluminum foil; place in a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GeM06ZKsLBWvcK_xBHuF7eg9AC8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221071-simply-roasted-artichokes-step-4-0674-1-95da5c292ecd48d9816900205ed14ca1.jpg"
      ],
      "image": "assets/images/221071/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until sizzling, about 1 hour 20 minutes",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aDkowxutf8sSwfxpw-q9W6Ultxk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221071-simply-roasted-artichokes-DDMFS-4x3-8f5d534a63f34fa591e4c7de61934ed4.jpg"
