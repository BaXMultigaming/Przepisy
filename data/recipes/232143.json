  "ingredients": [
    "2.25 cups all-purpose flour",
    "1.5 cups white sugar",
    "1.5 teaspoons baking powder",
    "0.75 teaspoon baking soda",
    "0.5 cup butter, room temperature",
    "1 cup buttermilk",
    "2 eggs",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, and baking soda in a large bowl. Cut butter into flour mixture until mixture resembles coarse crumbs. Reserve about 1 cup butter crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir buttermilk, eggs, and vanilla extract into remaining crumbs until batter is just combined; pour batter into prepared baking dish. Sprinkle reserved butter crumbs over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
