  "ingredients": [
    "0.5 cup all-purpose flour",
    "0.5 cup packed brown sugar",
    "0.5 cup quick cooking oats",
    "1 teaspoon ground cinnamon",
    "0.5 cup butter, softened",
    "1 (40 ounce) can cut yams, drained",
    "0.5 cup whole berry cranberry sauce, drained",
    "1 cup mini marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the flour, brown sugar, oats, and cinnamon together in a bowl; cut the butter into the mixture until crumbled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the yams and cranberries in a larger bowl. Stir 1 cup of the flour mixture into the yams and cranberries; pour the mixture into the bottom of an 8-inch square baking dish and top with the remaining flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes; top with the marshmallows and return to the oven until the marshmallows are browned, about 10 minutes more.",
      "section": null,
