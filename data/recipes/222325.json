  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon salt",
    "3 eggs",
    "0.75 cup softened butter",
    "1.25 cups white sugar",
    "1 teaspoon vanilla extract",
    "2 cups chopped mango",
    "0.5 cup shredded coconut",
    "0.25 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Grease and flour two 8x4-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, cinnamon, and salt together in a large bowl; make a well in the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, butter, sugar, and vanilla extract together in a separate bowl; fold in mango, coconut, and walnuts. Pour this mixture into the well in flour mixture; stir to combine. Pour batter into prepared loaf pans; let sit at room temperature for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
