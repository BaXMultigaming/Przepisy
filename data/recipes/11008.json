  "ingredients": [
    "0.5 cup unsalted butter",
    "1.125 cups white sugar",
    "1 egg",
    "1 tablespoon dark rum",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1.5 cups toffee baking bits",
    "0.5 cup chopped almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees F).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar in large bowl until fluffy. Add egg, rum, and vanilla and beat until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cocoa, baking soda and salt into small bowl. Stir dry ingredients into butter mixture. Mix in toffee and chopped almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter by heaping tablespoonfuls onto heavy large ungreased baking sheet, spacing 2 inches apart. Bake until cookies puff slightly and crack on top but are still soft to tough, about 11 minutes. Let cookies cool on sheet 1 minutes. Transfer cookies to rack and cool completely. Repeat shaping and baking with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
