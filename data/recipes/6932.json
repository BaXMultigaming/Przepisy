  "title": "Orange Pumpkin Loaf",
  "description": "This moist orange pumpkin loaf combines whole orange, pumpkin, and walnuts for a flavorful fall treat. Perfect plain or with cream cheese spread.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-08-31T15:56:47-04:00",
