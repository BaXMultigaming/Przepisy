  "ingredients": [
    "1 cup whole wheat flour",
    "1 cup all-purpose flour",
    "1 cup chocolate chips",
    "0.5 cup vanilla whey protein powder",
    "0.5 cup white sugar",
    "0.25 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "1 cup milk",
    "1 cup peanut butter",
    "3 eggs",
    "0.5 cup vegetable oil",
    "0.5 cup plain yogurt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease mini muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine whole wheat flour, all-purpose flour, chocolate chips, protein powder, sugar, cocoa powder, and baking soda in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, peanut butter, eggs, oil, and yogurt in another bowl until smooth. Pour over flour mixture and stir until batter is just blended. Fill muffin cups 3/4 of the way full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the centers comes out clean, about 10 minutes. Cool in the muffin pans for 10 minutes before removing to a wire rack until completely cooled, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
