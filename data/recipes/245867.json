  "title": "Sasa's Chocolate Peanut Butter Protein Bites",
  "description": "Vanilla protein powder and peanut butter make these bite-size chocolate chip muffins the perfect on-the-go snack before or after a workout.",
  "authors": [
    "Sasa's Kitchen"
  ],
  "date_published": "2020-06-19T00:04:33-04:00",
