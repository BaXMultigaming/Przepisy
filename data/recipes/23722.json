  "ingredients": [
    "0.5 (14 ounce) package vegetarian ground beef (e.g., Gimme Lean TM)",
    "1 (12 ounce) package vegetarian burger crumbles",
    "1 onion, chopped",
    "2 eggs, beaten",
    "2 tablespoons vegetarian Worcestershire sauce",
    "1 teaspoon salt",
    "0.33333334326744 teaspoon pepper",
    "1 teaspoon ground sage",
    "0.5 teaspoon garlic powder",
    "2 teaspoons prepared mustard",
    "1 tablespoon vegetable oil",
    "3.5 slices bread, cubed",
    "0.33333334326744 cup milk",
    "1 (8 ounce) can tomato sauce",
    "4 carrots, cut into 1 inch pieces",
    "4 potatoes, cubed",
    "1 cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine vegetarian ground beef, vegetarian ground beef crumbles, onion, eggs, Worcestershire sauce, salt, pepper, sage, garlic powder, mustard, oil, bread cubes and milk. Transfer to a 9 x 13 inch baking dish and form into a loaf. Pour tomato sauce on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place carrots and potatoes around loaf and spray vegetables with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 30 to 45 minutes; turn vegetables. Bake another 30 to 45 minutes. Let stand 15 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
