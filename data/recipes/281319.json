  "ingredients": [
    "12 empanada pastry discs (such as Goya® Tapas para Empanadas)",
    "1 cup diced cooked chicken",
    "0.5 (8 ounce) package Neufchatel cheese, softened",
    "0.25 cup medium salsa (such as Pace®)",
    "0.5 teaspoon salt, or to taste",
    "1.5 tablespoons heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chicken, Neufchatel cheese, and salsa in a saucepan over medium heat until cheese melts, 3 to 5 minutes; season with salt and stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop 1 tablespoon chicken filling onto each empanada disc; fold dough over filling to enclose. Wet fingers with water; run along dough edges to help seal. Press edges together using the tines of a fork. Place empanadas on the prepared baking sheet; brush with heavy cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
