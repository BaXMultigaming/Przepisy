  "ingredients": [
    "4 tablespoons salted butter",
    "1 head cabbage, cored and cut into large pieces",
    "0.5 cup water",
    "1 tablespoon dried dill weed",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a deep saucepan large enough to fit all the cabbage. Add cabbage, water, dill, salt, and black pepper. Cover; simmer, stirring often, until tender, about 20 minutes. Taste; adjust seasonings.",
