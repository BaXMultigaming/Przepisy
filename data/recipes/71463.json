  "ingredients": [
    "2 pounds country style pork ribs",
    "4 cups chicken broth",
    "0.125 cup teriyaki sauce",
    "1.5 tablespoons garlic powder",
    "1 tablespoon onion powder",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Place ribs in a roasting pan. In a large bowl, mix chicken broth, teriyaki sauce, garlic powder, onion powder, salt, and pepper until well combined; pour over ribs. Cover the pan with aluminum foil and marinate in the refrigerator for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook covered pan until meat is so tender it easily falls off the bone, about 2 hours. Check occasionally to ensure juices do not boil over, removing some broth if necessary.",
      "section": null,
      "name": null,
      "url": null,
