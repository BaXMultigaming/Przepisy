  "steps": [
    {
      "text": "Bring water and farro to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until farro is tender, about 30 minutes. Drain; cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine parsley and mint in the bowl of a food processor; pulse until finely chopped. Transfer to a bowl. Add farro, tomato, cucumber, onion, olive oil, lemon juice, salt, and black pepper; toss lightly. Refrigerate before servings, 3 to 4 hours.",
      "section": null,
