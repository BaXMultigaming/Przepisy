  "ingredients": [
    "1 cup all-purpose flour",
    "3 tablespoons unsweetened cocoa powder",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup margarine",
    "0.5 cup brown sugar",
    "0.5 cup white sugar",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "1.25 cups rolled oats",
    "0.5 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zuajesY2bqSUrZ4PYHUi1shCbgI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25023-Chocolate-Oatmeal-Cookies-ddms-4x3-step1-603c776464ff49b49c3d79866e6e4cb0.jpg"
      ],
      "image": "assets/images/25023/step_01.webp"
    },
    {
      "text": "Stir flour, cocoa, baking powder, baking soda, salt, and cinnamon together in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GaPJL-DcBpjmmaM3j3bJAF1gVug=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25023-Chocolate-Oatmeal-Cookies-ddms-4x3-step2-ad39b69a7a5f435aa5cc4f52d546434e.jpg"
      ],
      "image": "assets/images/25023/step_02.webp"
    },
    {
      "text": "Beat margarine, brown sugar, and white sugar together in a large bowl with an electric mixer until light and fluffy. Beat in egg and vanilla. Stir in flour mixture using a wooden spoon. Mix in oats and chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fCIxKaxTxQl1hP1zHt6mNfIvg7s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25023-Chocolate-Oatmeal-Cookies-ddms-4x3-step4-00eaae149707485bb79d6ce2c4335c61.jpg"
      ],
      "image": "assets/images/25023/step_03.webp"
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x6wA7ESPYOLYlGc-j6Bnq4mInAA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25023-Chocolate-Oatmeal-Cookies-ddms-4x3-step5-0f0888ae126b4ca48b1c17893dfde0ee.jpg"
      ],
      "image": "assets/images/25023/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 8 to 10 minutes. Cool on the baking sheet briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HyF-xWs2Eypyk9FqAiGC5H564H0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25023-Chocolate-Oatmeal-Cookies-ddms-4x3-80ae113f36ab4465883cac8d8c2ec2c5.jpg"
      ],
      "image": "assets/images/25023/step_05.webp"
    }
