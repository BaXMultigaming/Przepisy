  "title": "Cornbread Pancakes with Fresh Strawberry Syrup",
  "description": "Topped with a fresh strawberry syrup, Chef John's cornbread pancakes are light and fluffy with a lovely texture in each bite from the cornmeal.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2022-03-29T09:00:00-04:00",
  "date_modified": "2023-07-11T14:07:41-04:00",
