  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 pound fresh strawberries, hulled",
    "0.5 cup white sugar",
    "0.5 cup cold water",
    "2 teaspoons fresh lemon juice",
    "0.75 cup all-purpose flour",
    "2 tablespoons white sugar",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "1 teaspoon kosher salt",
    "1.75 cups buttermilk",
    "1.25 cups cornmeal",
    "3 tablespoons unsalted butter, divided, or more as needed",
    "2 large eggs"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wsVAEAfniOyZ9fGnveAfXGItKY4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8372401-cornbread-pancakes-with-fresh-strawberry-syrup-VAT-ingredients-2-7e3865a1ffc144519da19cc014b54579.jpg"
      ],
      "image": "assets/images/8372401/step_01.webp"
    },
    {
      "text": "Place strawberries in a saucepan over medium-high heat. Stir in sugar, water, and lemon juice and bring to a simmer. Lower heat to medium and cook, stirring occasionally, until strawberries are very soft, and the syrup starts to thicken, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R85cfcqdPWYps4LsrN9jBix3WoI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8372401-cornbread-pancakes-with-fresh-strawberry-syrup-VAT-step-02-6dde530647d049cfbf221f3469264481.jpg"
      ],
      "image": "assets/images/8372401/step_02.webp"
    },
    {
      "text": "Remove from the stove and carefully pass through a mesh sieve into a bowl. Discard any seeds and fibrous bits that are left in the sieve. Let syrup cool for 15 minutes, then cover and store in the refrigerator until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C9yaVDZg8Z6y6ZkEexG8ciXrpBE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8372401-cornbread-pancakes-with-fresh-strawberry-syrup-VAT-step-04-811e86f92b1a4f0490b95af6187ded98.jpg"
      ],
      "image": "assets/images/8372401/step_03.webp"
    },
    {
      "text": "Whisk together flour, sugar, baking powder, baking soda, and salt in a bowl until all ingredients are well incorporated; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dYoZ6hoqBnbpd-Sk__KVHwQthC4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8372401-cornbread-pancakes-with-fresh-strawberry-syrup-VAT-step-05-8df0bca483004a5e951abb445de302d1.jpg"
      ],
      "image": "assets/images/8372401/step_04.webp"
    },
    {
      "text": "Place buttermilk, cornmeal, and 2 tablespoons butter in a saucepan over medium heat. Stir with a whisk until butter melts and mixture starts to simmer. Once simmering, cook and stir until very thick, about 2 minutes. Remove from the heat and cool for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/azTa4zPsREn_T8IfbOUoSKryIJw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8372401-cornbread-pancakes-with-fresh-strawberry-syrup-VAT-step-06-cb59c1cde82d49988704395c8fdf37c1.jpg"
      ],
      "image": "assets/images/8372401/step_05.webp"
    },
    {
      "text": "Whisk eggs into the cooled cornmeal mixture until incorporated. Add the reserved flour mixture and stir with a spatula until well combined and no flour remains in the saucepan; batter will be thick but still scoopable.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WPlqrc00gVbBYbIPhKCqa6kjPAc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8372401-cornbread-pancakes-with-fresh-strawberry-syrup-VAT-step-07-7e10b275bb434a7f9aaa40bd08483526.jpg"
      ],
      "image": "assets/images/8372401/step_06.webp"
    },
    {
      "text": "Melt 1 tablespoon butter in a skillet over medium heat. Working in batches, scoop 1/3 cup batter for each pancake into the hot skillet and press them down with the back of a spatula to flatten out. Cook until the outside edges start to look a little dry, about 3 to 4 minutes. Flip and repeat on the other side until pancakes are cooked through, another 3 to 4 minutes. Repeat to cook remaining pancakes, adding more butter to the skillet as necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nPp3X0du3Q2xUhPFye8OeM1gY2k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8372401-cornbread-pancakes-with-fresh-strawberry-syrup-VAT-step-08-935cc509d4764b52bb8f23443ef281f4.jpg"
      ],
      "image": "assets/images/8372401/step_07.webp"
    },
    {
      "text": "Top warm pancakes with strawberry syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OrF091sAVI17W4BdNPav4RBZJKI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8372401-cornbread-pancakes-with-fresh-strawberry-syrup-VAT-4x3-1-9644ff475d4f4f33a44f69a3bdf9361a.jpg"
      ],
      "image": "assets/images/8372401/step_08.webp"
    }
  ],
