  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 cup whole wheat flour",
    "1.25 cups white sugar",
    "1 tablespoon ground cinnamon",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups grated carrots",
    "1 apple - peeled, cored, and chopped",
    "1 cup raisins",
    "1 egg",
    "2 egg whites",
    "0.5 cup apple butter",
    "0.25 cup vegetable oil",
    "1 tablespoon vanilla extract",
    "2 tablespoons chopped walnuts",
    "2 tablespoons toasted wheat germ"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly oil 18 muffin cups, or coat with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, whisk together eggs, egg whites, apple butter, oil and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together flours, sugar, cinnamon, baking powder, baking soda and salt. Stir in carrots, apples and raisins. Stir in apple butter mixture until just moistened. Spoon the batter into the prepared muffin cups, filling them about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine walnuts and wheat germ; sprinkle over the muffin tops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 15 to 20 minutes, or until the tops are golden and spring back when lightly pressed.",
      "section": null,
      "name": null,
      "url": null,
