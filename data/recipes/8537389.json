  "ingredients": [
    "0.5 cup water",
    "0.25 cup white grape juice or white cranberry juice",
    "1 serving wild strawberry sugar-free drink mix (such as Crystal Light)",
    "1 (2 g) bag hibiscus tea (such as Tazo Passion®)",
    "2.25 cups refrigerated unsweetened coconut milk",
    "ice cubes, freeze-dried strawberries, or sliced fresh or frozen strawberries as garnish (optional)"
  ],
  "steps": [
    {
      "text": "Pour water, juice, and drink mix into a glass. Stir to dissolve. Add tea bag. Let stand for 5 minutes (it doesn't have to be hot). Remove and discard tea bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill 2 tall glasses with ice. Add half the strawberry-tea mixture and half the coconut milk to each glass. Stir to combine. Stir in strawberries (if using).",
