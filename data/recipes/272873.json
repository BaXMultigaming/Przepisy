  "ingredients": [
    "1.5 cups whole wheat flour",
    "1 cup milk",
    "2 large eggs",
    "2 tablespoons butter, softened",
    "1 tablespoon baking powder",
    "2 teaspoons baking powder",
    "0.5 cup blueberries, or to taste"
  ],
  "steps": [
    {
      "text": "Place flour, milk, eggs, butter, and 1 tablespoon plus 2 teaspoons baking powder in a blender; blend until smooth, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle over medium-high heat. Drop batter by large spoonfuls onto the griddle and dot with blueberries. Cook until bubbles form and burst, and the pancake edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter.",
