  "ingredients": [
    "1 cup mayonnaise",
    "1 teaspoon curry powder",
    "1 teaspoon crushed garlic",
    "1 tablespoon tarragon vinegar",
    "1 teaspoon grated onion",
    "1 teaspoon prepared horseradish"
  ],
  "steps": [
    {
      "text": "In a small bowl, combine mayonnaise, curry powder, garlic, vinegar, onion and horseradish. Mix together, cover, and chill overnight to allow the flavors to blend.",
