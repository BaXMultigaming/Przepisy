  "ingredients": [
    "cooking spray",
    "3 tablespoons olive oil",
    "3 tablespoons mustard",
    "2 tablespoons honey",
    "2 green onions, minced",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.125 teaspoon ground cayenne pepper",
    "2 pounds baby red potatoes, scrubbed and quartered"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Spray a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, mustard, honey, green onions, salt, black pepper, and cayenne in a large bowl to combine. Add potatoes and toss to coat. Spread evenly on the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are cooked all the way through and browned, 20 to 30 minutes.",
