  "ingredients": [
    "4 (15 ounce) cans black-eyed peas, rinsed and drained",
    "1 red bell pepper, finely chopped",
    "1 yellow bell pepper, finely chopped",
    "0.5 onion, finely chopped",
    "2 jalapeno chiles, seeded and finely chopped",
    "2 tablespoons chopped fresh parsley",
    "1 clove garlic, minced",
    "0.5 cup red wine vinegar",
    "2 tablespoons balsamic vinegar",
    "0.25 cup olive oil",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon ground cumin",
    "4 slices cooked bacon, crumbled"
  ],
  "steps": [
    {
      "text": "Combine black-eyed peas, bell peppers, onion, jalapeño chiles, parsley, and garlic in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk red wine vinegar and balsamic vinegar together in a small bowl; gradually pour in olive oil, whisking constantly until thoroughly blended. Stir in salt, black pepper, and cumin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing over pea salad, tossing to coat evenly. Cover and refrigerate until completely chilled, about 3 hours. Just before serving, stir in bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
