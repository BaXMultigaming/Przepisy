  "ingredients": [
    "7 cups sliced cucumbers",
    "salt as needed",
    "1 cup sliced onions",
    "1 cup sliced green bell pepper",
    "2 cups white sugar",
    "1 cup white vinegar",
    "1 tablespoon celery seed",
    "2 teaspoons salt, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
