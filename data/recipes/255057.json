  "ingredients": [
    "3 tablespoons oil",
    "1 cup water",
    "1 cup yellow cornmeal",
    "1 dash seasoned salt"
  ],
  "steps": [
    {
      "text": "Heat oil in a cast iron skillet over medium heat. Bring water to a boil in a saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cornmeal in a bowl. Slowly pour boiling water into the cornmeal; stir until smooth. Mix seasoned salt into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter with a spoon into the hot oil. Fry until edges are brown, about 5 minutes; flip over bread. Flatten with spatula; fry until bread is cooked through and edges are brown, about 5 minutes. Drain on a paper towel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
