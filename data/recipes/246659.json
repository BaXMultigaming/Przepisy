  "ingredients": [
    "1 bunch broccoli rabe, ends trimmed",
    "2 tablespoons olive oil, divided",
    "1 clove garlic, very thinly sliced",
    "0.25 teaspoon red pepper flakes",
    "3 tablespoons water",
    "0.25 teaspoon kosher salt"
  ],
  "steps": [
    {
      "text": "Cut thick, lower stems off broccoli rabe and peel. Reserve florets and leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Add 1 tablespoon olive oil, garlic, and red pepper flakes; saute until fragrant, about 45 seconds. Add stems; saute until coated with oil, about 45 seconds. Pour in water; continue cooking until stems are mostly tender, 3 to 4 minutes. Stir in florets, leaves, and salt. Cover skillet and cook until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer broccoli rabe and its juices to a serving bowl. Top with remaining 1 tablespoon olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
