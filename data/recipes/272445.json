  "ingredients": [
    "2 avocados",
    "2 tablespoons chopped green onions",
    "2 cloves garlic",
    "1 tablespoon chopped fresh cilantro",
    "0.5 lime, juiced, or to taste",
    "0.5 tablespoon chopped fresh tarragon",
    "2 tablespoons butter",
    "0.25 cup heavy cream",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Combine avocados, green onions, garlic, cilantro, lime juice, and tarragon in the bowl of a food processor; purée until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over low heat. Stir in avocado purée; cook and stir occasionally until heated through, about 5 minutes. Add cream; cook until heated through, but not boiling. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
