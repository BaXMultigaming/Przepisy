  "ingredients": [
    "2 cups grated carrots",
    "1 cup raisins",
    "1 cup water",
    "0.75 cup white sugar",
    "0.5 cup orange juice",
    "3 tablespoons butter",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon ground cloves",
    "1 teaspoon ground nutmeg",
    "2 cups whole wheat flour",
    "1 egg",
    "2 teaspoons baking soda",
    "0.25 teaspoon salt",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine carrots, raisins, water, sugar, orange juice, butter, cinnamon, cloves, and nutmeg in a small saucepan; bring to a boil. Reduce heat to low and simmer until slightly reduced, about 5 minutes. Pour carrot mixture into a large bowl and cool to lukewarm, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, egg, baking soda, and salt into carrot mixture until batter is well mixed; fold in walnuts. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
