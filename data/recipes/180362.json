  "ingredients": [
    "1 (15.5 ounce) can corn",
    "1 (15.5 ounce) can white hominy",
    "2 (15.5 ounce) cans pinto beans",
    "2 (15.5 ounce) cans kidney beans",
    "1 (12 ounce) jar salsa",
