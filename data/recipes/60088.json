  "ingredients": [
    "1 pound ground beef",
    "0.5 cup shredded Cheddar cheese",
    "2 tablespoons prepared horseradish",
    "0.5 teaspoon salt",
    "0.5 teaspoon pepper",
    "0.5 teaspoon garlic powder",
    "0.5 cup real bacon bits",
    "4 hamburger buns"
  ],
  "steps": [
    {
      "text": "Preheat grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the ground beef, Cheddar cheese, horseradish, salt, pepper, garlic powder, and bacon bits using your hands. Shape the mixture into 4 hamburger patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil the grill grate. Place hamburger patties on the grill, and cook for 5 minutes per side, or until well done. Serve on buns.",
      "section": null,
