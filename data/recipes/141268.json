  "ingredients": [
    "5 pounds beef short ribs, cut flanken style",
    "1 Asian pear, cored and cubed",
    "1 onion, coarsely chopped",
    "5 cloves garlic",
    "1 cup soy sauce (such as Kikkoman®)",
    "1 cup brown sugar",
    "0.25 cup honey",
    "0.25 cup sesame oil",
    "black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place ribs in a large pot and cover with cold water. Soak ribs in the refrigerator for 1 hour to pull out any blood. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tnBsaE21LPOg7K9-F5ySggQcy_8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/141268-KoreanBBQGalbi-ddmfs-Step-1-0485-af7bc0e81759410489a4bfc1eb9a33ab.jpg"
      ],
      "image": "assets/images/141268/step_01.webp"
    },
    {
      "text": "Combine Asian pear, onion, and garlic in a blender; blend until smooth. Pour into a large bowl and stir in soy sauce, brown sugar, honey, sesame oil, and black pepper. Add ribs to soy mixture; turn to coat evenly. Cover the bowl and marinate in the refrigerator, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vSAjYypGMopFXG5S8etrar_M3sM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/141268-KoreanBBQGalbi-ddmfs-Step-2-0491-94ee4d3858434dc9ab63127c54524473.jpg"
      ],
      "image": "assets/images/141268/step_02.webp"
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove ribs from marinade and cook on the preheated grill until meat is tender and the outside is crusty, 5 to 10 minutes per side. Discard marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZgjXOZK2K9hnrHCtxGGu9I0AKrw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/141268-KoreanBBQGalbi-ddmfs-Step-4-0563-ae44f7f4658749f28f6a12e894567865.jpg"
      ],
