  "ingredients": [
    "cooking spray",
    "4 ounces fresh Dungeness crabmeat",
    "1 tablespoon finely diced poblano pepper",
    "1 tablespoon panko bread crumbs",
    "2 teaspoons minced green onion",
    "0.5 teaspoon lemon juice",
    "salt and ground black pepper to taste",
    "0.33333334326744 cup mayonnaise",
    "2 teaspoons lemon zest",
    "1 pinch cayenne pepper",
    "6 (2 ounce) sole fillets",
    "salt to taste",
    "0.125 teaspoon paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix crabmeat, poblano pepper, panko, green onion, lemon juice, salt, and black pepper together in a bowl until well combined. Stir mayonnaise, lemon zest, and cayenne pepper together in a second bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sole fillets onto a work surface with the flat sides facing up. Season with salt. Divide crab mixture between fillets. Roll fillets around filling and place into the prepared baking dish, seam-side down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1/2 of the mayonnaise mixture over the sides and tops of each fillet. Spoon remaining mayonnaise mixture into a piping bag, then pipe it in a zigzag over fillets. Sprinkle paprika over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork and topping is browned, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
