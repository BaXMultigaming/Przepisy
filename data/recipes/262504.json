  "ingredients": [
    "4 cups quick-cooking oats",
    "1 cup all-purpose flour",
    "1 cup whole wheat flour",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "0.75 cup white sugar",
    "0.75 cup brown sugar",
    "0.25 cup butter, room temperature",
    "2 large eggs",
    "0.5 cup applesauce",
    "2 teaspoons vanilla extract",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oats, all-purpose flour, whole wheat flour, baking powder, salt, and baking soda together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, brown sugar, and butter together in a large bowl using an electric mixer until fluffy. Beat in eggs, applesauce, and vanilla extract in that order. Stir in the oat-flour mixture until dough is just combined. Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop 1/4 cup of the dough onto the prepared baking sheet. Repeat with the remaining dough, flattening each cookie slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light brown at the edges, 12 to 15 minutes. Let cool on the baking sheet, 3 to 4 minutes. Transfer cookies to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
