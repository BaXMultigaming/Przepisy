  "ingredients": [
    "1.25 tablespoons paprika",
    "2 teaspoons mango garlic seafood seasoning",
    "1.5 teaspoons cayenne pepper",
    "1.5 teaspoons dried basil",
    "1 teaspoon dried thyme",
    "1 teaspoon minced fresh garlic",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon salt",
    "0.25 cup olive oil",
    "4 tilapia fillets"
  ],
  "steps": [
    {
      "text": "Mix paprika, mango garlic seasoning, cayenne pepper, dried basil, dried thyme, minced garlic, garlic powder, onion powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush a light coating of olive oil on both sides of fillets. Dredge fillets in seasoning mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining olive oil in an electric skillet to 250 degrees F (120 degrees C). Cook fillets until fish flakes easily with a fork, about 6 minutes per side.",
      "section": null,
