  "ingredients": [
    "1 pastry for a 9-inch double-crust pie, divided",
    "10 apples - peeled, cored, and sliced",
    "1.5 cups white sugar",
    "2 tablespoons all-purpose flour",
    "1 tablespoon ground cinnamon",
    "10 individually wrapped caramels, unwrapped",
    "3 tablespoons butter, sliced",
    "1 tablespoon milk",
    "1 tablespoon confectioners' sugar, or more as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bottom of a 9x13-inch baking dish with pastry for 1 1/2 pie shells, cutting the pastry to fit and filling gaps as necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir apples, sugar, flour, and cinnamon together in a large bowl to coat the apple slices. Layer apple mixture over pie crust. Arrange caramels and butter slices on top of apple mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut remaining pie pastry into 1- to 2-inch pieces; arrange atop the caramels and butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until just beginning to brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool in baking dish on a wire rack for 30 minutes, cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk and confectioner's sugar together in a small bowl; drizzle over bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
