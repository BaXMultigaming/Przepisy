  "ingredients": [
    "1 small head cabbage, shredded",
    "2 cups shredded Cheddar cheese",
    "1 large onion, thinly sliced",
    "1 (10.75 ounce) can condensed cream of celery soup",
    "2 tablespoons butter, melted",
    "1.5 cups Italian-seasoned bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cabbage, Cheddar cheese, onion, condensed soup, and melted butter in a large bowl until well combined; mixture will be dry. Transfer to a large baking dish, spreading vegetables evenly. Sprinkle with bread crumbs, then cover the baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Baked in the preheated oven for 45 minutes. Remove foil and continue baking until bubbly and lightly browned, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
