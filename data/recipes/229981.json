  "ingredients": [
    "1 (12 ounce) package frozen cranberries",
    "2 cups white sugar",
    "0.5 cup freshly squeezed orange juice",
    "0.25 cup water",
    "0.25 cup freshly squeezed lime juice",
    "1 teaspoon grated orange zest",
    "1 teaspoon grated lime zest",
    "1 pinch grated orange zest"
  ],
  "steps": [
    {
      "text": "Stir cranberries, sugar, orange juice, water, lime juice, 1 teaspoon orange zest, and lime zest together in a saucepan; bring to a boil. Reduce heat to low; cook at a simmer until cranberries pop, about 20 minutes. Set aside to cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cooled sauce to serving bowl, cover with plastic wrap, and refrigerate until cold, about 1 hour. Garnish with a pinch of orange zest to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
