  "ingredients": [
    "1 cup heavy cream",
    "0.75 cup half-and-half",
    "0.25 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "1 cup frozen blueberries",
    "1 cup frozen strawberries",
    "0.5 cup frozen raspberries",
    "0.5 cup frozen blackberries",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Pour cream and half-and-half into an electric blender and blend on low speed until it begins to thicken. Add sugar and vanilla extract and mix for about 30 seconds. Add blueberries, strawberries, raspberries, and blackberries. Blend until smooth, adding milk if necessary to make blending easier.",
