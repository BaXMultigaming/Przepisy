  "ingredients": [
    "cooking spray (such as Baker's Joy®)",
    "0.75 cup all-purpose flour",
    "0.75 cup whole wheat flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "4 medium bananas, mashed",
    "0.5 cup white sugar",
    "0.33333334326744 cup canola oil",
    "0.25 cup brown sugar",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray 16 standard muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift both flours, baking powder, baking soda, and salt together into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bananas, white sugar, oil, brown sugar, and egg together in a separate large bowl. Fold banana mixture into flour mixture until just incorporated. Scoop batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until muffins spring back when lightly tapped in the middle, 14 to 16 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
