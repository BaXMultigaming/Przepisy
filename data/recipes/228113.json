  "ingredients": [
    "0.5 cup butter",
    "0.5 cup white sugar",
    "2 eggs",
    "1 cup yellow cornmeal",
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1.5 cups milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease an 8-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar together in a bowl until creamy. Add eggs; beat until combined. Stir in cornmeal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and salt together in a separate bowl. Stir flour mixture, alternating with milk, into butter mixture until well combined. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the bread comes out clean, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
