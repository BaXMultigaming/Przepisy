  "ingredients": [
    "1 (16 ounce) package spaghetti, broken in half",
    "0.75 cup mayonnaise",
    "0.75 cup Thai sweet chili sauce",
    "0.25 cup lime juice",
    "2 teaspoons Sriracha",
    "1 tablespoon butter",
    "1 pound uncooked medium shrimp, peeled and deveined",
    "1 teaspoon minced garlic",
    "3 tablespoons chopped scallions"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk mayonnaise, chili sauce, lime juice, and Sriracha together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large soup pot over medium-high heat. Add shrimp and cook for 5 minutes. Add garlic and cook until fragrant, 1 more minute. Add cooked spaghetti and mayonnaise-chili sauce; toss to combine. Cook until sauce is hot, about 2 minutes. Turn heat off and let sit for 5 minutes to thicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide among serving plates and garnish with chopped scallion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
