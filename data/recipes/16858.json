  "ingredients": [
    "cooking spray",
    "0.5 medium onion, chopped",
    "1 clove garlic, minced",
    "1 tablespoon chili powder",
    "1.5 cups chicken broth",
    "1 (4 ounce) can canned green chile peppers, chopped",
    "1 teaspoon ground cumin",
    "1.5 cups canned peeled and diced tomatoes",
    "0.5 cup chopped green bell pepper",
    "0.5 cup medium shrimp, peeled and deveined",
    "0.5 pound cod fillets, cut into chunks",
    "0.75 cup plain nonfat yogurt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wZqn2UftTuMbtDy2HPCU4h4Muuo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16858-spicy-fish-soup-DDMFS-step-01-2755-be042b44deed43e98041dfc9aa86479e.jpg"
      ],
      "image": "assets/images/16858/step_01.webp"
    },
    {
      "text": "Spray a large saucepan with cooking spray and heat over medium-high heat. Add onion and sauté, stirring often, until translucent, about 5 minutes. Add garlic and chili powder; sauté until fragrant, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-gK7wD44klaMljEVsjAsOF52DpI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16858-spicy-fish-soup-DDMFS-step-03-2758-62dc34b4e2e64537867c07d074bb33dd.jpg"
      ],
      "image": "assets/images/16858/step_02.webp"
    },
    {
      "text": "Stir in chicken broth, chile peppers, and cumin; bring to a boil. Reduce the heat to low, cover, and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ulc-29FdYYb1ffQaDCkdjJ0ksiY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16858-spicy-fish-soup-DDMFS-step-05-1-2810-b312b75e61794071ac1d581f44d7ba8a.jpg"
      ],
      "image": "assets/images/16858/step_03.webp"
    },
    {
      "text": "Add tomatoes, bell pepper, shrimp, and cod; increase the heat to medium and return to a boil. Reduce the heat to low, cover, and simmer for 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AnWaZupykXFXq3M9_Sc9bresyVg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16858-spicy-fish-soup-DDMFS-step-06-2811-ea5d9f8b4f04444bb7de727abbb8b908.jpg"
      ],
      "image": "assets/images/16858/step_04.webp"
    },
    {
      "text": "Gradually stir in yogurt until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8Rd0CKtfMNPh5hppHKG-IoVTN48=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16858-spicy-fish-soup-DDMFS-step-08-2814-b4ca4b0d961a4c9ba062073f1c8683e8.jpg"
