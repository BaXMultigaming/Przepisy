  "ingredients": [
    "1 pint fresh blueberries, rinsed and drained",
    "3 eggs",
    "1 egg yolk",
    "1 cup white sugar",
    "1 cup milk",
    "1 teaspoon vanilla extract",
    "0.75 cup all-purpose flour, sifted",
    "1 pinch salt",
    "1 tablespoon confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange blueberries in the prepared baking dish. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and egg yolk together in a large bowl until light and fluffy; whisk in white sugar until mixture thickens. Whisk in milk and vanilla until well combined. Whisk in flour and salt until batter is light and airy. Pour over blueberries to evenly cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven on the center rack until top is golden and springs back when touched, about 45 minutes. Cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut clafouti into 8 equal pieces; sprinkle with confectioners' sugar. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
