  "ingredients": [
    "0.25 cup pine nuts",
    "1 (15 ounce) can chickpeas (garbanzo beans), drained with 1/4 cup of the liquid reserved",
    "0.25 cup lemon juice",
    "0.25 cup olive oil, plus more for drizzling",
    "2 tablespoons tahini",
    "4 cloves garlic, minced",
    "2.25 teaspoons ground cumin",
    "0.25 teaspoon paprika",
    "2 pinches salt",
    "0.5 teaspoon crushed peppercorns"
  ],
  "steps": [
    {
      "text": "Heat a small skillet over medium heat. Toast pine nuts in a skillet, frequently stirring, until fragrant and beginning to brown, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend chickpeas, reserved liquid, lemon juice, 1/4 cup olive oil, tahini, garlic, cumin, paprika, salt, and crushed peppercorns in a food processor until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir toasted pine nuts into the hummus or sprinkle on top. Drizzle a little olive oil on top before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
