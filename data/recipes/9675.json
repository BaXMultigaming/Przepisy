  "ingredients": [
    "3 cups all-purpose flour",
    "1 cup shortening",
    "0.75 teaspoon baking soda",
    "2 cups packed brown sugar",
    "3 eggs",
    "1 cup chopped walnuts",
    "1.5 cups walnut halves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream the shortening, brown sugar and eggs. Stir in the flour and baking soda. Stir in the walnuts. Drop dough by spoonfuls 2 inches apart on cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 10 to 12 minutes. Let cool on wire racks.",
      "section": null,
      "name": null,
