  "ingredients": [
    "0.25 cup white sugar",
    "5 teaspoons cornstarch",
    "0.25 teaspoon salt",
    "1 cup milk",
    "2 eggs",
    "2 tablespoons amaretto liqueur"
  ],
  "steps": [
    {
      "text": "Combine sugar, cornstarch, and salt in saucepan. In a separate bowl beat eggs and mix together with milk. Stir into dry mixture. Cook over medium heat, stirring constantly, until thick and bubbling. Cook for 2 minutes more. Remove from heat, add almond liqueur and stir well. Cover surface of filling with plastic wrap to prevent film from forming and chill completely before using.",
