  "ingredients": [
    "2.6666667461395 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "1 teaspoon baking powder",
    "0.75 teaspoon salt",
    "0.75 teaspoon ground cinnamon",
    "0.75 teaspoon ground allspice",
    "0.5 cup butter, softened",
    "1.875 cups white sugar",
    "3 eggs",
    "1.5 cups mashed ripe avocado",
    "0.75 cup buttermilk",
    "0.75 cup chopped pecans",
    "0.5 cup raisins",
    "1 tablespoon grated orange zest"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9x5 inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9TCMCq7vDjxLvJnIsWJQWW6Tjmk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-27341-avocado-quick-bread-VAT-step-01-f882e9ffa29d487fa6bda4266e03527d.jpg"
      ],
      "image": "assets/images/27341/step_01.webp"
    },
    {
      "text": "Sift flour, baking soda, baking powder, salt, cinnamon, and allspice together in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CtHAKscmxEqV4iSiEFgNtxzsvzY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-27341-avocado-quick-bread-VAT-step-02-1strainer-eb7ad5a4cfed4d8fb4a8a125b495692d.jpg"
      ],
      "image": "assets/images/27341/step_02.webp"
    },
    {
      "text": "Beat sugar and butter together in a separate bowl with an electric mixer until light and fluffy. Beat in eggs, one at a time, then mix in mashed avocado.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/63OJ1uHiabsnAu6WQtJ3cpo1J9k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-27341-avocado-quick-bread-VAT-step-03-1mixer-f5c46aa6bac84fd985f5ca9f50327037.jpg"
      ],
      "image": "assets/images/27341/step_03.webp"
    },
    {
      "text": "Stir in flour mixture alternately with buttermilk until just mixed. Fold in chopped pecans, raisins, and orange zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9GWmU5_-ZFC_oj-CHqnLbBNek7Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-27341-avocado-quick-bread-VAT-step-04-1spatula-2586b28fde6f48ada8f6168f075652cf.jpg"
      ],
      "image": "assets/images/27341/step_04.webp"
    },
    {
      "text": "Divide batter evenly between the two loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gn-EpIAkM6qA3nOqHTcqZbn5UdA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-27341-avocado-quick-bread-VAT-step-05-c843fc2aee274ed089129dd5ed251992.jpg"
      ],
      "image": "assets/images/27341/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the loaf comes out clean, about 1 hour. Allow loaves to cool in pan for at least 20 minutes before removing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Gt7fbvcmhspKQe_Y-AOmjYu595w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-27341-avocado-quick-bread-VAT-step-06-1toothpick-96837940f8554351959b78540bf3e918.jpg"
      ],
