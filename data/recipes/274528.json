  "ingredients": [
    "2.5 cups gluten-free rolled oats",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "2 apples, chopped",
    "0.5 cup applesauce",
    "0.5 cup almond milk",
    "2 tablespoons vegetable oil",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (180 degrees C). Grease or line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a blender or food processor to blend oats into oat flour. Mix in cinnamon, nutmeg, baking powder, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix apples, applesauce, almond milk, oil, and vanilla together in a large bowl until combined. Slowly add the oat mixture, mixing until thick like cookie dough. Add even spoonfuls of the mixture to the muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back to the touch, 14 to 18 minutes. Let cool at least 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
