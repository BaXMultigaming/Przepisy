  "ingredients": [
    "1 spaghetti squash, halved and seeded",
    "1 tablespoon olive oil",
    "1.5 cups shredded extra-sharp Cheddar cheese, divided",
    "0.75 cup bacon bits",
    "4 tablespoons butter",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat cut-sides squash with about 1 tablespoon olive oil. Place squash, cut-sides down, on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until squash is tender, about 30 minutes. Cool for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrape squash flesh with a fork into spaghetti-like strands; transfer to a large bowl. Add ¾ cup Cheddar cheese, bacon bits, butter, salt, and black pepper; mix until well blended. Transfer to the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle casserole with remaining ¾ cup Cheddar cheese; continue baking until cheese is browned and bubbly, 15 to 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
