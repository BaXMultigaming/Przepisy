  "ingredients": [
    "0.25 cup sifted cocoa",
    "2 cups basic cookie mix",
    "1 egg",
    "0.5 cup butter",
    "0.25 cup water",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift cocoa into Basic Cookie Mix. Beat egg lightly and stir into mixture. Melt butter over low heat and stir into mixture. Add water and vanilla and mix well. Drop by teaspoonfuls onto greased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes in the preheated oven.",
      "section": null,
