  "ingredients": [
    "1.5 cups oat flour",
    "0.5 cup packed brown sugar",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon salt",
    "1 cup pumpkin puree",
    "2 eggs",
    "0.5 cup honey",
    "0.25 cup unsweetened applesauce",
    "0.25 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oat flour, brown sugar, baking powder, cinnamon, baking soda, nutmeg, ginger, cloves, and salt together in a large bowl using a fork. Combine pumpkin puree, eggs, honey, applesauce, and oil in a separate bowl. Add pumpkin mixture to flour mixture and stir using a spatula until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin tin, filling cups 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until a fork or toothpick inserted in a cupcake center comes out clean, 22 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
