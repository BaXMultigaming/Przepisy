  "ingredients": [
    "2 medium red onions, thinly sliced into half-moons",
    "0.75 cup white wine vinegar",
    "1 teaspoon sea salt",
    "1 teaspoon white sugar",
    "5 black peppercorns"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KyKlGTPqUvqbxDNyv_nxaTlhpVo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/262197-PickledRedOnions-gw-ddmfs-4x3-step-01-2896-41d951a4fab84250a72156c113ebfe85.jpg"
      ],
      "image": "assets/images/262197/step_01.webp"
    },
    {
      "text": "Pack onion slices into a sterilized 1-pint jar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IffBsdM4ohfgZRhXVSdKjrwOP_8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/262197-PickledRedOnions-gw-ddmfs-4x3-step-04-2904-6b7428eb01cc4f14adf0c8e41ee7eb89.jpg"
      ],
      "image": "assets/images/262197/step_02.webp"
    },
    {
      "text": "Combine vinegar, salt, sugar, and peppercorns together in a small saucepan; bring to a boil over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1dWKP7GnLNSh4v49CFx3sp0RWZs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/262197-PickledRedOnions-gw-ddmfs-4x3-step-03-2902-1f54c96ef0f84effa39d986ae68c47bd.jpg"
      ],
      "image": "assets/images/262197/step_03.webp"
    },
    {
      "text": "Carefully pour brine solution over onions to fill the jar; let stand, uncovered, for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t7D6riHgaa7QYst0QWsTlsPYBxE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/262197-PickledRedOnions-gw-ddmfs-4x3-step-06-2907-9c0fdffbf7a44a639d434314d1e45d74.jpg"
      ],
      "image": "assets/images/262197/step_04.webp"
    },
    {
      "text": "Seal the jar with a tight-fitting lid and shake well. Refrigerate until flavor develops, at least 1 hour or up to 2 weeks, before serving. Keep refrigerated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
