  "ingredients": [
    "1 (5 pound) pork butt roast",
    "salt and pepper to taste",
    "1 (14 ounce) can beef broth",
    "0.25 cup brewed coffee"
  ],
  "steps": [
    {
      "text": "Cut roast in half. Rub each half with salt and pepper, and place in the slow cooker. Pour broth and coffee over meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn the slow cooker to Low, and cover it. Cook for 6 to 8 hours, or until the roast is fork-tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully remove the roast to a cutting board. Pull meat off the bone with a fork. You may also chop it with a cleaver afterward if you like it really finely cut.",
      "section": null,
      "name": null,
      "url": null,
