  "ingredients": [
    "1 (1 pound) loaf brioche, cut into chunks",
    "2 tablespoons grated Parmesan cheese",
    "2 teaspoons dried basil, or to taste",
    "1 teaspoon granulated garlic, or more to taste",
    "3 cups garlic butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place brioche chunks in a large mixing bowl. Add Parmesan cheese, basil, and garlic; pour in melted butter. Mix using a rubber spatula, being careful not to tear bread. Spread evenly onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until croutons are golden brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
