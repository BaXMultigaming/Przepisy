  "ingredients": [
    "2 English cucumbers, sliced very thin",
    "1 tablespoon salt",
    "3 green onions, finely chopped",
    "1 cup sour cream",
    "4 teaspoons vinegar",
    "2 teaspoons vegetable oil",
    "1 teaspoon dried dill weed"
  ],
  "steps": [
    {
      "text": "Mix cucumbers and salt in a bowl; let sit for 1 hour. Drain cucumber in a colander, squeezing as much excess liquid as you can with your hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cucumbers and green onions in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sour cream, vinegar, oil, and dill together in a small bowl; drizzle over cucumber mixture and toss to coat.",
