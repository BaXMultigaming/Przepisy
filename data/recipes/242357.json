  "ingredients": [
    "0.5 cup almond meal",
    "1 teaspoon ground paprika",
    "1 teaspoon sea salt",
    "1 teaspoon ground black pepper",
    "4 skinless, boneless chicken thighs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almond meal, paprika, sea salt, and black pepper together in a resealable bag. Put each chicken thigh into bag, 1 at a time; close bag and shake until evenly coated. Place chicken in a glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center and the juices run clear, 25 to 30 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
