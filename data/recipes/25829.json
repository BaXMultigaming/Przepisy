  "ingredients": [
    "1 cup white sugar",
    "1 cup light brown sugar",
    "0.5 cup butter, softened",
    "0.5 cup shortening",
    "2 large eggs",
    "2 tablespoons evaporated milk",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.5 cups rolled oats",
    "1.5 cups semisweet chocolate chips",
    "1 cup flaked coconut",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease two cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, brown sugar, butter, and shortening together in a large bowl until light and fluffy. Beat in eggs, one at a time, beating well after each addition. Stir in evaporated milk and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, baking soda, and salt in a separate large bowl; stir into sugar mixture. Stir in oats, chocolate chips, coconut, and pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded tablespoonfuls onto the prepared cookie sheets spaced 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, switching racks halfway through, 13 to 15 minutes. Cool slightly on cookie sheets before transferring cookies to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
