  "ingredients": [
    "1 cup low-fat Greek-style yogurt (such as Fage Total 2%)",
    "1 tablespoon Major Grey mango chutney",
    "2 teaspoons curry powder",
    "1 teaspoon peeled and grated fresh ginger root",
    "1 teaspoon fresh lime juice"
