  "ingredients": [
    "2 cups water",
    "1 cup quinoa",
    "1 pinch salt",
    "0.25 cup olive oil",
    "0.5 teaspoon sea salt",
    "0.25 cup lemon juice",
    "3 tomatoes, diced",
    "1 cucumber, diced",
    "2 bunches green onions, diced",
    "2 carrots, grated",
    "1 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a medium saucepan; add quinoa and a pinch of salt. Reduce heat to low, cover and simmer for 15 minutes. Allow to cool to room temperature; fluff with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine olive oil, sea salt, lemon juice, tomatoes, cucumber, green onions, carrots, and parsley in a large bowl; stir in cooled quinoa.",
