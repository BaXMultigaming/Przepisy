  "ingredients": [
    "1 large zucchini",
    "0.5 cup butter, melted",
    "3 cloves crushed garlic",
    "0.5 (14 ounce) can pizza sauce",
    "0.5 cup mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice zucchini into thick rounds. Combine butter and garlic in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill zucchini slices on the preheated grill for 3 minutes; flip, brush with butter mixture, and grill 3 minutes more. Flip again, brush with butter mixture, and grill until crisp-tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread sauce on zucchini and sprinkle with cheese; continue grilling until cheese begins to melt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
