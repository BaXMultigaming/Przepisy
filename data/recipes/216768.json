  "title": "Baked Potato with Mushrooms",
  "description": "Topped with sautéed mushrooms and onions and a dollop of yogurt, this tasty baked potato is an easy and filling meal after a long day at the office.",
  "authors": [
    "MOTTSBELA"
  ],
  "date_published": "2019-04-02T02:54:35-04:00",
