  "ingredients": [
    "0.5 cup dried moong dal",
    "1 tablespoon olive oil",
    "0.5 tablespoon ground turmeric",
    "0.25 tablespoon cumin seeds",
    "3 cups chopped kale",
    "1 pinch chili powder",
    "salt to taste",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Soak moong dal in water for 30 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large pan over medium-low heat. Add turmeric and cumin seeds; cook until seeds start crackling. Add kale and soaked dal, followed by chili powder and salt. Pour in 1/4 cup water; bring to a boil. Reduce heat back to medium-low and cover the pan. Cook, mixing every 5 minutes, until desired tenderness is reached, 10 to 20 minutes total.",
