  "ingredients": [
    "0.25 cup butter",
    "0.5 cup frozen peas",
    "1 small onion, chopped",
    "1 clove garlic, minced",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "0.5 cup milk, or as needed",
    "2 (5 ounce) cans tuna, drained",
