  "ingredients": [
    "nonstick cooking spray",
    "1 cup all-purpose flour",
    "1 cup cornmeal",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup unsalted butter, melted",
    "0.5 cup white sugar",
    "0.25 cup honey",
    "2 large eggs, at room temperature",
    "1 cup buttermilk, at room temperature",
    "0.5 cup frozen sweet corn, thawed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray an 8-inch square baking dish with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, cornmeal, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix melted butter, sugar, and honey together in another bowl. Add eggs, one at time, and mix until combined. Stir in buttermilk. Mix in flour mixture, then fold in thawed corn. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted into the center comes out clean, 28 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
