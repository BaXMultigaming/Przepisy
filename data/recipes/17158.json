  "ingredients": [
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "1 teaspoon salt",
    "0.33 cup vegetable oil",
    "0.67 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together flour, baking powder and salt. Use a fork to blend in the oil. Add buttermilk and stir until the dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough out on a lightly floured surface. Cut dough into biscuits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 15 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
