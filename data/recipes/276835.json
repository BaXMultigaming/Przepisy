  "ingredients": [
    "0.5 cup fresh figs, finely chopped",
    "0.5 cup whiskey",
    "1.6666667461395 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon cream of tartar",
    "0.125 teaspoon ground cloves",
    "0.5 cup white sugar",
    "0.33333334326744 cup vegetable oil",
    "0.25 cup brown sugar",
    "1 egg",
    "0.5 cup buttermilk",
    "1 teaspoon vanilla extract",
    "1 (8 ounce) package cream cheese, softened",
    "0.75 cup vegetable shortening (such as Crisco®)",
    "5 cups powdered sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Soak figs in whiskey in a bowl for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, baking soda, salt, cinnamon, cream of tartar, and cloves in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend white sugar, oil, and brown sugar together in a separate bowl using an electric mixer. Add egg and mix until creamy. Mix in buttermilk and vanilla extract. Reserve 1 tablespoon of fig mixture for frosting, and mix remainder into batter. Beat in flour mixture until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a cupcake comes out clean, 15 to 20 minutes. Remove from the oven and transfer to wire racks to cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and shortening together in a bowl using an electric mixer until creamy. Add powdered sugar slowly, 1 cup at a time, until creamy. Add vanilla extract. Slowly drizzle in reserved fig mixture; mix frosting until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pipe frosting onto cooled cupcakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
