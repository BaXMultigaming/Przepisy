  "ingredients": [
    "0.5 cup chopped tomato",
    "0.5 medium onion, minced",
    "2 cloves garlic, chopped",
    "1 (1/2 inch) piece fresh ginger, peeled and chopped",
    "2 tablespoons cashews",
    "1.5 tablespoons oil",
    "1 (1 inch) piece cinnamon stick",
    "2 pods cardamom",
    "1 bay leaf",
    "1 teaspoon garam masala",
    "0.5 teaspoon smoked paprika",
    "0.25 teaspoon salt",
    "1.5 cups Mushrooms, raw",
    "0.5 cup water",
    "0.5 cup coconut milk"
  ],
  "steps": [
    {
      "text": "Blend tomato, onion, garlic, ginger, and cashews in a food processor until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a pan over medium heat. Add cinnamon stick, cardamom pods, and bay leaf; cook until oil is infused, 2 to 3 minutes. Remove and discard cinnamon, cardamom, and bay leaf. Add tomato mixture (masala) and cook down, 1 to 2 minutes. Stir in garam masala, paprika, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in mushrooms and cook for 5 to 7 minutes; if mixture gets too thick, add water. Add coconut milk and cook until heated through, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
