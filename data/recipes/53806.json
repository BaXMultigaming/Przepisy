  "ingredients": [
    "4 cups grated carrots",
    "2 cups milk",
    "1 cup white sugar",
    "1 tablespoon butter",
    "0.5 cup cashew halves",
    "0.5 cup raisins",
    "1 pinch ground cardamom"
  ],
  "steps": [
    {
      "text": "In a saucepan over medium heat, combine carrots and milk. Bring to a boil, and cook until most of the milk evaporates, about 10 minutes. Stir in sugar, and simmer until mixture becomes dry. Stir constantly to ensure that it doesn't burn. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Stir in cashews and raisins, and saute until cashews are golden brown. Spread over carrot mixture. Sprinkle top with ground cardamom for fragrance.",
