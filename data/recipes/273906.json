  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently toss raspberries, white sugar, and 3 tablespoons flour in a bowl; transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, ⅓ cup flour, brown sugar, and coconut in a separate bowl; cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs. Lightly sprinkle crumb mixture over berries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 30 to 40 minutes. Cool.",
