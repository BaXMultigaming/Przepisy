  "ingredients": [
    "6 cups 2% milk",
    "16 ounces milk chocolate chips",
    "1 (14 ounce) can sweetened condensed milk",
    "1.5 cups heavy cream",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine milk, chocolate chips, condensed milk, cream, and vanilla extract in a large slow cooker.",
      "section": null,
