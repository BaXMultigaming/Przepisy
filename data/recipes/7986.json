  "ingredients": [
    "2 cups all-purpose flour",
    "3.5 teaspoons baking powder",
    "1 teaspoon salt",
    "1.5 cups white sugar",
    "0.5 cup shortening",
    "3 eggs",
    "1 cup milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gqqOmJvOcCdJnvVe0kA7QkKmSiU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7986-yellow-cake-made-from-scratch-DDMFS-step-1-1eadec5771a046cc9e99a8a9353a9382.jpg"
      ],
      "image": "assets/images/7986/step_01.webp"
    },
    {
      "text": "Combine flour, baking powder, and salt together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Zdgii0GlP7ChL0mbFlR9DpPhoy8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7986-yellow-cake-made-from-scratch-DDMFS-step-3-fb378d5aa41c4433abae14e31a88b87f.jpg"
      ],
      "image": "assets/images/7986/step_02.webp"
    },
    {
      "text": "Beat sugar and shortening together in a large bowl with an electric mixer until light and fluffy. Add eggs, one at a time, beating thoroughly after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t43jjZDwroTmQ7PLmdY8CthIgys=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7986-yellow-cake-made-from-scratch-DDMFS-step-4-656fc93dbf414aa099e2e45708863bbd.jpg"
      ],
      "image": "assets/images/7986/step_03.webp"
    },
    {
      "text": "Add flour mixture alternately with milk, beating just to combine. Stir in vanilla and pour cake batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jPgGje0dQkb89R5ql0BG30twQQw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7986-yellow-cake-made-from-scratch-DDMFS-step-7-fe408a86e32f429b8583c8d087a12e42.jpg"
      ],
      "image": "assets/images/7986/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xYvUsk8AUvV1Nka4Zazu7kpafEE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7986-yellow-cake-made-from-scratch-DDMFS-step-8-03996ab4e89741d8bf6a7cb356d9cf99.jpg"
      ],
      "image": "assets/images/7986/step_05.webp"
    },
    {
      "text": "Cool cake completely and top with your favorite frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_Shn28Kn2FQzGY88NPZLWxJfFbs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7986-yellow-cake-made-from-scratch-DDMFS-4x3-338f26c5b09541698f6d8e2e04f6a012.jpg"
      ],
      "image": "assets/images/7986/step_06.webp"
    }
