  "ingredients": [
    "8 (1 ounce) squares bittersweet chocolate, chopped",
    "0.25 cup cream",
    "2 tablespoons unsalted butter",
    "0.5 cup chocolate cake crumbs",
    "2 teaspoons dark rum",
    "0.5 cup chocolate sprinkles"
  ],
  "steps": [
    {
      "text": "Line a sheet pan with aluminum foil or parchment paper. Place chopped chocolate in a heatproof bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan, combine cream and butter. Place over low heat, and bring to a boil. Pour over chocolate, and stir until chocolate is melted and smooth. Stir in cake crumbs and rum. Set aside until firm, but not hard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll heaping teaspoons of chocolate mixture into balls, then roll in the chocolate sprinkles. Place on the prepared tray. Refrigerate 30 minutes or until firm. Serve in small paper cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
