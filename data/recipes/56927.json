  "ingredients": [
    "3.5 cups peeled and diced potatoes",
    "3.25 cups water",
    "0.75 cup diced cooked ham",
    "0.33333334326744 cup diced celery",
    "0.33333334326744 cup finely chopped onion",
    "2 tablespoons chicken bouillon granules",
    "1 teaspoon ground white or black pepper, or to taste",
    "0.5 teaspoon salt, or to taste",
    "5 tablespoons butter",
    "5 tablespoons all-purpose flour",
    "2 cups milk"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/94CsgoZv4JSCS-ItJZMFQl_1tYE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-56927-delicious-ham-and-potato-soup-step-01-73f65b4e74a7438aad2e288346dd8505.jpg"
      ],
      "image": "assets/images/56927/step_01.webp"
    },
    {
      "text": "Combine potatoes, water, ham, celery, and onion in a stockpot. Bring to a boil; simmer over medium heat until potatoes are tender, 10 to 15 minutes. Stir in chicken bouillon, pepper, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JMy0kNj0qJ_9gnoyfXljxV52_BI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-56927-delicious-ham-and-potato-soup-step-02-6a0fb75c5fee43f9b7de707491719dbf.jpg"
      ],
      "image": "assets/images/56927/step_02.webp"
    },
    {
      "text": "Melt butter in a separate saucepan over medium-low heat. Add flour; cook and stir until thick, about 1 minute. Whisk in milk; cook and stir until thick, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OJp7MI35dsOi_gsAz9w0YLdYOis=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-56927-delicious-ham-and-potato-soup-step-03-e200acab441d44edb47a0c0138e8449a.jpg"
      ],
      "image": "assets/images/56927/step_03.webp"
    },
    {
      "text": "Pour milk mixture into the stockpot; cook and stir until warmed through.",
      "section": null,
      "name": null,
