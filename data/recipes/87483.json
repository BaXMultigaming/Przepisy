  "ingredients": [
    "1.5 cups white sugar",
    "2 tablespoons cornstarch",
    "3 tablespoons all-purpose flour",
    "2 (8 ounce) packages cream cheese, softened",
    "1 pound small curd cottage cheese",
    "0.5 cup butter, softened",
    "4 medium eggs",
    "1.5 tablespoons lemon juice",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease the bottom and halfway up the sides of a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together sugar, cornstarch, and flour; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese and cottage cheese; beat with an electric mixer at high speed until smooth and fluffy. Beat in softened butter. Gradually add sugar mixture, beating until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add eggs one at a time, blending well and scraping down the bowl after each addition. Stir in lemon juice and vanilla and mix just until smooth. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour and 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn off the oven; let cheesecake rest in the oven with the door closed for 2 hours. Remove and cool on a wire rack. Chill for 4 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
