  "ingredients": [
    "2 cups corkscrew pasta",
    "1 cup mayonnaise",
    "0.25 cup grated Parmesan cheese",
    "0.25 cup chopped parsley",
    "2 tablespoons milk",
    "1 clove garlic, minced",
    "1.5 cups diced ham",
    "2 cups halved cherry tomatoes"
  ],
  "steps": [
    {
      "text": "Cook pasta in a large pot of boiling water until al dente. Drain, rinse, and drain once more. Set aside.",
