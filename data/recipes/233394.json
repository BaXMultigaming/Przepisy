    "3 tablespoons white sugar",
    "2 tablespoons white wine vinegar",
    "2 tablespoons cider vinegar",
    "1 teaspoon minced fresh onion",
    "1 pinch ground white pepper",
    "1 pinch paprika",
    "1 pinch garlic powder, or to taste",
    "salt to taste",
