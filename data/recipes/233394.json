  "ingredients": [
    "2 cups cooked orzo",
    "0.5 cup cooked wild rice",
    "0.5 cup diced orange bell pepper",
    "0.5 cup diced red bell pepper",
    "0.5 cup frozen corn, thawed",
    "0.5 cup dried currants",
