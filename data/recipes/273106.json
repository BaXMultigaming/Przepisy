  "ingredients": [
    "3 sweet potatoes",
    "2 teaspoons vegetable oil, or as needed",
    "6 tablespoons brown sugar",
    "6 teaspoons salted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a glass baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pierce sweet potatoes all over with a fork; rub with oil and place in the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour, flipping halfway through. Remove from the oven; rest for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice sweet potatoes in half lengthwise; cut small slits into flesh. Sprinkle 1 tablespoon brown sugar and place 1 teaspoon butter on each half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
