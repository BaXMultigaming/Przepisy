  "ingredients": [
    "1 pound carrot, peeled and cut into matchsticks",
    "1 tablespoon olive oil, or as needed",
    "1 teaspoon pure maple syrup",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon cayenne pepper, or to taste",
    "1 pinch curry powder",
    "1 pinch hot paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large rimmed baking pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread carrots on the prepared baking sheet; toss with enough olive oil to coat. Drizzle with maple syrup and sprinkle with salt, cayenne, curry powder, and paprika. Toss everything together and spread out evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven, tossing a few times while they bake, until tender, about 20 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
