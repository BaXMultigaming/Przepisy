  "ingredients": [
    "0.5 cup butter, melted",
    "2 (12.4 ounce) cans refrigerated cinnamon rolls with icing (such as Pillsbury® Refrigerated Cinnamon Rolls with Icing)",
    "6 large eggs",
    "0.5 cup heavy cream",
    "2 teaspoons ground cinnamon",
    "2 teaspoons vanilla extract",
    "1 cup chopped pecans",
    "0.5 cup maple syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Pour melted butter into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Tf-tsmLv5HAcDPB-xbEkFXvSE-A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274483-cinnamon-roll-casserole-mfs-4x3-step-01-590f1f512fed4d28a426c092450839fe.jpg"
      ],
      "image": "assets/images/274483/step_01.webp"
    },
    {
      "text": "Cut each cinnamon roll into 8 pieces; spread evenly in prepared dish. Set icing aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ojNFXtyuFnDDRK3CoNFZPTcDy5M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274483-cinnamon-roll-casserole-mfs-4x3-step-03-c3c044087dfe4163883362f198ac8e6c.jpg"
      ],
      "image": "assets/images/274483/step_02.webp"
    },
    {
      "text": "Whisk eggs, cream, cinnamon, and vanilla extract together in a large bowl until well combined; pour evenly over rolls. Sprinkle with pecans; drizzle with syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k1hQJDtibcpiquQH-LLHR1Bcq6M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274483-cinnamon-roll-casserole-mfs-4x3-step-06-425f0bd6294a41fe8536801e77c17cf9.jpg"
      ],
      "image": "assets/images/274483/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 25 minutes. Let cool for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l-rJFrucQjG1o0v_uRxJfWyEaug=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274483-cinnamon-roll-casserole-mfs-4x3-step-07-9c57a8c71b4f44f7806e9fcfa3655305.jpg"
      ],
      "image": "assets/images/274483/step_04.webp"
    },
    {
      "text": "Microwave icing for 10 to 15 seconds; drizzle over casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/higCy2pCfNboZ8fTv0Vx1ds42o4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274483-cinnamon-roll-casserole-mfs-4x3-step-08-c0845af7ddce43eda696bd2390bde3cf.jpg"
