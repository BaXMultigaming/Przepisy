  "title": "No-Bake Dark Chocolate Cream Pie",
  "description": "Cornstarch, gelatin, and 2 hours in the fridge help this dark chocolate custard pie set so that no baking is required.",
  "authors": [
    "dkoontz1"
  ],
  "date_published": "2020-06-19T00:43:06-04:00",
