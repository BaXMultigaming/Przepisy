  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "2 teaspoons vanilla extract",
    "1 cup sour cream",
    "0.125 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Make the batter following the directions on the box, EXCEPT replace 2 teaspoons water with an equal amount of vanilla. Fold in sour cream. Bake according to directions given for baking a bundt cake. Cool on rack, place on serving plate, and dust with confectioners sugar.",
