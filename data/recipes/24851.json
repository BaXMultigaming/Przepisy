  "ingredients": [
    "3 pounds pork roast",
    "0.25 cup honey",
    "2 tablespoons Dijon mustard",
    "2 tablespoons black pepper",
    "0.5 teaspoon dried thyme, crushed",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Score 1/2 inch slits in pork roast; place in a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine honey, mustard, pepper, thyme, and salt in a small bowl until well blended; brush over roast, working well into slits. Set aside remaining glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Remove roast from oven; flip and brush remaining glaze over roast. Continue baking until an instant-read thermometer inserted into the center reads 145 degrees F (63 degrees C), 45 to 60 minutes more. Let stand 15 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
