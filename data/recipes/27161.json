  "ingredients": [
    "1 egg, beaten",
    "0.25 cup skim milk",
    "0.33333331346512 cup water",
    "1 tablespoon vegetable oil",
    "0.66666668653488 cup all-purpose flour",
    "0.25 teaspoon white sugar",
    "1 pinch salt",
    "0.5 cup semisweet chocolate chips",
    "1 cup sliced fresh strawberries",
    "0.75 cup frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "In a large bowl, beat together egg, milk, water and oil. Beat in flour, sugar and salt until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a medium, nonstick skillet over medium-high heat. Place a ladleful of crepe batter into center of pan, tilting to coat the bottom. Cook until golden brown on one side, turning once, 2 to 5 minutes. Continue with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small saucepan over low heat, melt chocolate chips, stirring constantly. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To assemble, spread some melted chocolate on the lighter side of one crepe. Place a line of overlapping strawberries down the center of the crepe and roll it up. Top with whipped topping and drizzle with a bit more chocolate. Repeat with remaining crepes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
