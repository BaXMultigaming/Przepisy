  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.25 cup white sugar",
    "2 teaspoons baking powder",
    "1 pinch salt",
    "3 eggs",
    "0.25 cup heavy whipping cream",
    "0.25 cup unsalted butter, melted",
    "3 cups mango - peeled, seeded, and cubed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 12 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, and salt in a bowl. Beat eggs, cream, and butter until smooth in another large bowl. Stir flour mixture into egg mixture until batter is moistened. Fold mango into batter until just combined. Evenly divide batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
