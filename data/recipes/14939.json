  "ingredients": [
    "1 pound bacon",
    "1 (16 ounce) package little smokie sausages",
    "1 cup brown sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VevAm9X0oiyGCFj6iSxgJzqxTKE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14939-Brown-Sugar-Smokies-DDMFS-4x3-step-01-90365ae6b2d441bbbd3ce8a1c3babada.jpg"
      ],
      "image": "assets/images/14939/step_01.webp"
    },
    {
      "text": "Cut bacon slices into thirds. Wrap each strip around a sausage. Secure several sausages on each wooden skewer. Arrange the skewers on a baking sheet; sprinkle liberally with brown sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ppyXaASl_K650wp3V6huhZGt3kw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14939-Brown-Sugar-Smokies-DDMFS-4x3-step-02-67271586f4dc47f49b67727bff0b7153.jpg"
      ],
      "image": "assets/images/14939/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until bacon crisps and sugar liquifies, 20 to 25 minutes, turning halfway through for even browning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CIB-YB83Dl26AEysrFNUKMMFKYY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14939-Brown-Sugar-Smokies-DDMFS-4x3-step-03-741656b765e3407c8da57775cff8be62.jpg"
      ],
      "image": "assets/images/14939/step_03.webp"
    },
    {
      "text": "Transfer to a serving platter. Let stand 5 minutes before serving; glaze will thicken as it cools.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YcJo5JWdzJGIRskhfZaIaaTgwlM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14939-Brown-Sugar-Smokies-DDMFS-4x3-f9a40311916041b0853702ec03a7d80b.jpg"
      ],
