  "ingredients": [
    "1 (16 ounce) can spicy chili beans",
    "1 (10 ounce) can diced tomatoes and green chiles (such as RO*TEL® Mexican Lime & Cilantro)",
    "1 (8 ounce) package shredded sharp Cheddar cheese",
    "1 (8 ounce) container sour cream",
    "0.25 cup finely chopped cilantro",
    "3 stalks green onions, thinly sliced",
    "1 medium jalapeno pepper, seeded and chopped",
    "0.75 teaspoon chili powder",
    "0.5 teaspoon kosher salt"
  ],
  "steps": [
    {
      "text": "Pour chili beans and diced tomatoes and green chiles into a strainer to drain; do not rinse. Transfer to a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in Cheddar cheese, sour cream, cilantro, green onions, jalapeno, chili powder, and salt until combined. Cover and refrigerate for at least 1 hour or overnight before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Give it a stir before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
