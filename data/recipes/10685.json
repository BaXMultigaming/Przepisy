  "ingredients": [
    "0.5 cup butter, softened",
    "1 (3 ounce) package cream cheese",
    "1 cup sifted all-purpose flour",
    "1 cup fruit preserves",
    "0.33333334326744 cup white sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "DAY BEFORE: Cream butter and cream cheese together until smoothly blended. Beat in the flour. Shape dough into a smooth ball, wrap in foil or cling wrap, and refrigerate overnight or up to a week.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "AT BAKING TIME: Remove dough from refrigerator 30 minutes before using. Start heating oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll chilled dough thin. Cut with 3 or 4 inch round cookie cutter. Place small spoonful of jam in center of each round, moisten edges with water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold round over and press edges together. Bake on ungreased cookie sheet 15 to 20 minutes. Immediately roll in sugar mixed with cinnamon (traditional) OR in confectioners' sugar if preferred.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
