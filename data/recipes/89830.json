  "ingredients": [
    "1 quart vegetable oil for deep frying",
    "2 cups all-purpose flour",
    "4 tablespoons seasoned salt",
    "2 tablespoons garlic powder",
    "1 tablespoon salt",
    "1 teaspoon chili powder",
    "1 teaspoon cinnamon",
    "1 teaspoon coriander",
    "1 teaspoon dried basil",
    "1 teaspoon cumin",
    "1 teaspoon ground turmeric",
    "1 teaspoon paprika",
    "4 pounds pork steaks"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, seasoned salt, garlic powder, salt, chili powder, cinnamon, coriander, basil, cumin, turmeric, and paprika in a large resealable plastic bag. Add 1 pork steak to bag, seal, and shake to coat; transfer to a plate. Repeat with remaining pork steaks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lower 1 pork steak into hot oil; cook until deep brown and floats. Transfer to a paper-towel-lined plate to drain. Repeat with remaining pork steaks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
