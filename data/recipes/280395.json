  "ingredients": [
    "1 mango - peeled, seeded, and chopped",
    "2 cups all-purpose flour",
    "2 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon salt",
    "0.5 teaspoon pumpkin pie spice",
    "0.75 cup unsalted butter, softened",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "3 large eggs",
    "1.25 teaspoons vanilla extract",
    "0.5 cup mashed banana",
    "0.5 cup toasted shredded coconut",
    "0.25 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée 1/4 of chopped mango in a food processor or blender. It should yield about 1/2 cup puréed mango and set aside. Reserve remaining chopped mango.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, cinnamon, salt, and pumpkin pie spice together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, white sugar, and brown sugar in a small bowl until blended. Mix in eggs and vanilla extract. Fold into dry ingredients until just combined. Fold in remaining chopped mango, puréed mango, banana, coconut, and walnuts. Let sit for 10 to 15 minutes. Pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, 55 to 65 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
