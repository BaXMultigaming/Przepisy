  "ingredients": [
    "1 (12 ounce) bag fresh cranberries",
    "0.75 cup white sugar",
    "0.5 cup turbinado sugar",
    "0.25 cup water",
    "1 orange, zested",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground ginger",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground allspice",
    "1 dash ground black pepper"
  ],
  "steps": [
    {
      "text": "Combine cranberries, white sugar, turbinado sugar, water, orange zest, cinnamon, ginger, cloves, allspice, and pepper in a large pot over medium heat. Simmer, stirring frequently, until sugar dissolves and cranberries pop, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend cranberry jam into desired consistency using an immersion blender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour jam into a glass pint jar; cool until thickened and set, about 1 hour. Seal jar and refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
