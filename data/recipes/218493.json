  "ingredients": [
    "1 pound ground beef",
    "0.5 cup uncooked white rice",
    "0.5 cup water",
    "0.33333334326744 cup chopped onion",
    "1 teaspoon salt",
    "0.5 teaspoon celery salt",
    "0.125 teaspoon garlic powder",
    "0.125 teaspoon ground black pepper",
    "1 tablespoon canola oil",
    "1 (15 ounce) can tomato sauce",
    "1 cup low-sodium chicken stock, or more as needed",
    "2 teaspoons Worcestershire sauce",
    "1 teaspoon granulated sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c_p2sZFeOY2UyYa858HyaKhS86M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218493-melindas-porcupine-meatballs-VAT-step-01-a4a714fab28249c392e3d4fec7306e1c.jpg"
      ],
      "image": "assets/images/218493/step_01.webp"
    },
    {
      "text": "Mix ground beef, rice, water, onion, salt, celery salt, garlic powder, and black pepper thoroughly in a bowl until well combined. Roll mixture into 12 meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GGsCtOZCqQKwlLfBtGL0R-SjPX4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218493-melindas-porcupine-meatballs-VAT-step-02-2a684a70450e453a8229d4d2461715fe.jpg"
      ],
      "image": "assets/images/218493/step_02.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Place meatballs into the hot skillet; cook, turning once halfway through cooking, until well browned, about 8 minutes. Drain and discard excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BcDmSglH99ON7PeA-KXNn094-mY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218493-melindas-porcupine-meatballs-VAT-step-03-5a7fe91a5ae24237b0517eef8d74dbcf.jpg"
      ],
      "image": "assets/images/218493/step_03.webp"
    },
    {
      "text": "Pour tomato sauce, chicken stock, Worcestershire sauce, and sugar into the skillet; reduce heat to medium-low. Cover and simmer until meatballs are no longer pink in the center and rice is tender, about 45 minutes. Stir in more stock if sauce becomes too dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Be1h1m9P__T6SNa4-Urw9gOzo5c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218493-melindas-porcupine-meatballs-VAT-step-04-090abf7d93864b1e94b99f01e7571c96.jpg"
      ],
      "image": "assets/images/218493/step_04.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
