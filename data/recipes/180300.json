  "ingredients": [
    "2 (14 ounce) cans tomato sauce",
    "2 (15 ounce) cans kidney beans, rinsed and drained",
    "2 tablespoons chili powder",
    "1 tablespoon white sugar",
    "1 pinch cayenne pepper",
    "1 pound ground beef",
    "1 teaspoon cooking oil",
    "0.5 red onion, chopped",
    "1 banana pepper, chopped",
    "1 apple - peeled, cored, and chopped",
    "1 peach - peeled, pitted, and chopped"
  ],
  "steps": [
    {
      "text": "Combine tomato sauce, kidney beans, 2 tablespoons chili powder, 1 tablespoon sugar, and 1⁄8 teaspoon cayenne pepper in a large saucepan; bring to a simmer over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a large skillet over medium-high heat; place ground beef in the skillet; season with remaining 2 tablespoons chili powder, 1 tablespoon sugar, and 1⁄8 teaspoon cayenne pepper; cook until brown; add to sauce mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a small skillet over medium-high heat; cook onion in oil until slightly browned; add to sauce mixture, along with apple, peach, and banana pepper. Allow to simmer another 1 to 2 minutes until hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
