  "ingredients": [
    "4 cups unsweetened blackberry juice",
    "2.5 cups white sugar",
    "10 whole cloves",
    "0.5 cinnamon stick",
    "1 lemon, zested",
    "4 cups rum"
  ],
  "steps": [
    {
      "text": "Combine blackberry juice, sugar, cloves, cinnamon stick, and lemon zest in a large saucepan. Slowly bring to a boil, stirring until sugar dissolves, about 5 minutes. Remove from heat and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain to remove spices and add rum.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour liqueur into a sterilized bottle and seal. Store in a cool, dark place.",
      "section": null,
