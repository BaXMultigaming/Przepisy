  "ingredients": [
    "0.75 cup white sugar",
    "0.5 cup margarine",
    "1 orange, zested",
    "1.5 teaspoons vanilla extract",
    "0.25 teaspoon salt",
    "0.25 teaspoon baking powder",
    "1.5 cups all-purpose flour",
    "1.5 cups dried cranberries",
    "0.25 cup unsweetened applesauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, margarine, orange zest, vanilla extract, salt, and baking powder together in a large bowl until blended. Stir in flour, applesauce, and cranberries until dough is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough onto baking sheets by tablespoons, 2 inches apart; flatten slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden brown, 6 to 7 minutes. Let cool for 5 minutes; transfer to a wire rack to cool completely, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
