  "ingredients": [
    "1 (14.5 ounce) can diced tomatoes",
    "1 small onion, chopped",
    "1 large clove garlic, coarsely chopped",
    "2 tablespoons olive oil",
    "1 (7 ounce) package fideo pasta, uncooked",
    "3 (14.5 ounce) cans chicken broth",
    "coarse salt and freshly ground black pepper to taste",
    "1 tablespoon chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Place tomatoes, onion, and garlic into a blender; pulse several times to get the mixture moving, then blend until smooth, 30 seconds to 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium-low heat; stir in fideo pasta. Fry pasta gently, stirring often, until golden brown, 2 to 5 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour tomato mixture into a large saucepan; stir in chicken broth and noodles. Bring to a boil, then reduce heat to medium-low and simmer until noodles are tender, 7 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with salt and pepper; stir in cilantro and cook until warmed through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
