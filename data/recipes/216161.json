  "ingredients": [
    "1.5 pounds ground beef",
    "0.5 cup chopped onion",
    "0.5 cup chopped celery",
    "0.5 cup chopped green bell pepper",
    "2 tablespoons quick cooking oats",
    "0.75 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "0.125 teaspoon ground black pepper",
    "1 medium head cabbage, cut into thin wedges",
    "1 (15 ounce) can tomato sauce",
    "0.25 cup apple cider vinegar",
    "3 tablespoons brown sugar",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place a large skillet over medium heat; cook the ground beef, onion, celery, and green bell pepper in the hot skillet until the beef is completely browned, 7 to 10 minutes. Sprinkle the oats, 3/4 teaspoon salt, the garlic powder, and 1/8 teaspoon black pepper into the beef mixture. Arrange the cabbage wedges atop the beef mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the tomato sauce, cider vinegar, and brown sugar together in a bowl; season with salt and pepper. Pour over the cabbage and beef mixture. Place a cover on the skillet and simmer until the cabbage is tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
