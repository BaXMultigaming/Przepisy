  "ingredients": [
    "ice cubes",
    "1 (6 ounce) can pineapple juice",
    "6 fluid ounces coconut milk",
    "3 limes, juiced",
    "2 tablespoons almond-flavored syrup (such as Torani®)",
    "1 cup club soda, or as needed",
    "4 pinches ground nutmeg",
    "4 lime wheels",
    "4 sprigs fresh mint",
    "cocktail umbrellas"
