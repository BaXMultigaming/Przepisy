  "ingredients": [
    "cooking spray",
    "5 potatoes",
    "1 pound ground beef",
    "0.5 cup chopped onion",
    "1 (16 ounce) can green beans, drained",
    "1 (10.75 ounce) can condensed tomato soup",
    "0.5 cup warm milk",
    "1 egg, beaten",
    "2 cloves garlic, chopped",
    "0.25 teaspoon pepper",
    "0.25 teaspoon salt",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 1 1/2-quart casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes; drain. Set aside to cool in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat a large skillet over medium-high heat. Cook and stir ground beef and onion in the hot skillet until beef is crumbly, evenly browned, and no longer pink, about 10 minutes. Stir in green beans and condensed soup until well combined; transfer to the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash cooled potatoes with warm milk, beaten egg, garlic, pepper, and salt until smooth; spread evenly over beef mixture. Sprinkle with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and the edges begin to brown, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
