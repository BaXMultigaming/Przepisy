  "ingredients": [
    "1 cup butter, softened",
    "1.3333333730698 cups white sugar",
    "0.66666668653488 cup dark brown sugar",
    "2 large eggs",
    "4 tablespoons instant coffee granules",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "0.5 cup cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.5 cups white chocolate chunks"
  ],
  "steps": [
    {
      "text": "Combine butter, sugars, eggs, instant coffee, and vanilla extract in a large bowl. Beat with an electric mixer until fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, cocoa powder, baking soda, and salt together in a separate bowl. Pour over butter mixture and beat until combined. Fold in white chocolate chunks using a spatula. Cover dough and chill for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease 2 cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoonfuls of dough onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 12 to 15 minutes. Allow to cool slightly before removing from the cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
