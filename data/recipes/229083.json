  "ingredients": [
    "3 tablespoons butter",
    "2 tablespoons Worcestershire sauce",
    "1 teaspoon garlic powder",
    "1.5 teaspoons seasoned salt",
    "7 cups crisp rice cereal squares (such as Rice Chex®)",
    "1 cup roasted pumpkin seed kernels",
    "1 cup pretzel sticks",
    "1 cup goldfish crackers"
  ],
  "steps": [
    {
      "text": "Preheat oven to 250 degrees F (120 degrees C). Place butter in a 9x13-inch baking dish; melt in oven while it preheats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Worcestershire sauce, garlic powder, and seasoned salt into melted butter. Gradually stir rice cereal squares, pumpkin seeds, pretzel sticks, and goldfish crackers into butter mixture until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring every 15 minutes, until crisp and fragrant, about 1 hour. Transfer party mix to paper towel-lined plates to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
