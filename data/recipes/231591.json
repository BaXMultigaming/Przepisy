  "ingredients": [
    "6 hard-cooked eggs, peeled",
    "0.5 cup whipped chive and onion cream cheese spread",
    "1 tablespoon sweet pickle relish",
    "2 tablespoons mayonnaise",
    "0.5 teaspoon spicy brown mustard",
    "1 clove garlic, minced",
    "1 dash hot pepper sauce",
    "salt and ground black pepper to taste",
    "2 tablespoons chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Halve eggs lengthwise and scoop yolks into a bowl. Mash yolks with a fork; stir cream cheese spread, mayonnaise, sweet relish, brown mustard, garlic, hot pepper sauce, salt, and black pepper into yolks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill egg whites with yolk mixture; sprinkle deviled eggs with chives. Store covered in refrigerator.",
