  "ingredients": [
    "2 cups shredded Cheddar cheese",
    "1 cup ricotta cheese",
    "1 egg",
    "0.25 cup white sugar",
    "1 teaspoon almond extract",
    "2 (21 ounce) cans apple pie filling",
    "8 lasagne noodles, cooked and drained",
    "6 tablespoons all-purpose flour",
    "6 tablespoons packed brown sugar",
    "0.25 cup quick cooking oats",
    "0.5 teaspoon ground cinnamon",
    "1 pinch ground nutmeg",
    "3 tablespoons butter",
    "1 cup sour cream",
    "0.33333334326744 cup packed brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Cheddar cheese, ricotta cheese, egg, white sugar, and almond extract in a medium bowl. Blend well. Spread one can apple pie filling over the bottom of a greased 9x13 inch pan. Layer with half of the noodles, and then the cheese mixture. Layer again with remaining noodles, and the second can of pie filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 6 tablespoons brown sugar, oats, cinnamon, and nutmeg in a small bowl. Cut in butter until crumbly. Sprinkle over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 45 minutes. Cool for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, prepare garnish by blending sour cream and 1/3 cup brown sugar in small bowl until smooth. Cover, and refrigerate. Serve warm apple lasagna with sour cream garnish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
