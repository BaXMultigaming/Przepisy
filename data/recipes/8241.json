  "ingredients": [
    "flour",
    "1 box strawberry cake mix",
    "1.3333333730698 cups water",
    "3 eggs",
    "0.33333334326744 cup vegetable oil",
    "2 (10 ounce) packages frozen strawberries",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "1 cup milk",
    "2 cups frozen whipped topping, thawed",
    "1 pint fresh strawberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make cake: Prepare cake mix as directed on the package, using 1 1/3 cups water, 3 eggs, and 1/3 cup oil. Pour batter into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes. Allow cake to cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Poke holes on top of cooled cake using a fork. Purée thawed strawberries with juice in a blender or food processor until smooth. Spoon over top of cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make topping: Prepare pudding mix as directed on the package, using 1 cup milk. Fold whipped topping into pudding until combined, then spread over cake. Arrange strawberries on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate cake for at least 4 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
