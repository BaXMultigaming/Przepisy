  "title": "Sausage Cake",
  "description": "If you like to mix your breakfast sausage with your pancakes and syrup, you'll want to try this spice cake with sausage and coffee.",
  "authors": [
    "Lmdinco"
  ],
  "date_published": "1999-02-17T06:12:57-05:00",
