  "ingredients": [
    "cooking spray",
    "0.5 cup butter",
    "3 stalks celery, diced",
    "1 large onion, diced",
    "1 teaspoon salt, or to taste",
    "0.5 teaspoon freshly ground black pepper, or to taste",
    "0.5 teaspoon dried sage",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon dried rosemary",
    "1 pinch cayenne pepper, or to taste",
    "2.75 cups chicken broth",
    "1 pound saltine crackers, crushed",
    "0.5 cup milk",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly coat a baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add celery, onion, and 1 teaspoon salt; cook and stir until onion begins to turn translucent, about 5 minutes. Season with black pepper, sage, thyme, rosemary, and cayenne pepper; cook and stir about 1 minute. Off heat, stir in chicken broth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine crushed crackers and onion mixture in a large bowl. Add milk and egg; stir until combined. Season with salt and black pepper. Transfer to the prepared baking dish; smooth top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
