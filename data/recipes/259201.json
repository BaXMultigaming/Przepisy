  "ingredients": [
    "1 tablespoon butter, softened",
    "1 tablespoon white sugar",
    "2 tablespoons all-purpose flour",
    "2 tablespoons oats",
    "4 dashes ground cinnamon, divided",
    "1 pinch salt",
    "0.5 apple - peeled, cored, and thinly sliced",
    "1 tablespoon brown sugar",
    "2 teaspoons water"
  ],
  "steps": [
    {
      "text": "Combine butter and white sugar in a bowl using your fingers; add flour, oats, 1 pinch cinnamon, and salt. Mix until crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a microwave-safe mug. Place ½ oat crumble mixture in the mug; press to form a crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave crust on high for 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add apple slices, brown sugar, and 1 pinch cinnamon to the mug; add water and mix together carefully without disturbing bottom crust. Pour remaining ½ oat crumble mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on 60 percent power for 1 minute 50 seconds. Cool before serving, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
