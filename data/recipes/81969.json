  "ingredients": [
    "3 tablespoons olive oil",
    "0.5 cup onion, chopped",
    "2 cloves garlic, minced",
    "3 pounds boneless pork shoulder, cubed",
    "5 (7 ounce) cans green salsa",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (4 ounce) can diced jalapeno peppers"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large skillet or Dutch oven over medium heat. Cook and stir onion and garlic in hot oil until fragrant, about 2 minutes. Add pork and cook, stirring occasionally, until browned on all sides. Transfer pork mixture to a slow cooker and stir in salsa, tomatoes, and jalapeño peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on High for 3 hours. Reduce to Low and cook, 4 to 5 more hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
