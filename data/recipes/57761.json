  "ingredients": [
    "1 teaspoon rubbed sage",
    "1 clove garlic, crushed",
    "0.5 teaspoon salt",
    "0.25 teaspoon pepper",
    "1 (5 pound) boneless pork loin",
    "0.5 cup sugar",
    "0.25 cup vinegar",
    "0.25 cup water",
    "2 tablespoons soy sauce",
    "1 tablespoon cornstarch"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sage, garlic, salt, and black pepper in a small bowl; rub thoroughly all over pork loin. Place pork in a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven on the center rack, uncovered, until an instant-read thermometer inserted into center reads at least 145 degrees F (63 degrees C), depending upon your desired doneness, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine sugar, vinegar, water, soy sauce, and cornstarch in a small saucepan over medium heat; cook, stirring occasionally, until glaze begins to bubble and thicken slightly. Remove from heat; cover to keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush pork loin with glaze 3 or 4 times during the last 30 minutes of cooking. Pour remaining glaze over roast to serve.",
      "section": null,
      "name": null,
      "url": null,
