  "ingredients": [
    "1 quart fresh raspberries",
    "1.25 cups white sugar",
    "8 teaspoons cornstarch",
    "2 tablespoons quick-cooking tapioca",
    "6 tablespoons water",
    "4 tablespoons butter",
    "1 recipe pastry for a 9 inch double crust pie"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix raspberries, sugar, cornstarch, tapioca, and water together in a bowl; set aside as you arrange crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line the bottom and sides of a 9-inch pie plate with one pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon raspberry mixture into bottom crust, and put four 1 tablespoon pats of butter on top. Put on top crust and crimp edges. Make slits in the crust to allow the steam to escape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Reduce heat to 350 degrees F (175 degrees C) and bake until crust is golden and fruit is bubbly, about 45 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
