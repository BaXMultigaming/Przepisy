  "ingredients": [
    "4 ham stock cubes",
    "2.5 tablespoons instant coffee granules",
    "2 cups water",
    "3 tablespoons butter",
    "3 tablespoons all-purpose flour",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
