  "ingredients": [
    "0.25 cup soy sauce",
    "2 tablespoons prepared salsa verde",
    "2 tablespoons white sugar",
    "2 tablespoons lime juice",
    "2 tablespoons finely chopped fresh cilantro",
    "2 tablespoons water",
    "1 tablespoon sriracha hot sauce",
    "1 tablespoon minced fresh ginger root",
    "1 tablespoon rice vinegar"
  ],
  "steps": [
    {
      "text": "Shake soy sauce, salsa verde, sugar, lime juice, cilantro, water, sriracha, ginger, and rice vinegar together in a container with a tight-fitting lid until sugar is dissolved. Refrigerate to allow flavors to blend, about 1 hour.",
