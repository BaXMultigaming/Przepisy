  "ingredients": [
    "2.5 cups all-purpose flour",
    "6 tablespoons white sugar",
    "1 teaspoon ground cinnamon",
    "1.5 teaspoons ground nutmeg",
    "0.25 teaspoon ground cloves",
    "2 cups softened butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, cinnamon, nutmeg, and cloves in a bowl. Cut in butter until the mixture resembles small crumbs. Pack the crumbs into a ball, then knead by hand until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly flour a work surface. Roll dough out into a thick disc, 1/4- to 1/2-inch thick. Cut out desired shapes using a cookie cutter. Place cookies on the prepared baking sheet. Gather scraps together, roll out, and repeat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cookies in the preheated oven until edges are lightly browned, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
