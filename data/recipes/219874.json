  "ingredients": [
    "2 teaspoons Melt® Organic Buttery Spread, softened",
    "1.5 pounds ground lean turkey",
    "0.66666668653488 cup dry Italian bread crumbs",
    "0.33333334326744 cup chopped fresh parsley",
    "0.25 cup shredded Parmesan cheese",
    "0.25 cup tomato sauce",
    "3 cloves garlic, minced",
    "3 tablespoons chopped fresh oregano",
    "2 teaspoons chopped fresh rosemary",
    "1 teaspoon dry mustard",
    "0.5 teaspoon cayenne pepper",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees. Grease a broiler pan with buttery spread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground turkey, bread crumbs, parsley, Parmesan, tomato sauce, garlic, oregano, rosemary, mustard, cayenne, and salt together in a large bowl until well combined. Form mixture into 30 meatballs; place onto the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink inside, about 15 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
