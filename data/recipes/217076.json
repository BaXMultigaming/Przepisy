  "ingredients": [
    "1.5 cups frozen corn kernels",
    "0.25 cup cider vinegar",
    "3 tablespoons lime juice",
    "2 cloves garlic",
    "1.5 teaspoons ground cumin",
    "1 tablespoon Dijon mustard",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "0.75 cup extra-virgin olive oil",
    "0.25 cup fresh cilantro",
    "1 (15 ounce) can black beans, rinsed and drained",
    "1 (15 ounce) can butter beans, rinsed and drained",
    "1 cup chopped red onion",
    "1.5 cups chopped red bell pepper"
  ],
  "steps": [
    {
      "text": "Pour the corn into a microwave-safe dish; cook in the microwave until heated through, 2 to 3 minutes. Drain any excess liquid, and set aside to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend the cider vinegar, lime juice, garlic, cumin, Dijon mustard, black pepper, salt, olive oil, and cilantro together in a blender until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss the cooled corn with the black beans, butter beans, red onion, and red bell pepper in a large bowl; pour the blended dressing over the bean mixture. Refrigerate overnight; allow to come to room temperature before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
