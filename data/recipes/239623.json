  "ingredients": [
    "4 slices bacon, or more to taste, cut into bite-size pieces",
    "1 small onion, chopped",
    "2 (28 ounce) cans baked beans",
    "0.5 cup ketchup",
    "0.5 cup brown sugar",
    "2 tablespoons Worcestershire sauce",
    "2 tablespoons prepared yellow mustard",
    "2 tablespoons minced jalapeno pepper",
    "1 tablespoon chili powder",
    "1 tablespoon mustard powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir bacon in a large skillet over medium-high heat until some fat rendered, 2 to 3 minutes. Stir in onion; cook until bacon crisp and onion tender, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine baked beans, ketchup, brown sugar, Worcestershire sauce, prepared mustard, jalapeño, chili powder, and mustard powder in a large bowl; stir in bacon mixture. Pour into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until liquid thickened, 45 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
