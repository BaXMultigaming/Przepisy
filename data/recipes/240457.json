  "title": "Chef John&#39;s Boneless Whole Turkey",
  "description": "Use a deboned turkey to avoid the hassle of table-side carving with this twist on a Thanksgiving turkey. Enjoy delicious roasted flavor and stuffing too!",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2014-11-24T17:06:30-05:00",
  "date_modified": "2026-06-30T14:23:03-04:00",
