  "ingredients": [
    "2 pounds halibut, cut into bite size pieces",
    "1 cup mayonnaise",
    "1 teaspoon fresh lemon juice",
    "0.75 teaspoon chile-garlic sauce",
    "0.5 teaspoon white sugar",
    "0.5 teaspoon soy sauce",
    "0.125 teaspoon sesame oil",
    "4 cups thinly sliced mushrooms",
    "2 cups thinly sliced onions",
    "1 lemon, cut in half",
    "Kosher salt, to taste",
    "1 tablespoon sesame seeds",
    "0.75 cup sliced green onions"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack into the center of the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a baking sheet with aluminum foil and a layer of cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange halibut pieces on the prepared baking sheet so that all pieces are touching.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the mayonnaise, lemon juice, chili garlic sauce, sugar, soy sauce, and sesame oil in a bowl; fold the mushrooms and onion into the mayonnaise mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the mushroom mixture over the halibut pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Squeeze one lemon half over the mushroom mixture; sprinkle with Kosher salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until almost opaque, 15 to 20 minutes; remove the baking sheet from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Raise the oven rack with the baking sheet to the next-highest level switch the oven to broil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue cooking the fish under the broiler until the top is browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Squeeze the remaining lemon half evenly over the fish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with sesame seeds and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
