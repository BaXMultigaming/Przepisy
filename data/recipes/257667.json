  "ingredients": [
    "3 bananas, broken into chunks",
    "0.66666668653488 cup coconut milk (such as Calafia®)",
    "0.66666668653488 cup water",
    "2 cups ice cubes",
    "1 cup pitted Deglet Noor dates",
    "0.33333334326744 cup raw cacao powder",
    "1 tablespoon minced fresh ginger root",
    "1 tablespoon peeled and chopped fresh turmeric root",
    "1.5 teaspoons ground cinnamon",
    "0.75 teaspoon ground nutmeg",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Place bananas in a blender. Layer coconut milk, water, ice cubes, dates, cacao powder, ginger root, turmeric root, cinnamon, nutmeg, and vanilla extract over bananas, in that order. Cover and pulse until shake is very smooth. Dates will remain in chunks to represent \"cookie dough chews\".",
