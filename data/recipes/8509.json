  "ingredients": [
    "0.66666668653488 cup dry potato flakes",
    "0.33333331346512 cup grated Parmesan cheese",
    "1 teaspoon garlic salt",
    "1 (3 pound) chicken, skin removed, cut into pieces",
    "0.33333334326744 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Heat the oven to 375 degrees F (190 degrees C). Grease or line with foil a baking sheet or a 13x9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine potato flakes, Parmesan cheese, and garlic salt. Stir until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chicken pieces into melted butter or margarine, and roll in potato flake mixture to coat. Place in prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 45 to 60 minutes, or until chicken is tender and golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
