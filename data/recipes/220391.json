  "ingredients": [
    "1 tablespoon olive oil",
    "0.25 cup chopped onion",
    "4 cloves garlic, chopped",
    "1 large carrot, chopped",
    "1 large stalk celery, chopped",
    "2 tablespoons tomato paste",
    "0.125 teaspoon crushed red pepper flakes, or more to taste",
    "0.125 teaspoon cayenne pepper, or more to taste",
    "salt and ground black pepper to taste",
    "6 cups chicken stock",
    "1.5 cups dry lentils"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large saucepan over medium heat; cook and stir onion and garlic until onion is translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in carrot and celery; cook, stirring often, until vegetables are tender, about 8 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomato paste, crushed red pepper, cayenne pepper, salt, and black pepper; mix in chicken stock and lentils.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring soup to a boil and reduce heat to low; simmer until lentils are soft, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
