  "ingredients": [
    "6 green onions, finely chopped",
    "0.5 cup soy sauce",
    "3 eggs, beaten",
    "2 tablespoons white sugar",
    "5 cloves garlic, minced",
    "2 teaspoons Hawaiian sea salt",
    "0.75 cup cornstarch",
    "0.75 cup mochiko (glutinous rice flour)",
    "2 tablespoons all-purpose flour",
    "5 pounds chicken wings or thighs",
    "Oil for deep frying"
  ],
  "steps": [
    {
      "text": "Combine green onions, soy sauce, eggs, sugar, garlic, and sea salt in a large glass or ceramic bowl. Sift cornstarch, mochiko, and all-purpose flour together into the bowl with green onion mixture; fold until smooth. Add chicken and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from the refrigerator; stir to redistribute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large pot to 350 degrees F (175 degrees C). Lower chicken wings carefully into hot oil in batches. Fry until golden brown and cooked through. Drain on paper towels. Repeat with remaining wings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
