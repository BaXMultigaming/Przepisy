  "ingredients": [
    "0.25 cup coconut oil",
    "0.5 cup applesauce",
    "2 large eggs",
    "0.25 cup butter, melted and cooled",
    "0.5 cup white sugar",
    "0.5 cup raw sugar",
    "2 teaspoons vanilla extract",
    "1 teaspoon sea salt",
    "2 bananas, mashed",
    "0.5 cup sour cream",
    "1.5 teaspoons baking soda",
    "0.75 cup all-purpose flour",
    "0.75 cup whole wheat flour",
    "0.5 cup chopped roasted almonds",
    "0.25 cup teff",
    "0.25 cup poppy seeds",
    "0.25 cup chia seeds",
    "0.25 cup flax seeds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease two 9x5-inch loaf pans with the coconut oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat applesauce, eggs, and butter together in a large bowl until smooth. Add white sugar, raw sugar, vanilla extract, and salt; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk bananas, sour cream, and baking soda together in a separate bowl until smooth; stir into the applesauce mixture until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually stir all-purpose flour, 1/4 cup at a time, into banana mixture until well mixed. Gradually stir whole wheat flour, 1/4 cup at a time, into banana-flour mixture until batter is well mixed. Fold almonds, teff, poppy seeds, chia seeds, and flax seeds into the batter. Pour batter into the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on the middle rack of the preheated oven until a toothpick inserted in the center comes out clean, 40 to 50 minutes. Cool bread in the pans for 15 minutes before transferring to a wire rack to cool, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
