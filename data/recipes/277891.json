  "ingredients": [
    "2 (5 ounce) cans water-packed tuna, drained",
    "1 cup mayonnaise",
    "2 hard-boiled eggs, chopped",
    "8 large ripe olives, sliced",
    "0.25 cup finely chopped celery",
    "0.25 cup finely chopped green onions",
    "0.25 cup finely chopped carrots",
    "2 teaspoons Dijon mustard (such as Grey Poupon®)",
    "0.25 cup butter, melted",
    "12 slices sourdough bread, or more to taste",
    "12 slices Swiss cheese"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tuna, mayonnaise, hard-boiled eggs, olives, celery, green onions, carrots, and mustard in a bowl until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush melted butter on one side of each bread slice. Top 6 unbuttered sides bread slices each with 1 cheese slice, 1/6 tuna salad, and 1 more cheese slice; top each with 1 remaining bread slice, buttered-sides up. Transfer sandwiches to the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until bread toasted and cheese melts, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
