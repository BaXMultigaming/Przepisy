  "ingredients": [
    "0.25 cup olive oil",
    "2 cloves garlic, minced",
    "2 teaspoons dried basil",
    "1 cup chopped roma (plum) tomatoes",
    "4.5 teaspoons white sugar",
    "1 teaspoon onion powder",
    "1 teaspoon garlic powder",
    "0.5 teaspoon red pepper flakes",
    "0.5 teaspoon black pepper",
    "0.25 teaspoon salt",
    "2 cups diced cucumber",
    "0.5 cup chopped red bell pepper"
  ],
  "steps": [
    {
      "text": "Heat oil in a large saucepan over medium heat. Stir in garlic; cook until fragrant, 1 to 3 minutes. Stir in dried basil; cook a few seconds more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomatoes, sugar, onion powder, garlic powder, red pepper flakes, black pepper, and salt. Bring to a simmer; stir in cucumber and bell pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Simmer, stirring occasionally, until mixture reduces and thickens, 10 to 15 minutes.",
      "section": null,
