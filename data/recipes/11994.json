  "ingredients": [
    "12 ounces dry fettuccine pasta",
    "1 cup nonfat milk",
    "0.5 cup reduced fat margarine",
    "8 ounces Neufchatel cheese, cubed",
    "0.25 teaspoon garlic powder",
    "0.5 teaspoon minced garlic",
    "0.25 teaspoon onion salt",
    "1 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "In a large pot of boiling salted water cook fettuccini until al dente. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, cubed Neufchatel cheese, butter or margarine, garlic powder, onion powder, minced garlic, and salt. Stir until smooth. Stir in grated Parmesan cheese and cook 2 to 3 minutes, or until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss pasta with Alfredo sauce and serve warm.",
      "section": null,
