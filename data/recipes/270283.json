  "ingredients": [
    "1 (8 ounce) package mock crab meat, chopped",
    "0.5 cup diced celery",
    "0.25 cup diced green bell pepper",
    "3 tablespoons mayonnaise",
    "0.125 cup diced scallions",
    "1 tablespoon lemon juice",
    "2 dashes adobo seasoning, or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine mock crabmeat, celery, bell pepper, mayonnaise, scallions, lemon juice, adobo seasoning, salt, and black pepper in a bowl. Cover bowl; chill before serving, 30 minutes.",
