  "ingredients": [
    "4 slices bacon",
    "2 eggs",
    "2 tablespoons cider vinegar",
    "2 tablespoons water",
    "2 teaspoons white sugar",
    "0.5 teaspoon salt",
    "1 pound spinach",
    "0.25 pound fresh mushrooms, sliced"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large, deep skillet over medium-high heat, turning occasionally, until evenly browned. Reserve 2 tablespoons bacon drippings. Crumble bacon; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place eggs in a saucepan and cover with cold water; bring to a boil. Cover, remove from heat, and let eggs stand in hot water for 10 to 12 minutes. Remove eggs from hot water and cool under cold running water; peel and cut into wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat reserved 2 tablespoons drippings in the same skillet; stir in vinegar, water, sugar, and salt. Keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wash and remove stems from spinach; dry thoroughly. Tear into pieces in a salad bowl; add warm dressing and toss until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top salad with mushrooms and bacon; garnish with egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
