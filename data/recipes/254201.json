  "ingredients": [
    "1 (14.1 ounce) package pastry for a 9-inch double crust pie",
    "6 cups mulberries",
    "1 cup white sugar",
    "0.66666668653488 cup all-purpose flour",
    "2 teaspoons ground nutmeg",
    "1 teaspoon ground allspice",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay bottom pie crust in pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mulberries, sugar, flour, nutmeg, allspice, and salt together in a bowl; gently fold mixture with a wooden spoon until blended, 3 to 5 minutes. Pour mixture into bottom pie crust and cover with top crust. Seal the edges; make slits in the top with a sharp knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate pie until sealed edges appear firm, 10 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pie in the preheated oven for 15 minutes. Reduce oven temperature to 350 degrees F (175 degrees C), and continue baking until crust is golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
