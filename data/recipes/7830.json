  "ingredients": [
    "1 (18.25 ounce) package white cake mix",
    "1 (3 ounce) package lime flavored Jell-O® mix",
    "0.75 cup boiling water",
    "0.5 cup cold water",
    "4 (1.3 ounce) envelopes whipped topping mix",
    "1 (3 ounce) package instant lemon pudding mix",
    "1.5 cups milk"
  ],
  "steps": [
    {
      "text": "Dissolve the gelatin in the boiling water. Mix in the cold water and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix and bake cake as directed for one 9x13 inch pan. Let cake cool for 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Poke holes in cake about 1 inch apart. Pour gelatin into holes and over the top of the cake. Refrigerate cake while making the topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix instant pudding, whipped topping mix and milk until stiff. Frost cake and store in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
