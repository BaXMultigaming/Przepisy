  "ingredients": [
    "1 (16 ounce) package penne pasta",
    "0.25 cup olive oil, divided",
    "3 cloves garlic, chopped",
    "2 sun-dried tomatoes, chopped",
    "1 tablespoon dried parsley",
    "1 teaspoon crushed red pepper flakes",
    "0.5 teaspoon black pepper",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente. Drain, and return to pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 tablespoon olive oil in a skillet over medium heat. Saute garlic, sun-dried tomatoes and parsley for about 1 minute. Season with red pepper flakes and black pepper. Stir into cooked pasta, along with remaining olive oil. Top with Parmesan.",
