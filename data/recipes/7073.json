  "title": "Hot Cross Buns",
  "description": "Hot cross buns are yeast buns with dried fruit, traditionally marked with a cross on top. Eat warm or toasted with butter for an Easter brunch treat.",
  "authors": [
    "LITSTER5"
  ],
  "date_published": "1999-02-06T08:17:35-05:00",
  "date_modified": "2025-11-30T11:20:07-05:00",
