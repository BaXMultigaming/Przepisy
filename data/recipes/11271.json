  "title": "Onesy-Twosy Cookies",
  "description": "This is a very rich peanut butter cookie made crunchy with extra chopped peanuts.",
  "authors": [
    "Kevin Ryan"
  ],
  "date_published": "1999-02-19T05:47:09-05:00",
