  "ingredients": [
    "0.25 cup orange-flavored drink mix (e.g. Tang)",
    "1 (14 ounce) can sweetened condensed milk",
    "1 (8 ounce) package cream cheese, softened",
    "1 (9 inch) prepared graham cracker crust",
    "1 cup frozen whipped topping, thawed",
    "8 mandarin orange segments"
  ],
  "steps": [
    {
      "text": "In a large bowl combine the orange drink mix, condensed milk, and cream cheese. Beat on high speed with an electric mixer until well combined.",
      "section": null,
