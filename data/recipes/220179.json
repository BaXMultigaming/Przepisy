  "ingredients": [
    "6 slices bacon, chopped",
    "1 large onion, diced",
    "3 cloves garlic, minced",
    "2 cups chicken broth",
    "pinch of dried oregano",
    "pinch of cayenne pepper",
    "0.5 teaspoon ground cumin",
    "salt to taste",
    "2 (14.5 ounce) cans black beans, rinsed and drained",
    "14.5 fluid ounces water",
    "0.5 teaspoon ground black pepper",
    "0.33333334326744 cup minced green onion",
    "2 teaspoons sambal paste (or minced red chiles)",
    "juice of 1 lime",
    "2 tablespoons chopped green onion",
    "3 tablespoons sour cream"
  ],
  "steps": [
    {
      "text": "Place bacon in a cold pot. Turn heat to medium, cook and stir until the bacon is cooked but not crisp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in onion; cook and stir for 5 minutes, until the onion turns translucent and golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in garlic; cook for 2-3 minutes. Add chicken stock, turn heat to medium-high. Stir in oregano, cayenne and salt. Add black beans and water. Return to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Simmer on medium-low, stirring occasionally, for 20-30 minutes. While it's cooking, mash about half the beans to thicken the soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in black pepper and cumin. Add salt to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the relish by stirring together minced green onion, sambal paste, and lime juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve garnished with relish, chopped green onions, and sour cream.",
      "section": null,
      "name": null,
      "url": null,
