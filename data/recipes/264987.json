  "ingredients": [
    "0.75 cup white sugar",
    "0.25 cup butter, softened",
    "1 egg, beaten",
    "0.5 teaspoon vanilla extract",
    "0.5 cup whole milk",
    "2 cups cake flour, sifted",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "2 cups sliced fresh strawberries",
    "0.5 cup brown sugar",
    "0.25 cup butter, softened",
    "0.33333334326744 cup all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease and lightly flour a 9-inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar and ¼ cup butter in a large bowl using an electric mixer until light and fluffy; beat in egg and vanilla until combined. Add milk; beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift cake flour, baking powder, and salt together into a separate bowl; stir into sugar mixture until blended. Fold in strawberries until incorporated. Spread batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and ¼ cup butter together in a separate bowl until creamy; beat in all-purpose flour, cinnamon, and nutmeg. Sprinkle topping over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
