  "ingredients": [
    "8 ounces chopped feta cheese",
    "0.75 cup Greek yogurt",
    "1 clove garlic, minced",
    "0.5 teaspoon lemon zest",
    "freshly ground black pepper to taste",
    "3 tablespoons olive oil, divided",
    "1 tablespoon minced oil-packed dried tomatoes",
    "1 tablespoon pine nuts",
    "1 tablespoon minced fresh parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l1Ut-WIiJ-CMXVxYmYQ7kYdZCFo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8457754-creamy-whipped-feta-DDMFS-step-01-1120-15e2554e6fc441e99ffbf47d40460ebc.jpg"
      ],
      "image": "assets/images/8457754/step_01.webp"
    },
    {
      "text": "Combine feta cheese, Greek yogurt, garlic, lemon zest, and black pepper in a food processor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NBuZF4swmbF9WNCBNupAQhwvV5Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8457754-creamy-whipped-feta-DDMFS-step-01-1-1122-13ba17677ef64b2d95b711292a35ba9e.jpg"
      ],
      "image": "assets/images/8457754/step_02.webp"
    },
    {
      "text": "Pulse several times to combine. With motor running, slowly drizzle in 2 tablespoons olive oil until dip is smooth and creamy, approximately 1 minute, scraping down the sides of the bowl as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r0tjUbzjdwTcHZGVrd2cf7A3MdY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8457754-creamy-whipped-feta-DDMFS-step-02-1123-2cd8085456d14c928a9016a8320a4909.jpg"
      ],
      "image": "assets/images/8457754/step_03.webp"
    },
    {
      "text": "Transfer mixture to a bowl or onto a plate and top with sun-dried tomatoes, pine nuts, and parsley. Drizzle with remaining olive oil and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eof0sjEnqbZPY94rKQfkL3UfjC8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8457754-creamy-whipped-feta-DDMFS-step-04-1125-c5bc093c533c417d9112b97989a47fdb.jpg"
