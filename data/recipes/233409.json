  "ingredients": [
    "1 cup water",
    "2 (.25 ounce) packages unflavored gelatin powder",
    "1 cup boiling water",
    "2 cups milk",
    "0.75 cup white sugar",
    "1.5 teaspoons almond extract",
    "8 lychees, or to taste"
  ],
  "steps": [
    {
      "text": "Pour 1 cup water into a bowl; stir in gelatin powder until dissolved. Slowly stir boiling water into gelatin mixture. Mix milk, sugar, and almond extract into gelatin mixture; add lychees. Pour gelatin mixture into a shallow container; refrigerate until set, 3 to 4 hours.",
