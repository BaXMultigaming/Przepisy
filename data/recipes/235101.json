  "ingredients": [
    "0.25 cup butter",
    "0.75 cup all-purpose flour",
    "0.33333334326744 cup white sugar",
    "0.33333334326744 cup chopped walnuts",
    "0.25 cup rolled oats",
    "1 tablespoon ground cinnamon",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 cup milk",
    "1 teaspoon vanilla extract",
    "3 cups sliced fresh plums",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set butter in the middle of an 8-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in the pan in the preheated oven until butter melts, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, walnuts, oats, 1 tablespoon cinnamon, baking powder, and salt together in a bowl. Add milk and vanilla; stir well to create a batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into baking pan over melted butter. Place sliced plums over batter into baking pan. Sprinkle top with 1/2 teaspoon cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until batter browns, fruit bubbles, and a knife inserted into the batter comes out clean, 45 to 50 minutes. Cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
