  "ingredients": [
    "6 cups boiling water",
    "6 cups whole bran cereal",
    "3 cups shortening",
    "9 cups white sugar",
    "12 eggs",
    "12 cups buttermilk",
    "15 cups all-purpose flour",
    "5 tablespoons baking soda",
    "1 tablespoon salt",
    "12 cups whole bran cereal"
  ],
  "steps": [
    {
      "text": "In a large bowl, add boiling water to first 6 cups of bran cereal, cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream shortening or margarine, sugar, eggs, and buttermilk together. Add to bran mixture. Stir in flour, baking soda, and salt. Fold in 12 cups of bran cereal. Stir only until moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 425 degree F (220 degree C) oven for 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
