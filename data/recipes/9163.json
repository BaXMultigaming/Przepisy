  "ingredients": [
    "2 (3 ounce) packages raspberry flavored Jell-O® mix",
    "1 cup white sugar",
    "2 cups boiling water",
    "1.5 cups cold water",
    "1 pound cranberries",
    "1 orange",
    "1.5 cups crushed pineapple, drained",
    "2 cups seedless red grapes, halved",
    "1.5 cups diced apples"
  ],
  "steps": [
    {
      "text": "Add the sugar to the gelatin. Stir in the boiling water and stir until the gelatin is dissolved. Stir in the cold water or the pineapples juice. Chill until gelatin is thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Finely grind the cranberries and the orange in food processor or run through the meat grinder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the ground cranberry mixture, drained crushed pineapple, grapes and cubed apples to the thickened gelatin. Pour mixture into one 9 x 13 inch pan or a large bowl. Refrigerate overnight before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
