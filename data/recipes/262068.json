  "ingredients": [
    "1 pound extra-lean ground beef",
    "1 small onion, chopped",
    "1 rib celery, chopped",
    "1 tablespoon chopped garlic",
    "1 (10 ounce) can condensed cream of mushroom soup",
    "1 cup beef broth",
    "1 (6 ounce) can sliced mushrooms, drained",
    "0.25 cup white wine",
    "0.25 cup sour cream, or more to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine ground beef, onion, celery, and garlic in a skillet over medium heat. Cook and stir until beef is browned and crumbly, about 7 minutes. Drain and discard grease, if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream of mushroom soup, beef broth, mushrooms, and wine into the skillet. Bring to a boil. Reduce heat to low and simmer until stroganoff begins to thicken, 20 to 25 minutes. Add sour cream, salt, and pepper; cook until hot, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
