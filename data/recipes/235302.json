  "ingredients": [
    "2 medium oranges",
    "1 pound fresh cranberries",
    "1 cup white sugar",
    "1.25 cups water, or as needed to cover"
  ],
  "steps": [
    {
      "text": "Zest and juice oranges; set juice aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cranberries, sugar, and orange zest in a saucepan; stir to combine. Cover with water and bring to a boil. Cook until cranberries begin to burst, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce the heat to low, stir in orange juice, and simmer until flavors blend, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat and cool to room temperature, about 20 minutes. Refrigerate until jelled, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
