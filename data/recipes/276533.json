  "ingredients": [
    "1 cup white sugar",
    "1 cup shortening (such as Crisco®)",
    "1 egg",
    "1 cup canned pumpkin",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1 cup chopped walnuts",
    "4 cups powdered sugar",
    "0.5 cup butter, softened",
    "1 tablespoon milk, or as needed",
    "1 teaspoon maple extract, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar and shortening together in a large bowl with an electric mixer until well combined. Beat in egg until incorporated. Beat in pumpkin purée and vanilla extract. Stir in flour, baking soda, baking powder, cinnamon, and salt until well combined; fold in walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop small teaspoonfuls of dough onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges turn golden, 10 to 12 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat confectioners' sugar and butter together in a medium bowl with an electric mixer until well combined; stir in milk, 1 teaspoon at a time, until reaches a spreadable consistency. Fold in maple extract until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread frosting over cooled cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
