  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "3 teaspoons baking powder",
    "1 tablespoon grated lemon zest",
    "0.5 teaspoon salt",
    "0.75 cup milk",
    "0.33333334326744 cup vegetable oil",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Heat oven to 400 degrees F (205 degrees C). Grease bottoms only of 12 muffin cups or line with baking cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine flour, sugar, baking powder, lemon zest and salt; mix well. In a small bowl, combine milk, oil and egg; blend well. Add dry ingredients all at once; stir just until dry ingredients are moistened (batter will be lumpy.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill cups 2/3 full. Bake for 20 to 25 minutes or until toothpick inserted in center comes out clean. Cool 1 minute before removing from pan. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
