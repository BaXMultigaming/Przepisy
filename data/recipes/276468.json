  "ingredients": [
    "2 large oranges, peeled and segmented",
    "1 mango, diced",
    "1 cup diced fresh pineapple",
    "1 cup diced jicama",
    "1 small cucumber, sliced",
    "1 banana, sliced",
    "2 limes, juiced",
    "1 tablespoon chile-lime seasoning (such as Tajin®), or more to taste",
    "0.5 teaspoon chopped fresh mint, or to taste"
