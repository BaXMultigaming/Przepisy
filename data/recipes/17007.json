  "title": "Cranberry Sauce Chicken I",
  "description": "Chicken breasts baked with an onion cranberry sauce for a simple, sweet and tangy dinner. A great company dish to serve with hot, fluffy white rice.",
  "authors": [
    "phaylock"
  ],
