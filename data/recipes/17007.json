  "ingredients": [
    "12 skinless, boneless chicken breast halves",
    "1.25 cups cranberry sauce",
    "1 packet dry onion soup mix",
    "0.5 cup French-style salad dressing",
    "1 teaspoon white sugar",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange chicken in an 11x17 inch baking dish. In a medium bowl, combine the cranberry sauce, soup mix, salad dressing, sugar and ground black pepper. Mix well and spoon mixture over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover dish and bake at 325 degrees F (165 degrees C) for 1 to 1 1/2 hours, or until chicken is cooked through and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
