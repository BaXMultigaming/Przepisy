  "ingredients": [
    "1 pound dry great Northern beans",
    "8 cups water",
    "12 baby carrots",
    "1 cup chopped onion",
    "0.5 pound chopped ham",
    "0.25 cup ketchup",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a large bowl, combine the beans with the water, cover and let soak overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large pot over medium high heat, combine the soaked beans with water, carrots, onion and ham. Add more water to cover all, if necessary. Bring to a boil, then reduce heat to low and let simmer for 4 to 6 hours. Add ketchup just to get desired color. Season with salt and pepper to taste.",
