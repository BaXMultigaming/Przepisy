  "ingredients": [
    "2 cups packed light brown sugar",
    "1.5 cups all-purpose flour",
    "1 cup chopped walnuts",
    "0.5 cup melted butter",
    "3 eggs",
    "2 teaspoons baking powder",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, flour, walnuts, butter, eggs, baking powder, vanilla extract, and salt together in a bowl by hand until smooth. Spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is dry and edges have started to pull away from the sides of the pan, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool for 10 to 15 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
