  "ingredients": [
    "1 cup quick-cooking oats",
    "0.5 cup raisins",
    "0.25 cup wheat germ",
    "0.25 cup whole-wheat flour",
    "0.25 cup all-purpose flour",
    "2 tablespoons unsweetened cocoa powder",
    "1.5 tablespoons brown sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground ginger",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon salt",
    "0.5 cup applesauce",
    "0.33333334326744 cup honey",
    "1 egg",
    "1.5 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a 8x8-inch baking pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, raisins, wheat germ, whole-wheat flour, all-purpose flour, cocoa powder, brown sugar, cinnamon, ginger, allspice, and salt in a large bowl. Make a well in the middle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk applesauce, honey, egg, and vanilla extract together in a separate bowl until combined; pour into well of dry ingredients. Stir with two spoons until fully incorporated. Pour and press batter into prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm, about 20 minutes. Remove from pan and cool for about 10 minutes before slicing into 12 pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
