  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup butter",
    "0.33333334326744 cup heavy cream",
    "0.33333334326744 cup granulated sugar for decoration",
    "0.25 cup butter, softened",
    "0.75 cup sifted confectioners' sugar",
    "1 egg yolk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Mix flour and 1 cup butter thoroughly. Stir in whipping cream and mix well. Chill for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough 1/8-inch thick on a lightly floured board. Cut into 1 1/2-inch rounds. Transfer to waxed paper heavily sprinkled with sugar, turning to coat both sides. Place on an un-greased baking sheet. Prick in 4 places with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 7 to 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make the filling: Blend 1/4 cup soft butter, confectioners' sugar, egg yolk, and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put two cooled cookies together with filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
