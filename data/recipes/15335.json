  "ingredients": [
    "0.75 cup packed brown sugar",
    "0.25 cup white sugar",
    "6 tablespoons butter",
    "0.5 teaspoon vanilla extract",
    "1 egg white",
    "3 tablespoons water",
    "1.5 cups all-purpose flour",
    "0.75 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream brown and white sugars with butter in a medium bowl. Stir in vanilla, egg white, and water. Sift together flour, baking soda, and salt in a separate bowl; stir into creamed mixture. Mix in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by heaping spoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned and edges are set, 8 to 10 minutes. Allow cookies to cool on baking sheets for 10 minutes before transferring them to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
