  "ingredients": [
    "1 teaspoon vegetable oil",
    "2 skinless, boneless chicken breast halves",
    "2 cups chicken broth",
    "1 (15 ounce) can black beans, rinsed and drained",
    "1 (15 ounce) can cannellini beans, drained and rinsed",
    "1 (14.5 ounce) can diced tomatoes, drained and rinsed",
    "0.5 yellow onion, chopped",
    "1.5 tablespoons chili powder, or more to taste",
    "1 clove garlic, minced",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon paprika",
    "0.5 teaspoon mustard powder",
    "0.5 teaspoon garlic powder",
    "1 dash hot sauce (such as Cholula®), or to taste",
    "1 pinch salt and ground black pepper to taste",
    "0.5 cup sour cream"
  ],
  "steps": [
    {
      "text": "Lightly grease slow cooker crock with vegetable oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken breasts, chicken broth, black beans, cannellini beans, diced tomatoes, yellow onion, chili powder, garlic, cumin, paprika, garlic powder, hot sauce, salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover slow cooker. Cook on Low for 6 hours (or on High for 3 hours).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken breasts to a cutting board; shred with forks and return to the slow cooker. Add sour cream; stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue cooking on Low for 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
