  "ingredients": [
    "2.5 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "3 large eggs, well beaten",
    "3 tablespoons vegetable oil, divided",
    "1 tablespoon white sugar",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Sift together all-purpose flour, baking powder, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix eggs, 2 tablespoons vegetable oil, and sugar in a small bowl. Quickly stir into the flour mixture. Mix in approximately 1/2 of the water. Knead into a soft, pliable dough, using more water as necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover dough with a tea towel and allow to sit at least 1 hour while desired filling is prepared.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To use, divide into two parts. Cover half the dough with plastic wrap while you roll out the other.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully stretch the dough into paper thinness on a lightly floured surface (a clean cotton sheet is ideal) and lightly brush with remaining vegetable oil. Fill and bake as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
