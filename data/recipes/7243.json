  "ingredients": [
    "3.5 cups all-purpose flour",
    "3 teaspoons pumpkin pie spice",
    "2 teaspoons baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "3 cups white sugar",
    "1 (15 ounce) can pumpkin puree",
    "1 cup vegetable oil",
    "4 eggs",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vTNZ0mdgDJzZ9Mno4wC6iwvWYtk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7243-pumpkin-pie-bread-VAT-step-01-7652ad65a1fe43669863f28503caeb2f.jpg"
      ],
      "image": "assets/images/7243/step_01.webp"
    },
    {
      "text": "Whisk flour, pumpkin pie spice, baking soda, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QI2qGFkLKQF7N46dLAByq15jdw0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7243-pumpkin-pie-bread-VAT-step-02-91abc0bcab864c18b29eafa4a5627c71.jpg"
      ],
      "image": "assets/images/7243/step_02.webp"
    },
    {
      "text": "Beat sugar, pumpkin, oil, and eggs in a large bowl with an electric mixer until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VgaT2jrhkR7qro9QgVpC2dNULyE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7243-pumpkin-pie-bread-VAT-step-03-5a3394aa11954474a7dcb10226ab052f.jpg"
      ],
      "image": "assets/images/7243/step_03.webp"
    },
    {
      "text": "Beat in flour mixture, alternating with water, beating briefly after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tpSb4ZnCHTitV93Oh_Gn52fKAGw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7243-pumpkin-pie-bread-VAT-step-04-7ace7abf2ae64178a8fa48eb6e70e82b.jpg"
      ],
      "image": "assets/images/7243/step_04.webp"
    },
    {
      "text": "Divide batter between the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KAmeK1TTaJCTJ52oPzJZDX_PO_8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7243-pumpkin-pie-bread-VAT-step-05-c6f2be2bf2184a57912ec829377ec5ba.jpg"
      ],
      "image": "assets/images/7243/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 60 to 70 minutes.",
      "section": null,
      "name": null,
      "url": null,
