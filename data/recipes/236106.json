  "title": "Garlic Lemon Butter Salmon",
  "description": "Lemons, butter, and a few cloves of garlic are all you need to turn an easy salmon dinner into a delicious event.",
  "authors": [
    "Jim M"
  ],
  "date_published": "2019-07-10T03:05:07-04:00",
