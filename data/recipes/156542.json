  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil; lightly coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay puff pastry on the prepared baking sheet; center Brie wheel on pastry sheet. Evenly spread jam over top of Brie; sprinkle walnuts on top jam. Fold puff pastry over top of Brie; seal completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pastry is golden brown, about 20 minutes.",
