  "ingredients": [
    "0.25 cup all-purpose flour",
    "0.25 teaspoon salt",
    "pepper",
    "2 egg whites",
    "1 pound tilapia fillets",
    "0.25 cup dried bread crumbs",
    "0.25 cup cornmeal",
    "0.5 teaspoon dried basil, crushed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Spray a shallow baking dish with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, salt, and pepper in a shallow dish and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a separate shallow dish until white and frothy. Combine bread crumbs with cornmeal and basil in another shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip fillets into flour mixture, shaking off any excess, then dip into egg whites, followed by bread crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay fillets in the prepared baking dish, tucking under any thin ends or edges for even cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
