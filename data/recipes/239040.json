  "ingredients": [
    "4 cups zucchini, julienned (1/4 x 1/4 x 2-inch strips)",
    "1.5 tablespoons Diamond Crystal® Kosher Salt",
    "0.33333334326744 cup extra virgin olive oil",
    "2 tablespoons fresh lemon juice",
    "1 tablespoon white wine or rice vinegar",
    "0.5 teaspoon sugar",
    "1 small clove garlic, minced",
    "1 cup tightly packed fresh parsley leaves",
    "2 green onions, sliced diagonally",
    "1.5 teaspoons freshly grated lemon zest",
    "2 green onions, chopped, for garnish"
  ],
  "steps": [
    {
      "text": "Place zucchini strips in bowl; sprinkle with Diamond Crystal® Kosher Salt. Toss to mix. Let stand 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine olive oil, lemon juice, vinegar, sugar (if using) and garlic in small bowl or small jar with tight-fitting lid. Whisk or shake to blend. Cover and refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse zucchini lightly with cold water; drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place zucchini on dish towel or several layers of paper towels. Shake or blot gently to remove excess moisture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place zucchini, parsley and sliced green onions in a bowl; toss gently to mix. Drizzle lightly with vinaigrette (reserving any extra vinaigrette); toss to mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with lemon zest and additional green onions, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
