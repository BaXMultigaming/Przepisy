  "ingredients": [
    "olive oil cooking spray",
    "1 pound cod, about 1-inch thick, cut into 4 pieces",
    "0.25 cup polenta",
    "0.25 cup all-purpose flour",
    "1.5 teaspoons seafood seasoning (such as Old Bay®)",
    "1.5 teaspoons garlic salt",
    "1 teaspoon onion powder",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 380 degrees F (195 degrees C). Grease the air fryer basket with cooking spray. Pat cod dry with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine polenta, flour, seafood seasoning, garlic salt, onion powder, pepper, and paprika in a shallow dish. Press cod pieces into polenta mixture to evenly coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange coated cod in the prepared air fryer basket, leaving space between them so air can circulate. Spray the tops with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 8 minutes. Turn each piece and mist with cooking spray. Continue cooking for 4 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
