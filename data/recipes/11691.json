  "title": "Tomato and Garlic Pasta",
  "description": "A simple garlic and tomato pasta recipe made with fresh tomatoes will become a favorite, go-to dish in summer because of its light, bright flavors.",
  "authors": [
    "ALMA-LOU"
  ],
  "date_published": "1999-02-07T04:05:01-05:00",
