  "ingredients": [
    "5 cups powdered sugar",
    "0.75 cup unsweetened cocoa powder",
    "1 cup unsalted butter, softened",
    "2 teaspoons vanilla extract",
    "5 tablespoons whipping cream, or more as needed"
  ],
  "steps": [
    {
      "text": "Combine powdered sugar and cocoa powder in a large bowl. Add butter and mix with an electric mixer until crumbly. Slowly add whipping cream and mix until frosting comes together. Add vanilla extract and mix to the desired texture, adding more whipping cream, 1 tablespoon at a time, if frosting is too thick.",
