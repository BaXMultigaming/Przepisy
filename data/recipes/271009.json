  "ingredients": [
    "0.5 pound egg noodles",
    "2 tablespoons melted butter, plus more for greasing",
    "4 eggs",
    "1 pint sour cream",
    "1 cup cottage cheese",
    "0.5 cup grated Parmesan cheese",
    "0.25 cup grated onion",
    "2 tablespoons finely chopped fresh parsley",
    "0.125 teaspoon garlic powder",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook egg noodles in the boiling water until tender yet firm to the bite, 6 to 8 minutes. Drain and toss with melted butter. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a casserole dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, sour cream, and cottage cheese together in a bowl until well blended. Add Parmesan cheese, onion, parsley, garlic powder, salt, and pepper and beat until thoroughly mixed. Add cooked egg noodles and toss to mix well. Transfer mixture to the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
