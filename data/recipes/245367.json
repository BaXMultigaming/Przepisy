        "https://www.allrecipes.com/thmb/vVeVM8gkUOHehXMG1pqA2JIHxTM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245367_Pan-Roasted-Chicken-Breasts_step-1_ddmfs_4x3_1590-716d7537d985402a8aa9b698b70f53fe.jpg"
