  "ingredients": [
    "4 boneless chicken breast halves with skin",
    "salt and freshly ground black pepper to taste",
    "2 tablespoons olive oil",
    "1 tablespoon chopped fresh herbs (thyme, parsley, rosemary)",
    "0.25 cup apple cider vinegar",
    "4 tablespoons cold butter, cut into small pieces",
    "1 tablespoon chicken broth (or water), if needed to thin sauce"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TEYGaQ6-q4E6LaSwBWayuCrZcKw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245367_PanRoastedChickenBreasts_step1_ddmfs_4x3_1549-ef44fb1b2e43400d9b3674c370dbe281.jpg"
      ],
      "image": "assets/images/245367/step_01.webp"
    },
    {
      "text": "Season chicken on both sides with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a heavy skillet over medium-high heat until it starts to shimmer. Place chicken breasts skin-side down in the skillet. Sprinkle with fresh herbs. Cook until the bottoms are well seared and golden brown, 5 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D6OnfrH3BjGRvtE-tcH023X6eIo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245367_PanRoastedChickenBreasts_step2_ddmfs_4x3_1557-84f03809bf1041c88750138fde71efc3.jpg"
      ],
      "image": "assets/images/245367/step_03.webp"
    },
    {
      "text": "Flip chicken breasts over and continue cooking until an instant-read thermometer inserted into the center of a breast reads 150 degrees F (66 degrees C), about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iCC2lCY5ngCZRcdXFYAbgTKEQ78=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245367_PanRoastedChickenBreasts_step3_ddmfs_4x3_1559-f9ade423c4884a998eb5da3110f27ff2.jpg"
      ],
      "image": "assets/images/245367/step_04.webp"
    },
    {
      "text": "Add vinegar and cold butter to the pan with chicken. Shake the pan gently until butter melts and the internal temperature of chicken reads at least 165 degrees F (74 degrees C), 2 to 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cPn7v_lgcGaaB2GiTeweSkByEc0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245367_PanRoastedChickenBreasts_step4_ddmfs_4x3_1567-73fd566c5f194b3b8c84a7956f29c41b.jpg"
      ],
      "image": "assets/images/245367/step_05.webp"
    },
    {
      "text": "Stir in 1 tablespoon chicken broth to thin sauce.",
      "section": null,
      "name": null,
      "url": null,
