  "ingredients": [
    "24 mushrooms, caps and stems diced",
    "0.5 orange bell pepper, diced",
    "0.5 onion, diced",
    "1 small carrot, diced",
    "2 slices bacon, diced",
    "1 cup shredded Cheddar cheese",
