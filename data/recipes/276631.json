  "ingredients": [
    "0.75 cup white sugar",
    "0.5 cup butter, melted",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "0.5 cup banana-flavored Greek yogurt",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 medium bananas, mashed",
    "1 cup white chocolate chips",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar and melted butter together in a large bowl. Mix in eggs and vanilla until well combined. Mix in yogurt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, and salt in a separate bowl; stir into butter mixture until smooth. Fold in bananas, white chocolate chips, and walnuts. Spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the loaf comes out clean, about 1 hour. Cool loaf in the pan for 10 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
