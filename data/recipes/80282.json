  "ingredients": [
    "2 pounds bacon",
    "2 cups mayonnaise",
    "2 cups sour cream",
    "2 teaspoons paprika",
    "2 (14.5 ounce) cans diced tomatoes, drained"
  ],
  "steps": [
    {
      "text": "Place the bacon in a large skillet; cook over medium-high heat until very crisp, about 10 to 15 minutes. Drain the bacon slices on a paper towel-lined plate. Crumble, and reserve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the mayonnaise, sour cream, paprika in a large mixing bowl. Stir in the bacon and the drained tomatoes. Chill dip at least 6 hours or overnight.",
