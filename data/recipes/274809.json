  "ingredients": [
    "19.5 ounces baking chocolate, grated",
    "6 eggs",
    "2.3333332538605 cups white sugar",
    "1.5 cups unsalted butter",
    "1.125 cups all-purpose flour",
    "0.25 cup cocoa powder",
    "0.25 cup instant coffee granules",
    "2 tablespoons water",
    "0.875 cup heavy cream",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Melt chocolate in a microwave-safe glass or ceramic bowl in 15-second intervals, stirring after each interval, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and sugar together in a bowl. Stir in melted chocolate and butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour and cocoa powder together in another bowl; add to the chocolate mixture. Dissolve instant coffee in water and pour into the batter. Add heavy cream and walnuts; mix well. Pour into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
