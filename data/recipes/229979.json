  "ingredients": [
    "1 (12 ounce) package fresh cranberries",
    "2 navel oranges, peel and white pitch completely removed",
    "0.66666668653488 cup chopped walnuts",
    "1 cup granulated sugar",
    "1 tablespoon orange-flavored liqueur (such as Cointreau®)"
  ],
  "steps": [
    {
      "text": "Finely chop about half the cranberries with 1 orange in a food processor; scrape into a glass mixing bowl. Repeat process with remaining cranberries and orange.",
