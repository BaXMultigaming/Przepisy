  "ingredients": [
    "1.5 cups all-purpose flour",
    "3.5 teaspoons baking powder",
    "2 large eggs",
    "2 tablespoons white sugar",
    "1.75 cups milk",
    "3 tablespoons melted shortening",
    "1 teaspoon salt",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to manufacturer’s instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour and baking powder together into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and sugar in a separate bowl with an electric mixer until fluffy. Add milk, melted shortening, salt, and vanilla; mix until well blended. Mix in flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon 2/3 cup batter onto the preheated waffle iron. Close the iron and cook until waffle is golden brown and the iron stops steaming, about 5 minutes. Repeat to cook remaining waffles.",
      "section": null,
      "name": null,
      "url": null,
