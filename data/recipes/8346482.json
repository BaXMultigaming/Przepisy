  "ingredients": [
    "1 (20 ounce) can pineapple chunks in juice",
    "0.333 cup brown sugar",
    "0.25 cup low-sodium soy sauce",
    "1 small onion, sliced",
    "2 cloves garlic, minced",
    "1 teaspoon crushed red pepper flakes",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground black pepper",
    "1 (3 pound) pork butt roast"
  ],
  "steps": [
    {
      "text": "Pour pineapple chunks and juice in a bowl; add brown sugar, soy sauce, onion, garlic, pepper flakes, ginger, and black pepper and stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut pork butt in quarters and place in a slow cooker. Pour pineapple mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until pork is tender and can be easily pulled apart with a fork, 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred pork in the juices and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
