  "ingredients": [
    "2.5 cups all-purpose flour",
    "3 tablespoons packed brown sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground ginger",
    "0.5 cup butter, sliced",
    "2 cups pumpkin puree"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Grease a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, baking powder, salt, nutmeg, cinnamon, and ginger in a large bowl. Cut in butter with 2 knives or pastry blender until mixture resembles coarse crumbs. Mix in pumpkin until moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat dough out into a ½-inch thickness onto a lightly floured surface. Cut out biscuits with a 2-inch round cutter: place on the prepared cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until centers bounce back when gently pressed, 15 to 20 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
