  "ingredients": [
    "1 banana, sliced",
    "0.5 cup orange juice",
    "1 tablespoon lime juice",
    "2 tablespoons poppy seeds",
    "1 tablespoon raspberry vinegar",
    "0.25 teaspoon olive oil",
    "0.25 cup raspberries",
    "0.125 teaspoon salt",
    "0.125 teaspoon cayenne pepper",
    "1 cup seedless red grapes",
    "1 cup cubed watermelon",
    "1 cup halved fresh strawberries",
    "1 cup cubed cantaloupe",
    "1 cup blueberries",
    "1 cup sliced plums"
  ],
  "steps": [
    {
      "text": "In a blender or food processor, combine banana, orange juice, lime juice, poppy seeds, raspberry vinegar, olive oil, raspberries, salt and cayenne pepper, and puree until smooth. Cover tightly and refrigerate until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine grapes, watermelon, strawberries, cantaloupe, blueberries and plums in a large bowl. Pour dressing over fruit and toss to coat.",
