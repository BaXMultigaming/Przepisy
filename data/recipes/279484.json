  "ingredients": [
    "1 pound ground chicken",
    "0.25 cup grated Parmesan cheese",
    "2 tablespoons dried basil",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 serving nonstick cooking spray",
    "4 white hamburger buns, warmed"
  ],
  "steps": [
    {
      "text": "Combine ground chicken, Parmesan cheese, basil, garlic powder, salt, and black pepper in a large bowl; divide into 4 equal portions and form into patties using your hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a nonstick skillet over medium heat, coating with cooking spray if needed. Add patties; cook until browned and no longer pink in centers, about 5 minutes per side. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve burgers on warmed buns.",
      "section": null,
      "name": null,
      "url": null,
