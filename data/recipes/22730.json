  "ingredients": [
    "1 (12 ounce) package semisweet chocolate chips",
    "2 tablespoons butter",
    "1 (14 ounce) can sweetened condensed milk",
    "2.5 cups dry-roasted peanuts",
    "1 (16 ounce) package miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
