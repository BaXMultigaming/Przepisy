        "https://www.allrecipes.com/thmb/ZXqiSdB_kektqXOP9cNj5OPiPQk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22730-RockyRoadCandies-ddmfs-4x3-gw-step-07-0092-9bcfe5f7c1fe4f95bf58ee5d627a1fa6.jpg"
