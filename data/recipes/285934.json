  "ingredients": [
    "2 cups farfalle (bow tie) pasta",
    "1 tablespoon olive oil",
    "0.25 cup thinly sliced onion",
    "2 cloves garlic, minced",
    "8 ounces chunk light tuna in water, drained and flaked",
    "0.75 cup water",
    "0.5 cup dried cranberries",
    "0.5 cup sun-dried tomatoes, chopped",
    "0.25 cup pitted Kalamata olives, halved",
    "2 tablespoons pine nuts",
    "1 tablespoon chopped fresh parsley",
    "0.5 cup finely shredded Parmesan cheese",
    "0.5 cup coarsely torn fresh basil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook bow-tie pasta at a boil, stirring occasionally, until tender yet firm to the bite, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat oil in a large, oven-proof skillet over medium heat. Add onion and garlic and cook in the hot oil, stirring occasionally, until onion is tender, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tuna, water, cranberries, tomatoes, olives, pine nuts, and parsley. Stir in cooked pasta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the skillet to the preheated oven and bake, covered, for 25 minutes. Uncover and sprinkle with Parmesan cheese. Bake, uncovered, until heated through and cheese melted, about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with basil before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
