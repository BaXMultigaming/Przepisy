  "ingredients": [
    "1 cup warm water (110 degrees F/45 degrees C)",
    "3 tablespoons nonfat dry milk powder",
    "2 tablespoons vegetable oil",
    "2 tablespoons white sugar",
    "1.5 teaspoons garlic salt",
    "1.5 teaspoons onion powder",
    "1.5 teaspoons dried basil",
    "1.5 teaspoons dried dill weed",
    "1.5 teaspoons celery seed",
    "1.5 tablespoons dried parsley",
    "3 cups bread flour",
    "2.25 teaspoons active dry yeast"
  ],
  "steps": [
    {
      "text": "For bread machine: Place all ingredients in bread pan as recommended by your manufacturer. Process on \"Regular\" or \"White Bread\" cycle. Remove promptly after baking cycle is complete.",
