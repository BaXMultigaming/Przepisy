  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare batter according to instructions on cake mix package. Stir in 1 1/2 cups chocolate chips. Reserve remaining chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into Bundt pan. Bake at 350 degrees F (175 degrees C) for 35 to 40 minutes, or until toothpick inserted into center of cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool for 10 minutes in pan, then turn out onto a wire rack. Before cake is cool, pour reserved chocolate chips on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
