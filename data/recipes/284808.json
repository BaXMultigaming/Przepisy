  "ingredients": [
    "2 heads garlic, separated into cloves and peeled",
    "1 tablespoon olive oil",
    "4 pounds potatoes, peeled and cut into chunks",
    "0.5 cup half-and-half",
    "4 tablespoons butter, melted",
    "0.5 (8 ounce) package cream cheese, softened",
    "0.25 cup sour cream",
    "salt and ground white pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place garlic cloves in aluminum foil and drizzle with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until very soft, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix potatoes, half-and-half, and melted butter until well combined. Add cream cheese, sour cream, and roasted garlic; mix with a hand mixer until well blended. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
