  "ingredients": [
    "5 eggs, separated",
    "1.25 cups superfine sugar",
    "5 tablespoons sunflower seed oil",
    "2 cups all-purpose flour",
    "1 lemon, zested",
    "0.5 teaspoon vanilla extract, or more to taste",
    "2.25 cups pitted sour cherries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease an 8x16-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a bowl until foamy. Add sugar little by little while continuing to beat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend the yolks and oil together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the yolk mixture to the bowl with the egg whites. Add lemon zest and vanilla extract. Mix for 3 more minutes. Gently blend in flour using a tablespoon. Pour batter into the prepared pan and spread cherries on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden brown, 40 to 60 minutes. Turn off the oven, leaving cake inside with the door closed for 30 minutes. Allow to cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
