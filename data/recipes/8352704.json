  "steps": [
    {
      "text": "Preheat the oven to 390 degrees F (190 degrees C). Spray the air fryer basket with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Dijon, honey, balsamic vinegar, garlic, salt, and pepper together in a small bowl.",
