  "ingredients": [
    "2 fluid ounces vodka",
    "2 fluid ounces freshly squeezed grapefruit juice",
    "1.5 fluid ounces freshly squeezed pomegranate juice",
    "0.5 fluid ounce sweet French vermouth",
    "0.5 ounce cream of balsamic (balsamic glaze)",
    "0.25 fluid ounce cold-pressed cranberry juice",
    "0.125 teaspoon freshly ground pink peppercorns",
    "ice cubes",
    "1 pinch freshly grated orange zest"
  ],
  "steps": [
    {
      "text": "Place vodka, grapefruit juice, pomegranate juice, vermouth, cream of balsamic, cranberry juice, and peppercorns in a cocktail shaker. Fill shaker with ice and shake well; strain into a martini glass. Sprinkle with orange zest.",
