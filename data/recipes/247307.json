  "ingredients": [
    "1 pound ground beef",
    "1 tablespoon butter",
    "2 zucchini, sliced 1/2-inch thick",
    "2 cups water",
    "2 tomatoes, diced",
    "1 (5.5 ounce) package Knorr® Rice Sides™ - Beef flavor",
    "1 tablespoon dried minced onion",
    "1 tablespoon Worcestershire sauce",
    "Salt and black pepper to taste",
    "1 cup grated Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Brown ground beef in a large skillet over medium-high heat, stirring and breaking meat up. Transfer ground beef to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in the same skillet; add zucchini and sauté until slightly softened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return ground beef to the skillet. Add water, tomatoes, Knorr rice, dried onion, and Worcestershire sauce. Bring to a boil over high heat. Reduce heat to low; cover and cook, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with salt and pepper, and top with cheese. Let sit 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
