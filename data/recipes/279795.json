  "ingredients": [
    "1 pound fresh jalapenos",
    "1 cup white distilled vinegar",
    "0.5 cup water",
    "1 tablespoon minced garlic",
    "1 tablespoon sugar",
    "1 teaspoon sea salt"
  ],
  "steps": [
    {
      "text": "Slice jalapeños into thin rings using a mandoline.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine jalapeño rings, vinegar, water, garlic, sugar, and sea salt in a multi-functional pressure cooker (such as Instant Pot). Close and lock the lid. Select high pressure according to manufacturer's instructions; set the timer for 0 minutes. Allow 10 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle jalapeño rings and cooking liquid between 2 pint-sized jars and immediately place in the refrigerator to cool.",
