  "ingredients": [
    "2 cups dried brown lentils, rinsed and drained",
    "3 cups chicken stock",
    "1 bay leaf",
    "1 cup chopped carrots",
    "1 cup chopped celery",
    "1 cup chopped onion",
    "1 cup cooked, cubed ham",
    "1 teaspoon Worcestershire sauce",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon freshly grated nutmeg",
    "5 drops hot pepper sauce",
    "0.25 teaspoon caraway seed",
    "0.5 teaspoon celery salt",
    "1 tablespoon chopped fresh parsley",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place lentils in a 5- to 6-quart slow cooker. Add chicken stock, bay leaf, carrots, celery, onion, and ham. Season with Worcestershire sauce, garlic powder, nutmeg, hot pepper sauce, caraway seed, celery salt, parsley, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook on Low for 8 to 10 hours. Remove bay leaf before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
