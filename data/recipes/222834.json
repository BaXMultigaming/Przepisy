  "ingredients": [
    "1 (750 milliliter) bottle Chardonnay wine",
    "1 liter club soda",
    "3 tablespoons orange-flavored liqueur (such as Cointreau®)",
    "2 tablespoons white sugar",
    "1 cup seedless green grapes",
    "2 kiwis, peeled and sliced",
    "1 large pear, thinly sliced",
    "ice cubes",
    "8 sprigs mint"
