  "ingredients": [
    "white sugar, for rimming",
    "2 large limes, quartered",
    "0.5 bunch mint leaves",
    "7 strawberries, quartered",
    "1 cup white sugar",
    "2 cups club soda",
    "1 cup white rum",
    "8 cups ice cubes"
