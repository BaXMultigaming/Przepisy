  "ingredients": [
    "2 (5 ounce) cans tuna, drained",
    "0.5 cup refried black beans",
    "0.5 cup low-fat sour cream",
    "0.5 cup canned sweet corn, drained",
    "2 tablespoons hot buffalo wing sauce",
    "1 tablespoon garlic salt",
    "1 teaspoon ground cumin",
    "1 tablespoon butter, divided",
    "4 (9 inch) tortillas whole-wheat tortillas",
    "0.5 cup shredded Mexican cheese blend, divided"
  ],
  "steps": [
    {
      "text": "Combine tuna, black beans, and sour cream in a large bowl. Stir in corn, Buffalo wing sauce, garlic salt, and cumin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1 1/2 teaspoons butter in a large skillet over medium heat. Add 1 tortilla and heat for 1 minute; flip. Spread 1/2 tuna mixture over tortilla, sprinkle with 1/2 Mexican cheese, and top with another tortilla. Cover the skillet; cook for 1 minute. Flip quesadilla, cover, and cook until cheese is melted, 1 to 2 minutes. Repeat with remaining butter, tortillas, and filling. Slice each quesadilla into 8 wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
