  "ingredients": [
    "2.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "1 cup white sugar",
    "0.66666698455811 cup butter, softened",
    "1 cup mashed bananas",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 400 degrees F (200 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Fm7AZmHCmkG7LTLO7zia57l82ZY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11201-Banana-Chocolate-Chip-Cookies-DDMFS-Step-1-0533-79579c3da3d7476aae5b027b5e23679e.jpg"
      ],
      "image": "assets/images/11201/step_01.webp"
    },
    {
      "text": "Sift flour, baking powder, salt, and baking soda together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a separate large bowl with an electric mixer until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K4xZvwM7R9D3e_T4ddkTq3FcF4M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11201-Banana-Chocolate-Chip-Cookies-DDMFS-Step-3-0535-5ed45a18dff441c6842de7d43a31cdca.jpg"
      ],
      "image": "assets/images/11201/step_03.webp"
    },
    {
      "text": "Add bananas, eggs, and vanilla; beat to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0S1LGzPSZItQVEIL2uqr6b9_yAY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11201-Banana-Chocolate-Chip-Cookies-DDMFS-Step-4-0536-33de31f85ca94e8c8d4bd8154d4600ea.jpg"
      ],
      "image": "assets/images/11201/step_04.webp"
    },
    {
      "text": "Gradually blend in flour mixture until just combined; stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cUX6D8p3nbw4eTxcBHwvLFbUiMY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11201-Banana-Chocolate-Chip-Cookies-DDMFS-Step-5-0538-e233145ec1554ae2931e60b4c9e9dc22.jpg"
      ],
      "image": "assets/images/11201/step_05.webp"
    },
    {
      "text": "Drop dough by teaspoonfuls onto prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nIS-A04Y7pEjmMIKvPOs_cAukLc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11201-Banana-Chocolate-Chip-Cookies-DDMFS-Step-6-0540-eac93a9479e94879bca59d9e9a3d1b78.jpg"
      ],
      "image": "assets/images/11201/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven for 12 to 15 minutes. Transfer cookies to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9nS8RThagYB0zPSiKpz5dihGrL4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11201-Banana-Chocolate-Chip-Cookies-DDMFS-Step-7-0546-8c6c13223f6442f8974729429be6e302.jpg"
      ],
      "image": "assets/images/11201/step_07.webp"
