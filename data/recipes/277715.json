  "title": "Bourbon Bread Pudding",
  "description": "This bourbon-sauced bread pudding has layers of flavor from raisins, chopped hazelnuts, and cinnamon.",
  "authors": [
    "BugNBear"
  ],
  "date_published": "2004-03-21T17:57:16-05:00",
