  "ingredients": [
    "4 (14.5 ounce) cans whole peeled tomatoes",
    "4 cups fresh sliced mushrooms",
    "2 (15 ounce) cans tomato sauce",
    "4 (6 ounce) cans tomato paste",
    "3 cups water",
    "2 onions, chopped",
    "0.25 cup chopped fresh basil",
    "4 cloves garlic, minced",
    "4 teaspoons white sugar",
    "2 pinches baking soda, divided",
    "salt and ground black pepper to taste",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xX7vC7RYlNU3CGatFPdJimYGDAI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11885-moms-best-spaghetti-sauce-DDMFS-step-1-576db2139e0343e4b2fde83425a09314.jpg"
      ],
      "image": "assets/images/11885/step_01.webp"
    },
    {
      "text": "Mix together whole tomatoes, mushrooms, tomato sauce, tomato paste, water, onions, basil, garlic, sugar, 1 pinch of baking soda, salt, and pepper in a large saucepan. Bring to a boil over high heat while stirring, then reduce heat to a simmer, and cook for at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CEFAlrJPQbHh1XMMvfhfn58AZpg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11885-moms-best-spaghetti-sauce-DDMFS-step-2-ad36cceb039d4656a1cecd4e73fa03a0.jpg"
      ],
      "image": "assets/images/11885/step_02.webp"
    },
    {
      "text": "Stir in remaining pinch of baking soda; sauce will foam. Simmer, stirring occasionally, until thick and almost brown. Make sure to scrape the sides of the pan into the sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2nbmpk21mHclPVhcQMGcOWRPkfQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11885-moms-best-spaghetti-sauce-DDMFS-step-3-c15ad0bcfd034b82961b8a09c3eac78a.jpg"
      ],
      "image": "assets/images/11885/step_03.webp"
    },
    {
      "text": "Stir in Parmesan cheese. Taste sauce: if too tangy or acidic, add another pinch of baking soda and simmer for 30 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UemUhpo53mbS8F909lwCGicAbjE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11885-moms-best-spaghetti-sauce-DDMFS-step-4-3cc271f8ca334497a400bdf196470ad8.jpg"
      ],
      "image": "assets/images/11885/step_04.webp"
    },
    {
      "text": "Let sauce cool to room temperature, then cover and refrigerate for 8 hours to overnight. Reheat the next day and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jfEYIIxdrDyWNPkkmt_p5Tb7BIQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11885-moms-best-spaghetti-sauce-DDMFS-step-5-e70bca1fa10b4a1aa197d7f1ce48544b.jpg"
      ],
      "image": "assets/images/11885/step_05.webp"
    }
  ],
