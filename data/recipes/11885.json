  "title": "Mom's Best Spaghetti Sauce",
  "description": "This secret ingredient spaghetti sauce is made with tomato, mushrooms, and a bit of baking soda for a rich, dark sauce finished with Parmesan cheese.",
  "authors": [
    "Barb Tucker"
  ],
  "date_published": "1999-05-14T20:40:31-04:00",
