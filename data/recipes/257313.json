  "ingredients": [
    "6 chicken thighs",
    "1 clove garlic, minced",
    "1 teaspoon ground black pepper",
    "1 teaspoon ground cumin",
    "1 teaspoon oregano",
    "2 tablespoons vegetable oil",
    "0.75 (12 fluid ounce) can or bottle beer",
    "1 tomato, quartered",
    "1 red onion, quartered",
    "1 bunch cilantro"
  ],
  "steps": [
    {
      "text": "Season chicken thighs with garlic, black pepper, cumin, and oregano.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep saucepan over medium-high heat; cook seasoned chicken until browned on both sides, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beer, tomato, red onion, and cilantro in a blender; blend until a smooth sauce forms. Pour sauce over chicken and reduce heat to low; simmer until chicken is very tender, 45 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
