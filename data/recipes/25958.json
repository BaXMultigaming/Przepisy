  "ingredients": [
    "1 cup graham cracker crumbs",
    "5 tablespoons butter, melted",
    "0.25 cup finely chopped walnuts",
    "3 tablespoons brown sugar",
    "1 tablespoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "3 (8 ounce) packages cream cheese",
    "1 cup white sugar",
    "1 cup sour cream",
    "1 cup heavy cream",
    "3 tablespoons all-purpose flour",
    "1 tablespoon vanilla extract",
    "3 eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham cracker crumbs, melted butter, chopped walnuts, brown sugar, cinnamon, and nutmeg in a bowl; press into the bottom of a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Remove from the oven; cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and white sugar together in a large bowl with an electric mixer until smooth. Beat in sour cream and heavy cream; beat in flour and vanilla. Beat in eggs, one at a time, with mixer on low; pour batter over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center is almost set (filling will be soft), 60 to 70 minutes. Refrigerate at least 6 hours to overnight before removing from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
