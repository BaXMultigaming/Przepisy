  "ingredients": [
    "1 serving nonstick cooking spray",
    "1 pound ground beef",
    "1 cup chopped onion",
    "0.25 cup shredded Cheddar cheese",
    "0.25 cup crushed plain tortilla chips",
    "0.25 cup salsa",
    "1 egg",
    "1 (1.25 ounce) package taco seasoning mix"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 9x13-inch glass baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef, onion, Cheddar cheese, tortilla chips, salsa, egg, and taco seasoning together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form 1-inch balls from the mixture and place into the prepared dish so they aren't touching.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and no longer pink in the centers, about 30 minutes. Let stand for 5 minutes and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
