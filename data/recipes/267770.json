  "ingredients": [
    "2 pounds smoked oxtail, cut into segments",
    "2 medium sweet potatoes, chopped",
    "1 large red bell pepper, chopped",
    "1 medium onion, chopped",
    "4 cloves garlic, chopped",
    "1 (14.5 ounce) can fire-roasted diced tomatoes",
    "1 cup beef broth",
    "2 tablespoons brown sugar",
    "2 teaspoons chili powder",
    "2 bay leaves",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground allspice",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Place oxtails, sweet potatoes, bell pepper, onion, and garlic in a 6-quart slow cooker. Pour tomatoes and beef broth on top. Stir in brown sugar, chili powder, bay leaves, salt, black pepper, cinnamon, and allspice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover slow cooker. Cook on High for 5 to 6 hours, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer oxtails to a cutting board; shred meat off bones. Discard bones.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Skim fat off top of slow cooker liquid. Return oxtail meat to the slow cooker. Taste; season with brown sugar, salt, and black pepper. Stir to combine. Serve warm, topped with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
