  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "0.5 cup white sugar",
    "3 eggs",
    "4 ounces German sweet chocolate, melted, divided",
    "4 ounces semisweet chocolate, melted, divided",
    "1 (8 inch) prepared graham cracker crust",
    "0.5 cup sour cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese and sugar together in a bowl using an electric mixer. Mix in eggs. Add 1/2 the German chocolate and 1/2 the semisweet chocolate; beat until thick and smooth. Pour into the prepared pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, 30 to 35 minutes. Let cool completely, about 30 minutes. Chill in the refrigerator for 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix remaining German chocolate and semisweet chocolate with sour cream in a bowl. Spread over chilled pie. Return to the refrigerator until firm, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
