  "ingredients": [
    "0.33333334326744 cup marinara sauce",
    "1.5 teaspoons chopped fresh flat-leaf parsley",
    "0.5 teaspoon red pepper flakes",
    "salt and freshly ground black pepper to taste",
    "2 eggs",
    "1 tablespoon finely shredded Parmigiano-Reggiano cheese",
    "2 teaspoons olive oil",
    "2 tablespoons heavy whipping cream",
    "2 slices toast"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread marinara sauce in the bottom of a small baking dish, about 1/4-inch high. Sprinkle with parsley, red pepper flakes, salt, and black pepper. Make a narrow well in center of sauce for eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crack each egg into a separate ramekin; gently pour into the well in the sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with Parmigiano-Reggiano cheese, then drizzle with olive oil, followed by cream; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until yolks are just set, 10 to 12 minutes. Serve with toast.",
      "section": null,
      "name": null,
      "url": null,
