  "ingredients": [
    "0.75 cup butter",
    "1.5 cups brown sugar",
    "1.5 teaspoons vanilla",
    "2.25 cups quick cooking oats",
    "0.75 cup sesame seeds",
    "0.75 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Butter a 10x15 inch jellyroll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Stir in brown sugar and vanilla. Remove from heat, and stir in oats, sesame seeds and baking powder until well blended. Press evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 7 to 10 minutes in the preheated oven, or golden brown. Cool in the pan over a wire rack. Cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
