  "title": "Old Fashioned Peanut Butter Cookies",
  "description": "This recipe for old-fashioned peanut butter cookies packs in twice the peanut butter and adds peanut butter chips!",
  "authors": [
    "Stephanie"
  ],
  "date_published": "1998-04-23T16:29:53-04:00",
