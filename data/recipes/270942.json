  "ingredients": [
    "0.5 cup Greek yogurt",
    "0.25 cup stone-ground mustard",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon ground cayenne pepper",
    "0.33333334326744 cup all-purpose flour",
    "12 ounces spicy pork sausage",
    "12 quail eggs, hard-boiled and peeled",
    "1 egg, beaten",
    "1 cup panko bread crumbs",
    "1 serving cooking spray"
  ],
  "steps": [
    {
      "text": "Combine yogurt, mustard, garlic powder, and cayenne pepper in a small bowl. Cover and refrigerate mustard dipping sauce until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour on a flat plate. Divide sausage into 12 equal portions. Shape into balls; flatten each into a paper thin patty. Dredge both sides of each patty in flour; shake off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap each sausage patty around a hard-boiled quail egg, making sure the egg is completely sealed inside. Dip each in the beaten egg, then coat in bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat the air fryer basket with cooking spray; place 6 eggs in the basket. Lightly coat tops with cooking spray; cook for 8 minutes. Flip and coat again; cook 6 minutes more. Repeat with remaining 6 eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice each egg in half. Serve with mustard dipping sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
