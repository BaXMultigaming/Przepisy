  "ingredients": [
    "0.5 cup dried porcini mushrooms",
    "0.5 cup water",
    "2.5 pounds beef short ribs",
    "salt and freshly ground black pepper to taste",
    "2 tablespoons vegetable oil",
    "1 onion, sliced",
    "2 cloves garlic, minced",
    "2 cups beef broth",
    "1 cup tomato sauce",
    "1 teaspoon dried rosemary",
    "1/2 teaspoon salt",
    "1 pinch cayenne pepper",
    "1 bay leaf"
  ],
  "steps": [
    {
      "text": "Soak mushrooms in water in a bowl until rehydrated, about 30 minutes. Drain and reserve liquid; dice mushrooms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season short ribs all over with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a large skillet over medium-high heat. Add short ribs; cook until browned on all sides, 7 to 12 minutes. Transfer ribs to a Dutch oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook onion with a pinch of salt in the same skillet until softened, about 3 minutes. Add garlic; cook until fragrant, about 1 minute. Stir in mushrooms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add reserved mushroom liquid to the skillet; bring to a boil while scraping the browned bits of food off the bottom of the skillet with a wooden spoon. Stir in beef broth, tomato sauce, rosemary, ½ teaspoon salt, cayenne pepper, and bay leaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour beef broth mixture over short ribs. Cover the Dutch oven with a lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven until short ribs are fork-tender, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
