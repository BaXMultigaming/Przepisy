  "ingredients": [
    "1 pound bacon",
    "2 cups broccoli florets, chopped",
    "2 cups cauliflower florets, chopped",
    "1 carrot, chopped",
    "0.25 cup chopped green onions",
    "0.5 cup mayonnaise",
    "0.25 cup distilled white vinegar",
    "1 tablespoon sour cream",
    "1 pinch garlic powder",
    "1 pinch dried basil",
    "0.25 cup shredded Cheddar cheese",
    "1 tablespoon chopped fresh cilantro, or to taste"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Chop and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine broccoli, cauliflower, carrot, and green onions in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise, vinegar, and sour cream in a separate bowl. Beat until smooth. Season with garlic powder and basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing over vegetables and toss to coat evenly. Chill until flavors meld, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve salad garnished with Cheddar cheese and cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
