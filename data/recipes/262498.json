  "ingredients": [
    "0.25 cup balsamic vinegar",
    "1 teaspoon Dijon mustard",
    "1 teaspoon white sugar",
    "1 clove garlic, minced",
    "0.5 teaspoon salt",
    "freshly ground black pepper to taste",
    "0.5 cup extra-virgin olive oil"
  ],
  "steps": [
    {
      "text": "Whisk vinegar, mustard, sugar, garlic, salt, and black pepper together in a small bowl until sugar and salt are dissolved. Add oil in a thin stream, whisking continually until emulsified. Season with additional salt and pepper to taste.",
