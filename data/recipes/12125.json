  "ingredients": [
    "1.5 (.25 ounce) packages unflavored gelatin",
    "8 tablespoons cold water",
    "9 tablespoons white sugar",
    "2.25 tablespoons cornstarch",
    "2 eggs",
    "1.5 cups milk",
    "0.75 cup vanilla ice cream",
    "1 teaspoon vanilla extract",
    "2 cups heavy whipping cream",
    "1 (9 inch) pie crust, baked"
  ],
  "steps": [
    {
      "text": "Soften gelatin in cold water. Scald the milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, mix together sugar and cornstarch. Add eggs and mix thoroughly. Add milk and softened gelatin, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook custard in double boiler over hot water until it thickens and coats spoon. Remove from heat. Add ice cream while custard is hot. Cool thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add vanilla. Whip the cream, and fold 1 1/2 cups into cooled custard. Pour filling into pie shell, and refrigerate until set. Garnish with remaining whipped cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
