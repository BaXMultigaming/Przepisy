  "ingredients": [
    "3 eggs, lightly beaten",
    "1 cup beer",
    "1 cup all-purpose flour",
    "0.5 teaspoon salt",
    "2.5 teaspoons vegetable oil",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "In a large bowl, beat together the eggs and beer. Sift together the flour and salt, and mix in. Beat in oil. Allow to stand for 1 hour. If batter is too thick, stir in a little milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a crepe pan over medium heat, and lightly coat with cooking spray. Pour on 2 tablespoons batter, and quickly spread to the edges of pan. Cook until top appears dry, then turn, and cook for 15 seconds. Set aside on paper towels and repeat cooking method until all batter is used.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
