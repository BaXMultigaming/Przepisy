  "ingredients": [
    "1 pound lean ground turkey",
    "2 tablespoons cider vinegar",
    "1.5 teaspoons chili powder",
    "1 teaspoon garlic powder",
    "1 teaspoon smoked paprika",
    "1 teaspoon sweet paprika",
    "0.75 teaspoon salt",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon ground coriander",
    "0.5 teaspoon dried Mexican oregano",
    "0.5 teaspoon ground dried chipotle pepper",
    "0.25 teaspoon ground cinnamon",
    "0.125 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Combine turkey, vinegar, chili powder, garlic powder, smoked paprika, sweet paprika, salt, cumin, coriander, oregano, dried chipotle pepper, cinnamon, and cloves in a bowl until well mixed. Cover bowl with plastic wrap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate for flavors to blend, at least 1 hour. Store in the refrigerator or freeze until ready to use.",
      "section": null,
