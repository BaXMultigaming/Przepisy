  "ingredients": [
    "1 ready made pizza crust",
    "2 cups shredded mozzarella cheese",
    "1 cup tomato sauce",
    "0.5 cup chopped green bell pepper",
    "0.5 cup fresh sliced mushrooms"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out prepared pizza dough to a size that will fit your grill. Place on grill for 5 minutes, or to desired doneness, and flip over. Now add the sauce, cheese, green bell pepper and mushrooms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the grill and allow to cook over high heat for 5 to 10 minutes, or until cheese is melted and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
