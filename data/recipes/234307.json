  "ingredients": [
    "2 cups pumpkin puree",
    "0.5 cup white sugar",
    "0.25 cup butter, softened",
    "0.25 cup French vanilla-flavored coffee creamer, or to taste",
    "3 eggs, beaten",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon, or to taste",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pumpkin, sugar, butter, French vanilla-flavored coffee creamer, eggs, salt, cinnamon, and vanilla extract together in a bowl until evenly combined; pour into an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pudding is set, about 40 minutes.",
