  "ingredients": [
    "4 medium apples - peeled, cored and sliced",
    "0.5 pomegranate, skin and light-colored membrane removed",
    "0.5 cup brown sugar",
    "1 tablespoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 cup rolled oats",
    "0.5 cup all-purpose flour",
    "0.5 cup white sugar",
    "0.5 cup unsalted butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Butter a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, toss together the apples, pomegranate seeds, brown sugar, cinnamon, and nutmeg. Spread evenly into the prepared pan. In the same bowl, stir together the oats, flour and sugar. Rub in the butter between your fingers until the mixture resembles coarse crumbs. Sprinkle over the top of the fruit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 45 minutes in the preheated oven, or until the apples are soft. Let stand 10 minutes before serving. Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
