  "ingredients": [
    "2 tablespoons salted butter",
    "1 cup chopped fresh figs",
    "0.5 cup balsamic vinegar",
    "0.5 cup chicken stock",
    "1 tablespoon honey",
    "1 tablespoon chopped fresh thyme",
    "2 (5 ounce) salmon fillets",
    "salt and ground black pepper to taste",
    "1 tablespoon salted butter"
  ],
  "steps": [
    {
      "text": "Melt 2 tablespoons butter in a skillet over medium heat. Add figs and sauté in melted butter until browned, 3 to 5 minutes. Add balsamic vinegar, chicken stock, honey, and thyme; bring to a simmer. Simmer until sauce begins to thicken, about 3 minutes. Lower heat and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, season salmon with salt and pepper. Melt 1 tablespoon butter in a skillet over medium-high heat. Add salmon and sear both sides in the hot skillet. Reduce heat to medium and cook until fish flakes easily with a fork, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top salmon fillets with equal amounts of fig sauce.",
      "section": null,
