  "title": "Keto Smothered Chicken Thighs",
  "description": "This keto chicken thigh recipe features juicy bone-in chicken thighs in a creamy mushroom sauce, topped with crispy bacon and green onions.",
  "authors": [
    "France Cevallos"
  ],
  "date_published": "2019-10-25T00:55:51-04:00",
