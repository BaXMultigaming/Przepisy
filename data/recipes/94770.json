        "https://www.allrecipes.com/thmb/0FrfFVjPRxbIrXO9IYBgs_iTF4w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-94770-holiday-eggnog-pie-VAT-4x3-step-05-a90ed159b1e546499fc304c7ea3a6409.jpg"
