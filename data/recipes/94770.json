  "ingredients": [
    "1.25 cups white sugar",
    "0.25 cup all-purpose flour",
    "2 cups eggnog",
    "3 eggs, beaten",
    "1 teaspoon vanilla extract",
    "0.25 cup unsalted butter, melted and cooled slightly",
    "1 (9 inch) unbaked deep dish pie crust"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8BmkzyH4L86RHDI2ObSXoDIwNFg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-94770-holiday-eggnog-pie-VAT-4x3-step-01-2538aa924dad4206ab428035ec299e91.jpg"
      ],
      "image": "assets/images/94770/step_01.webp"
    },
    {
      "text": "Mix sugar and flour together in a mixing bowl. Beat in eggnog, eggs, and vanilla until mixture is smooth. Stir in butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-jVUMPNGwFQi8ieQnhkwdSGofSU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-94770-holiday-eggnog-pie-VAT-4x3-step-02-4af7bcc14c114de2ac11042f064db56a.jpg"
      ],
      "image": "assets/images/94770/step_02.webp"
    },
    {
      "text": "Pour mixture into prepared deep dish pie crust; dust with cinnamon and nutmeg, if using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9WxC_TgJ4aAEzmpyJKKkT1lsYKc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-94770-holiday-eggnog-pie-VAT-4x3-step-03-3b5f166792ae461abe1fa8674f776bb7.jpg"
      ],
      "image": "assets/images/94770/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until custard is set, 45 to 60 minutes. The outer edges of the pie should be fully set and the center should still be a little jiggly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iSo6CNug1Uy5Q8prRGoCWM5sqJI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-94770-holiday-eggnog-pie-VAT-4x3-step-04-9accc2ab25b44070b25d536b4a0acb8b.jpg"
      ],
      "image": "assets/images/94770/step_04.webp"
    },
    {
      "text": "Remove from oven and let cool to room temperature before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
