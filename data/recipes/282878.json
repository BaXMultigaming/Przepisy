  "ingredients": [
    "1 tablespoon bacon grease",
    "1.5 pounds ground beef, preferably chuck",
    "0.5 medium white onion, minced",
    "8 cloves garlic, or to taste",
    "3 tablespoons chili powder",
    "1 tablespoon ground paprika",
    "2 teaspoons dried oregano",
    "0.5 teaspoon salt",
    "0.5 teaspoon black pepper",
    "1 (28 ounce) can tomato puree",
    "1 cup water",
    "3 tablespoons tomato paste",
    "2 teaspoons white sugar",
    "1 cube beef bouillon"
  ],
  "steps": [
    {
      "text": "Heat bacon grease in a large pot over medium-high heat. Cook and stir ground beef in the hot pot until almost browned, about 5 minutes. Reduce heat to medium and add onion; cook, stirring occasionally, until the onion has softened and turned translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add garlic, chili powder, paprika, oregano, salt, and pepper; cook and stir until fragrant, 2 to 3 minutes. Add tomato puree, water, tomato paste, sugar, and bouillon cube. Reduce heat to low. Cover and simmer, stirring occasionally, for 30 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
