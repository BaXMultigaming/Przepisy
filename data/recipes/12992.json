  "ingredients": [
    "0.5 cup butter",
    "1 cup all-purpose flour",
    "11 cups water",
    "3 cubes chicken bouillon",
    "2 pounds skinless, boneless chicken breast halves - cut into bite-size pieces",
    "2 heads fresh broccoli, cut into florets",
    "1.5 teaspoons salt",
    "1 teaspoon ground black pepper",
    "1 cup light cream",
    "3 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Melt butter in a 5-quart pot over medium heat. Stir in flour and cook, stirring constantly, until a thick paste forms. Remove from the pot and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water, bouillon cubes, chicken, broccoli, salt, and pepper in the same pot. Bring to a boil over high heat. Reduce heat to medium-low and simmer for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually stir in the flour mixture until the soup thickens. Simmer for 5 minutes. Reduce heat and stir in cream. Stir in cheese 1 cup at a time until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
