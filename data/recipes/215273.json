  "ingredients": [
    "2 cups all-purpose flour",
    "1.75 cups white sugar",
    "0.75 cup water",
    "0.75 cup unsweetened cocoa powder",
    "0.75 cup vegetable oil",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "3 eggs, room temperature",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9-inch round cake pans or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat flour, sugar, 3/4 cup water, cocoa powder, vegetable oil, salt, baking soda, and baking powder in a mixing bowl with an electric mixer on medium speed for 2 minutes. Add eggs, remaining 1/2 cup water, and vanilla extract; beat 2 minutes more. Pour batter into the prepared cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until surface of cakes spring back when lightly pressed and a toothpick inserted into centers comes out clean, about 30 minutes. Cool in the pans for 10 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
