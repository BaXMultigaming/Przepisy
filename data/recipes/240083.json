  "ingredients": [
    "1 cup pumpkin puree",
    "0.75 cup white sugar",
    "2 eggs, beaten",
    "0.25 cup canola oil",
    "0.25 cup applesauce",
    "1.75 cups gluten-free multi-purpose flour (such as Mixoflour)",
    "1 teaspoon baking soda",
    "0.75 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground ginger",
    "0.25 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin purée, sugar, eggs, oil, and applesauce in a large bowl. Whisk flour, baking soda, salt, cinnamon, nutmeg, cloves, and ginger together in a separate bowl; stir into pumpkin mixture until just blended into a batter. Gently fold in raisins; pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 60 to 70 minutes. Cool in the pan for 10 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
