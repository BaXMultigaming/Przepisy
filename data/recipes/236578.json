  "ingredients": [
    "1 (16 ounce) can chicken broth",
    "0.5 teaspoon soy sauce",
    "0.5 teaspoon sesame oil, or to taste",
    "0.25 cup finely broken udon noodles",
    "2 teaspoons water",
    "1 teaspoon cornstarch",
    "2 eggs, beaten",
    "sea salt to taste",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine chicken broth, soy sauce, and sesame oil together in a small saucepan; bring to a boil. Stir udon pieces into broth and cook, stirring occasionally, until cooked through but are still firm to the bite, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MiJfjEBzYc4IL_P-6_x1pvS7taU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236578-pick-me-up-egg-drop-soup-PICS-Step-01-e68097275234426a893041527a167a24.jpg"
      ],
      "image": "assets/images/236578/step_01.webp"
    },
    {
      "text": "Whisk water and cornstarch together in a bowl. Whisk cornstarch mixture into broth mixture until smooth and thickened slightly. Gradually pour in eggs, stirring gently and constantly, until eggs are wispy and cooked through, 2 to 3 minutes. Season with sea salt and black pepper.",
