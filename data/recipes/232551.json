  "ingredients": [
    "3 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon freshly ground cinnamon",
    "0.5 teaspoon freshly ground nutmeg",
    "0.25 teaspoon salt",
    "1 cup softened butter",
    "2 cups white sugar",
    "4 eggs",
    "2.6666667461395 cups cooked mashed sweet potatoes",
    "1 teaspoon vanilla extract",
    "1 cup flaked coconut",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 10-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, baking soda, cinnamon, nutmeg, and salt together in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter with an electric mixer in a large bowl until creamy, about 2 minutes. Gradually beat in sugar until fully incorporated, about 3 minutes. Add eggs, one at a time, beating well after each addition before adding the next. Beat in sweet potatoes and vanilla until well combined. Stir in flour mixture, coconut, and walnuts until just combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour 10 minutes.",
      "section": null,
      "name": null,
