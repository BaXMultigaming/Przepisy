  "ingredients": [
    "2 (8 ounce) packages fat-free cream cheese, softened",
    "1 (8 ounce) container fat-free sour cream",
    "2 cups fresh basil leaves, minced",
    "0.25 cup fresh flat-leaf Italian parsley, minced",
    "2 tomatoes, seeded and chopped",
    "2 cloves garlic, minced",
    "0.5 lemon, zested and juiced",
    "2 tablespoons tomato paste",
    "1 teaspoon onion salt",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon white sugar",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine, cream cheese, sour cream, basil, Italian parsley, tomatoes, garlic, lemon zest, lemon juice, tomato paste, onion salt, Worcestershire sauce, sugar, and pepper in a large mixing bowl. Beat with an electric mixer on High until whipped, 2 to 3 minutes.",
