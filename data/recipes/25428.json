  "ingredients": [
    "2 cups ketchup",
    "1 bulb garlic, peeled and crushed",
    "1 cup water",
    "2 tablespoons hot sauce",
    "0.25 cup honey",
    "2 tablespoons molasses",
    "2 tablespoons brown sugar",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon soy sauce",
    "1 teaspoon salt",
    "2 tablespoons Cajun seasoning",
    "1 pinch paprika",
    "1 pinch crushed red pepper",
    "1 pinch ground white pepper",
    "1 pinch ground black pepper",
    "2 tablespoons cornstarch",
    "1 tablespoon water",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Mix together ketchup, garlic, 1 cup water, hot sauce, honey, molasses, brown sugar, Worcestershire sauce, soy sauce, salt, Cajun seasoning, paprika, red pepper, white pepper, and black pepper in a large saucepan over medium-low heat. Allow mixture to simmer for approximately 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve cornstarch in 1 tablespoon water in a small bowl. Adjust amount of water as needed to dissolve cornstarch fully. Stir into sauce mixture. Continue simmering for about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir butter into sauce mixture. Continue simmering until butter is melted and sauce has begun to thicken, about 15 minutes. Serve over meats prepared as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
