  "title": "Honey Garlic BBQ Sauce",
  "description": "This is my favorite homemade garlic BBQ sauce. It uses a whole bulb of garlic and lots of honey.",
  "authors": [
    "Christian Strub"
  ],
  "date_published": "2020-03-04T23:56:35-05:00",
