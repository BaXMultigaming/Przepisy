  "ingredients": [
    "1.5 cups white sugar",
    "0.5 cup butter",
    "2 eggs",
    "2.5 cups pureed peaches",
    "1 teaspoon almond extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "1.25 cups chopped toasted pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 5x9-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until creamy. Beat in eggs, one at a time, until light and fluffy. Stir in peach purée and almond extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, baking soda, baking powder, cinnamon, and salt together in a medium bowl; stir into peach mixture until blended. Fold in pecans. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, 50 to 60 minutes. Cool bread in the pan for 10 minutes before removing from the pan to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
