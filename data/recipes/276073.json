  "ingredients": [
    "1 (8 ounce) package cream cheese, softened to room temperature",
    "2 cups powdered sugar",
    "1 envelope unflavored gelatin (such as Knox®)",
    "1 (8 ounce) container frozen whipped topping (such as Cool Whip®), thawed",
    "1 (9 inch) prepared graham cracker crust",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Combine cream cheese and powdered sugar in a large bowl; beat with an electric mixer until smooth. Add gelatin and beat until incorporated. Mix in whipped topping until smooth. Spread batter in prepared crust, leaving some room at the top. Spread cherry pie filling over cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in the refrigerator until firm, 3 to 4 hours.",
