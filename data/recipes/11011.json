  "ingredients": [
    "1 cup unsalted butter, softened",
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "3.5 cups all-purpose flour",
    "1 cup vegetable oil",
    "1 cup rolled oats",
    "1 cup crisp rice cereal",
    "1 cup flaked coconut",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "1 teaspoon baking soda",
    "1 teaspoon cream of tartar",
    "1 teaspoon salt",
    "1 cup ground walnuts",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, and brown sugar in a large mixing bowl until creamy. Mix in flour and oil until combined. Add oats, rice cereal, coconut, eggs, vanilla, baking soda, cream of tartar, and salt; mix until well blended. Mix in walnuts and chocolate chips. Drop tablespoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 10 to 15 minutes. Cool on the baking sheet briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
