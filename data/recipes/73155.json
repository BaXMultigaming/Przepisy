  "ingredients": [
    "2.5 cups water",
    "1 cup rolled oats",
    "1 tablespoon white sugar",
    "1 teaspoon salt",
    "2 bananas, sliced",
    "1 pinch ground cinnamon",
    "0.5 cup cold milk"
  ],
