  "ingredients": [
    "1 cup white sugar",
    "0.75 cup shortening",
    "0.5 cup brown sugar",
    "1.75 cups shredded pumpkin",
    "2 medium eggs",
    "2 cups whole wheat flour",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground allspice",
    "0.25 teaspoon ground cloves",
    "1 cup quick-cooking oats"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, shortening, and brown sugar together in a bowl using an electric mixer until smooth and creamy. Stir pumpkin and eggs into creamed butter mixture; add flour, baking powder, cinnamon, ginger, allspice, and cloves and mix until dough is just combined. Fold oats into dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by spoonfuls onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges of cookies are crisp, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
