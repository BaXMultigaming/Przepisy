  "ingredients": [
    "2 tablespoons flaxseed meal",
    "0.25 cup water",
    "1 cup butter, softened",
    "1 cup white sugar",
    "0.5 cup brown sugar",
    "3 egg yolks",
    "1.5 teaspoons pure vanilla extract",
    "2 cups all-purpose flour",
    "0.25 cup brewer’s yeast",
    "1 tablespoon wheat germ",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon cream of tartar",
    "2.5 cups old-fashioned oats",
    "1 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z4vcFylCJiXoozoeufEbDoFoH60=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232191-lactation-cookies-DDMFS-4x3-step-01-72263495253e4d0188ae741c266f9700.jpg"
      ],
      "image": "assets/images/232191/step_01.webp"
    },
    {
      "text": "Mix flaxseed meal with water in a small bowl and let soak for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cEtyBzCOCRmRDWqm1lGR_6PJZcc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232191-lactation-cookies-DDMFS-4x3-step-02-9b6928f868e94408b2b932337b3d9aa5.jpg"
      ],
      "image": "assets/images/232191/step_02.webp"
    },
    {
      "text": "Beat butter, white sugar, and brown sugar together in a large mixing bowl until creamy. Add egg yolks and vanilla extract; beat to incorporate. Stir in flaxseed mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8x66DCuZPBb5I5pr4BoBirhQGn0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232191-lactation-cookies-DDMFS-4x3-step-03-005663c957b04e5c85a72d70fe296285.jpg"
      ],
      "image": "assets/images/232191/step_03.webp"
    },
    {
      "text": "Mix flour, brewer's yeast, wheat germ, baking soda, salt, and cream of tartar, in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ma7uYBng9RjR5pEgqyJb3OPx5-8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232191-lactation-cookies-DDMFS-4x3-step-04-2b5cef1274344d07b83df54630cf803d.jpg"
      ],
      "image": "assets/images/232191/step_04.webp"
    },
    {
      "text": "Add dry ingredients to the wet ingredients and stir until just combined. Fold in oats and chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uTdkeyZsFSbtZGhPOhJ3PJ52R2w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232191-lactation-cookies-DDMFS-4x3-step-05-315138b901734d45b828c99a8d2b7bcd.jpg"
      ],
      "image": "assets/images/232191/step_05.webp"
    },
    {
      "text": "Roll dough into walnut-sized balls and place 2 inches apart onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GyYCoampz0SoMyd14ej_u60yFfo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232191-lactation-cookies-DDMFS-4x3-step-06-b3fea7ac777c44288ca38bee63931866.jpg"
      ],
      "image": "assets/images/232191/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until the edges are golden, 10 to 12 minutes. Allow cookies to cool on the baking sheet for 1 minute before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qOebg6j92jp0m9NDDQU6ylB4fPU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232191-lactation-cookies-DDMFS-4x3-step-07-f70d7f51b5e84353a744acc2c061721e.jpg"
      ],
      "image": "assets/images/232191/step_07.webp"
    },
    {
      "text": "Once cool, serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CBfUacUMdZsEqoK4gwl0fUQlCO8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232191-lactation-cookies-DDMFS-4x3-4095064b81b84d8a8438491528b603e4.jpg"
      ],
      "image": "assets/images/232191/step_08.webp"
    }
