  "ingredients": [
    "0.5 cup butter, softened",
    "2 cups brown sugar",
    "2 eggs",
    "0.5 cup applesauce",
    "3 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 cup cold coffee",
    "1 cup chopped pecans",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the butter, brown sugar, eggs and applesauce. Combine the flour, baking powder, baking soda, cinnamon and nutmeg; stir into the batter alternately with the cold coffee. Finally, mix in the raisins and pecans. Spread the batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 20 minutes in the preheated oven, or until lightly browned. Cool and cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
