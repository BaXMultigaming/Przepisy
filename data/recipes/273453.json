  "ingredients": [
    "3 fresh peaches, pitted and sliced into equal crescents",
    "1 pint fresh raspberries",
    "0.75 cup white sugar, divided",
    "1 lemon, juiced",
    "1 tablespoon ground cinnamon, divided",
    "2 cups rolled oats",
    "1.25 cups all-purpose flour",
    "0.5 cup unsalted butter, cubed",
    "0.25 cup brown sugar",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine peaches, raspberries, ½ cup white sugar, lemon juice, and ½ tablespoon cinnamon in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, flour, butter, remaining ¼ cup white sugar, brown sugar, remaining ½ tablespoon cinnamon, and salt in a separate bowl until thoroughly smooth and not lumpy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour peach-raspberry mixture into a large ceramic baking dish, spreading evenly; top evenly with oat crumble mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
