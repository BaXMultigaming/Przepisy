  "ingredients": [
    "1 pound carrots, peeled and julienned (preferably with a mandoline)",
    "3 cloves garlic, minced",
    "0.25 cup vinegar",
    "1 tablespoon white sugar",
    "2.5 teaspoons salt",
    "0.33333334326744 cup vegetable oil",
    "0.5 onion, minced",
    "1 teaspoon ground coriander",
    "0.5 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Place carrots in a large bowl. Sprinkle garlic over carrots.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix vinegar, sugar, and salt together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat. Cook and stir onion in hot oil until soft and translucent, 5 to 7 minutes. Stir coriander and cayenne pepper into the onion; add to carrot mixture and toss. Pour vinegar dressing over carrot mixture; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer carrot salad to a dish with a tight-fitting lid, cover, and refrigerate 4 to 24 hours, tossing salad several times while it marinates.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
