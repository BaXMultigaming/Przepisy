  "ingredients": [
    "4 (6 ounce) fresh cod fillets",
    "0.25 cup coconut aminos",
    "0.5 cup shredded Parmigiano-Reggiano cheese",
    "1/2 cup garlic keto bread crumbs",
    "0.33333334326744 cup unsweetened coconut flakes",
    "1 tablespoon granular sucralose sweetener (such as Splenda®)",
    "2 teaspoons salt",
    "1 teaspoon ground dried chipotle pepper",
    "3 large egg yolks",
    "3 tablespoons heavy cream",
    "2 tablespoons coconut aminos"
  ],
  "steps": [
    {
      "text": "Marinate cod in 1/4 cup coconut aminos in a glass or ceramic bowl in the refrigerator for 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Parmigiano-Reggiano cheese, bread crumbs, coconut flakes, sweetener, salt, and chipotle pepper in the bowl of a food processor; blend into a moderately fine powder. Transfer to a large plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together egg yolks, cream, and 2 tablespoons coconut aminos in a shallow bowl until well combined for egg wash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove fish fillets from marinade, dip in egg wash, and cover completely in bread crumb mixture until thickly coated. Discard any excess marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry at 360 degrees F (182 degrees C) until fish flakes easily with a fork, 7 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
