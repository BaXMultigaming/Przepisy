  "ingredients": [
    "1 tablespoon olive oil",
    "1 tablespoon butter",
    "3 cloves garlic, finely minced",
    "1 jalapeno pepper, seeds and ribs removed, minced",
    "2 zucchini, halved lengthwise and sliced",
    "1 yellow bell pepper, cut into chunks",
    "1 red bell pepper, cut into chunks",
    "1 shallot, sliced",
    "0.25 teaspoon salt",
    "freshly ground black pepper to taste",
    "1 pinch paprika"
  ],
  "steps": [
    {
      "text": "Heat olive oil and butter in a large skillet over medium heat. Add garlic and jalapeño; cook and stir until softened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add zucchini, yellow bell pepper, red bell pepper, and shallot; continue to cook and stir until vegetables are tender, about 5 minutes more. Season with salt, pepper, and paprika.",
      "section": null,
      "name": null,
