  "ingredients": [
    "15 cloves garlic, peeled",
    "1.5 tablespoons extra-virgin olive oil",
    "2.5 cups chicken stock, heated",
    "sea salt and finely ground black pepper, to taste",
    "0.5 cup cream",
    "5 tablespoons butter, cut into small pieces",
    "0.25 cup chopped fresh parsley",
    "2 tablespoons chopped fresh thyme",
    "1.5 teaspoons chopped fresh oregano"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place garlic cloves in a small baking dish and toss with oil to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cloves are light golden brown, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine garlic and hot stock in a blender. Season with salt and pepper. Blend until smooth. Add cream, butter, parsley, oregano, and thyme; process until completely blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer sauce to a container and allow to cool, about 10 minutes. Refrigerate until ready to use. Reheat the sauce over low heat when ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
