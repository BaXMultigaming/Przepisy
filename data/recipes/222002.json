    "publisher-tested"
  ],
  "ingredients": [
    "1 cup uncooked long grain white rice",
    "2 cups water",
    "1 onion, diced",
    "1 tablespoon olive oil",
    "2 cups marinara sauce",
    "1 cup beef broth",
    "1 tablespoon balsamic vinegar",
    "0.25 teaspoon crushed red pepper flakes",
    "1 pound lean ground beef",
    "0.25 pound hot Italian pork sausage, casing removed",
    "1 (10 ounce) can diced tomatoes",
    "0.25 cup chopped fresh Italian parsley",
    "4 cloves garlic, minced",
    "2 teaspoons salt",
    "1 teaspoon freshly ground black pepper",
    "1 pinch ground cayenne pepper",
    "1 cup finely grated Parmigiano-Reggiano cheese, plus more for topping",
    "4 large green bell peppers, halved lengthwise and seeded"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1nXYJRGGpxCDhZwhiQPCk7CAn4Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222002-Chef-Johns-Stuffed-Peppers-DDMFS-3115-4x3-Ingredients-14575df7114f48d79e48b3a2de018534.jpg"
      ],
      "image": "assets/images/222002/step_01.webp"
    },
    {
      "text": "Bring rice and water to a boil in a saucepan over high heat. Reduce heat to medium-low, cover, and simmer until the rice is tender, and the liquid has been absorbed, 20 to 25 minutes. Set the cooked rice aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Yp5_vtrOLkm2pLxIwbwkeZPw6N8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222002-Chef-Johns-Stuffed-Peppers-DDMFS-3117-4x3-Step-02-2e3bac6853f44aec83036fa833498984.jpg"
      ],
      "image": "assets/images/222002/step_02.webp"
    },
    {
      "text": "Meanwhile, preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the sauce: Cook onion and olive oil over medium heat until onion begins to soften, about 5 minutes. Transfer 1/2 of the cooked onion to a large bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5lBcXp0p1vJYTClmS5wqFSgBRJ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222002-Chef-Johns-Stuffed-Peppers-DDMFS-3121-4x3-Step-03-1c3e99153b56488fa35c2b48aa18973a.jpg"
      ],
      "image": "assets/images/222002/step_04.webp"
    },
    {
      "text": "Stir marinara sauce, beef broth, balsamic vinegar, and red pepper flakes into the skillet with cooked onion; cook and stir for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JqRT3335lGgjOq5lZNII2Ko2yt4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222002-Chef-Johns-Stuffed-Peppers-DDMFS-3129-Step-04-b9e2574cce8d4eb3ad9cdd8fe07ba037.jpg"
      ],
      "image": "assets/images/222002/step_05.webp"
    },
    {
      "text": "Pour sauce mixture into a 9x13-inch baking dish and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DRqSOZnp6iW3hmwMQV0nCIOfaDQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222002-Chef-Johns-Stuffed-Peppers-DDMFS-3130-Step-05-e4f86bd2328849359c3894ec0834a9aa.jpg"
      ],
      "image": "assets/images/222002/step_06.webp"
    },
    {
      "text": "Combine ground beef, Italian sausage, diced tomatoes, Italian parsley, garlic, salt, black pepper, and cayenne pepper into the bowl with reserved onions; mix well. Stir in cooked rice and one cup of Parmigiano Reggiano. Stuff bell peppers with beef and sausage mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d6DN_kpNKJeK_WqbWRKdaiiTEP0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222002-Chef-Johns-Stuffed-Peppers-DDMFS-3171-Step-07-760304fc18874bfd8c29cfcf1eb50329.jpg"
      ],
      "image": "assets/images/222002/step_07.webp"
    },
    {
      "text": "Place stuffed bell pepper halves in the baking dish over tomato sauce; optionally sprinkle with additional Parmigiano Reggiano, cover baking dish with aluminum foil, and bake in the preheated oven for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j46xGMSZnX8HFiX9L1P2u9dQoDc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222002-Chef-Johns-Stuffed-Peppers-DDMFS-3172-4x3-Step-08-a5509e34f0894ad88fbac054681efa2e.jpg"
      ],
      "image": "assets/images/222002/step_08.webp"
    },
    {
      "text": "Remove aluminum foil and continue to bake until meat is no longer pink, bell peppers are tender and cheese is browned on top, an additional 20 to 25 minutes. Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mGdBE1zvZHj2b_9UBCEyR70sbbI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222002-Chef-Johns-Stuffed-Peppers-DDMFS-3199-4x3-Beauty-9b5aa3cd48bd4195aa2f2878ecb5782c.jpg"
      ],
      "image": "assets/images/222002/step_09.webp"
    }
  ],
