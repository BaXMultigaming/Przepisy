  "title": "Chef John’s Stuffed Peppers",
  "description": "This is the best stuffed peppers recipe that simply fills bell peppers with a mix of rice, ground beef and pork sausage for an easy yet satisfying supper.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-04-27T18:45:14-04:00",
  "date_modified": "2026-07-06T12:24:22-04:00",
