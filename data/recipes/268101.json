  "ingredients": [
    "2 tablespoons vegetable oil",
    "1.5 pounds baby potatoes, cut into quarters",
    "0.5 cup water",
    "2.5 tablespoons low-sodium soy sauce",
    "2 tablespoons ketchup",
    "2 tablespoons corn syrup",
    "1.5 tablespoons white sugar",
    "1 tablespoon minced garlic",
    "0.125 teaspoon red pepper flakes",
    "1 teaspoon sesame seeds"
  ],
  "steps": [
    {
      "text": "Heat oil in a wok over medium-high heat. Add potatoes; stir-fry until browned in spots and partially cooked through, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While potatoes are cooking, mix together water, soy sauce, ketchup, corn syrup, sugar, garlic, and red pepper flakes in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour soy sauce mixture over potatoes. Reduce heat and simmer until potatoes are tender and sauce thickens, 6 to 8 minutes. Sprinkle with sesame seeds and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
