  "ingredients": [
    "1 (1 1/2-pound) beef flank steak",
    "1 (8 ounce) can chopped tomatoes",
    "1 onion, sliced",
    "1 green bell pepper, sliced into strips",
    "1 red bell pepper, sliced into strips",
    "1 jalapeno pepper, seeded and chopped",
    "2 cloves garlic, minced",
    "1 teaspoon chili powder",
    "1 teaspoon ground cumin",
    "1 teaspoon ground coriander",
    "0.25 teaspoon salt",
    "6 large flour tortillas, or as needed",
    "1 cup shredded Mexican cheese blend"
  ],
  "steps": [
    {
      "text": "Place flank steak pieces into a slow cooker. Stir in tomatoes, onion, bell peppers, jalapeño pepper, garlic, chili powder, cumin, coriander, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 8 to 10 hours or High for 4 to 6 hours, until steak is fall-apart tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove steak from the slow cooker and shred. Return to the slow cooker and stir into the sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve hot with tortillas and shredded cheese, allowing everyone to make their own fajita.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
