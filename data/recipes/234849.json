  "ingredients": [
    "1 cup milk, divided",
    "1 tablespoon white sugar, or more to taste",
    "1 tablespoon pumpkin puree",
    "1 teaspoon pumpkin pie spice",
    "0.5 teaspoon vanilla extract",
    "0.25 cup brewed espresso"
  ],
  "steps": [
    {
      "text": "Whisk ½ cup milk, sugar, pumpkin purée, pumpkin pie spice, and vanilla extract together in a small saucepan over low heat; simmer for 5 minutes. Whisk in remaining ½ cup milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain milk mixture through a fine-mesh sieve to remove pulp. Return milk mixture to the saucepan; simmer and whisk, 2 minutes. Whisk in espresso until foamy, 1 minute.",
