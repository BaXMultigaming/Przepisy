  "ingredients": [
    "2.5 cups almond flour",
    "1 cup light brown sugar",
    "1 cup chopped toasted pecans",
    "1 cup semisweet chocolate chips",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon sea salt",
    "0.5 cup grapeseed oil",
    "1 egg",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almond flour, brown sugar, pecans, chocolate chips, baking soda, and salt in a large bowl. Add oil, egg, and vanilla extract; stir until a large ball of dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 1-inch balls; place on the prepared baking sheets 1 inch apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are firm and lightly golden, about 11 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
