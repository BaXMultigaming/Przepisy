  "ingredients": [
    "1 pound lean ground beef",
    "0.5 cup chopped onion",
    "0.5 cup ketchup",
    "2 tablespoons yellow mustard",
    "1 (.87 ounce) package McCormick® Brown Gravy Mix",
    "1 (8 ounce) package whipped cream cheese",
    "1 cup shredded Cheddar cheese, divided",
    "0.33333334326744 cup chopped tomatoes",
    "3 tablespoons chopped pickles"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Mix ground beef, onion, ketchup, mustard and Gravy Mix in large skillet until well blended. Cook and stir on medium-high heat until beef is no longer pink. Stir in cream cheese and 1/2 cup of the shredded cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon into 2-quart baking dish. Sprinkle with remaining 1/2 cup shredded cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 10 to 15 minutes or until cheese is melted. Sprinkle with tomatoes and pickles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
