  "ingredients": [
    "1 tablespoon distilled white vinegar",
    "1 cup mayonnaise",
    "2 tablespoons prepared Dijon-style mustard",
    "3 cups shredded cabbage",
    "3 cups shredded red cabbage",
    "1 cup grated carrot",
    "0.5 cup shredded green bell pepper",
    "0.5 cup shredded rell bell pepper",
    "0.5 cup shredded celery"
  ],
  "steps": [
    {
