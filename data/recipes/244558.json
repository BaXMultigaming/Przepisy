  "ingredients": [
    "1 tablespoon vegetable oil",
    "2 pounds lean ground beef",
    "1 onion, diced",
    "2 teaspoons salt",
    "3 tablespoons ground ancho chile powder",
    "3 cloves garlic, minced",
    "1 tablespoon ground cumin",
    "1 teaspoon paprika",
    "1 teaspoon ground black pepper",
    "0.125 teaspoon ground cinnamon",
    "1 (12 ounce) bottle beer",
    "2 cups water, or as needed",
    "1 cup tomato puree",
    "1 teaspoon unsweetened cocoa powder",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon ground cayenne pepper",
    "2 (12 ounce) cans pinto beans, drained and rinsed well",
    "0.66666668653488 cup diced poblano pepper"
  ],
  "steps": [
    {
      "text": "Place a large pot over high heat; drizzle in oil. Cook and stir ground beef, onion, and salt in hot oil until beef is crumbly and browned and any released liquid evaporates, about 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hPDRkG67XNS8i4ZwmiT2iYfjVzo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244558-beef-bean-and-beer-chili-VAT-step-01-3bfdc194485441d79edcc0e082184dcd.jpg"
      ],
      "image": "assets/images/244558/step_01.webp"
    },
    {
      "text": "Reduce heat to medium-high. Add chile powder, garlic, cumin, paprika, black pepper, and cinnamon. Cook and stir until mixture begins to darken, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1DLHaku1l0ksgX08Pdv6wQV-3Jc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244558-beef-bean-and-beer-chili-VAT-step-02-6b53146db9ad44aabe5a8673ef4082a9.jpg"
      ],
      "image": "assets/images/244558/step_02.webp"
    },
    {
      "text": "Pour in beer. Add water, tomato purée, cocoa powder, oregano, and cayenne; stir well. Bring to a simmer; reduce heat to medium-low and cook for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Vo-oMJfc0FIwVV4AqKBUZECWs2o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244558-beef-bean-and-beer-chili-VAT-step-03-b2d73dbf16324922ab4ba361825b5e9e.jpg"
      ],
      "image": "assets/images/244558/step_03.webp"
    },
    {
      "text": "Stir in beans and poblano pepper. Simmer until peppers are tender and flavors have blended, about 30 minutes; add more water if chili becomes too thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JUgaSFde0IxPjWQvz_9IIgIfDOA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244558-beef-bean-and-beer-chili-VAT-step-04-b9c3ed22f33c479d8cdcbd206606d87b.jpg"
      ],
      "image": "assets/images/244558/step_04.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h17rirnuL-RzeRT1UsKBSJCC6uI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244558-beef-bean-and-beer-chili-VAT-Beauty-4x3-1f867dbe0d034e33be505fe2be5195f5.jpg"
      ],
