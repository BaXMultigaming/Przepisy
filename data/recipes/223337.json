  "ingredients": [
    "1 egg, beaten",
    "1 tablespoon minced garlic",
    "0.25 teaspoon salt",
    "1 (4.5 ounce) can sliced mushrooms, drained",
    "1 pound ground beef"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix egg, garlic, salt, and mushrooms in a bowl. Add ground beef and mix until combined; divide into three patties.",
