  "ingredients": [
    "6 eggs",
    "1 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon ground nutmeg, divided",
    "2 cups whipping cream",
    "2 cups milk",
    "0.75 cup brandy, chilled",
    "0.33333334326744 cup spiced rum (such as Captain Morgan's®)"
  ],
