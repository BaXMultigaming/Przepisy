    "publisher-tested"
  ],
  "ingredients": [
    "12 slices day-old bread, cut into 1-inch cubes",
    "2 (8 ounce) packages cream cheese, cut into 1 inch cubes",
    "1 cup fresh blueberries",
    "12 eggs, beaten",
    "2 cups milk",
    "1 teaspoon vanilla extract",
    "0.33333334326744 cup maple syrup",
    "1 cup white sugar",
    "1 cup water",
    "2 tablespoons cornstarch",
    "1 cup fresh blueberries",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C9RK2COHGz-z7ZHDJJh23oL1qXo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15057-overnight-blueberry-french-toast-ddmfs-4x3-ingredients-ba71e287cea146b7a589ed3dbf951a00.jpg"
      ],
      "image": "assets/images/15057/step_01.webp"
    },
    {
      "text": "Prepare casserole: Lightly grease a 9x13-inch baking dish. Arrange 1/2 of the bread cubes in the dish and top with cream cheese cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t4d1ftejgdg_2BSpU3EDNHH2az8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15057-overnight-blueberry-french-toast-ddmfs-4x3-steps-02-9d73806610c140ecb5adb641d0759619.jpg"
      ],
      "image": "assets/images/15057/step_02.webp"
    },
    {
      "text": "Sprinkle blueberries over the cream cheese, then top with remaining bread cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BBcmy70RNgnQo-Ku6EJbc-McNFA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15057-overnight-blueberry-french-toast-ddmfs-4x3-steps-03-4ddf6a9245b94275a89fa892b1d09b88.jpg"
      ],
      "image": "assets/images/15057/step_03.webp"
    },
    {
      "text": "Whisk eggs, milk, vanilla extract, and syrup together in a large bowl until well-combined; pour over the bread cubes. Cover and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lsN9ExG0q2a6gNPE-efoHZsbZMc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15057-overnight-blueberry-french-toast-ddmfs-4x3-steps-04-107d6fe797ed4c968c1aa81408f90760.jpg"
      ],
      "image": "assets/images/15057/step_04.webp"
    },
    {
      "text": "Remove casserole from the refrigerator about 30 minutes before baking. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ib8_BrD5ZK84Mq3kcdAd5F4g-es=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15057-overnight-blueberry-french-toast-ddmfs-4x3-steps-05-5575d15a9cdd4897a4c5b2d1b0a9bf0b.jpg"
      ],
      "image": "assets/images/15057/step_05.webp"
    },
    {
      "text": "Bake casserole in the preheated oven, covered, for 30 minutes. Uncover, and continue baking until center is firm and surface is lightly browned, about 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TnDDaqXRwMjhuVEsl8CIlgxdkLo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15057-overnight-blueberry-french-toast-ddmfs-4x3-steps-06-44d6bb21234343b5b6bae046ac6a732e.jpg"
      ],
      "image": "assets/images/15057/step_06.webp"
    },
    {
      "text": "Meanwhile, prepare blueberry sauce: Mix sugar, water, and cornstarch together in a medium saucepan; bring to a boil and cook, stirring constantly, 3 to 4 minutes. Stir in blueberries, reduce heat to low, and simmer until all the blueberries burst, about 10 minutes. Stir in butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/20xlP0nd8nAUQzo8uTdVceEBuxA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15057-overnight-blueberry-french-toast-ddmfs-4x3-steps-07-5775abc3eff245ef95ad5a9d1ea5202b.jpg"
      ],
      "image": "assets/images/15057/step_07.webp"
    },
    {
      "text": "Serve portions of casserole on plates and pour warm syrup over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z6ivzX21OFyKGKRvI2QRVhPAOKU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15057-overnight-blueberry-french-toast-ddmfs-4x3-hero-1-52ba82012aa241be810904f8d2206e83.jpg"
      ],
      "image": "assets/images/15057/step_08.webp"
    }
  ],
