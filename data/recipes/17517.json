  "ingredients": [
    "1.5 cups cider vinegar",
    "10 tablespoons ketchup",
    "0.5 teaspoon cayenne pepper, or to taste",
    "1 pinch red pepper flakes",
    "1 tablespoon white sugar",
    "0.5 cup water",
    "1 pinch salt and black pepper to taste"
  ],
  "steps": [
    {
      "text": "In a small saucepan over medium heat, stir together vinegar, ketchup, cayenne pepper, red pepper flakes, sugar, and water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Simmer for 15 minutes, or until all sugar dissolves. Season to taste with salt and pepper. Remove from heat and let cool. Use to baste your favorite meat while grilling.",
