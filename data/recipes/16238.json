  "ingredients": [
    "1.5 pounds ground beef",
    "1 onion, chopped",
    "1 red bell pepper, chopped",
    "1 (6 ounce) can tomato paste",
    "1 cup water",
    "3 cloves garlic, minced",
    "1 tablespoon chili powder",
    "1 teaspoon paprika",
    "1 teaspoon ground cumin",
    "1 teaspoon distilled white vinegar",
    "3 tablespoons brown sugar",
    "1 teaspoon dried oregano",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "8 hamburger buns, split"
  ],
  "steps": [
    {
      "text": "In a large skillet over medium-high heat, saute the ground beef for 5 minutes. Add the onion and red bell pepper; saute for 5 more minutes, or until onion is tender. Drain the fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in tomato paste and water, stirring until paste is dissolved. Stir in garlic, chili powder, paprika, cumin, vinegar, brown sugar, oregano, salt and pepper. Continue to heat for 5 to 10 minutes, or until mixture is thick and stewy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
