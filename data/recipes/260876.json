  "ingredients": [
    "1 cup white sugar",
    "0.5 cup corn syrup",
    "0.5 cup salted macadamia nuts, chopped in half",
    "0.5 cup pecans, chopped",
    "1 teaspoon coconut oil",
    "0.5 teaspoon ground cinnamon",
    "1 pinch ground nutmeg",
    "0.5 cup dried blueberries",
    "1 teaspoon baking soda",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Butter a 10x15-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and corn syrup in a saucepan with a candy thermometer clipped on. Bring to a boil over medium heat, stirring constantly. Heat to 275 degrees F (135 degrees C); add macadamia nuts, pecans, coconut oil, cinnamon, and nutmeg. Cook and stir until candy mixture reaches 300 degrees F (148 degrees C); remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir blueberries, baking soda, and vanilla extract quickly into the candy mixture until combined. Pour all of the candy immediately onto the prepared pan. Spread evenly. Cool completely, about 15 minutes, before breaking into pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
