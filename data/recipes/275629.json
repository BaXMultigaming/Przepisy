  "ingredients": [
    "cooking spray",
    "2.5 cups oats",
    "1.5 cups pumpkin puree",
    "1 cup fat-free Greek yogurt",
    "0.75 cup white sugar",
    "2 eggs",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon pumpkin pie spice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Generously coat 18 cups of a mini muffin tin with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, pumpkin puree, yogurt, sugar, eggs, baking powder, baking soda, cinnamon, and pumpkin pie spice in the bowl of a food processor; process until ingredients are combined and oats are coarsely ground. Scoop batter into each muffin cup using a 2-teaspoon scoop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 23 minutes. Cool in the tins for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
