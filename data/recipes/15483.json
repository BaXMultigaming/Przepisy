  "ingredients": [
    "1.25 cups warm water (110 degrees F/45 degrees C)",
    "1 tablespoon vegetable oil",
    "1.5 tablespoons molasses",
    "1.5 cups unbleached bread flour",
    "1 cup rye flour",
    "0.5 cup whole wheat flour",
    "0.25 cup vital wheat gluten",
    "1 teaspoon salt",
    "3 tablespoons dry milk powder",
    "2 teaspoons instant coffee powder",
    "2 tablespoons unsweetened cocoa powder",
    "1 tablespoon caraway seed",
    "1.5 teaspoons active dry yeast"
  ],
  "steps": [
    {
      "text": "Place ingredients into the pan of a bread machine in the order suggested by the manufacturer. Select the Whole Wheat cycle, and Start.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "After the first rise, remove dough from the machine. Shape and place into a lightly oiled 9x5-inch loaf pan. Cover, and let rise for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven at 350 degrees C (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 45 minutes. Remove from oven, remove from pan, and let cool completely on a wire rack before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
