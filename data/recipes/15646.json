  "ingredients": [
    "2 teaspoons peanut oil",
    "2 stalks celery, chopped",
    "2 carrots, peeled and diagonally sliced",
    "1.5 pounds skinless, boneless chicken breast halves - cut into strips",
    "1 tablespoon cornstarch",
    "0.75 cup orange juice",
    "3 tablespoons light soy sauce",
    "1 tablespoon honey",
    "1 teaspoon minced fresh ginger root",
    "0.25 cup cashews",
    "0.25 cup minced green onions"
  ],
  "steps": [
    {
      "text": "Heat 1 teaspoon of the oil in a wok over high heat. Add the carrots and celery and stir fry for 3 minutes. Add remaining 1 teaspoon oil, then add the chicken and stir fry for 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, dissolve the cornstarch into the orange juice. Mix in the soy sauce, honey and ginger. Add this sauce to the wok and cook over medium heat until thickened. Top with the cashews and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
