  "ingredients": [
    "0.33000001311302 cup butter or margarine, softened",
    "0.25 cup light corn syrup",
    "0.75 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.5 cup all-purpose flour",
    "0.33300000429153 cup unsweetened cocoa powder",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).Grease and flour a 9x9 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the butter, corn syrup and sugar. Beat in the eggs one at a time, then stir in the vanilla. Combine the flour, cocoa and salt, gradually stir into the creamed mixture. Spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 to 35 minutes in the preheated oven, until brownies pull away from the sides of the pan. Frost when cooled, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
