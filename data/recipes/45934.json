  "ingredients": [
    "12 ounces sashimi grade tuna",
    "0.75 bunch green onions, thinly sliced",
    "0.5 medium onion, finely diced",
    "2 teaspoons minced fresh ginger root",
    "1 fresh jalapeno pepper, seeded and minced",
    "0.25 cup lemon juice, or to taste",
    "0.25 teaspoon soy sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Cut tuna into 1/2 inch cubes, and place into a bowl. Stir in the onion, green onions, ginger, jalapeno, lemon juice, and soy sauce; mix to combine. Cover and refrigerate for 2 to 3 hours. Taste before serving and add more lemon juice or soy sauce as needed.",
