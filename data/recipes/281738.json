  "ingredients": [
    "0.5 cup heavy whipping cream",
    "3 tablespoons sugar-free peanut butter-flavored syrup (such as Torani®)",
    "2 tablespoons peanut butter",
    "1 teaspoon powdered peanut butter (such as PB2®)",
    "ice",
    "2 tablespoons sugar-free vanilla syrup (such as Torani®)",
    "1 cup cold brew coffee, or as needed"
  ],
  "steps": [
    {
      "text": "Combine heavy whipping cream, syrup, peanut butter, and powdered peanut butter in a bowl. Whip with a hand mixer until creamy and slightly thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill 2 glasses with ice. Add 1 tablespoon vanilla syrup to each glass, fill 2/3 of the way with cold brew coffee, and divide peanut butter cream evenly between both.",
