  "ingredients": [
    "1.5 pounds fresh Brussels sprouts",
    "8 slices bacon",
    "1 teaspoon butter",
    "2 teaspoons olive oil",
    "4 cloves garlic, chopped",
    "0.5 cup reduced-sodium chicken broth",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "2 teaspoons butter"
  ],
  "steps": [
    {
      "text": "Cut an 'X' in the core end of each Brussels sprout. Set sprouts aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes; drain and cool on paper towels. Crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 teaspoon butter and olive oil in a large skillet over medium heat; cook and stir garlic until golden brown, 3 to 5 minutes. Add Brussels sprouts; toss to coat. Stir in broth, salt, and black pepper; cover and cook until Brussels sprouts are tender, 12 to 14 minutes. Drain liquid from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir remaining 2 teaspoons butter into Brussels sprouts mixture until melted. Mix in bacon and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
