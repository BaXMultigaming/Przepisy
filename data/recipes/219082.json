  "title": "Turkey Cocktail Meatballs with Orange Cranberry Glaze",
  "description": "You can make these ahead and freeze them without the glaze, then the day of the party, defrost them and simply reheat in the sauce.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2011-09-30T17:45:32-04:00",
  "date_modified": "2026-08-06T10:21:31-04:00",
