  "title": "Baked Salmon and Rice",
  "description": "Baked salmon and rice cooked with herbs and orange juice. Great served with steamed broccoli and carrots.",
  "authors": [
    "SDELATORE"
  ],
  "date_published": "2000-05-29T14:54:31-04:00",
