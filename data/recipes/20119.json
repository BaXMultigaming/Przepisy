  "ingredients": [
    "4 eggs",
    "1 cup vegetable oil",
    "2 cups white sugar",
    "1 (15 ounce) can pumpkin puree",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 12x18 inch half sheet pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, using a wooden spoon, mix together the eggs, oil, sugar and pumpkin until well blended. Combine the flour, baking powder, baking soda, salt, cinnamon, ginger, cloves and nutmeg; stir into the pumpkin mixture until just blended. Spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 to 30 minutes in the preheated oven, until bars spring back when lightly touched. Cool before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
