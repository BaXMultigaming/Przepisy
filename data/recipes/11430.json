  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "3 (1 ounce) squares unsweetened chocolate",
    "1 cup packed brown sugar",
    "0.5 cup butter",
    "1 egg",
    "0.75 cup sour cream",
    "0.5 cup chopped walnuts",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, soda, and salt together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the top half of a double boiler, melt the chocolate over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together brown sugar, butter, and egg in a large mixing bowl. Slowly mix in the flour mixture and mix until well blended. Pour in melted chocolate, sour cream, and vanilla. Mix well and stir in nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by teaspoonful onto greased cookie sheet about 1 inch apart. Bake for 10 minutes. Cool on wire racks. Cookies will be soft and about the size of a half dollar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When cooled top with Chocolate Frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
