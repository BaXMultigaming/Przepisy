  "ingredients": [
    "3 cups shredded potato",
    "6 saltine crackers, or as needed, crushed",
    "2 large eggs, beaten",
    "0.25 cup grated onion",
    "0.5 teaspoon salt, or more to taste",
    "0.25 teaspoon ground black pepper",
    "0.5 cup vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Combine potatoes, crackers, eggs, onion, salt, and pepper together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large, heavy skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop potato mixture with a spoon, press it against the side of the bowl to remove excess liquid; carefully drop into oil, flattening top slightly with the back of a spoon to make an even thickness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in batches until brown and crisp, 3 to 5 minutes per side. Drain on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
