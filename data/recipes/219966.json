  "ingredients": [
    "4 ounces bittersweet chocolate, chopped",
    "0.5 teaspoon instant coffee",
    "1 pinch salt",
    "1 cup heavy cream",
    "3 tablespoons white sugar",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Stir chocolate, instant coffee, and salt together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat cream, sugar, and vanilla in a saucepan over medium heat, stirring constantly, until it just begins to simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour hot cream mixture over chocolate mixture; let sit for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk chocolate and cream mixture for 1 to 2 minutes, until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into four small espresso cups. Tap to remove any air bubbles. Chill thoroughly in the refrigerator for at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve topped with grated chocolate, or add lightly whipped cream and dust with cocoa powder.",
      "section": null,
      "name": null,
      "url": null,
