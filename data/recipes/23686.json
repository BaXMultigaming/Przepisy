  "ingredients": [
    "1 (11 ounce) can whole kernel corn, drained",
    "1 (11 ounce) can cream-style corn",
    "1 (8.5 ounce) package dry corn bread mix",
    "1 (8 ounce) container sour cream",
    "1 cup shredded Cheddar cheese, divided",
    "1 small onion, diced",
    "1 large egg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine whole kernel corn, cream-style corn, cornbread mix, sour cream, 3/4 cup Cheddar cheese, onion, and egg in a large bowl. Stir until well blended, then pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes. Sprinkle with remaining 1/4 cup Cheddar cheese. Continue baking until cheese is melted, about 10 to 15 minutes. Let casserole stand briefly before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
