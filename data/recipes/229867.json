  "title": "Honey-Glazed Ham",
  "description": "Butter, red wine, honey, brown sugar, and black pepper make a glaze for your ham in this recipe for a holiday favorite.",
  "authors": [
    "Chefbendiaz"
  ],
  "date_published": "2020-03-05T00:09:46-05:00",
