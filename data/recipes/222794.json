  "ingredients": [
    "1 teaspoon olive oil",
    "1 (4 ounce) can sliced mushrooms",
    "0.5 cup diced red onion",
    "1 clove garlic, minced",
    "1.5 tablespoons balsamic vinegar",
    "1.5 tablespoons Worcestershire sauce",
    "salt and ground black pepper to taste",
    "0.5 teaspoon white sugar"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a saucepan over medium heat; add mushrooms, onion, garlic, balsamic vinegar, Worcestershire sauce, salt, and black pepper. Bring mixture to a simmer and cook until liquid is 2/3 reduced, about 10 minutes; sprinkle with sugar. Cook and stir until sugar is dissolved, 1 to 3 minutes.",
