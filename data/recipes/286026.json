  "keywords": [],
  "ingredients": [
    "butter for greasing",
    "1.75 cups diced pears",
    "3 tablespoons pomegranate seeds",
    "2 tablespoons white sugar",
    "1 tablespoon all-purpose flour",
    "0.25 teaspoon ground cinnamon",
    "0.125 teaspoon ground nutmeg",
    "0.125 teaspoon salt",
    "4 teaspoons unsalted butter",
    "1 tablespoon honey",
    "1 teaspoon unsalted butter",
    "4 tablespoons quick cooking oats",
    "2 tablespoons chopped almonds",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly coat the inside of 4 oven-safe ramekins with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine diced pears, pomegranate seeds, sugar, flour, cinnamon, nutmeg, and salt in a bowl and lightly toss together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Evenly divide pear mixture among the 4 prepared ramekins and dot each with 1 teaspoon unsalted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine honey and butter for topping in a microwave-safe bowl and microwave on high power until butter melts, about 10 seconds. If butter is not fully melted, add about 5 more seconds. Avoid overheating, as this may cause the butter to splatter the inside of the microwave.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in oats, almonds, and a pinch of salt. Evenly divide oat mixture amongst the 4 ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set ramekins inside the air fryer basket and air-fry until the topping is browned, 10 to 13 minutes. Cool for about 5 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
