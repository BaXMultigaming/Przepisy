  "ingredients": [
    "2 tablespoons butter",
    "2 ribs celery, diced",
    "0.5 onion, diced",
    "3 cloves garlic, sliced",
    "1 pound dried split peas, rinsed",
    "1 pound ham, diced",
    "1 bay leaf",
    "1 quart chicken stock",
    "2.5 cups water",
    "salt and ground black pepper to taste"
  ],
  "steps": [
