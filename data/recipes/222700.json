  "ingredients": [
    "1.5 cups dry black garbanzo beans (kala channa)",
    "3 cups water",
    "2 tomatoes, finely chopped",
    "1 onion, finely chopped",
    "4 dried red chile peppers",
    "1 jalapeno pepper, finely chopped",
    "3 tablespoons vegetable oil",
    "1 teaspoon salt",
    "0.5 teaspoon ground turmeric",
    "0.5 teaspoon ground red chile pepper",
    "2 tablespoons chopped fresh cilantro",
    "1 tablespoon finely chopped onion"
  ],
  "steps": [
    {
      "text": "Place garbanzo beans into a large bowl. Pour enough water over beans to cover by several inches. Soak for 8 hours to overnight. Rinse and drain garbanzo beans thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine garbanzo beans, 3 cups water, tomatoes, 1 finely chopped onion, dried red chile peppers, jalapeño pepper, oil, salt, turmeric, and ground red chile pepper in a large pot over medium-high heat; bring to a boil, reduce heat to medium-low, and cook until garbanzo beans are tender, 3 to 4 hours. Add water as needed to keep about 1 inch of liquid at the bottom of the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with cilantro and 1 tablespoon finely chopped onion to serve.",
