  "ingredients": [
    "2 tablespoons rice vinegar",
    "2 tablespoons ketchup",
    "2 tablespoons peanut butter",
    "1 teaspoon low-sodium soy sauce",
    "1 teaspoon sesame oil",
    "1 clove garlic, minced",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon cayenne pepper, or to taste",
    "fresh ground black pepper",
    "1 (16 ounce) package extra-firm tofu, cut into 1/2-inch cubes"
  ],
  "steps": [
    {
      "text": "Mix vinegar, ketchup, peanut butter, soy sauce, sesame oil, garlic, ground ginger, cayenne pepper, and black pepper together in a small, microwave-safe bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vinegar mixture in microwave oven until the peanut butter is softened, 10 to 15 seconds; stir mixture until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put tofu into a large bowl. Pour sauce over the tofu and stir to coat. Cover bowl with plastic wrap and refrigerate at least 30 minutes to a full day, stirring occasionally to assure tofu remains coated in sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread tofu onto a baking sheet in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until slightly browned, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
