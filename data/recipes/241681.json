  "ingredients": [
    "1 cup white sugar",
    "1 cup mayonnaise",
    "3 tablespoons yellow mustard",
    "2 teaspoons water, or as needed",
    "3 heads romaine lettuce, chopped",
    "4 hard-boiled eggs, peeled and sliced",
    "1 pinch paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Whisk sugar, mayonnaise, and mustard together in a bowl until smooth. Add water, 1 teaspoon at a time, if dressing is too thick. Refrigerate dressing until chilled, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place romaine lettuce in a bowl; add dressing and toss to coat. Arrange eggs around the lettuce and season with paprika.",
