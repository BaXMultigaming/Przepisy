  "ingredients": [
    "9 graham crackers, crushed",
    "0.75 cup salted peanuts, finely chopped",
    "0.25 cup white sugar",
    "0.25 cup butter, melted",
    "1 quart vanilla ice cream, softened",
    "0.5 cup crunchy peanut butter",
    "0.25 cup chopped salted peanuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together graham crackers, 3/4 cup peanuts, and sugar in a medium bowl. Stir in melted butter until mixture resembles wet sand, then press into a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake crust in the preheated oven until lightly browned, about 8 minutes. Place in the freezer to chill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together ice cream and peanut butter in a large bowl on medium-low speed until combined. Pour into chilled crust. Sprinkle with 1/4 cup peanuts. Place in the freezer until filling is firm, at least 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pie from the freezer 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
