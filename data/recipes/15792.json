  "title": "Peanut Butter Ice Cream Pie",
  "description": "This peanut butter ice cream pie features a peanut and graham cracker crust filled with a yummy combination of vanilla ice cream blended with chunky peanut butter.",
  "authors": [
    "Carolyn"
  ],
  "date_published": "1999-11-17T10:32:52-05:00",
