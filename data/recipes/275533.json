  "ingredients": [
    "3 cups white cornmeal",
    "4 cups boiling water",
    "1.25 cups white sugar",
    "1 teaspoon salt",
    "2 cups milk",
    "3 eggs",
    "0.5 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Butter a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cornmeal in a large bowl. Pour in boiling water, stirring until blended. Add sugar and salt; blend using an electric mixer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk and eggs together; stir into the cornmeal mixture. Add melted butter and blend well. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is slightly browned, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
