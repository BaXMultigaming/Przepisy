  "ingredients": [
    "1 head cauliflower, broken into small florets",
    "4 cups oil for deep frying",
    "1 large egg",
    "2 teaspoons milk",
    "1 cup cracker crumbs"
  ],
  "steps": [
    {
      "text": "Bring a pan of lightly salted water to a boil. Place cauliflower in boiling water and cook until tender, 5 to 8 minutes. Remove from heat, drain, and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer to 365 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together egg and milk in a small bowl. Place cracker crumbs in a shallow dish. Dip cauliflower in the egg mixture then roll in cracker crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry coated cauliflower in the hot oil until golden brown. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
