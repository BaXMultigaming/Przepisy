  "ingredients": [
    "1 cup white sugar",
    "0.5 cup shortening",
    "0.5 teaspoon salt",
    "2 eggs",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground cloves",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts",
    "2 cups sifted all-purpose flour",
    "1 (10.75 ounce) can condensed tomato soup",
    "1 teaspoon baking soda",
    "1 (8 ounce) package cream cheese",
    "2 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease and flour a 9 x 13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream sugar and shortening. Add beaten eggs, and mix well. Stir in salt, cinnamon, nutmeg, and cloves. Mix in flour and baking powder, and then raisins and nuts. Mix tomato soup and baking soda together; beat into first mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 to 35 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and confectioners sugar together until smooth. Frost the cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
