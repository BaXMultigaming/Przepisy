  "ingredients": [
    "0.5 cup butter, melted",
    "1 (16 ounce) package frozen peach slices",
    "0.66666668653488 cup white sugar",
    "0.5 cup water",
    "1 cup all-purpose flour",
    "1 cup white sugar",
