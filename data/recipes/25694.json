  "ingredients": [
    "2 tablespoons butter",
    "1 large onion, chopped",
    "4 cloves garlic, minced",
    "2 large potatoes, peeled and cubed",
    "2 medium carrots, chopped",
    "2 (14.5 ounce) cans chicken broth",
    "1 head cauliflower, chopped",
    "1 cup milk",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.125 teaspoon ground nutmeg",
    "1 tablespoon dry sherry",
    "1 tablespoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bewRdefNLWJ8GCY5aw4MCx49DUQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25694-Cream-of-Cauliflower-Soup-II-ddmfs-step-0-029-6e84309925634b858b47886f499120b7.jpg"
      ],
      "image": "assets/images/25694/step_01.webp"
    },
    {
      "text": "Melt butter in a large pot over medium heat. Add onion and garlic; cook and stir until onion is translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q5EwKtNjd2e2dPGkMjDhW2t4Z7o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25694-Cream-of-Cauliflower-Soup-II-ddmfs-step-1-032-e37089a3abbb432c885a98d359a7b2c2.jpg"
      ],
      "image": "assets/images/25694/step_02.webp"
    },
    {
      "text": "Add potatoes and carrots; cook and stir until beginning to soften, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TysfPi3eSTeuyExnPqZRtcv4ykE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25694-Cream-of-Cauliflower-Soup-II-ddmfs-step-2-033-d2ab8498e972407f977e8a7b627f7082.jpg"
      ],
      "image": "assets/images/25694/step_03.webp"
    },
    {
      "text": "Pour in broth and bring to a boil. Stir in cauliflower, then cover, reduce the heat, and simmer until vegetables are tender, 10 to 20 minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OepYnXQepEodO2xRJaOosgh76lU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25694-Cream-of-Cauliflower-Soup-II-ddmfs-step-3-056-930a8a927a1c4df28570dd7218b901f8.jpg"
      ],
      "image": "assets/images/25694/step_04.webp"
    },
    {
      "text": "Purée soup with an immersion blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jH_92oJ-tF15p4I11bWkYjmmDG4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25694-Cream-of-Cauliflower-Soup-II-ddmfs-step-4-059-cbd546f4c0964bc8a6b2a1601fd5a54e.jpg"
      ],
      "image": "assets/images/25694/step_05.webp"
    },
    {
      "text": "Return to the stove and stir in milk, salt, pepper, nutmeg, and sherry over low heat. Cook until heated through, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WB7jGBLowsUGO86jOm0-4P_OLHQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25694-Cream-of-Cauliflower-Soup-II-ddmfs-step-5-061-4b3d4beb9d674792a107f75d3df5c570.jpg"
      ],
      "image": "assets/images/25694/step_06.webp"
    },
    {
      "text": "Garnish with parsley and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wPGpkQY0q3kvAkQRz8-1fIaRkcw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25694-Cream-of-Cauliflower-Soup-II-ddmfs-step-6-070-97f163eccad644d083d9dd37dbcf2adf.jpg"
