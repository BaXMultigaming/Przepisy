  "title": "Fraser Shortbread",
  "description": "This is a Scottish Shortbread that I have created by trial and error. It is a favorite of my family and friends.",
  "authors": [
    "Margaret Fraser"
  ],
  "date_published": "1998-01-01T22:12:18-05:00",
