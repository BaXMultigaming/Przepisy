  "ingredients": [
    "4 tablespoons butter",
    "0.75 cup all-purpose flour",
    "0.75 cup sugar",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.75 cup milk",
    "2 cups of sliced fresh peaches or nectarines, or whole blueberries, strawberries, raspberries, blackberries or a combination of fruits (or a 12-ounce package of frozen berries)",
    "1 tablespoon sugar"
  ],
  "steps": [
    {
      "text": "Position the rack in the upper-middle of the oven. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put butter in an 8-inch square or 9-inch round pan; melt in the oven. Remove from the oven and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/54MVL8S6GRhQpFijj5IHU5tOUZ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88354-easy-batter-fruit-cobbler-ddmfs-Step1-4x3-cda9979e34e84c8591efb2651af5ddb1.jpg"
      ],
      "image": "assets/images/88354/step_02.webp"
    },
    {
      "text": "Whisk flour, 3/4 cup sugar, baking powder, and salt in a medium bowl. Whisk in milk until a smooth batter forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xbgOG9vS9Ie6G9wBeBhu8Ks-efI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88354-easy-batter-fruit-cobbler-ddmfs-Step3-4x3-1f18989f55044ca4b4b5c5c5647b9e6f.jpg"
      ],
      "image": "assets/images/88354/step_03.webp"
    },
    {
      "text": "Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tIVEG1YIpI7ZEtI934Q_aStqtuQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88354-easy-batter-fruit-cobbler-ddmfs-Step4-4x3-1e6e65bf5a5d4fa88ed872ef94794fa8.jpg"
      ],
      "image": "assets/images/88354/step_04.webp"
    },
    {
      "text": "Scatter fruit over batter. Sprinkle with 1 tablespoon sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mTDW8etj5bejyxxdpqFlyBsdJp4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88354-easy-batter-fruit-cobbler-ddmfs-Step7-4x3-382aa4fc732b4c17ac5d58864ab7c16a.jpg"
      ],
      "image": "assets/images/88354/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until top is light brown, and fruit bubbles, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ekAhSULDsnIIyL2dy2kXr6yvfOw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88354-easy-batter-fruit-cobbler-ddmfs-Step9-4x3-ca338c0517f9493ba925bda6a15e2b42.jpg"
