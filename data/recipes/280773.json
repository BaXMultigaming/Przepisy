  "ingredients": [
    "1 cup hulled and sliced strawberries",
    "1 tablespoon brandy-based orange liqueur (such as Grand Marnier®)",
    "0.5 teaspoon white sugar",
    "1 (16 ounce) package prepared polenta",
    "1 tablespoon olive oil, or as needed",
    "1 pinch salt and freshly ground black pepper to taste",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Combine strawberries, orange-flavored liqueur, and sugar in a small bowl: stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut polenta into 8 slices (½- to ¾-inch-thick). Lightly brush with olive oil; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly coat the grate with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook polenta slices on the preheated grill, 7 to 10 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 2 polenta slices each onto 4 plates; top each with ¼ strawberry mixture.",
