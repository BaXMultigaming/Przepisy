  "ingredients": [
    "0.5 cup milk",
    "1 egg",
    "1 teaspoon white sugar",
    "0.5 teaspoon ground cinnamon",
    "1 pinch salt",
    "2 tablespoons butter",
    "6 thick slices chocolate babka, about 3/4-inch thick",
    "1 tablespoon confectioners' sugar"
  ],
  "steps": [
    {
      "text": "In a shallow bowl, whisk together milk, egg, sugar, cinnamon, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each slice of babka into egg mixture, turning to coat each side. Place dipped babka slices into the hot skillet and cook until mixture begins to set and slices begin to brown, 3 to 4 minutes. Turn slices and cook on the other side until brown, 3 to 4 minutes, watching carefully to prevent burning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a serving plate and dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
