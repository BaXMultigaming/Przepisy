  "ingredients": [
    "4 cups chopped carrots",
    "3 cups fat-free chicken broth",
    "0.5 onion, sliced",
    "water to cover",
    "4 cloves garlic, smashed",
    "1 teaspoon dried thyme",
    "0.5 teaspoon dried tarragon",
    "2 tablespoons heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Combine carrots, chicken broth, and onion in a large pot. Pour enough water into the pot to assure the ingredients are covered; add garlic, thyme, and tarragon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring the liquid to a boil, reduce heat to medium-low, place a cover on the pot, and simmer the mixture until the carrots are very tender, 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pot from heat; carefully puree soup with an immersion blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return pot to medium heat and cook until warmed through, about 5 minutes. Stir cream through the soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
