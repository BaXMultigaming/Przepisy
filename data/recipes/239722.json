  "ingredients": [
    "1 tablespoon olive oil",
    "2 cloves garlic, minced",
    "2 teaspoons lemon juice",
    "salt and ground black pepper to taste",
    "2 cups chicken broth",
    "1 cup farro",
    "2 cups chopped kale",
    "0.5 cup crumbled reduced-fat feta cheese"
  ],
  "steps": [
    {
      "text": "Whisk olive oil, garlic, lemon juice, salt, and black pepper together in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chicken broth and farro in a large skillet or wok; bring to a boil. Reduce heat to medium; simmer until farro is tender and broth is absorbed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir olive oil mixture into farro until coated. Add kale; cook and stir until wilted, 2 to 3 minutes. Sprinkle feta cheese on salad; stir to combine. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
