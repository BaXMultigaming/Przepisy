  "ingredients": [
    "3 eggs",
    "2 cups shredded zucchini",
    "1.6666667461395 cups white sugar",
    "0.75 cup vegetable oil",
    "2 teaspoons lemon extract",
    "2 teaspoons poppy seeds",
    "3 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl. Add zucchini, sugar, oil, lemon extract, and poppy seeds. Stir to combine. Add flour, baking powder, baking soda, cinnamon, and salt. Mix thoroughly. Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of loaves comes out clean, about 1 hour.",
