  "ingredients": [
    "1.5 cups ricotta cheese",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.5 cup white sugar",
    "1.5 cups milk",
    "2 tablespoons cornstarch",
    "1 (9 inch) unbaked pie crust",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve cornstarch in 1/2 cup milk in a large bowl; stir in ricotta, remaining 1 cup milk, eggs, vanilla, and sugar until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour filling into unbaked pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, about 1 hour. Sprinkle top with cinnamon; cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
