  "ingredients": [
    "2 pounds rib tips",
    "1 teaspoon kosher salt",
    "1 tablespoon BBQ rub",
    "0.25 cup apple juice",
    "1 cup barbeque sauce"
  ],
  "steps": [
    {
      "text": "Preheat an electric smoker to 250 degrees F (120 degrees C) according to the manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season rib tips with salt, then massage with barbecue rub until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place rib tips on the preheated smoker; smoke 1 ½ hours, spritzing with apple juice throughout.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer rib tips to a baking sheet; toss with barbecue sauce to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return rib tips to the smoker; smoke 30 minutes more. Transfer to a serving plate; rest 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
