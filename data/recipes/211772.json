  "ingredients": [
    "10 large apples, quartered",
    "water, to cover",
    "0.75 cup white sugar",
    "1 tablespoon ground cinnamon",
    "1 tablespoon ground allspice"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eKAEv_aoMCXCM6cW5Sa4hCcOduU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/211772-homemade-apple-cider-ddmfs-0643-4x3-step01-b683a6c66a6a409e9bff664d5bf2fd30.jpg"
      ],
      "image": "assets/images/211772/step_01.webp"
    },
    {
      "text": "Place apples in a large stockpot; cover with water by at least 2 inches. Stir in sugar, cinnamon, and allspice. Bring to a boil over medium-high heat. Boil, uncovered, for 1 hour. Reduce heat to low; cover and simmer for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9IFaUiOnqf9rihZIE1feJ0FjvEw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/211772-homemade-apple-cider-ddmfs-0647-4x3-step02-a2a3675570064fcdb315c605dc5f4097.jpg"
      ],
      "image": "assets/images/211772/step_02.webp"
    },
    {
      "text": "Strain apple mixture through a fine-mesh sieve; discard solids. Drain cider again through a cheesecloth-lined sieve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VHJJanVUaBOHMwb9QvI-2w9ZhE4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/211772-homemade-apple-cider-ddmfs-0676-4x3-step03-b5be60fdbd284c6cba5f340d6ed30232.jpg"
      ],
      "image": "assets/images/211772/step_03.webp"
    },
    {
      "text": "Serve warm or refrigerate cider until cold.",
      "section": null,
      "name": null,
      "url": null,
