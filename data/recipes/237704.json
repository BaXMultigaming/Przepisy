  "ingredients": [
    "2 cups gluten-free rolled oats",
    "1 cup mashed banana",
    "0.66666668653488 cup vanilla protein powder (such as Muscletech Whey Protein Plus®)",
    "0.5 cup peanut butter, slightly melted",
    "0.5 cup sweetened dried cranberries (such as Craisins®)",
    "0.5 cup unsweetened flaked coconut",
    "0.5 cup chopped raw almonds",
    "0.25 cup brewed sweet and spicy black tea (such as Good Earth® Sweet&Spicy®",
    "2 tablespoons chia seeds",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon vanilla extract",
    "0.25 cup coconut, or to taste"
