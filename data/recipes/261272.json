  "ingredients": [
    "2 teaspoons vegetable oil, or as needed",
    "1 pound unpeeled russet potatoes, scrubbed",
    "3 cups sour cream",
    "2 cups shredded Monterey Jack cheese",
    "2 cups shredded Cheddar cheese",
    "1 pound cooked bacon, crumbled",
    "5 green onions, chopped",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prick potatoes with a fork. Place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are easily pierced with a fork, 45 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce oven temperature to 375 degrees F (190 degrees C). Remove potatoes from the oven and let cool completely, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut potatoes into 1-inch cubes. Combine sour cream, Monterey Jack cheese, Cheddar cheese, bacon, green onions, salt, and pepper in a large bowl. Add potatoes. Spoon mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
