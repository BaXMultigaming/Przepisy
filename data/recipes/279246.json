  "ingredients": [
    "2 tablespoons butter",
    "1 teaspoon minced garlic",
    "1 cup all-purpose flour",
    "2 large eggs",
    "1 cup Italian-seasoned dry bread crumbs",
    "3 tablespoons grated Parmesan cheese",
    "4 tilapia fillets"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter and garlic into an 8x8-inch microwave-safe baking pan and microwave until butter is melted, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour in a bowl. Beat eggs together in another bowl. Mix bread crumbs and Parmesan cheese together in a third bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip fillets in flour until lightly coated, then into beaten eggs, then into bread crumb mixture. Lay in the baking dish with the garlic-butter mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish is golden and easily flakes with a fork, about 25 minutes, flipping halfway through cooking time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
