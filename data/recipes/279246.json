  "title": "Breaded Parmesan Tilapia",
  "description": "These quick and easy tilapia fillets are baked in garlic butter and coated with Italian-seasoned bread crumbs and Parmesan cheese for tons of flavor.",
  "authors": [
    "Kevin Leebrick"
  ],
  "date_published": "2005-09-13T18:06:00-04:00",
