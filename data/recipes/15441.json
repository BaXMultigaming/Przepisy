  "ingredients": [
    "0.5 cup butter",
    "1 cup self-rising flour",
    "1 cup white sugar",
    "1 cup milk",
    "1 (16 ounce) can sliced peaches in heavy syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in an 8X8 glass baking dish. Place dish in oven until butter is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine flour and sugar. Mix well, then stir in milk. Spoon mixture into baking dish, on top of melted butter. Pour peaches over flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cobbler in the preheated oven until peaches are bubbly and crust is lightly browned, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
