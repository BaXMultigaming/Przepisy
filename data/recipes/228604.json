  "ingredients": [
    "0.75 cup sake",
    "0.25 cup white sugar",
    "1 cup soy sauce",
    "0.33333334326744 cup white sugar",
    "2 tablespoons orange marmalade",
    "5 teaspoons rice vinegar",
    "1 tablespoon garlic powder",
    "2 teaspoons sesame oil",
    "1 teaspoon ground ginger",
    "0.25 teaspoon ground cayenne pepper",
    "0.25 teaspoon black pepper",
    "0.33333334326744 cup cold water",
    "2 tablespoons cornstarch"
  ],
  "steps": [
    {
      "text": "Stir sake and 1/4 cup white sugar together in a saucepan over medium heat; cook until sugar dissolves, about 5 minutes. Add soy sauce, 1/3 cup white sugar, orange marmalade, vinegar, garlic powder, sesame oil, ginger, cayenne pepper, and black pepper; stir to combine. Bring to a boil, reduce heat, and simmer until slightly reduced, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cold water and cornstarch together in a small bowl until cornstarch is dissolved. Slowly stir cornstarch mixture into teriyaki sauce, 1 to 2 tablespoons at a time, until sauce is thickened. Remove from heat and cool.",
      "section": null,
      "name": null,
      "url": null,
