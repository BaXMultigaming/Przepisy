  "ingredients": [
    "3 pounds bone-in chicken pieces",
    "3 tablespoons fresh lemon juice",
    "1 tablespoon meat tenderizer",
    "2 cups plain yogurt, divided",
    "3 tablespoons ground cumin",
    "2 tablespoons ground coriander",
    "0.33333334326744 cup chopped fresh cilantro",
    "2 teaspoons paprika",
    "0.5 teaspoon ground turmeric",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper",
    "6 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Make shallow crosswise slits in the meat of the chicken parts to help absorb more flavor. Mix together the lemon juice and meat tenderizer; rub into the chicken meat. Place chicken into a shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1/2 cup yogurt, cumin, coriander, cilantro, paprika, turmeric, salt, pepper, and garlic into a blender or food processor, and blend until smooth. Transfer to a bowl, and stir in remaining 1 1/2 cups of yogurt. Pour over the chicken parts, cover, and marinate in the refrigerator for at least 8 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat grill for medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil the grill grate. Remove chicken from the marinade, and discard any remaining marinade. Grill chicken 30 to 45 minutes, turning frequently to prevent burning, until juices run clear. Smaller pieces will finish cooking first.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
