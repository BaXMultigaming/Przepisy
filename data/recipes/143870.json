  "ingredients": [
    "1.5 pounds beef round steak",
    "0.5 cup fresh lime juice",
    "0.25 cup tequila",
    "0.5 cup cooking oil",
    "2 tablespoons liquid smoke",
    "1 teaspoon Worcestershire sauce",
    "0.25 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "0.75 teaspoon paprika",
    "0.75 cup bell peppers, sliced into thin strips",
    "0.5 cup sliced onions"
  ],
  "steps": [
    {
      "text": "Combine steak, lime juice, and tequila in a plastic bag; marinate in the refrigerator for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to cook, preheat an outdoor grill for high heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove steak from marinade and shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill steak on the preheated grill until no longer pink on the inside, about 8 minutes per side. Remove from the grill and slice into 1/4-inch strips. Arrange strips on a serving plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat. Add liquid smoke, Worcestershire sauce, paprika, salt, and pepper; stir to combine. When the mixture is hot, add bell peppers and onions; cook until peppers are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour pepper and onion mixture over steak strips and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
