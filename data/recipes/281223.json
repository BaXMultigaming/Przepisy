  "ingredients": [
    "1.75 cups white sugar",
    "1.75 cups water",
    "2 cups fresh lemon juice",
    "0.5 cup fresh basil sprigs",
    "1 tablespoon lemon zest",
    "8 slices lemon",
    "1 sprig fresh basil"
  ],
  "steps": [
    {
      "text": "Combine sugar and water in a medium saucepan over medium-high heat and bring to a boil, 3 to 5 minutes. Boil for 1 minute, stirring occasionally. Add lemon juice, basil sprigs, and lemon zest. Remove from heat and allow to cool for about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into a 9x13-inch metal baking pan or two 8-inch metal cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in the freezer for about 30 minutes. Remove basil leaves and stir. Freeze for 6 to 8 hours, stirring sorbet with a fork about once per hour until all the liquid is frozen.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop sorbet into individual serving dishes and garnish with lemon slices and fresh basil leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
