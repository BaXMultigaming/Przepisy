  "ingredients": [
    "2 medium potatoes, peeled and cubed",
    "4 stalks celery, diced",
    "1 small onion, diced",
    "6 cups water",
    "2 tablespoons beef base (such as Better than Bouillon®)",
    "0.5 pound cubed cooked beef",
    "1 (16 ounce) package frozen peas and carrots",
    "0.5 teaspoon parsley flakes",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried basil"
  ],
  "steps": [
    {
      "text": "Combine potatoes, celery, and onion in a pot. Mix water with beef base and pour on top of vegetables. Bring to a boil over medium-high heat. Add beef and frozen peas and carrots.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce the heat and season with parsley, oregano, and basil. Cover and simmer until vegetables are tender, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
