  "ingredients": [
    "1 cup shortening",
    "1 cup creamy peanut butter",
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "0.5 cup buttermilk",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1.5 teaspoons baking soda",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the shortening, peanut butter, white sugar, brown sugar and buttermilk until smooth and fully combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the flour, baking powder, baking soda and salt to the peanut butter mixture and mix until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop cookies 2 inches apart on lightly greased cookie sheet. Flatten with a fork that has been dipped in flour. Bake at 375 degrees F (190 degrees C) for 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
