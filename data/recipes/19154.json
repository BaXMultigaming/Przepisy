  "ingredients": [
    "cooking spray",
    "1 tablespoon vegetable oil",
    "0.5 cup unpopped popcorn",
    "6 tablespoons butter",
    "5 cups miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Grease a 9x13-inch baking dish with cooking spray; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hXIXIvx68IyRSoJR8O6lz6QffJU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19154-marshmallow-popcorn-balls-VAT-step-01-575b53ab2ff44fdfbe2f0fc315169831.jpg"
      ],
      "image": "assets/images/19154/step_01.webp"
    },
    {
      "text": "Heat oil in a 4-quart saucepan over high heat. Add popcorn kernels to hot oil. Cover the pan and cook until popping ceases, shaking the pot occasionally. Remove from heat and pour popcorn into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-nmdCuzOkRxQYTAND0Qo6uiGqck=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19154-marshmallow-popcorn-balls-VAT-step-02-cbcff0a07b444fa3bc5643863207171c.jpg"
      ],
      "image": "assets/images/19154/step_02.webp"
    },
    {
      "text": "Melt butter in a medium saucepan over low heat. Cook and stir marshmallows in hot butter until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v2H-Cf8AFyRqomFPzd59wuDDtfE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19154-marshmallow-popcorn-balls-VAT-step-03-1d5df5e35929479ab4d100f277a31ccb.jpg"
      ],
      "image": "assets/images/19154/step_03.webp"
    },
    {
      "text": "Pour marshmallow mixture over popcorn, then use a spoon to mix thoroughly until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/256AHVFJB0BXUH--z0UulxH1o-Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19154-marshmallow-popcorn-balls-VAT-step-04-40445ccd56ba4eadb427716985c2dfb3.jpg"
      ],
      "image": "assets/images/19154/step_04.webp"
    },
    {
      "text": "Allow mixture to cool enough to handle. Spray your hands with cooking spray. Shape popcorn with your hands into 8 equal balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PC3SR1H0XF00VSxyD22grgfWAbE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19154-marshmallow-popcorn-balls-VAT-step-05-0228c58780ed409c9dcebe6c8e4c2979.jpg"
      ],
      "image": "assets/images/19154/step_05.webp"
    }
  ],
