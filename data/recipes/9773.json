  "ingredients": [
    "4 cups all-purpose flour",
    "2 teaspoons baking soda",
    "0.5 teaspoon salt",
    "1 cup butter, softened",
    "1 cup packed brown sugar",
    "1 cup real maple syrup",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.33333334326744 cup granulated sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, and salt into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and brown sugar in a large bowl with an electric mixer. Mix in maple syrup, egg, and vanilla until well blended. Mix in flour mixture until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 1-inch balls. Fill two cookie sheets with balls, 2 inches apart. Flatten slightly with the bottom of a glass. Sprinkle each cookie with some of the remaining sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 8 to 10 minutes. Transfer to wire racks to cool. Repeat to bake remaining cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
