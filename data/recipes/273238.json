  "ingredients": [
    "1 (16 ounce) can refried beans",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon ground cumin",
    "1 (10 ounce) bag scoop-shaped tortilla chips",
    "8 ounces Colby-Monterey Jack cheese, thinly sliced",
    "1 (4 ounce) can sliced jalapeno peppers"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine refried beans, garlic powder, onion powder, and cumin in a bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour tortilla chips onto a baking sheet in one layer. Spoon bean mixture over tortilla chips. Top with Colby-Monterey Jack cheese and jalapeños.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, about 5 minutes.",
