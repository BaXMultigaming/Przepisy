  "ingredients": [
    "8 large Granny Smith apples, cored and sliced",
    "0.5 cup white sugar",
    "2.5 tablespoons all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 cup butter, melted",
    "1.5 teaspoons ground nutmeg",
    "2 cups miniature marshmallows",
    "1 cup firmly packed brown sugar",
    "1 cup quick cooking oats",
    "1 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine apple slices, white sugar, 2 ½ tablespoons flour, and 1 teaspoon cinnamon in a bowl; spread into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine melted butter, 2 teaspoons cinnamon, and nutmeg in a bowl; stir in marshmallows, brown sugar, oats, and 1 cup flour until thoroughly combined. Spread over apples; gently flatten topping to a smooth layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apples are tender and topping is golden brown, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
