  "ingredients": [
    "1 cup butter",
    "0.33300000429153 cup white sugar",
    "2 teaspoons water",
    "2 teaspoons vanilla extract",
    "2 cups sifted all-purpose flour",
    "1 cup chopped pecans",
    "3 tablespoons confectioners' sugar"
  ],
  "steps": [
    {
      "text": "In a medium bowl, cream together the butter and sugar until smooth. Beat in the water and vanilla. Stir in the flour and pecans until well blended. Cover dough and chill for at least four hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Shape dough into walnut sized balls or crescents. Place 2 inches apart onto unprepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 18 to 20 minutes in the preheated oven, until golden. Roll in confectioners’ sugar while still warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
