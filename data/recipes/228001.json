  "ingredients": [
    "2 (1-inch x 1/2-inch) strips lemon zest",
    "2 (1-inch x 1/2-inch) strips orange zest",
    "1 packet Sweet'N Low granulated sugar substitute",
    "0.5 ounce unsweetened pomegranate juice",
    "1.5 ounces vodka",
    "1 slice lime, for garnish"
  ],
  "steps": [
    {
      "text": "Muddle lemon and orange zest with sugar substitute in a cocktail shaker. Add pomegranate juice and vodka. Fill the shaker halfway with ice and shake vigorously. Strain into a chilled stemmed glass. Garnish with lime slice.",
