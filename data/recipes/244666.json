  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "1 cup oats",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "3 cups grated carrots",
    "1 cup sweetened dried cranberries (such as Craisins®)",
    "1 cup dark brown sugar",
    "1 cup light brown sugar",
    "2 eggs",
    "0.5 cup butter, softened",
    "0.5 cup corn oil",
    "1 tablespoon maple syrup",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, oats, baking powder, baking soda, and ground cinnamon together in a bowl; stir in carrots and dried cranberries. Add dark brown sugar, light brown sugar, eggs, butter, oil, maple syrup, vanilla extract, and salt to the carrot mixture and stir until dough is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoonfuls of dough about 2 inches apart onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until edges are brown, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
