  "ingredients": [
    "1 teaspoon unflavored gelatin",
    "1 tablespoon cool water",
    "1.5 cups heavy whipping cream",
    "0.5 cup whole milk",
    "0.33333334326744 cup white sugar",
    "2 teaspoons grated lemon zest",
    "0.5 vanilla bean, split lengthwise",
    "6 tablespoons strawberry jam"
  ],
  "steps": [
    {
      "text": "Sprinkle gelatin over water; let stand until dissolved, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place heavy cream, milk, sugar, lemon zest, and vanilla bean in a saucepan over medium heat; cook, stirring constantly, until mixture is simmering. Simmer gently, about 5 minutes. Remove from heat and discard vanilla bean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir gelatin mixture into the hot cream mixture until dissolved. Stir in strawberry jam. Pour into small dessert cups, cover with plastic wrap, and refrigerate until set, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
