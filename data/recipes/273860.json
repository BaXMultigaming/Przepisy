  "ingredients": [
    "2 cups buttermilk",
    "2 cups Buffalo wing sauce (such as Frank's®)",
    "2 tablespoons Dijon mustard",
    "1 clove garlic, minced",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "4 skinless, boneless chicken breast halves",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Whisk buttermilk, Buffalo sauce, mustard, garlic, salt, and pepper together in a shallow bowl. Add chicken. Cover and marinate in the refrigerator for 12 to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour chicken and marinade into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until juices run clear, about 40 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
