  "ingredients": [
    "4 (6 ounce) fillets salmon",
    "2 tablespoons olive oil",
    "2 tablespoons capers",
    "0.125 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "4 slices lemon"
  ],
  "steps": [
    {
      "text": "Preheat a large heavy skillet over medium heat for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat salmon fillets with olive oil; place skin-side down in the preheated skillet and increase heat to high.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tZv5AgAQgUfFHeb9W_ZR7f1xYkc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21736-PanSearedSalmon-ddmfs-Step2-0344-5b95a169d9d746f7bff404abd9b67d18.jpg"
      ],
      "image": "assets/images/21736/step_02.webp"
    },
    {
      "text": "Sprinkle with capers, salt, and pepper; cook for 3 minutes on one side. Turn salmon fillets over; continue to cook until salmon flakes easily with a fork, about 5 minutes.",
