  "ingredients": [
    "2 pounds salted cod fish",
    "2 lemons, juiced",
    "salt to taste",
    "1 pound potatoes, cut into thick slices",
    "2 large onions, cut into 8 wedges",
    "3 tomatoes, cut into 8 wedges",
    "2 fresh bay leaves",
    "2 tablespoons olive oil",
    "0.25 cup chopped black olives",
    "2 tablespoons chopped parsley, or to taste"
  ],
  "steps": [
    {
      "text": "Soak cod in a large bowl of water in the refrigerator for 24 hours, changing soaking water 4 times to remove excess salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain water off cod; add lemon juice and salt. Let marinate in the refrigerator, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange layers of cod, potatoes, onions, and tomatoes in a large baking dish. Place bay leaves on top. Drizzle olive oil over baking dish and season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are tender and cod flakes easily with a fork, about 30 minutes. Add olives and parsley and continue baking until heated through, about 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
