  "ingredients": [
    "1 large cooking apple - peeled, cored and cubed",
    "2 tablespoons water",
    "1 tablespoon white sugar",
    "2 pork chops",
    "2 ounces Cheddar cheese, shredded"
  ],
  "steps": [
    {
      "text": "Preheat a grill to medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put apple in a pan with water and sugar. Cover and cook on low heat, stirring occasionally, for 10 to 20 minutes until cooked and pulpy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork chops under a preheated grill and cook for 5 to 10 minutes on each side. Cover each pork chop with some of the apple sauce mixture then with cheese. Return to grill and cook until cheese melts and is bubbling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
