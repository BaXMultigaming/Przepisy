  "ingredients": [
    "1 cup all-purpose flour",
    "0.25 cup shortening",
    "0.25 teaspoon salt",
    "0.75 cup white sugar",
    "0.25 teaspoon salt",
    "2 tablespoons all-purpose flour",
    "2 eggs",
    "2 teaspoons bourbon",
    "2 cups flaked coconut",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 9 inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make crust: In medium mixing bowl, combine flour and salt. Add in shortening until mixture resembles coarse crumbs. Press dough into baking pan and bake for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the filling: In large mixing bowl, beat sugar, eggs and bourbon. Slowly add in flour and salt, mixing well. Fold in coconut and pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread filling over hot crust. Bake 12 to 15 minutes, or until lightly browned. Let cool on wire racks before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
