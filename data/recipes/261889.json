  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup butter, softened",
    "0.5 cup confectioners' sugar",
    "0.25 teaspoon salt",
    "0.25 teaspoon baking powder",
    "2 tablespoons cinnamon sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, butter, confectioners' sugar, salt, and baking powder together in a bowl using an electric mixer on medium speed until well blended. Pat dough into a 9-inch square baking pan. Sprinkle with cinnamon sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 30 to 35 minutes. Cut into bars while still warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
