  "ingredients": [
    "0.5 pound linguine pasta",
    "1 tablespoon olive oil",
    "3 cloves garlic, minced",
    "12 medium shrimp, peeled and deveined",
    "1 (14.5 ounce) can fire roasted tomatoes",
    "1 tablespoon chopped fresh basil",
    "salt and pepper to taste",
    "0.5 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until tender yet firm to the bite, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While pasta is cooking, heat olive oil in a large skillet over medium heat. Add garlic; cook and stir in hot oil until fragrant, about 1 minute. Add shrimp; cook, stirring occasionally, until opaque, 3 to 5 minutes. Pour in tomatoes and cook until heated through. Season with basil, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add drained pasta to sauce; toss to coat. Sprinkle with feta to serve.",
