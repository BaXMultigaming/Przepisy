  "ingredients": [
    "1 (10.5 ounce) bag JET-PUFFED Miniature Marshmallows",
    "0.25 cup butter or margarine",
    "1 (3 ounce) package JELL-O Gelatin, any flavor",
    "12 cups plain popped popcorn"
  ],
  "steps": [
    {
      "text": "Place marshmallows and butter into a microwave-safe bowl. Microwave on high until marshmallows are puffed, 1 ½ to 2 minutes. Stir in gelatin until well blended.",
