  "ingredients": [
    "1 pound ground beef",
    "1 (15 ounce) can kidney beans, drained and rinsed",
    "1 (10 ounce) can enchilada sauce",
    "1.5 teaspoons garlic powder",
    "1 (8.5 ounce) package corn bread/muffin mix",
    "0.33333334326744 cup milk",
    "1 egg",
    "2 tablespoons melted butter",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Place ground beef in a skillet over medium heat. Cook and stir beef until it is browned, about 10 minutes, breaking up meat as it cooks. Drain beef and place it into the slow cooker. Stir in kidney beans, enchilada sauce, and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, combine corn bread mix with milk, egg, and butter, and stir until just mixed. Stir in Cheddar cheese. Spoon corn bread mixture over beef mixture in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set the cooker to Low, cover, and cook until corn bread topping is cooked through and set, about 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
