  "ingredients": [
    "1 cup cornflake crumbs",
    "0.5 cup seasoned dry bread crumbs",
    "2 teaspoons salt",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon paprika",
    "0.75 cup evaporated milk",
    "1 egg",
    "0.25 cup lemon juice",
    "2 tablespoons butter, melted",
    "4 pounds bone-in chicken pieces, with skin",
    "1 cup all-purpose flour",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a shallow baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In one bowl, stir together the cornflake crumbs, bread crumbs, salt, garlic powder, onion powder and paprika. In another bowl, whisk together the evaporated milk, egg, lemon juice and butter using a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip the chicken pieces in flour, and shake off the excess. Dip into the milk batter, then into the crumb mixture. Place pieces in a single layer in the greased baking dish. Spray the top of the chicken with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered for 1 hour in the preheated oven, until nicely browned, and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
