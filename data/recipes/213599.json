  "ingredients": [
    "4 cups water",
    "2 cups uncooked brown rice",
    "0.75 teaspoon salt",
    "2 cups milk",
    "1 (12 fluid ounce) can evaporated milk",
    "1 cup sugar",
    "0.5 teaspoon almond extract",
    "1 (3 inch) piece cinnamon stick"
  ],
  "steps": [
    {
      "text": "Bring water and brown rice to a boil in a saucepan. Add salt, reduce the heat to low, cover, and simmer until rice is tender and liquid has been absorbed, about 50 minutes.",
