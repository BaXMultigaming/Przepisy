  "title": "Happy Apple Zucchini Muffins",
  "description": "These guilt-free muffins are moist with yogurt and packed with apples, zucchini, and carrot.",
  "authors": [
    "Allrecipes Member"
  ],
  "date_published": "2020-03-05T00:09:01-05:00",
