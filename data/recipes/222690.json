  "ingredients": [
    "1.5 cups wheat flour",
    "0.5 cup oat bran",
    "0.5 teaspoon baking soda",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon ground cinnamon",
    "2 eggs",
    "0.75 cup nonfat plain yogurt",
    "0.75 cup packed brown sugar",
    "0.5 teaspoon vanilla extract",
    "1.25 cups peeled and chopped apples",
    "1 cup shredded zucchini",
    "0.5 cup grated carrot"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 12 muffin cups, or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, oat bran, baking soda, baking powder, and cinnamon together in a large bowl; set aside. Beat eggs for 1 minute, then beat in yogurt, brown sugar, and vanilla extract. Stir flour mixture into egg mixture until batter is just blended. Fold apples, zucchini, and carrot into batter until evenly distributed. Spoon batter into prepared muffin cups, filling cups about 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 15 minutes and rotate muffin cups 180 degrees. Continue baking until a toothpick inserted into the center comes out clean, about 10 more minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
