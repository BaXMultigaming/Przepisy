  "ingredients": [
    "1 bunch collard greens, thinly sliced",
    "3 slices bacon",
    "2 cups chicken stock",
    "2 tablespoons sliced fresh jalapeno pepper",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place collard greens in a large pot; cover with salted water and bring to a boil. Reduce heat to medium-low; simmer until just tender, about 10 minutes. Drain and transfer greens to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook bacon in a large, deep skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Crumble bacon; reserve drippings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken stock, bacon, drippings, and jalapeño slices to slow cooker; season with salt and black pepper. Cover slow cooker. Cook on Low for 8 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
