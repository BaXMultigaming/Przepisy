  "ingredients": [
    "1 (16 ounce) package baby carrots",
    "1 cup white sugar",
    "1 cup white vinegar",
    "1 tablespoon whole cloves",
    "1 cinnamon stick"
  ],
  "steps": [
    {
      "text": "Bring a large saucepan of lightly salted water to a boil. Cook carrots in boiling water until tender but not mushy, about 15 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, vinegar, and cloves together in a saucepan; drop in cinnamon stick and bring mixture to a boil. Stir until sugar dissolves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer carrots to a bowl and pour syrup over carrots. Cover tightly; refrigerate until chilled and flavors have blended, 3 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
