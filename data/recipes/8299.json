  "ingredients": [
    "1 (18.25 ounce) package butter cake mix",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "4 eggs",
    "0.25 cup water",
    "0.5 cup vegetable oil",
    "8 ounces sour cream",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour two 9 inch round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine cake mix, pudding mix, eggs, water, oil and sour cream. Beat with a mixer until smooth. Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide into two 9 inch pans. Bake at 350 degrees F (175 degrees C) for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Frost with Cream Cheese Frosting or Sour Cream Chocolate Frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
