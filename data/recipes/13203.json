  "ingredients": [
    "2 cups chicken broth",
    "2.5 cups fresh broccoli",
    "0.25 cup chopped onion",
    "1 cup milk",
    "2 tablespoons all-purpose flour",
    "1 cup shredded Cheddar cheese",
    "0.5 teaspoon dried oregano",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring broth to a boil. Add broccoli and onion; simmer for 5 minutes, or until broccoli is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and flour together in a bowl until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour mixture into broth mixture; cook, stirring constantly, until soup is thick and bubbly. Stir in cheese until melted. Season with oregano, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
