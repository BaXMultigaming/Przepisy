  "ingredients": [
    "0.5 cup butter, softened",
    "2 tablespoons mayonnaise",
    "3 cloves garlic, chopped",
    "2 teaspoons dried oregano",
    "0.5 teaspoon salt",
    "0.5 teaspoon black pepper",
    "0.25 teaspoon sage",
    "1 French baguette, halved lengthwise",
    "2 tablespoons grated Parmesan cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter, mayonnaise, garlic, oregano, salt, pepper, and sage in a bowl until well combined. Spread mixture evenly on baguette halves, then sprinkle Parmesan cheese over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place baguette under the preheated broiler until lightly toasted, about 5 minutes.",
      "section": null,
