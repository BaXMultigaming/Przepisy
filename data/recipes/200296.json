  "title": "Salmon Wellington",
  "description": "This salmon Wellington wraps a whole salmon fillet topped with tender spinach in golden buttery puff pastry for an impressive salmon main dish.",
  "authors": [
    "Valerie Roman"
  ],
  "date_published": "2019-04-02T02:51:58-04:00",
  "date_modified": "2026-04-27T13:10:48-04:00",
  "prep_time": "PT15M",
