  "total_time": "PT55M",
  "yield": [
    "3",
    "1 salmon Wellington"
  ],
  "categories": [
    "Dinner"
  ],
  "cuisines": [
    "British"
  ],
  "regions": [
    "British"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1.5 pounds salmon fillets",
    "1 tablespoon kosher salt",
    "1/4 teaspoon ground black pepper",
    "1.5 cups mayonnaise",
    "0.5 cup Dijon mustard",
    "1 teaspoon dried oregano",
    "1 teaspoon chopped fresh basil leaves",
    "2 teaspoons dried dill weed",
    "1 teaspoon lemon zest",
    "1 teaspoon chopped fresh thyme",
    "0.75 cup crumbled feta cheese",
    "1 cup frozen chopped spinach, thawed and drained",
    "1 (17.5 ounce) package frozen puff pastry, thawed",
    "1 egg white, beaten",
    "1 tablespoon water",
    "lemon wedges"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7bk7mhfd-KucIod2OPKONioLlQo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/200296-Salmon-Wellingtons-ddmfs-4x3-step-01-2115-acd76d5cbe5d41aca98c7fbb67ad4f2a.jpg"
      ],
      "image": "assets/images/200296/step_01.webp"
    },
    {
      "text": "Pat salmon fillet dry with paper towels. Sprinkle salt and pepper on both sides of salmon fillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DfzancnTs9YG5XdfDlPbWj17AKI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/200296-Salmon-Wellingtons-ddmfs-4x3-step-02-2117-306f86ba7c00442686767f4ddb39c6ab.jpg"
      ],
      "image": "assets/images/200296/step_02.webp"
    },
    {
      "text": "Mix mayonnaise, mustard, oregano, basil, dill, lemon zest, and thyme in a small bowl. Set aside ½ of the mixture for serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qHZWqJDVFyzepdTQhijWGLuHuHo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/200296-SalmonWellingtons-ddmfs-4x3-step-03-2120-68a4e0009b95488c9f4e894fedecf0fe.jpg"
      ],
      "image": "assets/images/200296/step_03.webp"
    },
    {
      "text": "Spread remaining mixture on the top of salmon fillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BnUZcGWiOb3TiBUK_BPvA6smswQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/200296-Salmon-Wellingtons-ddmfs-4x3-step-04-2122-d3ea1b222e704fae99565afa320ab3a6.jpg"
      ],
      "image": "assets/images/200296/step_04.webp"
    },
    {
      "text": "Unfold puff pastry on a lightly floured surface. Use your fingers to even out the folds in the pastry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eh7V_Q85fErqBYozH8cvCnwxPsQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/200296-Salmon-Wellingtons-ddmfs-4x3-step-05-2123-2e865818d33e40ab98d3d0c418b61f28.jpg"
      ],
      "image": "assets/images/200296/step_05.webp"
    },
    {
      "text": "Spread spinach in center of pastry in a rectangle the size of the fillet, and sprinkle with feta cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fxEA-uDmmprlrrEvmaOd7u0tUzc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/200296-Salmon-Wellingtons-ddmfs-4x3-step-07-2125-4983fea84f9747cebd28858efce8bb5b.jpg"
      ],
      "image": "assets/images/200296/step_06.webp"
    },
    {
      "text": "Place salmon, mayonnaise-side down, on top of feta cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MvYv1YXFhGMnMEXK2gXRglt5jZ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/200296-Salmon-Wellingtons-ddmfs-4x3-step-08-2127-c4c0be457f30491da61ba7424ec6ca2d.jpg"
      ],
      "image": "assets/images/200296/step_07.webp"
    },
    {
      "text": "Beat egg and water together in small bowl. Brush the edges of pastry with egg wash to ensure the puff pastry is “glued” together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5HhWf_ylaZTFSw06k7dF4QWPUdM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/200296-Salmon-Wellingtons-ddmfs-4x3-step-09-2129-4d70009a4fee4f23bc130fd58fa07f15.jpg"
      ],
      "image": "assets/images/200296/step_08.webp"
    },
    {
      "text": "Lift edges of pastry and slightly stretch to enclose the salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p5ngDDv0ONi8J_gHht4HxQ2dxrA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/200296-Salmon-Wellingtons-ddmfs-4x3-step-10-2130-a51bb9594c464e149c378a1229884812.jpg"
      ],
      "image": "assets/images/200296/step_09.webp"
    },
    {
      "text": "Pinch edges to seal. Place the bundle, seam-side down, on prepared baking sheet. Brush egg wash on tops and sides of pastry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Cgkfjp2DBtW8CUD2iz8jQi1IfOo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/200296-Salmon-Wellingtons-ddmfs-4x3-step-11-2131-af2b9f503c4944cd95ba5e70f61c3db9.jpg"
      ],
      "image": "assets/images/200296/step_10.webp"
    },
    {
      "text": "Cut several small slits in top of pastry to allow steam to escape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qVZwUGpJLCBvCpNUx6t_5PBhHec=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/200296-Salmon-Wellingtons-ddmfs-4x3-step-12-2133-fad600f32b0048e297b5225e68f1a4da.jpg"
      ],
      "image": "assets/images/200296/step_11.webp"
    },
    {
      "text": "Bake in preheated oven until pastry is golden brown, about 40 minutes. An instant-read thermometer inserted into the center of the salmon should be at least 145 degrees F (62 degrees C). Let stand for a few minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4ve-eoP13OiOW0BD4GutwIV9mnY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/200296-Salmon-Wellingtons-ddmfs-4x3-step-13-2145-e02124cd7a614a8e9dbed80e4e4c19b0.jpg"
      ],
      "image": "assets/images/200296/step_12.webp"
    },
    {
      "text": "Serve with reserved herb Dijon mixture and lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q8RJ792kHwSIg9RuykZDb16PoP4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/200296-Salmon-Wellingtons-ddmfs-4x3-step-14-2147-2f02cc502057446d895511cd2acd8443.jpg"
      ],
      "image": "assets/images/200296/step_13.webp"
    }
  ],
