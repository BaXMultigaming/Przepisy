  "ingredients": [
    "cooking spray",
    "0.25 cup unsweetened pineapple juice",
    "2 tablespoons brown sugar",
    "1 tablespoon soy sauce",
    "1 tablespoon wasabi",
    "1 (6 ounce) salmon fillet",
    "0.25 teaspoon seafood seasoning (such as Old Bay®), or to taste",
    "0.25 teaspoon smoked paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Line a baking pan small enough to fit into your air fryer with aluminum foil and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pineapple juice, brown sugar, soy sauce, and wasabi in a glass or ceramic bowl large enough to fit the salmon fillet. Add salmon and lightly cover with plastic wrap. Marinate for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat the air fryer to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer salmon to the prepared baking pan and spoon sauce mixture over fish. Sprinkle with seafood seasoning and paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer, uncovered, until fish flakes easily with a fork, basting frequently with pan juices, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
