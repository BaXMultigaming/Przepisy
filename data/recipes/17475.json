  "ingredients": [
    "3 limes, juiced",
    "2 green onions, chopped",
    "3 cloves garlic, minced",
    "3 tablespoons chopped fresh cilantro",
    "2 tablespoons vegetable oil",
    "0.5 teaspoon red pepper flakes",
    "0.25 teaspoon ground coriander",
