  "ingredients": [
    "2 cups vegetable oil for frying",
    "0.5 cup all-purpose flour",
    "0.25 cup red cooking wine",
    "2 teaspoons water",
    "1 teaspoon chopped fresh parsley",
    "0.75 teaspoon minced garlic",
    "0.5 teaspoon kosher salt",
    "ground black pepper to taste",
    "10 medium button mushrooms",
    "2 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, wine, water, parsley, garlic, salt, and pepper together in a bowl until well combined and no lumps remain. Dip mushrooms, one at a time, into batter to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully place coated mushrooms into hot oil, making sure they don't touch or stick together while cooking; fry until golden brown, 5 to 6 minutes. Drain on a paper towel-lined plate lined. Sprinkle with Parmesan cheese to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
