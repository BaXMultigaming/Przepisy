  "ingredients": [
    "6 large sweet potatoes",
    "0.5 cup butter",
    "2 cups white sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "salt to taste",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Peel and cut sweet potatoes into 1/4-inch-thick slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w0X8VpZFJ5zG4vRGbMFtuHT-ztA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9209-southern-candied-sweet-potatoes-DDMFS-4x3-step-02-e7f9c2e6f85a4c99a35a91db9bfbbb7a.jpg"
      ],
      "image": "assets/images/9209/step_01.webp"
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add sweet potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LZJKYEDXnIm9U0Bl6w6vCPCRfQc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9209-southern-candied-sweet-potatoes-DDMFS-4x3-step-03-bbe11ea78d994b75951bfed2099d3ad2.jpg"
      ],
      "image": "assets/images/9209/step_02.webp"
    },
    {
      "text": "Mix sugar, cinnamon, nutmeg, and salt together in a medium bowl; pour over sweet potatoes; stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0IuOP-XAo7qwcySCyoV26mzPliw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9209-southern-candied-sweet-potatoes-DDMFS-4x3-step-04-1-a2353af2bcd9427181e6d63e0536a301.jpg"
      ],
      "image": "assets/images/9209/step_03.webp"
    },
    {
      "text": "Cover the skillet, reduce heat to low, and cook, stirring occasionally, until saweet potatoes are tender, and sugar melts and darkens, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eyh3q8S1zVPiQesjoVuNmNAjf0M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9209-southern-candied-sweet-potatoes-DDMFS-4x3-step-05-472bad94355f44939056b8e97e415b3a.jpg"
      ],
      "image": "assets/images/9209/step_04.webp"
    },
    {
      "text": "Stir in vanilla extract just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6zO0xcsKlElVdbWCUzAsdFIGZvs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9209-southern-candied-sweet-potatoes-DDMFS-4x3-hero-0ffda513955b4e7ba20337d83c958890.jpg"
