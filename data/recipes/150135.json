  "ingredients": [
    "0.5 large head cabbage, cored and shredded",
    "1 bunch green onions, thinly sliced",
    "1 cup almond slivers",
    "0.25 cup toasted sesame seeds",
    "3 tablespoons sesame oil",
    "3 tablespoons rice vinegar",
    "1 tablespoon white sugar",
    "1 clove garlic, minced",
    "1 teaspoon grated fresh ginger root",
    "1 teaspoon salt",
    "1 teaspoon black pepper"
  ],
  "steps": [
    {
      "text": "Combine cabbage, green onions, almond, and sesame seeds in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make dressing: Whisk together sesame oil, vinegar, sugar, garlic, ginger, salt, and pepper in a small bowl until sugar is dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing over cabbage mixture and toss until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
