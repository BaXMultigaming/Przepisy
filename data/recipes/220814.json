  "ingredients": [
    "4 cups old-fashioned oats",
    "0.5 cup chopped pecans",
    "0.5 cup chopped walnuts",
    "0.5 cup ground flax seed",
    "2 teaspoons ground cinnamon",
    "0.33333334326744 cup canola oil",
    "0.66666668653488 cup pure maple syrup",
    "1 teaspoon maple flavoring",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, pecans, walnuts, flax seed, and cinnamon in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir canola oil, maple syrup, maple flavoring, and salt together in a small bowl; pour over the oat mixture and stir to coat evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the resulting mixture evenly onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set granola aside to cool completely before breaking into chunks. Store in an air-tight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
