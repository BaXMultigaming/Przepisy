  "ingredients": [
    "cooking spray",
    "0.5 cup mayonnaise",
    "6 tablespoons cream cheese",
    "7.5 ounces canned crabmeat, drained",
    "4 tablespoons minced onion",
    "1 tablespoon lemon juice",
    "0.5 teaspoon hot pepper sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a small baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together mayonnaise and cream cheese in a large bowl until smooth. Stir in crabmeat, onion, lemon juice, and hot sauce until well combined. Spoon mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until sauce is bubbly, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
