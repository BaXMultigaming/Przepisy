  "ingredients": [
    "2 tablespoons vegetable oil, divided",
    "1 medium onion, chopped",
    "1 medium green bell pepper, chopped",
    "1 pound ground chicken",
    "salt and ground black pepper to taste",
    "4 slices American cheese",
    "2 (8 inch) hoagie rolls, split lengthwise"
  ],
  "steps": [
    {
      "text": "Heat 1 tablespoon oil in a nonstick skillet over medium-high heat. Add onion and bell pepper; cook and stir until tender, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "At the same time, heat remaining 1 tablespoon oil in another nonstick skillet over medium-high heat. Add ground chicken; cook and stir until chicken is crumbly and no longer pink, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cooked onion and pepper mixture to the chicken; season with salt and pepper. Lay American cheese slices over top and cook until melted, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1/4 of the cheesy chicken mixture evenly over each roll half and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
