  "ingredients": [
    "3 large eggs",
    "0.75 cup whole milk",
    "0.25 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "0.5 cup all-purpose flour",
    "0.25 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "2 tablespoons unsalted butter",
    "0.5 cup blueberries",
    "confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, milk, sugar, and vanilla extract in a bowl; whisk to combine. Combine flour, salt, and cinnamon in a second bowl. Whisk flour mixture into the egg mixture until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in an 8-inch cast iron skillet over medium-high heat. Pour in the batter and sprinkle blueberries on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake Dutch baby in the preheated oven until puffed and golden, 20 to 25 minutes. Remove from the oven, dust with confectioners' sugar, and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
