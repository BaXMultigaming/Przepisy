  "ingredients": [
    "0.66666668653488 cup white sugar",
    "4 tablespoons all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "1 cup heavy whipping cream",
    "0.25 teaspoon almond extract",
    "5 nectarines",
    "1 (9 inch) unbaked pie shell"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place a large pot of water over high heat, and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, flour, cinnamon, heavy cream and almond extract. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place nectarines in boiling water for 30 to 45 seconds. Immediately place nectarines under cold running water and remove skins. Cut nectarines in half and remove pits; arrange nectarine halves in prepared crust cut-side down. Pour cream mixture around nectarines.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is set, about 40 to 45 minutes. Serve warm or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
