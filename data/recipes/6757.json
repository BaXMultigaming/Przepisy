  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "4 ripe bananas, mashed",
    "2 large eggs",
    "0.66666668653488 cup white sugar",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x4-inch loaf pan and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking powder, and salt in a large bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash bananas in another bowl and stir in eggs and sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the flour mixture into the banana mixture just to combine, then fold in walnuts. Pour the batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the bread comes out clean, 55 to 65 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and cool on a rack for 10 minutes, then remove from the pan and cool completely. Slice and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
