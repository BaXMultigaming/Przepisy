  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "2 teaspoons baking soda",
    "1 teaspoon baking powder",
    "1.5 cups buttermilk",
    "3 eggs, beaten",
    "0.5 cup vegetable oil",
    "1 teaspoon maple flavoring",
    "1 teaspoon vanilla extract",
    "4 slices crisp bacon, crumbled into bits"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 20 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, baking soda, and baking powder together in a bowl. Add buttermilk, eggs, oil, maple flavoring, and vanilla extract. Stir in crumbled bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill muffin cups 2/3 full of batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into a cupcake comes out clean, 17 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
