  "ingredients": [
    "1 teaspoon active dry yeast",
    "0.25 teaspoon white sugar",
    "0.75 cup lukewarm water",
    "2 cups all-purpose flour, divided",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2CRVhUbF0-q4mx4skh-eNoJpFwE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257198-thin-crust-pizza-ddmfs-step-01-3x4-1019-39e2b3b729184c33a9412305cb1a7d94.jpg"
      ],
      "image": "assets/images/257198/step_01.webp"
    },
    {
      "text": "Dissolve yeast and sugar in warm water that's 110 degrees F (44 degrees C) in a small bowl. Let stand until yeast softens and begins to form a creamy foam, about 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SSwZ_dJtvVggHiY7_F94OXX8DN0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257198-thin-crust-pizza-ddmfs-step-02-3x4-1024-256305da6eef4b2684d8296c0349e887.jpg"
      ],
      "image": "assets/images/257198/step_02.webp"
    },
    {
      "text": "Combine 1 3/4 cups flour and salt in a large bowl. Pour in yeast mixture; mix well until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UTmHxmidyGSHBXIul6zN3Ings6w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257198-thin-crust-pizza-ddmfs-step-03-3x4-1026-db421f9680594971b2a88d88b01b50a7.jpg"
      ],
      "image": "assets/images/257198/step_03.webp"
    },
    {
      "text": "Transfer dough to a floured surface and knead until smooth, about 2 minutes. Add remaining 1/4 cup flour if dough is too sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uC0e_XgUJvTbneRILjfQgdXW-Us=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257198-thin-crust-pizza-ddmfs-step-04-3x4-1027-4af2e372491e48c8afde6150fa49b6d4.jpg"
      ],
      "image": "assets/images/257198/step_04.webp"
    },
    {
      "text": "Roll dough into a 12-inch circle. Transfer to a greased pizza pan.",
      "section": null,
      "name": null,
      "url": null,
