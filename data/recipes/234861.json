  "ingredients": [
    "0.5 pound cooked pork roast, shredded",
    "2 (10 inch) flour tortillas",
    "0.25 cup barbeque sauce",
    "4 slices Cheddar cheese, halved",
    "0.5 small onion, thinly sliced into rings",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon 1/2 the shredded pork onto each tortilla; top each with 2 tablespoons barbeque sauce, 4 Cheddar cheese halves, 1/2 the onion rings, salt, and pepper. Fold opposing edges of each tortilla to overlap the filling. Roll 1 of the opposing edges around the filling into a burrito-shape. Wrap each tightly with aluminum foil and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through and cheese is melted, 15 to 20 minutes. Cut each wrap in half to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
