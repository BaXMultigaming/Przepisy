  "title": "French Onion Green Bean Casserole",
  "description": "Chef John elevates the classic green bean casserole with caramelized onions, crisp green beans, homemade white sauce, Gruyère cheese, and bread crumbs.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2011-11-09T17:26:46-05:00",
  "date_modified": "2026-01-04T15:26:56-05:00",
  "prep_time": "PT45M",
