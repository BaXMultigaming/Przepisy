  "ingredients": [
    "1 (8 ounce) package cavatelli pasta",
    "1 head broccoli, cut into florets",
    "0.5 cup butter",
    "3 cloves garlic, finely chopped",
    "1 (4.5 ounce) can sliced mushrooms, drained",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place broccoli in a microwave safe dish with about 3 tablespoons of water. Microwave for 3 minutes, or until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a medium skillet over medium heat. Saute garlic and mushrooms until garlic becomes aromatic. Combine with pasta, broccoli and Parmesan cheese; transfer to a 2 quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake in preheated oven for about 20 minutes, or until heated throughout.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
