  "title": "Chicken Marsala Milanese",
  "description": "Crispy panko-covered chicken Milanese is served with a rich Marsala sauce in Chef John's mash up of the two classic recipes.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2021-10-08T19:26:24-04:00",
