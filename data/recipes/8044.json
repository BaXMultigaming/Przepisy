  "ingredients": [
    "1.75 cups pastry flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1.5 teaspoons ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 cup shortening",
    "1 cup packed brown sugar",
    "2 eggs",
    "0.5 teaspoon vanilla extract",
    "1 cup applesauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9 inch square cake pan. Line the bottom of the pan with wax paper, or dust lightly with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sir together flour, baking powder, salt, and spices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream shortening. Blend in brown sugar, beating until light and fluffy. Beat in eggs and vanilla. Stir flour mixture into creamed mixture alternately with applesauce; make 3 dry and 2 liquid additions, combining lightly after each. Turn batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 40 to 45 minutes, or until cake springs back when lightly touched.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
