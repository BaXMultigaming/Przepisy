  "ingredients": [
    "1 pound ground beef",
    "2 (19 ounce) cans kidney beans, rinsed and drained",
    "1 (28 ounce) can crushed tomatoes",
    "1 (8 ounce) can tomato sauce",
    "1 medium green bell pepper, finely chopped",
    "1 tablespoon dehydrated onion flakes",
    "1 tablespoon chili powder",
    "1 teaspoon ground cumin"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Add ground beef; cook and stir until brown and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer beef to a slow cooker; stir in beans, crushed tomatoes, tomato sauce, bell pepper, onion flakes, chili powder, and cumin to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the slow cooker. Cook on Low until flavors have melded, 4 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
