      "image_sources": []
    },
    {
      "text": "Coat inside of squash with 1 tablespoon olive oil. Place squash cut-side down on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until squash is tender, about 30 minutes. Cool squash for 10 minutes.",
