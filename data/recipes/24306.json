  "ingredients": [
    "4.5 teaspoons unflavored gelatin",
    "0.25 cup cold water",
    "1 cup boiling water",
    "1.75 cups orange juice",
    "2 teaspoons grated orange zest",
    "1 teaspoon grated lemon zest",
    "0.75 cup white sugar",
    "0.5 cup lemon juice",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "In a medium bowl, soak gelatin in cold water for 5 minutes. Add boiling water, stirring until gelatin dissolves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To 3 tablespoons of the orange juice add the orange and lemon zest; set aside for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain the zest out of the orange juice and discard the zest. To the gelatin add all of the orange juice, sugar, lemon juice and salt. Stir until well blended and set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cooled mixture into a 4-cup mold which has been rinsed in cold water. Cover and refrigerate to congeal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
