  "title": "Deep-Fried Soft-Shell Crab",
  "description": "These soft-shell crabs have a thick, flavorful, deep-fried coating that contrasts nicely with the tender, delicious crab meat.",
  "authors": [
    "Brian Genest"
  ],
  "date_published": "2019-03-09T19:11:19-05:00",
