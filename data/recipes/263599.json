  "ingredients": [
    "1.5 cups water",
    "1 cup steel-cut oats",
    "1 cup almond milk",
    "1.5 tablespoons brown sugar",
    "0.25 teaspoon ground cinnamon",
    "1 pinch nutmeg",
    "1 pinch ground ginger",
    "1 pinch ground cloves"
  ],
  "steps": [
    {
      "text": "Combine water, oats, almond milk, brown sugar, cinnamon, nutmeg, ginger, and cloves in a multi-functional pressure cooker (such as Instant Pot®). Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 10 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let pressure release naturally for 10 minutes. Finish releasing pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Stir with a silicone spatula until oats are combined and thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
