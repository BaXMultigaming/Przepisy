  "ingredients": [
    "2 cups white sugar",
    "2 tablespoons unsweetened cocoa powder",
    "0.75 cup evaporated milk",
    "1 teaspoon vanilla extract",
    "2 cups crunchy peanut butter"
  ],
  "steps": [
    {
      "text": "Combine the sugar, cocoa, and milk in a medium saucepan. Bring to a boil, and cook for 3 minutes. Stir in the vanilla and peanut butter. Mix well. Spread over hot cake while frosting is also still hot. Let frosted cake cool before cutting.",
