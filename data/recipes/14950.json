  "ingredients": [
    "0.5 cup butter",
    "0.75 cup white corn syrup",
    "1 cup packed brown sugar",
    "1 cup chopped pecans",
    "1 cup almonds",
    "1 (12 ounce) package crispy corn and rice cereal"
  ],
  "steps": [
    {
      "text": "Preheat oven to 275 degrees F (135 degrees C). Spray a large roasting pan with non-stick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium-size microwave safe bowl, mix butter, white corn syrup and brown sugar. Place the mixture in the microwave and cook 2 minutes, or until butter melts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the cereal, pecans and almonds into the prepared roasting pan. Pour the melted butter mixture over the cereal and nuts and mix gently until the cereal and nuts are coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour, stirring every 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "As the snack mix is cooling, be sure to continue to stir so that the mix will not harden in one big lump.",
      "section": null,
      "name": null,
      "url": null,
