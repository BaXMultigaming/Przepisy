  "ingredients": [
    "1 (6 ounce) package dry bread stuffing mix",
    "1 (16 ounce) container sour cream",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 (10.75 ounce) can condensed cream of celery soup",
    "1 (1 ounce) package dry onion soup mix",
    "2 (14.5 ounce) cans French-style green beans, drained",
    "2 cups cooked, chopped turkey meat"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare stuffing according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix the sour cream, cream of mushroom soup, cream of celery soup and dry onion soup mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the green beans in a 9x13 inch dish. Top with a layer of turkey. Pour the soup mixture over the turkey. Top with stuffing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 30 minutes, or until browned and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
