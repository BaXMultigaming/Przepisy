  "ingredients": [
    "2 (14.5 ounce) cans pitted sour cherries, drained",
    "1 cup white sugar",
    "3.5 tablespoons cornstarch",
    "0.5 teaspoon lemon juice"
  ],
  "steps": [
    {
      "text": "Combine cherries, sugar, and cornstarch in a saucepan over medium heat; cook and stir constantly and bring to a boil.",
      "section": null,
