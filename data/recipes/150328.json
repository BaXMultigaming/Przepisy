  "ingredients": [
    "1 quart oil for frying",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon cinnamon",
    "0.75 teaspoon pumpkin pie spice",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 cup milk",
    "0.75 cup canned pumpkin puree",
    "1 egg",
    "0.25 cup packed brown sugar",
    "0.5 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep pot or deep skillet to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, cinnamon, pumpkin pie spice, baking powder, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk, pumpkin purée, egg, and brown sugar together in a large bowl with an electric mixer until well blended. Stir in flour mixture until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put your finger over bottom opening of a funnel; fill funnel with ½ cup batter. Holding funnel close to surface of oil, release batter into oil while making a circular motion. Fry until golden brown. Use tongs and a wide spatula to carefully turn funnel cake. Fry until golden, about 1 minute more. Drain on paper towels. Repeat with remaining batter. Cool for 5 minutes. Dust generously with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
