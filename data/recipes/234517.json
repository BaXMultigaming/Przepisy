  "ingredients": [
    "2 pounds shredded cabbage",
    "1 tablespoon salt",
    "2 large carrots, shredded",
    "2 cups white sugar",
    "1 cup apple cider vinegar",
    "0.25 cup water",
    "1 teaspoon celery seed",
    "1 teaspoon dry mustard"
  ],
  "steps": [
    {
      "text": "Mix together cabbage and salt in a colander; drain for 1 hour. Squeeze moisture from cabbage, then transfer to a large bowl. Stir in carrots until well combined, then divide mixture between pint containers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together sugar, vinegar, water, celery seed, and dry mustard in a medium saucepan over medium-high heat; bring to a boil for 1 minute. Remove from heat and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cooled vinegar mixture over cabbage mixture. Cover the containers and freeze. Thaw before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
