  "ingredients": [
    "2 cups whole wheat flour",
    "2 cups rolled oats",
    "1 cup chopped dried mixed fruit",
    "0.66666668653488 cup brown sugar",
    "0.5 cup unsweetened shredded coconut",
    "0.5 cup sunflower seeds",
    "0.33333334326744 cup flaxseed meal",
    "0.25 cup chia seeds",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "1 cup unsalted butter",
    "0.25 cup honey",
    "1 teaspoon baking soda",
    "2 tablespoons hot water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix whole wheat flour, oats, dried fruit, brown sugar, coconut, sunflower seeds, flaxseed meal, chia seeds, vanilla extract, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter and honey together in a microwave-safe glass or ceramic bowl in 30-second intervals, stirring after each interval, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve baking soda in hot water in a small bowl; add to the butter mixture and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour butter mixture over flour mixture; mix well to combine. Spoon tablespoons of mixture into ungreased mini muffin pans and flatten tops slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 10 minutes. Transfer to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
