  "ingredients": [
    "0.25 cup butter",
    "0.66666698455811 cup rolled oats",
    "0.66666698455811 cup brown sugar, divided",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground allspice",
    "0.66666698455811 cup water",
    "1.5 cups all-purpose flour",
    "0.33333298563957 cup rolled oats",
    "4 teaspoons baking powder",
    "2 teaspoons wheat germ",
    "1 egg, lightly beaten",
    "1 cup evaporated milk",
    "1.3333300352097 cups raisins",
    "1 tablespoon all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease a muffin pan, or use paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a skillet over medium heat. Cook 2/3 cup oats, 1/3 cup brown sugar, cinnamon and allspice until golden brown. Stir in 2/3 cup water and remaining 1/3 cup brown sugar. Cook until slightly thickened. Remove from heat and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine flour, 1/3 cup uncooked oats, baking powder and wheat germ. Whisk together egg and evaporated milk. Make a well in the center of flour mixture, and pour in egg mixture and cooked oatmeal. Mix just until combined. Dredge raisins in 1 tablespoon flour, then fold into batter. Spoon into muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
