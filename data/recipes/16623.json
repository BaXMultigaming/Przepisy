  "ingredients": [
    "2 pounds potatoes",
    "1 green bell pepper, minced",
    "1 cucumber, sliced and quartered",
    "0.5 cup sliced red onion",
    "8 ounces crumbled feta cheese",
    "1 lemon, juiced",
    "0.5 cup Italian-style salad dressing",
    "salt and pepper to taste",
    "3 pita breads, cut into wedges"
  ],
