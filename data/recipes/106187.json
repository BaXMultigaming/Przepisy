  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup mayonnaise",
    "0.25 cup sour cream",
    "2 (4.5 ounce) cans small shrimp, drained",
    "1 (8 ounce) jar cocktail sauce",
    "1 cup shredded mozzarella cheese",
    "0.25 cup chopped green onion",
    "0.25 cup chopped green bell pepper",
    "1 tomato, chopped"
  ],
  "steps": [
    {
      "text": "Mix cream cheese, mayonnaise, and sour cream together in a medium bowl until smooth. Spread into the bottom of a serving dish. Layer in the following order: shrimp, cocktail sauce, mozzarella cheese, green onion, green pepper, and tomato. Cover and refrigerate for 1 hour before serving.",
