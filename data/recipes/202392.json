        "https://www.allrecipes.com/thmb/lVHOGfv-9lB9HkZ542tP_Jlnj5M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/202392-sauteed-zucchini-DDMFS-28435-step-06-df554307aed7432e8b94c7ad96978fdb.jpg"
