  "ingredients": [
    "1 cup Greek yogurt",
    "0.25 cup extra-virgin olive oil",
    "2 tablespoons lemon juice",
    "1 tablespoon red wine vinegar",
    "3 cloves garlic, minced",
    "2 teaspoons kosher salt",
    "1.5 teaspoons paprika",
    "1 teaspoon ground black pepper",
    "1 teaspoon ground cumin",
    "1 teaspoon ground coriander seed",
    "1 teaspoon dried oregano",
    "0.5 teaspoon crushed red pepper",
    "0.25 teaspoon ground cinnamon",
    "2.5 pounds boneless, skinless chicken thighs",
    "1 large onion",
    "2 8- to 10-inch wooden skewers",
    "6 pita breads, warmed",
    "0.5 cup tzatziki sauce",
    "0.5 cup shredded lettuce, or to taste",
    "0.5 cup diced tomato, or to taste",
    "0.25 cup diced red onion, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qS8nit5gG6E6JIP3fEvMRkR-XkA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8448133-easy-oven-roasted-chicken-gyros-VAT-01-5fe79fd58fbe4fdea987cb00c5189807.jpg"
      ],
      "image": "assets/images/8448133/step_01.webp"
    },
    {
      "text": "Combine Greek yogurt, olive oil, lemon juice, vinegar, garlic, salt, paprika, black pepper, cumin, coriander, oregano, red pepper, and cinnamon in a medium bowl and stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dT-vux_QFHGFJU974HcvoWMqEZw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8448133-easy-oven-roasted-chicken-gyros-VAT-02-a952ec3688c2434e8f9d0aaa18f67749.jpg"
      ],
      "image": "assets/images/8448133/step_02.webp"
    },
    {
      "text": "Pound chicken thighs evenly to about 1/2 inch in thickness. Coat all chicken well in marinade, cover, and refrigerate at least 4 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RY4tAKAhfbsq879Gf7CWcJFa-WY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8448133-easy-oven-roasted-chicken-gyros-VAT-03-b8f5013cdd0145deb7cd8ee1b941ddf1.jpg"
      ],
      "image": "assets/images/8448133/step_03.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Cut ends off onion and cut onion in half horizontally. Place onion halves next to each other on a parchment or foil-lined rimmed baking sheet. Insert one skewer into each onion half, standing up vertically.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dwEOEE4fZya_03TH9eS4ja8cJkk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8448133-easy-oven-roasted-chicken-gyros-VAT-05-d3621f113d734641b24c109cce925b15.jpg"
      ],
      "image": "assets/images/8448133/step_04.webp"
    },
    {
      "text": "Remove chicken from marinade, allowing excess to drip off, and thread each piece of chicken over the two skewers to form a large stack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2wt7jhLn3OU7GgA9RKoKQFPpKzs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8448133-easy-oven-roasted-chicken-gyros-VAT-06-2222042446c6479faef05590b7e931ea.jpg"
      ],
      "image": "assets/images/8448133/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until evenly browned and cooked through, about 1 hour, rotating halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E-TXoevol-5pDgjSA2c6Tcqmf9o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8448133-easy-oven-roasted-chicken-gyros-VAT-07-60ebb806d3f448bd993183ee470bb832.jpg"
      ],
      "image": "assets/images/8448133/step_06.webp"
    },
    {
      "text": "Allow meat to rest for 10 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2eoRVE_Mhq2JdUdlK-Q_j-3h9MI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8448133-easy-oven-roasted-chicken-gyros-VAT-08-121728bbb5d543d48dc691c65046154e.jpg"
      ],
      "image": "assets/images/8448133/step_07.webp"
    },
    {
      "text": "Place the sliced chicken in a warm pita topped with tzatziki sauce, lettuce, tomato, and red onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wZmOUptYfqZPrXyspxM_YT2O71M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8448133-easy-oven-roasted-chicken-gyros-VAT-09-c82e1a5cb73644dbae385ddbf660a32e.jpg"
      ],
      "image": "assets/images/8448133/step_08.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vipHAGtj3neYr-znSWCDYm40vtE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8448133-easy-oven-roasted-chicken-gyros-VAT-4x3-47f7dd17d5984e668eeea157fea7c644.jpg"
      ],
      "image": "assets/images/8448133/step_09.webp"
    }
