  "ingredients": [
    "0.25 cup butter",
    "1 large onion, diced",
    "0.5 large green bell pepper, diced",
    "1 (4 ounce) jar chopped pimento peppers",
    "1 (8 ounce) package corn muffin mix (such as Jiffy®)",
    "1 (4 ounce) can diced green chiles",
    "1 (15.25 ounce) can whole kernel corn, with liquid",
    "1 (15.25 ounce) can creamed corn",
    "2 eggs",
    "1 pint sour cream",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pHRdxR62QJIM1s8CybjqzGlEDXQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-274670-jiffy-corn-casserole-VAT-step-01-d6e9ed4ba3db4daba14d170ecb005396.jpg"
      ],
      "image": "assets/images/274670/step_01.webp"
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add onion, bell pepper, and pimento peppers; sauté until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NObCPn2e99EDACyqrA8UYibqWnQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-274670-jiffy-corn-casserole-VAT-step-02-0b0106b9ce51441b937a70741dfe3679.jpg"
      ],
      "image": "assets/images/274670/step_02.webp"
    },
    {
      "text": "Combine corn muffin mix, green chiles, whole corn, creamed corn, and eggs in a large bowl; stir in onion mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ypLAfIDRWpWSIYxOTavlvFyaMjM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-274670-jiffy-corn-casserole-VAT-step-03-95d0bba5fb834d338b59cea3a72b9a7c.jpg"
      ],
      "image": "assets/images/274670/step_03.webp"
    },
    {
      "text": "Pour into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-ieG0uE7pTStbl6yPaNw4uhqXqY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-274670-jiffy-corn-casserole-VAT-step-04-cfaed615c0d64be0955fbb2f8b349905.jpg"
      ],
      "image": "assets/images/274670/step_04.webp"
    },
    {
      "text": "Spread sour cream evenly over the mixture; sprinkle with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RIMzo4pJ1I0to3HQVXV71c61Frc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-274670-jiffy-corn-casserole-VAT-step-05-6064ec255ccc44d380add0f942f9fc4d.jpg"
      ],
      "image": "assets/images/274670/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until casserole is lightly browned and firm, about 45 minutes.",
      "section": null,
      "name": null,
