  "ingredients": [
    "1.5 cups dried white kidney beans, soaked overnight",
    "3 tablespoons tomato paste",
    "1 tablespoon red pimento sauce",
    "3 cloves garlic, chopped",
    "3 medium onions, chopped",
    "1 tablespoon lemon juice",
    "1 teaspoon ground cumin",
    "2 tablespoons olive oil",
    "salt and pepper to taste",
    "1 (14.5 ounce) can beef broth"
  ],
  "steps": [
    {
      "text": "Combine soaked beans, tomato paste, pimento sauce, garlic, onions, lemon juice, cumin, olive oil, salt, and pepper in a slow cooker crock. Mix together until beans are coated. Pour in beef broth and top off with enough water to completely cover bean mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High until beans are tender and liquid is thickened, about 6 hours. It should not be soupy.",
