  "ingredients": [
    "1.5 cups white sugar",
    "1.5 cups brown sugar",
    "1 cup butter",
    "4 eggs",
    "4 teaspoons vanilla extract",
    "4.5 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "5 cups semisweet chocolate chips",
    "2 cups flaked coconut",
    "2 cups chopped almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together white sugar, brown sugar, and butter with an electric mixer in a large bowl until smooth. Beat in eggs one at a time, mixing well after each addition. Stir in vanilla. Combine flour, baking soda, and salt in a separate bowl; stir into creamed mixture until well blended. Mix in chocolate chips, coconut, and almonds until incorporated. Drop by rounded spoonfuls onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 8 to 10 minutes. Allow cookies to cool on the baking sheets for 5 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
