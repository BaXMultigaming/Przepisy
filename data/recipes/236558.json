  "ingredients": [
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 cup butter, softened",
    "1 cup white sugar",
    "1 cup firmly packed brown sugar",
    "2 eggs, beaten",
    "1 tablespoon Tennessee whiskey",
    "1 teaspoon vanilla extract",
    "1 (12 ounce) bag semi-sweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, and salt together into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, and brown sugar together in a large bowl with an electric mixer until smooth. Beat in first egg until thoroughly blended; beat in second egg. Add whiskey and vanilla extract; beat until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour mixture into creamed butter mixture until just incorporated; fold in chocolate chips. Form dough into 1-inch balls and place on a baking sheet, 1 to 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 9 to 12 minutes. Transfer cookies to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
