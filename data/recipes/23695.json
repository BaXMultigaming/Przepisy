  "ingredients": [
    "1 teaspoon garlic powder, or to taste",
    "salt and pepper to taste",
    "6 pounds pork butt roast",
    "2 onion, sliced",
    "20 new potatoes, raw",
    "16 carrots, peeled",
    "2 cups mushrooms, halved"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large frying pan over medium-high heat. Sprinkle garlic powder, salt, and pepper over pork roast; rub into meat. Sear meat on all sides in the hot pan until lightly brown. Transfer to a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place onion slices over meat and in the roasting pan. Fill the roasting pan 2/3 full with water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake in the preheated oven for 3 hours. Add potatoes and carrots; cover and continue baking for 45 minutes. Add mushrooms and bake, covered, for another 15 minutes. Remove and let stand at least 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
