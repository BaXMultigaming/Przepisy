  "ingredients": [
    "4.5 cups all-purpose flour (1 Kings 4:22)",
    "1 cup milk, Judges 5:25",
    "2 cups white sugar, Jeremiah 6:20",
    "2 cups figs (Nahum 3:12), chopped",
    "2 cups raisins, 1 Samuel 30:11",
    "2 cups almonds, Numbers 17:8",
    "2 teaspoons honey, 1st Samuel 14:25",
    "0.5 teaspoon salt, Leviticus 2:13",
    "2 teaspoons baking soda"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine flour, milk, sugar, figs, raisins, almonds, honey, salt and baking soda. Mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into prepared 9x13 inch pan. Bake at 350 degrees F (175 degrees C) for 40 minutes, or until edges pull away from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
