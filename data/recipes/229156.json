  "ingredients": [
    "2 cups water",
    "1 cup quinoa",
    "0.25 cup extra-virgin olive oil",
    "2 limes, juiced",
    "2 teaspoons ground cumin",
    "1 teaspoon salt",
    "0.5 teaspoon red pepper flakes, or more to taste",
    "1.5 cups halved cherry tomatoes",
    "1 (15 ounce) can black beans, drained and rinsed",
    "5 green onions, finely chopped",
    "0.25 cup chopped fresh cilantro",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender and water has been absorbed, 10 to 15 minutes. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WFSGFDGFpg8-6ip0GLp_zzYC_1w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229156-ZestyQuinoaSalad-ddmps-step-2-4x3-104378-411240960b7b41c7bbf952fd45e3394b.jpg"
      ],
      "image": "assets/images/229156/step_01.webp"
    },
    {
      "text": "Meanwhile, whisk olive oil, lime juice, cumin, salt, and red pepper flakes together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zCYS_FULFaA-Tx_XiGgkJm6DzS0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229156-ZestyQuinoaSalad-ddmps-step-3-4x3-104383-8c7865a9d64c453cb7a5ca057ce65601.jpg"
      ],
      "image": "assets/images/229156/step_02.webp"
    },
    {
      "text": "Combine quinoa, tomatoes, black beans, and green onions in a large bowl. Pour dressing over quinoa mixture; toss to coat. Stir in cilantro; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Qv6mPELs7E26ZlOyxlxz-z8Wkvk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229156-ZestyQuinoaSalad-ddmps-step-4-4x3-104389-173a51dd457041958ec25ec67563c5fb.jpg"
      ],
      "image": "assets/images/229156/step_03.webp"
    },
    {
      "text": "Serve immediately or chill salad in an airtight container in the refrigerator for about five days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AfZ5pJYvZSrlltkHiimLIOdEtjE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229156-Zesty-Quinoa-Salad-ddmps-4x3-104421-df647e343ce543769a038cccf4c6419c.jpg"
      ],
