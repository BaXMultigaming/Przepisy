  "ingredients": [
    "0.25 cup butter",
    "0.33333298563957 cup brown sugar",
    "1 cup milk",
    "12 dates, pitted and chopped",
    "0.5 cup raisins",
    "0.25 cup dried currants",
    "0.25 cup candied mixed fruit peel, chopped",
    "1 orange, zested",
    "1 teaspoon baking soda",
    "1 cup self-rising flour",
    "2 teaspoons ground cinnamon",
    "1 pinch salt"
