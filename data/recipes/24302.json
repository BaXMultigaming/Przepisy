  "steps": [
    {
      "text": "Generously grease a pudding mold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan combine butter, sugar, milk, dates, raisins, currants, mixed fruit peel and zest of the orange; bring to a boil. Remove from heat and stir in baking soda. Sift in the flour, cinnamon and salt; mix gently until blended. Pour into prepared pudding mold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover with a double layer of greased wax paper and steam for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
