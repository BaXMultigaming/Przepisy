  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend sugar, flour, butter, lemon zest, and cinnamon together in a small bowl for the topping; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, milk, butter, and egg together in another bowl. Blend well. Combine flour and baking powder; stir into the milk mixture. Fold in blueberries and lemon zest. Pour batter into the prepared loaf pan and sprinkle with the topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the loaf comes out clean, about 50 minutes.",
