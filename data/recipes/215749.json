  "ingredients": [
    "1 (1.1 oz) package chai tea powder",
    "0.75 cup hot water",
    "0.25 cup Chardonnay wine",
    "0.5 teaspoon vanilla extract",
    "1 egg yolk",
    "0.5 cup frozen unsweetened raspberries",
    "1 tablespoon butter, room temperature",
    "0.5 cup bread flour",
    "0.25 cup rye flour",
    "1 cup all-purpose flour",
    "0.5 cup wheat bran",
    "1 (.25 ounce) package active dry yeast",
    "0.5 cup coarsely chopped walnuts",
    "0.5 teaspoon caraway seed",
    "0.25 cup white sugar",
    "1 teaspoon coarse smoked salt flakes"
  ],
  "steps": [
    {
      "text": "Prepare the chai tea using one packet or two tablespoons of dry mix stirred into 3/4 cup hot water. Allow to cool for about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the chai tea, Chardonnay, vanilla extract, egg yolk, frozen raspberries, and butter in the pan of a bread machine. Add the bread flour, rye flour, all-purpose flour, wheat bran, yeast, walnuts, caraway seed, sugar, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Select the \"Sweet\" setting with a \"Light Crust\" and press Start. When the bread has finished baking, allow it to cool for at least 30 minutes before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
