  "ingredients": [
    "2 Earl Grey tea bags (such as Gryphon®)",
    "0.75 cup boiling water",
    "2 cups bread flour",
    "2.25 tablespoons white sugar",
    "0.75 teaspoon instant yeast",
    "0.5 teaspoon salt",
    "1.5 tablespoons unsalted butter"
  ],
  "steps": [
    {
      "text": "Cut open tea bags and place leaves in a tea strainer. Steep in boiling water for 10 minutes. Let tea cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cooled tea into a bread machine. Add bread flour, sugar, yeast, and salt in the order recommended by the manufacturer. Run White Bread cycle. Add the butter when the machine beeps, about 15 minutes into the kneading stage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove loaf from the machine after the cycle is done, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
