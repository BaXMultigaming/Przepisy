  "ingredients": [
    "cooking spray",
    "4 skinless, boneless chicken breasts",
    "1 clove garlic, minced",
    "1 pinch salt",
    "1 pinch ground black pepper",
    "1 pinch ground cumin",
    "1 cup salsa",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a greased skillet over medium heat. Rub chicken pieces with garlic, salt, pepper, and cumin to taste; place in the hot skillet. Cook until brown on both sides and no longer pink, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken to a 9x13-inch baking dish, top with salsa and cheese, and bake in the preheated oven until cheese is bubbly and starts to brown, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
