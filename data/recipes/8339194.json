  "ingredients": [
    "3 cups water",
    "1.5 pounds boneless, skinless chicken breasts",
    "1 large onion, chopped",
    "6 cloves garlic, minced",
    "1 teaspoon ground turmeric",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "2 cups basmati rice",
    "1 medium carrot, chopped",
    "3 tablespoons fresh lemon juice",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Place water, chicken breasts, onion, garlic, turmeric, salt, and pepper in a 4-quart pot. Bring to a boil over medium-high heat. Reduce heat to medium, cover, and simmer until chicken is cooked through, 20 to 25 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C). Remove chicken from pot and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse rice in a sieve under running water a few times to get rid of excess starch.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add rice and carrot to the broth in the pot. Bring to a simmer; reduce heat to medium-low; and simmer, covered, until rice is tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, shred chicken using two forks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once rice is cooked, fluff it using a fork. Gently mix in shredded chicken and drizzle with lemon juice. Taste and add more salt as needed. Sprinkle with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
