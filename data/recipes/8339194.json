  "title": "Shadi's One-Pot Turmeric Chicken and Rice",
  "description": "Turmeric chicken is a comforting Persian dish made in one pot with chicken breasts and rice cooked in a spicy turmeric broth with onions and garlic.",
  "authors": [
    "Shadi HasanzadeNemati"
  ],
  "date_published": "2022-01-20T15:49:50-05:00",
