  "ingredients": [
    "2 cups white sugar",
    "3 tablespoons unsweetened cocoa powder",
    "1 cup evaporated milk",
    "6 tablespoons butter",
    "1 (7 ounce) jar marshmallow creme",
    "3.5 cups graham cracker crumbs"
  ],
  "steps": [
    {
      "text": "Place sheets of waxed paper onto a work surface.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, cocoa, and evaporated milk together in a large nonstick saucepan over medium heat until mixture comes to a boil; boil for 5 minutes, stirring constantly. Remove from heat and stir butter and marshmallow creme into cocoa mixture. Quickly stir graham cracker crumbs into mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop cookies by the spoonful onto waxed paper; let stand until firm. Store in airtight containers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
