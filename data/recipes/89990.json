  "ingredients": [
    "cooking spray",
    "1 cup all-purpose flour",
    "1 cup fine cornmeal",
    "2 teaspoons baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.25 cup sugar",
    "0.75 cup skim milk",
    "2 large eggs",
    "0.25 cup unsweetened applesauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly spray an 8x8-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix together flour, cornmeal, baking soda, baking powder, salt, and sugar. In a separate bowl, stir together milk, eggs, and applesauce. Fold the wet mixture into the dry; mix together well. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and brown, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
