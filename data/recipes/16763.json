  "ingredients": [
    "2 apples",
    "8 cups bread cubes",
    "3 eggs",
    "1 cup half-and-half cream",
    "1 cup white sugar",
    "0.5 cup milk",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Peel, core and cube the apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly grease a 13x9 inch baking pan. Cover the bottom with half of the bread cubes and then sprinkle on half of the apples. Repeat with the remaining bread and apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl combine the eggs, cream, sugar, milk and cinnamon; beat well. Pour this mixture evenly over the bread cubes and apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees for 35 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
