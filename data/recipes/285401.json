  "ingredients": [
    "3 medium zucchini, or as needed",
    "1.5 cups white sugar",
    "0.5 cup vegetable oil",
    "3 large eggs",
    "1 cup sour cream",
    "1 teaspoon orange extract",
    "1 cup raisins",
    "1 cup dried cranberries",
    "1 cup chopped dried apricots",
    "1 cup finely chopped pecans",
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.25 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred zucchini and squeeze as much moisture out as possible. Continue until you have 2 cups squeezed, dried zucchini.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, vegetable oil, and eggs together in a large bowl. Blend in zucchini, sour cream, and orange extract. Stir in raisings, cranberries, apricots, and pecans. Mix in flour, baking powder, and baking soda. Divide batter evenly between the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the centers comes out clean, about 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
