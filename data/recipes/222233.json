  "ingredients": [
    "4 eggs",
    "2 high fiber, whole wheat tortillas, sliced into 1/2-inch strips",
    "2 ounces dry chorizo, diced",
    "2 slices pepperjack cheese",
    "salt and ground black pepper to taste",
    "1 tablespoon chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Beat eggs in a small bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tortilla slices and chorizo in a skillet over medium heat. Cook, stirring, until tortillas are crisped, 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cheese slices on top of chorizo and tortillas; pour in eggs. Reduce heat to low and cook, stirring, until eggs are cooked through, 3 minutes. Season with salt and pepper to taste; garnish with chives.",
      "section": null,
      "name": null,
