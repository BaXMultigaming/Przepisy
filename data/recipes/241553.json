  "ingredients": [
    "1 cup buckwheat flour",
    "1.5 teaspoons white sugar",
    "1 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1.25 cups buttermilk",
    "1 large egg, beaten",
    "0.25 teaspoon vanilla extract",
    "1 tablespoon unsalted butter, or as needed"
  ],
  "steps": [
    {
      "text": "Whisk buckwheat flour, sugar, baking powder, baking soda, and salt together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LLfPUZmBcSNFOtoJUxvYpu0h1TQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241553-buckwheat-pancakes-ddmfs-step-1-e4ea628cc9464e92ab16b1f0dd808dbd.jpg"
      ],
      "image": "assets/images/241553/step_01.webp"
    },
    {
      "text": "Beat buttermilk, egg, and vanilla together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v1HpkAak5Y6o8-mfzHm824Oa7nI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241553-buckwheat-pancakes-ddmfs-step-2-d5bcfad5c83042b2ac8f3df524f213ea.jpg"
      ],
      "image": "assets/images/241553/step_02.webp"
    },
    {
      "text": "Pour flour mixture into buttermilk mixture; whisk until batter is thick and smooth. Let batter rest until bubbles form and batter relaxes, about 5 minutes",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T6d2FgoWkUkXLtVvcNPW2xOJsG4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241553-buckwheat-pancakes-ddmfs-step-3-e741c119bb5a4e3b8b5aa7fa01c58925.jpg"
      ],
      "image": "assets/images/241553/step_03.webp"
    },
    {
      "text": "Melt butter on a griddle over medium heat. Drop batter by large spoonfuls onto the hot griddle and cook until bubbles form and the edges dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UocSWlr3RVK7l1RpJdDtAMpBOMU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241553-buckwheat-pancakes-ddmfs-step-5copy-a9335916aed64fc290c1cae72005ef09.jpg"
      ],
      "image": "assets/images/241553/step_04.webp"
    },
    {
      "text": "Serve with berries.",
      "section": null,
      "name": null,
      "url": null,
