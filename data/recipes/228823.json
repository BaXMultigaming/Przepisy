  "ingredients": [
    "2 tablespoons vegetable oil",
    "1 pound beef sirloin, cut into 2-inch strips",
    "1.5 cups fresh broccoli florets",
    "1 red bell pepper, cut into matchsticks",
    "2 carrots, thinly sliced",
    "1 green onion, chopped",
    "1 teaspoon minced garlic",
    "2 tablespoons soy sauce",
    "2 tablespoons sesame seeds, toasted"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZiLP4ZIx1miCX1WgMytg_dCwhz0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228823_QuickBeefStirFry-mfs-Step1-f709f0df9223415cb168d2ef2a2af56e.jpg"
      ],
      "image": "assets/images/228823/step_01.webp"
    },
    {
      "text": "Heat vegetable oil in a large wok or skillet over medium-high heat; add beef and stir-fry until browned, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TG7EFAWujAoqmwL5qyEkSDZEuFs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228823_QuickBeefStirFry-mfs-Step2-b1784684ad5b406f929d6455fb1e986e.jpg"
      ],
      "image": "assets/images/228823/step_02.webp"
    },
    {
      "text": "Move beef to the side of the wok and add broccoli, bell pepper, carrots, green onion, and garlic to the center of the wok; stir-fry vegetables for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir beef into vegetables and season with soy sauce and sesame seeds. Continue to cook and stir until vegetables are tender, about 2 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X9DxC2ORk0_RpzDuUl84p-1g0y4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228823_QuickBeefStirFry-mfs-Step3-f59503188dcd4fc59db0bffbfad4fe25.jpg"
      ],
