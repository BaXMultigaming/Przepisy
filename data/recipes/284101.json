  "ingredients": [
    "1 (8 ounce) package feta, cubed",
    "2 tablespoons ramps - washed, dried, and finely chopped",
    "0.25 teaspoon salt",
    "1 pinch chili powder",
    "freshly ground black pepper to taste",
    "1 cup olive oil, or as needed"
  ],
  "steps": [
    {
      "text": "Combine feta, dried ramps, salt, chili powder, and black pepper in a large jar; add olive oil until feta completely covered. Cover jar; marinate in a cool space for 1 to 2 days. Use within a few days.",
