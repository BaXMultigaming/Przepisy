  "ingredients": [
    "2 (8 ounce) packages cream cheese",
    "1 (8 ounce) jar cocktail sauce",
    "0.5 pound shrimp, peeled and deveined",
    "1 lime",
    "1 (16 ounce) package buttery round crackers"
  ],
  "steps": [
    {
      "text": "Place cream cheese in center of serving platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together cocktail sauce and cooked shrimp in a bowl until evenly coated. Pour mixture over cream cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice lime in half; squeeze one half over cocktail sauce. Slice other half into wedges for garnish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place crackers and lime wedges around edge of plate and serve.",
