  "ingredients": [
    "0.75 cup peanut butter",
    "0.5 cup shortening",
    "0.33333334326744 cup white sugar",
    "0.33333334326744 cup light brown sugar",
    "1 egg",
    "2 tablespoons milk",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 (8 ounce) package milk chocolate candy kisses (such as Hershey's Kisses®), unwrapped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat peanut butter and shortening together in a bowl using an electric mixer until smooth and creamy; add white sugar and brown sugar and beat until fluffy. Add egg, milk, and vanilla extract to creamed mixture and beat until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, and salt together in a separate bowl; gradually beat into the creamed mixture until dough is just mixed. Shape dough into 1-inch balls and arrange on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are lightly browned, 8 to 10 minutes. Immediately press a chocolate kiss into the center of each cookie. Transfer cookies to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
