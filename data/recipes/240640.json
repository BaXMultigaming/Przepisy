  "title": "Mom's Peanut Butter Blossom Cookies",
  "description": "Peanut butter blossoms, peanut butter cookies with a chocolate kiss in the center, are a favorite during the holiday season.",
  "authors": [
    "Hailey Rae"
  ],
  "date_published": "2020-06-19T00:01:53-04:00",
