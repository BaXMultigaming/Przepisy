  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 pound ground pork",
    "0.5 cup chopped onion",
    "2 cloves garlic, crushed",
    "0.5 cup minced carrots",
    "0.5 cup chopped green onions",
    "0.5 cup thinly sliced green cabbage",
    "2 tablespoons chopped fresh cilantro",
    "1 teaspoon ground black pepper",
    "1 teaspoon salt",
    "1 teaspoon garlic powder",
    "1 teaspoon soy sauce",
    "30 lumpia wrappers",
    "2 cups vegetable oil for frying, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Hg33vNDff55GNhncXkZOd7RQ5xs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35151-traditional-filipino-lumpia-ddmfs-ingredients-3x4-0681-88915ff001d5497db8de8de5ba2380c5.jpg"
      ],
      "image": "assets/images/35151/step_01.webp"
    },
    {
      "text": "Heat 1 tablespoon vegetable oil in a wok or large skillet over high heat. Add pork; cook and stir until crumbly and no longer pink, 5 to 7 minutes. Remove pork from the pan and set aside. Drain grease from the pan, leaving just a thin coating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dOPfdmHcSZQoKFKFur28GjbLmQI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35151-traditional-filipino-lumpia-ddmfs-step-02-3x4-0690-0a64cf1f08e64459a9f8e7b8fe3c0314.jpg"
      ],
      "image": "assets/images/35151/step_02.webp"
    },
    {
      "text": "Add onion and garlic to the pan; cook and stir until fragrant, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zw6dR-V99oe_IvovBNKZV0SW4Q8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35151-traditional-filipino-lumpia-ddmfs-step-03-3x4-0691-06dc56f213ab409bac12aefb187f505e.jpg"
      ],
      "image": "assets/images/35151/step_03.webp"
    },
    {
      "text": "Stir in cooked pork, carrots, green onions, cabbage, and cilantro. Season with pepper, salt, garlic powder, and soy sauce. Remove from the heat, and set aside until cool enough to handle, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S8uKWZbfwJf_rFuKpnqG6_VzE6I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35151-traditional-filipino-lumpia-ddmfs-step-05-3x4-0698-4cbcba34c0e4462da8494fba0cf290d2.jpg"
      ],
      "image": "assets/images/35151/step_04.webp"
    },
    {
      "text": "To assemble lumpia: Place 3 heaping tablespoons of filling diagonally near one corner of a lumpia wrapper, leaving a 1 ½ inch space at both ends.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/06L2u5hmthT7aRfWLWbQMlLJD4w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35151-traditional-filipino-lumpia-ddmfs-step-06-3x4-0708-9308b4cd7dcb4c62aaca14ebc26faf0e.jpg"
      ],
      "image": "assets/images/35151/step_05.webp"
    },
    {
      "text": "Fold the side along the length of the filling over the filling, tuck in both ends, and roll neatly and tightly to close.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CgZc4zIEp3j2yShBHHZF_NZmQ80=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35151-traditional-filipino-lumpia-ddmfs-step-08-3x4-0714-62576bd5438b428198e4fd76f17c562f.jpg"
      ],
      "image": "assets/images/35151/step_06.webp"
    },
    {
      "text": "Moisten the other side of the wrapper with water to seal the edge. Transfer to a plate and cover with plastic wrap to retain moisture. Repeat to assemble remaining lumpia.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0QqXPm2CwUyUs-yM4NLfyNqkaE4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35151-traditional-filipino-lumpia-ddmfs-step-10-3x4-0717-6b8b3710a1bb498f8474284a82a68744.jpg"
      ],
      "image": "assets/images/35151/step_07.webp"
    },
    {
      "text": "Heat 1/2 inch vegetable oil in a heavy skillet over medium heat for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slide 3 to 4 lumpia into the hot oil, making sure the seams are facing down. Fry, turning occasionally, until all sides are golden brown, 1 to 2 minutes. Transfer to a paper towel-lined plate to drain. Repeat to fry remaining lumpia.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HIFMryexWT9gnPpXDXN1qXqRzWE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35151-traditional-filipino-lumpia-ddmfs-step-14-3x4-0734-576f1a10fa984a4aadfe9b65657bc10b.jpg"
      ],
      "image": "assets/images/35151/step_09.webp"
    },
    {
      "text": "Serve immediately. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ndOxfSY8xgiuTmuoHbunghG88AA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35151-traditional-filipino-lumpia-ddmfs-hero-3x4-0744-6a66461864c9437da74828a882f2c42a.jpg"
      ],
      "image": "assets/images/35151/step_10.webp"
    }
  ],
