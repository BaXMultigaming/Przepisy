  "title": "Traditional Filipino Lumpia",
  "description": "Filipino lumpia are fried spring rolls filled with a savory mixture of pork, cabbage, and other veggies for a deliciously crispy appetizer or side.",
  "authors": [
    "LILQTPINAY23"
  ],
  "date_published": "2019-05-14T03:39:57-04:00",
  "date_modified": "2026-01-20T14:43:36-05:00",
  "prep_time": "PT40M",
