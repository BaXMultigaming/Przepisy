  "title": "Fasolia (Green Bean Stew)",
  "description": "This recipe uses lamb neck bones to get loads of savory flavor into this Syrian green bean stew with onion, garlic, and tomato sauce.",
  "authors": [
    "thecrazycook"
  ],
  "date_published": "2019-04-03T23:56:25-04:00",
