  "ingredients": [
    "1 (17.5 ounce) package lamb neck",
    "1 tablespoon butter",
    "0.5 cup chopped onion",
    "4 cloves garlic, chopped",
    "3 cups water",
    "1.5 cups tomato sauce",
    "1 teaspoon salt",
    "0.5 teaspoon ground allspice",
    "0.25 teaspoon ground black pepper",
    "1 pound green beans",
    "2 potatoes (or to taste), thinly sliced"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat; cook and stir lamb neck bones in hot butter until browned, 7 to 10 minutes. Add onion and garlic; cook and stir until browned, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water, tomato sauce, salt, allspice, and pepper together in a small bowl; pour into the skillet and bring to a boil. Reduce heat to medium-low, place a cover on the skillet, and cook until the meat pulls away from the neck bones, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put green beans and potatoes into the skillet so they are in liquid, replace cover, and continue cooking until the beans are tender and the potatoes are cooked through, about 15 minutes. Remove and discard bones before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
