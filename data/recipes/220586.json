  "ingredients": [
    "1 shallot, thinly sliced",
    "1 tablespoon olive oil",
    "1.5 pounds sweet Italian sausage links",
    "1 (16 ounce) package refrigerated gnocchi",
    "0.25 cup unsalted butter",
    "0.33333334326744 cup milk",
    "1 (8 ounce) package shredded Italian cheese blend",
    "1 tablespoon chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss sliced shallot with olive oil in a heavy pot or dutch oven until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange sausages atop shallot mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the sausage is no longer pink in the center, turning sausages occasionally to brown evenly, 25 to 30 minutes. An instant-read thermometer inserted into the center should read 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer sausages to a platter; cover and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in the pot used to cook the sausage over medium heat. Stir in milk and bring to a low simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually stir in about 3/4 of the Italian cheese blend until melted; reserve the remaining cheese for topping. Remove cheese sauce from heat, stirring occasionally to keep sauce smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a rolling boil. Cook the gnocchi at a boil until it floats to the top, about 3 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve sausage and gnocchi topped with cheese sauce and sprinkle with reserved cheese and basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
