  "ingredients": [
    "3 tablespoons butter",
    "2 tablespoons minced shallots",
    "2 cloves garlic, minced",
    "1 teaspoon dried tarragon",
    "0.25 teaspoon salt",
    "0.25 teaspoon white pepper",
    "0.25 cup white wine",
    "1 lemon, juiced",
    "1 tablespoon fresh parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m2JcMbFXwfkeWAP9I8WEs7110Ds=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/92911-wine-sauce-for-seafood-step-1-0677-1-f63e8db1de794fb68dc5b45bd8fb605a.jpg"
      ],
      "image": "assets/images/92911/step_01.webp"
    },
    {
      "text": "Melt butter in a small saucepan over medium-low heat. Add shallots and garlic; cook and stir until shallots are translucent, about 3 minutes. Season with tarragon, salt, and white pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PKXs9L51IoV4RLN5NkgBOAolBOA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/92911-wine-sauce-for-seafood-step-2-0680-1-59e3ce674b51451281f519907efc0903.jpg"
      ],
      "image": "assets/images/92911/step_02.webp"
    },
    {
      "text": "Increase heat to medium; stir in white wine and lemon juice. Bring to a simmer, then whisk for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YtIXcJcQaa2nFzA_W1kieJTH8yo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/92911-wine-sauce-for-seafood-step-3-0681-1-b7700fa9bae449bcb5553f8896e11fd2.jpg"
      ],
      "image": "assets/images/92911/step_03.webp"
    },
    {
      "text": "Remove from heat and sprinkle in parsley. Pour over your favorite white fish before serving.",
      "section": null,
