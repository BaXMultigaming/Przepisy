  "ingredients": [
    "1 cup milk",
    "1 cup white sugar",
    "6 ounces butter",
    "3 tablespoons golden syrup",
    "2 cups all-purpose flour",
    "1 tablespoon ground ginger",
    "1 teaspoon ground allspice",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour an 8x4-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, sugar, butter, and golden syrup in a small saucepan; bring to a boil, then remove from heat, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, ginger, allspice, and baking soda into a large bowl; stir in milk mixture until just blended. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in the preheated oven; reduce the oven temperature to 325 degrees F (160 degrees C). Bake until top springs back when lightly pressed, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
