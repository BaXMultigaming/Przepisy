  "ingredients": [
    "1 (14.4 ounce) package graham crackers, crushed",
    "0.5 cup butter, melted",
    "2 (8 ounce) packages cream cheese, softened",
    "1 (12 ounce) container frozen whipped topping (such as Cool Whip®), thawed",
    "1 cup white sugar",
    "1 cup white sugar",
    "0.75 cup water",
    "2 tablespoons cornstarch",
    "1 pinch salt",
    "0.25 cup mashed huckleberries",
    "1 teaspoon lemon juice",
    "1 teaspoon red food coloring",
    "1 cup huckleberries"
  ],
  "steps": [
    {
      "text": "Combine graham cracker crumbs and butter together in a bowl until evenly moistened; press into bottom of a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, whipped topping, and 1 cup sugar in a bowl until smooth; spread evenly over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup sugar, water, cornstarch, and salt in a saucepan over medium heat: cook and stir until clear, 3 to 5 minutes. Stir in mashed huckleberries, lemon juice, and red food coloring; simmer until thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread huckleberry mixture over cream cheese layer; scatter 1 cup whole huckleberries on top.",
      "section": null,
