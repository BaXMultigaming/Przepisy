  "ingredients": [
    "2 (16 ounce) packages frozen meatballs",
    "1 (18 ounce) bottle barbeque sauce",
    "1 (20 ounce) can pineapple chunks with juice",
    "1 medium onion, diced",
    "1 bell peppers, diced",
    "1 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Combine frozen meatballs, barbeque sauce, pineapple chunks and juice, onion, bell pepper, and garlic powder in a slow cooker. Mix all ingredients together until the meatballs are well covered with sauce using a large spoon. Put the lid on the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 4 to 6 hours, or High for 2 to 3 hours. Stir well before serving.",
