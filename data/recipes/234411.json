  "ingredients": [
    "1 tablespoon olive oil",
    "1 kielbasa sausage, cut into 1-inch pieces",
    "1 onion, diced",
    "1 tablespoon minced garlic",
    "3 (14 ounce) cans vegetable broth",
    "1 (14 ounce) can stewed tomatoes",
    "1.5 cups chopped carrots",
    "1 (8 ounce) can tomato sauce",
    "1 cup water",
    "1.5 teaspoons salt-free seasoning blend (such as Mrs. Dash®)",
    "1.5 cups bow-tie pasta (farfalle)"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat. Cook and stir sausage, onion, and garlic in hot oil until onion is slightly softened and browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir vegetable broth, stewed tomatoes, carrots, tomato sauce, water, and seasoning blend into sausage mixture; bring to a boil, reduce heat to low, and simmer for 30 minutes. Add bow-tie pasta and continue simmering until pasta is cooked through yet firm to the bite, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
