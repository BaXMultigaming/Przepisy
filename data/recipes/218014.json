  "ingredients": [
    "0.5 cup butter, melted",
    "1 cup white sugar",
    "1 cup self-rising flour",
    "0.75 cup milk",
    "2 cups fresh blackberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour melted butter into the bottom of an 8-inch square baking pan. Mix sugar, self-rising flour, and milk together until moistened; pour mixture over butter. Don't be tempted to stir. Spread blackberries evenly over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is golden brown and the cobbler is bubbling, about 45 minutes.",
      "section": null,
