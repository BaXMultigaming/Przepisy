  "title": "No Bake Sugar Free Cheese Cake",
  "description": "Finally a cheesecake that is easy to make, low in fat and even has no added sugar. Serve with a lemon sorbet.",
  "authors": [
    "Penny Lipchen"
  ],
  "date_published": "2000-03-23T23:10:53-05:00",
