  "ingredients": [
    "1 cup white sugar",
    "0.25 cup butter, cut into chunks",
    "2.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 cup milk",
    "0.25 cup butter, melted",
    "2 tablespoons brown sugar, or more to taste",
    "1 pinch ground cinnamon, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir white sugar and butter chunks together in a bowl with a spoon; add flour and baking powder. Slowly add milk to flour mixture while stirring until batter is just moistened. Spread batter into a 9x13-inch baking dish. Pour melted butter, brown sugar, and cinnamon evenly over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and set, 20 to 25 minutes.",
      "section": null,
