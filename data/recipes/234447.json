  "ingredients": [
    "1.5 cups chicken broth",
    "1 cup quinoa, rinsed",
    "Dijon mustard",
    "3 tablespoons olive oil",
    "1 1/2 tablespoons maple syrup",
    "1/4 teaspoon ground cinnamon",
    "salt and ground black pepper to taste",
    "1 large crisp apple, chopped into small pieces",
    "1 cup pecan pieces",
    "1/2 cup dried cranberries",
    "1/2 cup grated Parmesan cheese (Optional)"
  ],
  "steps": [
    {
      "text": "Bring chicken broth and quinoa to a boil in a saucepan. Reduce heat to low, cover, and simmer until broth is absorbed, about 10 minutes. Off heat, fluff quinoa with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, Dijon mustard, maple syrup, and cinnamon together in a bowl; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle maple syrup dressing over quinoa; stir. Stir in apple, pecans, cranberries, and Parmesan cheese. Return cover to the saucepan; let mixture steam until dressing warms and apples slightly soften, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
