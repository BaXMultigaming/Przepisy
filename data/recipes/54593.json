  "ingredients": [
    "3 tablespoons butter, softened",
    "12 slices white bread",
    "1.25 pounds ground beef",
    "1 egg",
    "1 small onion, chopped",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "salt and pepper to taste",
    "0.75 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter one side of each slice of bread, and press each slice butter-side down into the cups of a muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together ground beef, egg, onion, cream of mushroom soup, salt, and pepper until well blended. Fill each bread cup with mixture. Sprinkle shredded Cheddar cheese over the tops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes in the preheated oven, or until meat is cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
