  "ingredients": [
    "1 (40 ounce) can Bruce's Yams Cut Sweet Potatoes in Syrup, drained",
    "0.25 cup salted butter, melted",
    "2 eggs",
    "1 egg yolk",
    "1 (8 ounce) can crushed pineapple",
    "1 cup crushed cornflake crumbs",
    "2 tablespoons brown sugar",
    "1 cup mini marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (177 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sweet potatoes, 4 tablespoons butter, eggs, and egg yolk in a bowl with an electric mixer until smooth and creamy. Fold in pineapple; transfer to a 1 1/2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornflake crumbs, remaining 2 tablespoons butter, and brown sugar; spoon across top of casserole, in alternating rows at a diagonal, followed by a row of marshmallows. Repeat until you have 5 cornflake rows and 4 marshmallow rows.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until marshmallows have turned golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
