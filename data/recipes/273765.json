  "ingredients": [
    "0.5 cup tapioca starch",
    "0.5 teaspoon garlic powder",
    "0.75 teaspoon salt",
    "0.5 teaspoon black pepper",
    "1 pound boneless, skinless chicken breasts, cut into 1-inch pieces",
    "cooking spray",
    "4 ounces tomato sauce",
    "2 tablespoons gochujang (Korean hot pepper paste)",
    "2 tablespoons honey",
    "1 tablespoon soy sauce"
  ],
  "steps": [
    {
      "text": "Preheat air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tapioca starch, garlic powder, salt and pepper in a shallow dish. Dredge chicken pieces through the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a baking sheet with a cooling rack and place chicken on rack to let excess dredge fall off. Lightly grease chicken with cooking spray and place in the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 10 minutes, shaking the basket halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tomato sauce, gochujang sauce, honey, and soy sauce in a small bowl and drizzle over the chicken pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
