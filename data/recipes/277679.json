  "ingredients": [
    "0.5 (8 ounce) package cream cheese, softened",
    "1 tablespoon white sugar",
    "1 tablespoon mayonnaise",
    "0.5 (20 ounce) can crushed pineapple",
    "0.5 (14 ounce) can whole berry cranberry sauce",
    "2 tablespoons chopped pecans",
    "0.5 (8 ounce) container frozen whipped topping (such as Cool Whip®)",
    "0.5 cup miniature marshmallows",
    "1 (9 inch) prepared graham cracker crust"
  ],
  "steps": [
    {
      "text": "Blend cream cheese, sugar, and mayonnaise together in a bowl. Add pineapple, cranberry sauce, and pecans; mix to combine. Fold in frozen whipped topping and mini marshmallows.",
      "section": null,
      "name": null,
      "url": null,
