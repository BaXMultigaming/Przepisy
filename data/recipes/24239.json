  "title": "Vietnamese Fresh Spring Rolls",
  "description": "These Vietnamese spring rolls with rice noodles, shrimp, lettuce, fresh basil and mint are served with two delicious homemade Asian sauces for dipping.",
  "authors": [
    "Paula"
  ],
  "date_published": "2000-10-15T21:26:48-04:00",
