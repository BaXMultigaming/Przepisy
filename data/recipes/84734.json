  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups whole wheat flour",
    "4 teaspoons baking powder",
    "1.25 teaspoons baking soda",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon allspice",
    "3 teaspoons ground cinnamon",
    "0.25 teaspoon ground cloves",
    "1 teaspoon salt",
    "0.25 cup butter, softened",
    "0.5 cup applesauce",
    "2.25 cups sugar",
    "2 eggs, beaten",
    "1 (15 ounce) can pumpkin",
    "1 cup finely chopped pecans",
    "2 cups golden raisins",
    "3 tablespoons sugar",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together all-purpose and whole wheat flours, baking powder, and baking soda. Mix in ginger, allspice, cinnamon, cloves, and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate large bowl, cream butter until fluffy. Mix in applesauce, then slowly stir in 2 1/4 cups sugar until well blended. Mix in the eggs and pumpkin. Gradually mix the dry ingredients into the wet ingredients. Then stir in pecans and raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by heaping tablespoonfuls onto cookie sheets, leaving 2 inches between scones. Flatten scones with the back of the spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, stir together 3 tablespoons of sugar and cinnamon, and sprinkle on top of scones.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated oven until golden brown, about 12 to 14 minutes. Remove, and let cool on cookie sheets 5 minutes before removing to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
