  "ingredients": [
    "1 delicata squash, halved lengthwise and seeded",
    "0.5 cup vegetable broth",
    "1 pinch salt to taste",
    "1 lime, juiced",
    "1 tablespoon Sriracha sauce",
    "1 teaspoon white sugar",
    "0.5 teaspoon sesame oil",
    "0.25 teaspoon fish sauce"
  ],
  "steps": [
    {
      "text": "Place delicata squash halves, cut-sides down, in a microwave-safe bowl. Pour in vegetable broth, season with salt, and cover with a lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave until squash easily pierced with a knife, about 8 minutes. Carefully uncover bowl; drain broth. Flip squash; let cool 5 minutes then cut into smaller pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk lime juice, Sriracha, sugar, sesame oil, and fish sauce together in a small bowl until sugar dissolved; pour over squash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
