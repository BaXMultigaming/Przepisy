  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix peaches, blackberries, 1/2 cup gluten-free flour, white sugar, lemon juice, and cinnamon together in a bowl; spread evenly into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar, oats, and 3/4 gluten-free flour together in a separate bowl. Cut butter into oat mixture until it resembles coarse crumbs; sprinkle evenly over berry mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 45 minutes.",
      "section": null,
