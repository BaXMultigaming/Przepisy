  "ingredients": [
    "2 cups all-purpose flour",
    "0.75 cup firmly packed light brown sugar",
    "1 egg, beaten",
    "0.5 cup cold butter",
    "1 cup finely chopped peanuts",
    "1 (14 ounce) can sweetened condensed milk",
    "0.5 cup peanut butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, and egg in a large bowl. Cut in butter until mixture appears crumbly. Stir in chopped peanuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set 2 cups of the peanut crumble aside. Press remaining mixture into a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake crust in the preheated oven until lightly browned, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat condensed milk, peanut butter, and vanilla extract together in a large bowl. Spread over the prepared crust. Top with reserved peanut crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 25 minutes. Cool before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
