  "ingredients": [
    "2 cups half-and-half",
    "8 large eggs",
    "1.25 cups white sugar",
    "1 cup heavy cream",
    "2 tablespoons raisins",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon vanilla extract",
    "1 loaf white bread, torn into large chunks",
    "1 stick butter",
    "0.5 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine half-and-half, eggs, sugar, heavy cream, raisins, cinnamon, and vanilla extract in a bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bread pieces in the prepared pan; pour egg mixture over bread. Soak 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the baking pan into a larger pan. Fill the larger pan with boiling water halfway up the sides of the smaller pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into center comes out clean, 60 to 75 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a small skillet over low heat; transfer to a small bowl. Add confectioners' sugar; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Poke holes on the surface of bread pudding with a butter knife; pour butter sauce over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
