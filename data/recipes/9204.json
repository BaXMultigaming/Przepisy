  "ingredients": [
    "1 (15 ounce) can creamed corn",
    "1 (15.25 ounce) can whole kernel corn",
    "1 (8 ounce) container sour cream",
    "2 eggs",
    "0.5 cup butter",
    "2 tablespoons white sugar",
    "1 (8.5 ounce) package corn muffin mix"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix creamed corn, whole kernel corn, sour cream, eggs, melted butter, and sugar together in a bowl. Mix in muffin mix, then pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 35 to 40 minutes, or until a knife inserted in the center comes out clean.",
