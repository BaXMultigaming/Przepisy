  "ingredients": [
    "2.25 pounds mango slices",
    "1 cup white sugar, divided",
    "0.5 cup butter",
    "2 eggs",
    "0.5 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.25 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bottom of an 8x8-inch square pan with mango slices; sprinkle with 1/2 cup sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and remaining sugar in a bowl; cream together with a fork until smooth. Beat in eggs, 1 at a time, until combined. Stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour and baking powder together in a bowl. Pour flour mixture into butter mixture; stir until combined. Stir in milk slowly until smooth; spoon milk mixture over mangos.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
