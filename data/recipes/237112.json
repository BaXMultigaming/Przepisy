  "ingredients": [
    "1 cup mayonnaise",
    "3 tablespoons white sugar",
    "3 tablespoons vinegar",
    "2 tablespoons melted butter",
    "1 teaspoon tomato paste",
    "0.75 teaspoon paprika",
    "0.25 teaspoon cayenne pepper, or to taste",
    "0.25 teaspoon garlic powder, or to taste"
  ],
  "steps": [
    {
      "text": "Mix mayonnaise, sugar, vinegar, butter, tomato paste, paprika, cayenne pepper, and garlic powder together in a bowl until smooth; refrigerate until chilled, at least 30 minutes.",
