  "ingredients": [
    "1.5 pounds ground beef",
    "1 cup dry bread crumbs",
    "1 (15 ounce) can tomato sauce",
    "2 eggs",
    "1 teaspoon dried minced onion",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup white sugar",
    "2 tablespoons brown sugar",
    "2 tablespoons cider vinegar",
    "2 teaspoons prepared mustard"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, bread crumbs, 1/2 can tomato sauce, eggs, dried onion, salt, and black pepper until well mixed; transfer to a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Push down meatloaf into the pan forming a well for sauce around all edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine remaining 1/2 can tomato sauce, white sugar, brown sugar, vinegar, and mustard in a small saucepan over medium heat; bring to a boil, then remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sauce over top of meatloaf after 40 minutes of baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to oven; continue baking 20 minutes more. Let sit 5 minutes before removing from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
