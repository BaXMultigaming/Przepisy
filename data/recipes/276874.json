  "ingredients": [
    "1 cup butter, softened",
    "1 cup white sugar",
    "0.75 cup brown sugar",
    "0.5 cup cinnamon-flavored applesauce",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon coconut extract",
    "0.5 teaspoon almond extract",
    "1 cup cake flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 cup raisins",
    "4 (1.23 ounce) packages instant apple-cinnamon oatmeal",
    "0.5 cup dried cranberries",
    "1 cup whole wheat flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together butter, white sugar, brown sugar, applesauce, egg, vanilla, coconut extract, and almond extract in a large bowl until smooth in texture. Add cake flour, baking soda, and salt; mix until blended. Stir in raisins, instant oatmeal, and dried cranberries. Mix in whole wheat flour, 1/2 cup at a time, until blended. Drop tablespoon-sized scoops of dough onto a nonstick cookie sheet and flatten dough with a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 8 to 10 minutes. Place on a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
