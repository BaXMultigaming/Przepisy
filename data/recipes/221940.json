  "ingredients": [
    "2 whole artichokes",
    "1 tablespoon lemon juice",
    "1 clove garlic",
    "1 bay leaf"
  ],
  "steps": [
    {
      "text": "Cut and discard stems from artichokes, making sure bottoms of each artichoke are flat. Cut and discard top 1 inch (or so) of each artichoke. Snip thorny ends from each artichoke leaf with a pair of kitchen scissors.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill bottom of a pot with about 2 inches of water; add lemon, garlic, and bay leaf. Place a steamer basket in the pot, making sure the water does not flow over the bottom of the steamer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place artichokes in the basket, resting on flattened bottoms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water to a boil, cover the pot, and cook until leaves can be easily pulled from artichokes, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
