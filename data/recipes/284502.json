  "ingredients": [
    "1 small banana",
    "8 fresh blackberries",
    "0.5 cup pineapple juice",
    "0.5 cup freshly squeezed lime juice",
    "0.25 cup pomegranate juice",
    "0.25 cup Jamaican rum",
    "1 cup ice cubes",
    "0.5 cup chilled club soda"
  ],
  "steps": [
    {
      "text": "Set an oven rack 3 inches from the heat source of an oven and preheat the broiler. Cut banana into 3/4-inch slices. Arrange banana slices on a foil-lined baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until golden brown, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put broiled banana, 8 blackberries, pineapple juice, lime juice, pomegranate juice, and rum in a blender. Blend, dropping ice cubes, 1 at a time, through opening in lid, until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide among 2 hurricane glasses or other stemmed 12-ounce glasses. Top with chilled club soda and gently stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
