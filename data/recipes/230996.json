  "ingredients": [
    "1 prepared 9-inch single pie crust",
    "1 tablespoon olive oil",
    "4 green onions, chopped",
    "0.5 pound cooked ham, cubed",
    "1 cup fat-free egg substitute",
    "7 fluid ounces fat-free evaporated milk",
    "0.25 cup shredded part-skim mozzarella cheese",
    "1 tablespoon grated Parmesan cheese",
    "1 teaspoon chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Unroll pie crust and press into an 8-inch pie dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium heat; cook and stir green onions in hot oil until wilted and beginning to brown, 2 to 3 minutes. Remove from heat. Spread ham in pie crust and top with green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg substitute, evaporated milk, and mozzarella cheese in a bowl. Pour over ham mixture. Sprinkle with Parmesan cheese and chives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Increase heat to 350 degrees F (175 degrees C) and continue baking until quiche is browned, 15 to 20 minutes. Remove from the oven and allow quiche to rest until eggs are set, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
