  "ingredients": [
    "0.5 (16 ounce) package graham crackers",
    "2 cups chopped pecans",
    "0.5 cup white sugar",
    "0.5 cup butter",
    "0.5 cup margarine"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a baking sheet with graham crackers. Sprinkle evenly with pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, butter, and margarine in a small saucepan over medium heat. Bring to a boil and boil 3 minutes. Remove from heat and spoon mixture over pecans, coating well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 12 minutes. Cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
