  "ingredients": [
    "2 tablespoons olive oil",
    "2 tablespoons butter",
    "0.5 small red onion, diced",
    "1 tablespoon minced garlic",
    "1 bunch Swiss chard, stems and center ribs cut out and chopped together, leaves coarsely chopped separately",
    "0.5 cup dry white wine",
    "1 tablespoon fresh lemon juice, or to taste",
    "2 tablespoons freshly grated Parmesan cheese",
    "1 pinch salt to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cFQxpMmGY6EIC9v5hpTEeCSOrYw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/148889-sauteed-swiss-chard-with-parmesan-cheese-ddmfs-step1-0809-4x3-2845c8938e164bef8ea4b5e975a66bde.jpg"
      ],
      "image": "assets/images/148889/step_01.webp"
    },
    {
      "text": "Heat olive oil and butter together in a large skillet over medium-high heat. Stir in onion and garlic and sauté until fragrant, about 30 seconds. Add chard stems and white wine; simmer until the stems begin to soften, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KH_PUJbGLrsU_QHVk8V_dLi15L8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/148889-sauteed-swiss-chard-with-parmesan-cheese-ddmfs-step3-0813-4x3-571c5fbc76f44dfea0f856072365a07a.jpg"
      ],
      "image": "assets/images/148889/step_02.webp"
    },
    {
      "text": "Stir in the chard leaves and cook until just wilted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T77V3BtSlXOlDopT0xxOrKZ73PY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/148889-sauteed-swiss-chard-with-parmesan-cheese-ddmfs-step4-0816-4x3-c309ed3ec2e14e05928d225fe4b6860d.jpg"
      ],
      "image": "assets/images/148889/step_03.webp"
    },
    {
      "text": "Sprinkle lemon juice on top and stir to combine; add Parmesan cheese and season to taste with salt if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tp3uyWGoGhgVu3iayZ1WwZGmrnE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/148889-sauteed-swiss-chard-with-parmesan-cheese-ddmfs-step5-0817-4x3-2bc4f54ef6c3465f99f96cf4775c5b37.jpg"
      ],
      "image": "assets/images/148889/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
