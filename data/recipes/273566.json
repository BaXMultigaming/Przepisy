  "ingredients": [
    "4 fresh peaches - peeled, pitted, and sliced",
    "2 tablespoons brown sugar",
    "1 tablespoon lemon juice",
    "1 tablespoon butter",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place peach slices in center of a large sheet of heavy-duty aluminum foil. Sprinkle with lemon juice, brown sugar, and cinnamon; dot with butter. Fold edges of foil up to seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until peaches are tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
