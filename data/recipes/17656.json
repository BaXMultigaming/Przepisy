  "ingredients": [
    "1 cup white sugar",
    "0.5 cup shortening",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "3 medium ripe bananas"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease an 8x4-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and shortening with an electric mixer in a mixing bowl until creamy. Sift in flour, baking soda, and salt. Mix in mashed bananas. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
