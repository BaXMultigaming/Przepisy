  "ingredients": [
    "1.25 cups wheat bran",
    "1 cup buttermilk",
    "0.5 cup vegetable oil",
    "0.75 cup brown sugar",
    "1 egg",
    "1 tablespoon molasses",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup golden raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 12 cup muffin tin, or line with paper muffin liners. In a small bowl, mix together the wheat bran and buttermilk. Set aside to soak until thickened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, use an electric mixer to blend together the brown sugar, vegetable oil, egg and molasses. Stir in the bran mixture. Combine the flour, baking powder, baking soda and salt; stir into the batter until just moistened. Mix in raisins. Spoon batter into muffin cups, filling 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 20 minutes in the preheated oven, until the tops spring back when lightly pressed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
