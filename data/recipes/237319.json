  "ingredients": [
    "2 tablespoons butter",
    "1 medium yellow onion, diced",
    "2.5 pounds ground chuck",
    "1 cup dry bread crumbs",
    "0.75 cup buttermilk",
    "0.5 cup ketchup",
    "2 large eggs, beaten",
    "1 tablespoon Worcestershire sauce",
    "2.5 teaspoons salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon hot sauce",
    "0.5 teaspoon dried tarragon",
    "0.5 teaspoon Italian seasoning",
    "0.25 cup brown sugar",
    "1 tablespoon Dijon mustard",
    "1 teaspoon cider vinegar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with a silicone baking mat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the meatloaf: Melt butter in a skillet over medium-high heat. Add onion and sauté until soft and translucent, 6 to 7 minutes. Cool to room temperature, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooled onion, ground chuck, bread crumbs, buttermilk, ketchup, eggs, Worcestershire sauce, salt, pepper, hot sauce, tarragon, and Italian seasoning in a bowl; mix together with a fork and let sit until bread crumbs absorb moisture, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn meatloaf mixture out into the center of the prepared baking sheet and form into a 9x5-inch loaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the meatloaf is baking, make the glaze: Whisk brown sugar, mustard, and vinegar together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "After 45 minutes, remove meatloaf from the oven and spread brown sugar glaze over top. Return to the oven and continue baking until no longer pink in the center, about 30 minutes more. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
