  "ingredients": [
    "3 tablespoons olive oil",
    "4 thick cut boneless pork chops",
    "2 tablespoons dark brown sugar",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon dry mustard",
    "1 tablespoon fresh lemon juice",
    "1 (10 ounce) can tomato sauce",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a medium skillet over medium heat. Place pork chops in the skillet, and brown about 5 minutes on each side. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix brown sugar, salt, pepper, and dry mustard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange pork chops in a medium baking dish. Sprinkle with lemon juice, season with brown sugar mixture, and cover with tomato sauce. Pour water into the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and bake 1 hour in the preheated oven, to an internal temperature of 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
