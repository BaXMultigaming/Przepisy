  "ingredients": [
    "cooking spray",
    "2 (1 ounce) squares unsweetened chocolate",
    "2 cups grated zucchini",
    "1 cup unsweetened applesauce",
    "0.75 cup egg substitute",
    "1 teaspoon vanilla extract",
    "1.5 cups white sugar",
    "1 cup all-purpose flour",
    "1 cup whole wheat flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "1 teaspoon salt",
    "0.75 (1 ounce) square semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray 2 mini muffin tins with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate squares in a large microwave-safe glass or ceramic bowl in 15-second intervals, stirring after each melting, about 1 minute. Stir in zucchini, applesauce, egg substitute, and vanilla extract; beat well until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, all-purpose flour, whole wheat flour, baking soda, baking powder, cinnamon, and salt together in a large bowl. Add chocolate mixture; stir just until combined. Fold chocolate chips into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop batter into prepared muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
