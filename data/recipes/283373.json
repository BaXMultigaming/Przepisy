  "ingredients": [
    "2 medium apples",
    "2 tablespoons unsalted butter",
    "3 tablespoons brown sugar",
    "0.25 teaspoon ground cinnamon",
    "0.125 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Peel and core apples; cut into ¼-inch thick slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a sauté pan over medium heat; stir in brown sugar, cinnamon, and nutmeg. Add apples; cook until coated in sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the pan; steam, stirring frequently, until apples are soft, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
