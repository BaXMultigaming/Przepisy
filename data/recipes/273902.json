  "ingredients": [
    "2 (16 ounce) packages frozen corn",
    "2 (10.75 ounce) cans cream of potato soup",
    "1 (20 ounce) package frozen Southern-style hash browns",
    "2 cups chicken broth",
    "1 large onion, diced",
    "8 slices thick-cut bacon, cooked and crumbled",
    "1 jalapeno pepper, minced, or more to taste",
    "2 cups heavy cream",
    "1 cup small shrimp, peeled and deveined",
    "2 tablespoons chopped fresh parsley",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine corn, potato soup, hash browns, chicken broth, onion, bacon, and jalapeño in a large slow cooker; cover slow cooker. Cook on Low for 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée soup using an immersion blender until reaches desired consistency. Stir in cream, shrimp, parsley, salt, and black pepper; cover slow cooker. Cook on Low for 1 hour.",
