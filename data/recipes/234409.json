  "ingredients": [
    "5 slices bacon, or more to taste",
    "1 head fresh broccoli, diced",
    "1 head cauliflower, chopped",
    "0.75 cup shredded sharp Cheddar cheese",
    "0.25 red onion, chopped",
    "0.5 cup creamy salad dressing (such as Miracle Whip®)",
    "0.5 cup white sugar",
    "2 tablespoons white vinegar"
