  "ingredients": [
    "4 cups thinly sliced apples",
    "2 tablespoons white sugar, or more to taste",
    "1 tablespoon cornstarch",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon vanilla extract",
    "1 (9 inch) prepared pie crust (such as Pillsbury®)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine apples, sugar, cornstarch, cinnamon, and vanilla extract together in a bowl. Place pie crust on the prepared baking sheet. Spoon apple mixture into the center of crust, leaving a 2-inch border. Fold crust over the edges of the apple mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apples are tender and crust is golden, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
