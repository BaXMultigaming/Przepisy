  "ingredients": [
    "1 pound lean ground beef",
    "5 cups water",
    "1 (16 ounce) can diced tomatoes",
    "1 (10 ounce) package frozen corn kernels",
    "1 (8 ounce) can tomato sauce",
    "1 cup chopped carrots",
    "1 cup chopped celery",
    "1 cup chopped onion",
    "6 beef bouillon",
    "3 tablespoons ketchup",
    "1 teaspoon dried basil",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Mj-bKTfa1K3W_tS6xTDywbcbWrE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12921-Hamburger-Soup-ddmfs-031-step1-f2d9377ff3f5443dadfd74c1cdefadb7.jpg"
      ],
      "image": "assets/images/12921/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RzprkYwnv8oxRbZtq4DzDGNTsC0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12921-Hamburger-Soup-ddmfs-032-step2-ea96f25bf2cc43c5aa538725c89665bc.jpg"
      ],
      "image": "assets/images/12921/step_02.webp"
    },
    {
      "text": "Combine beef, water, tomatoes, corn, tomato sauce, carrots, celery, onion, bouillon, ketchup, basil, and salt in a large stockpot; bring to a boil. Reduce heat and simmer for at least 1 ½ hours.",
