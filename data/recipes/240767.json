  "ingredients": [
    "1 pound carrots, peeled",
    "1 tablespoon olive oil",
    "0.5 teaspoon garlic salt",
    "0.25 cup grated Parmesan cheese, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir olive oil and garlic salt together in a small bowl; pour into a large resealable plastic bag. Add carrots to the plastic bag, seal, and shake to coat carrots completely in oil mixture. Arrange coated carrots onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast carrots in preheated oven until crisp-tender, about 45 minutes. Sprinkle 1/4 cup Parmesan cheese over carrots and continue roasting until cheese is lightly browned, 5 to 10 minutes. Garnish with additional Parmesan cheese to serve, according to your taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
