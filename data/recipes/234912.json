  "ingredients": [
    "4 sweet potatoes, cut into cubes",
    "salt as needed",
    "2 tablespoons olive oil, or as needed",
    "1 white onion, chopped",
    "5 cloves garlic, chopped",
    "2 cups coconut milk",
    "1 cup heavy whipping cream",
    "0.5 teaspoon hot sauce",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place sweet potatoes into a large pot and cover with water and add a pinch of salt; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain. Mash sweet potatoes in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large pot over medium heat. Cook and stir onion and garlic in hot oil until golden brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mashed sweet potato into the onion and garlic. Pour coconut milk and heavy cream over the sweet potato mixture; stir. Season mixture with hot sauce, salt, and pepper. Reduce heat to low and cook until heated through and slightly thickened, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
