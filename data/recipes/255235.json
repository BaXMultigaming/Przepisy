  "ingredients": [
    "1 sweet potato, cubed",
    "3 eggs",
    "2 scoops vanilla protein powder",
    "0.5 cup milk",
    "0.5 cup oats, ground to flour",
    "0.25 cup flax seeds",
    "2 teaspoons pumpkin pie spice (such as Trader Joe's®)",
    "0.5 teaspoon baking powder",
    "1 large banana, sliced",
    "2.5 tablespoons almonds",
    "2.5 tablespoons pecans",
    "2.5 tablespoons walnuts",
    "2 tablespoons coconut oil, or as needed"
  ],
  "steps": [
    {
      "text": "Fill a pot with water; bring to a rolling boil. Add sweet potato; return to a boil. Cook until sweet potato is tender, 7 to 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash sweet potato in a small bowl with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup mashed sweet potato, eggs, protein powder, milk, oat flour, flax seeds, pumpkin pie spice, and baking powder in a bowl; stir in banana, almonds, pecans, and walnuts until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt coconut oil in a skillet over medium heat. Drop enough batter into the skillet to make a 4- to 6-inch pancake; cook until golden brown, 3 to 5 minutes. Flip; cook until browned on the other side, 3 to 5 minutes more. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
