  "ingredients": [
    "1 cup frozen raspberries",
    "1 cup frozen cherries",
    "2 tablespoons white sugar",
    "1 (9 inch) graham cracker pie crust",
    "1 cup quick cooking oats",
    "0.25 cup brown sugar",
    "1 teaspoon ground cinnamon",
    "1 tablespoon butter or margarine, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan, combine the raspberries, cherries and sugar. Cook over medium heat until soft. Remove from the heat and set aside. In a separate bowl, mix together the oats, brown sugar, cinnamon and melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a slotted spoon to spoon the fruit into the pie crust. Try not to add too much juice. Sprinkle the oat mixture over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 minutes in the preheated oven, or until oats are toasted and crisp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
