  "ingredients": [
    "0.5 cup butter",
    "0.5 cup shortening",
    "1.6667000055313 cups white sugar",
    "2.75 cups all-purpose flour",
    "1 teaspoon salt",
    "2 teaspoons baking powder",
    "3 eggs",
    "1.125 cups milk",
    "1 teaspoon vanilla extract",
    "1 teaspoon black walnut extract",
    "1 cup chopped black walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour two 9 inch round cake pans. Sift flour, salt and baking powder together and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream butter, shortening and sugar until light and fluffy. Add eggs one at a time and beat in well. Add flour mixture alternately with milk and mix well. Add vanilla and walnut extract. Fold in nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into 2 - 9 inch pans. Bake at 350 degrees F (175 degrees C) for 35 to 40 minutes, or until a toothpick inserted into the cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
