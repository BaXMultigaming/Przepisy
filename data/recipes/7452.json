  "ingredients": [
    "2 cups cake flour",
    "1 teaspoon baking powder",
    "0.125 teaspoon salt",
    "0.75 cup shortening",
    "1.5 cups white sugar",
    "1.5 teaspoons vanilla extract",
    "1 cup milk",
    "5 egg whites",
    "4 (2.15 ounce) milk chocolate covered caramel and nougat bars"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease and flour two 8 inch round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift cake flour and combine with baking powder, and salt. Set mixture aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With and electric mixer, beat shortening, sugar, and vanilla until fluffy. Add flour mixture and milk alternately to the shortening mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites until stiff peaks form. Fold egg whites into flour mixture then fold in chopped candy bars. Pour batter into prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 20 minutes. Let cakes cool in pans for 10 minutes then remove from pans. Drizzle with melted caramel if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
