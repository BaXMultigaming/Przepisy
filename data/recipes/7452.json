  "title": "Caramel Nougat Cake II",
  "description": "Layer cake make with candy bars, frosted and drizzled with melted caramel. M-m-mmmm!",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-05-10T21:54:14-04:00",
