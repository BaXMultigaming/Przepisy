  "ingredients": [
    "0.75 cup all-purpose flour",
    "1 tablespoon salt",
    "1 tablespoon ground black pepper",
    "1 tablespoon garlic powder",
    "12 skinless chicken wings",
    "1 quart vegetable oil for frying",
    "0.75 cup hot pepper sauce (such as Frank's RedHot®)",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Combine flour, salt, black pepper, and garlic powder in a 1-gallon resealable plastic bag; add chicken wings. Squeeze out excess air, seal the bag, and toss to evenly coat wings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove wings from the bag; shake off and discard any excess coating. Add wings carefully, in batches if necessary, to the hot oil; fry until no longer pink in centers, about 7 minutes. Transfer wings with a slotted spoon to a paper towel-lined plate; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine hot sauce and butter in a saucepan over medium heat; cook until heated through, about 5 minutes. Coat wings in sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
