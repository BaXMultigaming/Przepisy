  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend together the butternut squash, sweetened condensed milk, eggs, butter, vanilla, whipping cream, and sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into prepared casserole dish. Prepare topping, if desired: combine brown sugar, flour, 1/3 cup butter, and chopped nuts. Mix together and sprinkle over squash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
