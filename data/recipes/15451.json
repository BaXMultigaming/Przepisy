  "ingredients": [
    "3 cups mashed, cooked butternut squash",
    "0.5 cup sweetened condensed milk",
    "2 eggs, beaten",
    "0.5 cup butter, softened",
    "2 teaspoons vanilla extract",
    "0.5 cup heavy whipping cream",
    "1 cup white sugar",
    "1 pinch brown sugar",
    "0.33000001311302 dash all-purpose flour",
