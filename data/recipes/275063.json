  "ingredients": [
    "2 tablespoons kosher salt",
    "1 tablespoon freshly ground black pepper",
    "1 tablespoon smoked paprika",
    "1 teaspoon garlic powder",
    "0.25 teaspoon cayenne pepper",
    "1 teaspoon dried rosemary",
    "1 tablespoon chopped fresh rosemary leaves",
    "1 (2 1/2 pound) beef tri-tip roast",
    "0.5 cup beef broth"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 225 degrees F (110 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nGr51TUPu2cpSay2JFGsPc-ckfM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275063-the-best-beef-tri-tip-VAT-step-01-a55cc1eac0dd4e7db9537482f7735bd2.jpg"
      ],
      "image": "assets/images/275063/step_01.webp"
    },
    {
      "text": "Mix salt, pepper, paprika, garlic powder, cayenne, dried rosemary, and fresh rosemary together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-bY_ugqE0F-5hnNv3j4jl7M-0jo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275063-the-best-beef-tri-tip-VAT-step-02-f23dbf48ee6b4f39940ef2e464402e90.jpg"
      ],
      "image": "assets/images/275063/step_02.webp"
    },
    {
      "text": "Place tri-tip in a baking pan. Season generously with the spice rub until both sides are completely covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T73Hi_treK6pVatWWOFgLOZ5vM4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275063-the-best-beef-tri-tip-VAT-step-03-ae6c93cf307d495cb01a07dcfca9e77a.jpg"
      ],
      "image": "assets/images/275063/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until an instant-read thermometer inserted into the thickest part reads 130 degrees F (54 degrees C) for medium-rare, or until desired doneness, 1 1/2 to 2 hours. Flip meat over halfway.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4qIKHiLY8NgHNvok3ZYdCcZlzMU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275063-the-best-beef-tri-tip-VAT-step-04-cbd3fdbf86c44f8797cdc97d64a70051.jpg"
      ],
      "image": "assets/images/275063/step_04.webp"
    },
    {
      "text": "Cover pan with aluminum foil and let meat rest for 20 minutes. Remove tri-tip to a cutting board and cut into 2 pieces along where the grain changes direction. Slice meat across the grain and transfer to serving plates.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K7lbcKLQNpa-_fErVtnCIvfUs2c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275063-the-best-beef-tri-tip-VAT-step-05-841368aac7d849d5ba34940a053ad563.jpg"
      ],
      "image": "assets/images/275063/step_05.webp"
    },
    {
      "text": "Mix beef broth in with the pan drippings and drizzle over the slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5-64NEeA6mEsr1xNbWTZVra8sOM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275063-the-best-beef-tri-tip-VAT-step-06-a9d4d1a184a34556ac25f126b27ffa7e.jpg"
      ],
      "image": "assets/images/275063/step_06.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gOOfVdE-ZhOxpzK1PLXwtReQbW0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275063-the-best-beef-tri-tip-VAT-Beauty-4x3-998eb10a88584430967f7d0023ca1da7.jpg"
      ],
      "image": "assets/images/275063/step_07.webp"
    }
