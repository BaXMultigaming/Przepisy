  "ingredients": [
    "6 tablespoons plain yogurt",
    "2 cloves garlic, crushed",
    "1 teaspoon ground cumin",
    "1 teaspoon ground turmeric",
    "1 teaspoon freshly grated ginger",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon chile flakes",
    "0.5 teaspoon ground cinnamon",
    "4 (5 ounce) skinless, boneless chicken breast halves",
    "metal skewers"
  ],
  "steps": [
    {
      "text": "Combine yogurt, garlic, cumin, turmeric, ginger, pepper, chile flakes, and cinnamon in a glass or ceramic bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chop chicken into small chunks and add to the yogurt mixture. Cover with plastic wrap and marinate in the refrigerator for 4 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from the refrigerator and thread onto skewers. Place on the preheated grill and cook, turning occasionally, until no longer pink in the center and the juices run clear, about 15 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
