  "title": "Steak and Rice",
  "description": "Steak and rice cooked with green bell peppers, a can of diced tomatoes, and a tasty soy-garlic sauce. A great choice for a quick and easy dinner.",
  "authors": [
    "Christine Ropeter"
  ],
  "date_published": "1999-10-02T22:21:57-04:00",
  "date_modified": "2023-01-16T10:57:22-05:00",
