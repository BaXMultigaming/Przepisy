  "ingredients": [
    "2.5 pounds ground beef",
    "0.5 cup bread crumbs",
    "0.5 cup dried minced onion",
    "2 tablespoons dried cilantro",
    "2 teaspoons onion powder",
    "2 teaspoons garlic powder",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "11 ounces chipotle peppers in adobo sauce",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix beef, bread crumbs, dried onion, cilantro, onion powder, garlic powder, salt, and black pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Finely chop chipotle peppers and add peppers, adobo sauce, and egg to meat mixture. Mix well. Roll into 1 1/2-inch meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over high heat. Brown meatballs in the hot skillet, turning as needed, 3 to 5 minutes. Transfer to a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the centers, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
