  "ingredients": [
    "1 (3 pound) roasted chicken",
    "1 (15 ounce) can corn",
    "1 (16 ounce) can sliced carrots, drained",
    "1 (12 ounce) jar chicken gravy",
    "1 (12 ounce) jar turkey gravy",
    "3 cups prepared stuffing"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred or tear chicken into bite-sized pieces, removing as much chicken as possible, or as much as you think you need; place torn chicken in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add corn and carrots; pour chicken gravy and turkey gravy on top. Mix well and sprinkle stuffing over top to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for about 30 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
