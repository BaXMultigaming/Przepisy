  "ingredients": [
    "1 pound lean ground beef",
    "0.25 cup honey mustard",
    "0.25 cup brown sugar",
    "2 teaspoons onion powder",
    "2 teaspoons crushed red pepper",
    "1 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "2 tablespoons olive oil",
    "4 slices Swiss cheese",
    "4 hamburger buns"
  ],
  "steps": [
    {
      "text": "Combine ground beef, honey mustard, brown sugar, onion powder, red pepper flakes, garlic powder, and salt in a large bowl; shape into 4 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Add patties; cook, turning occasionally, until desired doneness is reached, 15 to 20 minutes for well done. Top each patty with 1 cheese slice shortly before removing from the skillet. Serve on hamburger buns.",
