  "ingredients": [
    "0.5 cup unsalted butter",
    "3 (1 ounce) squares unsweetened chocolate",
    "1.5 cups white sugar",
    "4 large eggs",
    "3 tablespoons light corn syrup (such as Karo®)",
    "1 teaspoon vanilla extract",
    "1 (9 inch) ready-to-use refrigerated pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter and chocolate in a pan over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat. Add sugar, eggs, corn syrup, and vanilla; stir until well combined. Pour into the pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until mostly set but slightly jiggly, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and cool to room temperature before serving; filling will thicken as it cools.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
