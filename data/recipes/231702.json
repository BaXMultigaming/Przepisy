  "title": "Chef John's Baked Lemon Pepper Salmon",
  "description": "This baked lemon-pepper salmon recipe uses lots of lemon juice and black pepper, along with mustard, miso, and mayo for flavorful wild salmon fillets.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2013-03-07T18:54:24-05:00",
