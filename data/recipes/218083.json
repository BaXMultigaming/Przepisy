  "ingredients": [
    "3 cups water",
    "2.5 tablespoons white sugar",
    "1.5 tablespoons kosher salt",
    "4 (1-inch thick) pork chops",
    "2 sprigs fresh thyme",
    "1 sprig fresh rosemary"
  ],
  "steps": [
    {
      "text": "Whisk water, sugar, and salt together in a bowl; pour into a gallon-sized resealable plastic bag. Add pork, thyme, and rosemary, coat pork with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pork chops from marinade and shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until no longer pink in centers, about 10 minutes per side. An instant-read thermometer inserted into centers should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
