  "ingredients": [
    "1 pound uncooked orzo pasta",
    "2 tablespoons butter",
    "3 tablespoons olive oil",
    "4 onions, sliced",
    "6.5 ounces blue cheese, crumbled",
    "3.5 ounces mascarpone cheese",
    "2 cups shredded spinach",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While pasta is cooking, heat butter and oil in a large skillet over low heat. Cook onion in this mixture until golden brown, 20 to 30 minutes. Remove from pan with a spoon and drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine blue cheese, mascarpone and onion and mix well. Toss cheese mixture with spinach and pasta, season with salt and pepper and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
