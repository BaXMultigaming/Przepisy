  "ingredients": [
    "2 cups all-purpose flour",
    "1.5 cups white sugar",
    "0.25 cup unsweetened cocoa powder",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1.25 cups 2% milk",
    "1 large egg, lightly beaten",
    "2 tablespoons butter, melted",
    "6 teaspoons vanilla extract, divided",
    "1 tablespoon vegetable oil",
    "6 cups confectioners' sugar",
    "4 tablespoons hot water, or more as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease doughnut pans well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, white sugar, cocoa powder, baking powder, and salt together into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, egg, butter, 2 teaspoons vanilla extract, and oil together in a small bowl; stir into flour mixture until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared doughnut pans, filling each well 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into a doughnut comes out clean, about 10 minutes. Cool doughnuts in the pans about 5 minutes, then tap onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine confectioners' sugar, hot water, and remaining 4 teaspoons vanilla extract in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place parchment paper under a wire rack. Transfer cooled doughnuts to the rack; coat in confectioners' sugar glaze, letting excess drip onto parchment paper. Coat doughnuts a second time if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
