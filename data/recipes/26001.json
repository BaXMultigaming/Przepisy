  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "1 teaspoon baking soda",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.5 cup buttermilk",
    "0.5 cup butter",
    "0.5 cup vegetable oil",
    "1 cup water",
    "0.5 cup unsweetened cocoa powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour an 11x17 inch sheet cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, sift together the flour, sugar and baking soda. Stir in the eggs, vanilla and buttermilk. Set aside. In a saucepan combine butter, oil, cocoa and water. Bring to a boil and stir until smooth. Slowly blend into the flour mixture. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 to 20 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
