  "ingredients": [
    "1 pound lean ground beef",
    "1 onion, finely diced",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "1 cup instant rice",
    "2 teaspoons white sugar",
    "1 tablespoon garlic powder",
    "1 teaspoon dried thyme",
    "1 teaspoon dried oregano",
    "6 slices American cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ground beef and onions in a large, deep skillet. Cook over medium-high heat until beef is evenly brown. Drain any excess fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomatoes, condensed soup, rice, sugar, garlic powder, thyme, and oregano. Mix well and cook over medium heat for 10 minutes. Place in a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with cheese slices and bake until cheese is bubbling and browning, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
