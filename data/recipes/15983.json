  "title": "Granny&#39;s Cherokee Casserole",
  "description": "A delicious casserole with cream of mushroom soup, tomatoes, rice, and onions with browned ground beef, covered with cheese in a baked one-dish meal.",
  "authors": [
    "Heather Denard"
  ],
  "date_published": "1999-11-24T17:26:09-05:00",
