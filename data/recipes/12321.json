  "ingredients": [
    "1 tablespoon cornstarch",
    "2 tablespoons cold water",
    "0.5 cup boiling water",
    "1 teaspoon vanilla extract",
    "3 egg whites",
    "6 tablespoons white sugar",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Blend cornstarch and cold water in a saucepan. Add boiling water, and cook until thick and clear. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites till foamy. Gradually beat in sugar, beating until stiff and glossy. Add salt and vanilla, and slowly beat in cold cornstarch mixture. Beat quickly for several minutes. Spread meringue on filled, cooled 9-inch pie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pie at 350 degrees F (175 degrees C) for 10 minutes until tips of meringue begin to brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
