  "ingredients": [
    "6 tablespoons olive oil",
    "1 onion, chopped",
    "1 tablespoon chopped garlic",
    "1 large green bell pepper, chopped",
    "1 tablespoon dried basil",
    "1 tablespoon dried oregano",
    "1 (.18 ounce) packet chicken bouillon granules",
    "2 (28 ounce) cans crushed tomatoes",
    "1 (6 ounce) can tomato paste",
    "2 teaspoons poultry seasoning",
    "1 teaspoon white sugar, or as needed",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a pot over medium heat. Add onion and garlic; cook 1 minute. Stir in green bell pepper; season with basil, oregano, and chicken bouillon. Stir in crushed tomatoes and tomato paste; season with poultry seasoning. Cook and stir 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar into sauce; season with salt and black pepper. Reduce heat to low; simmer 3 to 4 hours.",
