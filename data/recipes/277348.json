  "ingredients": [
    "nonstick cooking spray",
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "1 cup vegetable oil",
    "4 large eggs",
    "0.66666668653488 cup orange juice",
    "1 tablespoon baking powder",
    "2.5 teaspoons vanilla extract",
    "0.5 teaspoon salt",
    "1.5 cups fresh cranberries",
    "1 orange, zested"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 10-inch Bundt pan with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat flour, sugar, oil, eggs, orange juice, baking powder, vanilla, and salt in a large bowl with an electric mixer until thoroughly incorporated. Stir in cranberries and orange zest; pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour. Rest cake for 15 minutes, then invert onto a wire rack to cool for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
