  "ingredients": [
    "0.5 cup whole milk",
    "1.5 cups dark brown sugar",
    "0.75 cup unsalted butter",
    "6 tablespoons light corn syrup",
    "salt as needed",
    "1 (1 pound) loaf challah bread, cut into 1/2-inch slices",
    "4 large eggs, beaten",
    "1.5 teaspoons vanilla extract",
    "3 tablespoons white sugar",
    "1.5 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 cup whole milk, brown sugar, butter, corn syrup, and 1/8 teaspoon salt in a saucepan over medium heat; cook, stirring constantly, until sugar dissolves and syrup is smooth, about 5 minutes. Pour syrup into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bread slices over syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk remaining 2 1/2 cups milk, eggs, vanilla, and remaining 1/4 teaspoon salt in a bowl; pour over bread. Cover baking dish with plastic wrap; refrigerate 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Remove casserole from refrigerator; uncover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar and cinnamon in a small bowl; sprinkle over casserole. Cover baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Remove foil; continue baking until casserole is cooked through and eggs are set, 25 to 30 minutes. The casserole will be syrupy and should thicken as it cools.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
