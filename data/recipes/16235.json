  "ingredients": [
    "2 pounds ground beef",
    "0.5 medium onion, chopped",
    "2.5 cups tomato sauce",
    "1 (15 ounce) can light red kidney beans",
    "1 (15 ounce) can dark red kidney beans",
    "1 (8 ounce) jar salsa",
    "0.25 cup chili seasoning mix",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon garlic salt"
  ],
  "steps": [
    {
      "text": "Place ground beef and onion into a large nonstick saucepan over medium heat. Cook and stir until beef is browned and crumbly and onion is translucent, about 10 minutes. Drain grease if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomato sauce, light and dark kidney beans, salsa, chili seasoning, pepper, and garlic salt until well combined. Reduce the heat to low and simmer for at least 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
