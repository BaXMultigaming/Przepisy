  "title": "Homemade Soft Pretzels",
  "description": "This pretzel recipe makes soft and buttery homemade pretzels from scratch; the dough is shaped into knots, dipped in hot water solution, and quickly baked.",
  "authors": [
    "CHRISTA ROSE"
  ],
  "date_published": "2020-06-18T23:05:26-04:00",
