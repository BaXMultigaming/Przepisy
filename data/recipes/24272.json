  "ingredients": [
    "4 teaspoons active dry yeast",
    "1 teaspoon white sugar",
    "1.25 cups warm water (110 degrees F/45 degrees C), or more as needed",
    "5 cups all-purpose flour",
    "0.5 cup white sugar",
    "1.5 teaspoons salt",
    "1 tablespoon vegetable oil, or more as needed",
    "4 cups hot water",
    "0.5 cup baking soda",
    "0.25 cup kosher salt, for topping"
  ],
  "steps": [
    {
      "text": "Dissolve yeast and 1 teaspoon sugar in 1 ¼ cups warm water in a medium bowl; let stand until yeast softens and begins to form a creamy foam, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mdbRD1qclexj6EQtxRiRCjghgyQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24272-buttery-soft-pretzels-step1-2728-e9782e9ceb7b411ca88a334ed5590c8e.jpg"
      ],
      "image": "assets/images/24272/step_01.webp"
    },
    {
      "text": "Combine flour, ½ cup sugar, and 1 ½ teaspoons salt in a large bowl; make a well in the center. Add yeast mixture and 1 tablespoon oil to the well; mix well and form into a dough. If mixture is dry, add 1 or 2 more tablespoons water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pXaT9PwSP23s7YvGN-nZNNAS3WQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24272-buttery-soft-pretzels-step2-2729-3137de893d954a769d31f8a4daa40e66.jpg"
      ],
      "image": "assets/images/24272/step_02.webp"
    },
    {
      "text": "Knead dough until smooth, about 7 minutes. Lightly oil a large bowl; place dough in the oiled bowl and turn to coat. Cover the bowl with plastic wrap; let rise in a warm place until doubled in volume, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UuW6N-TR8fQCEYNwlx0TLj0Y8bs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24272-buttery-soft-pretzels-step3-2732-883d1ebd004b4b6ab6c08ceff22e34df.jpg"
      ],
      "image": "assets/images/24272/step_03.webp"
    },
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 4 cups hot water into a large bowl; stir in baking soda until dissolved. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a lightly floured surface; divide into 12 equal pieces. Roll each piece into a rope; twist into a pretzel shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3yrcBNkpZ0gad6gcrSLrpXRMNjo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24272-buttery-soft-pretzels-step4-2755-8d142ff0e05f444a9f148229455d2c80.jpg"
      ],
      "image": "assets/images/24272/step_06.webp"
    },
    {
      "text": "Once all dough is shaped, dip each pretzel into hot water-baking soda solution; place on the prepared baking sheets. Sprinkle with kosher salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PpZgzUvFExB5NUWrGxuLOkkaMzo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24272-buttery-soft-pretzels-step6-2759-1-1f788cac24d2414a85de8c5f2ca6df60.jpg"
      ],
      "image": "assets/images/24272/step_07.webp"
    },
    {
      "text": "Bake in preheated oven until browned, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IZi7FE2k4B8VA_VkAEaoac1CUY0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24272-buttery-soft-pretzels-DDMFS-4x3-4a474236a103453cb90039cee8ac0ad5.jpg"
      ],
      "image": "assets/images/24272/step_09.webp"
    }
