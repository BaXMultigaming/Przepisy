  "ingredients": [
    "1 cup butter, divided, softened",
    "0.5 cup plain dry bread crumbs",
    "2.6666667461395 cups all-purpose flour",
    "1 cup white sugar",
    "1 cup milk",
    "1 tablespoon ground cardamom",
    "2 teaspoons baking powder",
    "2 tablespoons ground cinnamon",
    "2 tablespoons pearl sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a fluted tube pan (such as Bundt®) with 1/4 cup butter and dust with bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 3/4 cup butter, flour, sugar, milk, cardamom, and baking powder together lightly in a bowl to form a moderately stiff and lumpy dough; transfer dough to the prepared tube pan. Sprinkle cinnamon and pearl sugar over the top of the dough, respectively.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
