  "ingredients": [
    "2 cups colored rotini pasta",
    "1 cup mayonnaise",
    "1 tablespoon red wine vinegar",
    "1 clove garlic, minced",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1.5 tablespoons chopped fresh basil",
    "1 cup chopped tomatoes",
    "0.5 cup chopped yellow bell pepper",
    "0.5 cup sliced black olives"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in rotini and return to a boil. Cook pasta uncovered, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and rinse with cold water; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, vinegar, garlic, salt, and black pepper together in a large bowl until combined. Stir in basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in rotini, tomatoes, bell pepper, and olives gently until combined. Chill in the refrigerator for 3 hours to overnight. Stir gently before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
