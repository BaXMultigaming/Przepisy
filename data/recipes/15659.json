  "ingredients": [
    "2 (9 inch) pie shell",
    "2 cups water",
    "0.5 cup white sugar",
    "2 tablespoons all-purpose flour",
    "0.25 teaspoon salt",
    "0.5 teaspoon vanilla extract",
    "1 tablespoon butter",
    "1 tablespoon lemon juice",
    "2 cups raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (225 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan, combine water, sugar, flour, salt, vanilla, butter or margarine, and lemon juice. Mix well, then stir in raisins. Simmer over low heat for 10 minutes, stirring frequently. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour raisin mixture into a pastry-lined pie pan. Cover with second pastry. Seal edges and cut steam vents on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes, then lower the heat to 350 degrees F (175 degrees C) and bake an additional 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
