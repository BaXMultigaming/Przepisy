  "title": "Braised Oxtail Stew",
  "description": "A rich, red wine-based broth with tender braised oxtail and vegetables ensures this hearty stew will get plenty of compliments from family and friends.",
  "authors": [
    "fed1999"
  ],
  "date_published": "2012-12-03T15:08:49-05:00",
