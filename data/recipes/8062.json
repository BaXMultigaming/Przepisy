  "title": "Ice Cream Cone Treats",
  "description": "Cupcakes are baked in cones, then topped with a swirl of vanilla frosting to truly resemble ice cream in a cone. Great fun for birthdays!",
  "authors": [
    "Dee Akeson"
  ],
  "date_published": "1998-08-25T19:38:17-04:00",
