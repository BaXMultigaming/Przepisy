  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix",
    "1 cup water",
    "0.5 cup vegetable oil",
    "3 large eggs",
    "30 flat bottomed ice cream cones",
    "1 (16 ounce) container vanilla frosting",
    "1 ounce colored candy sprinkles"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cake mix, water, oil, and eggs in large bowl with mixer on medium speed (or beat vigorously by hand for 2 minutes.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place each ice cream cone with its flat bottom in the cup of a standard nonstick muffin pan (you will need two pans). Pour enough batter into each cone to fill 1/2 to 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the centers comes out clean, 12 to 17 minutes. Remove from the oven and let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Frost with frosting and decorate with sprinkles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
