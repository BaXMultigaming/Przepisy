  "ingredients": [
    "1.5 cups wheat bran",
    "1 cup low-fat buttermilk",
    "1 cup all-purpose flour",
    "0.25 cup packed brown sugar",
    "1 teaspoon baking soda",
    "2 egg whites",
    "0.5 apple, grated"
  ],
  "steps": [
    {
      "text": "In a small bowl, combine bran and buttermilk. Set aside to soak for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease muffin pan, or use paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together flour, brown sugar and baking soda. Stir in bran mixture and egg whites. Fold in grated apple. Divide batter into 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 16 to 18 minutes, or until a toothpick inserted into the center comes out clean. Allow to cool for 5 minutes before removing from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
