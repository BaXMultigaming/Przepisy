  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "4 cups confectioners' sugar",
    "1.5 teaspoons vanilla extract",
    "12 ounces white chocolate, chopped",
    "0.75 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Grease an 8x8 inch baking dish. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, beat cream cheese, sugar, and vanilla until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the top of a double boiler over lightly simmering water, heat white chocolate, stirring until melted and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold melted white chocolate and pecans into cream cheese mixture. Spread into prepared baking dish. Chill for 1 hour, then cut into 1 inch squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
