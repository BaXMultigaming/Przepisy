  "ingredients": [
    "0.25 cup butter",
    "2 tablespoons olive oil",
    "1 teaspoon coarse salt",
    "0.25 teaspoon ground black pepper",
    "3 cloves garlic, minced",
    "1 pound fresh asparagus spears, trimmed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
