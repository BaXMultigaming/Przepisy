  "title": "Grilled BBQ Short Ribs with Dry Rub",
  "description": "These grilled short ribs are fall-off-the-bone tender thanks to foil packets that keep all the savory flavor inside. Beef ribs never tasted so good.",
  "authors": [
    "Reynolds KitchensR"
  ],
  "date_published": "2014-06-12T15:42:49-04:00",
