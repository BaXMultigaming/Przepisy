  "ingredients": [
    "1 cup whole oats",
    "1 cup oat flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking soda",
    "2 eggs",
    "0.5 cup dark chocolate-flavored almond milk",
    "0.5 cup brown sugar",
    "1 teaspoon vanilla extract, or to taste",
    "0.5 cup dry-roasted cocoa almonds",
    "0.5 cup semi-sweet chocolate chips",
    "0.5 cup shredded coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, oat flour, salt, and baking soda in a bowl. Add eggs, almond milk, brown sugar, and vanilla extract and mix well. Fold almonds, chocolate chips, and coconut into oats mixture; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set in the middle, about 40 minutes. Cool before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
