  "title": "German Stollen",
  "description": "A very traditional German stollen that is popular all over Germany in the Christmas season with raisins, candied citrus peel, and almonds.",
  "authors": [
    "Marianne"
  ],
  "date_published": "2020-06-19T00:25:45-04:00",
