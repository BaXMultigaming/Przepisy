  "ingredients": [
    "8 cups all-purpose flour",
    "3 ounces compressed fresh yeast",
    "1 pinch white sugar",
    "1 tablespoon lukewarm milk",
    "1.5 cups milk",
    "1 cup unsalted butter",
    "2 tablespoons unsalted butter",
    "1 cup white sugar",
    "2 egg yolks",
    "0.5 teaspoon salt",
    "1.75 cups chopped blanched almonds",
    "1.25 cups raisins",
    "6 tablespoons candied lemon peel",
    "6 tablespoons chopped candied orange peel",
    "2 tablespoons melted butter",
    "2 tablespoons confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LID5xBVF-ivpuwBGOAx-4kYayPQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261646-german-stollen-ddmfs-step-1-BG-25888-c398a73104484c2d9fc4035925c91959.jpg"
      ],
      "image": "assets/images/261646/step_01.webp"
    },
    {
      "text": "Place flour in a large bowl, make a well in the center, and crumble fresh yeast into it. Sprinkle in sugar and add 1 tablespoon milk. Cover and let rise at a warm place for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tXAbR3RWL4tvuHVVvwALNqgl-_o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261646-german-stollen-ddmfs-step-3alt-BG-25895-c511fb12150b4ae1afb52b1202baf1de.jpg"
      ],
      "image": "assets/images/261646/step_02.webp"
    },
    {
      "text": "Heat 1 1/2 cups milk and 1 cup plus 2 tablespoons unsalted butter in a saucepan over low heat until butter is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3uXTqfGhjWIzpg4L0FQKOBoCkMw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261646-german-stollen-ddmfs-step-4-BG-25898-7392224ede8149cab6f7f575916afcb6.jpg"
      ],
      "image": "assets/images/261646/step_03.webp"
    },
    {
      "text": "Pour milk-butter mixture over yeast mixture and add 1 cup sugar, egg yolks, and salt. Knead until a soft dough forms. Cover with a clean dish towel and let rise in a warm place until doubled in volume, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/93dyZuT1vrSKM2QjlfziTkPMchg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261646-german-stollen-ddmfs-step-7-BG-26032-43e54dfa52ec47d0af5d137314151918.jpg"
      ],
      "image": "assets/images/261646/step_04.webp"
    },
    {
      "text": "Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix almonds, raisins, candied lemon peel, and candied orange peel together and fold into the dough. Shape dough into a loaf and place on the prepared baking sheet. Cover and let rest until the loaf has risen again slightly, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mOqY9u6w4qZpn7kF6fC5n37bx6M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261646-german-stollen-ddmfs-step-9-BG-26037-c7af1d91644b474dad330fabdc2fcbae.jpg"
      ],
      "image": "assets/images/261646/step_06.webp"
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until toothpick inserted in the middle comes out clean, 45 to 60 minutes. Remove from oven. Brush hot stollen immediately with 2 tablespoons melted butter and dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I9AdbVaTOE60RE0QXwfjgeHHaNc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261646-german-stollen-ddmfs-step-12-BG-26100-b61e92f68a9142e586f3636e6b2a2657.jpg"
      ],
      "image": "assets/images/261646/step_08.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/unLXQtRFvccH9yJXt6NSO0hZjV0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261646-german-stollen-ddmfs-Beauty-4x3-26136-abf3d16e2cba42b3a61f764b48a7a07c.jpg"
      ],
      "image": "assets/images/261646/step_09.webp"
    }
  ],
