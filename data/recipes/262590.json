  "ingredients": [
    "3 large avocados - peeled, pitted, and mashed",
    "1 lime, juiced",
    "salt to taste",
    "1 large plum tomato, seeded and chopped",
    "0.5 white onion, chopped",
    "1 serrano chile, seeded and finely chopped",
    "2 tablespoons chopped fresh cilantro",
