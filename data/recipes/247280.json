  "ingredients": [
    "5 pounds beef brisket, trimmed of fat",
    "3 tablespoons mustard, or as needed",
    "2 tablespoons brisket rub (such as Fiesta®), or as needed"
  ],
  "steps": [
    {
      "text": "Coat beef brisket with mustard. Cover with brisket rub. Let marinate in the refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove brisket from the refrigerator and bring to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a smoker to 220 degrees F (104 degrees F) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beef brisket in the smoker and smoke until easily pierced with a knife and an instant-read thermometer inserted into the center reads 190 degrees F (88 degrees C), 6 1/4 to 7 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap brisket with aluminum foil and let rest for 30 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
