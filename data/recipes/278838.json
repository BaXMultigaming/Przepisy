  "ingredients": [
    "1 pound ground beef",
    "2 cups cooked white rice",
    "2 tablespoons water",
    "1.5 tablespoons chopped red bell pepper",
    "1 tablespoon chopped fresh garlic",
    "12 (6 inch) corn tortillas, or more to taste",
    "2 cups salsa",
    "1.5 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cooked rice, water, bell pepper, and garlic to the beef in the skillet; stir and cook until heated through, 3 to 5 minutes. Spoon onto tortillas and roll to close. Place taquitos tightly against each other in an 8x12-inch baking pan. Pour salsa over and top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
