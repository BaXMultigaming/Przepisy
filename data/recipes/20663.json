  "ingredients": [
    "1 cup white sugar",
    "1 cup brown sugar",
    "4 eggs",
    "0.5 cup vegetable oil",
    "1 teaspoon vanilla extract",
    "3.5 cups all-purpose flour",
    "2 teaspoons ground cinnamon",
    "1.5 teaspoons baking soda",
    "0.5 teaspoon salt",
    "2 cups peeled, chopped zucchini",
    "1 cup chopped, peeled apple",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Gather all the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GXfhRrUUUjA9ijQVVsIdZ9TPNx4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20663-zucchini-apple-bread-DDMFS-28402-step-01-05dfc236bb5f4a719fcebd2bc934b797.jpg"
      ],
      "image": "assets/images/20663/step_01.webp"
    },
    {
      "text": "Whisk white sugar, brown sugar, eggs, oil, and vanilla extract together in a bowl until well blended. Combine flour, cinnamon, baking soda, and salt in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4huG4866oSysflPVjdKOYDIexpY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20663-zucchini-apple-bread-DDMFS-28403-step-02-35baa4f45baf4953a169a6f1c998ca06.jpg"
      ],
      "image": "assets/images/20663/step_02.webp"
    },
    {
      "text": "Stir flour mixture into sugar mixture until well combined. Fold in zucchini, apple, and walnuts until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wX1brkrjFYDykfBI0gayedB6xZU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20663-zucchini-apple-bread-DDMFS-28405-step-03-8b102568326a46fcad22b2f7e113e35a.jpg"
      ],
      "image": "assets/images/20663/step_03.webp"
    },
    {
      "text": "Divide batter between the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VKgb6zezJikSmwStre0V992R2Rk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20663-zucchini-apple-bread-DDMFS-28407-step-04-71343320f9214d73a4b8876e21f70dd4.jpg"
      ],
      "image": "assets/images/20663/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until centers of loaves spring back when pressed lightly, about 1 hour. Cool loaves in the pans for 10 minutes before removing from the pans; transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7gRv2KQhkxx8WbNjvy92ad0nmHg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20663-zucchini-apple-bread-DDMFS-28437-step-05-c8ce408b10404d6b8ae37f2297a29b87.jpg"
      ],
      "image": "assets/images/20663/step_05.webp"
    }
