  "title": "Apple Zucchini Bread",
  "description": "This moist apple zucchini bread recipe is easy to make with chopped apple and zucchini, cinnamon, and walnuts for a delicious breakfast or brunch treat.",
  "authors": [
    "Rose Putman"
  ],
  "date_published": "2000-08-22T20:17:00-04:00",
