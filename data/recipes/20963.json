  "ingredients": [
    "0.125 cup olive oil",
    "1 tablespoon minced garlic",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon dried marjoram",
    "0.5 teaspoon dried dill weed",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried parsley",
    "0.5 teaspoon crushed red pepper flakes",
    "0.5 teaspoon salt",
    "4 large potatoes, peeled and cubed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 475 degrees F (245 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil, garlic, basil, marjoram, dill, thyme, oregano, parsley, pepper flakes, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ma3_DKmWnsFGOrDoVEfCVFNRMO0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20963-oven-roasted-potatoes-step1-459-4x3-70d61849987641039c36c5e8b30f9a9a.jpg"
      ],
      "image": "assets/images/20963/step_02.webp"
    },
    {
      "text": "Stir in potatoes until evenly coated. Place potatoes in a single layer on a roasting pan or baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Em3uI_unU9PoFxQKqfsOYD3f4QE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20963-oven-roasted-potatoes-step2-461-4x3-d89b54c6f5ca432eaeac8cf903a61a21.jpg"
      ],
      "image": "assets/images/20963/step_03.webp"
    },
    {
      "text": "Roast in the preheated oven, turning occasionally to brown on all sides, until tender with crispy edges, about 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vlPg3ApZcqw0EIUtC8pEAXCLjZY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20963-oven-roasted-potatoes-step3-473-4x3-0a25b93e5e1e4af6acc15d639bdbad78.jpg"
      ],
      "image": "assets/images/20963/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
