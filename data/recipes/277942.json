  "ingredients": [
    "7 cups water",
    "1 pound cooked, smoked lean ham, cut into chunks",
    "1 (14.5 ounce) can low-sodium diced tomatoes, undrained",
    "1.75 cups dried lentils, rinsed",
    "8 ounces chopped onion",
    "6 ounces sliced carrots",
    "6 ounces chopped celery",
    "5 cloves garlic, minced",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "0.5 teaspoon dried thyme, or more to taste",
    "1 bay leaf"
  ],
  "steps": [
    {
      "text": "Combine water, ham, tomatoes, lentils, onion, carrots, celery, garlic, pepper, salt, thyme, and bay leaf in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until lentils and vegetables are as soft as you like, 6 to 8 hours. Remove bay leaf before serving.",
      "section": null,
