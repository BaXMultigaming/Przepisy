    "publisher-tested"
  ],
  "ingredients": [
    "1 pound lean ground beef",
    "1 onion, chopped",
    "1 (4.5 ounce) can mushrooms, drained",
    "1 (28 ounce) jar spaghetti sauce",
    "1 (16 ounce) package cottage cheese",
    "1 pint part-skim ricotta cheese",
    "2 large eggs",
    "0.25 cup grated Parmesan cheese",
    "1 (16 ounce) package lasagna noodles",
    "8 ounces shredded mozzarella cheese, divided"
  ],
  "steps": [
    {
      "text": "Gather all ingredient, and preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6YPzxV0RGodA9ePOtq8qIpBuBoM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11949-easy-lasagna-DDMFS-step-1-BG-7334-146b6fb5c5744b0eb18b8377820969d4.jpg"
      ],
      "image": "assets/images/11949/step_01.webp"
    },
    {
      "text": "Make sauce: Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Add onion and mushrooms; sauté until onions are transparent. Stir in pasta sauce and cook until heated through. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ay6fXcr95y-Fy0ocRTSjEs4jiRc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11949-easy-lasagna-DDMFS-step-4-BG-7354-180d490da0f54e278a9aaa605bdc9dbc.jpg"
      ],
      "image": "assets/images/11949/step_02.webp"
    },
    {
      "text": "Make filling: Combine cottage cheese, ricotta, eggs, and Parmesan in a medium bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6W7nxu9d5-gRrdmeOOEBJzPP-IU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11949-easy-lasagna-DDMFS-step-5-BG-7358-589ebfe504f141a79b1936b70117f7f0.jpg"
      ],
      "image": "assets/images/11949/step_03.webp"
    },
    {
      "text": "Spread a thin layer of meat sauce in the bottom of a 13x9-inch dish. Layer with uncooked lasagna noodles, cheese filling, mozzarella, and meat sauce. Continue layering until all components are used, reserving 1/2 cup mozzarella. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/alzOI3MkoIktIorA-fxG_OOqz04=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11949-easy-lasagna-DDMFS-step-13-BG-7404-b1b871a331f34f869cd953b871645260.jpg"
      ],
      "image": "assets/images/11949/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Remove foil and top with reserved 1/2 cup mozzarella. Continue baking until cheese is melted, about 15 more minutes. Let lasagna stand for 10 to 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/koaRgDJOA_SoBR5iUek89o0rI8s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11949-easy-lasagna-DDMFS-step-14-BG-7425-f7d3c6ab831d47ee95d093a0c6f34f1c.jpg"
      ],
      "image": "assets/images/11949/step_05.webp"
    },
    {
      "text": "Serve warm and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cD5y8o2Up6mflAOP-8euDzZN-do=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11949-easy-lasagna-DDMFS-beauty-4x3-BG-7554-a7ed6d499a004616a22433ee41907a8f.jpg"
      ],
      "image": "assets/images/11949/step_06.webp"
    }
  ],
