  "title": "Easy Lasagna with Uncooked Noodles",
  "description": "This lasagna with uncooked noodles uses mushroom, onion, and ground beef in jarred pasta sauce layered with cottage cheese, ricotta, and mozzarella.",
  "authors": [
    "Susan T"
  ],
  "date_published": "1999-05-13T20:54:48-04:00",
