  "ingredients": [
    "3 tablespoons extra-virgin olive oil",
    "1 onion, finely chopped",
    "1 carrot, finely chopped",
    "1 rib celery, finely chopped",
    "4 cups passata (crushed tomatoes)",
    "2 tablespoons milk",
    "salt",
    "1 onion, peeled",
    "1 carrot",
    "1 stalk celery",
    "4 cups water",
    "8 cups stale Italian bread, crumbled",
    "1.25 cups grated Parmesan cheese",
    "1 tablespoon extra-virgin olive oil, divided",
    "2 tablespoons Parmesan cheese, shaved",
    "5 leaves chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8bZRbf6AjuYrPXTz6b8v7CNLi38=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259465-tuscan-tomato-soup-pappa-al-pomodoro-VAT-step-01-c9c76bce4d964572a56a24024be645e0.jpg"
      ],
      "image": "assets/images/259465/step_01.webp"
    },
    {
      "text": "Heat 3 tablespoons olive oil in a large saucepan over medium heat; add chopped onion, chopped carrot, and chopped celery. Cook until softened, stirring often, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RjVyWqY98sBgKHK-OFow0heMy0E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259465-tuscan-tomato-soup-pappa-al-pomodoro-VAT-step-02-1695a2363fa1435ca2db171301135e07.jpg"
      ],
      "image": "assets/images/259465/step_02.webp"
    },
    {
      "text": "Stir in tomato passata and milk. Season with salt, cover and simmer tomato sauce until flavors are well combined, 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K-dVz7pHEcc3LD3CmDfvgm8zshE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259465-tuscan-tomato-soup-pappa-al-pomodoro-VAT-step-03-79a516a9a6a34005b5de80ae14ceec1d.jpg"
      ],
      "image": "assets/images/259465/step_03.webp"
    },
    {
      "text": "Combine whole onion, whole carrot, and whole celery stalk in a stockpot; cover with water and bring to a boil. Simmer for 15 minutes. Strain vegetables and keep stock warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-3313X-UIStrnloFk_pgrSvsi_A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259465-tuscan-tomato-soup-pappa-al-pomodoro-VAT-step-04-6ae16d745d8247e281e1e06f5cf67273.jpg"
      ],
      "image": "assets/images/259465/step_04.webp"
    },
    {
      "text": "Stir 1 1/2 cups stock into tomato sauce. Add stale bread; stir and set aside for 15 to 20 minutes to allow the bread to soften.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PVjYhkduuMowTA9Ju6jW-uHPoLY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259465-tuscan-tomato-soup-pappa-al-pomodoro-VAT-step-05-68c4dada7ea24b5f949f21e2be8a4e8c.jpg"
      ],
      "image": "assets/images/259465/step_05.webp"
    },
    {
      "text": "Combine tomato-bread mixture, 1 1/4 cups grated Parmesan cheese, and 1 teaspoon of olive oil in a blender; blend until mixture has consistency of a mousse.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f7a_iCPFoaB0S94TChn8PGEe5J8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259465-tuscan-tomato-soup-pappa-al-pomodoro-VAT-step-06-565b9781995c44fb972c49e1541ebf2e.jpg"
      ],
      "image": "assets/images/259465/step_06.webp"
    },
    {
      "text": "Ladle soup into bowls and serve with shaved Parmesan cheese and drizzled with remaining olive oil. Garnish with basil leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PzCMHdifiQBQcCK9ZK_ZjJ-lQHI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259465-tuscan-tomato-soup-pappa-al-pomodoro-VAT-step-07-61c494cf6a00455db27b8b8762cabbc0.jpg"
      ],
      "image": "assets/images/259465/step_07.webp"
    }
