  "ingredients": [
    "1.5 pounds beef cube steak",
    "3 tablespoons all-purpose flour",
    "1 tablespoon olive oil",
    "0.5 tablespoon butter",
    "1 onion, chopped",
    "1 clove garlic, minced",
    "1 cube beef bouillon, dissolved in 1 cup water",
    "1 (15 ounce) can sliced potatoes, drained",
    "1 (8 ounce) can peas and carrots",
    "1 teaspoon browning sauce",
    "0.5 teaspoon Italian seasoning",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Cut cube steaks into 1/2-inch pieces. Sprinkle flour over a plate; dredge meat in flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil and butter in a large skillet over medium-high heat. Add steak pieces, onion, and garlic to the pan; sauté until lightly browned. Add more butter if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in beef bouillon, potatoes, peas and carrots, browning sauce, Italian seasoning, salt, and black pepper. Cover, turn heat down to simmer, and cook until thickened, about 25 minutes. Add more water if it gets too thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
