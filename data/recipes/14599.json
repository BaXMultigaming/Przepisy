  "title": "Cube Steak Stew",
  "description": "This cube steak stew is fast and easy. It uses canned vegetables and bottled browning sauce to speed up preparation. It simmers for less than half an hour.",
  "authors": [
    "Joyce"
  ],
  "date_published": "1999-09-26T01:43:39-04:00",
