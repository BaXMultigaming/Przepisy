  "ingredients": [
    "1 pound ground beef",
    "1 medium onion, chopped",
    "0.75 cup ketchup",
    "1.5 tablespoons white vinegar",
    "1.5 tablespoons brown sugar",
    "1.5 teaspoons prepared yellow mustard",
    "salt and pepper to taste",
    "4 hamburger buns"
