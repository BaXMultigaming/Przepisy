  "ingredients": [
    "2 pounds maple-flavored bacon",
    "1 large head fresh broccoli, chopped",
    "0.75 cup chopped celery",
    "0.25 cup minced green onions",
    "0.25 cup diced red onion",
    "1.5 cups seedless grapes, halved",
    "0.75 cup blanched slivered almonds",
    "0.25 cup white sugar",
    "2 tablespoons distilled white vinegar",
    "1 cup mayonnaise"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet. Cook, turning frequently, over medium high heat until evenly browned. Cool, and then crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C). Spread slivered almonds on a cookie sheet. Bake for approximately 12 to 14 minutes or until lightly browned, turning once during toasting. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix together mayonnaise, sugar, and vinegar. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine broccoli, crumbled bacon, celery, green onions, red onions, grapes, and toasted almonds. Toss with mayonnaise dressing. Chill for several hours in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
