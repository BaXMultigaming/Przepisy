  "title": "Camp David Spaghetti with Italian Sausage",
  "description": "This Camp David spaghetti with Italian sausage features hearty ground beef, tomato pasta sauce, spaghetti, Italian sausage, and Parmesan cheese.",
  "authors": [
    "hungryguy"
  ],
  "date_published": "2019-04-02T02:49:28-04:00",
