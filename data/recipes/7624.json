  "ingredients": [
    "3 cups white sugar",
    "1 cup water",
    "0.25 teaspoon cream of tartar",
    "3 large egg whites",
    "1 teaspoon vanilla extract",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Stir sugar, water, and cream of tartar together in a saucepan over medium heat. Cover and bring to a boil, then uncover and cook until a candy thermometer reaches 238 degrees F (115 degrees C), 5 to 7 minutes; syrup should spin a long thread when dripped from a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the syrup is cooking, beat egg whites in the bowl of a stand mixer with the whisk attachment until stiff peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When the syrup has reached temperature, slowly pour a thin stream into egg whites, beating constantly, until frosting stands in peaks. Stir in vanilla and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
