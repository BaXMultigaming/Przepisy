  "ingredients": [
    "6 slices black forest ham",
    "0.5 (8 ounce) wedge Brie cheese, sliced",
    "2 tablespoons apricot preserves",
    "1 tablespoon Dijon mustard",
    "4 thick slices Italian bread",
    "1 tablespoon olive oil"
  ],
  "steps": [
    {
      "text": "To assemble the sandwiches: Layer ham, Brie cheese, apricot preserves, and mustard in equal amounts on two pieces of bread, topping with the remaining two slices of bread. Brush top of each sandwich with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a grill pan over medium heat. Once the pan is hot, place sandwiches, oiled-side down, in the pan. Brush top of each sandwich with oil. Cook each side until bread is golden brown, 3 to 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
