  "ingredients": [
    "0.25 cup butter",
    "0.5 cup pure maple syrup",
    "1 cup confectioners' sugar",
    "0.125 teaspoon ground cinnamon",
    "1 pinch salt",
    "2.5 cups chopped walnuts"
  ],
  "steps": [
    {
      "text": "Spread a sheet of waxed paper onto a flat working surface.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat, stirring frequently. Slowly stream maple syrup into the saucepan while stirring with the butter; bring to a light simmer. Stir confectioners' sugar, cinnamon, and salt into syrup mixture with a whisk; cook and stir until the mixture is hot and the confectioners' sugar is completely dissolved into the liquid. Gently stir walnuts into the liquid just until coated and remove saucepan from heat. Let the mixture cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop walnut pieces by the spoonful onto the waxed paper and let each portion spread into a rounded mound; let cool completely until set, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
