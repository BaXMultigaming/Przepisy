  "ingredients": [
    "1.5 cups water",
    "1 cup white sugar",
    "0.25 cup coarsely chopped unpeeled fresh ginger",
    "2 tablespoons freshly squeezed lemon juice",
    "0.5 teaspoon whole black peppercorns"
  ],
  "steps": [
    {
      "text": "Mix together water, sugar, ginger, lemon juice, and peppercorns in a saucepan. Bring to a boil; reduce heat and simmer, stirring frequently, until sugar dissolves. Let cool, 15 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain syrup through a fine-mesh sieve; discard solids. Chill, covered, for up to 2 weeks.",
