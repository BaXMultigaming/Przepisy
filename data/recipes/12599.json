  "ingredients": [
    "1 (9 inch) pie shell",
    "7 ripe tomatoes, sliced",
    "1 yellow onion",
    "0.75 cup mayonnaise",
    "0.33333334326744 cup shredded mozzarella cheese",
    "0.33333334326744 cup grated Parmesan cheese",
    "ground black pepper to taste",
    "2 teaspoons fresh basil",
    "2 teaspoons fresh oregano"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake the pastry shell for 8 to 10 minutes or until browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice onion and place in the bottom of pastry shell. Slice tomatoes and arrange over onions. Add black pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine mozzarella, parmesan and mayonnaise. Spread this mixture evenly over tomatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 20-25 minutes or until golden brown. Once cooked, garnish with fresh herbs.",
      "section": null,
      "name": null,
      "url": null,
