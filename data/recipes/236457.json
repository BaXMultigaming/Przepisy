  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix",
    "2 eggs",
    "0.5 cup butter, melted",
    "1 teaspoon vanilla extract",
    "1 (16 ounce) package confectioners' sugar, plus more for dusting",
    "1 (8 ounce) package cream cheese, softened",
    "2 eggs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cake mix and 2 eggs together in a bowl. Add butter and vanilla extract; mix until batter is smooth and thick. Spread batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat confectioners' sugar, cream cheese, and 2 eggs together in a bowl until smooth; spread over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until sides of cake are pulled away from dish and browned, 25 to 35 minutes. Cool cake completely. Sprinkle more confectioners' sugar over cooled cake.",
      "section": null,
      "name": null,
      "url": null,
