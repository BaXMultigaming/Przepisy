  "ingredients": [
    "1 cup light corn syrup",
    "3 eggs",
    "1 cup white sugar",
    "2 tablespoons butter, melted",
    "1 teaspoon vanilla extract",
    "2 cups coarsely chopped pecans",
    "0.75 cup sweetened flaked coconut",
    "0.75 cup semisweet chocolate chips",
    "1 (9 inch) deep dish prepared pie crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk the corn syrup, eggs, sugar, butter, and vanilla together in a mixing bowl until light-colored and well blended. Stir in the pecans and coconut. Sprinkle the chocolate chips over the bottom of the prepared pie crust. Pour the corn syrup mixture over the chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until top is set, 55 to 60 minutes. Cool completely on a rack before serving, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
