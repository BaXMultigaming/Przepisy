  "ingredients": [
    "1 (16 ounce) package egg noodles",
    "2 tablespoons butter",
    "1 onion, chopped",
    "1 pound ground beef",
    "1 tablespoon all-purpose flour",
    "1 (4.5 ounce) can sliced mushrooms, drained",
    "1 tablespoon garlic salt",
    "1 (10.5 ounce) can cream of mushroom soup (such as Campbell's®)",
    "1 (10.5 ounce) can cream of chicken soup (such as Campbell's®)",
    "1 cup sour cream"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ca0OoYBXgj7bBbD8A8tZVGj1Zjg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_240773_QuickandEasyHamburgerStroganoff_Shot1_13254-0cd814fe02c8449a9d71e772c16fd490.jpg"
      ],
      "image": "assets/images/240773/step_01.webp"
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a large skillet over medium-high heat. Sauté onion in hot butter until tender and translucent, about 5 minutes. Add ground beef in small chunks; cook and stir beef until browned and crumbly, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i-2OFY64tthdFKWHvhZVHOnX5Cc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_240773_QuickandEasyHamburgerStroganoff_Shot2_13279-e74a9645ca7849e3956c931039b78cff.jpg"
      ],
      "image": "assets/images/240773/step_03.webp"
    },
    {
      "text": "Sprinkle flour over beef mixture; cook and stir for 1 minute. Stir in mushrooms and garlic salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in mushroom soup and chicken soup; cook and stir until heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RVjjisj-86HuJ51GxB-n3uSfHS0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_240773_QuickandEasyHamburgerStroganoff_Shot4_13285-ac82bcb10e25403191a8ec48e977759e.jpg"
      ],
      "image": "assets/images/240773/step_05.webp"
    },
    {
      "text": "Stir in sour cream until smooth and heated through, 2 to 3 minutes more. Serve beef mixture over cooked egg noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XtZyX_bEq2aBEGHHeu-iafslKKQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_240773_QuickandEasyHamburgerStroganoff_Shot4_13288-a52654db36864e29a4f2045dab8ba63b.jpg"
      ],
      "image": "assets/images/240773/step_06.webp"
    }
