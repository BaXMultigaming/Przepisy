  "ingredients": [
    "2 tablespoons olive oil",
    "1 cup chopped white onions",
    "1 teaspoon chopped fresh ginger",
    "1 teaspoon chopped fresh garlic",
    "0.5 teaspoon cayenne pepper",
    "1 teaspoon dried thyme",
    "0.75 teaspoon allspice",
    "0.125 teaspoon celery salt",
    "3 cups vegetable broth",
    "1 (14.25 ounce) can tomato puree",
    "2 (16 ounce) cans refried black beans",
    "0.125 teaspoon black pepper",
    "1 teaspoon white sugar",
    "2 (15 ounce) cans black beans, rinsed and drained",
    "0.25 cup fresh lemon juice",
    "1 (8 ounce) container sour cream"
  ],
  "steps": [
    {
      "text": "Heat the olive oil in a large saucepan over medium heat, and cook the onion until tender. Mix in ginger and garlic, and season with cayenne pepper, thyme, allspice, and celery salt. Pour in the broth. Mix in tomato puree, refried black beans, black pepper, and sugar. Cook and stir until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the remaining black beans and lemon juice into the soup. Continue cooking until heated through. Top each serving with a dollop of sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
