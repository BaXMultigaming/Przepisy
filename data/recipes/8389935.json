  "ingredients": [
    "coarse salt",
    "2 orange wedges",
    "3 ounces freshly squeezed orange juice",
    "3 ounces tequila",
    "1.5 ounces orange-flavored liqueur (such as Cointreau®)",
    "crushed ice"
