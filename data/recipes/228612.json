  "ingredients": [
    "1 cup olive oil",
    "3 tablespoons red wine vinegar",
    "3 tablespoons grated Parmesan cheese",
    "2 tablespoons lemon juice",
    "2 tablespoons finely chopped garlic",
    "2 tablespoons dried oregano, or to taste",
    "1.5 teaspoons dried basil",
    "1 teaspoon salt, or to taste",
    "freshly ground black pepper to taste",
    "2 heads romaine lettuce, chopped",
    "2 large tomatoes, cut into wedges",
    "1 large cucumber, cut into matchsticks",
    "1 red onion, sliced",
    "1 cup black olives",
    "0.5 pound feta cheese, crumbled"
  ],
  "steps": [
    {
      "text": "Place olive oil, vinegar, Parmesan cheese, lemon juice, garlic, oregano, basil, salt, and black pepper in the bowl of a food processor; pulse until smooth and emulsified.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine romaine lettuce, tomatoes, cucumber, red onion, black olives, and feta cheese in a large bowl. Drizzle vinaigrette over top; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
