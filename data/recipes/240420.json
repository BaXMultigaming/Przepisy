  "ingredients": [
    "2 cups white sugar",
    "1 cup peanut butter",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "1 cup all-purpose flour",
    "0.75 cup cocoa powder",
    "0.33333334326744 cup canola oil",
    "0.33333334326744 cup soy milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, peanut butter, vanilla extract, and salt together in a bowl until smooth and creamy. Mix flour and cocoa powder into peanut butter mixture; add canola oil and soy milk and stir until batter is moist, crumbly, and stiff. Spread batter into the prepared baking dish using your hands or a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is dry and the edges have started to pull away from the sides of the pan, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
