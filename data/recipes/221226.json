  "ingredients": [
    "1 large Asian pear, peeled, cored and sliced",
    "0.33333334326744 cup sherry wine",
    "0.33333334326744 cup soy sauce",
    "0.25 cup rice vinegar",
    "0.125 cup brown sugar",
    "5 slices fresh ginger, peeled and thinly sliced",
    "3 cloves garlic, peeled",
    "1 tablespoon hoisin sauce",
    "1 tablespoon hot chile paste (such as sambal oelek)",
    "1 teaspoon sesame oil",
    "4 pounds beef short ribs, trimmed",
    "1 chopped green onion for garnish"
  ],
  "steps": [
    {
      "text": "Combine pear slices, sherry wine, soy sauce, rice wine vinegar, brown sugar, ginger, garlic, hoisin sauce, chili paste, and sesame oil in a blender; blend until smooth, about 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange ribs in a 9x13-inch baking dish; coat with marinade. Cover the baking dish with plastic wrap; refrigerate 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer short ribs to a plate; pat dry with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook ribs on the preheated grill until firm, hot, and slightly pink in center, about 4 minutes per side. An instant-read thermometer inserted into center should read 140 degrees F (60 degrees C).",
      "section": null,
      "name": null,
      "url": null,
