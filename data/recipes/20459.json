  "ingredients": [
    "2 (6.5 ounce) jars marinated artichoke hearts, chopped",
    "1 small onion, chopped",
    "1 clove garlic, minced",
    "4 eggs, beaten",
    "0.25 cup fine dry bread crumbs",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.125 teaspoon dried oregano",
    "0.125 teaspoon hot pepper sauce",
    "2 cups shredded sharp Cheddar cheese",
    "2 tablespoons finely minced fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9 inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain marinade from 1 jar of artichokes into a medium sized skillet. Drain second jar and discard marinade. Heat the marinade in the medium sized skillet. Add the onions and garlic and saute for about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium sized bowl, combine the eggs, bread crumbs, salt, pepper, oregano and hot pepper sauce. Slowly mix in the shredded cheddar cheese, parsley and artichoke. Blend the marinade with the sauteed onions and garlic into the mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a 9 inch square baking pan and pour in the contents of the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for approximately 30 minutes and allow to cool briefly. Cut into one inch squares and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
