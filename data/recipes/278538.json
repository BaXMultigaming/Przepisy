  "ingredients": [
    "0.5 (12 ounce) bag semisweet chocolate chips, or more to taste",
    "1.5 cups heavy whipping cream, divided",
    "0.25 cup hot, strong coffee",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Place chocolate chips in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1/2 cup cream in a small saucepan over medium-high heat until it begins to rise and foam, watching carefully so it doesn't spill over, 3 to 5 minutes. Pour over chocolate chips and cover for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cover and slowly stir with a spatula until smooth. Stir in hot coffee and vanilla extract until all chocolate has melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip remaining 1 cup cream in a chilled glass or metal bowl with an electric mixer until soft peaks form. Gently fold cream into chocolate mixture until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon into glasses and refrigerate until firm, at least 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
