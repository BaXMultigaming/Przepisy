  "ingredients": [
    "1 cup rolled oats",
    "1.5 cups whole wheat flour",
    "0.25 cup brown sugar",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon sea salt",
    "0.75 cup unsweetened almond milk",
    "2 egg whites",
    "0.33333334326744 cup unsweetened applesauce",
    "0.5 teaspoon vanilla extract",
    "1 cup mashed bananas"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend oats in a blender until flour-like in texture. Transfer to a bowl. Add whole wheat flour, brown sugar, baking powder, baking soda, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almond milk, egg whites, applesauce, and vanilla extract in a second bowl. Mix until well blended. Add mashed bananas and combine thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir banana mixture into flour mixture until just combined. Divide batter into the muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly touched, 18 to 20 minutes.",
      "section": null,
