  "ingredients": [
    "2 pounds pork baby back ribs",
    "aluminum foil",
    "cooking spray",
    "1 (18 ounce) bottle barbecue sauce"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
