  "ingredients": [
    "1 (3 ounce) package strawberry-flavored gelatin (such as Jell-O®)",
    "1 cup boiling water",
    "1 (8 ounce) package cream cheese, softened",
    "1 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 (5 ounce) can cold evaporated milk",
    "1 (9 inch) prepared graham cracker crust"
  ],
  "steps": [
    {
      "text": "Dissolve strawberry gelatin in boiling water in a bowl; cool in refrigerator until thick, but not set, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vKPPY6F2D162CFoxLU0bF1H0mVQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234410-no-bake-strawberry-cheesecake-VAT-step-01-ffe45a48114943abaf7c783e18ed8c76.jpg"
      ],
      "image": "assets/images/234410/step_01.webp"
    },
    {
      "text": "Beat cream cheese, sugar, and vanilla extract together in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6s09EJqBRdOxmQHXpWxMvIpNwjY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234410-no-bake-strawberry-cheesecake-VAT-step-02-600f163da1b240dda7d85b820bbe5d23.jpg"
      ],
      "image": "assets/images/234410/step_02.webp"
    },
    {
      "text": "Beat evaporated milk in a separate bowl with an electric mixer until whipped and thick. Gradually pour strawberry gelatin mixture into evaporated milk, beating constantly. Fold cream cheese mixture into gelatin-milk mixture to form cheesecake filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rkCerKUbw0f1OWZ2YhmIQADRAss=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234410-no-bake-strawberry-cheesecake-VAT-step-03-0050f90d150846a58ba62e062833f0dc.jpg"
      ],
      "image": "assets/images/234410/step_03.webp"
    },
    {
      "text": "Set graham cracker crust on a baking sheet or plate to maintain stability. Pour cheesecake filling into crust. Refrigerate until cake is set, at least 3 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
