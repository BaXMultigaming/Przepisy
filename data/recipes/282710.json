  "ingredients": [
    "1 (16 ounce) package sage pork sausage (such as Jimmy Dean®)",
    "2 tablespoons salted butter",
    "3 tablespoons all-purpose flour, or more as needed",
    "2 cups milk, or more to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium heat. Cook and stir sausage in the hot skillet until browned and crumbly, 8 to 10 minutes. Add butter and stir until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour; stir until absorbed by the mixture. Add milk and pepper. Increase heat and stir until heated through and thick, about 5 minutes.",
