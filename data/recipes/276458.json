  "ingredients": [
    "1 cup raw cashews",
    "1 cup filtered water, or as needed",
    "0.5 cup water",
    "2 tablespoons lime juice",
    "1 teaspoon apple cider vinegar",
    "0.5 teaspoon garlic salt",
    "0.25 teaspoon ground red chile pepper",
    "0.25 teaspoon ground paprika",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Place cashews in a bowl and pour filtered water over top until completely covered. Soak for at least 2 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain and rinse cashews, then place into a food processor bowl. Add 1/2 cup water, lime juice, vinegar, garlic salt, ground chile pepper, and paprika. Blend for 1 minute. Add remaining 1/4 cup water if necessary for desired consistency; blend until smooth, 3 to 4 minutes. Taste and adjust for flavor.",
