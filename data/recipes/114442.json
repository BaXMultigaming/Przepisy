        "https://www.allrecipes.com/thmb/--TwWg84W91NjSIlXjxjvQOcwUk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/114442-Grilled-Wild-Duck-Breast-DDMFS-4x3-step-1-11561-448de5a50fb24ce8ac0b4a0fce69c13c.jpg"
