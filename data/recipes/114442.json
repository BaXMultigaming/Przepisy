  "ingredients": [
    "0.25 cup Worcestershire sauce",
    "2 tablespoons olive oil",
    "2 tablespoons minced garlic",
    "0.5 teaspoon hot sauce",
    "0.25 teaspoon black pepper",
    "4 skinned, boned duck breast halves"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
