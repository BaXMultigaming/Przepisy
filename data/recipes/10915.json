  "title": "White Chocolate Pumpkin Cookies",
  "description": "This pumpkin cookie recipe includes warm pumpkin pie spice and brown sugar and features white chocolate chips and chopped pecans for a sweet, nutty bite.",
  "authors": [
    "Jill Eshenbaugh"
  ],
  "date_published": "1998-05-26T12:30:45-04:00",
