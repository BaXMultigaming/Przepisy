  "ingredients": [
    "2.25 cups all-purpose flour",
    "1 teaspoon pumpkin pie spice",
    "0.5 teaspoon baking soda",
    "1.5 cups packed brown sugar",
    "1 cup unsalted butter",
    "1 cup solid pack pumpkin puree",
    "2 eggs",
    "1 tablespoon vanilla extract",
    "2 cups white chocolate chips",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, pumpkin pie spice, and baking soda together in a medium bowl until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter together in a large bowl with an electric mixer until smooth and creamy; beat in pumpkin purée until incorporated. Beat in eggs and vanilla, then beat in flour mixture until just combined. Stir in white chocolate chips and pecans until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop rounded tablespoons of dough 2 inches apart on an ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are set, 20 to 22 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
