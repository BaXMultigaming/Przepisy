  "ingredients": [
    "2 tablespoons olive oil",
    "1 medium lemon, juiced",
    "0.5 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "0.125 teaspoon ground black pepper",
    "1 pound broccolini",
    "0.25 cup finely shredded Asiago cheese"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, lemon juice, salt, garlic powder, and black pepper together in a small bowl. Trim about 1/4 inch off the bottoms of the broccolini and remove any leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush broccolini with some of the oil mixture. Place on the grate and grill for 7 to 9 minutes, turning every 2 to 3 minutes, brushing on more oil mixture. Remove to a platter and sprinkle with Asiago cheese.",
      "section": null,
      "name": null,
      "url": null,
