  "ingredients": [
    "0.25 cup mayonnaise",
    "0.5 clove garlic, finely chopped",
    "1.5 tablespoons lemon juice",
    "1.5 teaspoons chopped fresh basil",
    "1 teaspoon Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Mix the mayonnaise and garlic together in a small bowl. Add the lemon juice and basil; whisk until thoroughly combined. Beat the Worcestershire sauce into the mixture. Serve immediately, or chill until serving.",
