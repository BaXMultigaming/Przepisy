  "ingredients": [
    "2 teaspoons oil, or as needed",
    "1.5 cups milk",
    "1 egg",
    "2 cups glutinous rice flour",
    "0.25 cup white sugar",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "2 cups chopped dried mixed fruit"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan generously with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and egg together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift rice flour, sugar, baking powder, and salt together in a separate bowl. Mix in milk mixture until well blended. Fold in dried fruit. Pour batter into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges start to brown, about 1 hour. Let cool completely, 20 to 30 minutes, before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
