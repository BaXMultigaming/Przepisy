  "ingredients": [
    "4 cups all-purpose flour",
    "1 tablespoon white sugar",
    "1 teaspoon baking powder",
    "2 teaspoons salt",
    "1.75 cups shortening",
    "0.5 cup cold water",
    "1 egg",
    "1 tablespoon vinegar",
    "8 slices bacon",
    "1 tablespoon butter",
    "0.5 cup chopped onion",
    "0.33333334326744 cup finely diced smoked ham",
    "3 cups heavy cream",
    "8 eggs, beaten",
    "0.25 teaspoon salt",
    "0.5 teaspoon freshly ground black pepper",
    "0.25 teaspoon nutmeg",
    "3 tablespoons finely chopped fresh basil",
    "1 tablespoon fresh thyme, minced",
    "1 (3 ounce) package cream cheese, diced",
    "0.5 cup shredded Cheddar cheese",
    "0.5 cup shredded Monterey Jack cheese",
    "1 bunch green onions, chopped",
    "0.33333334326744 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Mix together flour, sugar, baking powder and salt. Cut in shortening until mixture resembles coarse crumbs. Add water, egg, and vinegar. Mix together but do not work too much. Divide pastry into two pieces, cover and chill for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Form each piece into a round and roll out crust on lightly floured surface. Carefully fit into two 10 inch tart pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blind bake tart shells in preheated oven until golden brown. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Saute onion in butter until translucent. Divide ham, bacon and onion into two equal portions and sprinkle over the bottom of tart shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together cream and beaten eggs. Add salt, pepper, nutmeg, basil, and thyme, and stir well. Pour egg mixture over bacon mixture. Sprinkle cream cheese cubes and grated Cheddar and Monterey Jack cheeses over the top of each filled tart. Sprinkle green onions over cheese, followed by sliced almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated 350 degrees F (175 degrees C) oven for 30 to 40 minutes. Let cool slightly, then cut and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
