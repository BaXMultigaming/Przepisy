  "ingredients": [
    "12 medium shrimp",
    "1 cup matchstick-cut Granny Smith apple",
    "1 cup matchstick-cut jicama",
    "0.5 cup matchstick-cut carrots",
    "0.5 cup fresh mint leaves",
    "0.5 cup extra virgin olive oil",
    "3 tablespoons white sugar",
    "2 tablespoons white vinegar",
    "1 tablespoon Dijon mustard",
    "1 teaspoon chopped garlic",
    "1 teaspoon chopped lemongrass",
    "2 sprigs cilantro"
  ],
  "steps": [
    {
      "text": "Bring a small pot of water to boil. Cook shrimp in boiling water until they are bright pink on the outside and the meat is no longer transparent in the center, 3 to 5 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse shrimp with cold water to cool completely. Peel, devein, and slice shrimp in half lengthwise; set aside in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss apple, jicama, and carrots together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place mint leaves, olive oil, sugar, vinegar, Dijon mustard, garlic, and lemongrass in a food processor. Pulse until blended but slightly chunky, about two 10-second intervals.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing over apple mixture; toss until well mixed. Cover salad and shrimp separately with plastic wrap; refrigerate until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix shrimp into salad before serving; garnish with cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
