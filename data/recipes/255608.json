  "ingredients": [
    "1.25 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1.3333333730698 cups brown sugar",
    "0.5 cup butter, melted",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 cup white chocolate chips",
    "1 cup dried cranberries",
    "Reynolds Wrap® Aluminum Foil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F. Line an 8x8x2-inch baking pan with Reynolds Wrap® Aluminum Foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour and baking powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and butter in a large bowl. Mix until fully incorporated. Add egg, vanilla and flour mixture and continue mixing until fully incorporated. Fold in the chocolate chips and cranberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into prepared pan and bake for 35 to 40 minutes or until edges are firm and starting to pull away from sides of the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool on a wire rack for 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
