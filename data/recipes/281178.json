  "ingredients": [
    "1 cup self-rising flour",
    "3 large eggs",
    "0.66666668653488 cup superfine sugar",
    "0.66666668653488 cup salted butter, melted",
    "2 tablespoons orange juice",
    "1 tablespoon grated orange zest",
    "1 teaspoon baking powder",
    "0.5 cup superfine sugar",
    "0.25 cup orange juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch cake pan well using butter and flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, eggs, sugar, butter, orange juice, orange zest, and baking powder in a bowl. Mix with an electric hand mixer or stand mixer until batter comes together and is pale in color. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 30 to 40 minutes. Remove from the oven and let cool in the pan for 5 minutes. Carefully remove from the pan and place on a cooling rack with a tray underneath.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While cake cools, combine sugar and orange juice for drizzle in a small bowl. Pour over the still-warm cake. Let cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
