  "title": "Broiled Sweet Potatoes",
  "description": "This is a quick and easy recipe for a tasty side dish. Sweet potatoes are microwaved, then slice and broiled with butter and sugar.",
  "authors": [
    "Maria Watson"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
