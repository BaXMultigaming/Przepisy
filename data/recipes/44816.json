  "ingredients": [
    "2 (5 ounce) cans tuna, drained and flaked",
    "0.75 cup dry bread crumbs",
    "3 green onions, minced",
    "1 large egg, beaten",
    "1 clove garlic, peeled and minced",
    "1 tablespoon soy sauce",
    "1 tablespoon teriyaki sauce",
    "1 tablespoon ketchup",
    "1 teaspoon sesame oil",
    "1 teaspoon black pepper",
    "0.5 cup cornmeal",
    "2 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Mix tuna, bread crumbs, green onions, egg, and garlic. Blend in soy sauce, teriyaki sauce, ketchup, sesame oil, and pepper until well combined. Form tuna mixture into 6 patties, about 1-inch thick. Lightly sprinkle each patty on all sides with cornmeal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a medium skillet over medium heat. Fry patties in batches in hot oil until golden brown, about 5 minutes per side.",
