  "ingredients": [
    "2 cups white sugar",
    "1 cup margarine, softened",
    "4 eggs",
    "4 cups all-purpose flour",
    "1 teaspoon salt",
    "2 teaspoons baking powder",
    "1 cup buttermilk",
    "1 teaspoon baking soda",
    "1.5 teaspoons vanilla extract",
    "1 (10 ounce) jar maraschino cherries, drained and juice reserved",
    "2 (12 ounce) packages semisweet chocolate chips",
    "2 (8 ounce) packages chopped pitted dates",
    "1 cup flaked coconut",
    "2 cups chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Lightly grease two 9x5 inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the margarine and sugar until light and fluffy. Stir in the eggs one at a time, beating well with each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, sift together flour, salt and baking powder. In a third bowl, combine the buttermilk, baking soda, vanilla extract and maraschino cherry juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the milk mixture and flour mixture alternately into the egg mixture until a soft batter is formed. Fold in cherries, chocolate chips, dates, coconut and pecans. Pour batter into prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 90 to 120 minutes, until loaves are firm and a toothpick inserted into the center of each loaf comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
