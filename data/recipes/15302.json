  "ingredients": [
    "1 tablespoon vegetable oil",
    "4 skinless, boneless chicken breast halves",
    "1 (10 ounce) can diced tomatoes with green chile peppers",
    "1 (15 ounce) can black beans, rinsed and drained",
    "1 (8.75 ounce) can whole kernel corn, drained",
    "1 pinch ground cumin"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add chicken breasts and sear for 2 to 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomatoes with green chiles, black beans, and corn. Reduce heat and let simmer until chicken is cooked through and the juices run clear, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with cumin before serving.",
