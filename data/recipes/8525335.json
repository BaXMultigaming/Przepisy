  "ingredients": [
    "1 (32 ounce) package frozen fried potato nuggets",
    "6 ounces corned beef, chopped (1 cup)",
    "0.5 cup sauerkraut, drained",
    "1 cup shredded Swiss cheese (4 oz.)",
    "1 cup shredded Colby and Monterey Jack cheese (4 oz.)",
    "0.5 cup Thousand Island salad dressing",
    "1 tablespoon spicy brown mustard",
    "2 tablespoons chopped green onion",
    "0.25 teaspoon caraway seeds, toasted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread potato nuggets on prepared baking sheet. Bake until golden brown, 28 to 32 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top potato nuggets with corned beef, sauerkraut, Swiss cheese, and Colby and Monterey Jack cheese. Bake until cheese is melted, 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
