  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1 cup blueberries",
    "1 teaspoon lemon zest",
    "0.33333334326744 cup shortening",
    "0.75 cup milk",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sugar, baking powder, and salt together in a large bowl. Combine blueberries and lemon zest in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat shortening in a separate bowl until creamy; stir into flour mixture, alternating with milk, then beat until well combined, about 2 minutes. Add egg; beat until well combined, about 1 minute. Fold in blueberry mixture. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
