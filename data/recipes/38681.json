  "ingredients": [
    "2 cups all-purpose flour",
    "4 (1 ounce) squares semisweet chocolate, grated",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "6 tablespoons margarine, softened",
    "0.75 cup white sugar",
    "2 eggs",
    "1 tablespoon orange zest",
    "0.25 cup orange juice",
    "0.5 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease a 12 cup muffin pan, or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix flour, semisweet chocolate, baking powder, baking soda, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate medium bowl, cream together margarine and sugar until smooth. Beat in the eggs one at a time then stir in the orange zest, orange juice, and buttermilk. Pour into the flour mixture, and mix just until evenly moist. Spoon batter into muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 20 minutes in the preheated oven, or until a toothpick inserted into the center of a muffin comes out clean. Let muffins cool in the pan on a wire rack for at least 10 minutes before removing from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
