  "ingredients": [
    "1 cup raw cashews",
    "2.5 cups hot water, divided",
    "2 tablespoons nutritional yeast",
    "2 tablespoons fresh salsa",
    "2 cloves garlic, roughly chopped",
    "1 teaspoon ancho chile powder",
    "1 teaspoon Dijon mustard",
    "0.75 teaspoon ground cumin",
    "0.75 teaspoon kosher salt"
  ],
  "steps": [
    {
      "text": "Place cashews in a bowl and cover with 1/2 of the hot water. Soak for 5 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine drained cashews, remaining 1 1/4 cup hot water, nutritional yeast, salsa, garlic, ancho chile powder, Dijon mustard, cumin, and salt in a high-powered blender (such as Vitamix®). Start blending at lowest speed and slowly increase the speed. Blend for 2 minutes. Add more hot water if you want the queso to have a pourable consistency.",
      "section": null,
