  "ingredients": [
    "1 butternut squash, cubed",
    "2 tablespoons butter",
    "0.25 cup maple syrup",
    "2 tablespoons brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to a boil over high heat. Add squash and boil until almost tender yet still firm, 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a skillet over low heat. Stir in maple syrup and brown sugar and cook until sugar has dissolved, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain semi-cooked squash and place on a large sheet of heavy-duty aluminum foil and brush with some of the maple glaze; reserve remaining glaze. Fold up foil to close.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until squash is tender, 10 to 15 minutes, brushing with remaining glaze occasionally and flipping halfway through cooking time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
