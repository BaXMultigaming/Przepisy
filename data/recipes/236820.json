  "ingredients": [
    "1 (18.25 ounce) box yellow cake mix (such as Duncan Hines®)",
    "1 cup water",
    "0.5 cup vegetable oil",
    "3 eggs",
    "2 cups cold milk",
    "2 (3.5 ounce) packages instant banana pudding mix",
    "1 (8 ounce) container frozen whipped topping (such as Cool Whip®), thawed",
    "1 cup vanilla wafer crumbs (such as Nilla®), or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/emuWsLwiwGh4ZqcpnFbtMQb_zn8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236820-banana-pudding-poke-cake-VAT-005-step-01-d4b547ba54554def9ce5ae02f2fb77e3.jpg"
      ],
      "image": "assets/images/236820/step_01.webp"
    },
    {
      "text": "Whisk cake mix, water, vegetable oil, and eggs together in a bowl until smooth; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VZWHWR-_1USkqmDrv-Eyy7Rh5Ng=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236820-banana-pudding-poke-cake-VAT-006-step-02-5ded123cadf444dca73de5606c67811b.jpg"
      ],
      "image": "assets/images/236820/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the cake comes out clean, 23 to 28 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i9jmJzKRuTpKVGMeToIjrev51wQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236820-banana-pudding-poke-cake-VAT-007-step-03-31abc53d2199491288011a1e5211d284.jpg"
      ],
      "image": "assets/images/236820/step_03.webp"
    },
    {
      "text": "Whisk cold milk and pudding mix together in a bowl until pudding is soft and thickened, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yNsMOIg1GNjzo4IvMqxS8mghHwM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236820-banana-pudding-poke-cake-VAT-008-step-04-af15ac5ee57f4722b1e4d63a43cd3028.jpg"
      ],
      "image": "assets/images/236820/step_04.webp"
    },
    {
      "text": "Poke holes into the cake using the handle of a clean wooden spoon. Pour pudding over cake, spreading evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EZlYUryBTE15AM-Bp7bBRz1X82s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236820-banana-pudding-poke-cake-VAT-009-step-05-2ccd7bb9e5ce424b8708d5adbb0640a5.jpg"
      ],
      "image": "assets/images/236820/step_05.webp"
    },
    {
      "text": "Spread whipped topping over pudding layer and sprinkle vanilla wafers over whipped topping.",
