  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup cane sugar",
    "1 tablespoon baking powder",
    "1 teaspoon fine sea salt",
    "4 eggs",
    "1 cup fresh strawberries, pureed",
    "0.5 cup unsalted butter, melted",
    "0.5 cup milk",
    "0.25 cup unsalted butter, melted",
    "1 (16 ounce) package confectioners' sugar",
    "4 tablespoons fresh strawberries, pureed, or more as needed",
    "1 cup fresh strawberries",
    "8 leaves fresh mint leaves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9-inch round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, 1 cup strawberry puree, melted butter, and milk until combined. Add to flour mixture; whisk until combined. Pour batter into the prepared cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 35 minutes. Set aside to cool slightly, then invert onto a cooling rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the frosting while the cakes cool. Pour melted butter into a large bowl and sift in confectioners' sugar. Add enough pureed strawberries to make a spreadable frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Frost the cooled cakes and garnish with fresh strawberries and mint.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
