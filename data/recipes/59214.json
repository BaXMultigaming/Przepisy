  "ingredients": [
    "2 cups baking mix (such as Bisquick ®)",
    "0.5 cup brown sugar",
    "0.75 cup chopped pecans",
    "2 tablespoons instant coffee granules",
    "1 large egg",
    "1 cup butter flavored shortening, melted",
    "1 teaspoon vanilla extract",
    "1 cup buttermilk",
    "0.25 cup brown sugar",
    "0.25 cup chopped pecans",
    "0.25 cup graham cracker crumbs",
    "0.25 cup softened butter"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 375 degrees F (190 degrees C). Grease and flour a 10 inch square cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix baking mix, 1/2 cup brown sugar, 3/4 cup chopped pecans, and the instant coffee granules in a large bowl. Whisk together the egg, shortening, buttermilk, and vanilla in a separate large bowl. Stir the dry ingredients into the wet ingredients, mixing just until completely moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into prepared pan. Mix remaining 1/4 cup brown sugar, 1/4 cup chopped pecans, and the graham cracker crumbs in a small bowl. Sprinkle topping evenly over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted in the center comes out clean, about 20 to 25 minutes. Immediately dot top of cake with softened butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
