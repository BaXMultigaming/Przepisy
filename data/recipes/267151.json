  "ingredients": [
    "cooking spray",
    "0.25 cup all-purpose flour",
    "0.125 teaspoon salt",
    "1 pinch ground black pepper",
    "0.5 cup ranch dressing",
    "0.5 cup whole wheat bread crumbs",
    "0.25 cup grated Parmesan cheese",
    "0.25 teaspoon garlic powder",
    "2 zucchini, thinly sliced"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C). Spray the air fryer basket with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, salt, and pepper in a bowl. Pour ranch dressing into a second bowl. Combine bread crumbs, Parmesan cheese, and garlic powder in a third bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working with as many zucchini slices as will fit in the air fryer basket in a single layer, dredge zucchini in flour mixture, then shake off excess. Dip into ranch dressing, then shake off excess. Finally, press into bread crumb mixture to coat both sides. Place into the prepared air fryer basket in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry until browned, 5 to 6 minutes. Repeat with remaining batches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
