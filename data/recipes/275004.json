  "ingredients": [
    "1 (8.8 ounce) package 2-pack naan bread",
    "2 tablespoons olive oil",
    "0.25 teaspoon garlic salt",
    "0.25 teaspoon crushed red pepper flakes",
    "1 small tomato, thinly sliced",
    "2 slices prosciutto",
    "4 ounces sliced fresh mozzarella cheese, or more to taste",
    "freshly cracked black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place a pizza stone on the middle rack of the oven; preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush naans with olive oil and sprinkle with garlic salt and red pepper flakes. Place 3 to 4 slices of tomato on each naan and layer with prosciutto. Top with mozzarella slices and season with pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pizza on the preheated pizza stone. Bake until cheese is melted and bubbling, 7 to 8 minutes. Remove from oven and let sit for 5 minutes before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
