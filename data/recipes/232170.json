  "ingredients": [
    "0.25 cup water",
    "1.5 teaspoons baking powder",
    "2 cups shredded cooked turkey",
    "0.5 cup all-purpose flour",
    "1 egg",
    "salt and ground black pepper to taste",
    "1 tablespoon vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Stir water and baking powder together in a bowl (mixture should foam). Mix turkey, flour, egg, salt, and black pepper into water mixture. Form mixture into bite-sized nuggets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry nuggets in hot vegetable oil until golden brown, 5 to 8 minutes per side.",
      "section": null,
