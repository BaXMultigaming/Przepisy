  "ingredients": [
    "0.25 cup packed brown sugar",
    "2 tablespoons rice vinegar",
    "2 tablespoons maple syrup",
    "ground black pepper to taste",
    "1 pound thick-cut bacon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, rice vinegar, maple syrup, and black pepper in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dVqvpGtrc8rMI7CCq972QtIVnE0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221007-candied-bacon-ddmfs-Step1-5222-4x3-33ef8590819947d1b064047ce11fc47e.jpg"
      ],
      "image": "assets/images/221007/step_02.webp"
    },
    {
      "text": "Place bacon slices on a cooling rack set over a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Odc5GuPcvpNTyjqw50QhuWtsStc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221007-candied-bacon-ddmfs-Step2-5226-4x3-8f0899aa5b8146dc8960816bd6783596.jpg"
      ],
      "image": "assets/images/221007/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 10 minutes, turn slices, and bake another 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove bacon and brush both sides with brown sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7vG1saxPjUFAz9TIG8YznhUgv_Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221007-candied-bacon-ddmfs-Step3-5227-4x3-047351c954054f2c9256a32068cfa599.jpg"
      ],
      "image": "assets/images/221007/step_05.webp"
    },
    {
      "text": "Return bacon to the oven and bake another 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yrsN4m3hDOOo6GKbKhIjQUI52FE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221007-candied-bacon-ddmfs-Step4-5239-4x3-03e388995d454c4b85d6d15b2c6fc9eb.jpg"
      ],
      "image": "assets/images/221007/step_06.webp"
    },
    {
      "text": "Repeat basting every 5 minutes until bacon is browned and crisp, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vLdZlGj7yyWzLQGW2zn1IlNKh4E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221007-candied-bacon-beauty-4x3-fbc9afd8199d432f95a3f0c841c389ec.jpg"
