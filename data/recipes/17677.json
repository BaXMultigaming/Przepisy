  "ingredients": [
    "0.25 cup water",
    "1 cup milk",
    "1 egg",
    "3 cups bread flour",
    "3 tablespoons brown sugar",
    "2 tablespoons white sugar",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "1.5 teaspoons active dry yeast",
    "2 tablespoons margarine, softened",
    "0.75 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Add water, milk, egg, bread flour, brown sugar, white sugar, salt, ground cinnamon, yeast, and margarine to the bread machine pan in the order recommended by the manufacturer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Select the Mix Bread cycle or the setting that adds mix-ins during kneading; start the machine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chocolate chips at the manufacturer’s signal, or about 5 minutes before the kneading cycle is complete.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When the baking cycle is complete, carefully remove the loaf from the pan and transfer it to a wire rack. Let cool before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
