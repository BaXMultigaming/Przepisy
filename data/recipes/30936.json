  "ingredients": [
    "1 cup plain yogurt",
    "2 teaspoons salt",
    "2 teaspoons crushed red pepper flakes",
    "1 teaspoon ginger garlic paste",
    "0.5 teaspoon ground black cumin",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon ground turmeric",
    "2 pounds round steak, cut into pieces",
    "0.75 cup vegetable oil",
    "1 medium onion, thinly sliced",
    "1.5 tablespoons lemon juice",
    "1 bunch fresh cilantro, for garnish",
    "4 fresh green chilies, for garnish"
  ],
  "steps": [
    {
      "text": "Combine yogurt, salt, red pepper flakes, ginger garlic paste, cumin, cloves, and turmeric in a medium bowl. Mix in beef until evenly coated. Set aside for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large heavy skillet over medium-high heat. Fry onion until golden brown. Remove 1 tablespoon onion and set aside for garnish. Reduce heat to low. Place meat in skillet, cover, and cook until tender, about 25 minutes. Check every 10 minutes, and add water if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in lemon juice and simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with cilantro, green chiles, and reserved fried onion.",
