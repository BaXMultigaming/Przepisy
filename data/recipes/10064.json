  "title": "Magic Peanut Butter Middles",
  "description": "A chocolate cookie with a surprise peanut butter center.",
  "authors": [
    "Stephanie"
  ],
  "date_published": "1997-11-07T07:50:53-05:00",
  "date_modified": "2022-07-14T17:58:11-04:00",
