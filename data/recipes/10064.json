  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "0.5 teaspoon baking soda",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "0.5 cup soft margarine",
    "0.25 cup peanut butter",
    "1 teaspoon vanilla extract",
    "1 egg",
    "0.75 cup confectioners' sugar",
    "0.75 cup peanut butter"
  ],
  "steps": [
    {
      "text": "In small bowl blend flour, cocoa and baking soda. Mix until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large bowl beat white and brown sugars, butter or margarine and 1/4 cup peanut butter, until light and fluffy. Add vanilla and egg, beat. Stir in flour mixture until blended. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make Filling: Combine confectioner's sugar and 3/4 cup peanut butter. Blend well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll filling into 30 1-inch balls. For each cookie, with floured hands, shape about 1 tablespoon of dough around 1 peanut butter ball, covering completely. Place 2 inches apart on an ungreased cookie sheet. Flatten with glass dipped in white sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 7-9 minutes. When cookies are done, they should be set and slightly cracked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
