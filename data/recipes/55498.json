  "ingredients": [
    "1 large portobello mushroom, stem removed",
    "1 tablespoon spaghetti sauce",
    "0.5 cup mozzarella cheese",
    "0.5 tablespoon sliced black olives",
    "4 slices pepperoni sausage",
    "1 clove garlic, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the mushroom on a baking sheet, and bake for 5 minutes in the preheated oven. Remove from the oven, and spread spaghetti sauce in the cup of the cap. Top with cheese, olives, pepperoni and garlic.",
