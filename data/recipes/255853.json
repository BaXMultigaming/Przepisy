  "ingredients": [
    "cooking spray",
    "1 (15.25 ounce) package chocolate cake mix",
    "0.25 cup butter, melted",
    "1 egg",
    "2 cups marshmallows",
    "1 (14 ounce) can sweetened condensed milk",
    "12 ounces sweetened flaked coconut",
    "1 cup sliced almonds",
    "1 cup butterscotch chips",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cake mix, butter, and egg together in a bowl until evenly mixed and crumbly; press into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges of crust begin to crisp, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place marshmallows in a microwave-safe bowl; heat in microwave until melted, 20 to 40 seconds. Stir condensed milk, coconut, and almonds into melted marshmallows; spread filling evenly over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butterscotch chips and chocolate chips in a microwave-safe bowl; heat in microwave, stirring every 20 to 30 seconds, until melted, about 1 minute. Spread mixture evenly over filling. Refrigerate until chocolate hardens, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
