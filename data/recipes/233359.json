  "ingredients": [
    "4 sheets Reynolds® Parchment Paper",
    "2.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1 cup unsalted butter, softened",
    "0.75 cup sugar",
    "2 large egg yolks",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine flour, baking powder and salt in large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar with electric mixer until fluffy, about 3 minutes. Beat in egg yolks and vanilla. Gradually add flour mixture and combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap dough in parchment paper and place in Hefty® Slider bag; refrigerate until chilled, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F. Line cookie sheets with Reynolds® Parchment Paper; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out dough 1/8-inch thick between 2 lightly floured sheets of parchment paper. Cut dough with 2 inch cookie cutters. Place dough on parchment-lined cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 6 to 8 minutes or until cookies are lightly browned on edges. Slide parchment paper with cookies onto cooling rack; cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Decorate as desired. Store in airtight containers for up to 5 days.",
      "section": null,
      "name": null,
      "url": null,
