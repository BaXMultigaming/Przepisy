  "ingredients": [
    "1 (9 inch) unbaked pie crust",
    "1 cup evaporated milk",
    "0.5 cup firmly packed brown sugar",
    "1.5 teaspoons firmly packed brown sugar",
    "0.25 cup coffee-flavored liqueur (such as Kahlua®)",
    "0.25 cup light corn syrup",
    "1.25 teaspoons ground cinnamon",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground nutmeg",
    "1 pinch ground ginger",
    "1.5 cups canned pumpkin",
    "2 eggs, slightly beaten"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Press pie crust into a 9-inch pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat evaporated milk, brown sugar, coffee-flavored liqueur, corn syrup, cinnamon, salt, cloves, nutmeg, and ginger together in a bowl using a stand mixer fitted with the whisk attachment until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour pumpkin and eggs into brown sugar mixture; beat until well incorporated. Pour pumpkin mixture into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pie in the preheated oven for 10 minutes. Reduce heat to 325 degrees F (165 degrees C) and continue baking until center begins to firm, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
