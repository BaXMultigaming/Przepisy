  "ingredients": [
    "aluminum foil",
    "2 tilapia fillets",
    "0.5 teaspoon dried dill weed",
    "0.25 teaspoon kosher salt",
    "freshly ground black pepper to taste",
    "10 chives, cut in half",
    "1.5 tablespoons butter, cut into pieces"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Tear off 2 large squares of heavy-duty aluminum foil. Place each fillet on top of a foil square; season with dill, salt, and pepper. Place chives, then butter on top of fillets. Fold up foil into loose packets, leaving room inside for steam to circulate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook fillets on the preheated grill until fish flakes easily with a fork, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
