  "ingredients": [
    "0.25 cup butter",
    "1 onion, diced",
    "1.5 cups pearl barley",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon ground turmeric",
    "0.25 teaspoon curry powder",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "3.5 cups chicken broth",
    "0.25 cup slivered almonds",
    "0.25 cup raisins"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet placed over medium-high heat. Add onion and barley; cook, stirring frequently, until onion begins to soften, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in allspice, turmeric, curry powder, salt, and black pepper. Pour in chicken broth, and bring to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover skillet with lid, and reduce heat to low; simmer until barley is tender, about 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fluff pilaf with a fork, and gently stir in almonds and raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
