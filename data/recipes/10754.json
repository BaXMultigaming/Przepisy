  "ingredients": [
    "1.25 cups white sugar",
    "1 cup vegetable oil",
    "3 eggs",
    "0.25 cup fresh lemon juice",
    "2 teaspoons lemon zest",
    "1.75 cups grated zucchini",
    "2 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "0.25 teaspoon baking powder",
    "1 cup chopped walnuts",
    "0.33333334326744 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, oil, eggs, lemon juice, and lemon zest in a large bowl; mix well. Stir in zucchini until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, salt, and baking powder in a separate bowl; gradually add to zucchini mixture, stirring until thoroughly combined. Stir in walnuts until incorporated. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 35 to 45 minutes. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle top with confectioners' sugar; cut into 24 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
