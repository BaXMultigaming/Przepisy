  "ingredients": [
    "2 tablespoons butter",
    "1 medium onion, chopped",
    "1 teaspoon minced garlic",
    "1 (15.25 ounce) can whole kernel corn, drained",
    "1 (15 ounce) can creamed corn",
    "1 cup sour cream",
    "1 (6 ounce) package cornbread stuffing mix",
    "4 ounces mild Cheddar cheese, grated",
    "0.33333334326744 cup mayonnaise",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a frying pan over medium heat; stir in onion. Saute for 2 minutes. Add garlic; saute for 2 more minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix whole kernel corn, creamed corn, sour cream, stuffing mix, 1/2 of the Cheddar cheese, mayonnaise, salt, and pepper in a large bowl. Mix in sauteed onions and garlic. Pour mixture into the prepared casserole dish and top with remaining Cheddar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until stuffing has fluffed up nicely, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
