  "ingredients": [
    "1 bunch lacinato kale, rinsed and dried",
    "1 tablespoon olive oil",
    "2 cloves garlic, minced",
    "0.25 teaspoon crushed red pepper flakes",
    "2 tablespoons water",
    "1 tablespoon red wine vinegar",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Cut along both sides of kale ribs and discard. Stack kale leaves and slice crosswise into ribbons.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat. Saute garlic and crushed red pepper until fragrant, 20 to 30 seconds. Add kale; toss and saute for 3 minutes. Add water and continue cooking until kale is just wilted, 2 to 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle with red wine vinegar and season with salt. Toss and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
