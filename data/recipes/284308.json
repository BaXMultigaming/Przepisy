  "ingredients": [
    "2 teaspoons kosher salt",
    "1 medium eggplant",
    "2 teaspoons Italian seasoning",
    "1 cup pizza sauce",
    "2 cups shredded low-moisture mozzarella cheese",
    "15 slices turkey pepperoni, or to taste",
    "2 tablespoons sliced black olives, or to taste"
  ],
  "steps": [
    {
      "text": "Slice ends off eggplant and cut into 3/4-inch rounds. Place on a baking sheet and sprinkle liberally on both sides with salt. Let sweat until most of the moisture seeps out, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse eggplant completely, then pat dry. Return to the baking sheet and sprinkle with Italian seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Remove from the oven and top each slice with pizza sauce, cheese, pepperoni, and olives. Return to the oven and bake just until cheese is melted and sauce is heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
