  "ingredients": [
    "2 cups white sugar",
    "3 eggs",
    "1 cup butter, melted",
    "2.5 teaspoons vanilla extract",
    "1.25 cups all-purpose flour",
    "0.75 cup unsweetened cocoa powder",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 cup milk chocolate chips",
    "2 (8 ounce) packages cream cheese, softened",
    "0.75 cup creamy peanut butter",
    "0.25 cup white sugar",
    "1 egg",
    "2 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat 2 cups sugar and 3 eggs together until foamy. Stir in the butter and vanilla. Combine the flour, cocoa, baking powder and salt; stir into the egg mixture. Stir in the chocolate chips. Reserve one cup of the batter, and spread the rest into the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, beat the cream cheese, peanut butter, 1/4 cup of sugar 1 egg and milk until smooth and creamy. Carefully spread the peanut butter batter over the layer of chocolate batter. Drop reserved chocolate batter, by tablespoonfuls onto the peanut butter layer. Cut through the batter with a knife to swirl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 to 40 minutes in the preheated oven, or until brownies are set when shaken gently. Cool completely before cutting into bars. Refrigerate until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
