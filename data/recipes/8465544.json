  "ingredients": [
    "1.5 tablespoons salted butter",
    "2 large eggs",
    "1 tablespoon water",
    "0.125 teaspoon freshly ground black pepper",
    "1 pinch flaky sea salt, or to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a medium nonstick skillet over medium heat. Carefully crack eggs into the skillet and let cook until whites have almost set, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YEA2Gv6V8NZu2FO7U768DjIRdp4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/basted-eggs-mfs-step-2-60-b166b97a549b40c0880bd5717ee3d1fc.jpg"
      ],
      "image": "assets/images/8465544/step_01.webp"
    },
    {
      "text": "Add water, cover skillet with a lid or cookie sheet, reduce heat to medium-low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aLJiUxvLZdO_aa52qzgZb7TX7vc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/basted-eggs-mfs-step-3-62-d029509c5f344c42bdb9fe39f5639517.jpg"
      ],
      "image": "assets/images/8465544/step_02.webp"
    },
    {
      "text": "Let cook until whites have set, yolks are still runny, and some of white has set over yolk, 1 to 2 more minutes. Remove lid and transfer eggs to a serving plate. Garnish with pepper and flaky salt, if desired. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
