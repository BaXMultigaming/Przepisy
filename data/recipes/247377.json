  "ingredients": [
    "0.75 cup chopped fresh asparagus",
    "2 cups all-purpose flour",
    "0.75 teaspoon dried marjoram",
    "0.75 teaspoon ground thyme",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon freshly ground black pepper",
    "0.25 teaspoon salt",
    "1 egg",
    "1 cup buttermilk",
    "1 tablespoon melted butter",
    "1 tablespoon olive oil",
    "2 cups shredded sharp Cheddar cheese",
    "0.5 cup finely chopped green onions",
    "3 tablespoons drained capers"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a 12-cup muffin tin or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place asparagus in a microwave-safe bowl with a small amount of water; cover the bowl with a microwave-safe cover. Microwave on high, in 30 seconds intervals, just until tender. Drain asparagus; set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, marjoram, thyme, baking powder, baking soda, black pepper, and salt together in a large bowl; set aside. Beat egg in a separate bowl; beat in buttermilk, melted butter, and olive oil. Stir in Cheddar cheese, green onions, capers, and asparagus. Stir buttermilk mixture into flour mixture just until dry ingredients are moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter among the prepared muffin cups, filling each ⅔ full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted near centers comes out clean, about 15 minutes. Cool on a wire rack for 3 to 5 minutes; serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
