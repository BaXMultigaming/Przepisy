  "ingredients": [
    "1 cup water",
    "0.5 cup quinoa",
    "1 (19 ounce) can chickpeas (garbanzo beans), rinsed and drained",
    "1 large carrot, peeled and roughly chopped",
    "1 rib celery, roughly chopped",
    "0.5 cup sunflower seeds",
    "0.25 cup shredded cabbage",
    "0.25 onion, chopped",
    "0.25 cup sliced almonds",
    "0.25 cup raisins",
    "0.5 cup reduced-fat mayonnaise",
    "2 tablespoons honey Dijon mustard",
    "1 tablespoon dried kelp flakes",
    "1.5 teaspoons sweet pickle relish",
    "1 teaspoon lemon juice",
    "0.25 teaspoon salt",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender and water has been absorbed, 15 to 20 minutes. Fluff quinoa with a fork and refrigerate until cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chickpeas, carrot, celery, sunflower seeds, cabbage, and onion in a food processor and pulse until everything is roughly equal in size; transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir quinoa, almonds, and raisins into the chickpea mixture; add mayonnaise, mustard, kelp flakes, relish, lemon juice, salt, and pepper. Stir the mixture until evenly seasoned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
