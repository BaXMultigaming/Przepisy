  "title": "Mouth-Watering Stuffed Mushrooms",
  "description": "This savory stuffed mushroom recipe is filled with cream cheese, minced garlic, Parmesan cheese, and cayenne pepper for a mouth-watering appetizer.",
  "authors": [
    "Angie Gorkoff"
  ],
  "date_published": "1999-12-29T01:11:18-05:00",
