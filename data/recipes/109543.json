  "ingredients": [
    "1 (12 inch) pre-baked Italian pizza crust",
    "1.5 cups whole-berry cranberry sauce from a 16-ounce can",
    "2 cups shredded chicken*",
    "4 ounces Brie, cut into small chunks",
    "3 green onions, thinly sliced",
    "0.25 cup slivered almonds",
    "1 cup shredded mozzarella"
  ],
  "steps": [
    {
      "text": "Adjust oven rack to lowest position, and heat oven to 450 degrees. Place crust on a cookie sheet, and spread 1 cup of cranberry sauce over the crust. Toss remaining 1/2 cup with chicken. Top pizza with chicken, brie, green onions, almonds and mozzarella. Bake until the crust is crisp and cheese melts, 10 to 12 minutes. Cut into 6 slices and serve.",
