  "ingredients": [
    "0.75 cup smooth natural peanut butter",
    "2 cloves garlic, minced",
    "2 tablespoons brown sugar",
    "1 tablespoon fish sauce",
    "2 teaspoons soy sauce",
    "2 teaspoons toasted sesame oil",
    "0.5 lime, juiced",
    "1 teaspoon chile-garlic sauce (such as Sriracha), or to taste",
    "1 (5.6 ounce) can coconut milk",
    "2 teaspoons chopped red bell pepper, or to taste",
    "2 teaspoons chopped fresh cilantro, or to taste",
    "2 teaspoons chopped peanuts, or to taste"
  ],
  "steps": [
    {
      "text": "Place peanut butter into a mixing bowl. Whisk in garlic, brown sugar, fish sauce, soy sauce, and sesame oil until combined, followed by lime juice and Sriracha.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring coconut milk to a simmer in a small saucepan over medium heat. Pour hot coconut milk over peanut butter mixture and whisk until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a serving bowl and garnish with chopped red pepper, cilantro, and peanuts.",
      "section": null,
      "name": null,
      "url": null,
