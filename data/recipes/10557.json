  "ingredients": [
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "1 cup shortening",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups quick cooking oats",
    "2 cups orange-flavored fruit slice jelly candies"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, cream together both sugars and shortening until fluffy. Add eggs and vanilla; beat well. Stir flour, baking powder, baking soda, and salt together in another bowl; stir into the creamed mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in oats and orange candy. Using about 1 tablespoon for each cookie, roll into 1-inch balls. Place onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in batches in the preheated oven until lightly browned, 10 to 12 minutes. Remove and cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
