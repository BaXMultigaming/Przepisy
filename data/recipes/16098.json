  "ingredients": [
    "10 slices bacon",
    "1 head fresh broccoli, cut into bite size pieces",
    "0.25 cup red onion, chopped",
    "0.5 cup raisins",
    "3 tablespoons white wine vinegar",
    "2 tablespoons white sugar",
    "1 cup mayonnaise",
    "1 cup sunflower seeds"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine the broccoli, onion and raisins. In a small bowl, whisk together the vinegar, sugar and mayonnaise. Pour over broccoli mixture, and toss until well mixed. Refrigerate for at least two hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Before serving, toss salad with crumbled bacon and sunflower seeds.",
