  "ingredients": [
    "1 pound venison, cut into cubes",
    "0.5 teaspoon garlic powder, or to taste",
    "salt and pepper to taste",
    "1 onion, chopped",
    "2 (10.5 ounce) cans condensed cream of mushroom soup",
    "1 (16 ounce) package uncooked egg noodles",
    "1 (8 ounce) container sour cream"
  ],
  "steps": [
    {
      "text": "Season venison with garlic powder, salt, and pepper; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Sauté onion in the hot skillet until soft and translucent. Add venison and cook until all sides are browned. Drain excess grease. Stir in condensed soup, reduce heat to low, and bring to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook noodles in boiling water until tender yet firm to the bite, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When noodles are almost done cooking, stir sour cream into venison mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain noodles and transfer to a rimmed serving dish. Pour venison mixture over hot, cooked noodles to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
