  "title": "Venison Stroganoff",
  "description": "This venison stroganoff features tender egg noodles, sour cream, mushroom soup, onion, and browned meat all stirred into a creamy comfort food dish.",
  "authors": [
    "Cathy"
  ],
  "date_published": "2000-10-03T14:30:24-04:00",
