  "ingredients": [
    "2 cups all-purpose flour",
    "2 tablespoons white sugar",
    "1 tablespoon baking powder",
    "1 teaspoon ground ginger",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.5 cup cold butter",
    "0.5 cup skim milk",
    "0.25 cup fancy molasses",
    "0.5 tablespoon raw sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, ginger, cinnamon, and cloves in a large bowl; mix well. Use a fork or a pastry cutter to cut butter into the flour mixture. Pour in milk and molasses and stir until all of the flour has been absorbed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place dough onto the prepared baking sheet and use your hands to shape it into a 3/4-inch thick, 8-inch round disk. Sprinkle raw sugar over the top and cut into 8 wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 17 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
