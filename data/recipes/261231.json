  "ingredients": [
    "1 tablespoon butter",
    "1.25 pounds skinless, boneless chicken breast, cubed",
    "5 potatoes, peeled and cubed",
    "1 carrot, sliced",
    "1 onion, chopped",
    "1 tablespoon tomato paste",
    "salt and freshly ground black pepper",
    "water to cover",
    "1 bunch fresh parsley, chopped"
  ],
  "steps": [
    {
      "text": "Melt butter in a large saucepan over medium heat. Add chicken and brown on all sides, about 5 minutes. Add potatoes, carrot, and onion; cook and stir until vegetables begin to soften, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomato paste into the saucepan and season with salt and pepper. Pour enough water to cover and continue to simmer until chicken is no longer pink in the center and vegetables are tender, about 15 minutes. Garnish with fresh parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
