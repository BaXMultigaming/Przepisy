  "steps": [
    {
      "text": "Place cauliflower, garlic, and bay leaf in a pot; pour in enough water to cover. Bring mixture to a boil and cook until cauliflower is tender, about 20 minutes. Drain and discard bay leaf.",
      "section": null,
      "name": null,
      "url": null,
