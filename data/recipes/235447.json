  "ingredients": [
    "1 head cauliflower, chopped",
    "2 cloves garlic",
    "1 bay leaf",
    "water to cover",
    "0.5 cup shredded Cheddar cheese",
    "2 tablespoons butter",
    "2 tablespoons sour cream",
    "salt and ground black pepper to taste"
