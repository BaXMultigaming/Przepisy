  "ingredients": [
    "2 ears corn on the cob, husks and silk removed",
    "2 tomatoes, chopped",
    "2 avocados - peeled, pitted, and diced",
    "1 white onion, chopped",
    "0.5 bunch cilantro, stems cut off and leaves chopped",
    "3 tablespoons chopped garlic",
    "2 tablespoons olive oil",
    "2 tablespoons red wine vinegar",
    "kosher salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat the grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook corn on the preheated grill until kernels are lightly charred but still firm, flipping often, 3 to 5 minutes per side. Cut kernels from cobs, transfer to a large bowl, and cool, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomatoes, avocados, onion, cilantro, garlic, olive oil, and vinegar into corn; season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
