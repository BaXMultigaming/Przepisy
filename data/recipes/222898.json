  "ingredients": [
    "2 ice cubes",
    "2 fluid ounces sloe gin",
    "1 fluid ounce lemon juice",
    "1 teaspoon simple syrup",
    "1 cup ice",
    "4 fluid ounces club soda",
    "1 slice lemon"
  ],
  "steps": [
    {
      "text": "Place 2 ice cubes into a highball glass and set aside in the freezer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sloe gin, lemon juice, and simple syrup in a cocktail shaker. Add 1 cup ice; cover and shake until the outside of the shaker is frosted. Strain into the prepared highball glass.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in club soda and garnish with a slice of lemon.",
      "section": null,
