  "ingredients": [
    "2 cups heavy cream",
    "1 cup milk",
    "0.75 cup white sugar",
    "1 tablespoon vanilla extract",
    "1 teaspoon almond extract",
    "2 cups fresh cherries, pits removed and cut in half"
