  "ingredients": [
    "2 pounds skinless, boneless chicken breasts",
    "2 cups chicken broth",
    "2 cups water, or as needed",
    "salt and pepper to taste",
    "2 cups heavy whipping cream, divided",
    "1 (8 ounce) jar pesto",
    "1 (16 ounce) package egg noodles",
    "8 ounces grated Parmesan-Romano-Asiago cheese",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Place chicken breasts in a slow cooker. Add broth and water to cover; season with salt and pepper. Cover and cook on High until chicken is no longer pink inside, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from the slow cooker and shred using two forks; return chicken to the slow cooker. Stir in 1 cup of cream and pesto; cover and continue to cook on High for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add remaining 1 cup of cream, egg noodles, and 3/4 of the grated cheese to the slow cooker. Stir in milk; cover and continue to cook on High until noodles are tender, about 1 hour more. Top with remaining grated cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
