  "ingredients": [
    "0.5 pound bulk pork sausage",
    "12 eggs",
    "0.5 cup chopped onion",
    "0.5 cup chopped green bell pepper, or to taste",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon garlic powder",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/29yDySGwymvu4vbexvJoeQ9-pCo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222586-scrambled-egg-muffins-ddmfs-step-01-3x4-1100-b3fa794a39384cfa8abf73cfab96df88.jpg"
      ],
      "image": "assets/images/222586/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease 12 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Stir in sausage and cook until crumbly, evenly browned, and no longer pink, 10 to 15 minutes. Drain off grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/90O3a2iAryd4GX4f5JewK3NTlXw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222586-scrambled-egg-muffins-ddmfs-step-02-3x4-1105-3128231fc94f49309988d598b703dcd8.jpg"
      ],
      "image": "assets/images/222586/step_03.webp"
    },
    {
      "text": "Beat eggs in a large bowl. Stir in onion, green pepper, salt, pepper, and garlic powder. Mix in sausage and Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MZbFx8wSSQDDGNNozrQEuCXfKyE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222586-scrambled-egg-muffins-ddmfs-step-03-3x4-1107-9e31fa9088924df2a5c1f2cbc8c0b28d.jpg"
      ],
      "image": "assets/images/222586/step_04.webp"
    },
    {
      "text": "Spoon into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gmUkNulmj0meP5nJ4HZ-lkk2OJ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222586-scrambled-egg-muffins-ddmfs-step-04-3x4-1114-77938565baa04f0c971d10f43db6753e.jpg"
      ],
      "image": "assets/images/222586/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a knife inserted near the center comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JB1MVP6ZaQhZExxbeZceXVyxI-g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222586-scrambled-egg-muffins-ddmfs-step-05-3x4-1136-da1b8cd17e6d4954b2173323165e9a4c.jpg"
      ],
      "image": "assets/images/222586/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
