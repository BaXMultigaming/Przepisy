  "ingredients": [
    "1.5 cups seedless red grapes, chopped",
    "1 avocado - peeled, pitted and diced",
    "0.25 cup chopped red bell pepper",
    "2 tablespoons chopped yellow bell pepper",
    "2 tablespoons chopped sweet onion",
    "2 tablespoons chopped fresh cilantro",
    "1 tablespoon lime juice",
    "0.5 teaspoon garlic salt",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Place the grapes, avocado, red pepper, yellow pepper, onion, and cilantro in a mixing bowl. Season with lime juice, garlic salt, and black pepper. Gently fold the ingredients together until well mixed. Refrigerate 30 minutes before serving.",
