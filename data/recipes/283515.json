  "ingredients": [
    "1 teaspoon olive oil",
    "0.25 cup finely chopped red onion",
    "3 cups baby spinach leaves",
    "0.33333334326744 cup low-sodium marinara sauce",
    "0.33333334326744 cup shredded cooked chicken breast",
    "6 ounces prepared pizza dough",
    "0.33333334326744 cup shredded mozzarella cheese",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Heat oil in a nonstick skillet over medium-high heat. Add onion; cook, stirring occasionally, until tender, about 2 minutes. Stir in spinach; cover and cook until wilted, about 1 1/2 minutes. Remove from heat; stir in marinara and chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 325 degrees F (165 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 4 equal pieces. Roll each piece on a lightly floured work surface into a 6-inch circle. Spread 1/4 of the spinach mixture over the bottom half of each dough circle. Top each with 1/4 of the mozzarella cheese. Fold dough over filling to form half-moons and crimp edges to seal. Coat well with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer calzone to the air fryer basket. Cook for 8 minutes. Turn calzone over; cook until golden brown, about 4 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
