  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C.) Divide dough into 2 pieces and shape into balls. Roll out one ball of dough to fit a 9 inch pie plate. Place bottom crust in pie plate. Roll out top crust and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan, saute the shredded carrot, potato and minced onion until soft. Remove from heat and alow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in the chopped chicken, chicken broth, salt and pepper. Pour into bottom crust. Cover with top crust, seal and crimp edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 to 25 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
