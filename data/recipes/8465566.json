  "ingredients": [
    "2 tablespoons unsalted butter",
    "1 tablespoon minced garlic",
    "1 tablespoon all-purpose flour",
    "1.5 cups heavy cream",
    "1 cup whole milk",
    "1.5 teaspoons kosher salt",
    "2 pounds Yukon Gold potatoes, scrubbed and sliced 1/8-inch thick with peel",
    "0.5 teaspoon chopped fresh thyme, plus more for garnish",
    "0.125 teaspoon ground black pepper",
    "cooking spray",
    "4 ounces Gruyere cheese, shredded"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a medium saucepan over medium-low heat. Add garlic; cook, stirring occasionally, until fragrant, 1 minute. Stir in flour; cook, stirring constantly, for 1 minute. Whisk in heavy cream, milk, and salt until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9e3Li3GzzApEm_wnMSUJruvcNRk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8465566-dauphinoise-potatoes-mfs-step-1-29-b465f96a2b19454485d1911d36cff572.jpg"
      ],
      "image": "assets/images/8465566/step_02.webp"
    },
    {
      "text": "Add sliced potatoes and bring to a simmer; cook, gently stirring occasionally, until potatoes begin to soften, 12 to 15 minutes. Remove from heat; stir in thyme and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mbTTY_wdajA1SMkrmwJwctLlHnI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8465566-dauphinoise-potatoes-mfs-step-2-32-a71943cfc72e468f83c085514f658d12.jpg"
      ],
      "image": "assets/images/8465566/step_03.webp"
    },
    {
      "text": "Layer 1/2 of the potatoes in the prepared baking dish; sprinkle 1/2 cup cheese evenly over potatoes. Top with remaining potatoes and spoon remaining liquid left in the pot over the potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6m3O045yrkItUliJ6Q4MOpZqBJ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8465566-dauphinoise-potatoes-mfs-step-4-39-c476b98bfb914dd182412418420f312b.jpg"
      ],
      "image": "assets/images/8465566/step_04.webp"
    },
    {
      "text": "Top with remaining 1/2 cup cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oB4x6Xfs00i1vAyd0Uci2yh6caI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8465566-dauphinoise-potatoes-mfs-step-5-42-8843b94375a249a2a64b5e53d467ae76.jpg"
      ],
      "image": "assets/images/8465566/step_05.webp"
    },
    {
      "text": "Bake in preheated oven until sauce is thickened, top is browned in spots, and potatoes are tender, 40 to 45 minutes. Let stand 15 minutes before serving; garnish with additional thyme. Recipe developed by Jasmine Smith",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZHbqveC49Dpjjtg_bI5aLGs7q0c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8465566-dauphinoise-potatoes-mfs-step-6-43-196e0d64eaf34f39b542781889fb94e6.jpg"
      ],
      "image": "assets/images/8465566/step_06.webp"
    }
