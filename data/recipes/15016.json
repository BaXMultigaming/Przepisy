  "ingredients": [
    "3 ounces cream cheese",
    "0.5 cup butter",
    "1 cup all-purpose flour",
    "0.75 cup packed brown sugar",
    "1 tablespoon butter",
    "1 egg, beaten",
    "1 teaspoon vanilla extract",
    "0.66666698455811 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 18 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend softened cream cheese and 1/2 cup butter or margarine in a mixing bowl until thoroughly combined. Add flour and mix well. Place in the refrigerator to chill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and 1 tablespoon butter or margarine in a mixing bowl. Add egg and vanilla; blend well. Stir in pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat chilled dough into the bottoms of the 18 paper muffin cups. Pour in filling, distributing evenly between all cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is set, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
