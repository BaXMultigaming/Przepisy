  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 teaspoon butter for greasing pan",
    "0.5 onion, unpeeled, sliced",
    "0.5 cup roughly chopped carrots",
    "0.5 cup roughly chopped celery",
    "2 beef rib bones",
    "4 cups beef bone broth or high quality, low-sodium beef broth",
    "2 cups water",
    "2 tablespoons unsalted butter",
    "1 cup sliced brown mushroom",
    "2 tablespoons reserved beef fat",
    "0.33 cup all-purpose flour",
    "3.5 cups reserved beef stock",
    "1 teaspoon kosher salt, or to taste",
    "Freshly ground black pepper to taste",
    "Cayenne to taste",
    "1 teaspoon balsamic vinegar"
  ],
  "steps": [
    {
      "text": "Gather ingredients. Preheat an oven to 450 degrees F (230 degrees C). Line a baking sheet with foil. Spread out onions, carrots, and celery on the prepared baking sheet. Set rib bones on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oLUxGFAwspRLvynwxkg8BzfqpGs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8519674-prime-rib-gravy-VAT-step-02-01f5228e597e4cf5a6abb7037dc8cd04.jpg"
      ],
      "image": "assets/images/8519674/step_01.webp"
    },
    {
      "text": "Roast until bones are deep brown and onions are black, about 1 hour. Use a spatula or tongs to transfer bones and vegetables into a saucepan. Drain off and reserve any rendered fat from the baking sheet for the gravy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S-XPxSVxbmDELXkl4MrLUVy3TDU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8519674-prime-rib-gravy-VAT-step-03-08efa61e18094070bc68a4607d7ba86f.jpg"
      ],
      "image": "assets/images/8519674/step_02.webp"
    },
    {
      "text": "Add broth and water to the saucepan, and bring to a boil on high heat. Reduce heat to low and simmer until meat falls off bone and is flavorless, about 4 hours. Skim any fat from the surface and reserve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LxFy448Zl12rg7dCnZCpIeClJu0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8519674-prime-rib-gravy-VAT-step-04-2-5348afd80ff040e9aac40c3d1e7126f7.jpg"
      ],
      "image": "assets/images/8519674/step_03.webp"
    },
    {
      "text": "Strain broth and let cool to room temp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yuDEtBUZeVF_LAKKjzL40Op0lwU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8519674-prime-rib-gravy-VAT-step-05-ef37112049c94f939ece471830c8e44c.jpg"
      ],
      "image": "assets/images/8519674/step_04.webp"
    },
    {
      "text": "Melt butter in a pot on medium-high and sauté mushrooms until well browned. Add 2 tablespoons rendered beef fat and stir until melted. Add flour and cook for a few minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xoHD9I9DqT25z-EAYlcIvMu005A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8519674-prime-rib-gravy-VAT-step-06-d157cfb1b6a44ba3860df31e1d4103ac.jpg"
      ],
      "image": "assets/images/8519674/step_05.webp"
    },
    {
      "text": "Whisk in broth, and bring to a simmer. Cook, stirring occasionally, about 5 minutes. Reduce heat to medium and simmer until gravy has thickened to desired thickness, 5 to 10 minutes more",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lToC7lceRskEGQTajAPVR3uWgXs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8519674-prime-rib-gravy-VAT-step-07-ece1c0b1443c465681053e0ff279694f.jpg"
      ],
      "image": "assets/images/8519674/step_06.webp"
    },
    {
      "text": "Adjust salt to taste and season with freshly ground black pepper, cayenne, and balsamic vinegar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nonTJMMDWW01-Q2YIgK2qKZ778w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8519674-prime-rib-gravy-VAT-step-08-cfdf0017a69f496b80ab5fc907e27055.jpg"
      ],
      "image": "assets/images/8519674/step_07.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sUk63uf2xD53Ko1AUYbhl0EtZLQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8519674-prime-rib-gravy-VAT-4x3-9b4781bcbef7418ea0addbc2d0310665.jpg"
      ],
      "image": "assets/images/8519674/step_08.webp"
    }
  ],
