  "title": "Prime Rib Gravy",
  "description": "A magnificent, beefy gravy with a rich flavor that can be served over prime rib, or even alone with some potatoes.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2022-12-16T09:00:00-05:00",
  "date_modified": "2024-11-21T15:20:25-05:00",
  "prep_time": "PT25M",
  "cook_time": "PT310M",
  "total_time": "PT335M",
  "yield": [
    "4",
