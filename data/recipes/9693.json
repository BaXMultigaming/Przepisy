  "ingredients": [
    "0.5 pound almond paste",
    "1 cup white sugar",
    "3 egg whites",
    "0.125 teaspoon salt",
    "2 tablespoons cake flour",
    "0.33333298563957 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Cover cookie sheets with parchment paper or aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large mixing bowl, soften almond paste with your hands or food processor. Mix in white sugar and egg whites until well blended. Mix in the confectioners' sugar, flour, and salt until smooth and well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Force dough through a cookie press or drop by teaspoonfuls onto cookie sheets. Cover and let stand for 30 minutes. Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 minutes. Remove foil or parchment from sheets and let cool. Peel off macaroons.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
