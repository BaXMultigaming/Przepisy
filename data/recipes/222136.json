  "ingredients": [
    "4 cups whole wheat elbow macaroni",
    "1 cup mayonnaise",
    "0.33333334326744 cup white sugar",
    "0.25 cup distilled white vinegar",
    "2.5 tablespoons prepared yellow mustard",
    "1.5 teaspoons salt",
    "0.5 teaspoon ground black pepper",
    "1 large onion, chopped",
    "1 green bell pepper, seeded and chopped",
    "1 red bell pepper, seeded and chopped",
    "2 stalks celery, chopped",
    "0.25 cup grated carrot",
    "2 tablespoons chopped pimento peppers"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and rinse under cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together mayonnaise, sugar, vinegar, mustard, salt, and black pepper in a large bowl. Stir in macaroni, onion, bell peppers, celery, carrot, and pimento peppers until well combined. Cover and refrigerate for at least 4 hours or overnight before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
