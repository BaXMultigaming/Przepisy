  "ingredients": [
    "2.5 cups oats",
    "1.5 cups quinoa",
    "1 cup slivered almonds",
    "0.33333334326744 cup chia seeds",
    "1 cup crunchy peanut butter",
    "0.5 cup honey",
    "0.25 cup coconut oil, warmed",
    "0.5 cup flaxseed meal",
    "1 teaspoon salt",
    "2 cups dark chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spread oats, quinoa, almonds, and chia seeds on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast in the preheated oven, stirring halfway through, until golden brown, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix peanut butter, honey, and coconut oil together in a bowl until thoroughly combined. Mix in oat mixture, flaxseed meal, and salt until well combined. Press granola mixture into a 12x18-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bars set, about 5 minutes. Remove from oven; sprinkle with chocolate chips. Bake until chocolate is just melted, about 5 minutes. Spread melted chocolate evenly over bars with a rubber spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in the freezer until chocolate is firm, about 20 minutes; cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
