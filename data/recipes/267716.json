  "ingredients": [
    "2 cups shredded Cheddar cheese",
    "0.5 cup mayonnaise",
    "2 pounds ground beef",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon Creole seasoning (such as Tony Cachere's®)",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "1 (15 ounce) package slider buns (such as Pepperidge Farm®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Cheddar cheese and mayonnaise; refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef, salt, pepper, Creole seasoning, onion powder, and garlic powder together. Form mixture into 12 slider patties; place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake patties in the preheated oven, flipping once, for about 15 minutes. Remove from oven and top each patty with 1 tablespoon of the cheese-mayonnaise mixture. Continue baking until cheese has melted, 1 to 2 minutes more. Serve on slider buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
