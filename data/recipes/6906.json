  "title": "Scottish Oat Scones",
  "description": "These oatmeal scones are made with currants, egg, sugar, butter, milk, and lots of rolled oats for a softly sweet and heart-healthy breakfast pastry.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-08-30T12:13:15-04:00",
