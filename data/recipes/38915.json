  "ingredients": [
    "2 quarts soy milk",
    "4 inch piece fresh ginger root - peeled, sliced and crushed",
    "1.5 tablespoons whole cardamom pods, coarsely crushed",
    "1 tablespoon whole cloves, coarsely crushed",
    "1 cinnamon stick",
    "2 tablespoons brown sugar"
