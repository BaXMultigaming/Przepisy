  "ingredients": [
    "2 cups all-purpose flour",
    "0.25 cup sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1 orange, zested",
    "6 tablespoons unsalted butter, chilled",
    "0.66666668653488 cup Original Unsweetened Almond Breeze Almondmilk",
    "1 orange, juiced",
    "1 cup fresh or frozen cranberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, whisk together flour, sugar, baking powder, salt and orange zest. Cut butter into small cubes and cut into mixture until coarse and crumbly. Stir in Almond Breeze Almondmilk and orange juice, then fold in the cranberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a floured surface, knead dough until it just comes together. Pat into a 1-inch round, cut into 8 wedges and place on a baking sheet. Brush tops with Almond Breeze Almondmilk, sprinkle with sugar and bake until golden brown for 12-15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
