  "title": "Spicy Vegan Chili",
  "description": "This chili recipe with rice and beans has been tweaked to be vegan. Jalapeño peppers add spice.",
  "authors": [
    "karkar"
  ],
  "date_published": "2019-04-04T00:16:49-04:00",
