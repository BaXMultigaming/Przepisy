  "ingredients": [
    "1.3333333730698 cups all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.5 cup white sugar",
    "1.5 tablespoons white sugar",
    "0.5 cup butter",
    "2 eggs",
    "1 teaspoon vegetable oil",
    "1 teaspoon milk",
    "2 (1.55 ounce) bars milk chocolate bars, chopped",
    "2 ounces marzipan, cut into small squares"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, cocoa powder, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 cup plus 1 1/2 tablespoon sugar and butter in a large bowl; beat with an electric mixer until light and fluffy. Beat in eggs one at a time. Fold in flour mixture until dough comes together; mix in vegetable oil and milk. Fold milk chocolate and marzipan into the dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of the dough on the lined baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are browned, about 13 minutes. Cool on the baking sheets for 5 minutes. Transfer to a wire rack to cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
