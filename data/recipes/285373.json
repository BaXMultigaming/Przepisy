  "ingredients": [
    "1 (12 ounce) box crispy rice cereal squares (such as Rice Chex®)",
    "1.3333333730698 cups semisweet chocolate chips",
    "0.5 cup peanut butter",
    "1 (18.4 ounce) package brownie mix",
    "1 cup candy-coated chocolate-covered peanuts",
    "2 cups mini pretzel twists"
  ],
  "steps": [
    {
      "text": "Pour cereal squares into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chocolate chips and peanut butter in a large microwave-safe bowl. Microwave on high in 30-second intervals, stirring in between, until smooth, about 1 1/2 minutes. Pour over cereal squares and stir until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place brownie mix in a container with a tight fitting lid, or in a large zip-top bag. Add 1/2 of the coated cereal in 2 batches and shake to coat. Spread on a sheet of waxed or parchment paper. Discard any leftover brownie mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cereal sit until cool and dry, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cereal to a large bowl. Add pretzels and chocolate-coated candies and toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
