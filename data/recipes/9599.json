  "ingredients": [
    "baking spray",
    "2 cups white sugar",
    "1.5 cups all-purpose flour",
    "1 cup butter, melted",
    "4 eggs",
    "0.5 cup cocoa powder",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 cup walnut halves"
  ],
  "steps": [
