      "image": "assets/images/9599/step_04.webp"
    },
    {
      "text": "Decorate with walnut halves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sJtgG2w8745eqUTbdPxDmu45aAc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9599-Quick-Easy-Brownies-ddmfs-step-4-74fbe68160014ddb88718338301b49a0.jpg"
