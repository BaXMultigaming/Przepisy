  "ingredients": [
    "0.75 cup sorghum flour",
    "0.75 cup almond flour",
    "0.25 cup rice flour",
    "0.25 cup tapioca flour",
    "1 tablespoon xanthan gum",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1.75 cups white sugar",
    "1 cup vegetable oil",
    "3 eggs",
    "4 small Golden Delicious apples - peeled, cored, and chopped",
    "0.5 cup coarsely chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch pan; lightly flour with gluten-free flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sorghum flour, almond flour, rice flour, tapioca flour, xanthan gum, cinnamon, baking soda, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, vegetable oil, and eggs together in a separate bowl; stir into flour mixture until incorporated and batter is thoroughly combined. Fold in apples and walnuts. Pour and press batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the middle of the cake comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
