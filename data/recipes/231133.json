  "ingredients": [
    "1 tablespoon olive oil",
    "1 yellow onion, diced",
    "1 green bell pepper, diced",
    "2 cloves garlic, chopped",
    "1.5 teaspoons cayenne pepper",
    "1 avocado, mashed",
    "0.5 cup tomato sauce",
    "2 tablespoons lemon juice",
    "1 tablespoon olive oil",
    "1 tablespoon ground coriander",
    "1 tablespoon chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a skillet over medium heat. Cook and stir onion, bell pepper, and garlic in the hot oil until the onion is translucent, 5 to 7 minutes. Dust the onion mixture with cayenne pepper and transfer to a bowl; set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss avocado, tomato sauce, lemon juice, olive oil, coriander, and cilantro together in a large bowl. Add onion mixture and gently mix to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bowl with plastic wrap; refrigerate until cool, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
