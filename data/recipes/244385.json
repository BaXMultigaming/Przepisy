  "ingredients": [
    "1 cup coconut milk",
    "1 cup milk",
    "0.5 cup white sugar",
    "0.33333334326744 cup shredded coconut",
    "2 tablespoons cornstarch",
    "1 egg",
    "1 tablespoon orange zest",
    "1 large banana, cut into 1/2-inch slices",
