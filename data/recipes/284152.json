  "ingredients": [
    "2 tablespoons butter",
    "1 large onion, chopped",
    "1 cup sliced mushrooms",
    "0.75 cup chopped celery",
    "0.33333334326744 cup all-purpose flour",
    "1 teaspoon poultry seasoning",
    "0.25 teaspoon dried savory",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1.5 cups chicken broth",
    "1 (8 ounce) package cream cheese, softened",
    "2.5 cups chopped cooked chicken",
    "1 cup frozen mixed vegetables",
    "0.5 (17.5 ounce) package frozen puff pastry, thawed",
    "1 large egg, beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Add onion, mushrooms, and celery; cook until vegetables are softened, 4 to 5 minutes. Stir in flour, poultry seasoning, savory, salt, and pepper. Add broth and cream cheese all at once. Cook and stir until thick and bubbly, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chicken and frozen vegetables. Pour into a 2-quart baking dish. Place puff pastry sheet over the chicken mixture and brush with beaten egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until puff pastry is golden brown and chicken mixture is bubbly, 20 to 25 minutes. Remove from the oven and let cool for 20 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
