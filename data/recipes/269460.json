  "ingredients": [
    "0.75 cup coconut oil",
    "0.75 cup white sugar",
    "0.75 cup brown sugar",
    "0.5 cup unsweetened applesauce",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "0.25 cup cocoa powder",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.66666668653488 cup vegan white chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together coconut oil, white sugar, and brown sugar in a bowl using an electric mixer. Gradually add applesauce and mix to combine. Blend in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cocoa powder, baking powder, and salt in a bowl. Gradually add flour mixture to the bowl with the coconut oil mixture and mix until batter is smooth. Fold in white chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough out into 2-inch balls and place onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cookies in the preheated oven until edges are crispy, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
