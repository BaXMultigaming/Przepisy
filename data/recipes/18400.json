    {
      "text": "Spread coconut on waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FyGhbR8GON5M9H9HDb_V5JsmdpU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18400-stained-glass-candy-VAT-step-02-1a61cd321b4f425a8e95b0f8fcf54b1a.jpg"
      ],
      "image": "assets/images/18400/step_02.webp"
    },
    {
      "text": "Divide cooled dough into two even portions. Form each portion into a long roll. Coat rolls with coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-2zyFU1cl1TMDW06SXMabwwipRQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18400-stained-glass-candy-VAT-step-03-aa2252407c3a42e9b0bbf2dd888f4fbe.jpg"
      ],
      "image": "assets/images/18400/step_03.webp"
    },
    {
      "text": "Wrap rolls in waxed paper and then again in plastic wrap. Refrigerate overnight or longer.",
