  "title": "Chocolate Covered Cherry Cookies",
  "description": "Chocolate cherry cookies with a rich chocolate cherry glaze. These decadent treats taste as good as they sound and will disappear at holiday parties!",
  "authors": [
    "JAMIE CARPENTER"
  ],
  "date_published": "1997-08-04T03:47:07-04:00",
