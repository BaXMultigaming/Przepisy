  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter",
    "1 egg",
    "1.5 teaspoons vanilla extract",
    "1.5 cups all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "0.25 teaspoon salt",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "1 (10 ounce) jar maraschino cherries",
    "0.5 cup sweetened condensed milk",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until light and fluffy. Add egg and vanilla; beat well. Stir in flour, cocoa powder, salt, baking soda, and baking powder until smooth. Roll dough into walnut-size balls and place 2 inches apart on ungreased cookie sheets. Make an indentation with your thumb in the center of each cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain cherries and reserve juice. Place a cherry in the indentation of each cookie ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chocolate chips with condensed milk in a saucepan over low heat; stir until chocolate is melted. Stir in 4 teaspoons of cherry juice. Drizzle or spoon about 1 teaspoon of chocolate cherry mixture over each cherry to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated for 10 minutes. Cool on the baking sheets briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
