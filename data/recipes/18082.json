  "ingredients": [
    "10 pounds potatoes, peeled",
    "0.5 cup butter",
    "0.33333331346512 cup heavy cream",
    "1 tablespoon salt",
    "1 tablespoon white sugar",
    "2.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fZgrJjXSwcpvOLwumKBQg4vy3tQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18082-norwegian-lefse-step-1-BP-2933-4x3-fd436ae4a18a4ac3b284f292713e9c65.jpg"
      ],
      "image": "assets/images/18082/step_01.webp"
    },
    {
      "text": "Place potatoes in a large pot and cover with water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Run hot potatoes through a potato ricer into a large bowl. Beat butter, cream, salt, and sugar into riced potatoes. Let cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9aFKAy3uLWOJjsICV2bN3WF8nIE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18082-norwegian-lefse-step-2-BP-2951-4x3-5a5e95c4724c49d483e55993100f9bb2.jpg"
      ],
      "image": "assets/images/18082/step_03.webp"
    },
    {
      "text": "Stir flour into potato mixture to form a soft dough. Pull off pieces of dough and form into walnut-sized balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ogs5PDytMCWDLI_9LE5EiFb6t0U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18082-norwegian-lefse-step-5-BP-2981-4x3-a752c0333eb04190bd5bb77a4eab6e66.jpg"
      ],
      "image": "assets/images/18082/step_04.webp"
    },
    {
      "text": "Lightly flour a clean cloth and roll out lefse balls to 1/8-inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/42wZbSJYljDTtUOuYwV4x5q6gL0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18082-norwegian-lefse-step-6-BP-2992-4x3-f2b9d9019cc941df912013ea6b98b836.jpg"
      ],
      "image": "assets/images/18082/step_05.webp"
    },
    {
      "text": "Heat a griddle over high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook lefse on the hot griddle until brown blisters form, about 1 minute per side. Place cooked lefse on a damp towel to cool slightly. Repeat with remaining dough, stacking them on top of each other as they're cooked; cover until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yq2SHhCEnfNctS0tpu6mhG2QB40=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18082-norwegian-lefse-BP-3009-4x3-7315b3583c0a48258cf67e5e25ec7e99.jpg"
      ],
      "image": "assets/images/18082/step_07.webp"
    }
  ],
