  "ingredients": [
    "2 cups shredded Cheddar cheese",
    "1 cup all-purpose flour",
    "6 tablespoons chilled butter, chopped",
    "0.5 cup hot pepper jelly"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_HUz1k27t4U70qwZPlLhM_hGuak=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-223553-cheesy-thumbprint-appetizers-with-hot-pepper-jelly-VAT-step-01-17714fd1068e4d829e347c401f9b2578.jpg"
      ],
      "image": "assets/images/223553/step_01.webp"
    },
    {
      "text": "Blend Cheddar cheese, flour, and butter in a food processor until dough is a coarse-meal texture and forms into a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q2hJNT56uEewunJ2FamyVy9Yzw0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-223553-cheesy-thumbprint-appetizers-with-hot-pepper-jelly-VAT-step-02-cf2387ea8a084a74b7cd666bab1a3e53.jpg"
      ],
      "image": "assets/images/223553/step_02.webp"
    },
    {
      "text": "Wrap dough in plastic wrap and refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FxAiUob8TYxSEv6Ty7RqTZhWKXQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-223553-cheesy-thumbprint-appetizers-with-hot-pepper-jelly-VAT-step-03-d6c025134d5a4195b58aed6eb726684f.jpg"
      ],
      "image": "assets/images/223553/step_03.webp"
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Shape dough into 1 1/2-inch balls and place 1-inch apart on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BA8qPb-AS_7DNPBxD3--IPWw6Aw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-223553-cheesy-thumbprint-appetizers-with-hot-pepper-jelly-VAT-step-04-b6d9b0b3295b42dc9b1633f8d7c2a796.jpg"
      ],
      "image": "assets/images/223553/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 5 minutes. Remove from the oven; press thumb into top of each ball, creating an indentation.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EvKiUVediO-PgIE0FDvO2ReTyic=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-223553-cheesy-thumbprint-appetizers-with-hot-pepper-jelly-VAT-step-05-1thumbinhand-b4c6b70d982a4b17bae48adae4737ba0.jpg"
      ],
      "image": "assets/images/223553/step_05.webp"
    },
    {
      "text": "Spoon about 1 teaspoon pepper jelly into indentation. Bake until edges are golden brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5m2fNF7pQ-qeSlgKlm-cI1K5Vb0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-223553-cheesy-thumbprint-appetizers-with-hot-pepper-jelly-VAT-step-06-dea5fd955c9844a2a98b798436101092.jpg"
