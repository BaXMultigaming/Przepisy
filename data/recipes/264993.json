  "ingredients": [
    "2 large eggs",
    "1 medium avocado, halved and pitted",
    "0.25 cup shredded Cheddar cheese",
    "salt and freshly ground black pepper to taste",
    "1 tablespoon chopped fresh parsley, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Crack each egg into a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop some avocado flesh out from each pit cavity to make room for one egg. Place avocado halves onto a baking sheet; gently pour an egg into each cavity.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until eggs are cooked through, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and transfer to a plate. Sprinkle Cheddar cheese on top, season with salt and pepper, and garnish with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
