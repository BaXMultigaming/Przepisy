  "ingredients": [
    "0.33333334326744 cup fresh lemon juice",
    "4 teaspoons lemon zest",
    "3 cloves garlic, minced",
    "2 teaspoons Dijon mustard",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup olive oil",
