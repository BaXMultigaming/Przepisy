  "ingredients": [
    "1 cup butter",
    "0.66666698455811 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2.5 cups sifted all-purpose flour",
    "0.5 teaspoon salt",
    "2 teaspoons ground cinnamon",
    "3 cups sifted confectioners' sugar",
    "1 tablespoon vanilla extract",
    "0.125 teaspoon salt",
    "0.5 cup butter, melted",
    "3 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Cream together 1 cup butter and white sugar. Beat in the egg and 1 teaspoon vanilla. Combine together the sifted flour, salt and ground cinnamon and stir into butter mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and chill dough for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly flour a rolling pin. Roll out dough on lightly floured wax paper and cut with cookie cutter. As dough warms it becomes unworkable. Return to refrigerator as needed. Bake on ungreased cookie sheet 15-20 minutes until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Icing: Sift confectioners' sugar into mixing bowl. Add vanilla, salt, and butter. Add milk one tablespoon at a time while beating until spreadable consistency. Continue beating on medium for 10 minutes. Ice cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
