  "ingredients": [
    "8 ounces dry bow-tie pasta",
    "12 ounces sweet Italian sausage, cut into 3/4-inch pieces",
    "1.5 cups thinly sliced onion",
    "1.5 cups thinly sliced red bell pepper",
    "1.5 cups thinly sliced green bell pepper",
    "1.5 cups thinly sliced yellow bell pepper",
    "2 (15 ounce) cans CONTADINA® Tomato Sauce",
    "0.5 teaspoon dried oregano",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Cook pasta according to package directions; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook sausage and onion in large non-stick skillet until sausage is lightly browned. Drain if needed. Add peppers; cook 2 minutes, stirring frequently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomato sauce and oregano. Bring to a boil. Reduce heat; simmer, uncovered, 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in pasta and toss with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
