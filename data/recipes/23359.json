  "title": "Run For The Roses Pie",
  "description": "This \"Run for the Roses\" pie recipe is a true Kentucky Derby favorite that features semisweet chocolate, walnuts, bourbon, molasses, and corn syrup.",
  "authors": [
    "LANA ENKE"
  ],
  "date_published": "2000-10-26T18:26:36-04:00",
