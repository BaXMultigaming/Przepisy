  "ingredients": [
    "1 cup brown sugar",
    "0.33333298563957 cup light corn syrup",
    "0.33333298563957 cup unsulfured molasses",
    "3 tablespoons butter",
    "3 tablespoons bourbon",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "4 eggs",
    "3 tablespoons half-and-half cream",
    "2 cups chopped walnuts",
    "0.33333298563957 cup semisweet chocolate chips",
    "1 (9 inch) unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, corn syrup, molasses, butter, bourbon, vanilla extract, and salt in a large, heavy saucepan; bring to a boil, stirring frequently. Continue to boil for 1 minute, stirring constantly. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and half-and-half together in a medium bowl until blended; stir into cooled syrup mixture until combined. Stir in walnuts and chocolate chips; pour into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 45 to 50 minutes. Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
