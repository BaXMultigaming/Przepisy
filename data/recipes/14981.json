  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "3 tablespoons salsa",
    "1 (1.25 ounce) package chili seasoning mix",
    "1 cup chopped pecans",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "In a medium-sized mixing bowl, combine cream cheese, salsa and chili seasoning mix. Mix until well combined, then shape it into a log or ball. Cover the prepared ball or log with chopped pecans, then with the cheese. Refrigerate the log until you are ready to serve it.",
