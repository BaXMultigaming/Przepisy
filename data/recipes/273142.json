  "ingredients": [
    "1 cup old-fashioned oats",
    "1 cup all-purpose flour",
    "0.5 cup whole wheat flour",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon sea salt",
    "1 cup unsweetened applesauce",
    "2 egg whites",
    "0.5 cup skim milk",
    "0.5 cup brown sugar",
    "2 tablespoons canola oil",
    "2 teaspoons vanilla extract",
    "0.5 cup fresh raspberries",
    "0.25 cup fresh blueberries",
    "0.25 cup fresh blackberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line 12 muffin cups with paper or foil liners, or grease if not using liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, all-purpose flour, whole wheat flour, baking powder, baking soda, cinnamon, nutmeg, salt, applesauce, egg whites, milk, brown sugar, oil, and vanilla in a large bowl. Mix until blended. Fold in raspberries, blueberries, and blackberries; batter will be lumpy and thick. Divide batter evenly into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 15 to 17 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let muffins cool for 5 minutes in the pan before transferring to a cooling rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
