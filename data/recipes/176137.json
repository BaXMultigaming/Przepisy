  "ingredients": [
    "1 (14.5 ounce) can whole peeled tomatoes",
    "1 fresh jalapeno pepper, seeded",
    "1 chipotle chile in adobo sauce, seeded",
    "1 (1 inch) piece dried ancho chile pepper",
    "1 clove garlic",
    "2.5 tablespoons chopped onion",
    "1 tablespoon chopped fresh cilantro",
    "1 tablespoon lemon juice, or to taste",
    "0.75 teaspoon salt",
    "0.25 teaspoon white sugar, or to taste",
    "0.25 teaspoon ground cumin"
  ],
  "steps": [
    {
      "text": "Place the tomatoes, jalapeno pepper, chipotle pepper, ancho chile, garlic, onion, cilantro, lemon juice, salt, sugar, and cumin into a blender. Pulse until the salsa has been finely ground, or to your desired consistency. Let stand at least 1 hour to allow the flavors to blend.",
