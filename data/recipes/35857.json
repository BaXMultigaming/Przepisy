  "ingredients": [
    "2 (8 ounce) containers plain yogurt, divided",
    "1 (1 ounce) package dry Ranch-style dressing mix",
    "1 cucumber, peeled, seeded, and chopped",
    "1.5 pounds ground beef",
    "0.25 cup diced onion",
    "6 pita bread rounds",
    "2 cups torn lettuce leaves",
    "1 tomato, seeded and diced"
  ],
  "steps": [
    {
      "text": "In a medium bowl, combine 1 container of plain yogurt with the envelope of ranch dressing mix. Remove half of the mixture to another bowl. Into one of the bowls, add the remaining container of plain yogurt and diced cucumber; mix well. Cover and refrigerate. Preheat grill and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the ground beef and 1/4 cup onion into the remaining half of the yogurt mixture. Shape into 6 hamburger patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill patties on medium heat for 7 minutes each side, turning once.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut off 1/4 end of the pita pockets and fill with torn lettuce, grilled burger, creamy cucumber sauce and diced tomatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
