  "ingredients": [
    "1 bunch fresh asparagus",
    "0.25 cup water",
    "1 lemon",
    "0.125 teaspoon ground black pepper",
    "0.125 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Take each spear of asparagus and break it towards the end, wherever it naturally snaps, to remove woody ends. Place asparagus in a microwave-safe glass container with a lid. Pour in water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll lemon on a flat work surface to release the juices; slice in half. Squeeze each half over the asparagus. Sprinkle with pepper and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover container and place in the microwave. Cook on high until tender-crisp, 5 to 6 minutes. Drain and let stand for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
