  "ingredients": [
    "1 pound medium seashell pasta",
    "1 (10 ounce) package frozen chopped spinach",
    "1 pound lean ground beef",
    "2 (26 ounce) jars pasta sauce",
    "8 ounces shredded Cheddar cheese, divided"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook spinach according to package directions; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a skillet over medium heat, cook ground beef until brown; drain. In a large bowl, stir together cooked beef, spinach, pasta sauce and all but 1/4 cup of the Cheddar cheese. Reserve 2 cups of sauce mixture. Stir the pasta shells into the remaining sauce mixture. Pour shell mixture into a 9x13 inch baking dish and top with reserved sauce and sprinkle with reserved cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 45 minutes, until browned and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
