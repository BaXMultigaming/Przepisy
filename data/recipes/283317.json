  "ingredients": [
    "2 cups flour, plus more for dusting",
    "1 tablespoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon white sugar",
    "0.33333334326744 cup cold butter, cubed",
    "1 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a cookie sheet with parchment paper and spray with nonstick cooking spray. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, baking soda, salt, and sugar in a large bowl. Cut in cold butter. Add buttermilk and stir until just combined. Do not overmix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place on a floured surface and pat into a circle about 1-inch thick. Cut biscuits using a 3.5-inch biscuit cutter. Arrange 6 biscuits in a circle, 1 in the center, edges touching.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bottoms are browned and tops are starting to brown, 11 to 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
