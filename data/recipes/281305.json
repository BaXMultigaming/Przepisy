  "ingredients": [
    "2 heads romaine lettuce, washed and dried",
    "2 tablespoons olive oil",
    "1 tablespoon lemon juice",
    "1 teaspoon rice vinegar",
    "freshly ground black pepper to taste",
    "2 pinches flaky sea salt (such as Maldon®)"
  ],
  "steps": [
    {
      "text": "Trim and discard root end romaine; slice leaves into thin ribbons, about 1/8-inch-thick, discarding any pieces of core. Transfer to a large bowl; toss gently to separate romaine ribbons.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle olive oil, lemon juice, vinegar, and pepper over romaine; toss to coat. Set aside to rest for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with sea salt and toss gently right before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
