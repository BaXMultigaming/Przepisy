  "ingredients": [
    "1 pound ground ham",
    "1.5 pounds lean ground beef",
    "1 egg",
    "1 cup milk",
    "1 cup bread crumbs",
    "0.5 teaspoon salt",
    "ground black pepper to taste",
    "0.5 cup packed brown sugar",
    "0.5 cup water",
    "1 teaspoon ground mustard",
    "0.25 cup distilled white vinegar"
  ],
  "steps": [
    {
      "text": "Combine ham, beef, egg, milk, bread crumbs, salt, and pepper. Form into loaf. Place in a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, water, mustard, and vinegar in a small saucepan over medium high heat. Bring to boil, and boil for 10 minutes. Pour over loaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) until done, about 1 hour, basting occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
