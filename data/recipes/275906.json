  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "0.75 cup white sugar",
    "0.75 cup dried cranberries",
    "0.75 cup chopped walnuts",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.75 cup apple cider",
    "2 eggs",
    "0.125 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x5-inch loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, cranberries, walnuts, baking powder, baking soda, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat apple cider, eggs, and vegetable oil in a separate bowl until frothy. Mix apple cider mixture into flour mixture until moist; pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
