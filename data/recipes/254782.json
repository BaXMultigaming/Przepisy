  "ingredients": [
    "1 cup chopped sweet potato",
    "1.5 cups white sugar",
    "0.5 cup vegetable oil",
    "1 over-ripe banana",
    "1.75 cups sifted all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "0.125 teaspoon baking powder",
    "0.33333334326744 cup water",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a large pot. Add sweet potatoes and cook until tender, 20 to 30 minutes; drain. Place sweet potatoes in a bowl and mash with a potato masher until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar and oil together in a bowl until well mixed; beat in banana. Combine flour, baking soda, cinnamon, nutmeg, salt, and baking powder in a separate bowl. Alternate stirring the flour mixture and 1/3 cup water into the sugar mixture until combined. Mix in sweet potatoes and pecans; stir until batter is smooth. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
