  "ingredients": [
    "1 (10.75 ounce) can condensed tomato soup, divided",
    "1.5 pounds ground beef",
    "0.5 cup dry bread crumbs",
    "1 egg, lightly beaten",
    "0.25 cup chopped onion",
    "1 teaspoon salt",
    "1 teaspoon pepper",
    "0.25 cup water",
    "0.5 teaspoon prepared yellow mustard",
    "0.5 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "In a large bowl, mix together 1/4 cup of the tomato soup, ground beef, bread crumbs, egg, onion, salt and pepper using your hands. Shape firmly into two loaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dkIEa156OzLMMwB0oVTtvmHmMNw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/72845-skillet-meatloaf-ddmfs-step-2-216-22ca9c409b3d42beaba225007316debb.jpg"
      ],
      "image": "assets/images/72845/step_01.webp"
    },
    {
      "text": "Heat a large deep skillet over medium-high heat. Brown the meatloaves in the hot skillet, then reduce heat to medium and cover with a lid. Simmer for about 25 minutes, or until meat is cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k_SPN_ifpWt9T4bwY_JJshqixH8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/72845-skillet-meatloaf-ddmfs-step-3-225-4db9936efd9b4a17824101e5f159fc91.jpg"
      ],
      "image": "assets/images/72845/step_02.webp"
    },
    {
      "text": "Spoon the fat from the skillet, and stir in the remaining soup, water, and mustard. Top with mozzarella cheese, and let simmer uncovered for 10 minutes, stirring sauce occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xzdWK7jYjTnrvjzLVcWOh-QvKhc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/72845-skillet-meatloaf-ddmfs-step-5-230-b37f55f6d13a4becb66cea8ee5e929cc.jpg"
      ],
      "image": "assets/images/72845/step_03.webp"
    }
