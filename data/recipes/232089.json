  "ingredients": [
    "1 head cauliflower, coarsely chopped",
    "1 (4 ounce) package cream cheese, softened",
    "0.25 cup grated Parmesan cheese",
    "0.5 teaspoon garlic powder",
    "salt and ground black pepper to taste",
    "0.25 cup shredded Cheddar cheese, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add cauliflower, cover, and steam until tender, 5 to 10 minutes. Transfer cauliflower to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash cauliflower with cream cheese until smooth; stir in Parmesan cheese, garlic powder, salt, and black pepper. Spoon mixture into a 1-quart casserole dish; top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling and Cheddar cheese is melted, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
