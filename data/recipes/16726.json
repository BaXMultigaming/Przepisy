  "title": "Australian Damper",
  "description": "Damper bread was a staple of the early Australian settlers' diet. Self-rising flour and basic ingredients mean this tasty white bread is easy to make.",
  "authors": [
    "Warren Lower"
  ],
  "date_published": "1998-11-12T16:24:57-05:00",
