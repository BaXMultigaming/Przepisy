  "ingredients": [
    "4 cups self-rising flour",
    "1 teaspoon salt",
    "1 tablespoon butter, softened",
    "1 cup milk",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour and salt together in a large bowl. Rub in butter until mixture resembles coarse crumbs. Make a well in the center; pour in milk and water, then stir until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a lightly floured surface and form into an 8-inch-diameter round loaf. Place loaf onto the prepared pan; cut a cross in the top using a sharp knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes; lower the temperature to 350 degrees F (175 degrees C) and continue to bake for an additional 5 to 10 minutes. The loaf should be golden brown and the bottom should sound hollow when tapped.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
