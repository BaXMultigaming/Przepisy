  "ingredients": [
    "1 (13.25 ounce) can pineapple chunks in juice",
    "1 green bell pepper, sliced",
    "0.5 cup brown sugar",
    "2 tablespoons cornstarch",
    "2 tablespoons soy sauce",
    "2 tablespoons lemon juice",
    "1 (3 pound) bag frozen cooked meatballs, thawed"
  ],
  "steps": [
    {
      "text": "Pour pineapple chunks with juice into a saucepan. Mix in green bell pepper, brown sugar, cornstarch, soy sauce, and lemon juice; stir until sugar and cornstarch dissolve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring mixture to a boil; cook and stir until thickened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place meatballs in a slow cooker; pour pineapple mixture over meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Medium for 2 hours, stirring every 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
