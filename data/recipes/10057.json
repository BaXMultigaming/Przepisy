  "ingredients": [
    "0.5 cup shortening",
    "1 cup packed brown sugar",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1.75 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Mix shortening, sugar, egg and vanilla thoroughly. Blend flour, soda and salt; stir in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form into roll 2 1/2\" across. Wrap in waxed paper. Chill until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With a thin sharp knife, slice 1/8 inch thick. Place a little apart on ungreased baking sheet. Bake 8 to 10 minutes.",
