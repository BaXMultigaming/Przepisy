  "ingredients": [
    "2 tablespoons butter or margarine",
    "0.25 cup chopped onion",
    "2 tablespoons flour",
    "2.5 cups milk",
    "0.75 pound VELVEETA®, cut up",
    "1 (10 ounce) package frozen chopped broccoli, thawed, drained",
    "0.125 teaspoon pepper"
  ],
  "steps": [
    {
      "text": "Melt butter in a large saucepan on medium heat. Add onion; cook and stir until onion is tender, about 5 minutes. Add flour; cook 1 minute or until bubbly, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in milk. Bring to boil. Reduce heat to medium-low; simmer for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add remaining ingredients; Velveeta cheese, broccoli, and pepper. Cook until cheese is melted and soup is heated through, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
