  "ingredients": [
    "0.75 cup milk",
    "0.5 cup dry bread crumbs",
    "2 eggs, beaten",
    "0.25 cup chopped onion",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon crumbled dried sage",
    "1.5 pounds ground beef",
    "0.5 cup ketchup",
    "2 tablespoons brown sugar",
    "1 teaspoon dry mustard powder"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3_ahyQc_Z_iM0pCPxiK-TufZ4a4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/217080-beths-meat-loaf-DDMFS_4x3_Step_01-fed32351567c4b6bb20c9bb1a39ff8c1.jpg"
      ],
      "image": "assets/images/217080/step_01.webp"
    },
    {
      "text": "Gently combine milk, bread crumbs, eggs, onion, salt, black pepper, and sage in a large bowl; gently work in ground beef until mixed. Press ground beef mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gwfAUiQMTAZEQwL4UGIsoN_3j08=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/217080-beths-meat-loaf-DDMFS_4x3_Step_02B-eecdd1f6eb754367905b7060bfc831ee.jpg"
      ],
      "image": "assets/images/217080/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until no longer pink inside and juices run clear, about 50 minutes. An instant-read thermometer inserted into center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UcKlG-ivkWoVob7b0mkem0kNsSk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/217080-beths-meat-loaf-DDMFS_4x3_Step_03-3fbe178a925c471386d24f0bfe0da824.jpg"
      ],
      "image": "assets/images/217080/step_03.webp"
    },
    {
      "text": "Meanwhile, combine ketchup, brown sugar, and mustard powder in a bowl until sugar dissolves; spread on top meatloaf. Bake until glaze sets, about 10 minutes. more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wTB3DIpcqu8g06nBKYbIiM5sfq4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/217080-beths-meat-loaf-DDMFS_4x3_Step_04-b14e17be63014774896301752c6fa6e5.jpg"
      ],
      "image": "assets/images/217080/step_04.webp"
    }
