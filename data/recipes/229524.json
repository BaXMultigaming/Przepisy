  "ingredients": [
    "0.25 cup vegetable oil",
    "1.5 cups instant rice",
    "1 onion, chopped",
    "1 green bell pepper, chopped",
    "1 (16 ounce) can diced tomatoes",
    "1 (11 ounce) can vegetable juice (such as V8®)",
    "1 (8 ounce) can tomato sauce",
    "0.5 cup water",
    "1 tablespoon white sugar",
    "1 teaspoon lemon juice",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Add rice, onion, and bell pepper; cook and stir until vegetables are slightly tender and rice is lightly browned, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in diced tomatoes, vegetable juice, tomato sauce, water, sugar, lemon juice, salt, and black pepper; bring to a simmer, then reduce heat to medium-low, and simmer until liquid is absorbed, about 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
