  "ingredients": [
    "1 (18.25 ounce) package spice cake mix",
    "0.75 cup white sugar",
    "1 (15 ounce) can solid-pack pumpkin",
    "2 eggs, beaten",
    "0.25 cup milk",
    "0.5 cup mini chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a loaf pan and 24 mini-muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cake mix and sugar together in a large bowl. Beat pumpkin, eggs, and milk with the cake mix mixture until you have a smooth batter. Stir chocolate chips through the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter into prepared muffin cups with a small cookie scoop. Pour remaining batter into greased bread pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake muffins in preheated oven until tops of muffins are golden and spring back when lightly pressed, 12 to 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake bread in preheated oven until top is golden and springs back when lightly pressed, 55 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
