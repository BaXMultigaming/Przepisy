  "ingredients": [
    "18 whole chicken wings, split",
    "0.25 cup honey",
    "2 tablespoons fresh lime juice",
    "1 tablespoon grated lime zest",
    "1 clove garlic, minced",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup all-purpose flour",
    "2 quarts vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "In a large bowl, mix together the honey, lime juice, lime peel, garlic, salt and ground black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the flour in a plastic bag and shake the chicken wings in the flour to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, fry the chicken wings in hot, 1 inch deep oil until cooked through. Place the cooked wings in the honey/lime mixture and toss to coat well. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
