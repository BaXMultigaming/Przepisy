  "ingredients": [
    "4 cups all-purpose flour",
    "1.75 cups shortening",
    "3 tablespoons white sugar",
    "2 teaspoons salt",
    "1 egg",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "In a large mixing bowl, combine all-purpose flour, shortening, sugar, and salt. Blend together with a pastry cutter until crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix egg with water. Blend into flour mixture. Chill in refrigerator until ready to use.",
