      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ydz4ksHQ9x3DJaDnjfntrvbMsJ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143230-Quick-and-Easy-Grilled-Potatoes-ddmfs-4x3-step-03-gw-1196-f6c3037bcca54bd48fd3fca0c2c3d946.jpg"
