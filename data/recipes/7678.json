  "title": "Scripture Cake",
  "description": "This old-fashioned Scripture cake is a spiced fruit cake with figs, raisins, almonds, honey, and warm spices. This recipe uses Bible verses to list each ingredient.",
  "authors": [
    "Stephanie"
  ],
  "date_published": "1998-06-08T17:43:41-04:00",
