  "ingredients": [
    "1 (8 ounce) package angel hair pasta",
    "0.5 cup butter",
    "1 pound shrimp, peeled and deveined",
    "4 cloves minced garlic",
    "1 cup dry white wine",
    "0.25 teaspoon ground black pepper",
    "0.75 cup grated Parmesan cheese",
    "1 tablespoon chopped fresh parsley",
    "4 lemon wedges"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d31e3RB5Q9whydUejwtBtYc0oHg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-19508-shrimp-scampi-VAT-step-01-259e6bef2e4c4daa96d489bffea4ece7.jpg"
      ],
      "image": "assets/images/19508/step_01.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook pasta in the boiling water, stirring occasionally, until tender yet firm to the bite, 4 to 5 minutes. Drain; transfer pasta to a serving bowl and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XRCGGoMshu5l1PPoSo1xN1JGoSQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-19508-shrimp-scampi-VAT-step-02-3dcbe23af3ee45559ac2257eaae71478.jpg"
      ],
      "image": "assets/images/19508/step_02.webp"
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Stir in shrimp and garlic; cook and stir until shrimp turns pink, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kRtvFT2RdJ6v5Abk_sHTYHYCWHk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-19508-shrimp-scampi-VAT-step-03-79500275df744d60b18bab8bf1666ad6.jpg"
      ],
      "image": "assets/images/19508/step_03.webp"
    },
    {
      "text": "Stir in white wine and pepper; bring to a boil. Cook and stir for 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/siPvwsalCVbEXnJ7xrPwQwjPnlg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-19508-shrimp-scampi-VAT-step-04-f1e2434c432f41a29f740b0298e26969.jpg"
      ],
      "image": "assets/images/19508/step_04.webp"
    },
    {
      "text": "Pour shrimp with sauce over pasta in the serving bowl; toss well. Sprinkle with Parmesan cheese and parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3LJ3TdHQzc7agldFUK-OaP7n7Lo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-19508-shrimp-scampi-VAT-step-05-1819d36a826b47c0977fb494630b725f.jpg"
      ],
      "image": "assets/images/19508/step_05.webp"
    },
    {
      "text": "Serve with lemon wedges.",
