  "ingredients": [
    "1 cup milk",
    "1 tablespoon lemon juice",
    "1 teaspoon vanilla extract",
    "1.75 cups brown sugar, divided",
    "0.66666668653488 cup vegetable oil",
    "1 large egg",
    "2.5 cups all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1.5 cups chopped rhubarb",
    "0.5 cup chopped walnuts",
    "0.5 teaspoon ground cinnamon",
    "1 tablespoon butter, melted"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 325 degrees F (165 degrees C). Lightly grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UWryBoLWkD4qXSbE-wFf1hhSoNs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17970-rhubarb-bread-DDMFS-011-step-01-99b836ea544540f3988e5d72663b2e2b.jpg"
      ],
      "image": "assets/images/17970/step_01.webp"
    },
    {
      "text": "Stir milk, lemon juice, and vanilla together in a small bowl; let stand for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qcarIAa2qc1fIPpYgMlPAjJ0GCY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17970-rhubarb-bread-DDMFS-014-step-02-35b2af2e87134254b56249505b10ac3c.jpg"
      ],
      "image": "assets/images/17970/step_02.webp"
    },
    {
      "text": "Mix 1 ½ cups brown sugar, oil, and egg in a large bowl. Combine flour, salt, and baking soda; stir into sugar mixture alternately with milk mixture just until combined. Fold in rhubarb and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/L-J_w9Oyj4a7CD4GVGSKkFp_eEQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17970-rhubarb-bread-DDMFS-015-step-03-53f24c9e18e440ddbf0d62f3de6f70cb.jpg"
      ],
      "image": "assets/images/17970/step_03.webp"
    },
    {
      "text": "Pour batter into prepared loaf pans. Combine remaining 1/4 cup brown sugar, butter, and cinnamon in a small bowl. Sprinkle this mixture over the unbaked loaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fcbt7nNTrBzwdqaXkgMGwe-Om90=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17970-rhubarb-bread-DDMFS-016-step-04-5f382acadd844ce8abdb03fee082e9c0.jpg"
      ],
      "image": "assets/images/17970/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a loaf comes out clean, about 40 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eF_eBAzYFzyjLAsCo56mY7h_FBA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17970-rhubarb-bread-DDMFS-055-step-05-b65943c119ac436692140fab8da7c134.jpg"
      ],
      "image": "assets/images/17970/step_05.webp"
    }
  ],
