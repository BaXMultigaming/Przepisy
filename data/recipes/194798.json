  "steps": [
    {
      "text": "Line a jelly roll pan with waxed paper. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place white confectioners' coating in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until melted. Transfer to the prepared pan; spread out. Sprinkle jelly beans over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
