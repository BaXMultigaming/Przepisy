  "ingredients": [
    "2 tablespoons coconut oil",
    "7 eggs",
    "1.25 cups unsweetened coconut milk",
    "1 cup spelt flour",
    "0.5 teaspoon Himalayan pink salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Put coconut oil into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place baking dish in the preheated oven to melt coconut oil, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and coconut milk together in a large bowl. Whisk in spelt flour and salt to make a smooth batter. Pour batter into the hot baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and golden, rotating the baking dish once halfway through, about 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
