  "ingredients": [
    "25 chocolate sandwich cookies",
    "0.5 cup butter, melted",
    "2 cups marshmallow fluff",
    "0.25 cup creme de menthe liqueur",
    "2 cups whipping cream"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5ch2Ygi-fbXzC0kcTpJyzagiCt0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17612-creme-de-menthe-grasshopper-pie-VAT-4x3-ingredients-b1fc68adb4834a0bb22b5c12c0c2ea1f.jpg"
      ],
      "image": "assets/images/17612/step_01.webp"
    },
    {
      "text": "Crush cookies and set aside 1/4 cup of crumbs. Place remaining crumbs in a medium bowl and mix in melted butter; press mixture firmly into the bottom and sides of a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rjNg0vl3D9wnGPNcWw6PFz6DFnE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17612-creme-de-menthe-grasshopper-pie-VAT-4x3-step-01-07d86251eb9e41c391c8e1bc3070e858.jpg"
      ],
      "image": "assets/images/17612/step_02.webp"
    },
    {
      "text": "Mix marshmallow fluff and crème de menthe together in a large mixing bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rl7QY9RxSETO3-yDULr4coKEx2o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17612-creme-de-menthe-grasshopper-pie-VAT-4x3-step-02-52809207edc24920a919b531680143a7.jpg"
      ],
      "image": "assets/images/17612/step_03.webp"
    },
    {
      "text": "Beat cream in a chilled glass or metal bowl with an electric mixer until soft peaks form; fold into marshmallow mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oi2W79EMBUvrZJJlofgOjIm--j4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17612-creme-de-menthe-grasshopper-pie-VAT-4x3-step-03-b6c9820edc5743bdbdccfed95dfd3899.jpg"
      ],
      "image": "assets/images/17612/step_04.webp"
    },
    {
      "text": "Pour mixture into prepared crust and sprinkle reserved cookie crumbs on top. Freeze until firm, at least 2 hours. Remove from freezer 20 minutes before serving to soften slightly.",
      "section": null,
      "name": null,
      "url": null,
