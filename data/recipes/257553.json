  "ingredients": [
    "2 cups fresh blackberries",
    "1 teaspoon ground cinnamon",
    "1 teaspoon lemon juice",
    "1.5 cups white sugar, divided",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 cup milk",
    "3 tablespoons butter, melted",
    "1 tablespoon cornstarch",
    "1 cup boiling water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix blackberries, cinnamon, and lemon juice together in a bowl until coated. Pour into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 3/4 cup sugar, flour, and baking powder together in a separate bowl; stir in milk and butter. Spoon batter over blackberry mixture, covering as much as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir remaining 3/4 cup sugar and cornstarch together in a bowl; stir in boiling water until sugar and cornstarch are dissolved. Pour mixture over berry mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
