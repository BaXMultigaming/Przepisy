  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 cup sour cream",
    "0.75 cup butter",
    "1 (21 ounce) can apple pie filling"
  ],
  "steps": [
    {
      "text": "Mix together the flour, sour cream and butter or margarine in a large mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flour a pastry board and your hands. Make dough into small balls or roll them into 2 inch squares. Add a small amount of pastry filling, any flavor you like. Fold dough diagonally and press together. If you make balls, press a small rim around the outside so the filling does not seep out.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 10 minutes and sprinkle on confectioners' sugar. A wonderful gift any time of the year.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
