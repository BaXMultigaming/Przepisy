  "ingredients": [
    "1 cup water",
    "0.25 cup soy sauce",
    "0.25 cup brown sugar",
    "2 tablespoons extra-virgin olive oil",
    "1 lemon, juiced",
    "2 teaspoons cornstarch",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon ground black pepper",
    "3 (4 ounce) salmon fillets"
  ],
  "steps": [
    {
      "text": "Combine water, soy sauce, brown sugar, olive oil, lemon juice, cornstarch, garlic powder, and black pepper together in a saucepan; cook over medium-high heat until sauce is thickened, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange salmon fillets on the prepared baking sheet. Brush sauce on both sides of each fillet. Fold aluminum foil loosely over fillets and seal edges together creating a packet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring remaining marinade to a boil and serve alongside cooked salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
