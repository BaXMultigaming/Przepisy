  "ingredients": [
    "1 cup flour",
    "1 cup cornmeal",
    "3 tablespoons sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "2 large eggs",
    "0.66666668653488 cup milk",
    "1/2 cup Country Crock&reg; Spread, melted",
    "1 cup corn",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F. Grease and flour 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cornmeal, sugar, baking powder, and salt in a large bowl. Mix eggs, milk, and melted Country Crock® Spread. Stir egg mixture into flour mixture just until moistened. Stir in corn and cheese. Pour into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until toothpick inserted into center comes out clean, 40 to 45 minutes. Cool bread for 10 minutes then cut into 2-inch squares. Serve warm with Country Crock® Honey Butter Spread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
