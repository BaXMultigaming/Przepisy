  "ingredients": [
    "1 (12 ounce) jar apricot preserves",
    "2 teaspoons prepared horseradish",
    "2 tablespoons Dijon-style prepared mustard",
    "ground black pepper to taste",
    "1 (8 ounce) package cream cheese, softened"
  ],
  "steps": [
    {
      "text": "In a medium bowl combine apricot preserves, horseradish, mustard, and black pepper. Taste mixture and add more horseradish, mustard, and pepper to taste. Cover and chill mixture 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to serve, place the cream cheese on a serving plate and pour apricot mixture over cream cheese. Serve with a basket of your favorite crackers.",
