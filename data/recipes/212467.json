  "ingredients": [
    "1 (12 ounce) package fresh cranberries, finely chopped",
    "0.5 cup white sugar",
    "2 cups chopped apples",
    "1 cup miniature marshmallows",
    "0.5 cup chopped pecans",
    "0.5 cup vanilla yogurt",
    "1 cup frozen whipped topping (such as Cool Whip®), thawed"
  ],
  "steps": [
    {
      "text": "Combine chopped cranberries and sugar in a large, nonreactive bowl. Toss well. Cover and refrigerate for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "After 3 hours, stir apples, marshmallows, and pecans into cranberries. Combine yogurt and whipped topping; fold into cranberry salad. Serve immediately.",
