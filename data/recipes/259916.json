  "ingredients": [
    "1 (15 ounce) can pumpkin pie filling",
    "4 cups all-purpose flour",
    "1.75 cups shortening",
    "3 tablespoons white sugar",
    "2 teaspoons salt",
    "0.5 cup water",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, shortening, sugar, and salt in a bowl; blend with a pastry cutter until crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix water and egg together in a bowl; add to flour mixture. Stir until a dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 12 equal portions. Flatten dough along the bottom and sides of each muffin cup. Spoon in pie filling; smooth the tops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and crust is golden, 15 to 18 minutes. Cool for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
