  "ingredients": [
    "8 ounces penne pasta",
    "2 (14.5 ounce) cans Italian-style diced tomatoes",
    "1 (19 ounce) can cannellini beans, drained and rinsed",
    "10 ounces fresh spinach, washed and chopped",
    "0.5 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in penne and return to a boil. Cook pasta uncovered, stirring occasionally, until tender yet firm to the bite, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine tomatoes and beans in a large non-stick skillet; bring to a boil over medium high heat, then reduce heat to medium-low and simmer 10 minutes. Add spinach; cook until wilted, 2 minutes, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve sauce over pasta, and sprinkle with feta.",
      "section": null,
      "name": null,
