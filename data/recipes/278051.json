  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a glass baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine potatoes, onion, truffle oil, and parsley in the prepared baking dish; stir to coat potatoes with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Stir, and continue to bake, stirring every 10 minutes, until crispy, 20 to 30 minutes longer.",
