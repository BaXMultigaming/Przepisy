  "ingredients": [
    "0.5 cup milk",
    "0.5 (1 ounce) square semisweet baking chocolate",
    "1 tablespoon sugar",
    "2 teaspoons cornstarch",
    "1 dash salt"
  ],
  "steps": [
    {
      "text": "Place milk and chocolate in a 12-ounce microwave-safe mug or a 2-cup glass measuring cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on high until hot but not boiling, 60 to 90 seconds; stir until chocolate melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, cornstarch, and salt in a small bowl; stir into milk mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on high for 30 seconds; stir. Continue microwaving until mixture thickens and just begins to boil, about 15 seconds more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
