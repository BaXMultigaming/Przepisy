  "ingredients": [
    "0.5 cup butter, softened",
    "1.5 cups white sugar",
    "4 egg yolks",
    "1 egg white",
    "2.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 cup milk",
    "0.25 teaspoon almond extract",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 15 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter and sugar until light and fluffy. In a separate bowl, beat together egg yolks and egg white. Beat the egg mixture into the butter and sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, sift together flour and baking powder. Stir flour into egg mixture alternately with milk. Stir in almond and vanilla extracts. Pour batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 15 minutes, until a toothpick inserted into the center of each cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
