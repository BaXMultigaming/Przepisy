  "ingredients": [
    "8 pounds russet potatoes",
    "1 (8 ounce) package cream cheese, softened",
    "1 cup butter, cut into pieces",
    "0.5 cup prepared minced garlic",
    "1 tablespoon salt, or more to taste"
  ],
  "steps": [
    {
      "text": "Rinse potatoes thoroughly and cut into 2- to 3-inch chunks. Place into a large pot and cover with just enough hot water to be about 1 inch over the top of the potatoes. Bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Boil until potatoes slide off the end of a fork when poked, 15 to 20 minutes. Drain in a colander and return to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in cream cheese, butter, garlic, and salt. Use a potato masher to mash the potatoes, then stir with a wooden spoon to mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
