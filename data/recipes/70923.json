  "ingredients": [
    "2 (12 ounce) skinless, boneless salmon fillets",
    "1 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "seasoned salt to taste",
    "1 (6 ounce) package spinach leaves",
    "1 (17.25 ounce) package frozen puff pastry, thawed",
    "0.33333334326744 cup pesto"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season salmon fillets with onion powder, garlic powder, and seasoned salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide 1/2 spinach between two sheets puff pastry; mound in the center. Place 1 salmon fillet on top of each spinach mound. Divide and spread pesto on salmon fillets; divide and top with remaining 1/2 spinach.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Moisten edges of puff pastry with water; fold to the center and seal the seams.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pastry puffed and golden and salmon cooked through, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
