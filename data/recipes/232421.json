  "ingredients": [
    "3 turkey wings",
    "1 (10.75 ounce) can cream of mushroom soup",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon garlic powder",
    "1 teaspoon seasoned salt",
    "water, or as needed to cover",
    "1 (10 ounce) package saffron rice (such as Mahatma®)"
  ],
  "steps": [
    {
      "text": "Place turkey wings, cream of mushroom soup, salt, black pepper, garlic powder, and seasoned salt in a 6-quart slow cooker. Add enough water to cover; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover slow cooker. Cook on High for 6 hours or Low for 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rice into slow cooker; continue cooking until rice is tender, 15 to 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
