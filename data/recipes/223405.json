  "ingredients": [
    "0.5 cup water",
    "0.33333334326744 cup light soy sauce",
    "0.25 cup vegetable oil",
    "3 tablespoons lemon pepper seasoning",
    "2 teaspoons minced garlic",
    "6 boneless pork loin chops, trimmed of fat"
  ],
  "steps": [
    {
      "text": "Mix water, soy sauce, vegetable oil, lemon-pepper seasoning, and garlic in a deep bowl; add pork chops and toss to coat. Marinate in the refrigerator for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DYhGAzUsNdtqct93iWK2rCCCrF4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223405-best-grilled-pork-chops-step1-00019-502bf504be314727bb7149d3f55c831f.jpg"
      ],
      "image": "assets/images/223405/step_01.webp"
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pork chops from the marinade and shake off excess; discard the remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mszvtBXV1pZcV44SoCmKWCE9IOw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223405-best-grilled-pork-chops-step-2-00022-173b537ad62148e6aef941ad335184e0.jpg"
      ],
      "image": "assets/images/223405/step_03.webp"
    },
    {
      "text": "Cook the pork chops on the preheated grill until no longer pink in the center, 5 to 6 minutes per side. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4byXuVqtc_9q1Rb4_MVipPgCaQ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223405-best-grilled-pork-chops-step-4-00034-443667415c0a4bd58322b890f78855bc.jpg"
      ],
      "image": "assets/images/223405/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
