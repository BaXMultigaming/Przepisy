  "ingredients": [
    "1.5 cups shredded Dietz & Watson White NY C-Sharp Cheddar Cheese",
    "1 (10.75 ounce) can cream of mushroom soup",
    "0.5 cup milk",
    "1 teaspoon soy sauce",
    "1 dash Dash ground black pepper",
    "4 cups cooked cut green beans",
    "1.3333333730698 cups French-fried onions"
  ],
  "steps": [
    {
      "text": "Stir the soup, milk, soy sauce, black pepper, 1 cup of the cheddar cheese, beans and 2/3 cup onions in a 1 1/2 quart casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F for 25 minutes or until the bean mixture is hot and bubbling. Stir the bean mixture. Sprinkle with the remaining cheddar cheese and onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for an additional 5 minutes or until the onions and cheese are golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
