  "steps": [
    {
      "text": "Combine vegetable broth, onion, garlic, chipotle pepper, adobo sauce, 1/4 teaspoon salt, and 1/4 teaspoon black pepper in a large skillet. Bring to a boil over medium-high heat. Reduce heat to medium; simmer until onion is soft and translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in kale. Cook, covered tightly and stirring occasionally, until just tender, 8 to 10 minutes. Season with more salt, black pepper, and crushed red pepper to taste.",
