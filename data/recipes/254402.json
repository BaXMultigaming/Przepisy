  "ingredients": [
    "3 skinless, boneless chicken breasts",
    "1 cup chicken broth",
    "1 pinch paprika, or to taste",
    "salt and ground black pepper to taste",
    "0.75 cup Buffalo wing sauce (such as Frank's® RedHot)",
    "1 (4 ounce) package cream cheese, softened",
    "1 (1 ounce) package ranch dressing mix",
    "10 (6 inch) flour tortillas",
    "0.5 cup shredded Cheddar-Monterey Jack cheese blend",
    "2 tablespoons peanut oil"
  ],
  "steps": [
    {
      "text": "Place chicken breasts into slow cooker; pour in chicken broth. Season with paprika, salt, and pepper. Cook on Low until chicken is tender, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain broth; shred chicken with 2 forks in the slow cooker. Add Buffalo sauce, cream cheese, and ranch dressing mix; stir until well mixed. Cook on low until flavors are blended, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon chicken onto the tortillas and sprinkle cheese on top. Roll up and place seam-side down on a nonstick baking sheet. Brush all sides of taquitos with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, turning every 5 minutes, until slightly browned, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
