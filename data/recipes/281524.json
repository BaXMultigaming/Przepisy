  "ingredients": [
    "nonstick cooking spray",
    "16 frozen chicken wings",
    "1 (5 ounce) bottle soy sauce",
    "0.25 cup water",
    "3 tablespoons white sugar",
    "0.25 cup sesame seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place frozen chicken wings, skin side-down, in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soy sauce, water, and sugar in a bowl; pour sauce over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Remove from the oven, turn wings, and sprinkle with sesame seeds. Return to the oven and bake until no longer pink at the bone and the juices run clear, about 30 minutes more. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
