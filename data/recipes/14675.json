  "ingredients": [
    "4 pounds lean beef brisket",
    "2 tablespoons liquid smoke flavoring",
    "1 tablespoon onion salt",
    "1 tablespoon garlic salt",
    "1.5 tablespoons brown sugar",
    "1 cup ketchup",
    "3 tablespoons butter",
    "0.25 cup water",
    "0.5 teaspoon celery salt",
    "1 tablespoon liquid smoke flavoring",
    "2 tablespoons Worcestershire sauce",
    "1.5 teaspoons mustard powder",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Pour liquid smoke over brisket. Rub with onion salt and garlic salt. Roll brisket in foil and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C). Place brisket in a large roasting pan. Cover and bake for 5 to 6 hours. Remove from oven, cool, and then slice. Put slices back into pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan, combine brown sugar, ketchup, butter, water, celery salt, liquid smoke, Worcestershire sauce, mustard, salt and pepper. Stir, and cook until boiling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sauce over meat slices in pan. Cover and bake for 1 more hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
