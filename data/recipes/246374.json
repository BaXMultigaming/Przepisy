  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, salt, and black pepper together in a bowl. Place panko bread crumbs in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip cauliflower florets in egg mixture, then dredge into bread crumbs to coat; place on the prepared baking sheet.",
