  "ingredients": [
    "2 (10.5 ounce) cans condensed cream of chicken soup",
    "1 cup mayonnaise",
    "1 tablespoon melted butter",
    "1 teaspoon lemon juice",
    "0.25 teaspoon curry powder",
    "2.5 cups cooked chopped broccoli",
    "2 cups shredded, cooked chicken meat",
    "2 (4.5 ounce) cans mushrooms, drained",
    "1 (8 ounce) can water chestnuts, drained",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 3-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix condensed soup, mayonnaise, melted butter, lemon juice, and curry powder together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange broccoli over the bottom of the prepared casserole dish. Top with chicken, then mushrooms, and finally water chestnuts. Pour soup mixture over top, then sprinkle with Cheddar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until casserole is bubbly and cheese is golden brown, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
