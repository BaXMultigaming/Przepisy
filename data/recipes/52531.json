    },
    {
      "text": "Place cabbage on a large sheet of aluminum foil. Top with onion slices, bell pepper slices, garlic, black pepper, and butter. Fold edges of foil together to seal, then wrap entire package again with another sheet of foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on hot grill for 30 to 45 minutes, turning packet every 10 minutes.",
