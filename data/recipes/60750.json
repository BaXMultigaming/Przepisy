  "title": "Dilly Beans",
  "description": "Classic dilly beans made with green beans pickled in a vinegar solution flavored with lots of fresh dill, pickling spice, mustard seeds, and garlic.",
  "authors": [
    "RIIHI"
  ],
  "date_published": "2003-05-03T19:26:02-04:00",
