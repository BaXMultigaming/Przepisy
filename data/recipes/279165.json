  "ingredients": [
    "0.25 pound turkey bacon",
    "0.25 pound angel hair pasta",
    "0.25 cup plain Greek yogurt",
    "0.25 cup grated Parmesan cheese",
    "1 egg",
    "0.25 teaspoon Italian seasoning",
    "0.25 teaspoon crushed red pepper flakes",
    "1 pinch garlic salt",
    "1 pinch onion powder"
  ],
  "steps": [
    {
      "text": "Place turkey bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 5 minutes. Drain, let cool, and crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in angel hair pasta, bring back to a boil, and cook over medium heat until tender yet firm to the bite, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk Greek yogurt, Parmesan cheese, egg, Italian seasoning, red pepper flakes, garlic salt, and onion powder together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta and return to the pot. Pour egg mixture over the pasta while still warm. Cook and stir over low heat for 1 to 2 minutes. Add bacon pieces and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
