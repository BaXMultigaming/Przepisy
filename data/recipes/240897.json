  "ingredients": [
    "1 pound steelhead trout fillets",
    "0.33333334326744 cup honey",
    "2 tablespoons mesquite seasoning",
    "1 teaspoon ground black pepper",
    "1 teaspoon seasoned salt (such as LAWRY'S®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place trout, skin-side down, onto the prepared baking sheet. Cover trout with honey, then sprinkle mesquite seasoning, black pepper, and seasoned salt over top. Use a fork to press honey and seasonings into trout.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
