  "ingredients": [
    "0.75 cup butter, softened",
    "0.75 cup white sugar",
    "0.75 cup packed light brown sugar",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "2.75 cups rolled oats",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Line two cookie sheets with parchment paper or silicone liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kXel-Yd4uU0TayCY0XedksKwc4U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10264-oatmeal-raisin-cookies-ddmfs-step-1-061-a58e1b7ab9e048ce8280b7752388703a.jpg"
      ],
      "image": "assets/images/10264/step_01.webp"
    },
    {
      "text": "Beat butter, white sugar, and brown sugar in a large bowl until smooth and creamy. Beat in eggs and vanilla until fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Zuwzz8lx9XlD1Or88IPcAnq3_zI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10264-OatmealRaisinCookies-mfs-step2-0770-ba6d67ed1bc44d09b55f3f110daeefef.jpg"
      ],
      "image": "assets/images/10264/step_02.webp"
    },
    {
      "text": "Stir together flour, baking soda, cinnamon, and salt. Gradually beat into the butter mixture. Stir in oats and raisins. Drop teaspoonfuls of batter 2 inches apart onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wY-NjUXMqiEtk_gqFvEWXkfv4kc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10264-OatmealRaisinCookies-mfs-step3-0773-1945c3960eac4d6788499b77b7648887.jpg"
      ],
      "image": "assets/images/10264/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, 8 to 10 minutes, switching racks halfway through. Remove from the oven and let sit on the cookie sheets for 1 to 2 minutes before transferring cookies to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JbnVNNMYuKZIgDvy1gDQcrTkorQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10264-oatmeal-raisin-cookies-i-DDMFS-4x3-0fe02131a6354b08a175d315210adb50.jpg"
      ],
      "image": "assets/images/10264/step_04.webp"
    }
  ],
