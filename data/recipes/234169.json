  "ingredients": [
    "5 cups white sugar",
    "3 cups stemmed and coarsely chopped figs",
    "0.33333334326744 cup lemon juice",
    "2 (3 ounce) pouches liquid pectin (such as CERTO®)"
  ],
  "steps": [
    {
      "text": "Mix sugar and figs together in a large glass or plastic bowl. Set aside, stirring occasionally, until sugar has dissolved slightly, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir lemon juice and pectin together in another glass or plastic bowl; pour into fig mixture and stir until sugar is fully dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour fig mixture into sterilized plastic canning containers, filling to within 1/4 inch of the top. Cover the containers and refrigerate or freeze.",
      "section": null,
      "name": null,
      "url": null,
