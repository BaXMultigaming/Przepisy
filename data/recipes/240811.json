  "ingredients": [
    "1 pound Brussels sprouts, trimmed and halved",
    "1 large red onion, chopped",
    "6 cloves garlic, chopped",
    "0.33333334326744 cup balsamic vinegar",
    "0.25 cup olive oil",
    "2 tablespoons maple syrup",
    "salt and ground black pepper to taste",
    "0.25 cup walnuts",
    "0.25 cup sweetened dried cranberries",
    "2 ounces crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Brussels sprouts, red onion, and garlic in a bowl; drizzle balsamic vinegar, olive oil, and maple syrup over top and toss to coat. Season with salt and black pepper; transfer to a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until sprouts are tender and sauce thickened, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer Brussels sprouts mixture to a serving bowl. Add walnuts, cranberries, and feta cheese; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
