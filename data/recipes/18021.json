  "ingredients": [
    "3 sweet potatoes",
    "3 cups white sugar",
    "4 eggs",
    "1 cup vegetable oil",
    "0.75 cup orange juice",
    "3.5 cups all-purpose flour",
    "1.5 teaspoons salt",
    "2 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "2 teaspoons ground nutmeg",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Wash sweet potatoes, slice lengthwise and place on a lightly greased baking sheet. Bake in preheated oven until tender, about 30 minutes. Let cool, peel and mash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, beat together sugar, eggs and oil. Stir in orange juice and 2 cups mashed sweet potatoes. In a separate bowl, mix together flour, salt, baking soda, cinnamon, nutmeg, allspice and cloves. Stir flour mixture into egg/sweet potato mixture until just combined. Fold in pecans if desired. Pour batter into prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 1 hour 25 minutes, or until golden brown and a toothpick inserted into center of a loaf comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
