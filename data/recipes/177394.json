  "ingredients": [
    "1 (18.25 ounce) package chocolate cake mix",
    "0.75 cup butter, melted",
    "1 cup chocolate chips",
    "1 cup butterscotch chips",
    "2 cups miniature marshmallows",
    "2 cups sweetened flaked coconut",
    "1 (14 ounce) can sweetened condensed milk"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 325 degrees F (165 degrees C). Grease a 10x15 inch jellyroll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the cake mix and the melted butter in a large mixing bowl. Mix until evenly moistened, then press into the prepared pan. Layer chocolate chips, butterscotch chips, miniature marshmallows, and coconut over the cake mix crust. Pour the condensed milk over the layers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 30 minutes or until golden brown. Let cool before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
