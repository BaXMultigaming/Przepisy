  "ingredients": [
    "0.5 cup white sugar",
    "0.375 cup butter",
    "1 egg",
    "1.3333333730698 cups all-purpose flour",
    "1 teaspoon baking powder",
    "18 ounces quark",
    "1 (3 ounce) package non-instant vanilla pudding mix",
    "3 tablespoons oil",
    "1 individual packet vanilla sugar",
    "2.125 cups milk",
    "2 egg yolks",
    "2 tablespoons fresh lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1/2 cup white sugar and butter together in a medium bowl until smooth. Stir in 1 egg, then stir in flour and baking powder; knead into a dough. Press into the bottom and up sides of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine quark, remaining 3/4 cup white sugar, pudding mix, oil, and 1 packet vanilla sugar in a large bowl until smooth. Stir in milk, remaining 1 egg, egg yolks, and lemon juice; pour into the crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until filling no longer moves when you shake the pan, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
