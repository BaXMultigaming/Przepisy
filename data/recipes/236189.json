  "ingredients": [
    "2 (8 ounce) packages cream cheese",
    "1 (15 ounce) can quartered artichoke hearts, diced",
    "1.5 cups shredded Cheddar cheese",
    "1 cup ranch dressing",
    "1 cup sour cream",
    "0.33333334326744 cup hot sauce (such as Frank's RedHot ®), or more to taste",
    "0.25 cup bacon bits",
    "2 (10 ounce) cans white meat chicken, drained and flaked"
  ],
  "steps": [
    {
      "text": "Mix cream cheese, artichoke hearts, Cheddar cheese, ranch dressing, sour cream, hot sauce, and bacon bits together in a saucepan over medium heat; cook, stirring frequently, until cheeses are melted, 5 to 10 minutes. Add chicken to cream cheese mixture and cook until heated through, about 5 more minutes.",
