  "ingredients": [
    "2 (14.5 ounce) cans chicken broth",
    "1 cup uncooked wild rice",
    "0.5 cup water chestnuts, sliced",
    "0.25 cup butter",
    "1 teaspoon salt",
    "0.5 pound fresh mushrooms, sliced",
    "0.5 cup onion, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring chicken broth to a boil in a medium saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chicken broth, uncooked wild rice, water chestnuts, 2 tablespoons butter, and salt in a 1 1/2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While rice mixture is baking, melt remaining butter in a medium skillet over medium heat. Place mushrooms and onion in the skillet; slowly cook and stir until tender. Stir mushrooms and onion into wild rice mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and continue baking until liquid has been absorbed, about 30 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
