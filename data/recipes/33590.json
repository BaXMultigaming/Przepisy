  "title": "Wild Rice Casserole",
  "description": "Wild rice casserole made with chicken broth, water chestnuts, and sautéed veggies for maximum flavor and tenderness.",
  "authors": [
    "CORWYNN DARKHOLME"
  ],
  "date_published": "2001-04-16T21:17:39-04:00",
