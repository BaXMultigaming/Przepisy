  "title": "Garlicky Mushroom Toast Cups",
  "description": "Liven up your brunch with these delicious, garlicky mushrooms in crispy buttery toast cups.",
  "authors": [
    "Kathy Midkiff Goins"
  ],
  "date_published": "2018-06-08T09:44:47-04:00",
  "date_modified": "2018-06-08T09:44:47-04:00",
