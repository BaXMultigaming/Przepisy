  "ingredients": [
    "1 pound white American cheese, cubed",
    "0.75 cup half-and-half",
    "0.25 cup diced pickled jalapeno peppers",
    "1 teaspoon pickled jalapeno pepper juice",
    "0.125 teaspoon ground cumin",
    "0.125 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Combine American cheese and half-and-half in a medium microwave-safe bowl. Microwave on high power in 1 1/2 minute intervals, stirring in between each interval, until melted and creamy, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in jalapeños, jalapeño juice, cumin, and cayenne. Microwave for 30 seconds. Stir and serve immediately.",
