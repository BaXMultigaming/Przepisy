  "ingredients": [
    "1 (6 ounce) can black olives, drained",
    "1 (5 ounce) jar pitted green olives, rinsed and drained",
    "1 (6.5 ounce) jar marinated artichoke hearts, undrained",
    "1 small red onion, chopped",
    "0.25 cup red wine vinegar",
    "0.5 cup olive oil",
    "1 teaspoon dried minced garlic",
    "0.5 teaspoon celery seed",
    "1 teaspoon dried oregano",
    "1 teaspoon dried basil",
    "0.75 teaspoon black pepper"
  ],
  "steps": [
    {
      "text": "Place the black olives, green olives, artichoke hearts with their juice, and onion into a food processor. Pour in the vinegar and olive oil, and season with garlic, celery seed, oregano, basil and black pepper. Cover, and process until finely chopped. Use as a condiment on sandwiches, or a dip for crackers. Refrigerate leftovers.",
