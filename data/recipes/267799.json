  "ingredients": [
    "2 tablespoons butter",
    "4 mushrooms, sliced, or more to taste",
    "2 green onions, sliced, or more to taste",
    "2 eggs",
    "1 tablespoon milk, or more to taste",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Heat a frying pan over medium-low heat. Add butter; heat until completely melted. Add mushrooms and green onions and stir until well coated with butter. Cook until mushrooms are light brown and tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While mushrooms are cooking, combine eggs and milk in a bowl and mix together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir egg mixture into mushrooms. Season with salt. Stir until eggs are scrambled and fluffy, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
