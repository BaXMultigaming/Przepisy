  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "1 large egg",
    "0.33333334326744 cup white sugar",
    "0.125 teaspoon salt",
    "1 cup miniature semisweet chocolate chips",
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "0.25 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup water",
    "0.33333334326744 cup vegetable oil",
    "1 tablespoon cider vinegar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease two 12-cup muffin tins or line with paper cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, egg, 1/3 cup sugar, and 1/8 teaspoon salt in a medium bowl until light and fluffy. Stir in chocolate chips; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, 1 cup sugar, cocoa, baking soda, and 1/2 teaspoon salt in a large bowl. Make a well in the center; add water, oil, vinegar, and vanilla. Stir together until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill the prepared muffin tins about 1/3 full with chocolate batter. Top each with a dollop of cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the chocolate cake comes out clean and the cream cheese center is set, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
