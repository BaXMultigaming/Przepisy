  "ingredients": [
    "2 cups raisins",
    "2 cups water",
    "1 cup cold water",
    "0.5 cup vegetable oil",
    "4 cups all-purpose flour",
    "2 cups white sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cloves",
    "1 teaspoon ground nutmeg",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Boil raisins in 2 cups water in a medium pot for 15 minutes. Remove from heat. Add 1 cup cold water and oil to raisin-water mixture in the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, cinnamon, cloves, nutmeg, baking soda, and salt in a large bowl. Add raisin mixture to flour mixture; stir until just mixed. Pour batter into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
