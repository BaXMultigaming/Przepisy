  "ingredients": [
    "2 pounds beets, peeled and sliced",
    "0.25 cup water",
    "3 tablespoons brown sugar",
    "3 tablespoons vinegar",
    "1 tablespoon cornstarch",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Place beets into a large saucepan and pour in enough water to cover by 1 inch. Bring to a boil over high heat, then reduce the heat to medium-low, cover, and simmer until beets are easily pierced with a fork, about 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1/4 cup water, brown sugar, vinegar, cornstarch, cinnamon, nutmeg, and cloves together in a saucepan over medium heat. Add beets and butter and cook, stirring constantly, until mixture comes to a boil. Cook until sauce thickens slightly, 1 to 2 minutes. Serve hot or cold.",
      "section": null,
