  "ingredients": [
    "1.25 cups all-purpose flour",
    "1 cup white sugar",
    "0.75 cup milk",
    "0.5 cup miniature semisweet chocolate chips",
    "0.33333334326744 cup butter, softened",
    "1 egg",
    "1.5 teaspoons baking powder",
    "1 teaspoon vanilla bean paste",
    "0.5 teaspoon cinnamon (such as Supreme Saigon®)",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, milk, chocolate chips, butter, egg, baking powder, vanilla bean paste, cinnamon, and salt in the bowl of a stand mixer fitted with the paddle attachment. Blend on low speed for 30 seconds, scraping bowl constantly. Beat on high speed for 3 minutes, scraping bowl occasionally. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cool on a cooling rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
