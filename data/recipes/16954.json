  "ingredients": [
    "1 egg",
    "1 tablespoon water",
    "1 tablespoon butter",
    "1 tablespoon vegetable oil",
    "1 onion, chopped",
    "2 cups cooked white rice, cold",
    "1 cup cooked, chopped chicken meat",
    "2 tablespoons soy sauce",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Zq-Y6N7SpWIbZCD1sTOe4Azh7uA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16954-chineese-chicken-fried-rice-ii--ddmfs-Step1-0230-72bc3e25b7cc4b93bb9f5b75f4a15da5.jpg"
      ],
      "image": "assets/images/16954/step_01.webp"
    },
    {
      "text": "Beat egg and water together in small bowl. Melt butter in a large skillet or wok over medium-low heat; add egg and cook without stirring, 1 to 2 minutes. Remove egg from skillet and cut into shreds; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n_ybwROmBTE6F2ifKLaY4Gh7FAI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16954-chineese-chicken-fried-rice-ii--ddmfs-Step2-0233-bef9bcda79ec44c488f009118f6d1a88.jpg"
      ],
      "image": "assets/images/16954/step_02.webp"
    },
    {
      "text": "Heat oil in the same skillet. Add onion; cook and stir until soft, about 3 minutes. Stir in rice, chicken, soy sauce, and pepper. Cook and stir for about 5 minutes; stir in shredded egg. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P_PgxWliuXXRXVxLBq-5lKfFGdo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16954-chineese-chicken-fried-rice-ii-ddmfs-3X4-0240-3db2550810b1464a965a89a55cc95c7a.jpg"
