  "ingredients": [
    "cooking spray",
    "1 cup all-purpose flour",
    "0.75 cup Buffalo sauce, divided",
    "2 eggs",
    "1 cup panko bread crumbs",
    "2 (1 ounce) packages ranch dressing mix",
    "1 pound green beans, stem ends trimmed, rinsed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with foil and grease with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour in a shallow bowl. Whisk 1/2 cup Buffalo sauce and eggs together in a small mixing bowl. Combine bread crumbs and ranch mix in a third bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge green beans in flour, dip in the egg mixture, then coat with the bread crumbs. Set out on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until golden brown, about 12 minutes. Serve immediately with remaining Buffalo sauce for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
