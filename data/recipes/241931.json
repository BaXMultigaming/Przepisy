  "title": "Grain Free and Gluten Free Chocolate Chip Cookies",
  "description": "Gluten-free chocolate chip cookies, made with almond flour and coconut flour, are also grain-free and just as tasty as traditional chocolate chip cookies.",
  "authors": [
    "Fox Woadhill Rogers"
  ],
  "date_published": "2020-03-05T00:13:11-05:00",
