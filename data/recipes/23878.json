  "ingredients": [
    "2 tablespoons sesame oil",
    "2 tablespoons chile paste",
    "2 teaspoons chopped fresh ginger root",
    "0.5 teaspoon ground turmeric",
    "1 quart chicken broth",
    "1 pound chopped cooked chicken breast",
    "1 cup chopped celery",
    "0.25 cup soy sauce",
    "2 teaspoons sugar",
    "1 (3 ounce) package ramen noodles",
    "1 cup shredded lettuce",
    "0.5 cup chopped green onion"
  ],
  "steps": [
    {
      "text": "Heat sesame oil in a large pot over medium heat. Add chile paste, ginger, and turmeric; cook and stir until fragrant, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chicken broth, chicken, celery, soy sauce, and sugar. Bring to a boil; add noodles and simmer for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in lettuce and remove from heat. Garnish servings with green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
