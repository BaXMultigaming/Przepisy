  "ingredients": [
    "0.33333334326744 cup olive oil",
    "1 teaspoon lemon-pepper seasoning, or to taste",
    "1 teaspoon ground cumin, or to taste",
    "1 teaspoon paprika, or to taste",
    "1 teaspoon dried mustard, or to taste",
    "garlic powder, or to taste",
    "4 (4 ounce) fillets tilapia",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Mix olive oil, lemon pepper, cumin, paprika, dried mustard, and garlic powder together in a small bowl. Brush each tilapia fillet with mixture using a pastry brush. Flip; brush other side. Cover with aluminum foil and refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a large piece of foil with cooking spray and place on the grill. Transfer tilapia onto the foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook fillets on the preheated grill until they're easily flaked with a fork, about 5 minutes per side. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
