  "ingredients": [
    "0.5 cup hot pepper sauce",
    "1 cup reduced fat sour cream",
    "0.5 cup ketchup",
    "0.25 cup honey",
    "0.25 teaspoon paprika",
    "0.25 teaspoon cumin",
    "8 skinless, boneless chicken breast halves",
    "0.25 cup vegetable oil",
    "2 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "In a medium bowl, mix together the hot pepper sauce, sour cream, ketchup, and honey until smooth. Season with paprika and cumin. Set aside half of the sauce for serving later, then place chicken breasts in the remaining sauce to marinate. Cover and refrigerate for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a large skillet over medium heat. Add garlic and cook until fragrant. Place chicken breasts coated with marinade into the skillet, and cook until nicely browned on each side and cooked through, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring reserved marinade to a boil in a small saucepan and cook for 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon cooked sauce over chicken breasts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
