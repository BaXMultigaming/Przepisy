  "ingredients": [
    "12.375 cups all-purpose flour",
    "2 cups white sugar",
    "5 tablespoons anise seed",
    "0.5 cup warm water",
    "2 (.25 ounce) packages active dry yeast",
    "2 cups warm milk",
    "8 eggs, at room temperature",
    "0.5 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Combine flour, sugar, and anise seeds in a very large bowl; create a well in the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine warm water and yeast in a separate bowl. Let stand until yeast softens and begins to form a creamy foam, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat warm milk, eggs, and butter together in a bowl; stir into yeast mixture. Add milk mixture to well in flour mixture; knead using your hands until dough and your hands are no longer sticky. Cover dough with a clean cotton cloth and let rise, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease and flour 6 loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Punch down dough; divide into 6 portions. Shape into balls; place each in a prepared pan. Cover pans and let rise for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bread is cooked through, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
