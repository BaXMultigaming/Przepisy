  "ingredients": [
    "1 serving cooking spray",
    "1.25 cups milk",
    "0.25 cup vinegar",
    "0.25 cup oil",
    "1 egg",
    "1.25 cups all-purpose flour",
    "0.25 cup white sugar",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Spray 2 mini muffin tins with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix milk and vinegar together in a bowl; let stand until milk curdles, about 5 minutes. Beat in oil and egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, baking soda, and salt in a bowl; stir into milk mixture until smooth. Spoon batter into the prepared muffin tins with a tablespoon or a small batter scoop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until batter is risen and still pale, about 8 minutes. Remove from muffin cups with a silicone scraper.",
      "section": null,
      "name": null,
      "url": null,
