  "ingredients": [
    "1 cup dry jasmine rice",
    "2 cups water",
    "1 pound lean ground beef",
    "1 tablespoon olive oil",
    "1 red bell pepper, chopped",
    "1 green bell pepper, chopped",
    "0.25 cup chopped fresh parsley",
    "2 large cloves garlic, thinly sliced",
    "2 tablespoons minced fresh ginger root",
    "0.25 teaspoon crushed red pepper",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 cup beef stock",
    "1 tablespoon low-sodium soy sauce",
    "1 teaspoon chile paste",
    "0.5 teaspoon Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "In a medium saucepan, bring the rice and water to a boil. Cover, reduce heat, and simmer 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a skillet over medium heat, cook and stir the ground beef until evenly browned. Drain, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the olive oil in the skillet over medium heat. Stir in the red bell pepper, green bell pepper, parsley, garlic and ginger. Season with red pepper, salt, and pepper. Cook and stir until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return the beef to the skillet. Mix in the beef stock, soy sauce, chile paste, and Worcestershire sauce. Cook and stir until thickened and heated through. Serve over the cooked rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
