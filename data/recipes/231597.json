  "ingredients": [
    "2 eggs, beaten",
    "1 cup white sugar",
    "0.5 cup butter, melted",
    "0.5 cup white raisins, or more to taste",
    "0.33333334326744 cup milk",
    "1 teaspoon vanilla extract",
    "4.5 cups mashed cooked sweet potato",
    "1 cup light brown sugar",
    "0.5 cup all-purpose flour",
    "0.5 cup butter, softened",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix eggs, sugar, melted butter, raisins, milk, and vanilla extract in a large mixing bowl. Add mashed sweet potatoes; stir to combine. Spread the sweet potato mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar and flour together in a small bowl. Mash butter into the mixture with a fork until crumbly; add pecans and stir. Sprinkle the brown sugar mixture over the sweet potato mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
