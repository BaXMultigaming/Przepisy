  "ingredients": [
    "2 cups crushed saltine crackers",
    "1 teaspoon seasoned salt",
    "1 pinch garlic powder, or to taste",
    "6 skinless, boneless chicken breast halves",
    "0.5 cup margarine, melted"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 425 degrees F (220 degrees C). Grease a large baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jk2_910_WNd_zTbRBoIi7L4EeX4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231367-easy-crispy-baked-chicken-ddmfs-step-01-3x4-1011-dc765ac829f2498fbaa1a054bab20a09.jpg"
      ],
      "image": "assets/images/231367/step_01.webp"
    },
    {
      "text": "Mix together crushed crackers, seasoned salt, and garlic powder in a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ULfVxvEpvi0P-gfNmuKSd4H57M4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231367-easy-crispy-baked-chicken-ddmfs-step-02-3x4-1013-d21a65fea4874adf9f31073ad63b179d.jpg"
      ],
      "image": "assets/images/231367/step_02.webp"
    },
    {
      "text": "Dip chicken breasts into melted margarine, then press into cracker mixture until coated. Arrange chicken in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-dpia4neXWol--gwag5cUObHczE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231367-easy-crispy-baked-chicken-ddmfs-step-03-3x4-1017-f275d993a6d24b8e932c59504894bcc1.jpg"
      ],
      "image": "assets/images/231367/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until chicken breasts are no longer pink in the center and the juices run clear, 45 to 60 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (75 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X7FITejMaBV5lfIMPa86MMZ2i20=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231367-easy-crispy-baked-chicken-ddmfs-step-05-3x4-1029-2220231d210b4f9da6ef97bf44f029b8.jpg"
      ],
      "image": "assets/images/231367/step_04.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tQVAbgzHThYR5NSyRM1hLCxndaY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231367-easy-crispy-baked-chicken-ddmfs-hero-3x4-1065-1-8f3bf7a1437f4f8495674546a5d54ac6.jpg"
