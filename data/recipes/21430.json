  "ingredients": [
    "0.66666668653488 cup honey",
    "0.5 cup Dijon mustard",
    "0.25 teaspoon chili powder",
    "0.25 teaspoon salt",
    "2 pounds pork tenderloin"
  ],
  "steps": [
    {
      "text": "Whisk honey, Dijon mustard, chili powder, and salt together in a bowl; pour into a resealable plastic bag. Add pork tenderloins, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium, indirect heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tenderloins from marinade and shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until an instant-read thermometer inserted into centers reads 145 degrees F (63 degrees C), 15 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
