  "ingredients": [
    "1.5 cups self-rising flour",
    "1.5 cups old-fashioned oats",
    "0.5 cup white sugar",
    "0.66666668653488 cup brown sugar",
    "1 cup butter, softened",
    "0.66666668653488 cup apple jelly",
    "0.25 cup chopped cashews",
    "1 (11 ounce) package butterscotch chips"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 375 degrees F (190 degrees C). Grease the bottom of a 9 inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the flour, oats, white sugar, and brown sugar in a large bowl. Cut the butter into the flour mixture until the mixture is crumbly. Set aside 3/4 cup of the mixture and press the rest into the bottom of the prepared dish. Spread the top with the apple jelly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the reserved flour mixture and the cashews together in a bowl; sprinkle over the apple jelly. Scatter the butterscotch chips over the cashew mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown; 30 to 35 minutes. Allow to cool completely before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
