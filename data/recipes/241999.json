  "ingredients": [
    "2 cups flour",
    "1 cup unsalted butter",
    "0.5 cup white sugar",
    "4 eggs",
    "1 cup white sugar, or to taste",
    "6 tablespoons all-purpose flour",
    "2 cups chopped rhubarb, or more to taste",
    "1 cup shredded coconut",
    "6 tablespoons lemon juice",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 2 cups flour, butter, and 1/2 cup white sugar together in a bowl until crumbly; press into the bottom of a 12x9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is light brown, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat eggs, 1 cup white sugar, and 6 tablespoons flour together in a bowl until smooth; add rhubarb, coconut, lemon juice, and vanilla extract and stir to coat. Pour rhubarb mixture over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is set, 35 to 40 minutes. Let bars cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
