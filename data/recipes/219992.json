  "ingredients": [
    "1 (16 ounce) box tagliatelle pasta",
    "1 cup heavy cream",
    "3.5 ounces crumbled blue cheese",
    "1 teaspoon lemon juice",
    "0.66666668653488 teaspoon garlic powder",
    "1 pinch ground nutmeg",
    "1 pinch dried oregano",
    "1 pinch dried basil",
    "1 pinch salt",
    "1 pinch ground white pepper",
    "1 pinch ground black pepper",
    "2 tablespoons olive oil",
    "1 tablespoon toasted walnuts, chopped"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Boil the tagliatelle until tender yet firm to the bite, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat cream in a saucepan over low heat until warm; stir in blue cheese, lemon juice, garlic powder, nutmeg, oregano, basil, salt, white pepper, and black pepper. Cook very gently until blue cheese has melted and sauce is hot; make sure the sauce doesn't boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain tagliatelle and return to the pot. Drizzle olive oil over top and toss gently to coat. Transfer to a serving dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour blue cheese sauce over tagliatelle. Top with walnuts to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
