  "title": "Lasagna Pepper Boats",
  "description": "This lasagna pepper boats recipe is gluten free and low carb, replacing noodles with bell peppers stuffed with 3 cheeses, ground beef, and tomato sauce.",
  "authors": [
    "Joan Gerland Crabtree"
  ],
  "date_published": "2019-04-03T23:57:23-04:00",
