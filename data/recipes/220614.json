  "ingredients": [
    "4 russet potatoes, peeled and grated",
    "2 eggs",
    "0.5 cup milk",
    "1 cup all-purpose flour",
    "0.5 cup grated Parmesan cheese",
    "0.5 cup shredded Cheddar cheese",
    "0.25 cup real bacon bits",
    "1 teaspoon onion salt",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 cup corn oil",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Combine potatoes, eggs, and milk together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, Parmesan cheese, Cheddar cheese, bacon bits, onion salt, baking powder, salt, and black pepper into potato mixture using a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat corn oil and butter in a large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop potato mixture by 2 tablespoonfuls onto skillet. Cook patties until golden brown, about 4 minutes per side",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain cooked pancakes on a paper towel-lined plate.",
      "section": null,
