  "ingredients": [
    "1 (8 ounce) package breakfast sausage",
    "12 eggs",
    "1 (8 ounce) package shredded Cheddar cheese",
    "0.75 cup heavy whipping cream",
    "1 tablespoon minced onion",
    "2 teaspoons dry mustard",
    "1 teaspoon dried oregano",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook sausage, breaking it apart with a wooden spoon, until browned and crumbly, 5 to 7 minutes. Spread over the bottom of a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix eggs, Cheddar cheese, cream, onion, mustard, oregano, salt, and pepper together in a bowl. Pour mixture over the sausage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm and cooked through, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
