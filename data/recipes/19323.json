  "title": "Versatile Tomato Sauce",
  "description": "This delicious tomato and meat sauce can be used for spaghetti or lasagna. The pepperoni gives this sauce an extra kick.",
  "authors": [
    "Tracie"
  ],
  "date_published": "2000-01-26T16:32:42-05:00",
