  "ingredients": [
    "3 tablespoons olive oil",
    "1 onion, chopped",
    "4 cloves garlic, minced",
    "1 pound lean ground beef",
    "2 (29 ounce) cans tomato sauce",
    "1 (14.5 ounce) can stewed tomatoes",
    "0.5 pound pepperoni sausage, sliced",
    "1 green bell pepper, chopped",
    "1 (4.5 ounce) can mushrooms, drained and chopped",
    "0.25 teaspoon garlic salt",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon Italian seasoning"
  ],
  "steps": [
    {
      "text": "In a medium skillet over medium heat, warm oil and saute onions and garlic until caramelized; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet over medium heat, cook ground beef until almost browned. Add onions and garlic and cook for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large pot over medium heat, combine tomato sauce and stewed tomatoes; bring to a boil and then reduce heat. Simmer sauce for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pepperoni, ground beef mixture and green peppers into sauce; cover and simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in mushrooms, garlic salt, salt, ground black pepper, onion powder, oregano and Italian seasoning. Simmer for 10 minutes and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
