  "ingredients": [
    "1 ripe mango, peeled and sliced 1/4 inch thick",
    "2 teaspoons olive oil",
    "0.25 cup finely chopped red onion",
    "2 tablespoons finely chopped red bell pepper",
    "1 jalapeno pepper, finely chopped",
    "1 lime, juiced",
    "2 teaspoons white sugar",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat. In a mixing bowl, toss mango slices with oil to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil grate, place mango slices on grill. Cook for 4 minutes on each side, until nicely browned with grill marks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove mango from grill, cut into small cubes, and transfer to a mixing bowl. Stir in onion, red pepper, jalapeno pepper, lime juice, salt, sugar, and ginger. Serve at room temperature, chill until ready to serve, or serve hot by heating through in a nonstick skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
