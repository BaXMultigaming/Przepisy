  "ingredients": [
    "1 (12 ounce) package bow-tie pasta (farfalle)",
    "8 ounces diced ham",
    "0.5 cup thinly sliced celery",
    "0.5 cup dried cranberries",
    "0.5 cup sliced almonds",
    "1 cup mayonnaise",
    "0.25 cup apple cider vinegar",
    "0.5 cup white sugar"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook the bow-tie pasta at a boil until cooked through yet tender, about 12 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse the pasta in cold water until completely chilled; drain. Transfer cool pasta to a large mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss the ham, celery, dried cranberries, and sliced almonds with the bow-tie pasta to mix evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the mayonnaise, apple cider vinegar, and sugar together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the mayonnaise dressing over the pasta mixture; toss to coat evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
