  "ingredients": [
    "2 cups unbleached all-purpose flour",
    "2 cups white sugar",
    "0.75 cup unsweetened cocoa powder",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "1 cup water",
    "1 cup vegetable oil",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with baking spray; line bottom with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6C1HFzs7vUabPZLm4KdzC9dDD9k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68436-vegan-brownies-DDMFS-001-f68fc3b2465f41029f20bfd231b6dd10.jpg"
      ],
      "image": "assets/images/68436/step_01.webp"
    },
    {
      "text": "Whisk flour, sugar, cocoa powder, baking powder, and salt together in a large bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d3SwLG8dQhIHcEWcEojS77Z9dIM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68436-vegan-brownies-DDMFS-002-1673c07241eb40a68a5eb342c8beecfd.jpg"
      ],
      "image": "assets/images/68436/step_02.webp"
    },
    {
      "text": "Pour in water (or coffee), vegetable oil, and vanilla; mix until well-blended. Spread batter evenly in the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wuKw1mGg61iYgKhNmhPyCagLkKI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68436-vegan-brownies-DDMFS-003-3ddc3989a8f4434f9855c30d8d432218.jpg"
      ],
      "image": "assets/images/68436/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until top is no longer shiny and center feels just set when gently pressed, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qZfLOWPElBTHOpoWtYJeGp294ao=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68436-vegan-brownies-DDMFS-004-956508090033479ea83347f3fd71bdfc.jpg"
      ],
      "image": "assets/images/68436/step_04.webp"
    },
    {
      "text": "Let cool for at least 10 minutes before cutting into 15 squares. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BUi8TGi-YgQZ4s3yeKFu78Bk5PM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68436-vegan-brownies-DDMFS-009-4x3-0f4c37f5bee6419caee4fa5931baac40.jpg"
      ],
