  "ingredients": [
    "4 cups oats",
    "1.5 cups nonfat dry milk powder",
    "0.75 cup brown sugar",
    "2 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "1.5 teaspoons salt",
    "1 teaspoon baking powder",
    "1 cup milk",
    "4 eggs",
    "0.5 cup oil",
    "2 teaspoons vanilla extract",
    "1 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking dish with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, milk powder, brown sugar, baking soda, cinnamon, salt, and baking powder together in a bowl. Whisk milk, eggs, oil, and vanilla extract together in a separate bowl; stir into oats mixture just until mixed. Fold cranberries into oats mixture; spoon into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until oatmeal is set, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
