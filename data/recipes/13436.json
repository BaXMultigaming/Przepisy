  "title": "Italian Sausage Soup with Tortellini",
  "description": "This sausage tortellini soup combines Italian sausage, stuffed tortellini pasta, and veggies in a rich tomato broth for an incredibly comforting meal.",
  "authors": [
    "Mary P"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
