  "ingredients": [
    "1 pound sweet Italian sausage, casings removed",
    "1 cup chopped onion",
    "2 cloves garlic, minced",
    "5 cups beef broth",
    "4 large tomatoes - peeled, seeded and chopped",
    "1 (8 ounce) can tomato sauce",
    "1 cup thinly sliced carrots",
    "0.5 cup water",
    "0.5 cup red wine",
    "0.5 tablespoon packed fresh basil leaves",
    "0.5 teaspoon dried oregano",
    "1.5 cups sliced zucchini",
    "3 tablespoons chopped fresh parsley",
    "8 ounces fresh tortellini pasta"
  ],
  "steps": [
    {
      "text": "Cook sausage in a 5-quart Dutch oven over medium-high heat until browned and crumbly, 8 to 10 minutes. Use a slotted spoon to transfer sausage to a paper towel-lined plate. Drain grease, reserving 1 tablespoon drippings in the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2uBcckucH0C2CNLR1S2Me0lqpMc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13436-ItalianSausageSoupWithTortellini-ddmfs-Step1-0516-52f3c5fd7a4547ff8f34036ce6a24844.jpg"
      ],
      "image": "assets/images/13436/step_01.webp"
    },
    {
      "text": "Sauté onions and garlic in drippings over medium heat until onions are translucent, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZtCWMnQStqYWPYmQI1QbwUcyDDs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13436-ItalianSausageSoupWithTortellini-ddmfs-Step2-0518-06e46539c5c248478d0dcdbc61468ae6.jpg"
      ],
      "image": "assets/images/13436/step_02.webp"
    },
    {
      "text": "Stir in beef broth, tomatoes, tomato sauce, carrots, water, wine, basil, oregano, and sausage. Bring to a boil. Reduce heat; simmer uncovered for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Skim fat from soup. Stir in zucchini and parsley. Simmer covered for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KoDOD6CRIhlxFoJISO8dugIYsLs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13436-ItalianSausageSoupWithTortellini-ddmfs-Step3-0520-d8e316747736438fae97cf9588d140aa.jpg"
      ],
      "image": "assets/images/13436/step_04.webp"
    },
    {
      "text": "Add tortellini during the last 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v4Bjy9GxucYO3SpCWYX2R5Vb01E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13436-ItalianSausageSoupWithTortellini-ddmfs-Step4-0522-d6826d01a0934c9f82f09ca6d7bf0845.jpg"
      ],
      "image": "assets/images/13436/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G5OhERQbU7j_kCYnmJu-XIIvld0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13436-ItalianSausageSoupWithTortellini-ddmfs-4X3-0526-aff20c0d15ff4c858f32aab11c0f059d.jpg"
