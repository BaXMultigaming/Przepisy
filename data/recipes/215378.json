  "ingredients": [
    "2 cups all-purpose flour, divided, or as needed",
    "2 tablespoons white sugar",
    "1 (.25 ounce) envelope Fleischmann's® RapidRise Yeast",
    "0.5 teaspoon salt",
    "0.5 cup milk",
    "0.25 cup water",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-WaH7QkSVW7mk5lNVD1o2iMFCqA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215378-classic-dinner-rolls-DDMFS-Step-01-feb95c60495a4c7aa78ba4a7f7e11134.jpg"
      ],
      "image": "assets/images/215378/step_01.webp"
    },
    {
      "text": "Combine ¾ cup flour, sugar, undissolved yeast, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nbjS0Uh8KudjYhLvc5vAo0lbCpI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215378-ClassicDinnerRolls-mfs-Step1-0017-3b3a1486c5764759a80bbc127f346b76.jpg"
      ],
      "image": "assets/images/215378/step_02.webp"
    },
    {
      "text": "Heat milk, water, and 2 tablespoons butter in a saucepan until very warm (120 degrees to 130 degrees F).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FgPczPq8P_YDIbq2x0cRjQ2N_X4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215378-ClassicDinnerRolls-mfs-Step2-0025-d2985cc51bd64de3b1209007c68e54fd.jpg"
      ],
      "image": "assets/images/215378/step_03.webp"
    },
    {
      "text": "Add warm milk mixture to the flour mixture. Beat for 2 minutes on medium speed of an electric mixer, scraping the bowl occasionally. Add ¼ cup flour; beat for 2 minutes at high speed. Stir in enough remaining flour to make soft dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BgjUw7vlDB5nKsdtGLj5PHb4g44=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215378-ClassicDinnerRolls-mfs-Step5-0039-4b4d116d5b524f10ae4c71c9c05d9a5c.jpg"
      ],
      "image": "assets/images/215378/step_04.webp"
    },
    {
      "text": "Knead dough on a lightly floured surface until smooth and elastic, about 8 to 10 minutes. Cover; let rest for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uBLTPxVHKoGjo-6NFirqb2BLt7s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215378-ClassicDinnerRolls-mfs-Step6-0041-c02fb1d5f7da43fe8b60f8d6a74b30df.jpg"
      ],
      "image": "assets/images/215378/step_05.webp"
    },
    {
      "text": "Divide dough into 12 equal pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Vzp9aMvZy2ODgoITDR6Afx9AhV4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215378-ClassicDinnerRolls-mfs-Step7-0054-d02f05da63cf430e9f1f4840ce7e1eef.jpg"
      ],
      "image": "assets/images/215378/step_06.webp"
    },
    {
      "text": "Shape pieces into balls and place in a greased 8-inch round pan. Cover and let rise in warm, draft-free place until doubled in size, about 30 minutes. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tPj6j9yynpEnqgeNoJbXOMcib-U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215378-ClassicDinnerRolls-mfs-Step9-0061-2c90bbc0d6ee4b318ac2945c097a49f8.jpg"
      ],
      "image": "assets/images/215378/step_07.webp"
    },
    {
      "text": "Bake rolls in the preheated oven until golden brown on top, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QgTfRmi-LdcO5qB7LxU_Wms5ssY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215378-ClassicDinnerRolls-mfs-Step10-0117-313e58b065ad47ff872980093bc6ceab.jpg"
      ],
      "image": "assets/images/215378/step_08.webp"
    },
    {
      "text": "Brush with melted butter if you like.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dDUbPO92eq9dRqEMXiryufysAZc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215378-classic-dinner-rolls-DDMFS-4x3-9cfa05df262549498f81be75834582aa.jpg"
      ],
      "image": "assets/images/215378/step_09.webp"
    },
    {
      "text": "Serve warm and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/87y28-AEutrPbPfSNpGg3nOp54w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215378-classic-dinner-rolls-FranceCevallos-AlternateHorizontal-4x3-92b771ccab424946a5e72fad60532c9e.jpg"
      ],
      "image": "assets/images/215378/step_10.webp"
    }
