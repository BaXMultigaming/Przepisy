  "ingredients": [
    "1 pound ground venison",
    "2 teaspoons Worcestershire sauce",
    "1 teaspoon seasoned salt (such as Lawry's®)",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon ground black pepper",
    "4 hamburger buns"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to the manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine venison, Worcestershire sauce, seasoned salt, onion powder, and pepper in a large bowl. Mix with your hands until evenly combined, then form into four patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place two patties into the air fryer basket and cook for 6 minutes. Carefully flip the patties and cook for 2 more minutes. Transfer to a paper towel-lined plate and repeat with the remaining patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve on hamburger buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
