  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "1 cup semisweet chocolate chips, divided",
    "0.5 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "1 cup plain yogurt",
    "0.5 cup milk",
    "0.5 cup vegetable oil",
    "1 large egg",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vkRj1xCwIc2il7J-0N_rDsoq9-E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228553-MoistChocolateMuffins-mfs-Step-1-0891-6716486f0c884272ad16a3d4a5e9b6c1.jpg"
      ],
      "image": "assets/images/228553/step_01.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, ¾ cup chocolate chips, cocoa powder, and baking soda in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LFv1HWvA2fyg44JIsoPOo3-AG9Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228553-MoistChocolateMuffins-mfs-Step-2-0894-8260c169cd6d4030ab4c819bef43cd10.jpg"
      ],
      "image": "assets/images/228553/step_03.webp"
    },
    {
      "text": "Whisk yogurt, milk, oil, egg, and vanilla extract together in separate bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ICS1oK0L1oFFm7_0l1QXRv0QaF8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228553-MoistChocolateMuffins-mfs-Step-3-0899-81fbb0301f7b4c3bba0b26d717be14f6.jpg"
      ],
      "image": "assets/images/228553/step_04.webp"
    },
    {
      "text": "Pour yogurt mixture into the chocolate mixture and stir until batter is just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qYiD8QTz99wgeWuDfzIwZRMBgqQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228553-MoistChocolateMuffins-mfs-Step-4-0901-3430325fb67b411888d63f2ac0b0604a.jpg"
      ],
      "image": "assets/images/228553/step_05.webp"
    },
    {
      "text": "Divide batter among the prepared muffin cups, filling each ¾ full; sprinkle with remaining ¼ cup chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zEYgexZxre97AhxVffbM8kvsVqg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228553-MoistChocolateMuffins-mfs-Step-5-0907-d85f919731fe4d64ad5201ef74f977ea.jpg"
      ],
      "image": "assets/images/228553/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 20 minutes. Cool in the tin for 10 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
