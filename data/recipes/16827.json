  "ingredients": [
    "0.75 cup butter",
    "1 onion, chopped",
    "0.5 cup chopped carrots",
    "0.5 cup chopped celery",
    "0.5 cup chopped green pepper",
    "1 tomato, chopped",
    "2 cups vegetable broth",
    "6 tablespoons all-purpose flour",
    "4 cups half-and-half",
    "12 ounces American cheese, sliced into strips"
