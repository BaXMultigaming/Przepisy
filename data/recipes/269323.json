  "ingredients": [
    "0.5 cup almond butter",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "0.25 cup shortening",
    "0.25 cup vegan margarine (such as Earth Balance®)",
    "1 egg",
    "1.25 cups all-purpose flour",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Mix almond butter, white and brown sugars, shortening, margarine, and egg in a large bowl. Stir in flour, baking baking soda, and baking powder until dough is combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 1 1/4-inch balls. Place about 3 inches apart on ungreased cookie sheets. Dip a fork in sugar and use it to flatten cookies in a crisscross pattern.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden brown, 9 to 10 minutes. Cool for 5 minutes; remove from cookie sheets. Cool cookies on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
