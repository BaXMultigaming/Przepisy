  "ingredients": [
    "2 cloves garlic, minced",
    "0.5 cup vegetable oil",
    "2 cups dry red wine",
    "3 onions, sliced",
    "1 carrot, sliced",
    "3 sprigs chopped fresh parsley",
    "0.25 teaspoon ground cloves",
    "2 teaspoons dried oregano"
  ],
  "steps": [
    {
      "text": "In a medium bowl, combine the garlic, oil, wine, onions, carrot, parsley, cloves and oregano. Mix together well and apply liberally to your favorite meat. Cover and allow to marinate overnight.",
