  "ingredients": [
    "1 cup rice wine",
    "1 tablespoon yellow miso paste",
    "1 tablespoon honey",
    "1 (4 ounce) fillet salmon"
  ],
  "steps": [
    {
      "text": "Pour rice wine and miso into a container and mix together, but don't overmix. Add honey and mix until mostly smooth with a few lumps remaining. Place salmon in the container, cover, and let sit in the refrigerator for 2 hours. Flip and let sit for 2 more hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 255 degrees F (124 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove salmon from the marinade and shake off excess. Discard the remaining marinade. Place fish on a heavy duty piece of aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork and is a little charred at the edges, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
