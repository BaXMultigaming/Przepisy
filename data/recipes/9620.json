  "ingredients": [
    "4 (1 ounce) squares unsweetened chocolate",
    "2 cups white sugar",
    "2 teaspoons vanilla extract",
    "2 teaspoons baking powder",
    "1 cup confectioners' sugar",
    "0.5 teaspoon salt",
    "2 cups all-purpose flour",
    "4 eggs",
    "0.5 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Melt chocolate over low heat. Remove from heat and add cooking oil and granulated sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add one egg at a time, mixing well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add vanilla, flour, baking powder and salt; mixing well after each additional ingredient.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill for several hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into balls about 1/2 inch in diameter. Roll balls in powdered sugar. Place about 2 inches apart on cookie sheets. Bake 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
