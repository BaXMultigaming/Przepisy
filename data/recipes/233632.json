      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tlUOHE4xzawrewM1AWdGpRfmWtM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-233632-roasted-cauliflower-step-3-82c1993a988f40e98e74e311d6851461.jpg"
      ],
      "image": "assets/images/233632/step_03.webp"
    },
    {
      "text": "Spread butter mixture evenly over the top and sides of cauliflower, place in a casserole dish, and cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B1kMU3z123REW6T72m_WomoCD1Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-233632-roasted-cauliflower-step-4-b0efad33f65b4ab9a55853fbe3ad9fde.jpg"
      ],
      "image": "assets/images/233632/step_04.webp"
    },
    {
      "text": "Roast in the preheated oven until tender and cooked through, about 1 hour and 15 minutes. Transfer to a platter and spoon any liquid in the casserole dish over cauliflower.",
