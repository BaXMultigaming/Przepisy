      ],
      "image": "assets/images/233632/step_01.webp"
    },
    {
      "text": "Mix butter, dill, garlic, lemon zest, cumin, salt, and black pepper in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d_hl8MdfEx14AILLlm9xGa9nykE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-233632-roasted-cauliflower-step-2-6275b7a7ea6f47e09f675016ec3c3bba.jpg"
