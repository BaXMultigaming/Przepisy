  "ingredients": [
    "2 cups water",
    "1 cup quinoa, rinsed and drained",
    "0.25 teaspoon salt",
    "1 large jicama, peeled and diced",
    "1 cup sweetened shredded coconut",
    "1 cup diced pineapple",
    "0.75 cup golden raisins",
    "0.75 cup diced sweet onion",
    "2 limes, zested and juiced",
    "0.25 cup chopped fresh cilantro",
    "0.5 jalapeno pepper, chopped",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring water and quinoa to a boil in a saucepan. Stir 1/4 teaspoon salt into the water and return water to a rolling boil. Reduce heat to low, cover the saucepan, and cook until the moisture is absorbed completely, about 15 minutes. Remove pan from heat and let pan sit covered for 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread quinoa in a thin later on a platter and refrigerate to cool completely, at least 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix jicama, coconut, pineapple, raisins, sweet onion, lime zest, lime juice, cilantro, and jalapeno pepper together in a large bowl; add cooled quinoa and toss. Season salad with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bowl with plastic wrap and refrigerate until salad is completely chilled, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
