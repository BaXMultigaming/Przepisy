  "ingredients": [
    "1.25 pounds ground beef",
    "1 tablespoon chili powder",
    "2 teaspoons garlic powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cumin",
    "4 slices Cheddar cheese, halved",
    "1.5 cups cilantro leaves",
    "0.5 cup mayonnaise",
    "1 jalapeno chile, seeded and finely chopped",
    "1 tablespoon lemon juice",
    "8 slider buns, toasted",
    "1 cup shredded cabbage"
  ],
  "steps": [
    {
      "text": "Heat an outdoor grill to medium-high heat (375 to 450 degrees F (190 to 230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together ground beef, chili powder, garlic powder, salt, and cumin in a large bowl. Form into 8 patties. Lightly oil grill grate, then grill patties until browned, about 3 minutes per side. Top with cheese during last minute of grilling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree cilantro, mayonnaise, jalapeno, and lemon juice in a food processor or blender. Spread mixture on bottom half of buns. Top with cabbage, patties, and bun tops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
