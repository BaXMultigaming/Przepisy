  "ingredients": [
    "1 (18.25 ounce) package white cake mix",
    "0.33333298563957 cup vegetable oil",
    "4 eggs",
    "8 ounces sour cream",
    "8 tablespoons unsweetened cocoa powder",
    "0.5 cup semisweet chocolate chips",
    "1 banana, peeled and mashed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease and flour one 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cake mix, oil, eggs, sour cream, cocoa, chocolate chips, and banana, and beat for two minutes. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 35 minutes. Let cool in pan and dust with powdered sugar if desired. ENJOY!",
