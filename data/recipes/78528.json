  "ingredients": [
    "1 cup butter",
    "1 cup packed brown sugar",
    "1 cup white sugar",
    "4 eggs",
    "2 teaspoons vanilla extract",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "2 cups peeled and finely shredded yam",
    "1 cup confectioners' sugar",
    "2 tablespoons butter or margarine",
    "2 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 cup unsalted butter, brown sugar, and white sugar together in a large bowl until smooth. Beat in eggs, one at a time, beating well after each addition. Stir in vanilla. Combine flour, baking powder, and salt in a separate bowl; stir into butter mixture until blended. Fold in yam. Spread batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine confectioners' sugar, 2 tablespoons salted butter, and milk until smooth. Spread over brownies while still warm, they will absorb some of the glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
