  "ingredients": [
    "2 pounds swai fish",
    "0.25 cup butter, melted",
    "0.25 teaspoon garlic powder, or to taste",
    "0.25 teaspoon garlic pepper seasoning, or to taste",
    "salt to taste",
    "1 lemon, thinly sliced",
    "1 tablespoon capers"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
