  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "2 eggs",
    "2 tablespoons vegetable oil",
    "1 (11 ounce) package semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cake mix, eggs, and vegetable oil in a bowl using an electric mixer on medium until dough is well combined; stir in chocolate chips. Drop dough by the spoonful onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 10 to 12 minutes.",
