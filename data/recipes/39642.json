  "ingredients": [
    "2 tablespoons vegetable oil",
    "4 pork steaks",
    "onion powder",
    "garlic powder",
    "salt and ground black pepper to taste",
    "1 large onion, chopped",
    "2 (4.5 ounce) cans sliced mushrooms, drained",
    "2 (10.75 ounce) cans condensed cream of mushroom soup",
    "1 (10.75 ounce) can water",
    "1 (1 ounce) package dry onion soup mix",
    "1 tablespoon Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large, heavy skillet over medium-high heat. Brown both sides pork steaks, 3 to 5 minutes per side, seasoning both sides with onion powder, garlic powder, salt, and black pepper while browning. Transfer steaks to a 9x13-inch casserole dish; sprinkle with chopped onion and sliced mushrooms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mushroom soup, water, onion soup mix, and Worcestershire sauce in a small bowl; mix until smooth, then pour over steaks. Cover dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
