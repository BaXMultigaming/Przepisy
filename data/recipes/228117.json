  "ingredients": [
    "0.25 cup unsalted butter",
    "1 cup chopped walnuts",
    "1 (3 ounce) package uncooked ramen noodles, crushed",
    "1 cup vegetable oil",
    "1 cup white sugar",
    "0.5 cup red wine vinegar",
    "3 teaspoons soy sauce",
    "salt and freshly ground black pepper to taste",
    "2 heads romaine lettuce, chopped",
    "1 bunch broccoli, coarsely chopped",
    "4 green onions, chopped"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Add walnuts and ramen noodles; cook and stir until toasted, about 5 minutes. Transfer to a paper-towel-lined plate; set aside until cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk vegetable oil, sugar, vinegar, soy sauce, salt, and black pepper together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine romaine lettuce, broccoli, walnut-ramen noodle mixture, and green onions in a large serving bowl. Add vinaigrette; toss to coat.",
