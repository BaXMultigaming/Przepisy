  "ingredients": [
    "3 corn tortillas, cut into 1-inch pieces",
    "0.5 cup chopped ham",
    "0.5 cup diced tomatoes",
    "0.5 cup salsa",
    "0.25 cup milk",
    "0.25 cup shredded sharp Cheddar cheese",
    "0.25 cup shredded jalapeno Jack cheese",
    "2 tablespoons chopped fresh cilantro",
    "2 medium green onions, sliced",
    "3 large eggs",
    "0.75 cup milk",
    "salt and freshly ground black pepper to taste",
    "0.25 cup crumbled cotija cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 5x7-inch glass dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ham, tomatoes, salsa, 1/4 cup milk, Cheddar cheese, jalapeno Jack cheese, cilantro, and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place half of the tortillas into the prepared baking dish and top with half of the ham mixture. Repeat layers. In another bowl, mix eggs, 3/4 cup milk, salt, and pepper. Pour over mixture in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top starts to brown, 60 to 75 minutes. Remove from the oven and let sit for 10 minutes before cutting. Sprinkle with cotija cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
