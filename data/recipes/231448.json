  "ingredients": [
    "0.25 cup olive oil",
    "1 medium lime, juiced",
    "3 tablespoons chopped fresh cilantro",
    "2 tablespoons finely chopped onion",
    "3 cloves garlic, finely chopped",
    "1.5 teaspoons ground cumin",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "2 (8 ounce) boneless New York strip steaks, cut into thin strips",
    "8 (6 inch) white corn tortillas, or more as needed",
    "1 (8 ounce) jar salsa",
    "1 (8 ounce) package shredded Mexican cheese blend"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TYteiV-w_jXf4x98IPT36QdqjuA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231448-beef-fajitas-ddmfs-01-17301-5a60a8cfd2d241b4b2502ed4bde78a74.jpg"
      ],
      "image": "assets/images/231448/step_01.webp"
    },
    {
      "text": "Whisk oil, lime juice, cilantro, onion, garlic, cumin, salt, and pepper together in a bowl; pour into a resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oD9LRdIy7VkwNrV7t-qMdTxkB_E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231448-beef-fajitas-ddmfs-02-17308-e9f6dd06fd274bdea569583321e4e04d.jpg"
      ],
      "image": "assets/images/231448/step_02.webp"
    },
    {
      "text": "Add steak strips, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 4 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WzXbJSdSudYxHeJ6u3Rl9qESd-M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231448-beef-fajitas-ddmfs-03-17319-ec52e265bf0a414cb959ffc5cde62ade.jpg"
      ],
      "image": "assets/images/231448/step_03.webp"
    },
    {
      "text": "When ready to cook, heat a large skillet over medium heat. Add steak and marinade. Cook and stir until steak is browned and cooked through and all liquid is absorbed, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/meX_348NhAOvlM1WEnf1vFneQxM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231448-beef-fajitas-ddmfs-04-17328-0fb8bdb7d23a435ba7f3540abef679ac.jpg"
      ],
      "image": "assets/images/231448/step_04.webp"
    },
    {
      "text": "Serve steak on tortillas with salsa and Mexican cheese.",
