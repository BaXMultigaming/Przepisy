  "ingredients": [
    "3 ounces white chocolate",
    "3 tablespoons heavy whipping cream",
    "0.75 cup heavy whipping cream",
    "1 cup chopped fresh mango",
    "1 teaspoon white sugar",
    "1 tablespoon hot water",
    "1 (.25 ounce) package unflavored gelatin"
  ],
  "steps": [
    {
      "text": "Place white chocolate and 3 tablespoons heavy cream in the top of a double boiler. Add hot water to the bottom of the double boiler and place over medium-low heat. Stir occasionally until chocolate melts, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 3/4 cup heavy cream in a chilled glass or metal bowl with an electric mixer until soft peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mango and sugar in a food processor; puree until smooth. Pour into a bowl; fold in melted white chocolate mixture and whipped cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place hot water in a small bowl. Sprinkle gelatin on the water; allow it to melt 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour softened gelatin into the mango mixture. Mix thoroughly with an electric mixer for 1 or 2 minutes. Transfer mixture to a 9-inch springform pan. Refrigerate until firm, 3 or 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
