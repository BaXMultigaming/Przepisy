  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In an 8x8-inch square pan, stir together flour, white sugar, 1/4 cup of cocoa, baking powder, and salt. Add milk and oil; mix well. Sprinkle brown sugar, remaining cocoa, and chocolate chips over mixture. Add vanilla to hot water, then pour water over top of mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 to 35 minutes in the preheated oven, until surface appears dry. Serve warm with a spoon or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
