  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "12 thick slices French bread",
    "8 eggs",
    "1 cup whole milk",
    "1 (15 ounce) can sliced peaches in syrup, drained and syrup reserved",
    "2 teaspoons vanilla extract",
    "3 tablespoons melted butter",
    "0.5 cup chopped pecans",
    "1 pinch brown sugar"
  ],
  "steps": [
    {
      "text": "Spread cream cheese thickly on 1 side of each slice of bread. Cascade the bread in 2 rows in the bottom of a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, milk, peach syrup, and vanilla extract in a bowl; whisk to combine. Pour mixture over bread. Arrange sliced peaches on top. Pour melted butter over the peaches. Cover baking dish and refrigerate for up to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle pecans on top of bread mixture just before baking. Sprinkle brown sugar on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
