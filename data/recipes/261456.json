  "ingredients": [
    "cooking spray",
    "1 pound ground beef",
    "0.5 cup salsa",
    "2 tablespoons taco seasoning mix",
    "2 cups shredded Mexican cheese blend",
    "24 wonton wrappers"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 24-cup mini muffin tin with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Mix in salsa and taco seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line each muffin cup with a wonton wrapper. Add about 1 tablespoon taco beef to each cup. Top with 1 tablespoon shredded Mexican cheese blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until wonton wrappers are browned and crispy and cheese is melted, 12 to 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
