  "ingredients": [
    "1.5 cups vegetable oil",
    "2 cups white sugar",
    "3 eggs, beaten",
    "2 teaspoons vanilla extract",
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "2.5 cups apples - peeled, cored and diced",
    "1 cup chopped walnuts",
    "1 cup raisins",
    "1 (16 ounce) container cream cheese frosting",
    "0.25 cup finely chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 10-inch fluted tube pan (such as Bundt).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together oil, eggs, vanilla, and sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking soda, salt, cinnamon, and nutmeg. Add to egg mixture; stir in apples, 1 cup walnuts, and raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into the prepared pan and bake in the preheated oven until a cake tester inserted in the center comes out clean, about 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool and frost with cream cheese icing. Sprinkle top with 1/4 cup chopped walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
