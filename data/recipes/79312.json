  "ingredients": [
    "2 tablespoons butter, melted",
    "0.25 cup dark corn syrup",
    "0.25 cup brown sugar",
    "1 (16 ounce) can pear halves, well drained",
    "0.5 cup pecan halves",
    "1 (14.5 ounce) package gingerbread cake mix"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Mix the melted butter, corn syrup, and brown sugar in a 9-inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice pear halves in half lengthwise. Place a pecan in the center of each pear quarter. Place pears cut side down in the cake pan, arranging them like spokes radiating from the center of the pan. Sprinkle any remaining pecans around the pears.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare the cake mix according to package directions, and pour over the pears and pecans in the cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 40 minutes in the preheated oven, or until a knife inserted in the center comes out clean. Cool slightly before turning out onto a serving dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
