  "ingredients": [
    "12 (3 inch) frozen tart shells, thawed",
    "1 cup brown sugar",
    "0.33333334326744 cup butter, melted",
    "1 teaspoon pure vanilla extract",
    "1 large egg, beaten",
    "2 tablespoons half-and-half"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place tart shells on a baking sheet.",
      "section": null,
      "name": null,
