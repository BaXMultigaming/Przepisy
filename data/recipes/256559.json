  "ingredients": [
    "cooking spray",
    "1.5 cups gluten-free rolled oats",
    "0.75 cup almond milk",
    "1 egg, at room temperature, separated",
    "3 tablespoons melted butter",
    "1 tablespoon brown sugar",
    "1 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions. Grease with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats and almond milk in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg yolk and butter together in a small bowl; stir into oat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white in a glass, metal, or ceramic bowl until stiff peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar and baking powder into the oat mixture. Fold beaten egg white gently into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop 1/2 cup batter onto the preheated iron and spread to the edges. Close iron and cook until iron stops steaming, about 5 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
