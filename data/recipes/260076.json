  "ingredients": [
    "2 (12 count) packages Hawaiian bread rolls (such as King's®)",
    "0.5 cup butter, melted",
    "2 tablespoons Dijon mustard",
    "1 tablespoon onion powder",
    "1 tablespoon poppy seeds",
    "Worcestershire sauce",
    "1 pound cooked pulled pork without sauce",
    "24 slices honey-cured deli ham",
    "0.5 pound sliced Swiss cheese, or more as needed",
    "48 dill pickle chips, patted dry"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Grease bottom and sides of a 9x13-inch baking dish or disposable aluminum pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UzBTvD2vDHeCQN1LBhoAUS6Yt0E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260076-cuban-sliders-step-01-3e52445c39f048daafd0c53ba4563c8c.jpg"
      ],
      "image": "assets/images/260076/step_01.webp"
    },
    {
      "text": "Cut Hawaiian rolls in half; arrange 24 bottom halves in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/poKr9rUDNEsElQhgAI2VXaaiK3k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260076-cuban-sliders-step-02-bf38fd1476ec4d759583634f9816c053.jpg"
      ],
      "image": "assets/images/260076/step_02.webp"
    },
    {
      "text": "Whisk melted butter, Dijon mustard, onion powder, poppy seeds, and Worcestershire sauce together in a bowl; brush ½ over bottom halves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cMD-IHBvz-5SICYmPh1o449uHpo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260076-cuban-sliders-step-03-f5c85c823b35409a8476da259db1ffb7.jpg"
      ],
      "image": "assets/images/260076/step_03.webp"
    },
    {
      "text": "Layer pulled pork, ham, Swiss cheese, and 2 pickle chips on each bottom roll, in exact order.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KocJP9SDyAerJxBuFrJrcOSMNng=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260076-cuban-sliders-step-04-a794121a44c94598904b6a8d65c59bc7.jpg"
      ],
      "image": "assets/images/260076/step_04.webp"
    },
    {
      "text": "Cover with roll tops. Brush remaining ½ butter mixture over tops; cover dish with aluminum foil and refrigerate for 20 to 30 minutes. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nO4wQ0jJAEbKJUyGTd3PwBwRUjY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260076-cuban-sliders-step-05-a7c9bf50a62146b6a8b021e0e442ba69.jpg"
      ],
      "image": "assets/images/260076/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven, covered, for 20 minutes. Remove foil; press sliders with a spatula to flatten. Continue baking until sliders are heated through and top is crispy, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OiHde6dim8P5AaW9CB6CbWMoeks=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260076-cuban-sliders-step-06-399052dfc67448df9ccffd275ec09c75.jpg"
