  "ingredients": [
    "2 cups whole-milk plain Greek yogurt",
    "3 tablespoons pure maple syrup, or to taste",
    "1 teaspoon vanilla extract",
    "1 teaspoon maple extract",
    "1 pinch salt",
    "1 cup pumpkin puree",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "0.125 teaspoon ground nutmeg",
    "0.125 teaspoon ground allspice",
    "1 cup maple nut granola"
  ],
  "steps": [
    {
      "text": "Whisk Greek yogurt, maple syrup, vanilla extract, maple extract, and salt together in a bowl until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer ½ cup maple-yogurt mixture to a separate bowl; whisk in pumpkin purée, cinnamon, cloves, nutmeg, and allspice until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a small amount of maple-yogurt mixture in 4 small jars or containers; top with a portion of pumpkin mixture, followed by a layer of maple granola. Continue alternating layers of maple-yogurt mixture, pumpkin mixture, and granola.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve immediately or cover and keep refrigerated until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
