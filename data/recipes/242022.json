  "title": "Chocolate Chip Carrot Cake Muffins",
  "description": "These carrot cake muffins are extra special thanks to chocolate chips added to the batter.",
  "authors": [
    "skylarb"
  ],
  "date_published": "2020-06-19T00:02:45-04:00",
