  "ingredients": [
    "1 tablespoon olive oil",
    "12 ounces mild Italian sausage",
    "1 (6 ounce) package baby portobello mushrooms",
    "1 small onion, chopped",
    "1 clove garlic, minced",
    "0.33333334326744 cup dry white wine",
    "1 tablespoon Dijon mustard",
    "1 (16 ounce) package gnocchi",
    "0.75 cup half-and-half",
    "0.5 cup baby spinach leaves",
    "0.25 cup finely shredded Parmesan cheese",
    "0.5 teaspoon crushed chili flakes"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large skillet over medium-high heat. Add sausage and cook for 5 minutes. Add mushrooms and onion; cook until soft, about 4 minutes. Add garlic and cook until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in wine and Dijon mustard. Add gnocchi and half-and-half; bring to a simmer. Reduce heat to medium, cover, and cook for 5 minutes. Remove the lid and stir in spinach and Parmesan cheese. Cook until sauce has thickened and cheese has melted, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide mixture between 4 serving plates and top with crushed chili flakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
