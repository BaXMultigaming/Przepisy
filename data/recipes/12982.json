        "https://www.allrecipes.com/thmb/mJCsZdvUp78f32uiGJqb1yh1vo0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-12982-Basic-Vegetable-Stock-ddmfs-4x3-Step-02-d33ddc18a4074b309bcfa91690bcd69d.jpg"
      ],
      "image": "assets/images/12982/step_03.webp"
    },
    {
      "text": "Add salt and water and bring to a boil. Lower heat and simmer, uncovered, 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
