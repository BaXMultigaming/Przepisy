        "https://www.allrecipes.com/thmb/FmYf374OPPt6GX6rGtfGV28cmwM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-12982-Basic-Vegetable-Stock-ddmfs-4x3-Step-01-ece72b11cf7d48b5877681f9e1e39d14.jpg"
