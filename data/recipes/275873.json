  "ingredients": [
    "2 cups whole-wheat elbow pasta",
    "0.5 bell pepper, diced",
    "0.33333334326744 cup corn",
    "1 stalk celery, diced",
    "2 tablespoons diced red onion",
    "0.5 cup vegan mayonnaise",
    "3 teaspoons white vinegar",
    "1.5 teaspoons Dijon mustard",
    "0.5 teaspoon white sugar",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Strain pasta and rinse under cold water. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bell pepper, corn, celery, and red onion in a bowl. Mix together vegan mayo, vinegar, Dijon mustard, sugar, salt, and pepper in a small bowl; pour over vegetables. Mix in cold pasta and toss to combine. Taste and adjust seasonings as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover pasta salad and let cool in fridge for at least 90 minutes before serving, stirring occasionally to mix sauce into pasta evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
