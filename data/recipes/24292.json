  "title": "Cranberry Nut Quick Bread",
  "description": "This bread is fabulous, with cranberries, walnuts and a hint of orange.",
  "authors": [
    "LOUGRAY"
  ],
  "date_published": "2020-06-18T23:05:27-04:00",
