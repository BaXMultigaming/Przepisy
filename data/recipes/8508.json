  "ingredients": [
    "6 tablespoons butter",
    "1 (1 ounce) package dry onion soup mix",
    "1 cup converted long-grain white rice",
    "0.25 cup grated Parmesan cheese for topping",
    "6 skinless, boneless chicken breasts",
    "1.5 cups milk",
    "2 (10.75 ounce) cans condensed cream of mushroom soup",
    "salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Mix together onion soup mix, milk, cream of mushroom soup, and rice in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay chicken breasts in the bottom of a lightly greased slow cooker. Place one tablespoon margarine on each chicken breast and pour soup mixture over all. Season with salt and pepper to taste and sprinkle with grated Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 8 to 10 hours, or on High for 4 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
