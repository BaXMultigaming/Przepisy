  "ingredients": [
    "1 cup old-fashioned oats",
    "0.5 cup flaxseed meal",
    "0.33333334326744 cup raisins",
    "0.33333334326744 cup dried cranberries",
    "0.33333334326744 cup vanilla whey protein powder",
    "0.5 cup white chocolate chips",
    "0.33333334326744 cup honey",
    "0.33333334326744 cup peanut butter"
  ],
  "steps": [
    {
      "text": "Line a 9x13-inch baking dish with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, flaxseed meal, raisins, cranberries, and protein powder in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate chips, honey, and peanut butter in a microwave-safe bowl. Microwave until chocolate chips are nearly melted, 2 to 3 minutes, stirring every 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats mixture and chocolate mixture until evenly mixed; spread into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate bars until hardened, 15 to 20 minutes. Remove bars from dish by lifting parchment; cut into squares using a pizza cutter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
