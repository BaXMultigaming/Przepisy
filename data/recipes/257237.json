  "ingredients": [
    "2.25 cups white sugar",
    "1.5 cups butter, softened",
    "1 (8 ounce) package cream cheese, softened",
    "6 eggs",
    "3 tablespoons lemon juice",
    "2 teaspoons lemon extract",
    "1.5 teaspoons lemon zest",
    "1 teaspoon vanilla extract",
    "3 cups all-purpose flour",
    "5.25 cups confectioners' sugar",
    "0.5 cup 2% milk",
    "3 tablespoons 2% milk",
    "3.5 teaspoons lemon extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease 2 mini muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, butter, and cream cheese in a large bowl; beat with an electric mixer until light and fluffy. Add eggs one at a time, beating well after each addition. Beat in lemon juice, 2 teaspoons lemon extract, lemon zest, and vanilla extract. Add flour; beat until batter is just moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into muffin tins, filling each cup 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted near the center comes out clean, 10 to 15 minutes. Cool for 5 minutes. Transfer to wire racks to cool completely, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk confectioners' sugar, 1/2 cup plus 3 tablespoons milk, and 3 1/2 teaspoons lemon extract together in a bowl to make glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip tops of cakes in the glaze; place cakes on the wire racks until glaze is set, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
