  "ingredients": [
    "4 large bananas, cut in half crosswise then lengthwise",
    "1 cup coconut milk",
    "1 cup white sugar",
    "1 teaspoon salt",
    "0.5 cup unsweetened coconut cream"
  ],
  "steps": [
    {
      "text": "Bring coconut milk to a boil in a pot. Add bananas and cook until tender, about 15 minutes. Stir in sugar and salt until dissolved, then stir in coconut cream. Remove from the heat and serve hot.",
