  "ingredients": [
    "0.5 cup butter, at room temperature",
    "0.5 cup smooth peanut butter",
    "0.5 cup brown sugar",
    "0.5 cup white sugar",
    "1 egg",
    "1 cup all-purpose flour",
    "1 cup crushed banana chips",
    "0.25 teaspoon salt",
    "0.25 teaspoon baking soda",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, peanut butter, brown sugar, white sugar, and egg in a large bowl; beat with an electric mixer until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, banana chips, salt, baking soda, and nutmeg together in a separate bowl. Blend into the creamed butter mixture. Dust your hands with flour and roll mixture into 3/4-inch balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange cookie balls on ungreased baking sheets. Press down on each ball gently with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 10 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
