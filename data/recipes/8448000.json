  "ingredients": [
    "1.5 cups uncooked elbow macaroni",
    "1.5 cups mayonnaise",
    "0.5 cup minced red onion",
    "0.5 cup minced celery",
    "0.25 cup chopped fresh parsley",
    "2 tablespoons chopped pimento",
    "2 tablespoons sweet pickle relish",
    "0.5 teaspoon salt",
    "0.13 teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise, red onion, celery, parsley, pimento, relish, salt, and pepper in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once macaroni has cooled, add to the mixing bowl and toss to combine with the dressing. Chill until read to serve for about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
