  ],
  "ingredients": [
    "3.25 cups white sugar, divided",
    "3 teaspoons ground cinnamon, divided",
    "0.75 cup butter",
    "6 very ripe bananas, mashed",
    "1 (16 ounce) container sour cream",
    "3 eggs",
    "2 teaspoons vanilla extract",
    "4.5 cups all-purpose flour",
    "3 teaspoons baking soda",
    "0.5 teaspoon salt",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/33EUHWPBdAHC3upvgKH5ZJHJxXk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6984-banana-sour-cream-bread-DDMFS-ingredients-24a104d31e1f4151ae6a86679dc843ff.jpg"
      ],
      "image": "assets/images/6984/step_01.webp"
    },
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease four 7x3-inch loaf pans. Mix 1/4 cup sugar and 1 teaspoon cinnamon together in a small bowl until well combined; dust the greased pans lightly with sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M8F6BXXeyq9LSEWbr0vUt0Rs45A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6984-banana-sour-cream-bread-DDMFS-step2-88bfc261db7b47df965e7f6d8300b45e.jpg"
      ],
      "image": "assets/images/6984/step_02.webp"
    },
    {
      "text": "Beat remaining 3 cups sugar and butter together in a large bowl with an electric mixer until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b1O8CziJYxEAKUzkuAH9CcaI8-I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6984-banana-sour-cream-bread-DDMFS-step3-e7bde43e4c02422fae36f98a76db83a3.jpg"
      ],
      "image": "assets/images/6984/step_03.webp"
    },
    {
      "text": "Add mashed bananas, sour cream, eggs, vanilla, and remaining 2 teaspoons cinnamon; continue to beat until well-blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/avDdTEO1SznDo41_mWitPcwZlqA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6984-banana-sour-cream-bread-DDMFS-step4-c4a96a43a98d48b8939948453c825b46.jpg"
      ],
      "image": "assets/images/6984/step_04.webp"
    },
    {
      "text": "Add flour, baking soda, and salt; mix until just combined. Stir in walnuts and divide batter evenly into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9ml_XCOjLsi9vJVoM7Xw-d8x05w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6984-banana-sour-cream-bread-DDMFS-step5-53ab02dc5f1a4e1fa7019d125ca1e765.jpg"
      ],
      "image": "assets/images/6984/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gTZEU9_ubXbyBfwNyEI5K7-pewc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6984-banana-sour-cream-bread-DDMFS-step6-1f03095443e545499c133896fb3d584e.jpg"
      ],
      "image": "assets/images/6984/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kcdxlIXhpJJUY08OMgsE1yLpX6U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6984-banana-sour-cream-bread-DDMFS-4x3-42e521007c6241ca9db1a870f93d70b4.jpg"
      ],
      "image": "assets/images/6984/step_07.webp"
    }
