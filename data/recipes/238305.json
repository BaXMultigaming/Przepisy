  "ingredients": [
    "1 large yellow plantain, peeled",
    "0.125 teaspoon garlic powder",
    "1 tablespoon canola oil",
    "0.5 teaspoon reduced-fat margarine (such as Smart Balance®)",
    "0.125 teaspoon ground black pepper",
    "1 teaspoon agave nectar",
    "0.33333334326744 teaspoon light brown sugar",
    "1 pinch ground cinnamon, or more to taste"
  ],
  "steps": [
    {
      "text": "Cut plantain into three sections; quarter each section to yield twelve pieces. Season with garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil and margarine together in a small skillet over medium heat. Add plantain pieces, cook until lightly browned, 2 to 3 minutes per side. Season with black pepper; continue cooking until slightly darker in color, 2 to 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, drizzle agave syrup over plantain pieces; sprinkle with brown sugar and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
