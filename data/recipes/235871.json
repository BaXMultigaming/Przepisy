  "ingredients": [
    "0.25 cup all-purpose flour, or as needed",
    "0.25 teaspoon onion powder, or more to taste",
    "0.25 teaspoon garlic powder, or to taste",
    "salt and ground black pepper to taste",
    "1.5 pounds cubed beef stew meat",
    "1 tablespoon vegetable oil",
    "0.5 (16 ounce) package baby carrots, quartered",
    "0.5 yellow onion, quartered and sliced",
    "4 red potatoes, quartered",
    "2 stalks celery, roughly chopped",
    "2 cloves garlic, chopped",
    "0.75 cup red wine",
    "0.25 cup beef broth",
    "0.25 cup tomato paste",
    "1 teaspoon dried rosemary"
  ],
  "steps": [
    {
      "text": "Whisk together flour, onion powder, garlic powder, salt, and pepper in a large shallow bowl. Add beef to seasoned flour and toss until evenly coated; shake off any excess flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Cook beef in hot oil, stirring occasionally, until browned on all sides, 5 to 10 minutes. Transfer beef to the slow cooker; add carrots, onion, potatoes, celery, and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together red wine, beef broth, tomato paste, and rosemary in a small bowl until smooth; pour over beef and vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until beef and vegetables are tender, 4 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
