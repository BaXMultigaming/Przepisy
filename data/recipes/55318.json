  "ingredients": [
    "2.5 pounds russet potatoes, peeled and cubed",
    "0.25 teaspoon lemon juice",
    "1 egg white",
    "0.25 cup butter",
    "0.5 cup half-and-half cream",
    "salt and black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes and lemon juice in a large saucepan, and add enough water to cover. Bring to a boil over medium-high heat, and cook until tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain water from potatoes, and use a potato masher to mash. Stir in egg white and butter, and gradually mix in the half-and-half using the masher. Use more or less cream to reach your desired consistency. Season with salt and pepper to taste.",
      "section": null,
