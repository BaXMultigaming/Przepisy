  "ingredients": [
    "1 pound ground pork sausage, regular or hot",
    "2 cups finely shredded Monterey Jack and Cheddar cheese blend",
    "1.25 cups self-rising flour",
    "1 (8 ounce) package cream cheese, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
