  "ingredients": [
    "cooking spray",
    "1 pound lean ground beef",
    "0.33333334326744 cup chopped onion",
    "1 (8 ounce) can tomato sauce",
    "0.33333334326744 cup sliced black olives",
    "0.25 cup water",
    "2 tablespoons hot sauce",
    "1 large egg, beaten",
    "1 (1.25 ounce) package taco seasoning mix",
    "4 (10 inch) flour tortillas",
    "0.33333334326744 cup sour cream",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook beef and onion in a large, nonstick skillet over medium-high heat until beef is browned and crumbly, 5 to 7 minutes. Remove from the heat. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomato sauce, olives, water, hot sauce, egg, and taco seasoning; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each flour tortilla into 3 rounds using a 4-inch round cookie cutter. Fit a round into each of the prepared muffin cups and fill each with 1/4 cup meat mixture. Top with sour cream and Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
