  "ingredients": [
    "1 (15 ounce) can sliced beets, drained",
    "2 large eggs",
    "2.25 cups all-purpose flour",
    "2 cups white sugar",
    "0.5 cup unsweetened dark cocoa powder",
    "1 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "0.5 cup salted butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease the bottom of a 10-inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree beets in a food processor or blender until the consistency is smooth and no lumps remain. Add eggs and blend for a few seconds more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, cocoa, baking powder, and baking soda together in a separate bowl with an electric mixer. Mix in butter. Pour beet puree into the bowl while mixing on low speed to combine. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 40 minutes. Cool in the pan for 5 to 10 minutes before inverting onto a wire rack and cooling completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
