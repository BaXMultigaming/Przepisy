  "ingredients": [
    "1.5 cups spelt flour",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "1 cup mashed banana",
    "0.75 cup brown sugar",
    "0.33333334326744 cup vegetable shortening",
    "0.33333334326744 cup applesauce",
    "1 egg",
    "1 tablespoon maple syrup",
    "1.75 cups rolled oats",
    "0.5 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix spelt flour, salt, cinnamon, and baking soda together in a bowl. Mix banana, brown sugar, shortening, applesauce, egg, and maple syrup together in a separate bowl; add to flour mixture. Stir to combine. Fold in oats and raisins. Drop tablespoonfuls of batter onto an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cookies in the preheated oven until the edges are light brown, about 12 minutes. Cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
