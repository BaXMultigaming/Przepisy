  "ingredients": [
    "0.5 pound bacon",
    "1 pound mild pork sausage",
    "1 onion, finely diced",
    "1 tablespoon minced garlic",
    "6 cups chicken broth",
    "6 large red potatoes, sliced",
    "1 teaspoon red pepper flakes",
    "4 cups chopped fresh kale",
    "1 cup sour cream",
    "0.5 cup grated Parmesan cheese, plus extra for garnishing"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Add sausage, onion, and garlic; cook and stir until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble bacon into a large soup pot; add sausage mixture, chicken broth, potatoes, and red pepper flakes. Bring to a boil, then reduce heat to medium-low, and simmer until potatoes are soft, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir kale, sour cream, and 1/2 cup Parmesan cheese into soup; cook until kale wilts, about 5 minutes. Garnish with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
