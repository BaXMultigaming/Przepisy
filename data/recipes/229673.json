  "ingredients": [
    "2 tablespoons vegetable oil",
    "2 cups sliced carrots",
    "0.25 cup brown sugar",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon cayenne pepper, or to taste",
    "0.125 teaspoon freshly grated nutmeg"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a skillet over medium heat. Add carrots, brown sugar, cinnamon, cayenne pepper, and nutmeg; cook and stir until carrots are glazed, coated with spices, and tender, 10 to 15 minutes.",
