  "ingredients": [
    "0.5 cup butter",
    "0.33333298563957 cup unsweetened cocoa powder",
    "0.25 cup packed brown sugar",
    "0.25 cup milk",
    "3.5 cups confectioners' sugar",
    "1 teaspoon vanilla extract",
    "30 individually wrapped caramels, unwrapped",
    "1 tablespoon water",
    "2 cups salted peanuts",
    "0.5 cup semisweet chocolate chips",
    "0.5 cup milk chocolate chips"
  ],
  "steps": [
    {
      "text": "Grease an 8x8 inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a microwave-safe bowl, combine butter, cocoa powder, brown sugar and milk. Microwave until mixture boils. Stir in confectioners' sugar and vanilla extract. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a microwave-safe bowl, microwave caramels and water until caramels melt. Stir in peanuts. Spread mixture over chocolate layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small microwave-safe bowl, combine semisweet and milk chocolate chips; microwave until melted. Spread over caramel layer. Chill for 2 hours, or until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
