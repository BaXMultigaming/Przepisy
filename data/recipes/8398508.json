  "ingredients": [
    "1 pound dried red beans",
    "3 quarts water",
    "1 bay leaf",
    "1.5 pounds boneless pork shoulder, cut into 2-inch cubes",
    "1 yellow onion, chopped",
    "1 cup barbecue sauce",
    "0.5 cup ketchup",
    "0.33 cup apple cider vinegar",
    "0.25 cup packed light brown sugar",
    "3 tablespoons molasses",
    "2 tablespoons yellow mustard",
    "1 teaspoon Worcestershire sauce",
    "1 tablespoon smoked paprika",
    "0.125 teaspoon cayenne pepper",
    "1 teaspoon freshly ground black pepper",
    "1 tablespoon kosher salt",
    "1 teaspoon garlic powder",
    "2.50 cups reserved bean cooking liquid",
    "6 slices thick-cut bacon"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AjFSOF3gRNF3vzXeVFnUDdyJsGY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8398508-the-best-barbecue-baked-beans-VAT-4x3-01-1a8f12c339464290936ede8a55d743fc.jpg"
      ],
      "image": "assets/images/8398508/step_01.webp"
    },
    {
      "text": "Add dry beans to a bowl, cover with water, and let soak for 8 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M1T6jjkvxrM2YHTQFX4I18bnWxc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8398508-the-best-barbecue-baked-beans-VAT-4x3-step-02-867ae923981748dda1ba2720a51712cf.jpg"
      ],
      "image": "assets/images/8398508/step_02.webp"
    },
    {
      "text": "Drain beans and transfer to a large pot filled with 3 quarts of cold, fresh water. Add bay leaf, pork shoulder, and onion. Bring to a simmer over high heat. Reduce heat to medium-low and stir. Skim off foam if desired. Let simmer until beans are just tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X6VIdBrjCQM-B3_VtgNTrrSVj64=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8398508-the-best-barbecue-baked-beans-VAT-4x3-03-e7581981474c4dc7af50773b2022392e.jpg"
      ],
      "image": "assets/images/8398508/step_03.webp"
    },
    {
      "text": "Reduce heat to medium-low and stir. Skim off foam if desired. Let simmer until beans are just tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cAvu-9i-3t6SrhyZB0ip1K1sTeI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8398508-the-best-barbecue-baked-beans-VAT-4x3-04-9d430aa85830400e8d8eea442b6eee7f.jpg"
      ],
      "image": "assets/images/8398508/step_04.webp"
    },
    {
      "text": "While beans simmer, combine barbecue sauce, ketchup, vinegar, brown sugar, molasses, mustard, Worcestershire, smoked paprika, cayenne, black pepper, kosher salt, and garlic powder in a bowl with a whisk. Set aside until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jOm47TfD3XwUN0JJ6VedJwc37Zg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8398508-the-best-barbecue-baked-beans-VAT-4x3-05-1-7f55207f27a34bb3be2b8f1024de2f30.jpg"
      ],
      "image": "assets/images/8398508/step_05.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Transfer tender bean mixture to a deep, 15x10-inch baking dish using a spider strainer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xoQh_SUVATYlQYJJERBmp4DzGhs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8398508-the-best-barbecue-baked-beans-VAT-4x3-06-2-b9d7842dfe1e4047851ac9193b35e491.jpg"
      ],
      "image": "assets/images/8398508/step_06.webp"
    },
    {
      "text": "Pour in barbecue sauce mixture and 2 ½ cups of the bean cooking liquid. Place bacon slices on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/atGqVwH9nFLMstkkwyCVeXlp_Fo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8398508-the-best-barbecue-baked-beans-VAT-4x3-07-5bc84a6e5ef145c5a36b181aca7b863d.jpg"
      ],
      "image": "assets/images/8398508/step_07.webp"
    },
    {
      "text": "Bake uncovered in the center of the preheated oven until the liquids have reduced into a thick sauce, 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GwxMqQsnKZEDzemvXIdCXqHGzRE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8398508-the-best-barbecue-baked-beans-VAT-4x3-08-60a158578cbe4f409d7a91fc2043e3a0.jpg"
      ],
      "image": "assets/images/8398508/step_08.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h152tB0Ng3QjgkzAtmZpBoEL9-E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8398508-the-best-barbecue-baked-beans-VAT-4x3-2-547c0480aa9a458bb2bc6016ceb2547c.jpg"
      ],
      "image": "assets/images/8398508/step_09.webp"
    }
