  "ingredients": [
    "cooking spray",
    "0.75 cup white sugar",
    "2 eggs",
    "2 ripe bananas, mashed",
    "0.33333334326744 cup low-fat Greek banana yogurt",
    "3 tablespoons canola oil",
    "1 teaspoon vanilla extract",
    "1 cup whole wheat flour",
    "0.75 cup all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly spray a 12-cavity doughnut pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and eggs in a large bowl; beat with an electric mixer until smooth and creamy. Add bananas, yogurt, oil, and vanilla extract; mix until incorporated. Add whole wheat flour, all-purpose flour, cinnamon, baking soda, baking powder, and salt; mix until combined. Transfer batter to a resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Snip off one corner of the bag and pipe batter into the prepared doughnut pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake doughnuts in the preheated oven until slightly browned on the bottoms, 10 to 12 minutes. Remove from pan and transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
