  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup packed dark brown sugar",
    "0.66666668653488 cup solid-pack pumpkin puree",
    "0.5 cup butter, softened",
    "2 eggs",
    "1 teaspoon ground cinnamon",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground ginger",
    "0.5 teaspoon baking powder",
    "0.5 cup chopped pecans",
    "2 tablespoons butter, softened",
    "1.5 cups confectioners' sugar, sifted",
    "2 tablespoons orange juice",
    "1 tablespoon grated orange zest"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat flour, brown sugar, pumpkin, 1/2 cup butter, eggs, cinnamon, vanilla extract, baking soda, nutmeg, ginger, and baking powder together in a large bowl using an electric mixer on medium speed until batter is evenly combined, about 2 minutes. Fold pecans into batter and spread into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 20 to 25 minutes. Remove from oven and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 2 tablespoons butter and confectioners' sugar together in a bowl using an electric mixer until smooth; beat in orange juice and orange zest until frosting is light and spreadable. Spread frosting onto cooled bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
