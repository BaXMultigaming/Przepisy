  "title": "Nutty Pumpkin Bars",
  "description": "Nutty pumpkin bars have an extra crunch from pecans and are topped with a fresh orange frosting for a tasty treat during the fall season.",
  "authors": [
    "Gran28540"
  ],
  "date_published": "2020-03-05T00:11:10-05:00",
