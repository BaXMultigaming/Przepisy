  "ingredients": [
    "1 pound dry black beans, soaked overnight",
    "6 cups chicken broth",
    "4 teaspoons diced jalapeno peppers",
    "1 tablespoon chili powder",
    "1 teaspoon ground cumin",
    "1 teaspoon cayenne pepper",
    "0.75 teaspoon ground black pepper",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon hot pepper sauce"
  ],
  "steps": [
    {
      "text": "Drain black beans, rinse well, and place into a slow cooker. Add chicken broth and jalapeño peppers. Season with chili powder, cumin, cayenne, black pepper, garlic powder, and hot pepper sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for 4 hours. Reduce heat to Low and continue cooking for 2 more hours.",
      "section": null,
