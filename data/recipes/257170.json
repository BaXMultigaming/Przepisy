  "steps": [
    {
      "text": "Mix flour and salt together in a large bowl. Mix in water, a little at a time, then rub in lard until dough comes together in a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer dough to a lightly floured work surface; knead until smooth and elastic, about 10 minutes. Divide dough into 6 pieces; roll out each piece to 1/16-inch thickness.",
