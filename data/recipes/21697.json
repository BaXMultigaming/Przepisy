  "title": "Chocolate Pudding with Meringue",
  "description": "A rich, custardy, steamed chocolate pudding topped with chocolate meringue.",
  "authors": [
    "SALLYCOOKS"
  ],
  "date_published": "2000-09-29T13:04:06-04:00",
