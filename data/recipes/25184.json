    "salt and pepper to taste",
    "Creole-style seasoning to taste",
    "1 (14.5 ounce) can stewed tomatoes, with liquid",
    "1 stalk celery, diced",
    "1 green bell pepper, diced",
    "3 cloves garlic, minced",
