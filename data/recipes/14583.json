  "ingredients": [
    "4 red potatoes, thinly sliced",
    "1 sheet aluminum foil",
    "1 large onion, chopped",
    "0.25 cup butter, cubed",
    "0.25 cup chopped fresh basil",
    "4 cloves garlic, chopped",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the grill for medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer potatoes on aluminum foil with onion, butter, basil, and garlic. Season with salt and pepper. Fold foil around potatoes to make a packet; seal well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place packet on the preheated grill over indirect heat and cook until potatoes are tender, about 30 minutes. Turn over packet halfway through cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
