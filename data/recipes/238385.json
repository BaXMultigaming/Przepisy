        "https://www.allrecipes.com/thmb/l6-QfMcdhdT-yio_C88k1JpSHPs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/238385-pickle-brine-chicken-ddmfs-3X4-0145-66c102ce7120422ca1a4d192353f5bf5.jpg"
