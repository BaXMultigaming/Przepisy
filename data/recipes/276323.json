  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 cup old-fashioned oats",
    "0.25 cup brown sugar",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "1 cup low-fat vanilla Greek yogurt",
    "0.33333334326744 cup buttermilk",
    "0.25 cup vegetable oil",
    "1 large egg, lightly beaten",
    "1 teaspoon vanilla extract",
    "0.75 cup peeled and grated apple",
    "0.75 cup peeled and grated carrots",
    "0.33333334326744 cup chopped walnuts, lightly toasted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, oats, brown sugar, baking powder, cinnamon, baking soda, salt, and nutmeg together in a large bowl. Whisk together yogurt, buttermilk, oil, egg, and vanilla extract in a second bowl. Fold flour mixture into yogurt mixture, mixing just until combined and flour disappears. Stir together apple, carrot, and walnuts in a separate bowl; gently fold into the batter. Divide batter evenly among the muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake muffins in the preheated oven until golden brown or a toothpick inserted in the center comes out clean, 17 to 19 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool muffins in the tin for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
