  "ingredients": [
    "0.75 cup ketchup",
    "2 tablespoons dark brown sugar",
    "1 tablespoon molasses",
    "2 teaspoons apple cider vinegar",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon liquid smoke",
    "0.5 teaspoon salt",
    "0.5 teaspoon pepper",
    "0.125 teaspoon cayenne pepper",
    "2 medium baking potatoes, cut into quarters",
    "3 large carrots, cut into 1-inch chunks",
    "6 Brussels sprouts, halved",
    "1.5 pounds boneless, skinless chicken thighs",
    "Reynolds Wrap® Non-Stick Foil"
  ],
  "steps": [
    {
      "text": "Preheat grill to medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk all the ingredients for the Kansas-Style BBQ sauce in a small bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes, carrots and Brussels sprouts into a 9-inch cast iron skillet. Place chicken thighs on top of the vegetables and using a pastry brush, generously brush Kansas-style BBQ sauce onto chicken thighs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover cast iron skillet tightly with a sheet of Reynolds Wrap® Non-Stick Foil, with the non-stick side facing down on top of the chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cast iron skillet onto grill and roast for 25 to 30 minutes. Remove foil and continue roasting for 15 minutes until chicken is tender and juices run clear or meat thermometer inserted into the center reads 180 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove skillet from grill and let chicken cool for 20 minutes. Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
