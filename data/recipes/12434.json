  "ingredients": [
    "3 cups all-purpose flour",
    "1 teaspoon salt",
    "0.75 cup shortening",
    "1 egg, beaten",
    "0.25 cup water",
    "1 teaspoon distilled white vinegar"
  ],
  "steps": [
    {
      "text": "Combine flour and salt. Cut in shortening with pastry blender until mixture resembles coarse meal. Combine egg and water, and sprinkle lightly over flour mixture. Add vinegar, and lightly stir with a fork until dry ingredients are moistened. Shape into a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap dough in wax paper. Chill for at least one hour. Use as directed in any fried pie recipe.",
      "section": null,
