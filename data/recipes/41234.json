  "ingredients": [
    "6 tablespoons white sugar, divided",
    "14 Italian prune plums, halved and pitted",
    "3 eggs",
    "1.3333333730698 cups milk",
    "0.66666668653488 cup all-purpose flour",
    "1.5 teaspoons grated lemon zest",
    "2 teaspoons vanilla",
    "1 pinch salt",
    "0.5 teaspoon ground cinnamon",
    "2 tablespoons confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 10-inch pie plate, and sprinkle 1 tablespoon of sugar over the bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange plum halves, cut-side down, to cover the entire bottom of the pie plate. Sprinkle 2 tablespoons of sugar on top of plums.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the custard: Combine remaining 3 tablespoons of sugar, eggs, milk, flour, lemon zest, cinnamon, vanilla, and salt in a blender. Process until smooth, about 2 minutes. Pour over arranged plums in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until custard is firm and lightly browned, about 50 to 60 minutes. Let stand 5 minutes before slicing. Dust with confectioners' sugar before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
