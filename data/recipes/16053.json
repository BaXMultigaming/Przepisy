  "ingredients": [
    "1 cup dates, pitted and chopped",
    "1 teaspoon baking soda",
    "1 cup boiling water",
    "1 cup white sugar",
    "2.5 cups all-purpose flour",
    "1 cup chopped walnuts",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 pinch salt",
    "1 tablespoon butter",
    "1 cup buttermilk",
    "1 cup white sugar",
    "1 pinch salt",
    "4 tablespoons all-purpose flour",
    "1 cup chopped walnuts",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 C). Grease and flour two 8 inch round cake pans. Set aside. Put dates in a bowl with soda and pour boiling water on top. Set a side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, mix together 1 cup sugar, 2 1/2 cups flour and 1 cup chopped walnuts. Add egg, 1 teaspoon vanilla, pinch of salt and tablespoon butter. Mix to combine. Finally, stir in chopped dates with liquid. Mix well. Pour batter into prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 to 30 minutes. Cake will pull away from sides of pans and be golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan, combine buttermilk, 1 cup sugar, pinch of salt and 4 tablespoons flour. Cook on medium heat until thickened. Stir in 1 teaspoon vanilla and remaining cup of walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread mixture between layers and on top of cake. Let filling run down the sides of cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
