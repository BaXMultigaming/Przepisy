  "ingredients": [
    "6 ice cubes",
    "2 fluid ounces bourbon",
    "1 fluid ounce maple syrup",
    "1 fluid ounce brandy-based orange liqueur (such as Grand Marnier®)",
    "1 clementine, juiced and peel cut into 1x1/4-inch strips",
    "0.5 lemon, juiced"
  ],
  "steps": [
    {
      "text": "Place ice cubes in a cocktail shaker; add bourbon, maple syrup, orange liqueur, clementine juice, and lemon juice. Cover and shake until the outside of the shaker has frosted, about 15 seconds. Strain into a chilled martini glass.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Light a match or lighter over cocktail; squeeze clementine peel strip near flame to ignite peel's oil. Rub peel on rim of glass; drop peel into cocktail.",
