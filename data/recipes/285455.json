  "ingredients": [
    "1 cup white wine vinegar",
    "3 tablespoons sesame oil",
    "1 tablespoon white sugar",
    "1 tablespoon soy sauce",
    "1 teaspoon lime juice",
    "1 (16 ounce) package coleslaw mix",
    "0.25 cup sliced green onions",
    "1 tablespoon olive oil",
    "2 (4 ounce) fillets salmon",
    "salt and ground black pepper to taste",
    "6 (6 inch) corn tortillas"
  ],
  "steps": [
    {
      "text": "Whisk vinegar, sesame oil, sugar, soy sauce, and lime juice together in large bowl. Add coleslaw mix and green onions; toss to coat and let stand for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat olive oil in a skillet over medium-high heat. Season salmon with salt and pepper and place in the hot skillet. Saute until salmon is golden brown and flakes easily with a fork, 3 to 4 minutes per side. Remove from heat and flake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat tortillas in a dry skillet over medium-high heat until slightly crispy, 30 to 60 seconds per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain slaw mixture, then spoon into the center of each tortilla and add flaked salmon on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
