  "ingredients": [
    "2 tablespoons cocoa powder",
    "2 tablespoons brown sugar",
    "1 teaspoon hazelnut flavor instant coffee powder",
    "0.25 cup chia seeds",
    "1 cup milk",
    "2 teaspoons honey, or to taste"
  ],
  "steps": [
    {
      "text": "Combine cocoa powder, brown sugar, and instant coffee powder in a bowl; stir until no lumps remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold chia seeds into mixture; stir in milk to incorporate. Let mixture sit a few minutes before stirring again. Repeat resting and stirring for about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl with plastic wrap; refrigerate 2 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle honey over pudding; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
