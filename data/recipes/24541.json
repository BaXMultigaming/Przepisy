  "ingredients": [
    "2 bunches beets",
    "2 tablespoons water",
    "0.25 cup white vinegar",
    "2 tablespoons caraway seeds",
    "1 teaspoon white sugar",
    "2 tablespoons minced onion",
    "1 teaspoon prepared horseradish",
    "0.25 teaspoon ground cloves",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "5 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Wash beets and trim off greens. Bring a medium pot of salted water to a boil, add beets and cook, covered, until beets are tender. Remove from heat, drain, and peel and slice when cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk together the water, vinegar, caraway seeds, sugar, onion, horseradish, cloves, salt, pepper and oil. Add beets and toss to coat. Let stand for several hours, stirring occasionally. Serve at room temperature or chilled, as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
