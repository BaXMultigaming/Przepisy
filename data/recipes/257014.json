  "ingredients": [
    "1 cup all-purpose flour",
    "2.5 tablespoons white sugar",
    "2 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "1 cup milk",
    "2 large eggs",
    "0.25 cup butter, melted",
    "1 tablespoon vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Mix together flour, sugar, baking powder, cinnamon, and baking soda in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together milk, eggs, and melted butter in a separate bowl until well combined. Pour into flour mixture; whisk until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil on a griddle over medium heat. Drop batter by 1/4 cup spoonfuls onto the hot griddle. Cook until bubbles form and the edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Remove to a plate and keep warm while you cook remaining batter.",
      "section": null,
