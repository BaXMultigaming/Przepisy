  "ingredients": [
    "1.5 tablespoons yellow miso paste",
    "1.5 tablespoons seasoned rice vinegar",
    "1.5 tablespoons maple syrup",
    "1 teaspoon hot chili sauce (such as Sriracha®)",
    "1 teaspoon vegetable oil",
    "2 (6 ounce) center-cut salmon fillets, with skin"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Brush an oven-safe skillet with vegetable oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk miso paste, rice wine vinegar, maple syrup, and hot chili sauce together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange salmon fillets, skin-sides down, in the prepared skillet. Place skillet over medium heat; cook until skin starts to sizzle, 2 to 3 minutes. Remove skillet from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush salmon fillets with miso glaze. Place skillet in the preheated broiler; cook until salmon is just cooked through and top is browned, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove fillets from skillet, separating flesh from skins; leave skins in the pan.",
      "section": null,
