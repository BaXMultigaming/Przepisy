  "ingredients": [
    "3 tablespoons vegetable oil",
    "1.5 pounds boneless lean beef, cubed",
    "2 teaspoons garlic powder",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "6 cups water, divided",
    "3 (10.5 ounce) cans beef broth",
    "6 medium carrots, chopped",
    "6 medium green onions, chopped",
    "4 stalks celery, chopped",
    "1 cup barley",
    "0.5 cup chopped fresh parsley",
    "1 teaspoon dried thyme"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hRHgYSFQXsiIbuxqEvPUx3nadMY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16454-slow-cooker-beef-barley-soup-DDMFS-114-4x3-step-01-8d3f5e8607f94c78bf281a728603f790.jpg"
      ],
      "image": "assets/images/16454/step_01.webp"
    },
    {
      "text": "Heat oil in a skillet over medium heat. Add beef and sauté until browned, about 5 minutes. Stir in garlic powder, salt, and pepper, then transfer mixture to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vnj3mIloEzXsXbPL8-mwZjQydCo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16454-slow-cooker-beef-barley-soup-DDMFS-117-4x3-step-02-f25401791e3e4064b5611e33bded32ff.jpg"
      ],
      "image": "assets/images/16454/step_02.webp"
    },
    {
      "text": "Add a few tablespoons water to the skillet. Stir over medium heat, scraping up any browned bits with a spoon. Transfer liquid and browned bits to the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MIBE8_5RxORIz4g8HQf4-bKPggc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16454-slow-cooker-beef-barley-soup-DDMFS-119-4x3-step-03-d23adb1b2bee43c98b62ee413ababd10.jpg"
      ],
      "image": "assets/images/16454/step_03.webp"
    },
    {
      "text": "Add remaining water, broth, carrots, green onions, celery, barley, and parsley. Cover and cook on Low until vegetables and barley are tender, 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZdTkgz-0SCLcY1Ejh9CLJOAKKxM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16454-slow-cooker-beef-barley-soup-DDMFS-120-4x3-step-04-f54382dbf161422bb0b40a3222f92abe.jpg"
      ],
      "image": "assets/images/16454/step_04.webp"
    },
    {
      "text": "Stir in thyme just before serving.",
      "section": null,
      "name": null,
      "url": null,
