  "ingredients": [
    "2 cups water",
    "1.6666666269302 cups dry lentils",
    "1 (14.5 ounce) can stewed tomatoes",
    "2 large onions, chopped",
    "3 cloves garlic, minced",
    "2 teaspoons salt",
    "0.25 teaspoon pepper",
    "0.25 teaspoon dried marjoram",
    "0.25 teaspoon dried sage",
    "0.25 teaspoon dried thyme",
    "1 large bay leaf",
    "2 large carrots, cut into 1/2 inch pieces",
    "1 stalk celery, chopped",
    "1 medium green bell pepper, chopped",
    "1.5 cups shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix water, lentils, stewed tomatoes, onions, garlic, salt, pepper, marjoram, sage, thyme, and bay leaf together in a 3-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in carrots and celery; cover and continue to bake until lentils and vegetables are tender, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in bell pepper, then sprinkle Cheddar over top. Bake, uncovered, until cheese has melted, about 5 more minutes. Remove bay leaf before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
