  "ingredients": [
    "4 pounds boneless beef short ribs",
    "salt and pepper to taste",
    "0.33333334326744 cup molasses",
    "0.66666668653488 cup ketchup",
    "0.25 cup fresh lemon juice",
    "1 tablespoon dry mustard",
    "0.5 teaspoon chili powder",
    "0.5 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Trim fat from rib meat. Sprinkle with salt and pepper to taste. Place in a Dutch oven and cover with water. Simmer for 2 hours. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine the molasses, ketchup, lemon juice, dry mustard, chili powder and garlic powder. Mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the drained meat on a broiler rack. Brush molasses mixture over ribs. Broil on medium for 10 to 15 minutes, turning and basting with sauce often.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
