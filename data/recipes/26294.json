  "ingredients": [
    "1 pound dry vermicelli pasta",
    "2 skinless, boneless chicken breast halves - cut into strips",
    "2 butterfly pork chops, thinly sliced",
    "2 cloves garlic, crushed",
    "3 tablespoons vegetable oil",
    "0.5 onion, thinly sliced",
    "2 carrots, thinly sliced",
    "2 stalks celery, thinly sliced",
    "0.5 (12 ounce) package frozen shrimp, thawed",
    "1 cup bean sprouts",
    "2 tablespoons soy sauce",
    "3 tablespoons yellow curry powder",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until al dente, 8 to 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep skillet or fry pan over medium-high heat. Add chicken, pork, and garlic; cook until browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium-low. Add onion, carrots, and water; cover and steam for 5 minutes. Stir in celery and shrimp; cover and steam for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in bean sprouts, soy sauce, and curry powder; stir together until blended and hot, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add noodles to the skillet; toss well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
