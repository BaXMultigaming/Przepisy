  "ingredients": [
    "0.75 cup blanched slivered almonds",
    "0.33333334326744 cup instant coffee granules",
    "2 tablespoons hot water",
    "2.6666667461395 cups all-purpose flour",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.25 cups white sugar",
    "0.5 cup butter, softened",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups semi-sweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast almonds in a single layer on a baking sheet in the preheated oven until brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve coffee in 2 tablespoons hot water in a small bowl; set aside. Whisk flour, baking soda, and salt together in a separate bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a large bowl with an electric mixer at a medium speed until fluffy. Add coffee, eggs, and vanilla extract; mix well. Reduce mixer’s speed to low; slowly add flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold chocolate chips and almonds into dough. Drop teaspoonfuls of dough 3 inches apart onto an ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
