  "ingredients": [
    "8 (6 ounce) chicken thighs",
    "1 (12 ounce) jar roasted red peppers, drained and chopped",
    "3 tablespoons bottled minced garlic",
    "0.5 cup mayonnaise",
    "1 tablespoon pesto",
    "6 (6 inch) hoagie rolls, split lengthwise",
    "2 large tomatoes, sliced"
  ],
  "steps": [
    {
      "text": "Place chicken in the bottom of a slow cooker. Add roasted red peppers and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until chicken is no longer pink at the bone and the juices run clear, about 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the chicken is cooking, mix mayonnaise and pesto in a small bowl. Store in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred chicken with 2 forks. Use a slotted spoon to put chicken and pepper mixture onto hoagie rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with pesto mayonnaise and sliced tomatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
