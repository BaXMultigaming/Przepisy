  "ingredients": [
    "2 (15.25 ounce) cans whole kernel corn",
    "2 (15 ounce) cans creamed corn",
    "4 tablespoons white sugar",
    "4 tablespoons all-purpose flour",
    "4 tablespoons milk",
    "4 eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine corn, creamed corn, sugar, flour, milk, and eggs. Mix well. Pour mixture into a soufflé dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the middle of soufflé comes out clean, about 1 to 1 1/2 hours.",
