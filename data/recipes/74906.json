  "ingredients": [
    "3 quarts chicken stock",
    "3 pounds celery, coarsely chopped",
    "0.5 pound carrots, julienned",
    "0.5 pound onions, chopped",
    "1 cup all-purpose flour",
    "1 tablespoon salt",
    "1 teaspoon ground white pepper",
    "3 quarts hot milk",
    "1 cup margarine"
  ],
