  "ingredients": [
    "0.75 cup light cream",
    "1 (4 ounce) bar sweet baking chocolate, chopped",
    "2 tablespoons white sugar",
    "2 egg yolks, lightly beaten",
    "0.5 teaspoon vanilla extract",
    "4 tablespoons whipped cream, or to taste"
  ],
  "steps": [
    {
      "text": "Heat together cream, chocolate, and sugar in a medium saucepan over medium heat, stirring constantly, until chocolate is melted and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour a little of the chocolate mixture into beaten egg yolks and vanilla in a medium bowl; mix until smooth. Pour back into the saucepan with remaining chocolate mixture. Heat gently, stirring constantly, until custard thickens slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon custard into small dessert bowls and garnish with whipped cream.",
      "section": null,
