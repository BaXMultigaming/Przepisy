  "title": "Berliner Brot (German Christmas Cookie)",
  "description": "Berliner Brot is a classic German bar cookie with hazelnuts and chocolate, that is only eaten during advent and Christmas.",
  "authors": [
    "Jason Wilkins"
  ],
  "date_published": "2022-04-01T09:09:15-04:00",
