  "ingredients": [
    "1 pound small new potatoes, quartered",
    "0.5 cup plain Greek yogurt",
    "0.25 cup light mayonnaise",
    "1 tablespoon Dijon mustard",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "2 cups steamed cauliflower rice",
    "0.25 cup finely chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Put potatoes in a large saucepan with water to cover. Bring to a boil and cook, covered, until tender, 15 to 20 minutes. Drain; rinse with cold water. Let potatoes cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together yogurt, mayonnaise, mustard, salt, and pepper in a large bowl. Stir in cauliflower and fresh parsley. Add cooled potatoes; toss gently to coat. Chill, covered, at least 1 hour or up to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
