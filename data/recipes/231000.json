  "ingredients": [
    "1.5 pounds new potatoes, cut into 1-inch pieces",
    "3 tablespoons extra-virgin olive oil",
    "2 tablespoons grated Parmesan cheese",
    "1 tablespoon chopped fresh rosemary",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil.",
