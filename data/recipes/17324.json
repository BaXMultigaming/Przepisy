  "title": "Cracker Jack Cookies II",
  "description": "Chocolate chip cookies with a few more ingredients. Oatmeal, coconut, and cereal make them very good and chewy.",
  "authors": [
    "Earthymom"
  ],
  "date_published": "2000-04-04T15:04:28-04:00",
