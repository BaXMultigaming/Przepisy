  "ingredients": [
    "1 (15 ounce) package pastry for a 9 inch double crust pie",
    "0.75 cup white sugar",
    "0.33333334326744 cup all-purpose flour",
    "0.75 teaspoon ground cinnamon",
    "4 cups blackberries",
    "0.75 cup semisweet chocolate chips",
    "0.5 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Place one of the pie crusts into the bottom of a 9 inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix the sugar, flour, and cinnamon. Gently stir in the blackberries and chocolate chips. Sprinkle with lemon juice. Transfer to the pie crust in the pie plate. Place remaining pie crust over the top, and secure to the bottom crust by pressing with a fork, or fluting with your fingers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 35 minutes in the preheated oven, until top is golden brown. Cool slightly before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
