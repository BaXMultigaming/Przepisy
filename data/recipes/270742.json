  "ingredients": [
    "0.5 cup vegetable oil",
    "1 egg",
    "0.25 cup milk",
    "1 tablespoon lemon juice",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.75 cup white sugar",
    "0.5 cup mini chocolate chips",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1 cup shredded zucchini"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup cupcake pan with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk vegetable oil, egg, milk, lemon juice, and vanilla extract together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, chocolate chips, baking soda, cinnamon, and salt in a separate bowl. Pour in oil mixture and fold gently to combine. Stir in zucchini. Spoon batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes. Transfer to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
