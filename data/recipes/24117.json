  "ingredients": [
    "6 cups apples - peeled, cored and sliced",
    "1.25 teaspoons ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 cup white sugar",
    "0.5 cup buttermilk baking mix",
    "0.75 cup milk",
    "2 eggs",
    "2 tablespoons butter, softened",
    "1 cup buttermilk baking mix",
    "0.5 cup chopped walnuts",
    "0.33333334326744 cup dark brown sugar",
    "3 tablespoons margarine, chilled"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine apples, cinnamon, nutmeg, white sugar and 1/2 cup baking mix. Stir together the milk and eggs and mix into apple mixture, Pour filling into pie plate and dot with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the Topping: In a large bowl, combine 1 cup baking mix, walnuts, brown sugar and margarine. Mix until crumbly and sprinkle over top of apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 60 minutes, or until apples are cooked and topping is golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
