  "ingredients": [
    "1 cup all-purpose flour",
    "1.5 tablespoons white sugar",
    "0.5 tablespoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup coconut milk (such as Coconut Dream®)",
    "0.25 cup vegan butter (such as Earth Balance®), melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour into a bowl and add sugar, baking powder, and salt. Mix together. Add coconut milk and vegan butter; mix together gently until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter by heaping tablespoonfuls onto the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until sides or tops are golden, 10 to 13 minutes. Let sit for 2 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
