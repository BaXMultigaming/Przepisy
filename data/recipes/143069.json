  "ingredients": [
    "1 pound bulk mild Italian sausage",
    "1.25 teaspoons crushed red pepper flakes",
    "4 slices bacon, cut into 1/2 inch pieces",
    "1 large onion, diced",
    "1 tablespoon minced garlic",
    "5 (13.75 ounce) cans chicken broth",
    "6 medium potatoes, thinly sliced",
    "1 cup heavy cream",
    "0.25 bunch fresh spinach, tough stems removed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Mz7ERZ-aRpm_XS-cWQMbtHYWhuU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-143069-super-delicious-zuppa-toscana-ddmfs-step-01-1-b262512ec36a4d01841a4885012ec2f5.jpg"
      ],
      "image": "assets/images/143069/step_01.webp"
    },
    {
      "text": "Cook Italian sausage and red pepper flakes in a Dutch oven over medium-high heat until crumbly, browned, and no longer pink, 10 to 15 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/68DyvkErMKRClUtxUy97VhQHbdk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-143069-super-delicious-zuppa-toscana-ddmfs-step-02-1-99b4cebd724743f2bc798d4d8288305f.jpg"
      ],
      "image": "assets/images/143069/step_02.webp"
    },
    {
      "text": "Cook bacon in the same Dutch oven over medium heat until crisp, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VWml_9pLw5mYJjw5JQrLiL40Rec=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-143069-super-delicious-zuppa-toscana-ddmfs-step-03-1-4165605b5a1e487f9999027f656f6237.jpg"
      ],
      "image": "assets/images/143069/step_03.webp"
    },
    {
      "text": "Drain, leaving a few tablespoons of drippings with the bacon in the bottom of the Dutch oven. Stir in onions and garlic; cook until onions are soft and translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ziK9cEbL_-d3PVgm3CqBTvsrOQQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-143069-super-delicious-zuppa-toscana-ddmfs-step-04-1-18c2f8e5c9f241789c2d73112cc4c538.jpg"
      ],
      "image": "assets/images/143069/step_04.webp"
    },
    {
      "text": "Stir in chicken broth and bring to a boil over high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MwG0Ro3M46nniFKZUYVRvyFDmq0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-143069-super-delicious-zuppa-toscana-ddmfs-step-05-1-7de904c711c04fc3a55edaf7dbf0736b.jpg"
      ],
      "image": "assets/images/143069/step_05.webp"
    },
    {
      "text": "Add potatoes and simmer until fork tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1AShjRuOkNo8CzmyHUWenOlY56Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-143069-super-delicious-zuppa-toscana-ddmfs-step-06-1-bc9af25b03684e52835c9450f22b445e.jpg"
      ],
      "image": "assets/images/143069/step_06.webp"
    },
    {
      "text": "Reduce heat to medium; stir in cream, cooked sausage, and spinach.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g-MVwE5YrToLln8XEbsZ3SO-qQQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-143069-super-delicious-zuppa-toscana-ddmfs-step-07-1-185db2a57d444493b44194c961fe54d1.jpg"
      ],
      "image": "assets/images/143069/step_07.webp"
    },
    {
      "text": "Cook and stir until spinach has wilted and sausage is warmed through; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_KM-E-twRNSm8pniAzsSeOYX6ao=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-143069-super-delicious-zuppa-toscana-ddmfs-Beauty-4x3-8ee6560b8d8e43c49321c468fc48df9a.jpg"
      ],
      "image": "assets/images/143069/step_08.webp"
    }
