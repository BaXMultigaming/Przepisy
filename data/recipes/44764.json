  "ingredients": [
    "2 hoagie buns, split",
    "2 tablespoons mayonnaise",
    "2 teaspoons prepared coarse-ground mustard",
    "1 pound deli sliced roast beef",
    "2 tomatoes, thinly sliced",
    "0.5 red onion, thinly sliced",
    "4 slices provolone cheese",
