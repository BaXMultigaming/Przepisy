  "ingredients": [
    "0.75 cup low-fat cream cheese",
    "0.5 cup packed brown sugar",
    "0.5 cup canned pumpkin",
    "2 teaspoons maple syrup",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Beat cream cheese, brown sugar, and canned pumpkin together with an electric mixer on medium speed in a bowl until light and creamy, 3 to 5 minutes. Add maple syrup and cinnamon and beat until smooth, 1 to 2 minutes. Cover with plastic wrap and refrigerate for 30 minutes.",
