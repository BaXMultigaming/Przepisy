  "ingredients": [
    "1 pound pork butt roast",
    "2.5 cups water",
    "0.5 onion",
    "1 clove garlic, peeled",
    "1 bay leaf",
    "salt to taste",
    "8 black peppercorns",
    "1 dried red chile pepper"
  ],
  "steps": [
    {
      "text": "Trim fat from pork butt. Cut into chunks and place in a large saucepan. Add water, onion, garlic, bay leaf, salt, peppercorns and chile pepper. Bring to a boil; skim foam from surface. Reduce heat, cover and simmer for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain broth, let meat cool and shred with a fork. Refrigerate overnight if desired.",
