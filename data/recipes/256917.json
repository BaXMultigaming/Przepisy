  "title": "Pan Roasted Spanish-Lemon Drumsticks with Potatoes",
  "description": "Chicken drumsticks and potatoes are seasoned with garlic, salt, and pepper and roasted with lemons creating a savory and quick meal.",
  "authors": [
    "Chef Mia"
  ],
  "date_published": "2018-06-08T10:42:11-04:00",
