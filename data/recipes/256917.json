  "ingredients": [
    "3 pounds bone-in chicken drumsticks",
    "1 tablespoon paprika",
    "3 tablespoons olive oil, divided",
    "1.5 tablespoons chopped garlic, divided",
    "0.75 teaspoon salt, divided",
    "0.5 teaspoon ground black pepper, divided",
    "2 pounds red potatoes",
    "2 lemons, thinly sliced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chicken with paprika, half of the olive oil, half of the garlic, half of the salt, and half of the pepper together in a bowl until evenly coated. Toss potatoes with remaining olive oil, garlic, salt, and pepper in a separate bowl; add lemon slices and toss well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange chicken in a roasting pan and surround chicken with potatoes and lemon slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes; rotate and flip chicken and potatoes. Continue baking until chicken is no longer pink in the center and the potatoes are tender, 20 to 30 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
