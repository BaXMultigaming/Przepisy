  "ingredients": [
    "1 (9 inch) unbaked pie crust",
    "1 cup white sugar",
    "1 cup milk",
    "0.25 cup butter, melted",
    "2 tablespoons all-purpose flour",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground nutmeg",
    "3 large eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pie crust in the preheated oven until partially baked, about 5 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Adjust oven temperature to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, milk, melted butter, flour, vanilla, and nutmeg in a large bowl; mix well. Beat in eggs until well blended. Pour filling into partially baked pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean and custard is set, 45 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
