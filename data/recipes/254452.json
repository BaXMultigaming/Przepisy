  "ingredients": [
    "2 cups pitted Medjool dates, roughly chopped",
    "2 cups raw cashews",
    "1 cup raw or roasted unsalted almonds",
    "0.75 cup high-quality unsweetened cocoa powder (such as Guittard® Cocoa Rouge)",
    "0.5 cup unsweetened shredded coconut",
    "2 tablespoons coconut oil, melted",
    "1 tablespoon cold espresso, or more as needed (or water)",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon kosher salt",
    "0.5 pinch cayenne pepper"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IjpBC-JgiPSiWvWhlXPQbKM4mpo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/254452-chef-johns-chocolate-energy-bars-DDMFS-step-01-64298324c794463b956e2feff795b13b.jpg"
      ],
      "image": "assets/images/254452/step_01.webp"
    },
    {
      "text": "Place dates, cashews, almonds, cocoa powder, shredded coconut, coconut oil, cold espresso, vanilla, salt, and cayenne in the bowl of a food processor. Pulse on and off to start, then process for about 1 minute. Check to ensure mixture is sticky and moist enough to come together. Add more coffee if needed. Continue to process until mixture becomes a chunky mass.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-Tbyf0lfS74w0I5XVyrgNVbOtYA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/254452-chef-johns-chocolate-energy-bars-DDMFS-step-02-3624782bcd1c4ecda5eb3d981d3e2037.jpg"
      ],
      "image": "assets/images/254452/step_02.webp"
    },
    {
      "text": "Line a 9x9-inch square baking pan with plastic wrap. Scoop mixture into the pan; press down with a spatula until mixture is even. Place a layer of plastic wrap on the surface and smooth again with your hands. Refrigerate until cold and firm, 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1obWiIahRYEbjunBX0TrMe7v5bs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/254452-chef-johns-chocolate-energy-bars-DDMFS-step-03-bd253658f23b4f6f957e34465ac11f1a.jpg"
      ],
      "image": "assets/images/254452/step_03.webp"
    },
    {
      "text": "Remove from the pan and unwrap. Cut into 10 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TBwTwksXwUEFffOp1Io3bvqSdkk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/254452-chef-johns-chocolate-energy-bars-DDMFS-step-04-84d70904c3224f2bb3a502fea5f51d40.jpg"
      ],
      "image": "assets/images/254452/step_04.webp"
