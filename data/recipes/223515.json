  "ingredients": [
    "5 tablespoons biscuit baking mix (such as Bisquick®)",
    "0.25 teaspoon salt",
    "ground black pepper to taste",
    "0.66666668653488 cup shredded Parmesan cheese",
    "2 eggs",
    "2 cups whole kernel corn, drained",
    "2 tablespoons finely chopped onion",
    "0.25 cup butter",
    "2 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Whisk baking mix with salt, black pepper, and Parmesan cheese in a small bowl. Beat eggs in a separate bowl and stir in corn and onion. Lightly stir biscuit mix-cheese mixture into corn mixture just until moistened; do not overmix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter with vegetable oil in a large skillet over medium heat. Drop batter into hot skillet with a tablespoon and flatten fritters slightly with spoon. Cook fritters until browned on both sides, about 3 minutes per side, and drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
