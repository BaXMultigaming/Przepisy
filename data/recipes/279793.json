  "ingredients": [
    "2 tablespoons white sugar",
    "2 tablespoons instant coffee granules",
    "2 tablespoons boiling water",
    "0.75 cup milk, divided",
    "1 cup ice",
    "1 fluid ounce amaretto liqueur",
    "1 fluid ounce creme de cacao"
  ],
  "steps": [
    {
      "text": "Combine sugar and instant coffee in a bowl and pour in boiling water. Whip until the mixture is thickened and holds its shape, 3 to 4 minutes",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/2 of the milk into an old fashioned glass.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a cocktail shaker with ice and pour in remaining milk, amaretto, and creme de cacao. Cover and shake vigorously for about 2 minutes. Strain into the old fashioned glass. Spoon the dalgona whip on top.",
