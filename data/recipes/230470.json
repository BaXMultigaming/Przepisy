  "ingredients": [
    "1 Cornish game hens, halved lengthwise",
    "0.25 cup orange juice",
    "2 tablespoons honey",
    "2 tablespoons soy sauce",
    "1 tablespoon white vinegar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place game hen halves with skin sides up into a 9x13-inch roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast hens in the preheated oven for 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir orange juice, honey, soy sauce, and vinegar together in a small bowl; brush mixture over hens.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast hens for 5 more minutes and baste again with orange juice mixture. Roast until skin is browned and meat is no longer pink inside, about 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
