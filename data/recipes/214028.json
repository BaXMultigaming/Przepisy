  "title": "Italian Cheesecake II",
  "description": "This is a sweet, moist chocolate chip cheesecake with a hint of citrus and anise flavors. It is made with ricotta cheese instead of cream cheese.",
  "authors": [
    "Keri"
  ],
  "date_published": "2020-06-18T23:41:55-04:00",
