  "ingredients": [
    "2 pounds ground beef",
    "2 (10.75 ounce) cans condensed tomato soup",
    "2 medium onions, chopped",
    "5 large potatoes, cubed",
    "2 (15.25 ounce) cans kidney beans, undrained"
  ],
  "steps": [
    {
      "text": "Crumble the ground beef into a large skillet over medium-high heat. Cook and stir until browned. Drain grease, and transfer beef to a slow cooker. Mix in the tomato soups (undiluted), onions, potatoes, and beans.",
