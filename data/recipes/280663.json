  "ingredients": [
    "8 cups water",
    "0.33333334326744 cup white sugar",
    "3 family-size tea bags",
    "1 pound strawberries, sliced",
    "ice cubes"
  ],
  "steps": [
    {
      "text": "Combine water, sugar, and tea bags in a multi-functional pressure cooker (such as Instant Pot®). Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 4 minutes. Allow 25 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Remove tea bags using a slotted spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add strawberries to a blender and puree until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow tea to cool completely. Stir strawberry puree into the cooled tea and serve over ice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
