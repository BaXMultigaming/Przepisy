  "ingredients": [
    "0.75 cup golden syrup",
    "0.75 cup water",
    "0.75 cup butter",
    "0.5 cup brown sugar",
    "2 apples, peeled, or more to taste",
    "2.25 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "1.5 teaspoons ground ginger",
    "1.5 teaspoons ground allspice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a (9x5-inch) loaf pan (or 2 smaller pans) with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm syrup, water, ¾ cup butter, and sugar in a saucepan over low heat until butter and sugar are just melted; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, grate apples directly into the saucepan. Sift flour, baking soda, ginger, and allspice over apples; stir until batter is just combined. Do not overmix. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
