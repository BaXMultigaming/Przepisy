  "ingredients": [
    "1 head red leaf lettuce",
    "4 green onions (white part only)",
    "0.25 cup soy sauce",
    "5 tablespoons water",
    "2 teaspoons white sugar",
    "0.25 cup distilled white vinegar",
    "2 tablespoons sesame oil",
    "1 tablespoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Cut lettuce into bite-sized pieces and place into a salad bowl. Thinly slice green onion whites lengthwise into long strips; if they curl as you slice them, they are perfectly thin. Add green onions to the salad bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small mixing bowl, whisk soy sauce, water, sugar, vinegar, sesame oil, and red pepper flakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Just before serving, pour dressing over lettuce and green onions; toss until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
