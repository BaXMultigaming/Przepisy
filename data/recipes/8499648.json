  "ingredients": [
    "0.33 cup extra-virgin olive oil",
    "0.25 cup freshly squeezed orange juice",
    "1 teaspoon white wine vinegar",
    "salt and freshly ground black pepper to taste",
    "2 heads romaine lettuce, torn into bite-size pieces",
    "1 bunch arugula",
    "1 orange, peeled and segmented",
    "0.5 cup pitted kalamata olives",
    "0.5 small red onion, thinly sliced",
    "2 tablespoons toasted pine nuts"
  ],
  "steps": [
    {
      "text": "Whisk together olive oil, orange juice and vinegar in a small bowl. Season with salt and pepper and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut orange sections in half and add to a large bowl along with romaine lettuce, arugula, olives, and red onion. Toss until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle half the dressing over the salad and toss to combine. Garnish with pine nuts. Serve the remaining dressing on the side to be used at the table.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
