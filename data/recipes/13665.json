  "ingredients": [
    "1 cup persimmon pulp",
    "1 egg, beaten",
    "1.25 cups white sugar",
    "1 cup all-purpose flour",
    "1.25 cups milk",
    "0.25 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Butter one 9x13 inch baking pan. Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a blender, combine persimmon pulp, egg, sugar, flour, milk, baking soda, baking powder, cinnamon, salt and butter. Blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into baking pan and bake for 30 minutes or until a knife inserted in the center comes out with just crumbs but no batter stuck to it.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
