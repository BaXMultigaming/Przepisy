    "publisher-tested"
  ],
  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix (such as Betty Crocker®)",
    "1 cup water",
    "3 large eggs",
    "0.5 cup vegetable oil",
    "1 (16 ounce) container prepared chocolate frosting",
    "18 lollipop sticks",
    "1 (14 ounce) bag chocolate candy melts",
    "1 (.75 ounce) tube decorating icing",
    "1 tablespoon multicolored candy sprinkles, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cake mix, water, oil, and eggs in a bowl using an electric mixer on low speed for 30 seconds. Increase speed to medium and beat for 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rzX4mlj9359wbFRyKzL4xJeUxxw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244964-SimpleCakePops-mfs-step1-0193-00b7851abcba4075a98003bfd2407d26.jpg"
      ],
      "image": "assets/images/244964/step_02.webp"
    },
    {
      "text": "Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 28 to 33 minutes. Remove from the oven and cool completely, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hJPqUpb4z1ymVnGj5SmgpJfgXV4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244964-SimpleCakePops-mfs-step2-0195-7f9861eaf17c4807a2be31af344b3b33.jpg"
      ],
      "image": "assets/images/244964/step_04.webp"
    },
    {
      "text": "Crumble cooled cake into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QXPrWoxsvXcISylj1B6NU5NTqZw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244964-SimpleCakePops-mfs-step3-0197-7221a921e0f14d6eb895d9615e4539d9.jpg"
      ],
      "image": "assets/images/244964/step_05.webp"
    },
    {
      "text": "Stir frosting into the crumbled cake until mixture is sticky and starts to come together but is not too smooth. Refrigerate until chilled, for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kkiH7PHficsj5cRAMNXdnPeiWVE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244964-SimpleCakePops-mfs-step4-0198-5c326241aae746d19c38ba296da0c620.jpg"
      ],
      "image": "assets/images/244964/step_06.webp"
    },
    {
      "text": "Roll cake mixture into eighteen 1 1/2-inch balls and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/emqAt0Tme8yMHr9HVKUJzXxDwBA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244964-SimpleCakePops-mfs-step5-0210-fe8ed4543db34404949ff90908e6dc72.jpg"
      ],
      "image": "assets/images/244964/step_07.webp"
    },
    {
      "text": "Place about 1/4 cup candy melts in a microwave-safe bowl. Microwave on high until melted, about 20 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Push a lollipop stick halfway into each ball of cake mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qqMOOtNxVoD1dCY926qQM7jYuCE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244964-SimpleCakePops-mfs-step6-0218-a5b1b38b372f4283afb645fc75e8fc13.jpg"
      ],
      "image": "assets/images/244964/step_09.webp"
    },
    {
      "text": "Gently dip balls into the melted chocolate to coat, then place upright in a block of styrofoam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FJjO1QRQ8iksRt98T8Y0p_HGDbM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244964-SimpleCakePops-mfs-step7-0229-96beb0ae41ab4034b615d5d6b772e27a.jpg"
      ],
      "image": "assets/images/244964/step_10.webp"
    },
    {
      "text": "Decorate with candy sprinkles while chocolate coating is wet. Repeat to make remaining cake pops, melting more candy melts as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Hnqu5sFyDn0YIGABuXLzFQGkJEw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244964-SimpleCakePops-mfs-step8-0232-31ecc6f752fc41e39e12f42408056d08.jpg"
      ],
      "image": "assets/images/244964/step_11.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ce2tkd1gnhuxiuXtOoVUM1r6-EI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244964-simple-cake-pops-DDMFS-4x3-d9427cfc78cc4585b2eeaef4ba28f6ab.jpg"
      ],
      "image": "assets/images/244964/step_12.webp"
    }
  ],
