  "title": "Simple Cake Pops",
  "description": "These cake pops are easy to make with any flavor cake mix and frosting for perfect bite-sized sweet treats. Great for birthdays, baby showers, weddings, or any special occasion!",
  "authors": [
    "Miss Amy"
  ],
  "date_published": "2019-04-04T00:00:21-04:00",
  "date_modified": "2026-01-20T14:44:57-05:00",
  "prep_time": "PT30M",
  "cook_time": "PT30M",
  "total_time": "PT150M",
  "yield": [
    "18",
    "18 cake pops"
  ],
  "categories": [
    "Dessert"
  ],
