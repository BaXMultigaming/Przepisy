  "ingredients": [
    "1 cup milk",
    "1 cup yellow cornmeal",
    "1 cup all-purpose flour",
    "0.33333334326744 cup vegetable oil",
    "0.25 cup white sugar",
    "0.25 cup brown sugar",
    "3 tablespoons honey",
    "1 large egg",
    "3.5 teaspoons baking powder",
    "1 teaspoon salt",
    "0.5 cup unsalted butter, softened",
    "3 tablespoons ground cinnamon",
    "2 tablespoons honey"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk and cornmeal in a bowl; sit aside for 10 minutes, stirring halfway through. Add flour, oil, white sugar, brown sugar, 3 tablespoons honey, egg, baking powder, and salt; stir until well mixed. Pour batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, cinnamon, and 2 tablespoons honey in a bowl. Serve with muffins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
