  "ingredients": [
    "2 pounds ground beef",
    "2.5 cups crushed butter-flavored crackers",
    "0.75 cup ketchup",
    "1 small onion, chopped",
    "0.25 cup brown sugar",
    "2 eggs",
    "2 slices bacon",
    "2 tablespoons vinegar",
    "2 tablespoons prepared yellow mustard",
    "0.75 teaspoon salt, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, crushed crackers, 3/4 cup ketchup, onion, 1/4 cup brown sugar, and eggs until well blended. Press into a 9x5-inch loaf pan; lay bacon over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through, about 1 hour. While loaf bakes, whisk remaining 1 cup ketchup, remaining 1/2 cup brown sugar, vinegar, mustard, and salt together in a bowl; spread over top of meatloaf during last 15 minutes of baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
