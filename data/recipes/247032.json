  "ingredients": [
    "0.5 cup diced SPAM® with Bacon",
    "3 eggs",
    "2 teaspoons water",
    "2 large flour tortillas",
    "3 tablespoons your favorite salsa",
    "0.5 cup shredded Colby-Jack cheese"
  ],
  "steps": [
    {
      "text": "Heat a skillet over high heat; add SPAM with Bacon, reduce heat to medium and cook and stir until SPAM with Bacon starts to brown, 2 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While SPAM with Bacon is browning, crack eggs into a bowl, add water and whisk thoroughly with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low; pour eggs into skillet. Cook and stir lightly until eggs are set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove SPAM with Bacon mixture from skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn heat up to medium and place first tortilla into skillet. Top with SPAM with Bacon mixture, salsa, and Colby-Jack cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with remaining tortilla. Cook until bottom tortilla starts to brown; flip carefully. Continue cooking on the other side until the cheese melts and tortilla starts to brown, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
