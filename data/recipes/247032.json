  "title": "Breakfast SPAMadillas",
  "description": "A delicious breakfast quesadilla on flour tortillas featuring SPAM with bacon, eggs, Colby-Jack cheese, and salsa.",
  "authors": [
    "Allrecipes Member"
  ],
  "date_published": "2016-04-21T04:08:00-04:00",
