  "ingredients": [
    "ice",
    "8 tablespoons horchata",
    "1.5 fluid ounces silver tequila",
    "1 fluid ounce rum cream liqueur (such as RumChata®)",
    "0.25 fluid ounce agave nectar",
    "0.25 fluid ounce cinnamon whiskey (such as Fireball®)",
    "1 teaspoon sweetened condensed milk, or to taste",
    "1 dash ground cinnamon"
