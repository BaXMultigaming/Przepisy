  "ingredients": [
    "2 (12 ounce) packages extra firm tofu, drained and cubed",
    "1 cup white sugar",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "0.25 cup vegetable oil",
    "2 tablespoons lemon juice",
    "1 (9 inch) prepared graham cracker crust"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a blender or food processor, combine tofu, sugar, vanilla, salt, vegetable oil, and lemon juice. Blend until smooth. Pour into the pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until slightly brown, 20 to 30 minutes. Remove from the oven to cool. Refrigerate until chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
