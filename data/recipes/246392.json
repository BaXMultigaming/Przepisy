  "ingredients": [
    "1 small potato, peeled and cubed",
    "2 tablespoons olive oil",
    "0.5 cup sweet corn kernels",
    "2 tablespoons sofrito",
    "2 cloves garlic",
    "1 (8 ounce) can tomato sauce",
    "1 teaspoon dried oregano",
    "1 large bay leaf",
    "0.5 cup water",
    "1 (12 ounce) can corned beef",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZYS7dKiYruNlk8JoaPEaAbiVQOw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236392-PuertoRican-Canned-Corned-Beef-Stew-ddmfs-Step1-4x3-0741-08cb62829c034bde938a908e4f594b1a.jpg"
      ],
      "image": "assets/images/246392/step_01.webp"
    },
    {
      "text": "Bring a small pot of water to a boil. Add potato and cook, uncovered, until slightly tender, about 5 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lBH1amgBMgXgZ2d2UplRA3D3KRA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236392-PuertoRican-Canned-Corned-Beef-Stew-ddmfs-Step2-4x3-0743-960ab5b2b0b2413bb9a56e84e91463f9.jpg"
      ],
      "image": "assets/images/246392/step_02.webp"
    },
    {
      "text": "Heat oil in a large skillet or Dutch oven over medium-high heat. Add drained potatoes, corn, sofrito, and garlic; cook and stir until fragrant, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m_exhJ89B4wZodXSdurCyLqR56k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236392-PuertoRican-Canned-Corned-Beef-Stew-ddmfs-Step3-4x3-0748-15c0a64d5c4848bc883a65fb9be13987.jpg"
      ],
      "image": "assets/images/246392/step_03.webp"
    },
    {
      "text": "Add tomato sauce, oregano, and bay leaf; cook and stir until flavors combine, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2d45rKvu4QBKOPPWN5P4oAYWK-U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236392-PuertoRican-Canned-Corned-Beef-Stew-ddmfs-Step3-4x3-0749-b68371efd56045628bcaa0c058af35a7.jpg"
      ],
      "image": "assets/images/246392/step_04.webp"
    },
    {
      "text": "Add water and bring to a boil. Reduce the heat to medium-low and stir in corned beef; cook until heated through, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N09sq4kzmiXbLQ7s1JGhrq-W2Uo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236392-PuertoRican-Canned-Corned-Beef-Stew-ddmfs-Step3-4x3-0757-852233161c3e41c0aaa2bb0b9f3510c4.jpg"
