  "ingredients": [
    "0.75 cup creamy salad dressing (e.g. Miracle Whip)",
    "0.5 cup mayonnaise",
    "3.5 tablespoons sugar",
    "2 tablespoons prepared horseradish",
    "1.5 teaspoons white vinegar",
    "1.5 teaspoons dill weed",
    "1 (16 ounce) package coleslaw mix"
  ],
  "steps": [
    {
      "text": "Mix salad dressing, mayonnaise, sugar, horseradish, vinegar, and dill together in a large bowl. Stir in coleslaw mix until well coated. Cover and refrigerate until flavors have blended, at least 3 hours.",
