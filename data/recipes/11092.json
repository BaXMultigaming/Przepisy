  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix",
    "0.5 cup butter, melted",
    "1 large egg, beaten",
    "1 (8 ounce) package cream cheese, softened",
    "2 large eggs, beaten",
    "3.5 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 15x10-inch sheet pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the cake mix layer: Stir cake mix, melted butter, and egg in a bowl until well combined. Press mixture into the prepared sheet pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the cream cheese layer: Beat cream cheese and eggs in a bowl until combined. Gradually mix in confectioners' sugar. Pour mixture over the cake mix layer in the sheet pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Reduce the oven temperature to 300 degrees F (150 degrees C), and continue to bake until a toothpick inserted at the center of the pan comes out with just a few moist crumbs clinging to it, 30 to 35 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool completely before cutting into 24 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
