  "ingredients": [
    "1 pound medium shrimp, peeled (tails left on) and deveined",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon garlic powder",
    "1 cup all-purpose flour",
    "1 teaspoon paprika",
    "2 large eggs, beaten",
    "1 cup panko crumbs",
    "1 quart vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
