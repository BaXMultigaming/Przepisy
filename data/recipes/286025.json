  "ingredients": [
    "1 tablespoon olive oil",
    "1 small onion, diced",
    "1 pound ground venison",
    "2 cloves minced garlic",
    "2 tablespoons chili powder",
    "1 tablespoon cumin",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 tablespoons lime juice",
    "1 tablespoon apple cider vinegar",
    "0.33333334326744 cup water"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add onion and cook until softened, about 2 minutes. Add venison and cook until crumbly, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in garlic, chili powder, cumin, salt, and pepper. Cook for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Deglaze the pan with lime juice and apple cider vinegar. Add water and turn heat down to medium. Simmer mixture for 8 minutes or until desired texture is reached.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
