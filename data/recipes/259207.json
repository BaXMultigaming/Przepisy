  "ingredients": [
    "1 cup all-purpose flour",
    "2 tablespoons white sugar",
    "2 tablespoons baking powder",
    "0.5 teaspoon salt",
    "1.25 cups milk",
    "0.33333334326744 cup peanut butter",
    "1 egg",
    "1 tablespoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Sift flour, sugar, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, peanut butter, egg, and oil in a large bowl. Fold in the flour mixture gently until batter is evenly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle over medium heat. Drop batter by large spoonfuls onto the griddle and cook until bubbles form and the edges are dry, about 2 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter.",
