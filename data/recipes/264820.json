  "ingredients": [
    "1 (15 ounce) can chickpeas, rinsed and drained",
    "1 tablespoon nutritional yeast",
    "1 tablespoon olive oil",
    "1 teaspoon smoked paprika",
    "1 teaspoon granulated garlic",
    "0.5 teaspoon salt",
    "1 pinch cumin"
  ],
  "steps": [
    {
      "text": "Spread chickpeas on a double layer of paper towels, cover with another layer of paper towels, and let dry for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat air fryer to 355 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine dry chickpeas, nutritional yeast, olive oil, smoked paprika, garlic, salt, and cumin in a bowl; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chickpeas to the air fryer and cook until crispy, 20 to 22 minutes, shaking them every 4 minutes.",
      "section": null,
