  "ingredients": [
    "5 pounds small red potatoes",
    "0.5 cup olive oil, or more as needed",
    "8 large cloves garlic, minced",
    "1.5 teaspoons salt",
    "0.75 teaspoon ground black pepper",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Place potatoes into a very large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 40 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange potatoes close together in a 9x13-inch baking dish. Use a fork to press about 1 inch deep in the center of each potato until inner flesh is exposed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1/2 cup olive oil, garlic, and salt together in a small bowl to blend. Drizzle over potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, basting occasionally with the oil mixture, until potatoes are crisp and brown on top, about 1 hour 10 minutes. Add additional oil if potatoes seem dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with parsley and serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
