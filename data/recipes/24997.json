  "ingredients": [
    "3 tablespoons unsweetened cocoa",
    "3 tablespoons hot water",
    "1 cup white sugar",
    "6 tablespoons shortening, melted",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 cup sour milk",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan. In a small bowl, mix together the cocoa and hot water and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat together the sugar and shortening until smooth. Beat in the egg and stir in the vanilla. Sift together the flour, baking soda and salt. Beat in the flour mixture alternately with the sour milk. Stir in the cocoa and water mixture. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 35 to 40 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
