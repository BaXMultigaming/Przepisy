  "ingredients": [
    "1.5 pounds ground beef",
    "1 small onion, minced",
    "1 cup bread crumbs",
    "1 large egg, beaten",
    "1.5 tablespoons apricot preserves",
    "1 tablespoon kosher salt",
    "2 cloves garlic, minced",
    "1.5 teaspoons freshly ground black pepper",
    "1 cup ketchup",
    "0.5 cup apricot preserves",
    "0.25 cup brown sugar",
    "2 tablespoons hot sauce (such as Frank's Red Hot ®)",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon apple cider vinegar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, onion, bread crumbs, egg, 1 ½ tablespoons apricot preserves, kosher salt, garlic, and black pepper in a large bowl until thoroughly mixed. Transfer to a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine ketchup, ½ cup apricot preserves, brown sugar, hot sauce, Worcestershire sauce, and cider vinegar in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove meatloaf from the oven; pour glaze over top. Continue cooking until no longer pink in center, about 15 minutes more. An instant-read thermometer inserted into center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rest meatloaf before serving for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
