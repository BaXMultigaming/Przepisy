  "ingredients": [
    "4 large eggs",
    "4 small seedless cucumbers",
    "4 small dill pickles",
    "3 tablespoons mayonnaise"
  ],
  "steps": [
    {
      "text": "Place eggs in a saucepan and cover completely with cold water; bring to a boil. Cover, remove from the heat, and let stand for 10 to 12 minutes. Transfer eggs to a colander and run under cold water to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel and chop eggs. Chop cucumbers and pickles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, cucumbers, pickles, and mayonnaise in a bowl; mix until well blended. Cover and refrigerate until chilled, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
