  "ingredients": [
    "2 heads broccoli, separated into florets",
    "2 teaspoons extra-virgin olive oil",
    "1 teaspoon sea salt",
    "0.5 teaspoon ground black pepper",
    "1 clove garlic, minced",
    "0.5 teaspoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss broccoli florets with extra virgin olive oil, sea salt, pepper, and garlic in a large bowl. Spread the broccoli out in an even layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until florets are tender enough to pierce the stems with a fork, 15 to 20 minutes. Remove and transfer to a serving platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Squeeze lemon juice liberally over broccoli before serving for a refreshing, tangy finish.",
