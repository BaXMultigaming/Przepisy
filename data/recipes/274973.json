  "ingredients": [
    "3 stalks celery, cut into matchstick-size pieces",
    "2 large carrots, shredded",
    "0.33333334326744 cup buttermilk",
    "0.33333334326744 cup crumbled blue cheese",
    "2 teaspoons red wine vinegar",
    "1 teaspoon Worcestershire sauce",
    "0.5 teaspoon celery seed",
    "0.5 teaspoon salt",
    "3 pounds boneless skinless chicken thighs",
    "1 cup buffalo wing sauce, divided"
  ],
  "steps": [
    {
      "text": "Combine celery, carrots, buttermilk, blue cheese, vinegar, Worcestershire, celery seed, and salt in a bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken thighs into a bowl and coat with 3/4 cup wing sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill to medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill chicken on the preheated grill for 6 minutes. Flip, and grill for 6 more minutes. Brush thighs with remaining 1/4 cup wing sauce and grill until chicken is no longer pink at the bone and the juices run clear, about 2 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken to a plate and serve with blue cheese slaw.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
