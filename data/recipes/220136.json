  "title": "Brownie Cheesecake Hearts",
  "description": "Rich heart-shaped Valentine's Day chocolate brownies have a swirl of cheesecake filling and a topping of smooth chocolate frosting.",
  "authors": [
    "Larma"
  ],
  "date_published": "2020-06-18T23:47:28-04:00",
