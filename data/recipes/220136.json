  "ingredients": [
    "15 small heart-shaped baking molds",
    "2 teaspoons butter",
    "1 (19.8 ounce) package chocolate chunk brownie mix",
    "0.33333334326744 cup vegetable oil",
    "3 tablespoons water",
    "1 egg",
    "1 (8 ounce) package cream cheese, softened",
    "0.25 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 egg",
    "0.25 cup heavy cream",
    "0.75 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Butter the heart-shaped molds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brownie mix, vegetable oil, water, and 1 egg together in a bowl until smooth and well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the batter into the prepared heart molds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, sugar, and vanilla extract together with an electric mixer in a large bowl until light and fluffy. The mixture should be noticeably lighter in color. Beat in 1 egg until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon a dollop of the cream cheese mixture into each heart mold and mix slightly with a knife to make decorative swirls of cream cheese filling in the brownie batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While brownies are baking, place chocolate chips into a microwave-safe bowl and microwave for 30-second intervals, stirring after each time, until the chocolate is warm, smooth, and melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir heavy cream into the chocolate. Mixture will be clumpy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove hearts from oven, and immediately spread about 1 tablespoon of chocolate mixture over each heart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return the hearts to the oven and bake until the chocolate topping spreads out, about 5 minutes. Cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
