  "ingredients": [
    "0.33333334326744 cup olive oil",
    "0.25 cup tomato sauce",
    "3 cloves garlic, minced",
    "2 tablespoons red wine vinegar",
    "2 tablespoons chopped fresh basil",
    "0.5 teaspoon salt",
    "0.25 teaspoon cayenne pepper",
    "2 pounds fresh shrimp, peeled and deveined",
    "6 skewers"
  ],
  "steps": [
    {
      "text": "Stir olive oil, tomato sauce, garlic, and red wine vinegar together in a large bowl. Season with basil, salt, and cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WDeBiik5wTv0w2QKGGrLtOvKlw8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21694-marinated-grilled-shrimp-ddmfs-step1-0183-4x3-8bc416ccae7a4f199a785756d35c99ac.jpg"
      ],
      "image": "assets/images/21694/step_01.webp"
    },
    {
      "text": "Add shrimp to the bowl; stir until evenly coated. Cover and refrigerate for 30 minutes to 1 hour, stirring once or twice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GDW8Jp99u7KTb4wPZVKvJM2xLuY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21694-marinated-grilled-shrimp-ddmfs-step2-0185-4x3-709d56810dbe4c7ca0dd49ff2cd656b5.jpg"
      ],
      "image": "assets/images/21694/step_02.webp"
    },
    {
      "text": "Preheat the grill to medium heat. Lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thread shrimp onto skewers, piercing once near the tail and once near the head. Discard marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A3y2G0duPMwH4nJDrs9iBXJLulo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21694-marinated-grilled-shrimp-ddmfs-step3-0187-4x3-892895c37da24a6da55bb695a1b6461a.jpg"
      ],
      "image": "assets/images/21694/step_04.webp"
    },
    {
      "text": "Cook shrimp on the preheated grill until opaque, 2 to 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SaymkVMhfKoqVLPNKDK4oUMJSBY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21694-marinated-grilled-shrimp-ddmfs-step4-0188-4x3-a8e48120869c4eb9a8ab0e42fafb3f10.jpg"
      ],
      "image": "assets/images/21694/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
