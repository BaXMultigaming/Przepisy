  "ingredients": [
    "1 cup butter",
    "0.25 cup white sugar",
    "2 cups all-purpose flour",
    "1.5 cups shredded coconut",
    "1 (14 ounce) can sweetened condensed milk",
    "0.33333334326744 cup chopped red maraschino cherries",
    "0.33333334326744 cup chopped green maraschino cherries",
    "0.33333334326744 cup chopped walnuts",
    "0.25 cup golden raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar in a large bowl with an electric mixer. Blend in flour until mixture resembles coarse crumbs. Pat dough evenly into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine shredded coconut, condensed milk, red and green maraschino cherries, walnuts, and raisins in a bowl; spread evenly on top of cooked shortbread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until golden brown, about 35 minutes more. Let cool completely before slicing into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
