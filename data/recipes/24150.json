  "ingredients": [
    "1 pound ground pork sausage",
    "1 pound bacon",
    "4 cups milk",
    "8 eggs",
    "12 slices white bread, crusts trimmed",
    "2 tablespoons butter, softened",
    "3 small onion, chopped",
    "6 slices processed American cheese, shredded"
  ],
  "steps": [
    {
      "text": "Place sausage and bacon in two large, deep skillets. Cook over medium-high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Butter one side of six slices of the bread. Placed slices butter side up in the bottom of a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together cooked sausage and bacon with onion and cheese. Place half of his mixture on top of buttered bread. Then add another six slices of bread (no butter). Add remaining meat/cheese mixture. Beat together milk and eggs; pour over top of casserole. Cover with foil and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "The next morning: preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, covered, in preheated oven for 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
