  "ingredients": [
    "1.5 cups shortening",
    "2 cups white sugar",
    "0.5 cup molasses",
    "2 eggs",
    "4 cups all-purpose flour",
    "4 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "1 teaspoon ground cloves",
    "1 teaspoon ground ginger",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Melt the shortening in a large pan on the stove, and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sugar, eggs, and molasses, beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, sift dry ingredients together and add to the pan. Mix well and chill 3 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form into walnut-size balls. Roll in granulated sugar. Place on greased cookie sheet about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 8-10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Store in an airtight container to keep from getting overly crisp. If they do lose their softness, an easy way to restore it is to place one slice of fresh bread in the container with the cookies for a couple of hours or overnight and they will be soft again!",
      "section": null,
      "name": null,
