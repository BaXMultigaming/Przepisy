  "ingredients": [
    "10 cups water",
    "2 tablespoons salt",
    "1 tablespoon white sugar",
    "2.25 pounds turnip greens, chopped",
    "0.5 onion, chopped",
    "1 clove garlic, pressed, or more to taste",
    "0.25 cup hot sauce"
  ],
  "steps": [
    {
      "text": "Combine water, salt, and sugar in a stockpot; bring to a boil. Add turnip greens, onion, and garlic to the boiling water; cook, stirring occasionally, for 5 minutes. Stir hot sauce into the mixture and cook until greens are tender, about 20 minutes more.",
