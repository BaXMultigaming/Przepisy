  "ingredients": [
    "1 cup white sugar",
    "0.33333334326744 cup butter",
    "4 eggs, beaten",
    "2 cups mashed sweet potatoes",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 cup milk",
    "0.5 cup orange juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
