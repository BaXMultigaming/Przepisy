  "ingredients": [
    "2 (8 ounce) shark steaks",
    "2 cups milk",
    "1 tablespoon lemon juice",
    "sea salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place shark steaks in a shallow dish; add milk to cover. Set aside for 2 hours, or refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove steaks from milk; pat dry. Discard milk. Season steaks with lemon juice, sea salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until meat is firm, about 15 minutes, flipping once. Steaks should appear white all the way through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
