  "ingredients": [
    "1 onion, sliced",
    "3 pounds pork tenderloin",
    "3 tablespoons minced garlic",
    "0.5 cup orange juice",
    "3 tablespoons red wine vinegar",
    "1 lemon, juiced",
    "1 tablespoon ground cumin",
    "1 tablespoon grill seasoning (such as Montreal Steak Seasoning®)",
    "1 teaspoon salt",
    "1 teaspoon ground red pepper",
    "3 bay leaves",
    "2 tablespoons grated lemon peel"
  ],
  "steps": [
    {
      "text": "Arrange onion slices in the bottom of a slow cooker; top with pork tenderloin. Sprinkle garlic evenly over onion and pork. Pour orange juice, vinegar, and lemon juice over pork. Sprinkle cumin, grill seasoning, salt, red pepper, bay leaves, and lemon zest over pork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until pork is very tender, 6 to 7 hours. To serve, slice tenderloin into 1 1/2-inch slices, arrange on a platter, and drizzle juices over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
