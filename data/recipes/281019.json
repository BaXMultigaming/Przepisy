  "ingredients": [
    "1 nonstick cooking spray",
    "1 pound lean ground beef",
    "1 small onion, chopped",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1.3333333730698 cups chicken broth",
    "2 cups chopped celery",
    "2 cups water",
    "0.5 cup uncooked white rice",
    "2 teaspoons Worcestershire sauce",
    "2 teaspoons soy sauce",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 10x14-inch baking pan or large casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir ground beef and onion in a hot skillet until beef is browned and crumbly, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cream of chicken soup into the skillet. Fill the empty can with chicken broth and pour into the skillet. Add celery, water, rice, Worcestershire, soy sauce, and salt. Mix well. Transfer mixture to the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and rice is cooked through, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
