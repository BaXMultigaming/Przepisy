  "ingredients": [
    "1 cup white sugar",
    "2 tablespoons mustard powder",
    "1 tablespoon kosher salt",
    "1 pinch red pepper flakes",
    "0.25 teaspoon ground black pepper",
    "0.25 cup white vinegar",
    "0.5 cup water",
    "1 tablespoon pureed garlic",
    "2 cups corn oil"
  ],
  "steps": [
    {
      "text": "In the container of a blender or food processor, combine the sugar, mustard powder, salt, red pepper flakes, black pepper, vinegar, water and garlic. Cover and blend while drizzling in the corn oil to form an emulsion.",
