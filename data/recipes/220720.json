  "ingredients": [
    "3 cups water",
    "2 tablespoons butter",
    "1 (12 ounce) package bacon, chopped",
    "1 head cabbage, cored and chopped",
    "1 (8 ounce) package egg noodles",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place water and butter in a large, deep skillet and bring to a boil; stir in bacon and return to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cabbage into the bacon mixture; simmer until the thickest pieces of cabbage are fork-tender and the liquid has almost evaporated, about 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in egg noodles and return to a boil. Cook noodles uncovered, stirring occasionally, until tender but still slightly firm, about 5 minutes. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly toss egg noodles with bacon and cabbage; season to taste with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
