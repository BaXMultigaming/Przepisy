  "ingredients": [
    "1.5 cups whole wheat flour",
    "0.5 cup white sugar",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup vegetable oil",
    "1 (4 ounce) container applesauce",
    "1 tablespoon vanilla-flavored almond milk",
    "1 tablespoon vanilla extract",
    "0.5 cup cinnamon-sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat vegetable oil, applesauce, almond milk, and vanilla extract together in a separate large bowl; add flour mixture and stir until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 14 portions and roll into balls. Spread cinnamon-sugar into a wide, shallow bowl. Roll dough balls in the cinnamon-sugar and arrange onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
