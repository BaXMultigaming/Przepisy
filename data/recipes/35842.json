  "ingredients": [
    "cooking spray",
    "3.75 cups white sugar",
    "1.5 cups light corn syrup",
    "1 cup water",
    "1 tablespoon orange, or other flavored extract",
    "0.5 teaspoon food coloring",
    "0.25 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Grease a cookie sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir white sugar, corn syrup, and water together in a medium heavy-bottomed saucepan. Cook, stirring, over medium heat until sugar dissolves, then bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PSVIj1T8ebpdn3x2PJjAWSPgl38=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35842-hard-candy-ddmfs-step3-0844-38129d929d4340f387823f11ad3fecb3.jpg"
      ],
      "image": "assets/images/35842/step_02.webp"
    },
    {
      "text": "Without stirring, heat to 300 to 310 degrees F (149 to 154 degrees C), or until a small amount of syrup dropped into cold water forms hard, brittle threads.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V206cG97rMQVb3RqmMN4j_4r24g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35842-hard-candy-ddmfs-step4-186-12c87e96b4174cd0a2c34805601b614c.jpg"
      ],
      "image": "assets/images/35842/step_03.webp"
    },
    {
      "text": "Remove from the heat and stir in flavored extract and food coloring. Pour onto the prepared cookie sheet. Dust top with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7vQ_dzJhw8nxyUv3ukKXsMxXn8U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35842-hard-candy-ddmfs-step5-191-c86651d492fd44c880b7fea08133ae62.jpg"
      ],
      "image": "assets/images/35842/step_04.webp"
    },
    {
      "text": "Let cool until hardened, about 15 minutes. Break into about 36 pieces and store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZnM98ya7uOFdab71l_e-BKnTkG0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35842-hard-candy-DDMFS-4x3-3b26ecd8219843a4b06729d51fc8e53f.jpg"
      ],
      "image": "assets/images/35842/step_05.webp"
    }
  ],
