  "ingredients": [
    "1 pound carrots, coarsely chopped",
    "0.5 cup margarine",
    "1 teaspoon vanilla extract",
    "3 large eggs",
    "3 tablespoons all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.75 cup white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of salted water to a boil. Add carrots and cook until tender, 15 to 20 minutes. Drain and mash. Stir in butter, vanilla extract, and eggs; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, salt, and sugar together. Stir into carrot mixture and blend until smooth. Transfer to the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
