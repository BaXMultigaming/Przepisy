  "ingredients": [
    "0.33333334326744 cup vegetable oil",
    "2 teaspoons chili powder",
    "1 teaspoon dried oregano",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 pinch ground cayenne pepper",
    "1.5 pounds chicken tenders, quartered",
    "4 cups sliced bell peppers, any color",
    "1 onion, sliced",
    "0.25 cup chopped fresh cilantro",
    "0.5 lime, juiced"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D3nDJ5xQgzg7qrD0hJKXQSGKIrM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255038_SheetPanChickenFajitas_ddmfs_step1_4x3_1271-904cb02184e246cbb7fdc2bbbaa2f0f5.jpg"
      ],
      "image": "assets/images/255038/step_01.webp"
    },
    {
      "text": "Combine oil, chili powder, oregano, garlic powder, onion powder, cumin, salt, black pepper, and cayenne pepper in a large resealable plastic bag. Add chicken tenders, bell peppers, and onion; seal the bag and shake to mix. Marinate in the refrigerator, 30 minutes to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9e6ThO8rCWy8OFNQLMn2S5gUDJc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255038_SheetPanChickenFajitas_ddmfs_step3_4x3_1276-f01ca631451e457a969b79877f1ccac7.jpg"
      ],
      "image": "assets/images/255038/step_02.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a rimmed sheet pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread chicken mixture onto the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KM90GF9LzYTB0yquWhR5XPD8j8w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255038_SheetPanChickenFajitas_ddmfs_step3_4x3_1278-9555445c14424bb58ca3a492a81c4cea.jpg"
      ],
      "image": "assets/images/255038/step_04.webp"
    },
    {
      "text": "Roast in the preheated oven, stirring halfway, until chicken is no longer pink and bell peppers are softened, 15 to 20 minutes. An instant-read thermometer inserted into the center of chicken should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cXxbyGOPGi78v8us95Gtycf_Mew=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255038_SheetPanChickenFajitas_ddmfs_step4_4x3_1280-15b2e2706da94e9c819632330446507c.jpg"
      ],
      "image": "assets/images/255038/step_05.webp"
    },
    {
      "text": "Sprinkle cilantro and pour lime juice over chicken mixture; stir to distribute. Serve hot with warm tortillas and your favorite fajita toppings.",
      "section": null,
      "name": null,
      "url": null,
