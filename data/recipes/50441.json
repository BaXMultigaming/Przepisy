  "ingredients": [
    "0.75 cup SPLENDA® Granular",
    "1 cup rolled oats",
    "1 cup whole wheat flour",
    "0.5 cup soy flour",
    "1.75 teaspoons baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "2 teaspoons ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.5 cup pumpkin puree",
    "1 tablespoon canola oil",
    "2 teaspoons water",
    "2 egg whites",
    "1 teaspoon molasses",
    "1 tablespoon flax seeds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk together Splenda®, oats, wheat flour, soy flour, baking soda, baking powder, salt, cinnamon, and nutmeg. Stir in pumpkin, canola oil, water, egg whites, and molasses. Stir in flax seeds, if desired. Roll into 14 large balls, and flatten on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 5 minutes in preheated oven. DO NOT OVERBAKE: the cookies will come out really dry if overbaked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
