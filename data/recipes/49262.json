  "ingredients": [
    "1 large head cauliflower",
    "0.5 cup seasoned bread crumbs",
    "2 tablespoons grated Parmesan cheese",
    "0.25 cup margarine, melted",
    "0.125 teaspoon garlic powder",
    "0.125 teaspoon salt",
    "1 pinch red pepper flakes",
    "1 pinch dried oregano"
