  "steps": [
    {
      "text": "Clean cauliflower, and trim off leaves and any brown spots. Place the whole head of cauliflower into a steamer basket, place the basket in a large pot, and add one inch of water. Cover, and bring to a boil over medium heat. Cook for about 20 minutes or until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). In a medium bowl, mix together the bread crumbs, Parmesan cheese, melted margarine. Season with garlic powder, salt, red pepper flakes, and oregano, and mix well. Place the head of cauliflower into a baking dish, and coat with the breadcrumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for about 10 to 15 minutes in the preheated oven, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
