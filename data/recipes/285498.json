  "ingredients": [
    "1 (8 ounce) tub whipped cream cheese",
    "9 thick slices bread",
    "8 large eggs",
    "2 cups milk",
    "0.5 cup pure maple syrup",
    "1 teaspoon vanilla extract",
    "1 pinch ground cinnamon",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cream cheese in a thick layer onto bread slices, then cut bread into cubes. Layer bread cubes in the bottom of a 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together eggs, milk, maple syrup, vanilla, cinnamon, and nutmeg in a large bowl until well combined. Pour over bread cubes and pat gently until bread is evenly soaked. Let sit for 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until eggs are cooked and fluffy, 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
