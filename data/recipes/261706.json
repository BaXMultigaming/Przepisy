  "title": "Vegan Blueberry Muffins",
  "description": "These juicy vegan blueberry muffins are made with applesauce, vanilla soy yogurt, and oil instead of butter and egg. They taste best fresh.",
  "authors": [
    "Christine"
  ],
  "date_published": "2020-06-19T00:25:57-04:00",
