  "ingredients": [
    "3 tablespoons butter, divided",
    "1 small onion, finely chopped",
    "5 tablespoons unbleached all-purpose flour",
    "2.5 cups water",
    "2 teaspoons beef bouillon",
    "2 teaspoons chicken bouillon",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt 1 1/2 tablespoons butter in a skillet over medium heat. Add onion; cook and stir until translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qVjkjNju9qfPotrSazVCRVOrNCs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246008-kfc-copycat-gravy-VAT-step-1-4x3-97487b6a0ced4c93beb84593fb69e704.jpg"
      ],
      "image": "assets/images/246008/step_01.webp"
    },
    {
      "text": "Add remaining 1 1/2 tablespoons butter and let melt. Whisk in flour to form a thick paste the consistency of cake frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9mkdAZS80IoZnb5KQP_Le0-QI4c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246008-kfc-copycat-gravy-VAT-step-2-4x3-f098cc73c19b4e3fa0efced289961c89.jpg"
      ],
      "image": "assets/images/246008/step_02.webp"
    },
    {
      "text": "Continue cooking, whisking constantly, until flour has turned golden and begins to smell like toast, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7_q8l81WnJ0O_1WBgt_NXSJw6iA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246008-kfc-copycat-gravy-VAT-step-2b-4x3-8f7a7fd20bef47639ef2285870ee625e.jpg"
      ],
      "image": "assets/images/246008/step_03.webp"
    },
    {
      "text": "Whisk in water and both bouillons until no lumps remain. Stir in pepper and bring mixture to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VF4grJxEs4Px2_Lca9--NGX1qKY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246008-kfc-copycat-gravy-VAT-step-4-4x3-3f43fbd689d043a7bd08b11f0045fa31.jpg"
      ],
      "image": "assets/images/246008/step_04.webp"
    },
    {
      "text": "Cook and stir until thickened to gravy consistency, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v257HHuQGk__QNqlgiKwfq7NOy8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246008-kfc-copycat-gravy-VAT-step-3-4x3-54d5f5a80b4b45b3a0a90a3216bc8c2c.jpg"
      ],
      "image": "assets/images/246008/step_05.webp"
    }
