  "ingredients": [
    "2 cups all-purpose flour",
    "0.66666668653488 cup confectioners' sugar",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "1 pinch nutmeg",
    "0.5 cup butter, softened",
    "1 egg",
    "1 cup Mott's® Original or Cinnamon Applesauce",
    "1 teaspoon vanilla extract",
    "0.5 cup chopped dried apples",
    "1 cup caramel bits*",
    "1 cup chopped walnuts",
    "0.25 cup granulated sugar",
    "0.5 teaspoon ground cinnamon",
    "0.125 teaspoon coarse sea salt, or to taste**"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 9-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, confectioners' sugar, baking powder, salt, cinnamon and nutmeg in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter in separate large bowl. Beat in egg, applesauce, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix dry ingredients into wet ingredients. Stir to combine. Add diced apples, caramel bits and walnuts; blend in thoroughly. Pour into greased pan and distribute evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine granulated sugar, cinnamon and sea salt for the topping. Sprinkle evenly on top of the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until toothpick inserted in center comes out clean, 30-35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool completely and cut into 16 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
