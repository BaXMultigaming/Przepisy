  "ingredients": [
    "0.75 cup all-purpose flour",
    "0.25 cup powdered peanut butter (such as PB2®)",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup peanut butter",
    "0.33333334326744 cup butter",
    "0.5 cup white sugar",
    "0.25 cup brown sugar",
    "2 eggs",
    "0.5 teaspoon vanilla extract",
    "0.5 cup dark chocolate chips, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, powdered peanut butter, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat peanut butter and butter together in a bowl until creamy. Gradually add white sugar and brown sugar; beat until fluffy. Add eggs and vanilla extract; beat until smooth. Stir in flour mixture and chocolate chips until incorporated. Spread batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
