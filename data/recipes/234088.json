  "ingredients": [
    "1 gallon apple cider",
    "1 gallon apple juice",
    "2 cups white sugar",
    "6 large glass bottles",
    "6 cinnamon sticks",
    "1 (1 liter) bottle 190 proof grain alcohol (such as Everclear®)"
  ],
  "steps": [
    {
      "text": "Bring apple cider, apple juice, and sugar to a boil in a large pot over medium heat until sugar is dissolved, about 10 minutes. Divide juice mixture evenly into the bottles. Add a cinnamon stick to each bottle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide alcohol into the bottles and allow mixture to cool; seal and store in a cool dry place.",
