  "ingredients": [
    "1.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup brown sugar",
    "0.33300000429153 cup peanut butter",
    "1 egg, beaten",
    "0.5 teaspoon vanilla extract",
    "1 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8x4-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, and salt into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and peanut butter in a large bowl until creamy. Beat in egg and vanilla until smooth. Mix in flour mixture alternately with buttermilk, beating until smooth after each addition. Spoon batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until nicely browned and a toothpick inserted into the center comes out clean, about 1 hour. Remove from the pan to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
