  "ingredients": [
    "1 tablespoon vegetable oil",
    "2 cups grated zucchini",
    "1 medium onion, minced",
    "5 cups cornbread crumbs",
    "2 cups sourdough bread crumbs",
    "1 cup Swanson® Chicken Broth",
    "0.5 cup sour cream",
    "0.5 cup butter, melted",
    "2 eggs",
    "1 teaspoon dried sage",
    "0.5 teaspoon poultry seasoning",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly oil a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 tablespoon oil in skillet over medium heat. Add zucchini and onion; sauté until zucchini is slightly softened, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornbread crumbs, bread crumbs, chicken broth, sour cream, and butter in a large bowl; stir in zucchini mixture, eggs, sage, poultry seasoning, salt, and black pepper until evenly moistened. Transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
