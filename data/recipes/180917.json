  "ingredients": [
    "12 large eggs, separated, divided",
    "0.5 teaspoon salt",
    "3 pounds confectioners' sugar",
    "1 pound butter, room temperature",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground cloves",
    "1 teaspoon ground allspice"
  ],
  "steps": [
