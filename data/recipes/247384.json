  "ingredients": [
    "4 cups milk",
    "3 cups white sugar",
    "1.5 cups cornmeal",
    "3 eggs",
    "2 tablespoons unsalted butter",
    "2 tablespoons all-purpose flour",
    "1 tablespoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, sugar, cornmeal, eggs, butter, all-purpose flour, and baking powder in a blender; mix until very smooth, about 5 minutes. Pour into the prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the cake comes out clean, about 45 minutes. Let cool before cutting and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
