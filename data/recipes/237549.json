  "ingredients": [
    "0.5 pound green peas",
    "0.5 cup all-purpose flour, or as needed",
    "0.33333334326744 cup freshly grated Parmesan cheese",
    "1 large egg",
    "1 tablespoon milk, or as needed",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt, or to taste",
    "0.5 teaspoon ground black pepper, or to taste",
    "1 tablespoon olive oil, or as needed"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook peas in boiling water, stirring occasionally, until tender, about 5 minutes. Drain and transfer to a bowl; mash peas using a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, Parmesan cheese, egg, milk, baking powder, salt, and pepper into mashed peas, adding more milk or flour until mixture holds together. Shape pea mixture into 1/2-inch-thick patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry patties in hot oil until golden, 3 to 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
