  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "4 eggs",
    "1 cup pumpkin",
    "0.75 cup white sugar",
    "0.5 cup vegetable oil",
    "0.25 cup water",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix yellow cake mix, pumpkin, eggs, sugar, vegetable oil, water, and cinnamon together in a large bowl; beat until well blended. Transfer to the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
