  "ingredients": [
    "1.5 pounds ground beef",
    "0.25 cup chopped onion",
    "0.25 cup quick-cooking oats",
    "0.125 cup cornmeal",
    "1 cup dried bread crumbs",
    "1.5 teaspoons salt",
    "1 tablespoon white sugar",
    "1 egg, beaten",
    "0.5 cup tomato juice",
    "0.5 cup water",
    "1 tablespoon barbecue sauce",
    "1 dash liquid smoke flavoring",
    "1 tablespoon distilled white vinegar",
    "0.25 cup ketchup",
    "1 tablespoon brown sugar",
    "2 teaspoons prepared mustard",
    "2 dashes liquid smoke flavoring"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the beef, onion, oatmeal, cornmeal, bread crumbs, salt, sugar, egg, tomato juice, water, barbecue sauce, 1/8 teaspoon liquid smoke and vinegar. Mix together thoroughly and place mixture into a lightly greased 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate small bowl, combine the ketchup, brown sugar, mustard and 2 drops liquid smoke and mix thoroughly. Spread over the top of the meatloaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for approximately one hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
