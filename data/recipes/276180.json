  "ingredients": [
    "1 cup brown sugar",
    "0.5 cup white sugar",
    "0.5 cup butter",
    "2 egg whites",
    "0.5 teaspoon vanilla extract",
    "1 teaspoon white vinegar",
    "1.75 cups all-purpose flour",
    "0.5 teaspoon fine sea salt",
    "0.5 teaspoon baking soda",
    "0.75 cup mini chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease cookie sheets or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, white sugar, butter, egg whites, and vanilla extract together in a large bowl using an electric mixer. Mix in vinegar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sea salt, and baking soda in a separate bowl. Mix into butter mixture until just combined. Fold in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1-inch balls. Place onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until just barely browned on the edges, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
