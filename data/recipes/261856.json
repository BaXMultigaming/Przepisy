  "title": "Decadent Chocolate Chip Bar Cookies",
  "description": "Chocolate chip bar cookies are a quicker and easier alternative to regular cookies, painted with a decadent extra layer of melted chocolate.",
  "authors": [
    "Linda"
  ],
  "date_published": "2020-06-19T00:26:08-04:00",
