  "title": "Roast Duck with Apple Dressing",
  "description": "When you're in the mood for something rich and flavorful, try this wild duck rubbed with light seasoning and stuffed with apples, celery and onion.",
  "authors": [
    "Debbie"
  ],
  "date_published": "2000-04-06T00:56:14-04:00",
