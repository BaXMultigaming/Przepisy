  "ingredients": [
    "1 (4 pound) whole duck",
    "salt and pepper to taste",
    "1 teaspoon poultry seasoning",
    "0.5 tablespoon butter",
    "3 tablespoons chopped onion",
    "5 stalks celery, chopped",
    "3 cups peeled, cored and chopped apple",
    "3 cups cornbread crumbs",
    "1 tablespoon olive oil"
  ],
  "steps": [
    {
      "text": "Rinse duck and pat dry; rub with salt, pepper, and poultry seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small skillet over medium heat. Saute onion and celery in butter until tender. In a medium bowl, combine with apple and cornbread crumbs. Mix together to make dressing (if necessary, add a little water to moisten).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill the duck's cavity with dressing, and sew shut with kitchen twine. Rub outside of bird lightly with olive oil, and place in a shallow roasting pan or 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 60 to 80 minutes, or until internal temperature reaches 180 degrees F (80 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
