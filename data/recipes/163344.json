  "ingredients": [
    "6 cups water",
    "0.25 cup brown sugar",
    "1 (3 inch) cinnamon stick",
    "1 whole clove",
    "0.5 cup ground coffee beans",
    "0.5 teaspoon vanilla",
    "0.25 cup chocolate syrup",
    "1 cup whipped cream"
  ],
  "steps": [
    {
      "text": "Bring the water, sugar, cinnamon, and clove to a boil in a large saucepan over high heat. Stir until the sugar has dissolved, then remove from the heat, stir in the coffee grounds, cover, and steep for 5 minutes. Stir in the vanilla and chocolate syrup, then strain through several layers of cheesecloth to remove the coffee grounds and spices. Serve with a dollop of whipped cream.",
