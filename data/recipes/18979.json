  "title": "Syrup Sponge Pudding",
  "description": "This is an old family recipe that originates from Yorkshire England. A simple, sweet, spongy steamed pudding.",
  "authors": [
    "Tricia Scoffield"
  ],
  "date_published": "2000-05-31T21:47:02-04:00",
