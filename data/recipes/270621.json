  "ingredients": [
    "1 pound fresh rhubarb, trimmed and cut into 1-inch pieces",
    "0.5 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.125 teaspoon ground cloves",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place rhubarb in a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, cinnamon, cloves, and salt in a small bowl; sprinkle evenly over rhubarb. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until rhubarb is soft, 30 to 45 minutes. Stir sauce vigorously to break down rhubarb; serve sauce warm, chilled, or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
