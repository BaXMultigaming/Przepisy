  "ingredients": [
    "0.75 cup ketchup",
    "0.5 cup finely chopped onion",
    "2 tablespoons brown sugar",
    "2 tablespoons minced garlic, or to taste",
    "2 tablespoons vegetable oil",
    "2 tablespoons white vinegar",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon liquid smoke",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper",
    "12 (4 ounce) bone-in chicken drumsticks, with skin"
  ],
  "steps": [
    {
      "text": "Mix ketchup, onion, brown sugar, garlic, vegetable oil, Worcestershire sauce, liquid smoke, salt, and pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken drumsticks in a slow cooker and drizzle sauce over top. Cook on High for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When the 3 hours are almost up, preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken and sauce to a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven until no longer pink at the bone, the juices run clear, and the skin is browned, about 30 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
