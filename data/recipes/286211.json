  "ingredients": [
    "2 cups all-purpose flour",
    "0.33333334326744 cup white sugar",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "0.5 cup unsalted butter, chilled",
    "0.5 cup sour cream",
    "1 large egg",
    "1 tablespoon lime zest",
    "3 ounces dried blueberries",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, 1/3 cup sugar, baking powder, salt, and baking soda together in a large bowl. Grate butter into flour mixture; toss and mix until mixture looks like coarse meal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sour cream, egg, and lime zest together in a small bowl; add to flour mixture along with blueberries. Mix with a fork to form a dough. Turn dough out onto the prepared baking sheet. Pat into a 7-inch round. Cut into 8 wedge-shaped pieces and separate scones. Sprinkle with 1 tablespoon sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden brown, about 18 minutes. Cool 5 to 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
