  "ingredients": [
    "2 cups almond flour",
    "1 tablespoon baking powder",
    "2.5 cups shredded Cheddar cheese",
    "4 eggs",
    "0.25 cup half-and-half"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
