  "ingredients": [
    "5 anchovy fillets",
    "8 cloves garlic",
    "1 tablespoon fresh lime juice",
    "1 tablespoon mayonnaise",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon Dijon mustard",
    "1 teaspoon freshly ground black pepper",
    "1 teaspoon pureed chipotle peppers",
    "1 teaspoon capers",
    "2 drops hot pepper sauce, or to taste",
    "1 cup olive oil",
    "2 tablespoons red wine vinegar",
    "2 tablespoons water, as needed"
  ],
  "steps": [
    {
      "text": "Blend anchovy fillets, garlic, lime juice, mayonnaise, Worcestershire sauce, Dijon mustard, black pepper, chipotle pepper, capers, and hot pepper sauce in a blender until smooth. Stream oil into the anchovy mixture while continuing to blend until the oil is fully emulsified into the mixture; repeat with the vinegar. Thin dressing with water if too thick.",
