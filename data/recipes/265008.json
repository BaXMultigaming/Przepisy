  "title": "Viennese Chocolate-Nut Cake",
  "description": "This classic chocolate-nut cake recipe is from Vienna, Austria. It can be made with walnuts or hazelnuts and it doesn't use any baking powder.",
  "authors": [
    "christlk"
  ],
  "date_published": "2020-06-19T00:29:17-04:00",
