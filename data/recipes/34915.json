  "ingredients": [
    "2 pounds carrots, sliced",
    "1 small onion, thinly sliced",
    "1 small green bell pepper, cut into thin strips",
    "0.5 cup vegetable oil",
    "0.5 cup white sugar",
    "0.25 cup distilled white vinegar",
    "2 teaspoons almond extract",
    "1 teaspoon dried basil"
  ],
  "steps": [
    {
      "text": "In a medium saucepan with enough water to cover, boil carrots until tender but crisp. Remove from heat, drain, and place in a medium bowl with onion and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan over medium heat, blend oil, sugar, vinegar, almond extract and basil. Cook and stir until sugar is dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the oil mixture over the carrot mixture. Cover, and chill in the refrigerator 8 hours or overnight before serving cold.",
      "section": null,
