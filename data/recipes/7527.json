  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "1 (5.9 ounce) package instant chocolate pudding mix",
    "4 eggs, beaten",
    "0.66666668653488 cup vegetable oil",
    "0.66666668653488 cup white sugar",
    "0.33333334326744 cup water",
    "1 (8 ounce) container sour cream",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix yellow cake mix, pudding mix, eggs, vegetable oil, sugar, and water. Gently fold in sour cream and chocolate chips. Pour batter into the prepared Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 55 minutes. Cool in pan for 10 minutes before transferring to cooling racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
