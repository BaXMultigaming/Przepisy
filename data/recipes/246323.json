  "ingredients": [
    "1.75 cups all-purpose flour",
    "0.5 cup cornmeal",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon white sugar",
    "0.5 teaspoon salt",
    "0.5 cup cold butter",
    "1.5 tablespoons fresh thyme leaves",
    "1 tablespoon chopped fresh rosemary",
    "0.5 teaspoon garlic powder",
    "0.5 cup water",
    "2 tablespoons white vinegar",
    "0.25 cup grated Parmesan cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Combine flour, cornmeal, baking soda, sugar, and salt together in a large bowl. Cut in butter with a fork or pastry blender until mixture looks crumbly. Stir in thyme, rosemary, and garlic powder. Sprinkle in water and vinegar; toss with a fork until a ball of dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap dough tightly in plastic wrap. Freeze until firm, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover a large cutting board with aluminum foil. Turn dough out onto aluminum foil, cover with plastic wrap, and roll out into a thin rectangle. Cut into smaller rectangles; transfer to baking sheets. Sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and crispy, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
