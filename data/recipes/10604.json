  "ingredients": [
    "1 cup butter, softened",
    "1 cup packed brown sugar",
    "0.5 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.33333334326744 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "3 cups rolled oats",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter or margarine and sugars until creamy. Add eggs and vanilla; beat well. Add combined flour, cocoa powder, baking soda, and salt; mix well. Stir in oats and raisins, mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded tablespoonfuls onto ungreased cookie sheets. Bake 10 to 12 minutes, until cookies are almost set. Do not overbake. Cool 1 minute on cookies sheets, then move to wire racks. Cool; store tightly covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
