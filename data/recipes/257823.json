  "ingredients": [
    "1 cup butter",
    "0.66666668653488 cup all-purpose flour",
    "2 quarts milk",
    "1 cup half-and-half",
    "salt and ground black pepper to taste",
    "0.5 teaspoon liquid smoke flavoring"
