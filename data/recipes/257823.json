      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir half-and-half into the saucepan; season with salt and pepper. Add liquid smoke. Cook and stir until gravy is smooth and slightly thickened, 2 to 3 minutes more.",
