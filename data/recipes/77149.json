  "ingredients": [
    "1 quart oil for frying",
    "2 cups all-purpose flour",
    "1.5 cups Parmesan cheese",
    "0.25 cup Italian seasoning",
    "1 pound venison steaks, cut into strips",
    "1 egg, beaten",
    "1 cup prepared mustard",
    "1 cup brown sugar"
  ],
  "steps": [
    {
      "text": "Heat the oil in skillet or deep fryer to 375 degrees F (190 degrees C).",
