    "publisher-tested"
  ],
  "ingredients": [
    "1 (3 pound) boneless pork loin roast",
    "2 tablespoons butter",
    "2 cloves garlic, minced",
    "1 teaspoon dried oregano",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon dry mustard powder",
    "0.5 teaspoon ground black pepper",
    "1 large onion, diced",
    "2 medium carrots, diced",
    "1 stalk celery, diced",
    "salt and ground black pepper to taste",
    "3 tablespoons flour",
    "0.5 cup pork stock"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UdFhaUkfCluG0-3_ohvWJ8mMpkc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219208-roasted-loin-of-pork-with-pan-gravy-ddmfs-step-01-3170-af7b029a638940dfa4e4967a2b867646.jpg"
      ],
      "image": "assets/images/219208/step_01.webp"
    },
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Make several small slits in top of pork roast; place into a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TU1-OSHEC7kk6ZuC4tjjna8lyGE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219208-roasted-loin-of-pork-with-pan-gravy-ddmfs-step-02-3172-ceb808b58e254c0d942a7d94a0003ea0.jpg"
      ],
      "image": "assets/images/219208/step_02.webp"
    },
    {
      "text": "Melt butter in a skillet over medium heat. Add garlic, oregano, cayenne, thyme, mustard powder, and black pepper; cook and stir until fragrant, about 1 minute. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/U8nq3lmRyVj0TSHVFRKYQlD9xLo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219208-roasted-loin-of-pork-with-pan-gravy-ddmfs-step-03-3179-d59eee83088c43adafd9c62a3b665b85.jpg"
      ],
      "image": "assets/images/219208/step_03.webp"
    },
    {
      "text": "Spread spice mixture all over pork and rub into slits. Place onion, carrots, and celery around pork; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8lHSpbjylQH8-onqH8NSWtrGIRw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219208-roasted-loin-of-pork-with-pan-gravy-ddmfs-step-05-3186-91d55453324c4fea937206411502c8ed.jpg"
      ],
      "image": "assets/images/219208/step_04.webp"
    },
    {
      "text": "Roast in the preheated oven for 1 hour 45 minutes. Increase the heat to 425 degrees F (220 degrees C) and continue cooking until pork is browned and an instant-read meat thermometer inserted into the center of the roast reads at least 150 degrees F (65 degrees C), about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8YiFiMftS9qtQGxxH2B3Swv4ke8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219208-roasted-loin-of-pork-with-pan-gravy-ddmfs-step-05-3264-6484899e154448bd9a15da26366fa0cd.jpg"
      ],
      "image": "assets/images/219208/step_05.webp"
    },
    {
      "text": "Remove from the oven and let stand for 10 minutes. Recheck the temperature; it should be at least 160 degrees F (75 degrees C) before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the pork is resting, place the roasting pan with vegetables and pan drippings over a stove burner set to medium heat. Whisk in flour and simmer to remove raw taste, about 3 minutes. Whisk in stock, a little at a time, until gravy is thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wbl3L31Pz7cns_lyMgGDwHuGuWk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219208-roasted-loin-of-pork-with-pan-gravy-ddmfs-step-07-3273-f4e5ad5d246a416391f6836962343a2d.jpg"
      ],
      "image": "assets/images/219208/step_07.webp"
    },
    {
      "text": "Strain and serve with pork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YZgm6lJnWJSsdsdR3qqEpSGyT9Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219208-roasted-loin-of-pork-with-pan-gravy-ddmfs-4x3-3317-1c587b33a5fe4e589103684c20e64423.jpg"
      ],
      "image": "assets/images/219208/step_08.webp"
    }
  ],
