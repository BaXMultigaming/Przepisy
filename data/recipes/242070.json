  "ingredients": [
    "12 (3 inch) unbaked tart shells",
    "0.25 cup raspberry jam",
    "0.25 cup butter, softened",
    "0.25 cup white sugar",
    "0.25 cup all-purpose flour",
    "1 large egg",
    "1 teaspoon baking powder",
    "1 teaspoon almond extract",
    "5 tablespoons confectioners' sugar",
    "1 tablespoon boiling water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange tart shells on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 6 minutes. Set shells aside to cool. Reduce the oven temperature to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon 1 teaspoon raspberry jam into bottom of each shell; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and white sugar together in a large bowl with an electric mixer until smooth and creamy. Add flour, egg, baking powder, and almond extract; mix well. Spoon 1 tablespoon butter mixture on top raspberry jam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake tarts in the preheated oven until filling is bubbling, 25 to 30 minutes. Cool tarts while making icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine confectioners' sugar and water in a small bowl until smooth. Drizzle icing over cooled tarts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
