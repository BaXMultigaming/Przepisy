  "ingredients": [
    "1 (7 pound) pork shoulder roast",
    "0.75 cup molasses",
    "1 tablespoon chili powder",
    "1 teaspoon salt",
    "1 teaspoon paprika",
    "1 teaspoon cumin seeds",
    "1 teaspoon ground coriander",
    "water to cover",
    "1 (18 ounce) bottle barbeque sauce"
  ],
  "steps": [
    {
      "text": "Place pork in a slow cooker. Add molasses, chili powder, salt, paprika, cumin seeds, and ground coriander. Pour enough water into slow cooker to cover pork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for 6 to 8 hours. Drain liquid from slow cooker and shred pork with 2 forks. Add barbeque sauce. Reduce heat the Low and continue cooking for 1 hour more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
