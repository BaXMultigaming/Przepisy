  "ingredients": [
    "0.25 cup butter",
    "2 tablespoons olive oil",
    "0.5 large onion, finely chopped",
    "2 large carrots, sliced",
    "2 tablespoons curry powder",
    "0.5 teaspoon ground turmeric",
    "salt and ground black pepper to taste",
    "1 pinch red pepper flakes",
    "1 head cauliflower, broken into small florets",
    "2 large potatoes, peeled and cubed"
  ],
  "steps": [
    {
      "text": "Heat the butter and olive oil in a large skillet over medium heat. Add the onion and carrots; cook and stir until tender. Season with curry powder, turmeric, salt, pepper, and red pepper flakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the cauliflower and potatoes to the pan, and stir to coat with spices. Reduce heat to medium-low, cover, and simmer for 20 minutes, or until the potatoes are tender. Stir occasionally.",
      "section": null,
      "name": null,
      "url": null,
