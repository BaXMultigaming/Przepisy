  "ingredients": [
    "0.5 cup butter",
    "1 cup white sugar",
    "0.75 cup self-rising flour",
    "1 pinch ground nutmeg, or to taste",
    "0.75 cup milk",
    "1 (28 ounce) can sliced peaches, with juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter into a 8x8-inch baking pan; place into the oven until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, flour, and nutmeg in a large bowl; stir in milk until no lumps remain. Pour batter over melted butter in the prepared pan; do not stir. Spoon peaches over top; gently pour in juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until batter has firmed and cobbler has risen a bit, 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
