  "ingredients": [
    "1.5 cups brown sugar",
    "1 cup solid vegetable oil-butter spread (such as Smart Balance® sticks), softened",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "2 cups shredded unsweetened coconut",
    "1.5 cups whole wheat flour",
    "1 cup rolled oats",
    "1 cup dark chocolate chips",
    "1 cup chopped unsalted almonds",
    "1 tablespoon plain Greek yogurt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, vegetable oil butter spread, and egg with an electric mixer in a bowl until smooth. Stir in vanilla extract, baking soda, and salt. Add coconut, flour, and oats; stir until just moistened. Fold in chocolate chips, almonds, and yogurt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of the dough 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 9 to 11 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
