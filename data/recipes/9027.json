  "ingredients": [
    "2 tablespoons white wine, divided",
    "2 tablespoons soy sauce, divided",
    "2 tablespoons sesame oil, divided",
    "2 tablespoons cornstarch, dissolved in 2 tablespoons water",
    "1 pound skinless, boneless chicken breast halves - cut into chunks",
    "1 ounce hot chile paste",
    "2 teaspoons brown sugar",
    "1 teaspoon distilled white vinegar",
    "1 (8 ounce) can water chestnuts",
    "4 ounces chopped peanuts",
    "4 green onions, chopped",
    "1 tablespoon chopped garlic"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n777PRVkV2XioaC9c_UbD2PYkeM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9027-kung-pao-chicken-ddmfs-4x3-ingredients-24a91b7be1f24aa8aa5c5335e2848067.jpg"
      ],
      "image": "assets/images/9027/step_01.webp"
    },
    {
      "text": "Whisk 1 tablespoon wine, 1 tablespoon soy sauce, 1 tablespoon sesame oil, and 1 ½ teaspoons cornstarch in a large glass bowl until smooth. Add chicken pieces and toss to coat. Cover the dish and refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Zje90YPSHGJxIjouZiNFhJVBTew=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9027-kung-pao-chicken-ddmfs-4x3-step-02-805b46b8847547248104e7dcef4f72d7.jpg"
      ],
      "image": "assets/images/9027/step_02.webp"
    },
    {
      "text": "Combine remaining 1 tablespoon wine, 1 tablespoon soy sauce, and 1 tablespoon sesame oil in a medium bowl. Whisk in chili paste, brown sugar, and vinegar. Add water chestnuts, peanuts, green onions, and garlic and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nx5vGkjdO3DMFWREwwPgYRGhvlU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9027-kung-pao-chicken-ddmfs-4x3-step-03-e47a1564037c44ada57460407db310b7.jpg"
      ],
      "image": "assets/images/9027/step_03.webp"
    },
    {
      "text": "Transfer water chestnut sauce mixture to a medium skillet. Heat slowly over medium heat until aromatic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Apft4n9FEDFE2zJ25CNTfjvLdVU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9027-kung-pao-chicken-ddmfs-4x3-step-04-53874fbd3cf7481ba1e3f8c86eea8f58.jpg"
      ],
      "image": "assets/images/9027/step_04.webp"
    },
    {
      "text": "Meanwhile, transfer chicken from marinade into a large skillet; cook over medium-high heat, stirring, until chicken is cooked through and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R5s_rK_TOjLORyGsm72-nH91qhc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9027-kung-pao-chicken-ddmfs-4x3-step-05-43b040c6c5f9425ea2ed55a8010d9b4b.jpg"
      ],
      "image": "assets/images/9027/step_05.webp"
    },
    {
      "text": "Combine water chestnut mixture and cooked chicken together in one skillet. Adjust heat and simmer until sauce thickens and coats chicken, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/77x4rJvy5T1z_Iyc52NK7pDOkJE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9027-kung-pao-chicken-ddmfs-4x3-hero-9a10c2277f65472a941d932313caab86.jpg"
      ],
      "image": "assets/images/9027/step_06.webp"
    }
