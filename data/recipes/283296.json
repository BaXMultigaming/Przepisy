  "ingredients": [
    "1 pound ground beef",
    "0.5 cup chopped onion",
    "0.33333334326744 cup chopped green bell pepper",
    "1 (15 ounce) can Sloppy Joe sauce",
    "0.75 cup beef broth",
    "1 (11 ounce) can corn with red and green peppers (such as Green Giant® Mexicorn®), drained",
    "1 medium potato, peeled and cut into 1/2-inch cubes",
    "1 teaspoon Worcestershire sauce",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Brown ground beef, onion, and bell pepper in a large saucepan over medium heat until beef is no longer pink, 5 to 7 minutes. Drain grease from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in Sloppy Joe sauce and beef broth until well combined. Add corn, potato, Worcestershire sauce, salt, and pepper; stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the pot and cook until the potatoes are tender, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
