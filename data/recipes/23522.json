  "ingredients": [
    "3 cups raw whole pumpkin seeds",
    "1 teaspoon salt",
    "2 tablespoons water",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Clean and dry pumpkin seeds so there is no goo or strings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter onto a cookie sheet. Spread pumpkin seeds evenly over the buttered sheet and sprinkle with salt and water.",
