  "ingredients": [
    "0.5 cup reduced-fat sour cream (such as Daisy®)",
    "2 tablespoons fresh lemon juice",
    "2 tablespoons chopped fresh dill",
    "3 cucumbers, halved lengthwise and thinly sliced crosswise",
    "0.5 cup thinly sliced red onion",
    "coarse salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Mix together sour cream, lemon juice, and dill in a medium bowl until well combined. Add cucumbers and onion; stir to incorporate. Season with salt and black pepper.",
