  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut cabbage vertically through the core into 4 wedges. Whisk Thai sweet chili sauce and Sriracha together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cabbage wedges on the prepared baking sheet and brush 1/2 of the chili-Sriracha sauce over the top of each wedge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Heat the oven's broiler to high. Brush remaining sauce over the cabbage wedges. Broil for 5 minutes.",
