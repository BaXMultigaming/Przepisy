  "title": "Ham and Cheese Sliders",
  "description": "These ham and cheese sliders with deli ham and melted Swiss cheese on Hawaiian rolls are topped with seasoned butter for a delicious party appetizer.",
  "authors": [
    "TheRealPaulGately"
  ],
  "date_published": "2018-06-08T10:46:39-04:00",
  "date_modified": "2025-12-14T22:08:47-05:00",
