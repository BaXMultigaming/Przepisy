  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "cooking spray",
    "1 (12 count) package Hawaiian sweet rolls",
    "1 (6 ounce) package thinly sliced deli ham",
    "0.75 pound shredded Swiss cheese",
    "0.5 cup unsalted butter",
    "1 tablespoon Dijon mustard",
    "1 tablespoon poppy seeds",
    "2 teaspoons Worcestershire sauce",
    "2 teaspoons dried minced onion",
    "0.25 teaspoon salt, or to taste",
    "0.25 teaspoon ground black pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Line a 9-inch square baking pan with aluminum foil and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NG8gDRnnTDKdFMyCI5t8xq0HM10=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-261933-ham-and-cheese-sliders-VAT-step-01-97d388ccdb2c4cf2a2fbfd5a51ee2fbe.jpg"
      ],
      "image": "assets/images/261933/step_01.webp"
    },
    {
      "text": "Pull attached rolls from the package. Use a serrated knife to cut through horizontally, separating rolls into a top and bottom \"slab.\"",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fUJlWdKbJEejEmKDgGE5l9Oxrxw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-261933-ham-and-cheese-sliders-VAT-step-02-1-45205ef632484002b045535c0cebfc02.jpg"
      ],
      "image": "assets/images/261933/step_02.webp"
    },
    {
      "text": "Place bottom slab into the prepared pan. Layer with 1/2 of the ham, all of the Swiss cheese, followed by remaining ham. Cover with top slab.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yeqx7C0jngMazTMajEF6q57BqhQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-261933-ham-and-cheese-sliders-VAT-step-03-1overhead-2152b3b0b6d64cd5bf152e1e826a734e.jpg"
      ],
      "image": "assets/images/261933/step_03.webp"
    },
    {
      "text": "Whisk melted butter, mustard, poppy seeds, Worcestershire sauce, onion, salt, and pepper together in a small bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LETmeULHMWof_QLkwpw9YT30NFU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-261933-ham-and-cheese-sliders-VAT-step-04-1handwhisking-776af935d1df4cbd846c042b086eb0fc.jpg"
      ],
      "image": "assets/images/261933/step_04.webp"
    },
    {
      "text": "Slowly pour butter mixture over all rolls. Use a spatula to spread it evenly; some will pool at the bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KhLCyksKk6lalgYhfRH1iI6mglY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-261933-ham-and-cheese-sliders-VAT-step-05-1spatulaspreading-d07edfe9add94daaaab7f963f22b85b1.jpg"
      ],
      "image": "assets/images/261933/step_05.webp"
    },
    {
      "text": "Cover with aluminum foil and let stand at room temperature for 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tQ9Le6q7e-xet5x4nbggrC-y20s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-261933-ham-and-cheese-sliders-VAT-step-06-0e5ff0f825e7417eb9d393629ee3c21a.jpg"
      ],
      "image": "assets/images/261933/step_06.webp"
    },
    {
      "text": "Bake, covered, in the preheated oven until cheese has melted, about 20 minutes. Uncover and continue baking until rolls are browned, 3 to 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MjSgO37JO_W24Thm07T8gfhujHA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-261933-ham-and-cheese-sliders-VAT-step-07-6e9a64524db14bd08248978ae64ad033.jpg"
      ],
      "image": "assets/images/261933/step_07.webp"
    },
    {
      "text": "Cut to separate sliders.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0hodaLF2rj6Ecz3PSL68qna72uU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-261933-ham-and-cheese-sliders-VAT-step-08-a5609c70ffd641f98becc5ca40268e0a.jpg"
      ],
      "image": "assets/images/261933/step_08.webp"
    }
  ],
