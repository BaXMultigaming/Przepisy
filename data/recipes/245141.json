  "ingredients": [
    "1 cup whole wheat flour",
    "1 cup all-purpose flour",
    "1 tablespoon baking powder",
    "2 teaspoons baking soda",
    "0.25 teaspoon ground cinnamon",
    "4 eggs",
    "0.75 cup brown sugar",
    "0.66666668653488 cup applesauce",
    "0.33333334326744 cup vegetable oil",
    "3 cups shredded carrots",
    "1 orange, zested"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 12 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift whole wheat flour, all-purpose flour, baking powder, baking soda, and cinnamon together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, brown sugar, applesauce, and vegetable oil together in a bowl. Stir egg mixture into flour mixture just until ingredients are moistened; fold in carrots and orange zest. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted near the center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
