  "ingredients": [
    "1 cup butter, melted",
    "1 cup dark brown sugar",
    "0.5 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.25 teaspoon baking powder",
    "2 cups dark chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter, brown sugar, and white sugar together in a bowl; beat it eggs and vanilla extract until smooth and creamy. Stir flour, baking soda, salt, and baking powder into the creamed butter mixture until batter is well mixed. Fold chocolate chips into batter; spread into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 40 minutes. Cool before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
