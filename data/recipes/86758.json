  "ingredients": [
    "2 cups diced yellow squash",
    "2 cups crumbled cornbread",
    "0.5 cup margarine, melted",
    "2 teaspoons dried sage",
    "1 (10.75 ounce) can cream of mushroom soup",
    "1 egg, beaten",
    "1 large onion, chopped",
    "1.5 teaspoons sugar",
    "salt and pepper to taste",
    "0.25 cup milk"
  ],
