  "ingredients": [
    "2 tablespoons pine nuts",
    "2 cups fresh basil leaves, stems removed",
    "1 tablespoon minced garlic",
    "0.5 cup extra-virgin olive oil",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Cook pine nuts in a dry skillet in a single layer over medium-low heat, stirring constantly, until fragrant and golden brown, 3 to 5 minutes. Immediately transfer to a plate to stop the cooking process; cool, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pine nuts, basil, and garlic in the bowl of a food processor; pulse until blended. Pour in olive oil slowly, with the processor running on low speed, until mixture is smooth. Add Parmesan cheese; pulse until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
