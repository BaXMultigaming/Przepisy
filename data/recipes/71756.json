  "ingredients": [
    "1 (3 pound) beef brisket",
    "1 cup ketchup",
    "1 (1 ounce) package dry onion soup mix",
    "1 (12 fluid ounce) can or bottle ginger ale",
    "3 carrots, cut into 1 inch pieces",
    "1 small onion, sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the brisket in a roasting pan fat side up. In a medium bowl, stir together the ketchup, soup mix and ginger ale; pour over the brisket. Arrange carrots and onion around the edge of the roast if using. Cover the roast with a lid or aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 2 hours in the preheated oven. Remove the cover, and cook for 1 more hour. Let stand for a few minutes before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
