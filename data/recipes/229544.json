  "ingredients": [
    "3 cups Rice Chex® cereal",
    "3 cups Corn Chex® cereal",
    "3 cups Chocolate Chex® cereal",
    "1 cup semisweet chocolate chips",
    "0.5 cup peanut butter",
    "0.25 cup butter or margarine",
    "1 teaspoon vanilla",
    "1.5 cups powdered sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jJX0erOYx4rxm6CkqbRNnf3JOn4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229544-chex-muddy-buddies-ddmfs-step1-1866-e848d2a7e5324e5cb0602ddeb4638713.jpg"
      ],
      "image": "assets/images/229544/step_01.webp"
    },
    {
      "text": "Combine rice, corn, and chocolate cereals in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate chips, peanut butter, and butter in a 1-quart microwave-safe bowl. Microwave, uncovered, on high for 1 minute; stir. Continue microwaving mixture until smooth and combined, about 30 seconds more. Stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YBa5QEkX-6FIaCUXkH4AN5odH-o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229544-chex-muddy-buddies-ddmfs-step2-1868-45bb7ccd33ca434c96d9d4f68efcb88f.jpg"
      ],
      "image": "assets/images/229544/step_03.webp"
    },
    {
      "text": "Pour chocolate mixture over cereals; stir until evenly coated. Transfer to a 2-gallon resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AJ44gSPupew5RXAVsyGeN6_otOQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229544-chex-muddy-buddies-ddmfs-step4-1873-706b2fde1d2d4e059af27dbf8e8e35d3.jpg"
      ],
      "image": "assets/images/229544/step_04.webp"
    },
    {
      "text": "Add confectioners' sugar to the bag and seal; shake until well-coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hzrDBXMujixlgD2aUIkdrXJ-VV4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229544-chex-muddy-buddies-ddmfs-step5-1875-a7cba7ef69de4d26918fe7ac6fd33037.jpg"
      ],
      "image": "assets/images/229544/step_05.webp"
    },
    {
      "text": "Spread cereal mixture onto waxed paper to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
