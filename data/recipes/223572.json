  "ingredients": [
    "1 cup water",
    "0.5 cup white sugar",
    "3 avocados, peeled and pitted",
    "1 lime, juiced",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Combine water and sugar in a saucepan; bring to a boil, stirring continually, until sugar dissolves. Set aside simple syrup to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine simple syrup, avocados, lime juice, and salt in a blender; blend until smooth. Pour mixture into 10 ice pop molds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Freeze ice pops until solid yet still soft, about 2 hours; insert wooden sticks and continue freezing until firm, 12 to 24 hours more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
