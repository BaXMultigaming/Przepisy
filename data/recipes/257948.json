  "ingredients": [
    "1.25 cups whole wheat flour",
    "0.25 cup quinoa flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "3 bananas",
    "1 cup sliced strawberries",
    "0.33333334326744 cup honey",
    "0.33333334326744 cup canola oil",
    "1 egg",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift whole wheat flour, quinoa flour, baking powder, baking soda, and salt into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bananas, strawberries, honey, oil, egg, and vanilla extract in a blender; blend until small chunks remain or mixture is completely smooth. Pour over whole wheat flour mixture; mix until batter is combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes. Transfer to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
