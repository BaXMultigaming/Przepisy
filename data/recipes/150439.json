      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add vegetables, broth, and soy sauce to the same skillet; bring to a boil. Stir in rice; cover. Remove from heat and let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir scrambled eggs into rice mixture. Serve hot.",
