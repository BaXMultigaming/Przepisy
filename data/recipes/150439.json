  "ingredients": [
    "1 tablespoon oil",
    "3 large eggs, lightly beaten",
    "1 (16 ounce) package frozen stir-fry vegetables, thawed",
    "1 (14.5 ounce) can chicken broth",
    "2 tablespoons soy sauce",
    "2 cups Minute® White Rice, uncooked"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Cook beaten eggs in hot oil until set, stirring occasionally. Remove scrambled eggs to a plate; set aside.",
