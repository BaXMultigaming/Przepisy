  "ingredients": [
    "4 large apples",
    "5 ounces marzipan",
    "1 tablespoon orange marmalade",
    "2 tablespoons unsalted butter, cut into small pieces",
    "0.75 cup orange juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel apples and carefully cut out core using an apple corer. Place in a small baking dish side by side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead marzipan and orange marmalade together in a small bowl and stuff mixture into the apples. Top with butter cubes. Pour orange juice into the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apples are soft, 55 to 60 minutes. Baste with orange juice every 10 to 15 minutes.",
