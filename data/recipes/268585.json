  "ingredients": [
    "1 (17.5 ounce) package frozen puff pastry, thawed",
    "1 (8 ounce) package cream cheese, softened",
    "4 Granny Smith apples, peeled and diced",
    "0.5 cup white sugar",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll puff pastry sheets onto a floured work surface. Cut each sheet into 6 small squares. Arrange squares on 2 baking sheets. Spread cream cheese over the center of each square.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix apples, sugar, and cinnamon together in a separate bowl. Spoon mixture onto the squares. Pinch corners of each square together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed up and golden, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
