  "ingredients": [
    "1 (3 ounce) package instant ramen noodles (without flavor packet)",
    "1 teaspoon sambal oelek (chile paste)",
    "1 teaspoon minced garlic",
    "1 teaspoon ginger paste",
    "1 tablespoon sesame oil",
    "0.5 teaspoon toasted sesame seeds"
  ],
  "steps": [
    {
      "text": "Bring 2 cups water to a boil in a large skillet. Add ramen noodles and boil for 2 minutes. Drain noodles in a colander and wipe out the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk sambal oelek, garlic, and ginger paste together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sesame oil to the skillet and heat over medium heat. Add drained noodles and cook until slightly crispy, about 3 minutes. Add sambal oelek mixture. Cook for 3 minutes more using chopsticks to toss the noodles in the sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide mixture between 2 serving bowls and garnish with toasted sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
