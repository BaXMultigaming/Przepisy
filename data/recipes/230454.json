  "ingredients": [
    "2.25 teaspoons active dry yeast",
    "0.25 cup warm water",
    "1 cup scalded milk, cooled",
    "0.5 cup prepared mashed potatoes",
    "0.25 cup vegetable shortening",
    "0.25 cup white sugar",
    "1.5 teaspoons salt",
    "1 large egg, beaten",
    "4.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Dissolve yeast in warm water in a bowl. Let stand until yeast softens and begins to form a creamy foam, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6snL0wm1Sx2tRGysUQst_aIAbGE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230454_PotatoRolls_ddmfs_Step1_3x4_3491-cdf4229741444f2c95657d4d7b057712.jpg"
      ],
      "image": "assets/images/230454/step_01.webp"
    },
    {
      "text": "Mix milk, mashed potatoes, shortening, sugar, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DudyZKVXfyF70XbmRf50We2PbKA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230454_PotatoRolls_ddmfs_Step2_3x4_3486-d8ef7dfcdb8a4f6faa22409f290178c3.jpg"
      ],
      "image": "assets/images/230454/step_02.webp"
    },
    {
      "text": "Add yeast mixture and egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pt9oT6GFKhq9xSOIGQu2jxUe7Kc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230454_PotatoRolls_ddmfs_Step3_3x4_3492-67dfabffcae9488098daaccfca50ae81.jpg"
      ],
      "image": "assets/images/230454/step_03.webp"
    },
    {
      "text": "Stir in 2 cups flour until incorporated. Stir in remaining 2 ½ cups flour to make a soft dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QmIsJ9q90Ne2ZdNNY5IKBnigfNY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230454_PotatoRolls_ddmfs_Step4_3x4_3493-e645c33b407941119a830e3533209fe8.jpg"
      ],
      "image": "assets/images/230454/step_04.webp"
    },
    {
      "text": "Transfer dough to a lightly floured surface and knead until smooth and elastic, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iqo_Z1LB6_VYD9sLaBM17Y4hiPg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230454_PotatoRolls_ddmfs_Step6_3x4_3498-e0cfffdc11e14ccfa8775f28ae19ef54.jpg"
      ],
      "image": "assets/images/230454/step_05.webp"
    },
    {
      "text": "Place dough into a lightly greased bowl and turn once to coat all sides with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Lb8sBFYuxI9PhmuAcUP-GrsV7d4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230454_PotatoRolls_ddmfs_Step7_3x4_3499-cbe9ecdd5487447cb0c8f81284c1eea8.jpg"
      ],
      "image": "assets/images/230454/step_06.webp"
    },
    {
      "text": "Cover the bowl and set in a warm place until dough has doubled in size, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LKFhH34w_0iQrqzCshM3Pge_HaA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230454_PotatoRolls_ddmfs_Step8_3x4_3567-538a087e4ec640bb8945649fe7f94e82.jpg"
      ],
      "image": "assets/images/230454/step_07.webp"
    },
    {
      "text": "Punch dough down and shape into a ball. Cover the bowl and let rest for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rGC9iz0eDyLmvJ-FXi_c8-aPcs0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230454_PotatoRolls_ddmfs_Step9_3x4_3568-55549f4e43e7452986a649aab73fb764.jpg"
      ],
      "image": "assets/images/230454/step_08.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease two baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 24 rolls. Place rolls onto the prepared baking sheets and let rise until dough springs back when you touch the side of a roll with your fingertip, 25 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sG7rc1_3r79eOhjBCe-iT4LgluA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230454_PotatoRolls_ddmfs_Step11_3x4_3593-41b57545ebc0491d89552bd1cf298814.jpg"
      ],
      "image": "assets/images/230454/step_10.webp"
    },
    {
      "text": "Bake rolls in the preheated oven until golden brown, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2Hn-3BjRg23HWq4b34vInqWsrsc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230454_PotatoRolls_ddmfs_3x4_3623-aa5b184932f74203844743ee4264f0e5.jpg"
      ],
