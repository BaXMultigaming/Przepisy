  "ingredients": [
    "3 tablespoons brown sugar",
    "1 pound beef for stew, cut in 1 inch pieces",
    "2 cups fresh pigeon peas",
    "1.5 cups water",
    "1.5 cups uncooked brown rice",
    "1 cup coconut milk",
    "1 cup chopped carrot",
    "3 tablespoons coarsely chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Cook sugar in a large saucepan over medium heat until it begins to caramelize. Stir in beef and cook until well browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add in peas, water, rice, coconut milk, and carrot, and bring to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook until rice is done, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in parsley to garnish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
