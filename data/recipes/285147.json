  "ingredients": [
    "2 ears fresh corn",
    "1 cup quartered cherry tomatoes",
    "1 small red onion, diced",
    "1 medium jalapeno pepper, diced",
    "1 medium lime, juiced",
    "1 tablespoon extra-virgin olive oil",
    "1 teaspoon ground cumin",
    "1 teaspoon paprika",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook the corn on the preheated grill, turning often to ensure even cooking, until browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a sharp knife, shuck the corn and toss the cobs. Place the corn in a large mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer tomatoes, onion, jalapeno, lime juice, oil, cumin, paprika, and salt to the bowl; mix to combine.",
