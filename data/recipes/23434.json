  "ingredients": [
    "3 potatoes, thinly sliced",
    "3 carrots, thinly sliced",
    "1 large onion, thinly sliced",
    "0.5 cup uncooked long-grain rice",
    "2 (8 ounce) cans peas, with liquid",
    "1 pound pork sausage",
    "1 (10.75 ounce) can condensed tomato soup",
    "1 (10.75 ounce) can water",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a large casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer potatoes, carrots, and onions in the prepared casserole dish. Sprinkle uncooked rice over vegetables. Add peas (with liquid); arrange pork sausage on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dilute 1 can tomato soup with 1 can water in a large measuring cup; pour over sausage. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, covered, for 1 hour. Uncover and continue baking 1 hour more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
