  "ingredients": [
    "1 serving cooking spray",
    "1 (18.25 ounce) package yellow cake mix",
    "1 cup chopped pecans",
    "2 ripe bananas, mashed",
    "0.5 cup water",
    "0.5 cup vegetable oil",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "4 eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray two 9x5-inch loaf pans with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cake mix, pecans, bananas, water, vegetable oil, pudding mix, and eggs together in a large bowl with an electric mixer until evenly blended. Pour 1/2 of the batter into each of the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the middle of each loaf comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
