  "ingredients": [
    "1 cup crushed cornflakes cereal",
    "0.75 cup grated Parmesan cheese",
    "0.25 cup shredded Cheddar cheese",
    "0.5 cup butter, melted",
    "8 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix the cornflake crumbs, Parmesan cheese and Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip the chicken breasts in the melted butter, and roll them in the cornflake crumb mixture. Place chicken in a lightly greased 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 40 minutes, until chicken is no longer pink and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
