  "ingredients": [
    "1 cup milk",
    "1 egg",
    "3 tablespoons butter, melted",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 cup rolled oats",
    "1 cup packed dark brown sugar",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon pumpkin pie spice",
    "0.5 teaspoon salt",
    "1.5 cups fresh blackberries",
    "0.25 cup turbinado raw sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease 12 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together milk, egg, melted butter, and vanilla in a medium bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, oats, brown sugar, baking powder, baking soda, pumpkin pie spice, and salt in a large bowl until well combined. Make a well in the center and pour in egg mixture. Stir until just combined. Gently fold in blackberries. Divide batter evenly into the prepared muffin cups and sprinkle the tops with turbinado sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 20 minutes. Cool muffins in the pan for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
