  "ingredients": [
    "1 cup rolled oats",
    "0.75 cup whole wheat flour",
    "0.75 cup all-purpose flour",
    "0.25 cup white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon, or more to taste",
    "0.25 teaspoon ground nutmeg, or more to taste",
    "2 eggs",
    "0.75 cup milk",
    "0.33333334326744 cup vegetable oil",
    "0.25 cup brown sugar, packed",
    "0.5 teaspoon vanilla extract",
    "3 extra-ripe bananas, mashed",
    "1 cup walnuts, crushed using a rolling pin"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, whole wheat flour, all-purpose flour, white sugar, baking powder, baking soda, salt, cinnamon, and nutmeg in a medium-sized bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly beat eggs in a large bowl. Stir in milk, oil, brown sugar, and vanilla extract. Add bananas and mix together well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 1/2 of the flour mixture to egg mixture; stir to combine. Add remaining flour mixture and stir. Stir nuts into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
