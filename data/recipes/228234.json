  "ingredients": [
    "2 pounds potatoes, peeled and coarsely shredded",
    "2 onions, minced",
    "3 eggs, beaten",
    "0.25 cup all-purpose flour",
    "1 tablespoon baking powder",
    "1 teaspoon lemon juice",
    "1 pinch ground nutmeg, or to taste",
    "salt and ground black pepper to taste",
    "0.25 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Mix potatoes, onions, eggs, flour, baking powder, and lemon juice in a large bowl; season with nutmeg, salt, and black pepper. Shape potato mixture into 12 evenly sized patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a large skillet over medium heat. Pan-fry potato patties in batches until tender and browned on both sides, 7 to 10 minutes. Transfer browned patties to a paper towel-lined baking sheet. Repeat with remaining patties.",
      "section": null,
      "name": null,
      "url": null,
