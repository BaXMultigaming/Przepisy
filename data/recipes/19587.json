  "ingredients": [
    "1 cup quinoa",
    "2 cups water",
    "2 cups apple juice",
    "1 cup raisins",
    "2 tablespoons lemon juice",
    "1 teaspoon ground cinnamon, or to taste",
    "salt to taste",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Place quinoa in a sieve and rinse thoroughly. Allow to drain, then place quinoa in a medium saucepan with water. Bring to a boil over high heat. Cover pan with lid, lower heat, and allow to simmer until all water is absorbed and quinoa is tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in apple juice, raisins, lemon juice, cinnamon, and salt. Cover pan and allow to simmer for 15 minutes longer. Stir in vanilla extract. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
