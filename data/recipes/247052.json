  "ingredients": [
    "5 cups water",
    "0.25 cup white sugar",
    "5 pods star anise",
    "1 cinnamon stick",
    "4 pods cardamom, crushed",
    "8 red rooibos tea bags",
    "0.75 cup sweetened condensed milk",
    "ice"
  ],
  "steps": [
    {
      "text": "Place water, sugar, star anise, cinnamon stick, and cardamom in a saucepan; bring to a boil. Remove from heat and add tea bags. Let tea steep and cool to room temperature, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tea bags and strain out whole spices; discard. Whisk in condensed milk. Pour into a large pitcher and refrigerate until flavors combine, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill 4 glasses with ice. Serve tea over ice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
