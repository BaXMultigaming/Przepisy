  "title": "Georgia Peach Pie",
  "description": "This quick and easy Georgia peach pie recipe features a vanilla meringue base with chopped pecans, topped with fresh sliced peaches and whipped cream.",
  "authors": [
    "GOMOMMYGO"
  ],
  "date_published": "2020-06-18T23:11:01-04:00",
