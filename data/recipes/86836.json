  "title": "Shepherd's Pie Daddy's Way",
  "description": "This shepherd's pie without vegetables features ground beef, canned golden mushroom soup, and American cheese topped with homemade mashed potatoes.",
  "authors": [
    "MAMA29"
  ],
  "date_published": "2018-03-21T12:45:38-04:00",
