  "ingredients": [
    "1 tablespoon butter, melted",
    "2 tablespoons full fat cream cheese",
    "2 tablespoons coconut flour",
    "1 tablespoon granular sucralose sweetener (such as Splenda®)",
    "0.5 teaspoon baking powder",
    "1 medium egg",
    "0.25 teaspoon maple extract, or more to taste",
    "3 drops vanilla extract",
    "6 frozen raspberries"
  ],
  "steps": [
    {
      "text": "Combine butter and cream cheese in a mug and microwave on high for 1 minute 20 seconds. Add coconut flour, sweetener, and baking powder and mix until well combined. Mix in egg, maple extract, and vanilla extract, scraping down the sides of the mug. Press frozen raspberries into the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on high until cake is cooked through, another 1 minute 20 seconds.",
