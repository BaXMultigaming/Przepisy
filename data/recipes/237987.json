  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup white sugar",
    "1 (8 ounce) can crushed pineapple, drained",
    "1 (8 ounce) container frozen whipped topping (such as Cool Whip®), thawed",
    "1 cup crushed pretzels",
    "0.5 cup butter, melted",
    "0.33333334326744 cup white sugar"
  ],
  "steps": [
    {
      "text": "Mix cream cheese and 1/2 cup sugar together in a bowl; add pineapple and mix well. Fold whipped topping into pineapple mixture; refrigerate until chilled, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a baking sheet with a silicone mat or parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pretzels, butter, and 1/3 cup sugar in a bowl until evenly coated; spread onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pretzel mixture holds together like toffee, 6 to 8 minutes. Remove pan from oven and cool. Break pretzel mixture into pieces and mix into pineapple mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
