  "ingredients": [
    "1 cup cottage cheese",
    "3 eggs",
    "0.25 cup all-purpose flour",
    "2 tablespoons melted butter",
    "0.25 teaspoon salt",
    "1 teaspoon butter",
    "0.25 cup blueberries, or to taste"
  ],
  "steps": [
    {
      "text": "Strain cottage cheese in a fine-mesh sieve fitted over a bowl, pressing down occasionally, until cottage cheese dries out, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs together in a medium bowl; stir in cottage cheese, flour, 2 tablespoons melted butter, and salt until just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1 teaspoon butter in a skillet over medium-high heat. Drop batter by large spoonfuls into the skillet; sprinkle with blueberries. Cook until lightly browned, 2 to 3 minutes per side. Repeat with remaining batter and blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
