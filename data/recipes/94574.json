  "ingredients": [
    "2 cups uncooked white rice",
    "1 (3 pound) whole chicken, cut into pieces",
    "2 (28 ounce) cans whole peeled tomatoes, chopped, juice reserved",
    "2 cups small fresh okra",
    "2 bay leaves",
    "5 cups chicken broth",
    "salt and black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the rice over the bottom of a 10x15 inch baking dish. Layer the chicken pieces, tomatoes, okra, and bay leaves on top of the rice. Pour the broth and reserved tomato juice over the ingredients and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake for 2 hours, until the chicken is tender and falling off the bone. Remove the bay leaves. Serve in large bowls with plenty of rice and sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
