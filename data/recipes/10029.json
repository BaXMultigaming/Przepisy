  "ingredients": [
    "2 cups unsalted butter, softened",
    "2 cups white sugar",
    "2 cups packed brown sugar",
    "4 eggs",
    "2 teaspoons vanilla extract",
    "5 cups rolled oats",
    "4 cups all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "4 cups semisweet chocolate chips",
    "3 cups chopped walnuts",
    "8 ounces finely grated chocolate bar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together butter, white sugar, and brown sugar. Add eggs and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pulverize oats in a blender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pulverized oats, flour, baking powder, baking soda, and salt together in a separate bowl. Stir into butter mixture until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chocolate chips, walnuts, and chocolate and stir until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place golfball-sized balls of dough onto greased cookie sheets, about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, working in batches as needed, until golden, 8 to 10 minutes. Do not overbake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
