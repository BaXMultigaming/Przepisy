  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 cup cornstarch",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "4 pinches ground nutmeg",
    "4 pinches salt",
    "12 tablespoons butter",
    "1.3333333730698 cups sugar",
    "4 eggs",
    "1 teaspoon vanilla extract",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 15 muffin cups with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift the flour, cornstarch , baking powder, cinnamon, nutmeg, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the butter and sugar with an electric mixer in a large bowl until light and fluffy. Add the eggs one at a time, allowing each egg to blend into the butter mixture before adding the next. Beat in the vanilla with the last egg. Mix in the flour mixture alternately with the milk. Pour the batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and the tops spring back when lightly pressed, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
