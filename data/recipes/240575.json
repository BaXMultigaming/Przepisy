  "ingredients": [
    "1 cup firmly packed brown sugar",
    "2 tablespoons all-purpose flour",
    "0.25 teaspoon ground cinnamon",
    "3 tablespoons vinegar",
    "3 tablespoons water",
    "2 teaspoons honey",
    "0.5 teaspoon Dijon mustard",
    "0.5 cup crushed pineapple, drained"
  ],
  "steps": [
    {
      "text": "Mix brown sugar, flour, and cinnamon together in a bowl. Stir vinegar, water, honey, and mustard together in a saucepan; add brown sugar mixture and whisk until blended. Turn heat to medium-high, stir crushed pineapple into mixture, and bring to a boil, whisking constantly, until thickened, 2 to 3 minutes.",
