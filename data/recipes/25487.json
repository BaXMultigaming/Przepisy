  "ingredients": [
    "2 pounds large mushrooms",
    "0.75 pound cooked baby shrimp",
    "1 cup crushed bacon flavored crackers",
    "1 cup cream cheese, softened",
    "0.5 cup shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a medium baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove stems from mushrooms. Finely chop stems, and set aside. Arrange caps cavity side up in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix mushroom stems, cooked baby shrimp, crushed bacon flavored crackers and cream cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stuff mushroom caps generously with the mushroom stem mixture. Top with sharp Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 8 to 10 minutes, or until cheese is melted and lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
