  "ingredients": [
    "0.66666698455811 cup butter",
    "1.3329999446869 cups white sugar",
    "3 eggs",
    "1 teaspoon vanilla extract",
    "0.5 cup unsweetened cocoa powder",
    "2.25 cups sifted all-purpose flour",
    "1 teaspoon baking powder",
    "0.75 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1.25 cups water",
    "0.66666698455811 cup drained and chopped sauerkraut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour two 8-inch pans, round or square.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thoroughly cream together butter and sugar. Beat in eggs and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together cocoa, flour, baking powder, soda, and salt, and add alternately with water to egg mixture. Stir in the sauerkraut. Pour batter into prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 30 minutes or until a wooden pick comes out clean. Frost with your favorite chocolate or white frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
