  "ingredients": [
    "1 (4 pound) beef chuck roast",
    "1.5 teaspoons sea salt",
    "1 teaspoon ground black pepper",
    "2 yellow onions, quartered",
    "3 cloves garlic, or more to taste",
    "2 cups beef broth",
    "1 cup vegetable broth",
    "3 bay leaves",
    "3 sprigs thyme, chopped"
  ],
  "steps": [
    {
      "text": "Season beef chuck roast with sea salt and black pepper; put into the crock of a slow cooker with onion quarters and garlic cloves. Pour beef broth and vegetable broth over the roast. Lay bay leaves and thyme atop the roast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 7 to 8 hours.",
