  "ingredients": [
    "1 (10 ounce) package frozen peas",
    "1 cup shredded carrots",
    "1 (8 ounce) can sliced water chestnuts, drained",
    "2 green onions, sliced",
    "1 tablespoon vegetable oil",
    "1 tablespoon red wine vinegar",
    "1 tablespoon soy sauce",
    "1 clove garlic, smashed",
    "1 teaspoon white sugar",
    "1 teaspoon paprika",
    "1 teaspoon dry mustard",
    "0.25 cup mayonnaise"
  ],
  "steps": [
    {
      "text": "Place frozen peas in a colander; rinse under hot water to thaw. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix peas, carrots, water chestnuts, and green onions together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk vegetable oil, red wine vinegar, soy sauce, garlic, sugar, paprika, and dry mustard together in a separate bowl; pour over pea mixture. Marinate salad for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mayonnaise into salad just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
