  "ingredients": [
    "1 pound ground turkey",
    "1.5 teaspoons ground coriander",
    "1.5 teaspoons salt",
    "1.5 teaspoons brown sugar",
    "0.75 teaspoon ground black pepper",
    "0.25 teaspoon cayenne pepper",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "In a bowl, thoroughly mix together the turkey, coriander, salt, brown sugar, black pepper, and cayenne pepper. Cover the bowl, and refrigerate the sausage overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "The next day, heat olive oil in a skillet over medium heat. Form the sausage into thin patties, and fry until browned and no longer pink inside, 2 to 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
