  "ingredients": [
    "0.5 pound sweet butter",
    "6 ounces cream cheese, softened",
    "2 cups all-purpose flour",
    "1.5 cups dark brown sugar",
    "1 cup chopped walnuts",
    "3 tablespoons butter, melted",
    "3 eggs",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sweet butter and cream cheese together in a bowl with an electric mixer until smooth and creamy. Gradually stir flour into butter until forming a dough. Shape dough into 1-inch balls and place into 3/4-inch muffin cups. Press dough into the bottom and sides of each muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, walnuts, melted butter, eggs, and vanilla extract together in a separate bowl. Spoon about 1 teaspoon of walnut filling into the dough cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges of cookies are lightly browned and filling is cooked through, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
