  "ingredients": [
    "0.25 cup water",
    "1 black tea bag",
    "3 tablespoons white sugar",
    "2 tablespoons unsweetened cocoa powder, preferably Dutch-process",
    "2 cups milk",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "sweetened whipped cream",
    "2 (3 inch) cinnamon sticks"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a small saucepan. Add tea bag, cover, and remove from the heat. Let stand for 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tea bag and stir in sugar and cocoa. Return to the stove over medium heat and bring just to a boil. Mix in milk, vanilla, cinnamon, and nutmeg. Heat through but do not boil. Pour into mugs, then top with whipped cream and garnish with cinnamon sticks.",
      "section": null,
