  "ingredients": [
    "6 egg whites",
    "2 cups white sugar",
    "1 cup olive oil",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.75 teaspoon ground cinnamon",
    "0.75 teaspoon ground cloves",
    "1 cup buttermilk",
    "1 cup chopped cranberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a 9 inch Bundt pan with cooking spray, and dust with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, beat the egg whites until stiff. Beat in the sugar until fluffy. Mix in the olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, mix the flour, baking soda, salt, cinnamon, and cloves. Alternately mix the egg white mixture and the buttermilk into the flour mixture until smooth. Fold in the cranberries. Transfer the mixture to the prepared Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 1 hour in the preheated oven, until a knife inserted in the cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
