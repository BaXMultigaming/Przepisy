  "ingredients": [
    "1 cup semisweet chocolate chips",
    "2 egg whites",
    "1 pinch salt",
    "0.5 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon distilled white vinegar",
    "0.75 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Melt chocolate over hot, not boiling water. (Or 30 seconds on High in microwave, stir then another 30 seconds.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites with a dash of salt until foamy. Gradually add sugar, beating well, then beat until stiff peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat in vanilla and vinegar. Fold in melted chocolate and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoonfuls on well greased cookie sheet. Bake at 350 degrees F (180 degrees C) for 10+ minutes. Remove from pan *immediately*. Decorate with nuts if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
