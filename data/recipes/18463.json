  "ingredients": [
    "1 (14 ounce) package double-crust pie pastry, thawed",
    "3 cups mulberries",
    "1.25 cups white sugar",
    "0.25 cup all-purpose flour",
    "2 tablespoons butter",
    "1 tablespoon milk"
  ],
  "steps": [
    {
      "text": "Lay bottom pie crust in a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix berries with sugar and flour in a large bowl. Place mixture into bottom pie crust. Dot with butter, then cover with top pie crust. Crimp edges, cut slits in upper crust, and brush with milk. Let pie rest in the refrigerator for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pie in the preheated oven for 15 minutes. Lower the oven temperature to 350 degrees F (175 degrees C) and bake for an additional 30 minutes. Remove pie from oven and let sit on wire rack until cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
