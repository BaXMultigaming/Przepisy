  "ingredients": [
    "1 (2 pound) cauliflower, trimmed and cut into florets",
    "1 tablespoon minced garlic",
    "2 teaspoons crushed red pepper flakes",
    "1 teaspoon mustard seeds",
    "0.5 teaspoon whole black peppercorns",
    "2 cups distilled white vinegar",
    "2 cups water",
    "1 tablespoon sea salt",
    "1 teaspoon white sugar"
  ],
  "steps": [
    {
      "text": "Place cauliflower florets into a large canning jar. Add garlic, crushed red pepper flakes, mustard seeds, and peppercorns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring vinegar, water, sea salt, and sugar to a boil in a small saucepan over medium-high heat. Reduce heat and simmer until salt and sugar have dissolved, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture over the cauliflower mixture, seal, and let cool for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place jar in the refrigerator for 24 hours, shaking every 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
