  "ingredients": [
    "2 (8 ounce) containers fat-free cream cheese, softened",
    "0.75 cup white sugar",
    "2 eggs, beaten",
    "1 tablespoon green tea powder",
    "2 teaspoons vanilla extract",
    "1 (9 inch) prepared graham cracker pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and sugar together in a large bowl with an electric mixer until smooth. Beat in eggs, green tea powder, and vanilla extract until light and creamy; pour into the prepared crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center jiggles evenly when cake is lightly shaken, about 25 minutes. Refrigerate before serving, 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
