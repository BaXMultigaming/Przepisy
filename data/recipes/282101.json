  "ingredients": [
    "cooking spray",
    "2 cups self-rising flour",
    "1.5 cups sparkling apple cider",
    "1 cup oat flour",
    "0.33333334326744 cup white sugar",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking powder",
    "1 tablespoon white sugar",
    "0.5 teaspoon ground cinnamon",
    "2 tablespoons salted butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a loaf pan with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine self-rising flour, sparkling cider, oat flour, sugar, cinnamon, and baking powder in a large bowl; mix well. Pour batter into the prepared loaf pan. Mix sugar and cinnamon in a small bowl and sprinkle over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce the oven temperature to 375 degrees F (190 degrees C). Bake the loaf in the preheated oven for 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the loaf and pour melted butter on top. Continue baking for 20 minutes. Cool before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
