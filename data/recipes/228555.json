  "ingredients": [
    "0.25 cup butter",
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "2 teaspoons baking powder",
    "1 cup milk",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "22 ounces fig preserves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a baking dish; melt in the preheated oven, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, and baking powder in a bowl; stir in milk, egg, and vanilla extract until well combined. Pour batter into the prepared baking dish; spoon fig preserves evenly over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Cover cobbler with aluminum foil; continue baking until bubbling and lightly browned, 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
