  "ingredients": [
    "2 tablespoons Parmesan cheese flavored bread crumbs",
    "2 tablespoons chopped red bell pepper",
    "2 tablespoons chopped yellow bell pepper",
    "2 green onions, chopped",
    "0.25 jalapeno pepper, seeded and minced",
    "4 tablespoons butter, melted",
    "1 (6 ounce) can crabmeat, drained and flaked",
    "2 tablespoons shredded mozzarella cheese",
    "4 (6 ounce) fillets grouper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir bread crumbs, red pepper, yellow pepper, green onions, jalapeño, butter, crabmeat, and mozzarella cheese together in a medium bowl. Arrange grouper fillets in a single layer in a 9x13-inch baking dish. Spread the crumb topping evenly over the fish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes in the preheated oven, or until fish is easily flaked with a fork. If you have thin fillets, you can broil for 10 minutes instead of baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
