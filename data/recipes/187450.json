  "ingredients": [
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "3 eggs, beaten",
    "1.5 cups milk",
    "0.25 cup melted butter",
    "1 tablespoon dried parsley",
    "1 pound extra lean ground beef",
    "0.25 cup finely chopped onion",
    "0.25 cup diced celery",
    "0.25 cup chopped carrot",
    "0.5 teaspoon salt",
    "0.25 teaspoon pepper",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon steak sauce (such as A.1.™)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and 1 teaspoon salt together in a bowl. Whisk eggs, milk, and butter together in a separate bowl. Pour egg mixture over flour mixture; beat until well blended. Stir in parsley; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat; stir in ground beef and onion. Cook and stir until beef is crumbly, evenly browned, and no longer pink, about 10 minutes. Drain and discard any excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine drained meat mixture with celery, carrot, 1/2 teaspoon salt, pepper, Worcestershire sauce, and steak sauce. Spread meat mixture evenly into the prepared baking dish. Pour Yorkshire pudding batter over meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the pudding has risen tall and is golden, about 45 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
