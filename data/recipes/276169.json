  "ingredients": [
    "4 cups peeled, cubed russet potatoes",
    "0.5 pound ground chorizo sausage",
    "2 tablespoons olive oil",
    "4 ribs celery, chopped",
    "1 medium onion, chopped",
    "1 (32 fluid ounce) container chicken broth",
    "1.5 cups baby carrots, chopped",
    "0.5 teaspoon celery salt",
    "salt and ground black pepper to taste",
    "2 cups heavy whipping cream",
    "2 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Place potatoes in a bowl of cold water and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir chorizo in the hot skillet until browned and crumbly, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a heavy pot over medium-low heat. Add celery and onion and cook until soft, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain potatoes and transfer to the pot. Pour in chicken broth; add chorizo, carrots, and celery salt. Season with salt and pepper. Simmer until carrots are tender, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reserve 1/2 cup heavy cream; pour 1 1/2 cups into the soup. Continue cooking until flavors combine, about 10 minutes. Warm reserved cream slightly and whisk in flour; slowly pour into the soup. Simmer until thickened, 7 to 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
