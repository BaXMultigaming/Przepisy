  "ingredients": [
    "6 ounces uncooked orzo pasta",
    "0.5 cup frozen peas",
    "0.5 cup chopped cucumber",
    "0.25 cup diced red bell pepper",
    "0.25 cup diced red onion",
    "0.25 cup chopped marinated artichoke hearts",
    "1 Roma tomato, seeded and diced",
    "2 tablespoons red wine vinegar",
    "2 tablespoons salad seasoning mix (such as McCormick® Salad Supreme Seasoning)",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook orzo in the boiling water, stirring occasionally until tender yet firm to the bite, about 11 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While pasta is cooking, place peas, cucumber, bell pepper, onion, artichokes, and tomato into a large bowl and toss.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain cooked orzo, but do not rinse or cool. Toss hot pasta with the veggies in the bowl and mix in vinegar, seasoning mix, and oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate for 8 hours, or overnight. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
