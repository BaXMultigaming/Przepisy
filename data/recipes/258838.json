  "ingredients": [
    "1.5 cups all-purpose flour",
    "2 medium ripe bananas, mashed, or more to taste",
    "0.5 cup white sugar",
    "0.25 cup butter, melted",
    "0.25 cup chopped walnuts",
    "1 large egg",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UWysmIeH-eSzTwJ58BrjfbyJouY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/258838-Easy-Kids-Recipe-for-Fluffy-Banana-Cookies-ddmfs-step-0-027-798f89c5902d46eb93c099768c466590.jpg"
      ],
      "image": "assets/images/258838/step_01.webp"
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W_jMgqn48iRVyQOBC2ZntTYp3gM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/258838-Easy-Kids-Recipe-for-Fluffy-Banana-Cookies-ddmfs-step-1-029-7603eaea2f3e4bb9a367c2dfc33fe07e.jpg"
      ],
      "image": "assets/images/258838/step_02.webp"
    },
    {
      "text": "Mix flour, bananas, 1/2 cup sugar, butter, walnuts, egg, baking soda, and salt together in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ob60aorT0FZLbmfWkeFBtduHZtk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/258838-Easy-Kids-Recipe-for-Fluffy-Banana-Cookies-ddmfs-step-2-031-dcccf76741f04958a2467d1458d65e16.jpg"
      ],
      "image": "assets/images/258838/step_03.webp"
    },
    {
      "text": "Drop 3-tablespoon portions dough onto the prepared baking sheet, about 2 to 3 inches apart. Sprinkle remaining 1 tablespoon sugar over cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qblxMDkClk1sroaDS2hp1gpSlco=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/258838-Easy-Kids-Recipe-for-Fluffy-Banana-Cookies-ddmfs-step-4-033-e04a1a81df4744d4847f5364ec99e69c.jpg"
      ],
      "image": "assets/images/258838/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown and edges are set, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
