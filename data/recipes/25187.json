  "ingredients": [
    "3 pounds chicken wings",
    "2 eggs, beaten",
    "0.5 cup all-purpose flour for coating",
    "0.75 cup oil for frying",
    "0.25 cup margarine",
    "6 tablespoons soy sauce",
    "6 tablespoons water",
    "2 cups white sugar",
    "1 cup vinegar",
    "2 tablespoons monosodium glutamate (MSG)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour egg beat into a shallow dish or bowl; do the same with the flour. Heat oil and margarine in a large, deep skillet over medium high heat. Dip wings in egg, then flour, then fry until browned and crisp. Lay browned wings in an 11x14 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Sauce: In a small bowl combine the soy sauce, water, sugar, vinegar and MSG. Blend well and pour sauce over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
