  "ingredients": [
    "0.25 cup oil",
    "1 (3 pound) rabbit, cleaned and cut into pieces",
    "1 large onion, chopped",
    "3 cloves garlic, chopped",
    "0.5 cup red wine",
    "1 bay leaf",
    "1 cube beef bouillon",
    "0.25 teaspoon ground nutmeg",
    "2 tablespoons tomato paste",
    "0.25 teaspoon white sugar",
    "salt and pepper to taste",
    "4 large potatoes, peeled and quartered",
    "2 carrots, chopped",
    "0.5 cup peas"
  ],
  "steps": [
    {
      "text": "Heat the oil in a large saucepan over medium heat; cook the rabbit, onion and garlic in the hot oil until the garlic and onion are fragrant and the rabbit is brown. Stir in the wine, bay leaf, beef bouillon, nutmeg, tomato paste, and sugar; season with salt and pepper. Add the potatoes, carrots, and peas. Pour enough water over everything until covered. Bring stew to a boil; reduce heat to low and allow to simmer until the potatoes are completely cooked through, about 1 hour.",
