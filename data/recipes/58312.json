  "ingredients": [
    "3.5 quarts water",
    "3 cinnamon sticks",
    "15 green cardamom pods, split open and seeded",
    "15 slices fresh ginger, peeled",
    "25 whole cloves",
    "3 whole black peppercorns",
    "8 black tea bags",
    "1 (14 ounce) can sweetened condensed milk"
  ],
  "steps": [
    {
      "text": "Combine water, cinnamon sticks, cardamom pods, ginger, cloves, and peppercorns in a slow cooker. Cook on High for 8 hours.",
