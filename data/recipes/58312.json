      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tea bags to the slow cooker and steep for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain liquid into a clean container; stir in condensed milk. Serve hot.",
