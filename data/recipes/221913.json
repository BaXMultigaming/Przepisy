  "ingredients": [
    "1.25 (16 ounce) cans refried beans with jalapeno peppers",
    "2 ripe avocados, halved and pitted",
    "0.75 cup sour cream",
    "0.5 cup mayonnaise",
    "0.5 envelope taco seasoning mix",
    "2 tomatoes, diced",
    "10 green onions, diced",
    "2 cups fresh bean sprouts",
    "2 cups grated Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Place refried beans into a bowl and mash until smooth. Scoop avocado out of the peels and mash with refried beans until thoroughly combined. Spread the bean mixture over a large platter in an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sour cream, mayonnaise, and taco seasoning in a bowl; spread in a layer over the bean mixture. Sprinkle tomatoes and green onions as a single layer, then top with a layer of bean sprouts. Sprinkle Cheddar cheese over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
