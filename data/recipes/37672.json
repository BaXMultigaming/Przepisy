  "ingredients": [
    "1 cup white sugar",
    "1 cup water",
    "1 cup mashed banana"
  ],
  "steps": [
    {
      "text": "In a small saucepan, stir together sugar and water. Bring to a boil, then remove from heat and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When the sugar syrup is cool, stir in bananas. Pour into a freezer - safe baking dish. Freeze for 3 to 4 hours, until set at the edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the freezer and transfer to a mixing bowl. Use an electric mixer to beat until smooth. Return to the freezer until gently set, at least 2 hours.",
      "section": null,
