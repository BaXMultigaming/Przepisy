  "ingredients": [
    "1.5 pounds large baking potatoes",
    "0.25 cup olive oil",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon chili powder",
    "0.25 teaspoon ground cumin"
  ],
  "steps": [
    {
      "text": "Cut each potato in half lengthwise. Place each half flesh-side down on the cutting board and cut each half lengthwise again to make 4 large wedges. Cut each wedge in half lengthwise again for a total of 8 wedges per potato.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of salted water to a boil. Add potato wedges and boil for about 10 minutes. Drain in a colander.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, salt, pepper, onion powder, chili powder, and cumin together in a bowl until smooth. Add wedges and gently toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Grill wedges for 4 minutes. Flip and grill for 4 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
