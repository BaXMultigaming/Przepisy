  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 onion, chopped",
    "2 cloves garlic, minced",
    "1 teaspoon dried thyme",
    "1 teaspoon dried rosemary",
    "1 teaspoon salt",
    "1 teaspoon pepper",
    "1 pound lean ground beef",
    "4 teaspoons all-purpose flour",
    "0.25 cup Heinz Tomato Ketchup",
    "0.75 cup Heinz® Tomato Juice",
    "2 tablespoons Heinz Worcestershire Sauce",
    "2 tablespoons Dijon mustard",
    "1 cup frozen mixed vegetables (such as peas and carrots)",
    "3 cups cooked, warm, mashed potatoes",
    "2 tablespoons butter",
    "1 clove garlic, minced",
    "0.66666668653488 cup warm milk"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eRU0cXOgkRvMVJm3tevcgMtZYjE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/217812-classic-shepherds-pie-VAT-step-01-1041f1dd6f7b4d28adc33da7cbc722f1.jpg"
      ],
      "image": "assets/images/217812/step_01.webp"
    },
    {
      "text": "Heat oil in a skillet set over medium heat. Add onion, garlic, thyme, rosemary, and 1/2 of the salt and pepper. Cook, stirring often, for 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uj9oU_3WrK4qddlC5nMC5l-g4Pg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/217812-classic-shepherds-pie-VAT-step-02-c463c454a79040f0ac4021c288c96874.jpg"
      ],
      "image": "assets/images/217812/step_02.webp"
    },
    {
      "text": "Crumble ground beef into pan and cook until brown all over. Sprinkle with flour. Stir in ketchup, tomato juice, Worcestershire sauce and mustard. Simmer for 5 minutes. Stir in mixed vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XcI8SdgVcMqOGvfQCZ3xpiHVDlo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/217812-classic-shepherds-pie-VAT-step-03-b7cd1f81b5f94d2c9780c88430ae6d39.jpg"
      ],
      "image": "assets/images/217812/step_03.webp"
    },
    {
      "text": "Transfer to a 9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Lw4TyzCTcTbPDSHb3x2EckYGIzA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/217812-classic-shepherds-pie-VAT-step-04-58a91e2bf462406d8af1c5404a938538.jpg"
      ],
      "image": "assets/images/217812/step_04.webp"
    },
    {
      "text": "Whip mashed potatoes with warm milk, remaining salt and pepper, butter, and garlic until very fluffy. Spread potatoes evenly over meat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G8XMk3FdEK_FT3Znd3XrYAlCtg8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/217812-classic-shepherds-pie-VAT-step-05-b39f1b1e7c334e30b1e2c63eef97d53d.jpg"
      ],
      "image": "assets/images/217812/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until potatoes are golden on top, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fTd6192o77t279aUs8qkXaUx5wM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/217812-classic-shepherds-pie-VAT-step-06-0869d937fe674b68b4d216866b20baab.jpg"
      ],
      "image": "assets/images/217812/step_06.webp"
    }
  ],
