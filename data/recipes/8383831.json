  "title": "Air Fryer Marinated Chicken",
  "description": "Chicken breasts are marinated for an hour in a Mexican-inspired marinade and then cooked in the air fryer for a quick weekday meal for 2.",
  "authors": [
    "thedailygourmet"
  ],
  "date_published": "2022-04-28T10:19:03-04:00",
