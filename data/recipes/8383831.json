  "ingredients": [
    "0.5 cup orange juice",
    "0.25 cup oil",
    "2 tablespoons pollo asado seasoning, divided",
    "1 tablespoon vinegar",
    "0.5 teaspoon granulated garlic",
    "2 (5 ounce) boneless, skinless chicken breasts"
  ],
  "steps": [
    {
      "text": "Combine orange juice, oil, 1 tablespoon pollo asado seasoning, vinegar, and garlic in a large container, or resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle remaining pollo asado seasoning on chicken. Add chicken to the marinade and refrigerate for 1 hour or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 370 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain off marinade from chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry until chicken is no longer pink in the center and the juices run clear, about 15 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
