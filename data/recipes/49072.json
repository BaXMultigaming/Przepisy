  "ingredients": [
    "0.25 cup applesauce",
    "0.75 cup white sugar",
    "2 egg whites",
    "0.25 cup butter, melted",
    "0.25 cup buttermilk",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon coffee flavored extract",
    "0.33333298563957 cup unsweetened cocoa powder",
    "0.25 cup all-purpose flour",
    "0.25 cup whole wheat pastry flour",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup chopped walnuts",
    "0.5 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8 inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the applesauce, white sugar, egg whites and butter until smooth. Mix in the buttermilk, vanilla extract and coffee extract. Combine the cocoa, all-purpose flour, whole wheat flour, baking powder and salt; stir into the sugar mixture just until incorporated. Spread the batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 minutes in the preheated oven, until a toothpick inserted in the center comes out clean, but the brownies are still moist. Cool, and cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
