  "ingredients": [
    "cooking spray",
    "1 cup whole wheat flour",
    "2 tablespoons stevia sugar substitute (such as Truvia®)",
    "1.5 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.5 cup almond milk",
    "0.25 cup egg substitute (such as Egg Beaters®)",
    "3 tablespoons unsweetened applesauce",
    "1 tablespoon unsalted butter, melted",
    "0.5 teaspoon pure vanilla extract",
    "1 cup sliced fresh strawberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line 6 muffin cups with paper liners; spray the inside of each paper liner with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar substitute, baking powder, and salt together in a bowl. Whisk almond milk, egg substitute, applesauce, butter, and vanilla extract together in a separate bowl; stir almond milk mixture into flour mixture. Fold in strawberries. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, 20 to 22 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
