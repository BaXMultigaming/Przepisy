  "ingredients": [
    "cooking spray",
    "12 wonton wrappers",
    "0.25 cup cream cheese",
    "1 teaspoon water, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay wonton wrappers on the prepared baking sheet. Place 1 teaspoon cream cheese in the center of each wonton wrapper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly brush the edges of wonton wrappers with water, then fold each wrapper in half to form a triangle. Press edges to seal. Fold the tips of each triangle together up and in to meet above the center of the wonton; press the tips together to seal. Spray assembled wontons with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until wontons are crispy and golden and cream cheese is melted, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
