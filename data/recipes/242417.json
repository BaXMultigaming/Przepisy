  "ingredients": [
    "0.5 cup barbeque sauce",
    "0.25 cup apple butter",
    "2 tablespoons brown sugar",
    "1 tablespoon ground black pepper",
    "2 cloves garlic, minced",
    "3 (4 ounce) pork chops"
  ],
  "steps": [
    {
      "text": "Whisk barbecue sauce, apple butter, brown sugar, black pepper, and garlic together in a microwave-safe bowl. Microwave until sugar dissolves, about 30 seconds; stir until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork chops in a rimmed dish; pour sauce over chops. Marinate in the refrigerator, 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook pork chops on the preheated grill until cooked through, about 15 minutes. An instant-read thermometer inserted into centers should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
