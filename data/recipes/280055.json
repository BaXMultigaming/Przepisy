  "ingredients": [
    "1 cup unsweetened applesauce",
    "1 cup packed brown sugar",
    "0.25 cup white sugar",
    "1 egg",
    "1 egg yolk",
    "2.5 cups all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir applesauce, brown sugar, and white sugar together in a large bowl until sugars dissolve. Stir in egg and egg yolk until well blended. Add flour, baking soda, and salt; mix into a smooth dough. Fold in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a disher scoop to drop uniform amounts of dough onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are dry and bottoms are golden brown, about 12 minutes. Transfer to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
