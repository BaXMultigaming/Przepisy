  "ingredients": [
    "8 apples, peeled and cut into bite-size pieces",
    "1.5 lemons, juiced",
    "2 cups chopped pecans",
    "1 cup mayonnaise (such as Hellman's®), or more to taste",
    "1 cup raisins",
    "1 teaspoon dried orange zest",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon celery seed",
    "0.25 teaspoon salt",
    "1 pinch stevia powder, or to taste"
  ],
  "steps": [
    {
      "text": "Place apples in a large bowl and sprinkle lemon juice over the top; toss to coat. Stir pecans, mayonnaise, raisins, orange zest, vanilla extract, celery seed, salt, and stevia into apples until well-combined. Cover the bowl with plastic wrap and refrigerate until chilled, about 30 minutes.",
