  "ingredients": [
    "3.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 cups packed brown sugar",
    "1 cup butter-flavored shortening",
    "2 large eggs",
    "0.5 cup milk",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "2 cups maraschino cherries, chopped",
    "2 cups milk chocolate chunks"
  ],
  "steps": [
    {
      "text": "Combine flour, baking soda, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, shortening, and eggs in a large bowl with an electric mixer until well combined. Mix in milk, vanilla, and almond extract. Add flour mixture gradually, beating well after each addition. Stir in cherries and chocolate chunks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place dough in the refrigerator for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop heaping tablespoons of dough 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the edges are golden, 8 to 10 minutes, switching racks halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
