  "title": "Chewy Chocolate-Cherry Cookies",
  "description": "Tart-sweet bits of maraschino cherries add vibrant color and chewy texture to chocolate chip cookies made with chunks of creamy milk chocolate.",
  "authors": [
    "Heather Gillaspy"
  ],
  "date_published": "2022-02-28T09:43:31-05:00",
