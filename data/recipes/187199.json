  "ingredients": [
    "1 cup blue cornmeal",
    "1 cup all-purpose flour",
    "5 teaspoons baking powder",
    "0.25 cup white sugar",
    "1 pinch salt",
    "2 eggs, beaten",
    "1 cup milk",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cornmeal, flour, baking powder, sugar, and salt in a bowl. Sift 3 times. Stir in beaten eggs and milk until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in the prepared baking dish and melt in the preheated oven. Pour hot, melted butter into cornmeal mixture and mix until incorporated. Transfer batter to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on the center rack in the preheated oven until the edges of cornbread pull away from the sides of the dish and a toothpick inserted into the center comes out clean, 30 to 35 minutes. Let cool for 10 minutes before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
