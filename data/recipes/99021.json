  "ingredients": [
    "0.75 cup white wine",
    "0.5 cup soy sauce",
    "0.25 cup vegetable oil",
    "2 tablespoons water",
    "1 clove garlic, chopped",
    "1 teaspoon ground ginger",
    "0.25 teaspoon dried oregano",
    "1 tablespoon brown sugar",
    "2 pounds skinless, boneless chicken breast"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk the white wine, soy sauce, vegetable oil, water, garlic, ginger, oregano, and brown sugar together in a bowl. Arrange the chicken breasts in a covered baking dish; pour the sauce over the chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake covered in the preheated oven for 1 hour, turn and cook until no longer pink in the center and the juices run clear, about 30 minutes more. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
