  "ingredients": [
    "1.5 cups mayonnaise",
    "0.66666698455811 cup grated Parmesan cheese",
    "0.66666698455811 cup shredded Swiss cheese",
    "0.33333298563957 cup chopped onion",
    "2 teaspoons Worcestershire sauce",
    "10 drops hot pepper sauce",
    "1 (4 ounce) can small shrimp, drained",
    "1 (6 ounce) can crabmeat, drained and flaked",
    "2 (2.1 ounce) packages mini phyllo tart shells",
    "paprika"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease a medium baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together mayonnaise, Parmesan cheese, Swiss cheese, onion, Worcestershire sauce and hot pepper sauce. Gently stir in shrimp and crabmeat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form phyllo dough into shells. Fill shells with the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange stuffed shells on baking sheet. Bake in the preheated oven 7 to 10 minutes, or until lightly browned. Sprinkle with paprika before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
