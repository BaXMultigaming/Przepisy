  "ingredients": [
    "1 cup white sugar",
    "2 tablespoons cornstarch",
    "1 cup boiling water",
    "2.5 quarts fresh strawberries",
    "2 (8 inch) pie shells, baked",
    "1 (3 ounce) package strawberry flavored Jell-O®"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
