  "ingredients": [
    "1 cup Blue Diamond Almond Flour",
    "2 tablespoons granulated sugar",
    "0.25 teaspoon salt",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "1 large egg",
    "1 teaspoon lemon juice",
    "0.5 cup Almond Breeze Unsweetened Vanilla almondmilk",
    "2 tablespoons vegetable oil",
    "0.5 cup fresh blueberries, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat griddle to 350 degrees F or heat frying pan over medium heat until a fleck of water \"dances\" in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk almond flour, sugar, salt, baking powder, and baking soda. Add egg, lemon juice, almondmilk, and oil. Whisk until combined (batter may be slightly lumpy).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently fold in desired amount of blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook pancakes immediately, flipping halfway, on griddle or in pan greased with cooking spray. Serve warm with syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
