    "publisher-tested"
  ],
  "ingredients": [
    "1 cup butter",
    "1 pound chopped nuts",
    "1 teaspoon ground cinnamon",
    "1 (16 ounce) package phyllo dough",
    "1 cup water",
    "1 cup white sugar",
    "0.5 cup honey",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F(175 degrees C). Butter the bottoms and sides of a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/87Mgb-xwet_yDVA5OPzHAs9kwZM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9454-Greek-Baklava-mfs-STEP-001-07ae1dcb30ab4f63b154a02f6ced7050.jpg"
      ],
      "image": "assets/images/9454/step_01.webp"
    },
    {
      "text": "Chop nuts; toss with cinnamon in a bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NKHKnoJ0a4td4E39_-Tz0eVD1oQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9454-Greek-Baklava-mfs-STEP-003-07b605749e2e4b658f5d9021ace6479d.jpg"
      ],
      "image": "assets/images/9454/step_02.webp"
    },
    {
      "text": "Unroll phyllo dough. Cut whole stack in half to fit pan. Cover phyllo with a dampened cloth to keep from drying out as you work. Place two sheets of dough in pan, thoroughly brush with butter using a pastry brush. Repeat until you have 8 sheets layered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gPvcyLk0IFqvsS8c1kmP58rI4L0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9454-Greek-Baklava-mfs-STEP-009-ffa990977d334a21b353af63965b04ec.jpg"
      ],
      "image": "assets/images/9454/step_03.webp"
    },
    {
      "text": "Sprinkle 2 to 3 tablespoons cinnamon-nut mixture on top; layer with two sheets of dough, brush with melted butter, and top with more cinnamon-nut mixture. Continue layering in this way until nut mixture is used up, finishing with a final layer of phyllo about 6 to 8 sheets deep.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QukIJkclLTSaPk4e57iZ7RpMjf4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9454-Greek-Baklava-mfs-STEP-021-6971a6c7bd514a52afe974ec1f7f664a.jpg"
      ],
      "image": "assets/images/9454/step_04.webp"
    },
    {
      "text": "Cut into diamond or square shapes all the way to the bottom of the pan using a sharp knife. You may cut into 4 long rows then make diagonal cuts. Bake until baklava is golden and crisp, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s2cxpjWUn-s0ifFSK1WU96m8sAs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9454-Greek-Baklava-mfs-STEP-038-881ddece12c14d2aa34ce71016569531.jpg"
      ],
      "image": "assets/images/9454/step_05.webp"
    },
    {
      "text": "Make sauce while baklava is baking. Boil sugar and water until sugar is melted. Add honey and vanilla; simmer for about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zcBrVnQm097K_1uWMkxHmbkdfhc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9454-Greek-Baklava-mfs-STEP-046-00102249163d423aac9f446985b87c7a.jpg"
      ],
      "image": "assets/images/9454/step_06.webp"
    },
    {
      "text": "Remove baklava from the oven; immediately spoon sauce over top. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ktH5Zri4wm5dKzQfYFvvtZ9bMqI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9454-Greek-Baklava-mfs-STEP-047-a410c92595d44a359859686ce5b6d449.jpg"
      ],
      "image": "assets/images/9454/step_07.webp"
    },
    {
      "text": "Once completely cooled, serve baklava in cupcake papers to make it easier to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pyuf8isAIhLaiRz6Nixp2Kc7FRw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9454-Greek-Baklava-mfs-STEP-049-89d5424dc6cb4ae78801af223c31eabe.jpg"
      ],
      "image": "assets/images/9454/step_08.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ey6wTWvSrhdy-5OYOd62bRxLBic=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9454-Greek-Baklava-DDMFS-4x3-c075b25eb1bd446499b0ae04ea6d2375.jpg"
      ],
      "image": "assets/images/9454/step_09.webp"
    }
  ],
