  "title": "Chicken Stock",
  "description": "Slices of fresh ginger and bay leaves season this chicken stock to use as a base for soups and sauces.",
  "authors": [
    "Margaret Price"
  ],
  "date_published": "1999-01-17T18:15:29-05:00",
