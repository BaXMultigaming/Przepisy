  "ingredients": [
    "cooking spray",
    "2 cups whole wheat flour",
    "1 tablespoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1 cup finely chopped apples",
    "0.75 cup nonfat milk",
    "0.25 cup vegetable oil",
    "0.25 cup maple syrup",
    "0.25 cup brown sugar",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 12 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix whole wheat flour, baking powder, cinnamon, and salt together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix apples, nonfat milk, vegetable oil, maple syrup, and brown sugar in another bowl. Gently fold in egg. Pour into flour mixture. Stir until batter is lumpy and just moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the middle comes out clean, about 20 minutes. Cool in the tin for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
