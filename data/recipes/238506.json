  "ingredients": [
    "0.66666668653488 cup Marsala wine",
    "0.25 cup ketchup",
    "6 cloves garlic, minced",
    "2 teaspoons kosher salt",
    "1 teaspoon dried rosemary",
    "1 teaspoon ground black pepper",
    "1 (1 1/2-pound) skirt steak, cut in half across the grain"
  ],
  "steps": [
    {
      "text": "Whisk wine, ketchup, garlic, salt, rosemary, and black pepper together in a large glass or ceramic bowl. Add skirt steak and turn to evenly coat. Cover the bowl with plastic wrap; marinate in the refrigerator for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove steak from marinade and shake off excess; discard marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook steak on the preheated grill until steak shines, 3 to 4 minutes per side. An instant-read thermometer inserted into center should read 130 degrees F (54 degrees C). Transfer to a plate; rest at least 5 minutes before slicing against the grain.",
      "section": null,
      "name": null,
      "url": null,
