    {
      "text": "Place chicken in a large pot with onion, carrots, celery, and peppercorns; add water to cover by 1 inch.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PlobOGJvrTxLMqbQNEa-CV29NBc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20455-boiled-chicken-step-2-0623-1-9b2423bcc38b4dcab2e9bb67d0694d50.jpg"
      ],
      "image": "assets/images/20455/step_02.webp"
    },
    {
      "text": "Cover the pot and bring to a boil; reduce heat to a gentle boil and cook until meat falls off the bone, about 90 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hwl0-fn4pUWutx6qO77pX03MaB8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20455-boiled-chicken-step-3-0625-1-7f6c9c16c522467fa61a67398f3dcf7d.jpg"
