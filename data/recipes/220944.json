  "title": "Bud's Easy Buttercream Pound Cake",
  "description": "A rich lemon-poppyseed pound cake has the easiest 2-ingredient frosting ever. Just beat the ingredients, pour into a tube pan, and bake. It makes a great Easter dessert.",
  "authors": [
    "Bud"
  ],
  "date_published": "2019-07-10T03:03:12-04:00",
  "date_modified": "2019-07-10T03:03:12-04:00",
  "prep_time": "PT15M",
  "cook_time": "PT75M",
  "total_time": "PT150M",
  "yield": [
    "16",
    "1 10-inch tube cake"
  ],
