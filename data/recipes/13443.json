  "ingredients": [
    "1 pound cubed lamb meat",
    "1 onion, chopped",
    "1 red onion, chopped",
    "0.75 cup chopped celery",
    "0.5 cup chopped fresh cilantro",
    "2 tablespoons margarine",
    "1.5 teaspoons ground black pepper",
    "1 teaspoon ground turmeric",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground cayenne pepper",
    "1 (29 ounce) can diced tomatoes",
    "7 cups water",
    "0.75 cup green lentils",
    "1 (15 ounce) can garbanzo beans, drained",
    "4 ounces vermicelli pasta",
    "2 eggs, beaten",
    "1 lemon, juiced"
  ],
  "steps": [
    {
      "text": "Combine lamb, onions, celery, cilantro, margarine, pepper, turmeric, cinnamon, ginger, and cayenne in a large soup pot over low heat. Cook, stirring frequently, for 5 minutes. Pour in tomatoes (without juice) and simmer for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add water, reserved tomato juice, and lentils. Bring to a boil, then reduce the heat, cover, and simmer for 1 hour 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase the heat to medium-high and add garbanzo beans and vermicelli pasta. Cook until noodles are tender yet firm to the bite, about 10 minutes. Stir in eggs and lemon juice and cook for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
