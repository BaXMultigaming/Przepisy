  "ingredients": [
    "2 tablespoons cooking oil",
    "1 large onion, thinly sliced",
    "4 cloves garlic, minced",
    "1 teaspoon ground cumin",
    "1 teaspoon ground coriander",
    "0.5 teaspoon ground turmeric",
    "0.5 teaspoon Kashmiri red chili powder",
    "4 tomatoes, pureed",
    "0.5 pound paneer, cubed",
    "0.25 cup water",
    "1 teaspoon white sugar",
    "salt to taste",
    "0.25 cup cream",
    "2 tablespoons chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Add onion and garlic; cook until onion soft and golden brown, about 5 minutes. Season with cumin, coriander, turmeric, and chili powder; cook until fragrant, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add puréed tomatoes to the skillet; cook until excess liquid evaporates and oil separates, 3 to 5 minutes. Add paneer, water, sugar, and salt; stir gently so paneer does not break apart. Cook until paneer absorbs some liquid, about 10 minutes. Stir in cream; simmer 5 minutes. Garnish servings with cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
