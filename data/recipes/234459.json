  "ingredients": [
    "2.3333332538605 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.125 teaspoon salt",
    "1 cup butter",
    "1 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon lemon extract",
    "2 cups confectioners' sugar",
    "0.25 cup butter, melted",
    "1 tablespoon hot water, or as needed",
