  "ingredients": [
    "1 cup brown sugar",
    "0.75 cup margarine",
    "0.5 cup white sugar",
    "2 eggs",
    "0.33333334326744 cup milk",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cloves",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "1.5 cups quick-cooking oats",
    "1 cup golden raisins",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, margarine, and white sugar with an electric mixer in a large bowl until creamy. Beat in eggs until well blended; add milk and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, cloves, salt, and nutmeg together in a bowl. Add flour mixture to sugar mixture and beat until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oats, raisins, and walnuts into sugar mixture; chill dough for at least 30 minutes. Drop dough 2 to 3 inches apart by rounded tablespoons onto baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
