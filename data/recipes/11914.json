  "ingredients": [
    "1 pound lean ground beef",
    "8 ounces macaroni",
    "0.5 cup chopped onion",
    "1 (10.75 ounce) can condensed tomato soup",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (1.25 ounce) package taco seasoning mix",
    "2 ounces shredded Cheddar cheese",
    "2 ounces shredded Monterey Jack cheese",
    "1 cup crushed tortilla chips",
    "0.5 cup sour cream",
    "0.25 cup chopped green onions"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook pasta in a large pot of boiling water until al dente. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, cook and stir ground beef and chopped onion over medium heat until brown. Mix in tomato soup, diced tomatoes, and taco seasoning mix. Stir in pasta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon beef mixture into a 9x13 inch baking dish. Sprinkle crumbled taco chips and grated cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 to 35 minutes, until the cheese is melted. Serve with chopped green onions and sour cream, if desired.",
      "section": null,
      "name": null,
