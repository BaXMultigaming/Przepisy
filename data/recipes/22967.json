  "ingredients": [
    "2 small very ripe bananas, sliced",
    "1 cup white sugar",
    "0.5 cup buttermilk",
    "0.5 cup vegetable oil",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.125 teaspoon salt",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bananas, sugar, buttermilk, oil, eggs, and vanilla in a blender; process until smooth. Sift together flour, cinnamon, baking powder, baking soda, and salt in a large bowl. Pour banana mixture over dry ingredients and mix well. Stir in nuts. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted into the center of loaf comes out clean, 55 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
