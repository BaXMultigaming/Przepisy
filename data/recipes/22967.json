  "title": "Nanna's Banana Bread",
  "description": "My nanna Towgood has been making this blender banana bread for over 40 years, and it's a family favorite — moist, flavorful, and just the right amount of sweetness.",
  "authors": [
    "SHARON PARENTEAU"
  ],
  "date_published": "2000-08-30T14:12:02-04:00",
