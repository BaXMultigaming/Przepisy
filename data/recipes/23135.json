  "title": "Pumpkin Cookies VI",
  "description": "A chewy pumpkin cookie made with oatmeal. You can substitute chocolate chips or nuts for the raisins.",
  "authors": [
    "Kathleen"
  ],
  "date_published": "2000-10-24T23:06:45-04:00",
