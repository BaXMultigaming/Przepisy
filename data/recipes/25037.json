  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup packed brown sugar",
    "0.75 cup unsalted butter, melted",
    "0.5 cup white sugar",
    "1 egg",
    "1 egg yolk",
    "1 tablespoon vanilla extract",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C). Grease cookie sheets or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LnkOqtGeTQTE0bV9PT48aACNl1E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25037-best-big-fat-chewy-chocolate-chip-cookie-ddmfs-step-1-2bf387a92cb24163abcbbc6ad3cd87fe.jpg"
      ],
      "image": "assets/images/25037/step_01.webp"
    },
    {
      "text": "Sift flour, baking soda, and salt together; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LgI3RPs5eGOmUwt2E_bLFF8pcwQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25037-best-big-fat-chewy-chocolate-chip-cookie-ddmfs-step-2-9daa6e7847864c859ad5a0db97561772.jpg"
      ],
      "image": "assets/images/25037/step_02.webp"
    },
    {
      "text": "Beat brown sugar, melted butter, and white sugar with an electric mixer in a large bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jwjbcSb9CWSXufmX_mop_qzNr5Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25037-best-big-fat-chewy-chocolate-chip-cookie-ddmfs-step-3-559b8d6024fe44d5a3ce37aa9b251a17.jpg"
      ],
      "image": "assets/images/25037/step_03.webp"
    },
    {
      "text": "Beat in egg, egg yolk, and vanilla until light and creamy; add flour mixture and stir until dough is just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1UPc5X8lySU7Yo1N9ARSJGFlUeM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25037-best-big-fat-chewy-chocolate-chip-cookie-ddmfs-step-5-cb71582ba9594e33a22473cc70b4ef8a.jpg"
      ],
      "image": "assets/images/25037/step_04.webp"
    },
    {
      "text": "Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7lUgRZBVmtkO0ncGplXIcsxMfZs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25037-best-big-fat-chewy-chocolate-chip-cookie-ddmfs-step-6-349ceadca0cd406b8d2ed3b7a53c4fdf.jpg"
      ],
      "image": "assets/images/25037/step_05.webp"
    },
    {
      "text": "Drop spoonfuls of dough 3 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HbR0Q-bjY4Z8pHjhuhu0XMM9eRM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25037-best-big-fat-chewy-chocolate-chip-cookie-ddmfs-step-7-4491dbe8e3324dad97ac02749de68c4c.jpg"
      ],
      "image": "assets/images/25037/step_06.webp"
    },
    {
      "text": "Bake cookies in the preheated oven until edges are golden, about 15 to 17 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h9_bOWYPCP2E88VPoFEZlJAXFWE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25037-best-big-fat-chewy-chocolate-chip-cookie-ddmfs-step-8-c70d194ef06644e988272babae693446.jpg"
      ],
      "image": "assets/images/25037/step_07.webp"
    },
    {
      "text": "Cool on the cookie sheets briefly before transferring them to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
