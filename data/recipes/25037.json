        "https://www.allrecipes.com/thmb/GpNqyTftluPyp627Q8Ei4j9L6b8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25037-best-big-fat-chewy-chocolate-chip-cookie-ddmfs-beauty-4x3-4f6288eb3e904ba8be1c400cdcd178b0.jpg"
      ],
