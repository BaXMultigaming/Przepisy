  "ingredients": [
    "cooking spray",
    "1 teaspoon minced garlic",
    "1 (4 ounce) fillet swai fish",
    "1 pinch Greek seasoning, or to taste"
  ],
  "steps": [
    {
      "text": "Coat a nonstick skillet with cooking spray; heat over medium-high heat. Add garlic; cook and stir until lightly browned and fragrant, about 1 minute. Move garlic to one side of the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fillet in the skillet; season with Greek seasoning. Spoon garlic on top of fillet; cook until edges of fillet are white and bottom is browned, about 5 minutes. Flip fillet; cook until it easily flakes with a fork, about 5 minutes more.",
      "section": null,
