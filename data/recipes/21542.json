  "title": "Sweet and Sour Fish",
  "description": "This sweet and sour fish recipe pairs deep-fried halibut with a sweet and sour sauce. Cod or any other white fish can be used instead of halibut.",
  "authors": [
    "ASUAYAN"
  ],
  "date_published": "2000-06-06T11:34:57-04:00",
