  "ingredients": [
    "1 pound halibut",
    "1 tablespoon soy sauce",
    "1 tablespoon all-purpose flour",
    "2 cups oil for deep frying",
    "1 tablespoon vegetable oil",
    "1 medium green bell pepper, diced",
    "1 medium onion, diced",
    "1 (8 ounce) can pineapple chunks, juice reserved",
    "3 tablespoons ketchup",
    "1.5 tablespoons white sugar",
    "1 tablespoon water",
    "2 teaspoons all-purpose flour",
    "1 teaspoon sesame oil",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Cut halibut into bite-sized pieces. Place in a mixing bowl and combine with soy sauce and 1 tablespoon of flour. Let stand for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat oil in deep-fryer or heavy saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Deep-fry halibut pieces until golden brown. Drain on paper towels; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make sauce: Heat oil in a medium skillet over medium heat. Add bell pepper, onion, and pineapple chunks and sauté for 1 minute. Stir in pineapple juice, ketchup, sugar, water, 2 teaspoons flour, sesame oil, and salt. Cook until thickened, stirring occasionally, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the sauce over the halibut pieces to serve, or serve halibut alongside the sauce for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
