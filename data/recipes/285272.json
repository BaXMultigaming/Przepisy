  "ingredients": [
    "nonstick cooking spray",
    "0.75 cup all-purpose flour",
    "2 tablespoons white sugar, divided",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "0.125 teaspoon salt",
    "6 tablespoons milk, divided",
    "4 tablespoons unsalted butter, melted, divided",
    "1 teaspoon apple cider vinegar",
    "0.75 teaspoon vanilla extract, divided",
    "0.25 cup chocolate chips",
    "3 tablespoons light brown sugar",
    "1 teaspoon ground cinnamon",
    "0.5 cup powdered sugar",
    "1 tablespoon unsalted butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray 6 cups of a 12-cup muffin tin pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, 1 tablespoon white sugar, baking powder, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 5 tablespoons milk, 2 tablespoons melted butter, cider vinegar, and 1/4 teaspoon vanilla in a separate bowl. Pour into the flour mixture and mix until it a soft dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat the dough on a heavily floured surface into a thin rectangle. Brush or pour remaining melted butter over dough. Combine chocolate chips, brown sugar, cinnamon, and remaining white sugar in a bowl; pour over the buttered dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully roll the dough up, away from you. Once rolled, pinch the entire seam shut. Cut into six pieces and place each one in a prepared muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While rolls bake, combine powdered sugar, softened butter, remaining 1 tablespoon milk, and 1/2 teaspoon vanilla together for icing. Mix until it becomes desired consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cupcake pan from the oven and top rolls with icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
