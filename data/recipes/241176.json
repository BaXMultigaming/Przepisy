  "ingredients": [
    "5 cups chopped apples",
    "0.25 cup rice flour",
    "3 tablespoons white sugar",
    "1 teaspoon ground cinnamon",
    "0.75 cup brown sugar",
    "0.5 cup butter, softened",
    "0.5 cup rice flour",
    "0.5 cup quinoa flakes",
    "0.5 cup rice flakes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine apples, 1/4 cup rice flour, white sugar, and cinnamon in a bowl; transfer to an 8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, butter, 1/2 cup rice flour, quinoa flakes, and rice flakes in the same bowl used for apple mixture. Sprinkle crumble topping over apple mixture and pat down gently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apples are tender and topping is slightly browned, 35 minutes.",
      "section": null,
