  "ingredients": [
    "1.5 pounds ground turkey breast",
    "2 tablespoons water",
    "1 tablespoon liquid smoke flavoring",
    "1 teaspoon kosher salt",
    "0.25 teaspoon pink curing salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon smoked paprika",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon ground dried sage"
  ],
  "steps": [
    {
      "text": "Combine ground turkey, water, liquid smoke, kosher salt, pink salt, pepper, onion powder, paprika, garlic powder, and sage in a large bowl. Mix until evenly combined. Cover and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form as many sticks as you can fit on the racks of a dehydrator using a jerky gun.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set the dehydrator to 155 degrees F (68 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook for 2 1/2 hours. Unplug the dehydrator and remove the lid. Let jerky sit for 1 hour for final drying.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
