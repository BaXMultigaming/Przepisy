  "ingredients": [
    "1 egg",
    "0.33333334326744 cup 1% milk",
    "0.33333334326744 cup grated Parmesan cheese",
    "1 teaspoon crushed garlic",
    "salt and pepper to taste",
    "2 (10 ounce) packages frozen chopped spinach, thawed and drained"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl whisk together egg, milk, cheese, garlic, salt and pepper. Fold in spinach. Place in a small casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 minutes, or until lightly set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "NOTE: If you are in a hurry, use a microwave safe casserole dish, cover with plastic wrap, and cook on high for 3 minutes. Release the steam, recover, and cook on high for another 3 minutes. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
