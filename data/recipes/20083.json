  "ingredients": [
    "1 onion, chopped",
    "2 tablespoons butter",
    "1 pound fresh asparagus, trimmed and coarsely chopped",
    "1 cup vegetable broth",
    "1 dash garlic powder",
    "1 dash white pepper",
    "1 cup 1% milk"
  ],
  "steps": [
    {
      "text": "Microwave onion and butter on HIGH for 2 minutes. Add asparagus, vegetable broth, garlic powder and white pepper. Microwave, covered, on HIGH for 10 to 12 minutes. Puree in blender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return mixture to microwave safe dish, stir in milk and microwave until heated through.",
