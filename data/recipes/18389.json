  "ingredients": [
    "2 apples",
    "2 tablespoons brown sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "2 teaspoons butter"
  ],
  "steps": [
    {
      "text": "Core apples, leaving the bottom intact.",
      "section": null,
      "name": null,
      "url": null,
