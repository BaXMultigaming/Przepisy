  "ingredients": [
    "1 pound Brussels sprouts, trimmed",
    "6 slices bacon, cut into 1/2-inch pieces",
    "1 medium red onion, diced",
    "1 teaspoon extra-virgin olive oil",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon sea salt",
    "0.25 cup pine nuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Brussels sprouts, bacon, onion, olive oil, garlic powder, cayenne, and salt together in a large bowl. Spread evenly on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until bacon is crispy and reaches 145 degrees F (63 degrees C), about 40 minutes, stirring after 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven. Toss with pine nuts and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
