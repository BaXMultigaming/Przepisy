  "ingredients": [
    "3 cups bread flour",
    "1 cup milk",
    "5 tablespoons white sugar",
    "0.25 cup butter, melted",
    "1 egg",
    "2.25 teaspoons instant yeast",
    "1.5 teaspoons salt",
    "2 tablespoons butter, softened",
    "1 cup chocolate-hazelnut spread (such as Nutella®)",
    "0.5 cup coarsely chopped hazelnuts"
  ],
  "steps": [
    {
      "text": "Put bread flour, milk, white sugar, 1/4 cup melted butter, egg, yeast, and salt in a bread machine; set to \"dough\" cycle and press Start.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease and 9x12-inch baking dish and line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer dough to a floured work surface and punch dough. Roll dough into a large rectangle. Spread 2 tablespoons softened butter over dough and top with chocolate-hazelnut spread. Sprinkle hazelnuts over chocolate layer. Roll dough around the filling into a log shape; cut into 12 even portions. Arrange rolls in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until rolls are cooked through, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
