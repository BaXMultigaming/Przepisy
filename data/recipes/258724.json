  "ingredients": [
    "4 bananas",
    "1 cup brown sugar",
    "2 egg whites",
    "1 egg",
    "3 tablespoons canola oil",
    "1.25 cups whole wheat flour",
    "1 cup rolled oats",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking powder",
    "12 paper muffin cup liners"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 12 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash bananas in a bowl until no lumps remain. Add brown sugar, egg whites, egg, and canola oil; mix thoroughly. Stir flour, oats, baking soda, salt, and baking powder into the batter until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill muffin cup 2/3-full with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
