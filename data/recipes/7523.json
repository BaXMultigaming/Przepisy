  "ingredients": [
    "1 cup butter",
    "2 cups white sugar",
    "1 cup water",
    "3.5 cups all-purpose flour",
    "2.5 teaspoons baking powder",
    "1 teaspoon vanilla extract",
    "4 egg whites",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Cream butter and sugar; add water. Mix flour, baking powder and salt; fold into creamed mixture. Mix well; stir in vanilla. Beat egg whites until stiff and fold into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter evenly in a greased and floured lamb mold (cast iron if you have one or tin). Bake at 350 degrees F (175 degrees C) for 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
