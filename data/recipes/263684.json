  "ingredients": [
    "2 tablespoons red wine",
    "2 cloves garlic, chopped",
    "5 whole allspice berries",
    "4 juniper berries",
    "3 whole cloves",
    "1.5 teaspoons whole black peppercorns",
    "1 teaspoon fennel seeds",
    "0.5 teaspoon whole white peppercorns",
    "0.5 teaspoon red pepper flakes",
    "2.5 tablespoons salt",
    "0.5 teaspoon Prague Powder #2",
    "0.25 teaspoon freshly grated nutmeg",
    "2 pounds pork belly"
  ],
  "steps": [
    {
      "text": "Combine wine and garlic. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine allspice berries, juniper berries, cloves, black peppercorns, fennel seeds, white peppercorns, and red pepper flakes in a spice grinder or mortar and pestle. Grind to a fine powder. Add salt, Prague powder, and nutmeg and stir well to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork belly in a glass or ceramic dish. Cover on all sides with the spice mixture. Pour wine mixture evenly on top. Cover with a wire rack and then with a large piece of muslin; the rack prevents the muslin from touching the pork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate for 2 weeks. After 2 weeks, slice the pancetta and use in your favorite recipe, or pan fry as you would bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uSplK4bbxXMI1E7xEKo0G_dHYJo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/5290647-0c27eb48e62b4689b3e84bd976722ff1.jpg"
      ],
