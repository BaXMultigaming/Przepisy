  "ingredients": [
    "1.5 cups crushed chocolate sandwich cookies",
    "0.25 cup butter, melted",
    "1 quart mint chocolate chip ice cream",
    "4 tablespoons creme de menthe liqueur",
    "1 cup crushed chocolate sandwich cookies",
    "3 egg whites",
    "salt to taste",
    "0.25 teaspoon cream of tartar",
    "2 teaspoons creme de menthe liqueur",
    "0.33333334326744 cup white sugar"
  ],
  "steps": [
    {
      "text": "Combine 1 1/2 cups cookie crumbs and melted butter or margarine. Press firmly over bottom and up the sides of a 9 inch pie pan. Freeze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread half of softened ice cream in crust. Drizzle 2 tablespoons creme de menthe and sprinkle 1/2 cup cookie crumbs over the ice cream. Repeat. Freeze till firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a clean bowl, beat egg whites until foamy. Add salt and cream of tartar, and beat until slightly stiff. Gradually beat in sugar until peaks form. Fold in 2 teaspoons creme de menthe. Spread meringue over pie, and seal to edges. Freeze up to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Just before serving, broil until top is golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
