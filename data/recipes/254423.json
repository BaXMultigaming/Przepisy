  "ingredients": [
    "1 teaspoon butter, softened",
    "1 teaspoon all-purpose flour",
    "1 (16.5 ounce) can cream-style corn",
    "4 eggs, separated",
    "0.125 teaspoon cayenne pepper",
    "1 teaspoon cream of tartar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 4-cup souffle dish with butter. Dust dish with flour; tap out excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream-style corn, egg yolks, and cayenne pepper in a large bowl with an electric mixer until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites with cream of tartar in another bowl with an electric mixer until stiff peaks form. Fold a large spoonful of whipped egg whites into corn mixture until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold corn mixture into remaining egg whites. Pour into the prepared souffle dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until souffle is golden brown and center is set, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
