  "ingredients": [
    "4 cups chopped rhubarb",
    "1.5 cups water",
    "0.5 cup white sugar",
    "1 (3 ounce) package strawberry-flavored gelatin mix (such as Jell-O®)"
  ],
  "steps": [
    {
      "text": "Combine rhubarb, water, and sugar in a saucepan over medium-high heat; bring to a boil. Reduce the heat and simmer until rhubarb is soft, 15 to 20 minutes. Stir in gelatin mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat and let cool to room temperature, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour rhubarb sauce into a bowl. Serve immediately or cover and refrigerate for a chilled sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
