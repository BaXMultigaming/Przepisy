  "ingredients": [
    "0.5 cup butter",
    "3 cloves garlic, minced",
    "0.25 cup white wine",
    "1 teaspoon lemon pepper",
    "2 tablespoons prepared yellow mustard",
    "0.25 teaspoon red pepper flakes",
    "2 pounds fresh shrimp, peeled and deveined",
    "1 tablespoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Saute garlic in butter until tender, 1 to 2 minutes. Pour in the wine. Season with lemon pepper, mustard, and red pepper flakes. Stir in shrimp, and cook 5 minutes, or until shrimp is done. Sprinkle with chopped parsley.",
