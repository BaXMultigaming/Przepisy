  "ingredients": [
    "oil for the grill",
    "1 pound sirloin steak",
    "1 tablespoon garlic salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon ground cumin",
    "ground cayenne pepper to taste",
    "4 kaiser rolls, split",
    "0.25 cup mayonnaise",
    "0.5 cup refried beans",
    "1 large avocado, thinly sliced",
    "1 large tomato, sliced",
    "2 cups shredded lettuce",
    "1 ounce crumbled cotija cheese"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season steak with garlic salt, black pepper, cumin, and cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill on the preheated grill until medium-rare, about 5 minutes per side. Transfer steak to a cutting board and cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat a large skillet over medium-high heat. Spread both halves of each roll with mayonnaise. Brown rolls, mayonnaise-side down, until golden, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place refried beans in a microwave-safe bowl; microwave on high until warmed through, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice sirloin steak against the grain into thin strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread a thin layer of beans on bottom half of each roll. Layer with steak, avocado, tomato, and lettuce. Top with cheese and top half of roll.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
