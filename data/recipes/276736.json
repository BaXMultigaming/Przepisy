  "ingredients": [
    "cooking spray",
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "3 tablespoons freshly grated lemon zest, preferably organic",
    "0.25 cup freshly squeezed lemon juice",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "2 tablespoons all-purpose flour",
    "0.5 cup powdered sugar",
    "2 tablespoons powdered sugar for sprinkling"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly coat a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wv0bWo52QzGok4TlyTnf_sVdlwc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276736-soft-lemon-cookies-from-scratch-DDMFS-step-01-4c43fae799c942c180a0a4bb9cbf2dc6.jpg"
      ],
      "image": "assets/images/276736/step_01.webp"
    },
    {
      "text": "Beat sugar and butter together in a bowl with an electric mixer on medium speed until light and fluffy. Add lemon zest, lemon juice, egg, and vanilla extract; beat on low speed to combine, scraping down the sides of the bowl to evenly incorporate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9GjkC-5YE0DZPhyI0Z7LU10SGJ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276736-soft-lemon-cookies-from-scratch-DDMFS-step-02-b901a90ed7cb48269ba8a87afa2ca1b8.jpg"
      ],
      "image": "assets/images/276736/step_02.webp"
    },
    {
      "text": "Combine 1 ½ cups flour, baking powder, baking soda, and salt in a small bowl; beat into sugar mixture on low speed until just incorporated. Beat in remaining 2 tablespoons flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mI3yvI59SW5xLykB-WvjcolnV7w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276736-soft-lemon-cookies-from-scratch-DDMFS-step-03-f3bf03fca0d741c0a9570cc836db83f0.jpg"
      ],
      "image": "assets/images/276736/step_03.webp"
    },
    {
      "text": "Place ½ cup confectioners' sugar in a small bowl; drop in teaspoonfuls of dough and roll until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PYh4pOiYREIDPmcpmXqDXPeI5hw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276736-soft-lemon-cookies-from-scratch-DDMFS-step-04-5d2ee997aeb84054974f12bad743a6b8.jpg"
      ],
      "image": "assets/images/276736/step_04.webp"
    },
    {
      "text": "Place on the prepared baking sheet, 1 to 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BC7N_ai8hKKzFnotqz9hHpub6Mw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276736-soft-lemon-cookies-from-scratch-DDMFS-step-05-a57288ce780b44d8a7fbdf4f8ab7fd0f.jpg"
      ],
      "image": "assets/images/276736/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are light brown, 9 to 11 minutes. Cool on the baking sheet for 3 minutes, then transfer to a wire rack to cool; sprinkle with remaining 2 tablespoons confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q0-_RlJRyh0sMrekr0SqHNaUW2g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276736-soft-lemon-cookies-from-scratch-DDMFS-step-06-086a7504816540568b2744ede7ff08eb.jpg"
      ],
      "image": "assets/images/276736/step_06.webp"
    }
  ],
