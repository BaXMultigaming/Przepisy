  "ingredients": [
    "cooking spray",
    "2 cups soy milk",
    "0.75 cup unsweetened applesauce",
    "2 tablespoons white vinegar",
    "4 teaspoons vanilla extract",
    "2.5 cups white whole wheat flour",
    "2 cups turbinado sugar",
    "1 cup whole wheat flour",
    "1 cup rolled oats",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "1 cup diced strawberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 2 muffin tins with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix soy milk, applesauce, vinegar, and vanilla extract together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift white whole wheat flour and whole wheat flour together into a separate bowl. Add oats, baking soda, and salt in a separate bowl. Mix in soy milk mixture until smooth. Let batter sit for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold strawberries into the batter. Fill muffin tins 2/3 full of batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until muffin tops are brown and sides pull away from the tin, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
