  "ingredients": [
    "2 cups uncooked short-grain white rice",
    "1 (14 ounce) can unsweetened coconut milk",
    "1 cup chicken stock",
    "2 tablespoons white sugar",
    "1 teaspoon fine sea salt"
  ],
  "steps": [
    {
      "text": "Rinse rice under cold tap water until water runs clear. Soak rice in a bowl of water for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine coconut milk, chicken stock, sugar, and salt in a multi-functional pressure cooker (such as Instant Pot®).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain rice and stir into the pressure cooker. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 5 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 10 minutes. Unlock lid and open carefully; fluff rice with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
