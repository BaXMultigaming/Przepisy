  "ingredients": [
    "4 large cucumbers, sliced",
    "salt and ground black pepper to taste",
    "0.5 cup half-and-half",
    "0.5 cup sour cream",
    "0.5 cup mayonnaise",
    "5 large green onions, thinly sliced",
    "1 (1 ounce) package ranch dressing mix (such as Lipton® Recipe Secrets®)",
    "1.5 tablespoons white sugar",
    "1 tablespoon dried dill weed",
    "1 teaspoon celery salt",
    "2 teaspoons lime juice"
  ],
  "steps": [
    {
      "text": "Layer cucumber slices in a large bowl, generously seasoning each layer of cucumber with salt and pepper. Cover the bowl with plastic wrap and refrigerate for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain liquid from cucumbers. Gently press cucumber slices with paper towels to absorb any remaining liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir half-and-half, sour cream, mayonnaise, green onions, ranch dressing mix, sugar, dill, celery salt, and lime juice together in a small bowl; pour over cucumber slices and gently stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
