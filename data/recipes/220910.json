  "ingredients": [
    "10 red potatoes, cut into cubes",
    "3 tablespoons all-purpose flour",
    "0.75 cup real bacon bits",
    "1 small red onion, chopped",
    "1 clove garlic, minced",
    "2 tablespoons chicken bouillon granules",
    "1 tablespoon ranch dressing mix",
    "2 teaspoons dried parsley",
    "1 teaspoon seasoned salt",
    "0.5 teaspoon ground black pepper",
    "3 cups water",
    "1 cup half-and-half",
    "0.5 cup shredded Cheddar cheese, or to taste",
    "0.25 cup chopped green onion, or to taste"
  ],
  "steps": [
    {
      "text": "Put potatoes in the bottom of your slow cooker crock. Scatter flour over the potatoes; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scatter bacon bits, red onion, garlic, chicken bouillon, ranch dressing mix, parsley, seasoned salt, and black pepper over the potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour water into the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low 7 to 9 hours.",
      "section": null,
      "name": null,
