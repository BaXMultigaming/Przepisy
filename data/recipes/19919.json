  "ingredients": [
    "2 tablespoons olive oil",
    "2 cloves garlic, minced",
    "1 (28 ounce) can whole peeled tomatoes",
    "0.5 cup chopped fresh basil",
    "salt and pepper to taste",
    "0.25 cup vodka",
    "1 pound penne pasta",
    "1 pint heavy cream"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Add garlic; cook and stir until fragrant, 1 to 2 minutes. Stir in tomatoes, breaking up with a fork. Stir in basil, salt, and pepper; simmer for 15 minutes. Stir in vodka and cook 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Add pasta and cook until al dente, 8 to 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream into sauce; cook 10 minutes more. Toss with hot pasta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
