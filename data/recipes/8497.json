  "ingredients": [
    "6 skinless, boneless chicken breast halves",
    "6 slices Swiss cheese",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "0.25 cup milk",
    "1 (8 ounce) package dry bread stuffing mix",
    "0.5 cup melted butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange chicken breasts in the baking dish. Place one slice of Swiss cheese on top of each chicken breast. Combine cream of chicken soup and milk in a medium bowl, and pour over chicken breasts. Sprinkle with stuffing mix. Pour melted butter over top, and cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 50 minutes, or until chicken is no longer pink and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
