  "ingredients": [
    "3 ounces cooked salmon, flaked",
    "1 cup cooked white rice",
    "1 tablespoon soy sauce",
    "0.5 teaspoon sriracha or other hot sauce",
    "2 teaspoons Japanese mayonnaise (such as Kewpie®)",
    "1 sheet nori, torn",
    "0.5 ripe avocado, sliced",
    "0.25 cup kimchi"
  ],
  "steps": [
    {
      "text": "Use a fork to flake salmon onto a microwave-safe plate. Top with rice and place 1 ice cube on top. Cover with a microwave-safe lid and microwave at low power for 30 seconds. Uncover and check temperature. If salmon and rice are not warm enough, cover and return to the microwave for another 30 seconds at low power.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Uncover and remove ice cube. Drizzle soy sauce, Sriracha and mayonnaise over the top and toss everything with a fork until well-combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with torn pieces of nori, sliced avocado and kimchi.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
