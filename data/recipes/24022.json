  "ingredients": [
    "1 cup chopped green chile pepper",
    "1 cup shredded Cheddar cheese",
    "3 cups self-rising flour",
    "3 tablespoons white sugar",
    "1 (12 fluid ounce) can or bottle beer"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend green chiles and cheese together in a blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together chile mixture, flour, sugar and beer together in a large mixing bowl until you get a sticky dough. Scoop dough into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 60 minutes, or until the top is golden brown and the loaf sounds hollow when tapped.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
