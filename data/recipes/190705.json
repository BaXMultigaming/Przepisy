  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "0.25 teaspoon black pepper",
    "1 egg",
    "0.25 cup milk",
    "2 tablespoons vegetable oil",
    "3 potatoes, peeled and diced"
  ],
  "steps": [
    {
      "text": "Whisk the flour, baking powder, salt, and pepper together in a bowl. Whisk together the egg and milk in a separate bowl; stir in the flour mixture until a smooth dough is formed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil over high heat. Once the water is boiling, cut the dough into bite sized pieces with scissors into the boiling water. Boil for 20 minutes; drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the oil in a large skillet over medium-low heat; add the knefla and potatoes. Stirring occasionally, cook until the potatoes are tender and the knefla are golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
