  "ingredients": [
    "1 cup mayonnaise",
    "1 cup lump crabmeat",
    "1 tablespoon chopped fresh tarragon",
    "2 cloves garlic, finely crushed",
    "1 teaspoon fresh lemon juice",
    "0.25 teaspoon Worcestershire sauce",
    "1 pinch cayenne pepper",
    "salt to taste",
    "2 pounds shrimp, peeled and deveined",
    "1 cup buttermilk",
    "2 teaspoons hot sauce",
    "2 teaspoons cayenne pepper",
    "2 teaspoons kosher salt",
    "1 teaspoon ground chipotle pepper",
    "1 teaspoon freshly ground black pepper",
    "1 cup all-purpose flour",
    "0.33333334326744 cup cornmeal",
    "2 teaspoons paprika",
    "2 teaspoons kosher salt",
    "6 soft sandwich rolls",
    "2 cups thinly sliced romaine lettuce",
    "canola oil for frying",
    "1 pinch cayenne pepper"
  ],
  "steps": [
    {
      "text": "Combine mayonnaise, crabmeat, tarragon, garlic, lemon juice, Worcestershire sauce, and 1 pinch cayenne pepper in a bowl; season with salt and stir to combine. Refrigerate aioli until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tails from shrimp; refrigerate until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk buttermilk, hot sauce, 2 teaspoons cayenne pepper, 2 teaspoons kosher salt, ground chipotle, and black pepper together in a bowl; set aside. Combine flour, cornmeal, paprika, and 2 teaspoons kosher salt in a shallow dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice sandwich rolls partway; split open. Scoop out some bread from tops. Toast in the preheated oven until crisp, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Soak shrimp in buttermilk mixture for about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat oil in a deep skillet over medium-high heat. Spread crab aioli generously over both sides of each roll; top with sliced lettuce. Toss shrimp in cornmeal mixture to coat; shake off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lower shrimp carefully into the hot oil in batches until golden brown and crispy, about 2 minutes per side. Drain on a paper towel-lined plate; immediately transfer shrimp to rolls. Sprinkle cayenne pepper on top. Repeat with remaining shrimp.",
      "section": null,
      "name": null,
      "url": null,
