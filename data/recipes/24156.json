  "ingredients": [
    "4 slices bacon",
    "2 peeled and diced potatoes",
    "0.125 teaspoon garlic salt",
    "0.125 teaspoon seasoning salt",
    "0.125 teaspoon black pepper",
    "3 eggs, beaten",
    "0.25 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown. Remove bacon slices, reserving grease. Crumble bacon and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add potatoes to bacon grease and season with garlic salt, seasoned salt and black pepper. Cook until potatoes are soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When potatoes are tender, add crumbled bacon. Pour eggs over potatoes and cook until firm. Spread with cheese and cover with lid until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
