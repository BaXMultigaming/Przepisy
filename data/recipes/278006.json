  "ingredients": [
    "1 cup dates, pitted and chopped",
    "0.5 cup water",
    "1 teaspoon baking soda",
    "0.5 cup brown sugar",
    "0.5 cup butter",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.25 cup heavy cream",
    "2 tablespoons butter",
    "2 tablespoons brown sugar",
    "0.25 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring dates and water to a simmer in a saucepan. Stir in baking soda and let simmer until most of the water is absorbed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter together using an electric mixer until creamy. Add the date mixture, egg, and vanilla extract. Mix in flour, baking powder, and salt. Drop tablespoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 13 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stir heavy cream, butter, and brown sugar together in a sauce pot. Let boil for 3 minutes, stirring constantly. Stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cookies cool before drizzling with warm toffee sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
