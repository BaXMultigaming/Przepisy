  "ingredients": [
    "2 cups water",
    "1 teaspoon liquid smoke flavoring",
    "3 pounds pork butt roast",
    "0.25 cup Hawaiian sea salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Stir water and liquid smoke together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork into a roasting pan with the fatty side facing up. Pour liquid smoke mixture over top, then sprinkle with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and roast in the preheated oven until meat is tender and can be easily pulled apart with a fork, about 3 hours. Remove from the pan and shred with two forks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
