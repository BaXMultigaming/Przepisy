  "ingredients": [
    "6 cups water",
    "1 (16 ounce) package dry kidney beans",
    "12 ounces smoked sausage, sliced",
    "1 onion, chopped",
    "1 green bell pepper, chopped",
    "1 stalk celery, chopped, or to taste",
    "2 cloves garlic, minced, or to taste",
    "1 bay leaf",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine water, kidney beans, sausage, onion, green bell pepper, celery, garlic, and bay leaf in the bowl of a slow cooker and stir to combine. Set slow cooker to Low and cook for at least 8 hours. Remove bay leaf and discard. Season with salt and ground black pepper to taste.",
