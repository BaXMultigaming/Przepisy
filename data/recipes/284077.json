  "ingredients": [
    "0.66666668653488 pound waxy potatoes",
    "1 tablespoon vegetable oil",
    "2 teaspoons dried crushed red pepper flakes",
    "1/2 teaspoon ground Sichuan pepper",
    "1 clove garlic, minced",
    "1 tablespoon black rice vinegar (such as Chinkiang)",
    "1 tablespoon soy sauce",
    "1 pinch flaked salt",
    "1 teaspoon fresh cilantro leaves, or to taste"
  ],
  "steps": [
    {
      "text": "Peel potatoes and cut into 1/4-inch matchsticks. Rinse under running water until water runs clear. Soak potatoes in water for 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain potatoes and pat dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a wok over medium-high heat. Add oil. Add pepper flakes and ground Sichuan pepper to the hot oil; cook and stir until fragrant, about 30 seconds. Add potatoes and garlic; toss and cook until potatoes begin to soften, about 5 minutes. Add vinegar, soy sauce, and salt; toss to combine. Cook until flavors have infused, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve garnished with cilantro leaves.",
      "section": null,
