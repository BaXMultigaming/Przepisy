  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 pounds skinless, boneless chicken breasts, cut into chunks",
    "salt and ground black pepper to taste",
    "2 (16 ounce) packages thin spaghetti",
    "4 (15 ounce) jars Alfredo sauce",
    "2 tablespoons Italian seasoning",
    "2 tablespoons garlic powder",
    "2 tablespoons chopped onion",
    "2 tablespoons chopped fresh basil",
    "2 tablespoons salt",
    "2 tablespoons ground black pepper",
    "1 tablespoon onion powder",
    "0.5 tablespoon cayenne pepper, or to taste",
    "1.5 cups shredded Parmesan cheese",
    "2 cups chopped broccoli"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aygIDKsYmmMiziqBz-9bZA9PCvI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276725-creamy-chicken-alfredo-VAT-005-step-01-bfcf31fc02304b5fbfd946007021c6a5.jpg"
      ],
      "image": "assets/images/276725/step_01.webp"
    },
    {
      "text": "Season chicken with a pinch of salt and pepper. Heat a large skillet over medium-high heat. Add chicken and cook until no longer pink in the center and juices run clear, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZVQTO-Ub8NNmkqdP00hkrPz9yrs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276725-creamy-chicken-alfredo-VAT-005-step-02-2e11ccf818ea418480a747a92aa02539.jpg"
      ],
      "image": "assets/images/276725/step_02.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V1gx94b-srljNamXzkqDe9HExYM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276725-creamy-chicken-alfredo-VAT-005-step-03-77b2b694fc4f4a08a36c1dff056e6164.jpg"
      ],
      "image": "assets/images/276725/step_03.webp"
    },
    {
      "text": "Meanwhile, add Alfredo sauce to the chicken; season to taste with Italian seasoning, garlic powder, onion, basil, salt, black pepper, onion powder, and cayenne.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NzVWCXocNjzF6zsjazVWJMvNd4E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276725-creamy-chicken-alfredo-VAT-005-step-04-6e4d967aee904662944b977fb48d528a.jpg"
      ],
      "image": "assets/images/276725/step_04.webp"
    },
    {
      "text": "Bring to a simmer; stir in Parmesan cheese. Cook mixture until cheese is melted and you are able to lift a spoon out of the sauce without cheese hanging onto it, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iUA2DdCckoU3zPK_ar2UK0FVfBs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276725-creamy-chicken-alfredo-VAT-005-step-05-7584081c8e794b3aadfaed537b7b8a3a.jpg"
      ],
      "image": "assets/images/276725/step_05.webp"
    },
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add broccoli, cover, and steam until tender, 2 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KF0gubdq-foYe1wVWO3f3xF90js=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276725-creamy-chicken-alfredo-VAT-005-step-06-0fea7253047f4132828511eda38dfd91.jpg"
      ],
      "image": "assets/images/276725/step_06.webp"
    },
    {
      "text": "Add broccoli to sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Xnst16sz8yW_K2gDM7gP4q8-UQw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276725-creamy-chicken-alfredo-VAT-005-step-07-92e8f03330a741bf8c100fcf5d4a3a79.jpg"
      ],
      "image": "assets/images/276725/step_07.webp"
    },
    {
      "text": "Drain cooked pasta. Scoop into individual serving bowls and pour sauce on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UOkN1GXtGwk89z926x2-c6IEFGs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276725-creamy-chicken-alfredo-VAT-012-step-08-a2fe5f38a21c4b6da80a4d3ecc77f5e5.jpg"
      ],
      "image": "assets/images/276725/step_08.webp"
    }
  ],
