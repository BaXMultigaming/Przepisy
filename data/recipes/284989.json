  "ingredients": [
    "1 (8 ounce) package whole white button mushrooms",
    "0.25 cup balsamic vinegar",
    "3 tablespoons olive oil",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1 tablespoon chopped fresh chives, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wipe mushrooms clean with a damp paper towel and place in a bowl. Add vinegar, oil, garlic powder, salt, and pepper; stir to combine. Let sit while oven preheats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place mushrooms in a single layer on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Remove baking sheet from oven and garnish with chives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
