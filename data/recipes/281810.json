  "ingredients": [
    "6 medium sweet potatoes",
    "1 cup packed brown sugar",
    "0.5 cup unsalted butter",
    "0.25 cup orange juice",
    "0.5 teaspoon salt",
    "4 whole cloves, or more to taste"
  ],
  "steps": [
    {
      "text": "Place sweet potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender but not mushy, 18 to 20 minutes. Drain. Peel sweet potatoes and cut in half lengthwise. Discard skins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, butter, orange juice, salt, and cloves in a large skillet or electric frying pan; bring to a boil. Reduce heat and simmer for 5 minutes until syrupy. Arrange potato halves in the syrup and simmer for 20 to 25 minutes. Remove cloves from syrup before serving, if you wish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
