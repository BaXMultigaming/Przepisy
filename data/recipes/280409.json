  "ingredients": [
    "8 medium potatoes, peeled and quartered",
    "0.25 cup olive oil",
    "0.25 cup lemon juice",
    "2 cloves garlic, minced",
    "1.5 teaspoons seasoned salt",
    "1 teaspoon chicken soup base",
    "1 teaspoon Greek seasoning"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread potatoes evenly in a large casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together olive oil, lemon juice, garlic, seasoned salt, chicken soup base, and Greek seasoning in a medium bowl until well combined. Pour over potatoes and stir to coat evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven, uncovered, until just tender, about 30 minutes. Reduce oven temperature to 350 degrees F (175 degrees C) and continue to bake until fork-tender, about 15 minutes.",
      "section": null,
