  "ingredients": [
    "2 large cucumbers, peeled and sliced in half lengthwise",
    "0.5 teaspoon salt",
    "1 cup sour cream",
    "0.25 cup white onion, minced",
    "2 tablespoons white wine vinegar",
    "2 tablespoons chopped fresh dill",
    "1 tablespoon white sugar",
    "1 pinch white pepper, or to taste",
    "0.5 cup crumbled blue cheese"
  ],
  "steps": [
    {
      "text": "Scoop out cucumber seeds using a spoon; slice into thick half-moons, then place on a paper towel-lined plate. Sprinkle with ½ teaspoon salt; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sour cream, onion, white wine vinegar, dill, sugar, and white pepper in a large bowl; fold in blue cheese until incorporated. Pat cucumber slices dry with paper towels; gently stir into blue cheese mixture until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate for at least 1 hour; season with salt just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
