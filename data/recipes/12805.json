  "ingredients": [
    "3 tablespoons vegetable oil",
    "1.5 pounds cod fillets",
    "1 lemon, juiced",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "In a large skillet, heat oil over medium high heat until hot. Add fillets and squeeze 1/2 of the lemon's juice over the tops. Sprinkle with pepper to taste. Cook for 4 minutes and turn. Squeeze with the remaining lemon's juice and sprinkle with pepper to taste. Continue to cook until fillets flake easily with a fork.",
