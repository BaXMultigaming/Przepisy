  "ingredients": [
    "1 tablespoon butter",
    "10 ounces Hawaiian sweet rolls",
    "1.5 cups fresh blueberries",
    "0.5 cup butter",
    "3 cups Almond Breeze Vanilla almondmilk",
    "0.66666668653488 cup sugar",
    "1 teaspoon almond extract",
    "1 teaspoon vanilla extract",
    "4 eggs, well beaten",
    "Powdered sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F and spread 1 tablespoon butter onto the bottom and sides of an 11 x 7-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each roll into 3 slices (you should have 10 cups, loosely measured). Place on a baking sheet and bake for 5 minutes or until lightly toasted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle some of the blueberries into the dish and arrange roll slices in rows. Sprinkle with remaining blueberries, tucking some between the roll slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt remaining butter and whisk together with Almond Breeze, sugar, extracts, and eggs. Pour over bread, then cover and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove French toast from refrigerator and preheat oven to 350 degrees F. Bake for 45 to 55 minutes or until firm when the dish is gently tapped. Serve warm, dusted with powdered sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
