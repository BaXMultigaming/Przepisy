  "ingredients": [
    "1 small potato, cut into cubes",
    "0.5 cup finely chopped cabbage",
    "0.25 cup fresh pomegranate seeds",
    "0.5 carrot, cut into matchsticks",
    "1 tablespoon extra-virgin olive oil",
    "1 teaspoon lemon juice",
    "1 clove garlic, minced",
    "0.5 teaspoon salt",
    "0.25 teaspoon brown sugar",
    "0.25 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Place potato cubes into a small pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 5 to 10 minutes. Drain and let cool, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooled potato, cabbage, pomegranate seeds, and carrot in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, lemon juice, garlic, salt, brown sugar, and red pepper flakes in a small bowl until well-mixed. Poured over potato mixture and toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
