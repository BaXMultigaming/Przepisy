  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "1 cup salsa",
    "2 cups chopped cooked chicken breast meat",
    "1 (15.5 ounce) can pinto beans, drained",
    "6 (6 inch) flour tortillas",
    "2 cups shredded Colby-Jack cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Cu7oiVNwWqCTiar6ELpDs614_D0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47374-easy-chicken-enchiladas-VAT-005-step-01-e72d44df969e44ebb66ff11632009896.jpg"
      ],
      "image": "assets/images/47374/step_01.webp"
    },
    {
      "text": "Combine cream cheese and salsa in a small saucepan over medium heat; cook and stir until well blended. Stir in chicken and pinto beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WWUdPA00g_aw7wWnUv7pmXqsjtU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47374-easy-chicken-enchiladas-VAT-006-step-02-85ec646b274c4e5e8e9a89ffbad56759.jpg"
      ],
      "image": "assets/images/47374/step_02.webp"
    },
    {
      "text": "Fill tortillas with chicken mixture, roll up and place into the prepared baking dish. Sprinkle shredded cheese on top. Cover pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g6_pYH239uK3E8iT7bPT2WtHzvg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47374-easy-chicken-enchiladas-VAT-007-step-03-ef841ab9f26343a3b407cd9b51e485a0.jpg"
      ],
      "image": "assets/images/47374/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for until heated through, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M2dIW3Dv6PXuQwEiJJ4MfIOwoZA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47374-easy-chicken-enchiladas-VAT-008-step-04-93b75d2a09f74210a691541dbe99b889.jpg"
