  "ingredients": [
    "1 (14 ounce) package frozen waffle fries",
    "1 pound ground beef",
    "1 (1 ounce) package taco seasoning",
    "1 (8 ounce) package shredded Mexican cheese blend",
    "1 cup diced tomatoes",
    "0.5 cup sliced black olives",
    "0.5 cup sliced jalapeno peppers",
    "3 leaves romaine lettuce, chopped",
    "3 tablespoons sour cream, or to taste",
    "3 tablespoons guacamole, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange waffle fries in a single layer on a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden in color, 12 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook and stir ground beef in a large skillet until browned and crumbly, 5 to 7 minutes. Drain excess grease. Stir in taco seasoning and cook for 1 to 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer baked fries to a 9x13-inch baking pan. Spread seasoned ground beef evenly over fries. Cover beef with cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven until cheese has melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with tomatoes, olives, jalapeños, and lettuce to serve. Dollop sour cream and guacamole on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
