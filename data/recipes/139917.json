  "ingredients": [
    "1 pound peeled and deveined medium shrimp",
    "1 cup fresh lime juice",
    "10 plum tomatoes, diced",
    "2 avocados, diced",
    "2 ribs celery, diced",
    "1 large yellow onion, diced",
    "1 jalapeno pepper, seeded and minced, or to taste",
