  "ingredients": [
    "0.5 cup molasses",
    "0.25 cup brown sugar",
    "0.5 teaspoon baking soda",
    "1 teaspoon ground ginger",
    "0.75 teaspoon ground cinnamon",
    "6 cups hot brewed coffee",
    "1 cup half-and-half cream",
    "1 teaspoon ground cloves",
    "1.5 cups sweetened whipped cream"
  ],
  "steps": [
    {
      "text": "In a small bowl, mix together the molasses, brown sugar, baking soda, ginger and cinnamon until well blended. Cover and refrigerate for at least 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add about a 1/4 cup of coffee to each cup, then stir in about a tablespoon of the spice mixture until dissolved. Fill cup to within an inch of the top with coffee. Stir in half and half to taste, then garnish with whipped cream and a light dusting of cloves.",
