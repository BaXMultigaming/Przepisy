  "ingredients": [
    "3 slices bacon",
    "1 (28 ounce) package frozen French fries",
    "1 cup shredded Cheddar cheese",
    "Ranch dressing"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels; crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread fries in a single layer on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and crisp, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove fries from the oven. Turn on the broiler to high.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle fries with Cheddar cheese and crumbled bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil under the preheated broiler until cheese melted, 1 to 2 minutes. Serve with ranch dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
