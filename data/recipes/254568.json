  "ingredients": [
    "6 cups cubed russet potatoes",
    "1 teaspoon salt",
    "1 cup sour cream",
    "1 cup creamy salad dressing (such as Miracle Whip®)",
    "0.5 teaspoon coarse ground black pepper",
    "1 cup shredded Cheddar cheese",
    "0.5 cup chopped green onions",
    "0.5 cup real bacon bits"
  ],
  "steps": [
    {
      "text": "Place potatoes in a pot and cover with cold water. Add salt and bring to a boil. Simmer until potatoes are just tender enough to be pierced with a fork, about 15 minutes. Drain and run under cold water until potatoes are slightly cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sour cream, creamy salad dressing, and ground black pepper together in a large bowl. Stir in Cheddar cheese, green onion, and bacon bits; add potatoes. Cover and chill in the refrigerator until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
