  "ingredients": [
    "cooking spray",
    "1 cup whole wheat flour",
    "0.5 cup rolled oats",
    "1.5 teaspoons baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "1 pinch sea salt",
    "4 large eggs",
    "0.5 cup applesauce",
    "0.25 cup maple syrup",
    "1 teaspoon vanilla extract",
    "1 cup grated carrot",
    "1 cup grated zucchini"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin with cooking spray or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, oats, baking soda, baking powder, cinnamon, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, applesauce, maple syrup, and vanilla in another bowl. Pour egg mixture into flour mixture and stir until evenly combined. Stir in carrot and zucchini. Spoon batter into the prepared muffin tins, filling each cup 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 15 to 20 minutes. Cool in the muffin tin for 5 minutes. Transfer to a wire rack and let cool completely, about 20 minutes, before serving to hungry toddlers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
