  "title": "Toddler-Friendly Carrot and Zucchini Muffins",
  "description": "Give your toddler a healthy dose of carrots and zucchini with these whole wheat muffins sweetened with only maple syrup and applesauce.",
  "authors": [
    "AmyGail"
  ],
  "date_published": "2014-11-04T11:11:50-05:00",
