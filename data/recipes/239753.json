  "ingredients": [
    "2 tablespoons chocolate-hazelnut spread (such as Nutella®), or more to taste",
    "4 slices cinnamon bread (such as Pepperidge Farm®)",
    "0.25 cup milk",
    "1 large egg, beaten",
    "0.25 teaspoon vanilla extract",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
