  "ingredients": [
    "1 bunch fresh chives",
    "0.5 cup olive oil",
    "4 cups baby arugula",
    "4 slices prosciutto, chopped, or more to taste",
    "0.5 cup crumbled blue cheese (such as Point Reyes®)",
    "2 medium Bosc pears",
    "0.25 cup balsamic vinegar glaze (such as Trader Joe's®)"
  ],
  "steps": [
    {
      "text": "Coarsely chop chives and put in a food processor. Add olive oil and purée for 1 minute. Transfer to a squeeze bottle dispenser and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Evenly distribute arugula onto 4 medium plates. Top with prosciutto and blue cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel and core pears, then cut in half. Cut each half into thin slices and add to plates in a fan shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle chive olive oil over each salad and decoratively add some to the sides of the plates. Repeat with balsamic glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
