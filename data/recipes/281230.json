  "ingredients": [
    "6 ounces fusilloni pasta",
    "1 cup ricotta cheese, drained",
    "0.25 cup finely grated Grana Padano cheese",
    "1 teaspoon ground turmeric",
    "0.5 teaspoon ground black pepper",
    "1 pinch salt to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook fusilloni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk ricotta, grated Grana padano, turmeric, and black pepper together in a bowl. Stir in enough pasta water to give the sauce a creamy consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain the pasta, reserving a bit more pasta water. Fold the pasta into the sauce, adding a bit of pasta water if necessary. Season with salt.",
      "section": null,
