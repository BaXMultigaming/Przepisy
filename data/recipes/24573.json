  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "1 teaspoon salt",
    "1 (5.9 ounce) package instant chocolate pudding mix",
    "1 cup Amish Friendship Bread Starter",
    "1 cup vegetable oil",
    "0.5 cup milk",
    "3 eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease two 9x5 inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, stir together all-purpose flour, sugar, baking powder, baking soda, salt, chocolate pudding. Make a well in the center of this mixture. Add Amish friendship bread starter, vegetable oil, milk, eggs and vanilla extract; mix well. Pour batter into prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted into center of the loaf comes out clean, about 60 minutes. Cool on a wire rack for 10 minutes before removing from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
