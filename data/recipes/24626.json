  "ingredients": [
    "12 roma (plum) tomatoes",
    "1 small onion, quartered",
    "2 cloves garlic, unpeeled",
    "1 jalapeno chile pepper",
    "1.5 tablespoons olive oil",
    "0.25 cup chopped fresh cilantro",
    "3 tablespoons fresh lime juice",
    "1 teaspoon ground cumin",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tomatoes, onion, garlic, and jalapeño in a medium baking dish; drizzle with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil, checking often, until the vegetables are charred, about 5 to 10 minutes. Remove vegetables from heat. Remove and discard tomato cores, jalapeño stem, and garlic skins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer charred vegetables into a blender or food processor; process until coarsely chopped. Transfer into a medium bowl; stir in cilantro, lime juice, cumin, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
