  "ingredients": [
    "1 pound thin spaghetti",
    "1 (8 ounce) bottle Italian salad dressing",
    "0.25 cup red wine vinegar",
    "2 cups shredded Parmesan cheese",
    "1 (16 ounce) can Italian-style diced tomatoes, drained",
    "1 small red onion, chopped",
    "1 (8 ounce) package pepperoni sausage, chopped",
    "1 (4 ounce) jar sliced mushrooms",
    "1 (3 ounce) jar sliced green olives, drained",
    "0.25 (2.62 ounce) bottle salad seasoning mix"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 10 minutes; rinse under cold water and drain. Transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour Italian dressing and vinegar over spaghetti; mix well. Add Parmesan cheese, diced tomatoes, onion, pepperoni, mushrooms, olives, and salad seasoning mix; stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve at room temperature, or refrigerate, covered, for about 3 hours, or marinate 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
