  "title": "Chocolate Popcorn",
  "description": "This baked chocolate popcorn candy recipe combines freshly popped popcorn, peanuts, and a rich homemade glaze to create a crispy, chocolaty treat!",
  "authors": [
    "sueb"
  ],
