  "ingredients": [
    "12 eggs",
    "0.5 cup mayonnaise",
    "2 tablespoons prepared horseradish",
    "2 teaspoons chopped fresh dill",
    "0.5 teaspoon dry mustard",
    "0.25 teaspoon salt",
    "0.125 teaspoon pepper",
    "0.125 teaspoon paprika"
