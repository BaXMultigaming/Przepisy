  "ingredients": [
    "4 cups water",
    "1 cup white quinoa",
    "1 cup red quinoa",
    "1.5 large red onions, chopped",
    "1 red bell pepper, chopped",
    "1 yellow bell pepper, chopped",
    "1 teaspoon sea salt",
    "1 teaspoon sea salt",
    "0.25 cup olive oil",
    "2 limes, juiced",
    "2 tablespoons chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a large saucepan. Add quinoa; reduce heat to low. Cover and simmer until water absorbs, about 15 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine onions, bell peppers, 1 teaspoon salt, and ¼ teaspoon black pepper in a bowl; stir in quinoa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil and lime juice together in a separate bowl; stir into quinoa mixture to coat. Stir in cilantro until well combined. Cover the bowl; refrigerate to let flavors blend, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
