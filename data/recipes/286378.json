  "ingredients": [
    "3 medium potatoes, peeled and diced",
    "0.5 link kielbasa, diced",
    "0.5 small onion, chopped",
    "1 (15.25 ounce) can whole kernel corn, drained",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (6.0 ounce) package pork stuffing mix",
    "nonstick cooking spray",
    "3 large eggs"
  ],
  "steps": [
    {
      "text": "Combine potatoes, kielbasa, and onion in a skillet. Pour corn and diced tomatoes with liquids on top and stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bring to a boil over medium-high heat. Reduce heat and simmer until potatoes are tender, about 20 minutes. Add stuffing mix and stir well. Cover, remove from heat, and let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, spray a large skillet with cooking spray; warm over medium-high heat. Whisk eggs together in a bowl. Pour into the skillet; cook and stir until eggs are set, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add scrambled eggs to skillet and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
