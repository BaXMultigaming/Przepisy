  "ingredients": [
    "0.5 cup cold unsalted butter, cut into small cubes",
    "1.5 cups sifted all-purpose flour",
    "0.5 cup white sugar",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon five-spice powder",
    "1 egg yolk",
    "0.5 teaspoon ice water, or more if needed",
    "0.75 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter cubes in the freezer for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour, sugar, salt, and baking powder in a large bowl. Sprinkle in five-spice powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut in frozen butter using a pastry cutter until butter pieces are about the size of peas. Mix in egg yolk and continue cutting in until thoroughly combined. Drizzle in ice water and stir to combine. The dough should just come together when pinched between your fingers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour about 3/4 of the crumb mixture into an ungreased 9x9-inch baking dish. Press mixture down firmly using the back of a spoon. Spread blueberries in one layer and sprinkle with remaining crumbly dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is golden and sides are crisp and browned, 30 to 35 minutes. Cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_9QbqWn4JJmfZpQOQxNStaoIz_w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3215640-ca2423e4408a4532ac3990bf368b905d.jpg"
      ],
