  "title": "Blueberry Shortbread Bars",
  "description": "Easy, buttery blueberry shortbread bars baked in a pan topped with summer fruit and shortbread crumbles for quick, easy, delicious bar cookies.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-08-13T18:40:49-04:00",
