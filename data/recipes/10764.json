  "title": "Excellent Oatmeal Cookies",
  "description": "These chewy oatmeal cookies studded with walnuts and spiced with a hint of delicious cinnamon are a favorite treat for dessert or an after-school snack.",
  "authors": [
    "Beatrice"
  ],
  "date_published": "1998-03-26T21:12:33-05:00",
