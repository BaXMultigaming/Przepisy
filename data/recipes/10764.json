  "ingredients": [
    "1 cup butter, softened",
    "1 cup packed brown sugar",
    "0.5 cup white sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "1.25 cups all-purpose flour",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "3 cups quick cooking oats",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, brown sugar, and white sugar in a large bowl with an electric mixer until fluffy. Beat in one egg at a time, then stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cinnamon, salt, and baking soda in a separate bowl; stir into the creamed mixture. Mix in oats and walnuts until just blended. Drop teaspoonfuls of dough 2 inches apart onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 12 minutes. Transfer to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
