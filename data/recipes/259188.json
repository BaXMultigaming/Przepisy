  "ingredients": [
    "2.5 cups all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1.75 cups white sugar",
    "0.5 cup butter",
    "0.5 cup vegetable oil",
    "2 eggs",
    "1 tablespoon chile powder",
    "1 teaspoon vanilla extract",
    "0.5 cup buttermilk",
    "2 cups grated zucchini",
    "0.75 cup chopped walnuts",
    "6 ounces semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease a 9x13-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, cocoa powder, salt, and baking soda together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, butter, vegetable oil, and eggs together in a large bowl. Add chile powder and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour flour mixture into sugar mixture; add buttermilk and stir to combine. Mix zucchini into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared cake pan; sprinkle chocolate chips and walnuts on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
