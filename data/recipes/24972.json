  "ingredients": [
    "1.5 cups white sugar",
    "1 cup butter",
    "8 large egg yolks",
    "1.5 teaspoons vanilla extract",
    "2 cups cake flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.75 cup milk"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ILOsOUAlFd68shyy7ru05A0pQOU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24972_DavidsYellowCake_ddmfs_step1_4x3_1757-1547e9bb65e54ae7b169e780246948e1.jpg"
      ],
      "image": "assets/images/24972/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 8-inch, round pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and butter in a large bowl until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5AfjJ-B3jOcsErsW_U7Tvi6za2c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24972_DavidsYellowCake_ddmfs_step2_4x3_1759-7f3585d38e794045be39b6d08e0aa79c.jpg"
      ],
      "image": "assets/images/24972/step_03.webp"
    },
    {
      "text": "Beat in egg yolks, one at a time, then stir in vanilla. Sift together flour, baking powder, and salt in a separate bowl. Beat in flour mixture alternately with milk, mixing just until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jiER9H0lvw_oXk9Kp7S2ehOIqEQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24972_DavidsYellowCake_ddmfs_step3_4x3_1761-de26de88f55947af98f8dd25b2120c36.jpg"
      ],
      "image": "assets/images/24972/step_04.webp"
    },
    {
      "text": "Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jveJz52ccX6vkBr0UGbkjb0X21s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24972_DavidsYellowCake_ddmfs_step4_4x3_1762-fa723a856cbd44d5bb1078b945b3a095.jpg"
      ],
      "image": "assets/images/24972/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the middle of the cake comes out clean, 25 to 30 minutes. Cool 15 minutes before turning out onto cooling racks to cool completely before frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AQHF1xBHg_y46eN9uawnP6ugZhQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24972_DavidsYellowCake_ddmfs_4x3_1774-ab2b0bdefcba44488ae88ed13038d4c7.jpg"
      ],
      "image": "assets/images/24972/step_06.webp"
    }
