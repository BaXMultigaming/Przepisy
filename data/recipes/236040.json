  "ingredients": [
    "cooking spray",
    "12 slices bacon",
    "10 large eggs",
    "0.25 cup milk",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.25 cup sliced green onions",
    "0.25 cup diced jalapeno peppers",
    "0.25 cup diced roasted red peppers",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12-cup muffin tin with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bacon on a microwave-safe plate. Microwave on high for 75 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line each muffin cup with one bacon slice going around the edges of the cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, milk, salt, and pepper together in a bowl; spoon into muffin cups. Sprinkle 1 tablespoon green onions over four muffin cups, sprinkle 1 tablespoon jalapeño peppers over another four muffin cups, and sprinkle 1 tablespoon roasted red pepper over the remaining four muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until only slightly moist on top, about 20 minutes. Sprinkle Cheddar over muffins and continue to bake until eggs are cooked through and cheese is melted, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
