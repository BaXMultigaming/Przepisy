  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "0.5 cup butter, softened",
    "0.5 cup brown sugar",
    "0.66666668653488 cup molasses",
    "2 eggs",
    "4 cups all-purpose flour, divided",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "1 pound confectioners' sugar",
    "0.5 teaspoon cream of tartar",
    "3 egg whites"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ycZkdnLzIVUEJkOA4v2boif3qF0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-23073-classic-gingerbread-cutouts-step-01-cc087249053e4f16b546be17b4ede8f8.jpg"
      ],
      "image": "assets/images/23073/step_01.webp"
    },
    {
      "text": "In a large bowl, cream together butter and brown sugar until smooth. Stir in molasses and eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6nEPbPWANnduD59fL_mCROgHBR8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-23073-classic-gingerbread-cutouts-step-02-2ae8a9aa1f0b477a8dfe390a642d6d4c.jpg"
      ],
      "image": "assets/images/23073/step_02.webp"
    },
    {
      "text": "Combine 1 1/2 cups of the flour, baking soda, salt, allspice, cloves, cinnamon, and ginger; beat into molasses mixture. Gradually stir in remaining flour by hand to form a stiff dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K8tnXv_CUpRTCp8npBhaVcsx3QM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-23073-classic-gingerbread-cutouts-step-03-aee1ee235ec04279828b0c54b02daa49.jpg"
      ],
      "image": "assets/images/23073/step_03.webp"
    },
    {
      "text": "Divide dough into 2 pieces. On a lightly floured surface, roll out dough to 1/8-inch thickness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ph1XV1ATvm58gPB5m8gl9qtczmU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-23073-classic-gingerbread-cutouts-step-04-df82bb1a9d40476280cfa8164971cbb7.jpg"
      ],
      "image": "assets/images/23073/step_04.webp"
    },
    {
      "text": "Cut into desired shapes using cookie cutters. Place cookies 1-inch apart onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tsUnYyGt9aowO92vBwS7mnl-I9o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-23073-classic-gingerbread-cutouts-step-05-2429ecc908e94ad1884cce7ad01f4266.jpg"
      ],
      "image": "assets/images/23073/step_05.webp"
    },
    {
      "text": "Bake for 8 to 10 minutes in the preheated oven. Allow cookies to cool on baking sheet for 5 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wv4P4h1ftIRv-gML4Kmy19kyxxE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-23073-classic-gingerbread-cutouts-step-06-51817468bf4743df9c6a7ff303d88068.jpg"
      ],
      "image": "assets/images/23073/step_06.webp"
    },
    {
      "text": "In a medium bowl, sift together confectioners' sugar and cream of tartar. Blend in egg whites.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jlcsag4xTdh3uWGbhZoGuTNvLa4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-23073-classic-gingerbread-cutouts-step-07-82aa353804c444c29577106d0999bb66.jpg"
      ],
      "image": "assets/images/23073/step_07.webp"
    },
    {
      "text": "Using an electric mixer on high speed, beat for about 5 minutes, or until mixture is thick and stiff. Keep covered with a moist cloth until ready to frost cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wYCUxHgiGP6-LO4xB5PgwKEf8T4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-23073-classic-gingerbread-cutouts-step-08-2c7e93c697994b91a1fd78e92e3066a5.jpg"
      ],
      "image": "assets/images/23073/step_08.webp"
    },
    {
      "text": "Decorate cooled cookies and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CW7EK4wYLzd5FMDn5q-JAS9NMWE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-23073-classic-gingerbread-cutouts-step-09-6b9975246c3743d6aa5d50b056b4d661.jpg"
      ],
      "image": "assets/images/23073/step_09.webp"
    }
  ],
