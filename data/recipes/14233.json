  "ingredients": [
    "0.5 cup mayonnaise",
    "0.5 cup sour cream",
    "1 tablespoon honey",
    "1.5 cups shredded Cheddar cheese, divided",
    "4 cups shredded lettuce",
    "3 cups fresh peaches - peeled, pitted, and sliced",
    "3 cups sliced fresh strawberries",
    "3 cups seedless grapes"
  ],
  "steps": [
    {
      "text": "In a small bowl whisk the mayonnaise, sour cream and honey together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl toss 1 cup of the cheese with the lettuce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 2 1/2 quart glass bowl, layer half of the lettuce mixture, peaches, remaining lettuce mixture, strawberries, grapes and remaining cheese. Spread mayonnaise mixture over the top or serve on the side. Chill well before serving.",
