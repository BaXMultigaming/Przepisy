  "ingredients": [
    "1.5 teaspoons butter",
    "1.25 cups flaxseed meal",
    "0.25 cup white sugar",
    "2 tablespoons chia seeds",
    "1 tablespoon baking powder",
    "1.5 teaspoons ground cinnamon",
    "3 ripe bananas, mashed",
    "3 eggs, beaten",
    "1 apple, chopped",
    "0.5 cup coconut flakes, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a muffin tin with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flaxseed meal, sugar, chia seeds, baking powder, and cinnamon in a bowl. Add bananas, eggs, and apple; mix batter thoroughly. Stir in 6 tablespoons coconut flakes. Fill tin 3/4 full with batter. Sprinkle remaining 2 tablespoons coconut flakes on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
