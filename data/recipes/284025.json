  "ingredients": [
    "1 (9 inch) frozen deep-dish pie crust",
    "1 cup white sugar",
    "1 tablespoon all-purpose flour",
    "3 large eggs, lightly beaten",
    "0.5 cup sweetened flaked coconut",
    "0.5 cup evaporated milk",
    "0.33333334326744 cup unsalted butter, softened",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pie crust in the preheated oven until lightly browned, about 10 minutes. Remove from the oven. Reduce oven temperature to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and flour in a large bowl; stir in eggs. Add coconut, evaporated milk, butter, and vanilla. Stir well to combine. Pour filling into the prepared pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pie is set, 35 to 40 minutes. Let cool before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
