  "ingredients": [
    "1 (10 ounce) package baby spinach leaves",
    "1.25 cups diced apple",
    "1.25 cups diced sharp Cheddar cheese",
    "1 cup dried cranberries",
    "1 cup chopped pecans",
    "0.5 cup balsamic vinegar",
    "0.25 cup pure maple syrup",
    "1 teaspoon Dijon mustard",
    "0.75 cup extra-virgin olive oil",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine spinach, apple, Cheddar cheese, cranberries, and pecans in a large salad bowl; toss well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine balsamic vinegar, maple syrup, and mustard in a blender; blend on medium speed until well mixed. With blender running; pour in olive oil in a steady stream. Blend until dressing is smooth and emulsified (where oil and vinegar are no longer separated). Season with salt and black pepper; blend to incorporate. Drizzle over salad; serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
