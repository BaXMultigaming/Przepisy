  "ingredients": [
    "6 slices white bread",
    "0.67 cup milk",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Cut each slice of bread twice diagonally to make 4 triangles (24 total). Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together milk, eggs, vanilla, and cinnamon in a shallow bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter over medium-high heat in a frying pan or skillet. Working in batches, dunk bread triangles in egg mixture, soaking both sides. Cook bread triangles in hot butter until golden brown, 2 to 3 minutes per side. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
