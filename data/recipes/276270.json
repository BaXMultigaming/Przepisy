  "ingredients": [
    "2 eggs",
    "1 cup white sugar",
    "1 cup buttermilk",
    "1 teaspoon vanilla extract",
    "2 tablespoons butter, melted",
    "4 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "0.5 cup vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Beat eggs in the bowl of a stand mixer until whipped to a creamy color. Mix in sugar gradually until well blended. Mix in buttermilk and vanilla extract. Mix in butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, baking powder, nutmeg, and salt together in a separate bowl. Beat 1/2 of the mixture into the sugar mixture until well blended; beat in remaining 1/2. Let batter rest for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a floured surface and knead as little as possible until it comes together. Roll dough out using a rolling pin until it is 3/8-inch thick; cut into donut shapes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lower donuts carefully into the hot oil and cook until light brown, 2 to 3 minutes, turning once. Remove from oil and let cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
