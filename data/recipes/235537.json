  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar and cinnamon together in a large bowl until well combined. Add apple slices and toss to coat. Arrange apple slices in a single layer on prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until browned and crisp, about 2 hours. Cool completely.",
