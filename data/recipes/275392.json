  "ingredients": [
    "0.5 cup mayonnaise",
    "1 teaspoon finely minced garlic",
    "0.5 teaspoon fresh lemon juice",
    "2 pinches Cajun seasoning",
    "12 ounces salmon, minced",
    "1 tablespoon snipped fresh chives",
    "1 teaspoon dried parsley",
    "1 teaspoon finely minced garlic",
    "0.5 teaspoon salt",
    "1 tablespoon all-purpose flour, or more as needed",
    "1 lemon",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Mix mayonnaise, garlic, lemon juice, and Cajun seasoning together in a small bowl and refrigerate dipping sauce until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon, chives, parsley, garlic, and salt in a medium bowl and mix well. Add flour and mix well. Divide into 4 equal portions; mold into patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat air fryer to 350 degrees F (175 degrees C). Cut lemon into 4 slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place lemon slices into the bottom of the air fryer basket and place salmon patties on top. Lightly spray patties with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the basket into the preheated fryer and drop the temperature to to 275 degrees F (135 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the air fryer until an instant-read thermometer inserted into the center of a patty reads 145 degrees F (63 degrees C), 10 to 15 minutes. Serve with sauce.",
      "section": null,
      "name": null,
      "url": null,
