  "ingredients": [
    "1 cup almond flour",
    "0.25 cup coconut flour",
    "2 tablespoons low-calorie natural sweetener (such as Swerve®)",
    "1 teaspoon salt",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "6 eggs, at room temperature",
    "0.25 cup heavy whipping cream, at room temperature",
    "2 tablespoons butter, melted",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Whisk almond flour, coconut flour, natural sweetener, salt, baking powder, and cinnamon together in a bowl. Slowly whisk in eggs, heavy cream, butter, and vanilla extract until batter is just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle over medium-high heat. Drop batter by large spoonfuls onto the griddle and cook until bubbles form and the edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
