  "ingredients": [
    "3.5 cups all-purpose flour",
    "2 cups packed dark brown sugar",
    "2 cups pumpkin puree",
    "1 cup vegetable oil",
    "0.66666001081467 cup coconut milk",
    "0.66666698455811 cup white sugar",
    "2 teaspoons baking soda",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon ground nutmeg",
    "1 cup toasted walnuts, chopped",
    "0.66666698455811 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 8x4-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, pumpkin purée, oil, coconut milk, white sugar, baking soda, cinnamon, salt, and nutmeg in a bowl; fold in walnuts and coconut flakes until evenly distributed. Divide batter between the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour and 15 minutes. Set pans on a wire rack, tightly cover pans with aluminum foil, and allow to steam for 10 minutes. Remove the foil and turn out loaves onto the wire rack. Tent lightly with the foil; cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
