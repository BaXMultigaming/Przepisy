  "ingredients": [
    "4 cups shredded zucchini",
    "0.25 teaspoon salt",
    "1.5 cups shredded mozzarella cheese, divided",
    "0.5 cup grated Parmesan cheese",
    "2 large eggs",
    "1 teaspoon Italian seasoning",
    "0.5 teaspoon garlic powder",
    "1 pound 85% lean ground beef",
    "0.5 white onion, chopped",
    "1 cup pizza sauce",
    "1 ounce pepperoni slices"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 10x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place zucchini in a colander; sprinkle with salt and set aside for 10 minutes. Press zucchini to remove as much liquid as possible. Transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir ½ mozzarella cheese, Parmesan cheese, eggs, Italian seasoning, and garlic powder into zucchini until well combined; press into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat a large skillet over medium-high heat. Add ground beef and onion; cook and stir until beef is brown and crumbly, 5 to 7 minutes. Drain and discard grease. Stir pizza sauce into beef mixture; spoon over zucchini mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle remaining ½ mozzarella over casserole; top with pepperoni slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until mozzarella melts, 15 to 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
