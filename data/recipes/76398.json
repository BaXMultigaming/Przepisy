  "ingredients": [
    "2.75 cups all-purpose flour",
    "2.5 tablespoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "3 tablespoons butter",
    "1 cup honey",
    "1 egg",
    "1 orange, zested",
    "0.75 cup orange juice",
    "2 cups pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line a 5x9 inch loaf pan with aluminum foil. Lightly grease the foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, sift together the flour, baking powder, baking soda, and salt. In a separate bowl, beat together the butter, honey, egg, and orange zest until creamy. Alternately stir the flour mixture and orange juice into the butter mixture. Fold in the pecans, and transfer to the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a knife inserted in the center comes out clean, about 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
