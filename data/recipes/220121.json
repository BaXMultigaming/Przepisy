  "ingredients": [
    "2 (4 ounce) fillets mahi mahi",
    "2 teaspoons olive oil",
    "0.5 cup salted butter",
    "1 tablespoon lemon juice",
    "1 clove garlic, minced",
    "2 drops Louisiana-style hot sauce, or to taste",
    "1 roma tomato, seeded and chopped",
    "1 green onion, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub fillets with oil; transfer to a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a saucepan over medium heat. Add lemon juice, garlic, and hot sauce; simmer for 1 minute. Add tomato and green onion; cook and stir until heated through. Spoon over fillets to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
