  "ingredients": [
    "2 (6 ounce) packages strawberry flavored Jell-O®",
    "1 (14 ounce) can sweetened condensed milk",
    "2 cups flaked coconut",
    "2 teaspoons vanilla extract",
    "0.5 cup red decorator sugar",
    "0.25 cup green decorator sugar",
    "2 ounces slivered almonds"
  ],
  "steps": [
    {
      "text": "Blend together the gelatin and condensed milk. Add coconut and vanilla; mix well and refrigerate until chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll into small balls and shape into strawberries; roll in red sugar crystals.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip fat end into green sugar crystals. Place an almond sliver into the fat end for a stem. To prevent hardening, store in an air tight container until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
