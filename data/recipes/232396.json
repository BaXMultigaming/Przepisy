  "ingredients": [
    "0.75 cup white sugar",
    "0.5 cup unsweetened cocoa powder",
    "1.5 tablespoons all-purpose flour",
    "1.25 cups milk",
    "2 tablespoons butter",
    "0.5 teaspoon vanilla extract, or more to taste",
    "1 tiny pinch salt"
  ],
  "steps": [
    {
      "text": "Place sugar, cocoa powder, and flour into a bowl. Whisk together to remove lumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P_Y8Sm0Sbt3I3zth1JcQZ5gyGk0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232396-easy-homemade-chocolate-sauce-step2-692copy-940b473aa88a4ecea61d9b396e709136.jpg"
      ],
      "image": "assets/images/232396/step_01.webp"
    },
    {
      "text": "Heat milk, butter, and vanilla extract in a saucepan over medium heat until butter melts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I0JCB65c5v2zLtSRCwoAIMjayVE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232396-easy-homemade-chocolate-sauce-step3-694copy-32d38ac664c749cc90d5f1c716019a6c.jpg"
      ],
      "image": "assets/images/232396/step_02.webp"
    },
    {
      "text": "Whisk dry ingredients into the milk mixture a little at a time. Increase heat to medium-high until mixture comes to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dFESbsmkydExCslrEQwINURkNVc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232396-easy-homemade-chocolate-sauce-step4-696copy-5719ece12e884c108f5c929a33baca20.jpg"
      ],
      "image": "assets/images/232396/step_03.webp"
    },
    {
      "text": "Cook, stirring constantly, for exactly 6 minutes, then turn off the heat. Whisk in a pinch of salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5tUwKV53H1-n7JrkRUEAbN92d2I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232396-easy-homemade-chocolate-sauce-step5-698copy-e2a480e2b91644469dbf26aa26c152b6.jpg"
      ],
      "image": "assets/images/232396/step_04.webp"
    },
    {
      "text": "Serve over ice cream.",
      "section": null,
      "name": null,
      "url": null,
