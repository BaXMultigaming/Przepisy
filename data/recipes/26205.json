  "ingredients": [
    "0.5 cup butter, softened",
    "2 tablespoons white sugar",
    "1 teaspoon vanilla extract",
    "1 cup sifted cake flour",
    "1 cup pecan halves",
    "0.5 cup confectioners' sugar for rolling"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together butter and sugar until smooth. Beat in the vanilla. Grind pecans in a food processor or blender; toss with cake flour. Stir the pecan mixture into the creamed mixture until well blended. Roll the dough into tablespoon balls, then place them 1 inch apart onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 to 20 minutes in the preheated oven, or until lightly browned. Roll warm cookies in confectioners' sugar. When they are cooled, roll them again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
