  "ingredients": [
    "0.5 cup honey",
    "2 tablespoons red wine vinegar",
    "2 teaspoons red pepper flakes",
    "1 teaspoon dried thyme",
    "0.5 teaspoon smoked paprika",
    "0.5 teaspoon kosher salt"
  ],
  "steps": [
    {
      "text": "Combine honey, vinegar, red pepper flakes, thyme, smoked paprika, and salt in a small saucepan. Bring to a boil. Remove from heat and let cool to room temperature so flavors infuse, about 30 minutes. Store at room temperature in an airtight container.",
