  "ingredients": [
    "2 cups water",
    "1 cup uncooked white rice",
    "1.5 pounds leftover roast pork, cubed",
    "1 (10 ounce) package frozen broccoli, thawed",
    "2 (10.75 ounce) cans condensed cream of celery soup",
    "0.5 cup mayonnaise",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon curry powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and rice to a boil in a saucepan over medium-high heat. Reduce heat to low, cover, and simmer until rice is tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pork, cooked rice, and broccoli in a large bowl. Stir in soup and mayonnaise; season with pepper and curry powder. Transfer to a 9x13-inch baking dish; cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until evenly heated through, 45 to 50 minutes. Remove foil for the last 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
