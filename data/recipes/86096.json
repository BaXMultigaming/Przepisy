  "ingredients": [
    "0.5 cup diced bacon",
    "4 medium potatoes, peeled and chopped",
    "1 medium onion, chopped",
    "3 cups cream-style corn",
    "2 cups water",
    "2 teaspoons salt",
    "ground black pepper to taste",
    "2 cups half-and-half"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_lMyMlS3FIkn7zQVs1yCUb5vlwA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86096-grandmas-corn-chowder-ddmfs-step-01-3x4_9528-c6493e129ae841c287eab44e3433757d.jpg"
      ],
      "image": "assets/images/86096/step_01.webp"
    },
    {
      "text": "Cook bacon in a large pot over medium-high heat until crisp, 5 to 7 minutes. Drain, leaving bacon and 2 tablespoons grease in the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uVZLbP69ZIGh814uLvvkFQn9Kb4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86096-grandmas-corn-chowder-ddmfs-step-03.1-3x4_9538-8d2629503839403e9ef4481981dc345c.jpg"
      ],
      "image": "assets/images/86096/step_02.webp"
    },
    {
      "text": "Add potatoes and onion to the pot; cook, stirring occasionally, for 5 minutes. Add corn, water, salt, and pepper; bring to a boil. Reduce the heat to low, cover the pot and simmer, stirring frequently, until potatoes are tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a3XSVf1SV295CFEXQqK4VUs0AzQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86096-grandmas-corn-chowder-ddmfs-step-05-3x4_9542-1b68b1144f0f48acb0f685f448c72bf0.jpg"
      ],
      "image": "assets/images/86096/step_03.webp"
    },
    {
      "text": "Warm half-and-half in a small saucepan until it bubbles; remove from the heat just before it boils. Mix into chowder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RNOSq0P1Wbj9Oa2wAB40fnUUgz8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86096-grandmas-corn-chowder-ddmfs-step-07-3x4_9552-aafaffdd413a42208a816c68046211b0.jpg"
      ],
      "image": "assets/images/86096/step_04.webp"
    },
    {
      "text": "Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
