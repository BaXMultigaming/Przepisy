  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine all-purpose flour, 1/3 cup plus 1/4 cups whole wheat flour, baking powder, baking soda, salt, cinnamon, nutmeg, ginger, and cloves in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pumpkin, sugar, applesauce, eggs, and vanilla extract together using an electric mixer in a large bowl until well blended. Add pecans and chocolate chips and mix until evenly distributed. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 to 55 minutes. Let cool in the pan for 15 to 20 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
