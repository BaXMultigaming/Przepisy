  "ingredients": [
    "2 tablespoons butter",
    "1 onion, diced",
    "salt and ground black pepper to taste",
    "1.25 pounds ground turkey",
    "0.5 cup cold water",
    "0.75 cup ketchup",
    "1.5 tablespoons brown sugar",
    "0.5 teaspoon cayenne pepper, or to taste",
    "0.5 teaspoon Worcestershire sauce",
    "0.5 teaspoon unsweetened cocoa powder",
    "1 cup water, or as needed",
    "6 hamburger buns, split",
    "0.5 cup shredded white Cheddar cheese",
    "0.33333334326744 cup chopped green onions"
  ],
  "steps": [
    {
      "text": "Melt butter in a heavy skillet over medium heat. Cook and stir onion in butter until lightly brown, about 5 minutes. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix turkey and 1/2 cup cold water into onions. Cook and stir, breaking up the meat, until it begins to brown, about 2 minutes. Add ketchup, brown sugar, cayenne pepper, salt, and black pepper. Cook and stir until liquid is reduced, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in Worcestershire sauce and cocoa powder. Cook, stirring frequently, until meat is cooked through and liquid is reduced and thick, 20 to 30 minutes, adding up to 1 cup water if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven's broiler. Set the oven rack about 6 inches from the heat source.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast hamburger buns under the preheated broiler until golden, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove turkey mixture from the heat; mix in cheese and green onions. Serve on toasted hamburger buns.",
      "section": null,
      "name": null,
      "url": null,
