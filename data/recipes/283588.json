  "ingredients": [
    "1 (12 ounce) package linguine pasta",
    "0.25 cup peanut butter",
    "0.25 cup sesame oil",
    "3 tablespoons soy sauce",
    "2 teaspoons white sugar",
    "2 cloves garlic, minced",
    "0.5 teaspoon crushed red pepper flakes",
    "1 tablespoon sesame seeds, or to taste",
    "1 tablespoon chopped green onion, or to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, about 11 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the pasta is cooking, combine peanut butter, sesame oil, soy sauce, sugar, and garlic in a large bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta and rinse under cold water. Add to the sauce and toss to coat. Sprinkle with sesame seeds and green onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate until cold, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
