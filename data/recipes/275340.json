  "ingredients": [
    "1 cup packed brown sugar",
    "0.5 cup butter",
    "2 eggs",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup toffee baking bits",
    "1 cup chocolate chips",
    "1 tablespoon toffee baking bits, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, butter, and eggs together in a large bowl with an electric mixer. Stir in flour, baking powder, baking soda, and salt. Stir in 1 cup toffee bits and chocolate chips. Spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and edges have started to pull away from the sides of the pan, 23 to 28 minutes. Remove from the oven and immediately sprinkle evenly with 1 tablespoon toffee bits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
