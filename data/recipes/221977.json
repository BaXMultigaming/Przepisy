  "ingredients": [
    "1.25 cups chopped pecans",
    "0.75 cup brown sugar",
    "0.75 cup light corn syrup",
    "0.5 cup all-purpose flour",
    "0.5 cup butter, melted and cooled",
    "0.25 cup white sugar",
    "4 large eggs",
    "2 tablespoons bourbon",
    "1.5 teaspoons vanilla extract",
    "0.75 cup miniature semisweet chocolate chips",
    "1 (9 inch) unbaked deep dish pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Spread pecans evenly on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pecans in the preheated oven until toasted, stirring halfway through, about 10 to 15 minutes total; let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase the oven temperature to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk brown sugar, corn syrup, flour, butter, white sugar, eggs, bourbon, and vanilla together in a large bowl until smooth. Fold in pecans and chocolate until well combined. Pour mixture into prepared pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pie is set, 50 to 60 minutes. Serve warm or chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
