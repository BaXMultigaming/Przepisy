    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "4 large eggs",
    "4 large egg yolks",
    "0.5 teaspoon kosher salt",
    "1.25 cups white sugar",
    "0.25 cup light brown sugar",
    "1 teaspoon pure vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "1 medium lemon, zested",
    "3 cups whole milk",
    "2 cups heavy cream",
    "1 (1 pound) loaf stale sourdough French or Italian bread, cut into 3/8-inch slices",
    "4 tablespoons melted butter, divided",
    "1 pound fresh blueberries"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1Y_8m5Cjy0J65w_i7Z-OGNMitTE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-284838-the-best-blueberry-bread-pudding-VAT-step-01-b93d7900a49546439057619d07cc806f.jpg"
      ],
      "image": "assets/images/284838/step_01.webp"
    },
    {
      "text": "Vigorously whisk eggs, egg yolks, salt, white sugar, and brown sugar together in a large bowl until mixture turns light and frothy, about 1 minute. Add vanilla, cinnamon, lemon zest, milk, and cream; whisk to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VyNdISU3tIiVh1ynINhLJrAoEjY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-284838-the-best-blueberry-bread-pudding-VAT-step-02-e48723811d2742e4b3e2c58f782be0dd.jpg"
      ],
      "image": "assets/images/284838/step_02.webp"
    },
    {
      "text": "Toss in bread slices and press down until they start to soften and are submerged. Let sit, pressing down occasionally with a spatula, until custard has been absorbed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i0O6HuVr2smMGziuWLU3n4elbuI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-284838-the-best-blueberry-bread-pudding-VAT-step-03-1spatulainframe-5edc73ca14b3421d90be34a2b414ca49.jpg"
      ],
      "image": "assets/images/284838/step_03.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Brush 2 tablespoons melted butter in the bottom and sides of a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oYSjOvqoPf72eRGoziLpJBv3g6g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-284838-the-best-blueberry-bread-pudding-VAT-step-04-3b94d79d63664d1f9562dbc005033a6c.jpg"
      ],
      "image": "assets/images/284838/step_04.webp"
    },
    {
      "text": "Grab a few intact bread slices from the top of the bowl if possible and set aside. Transfer 1/2 of the remaining soaked bread into the prepared baking dish. Don't worry if it's falling apart, it should be; if not, break it up into pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_CF-vdvbtTw2Y5JuP6G2S9NpksA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-284838-the-best-blueberry-bread-pudding-VAT-step-05-251071be9d234bd686a92acef79c9195.jpg"
      ],
      "image": "assets/images/284838/step_05.webp"
    },
    {
      "text": "Add blueberries and spread with your fingers to press them down into the bread. Add remaining bread pieces in an even layer, then top with the reserved slices. Pour any remaining custard batter over top and brush with remaining melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nIAIbu_XehvkO6nDtQhLuK1GYEI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-284838-the-best-blueberry-bread-pudding-VAT-step-06-7488e09a83be4ceab44795a16800aed2.jpg"
      ],
      "image": "assets/images/284838/step_06.webp"
    },
    {
      "text": "Transfer bread pudding onto a baking sheet and place in the center of the preheated oven. Bake until puffed and golden brown, about 1 hour. Let sit for at least 20 to 30 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8dMGMPn7kQLiv8aH8qNVdhGiAVc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-284838-the-best-blueberry-bread-pudding-VAT-step-07-1trayinframe-93ce9d353fa54fc0848139e4951a5342.jpg"
      ],
      "image": "assets/images/284838/step_07.webp"
    },
    {
      "text": "Serve slightly warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7WOWjP4ixLBTqNfyLGYDa2Jy7Vc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-284838-the-best-blueberry-bread-pudding-VAT-4x3-casserole-lower-closer-20c91b5e12eb4467b519e15546ac495c.jpg"
      ],
      "image": "assets/images/284838/step_08.webp"
    }
  ],
