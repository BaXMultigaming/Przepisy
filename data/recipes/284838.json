  "title": "The Best Blueberry Bread Pudding",
  "description": "Fresh blueberries, tangy sourdough bread, and a creamy custard make this blueberry bread pudding a definite crowd-pleaser!",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2021-06-30T14:19:38-04:00",
  "date_modified": "2025-04-15T13:08:18-04:00",
