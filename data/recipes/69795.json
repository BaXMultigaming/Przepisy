  "ingredients": [
    "0.5 cup dried lentils",
    "1 cup water",
    "0.75 cup canned cream of coconut",
    "1 tablespoon curry paste",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Rinse lentils and place in a saucepan with the water. Bring to a boil, then cover, and simmer over low heat for 15 minutes. Stir in the curry paste, coconut cream and season with salt to taste. Return to a simmer, and cook for an additional 10 to 15 minutes, until tender.",
