  "ingredients": [
    "1 (17.6 ounce) container full-fat Greek yogurt",
    "2 tablespoons maple syrup, or to taste",
    "0.25 teaspoon vanilla extract",
    "0.25 cup sliced almonds",
    "0.25 cup freeze-dried blueberries",
    "2 tablespoons cacao nibs"
  ],
  "steps": [
    {
      "text": "Line two 9-inch rimmed baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together yogurt, maple syrup, and vanilla extract. Divide mixture between the 2 baking sheets and spread out using a spatula until about 1/4-inch thick. Scatter sliced almonds, dried blueberries, and cacao nibs evenly over each baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place baking sheets in the freezer for at least 3 hours, or overnight. Remove from freezer and roughly break or slice into about 2 dozen pieces.",
      "section": null,
      "name": null,
      "url": null,
