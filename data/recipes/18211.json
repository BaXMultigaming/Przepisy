  "title": "Pumpkin Cranberry Bread",
  "description": "This moist pumpkin cranberry bread is flavored with pumpkin spice, tangy cranberries, and walnuts for a delicious addition to your holiday table.",
  "authors": [
    "LINDAGEAN"
  ],
  "date_published": "2000-05-10T04:55:14-04:00",
