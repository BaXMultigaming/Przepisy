  "ingredients": [
    "2.25 cups all-purpose flour",
    "1 tablespoon pumpkin pie spice",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "2 cups white sugar",
    "1 (15 ounce) can pumpkin puree",
    "2 large eggs",
    "0.5 cup vegetable oil",
    "1 cup dried cranberries",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9x5-inch loaf pans (or 4 mini loaf pans).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, pumpkin pie spice, baking powder, and salt in a mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, pumpkin purée, eggs, and oil in a small mixing bowl. Beat until just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the wet mixture into the dry with a wooden spoon until batter is just moistened. Fold cranberries and walnuts into the batter. Spoon the batter into the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
