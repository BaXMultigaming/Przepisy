  "ingredients": [
    "2 cups shelled pistachio nuts",
    "2 large eggs",
    "2 tablespoons water",
    "2 pounds thick asparagus, shaved using a vegetable peeler",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place pistachio nuts in a food processor and pulse until finely ground. Transfer to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs with water in a shallow bowl. Roll asparagus in the egg wash, then in ground nuts. Place on a wire rack set on a sheet pan. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C) while pistachio crust sets, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
