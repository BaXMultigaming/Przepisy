  "ingredients": [
    "aluminum foil",
    "cooking spray",
    "1 pound ground turkey",
    "1 cup crushed pork rinds",
    "0.5 cup shredded Parmesan cheese",
    "1 egg",
    "1 tablespoon chopped fresh parsley",
    "1 teaspoon minced garlic",
    "1 teaspoon onion powder",
    "1 teaspoon Italian seasoning",
    "0.125 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground turkey, pork rinds, Parmesan cheese, egg, parsley, garlic, onion powder, Italian seasoning, and red pepper flakes in a large bowl. Mix with your hands until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop out meat mixture to form twelve 1 1/2-inch meatballs. Place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until meatballs are no longer pink at the center and juices run clear, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
