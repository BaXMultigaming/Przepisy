  "ingredients": [
    "6 cups water",
    "1 cup Thai tea leaves",
    "1 tablespoon vanilla extract",
    "0.5 teaspoon crushed cardamom pods",
    "0.25 teaspoon crushed cloves",
    "0.25 teaspoon ground cinnamon",
    "1.25 cups white sugar",
    "1 cup half-and-half, or to taste",
    "crushed ice, as needed"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a saucepan. Stir in tea leaves, vanilla extract, cardamom, cloves, and cinnamon. Cover and remove from the heat. Let steep for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour tea through a fine mesh strainer; discard tea leaves. Add sugar and stir until dissolved. Cover and chill in the refrigerator for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill glasses with crushed ice. Pour tea into glasses and top with half-and-half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
