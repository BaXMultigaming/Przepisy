  "ingredients": [
    "1 pound smoked pork butt",
    "water to cover",
    "salt and ground black pepper to taste",
    "2 pounds red potatoes, peeled",
    "1 head cabbage, cored and quartered"
  ],
  "steps": [
    {
      "text": "Place smoked pork butt in a 6-quart pot with enough water to cover; season with salt and pepper. Bring to a boil over medium-high heat, then reduce heat to medium-low and simmer for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in potatoes and cabbage. Simmer until potatoes are tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pork from soup and cut into quarters; return pork to pot until ready to serve. Season with more salt and pepper, if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
