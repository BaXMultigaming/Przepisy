  "ingredients": [
    "0.5 cup butter, softened",
    "0.25 cup crumbled blue cheese",
    "2 teaspoons fresh thyme leaves",
    "salt and freshly ground black pepper to taste",
    "4 (4 ounce) filet mignon steaks",
    "2 teaspoons canola oil, or as needed"
  ],
  "steps": [
    {
      "text": "Mash butter, blue cheese, and thyme together in a small bowl until well combined. Season with salt and pepper. Cover and refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush steaks with oil and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook steaks on the preheated grill until firm and reddish-pink and juicy in the center, about 5 minutes per side. An instant-read thermometer inserted into the center should read 130 degrees F (54 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer steaks to a platter and top with some of the butter mixture. Let them rest for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
