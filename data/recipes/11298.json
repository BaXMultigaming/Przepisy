  "ingredients": [
    "1.5 cups rolled oats",
    "1.5 cups sifted pastry flour",
    "1.333 cups packed brown sugar, divided",
    "0.75 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.75 cup butter, softened",
    "0.75 pound pitted dates, diced",
    "1 cup water",
    "1 teaspoon lemon juice"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5F7brMMGuvlkAezSvw-hqOPQ6b8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11298-grammas-date-squares-DDMFS-step-01-e0a228fa52194753a66bfae30445ed74.jpg"
      ],
      "image": "assets/images/11298/step_01.webp"
    },
    {
      "text": "Combine oats, pastry flour, 1 cup brown sugar, baking soda, and salt in a large bowl. Mix in butter until crumbly. Press half of the mixture into the bottom of a 9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OmZTYyCsObOuM3HEoPCzPfzXBB8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11298-grammas-date-squares-DDMFS-step-02-0609b88af5d24768ba59ef0524770301.jpg"
      ],
      "image": "assets/images/11298/step_02.webp"
    },
    {
      "text": "Combine dates, water, and remaining 1/3 cup brown sugar in a small saucepan over medium heat. Bring to a boil, and cook until thickened. Stir in lemon juice, and remove from heat. Spread the filling over the base, and spread the remaining crumb mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fqwGc52DydLKDllgn-fPbvKyrfc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11298-grammas-date-squares-DDMFS-step-03-5936a8db65ca4e0087bf2c51882434cc.jpg"
      ],
      "image": "assets/images/11298/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until the top is lightly toasted, 20 to 25 minutes. Cool before cutting into 12 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MbSm8Tso9-EeHwzuYsKJ1_ZmQWA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11298-grammas-date-squares-DDMFS-step-04-595d87a5d1e74bb3b8310fd79707758b.jpg"
      ],
      "image": "assets/images/11298/step_04.webp"
    }
