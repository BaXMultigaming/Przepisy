  "ingredients": [
    "4 (2.05 ounce) bars milk chocolate covered caramel and nougat candy bars (e.g. Milky Way®)",
    "0.25 cup butter",
    "1 tablespoon milk",
    "2 teaspoons vanilla extract",
    "1.25 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Place candy bars, butter, milk and vanilla in a microwave safe bowl and microwave on High for 30 seconds; stir. Heat for an additional 10 seconds, remove the bowl from the mircrowave and stir again. Add confectioners' sugar and stir until smooth and creamy.",
