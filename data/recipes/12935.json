  "ingredients": [
    "2 cucumbers",
    "2 tablespoons thinly sliced green onion",
    "2 tablespoons margarine",
    "1 tablespoon red wine vinegar",
    "4 cups chicken broth",
    "1 tablespoon farina",
    "salt to taste",
    "0.125 tablespoon dried tarragon",
    "0.5 cup sour cream",
    "3 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Peel, seed, and chop 2 cucumbers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook the chopped scallions in the margarine until soft. Add the chopped cucumbers and the wine vinegar. Pour in the broth, and stir in the farina. Salt to taste, and add tarragon. Let the soup simmer for 20 minutes, or until the cucumbers are soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put the soup into a blender, and puree it.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the puree into a bowl, and whisk in the sour cream. Taste the soup for seasoning. Pour the soup into bowls, and garnish with cucumber slices and chopped parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
