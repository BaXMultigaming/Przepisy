  "title": "Cucumber Soup I",
  "description": "This is a refreshing soup of cucumbers simmered in chicken broth with scallions, farina and tarragon, pureed and combined with sour cream. Serve hot or cold.",
  "authors": [
    "Richard"
  ],
  "date_published": "1999-01-24T09:26:32-05:00",
