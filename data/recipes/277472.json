  "ingredients": [
    "2 cups water",
    "1 (12 ounce) bag fresh cranberries",
    "1 cup white sugar",
    "1 (3 ounce) package raspberry-flavored gelatin mix (such as Jell-O®)",
    "1 (15 ounce) can crushed pineapple"
  ],
  "steps": [
    {
      "text": "Combine water, cranberries, and sugar in a saucepan over medium heat; bring to a boil. Reduce heat to a simmer and cook until cranberries pop, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a serving bowl. Mix in raspberry-flavored gelatin and crushed pineapple. Refrigerate until chilled, 8 hours to overnight.",
