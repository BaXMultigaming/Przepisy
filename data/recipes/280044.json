  "ingredients": [
    "cooking spray",
    "5 large eggs, beaten",
    "2 cups shredded sharp Cheddar cheese",
    "1 cup small-curd cottage cheese",
    "0.25 cup all-purpose flour",
    "4 tablespoons salted butter, melted",
    "0.5 teaspoon baking powder",
    "0.125 teaspoon salt",
