  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees. Coat an 8-inch square baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, Cheddar cheese, cottage cheese, flour, butter, baking powder, and salt in a large bowl. Stir to mix well. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and a knife inserted into the center comes out clean, about 25 minutes. Let cool for 5 minutes. Top with hot sauce before serving.",
