  "ingredients": [
    "cooking spray (such as Pam®)",
    "1 pound ground beef",
    "1 small onion, chopped",
    "2.5 cups all-purpose flour",
    "1 tablespoon white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "0.75 cup ketchup",
    "0.75 cup milk",
    "0.5 cup butter, melted",
    "2 eggs, beaten",
    "1 teaspoon prepared yellow mustard",
    "2 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Line 24 muffin cups with paper cups and lightly coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef and onion in the hot skillet until the beef is completely browned and crumbly, 5 to 7 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, baking powder, and salt together in a large bowl. Stir ketchup, milk, butter, eggs, and mustard together in a separate bowl; add to flour mixture and stir until pink in color. Mix ground beef mixture into the flour mixture; spoon into prepared muffin cups to completely filled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 40 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
