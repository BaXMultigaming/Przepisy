  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "1 cup frozen cranberries, thawed",
    "1.25 cups plain yogurt",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "2 large eggs, beaten",
    "1 cup quick-cooking oats",
    "1 cup frozen blueberries, thawed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12-cup muffin pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend flour, baking powder, and baking soda together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chop thawed cranberries in half; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine yogurt, white sugar, brown sugar, and beaten eggs in a large bowl. Stir with a wire whisk until light and creamy. Add oats, blueberries, and cranberries and stir until no lumps remain. Slowly stir in dry ingredients until all flour is incorporated into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light brown on top, about 20 minutes. Allow to cool for 5 minutes before removing from the pan and placing on a serving plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
