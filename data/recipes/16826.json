  "ingredients": [
    "1 (8 ounce) package 15 bean soup mix",
    "12 cups water",
    "1 pound bacon",
    "2 (4 ounce) cans canned green chile peppers, chopped",
    "1 tablespoon chili powder",
    "1 tablespoon crushed red pepper flakes",
    "1 onion, chopped",
    "2 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Rinse and sort the beans in the mix. Place them in a slow cooker on low setting with the water. Cook overnight. The next morning, add the ham, chile peppers, chili powder, crushed red pepper, onion and garlic and continue to cook on low for 8 hours.",
