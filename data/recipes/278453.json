  "ingredients": [
    "1 cup fresh parsley",
    "0.5 cup extra-virgin olive oil",
    "2 tablespoons fresh oregano",
    "2 tablespoons red wine vinegar",
    "1 tablespoon water",
    "1 jalapeno chile pepper, seeded",
    "2 cloves garlic, chopped",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper"
