  "ingredients": [
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "6 tablespoons unsweetened cocoa powder",
    "2 teaspoons baking soda",
    "2 teaspoons baking powder",
    "2 cups water",
    "0.66666668653488 cup vegetable oil",
    "2 tablespoons distilled white vinegar",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, cocoa powder, baking soda, and baking powder together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix water, oil, vinegar, and vanilla together in a separate bowl; pour wet ingredients into dry ingredients and beat with an electric mixer until smooth. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes. Remove from the oven and let cool in the pan, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle confectioners’ sugar over cooled cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
