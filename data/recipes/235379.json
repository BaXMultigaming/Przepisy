  "ingredients": [
    "1 (3 pound) boneless pork loin roast",
    "water as needed",
    "1 pinch garlic salt",
    "ground black pepper to taste",
    "2 (14 ounce) cans green enchilada sauce, divided",
    "0.5 cup brown sugar",
    "1 (15 ounce) package flour tortillas",
    "2 (15 ounce) cans black beans, rinsed and drained",
    "0.25 cup chopped cilantro, or to taste",
    "0.5 cup shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Place pork in a slow cooker with enough water to cover bottom by 2 inches. Season pork with garlic salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pork to a bowl and shred meat with 2 forks. Mix 1 can enchilada sauce and brown sugar into pork. Pour half the remaining can of sauce into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread about 1/4 cup pork mixture down the center of each tortilla; top with black beans and cilantro. Roll tortillas around filling and arrange in prepared baking dish, seam sides down. Pour remaining half can enchilada sauce over tortillas and cover with Monterey Jack cheese. Cover baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and sauce is bubbly, 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
