  "ingredients": [
    "1 pound ground beef",
    "1 cup ketchup",
    "0.5 (12 ounce) bottle chili sauce",
    "0.5 cup dark brown sugar",
    "0.25 cup grated Parmesan cheese, or to taste",
    "1 teaspoon sweet pickle relish",
    "1 teaspoon minced onion",
    "1 teaspoon Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Mix ketchup, chili sauce, brown sugar, Parmesan cheese, relish, onion, and Worcestershire sauce into ground beef; simmer until heated through and flavors blend, 20 to 25 minutes.",
