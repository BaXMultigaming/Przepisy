  "ingredients": [
    "1 pound ground beef",
    "0.5 cup chopped onion",
    "1 (4.5 ounce) can mushrooms, drained",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon mustard powder",
    "2 tablespoons all-purpose flour",
    "0.5 cup beef broth",
    "1 tablespoon Worcestershire sauce",
    "1/2 teaspoon freshly ground black pepper",
    "1 (8 ounce) package wide egg noodles",
    "0.5 cup sour cream",
    "freshly chopped parsley"
  ],
  "steps": [
    {
      "text": "Cook ground beef, onion, mushrooms, garlic powder, and mustard powder in a large skillet over medium heat until beef is browned and crumbly, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle flour evenly over beef mixture and stir well until coated. Stir in beef broth, Worcestershire sauce, and black pepper, scraping up browned bits with a wooden spoon. Bring to a simmer and cook until slightly thickened, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook egg noodles in a large pot of boiling salted water until tender, about 7 to 9 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove beef stroganoff from heat; stir in sour cream until blended and heated through. Serve over hot egg noodles and garnish with freshly chopped parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
