  "ingredients": [
    "2 tablespoons diced onion",
    "2 tablespoons carrot matchsticks",
    "1 tablespoon chopped fresh cilantro",
    "0.25 teaspoon chili powder",
    "0.25 teaspoon ground cumin",
    "1 pinch cayenne pepper",
    "8 uncooked medium shrimp, peeled and deveined",
    "1 tablespoon olive oil",
    "2 (6 inch) corn tortillas",
    "0.5 cup shredded cabbage",
    "0.5 cup Caesar salad dressing (such as Cardini's Red Jalapeno Caesar Dressing®)"
  ],
  "steps": [
    {
      "text": "Combine onion, carrots, and cilantro in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk chili powder, cumin, and cayenne pepper together in a separate bowl. Add shrimp; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium heat. Add shrimp; cook for 2 minutes. Flip; cook until pink, about 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap tortillas in damp paper towels; microwave until warm, 15 to 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide shrimp between tortillas. Top with cabbage, onion mixture, and dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
