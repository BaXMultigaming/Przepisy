  "ingredients": [
    "2 cups maple syrup",
    "1 cup heavy cream",
    "0.75 cup dark brown sugar",
    "2 tablespoons butter",
    "1 pinch salt",
    "0.66666668653488 cup chopped walnuts",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Line an 8x8-inch baking pan with waxed paper. Butter the paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring maple syrup, heavy cream, and brown sugar to a boil in a saucepan over medium heat. Continue to boil, without stirring, until mixture starts to bubble and registers 240 degrees F (166 degrees C) on a candy thermometer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat. Add butter and salt but do not mix. Let sit until mixture reaches 105 degrees F (41 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add walnuts and vanilla; beat until mixture loses its gloss. Pour into the prepared pan and let cool to room temperature. Cut, wrap, and store in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
