  "ingredients": [
    "2 russet potatoes",
    "0.25 teaspoon olive oil",
    "salt to taste",
    "2 sheets aluminum foil"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill to medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wash and dry potatoes. Poke potatoes all over with a fork. Rub with olive oil and sprinkle with salt. Roll each potato up in aluminum foil and fold the ends in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes on preheated grill and close the lid. Grill wrapped potatoes until fork-tender, rotating every 15 minutes or so, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
