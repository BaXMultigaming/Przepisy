  "ingredients": [
    "12 (1 ounce) squares semisweet chocolate, chopped",
    "0.5 cup chopped dried cranberries",
    "0.5 cup slivered almonds",
    "0.5 cup chopped dried apricots"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with a sheet of waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until chocolate is melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cranberries, almonds, and apricots in a bowl. Add to melted chocolate and mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread chocolate onto the prepared baking sheet to a thickness of about 1/4 inch. Place baking sheet in the refrigerator until chocolate has completely hardened, about 1 hour. Break into pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
