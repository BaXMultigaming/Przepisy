  "ingredients": [
    "cooking spray",
    "2 (12 ounce) pork tenderloins",
    "0.5 cup bread crumbs",
    "0.5 cup chopped fresh parsley",
    "0.33333334326744 cup grated Parmesan cheese",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon salt",
    "0.25 teaspoon freshly ground black pepper",
    "0.25 cup Dijon mustard",
    "2 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange pork tenderloins in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together bread crumbs, parsley, Parmesan cheese, thyme, salt, and black pepper in a medium bowl until well combined; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together mustard and garlic in a small bowl until well combined, then spread over pork. Sprinkle bread crumb mixture over mustard coating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pork in the preheated oven until no longer pink in the center, about 20 minutes. An instant-read thermometer inserted into the center should read 160 degrees F (70 degrees C). Allow pork to rest for 5 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
