  "ingredients": [
    "1.5 cups milk",
    "0.75 cup rolled oats",
    "2 tablespoons brown sugar",
    "1 tablespoon white sugar",
    "2 teaspoons ground cinnamon",
    "1 teaspoon pumpkin pie spice",
    "0.25 teaspoon salt",
    "0.25 cup canned pumpkin"
  ],
  "steps": [
    {
      "text": "Bring milk to boil in a small pot over medium-high. Stir oats, brown sugar, white sugar, cinnamon, pumpkin pie spice, and salt into the boiling milk. Place a cover on the pot, reduce heat to medium-low, and cook, stirring occasionally, for 3 minutes. Stir pumpkin puree into oat mixture until smooth; cook and stir continually another 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat; let oatmeal set 2 minutes before serving.",
