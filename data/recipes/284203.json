  "ingredients": [
    "8 ounces conchiglie pasta (small shells)",
    "0.5 cup minced celery",
    "0.25 cup diced red bell pepper",
    "0.25 cup diced green bell pepper",
    "0.25 cup chopped sweet pickles",
    "2 stalks green onion, thinly sliced",
    "1 tablespoon red wine vinegar",
    "0.25 teaspoon seasoning salt, or to taste",
    "0.25 teaspoon ground black pepper",
    "0.5 cup mayonnaise",
    "0.5 cup sour cream",
    "0.5 cup cubed sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to a boil. Add shells and cook, stirring occasionally, until tender yet firm to the bite, 8 to 9 minutes. Drain in a colander, rinse briefly with cold water, and drain again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine celery, red and green bell pepper, pickles, green onion, vinegar, 1/4 teaspoon seasoning salt, and pepper in a medium bowl; mix well. Fold in mayonnaise and sour cream until well blended. Taste and add additional seasoning salt if needed. Fold in pasta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerator at least 4 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the refrigerator. Fold in Cheddar cheese and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
