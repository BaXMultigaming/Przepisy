  "ingredients": [
    "1 (3 pound) boneless pork shoulder roast",
    "1 cup ketchup",
    "0.5 cup firmly packed brown sugar",
    "0.25 cup apple cider vinegar",
    "1 (1 ounce) envelope dry onion soup mix (such as Lipton®)",
    "1 tablespoon hot sauce, or to taste",
    "10 hamburger buns, split"
  ],
  "steps": [
    {
      "text": "Place pork roast in a slow cooker. Whisk ketchup, brown sugar, vinegar, onion soup mix, and hot sauce together in a bowl until well combined; pour over pork roast. Turn pork to coat completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 8 to 10 hours or High for 4 to 6 hours. Shred pork with 2 forks. Serve on hamburger buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
