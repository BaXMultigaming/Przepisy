  "ingredients": [
    "3 cups quick cooking oats",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 cups packed brown sugar",
    "1 cup butter, softened",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "1 (14 ounce) can sweetened condensed milk",
    "1.5 cups semisweet chocolate chips",
    "2 tablespoons butter",
    "0.5 teaspoon salt",
    "0.5 cup chopped walnuts",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the oatmeal batter: Combine oats, flour, baking soda, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter with an electric mixer in a large bowl until fluffy. Mix in eggs and vanilla. Stir in flour mixture until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the filling: Heat condensed milk, chocolate chips, butter, and salt in a medium saucepan over low heat, stirring frequently, until smooth, 5 to 8 minutes. Remove from the heat and stir in walnuts and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat 2/3 of the oatmeal batter into the bottom of the prepared pan. Spread filling evenly over top, then dot with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 35 minutes. Remove to a wire rack and let cool completely before cutting into 24 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
