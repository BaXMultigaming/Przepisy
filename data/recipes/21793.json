  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Coat a 10-inch pie plate with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine zucchini, tomato, onion, and Parmesan cheese in the prepared pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat baking mix, eggs, milk, salt, and black pepper together in a bowl until smooth; pour over zucchini mixture.",
