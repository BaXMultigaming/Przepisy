  "ingredients": [
    "0.5 pound chorizo sausage, chopped",
    "0.25 cup olive oil",
    "2 carrots, chopped",
    "1 cup chopped onion",
    "5 stalks celery, chopped",
    "5 tomatoes, chopped",
    "3 small potatoes, peeled and chopped",
    "3 quarts chicken broth",
    "1.5 tablespoons cayenne pepper",
    "1 (15 ounce) can kidney beans, drained",
    "0.5 cup tomato paste",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Place sausage in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a stockpot over medium-high heat. Add carrots, onion, and celery; cook and stir for 2 to 3 minutes. Add tomatoes, potatoes, kidney beans and chicken broth. Bring to a boil and stir in cayenne pepper and tomato paste. Reduce heat and simmer for 20 minutes. Add sausage and season with salt and pepper to taste. Serve hot.",
