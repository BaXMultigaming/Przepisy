  "ingredients": [
    "2 cups canned pumpkin puree",
    "2 tablespoons butter, room temperature",
    "2 eggs, lightly beaten",
    "4 egg whites, lightly beaten",
    "0.5 cup brown sugar",
    "0.5 teaspoon baking soda",
    "1 teaspoon salt",
    "2 teaspoons ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground cloves",
    "1 cup low-fat plain yogurt",
    "2 cups polenta or yellow cornmeal"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a blender or food processor, blend pumpkin, butter, eggs, and egg whites. Mix in the brown sugar, baking soda, salt, cinnamon, nutmeg, and cloves. Blend until smooth, and transfer to a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix yogurt and polenta into the pumpkin mixture. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until a toothpick inserted in the center comes out clean, about 45 minutes. Cool slightly before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
