  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease 6 small ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine peaches, raspberries, ⅓ cup white sugar, lemon juice, and 1 pinch cinnamon in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, butter, brown sugar, ¼ cup white sugar, vanilla extract, salt, and remaining 1 pinch cinnamon in a separate medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide raspberry-peach mixture among prepared ramekins; divide and top with oat mixture. Arrange ramekins on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crisp and golden brown, about 35 minutes. Cool before serving, 10 minutes.",
