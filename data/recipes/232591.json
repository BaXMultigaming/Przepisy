  "ingredients": [
    "1 pound ground beef",
    "0.25 cup chopped green onion",
    "2 tablespoons hoisin sauce",
    "1 tablespoon Asian-style Sriracha chile-garlic sauce",
    "1 teaspoon Asian (toasted) sesame oil",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon red pepper flakes, or to taste",
    "0.25 teaspoon ground ginger",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef, green onion, hoisin sauce, Sriracha sauce, sesame oil, garlic powder, red pepper flakes, ginger, salt, and black pepper together in a bowl until thoroughly combined. Divide meat mixture into quarters; form each portion into a patty.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill on the preheated grill until meat is browned and no longer pink inside, about 10 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
