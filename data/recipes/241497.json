  "ingredients": [
    "1.5 cups quick-cooking oats",
    "1.25 cups all-purpose flour",
    "1.25 cups brown sugar",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.75 cup butter",
    "0.5 pound dates, pitted and chopped",
    "0.75 cup water",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oats, flour, brown sugar, baking soda, and baking powder together in a bowl; cut in butter using a pastry blender until mixture is mealy and butter pieces are uniformly small.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press half of oat mixture evenly into the bottom of a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook dates with water in a small saucepan over medium heat until they fall apart and are easily mashed with a wooden spoon, about 10 minutes; remove from heat and stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon date mixture evenly over oat mixture in baking pan; sprinkle remaining oat mixture evenly over top and press into place.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden at the edges, about 30 minutes; remove to cool completely on a wire rack. Cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
