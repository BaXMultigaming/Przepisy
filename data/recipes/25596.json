  "ingredients": [
    "0.75 cup white sugar",
    "1 pinch salt",
    "3 tablespoons butter, melted",
    "0.25 cup sifted all-purpose flour",
    "1 teaspoon grated lemon zest",
    "0.25 cup lemon juice",
    "1.5 cups milk",
    "3 egg yolks",
    "3 egg whites"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour an 8 inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine sugar, salt and melted butter. Beat in the flour. Stir in the lemon zest and lemon juice. Combine milk and egg yolks, and add to lemon mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large glass or metal mixing bowl, beat egg whites until stiff peaks form. Fold 1/3 of the whites into the batter, then quickly fold in remaining whites until no streaks remain. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set cake pan in a water bath. Bake in the preheated oven for 40 minutes, or until top is lightly browned. Serve warm or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
