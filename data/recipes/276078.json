  "title": "Homemade Red Velvet Cake",
  "description": "This homemade red velvet cake recipe yields a moist red cake with chocolaty flavor topped with a tangy cream cheese frosting for a delicious dessert.",
  "authors": [
    "iluvfewd"
  ],
  "date_published": "2020-06-19T00:41:08-04:00",
