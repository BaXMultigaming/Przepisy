  "ingredients": [
    "3 tablespoons cornstarch",
    "2 tablespoons water",
    "1.5 cups soy milk",
    "0.25 cup white sugar",
    "0.25 cup unsweetened cocoa powder",
    "0.25 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1Gx5vH0YYZGFzZNuVaZp7zz5qao=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20366-Dairy-Free-Chocolate-Pudding-ddmfs-4x3-step-01-0a410f043ad4415c9f26c2ec59ab5b91.jpg"
      ],
      "image": "assets/images/20366/step_01.webp"
    },
    {
      "text": "Mix cornstarch and water together in a small bowl until a paste forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aQsZCGy8FuPB2Xsm7YCuyl856n0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20366-Dairy-Free-Chocolate-Pudding-ddmfs-4x3-step-02-18039a6dadca41eb94135bbbb9910557.jpg"
      ],
      "image": "assets/images/20366/step_02.webp"
    },
    {
      "text": "Combine soy milk, sugar, cocoa, and vanilla in a large saucepan; stir in cornstarch paste until well combined. Cook over medium heat, stirring constantly, until boiling. Continue to cook and stir until mixture thickens, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Wx1R0Ofbx8QSVG4QniFscSi0YZY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20366-Dairy-Free-Chocolate-Pudding-ddmfs-4x3-step-03-7b73df6f028548efb157c75a98ea795c.jpg"
      ],
      "image": "assets/images/20366/step_03.webp"
    },
    {
      "text": "Remove from the heat and let cool for 5 minutes; pudding will continue to thicken as it cools. Cover and refrigerate until completely cool, 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8xCUYCql4UpenMbpzt8xacxwWSo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20366-Dairy-Free-Chocolate-Pudding-ddmfs-4x3-step-04-78ba07a6cab443229586984a7b6d59ff.jpg"
      ],
      "image": "assets/images/20366/step_04.webp"
    }
  ],
