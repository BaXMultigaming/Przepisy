  "ingredients": [
    "1 tablespoon olive oil",
    "1 savoy cabbage, sliced",
    "1 (8 ounce) package sliced fresh mushrooms",
    "0.5 teaspoon dried cilantro leaves",
    "salt to taste",
    "0.5 cup vegetable broth"
  ],
  "steps": [
    {
      "text": "Heat oil in a pot over medium-low heat. Add cabbage and mushrooms; cook and stir until softened, about 5 minutes. Season with cilantro and salt. Add broth, cover, and simmer until cabbage is cooked through, about 20 minutes.",
