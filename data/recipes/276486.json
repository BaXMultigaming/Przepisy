  "ingredients": [
    "3 cups water",
    "1 cup milk",
    "9.25 ounces instant polenta",
    "0.5 cup shredded Parmesan cheese",
    "2 tablespoons butter",
    "1 tablespoon olive oil",
    "2 (3.5 ounce) links sweet Italian sausage, casings removed",
    "1 cup sliced mushrooms",
    "0.5 cup chopped onions",
    "3 cloves garlic, diced",
    "1.5 cups dry white wine",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (6 ounce) can tomato paste",
    "1 tablespoon white sugar",
    "1 teaspoon Italian seasoning",
    "0.5 teaspoon dried oregano",
    "2 cups shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water and milk in a large saucepan with polenta. Bring to a boil over high heat; add Parmesan cheese and butter. Stir constantly until thickened, about 3 minutes. Pour polenta into a large, round casserole dish, filling about 1 inch deep.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a medium nonstick skillet over medium-high heat. Cook and stir sausage, mushrooms, onion, and garlic in the skillet until sausage is browned and crumbly, about 10 minutes. Add wine, tomatoes, tomato paste, sugar, Italian seasoning, and oregano; cook over medium heat for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour tomato sauce mixture over polenta. Top with mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
