  "ingredients": [
    "2 tablespoons butter",
    "1 tablespoon minced garlic",
    "1 tablespoon minced yellow onion",
    "0.5 cup dry white wine",
    "0.25 cup fresh lemon juice",
    "0.66666668653488 cup cold butter, sliced",
    "1.5 cups chopped sun-dried tomatoes",
    "0.25 cup chopped fresh basil",
    "0.5 teaspoon kosher salt",
    "0.5 teaspoon ground white pepper",
    "6 skinless, boneless chicken breast halves",
    "1 tablespoon extra-virgin olive oil, or as needed",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 (8 ounce) package caprino (goat's milk) cheese"
  ],
  "steps": [
    {
      "text": "Heat 2 tablespoons butter over medium heat in a large skillet. Cook and stir garlic and onion in the hot oil until tender, 3 to 4 minutes. Stir in wine and lemon juice, increase heat to medium-high, and simmer to reduce by 1/2, about 10 minutes. Reduce heat to low and stir in cold butter, 1 slice at a time. Stir in tomatoes, basil, kosher salt, and white pepper; remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush chicken breasts with olive oil and sprinkle with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook chicken on the preheated grill until no longer pink in the center, 15 to 20 minutes. Place equal amounts of goat cheese on top of each chicken breast in the last few minutes of cooking. Spoon sun-dried tomato sauce over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
