  "ingredients": [
    "1 (16 ounce) package water-packed firm tofu, drained and rinsed",
    "6 tablespoons nutritional yeast",
    "0.5 teaspoon garlic powder, or to taste",
    "salt and ground black pepper to taste",
    "1.5 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Slice tofu into 1/4-inch-thick slabs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place nutritional yeast on a plate. Mix in garlic powder, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll tofu slices in nutritional yeast mixture until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a nonstick skillet over low to medium heat. Add tofu slices; cook until golden brown and crispy, 3 to 5 minutes per side.",
