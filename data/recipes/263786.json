  "ingredients": [
    "1 cup butter",
    "1 cup white sugar",
    "3 eggs",
    "2 cups grated zucchini",
    "1 cup grated carrots",
    "3 teaspoons vanilla extract",
    "3 cups all-purpose flour",
    "2 teaspoons ground nutmeg",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 21 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, sugar, and eggs together in a large bowl with an electric mixer until creamy; beat in zucchini, carrots, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, nutmeg, cinnamon, salt, baking soda, and baking powder in a separate bowl; stir into zucchini mixture until combined. Stir in raisins and walnuts. Divide batter among the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 17 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
