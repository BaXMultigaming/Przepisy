  "ingredients": [
    "1 (16 ounce) package dry whole-wheat noodles",
    "0.5 cup chicken stock",
    "0.5 cup orange marmalade",
    "0.33333334326744 cup tamari sauce",
    "1 (1 inch) piece ginger root, peeled",
    "ground black pepper to taste",
    "1 lemon, juiced",
    "3 tablespoons peanut oil",
    "2 pounds skinless, boneless chicken breast halves, cut into thin strips",
    "1 (16 ounce) bag frozen stir-fry vegetables, thawed"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in whole-wheat noodles and return to a boil. Cook uncovered, stirring occasionally, until the pasta has cooked through but is firm to the bite, 5 to 8 minutes. Drain well and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chicken stock, orange marmalade, tamari sauce, whole ginger root piece, and ground black pepper in a pot over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring sauce to a boil and reduce heat to medium. Simmer until sauce reduces and thickens; about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove sauce from heat. Stir in lemon juice and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat peanut oil in a large skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir chicken in hot oil until golden, no longer pink in the center, and the juices run clear, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from skillet and set aside, leaving oil in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir the stir-fry vegetables in the same skillet used for the chicken until vegetables are almost tender, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove ginger root piece from sauce and discard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chicken and sauce into vegetables and cook until heated through, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve over whole-wheat noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
