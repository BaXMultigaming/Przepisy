  "title": "Citrus Chicken Stir Fry",
  "description": "This quick and easy citrus chicken stir fry gets its kick from a combination of flavors including lemon juice, fresh ginger, and orange marmalade.",
  "authors": [
    "cookied"
  ],
  "date_published": "2015-07-25T02:04:02-04:00",
