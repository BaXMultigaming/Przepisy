  "ingredients": [
    "0.75 cup water",
    "0.75 cup distilled white vinegar",
    "3 tablespoons white sugar",
    "1 tablespoon kosher salt",
    "1 clove garlic, crushed",
    "0.5 teaspoon oregano",
    "10 large jalapeno peppers, sliced into rings"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2ui9K1ASHRrHyXLk_zFewZ41xuI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221961-Quick-Pickled-Jalapeno-Rings-4x3-step-01-2f4d886e94b74cdea05dd2c5e8b20f96.jpg"
      ],
      "image": "assets/images/221961/step_01.webp"
    },
    {
      "text": "Combine water, vinegar, sugar, kosher salt, garlic, and oregano in a saucepan over high heat. Bring mixture to a boil, stir in jalapeño peppers, and remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/klPnSOjGZLxNVDLO690ebdpjkAs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221961-Quick-Pickled-Jalapeno-Rings-4x3-step-02-277c3801f74a4f91ac53b179ddfb0f9a.jpg"
      ],
      "image": "assets/images/221961/step_02.webp"
    },
    {
      "text": "Let mixture cool for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DRHPKezj5WOn4uRVrUD-mggftdg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221961-Quick-Pickled-Jalapeno-Rings-4x3-step-03-b4285fc018504d1eb7f581ece459b4c0.jpg"
      ],
      "image": "assets/images/221961/step_03.webp"
    },
    {
      "text": "Pack peppers into two 8-ounce jars using tongs and cover with vinegar brine mixture. Let pickles cool completely at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AgGp-Tc-93hJ1Sd_Pine7cp7Jxc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221961-Quick-Pickled-Jalapeno-Rings-4x3-step-04-92504fafbb3c454e80a853e7813182f4.jpg"
      ],
      "image": "assets/images/221961/step_04.webp"
    },
    {
      "text": "Cover jars with tight-fitting lids and refrigerate until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G6a_354DiDXW96kqgpc2HtHyZJo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221961-Quick-Pickled-Jalapeno-Rings-4x3-f5169703c8f74c86b8caebd9b616c94b.jpg"
