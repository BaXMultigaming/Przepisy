  "ingredients": [
    "4 (6 ounce) fillets cod",
    "1 cup creamy Italian-style salad dressing",
    "0.25 cup shredded sharp Cheddar cheese",
    "1 cup crushed potato chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 500 degrees F (260 degrees C). Coat a 9x13 inch baking dish with non-stick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, marinate the fish fillets in the salad dressing for a few minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss the shredded cheese and crushed chips together. Place the marinated fish fillets in the prepared baking dish and top with the cheese/chip mixture. Discard the leftover marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered in the preheated oven for 8 to 10 minutes or until the fish can be flaked with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
