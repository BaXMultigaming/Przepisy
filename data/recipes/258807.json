  "ingredients": [
    "1.25 cups cashew milk",
    "0.25 cup raw cashews",
    "1 tablespoon fresh lemon juice",
    "1 tablespoon chia seeds, or more to taste",
    "1 teaspoon onion powder",
    "0.25 teaspoon salt",
    "0.25 teaspoon granulated garlic",
    "1 tablespoon dried chopped onion",
    "1 tablespoon dried dill",
    "1 tablespoon dried parsley"
  ],
  "steps": [
    {
      "text": "Combine cashew milk, cashews, lemon juice, chia seeds, onion powder, salt, and granulated garlic in a blender. Blend on high speed until smooth. Add dried onion, dill, and parsley; pulse a few times more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate until well chilled, at least 1 hour.",
