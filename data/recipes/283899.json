  "steps": [
    {
      "text": "Spray a regular size mug with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour, powdered sugar, cocoa powder, a little less than ¼ teaspoon baking powder, and a pinch of salt to the mug. Mix everything well using a fork. Add milk, oil, and chocolate essence to taste. Stir until just smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
