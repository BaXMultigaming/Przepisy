  "ingredients": [
    "2.5 cups all-purpose flour",
    "0.75 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1.5 cups white sugar",
    "0.5 cup butter, softened",
    "0.5 cup shortening",
    "1 teaspoon vanilla extract",
    "1 egg",
    "2 tablespoons milk",
    "1 tablespoon white sugar, or as desired"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, salt, and baking soda together in a bowl. Beat 1 ½ cups sugar, butter, shortening, and vanilla extract together in a separate bowl until thoroughly combined. Add egg; beat until creamy. Stir sugar mixture into flour mixture until smooth; stir in milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop teaspoonsfuls of dough onto a baking sheet; flatten with the bottom of a water glass. Sprinkle tops of cookies with enough sugar to cover cookies entirely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned around edges, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
