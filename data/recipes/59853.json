  "ingredients": [
    "0.5 cup whole wheat flour",
    "0.5 cup rye flour",
    "1 tablespoon soy flour",
    "1 tablespoon white sugar",
    "1.5 teaspoons baking powder",
    "0.125 teaspoon salt",
    "0.125 teaspoon ground cinnamon",
    "0.5 teaspoon vanilla extract",
    "0.5 cup water",
    "0.5 cup soy milk",
    "0.25 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "In a medium bowl, stir together the whole wheat flour, rye flour, soy flour, sugar, baking powder, salt and cinnamon. Make a well in the center, and pour in the vanilla, water and soy milk. Mix until all of the dry ingredients have been absorbed, then stir in the pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet or griddle iron over medium heat, and coat with cooking spray. Pour about 1/3 cup of batter onto the hot surface, and spread out to 1/4 inch thickness. Cook until bubbles appear on the surface, then flip and brown on the other side. Serve warm.",
