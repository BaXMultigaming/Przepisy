  "ingredients": [
    "1 pound raw peanuts, in shells",
    "0.5 cup salt",
    "0.5 cup chopped jalapeno peppers",
    "0.5 cup red pepper flakes",
    "1 (3 ounce) package dry crab boil (such as Zatarain's® Crab and Shrimp Boil)",
    "2 tablespoons Cajun seasoning",
    "1 tablespoon garlic powder"
  ],
  "steps": [
    {
      "text": "Place peanuts, salt, jalapeños, red pepper flakes, crab boil, Cajun seasoning, and garlic powder into a slow cooker. Pour in water to cover the peanuts and stir to combine. Cover and cook on Low until peanuts are soft, at least 24 hours. Stir occasionally and add water as needed to keep the peanuts covered. Drain, then serve hot or cold.",
