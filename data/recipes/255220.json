  "ingredients": [
    "3 pounds pork back ribs, separated and fat trimmed",
    "1 (12.5 ounce) can pineapple tidbits, drained",
    "1 cup apricot jam",
    "0.25 cup soy sauce",
    "2 tablespoons white wine vinegar",
    "2 tablespoons brown sugar",
    "2 cloves garlic, minced",
    "1 teaspoon ground ginger",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Arrange ribs in a single layer in a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pineapple, jam, soy sauce, vinegar, brown sugar, garlic, ginger, salt, black pepper, and cayenne pepper together in a bowl. Pour evenly over ribs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, basting every 15 minutes, until ribs are glazed and pull away easily from bone, about 1 1/2 hours. An instant-read thermometer inserted into the center of meat should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
