  "ingredients": [
    "0.5 cup soy sauce",
    "0.5 cup rice vinegar",
    "3 tablespoons honey",
    "2 teaspoons sesame oil",
    "4 teaspoons fresh ginger, minced",
    "4 teaspoons cornstarch",
    "4 cloves garlic, minced",
    "1 tablespoon olive oil",
    "2 pounds boneless, skinless chicken breasts, cut into 1-inch pieces",
    "1 pound broccoli florets, chopped into bite-sized pieces",
    "1 (8 ounce) package sliced mushrooms"
  ],
  "steps": [
    {
      "text": "Mix all the sauce ingredients in a medium size bowl until completely smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the olive oil to the bottom of a fry pan and heat to medium high. Add the cut-up chicken and cook until the chicken is golden brown and almost cooked through, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the sauce to the chicken and toss until all the chicken is coated. Add the broccoli floret pieces and sliced mushrooms to the chicken mixture; stir until coated. Let the chicken and veggie mixture simmer for about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
