  "ingredients": [
    "2 tablespoons butter",
    "1 (8 ounce) package sliced white mushrooms",
    "2 cloves garlic, minced",
    "2 teaspoons soy sauce",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium heat. Add mushrooms; cook and stir until mushrooms have softened and released their liquid, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mnfLLUhxnUmjtxAhXztfTsDEdCs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/58112-mushrooms-with-a-soy-sauce-glaze-step-1-1468-4x3-c89ba6470006460d8be9c36d1495cf37.jpg"
      ],
      "image": "assets/images/58112/step_01.webp"
    },
    {
      "text": "Stir in garlic; continue to cook and stir for 1 minute. Stir in soy sauce; cook until liquid has evaporated, about 4 minutes.",
