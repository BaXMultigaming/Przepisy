  "ingredients": [
    "12 ears fresh corn with husks",
    "5 stalks celery, diced",
    "1 small onion, diced",
    "0.5 green bell pepper, diced",
    "2 tablespoons chopped pimento peppers",
    "0.5 cup olive oil",
    "2 tablespoons balsamic vinegar",
    "1 teaspoon Dijon mustard",
    "1 teaspoon sea salt",
    "1 teaspoon white sugar",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill corn until husks are charred on all sides, about 20 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove and discard husks and silk from corn. Cut kernels off cobs into a large bowl; add celery, onion, bell pepper, and pimentos.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, vinegar, mustard, salt, sugar, and black pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add vinaigrette to corn mixture; toss well. Cover the bowl; refrigerate before serving, 12 hours to 3 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
