  ],
  "steps": [
    {
      "text": "Combine tomatoes, basil, garlic, oil, and sugar in a blender or the bowl of a food processor; blend until smooth. Transfer sauce to a bowl; cover and refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cold sauce over spaghetti; toss to coat. Top servings with Parmesan cheese.",
