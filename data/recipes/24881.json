  "ingredients": [
    "4 ripe tomatoes - peeled and seeded",
    "0.33300000429153 cup chopped fresh basil",
    "3 cloves garlic, peeled",
    "1 teaspoon olive oil",
    "0.5 teaspoon white sugar",
    "1 (8 ounce) package uncooked spaghetti",
