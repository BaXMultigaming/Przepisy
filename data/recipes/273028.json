  "ingredients": [
    "8 ounces fresh asparagus, trimmed",
    "0.5 teaspoon salt",
    "0.5 teaspoon olive oil",
    "2 tablespoons unsalted butter",
    "2 tablespoons all-purpose flour",
    "1 cup half-and-half",
    "0.5 teaspoon dry mustard",
    "0.5 teaspoon paprika",
    "8 ounces shredded Gouda cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place asparagus on a large baking sheet in one layer and season with salt. Drizzle with olive oil and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until soft, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, for the cheese sauce melt butter in a saucepan over medium heat. Add flour and whisk until smooth and golden, about 2 minutes. Add half and half, mustard powder, and paprika; whisk for an additional 2 minutes. Add smoked Gouda cheese and whisk until cheese is melted and sauce is thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer asparagus to a serving tray and spoon cheese sauce on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
