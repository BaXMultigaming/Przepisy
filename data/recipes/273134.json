  "ingredients": [
    "1.75 cups whole wheat flour",
    "3 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "3 mashed ripe bananas, or to taste",
    "2 eggs",
    "0.5 cup applesauce",
    "0.33333334326744 cup brown sugar",
    "3 tablespoons flaxseed meal",
    "0.125 cup milk",
    "0.5 tablespoon vanilla extract",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease two 4x8-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, cinnamon, baking soda, salt, and nutmeg in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bananas, eggs, applesauce, brown sugar, flaxseed meal, milk, and vanilla extract in a large bowl and mix until well combined. Gradually add flour mixture to the banana mixture, stirring until uniform. Add walnuts and mix lightly just until evenly distributed. Pour batter evenly into the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove loaves from oven and set aside to cool for 15 minutes. Remove loaves from pans and let cool about 5 minutes more before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
