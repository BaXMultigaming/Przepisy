  "ingredients": [
    "0.5 cup King Arthur Coconut Flour",
    "1 teaspoon baking powder",
    "0.5 cup Dutch-process cocoa powder",
    "6 tablespoons unsalted butter, cut into pieces",
    "0.75 cup sugar",
    "6 large eggs",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F. Grease an 8-inch square cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift coconut flour and baking powder together into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cocoa powder and butter in a large, microwave-safe bowl. Microwave on high in 30- to 60-second increments, stirring often, until butter melts and mixture is well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sugar, eggs, vanilla, and salt to butter mixture; whisk until well combined. Whisk in flour mixture until smooth. Pour batter into the prepared pan and let rest for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a cake tester inserted into the middle comes out clean, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and cool on a wire rack until completely cool, 30 to 45 minutes. Cut into 16 pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
