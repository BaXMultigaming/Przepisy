  "ingredients": [
    "1 gallon whole milk",
    "0.25 cup white vinegar",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OGcG0bmBXXUg8THDIacenrg2eV4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_75597_HomemadeFreshCheese_Shot1_12515-0babf7645c6641f7ad9afd79fec0b6ac.jpg"
      ],
      "image": "assets/images/75597/step_01.webp"
    },
    {
      "text": "Heat milk in a large pot until the temperature reaches 195 degrees F (90 degrees C), stirring constantly to prevent scorching on the bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IFXjtiN5ozozjOwMsccoYbVovDs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_75597_HomemadeFreshCheese_Shot2_12522-a88a7ef51ea446979199aafb1d73654d.jpg"
      ],
      "image": "assets/images/75597/step_02.webp"
    },
    {
      "text": "Remove from the heat and stir in vinegar. Let stand for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a mesh strainer with cheesecloth and set over a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XeMO3jNkYHyyY4l0tE953JcbdPE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_75597_HomemadeFreshCheese_Shot3_12528-620a3706ff6b48a7ae018a38ffb41fc4.jpg"
      ],
      "image": "assets/images/75597/step_04.webp"
    },
    {
      "text": "Stir salt into milk; pour through the prepared strainer. Let curds strain for 1 hour. The milk should separate into a white solid part and a yellowish liquid (whey). Discard the whey.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z_A4d8MAdRfD5d01Bu0dC3Ec3co=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_75597_HomemadeFreshCheese_Shot4_12542-60de9df8ead14ae28c48d3d88cce6a3c.jpg"
      ],
      "image": "assets/images/75597/step_05.webp"
    },
    {
      "text": "Pat cheese into a ball and remove the cheesecloth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bx0FX8cvL-R5poHnfKyFfl80BPw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_75597_HomemadeFreshCheese_Shot5_12780-a5163041ae9c4665bc0eace186863dbe.jpg"
      ],
      "image": "assets/images/75597/step_06.webp"
    },
    {
      "text": "Wrap in plastic and store in the refrigerator until ready to use. Fresh cheese will usually last about 1 week.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aG8iEq5xONczXNrUcP-xyH6uMaw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_75597_HomemadeFreshCheese_Shot6_12784-97a7e78ed44047b2bfd00f0a0d17c708.jpg"
      ],
      "image": "assets/images/75597/step_07.webp"
    }
