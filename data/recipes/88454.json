  "ingredients": [
    "1 French baguette, cut into diagonal 1/2 inch slices",
    "0.25 cup olive oil",
    "0.25 cup butter or margarine",
    "2 cloves garlic, minced",
    "salt and pepper to taste",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Set the oven to broil at 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small saucepan, combine the olive oil, butter and garlic. Set over medium heat, and cook until butter has melted and the mixture starts to bubble. Season with salt and pepper. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each slice of bread into the garlic mixture, turning to coat each side. Place Parmesan cheese on a plate. Press one side of each piece of bread into the cheese, and place cheese side up on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil on the middle rack of the preheated oven for about 8 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
