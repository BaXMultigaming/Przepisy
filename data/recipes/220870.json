  "ingredients": [
    "1 cup dried chickpeas",
    "0.5 teaspoon baking soda",
    "1 tablespoon water",
    "1.3333333730698 tablespoons sesame seeds",
    "2 teaspoons ground cumin",
    "1 teaspoon salt",
    "1 teaspoon baking powder",
    "1 teaspoon ground coriander",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon red chili powder",
    "0.5 teaspoon white sugar",
    "0.25 teaspoon ground turmeric",
    "1 pinch asafoetida powder",
    "1 quart vegetable oil for frying, or as needed"
  ],
  "steps": [
    {
      "text": "Place dried chickpeas in a bowl. Fill with water to cover; stir in baking soda. Soak at least 8 hours or overnight in refrigerator. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place soaked and drained chickpeas in a blender or food processor; blend to a paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour water into chickpea paste and blend until smooth. Scrape down sides of blender with spatula if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sesame seeds, cumin, salt, baking powder, coriander, black pepper, red chili powder, sugar, turmeric, and asafoetida powder in blender with chickpea paste; blend until well mixed. Transfer chickpea mixture to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill chickpea mixture in refrigerator to allow flavors to blend, at least 1 hour and up to two days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour vegetable oil to a depth of 1 inch in a deep skillet over medium heat and heat to 370 degrees F (188 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop up chickpea mixture by heaping tablespoons and form into balls the size of ping pong balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry balls in hot oil until golden brown, 3 to 5 minutes on each side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
