  "title": "Chocolate Crunch Brownies",
  "description": "Chocolate brownies are covered with gooey marshmallows and a crispy peanut butter topping for a delicious triple-layer treat.",
  "authors": [
    "kylann"
  ],
  "date_published": "2020-06-19T00:45:00-04:00",
