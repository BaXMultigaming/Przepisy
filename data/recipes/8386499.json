  "ingredients": [
    "4 slices brioche bread",
    "0.5 cup lemon curd",
    "0.5 cup blueberries",
    "2 large eggs",
    "2 tablespoons milk",
    "2 tablespoons unsalted butter",
    "1 teaspoon confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Trim crusts from bread; flatten slices with a rolling pin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread about 1 tablespoon lemon curd on each bread slice. Line up 4 or 5 blueberries (depending on berry size) on one edge each bread slice; roll up slices to opposite edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and milk together in a bowl; coat rolls in egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a skillet over medium heat; place roll-ups seam-sides down in the skillet. Cook rolls on all sides until golden brown, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dust roll-ups with confectioners' sugar before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
