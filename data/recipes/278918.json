  "title": "Moroccan Lentil Stew",
  "description": "This hearty lentil stew features butternut squash, carrots, green beans, and peas. Warm Moroccan spices ensure extra flavor.",
  "authors": [
    "Kim's Cooking Now"
  ],
  "date_published": "2020-06-19T00:44:41-04:00",
