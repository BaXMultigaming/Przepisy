  "ingredients": [
    "0.5 cup butter, softened",
    "0.5 cup white sugar",
    "3 egg yolks",
    "1 cup all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.33333334326744 cup milk",
    "1 teaspoon vanilla extract",
    "3 egg whites",
    "0.5 cup white sugar",
    "1.5 cups flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and 1/2 cup white sugar until light and fluffy. Beat in egg yolks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder and salt in bowl. Add flour mixture to butter mixture in two parts, alternating with milk and vanilla, beginning and ending with flour mixture. Spread in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Topping: Beat egg whites until soft peaks form; add 1/2 cup of the white sugar gradually, and beat until egg whites are stiff. Fold in the coconut. Put spoonfuls here and there over batter, smoothing as best you can.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until meringue topping starts to brown and a toothpick inserted in the center comes out clean, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
