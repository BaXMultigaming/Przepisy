  "keywords": [],
  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "1 pinch freshly ground white pepper",
    "2 eggs",
    "0.25 cup milk",
    "2 tablespoons butter",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HWnUSn3xr28jfaGG1WK0DkrKqdQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11793-German-Spaetzle-Dumplings-DDMFS-Step-01-e43d439b1a514a31bb9184deb1ab1253.jpg"
      ],
      "image": "assets/images/11793/step_01.webp"
    },
    {
      "text": "Fill a large pot halfway full with water and bring to a boil. Adjust heat so water just simmers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4PiTIvfXkUairiSmVBFsqELgiEg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11793-German-Spaetzle-Dumplings-DDMFS-Step-02-849ac83f058d494d9364d523f2926af9.jpg"
      ],
      "image": "assets/images/11793/step_02.webp"
    },
    {
      "text": "Meanwhile, mix together flour, nutmeg, salt, and white pepper in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GF7cTdg9py_hOhxmLJ_N1EbLmSE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11793-German-Spaetzle-Dumplings-DDMFS-Step-03-0287544dba244be6a0e8de83b9ff3bef.jpg"
      ],
      "image": "assets/images/11793/step_03.webp"
    },
    {
      "text": "Whisk eggs together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cTmEQEfSRsw4PcIWmXiSalq_L6k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11793-German-Spaetzle-Dumplings-DDMFS-Step-04-9fe4af219ad34f90ae8f6fe246b2872e.jpg"
      ],
      "image": "assets/images/11793/step_04.webp"
    },
    {
      "text": "Add eggs alternately with milk to dry ingredients. Stir until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NQQmI1_HCP80LaJ3LdwEJwyuFLI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11793-German-Spaetzle-Dumplings-DDMFS-Step-05-a41a896d553d48679f0c3519db6e0f20.jpg"
      ],
      "image": "assets/images/11793/step_05.webp"
    },
    {
      "text": "Working in batches, press dough through a spaetzle maker, or through a large-holed colander or metal grater, into simmering water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3HcYb2sExAJqVzll7YYwmz6dRcY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11793-German-Spaetzle-Dumplings-DDMFS-Step-07-97269a354f8c40e7b4461bebab18b1d9.jpg"
      ],
      "image": "assets/images/11793/step_06.webp"
    },
    {
      "text": "Cook 5 to 8 minutes. Remove with a slotted spoon or spider and drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VHNzKKZ0ctjzasEztQr_kYkk68g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11793-German-Spaetzle-Dumplings-DDMFS-Step-08-cf13de82004c49edb0201c80bdda4de9.jpg"
      ],
      "image": "assets/images/11793/step_07.webp"
    },
    {
      "text": "Melt butter in a large skillet. Add spaetzle and cook, stirring gently, until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_lDTmHRN8Nt5PhC4jk-JnnuIzlo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11793-German-Spaetzle-Dumplings-DDMFS-Step-09-13390902364042e6bef29d4dc306545e.jpg"
      ],
      "image": "assets/images/11793/step_08.webp"
    },
    {
      "text": "Serve sprinkled with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mEmYYBp9IoG-W4QVt1CRQzmdJjg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11793-german-spaetzle-dumplings-DDMFS-4x3-b1307f2ebcf94b6a90511f820ac2a1e8.jpg"
      ],
      "image": "assets/images/11793/step_09.webp"
    }
  ],
