  "ingredients": [
    "1 (16 ounce) package bow tie pasta",
    "1 (6 ounce) package spinach leaves",
    "2 cups fresh basil leaves",
    "0.5 cup extra virgin olive oil",
    "3 cloves garlic, minced",
    "4 ounces prosciutto, diced",
    "salt and ground black pepper to taste",
    "0.75 cup freshly grated Parmesan cheese",
    "0.5 cup toasted pine nuts"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil over high heat. Add bow tie pasta and return to a boil. Cook, uncovered and stirring occasionally, until pasta has cooked through but is still firm to the bite, about 12 minutes. Rinse with cold water to cool, then drain well in a colander set in the sink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss spinach and basil together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium heat. Add garlic and sauté for 1 minute. Stir in prosciutto and cook 2 to 3 minutes more. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add prosciutto mixture to spinach and basil and toss to combine. Pour in the drained pasta and toss again. Season with salt and pepper. Sprinkle with Parmesan cheese and pine nuts to serve.",
      "section": null,
      "name": null,
      "url": null,
