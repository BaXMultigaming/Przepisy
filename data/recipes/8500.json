  "ingredients": [
    "2 eggs",
    "0.25 cup milk",
    "0.5 cup all-purpose flour",
    "1 tablespoon poultry seasoning",
    "1.5 tablespoons ground cinnamon",
    "1 cup chopped pecans",
    "1 pinch white sugar",
    "salt to taste",
    "ground black pepper to taste",
    "4 skinless, boneless chicken breast halves - pounded to 1/2 inch thickness",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "In a small bowl, mix the eggs with the milk. Put aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together flour, seasoning, cinnamon, pecans, sugar, and salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip the chicken in the egg mix, and press in the pecan mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry in hot olive oil until golden, about 5 minutes per side. Check to make sure pecans don't burn. Place on paper towel to drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
