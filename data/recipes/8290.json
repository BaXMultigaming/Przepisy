  "title": "Fresh Fig Cake",
  "description": "This moist fig cake has pieces of fresh ripe figs in the cake and a layer of homemade fig preserves. Top with fresh fig slices for a beautiful dessert.",
  "authors": [
    "Karin Christian"
  ],
  "date_published": "1999-07-08T13:24:32-04:00",
