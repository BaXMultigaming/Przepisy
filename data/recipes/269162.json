  "ingredients": [
    "1 fennel bulb, cut into 1/2-inch slices, fronds reserved",
    "1 small onion, cut into 1/2-inch slices",
    "2 tablespoons olive oil",
    "3 turkey Italian sausages, casings removed",
    "1 pound prepared pizza dough, or as needed",
    "0.5 cup pizza sauce",
    "1.5 cups shredded mozzarella cheese",
    "2 cloves garlic, thinly sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss fennel and onion slices with olive oil; spread out on the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until golden, 10 to 15 minutes. Remove from the oven. Increase oven temperature to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir sausage in a skillet over medium heat until no longer pink, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out pizza dough on a lightly floured surface. Transfer to a pizza pan or clean baking sheet. Spread sauce on top and cover with mozzarella cheese. Top with fennel, onion, sausage, and garlic slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, 15 to 17 minutes. Garnish with chopped fennel fronds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
