  "ingredients": [
    "1 cup unsalted butter",
    "0.75 cup confectioners' sugar",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "1.75 cups all-purpose flour",
    "1 cup ground pecans",
    "50 almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar together using an electric mixer until fluffy. Blend in vanilla extract and salt. Mix in flour and ground pecans. Shape about 1 tablespoon of dough into a finger, about 3 inches long and 3/4 inch wide. Repeat with remaining dough to form about 50 fingers total.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fingers 2 inches apart on the prepared baking sheet; they will expand a little while baking. Stick an almond 'nail' onto the end of each finger. Lightly score some 'knuckles' into the centers using a knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and very lightly browned, about 20 minutes. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
