  "ingredients": [
    "3 cups canned pumpkin puree",
    "1.5 cups vegetable oil",
    "4 cups white sugar",
    "6 eggs",
    "4.75 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons baking soda",
    "1.5 teaspoons salt",
    "1.5 teaspoons ground cinnamon",
    "1.5 teaspoons ground nutmeg",
    "1.5 teaspoons ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour three 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pumpkin, oil, sugar, and eggs together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Lv9BTT9JkCl-2q7CdR2xFM9XtW0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6862-pumpkin-bread-PICS-step-02-94e50ee798ba4c6da43b90851cf77937.jpg"
      ],
      "image": "assets/images/6862/step_02.webp"
    },
    {
      "text": "Combine flour, baking powder, baking soda, salt, cinnamon, nutmeg, and cloves in a separate bowl; stir into pumpkin mixture until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XDu6zWdVnGUDMERgu7-th_rUNMI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6862-pumpkin-bread-PICS-step-03-3ec94ee0bb4547efb499aa07c19014b2.jpg"
      ],
      "image": "assets/images/6862/step_03.webp"
    },
    {
      "text": "Divide batter evenly between the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_OA4i44ABm2Hm24SYb9S2bHVMag=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6862-pumpkin-bread-PICS-step-04-6cc8b6d543fe4d90bfc505101bf0b4b7.jpg"
      ],
      "image": "assets/images/6862/step_04.webp"
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted into the center of each loaf comes out clean, about 45 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lRwJMW5myWYrDtPDf3SJkuyURZw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6862-pumpkin-bread-PICS-step-05-7a45ee210fb24ee3808b73a9bb54c0f5.jpg"
      ],
      "image": "assets/images/6862/step_05.webp"
