  "ingredients": [
    "0.25 cup all-purpose flour",
    "1 cup milk",
    "3 eggs",
    "1 tablespoon white sugar",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "1 pinch salt",
    "12 thick slices bread"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-Hv36CG4EGmn40tVHAUIlP-p1Oc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-16895-fluffy-french-toast-step-01-e817a1a94d4540a3b7ab071d87822ff1.jpg"
      ],
      "image": "assets/images/16895/step_01.webp"
    },
    {
      "text": "Place flour into a large mixing bowl; slowly whisk in milk until smooth. Whisk in eggs, sugar, vanilla, cinnamon, and salt until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WA1DerA6wCeYb8R-ZMScgM8A_mc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-16895-fluffy-french-toast-step-02-bd749b7d3aab42a68618a4964a6bd33f.jpg"
      ],
      "image": "assets/images/16895/step_02.webp"
    },
    {
      "text": "Heat a lightly oiled griddle or frying pan over medium heat. Meanwhile, soak bread slices in milk mixture until saturated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TH9CQtc-Wh4aJwm0Jp5VUz9Av8s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-16895-fluffy-french-toast-step-03-61849faa1ccc4842abbf3ab2a9cc21d1.jpg"
      ],
      "image": "assets/images/16895/step_03.webp"
    },
    {
      "text": "Working in batches, cook bread on the preheated griddle or pan until golden brown on both sides, about 2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oDtSK3MiAxkGSWw_GL5IKV1rFPA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-16895-fluffy-french-toast-step-04-53dd75e6c8cf4c47a50a0feb3a192e70.jpg"
      ],
      "image": "assets/images/16895/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kpI2DQrw7zDake_7B8wOJRkZ-6Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-16895-fluffy-french-toast-hero-01-ddmfs-4x3-7fd61e054f2c4f0f868b7ab0dd8767ae.jpg"
