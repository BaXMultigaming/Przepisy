  "title": "Waldorf&#39;s Sour Cream Cheesecake",
  "description": "Sour cream cheesecake baked over a vanilla wafer crust is a delightful dessert for special occasions and holidays.",
  "authors": [
    "Donna Halcarz"
  ],
