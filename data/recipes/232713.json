  "ingredients": [
    "0.5 loaf dry French bread, broken into pieces",
    "3 tablespoons butter, melted",
    "8 ounces shredded Swiss cheese",
    "4 ounces shredded Monterey Jack cheese",
    "1 (1/4 inch thick) ham slice, coarsely chopped",
    "1.75 cups milk",
    "9 eggs",
    "4 green onions, minced",
    "0.25 cup sherry",
    "1.5 tablespoons Dijon mustard",
    "0.25 teaspoon ground black pepper",
    "0.125 teaspoon cayenne pepper",
    "0.75 cup sour cream",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bread pieces in the prepared baking dish; drizzle with melted butter. Top with Swiss cheese, Monterey Jack cheese, and ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, eggs, green onions, sherry, mustard, black pepper, and cayenne pepper together in a bowl until foamy; pour over bread mixture. Cover dish tightly with aluminum foil and refrigerate for 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove dish from refrigerator 30 minutes before baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake strata in the preheated oven for 1 hour. Remove aluminum foil and top with sour cream and Parmesan cheese. Bake, uncovered, until a knife inserted in the strata comes out clean, about 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
