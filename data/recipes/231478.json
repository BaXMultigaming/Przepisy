  "ingredients": [
    "1.3333333730698 cups all-purpose flour",
    "1.125 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.75 cup white sugar",
    "0.5 cup butter, softened",
    "2 large eggs, separated, divided",
    "1.5 teaspoons almond extract",
    "1 teaspoon freshly grated lemon zest",
    "0.5 cup buttermilk",
    "2.5 tablespoons poppy seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, baking powder, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter with an electric mixer in a large bowl until light and fluffy; the mixture should be noticeably lighter in color. Add 1 egg yolk and beat until fully blended into the butter mixture; repeat with the remaining egg yolk. Beat in almond extract and lemon zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour mixture to the butter mixture in 2 batches, alternating with buttermilk, beating batter briefly after each addition. Fold in poppy seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a glass or metal bowl until stiff peaks form. Fold egg whites into the batter. Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until muffins are golden and the tops spring back when lightly pressed, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove muffins from the oven, turn out onto a wire rack, and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
