  "ingredients": [
    "2 cups boiling water",
    "1 cup unsweetened cocoa powder",
    "2.75 cups all-purpose flour",
    "2 teaspoons baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup butter, softened",
    "2.25 cups white sugar",
    "4 eggs",
    "1.5 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 3 - 9 inch round cake pans. In medium bowl, pour boiling water over cocoa, and whisk until smooth. Let mixture cool. Sift together flour, baking soda, baking powder and salt; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream butter and sugar together until light and fluffy. Beat in eggs one at time, then stir in vanilla. Add the flour mixture alternately with the cocoa mixture. Spread batter evenly between the 3 prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 25 to 30 minutes. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
