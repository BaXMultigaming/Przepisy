  "ingredients": [
    "1 (4 pound) whole chicken",
    "1 cup margarine, softened",
    "1 tablespoon garlic salt",
    "1 teaspoon coarsely ground black pepper",
    "1 teaspoon dried thyme",
    "1 teaspoon dried parsley",
    "1 pinch dried rosemary"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse chicken; pat thoroughly dry with paper towels. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine margarine, garlic salt, black pepper, thyme, parsley, and rosemary in a bowl. Thoroughly rub outside of chicken with margarine mixture; rub any remaining into chicken cavity. Transfer to a glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and juices run clear, about 2 hours. An instant-read meat thermometer inserted into the thickest part of the thigh, near but not touching the bone, should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
