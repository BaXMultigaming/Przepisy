  "ingredients": [
    "4 baking potatoes",
    "3 tablespoons olive oil",
    "1 teaspoon minced fresh garlic",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1.5 teaspoons onion powder",
    "0.5 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each potato into 12 wedges; place in a large bowl. Toss potatoes with olive oil, garlic, salt, pepper, onion powder, and paprika. Arrange in a single layer on prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 minutes. Turn potatoes over and continue baking until golden and crisp, 25 to 30 minutes longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
