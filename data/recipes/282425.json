  "title": "Vegetarian Southwestern Potato Skins",
  "description": "Crispy vegetarian potato skins with a Southwestern kick. The key to crispy skins is the double dose oil treatment.",
  "authors": [
    "Soup Loving Nicole"
  ],
  "date_published": "2020-11-22T23:26:53-05:00",
