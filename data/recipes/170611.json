  "ingredients": [
    "1 cup quinoa",
    "2 cups water",
    "1 (15 ounce) can garbanzo beans, drained",
    "0.5 cup dried cranberries",
    "0.5 cup golden raisins",
    "0.33333334326744 cup sliced almonds",
    "0.25 cup mint leaves, chopped",
