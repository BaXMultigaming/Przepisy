  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.125 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground cardamom",
    "0.66666698455811 cup unsalted butter, softened",
    "1 cup white sugar",
    "1 (3 ounce) package cream cheese, softened",
    "3 tablespoons almond paste",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon lemon zest"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease cookie sheets. Sift together the flour, baking powder, baking soda, salt and cardamom. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the butter, sugar, cream cheese and almond paste until smooth. Beat in the egg, vanilla and lemon zest. Gradually blend in the dry ingredients until well mixed. Drop by spoonfuls onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes in the preheated oven. Allow cookies to cool on baking sheet for 5 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
