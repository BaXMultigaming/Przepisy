  "ingredients": [
    "1 (15 ounce) can garbanzo beans, drained",
    "1 (13.75 ounce) can artichoke hearts, drained and diced",
    "1.5 cups frozen green peas",
    "0.5 cup diced black olives",
    "0.5 red onion, diced",
    "1 (16 ounce) package farfalle (bow tie) pasta",
    "1.5 cups diced queso blanco cheese",
    "1 (12 ounce) bottle Italian-style salad dressing (such as Girard's® Olde Venice)",
    "cracked black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine garbanzo beans, artichoke hearts, frozen peas, black olives, and red onion in a large salad bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook the bow tie pasta at a boil, stirring occasionally, until cooked through but firm to the bite, about 12 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix still-warm pasta into garbanzo bean mixture. Fold queso blanco cheese into salad; add Italian salad dressing and toss to coat. Season to taste with cracked black pepper. Set salad aside until peas thaw and flavors blend, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
