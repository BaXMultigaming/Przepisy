  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat tortilla in a large skillet or directly on the grates of a gas stove until soft and pliable. Place tortilla inside souffle dish, patting bottom down and fluting tortilla up the sides of the dish.",
