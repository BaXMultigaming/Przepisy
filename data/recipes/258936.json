  "ingredients": [
    "0.33333334326744 cup packed brown sugar",
    "0.25 cup butter",
    "0.25 cup shortening",
    "0.25 cup white sugar",
    "1 egg",
    "2 tablespoons molasses",
    "2 tablespoons heavy whipping cream",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.5 cup rolled oats",
    "0.33333334326744 cup coconut flakes",
    "1 tablespoon baking powder",
    "0.25 teaspoon salt",
    "1 cup chopped dried jackfruit"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, butter, shortening, and white sugar in a large bowl; beat with an electric mixer until creamy. Mix in egg, molasses, heavy cream, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, oats, coconut flakes, baking powder, and salt together in a separate bowl. Add to the creamed mixture; mix until dough is just combined. Fold in jackfruit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop small spoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 10 to 12 minutes. Cool on the baking sheets for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
