  "ingredients": [
    "2 cups cooked, mashed sweet potatoes",
    "1 cup white sugar",
    "0.5 cup melted butter",
    "0.33333334326744 cup milk",
    "2 eggs, beaten",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.5 cup brown sugar",
    "0.25 cup all purpose flour",
    "2.5 tablespoons butter at room temperature",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 2-quart baking dish, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the sweet potatoes, white sugar, 1/2 cup melted butter, milk, eggs, vanilla extract, cinnamon, and nutmeg in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, stir together the brown sugar, flour, 2 1/2 tablespoons of butter, and the pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon the sweet potato mixture into the greased baking dish, spread the pecan mixture evenly over the top, and bake in the preheated oven until the topping is browned and bubbling, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
