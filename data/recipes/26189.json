  "ingredients": [
    "0.5 cup margarine, softened",
    "0.5 cup canola oil",
    "0.75 cup brown sugar",
    "0.75 cup white sugar",
    "0.5 cup egg substitute",
    "1 teaspoon vanilla extract",
    "1 teaspoon water",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "2.5 cups rolled oats",
    "0.25 cup oat bran",
    "0.25 cup wheat germ",
    "0.75 cup raisins",
    "0.75 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the margarine, oil, brown sugar and white sugar until smooth. Beat in the egg substitute, vanilla and water. Combine the flour, baking soda, cinnamon and nutmeg; stir into the sugar mixture. Stir in the oats, oat bran, wheat germ, raisins and walnuts. Drop by teaspoonfuls onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 18 to 20 minutes in the preheated oven, or until the edges are lightly browned. Remove from cookie sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
