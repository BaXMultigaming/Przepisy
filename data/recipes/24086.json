  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake wings in the preheated oven for 30 minutes or until cooked through and crispy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, in a small bowl combine melted butter, red pepper sauce, tomato sauce, chili powder, and cayenne pepper. Mix together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When wings are baked, dip in sauce to coat well, then shake off excess and return coated wings to baking sheet. Reduce the oven temperature to 250 degrees F (120 degrees C) and bake for another 15 minutes to set sauce.",
