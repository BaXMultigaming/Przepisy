  "ingredients": [
    "0.5 pound ground lamb",
    "0.5 cup bread crumbs",
    "steak seasoning to taste",
    "1 (10 ounce) can coconut milk",
    "1.5 tablespoons green curry paste"
  ],
  "steps": [
    {
      "text": "In a medium bowl, mix together the ground lamb, bread crumbs and steak seasoning until well blended. Form into meatballs about 1 inch in diameter. Heat a greased skillet over medium-high heat and fry the lamb balls until they are a bit black and crusty, about 5 minutes. Remove balls from pan and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss the curry paste into the hot skillet and fry for about a minutes. Then pour in the entire can of coconut milk and lower the heat. Let the mixture simmer, stirring frequently for 5 to 10 minutes. Serve the meatballs and curry sauce over rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
