  "ingredients": [
    "2 bananas, peeled and thinly sliced",
    "2 cucumbers - peeled, seeded, and diced",
    "0.5 cup fresh mint leaves",
    "0.5 cup fresh cilantro leaves",
    "1 teaspoon finely chopped fresh ginger root",
    "1 fresh red chile pepper, thinly sliced",
    "0.25 cup lime juice",
    "1 tablespoon fish sauce",
    "1 tablespoon brown sugar",
    "1.5 pounds tiger prawns, peeled and deveined"
  ],
  "steps": [
    {
      "text": "In a large bowl, mix bananas, cucumbers, mint, cilantro, ginger, and red chile pepper to make salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, blend lime juice, fish sauce, and brown sugar until sugar has dissolved. Thoroughly mix into the salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large saucepan of lightly salted water to a boil. Place prawns in the water, and cook 3 minutes, or until flesh is opaque. Serve with the banana salsa.",
      "section": null,
