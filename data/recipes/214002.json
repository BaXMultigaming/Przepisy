  "title": "Brown Sugar and Pineapple Glazed Ham",
  "description": "This brown sugar and pineapple-glazed ham recipe features cooked ham, brown sugar, pineapple rings, and juice for a tasty, savory-sweet holiday meal.",
  "authors": [
    "Lex"
  ],
  "date_published": "2020-03-05T00:07:14-05:00",
