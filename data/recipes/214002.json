  "ingredients": [
    "1 (6 pound) fully-cooked, bone-in ham",
    "1 fresh pineapple",
    "2 (6 ounce) cans pineapple juice",
    "1 cup brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Place ham, cut-side down, on a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kRwLM43FtQiaJHHOkQ5UKyoyo-I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214002-BrownSugarAndPineappleGlazedHam-ddfms-Step2-0225-7f3076044e944d5689d14151eb495eac.jpg"
      ],
      "image": "assets/images/214002/step_01.webp"
    },
    {
      "text": "Cut skin off pineapple; remove any remaining brown eyes. Slice pineapple into ½-inch-thick rings; remove cores with a round cutter. Attach pineapple rings to ham with toothpicks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ARZb5GGvyLGkXg6DGg9EJtetEQg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214002-BrownSugarAndPineappleGlazedHam-ddfms-Step4-0228-b47e991901584c7cba369037bcadab34.jpg"
      ],
      "image": "assets/images/214002/step_02.webp"
    },
    {
      "text": "Bake ham in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk pineapple juice and brown sugar together in a microwave-safe bowl on MEDIUM, or small saucepan over medium heat until boiling and slightly thickened, about 5 minutes; glaze will be sticky and hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b0XsD89QjqCpDqzv8_pMXCsrkfI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214002-BrownSugarAndPineappleGlazedHam-ddfms-Step5-0234-5653748d195644ae9a0882a45e98f256.jpg"
      ],
      "image": "assets/images/214002/step_04.webp"
    },
    {
      "text": "Pour 1/2 of the glaze evenly over ham and pineapple rings; bake 30 minutes more. Pour remaining glaze over ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0qLMYFIHzzJpuEAAq_5tzmJndyA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214002-BrownSugarAndPineappleGlazedHam-ddfms-Step7-0263-68aaef56fd354cf3b6d3dfddb84119f8.jpg"
      ],
      "image": "assets/images/214002/step_05.webp"
    },
    {
      "text": "Continue baking until a meat thermometer inserted into the thickest part of ham reads 140 degrees F (60 degrees C), 30 to 60 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let ham rest for 15 to 20 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s-IufoiaShbx-F-s_1KmbcUv2xw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214002-brown-sugar-and-pineapple-glazed-ham-DDMFS-4x3-16e348e79a5f456d80564734671d01a4.jpg"
      ],
      "image": "assets/images/214002/step_07.webp"
    }
  ],
