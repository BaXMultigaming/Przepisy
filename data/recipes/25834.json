  "ingredients": [
    "1 cup shortening",
    "1 cup white sugar",
    "1 cup brown sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups rolled oats",
    "2 cups whole wheat flake cereal",
    "1 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the shortening, white sugar and brown sugar until smooth. Beat in the eggs one at a time, then stir in the vanilla. Combine the baking powder, baking soda and oats; stir into the sugar mixture. Fold in the wheat cereal, and coconut. Drop dough by teaspoonfuls onto the prepared cookie sheets. Flatten slightly with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 to 12 minutes in the preheated oven, or until light brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
