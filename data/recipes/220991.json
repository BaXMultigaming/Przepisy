  "title": "Chef John's Asparagus Souffle",
  "description": "Fresh asparagus and sharp white Cheddar cheese give this savory souffle its bright color and bold flavors.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-04-04T17:19:33-04:00",
  "date_modified": "2023-05-08T20:05:50-04:00",
