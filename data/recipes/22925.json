  "title": "Pumpkin Stew",
  "description": "This tasty pumpkin stew recipe is perfect for an autumn potluck dinner. Impress your guests with this thick beef stew made and served in a pumpkin shell.",
  "authors": [
    "Cathryn Gross"
  ],
  "date_published": "2000-10-16T20:50:20-04:00",
