  "ingredients": [
    "0.25 cup all-purpose flour",
    "1 tablespoon paprika",
    "1 teaspoon ground sage",
    "1 teaspoon Creole seasoning",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon black pepper",
    "0.5 teaspoon garlic powder",
    "4 (1/2 inch thick) boneless pork chops",
    "2 teaspoons olive oil"
  ],
  "steps": [
    {
      "text": "Place flour, paprika, sage, Creole seasoning, cayenne pepper, black pepper, and garlic powder in a large, resealable plastic bag. Place pork chops in the bag, seal, and shake to coat chops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, heat oil over high heat for about 1 minute. Arrange chops in pan, and reduce heat to medium. Cook until pork chops are dark brown, about 6 to 8 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
