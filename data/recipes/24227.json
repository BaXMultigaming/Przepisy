        "https://www.allrecipes.com/thmb/aGdL_1-FqPgREN0FYVv8lyC6kZA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-24227-christmas-plum-pudding-VAT-step-03-ef504a3e80474786a0e9fa8c0a249420.jpg"
      ],
      "image": "assets/images/24227/step_03.webp"
    },
    {
      "text": "Cover tightly with greased waxed paper, then foil; secure with string.",
      "section": null,
      "name": null,
      "url": null,
