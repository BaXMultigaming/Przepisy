  "ingredients": [
    "2 cups brown sugar",
    "2 cups white sugar",
    "1 cup milk",
    "1.5 cups creamy peanut butter",
    "1 tablespoon margarine",
    "1.25 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather ingredients.",
      "section": null,
