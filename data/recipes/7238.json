  "ingredients": [
    "cooking spray",
    "2 large eggs",
    "1 cup all-purpose flour",
    "1 cup milk",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease and flour six 6-ounce custard cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs slightly in a medium bowl. Beat in flour, milk, and salt until just smooth; being careful not to overbeat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OZNHeTUKCJ6jdnULhzZrtPkTszE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7238-popovers-ddmfs-Step1-1401-4x3-7e58613d53c74dbe8deac79974d60deb.jpg"
      ],
      "image": "assets/images/7238/step_02.webp"
    },
    {
      "text": "Fill custard cups 1/2 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ny8gnepp5BaYpHOv6loxT8IKF7k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7238-popovers-ddmfs-Step2-1403-4x3-180a7ea779b54839bbf8ff80272431c4.jpg"
      ],
      "image": "assets/images/7238/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Decrease the oven temperature to 350 degrees F (175 degrees C) and bake for 20 minutes more. Immediately remove from cups and serve piping hot.",
