  ],
  "steps": [
    {
      "text": "Melt chocolate and peanut butter chips in the top of a double boiler over simmering water, stirring frequently, until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chow mein noodles and peanuts in a large mixing bowl. Pour chocolate mixture over noodles and peanuts and turn to coat.",
