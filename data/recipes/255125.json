  "ingredients": [
    "1.5 cups blanched almond flour",
    "1.5 cups confectioners' sugar",
    "2 teaspoons almond extract",
    "1 teaspoon rose water",
    "1 egg white"
  ],
  "steps": [
    {
      "text": "Combine almond flour and confectioners' sugar in a food processor; pulse until evenly mixed. Add almond extract and rose water; process until combined. Add egg white; process until a thick dough forms.",
