  "ingredients": [
    "0.5 cup uncooked long-grain white rice",
    "1 cup water",
    "3 tablespoons vegetable oil",
    "0.25 cup butter",
    "3 skinless, boneless chicken breast halves",
    "3 fluid ounces dark rum",
    "1 (6 ounce) can broiled-in-butter-style sliced mushrooms",
    "2.5 tablespoons chicken bouillon granules",
    "2 teaspoons garlic powder",
    "2 teaspoons ground black pepper",
    "1 (14 ounce) can coconut milk",
    "1 small banana, sliced"
  ],
  "steps": [
    {
      "text": "In a pot, bring the rice and water to a boil. Reduce heat to low, cover, and simmer 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the oil and melt the butter in a skillet over medium-high heat. Place chicken in skillet, and cook 6 to 8 minutes per side, or until juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour rum over chicken. With a long match, carefully light the rum on fire. When flames subside, mix the mushrooms, bouillon granules, garlic powder, pepper, and coconut milk into the skillet. Reduce heat to low, and simmer 10 minutes, until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve chicken and mushroom mixture over cooked rice. Top with banana slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
