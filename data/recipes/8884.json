  "ingredients": [
    "12 fresh chicken livers, halved",
    "1 teaspoon garlic salt",
    "12 slices bacon, cut in half"
  ],
  "steps": [
    {
      "text": "Preheat oven to Broil/Grill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle each 1/2 chicken liver with garlic salt to taste. Wrap 1/2 slice bacon around each chicken piece and fasten with a toothpick. Place on a broiling pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil for 5 to 7 minutes. Turn pieces over and broil another 5 to 7 minutes, or until chicken livers are cooked through and no longer pink inside. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
