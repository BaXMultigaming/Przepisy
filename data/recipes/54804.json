  "ingredients": [
    "2 tablespoons butter",
    "0.5 cup all-purpose flour",
    "7 cups chicken broth",
    "0.5 cup finely chopped dill pickles",
    "2 tablespoons dill pickle juice",
    "2 tablespoons white sugar",
    "1 tablespoon Worcestershire sauce",
    "4 teaspoons onion salt",
    "2 teaspoons minced garlic",
    "1 teaspoon dill weed",
    "1 teaspoon curry powder",
    "0.5 teaspoon white pepper",
    "2 large bay leaves",
    "2 cups warm milk"
  ],
  "steps": [
    {
      "text": "Melt butter in a large stockpot over medium heat. Whisk in flour and cook until it begins to turn pale beige in color, 1 to 2 minutes. Whisk in chicken broth until thickened and smooth, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add dill pickles, pickle juice, sugar, Worcestershire sauce, onion salt, garlic, dill, curry powder, white pepper, and bay leaves; increase the heat to medium-high and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce the heat to medium-low and simmer for 5 minutes, whisking frequently. Remove from the heat and whisk in milk. Remove bay leaves before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
