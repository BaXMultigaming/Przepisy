  "ingredients": [
    "1.5 cups whole wheat flour",
    "0.66666668653488 cup brown sugar",
    "0.5 cup flaxseed meal",
    "0.33333334326744 cup rolled oats",
    "2 tablespoons white sugar",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.125 teaspoon salt",
    "2 eggs",
    "6 tablespoons butter, melted",
    "0.33333334326744 cup buttermilk",
    "1 tablespoon buttermilk",
    "1 teaspoon vanilla extract",
    "3 bananas, mashed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix whole wheat flour, brown sugar, flaxseed meal, oats, white sugar, baking powder, baking soda, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, butter, 1/3 cup plus 1 tablespoon butter milk, and vanilla extract in another bowl. Stir in flour mixture. Add bananas; mix until batter is well-combined. Pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 minutes to 1 hour. Cool in the pan for 5 minutes. Invert onto a wire rack and let cool, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
