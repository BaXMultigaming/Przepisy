  "ingredients": [
    "1.5 cups milk",
    "2 (1 ounce) squares unsweetened chocolate",
    "0.75 cup white sugar",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "3 cups day-old bread cubes",
    "0.5 cup chopped walnuts",
    "3 eggs, beaten",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a double boiler, heat together the milk and chocolate until chocolate is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 10x16 inch oven baking bag, combine 1/4 cup sugar, cinnamon and nutmeg. Mix in the bread and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together the eggs, sugar and vanilla; blend together with chocolate mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bag in 1 quart loaf pan; pour chocolate mixture over bread. Close bag with twist tie; make 6 half inch slits on top. Pour water into pan so that water comes up sides of bag, not overflowing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 50 to 60 minutes or until knife inserted comes out clean. To serve, remove from pan, cut bag away from top and put on plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
