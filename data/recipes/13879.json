  "title": "Chocolate Custard Bread Pudding",
  "description": "The ingredients for this moist bread pudding are mixed together in an oven baking bag, then baked in a water bath. Turn out onto a plate before serving.",
  "authors": [
    "Monica Jimenez"
  ],
  "date_published": "1999-11-10T23:48:28-05:00",
  "date_modified": "2022-08-08T11:43:03-04:00",
