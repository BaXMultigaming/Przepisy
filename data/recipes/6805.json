  "ingredients": [
    "1 cup milk",
    "1 large egg",
    "0.33333334326744 cup vegetable oil",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 cup white sugar",
    "0.5 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 400 degrees F (200 degrees C). Line a 12-cup muffin tin with liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together milk, egg, and oil in a large bowl. Add flour, baking powder, sugar, and blueberries; gently mix the batter with only a few strokes. Spoon batter into the muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
