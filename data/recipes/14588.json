  "ingredients": [
    "1 pound ground beef",
    "1.5 cups medium salsa",
    "0.25 cup grated Parmesan cheese",
    "0.25 cup shredded Monterey Jack cheese",
    "1 egg",
    "1 cup crushed saltine crackers"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together ground beef, salsa, cheese, egg, and cracker crumbs. Form into a loaf, and place in prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for approximately 1 hour, or until done. Internal temperature should measure at least 160 degrees F (70 degrees C), the meat should be browned through, and the juices clear.",
