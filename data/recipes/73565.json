  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (220 degrees C). Line a baking sheet with aluminum foil, and coat with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7s_MbYX3cq6hn5xtYYhz0eQ6lr8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/73565-asparagus-wrapped-in-crisp-prosciutto-ddmfs-step-01-9b485e4f181840eb919938d874ea1f7f.jpg"
      ],
      "image": "assets/images/73565/step_01.webp"
    },
    {
      "text": "Wrap one slice of prosciutto around each asparagus spear, starting at the bottom, and spiraling up to the tip. Place the wrapped spears on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1_Zb5EtoZnkmtZBv-RpUPWyGP9I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/73565-asparagus-wrapped-in-crisp-prosciutto-ddmfs-step-02-a68da7f5690b4a308e4f0dd47aab3d45.jpg"
      ],
      "image": "assets/images/73565/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven for 5 minutes. Remove, and shake the pan back and forth to roll the spears over. Return to the oven until asparagus is tender and prosciutto is crisp, another 5 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NcZgTo1KDYw_PH4sdq8j1PZEy58=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/73565-asparagus-wrapped-in-crisp-prosciutto-ddmfs-step-03-3b75a198c9f14730916ca2b5f5194759.jpg"
      ],
