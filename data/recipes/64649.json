  "ingredients": [
    "1 cup quick-cooking rolled oats",
    "0.5 cup whole wheat flour",
    "0.5 cup wheat and barley nugget cereal (e.g. Grape-Nuts™)",
    "0.5 teaspoon ground cinnamon",
    "1 beaten egg",
    "0.25 cup applesauce",
    "0.25 cup honey",
    "3 tablespoons brown sugar",
    "2 tablespoons vegetable oil",
    "0.25 cup unsalted sunflower seeds",
    "0.25 cup chopped walnuts",
    "1 (7 ounce) bag chopped dried mixed fruit"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line a 9 inch square baking pan with aluminum foil. Spray the foil with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the oats, flour, cereal, and cinnamon. Add the egg, applesauce, honey, brown sugar, and oil. Mix well. Stir in the sunflower seeds, walnuts, and dried fruit. Spread mixture evenly in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 30 minutes, or until firm and lightly browned around the edges. Let cool. Use the foil to lift from the pan. Cut into bars or squares, and store in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
