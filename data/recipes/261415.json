  "ingredients": [
    "1 cup unsalted butter, softened",
    "1 cup white sugar",
    "1 cup packed light brown sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "1 teaspoon peppermint extract",
    "1 teaspoon baking soda",
    "2 teaspoons hot water",
    "3 cups all-purpose flour",
    "1 teaspoon salt",
    "0.5 teaspoon cream of tartar",
    "2 cups semisweet chocolate chips",
    "10 drops green food coloring, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, and brown sugar together in a large bowl with an electric mixer until creamy. Beat in eggs. Stir in vanilla extract and peppermint extract. Dissolve baking soda in hot water; stir into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, salt, and cream of tartar in a separate bowl. Gradually add to batter; mix well. Stir in chocolate chips and food coloring until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of batter onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are nicely browned, about 10 minutes. Cool on the baking sheets for 1 minute; transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
