  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 tablespoon sugar",
    "2.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup eggnog",
    "2 tablespoons clarified butter",
    "1 egg, lightly beaten"
  ],
  "steps": [
    {
      "text": "Heat a lightly oiled skillet or griddle over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix the flour, sugar, baking powder, and salt. Make a well in the center, and pour in the eggnog, butter, and egg. Mix until dry ingredients are evenly moist.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/4 cup batter onto the hot griddle for each pancake. Cook pancakes until bubbly on top. Flip with a spatula, and continue cooking until lightly browned on bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
