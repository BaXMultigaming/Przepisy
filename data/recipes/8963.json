  "ingredients": [
    "1 (2 to 3 pound) whole chicken, cut into pieces",
    "1 cup dried bread crumbs",
    "1 teaspoon garlic powder",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon dried thyme",
    "0.5 teaspoon paprika",
    "1 cup mayonnaise"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl or gallon size resealable plastic bag, mix together the bread crumbs, garlic powder, salt, pepper, thyme and paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat the chicken pieces with mayonnaise. Place chicken pieces in bowl/bag with bread crumb mixture and coat/shake until well coated. Place chicken pieces in a lightly greased 9x13 inch baking dish and bake for 45 minutes or until juices run clear.",
