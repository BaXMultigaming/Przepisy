  "ingredients": [
    "1 head cauliflower, thinly sliced",
    "1 pound shrimp - cooked, peeled, deveined and chilled",
    "1 cup chopped green onions",
    "3 eggs",
    "1 cup mayonnaise",
    "0.75 cup creamy Italian-style salad dressing",
    "0.75 cup sliced black olives",
    "1 tablespoon minced pimento"
  ],
  "steps": [
    {
      "text": "Place eggs in a small saucepan, and add water to cover. Cover the pan, and bring to a boil over high heat. Remove from heat and let stand covered for 12 minutes. Cool, peel, and chop the hard boiled eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mayonnaise and salad dressing together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To a large bowl, add cauliflower, shrimp, green onions, chopped eggs, olives, and pimientos. Toss to combine. Stir in dressing mixture, and toss to coat. Refrigerate. Serve chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
