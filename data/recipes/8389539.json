  "ingredients": [
    "4 heads baby artisan lettuce",
    "1 pound grilled chicken breast, sliced",
    "10 ounces multi-colored cherry tomatoes, halved, or more to taste",
    "1 cup thinly sliced mini peppers",
    "0.5 pound cooked bacon, chopped",
    "0.5 cup ranch dressing",
    "2 medium avocados - peeled, pitted, and cubed",
    "0.5 cup multicolored tortilla strips",
    "pollo asado seasoning"
  ],
  "steps": [
    {
      "text": "Remove core from each mini artisan lettuce. Place each lettuce head on a large cutting board and cut each lettuce head into bite-sized pieces, using a sharp knife. Place lettuce in a very large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken, tomatoes, and peppers to salad greens and sprinkle with chopped bacon. Pour in ranch dressing and toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle cubed avocado and tortilla strips over the the salad and season with pollo asado seasoning, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
