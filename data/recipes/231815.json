  "ingredients": [
    "1.25 cups HONEY MAID Graham Crumbs",
    "0.25 cup butter, melted",
    "2 (250 g) packages PHILADELPHIA Light Brick Cream Cheese Spread, softened",
    "0.75 cup sugar",
    "4 cups mixed fresh berries (blueberries, blackberries, raspberries, strawberries)",
    "2 cups thawed COOL WHIP Light Whipped Topping"
  ],
  "steps": [
    {
      "text": "Line a 9-inch springform pan with parchment on the bottom and sides. Mix graham crumbs and butter; press onto bottom of prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese spread and sugar in large bowl with mixer until blended. Mash 1-1/2 cups berries with fork. Add to cream cheese mixture; beat on low speed just until blended. Gently stir in Cool Whip; spoon over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate 6 hours. Serve topped with remaining berries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
