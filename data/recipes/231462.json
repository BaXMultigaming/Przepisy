  "ingredients": [
    "3 cups all-purpose flour",
    "1 cup dried cranberries",
    "0.75 cup plain yogurt",
    "0.5 cup warm water",
    "3 tablespoons honey",
    "1 tablespoon butter, melted",
    "2 teaspoons active dry yeast",
    "1.5 teaspoons salt",
    "1 teaspoon orange oil"
  ],
  "steps": [
    {
