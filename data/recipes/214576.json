  "ingredients": [
    "1 (16 ounce) package spaghetti",
    "0.25 cup olive oil",
    "8 slices bacon, cut into 1/4 inch pieces",
    "4 cloves garlic, minced",
    "0.5 cup chopped fresh flat-leaf parsley"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil over high heat. Stir in spaghetti and return to a boil. Cook spaghettii uncovered, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain well in a colander set in the sink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat oil in a large skillet over medium heat. Stir in bacon; cook until begins to shrink, about 3 minutes. Add garlic; continue cooking and stirring until garlic softened, and bacon crisp, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss spaghetti with bacon, oil, and parsley to coat; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
