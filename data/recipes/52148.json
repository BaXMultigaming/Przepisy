      ],
      "image": "assets/images/52148/step_04.webp"
    },
    {
      "text": "Sprinkle each stuffed eggplant with Parmesan cheese, bread crumbs, and parsley. Place in a shallow baking dish. Cover with tomato sauce and mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
