  "ingredients": [
    "0.75 cup fresh lemon juice",
    "0.75 cup white sugar",
    "0.5 cup unsalted butter, cubed",
    "3 large eggs",
    "1 tablespoon grated lemon zest"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FR-A5_YtYxAuMXpj8_3bOU6ThxA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/53683-perfect-lemon-curd-DDMFS-step01-ff178b90e5624666888be976ff522b9f.jpg"
      ],
      "image": "assets/images/53683/step_01.webp"
    },
    {
      "text": "Combine lemon juice, sugar, butter, eggs, and lemon zest in a 2-quart saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7H3JFKgQBzb-yW4olzXKRhf_xBo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/53683-perfect-lemon-curd-DDMFS-step02-ada826b7ccb64c9790457ba0b16fbf9a.jpg"
      ],
      "image": "assets/images/53683/step_02.webp"
    },
    {
      "text": "Cook over medium-low heat, whisking constantly to prevent the eggs from curdling, until mixture starts to get thick and bubbles rise to the surface, about 5 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AwKHUakpGpfLnn1VA4LOay183GU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/53683-perfect-lemon-curd-DDMFS-step03-6aa0d693081c445c829126353fc4ad73.jpg"
      ],
      "image": "assets/images/53683/step_03.webp"
    },
    {
      "text": "Remove saucepan from the heat; transfer lemon curd into a large bowl and place a piece of plastic wrap on top to prevent a skin forming. The curd will thicken more as it cools. Store in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/97D0ZPDsuVzEMbt4LBigBSq7qGk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/53683-perfect-lemon-curd-DDMFS-step04-d7f04af625754d9db69c09d56e53a45e.jpg"
      ],
      "image": "assets/images/53683/step_04.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
