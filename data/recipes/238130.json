  "ingredients": [
    "8 ounces bacon, chopped",
    "0.5 cup thinly sliced green onions",
    "1.25 cups all-purpose flour",
    "0.75 cup cornmeal",
    "1 tablespoon baking powder",
    "0.75 teaspoon salt",
    "1 pinch ground black pepper",
    "1 pinch cayenne pepper",
    "1.3333333730698 cups milk",
    "2 ounces sharp Cheddar cheese, grated",
    "2 large eggs, beaten",
    "2 tablespoons butter, melted",
    "1 tablespoon white sugar",
    "1 cup warm maple syrup, or to taste",
    "0.125 teaspoon chipotle chile powder, or to taste",
    "1 teaspoon vegetable oil",
    "1 teaspoon butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m4bCb5oshwIDS4EGytsuvDUzpiM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-238130-mancakes-VAT-step-01-8f78b15447964ac5a2233b43ab63fd31.jpg"
      ],
      "image": "assets/images/238130/step_01.webp"
    },
    {
      "text": "Cook bacon in a large skillet over medium-high heat, stirring occasionally, until evenly browned, about 10 minutes. Off heat, stir green onions into bacon; sauté in hot drippings until slightly softened, 1 to 2 minutes. Transfer bacon mixture to a strainer; drain. Reserve drippings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HW9KkL5xrZHDKqZOdfiOsZ-0W8E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-238130-mancakes-VAT-step-02-A-bdd4dbcae54a4a22a69c6c9381308f06.jpg"
      ],
      "image": "assets/images/238130/step_02.webp"
    },
    {
      "text": "Whisk flour, cornmeal, baking powder, salt, black pepper, and cayenne pepper together in a large bowl; whisk in drained bacon mixture, milk, Cheddar cheese, eggs, melted butter, and sugar until batter is smooth. Let batter rest for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/do3zLrLJKEYXvDiuNUlXhWV8Qws=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-238130-mancakes-VAT-step-03-A-e426348a252d4ea39027b83aebde2229.jpg"
      ],
      "image": "assets/images/238130/step_03.webp"
    },
    {
      "text": "Whisk maple syrup and chipotle chile powder together in a small bowl until chile powder is completely dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/89O5E_Ub5IFNEMzsQ9q4d8cqMI0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-238130-mancakes-VAT-step-04-6de4dc222ccc498a8be00743eea6d8b0.jpg"
      ],
      "image": "assets/images/238130/step_04.webp"
    },
    {
      "text": "Heat 1 teaspoon reserved drippings, 1 teaspoon oil, and 1 teaspoon butter on a griddle over medium-high heat. Drop ¼ cupfuls of batter per mancake onto the griddle; cook until bubbles form and edges are dry, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tSKkrKrPVG0Cn4QIM4hS84glWXM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-238130-mancakes-VAT-step-05-72f855755f6b42aea620e83d0addc803.jpg"
      ],
      "image": "assets/images/238130/step_05.webp"
    },
    {
      "text": "Flip; cook until browned on other side, 2 to 3 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1iZwtu1eJbCh5eFG5Y6iYr06vfM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-238130-mancakes-VAT-step-06-e93e8b5c93b341be976ee6f78b9d89a8.jpg"
      ],
      "image": "assets/images/238130/step_06.webp"
    },
    {
      "text": "Transfer mancakes to a plate; top with maple syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gwlqPPgY5ZQ8LAJCRwBVm0te6zQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-238130-mancakes-VAT-4x3-A-1f28df04837244ebb9b1ad80bf2de934.jpg"
      ],
      "image": "assets/images/238130/step_07.webp"
    }
