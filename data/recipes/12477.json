  "title": "Steak and Kidney Pie",
  "description": "This savory steak and kidney pie has a rich filling of tender steak with diced kidneys in a rich gravy topped with golden flaky pastry for a hearty meal.",
  "authors": [
    "Lorrie Sterling"
  ],
  "date_published": "1998-10-22T10:10:54-04:00",
