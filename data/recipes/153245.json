  "title": "Pumpkin Cupcakes",
  "description": "Deliciously moist pumpkin cupcakes topped with a creamy cinnamon cream cheese frosting. Easy to make and perfect for fall and holiday celebrations.",
  "authors": [
    "Javaru"
  ],
  "date_published": "2020-06-18T23:33:11-04:00",
