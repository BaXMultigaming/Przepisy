  "ingredients": [
    "3 cups water",
    "1 cup sorghum grain",
    "5 quail eggs",
    "0.5 teaspoon Sriracha salt, or to taste",
    "0.25 teaspoon ground cumin",
    "2 tablespoons avocado oil, divided",
    "0.5 teaspoon vinegar",
    "4 ounces fresh buffalo mozzarella",
    "4 fresh basil leaves",
    "1 avocado, sliced",
    "1 Kumato® tomato, diced",
    "4 radishes, sliced"
  ],
  "steps": [
    {
      "text": "Bring water and sorghum to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until sorghum is tender and liquid has been absorbed, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place eggs in a saucepan and fill with water; boil for 4 minutes. Remove from heat, cover, and let sit for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sorghum, Sriracha salt, and cumin together in a bowl. Drizzle 1 tablespoon avocado oil and vinegar over sorghum mixture and mix well; divide between 2 bowls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse quail eggs under cold water; peel and cut each egg in half. Set egg halves on top of sorghum mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred mozzarella cheese using your hands; divide between the 2 bowls of sorghum. Tear basil leaves and sprinkle over mozzarella cheese. Divide avocado, tomato, and radishes between the bowls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
