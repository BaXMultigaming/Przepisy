  "ingredients": [
    "2.25 pounds potatoes, peeled and chopped",
    "4 slices white bread, torn into pieces",
    "0.5 cup diced onion",
    "0.5 cup diced celery",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes. Drain and mash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease one 2 quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the potatoes, white bread, onion, celery, salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into prepared casserole dish and bake at 350 degrees F (175 degrees C) for 1 hour.",
