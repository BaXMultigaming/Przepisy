  "ingredients": [
    "1.5 tablespoons grated fresh ginger root",
    "1 cup sugar",
    "0.25 teaspoon active dry yeast",
    "1 lemon, juiced",
    "water"
  ],
  "steps": [
    {
      "text": "Into an empty 2-liter soda bottle, put ginger root, sugar, yeast, and lemon juice. Fill the rest of the bottle with water. Screw the cap onto the bottle as tight as possible. Shake the bottle well, then leave at room temperature until the bottle is too hard to squeeze, about 2 days. Refrigerate. To serve, pour through a tea strainer.",
