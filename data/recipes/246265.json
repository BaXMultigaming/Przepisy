  "ingredients": [
    "1 cup white sugar, or to taste",
    "0.5 cup unsweetened cocoa powder",
    "0.33333334326744 cup cornstarch",
    "0.25 teaspoon salt",
    "3 cups unsweetened almond milk",
    "1 teaspoon unsalted butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Whisk sugar, cocoa powder, cornstarch, and salt together in a saucepan off the stove. Add 1/4 cup almond milk; whisk until smooth and foamy. Continue adding almond milk, 1/4 cup at a time, whisking after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the saucepan over medium-high heat and cook, stirring constantly, until mixture comes to a simmer and starts to thicken, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat and stir in butter until melted and smooth. Stir in vanilla, then pour pudding into a serving bowl. Cover and refrigerate until chilled, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
