  "ingredients": [
    "1 cup sugar",
    "1 cup light corn syrup",
    "1 cup SunButter®, any variety",
    "6 cups crispy rice cereal",
    "1 (11.5 ounce) package semisweet chocolate chips",
    "1 (12 ounce) package Guittard® Butterscotch Chips"
  ],
  "steps": [
    {
      "text": "In large microwaveable dish, mix sugar and corn syrup until well blended. Microwave 1-1/2 minutes on High. Remove from microwave and stir. Microwave an additional 1 minute or until sugar is dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add SunButter® and mix until smooth. Add cereal. Press into a 9x13-inch greased cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In medium microwaveable dish, combine chocolate chips and butterscotch chips. Microwave on High 1 minute. Remove from microwave and stir. Microwave 1 minute more or until chips are melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread melted chips on top of cereal mixture and let cool or refrigerate until chocolate sets. Cut into 24 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
