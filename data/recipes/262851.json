  "ingredients": [
    "1 pound scallops",
    "salt and freshly ground black pepper to taste",
    "2 tablespoons all-purpose flour",
    "2 tablespoons butter",
    "1 tablespoon pesto",
    "1 tablespoon capers",
    "1 cup heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Season scallops with salt and pepper, then dredge in flour.",
