  "ingredients": [
    "2 tablespoons butter",
    "4 firm bananas, peeled and cut into 1- to 2-inch pieces",
    "0.25 cup brown sugar",
    "0.5 teaspoon ground cinnamon",
    "1 lime, juiced",
    "1 teaspoon black sesame seeds"
  ],
  "steps": [
    {
      "text": "Melt butter in a wok over high heat. Add bananas, brown sugar, and cinnamon; saute until bananas are golden brown and sugar is bubbling, about 5 minutes. Stir in sesame seeds and lime juice.",
