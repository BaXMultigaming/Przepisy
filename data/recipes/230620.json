  "ingredients": [
    "1 whole chicken, cut into 6 pieces",
    "1 cup mayonnaise",
    "2 cloves garlic, crushed",
    "1 tablespoon finely chopped fresh rosemary",
    "1 teaspoon salt",
    "freshly ground black pepper to taste",
    "0.5 cup grated Parmesan cheese"
  ],
