  "ingredients": [
    "1 tablespoon sweet cream butter",
    "0.5 cup brown rice",
    "0.5 cup coconut milk",
    "0.5 cup water",
    "2 tablespoons white sugar",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Cook butter in a small saucepan over medium heat until beginning to brown, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grind uncooked rice in a blender until grains are broken; add to butter, cook and stir until lightly browned, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir coconut milk, water, sugar, and cinnamon together in a bowl to dissolve sugar; gradually add to rice, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low, cover saucepan, and simmer until rice is tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
