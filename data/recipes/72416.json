  "ingredients": [
    "1 tablespoon canola or vegetable oil, or more as needed, for greasing",
    "2 pounds lean ground turkey",
    "2 tablespoons minced garlic",
    "1 teaspoon minced fresh ginger root",
    "2 fresh green chile peppers, diced",
    "1 medium red onion, diced",
    "0.5 cup fresh cilantro, finely chopped",
    "1 teaspoon salt",
    "0.25 cup low sodium soy sauce",
    "1 tablespoon freshly ground black pepper",
    "3 tablespoons paprika",
    "1 tablespoon ground dry mustard",
    "1 tablespoon ground cumin",
    "1 dash Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Preheat the grill for high heat. Lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together ground turkey, garlic, ginger, chile peppers, red onion, cilantro, salt, soy sauce, black pepper, paprika, mustard, cumin, and Worcestershire sauce in a large bowl until well combined. Form mixture into 8 burger patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook patties on the preheated grill until well done, 5 to 10 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
