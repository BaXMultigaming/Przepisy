    "0.25 cup sour cream",
    "0.25 cup mayonnaise",
    "1 tablespoon apple cider vinegar",
    "1 tablespoon stone ground mustard",
    "1.5 teaspoons white sugar",
    "0.66666668653488 cup blue cheese crumbles, or to taste",
