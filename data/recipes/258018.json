  "ingredients": [
    "1 cup packed brown sugar",
    "0.75 cup chopped pecans",
    "0.25 cup melted butter",
    "2 tablespoons all-purpose flour",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground nutmeg",
    "1 (15.25 ounce) package yellow cake mix",
    "1 cup pumpkin puree",
    "3 eggs",
    "0.5 cup water",
    "0.5 cup confectioners' sugar",
    "0.25 cup milk, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar, pecans, butter, flour, cinnamon, cloves, and nutmeg together in a bowl to make crunch mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix yellow cake mix, pumpkin, eggs, and water together in a separate bowl until batter is smooth. Pour half of the batter into the prepared baking dish; top with crunch mixture. Pour remaining batter over crunch.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk confectioners' sugar and milk together in a small bowl, adding more milk if needed to reach a pourable consistency; drizzle over the cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
