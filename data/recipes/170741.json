  "ingredients": [
    "0.5 cup butter",
    "1 small onion, finely chopped",
    "2 cups ketchup",
    "0.5 cup water",
    "0.33333334326744 cup distilled white vinegar",
    "3 tablespoons brown sugar",
    "2 tablespoons Worcestershire sauce",
    "2 teaspoons prepared yellow mustard",
    "1.5 pounds chipped chopped ham",
    "8 kaiser rolls, split",
    "1 cup pickle relish"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium-high heat. Add onion; cook and stir until translucent, about 5 minutes. Stir in ketchup, water, vinegar, brown sugar, Worcestershire sauce, and mustard; simmer about 10 minutes. Stir in ham; cook until sauce is bubbling and ham is heated through, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat kaiser rolls in the preheated oven until toasted, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide ham mixture among toasted rolls; top with pickle relish. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
