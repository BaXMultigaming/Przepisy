  "ingredients": [
    "3 tablespoons olive oil",
    "1 small onion, chopped",
    "2 cloves garlic, minced",
    "3 tablespoons curry powder",
    "1 teaspoon ground cinnamon",
    "1 teaspoon paprika",
    "1 bay leaf",
    "0.5 teaspoon grated fresh ginger root",
    "0.5 teaspoon white sugar",
    "salt to taste",
    "2 skinless, boneless chicken breast halves - cut into bite-size pieces",
    "1 tablespoon tomato paste",
    "1 cup plain yogurt",
    "0.75 cup coconut milk",
    "0.5 lemon, juiced",
    "0.5 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a skillet over medium heat. Sauté onion until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z5rGLzpMzYWntTzXFfu-d3GD24k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46822-Indian-Chicken-Curry-PICS-step-01-bac5e3cfb9f84ec49139b51230874edf.jpg"
      ],
      "image": "assets/images/46822/step_01.webp"
    },
    {
      "text": "Stir in garlic, curry powder, cinnamon, paprika, bay leaf, ginger, sugar, and salt. Continue stirring for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hDPvMNfY_dl_rRxR30PiD1S5yOA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46822-Indian-Chicken-Curry-PICS-step-02-22f16e8e961b45478d8b6d210c841c9b.jpg"
      ],
      "image": "assets/images/46822/step_02.webp"
    },
    {
      "text": "Add chicken pieces, tomato paste, yogurt, and coconut milk. Bring to a boil, reduce heat, and simmer for 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8l2fyzcr2P-gvq9IRNKzvekV8-A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46822-Indian-Chicken-Curry-PICS-step-03-4608285026a944a09db1c1ae28064c9d.jpg"
      ],
      "image": "assets/images/46822/step_03.webp"
    },
    {
      "text": "Remove bay leaf, and stir in lemon juice and cayenne pepper. Simmer 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/odXuaWC22BB1YMJsslirSvqRKwc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46822-Indian-Chicken-Curry-PICS-step-04-db46e3e9fbba444595989085b2e094fb.jpg"
      ],
      "image": "assets/images/46822/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5cNqrUZLaR6p7Wbq_khQjIKnHiE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46822-Indian-Chicken-Curry-PICS-Beauty-4x3-9535b806e7dc4f1da14f8ddb7a6367a4.jpg"
      ],
