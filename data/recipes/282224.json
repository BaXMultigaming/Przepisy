  "ingredients": [
    "1 pound ground beef",
    "0.25 medium head cabbage, cut into chunks",
    "1 small head broccoli, cut into florets",
    "2 medium potatoes, cut into 1/4-inch slices",
    "1 medium onion, chopped",
    "1 cup baby carrots",
    "1 cup frozen peas",
    "1 (46 fluid ounce) bottle vegetable juice (such as V8®)",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer ground beef to the bottom of a slow cooker. Layer cabbage, broccoli, potatoes, onion, carrots, and peas, one by one, on top of the meat. Pour vegetable juice over top. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook until vegetables are tender, 6 to 8 hours on Low, gently stirring after a few hours of cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
