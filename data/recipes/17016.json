  "title": "Mushroom and Swiss Chicken",
  "description": "Cajun seasoning and garlic add zesty flavor to chicken breasts baked with fresh mushrooms and nutty Swiss cheese.",
  "authors": [
    "Natalie Rowe"
  ],
  "date_published": "1999-05-26T18:36:18-04:00",
  "date_modified": "2023-02-21T19:07:48-05:00",
