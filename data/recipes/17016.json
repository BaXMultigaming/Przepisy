    "Dinner"
  ],
  "cuisines": [],
  "regions": [],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "4 tablespoons olive oil, divided",
    "2 cloves crushed garlic",
    "4 skinless, boneless chicken breasts",
    "4 tablespoons red wine vinegar, divided",
    "1 tablespoon Cajun-style seasoning",
    "1 cup chopped green onions",
    "1 (8 ounce) package sliced fresh mushrooms",
    "4 slices Swiss cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 3 tablespoons oil and garlic in a 9x13-inch baking dish. Add chicken breasts and turn until coated. Drizzle chicken with 3 tablespoons vinegar and season with Cajun seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from the oven and cover with green onions and mushrooms. Drizzle remaining 1 tablespoon each oil and vinegar over top. Return to the oven and bake until chicken is no longer pink in the center and the juices run clear, 15 to 20 more minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and immediately place 1 slice Swiss cheese on top of each chicken breast to melt. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
