  "ingredients": [
    "8 ounces salmon fillets",
    "1 tablespoon gochujang (Korean hot pepper paste)",
    "2 tablespoons pineapple juice",
    "1 pinch black sesame seeds",
    "1 pinch white sesame seeds",
    "1 tablespoon sliced green onions, or to taste"
  ],
  "steps": [
    {
