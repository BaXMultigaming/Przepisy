  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup melted butter",
    "0.5 cup confectioners' sugar",
    "0.5 cup chopped macadamia nuts",
    "4 cups chopped mangoes",
    "0.75 cup white sugar",
    "0.33333334326744 cup water",
    "1 teaspoon lemon juice",
    "4 tablespoons cornstarch",
    "3 tablespoons water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, butter, and confectioners' sugar in a bowl. Stir in macadamia nuts. Press half of the mixture into a 1/2-inch-thick layer on the bottom of the prepared pan to make the crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mangoes, white sugar, 1/3 cup water, and lemon juice together in a saucepan. Cook over medium heat until mangoes reduce by 1/3, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornstarch and 3 tablespoons water in a small bowl. Pour into the mango mixture; cook until thickened, 5 to 7 minutes. Cool briefly and pour over the crust. Sprinkle the remaining flour mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue baking until lightly browned, 20 to 25 minutes. Cool until set, about 15 minutes. Cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
