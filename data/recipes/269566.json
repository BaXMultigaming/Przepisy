  "ingredients": [
    "6 camote, peeled and sliced 1/2-inch thick",
    "1 teaspoon salt",
    "1 cup chopped pineapple",
    "0.5 cup brown sugar",
    "3 tablespoons melted butter",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place camote in a large pot and cover with water. Add salt and bring to a boil. Cook over medium heat until crisp-tender, about 10 minutes; do not overcook. Drain and transfer camote to a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pineapple, brown sugar, butter, and cinnamon in a bowl; pour over the camote in the baking dish and toss to coat. Cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until soft and bubbly, about 1 hour. Remove aluminum foil and bake 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
