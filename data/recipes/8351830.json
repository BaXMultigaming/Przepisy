  "title": "Chef John's Chocolate Pecan Pie",
  "description": "Easy, delicious, and made more decadent with the addition of chocolate chips, this pecan pie is a must-have on your holiday table.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2022-02-22T08:41:10-05:00",
