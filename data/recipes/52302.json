  "ingredients": [
    "1.5 cups cooked garbanzo beans",
    "0.5 cup tahini",
    "1 lemon, juiced",
    "2 tablespoons olive oil",
    "8 oil-packed sun-dried tomatoes",
    "1 tablespoon maple syrup",
    "1 tablespoon nutritional yeast",
    "0.5 teaspoon fennel seed",
    "0.25 cup chopped onion",
