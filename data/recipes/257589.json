  "ingredients": [
    "4 Ball Park® Hamburger Buns",
    "4 sausage patties",
    "8 eggs",
    "Salt and pepper to taste",
    "1 tablespoon olive oil",
    "1 teaspoon Sriracha sauce, or to taste",
    "0.5 cup mayonnaise",
    "4 slices Cheddar cheese",
    "1 cup arugula"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F. Toast buns until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook sausage patties in a skillet over medium heat until brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While preparing sausage, whisk the eggs together in a bowl and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a clean saute pan add 1 tablespoon of olive oil and scramble the eggs till cooked throughout.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Sriracha sauce and mayonnaise and spread on each side of the buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a sausage patty onto the four bottom buns. For each sandwich, top sausage with eggs, cheese and arugula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve while warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
