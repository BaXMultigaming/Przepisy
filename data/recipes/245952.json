  "ingredients": [
    "10 slices bacon",
    "5 red potatoes, diced",
    "1 red bell pepper, diced",
    "1 orange bell pepper, diced",
    "0.5 red onion, diced",
    "1 jalapeno pepper, diced",
    "1 cup shredded Cheddar cheese, divided",
    "6 eggs",
    "0.75 cup skim milk",
    "1 tablespoon garlic powder",
    "1 tablespoon ground black pepper",
    "0.5 teaspoon salt",
    "0.25 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels, then crumble into pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease the bottom and sides of a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer potatoes, bell peppers, onion, and jalapeño in the prepared casserole dish. Sprinkle 1/2 cup Cheddar cheese on top. Scatter bacon pieces over Cheddar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, milk, garlic powder, black pepper, salt, and paprika together in a large bowl. Pour over layers in the casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, about 35 minutes. Remove from the oven and top with remaining 1/2 cup Cheddar. Continue baking until cheese is melted and golden, about 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
