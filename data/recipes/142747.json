  "title": "Mango Jam",
  "description": "Luscious, fresh mango jam will add bright, tropical sweetness all winter long to a variety of dishes and desserts. Canning mangoes made easy.",
  "authors": [
    "RADHIKA GHATAGE"
  ],
  "date_published": "2020-06-18T23:31:03-04:00",
