  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "2 pounds ripe mangoes",
    "1.5 cups white sugar",
    "0.75 cup water",
    "3 saffron threads"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0WBJWB0O4uZxA-1AVt9WBr4jjqg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-142747-MangoJam-ddmfs-step1-3x4-6841-3d2645bec58d4d0596b993a3ef1d50aa.jpg"
      ],
      "image": "assets/images/142747/step_01.webp"
    },
    {
      "text": "Make 4 to 5 slits in mangoes and microwave on High until soft, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a5Yrmdbue4zyvFyoh6QCli09SaE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-142747-MangoJam-ddmfs-step2-3x4-6844-5f7ea62ee2724c829a94dd4b931c44ea.jpg"
      ],
      "image": "assets/images/142747/step_02.webp"
    },
    {
      "text": "Cool, then remove the peel and inner seed; place mango pulp in a large bowl. Use a fork or potato masher to mash the pulp well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ybLglT-SzBDIuZg1Ikk8hG45Vus=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-142747-MangoJam-ddmfs-step3-3x4-6847-fb373252a13047e397504a821b090a77.jpg"
      ],
      "image": "assets/images/142747/step_03.webp"
    },
    {
      "text": "Stir together sugar and water in a large saucepan over low heat, and bring to a boil. When the mixture begins boiling, increase heat to medium-high. Continue boiling until fine, soft threads form, 270 degrees F (135 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TmE6edNd0CskYZj4JMvBaIve0Ps=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-142747-MangoJam-ddmfs-step4-3x4-6882-34ee11cfa6564a4e95b0a64f4a0f6461.jpg"
      ],
      "image": "assets/images/142747/step_04.webp"
    },
    {
      "text": "Stir in mango pulp, add saffron threads, and boil until the mixture thickens, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qUB-mFlqIWW0cx83IkOy99bWB4A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-142747-MangoJam-ddmfs-step5-3x4-6894-6090d1e401de4d7495c2298fc4251f65.jpg"
      ],
      "image": "assets/images/142747/step_05.webp"
    },
    {
      "text": "Pour cooked jam into sterilized jars and seal according to canning directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uRAvpbLuXCNo67N3edSC6Stzv4I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-142747-MangoJam-ddmfs-step6-3x4-6897-763bf509caac4f87bf8fe6b4a289e2aa.jpg"
      ],
      "image": "assets/images/142747/step_06.webp"
    }
