  "ingredients": [
    "1 pint fresh blueberries",
    "1.25 cups milk",
    "0.66666668653488 cup white sugar",
    "0.5 cup all-purpose flour",
    "3 large eggs",
    "1 tablespoon vanilla extract",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Generously butter a 2 1/2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour blueberries into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend milk, sugar, flour, eggs, vanilla extract, and salt in a blender until batter is smooth. Pour batter over blueberries and gently shake to remove any air bubbles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and center is set, 25 to 30 minutes. Cool until clafoutis deflates and is just warm.",
      "section": null,
      "name": null,
      "url": null,
