  "ingredients": [
    "2 quarts vegetable oil for frying",
    "1 cup all-purpose flour",
    "2 teaspoons baking powder",
    "1.5 teaspoons white sugar",
    "1 pinch salt",
    "2 large eggs, beaten",
    "1 cup ricotta cheese",
    "0.25 teaspoon vanilla extract",
    "0.5 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Heat oil in a deep fryer to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vTMsYhycLflu_l4ii1SQBDvi_Ys=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19847-zeppole-DDMFS-step-01-d629330e9c0b4b73b9a8608f985da8ce.jpg"
      ],
      "image": "assets/images/19847/step_01.webp"
    },
    {
      "text": "Combine flour, baking powder, sugar, and salt in a medium saucepan. Stir in eggs, ricotta cheese, and vanilla. Mix gently over low heat until combined. Batter will be sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4l_j8w8s2Ib3LUhu3UBHrULku3E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19847-zeppole-DDMFS-step-02-7b992341e7ec4b4eb5cc7d3eddcfcc1f.jpg"
      ],
      "image": "assets/images/19847/step_02.webp"
    },
    {
      "text": "Drop by tablespoons into the hot oil a few at a time. Zeppole will turn over by themselves. Fry until golden brown, about 3 or 4 minutes. Drain in a paper sack and dust with confectioners' sugar. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qb3IUSFkeG8zz0NNGqPRE-8D2FI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19847-zeppole-DDMFS-step-03-8078600b9bfc4072a8be31bca07881ba.jpg"
      ],
      "image": "assets/images/19847/step_03.webp"
    }
  ],
