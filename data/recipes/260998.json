  "ingredients": [
    "1.5 teaspoons vegetable oil, or as needed",
    "1 large white onion, chopped",
    "2 cloves garlic, chopped",
    "4 large boneless, skinless chicken breasts, cubed",
    "2 cups picante sauce",
    "1 (15 ounce) can black beans, undrained",
    "1 (15 ounce) can pinto beans, undrained",
    "6 Roma tomatoes, chopped",
    "1 (4 ounce) can chopped green chilies",
    "0.25 cup dry white wine",
    "2 tablespoons ground cumin",
    "1 tablespoon dried sage",
    "1 bay leaf"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sauté onion and garlic until onion is translucent, about 5 minutes. Add chicken; cook and stir until mostly opaque, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add picante sauce, black beans, pinto beans, tomatoes, green chilies, wine, cumin, sage, and bay leaf; simmer until flavors meld, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
