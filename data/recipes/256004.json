  "ingredients": [
    "1 cup pecan halves",
    "1 cup light corn syrup",
    "1 cup white sugar",
    "3 eggs",
    "0.25 cup unsalted butter, melted",
    "0.25 cup bourbon",
    "0.5 teaspoon salt",
    "0.33333334326744 cup dark chocolate chips",
    "0.33333334326744 cup milk chocolate chips",
    "0.33333334326744 cup white chocolate chips",
    "1 pastry for a 9-inch pie crust",
    "2 teaspoons milk, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Spread pecan halves on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast pecans in the preheating oven, stirring occasionally, until golden and fragrant, 6 to 10 minutes. Chop coarsely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk corn syrup, sugar, eggs, melted butter, bourbon, and salt together in a large bowl. Stir pecans, dark chocolate chips, milk chocolate chips, and white chocolate chips into the filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a 9-inch fluted glass pie plate with pie crust. Brush milk over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pie crust in the preheated oven until hot to the touch, 5 to 10 minutes. Pour filling into the hot crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are firm and center is mostly set, about 45 minutes. Transfer to a cooling rack; cool for at least 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
