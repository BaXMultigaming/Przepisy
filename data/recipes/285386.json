  "ingredients": [
    "0.75 cup cane sugar",
    "0.75 cup almond milk",
    "0.25 cup unsweetened applesauce",
    "0.25 cup coconut oil, melted",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.33333334326744 cup cocoa powder",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons ground cinnamon",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "1 cup grated zucchini",
    "0.5 cup vegan chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cane sugar, almond milk, applesauce, coconut oil, and vanilla together in a large bowl using an electric mixer; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cocoa powder, baking powder, cinnamon, salt, and baking soda together in a separate bowl; slowly add to cane sugar mixture using an electric mixer until well mixed. Stir in zucchini and ¼ cup chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared bread pan; sprinkle remaining ¼ cup chocolate chips on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top springs back when lightly pressed and a toothpick inserted into center comes out clean, 50 to 55 minutes. Cool in the pan for 10 minutes. Remove from the pan; transfer to a wire rack to cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
