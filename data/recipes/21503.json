  "ingredients": [
    "1 (14.75 ounce) can salmon, undrained",
    "0.5 cup crushed saltine crackers",
    "0.5 cup milk",
    "1 large egg, beaten",
    "2 tablespoons melted butter",
    "salt and pepper to taste"
  ],
  "steps": [
