  "ingredients": [
    "1 (16 ounce) package spaghetti",
    "3 (12.5 fl oz) cans chicken chunks, drained",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "4 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally until tender yet firm to the bite, about 12 minutes. Drain; transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chicken, cream of mushroom soup, and cream of chicken soup into spaghetti; transfer to a 9x13-inch baking dish. Top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and sauce is bubbly, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
