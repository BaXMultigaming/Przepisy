  "ingredients": [
    "1 (9 inch) deep dish frozen pie crust",
    "5 ounces shredded Swiss cheese",
    "0.5 cup chopped onion",
    "3 ounces grated Parmesan cheese",
    "1 (3 ounce) can bacon bits",
    "4 eggs, lightly beaten",
    "1 cup half-and-half cream"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place unthawed pie crust in a 9 inch pie plate on a baking sheet. Combine Swiss cheese, onion, Parmesan cheese, and bacon bits in a medium bowl; pour into the crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PqcOXgy5znM8aYdCzqsDiWlJsCM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24474-easy-bacon-and-cheese-quiche-ddmfs-step2-0193-4x3-88371eb791cc4576829522857c4a77b7.jpg"
      ],
      "image": "assets/images/24474/step_02.webp"
    },
    {
      "text": "Whisk eggs and half and half together in a bowl until blended; pour over cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MdL9YqT-GYvC2K_Ed41kIBx4oug=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24474-easy-bacon-and-cheese-quiche-ddmfs-step5-0197-4x3-57f87b2644c747748b6d6c4e81128330.jpg"
      ],
      "image": "assets/images/24474/step_03.webp"
    },
    {
      "text": "Bake in preheated oven for 15 minutes. Reduce the oven temperature to 350 degrees F (175 degrees C); continue baking until quiche top begins to turn golden brown, about 35 minutes more.",
