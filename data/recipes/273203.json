  "ingredients": [
    "0.5 stick butter",
    "2 onions, sliced",
    "2 tablespoons minced garlic",
    "2.25 pounds boneless stewing beef, cut into 1-inch (2.5 cm) pieces",
    "6 cups water",
    "0.75 cup rice wine",
    "0.5 cup soy sauce",
    "0.5 cup brown sugar",
    "0.33333334326744 cup honey",
    "5 shiitake mushrooms, sliced",
    "0.5 teaspoon chile-garlic sauce",
    "1 carrot, sliced",
    "0.25 cup toasted sesame seeds",
    "salt and ground black pepper to taste",
    "2 tablespoons sesame oil"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Add onion and garlic; cook for 1 to 3 minutes. Add beef; cook and stir until brown, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add water, rice wine, soy sauce, brown sugar, honey, mushrooms, and chile-garlic sauce to the skillet with beef. Simmer until beef is tender, about 60 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add carrot and sesame seeds to the skillet with stew. Season with salt and pepper. Continue cooking until 1/2 the liquid has evaporated, about 15 minutes. Drizzle in sesame oil and remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
