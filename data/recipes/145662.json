  "ingredients": [
    "10 large baking potatoes, peeled and cubed",
    "3 tablespoons olive oil, or as needed",
    "1 onion, diced",
    "1 tablespoon ground turmeric",
    "1 tablespoon salt, or to taste",
    "2 teaspoons ground black pepper",
    "0.5 teaspoon ground cumin"
  ],
  "steps": [
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender and easily pierced with a fork, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat 1 tablespoon oil in a small skillet over medium-high heat. Add onion; cook until translucent and lightly brown, about 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain water from potatoes; mash. Stir in onion; continue mashing. Add turmeric, salt, black pepper, and cumin; add remaining 2 tablespoons oil until potatoes reach a creamy consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
