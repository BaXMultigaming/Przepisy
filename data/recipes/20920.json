  "ingredients": [
    "cooking spray",
    "4 cups shredded zucchini",
    "1 onion, chopped",
    "1 (8.5 ounce) package dry corn muffin mix",
    "2 eggs, beaten",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "8 ounces Cheddar cheese, shredded"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together zucchini, onion, muffin mix, beaten eggs, salt, and pepper in a large bowl until well combined. Stir in 4 ounces cheese. Spread evenly into the prepared baking dish. Sprinkle with remaining 4 ounces cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is lightly browned and a toothpick inserted into the center comes out clean, about 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
