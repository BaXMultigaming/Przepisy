  "ingredients": [
    "1 tablespoon olive oil",
    "1 pound carrots, peeled and sliced",
    "1 small onion, roughly chopped",
    "3 cloves garlic, chopped",
    "1 teaspoon ground coriander",
    "1 teaspoon ground cumin",
    "4 cups chicken bone broth",
    "0.5 cup chopped fresh parsley",
    "0.5 cup plain Greek yogurt",
    "salt and ground black pepper to taste",
    "0.25 cup chopped fresh cilantro, or to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a large soup pot over medium-high heat. Add carrots and onion; cook until slightly softened, about 5 minutes. Add garlic, coriander, and cumin; cook until fragrant, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add bone broth and bring to a boil. Lower heat and simmer until the carrots are tender, 5 to 7 minutes. Add parsley; cook for 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree with an immersion blender or in a blender until smooth. Add yogurt; blend until thoroughly mixed. Season with salt and pepper. Ladle into bowls and garnish with cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
