  "ingredients": [
    "nonstick cooking spray",
    "1 (15 ounce) can pumpkin puree",
    "1 (12 fluid ounce) can evaporated milk",
    "0.75 cup white sugar",
    "0.5 cup baking mix (such as Bisquick ®)",
    "0.5 cup maple syrup",
    "2 eggs, beaten",
    "2 tablespoons butter, melted",
    "2.5 teaspoons pumpkin pie spice",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Coat the bowl of a slow cooker with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin, evaporated milk, sugar, baking mix, maple syrup, eggs, butter, and pumpkin pie spice in a large bowl. Transfer to the prepared slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until an instant-read thermometer reads 160 degrees F ( C), 6 to 7 hours. Stir in vanilla extract and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
