  "ingredients": [
    "0.5 cup pitted dates",
    "0.5 cup pitted prunes",
    "1 cup water",
    "0.5 cup chopped raisins",
    "0.5 cup margarine",
    "2 eggs",
    "0.5 cup chopped walnuts",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Cut dates and prunes into small pieces; place into a medium saucepan. Add water and raisins. Bring to a boil and cook for 5 minutes. Remove from heat and stir in margarine. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together eggs, nuts, and vanilla in a small bowl until well combined; add to cooled fruit mixture. Sift in flour, baking soda, and salt; stir until incorporated. Spread mixture in a 7x11-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
