  "ingredients": [
    "2 tablespoons vegetable oil",
    "0.75 pound cubed skinless, boneless chicken breast meat",
    "0.5 (1.25 ounce) package taco seasoning mix",
    "1 (15 ounce) can black beans, rinsed and drained",
    "1 (8.75 ounce) can sweet corn, drained",
    "0.25 cup salsa",
    "water as needed",
    "1 cup shredded Mexican-style cheese",
    "1.5 cups crushed plain tortilla chips"
  ],
  "steps": [
    {
      "text": "In a large skillet over medium high heat, saute chicken in oil until cooked through and no longer pink inside. Add taco seasoning, beans, corn, salsa and a little water to prevent drying out. Cover skillet and simmer over medium low heat for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken mixture to a 9x13 inch baking dish. Top with 1/2 cup of the cheese and crushed tortilla chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Add remaining 1/2 cup cheese and bake until cheese is melted and bubbly.",
      "section": null,
      "name": null,
      "url": null,
