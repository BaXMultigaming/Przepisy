  "ingredients": [
    "0.5 cup shortening",
    "1.75 cups all-purpose flour",
    "1 cup white sugar",
    "0.5 teaspoon baking soda",
    "1 egg",
    "0.5 teaspoon salt",
    "0.75 cup buttermilk",
    "0.5 cup unsweetened cocoa powder",
    "1 teaspoon vanilla extract",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Mix thoroughly sugar, shortening and egg. Stir in buttermilk and vanilla. Sift dry ingredients and stir in. Add nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill dough for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Drop by rounded spoonfuls onto the cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 8 to 10 minutes. Cool. Frost with chocolate or white icing. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
