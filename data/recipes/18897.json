  "ingredients": [
    "1 cup couscous",
    "1 cup boiling water",
    "3 tablespoons olive oil",
    "1 clove garlic, minced",
    "0.25 cup diced red bell pepper",
    "4 green onions, sliced",
    "1 cup cherry tomatoes",
    "1 cup fresh basil leaves",
    "1 pinch salt",
    "1 pinch ground black pepper",
    "1 dash balsamic vinegar",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir couscous into boiling water and return water to a boil. Cover and remove pot from heat. Let stand 5 minutes, then fluff with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While couscous is cooking, heat oil in a large skillet over medium heat. Stir in garlic, green onions, and peppers; sauté briefly. Stir in tomatoes, basil, cooked couscous, salt, and pepper. Mix together and transfer to a 1 1/2 quart casserole dish. Splash some balsamic vinegar on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Sprinkle with Parmesan cheese while still warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
