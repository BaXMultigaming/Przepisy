  "ingredients": [
    "4 sheets Reynolds Wrap® Heavy Duty Aluminum Foil",
    "2 medium yellow squash, cut into 1/2-inch slices",
    "2 large Roma tomatoes, cut into wedges",
    "1 medium onion, chopped",
    "4 tablespoons butter, melted",
    "0.25 cup chopped fresh basil",
    "Salt and pepper to taste",
    "0.25 cup shredded Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1/4 of vegetables in center of a sheet of Reynolds Wrap® Heavy Duty Aluminum Foil. Drizzle with butter; top with basil. Sprinkle with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring up sides of foil over vegetables; fold down two times. Double fold both ends of foil to seal packet, leaving room for heat circulation inside. Repeat to make four packets. Place packets on baking sheet with 1-inch sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 15 to 18 minutes on the cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Open packets carefully by cutting beside top fold with a sharp knife, allowing steam to escape. Sprinkle 1 tablespoon Parmesan cheese over vegetables in each packet.",
      "section": null,
      "name": null,
      "url": null,
