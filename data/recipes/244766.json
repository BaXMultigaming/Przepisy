  "steps": [
    {
      "text": "Mix together 1/2 cup lukewarm water and yeast in a small bowl. Let stand until foamy, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 cup water, olive oil, honey, and salt in a large mixing bowl. Add 1 cup flour and mix well. Mix yeast mixture into flour mixture. Add remaining flour, 1 cup at a time, until dough is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead dough on a floured work surface until dough is soft, smooth, and elastic, about 8 minutes. Roll dough into 4 calzone shapes or 1 large pizza.",
