  "ingredients": [
    "0.5 cup lukewarm water",
    "1 (.25 ounce) package active dry yeast",
    "0.5 cup water",
    "2 tablespoons olive oil",
    "2 tablespoons honey",
    "0.5 teaspoon salt",
    "3 cups all-purpose flour, plus more for dusting"
