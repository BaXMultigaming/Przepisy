  "ingredients": [
    "4 (4 ounce) fillets salmon, skin removed",
    "1 cup chopped fresh tomato",
    "0.5 Hass avocado, chopped",
    "1 garlic clove, crushed",
    "1 tablespoon balsamic vinegar",
    "1 teaspoon olive oil",
    "0.5 cup cooked corn kernels",
    "0.25 cup minced red onion",
    "0.25 cup chopped fresh cilantro",
    "Salt and pepper, to taste",
    "1 lime, cut in wedges"
  ],
  "steps": [
    {
      "text": "Place salmon in a shallow microwave bowl. Add 2 cups water. Cover and microwave on high 7-9 minutes or until salmon is cooked as desired. Remove from water; refrigerate until cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine remaining ingredients (except lime). Refrigerate 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve salmon surrounded by the salsa and lime wedges.",
      "section": null,
