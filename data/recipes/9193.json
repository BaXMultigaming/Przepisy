  "ingredients": [
    "6 tablespoons butter",
    "1 red onion, thinly sliced",
    "0.5 teaspoon ground allspice",
    "0.25 teaspoon ground nutmeg",
    "1.5 pounds red cabbage, thinly sliced",
    "0.75 cup dried apricots, sliced",
    "0.25 cup apricot preserves",
    "0.25 cup balsamic vinegar",
    "salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter or margarine in a heavy large pot over medium-high heat. Add onion, allspice, and nutmeg; toss for 1 minute. Add cabbage and apricots. Saute until well coated, about 2 minutes. Add apricot preserves and vinegar. Toss until juices are reduced to glaze and cabbage is crisp-tender, about 6 minutes. Season with salt and pepper. Store, covered, in the refrigerator if making ahead.",
