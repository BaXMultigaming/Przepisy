  "ingredients": [
    "1 pound baby red potatoes, quartered",
    "1 cup shelled English peas",
    "1 tablespoon butter",
    "1 tablespoon all-purpose flour",
    "1 cup milk",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 15 to 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a medium saucepan of water to a boil; add peas and simmer until just tender, about 6 to 7 minutes. Drain and set peas aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add butter to the same saucepan; melt over medium heat. Stir in flour to make a thick paste; gradually whisk in milk, stirring constantly until slightly thickened. Season with salt and pepper to taste. Add potatoes and peas; simmer, stirring often, until potatoes are heated through, about 5 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
