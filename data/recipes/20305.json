  "ingredients": [
    "1.5 quarts milk",
    "1 cup uncooked white rice",
    "1 cup white sugar",
    "2 eggs, beaten"
  ],
  "steps": [
    {
      "text": "In a large saucepan over high heat combine sugar and milk. When bubbles form at the edges, stir in rice and reduce heat to medium-low. Cook 60 minutes, stirring often, until rice is tender. Do not allow to boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and vigorously stir in beaten eggs, a little at a time, until well incorporated. Serve warm.",
      "section": null,
