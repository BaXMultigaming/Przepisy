  "title": "Banana Peanut Butter Bread",
  "description": "In this clever recipe, a popular variation on the peanut butter sandwich is made into a bread! It also calls for walnuts.",
  "authors": [
    "CORWYNN DARKHOLME"
  ],
  "date_published": "1999-05-07T21:51:37-04:00",
