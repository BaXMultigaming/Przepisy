  "ingredients": [
    "0.5 cup butter, softened",
    "1 cup white sugar",
    "2 eggs",
    "0.5 cup peanut butter",
    "2 bananas, mashed",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Lightly grease a 5x9 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, cream together butter and sugar. Add eggs; beat well. Stir in peanut butter, bananas, flour and baking soda until blended. Fold in walnuts. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (165 degrees C) for 70 minutes, or until a toothpick inserted into center of the loaf comes out clean. Remove to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
