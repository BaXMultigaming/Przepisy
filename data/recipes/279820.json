  "ingredients": [
    "1 (8 ounce) package elbow macaroni",
    "3 large eggs",
    "1 cup mayonnaise",
    "1 tablespoon apple cider vinegar",
    "0.25 teaspoon sweet relish",
    "0.25 teaspoon ground white pepper",
    "0.25 teaspoon sea salt",
    "1 large avocado, chopped",
    "0.25 cup chopped celery",
    "0.25 cup chopped green onion",
    "2 tablespoons honey Dijon mustard"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain, rinse with cold water, and transfer to a large bowl. Place in the refrigerator to chill while you prepare the eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place eggs in a saucepan and cover with water. Bring to a boil, remove from heat, and let eggs stand in hot water for 15 minutes. Remove eggs from hot water, cool under cold running water, and peel. Slice eggs with an egg slicer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mayonnaise, vinegar, relish, white pepper, and sea salt together in a small bowl. Gently mix in avocado, celery, and green onion, being careful not to overmix the avocado. Mix in sliced eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add mayonnaise mixture to cooled macaroni; stir until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
