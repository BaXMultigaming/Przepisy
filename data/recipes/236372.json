  "ingredients": [
    "3 large eggs",
    "1 pinch red pepper flakes",
    "9 cherry tomatoes, halved",
    "2 tablespoons crumbled feta cheese",
    "1 tablespoon very thinly sliced fresh basil leaves",
    "olive oil",
    "1 pinch sea salt"
  ],
  "steps": [
    {
      "text": "Whisk eggs and pepper flakes together in a bowl. Stir in tomatoes, feta, and basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a nonstick skillet over high heat until starting to shimmer. Pour egg mixture into hot oil and cook, without stirring, for 5 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir egg mixture until eggs are scrambled and softly set, about 30 seconds. Transfer to a plate and sprinkle with sea salt.",
      "section": null,
      "name": null,
