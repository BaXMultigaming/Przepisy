  "title": "Salisbury Steak",
  "description": "This Salisbury steak recipe browns beef patties and simmers them in a savory onion sauce. Delicious served with mashed potatoes for a comforting dinner.",
  "authors": [
    "Kelly Berenger"
  ],
  "date_published": "1999-09-23T11:55:20-04:00",
