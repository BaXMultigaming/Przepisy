  "ingredients": [
    "1.5 pounds ground beef",
    "1 (10.5 ounce) can condensed French onion soup",
    "0.5 cup dry bread crumbs",
    "1 egg",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1 tablespoon all-purpose flour",
    "0.25 cup ketchup",
    "0.25 cup water",
    "1 tablespoon Worcestershire sauce",
    "0.5 teaspoon mustard powder"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3P1EGAjWMtOqunQ1elpTp0PVAYc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-RM-14595-salisbury-steak-ddmfs-ingredients-3x4-bf6d9e88507b4154b99de427da497eda.jpg"
      ],
      "image": "assets/images/14595/step_01.webp"
    },
    {
      "text": "Combine ground beef, 1/3 cup condensed soup, bread crumbs, egg, salt, and black pepper in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kBJO1OECNCclUmhhEkx8U-kF2o4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-RM-14595-salisbury-steak-ddmfs-step1-1-3x4-887b8026ee4d4708a3d412a42abf0074.jpg"
      ],
      "image": "assets/images/14595/step_02.webp"
    },
    {
      "text": "Shape into 6 oval patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eewW6KOCrOIbfkEPa9K3kFj4PGE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-RM-14595-salisbury-steak-ddmfs-step2-3x4-d8a2e5f1f7ca480bbaff0dcc9d9289e7.jpg"
      ],
      "image": "assets/images/14595/step_03.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat; add patties and brown on both sides. Drain excess fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Td7KMPXDqSe6c50Rf48xgLFqqr0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-RM-14595-salisbury-steak-ddmfs-step3-3x4-5feb989cc1e14ec7857b63b1f89733d6.jpg"
      ],
      "image": "assets/images/14595/step_04.webp"
    },
    {
      "text": "Blend remaining soup and flour together in a small bowl until smooth; mix in ketchup, water, Worcestershire sauce, and mustard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kffOyDHAhqR0bW1saLJBL28Jq1w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-RM-14595-salisbury-steak-ddmfs-step4-3x4-2c1973250a974ba88de6e7d4a2c391f3.jpg"
      ],
      "image": "assets/images/14595/step_05.webp"
    },
    {
      "text": "Pour soup mixture over patties in the skillet. Cover and reduce heat to low. Simmer until patties are cooked through and sauce has thickened, about 20 minutes, stirring occasionally. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w7ReMdcOWh2S7HYETXIeGdj9Eas=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-RM-14595-salisbury-steak-ddmfs-step5-3x4-ea2422a913ba4de593a469a89a66a949.jpg"
      ],
      "image": "assets/images/14595/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YOich567sAQ878Z_ljNv_ybaGoU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-RM-14595-salisbury-steak-ddmfs-3x4-9ed23d6ffebe4448abf1ef7e22c75e3f.jpg"
