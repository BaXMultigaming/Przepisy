  "ingredients": [
    "0.75 cup unsweetened applesauce",
    "0.33333334326744 cup packed brown sugar",
    "0.33333334326744 cup honey",
    "0.5 cup whole wheat flour",
    "0.5 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.5 cup rolled oats",
    "1 teaspoon vanilla extract",
    "1 teaspoon almond extract",
    "0.5 cup chopped dried apricots",
    "0.25 cup sliced almonds",
    "0.25 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, blend the applesauce, brown sugar, and honey. In a separate bowl, sift together the whole wheat flour, all-purpose flour, baking soda, baking powder, salt, cinnamon, and nutmeg. Blend the flour mixture into the applesauce mixture. Fold in the oats, vanilla extract, almond extract, apricots, almonds, and cranberries. Drop the batter by rounded teaspoonfuls onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 12 to 15 minutes in the preheated oven, until golden brown. Cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
