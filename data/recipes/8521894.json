  "ingredients": [
    "2 tablespoons extra-virgin olive oil",
    "1 cup chopped yellow onion",
    "1 tablespoon chopped garlic",
    "1 cup (7 oz.) uncooked orzo",
    "2 cups heavy cream",
    "1 cup chicken broth",
    "2 lemons, zested and juiced",
    "2 cups shredded cooked chicken",
    "3 cups baby spinach",
    "0.5 cup shredded fontina cheese",
    "0.25 cup freshly grated Parmesan cheese, plus more for garnish.",
    "2 tablespoons chopped fresh flat-leaf parsley, plus more for garnish",
    "0.75 teaspoon black pepper",
    "0.5 teaspoon table salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D0OYI_Q0-3k9yEPuUgTYPf0viBo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8521894-one-pot-lemon-chicken-orzo-step-01-d63173b8b2554c0a820b6e04afd6d453.jpg"
      ],
      "image": "assets/images/8521894/step_01.webp"
    },
    {
      "text": "Heat oil in a large Dutch oven over medium. Add onion and cook, stirring occasionally, until softened, 2 to 3 minutes. Add garlic and cook, stirring occasionally, until fragrant, about 30 seconds. Stir in orzo and cook, stirring constantly, until lightly toasted, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TjNR17SV8kiQpfxbPH21D5IUzf4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8521894-one-pot-lemon-chicken-orzo-step-02-e93e0dcf9491474c9fbac74c9f6a2ec4.jpg"
      ],
      "image": "assets/images/8521894/step_02.webp"
    },
    {
      "text": "Stir in heavy cream, broth, about 1 teaspoon lemon zest, and 3 tablespoons lemon juice; bring to a simmer over medium heat, stirring occasionally to prevent the bottom from sticking, about 3 minutes. Reduce heat to medium-low; simmer, stirring constantly, until orzo is tender and mixture is thickened, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EZ3y8CM0qEqK_bJ9f4pFom-wGVo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8521894-one-pot-lemon-chicken-orzo-step-03-20c9173c87cb4c2bbd19e5b8aa7a7391.jpg"
      ],
      "image": "assets/images/8521894/step_03.webp"
    },
    {
      "text": "Stir in chicken and spinach until spinach wilts, about 1 minute. Remove from heat. Stir in fontina, Parmesan, parsley, pepper, and salt until creamy, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K8FNklQgGgNeGyFioQ2O8X_Ss9k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8521894-one-pot-lemon-chicken-orzo-step-04-a25f9d8ad5f548f88dac70cce5a3ef8f.jpg"
      ],
      "image": "assets/images/8521894/step_04.webp"
    },
    {
      "text": "Serve immediately topped with additional Parmesan and parsley. Recipe developed by Laura Kanya",
