  "ingredients": [
    "2 tablespoons butter",
    "1 onion, chopped",
    "1 cup couscous",
    "8 cups water",
    "2 zucchini, chopped",
    "1 potato, chopped",
    "20 green beans, chopped",
    "2 carrots, chopped",
    "2 tablespoons tomato puree",
    "0.5 teaspoon ground coriander",
    "0.5 teaspoon red chile powder",
    "0.5 teaspoon ground cumin",
    "0.25 teaspoon salt",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Melt butter in a pot over medium heat. Add onion; cook and stir until translucent, about 5 minutes. Mix in couscous; cook and stir until browned, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in water, zucchini, potato, green beans, carrots, tomato puree, coriander, chile powder, cumin, and salt; bring to a boil. Simmer until tender, about 20 minutes. Stir in milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
