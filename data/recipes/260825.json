  "ingredients": [
    "12 eggs, separated",
    "3 cups white sugar, divided",
    "16 fluid ounces dark rum (such as Captain Morgan® Spiced Rum)",
    "1 teaspoon ground nutmeg",
    "2 cups heavy whipping cream",
    "1 quart half-and-half"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
