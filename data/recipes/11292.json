  "ingredients": [
    "2 cups all-purpose flour",
    "2 tablespoons instant coffee powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "0.5 cup packed brown sugar",
    "0.5 cup white sugar",
    "0.33333334326744 cup shortening",
    "1 large egg",
    "1 tablespoon milk",
    "1.5 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, coffee powder, salt, baking soda, and baking powder together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, white sugar, shortening, egg, milk, and vanilla in a large bowl; beat with an electric mixer until fluffy. Gradually mix in flour mixture until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 1-inch balls and place 2 inches apart on the prepared baking sheets. Use a fork to flatten balls to a thickness of 1/8 inch.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, switching racks halfway through, until lightly browned, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and transfer to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
