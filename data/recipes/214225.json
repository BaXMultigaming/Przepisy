  "ingredients": [
    "1 tablespoon finely chopped green chile peppers",
    "1 tablespoon rice vinegar",
    "2 tablespoons fresh lime juice",
    "3 tablespoons Asian fish sauce",
    "3 cloves garlic, minced",
    "1 tablespoon white sugar",
    "1 tablespoon Asian (toasted) sesame oil",
    "2 tablespoons vegetable oil",
    "1 teaspoon black pepper",
    "2 cooked skinless boneless chicken breast halves, shredded",
    "0.5 head cabbage, cored and thinly sliced",
    "1 carrot, cut into matchsticks",
    "0.33333334326744 onion, finely chopped",
    "0.33333334326744 cup finely chopped dry roasted peanuts",
    "0.33333334326744 cup chopped fresh cilantro"
  ],
  "steps": [
