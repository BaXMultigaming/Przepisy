  "ingredients": [
    "1 egg",
    "1 cup persimmon pulp",
    "0.5 cup canned sweetened condensed milk",
    "1 teaspoon vanilla extract",
    "1 tablespoon melted butter",
    "1 cup white sugar",
    "1 cup all-purpose flour",
    "2 teaspoons baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Butter a 1 1/2 quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk together the egg, persimmon pulp, sweetened condensed milk, vanilla and melted butter. Combine the sugar, flour, baking soda, salt and cinnamon; whisk into the persimmon batter until well blended. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour in the preheated oven, or until the pudding is set and the top is lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
