  "title": "Pork Pie",
  "description": "This pork pie recipe includes ground beef in the meaty filling mixed with mashed potatoes and lightly seasoned with nutmeg for a French Canadian dish.",
  "authors": [
    "Laurie Fontaine Bennett"
  ],
  "date_published": "1998-12-06T07:40:03-05:00",
