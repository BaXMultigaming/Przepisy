  "ingredients": [
    "cooking spray",
    "0.66666668653488 cup strong brewed coffee, cooled",
    "3 eggs",
    "1 tablespoon coconut oil",
    "0.5 cup coconut flour",
    "0.5 cup brown sugar",
    "0.25 cup shredded unsweetened coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray 6 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk coffee, eggs, and coconut oil together in a bowl. Combine coconut flour, brown sugar, and shredded coconut together in a separate bowl. Stir coffee mixture into flour mixture until batter is just combined; spoon into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the the preheated oven until a toothpick inserted in the center comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
