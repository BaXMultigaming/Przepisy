  "ingredients": [
    "2 cups white sugar",
    "1 cup packed brown sugar",
    "1 cup vegetable oil",
    "4 eggs",
    "1 (15 ounce) can pumpkin puree",
    "3.5 cups all-purpose flour",
    "2 teaspoons baking soda",
    "2 teaspoons salt",
    "0.5 teaspoon ground cloves",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon ground allspice",
    "1 teaspoon ground nutmeg",
    "0.66670000553131 cup water",
    "1 cup flaked coconut",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour two 9 x 5 inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together sugars, oil, and eggs. Mix in pumpkin. Add flour, salt, soda, and spices, and then water. Stir together until just moistened. Stir in coconut and nuts. Pour batter into prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 60 minutes, or until tester inserted in the center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
