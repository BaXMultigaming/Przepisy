  "ingredients": [
    "1 pound ground beef",
    "1 egg",
    "0.5 cup milk",
    "0.25 cup chopped onion",
    "1 cup soft bread crumbs",
    "1 teaspoon salt",
    "1 pinch pepper",
    "1 (15 ounce) can sliced peaches, drained",
    "1 tablespoon vinegar",
    "1 tablespoon ketchup",
    "0.25 cup brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the ground beef, egg, milk, onion, bread crumbs, salt and pepper. Press into a 9 inch pie pan like a crust. Prick meat all over using a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 to 30 minutes in the preheated oven. Remove from the oven, and pour off any excess fat. Arrange the sliced peaches over the beef. Mix together the vinegar, ketchup and brown sugar, and spoon over the top of the peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for an additional 20 minutes. Let stand for at least 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
