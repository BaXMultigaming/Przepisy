  "ingredients": [
    "1 (2 pound) package frozen hash brown potatoes, thawed",
    "1 (8 ounce) package processed cheese",
    "2 cups half-and-half",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place frozen potatoes in a 13 x 9 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan on the stovetop or in microwave on low, melt together cheese and butter or margarine. When melted, blend in the cream. Pour mixture over frozen potatoes, and cover pan with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour. Remove foil, and bake 15 minutes more.",
      "section": null,
