  "ingredients": [
    "2 cups oatmeal",
    "1.5 cups all-purpose flour",
    "1 cup melted butter",
    "1 cup brown sugar",
    "1 teaspoon baking soda",
    "0.75 teaspoon salt",
    "1 (14 ounce) can sweetened condensed milk",
    "0.33333334326744 cup peanut butter",
    "1 cup candy-coated milk chocolate pieces (such as M&M's®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oats, flour, butter, brown sugar, baking soda, and salt together in a bowl. Reserve 1 1/2 cups of crumb mixture. Spread remaining mixture into a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is lightly browned, about 12 minutes. Remove crust; leave oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sweetened condensed milk and peanut butter together in a bowl. Spread over the baked crust. Sprinkle the reserved crumb mixture and milk chocolate pieces on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
