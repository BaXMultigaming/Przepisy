  "ingredients": [
    "2 pounds yuca, peeled and sliced lengthwise",
    "0.5 teaspoon salt",
    "0.25 cup olive oil",
    "0.5 onion, diced",
    "4 cloves garlic, minced",
    "0.5 teaspoon fresh lemon juice"
  ],
  "steps": [
    {
      "text": "Place yuca into a pan and fill with enough water to cover. Stir in salt. Bring to a boil over medium-high heat, cover, and cook until tender, about 15 minutes. Drain; place yuca on a serving plate.",
      "section": null,
      "name": null,
      "url": null,
