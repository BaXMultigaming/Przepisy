  "ingredients": [
    "3 large carrots, cubed",
    "1 large turnip, cubed",
    "0.25 cup all-purpose flour",
    "0.25 cup white sugar",
    "3 tablespoons softened butter",
    "0.5 teaspoon salt",
    "0.5 cup milk",
    "2 eggs",
    "2 tablespoons white sugar",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place carrot and turnip cubes into a large pot and cover with salted water; bring to a boil over high heat. Reduce heat to medium-low, cover, and simmer until tender, about 20 minutes. Drain; steam dry 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return carrot and turnip cubes to the pot. Add flour, ¼ cup sugar, butter, and salt; mash well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and eggs together in a bowl; stir into mashed carrot-turnip mixture until combined. Transfer to the prepared dish. Combine remaining 2 tablespoons sugar and cinnamon in a small bowl; sprinkle over casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until casserole is slightly firmed and top has begun to turn golden brown, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
