  "ingredients": [
    "3 tablespoons olive oil",
    "1 clove garlic, minced",
    "1 large head broccoli",
    "0.25 teaspoon salt",
    "0.125 teaspoon pepper",
    "1 tablespoon balsamic vinegar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 475 degrees F (245 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine olive oil and garlic in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut broccoli into florets, leaving 2 to 3 inches of stem; spread on a rimmed baking sheet. Drizzle garlic oil over broccoli; toss to coat. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until broccoli is tender and charred at edges, 7 to 9 minutes, flipping once. Transfer to a serving dish; drizzle with vinegar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
