  "ingredients": [
    "2 (6 ounce) cans crabmeat, drained and flaked",
    "11 ounces cream cheese, softened",
    "5 tablespoons mayonnaise",
    "1 small onion, finely chopped",
    "0.125 teaspoon garlic powder",
    "salt and pepper to taste",
    "1 (1 pound) loaf round, crusty Italian bread"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MjTgw2lDUMuhQrzrVcJOjYYz7W8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12799-crab-dip-ddmfs-step-1-f7d30ab686574efe8fe229bfa7aafcb4.jpg"
      ],
      "image": "assets/images/12799/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine crabmeat, cream cheese, mayonnaise, onion, garlic powder, salt, and pepper together in a medium bowl; spread mixture into a 1-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6urtlIOSKoU7xk8r33MB89y3Oi0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12799-crab-dip-ddmfs-step-2-c01aaa1d3d674c9dacd6d58323e4e884.jpg"
      ],
      "image": "assets/images/12799/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Meanwhile, cut a circle in the top of the bread; scoop out the inside to create a bread bowl. Tear the removed bread into pieces for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7s1mhIGIlvNFLZgmtcr4AqSLwIk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12799-crab-dip-ddmfs-step-3-b225cbf730904206b7916c32a52af2d2.jpg"
      ],
      "image": "assets/images/12799/step_04.webp"
    },
    {
      "text": "Stir baked crab dip and spoon into bread bowl. Place bread bowl and chunks of bread on a medium baking sheet; bake for an additional 10 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xnYmamao4qWa0_VkEEoF-7Fe-Ow=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12799-crab-dip-ddmfs-step-4-e42da8452409411491352b3684de0d26.jpg"
      ],
      "image": "assets/images/12799/step_05.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eZV0mDxPZB5er1SuJRUsxTaGE7Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12799-crab-dip-ddmfs-beauty-3x4-59a075f1b62248e9a7ea63d7dcfa48cf.jpg"
