  "ingredients": [
    "1 cup raw cashews",
    "7 tablespoons water",
    "2 teaspoons fresh lemon juice",
    "2 teaspoons rice vinegar",
    "0.5 teaspoon kosher salt"
  ],
  "steps": [
    {
      "text": "Place cashews in a bowl and cover with a few inches of water. Let soak until soft, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain and rinse cashews; transfer to a high-powered blender. Add 4 tablespoons water, lemon juice, vinegar, and salt. Blend until cashews are finely ground. Scrape down the sides of the blender and add remaining water; blend until very smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cashew cream to a jar with a tight-fitting lid and store in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
