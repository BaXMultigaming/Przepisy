  "ingredients": [
    "1 cup milk",
    "1 tablespoon powdered peanut butter (such as PB2®)",
    "1 tablespoon sugar-free peanut butter-flavored syrup (such as Torani®)",
    "ice",
    "0.25 cup boiling water",
    "1 tablespoon instant coffee granules",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Mix milk, peanut butter powder, and peanut butter syrup in a bowl, stirring until peanut butter powder is dissolved. Fill a large glass with ice. Pour in the milk mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine boiling water, coffee granules, and sugar in a tall container. Whip with an immersion blender or a hand mixer until foamy, about 2 minutes. Pour coffee foam over the milk mixture.",
