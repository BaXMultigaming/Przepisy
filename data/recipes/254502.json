  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup white sugar",
    "1 (10 ounce) package frozen strawberries in juice, thawed",
    "0.5 cup crushed pineapple, drained",
    "1 (8 ounce) container frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Combine cream cheese and sugar in a bowl; add strawberries and pineapple. Fold in the whipped topping.",
      "section": null,
