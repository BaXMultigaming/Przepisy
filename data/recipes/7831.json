  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup sourdough starter",
    "1 cup white sugar",
    "0.66666698455811 cup vegetable oil",
    "3 large eggs",
    "1.5 teaspoons baking powder",
    "2 teaspoons vanilla extract",
    "0.25 teaspoon salt",
    "1 cup chopped walnuts",
    "0.25 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sourdough starter, sugar, oil, eggs, baking powder, vanilla, and salt together in a bowl. Stir in chopped walnuts. Stir in baking soda and pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 45 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
