  "ingredients": [
    "3 eggs",
    "3 tablespoons milk",
    "2 tablespoons butter",
    "2 potatoes, cubed",
    "0.5 cup cubed fully cooked ham",
    "0.25 cup chopped onion",
    "1.5 teaspoons minced garlic",
    "0.25 cup water, or as needed",
    "salt and ground black pepper to taste",
    "0.25 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source; preheat the broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and milk in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large, oven-proof skillet over medium heat; cook and stir potatoes, ham, onion, and garlic in melted butter until potatoes are tender, about 15 minutes. Add water if vegetables become dry. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour egg mixture over vegetable mixture. Cook, without stirring, until eggs are slightly browned on the bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until eggs are nearly set, about 5 minutes. Sprinkle Cheddar cheese over eggs and continue broiling until frittata is completely set and cheese is melted, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
