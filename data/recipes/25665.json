  "ingredients": [
    "9 baking potatoes",
    "0.66666668653488 cup butter",
    "0.66666668653488 cup all-purpose flour",
    "6 cups whole milk",
    "0.5 tablespoon salt",
    "1 teaspoon ground black pepper",
    "0.5 cup bacon bits, divided",
    "4 green onions, chopped",
    "10 ounces shredded Cheddar cheese",
    "1 (8 ounce) container sour cream"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MX1AOZQka48Nk7cZ0w_UcHk1bUY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25665-baked-potato-soup-v-VAT-step-01-bda5615deb454982b5f30d8fd4406ba7.jpg"
      ],
      "image": "assets/images/25665/step_01.webp"
    },
    {
      "text": "Prick potatoes with a fork and cook in the microwave, 3 or 4 at a time, until fork-tender, about 7 to 8 minutes. When cool enough to handle, scoop out the flesh.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gwj9icRq9PvQNjdwrBojDnEsmRg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25665-baked-potato-soup-v-VAT-step-02-b8ca0e78a20d4b50abd4e3a9c963330e.jpg"
      ],
      "image": "assets/images/25665/step_02.webp"
    },
    {
      "text": "Melt butter in a large saucepan over medium heat; stir in flour and cook until well combined, about a minute. Whisk in milk, a little at a time, stirring constantly until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rg7oJassPWbPecjxy9enS4Mg28Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25665-baked-potato-soup-v-VAT-step-03-daded6a711d7441abae1328893d0df2c.jpg"
      ],
      "image": "assets/images/25665/step_03.webp"
    },
    {
      "text": "Stir in cooked potatoes, salt, pepper, 1/3 cup bacon bits, 2 tablespoons green onions and most of the cheese. Cook until thoroughly heated. Stir in sour cream and heat through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5K2s41EAq5oZDDUsmFkky6X4yNI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25665-baked-potato-soup-v-VAT-step-04-189e6bb6ecde4de2994082cb96c6c560.jpg"
      ],
      "image": "assets/images/25665/step_04.webp"
    },
    {
      "text": "Serve topped with remaining bacon, onions and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vHx7wiMGJqcKMyAvigX-pwAY6RY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25665-baked-potato-soup-v-VAT-step-05-1-fb64008b7e5e4513b3b4c443ca874bca.jpg"
      ],
      "image": "assets/images/25665/step_05.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
