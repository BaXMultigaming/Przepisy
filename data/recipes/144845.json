  "ingredients": [
    "1.5 pounds skinless, boneless halibut, cut into 1/2 inch cubes",
    "0.33333334326744 cup fresh lime juice",
    "0.25 cup fresh lemon juice",
    "0.25 cup tequila",
    "3 jalapeno chile peppers, seeded and minced",
    "1 mango - peeled, seeded and diced",
    "1 green bell pepper, seeded and finely chopped",
    "0.5 cup finely chopped Vidalia or other sweet onion",
    "0.5 cup finely chopped red onion",
    "0.5 bunch chopped fresh cilantro",
    "0.25 cup chopped fresh parsley",
    "1 teaspoon salt, or to taste"
  ],
  "steps": [
    {
      "text": "Combine cubed halibut, lime juice, lemon juice, tequila, minced jalapeño peppers, and 1 diced mango in a non-metallic bowl. Cover and refrigerate for 1 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "After the ceviche has sat for 1 ½ hours, add green pepper, sweet onion, and red onion. Mix well, then cover and refrigerate for another 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold in the remaining diced mango, cilantro, and parsley; season to taste with salt before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
