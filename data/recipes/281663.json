  "ingredients": [
    "1 tablespoon olive oil",
    "0.25 cup diced red onion",
    "1.5 cups peeled and diced sweet potatoes",
    "1 teaspoon minced garlic",
    "6 cups water",
    "0.5 cup diced ham",
    "2 cubes chicken bouillon",
    "2 cups broccoli florets",
    "1.5 cups dry elbow macaroni"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot or Dutch oven and cook onion until starting to soften, 2 to 3 minutes. Add sweet potato and garlic; cook until fragrant, about 1 minute. Add water, ham, and bouillon cubes; bring to a boil. Boil for 3 to 4 minutes. Add broccoli and until it reaches your desired tenderness, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of unsalted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain pasta and add to the soup. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
