  "ingredients": [
    "1 (12 ounce) package vanilla wafers",
    "2 (8 ounce) packages cream cheese",
    "0.75 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TJDsXzsRlJGScxzwIK5joMyiACk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7307-Mini-Cheescakes-ddmfs-step-1-174-5dfe3937e06b47d9b08d867c9fbcb902.jpg"
      ],
      "image": "assets/images/7307/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two 24-cup miniature muffin tins with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crush vanilla wafers in a food processor or resealable plastic bag until fine crumbs form. Press about ½ teaspoon crumbs into each paper liner.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rsu0cdtzHHFX7e30bKJxexEWGNs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7307-Mini-Cheescakes-ddmfs-step-3-176-c61f1c95c5494af3864c7ba00d6e06fa.jpg"
      ],
      "image": "assets/images/7307/step_03.webp"
    },
    {
      "text": "Beat cream cheese, sugar, eggs, and vanilla in a mixing bowl until light and fluffy. Fill each miniature muffin liner with this mixture, almost to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ePAEf-G6mPTpX0ttAQxf3NkqDhA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7307-Mini-Cheescakes-ddmfs-step-4-177-f68130de5a3a4cceafaebcb8fd2839a8.jpg"
      ],
      "image": "assets/images/7307/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 15 minutes until the cheesecake is set. Cool completely in the pan. Top each mini cheesecake with about a teaspoon of cherry pie filling before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lBY3jrKw6q1oBRJXpmFJGKsFty8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7307-Mini-Cheescakes-ddmfs-step-6-230-b8771bd61b6543ba965e03f0d3874b08.jpg"
      ],
      "image": "assets/images/7307/step_05.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0NBWpJhXU1mScrWYsnj0n1YRdqQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7307-Mini-Cheescakes-ddmfs-4x3-236-befa961645a0475a80b584d921d3c9fe.jpg"
      ],
