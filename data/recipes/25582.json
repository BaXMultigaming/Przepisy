  "ingredients": [
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "2 teaspoons baking soda",
    "6 tablespoons unsweetened cocoa",
    "1 cup vegetable oil",
    "2 tablespoons vinegar",
    "1 teaspoon vanilla",
    "2 cups water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, sift together the flour, sugar, baking soda and cocoa. Measure and combine water, oil, vinegar and vanilla. Pour liquid ingredients into flour mixture and beat until smooth. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 to 45 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
