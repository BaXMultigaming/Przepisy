  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 cup butter, softened",
    "0.375 cup white sugar",
    "1 pinch salt",
    "3 tablespoons Madeira wine",
    "1 egg",
    "0.33333334326744 cup white sugar for decoration"
  ],
  "steps": [
    {
      "text": "Sift together the flour and salt into a large bowl. Cream in the butter until mixture resembles fine breadcrumbs. Mix in the sugar and Madeira, until mixture becomes stiff. Wrap dough in foil or plastic, and refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a lightly floured surface, knead dough lightly until smooth. Roll out to approximately 1/8\" and prick all over with a fork. Cut dough into 36 fingers measuring 1 x 2 1/2 inches. Place on cookie sheets. In a small bowl, lightly beat the egg. Brush cookie fingers with the egg and sprinkle each with sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for about 15 minutes or until light golden in color. Let cool on wire racks. Store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
