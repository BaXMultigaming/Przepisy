  "title": "Pesto Spaghetti Squash",
  "description": "This pesto spaghetti squash, featuring onions, mushrooms, and kale, gets a cheesy boost from Parmesan for a hearty side or comforting vegetarian meal.",
  "authors": [
    "Shyla Lane"
  ],
  "date_published": "2013-02-19T16:44:45-05:00",
