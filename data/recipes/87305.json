  "ingredients": [
    "0.5 cup unpopped popcorn",
    "1 teaspoon vegetable oil",
    "0.5 teaspoon salt, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
