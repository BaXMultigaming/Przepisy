  "ingredients": [
    "2 cups ricotta cheese",
    "1 (8 ounce) package cream cheese, at room temperature",
    "1.5 cups confectioners' sugar",
    "1 teaspoon vanilla extract",
    "1 cup miniature semisweet chocolate chips"
  ],
