  "ingredients": [
    "2 cups dried split fava beans",
    "1 red onion, quartered",
    "0.5 cup fresh parsley",
    "0.5 cup fresh cilantro",
    "0.5 cup fresh dill",
    "3 cloves garlic",
    "1.5 teaspoons ground coriander",
    "1.5 teaspoons salt",
    "1 teaspoon ground cumin",
    "1 cup sesame seeds",
    "vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Place fava beans into large bowl and cover with several inches of water. Let soak, 8 hours to overnight. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soaked fava beans, red onion, parsley, cilantro, dill, garlic, coriander, salt, and cumin in a food processor; process to a dough-like consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium heat. Add sesame seeds; cook, stirring occasionally, until toasted, about 5 minutes. Transfer to a large plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape fava bean mixture into about 50 balls. Roll balls in sesame seeds to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large saucepan 1/4 full with oil; heat over medium heat. Fry fava bean balls in batches until golden brown, 3 to 5 minutes per batch. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
