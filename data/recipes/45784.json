  "ingredients": [
    "2 teaspoons butter",
    "6 mushrooms, coarsely chopped",
    "1 green onion, finely chopped",
    "1 clove garlic, minced",
    "2 cups chicken broth",
    "1 cup uncooked white rice",
    "0.5 teaspoon chopped fresh parsley",
    "salt and pepper to taste"
  ],
