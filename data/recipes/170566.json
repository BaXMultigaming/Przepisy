  "ingredients": [
    "0.25 cup orange juice",
    "0.25 cup soy sauce",
    "0.25 cup sesame oil",
    "1 teaspoon white sugar",
    "1 teaspoon minced garlic",
    "0.5 teaspoon ground ginger",
    "6 (4 ounce) fillets tilapia fillets"
  ],
  "steps": [
    {
      "text": "Stir the orange juice, soy sauce, sesame oil, sugar, garlic, and ginger in a 9x13 inch baking dish until combined. Add the tilapia fillets, turning once to evenly coat. Cover the dish with plastic wrap, and marinate in the refrigerator at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the plastic wrap, and bake in the preheated oven until the fish flakes easily with a fork, 9 to 11 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
