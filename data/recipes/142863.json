  "ingredients": [
    "1 whole coconut, shelled and drained",
    "1 cup water",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup white sugar",
    "1 tablespoon fresh lime juice"
  ],
  "steps": [
    {
      "text": "Chop the coconut meat into pieces about 1/2 inch square.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place water in a saucepan, and bring to a boil over medium-high heat. Stir in cinnamon and sugar until dissolved. Boil mixture until liquid reduces to a syrup consistency, then stir in coconut pieces. Add the lime juice, and turn off heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place spoonfuls of sugared coconut mixture into small paper cups. Cool in cups until hardened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
