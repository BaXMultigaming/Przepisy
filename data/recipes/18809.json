  "ingredients": [
    "1 (30 ounce) package frozen hash brown potatoes",
    "2 cups shredded Cheddar cheese",
    "1 (16 ounce) container sour cream",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "1 cup butter, divided",
    "1 onion, chopped",
    "3 cups crushed corn flakes"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eh4RxG1d2eAv01kEbxfpaW8QeOQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18809-potato-casserole-DDMFS-028-step-01-b15ca344345d4299984fcdcfe6f2f8a7.jpg"
      ],
      "image": "assets/images/18809/step_01.webp"
    },
    {
      "text": "Pour hash browns into the prepared dish; set aside. Combine cheese, sour cream, and condensed soup in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XHIPwfyLNga4SbVNK1DramuYZ9E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18809-potato-casserole-DDMFS-029-step-02-4181591c6c3f4056a33b9e5608ff3a63.jpg"
      ],
      "image": "assets/images/18809/step_02.webp"
    },
    {
      "text": "Melt 1/2 cup butter in a large skillet over medium heat; sauté onion in hot butter for 5 minutes. Add to cheese mixture and mix until combined. Spread over hash browns in the dish. Sprinkle with cornflakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BzXXEHVQjs7Q9V7tPQVIc-s5DxE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18809-potato-casserole-DDMFS-031-step-03-1d035c76f5044d8eb796a0094a895cce.jpg"
      ],
      "image": "assets/images/18809/step_03.webp"
    },
    {
      "text": "Melt remaining 1/2 cup butter in the skillet over medium heat and pour over cornflakes. Bake in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xAogCWqGXloeF_7ZA9_sJJXdDAo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18809-potato-casserole-DDMFS-032-step-04-a465a09ae7484fada17224dffb8f64b0.jpg"
      ],
      "image": "assets/images/18809/step_04.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PiRJQA34lq4jgPShtY5IGGxFCWk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18809-potato-casserole-DDMFS-094-4x3-3307ca75643b4b8582d378670246b0bf.jpg"
