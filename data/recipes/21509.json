  "ingredients": [
    "2.5 pounds pork shoulder",
    "2 cups ketchup",
    "0.5 cup chopped onion",
    "0.25 cup Worcestershire sauce",
    "0.25 cup brown sugar",
    "1 clove garlic, minced",
    "1 teaspoon dry mustard",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Cut pork shoulder crosswise into 1/4-inch slices. (Partially freezing it first will make slicing it easier.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slow Cooker Method: Combine sliced pork, ketchup, onion, Worcestershire sauce, brown sugar, garlic, dry mustard, salt, and black pepper in a slow cooker; cover. Cook on Low, stirring occasionally, until meat is tender, 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dutch Oven Method: Combine sliced pork, ketchup, onion, Worcestershire sauce, brown sugar, garlic, dry mustard, salt, and black pepper in a Dutch oven or large saucepan. Bring to a boil, reduce heat, and cover. Simmer, stirring occasionally, until pork is tender, 2 1/2 to 3 hours.",
      "section": null,
