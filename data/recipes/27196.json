  "title": "Double Chocolate Chip Macadamia Cookies",
  "description": "We love chocolate chip cookies at our house, and these are especially good!! I use a 1 inch scoop to form the cookies.",
  "authors": [
    "Bonnie"
  ],
  "date_published": "2020-06-18T23:07:07-04:00",
