  "ingredients": [
    "5 boneless, skinless chicken breasts",
    "2 (6 ounce) cans black olives, drained",
    "1 (16 ounce) jar salsa",
    "24 (6 inch) flour tortillas",
    "0.25 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Boil chicken breasts for 20 minutes or until they are thoroughly cooked. Drain breasts well and let cool. Use an electric food processor or manually shred the chicken and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use an electric food processor or blender to puree the olives. In a mixing bowl, combine salsa, olives, and chicken. Heat tortillas in microwave for about 20 to 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 to 2 tablespoons of the chicken mixture into the center of each warmed tortilla and roll the tortillas tightly, using toothpicks to keep them closed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in skillet over a high heat. When the oil is hot, place the rolled taco into the oil and deep fry until lightly browned. Drain on paper towels and serve.",
      "section": null,
      "name": null,
      "url": null,
