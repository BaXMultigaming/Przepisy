  "ingredients": [
    "1 egg",
    "2 tablespoons water",
    "1 pound uncooked shrimp, peeled and deveined",
    "1 cup panko bread crumbs",
    "4 tablespoons oil, divided",
    "2 tablespoons butter",
    "1 lime, juiced"
  ],
  "steps": [
    {
      "text": "Mix egg and water together to make a light egg wash. Place breadcrumbs in a shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip shrimp into the egg wash and toss into breadcrumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 2 tablespoons oil in a pan over medium heat. Add shrimp and fry until firm and opaque, 4 to 6 minutes. Remove shrimp and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse out the pan. Heat butter and remaining 2 tablespoons oil in the pan. Add lime juice; bring to a boil. Continue boiling for 1 minute. Return cooked shrimp to the pan and stir to coat with the lime sauce. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
