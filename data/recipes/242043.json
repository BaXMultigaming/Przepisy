  "ingredients": [
    "1 tablespoon olive oil, or as needed",
    "1 small eggplant, halved lengthwise and sliced",
    "2 (6 inch) whole-grain sandwich rolls, split",
    "0.25 cup Greek yogurt",
    "1 tablespoon garlic-and-herb spreadable cheese (such as Boursin®)",
    "2 cloves garlic, minced",
    "1 Roma (plum) tomato, sliced",
    "0.25 cup chopped fresh basil leaves"
  ],
  "steps": [
    {
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush olive oil over both sides of each eggplant slice. Arrange eggplant slices onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook eggplant slices under the broiler until tender and lightly browned, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast split rolls under the broiler, cut sides up, until lightly browned, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir yogurt, cheese, and garlic together in a small bowl until smooth; spread onto the rolls. Divide eggplant slices between the rolls; add tomato slices and basil to complete sandwiches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
