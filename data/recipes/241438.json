  "ingredients": [
    "0.25 cup plain Greek yogurt",
    "0.5 lemon, juiced",
    "1 clove garlic, minced",
    "0.25 cup olive oil",
    "1 teaspoon Sriracha hot sauce, or more to taste",
    "0.5 cup crumbled feta cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Mix yogurt, lemon juice, and garlic together in a bowl. Slowly pour olive oil in a fine stream into yogurt mixture while constantly mixing with a whisk or in a food processor. Whisk Sriracha hot sauce into yogurt mixture; fold in feta cheese. Season dressing with salt and pepper.",
