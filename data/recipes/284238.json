  "ingredients": [
    "1 (16 ounce) package egg noodles",
    "2 tablespoons canola oil",
    "0.66666668653488 cup dry-roasted peanuts",
    "6 tablespoons low-sodium soy sauce",
    "2 tablespoons sambal oelek (chile paste)",
    "2 teaspoons white sugar",
    "5 cloves garlic, peeled",
    "1 (1 inch) piece fresh ginger, peeled",
    "8 ounces ground pork",
    "0.125 teaspoon salt",
    "1.25 cups cucumber - peeled, seeded, and chopped",
    "0.75 cup thinly sliced green onion",
    "0.33333334326744 cup chopped fresh cilantro",
    "3 tablespoons lime juice"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YH1dwIYH00_bTghe7eZi2cx4-QU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/284238-dan-dan-noodles-VAT-step-01-86a81559cd1e425a8b3f014e372dade6.jpg"
      ],
      "image": "assets/images/284238/step_01.webp"
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes. Drain in a colander over a bowl, reserving 3/4 cup cooking liquid. Place noodles in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IIsYSMgKLNfqk5CkgKUexy9t_oA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/284238-dan-dan-noodles-VAT-step-02-a8eab069367e424a81c510535997529a.jpg"
      ],
      "image": "assets/images/284238/step_02.webp"
    },
    {
      "text": "Heat oil in a large wok over medium-high heat. Add peanuts to pan; saute until fragrant, about 2 minutes. Remove from heat; cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e_MxXffLMbiKUVlLkuzsHoNka84=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/284238-dan-dan-noodles-VAT-step-03-62280842a50541528789538b7a70bd8d.jpg"
      ],
      "image": "assets/images/284238/step_03.webp"
    },
    {
      "text": "Combine peanuts, soy sauce, sambal oelek, sugar, garlic, and ginger in a mini food chopper; process until finely ground.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oSBZPAPTqjQ63u_jniipKCLUNJY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/284238-dan-dan-noodles-VAT-step-04-69197644ac60409f98b6bb98138a4d74.jpg"
      ],
      "image": "assets/images/284238/step_04.webp"
    },
    {
      "text": "Cook pork and salt in a wok over medium-high heat until no longer pink, stirring to crumble, about 8 minutes. Add peanut mixture and 3/4 cup cooking liquid to pork; bring to a boil. Cook for 1 minute, stirring frequently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n63EXkjaHT2_1QcD737zbgfMuU4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/284238-dan-dan-noodles-VAT-step-05-6700362aca2e448fb68d76f6226dfdfb.jpg"
      ],
      "image": "assets/images/284238/step_05.webp"
    },
    {
      "text": "Add pork mixture, cucumber, green onions, cilantro, and lime juice to noodles; toss well. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0s1beFLcJMqdRpN9ORYSsMepbHc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/284238-dan-dan-noodles-VAT-step-06-60d13690657646b0a54361ce95dc5dab.jpg"
      ],
      "image": "assets/images/284238/step_06.webp"
    }
  ],
