  "ingredients": [
    "1 pound ground pork sausage",
    "2 cups diced celery",
    "2 large onions, chopped",
    "5 cups crumbled cornbread",
    "5 cups seasoned bread crumbs",
    "2.75 cups chicken broth",
    "1.5 teaspoons poultry seasoning",
    "1 teaspoon dried sage, crushed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sausage, celery, and onions in a large, deep skillet over medium-high heat. Cook, stirring often and breaking sausage up with a spoon, until sausage is evenly browned and crumbly and vegetables are translucent, 7 to 10 minutes. Remove from the heat and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer sausage mixture to a large bowl. Add crumbled cornbread, bread crumbs, chicken broth, poultry seasoning, and sage. Mix until well combined, then transfer to a 9x13-inch baking dish. Cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until stuffing is well set and cooked through, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
