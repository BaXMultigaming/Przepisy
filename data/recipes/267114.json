  "ingredients": [
    "2 tablespoons butter, softened",
    "1 clove garlic, minced",
    "2 naan breads",
    "salt and ground black pepper to taste",
    "0.66666668653488 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and garlic in a bowl and mix thoroughly. Spread butter mixture over 1 side of each bread and place on a baking sheet. Sprinkle with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce grill heat to low and place bread, butter-side down, onto grill. Cook until grill marks appear, about 2 minutes, moving bread around every 15 to 20 seconds and watching for flare-ups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn bread over and sprinkle evenly with mozzarella cheese. Close grill and cook until cheese is melted, 1 to 2 minutes more. Transfer to a baking sheet, cut each bread into quarters, and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
