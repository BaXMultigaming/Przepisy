  "steps": [
    {
      "text": "Place eggs in a saucepan and cover with water. Bring to a boil, remove from heat, and let eggs stand in hot water for 15 minutes. Remove eggs from hot water, cool under cold running water, and peel. Chop eggs and transfer to a salad bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash avocado in a separate bowl using a fork. Mix mashed avocado, yellow mustard, and paprika into eggs until thoroughly combined. Season with salt and black pepper.",
