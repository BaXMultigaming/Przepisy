  "title": "Cream of Potato Soup",
  "description": "Celery and carrot flavor the stock of this tasty puréed potato soup made easy with a can of evaporated milk. Serve garnished with chopped chives.",
  "authors": [
    "Karen Wood"
  ],
  "date_published": "1999-01-30T21:45:05-05:00",
