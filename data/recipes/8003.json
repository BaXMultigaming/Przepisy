  "ingredients": [
    "1 cup white sugar",
    "0.33329999446869 cup butter",
    "1 cup yogurt",
    "1.5 cups all-purpose flour",
    "3 eggs",
    "0.25 teaspoon vanilla extract",
    "2 teaspoons baking powder",
    "12 (1.5 ounce) bars milk chocolate candy",
    "2 cups cream cheese",
    "3 eggs",
    "0.25 teaspoon vanilla extract",
    "0.75 cup white sugar",
    "0.25 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Oil and flour a deep 9-inch round pan or springform.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and 1 cup sugar in a large bowl; beat in 3 eggs and blend in yogurt. Combine flour and baking powder; add to the creamed mixture. Stir in 1/4 teaspoon vanilla. Melt 6 chocolate bars; blend into the batter. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until the cake tests done, for 30 minutes. Cool for 10 minutes in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut a hole in the center of the cake that does not go all the way through the cake. Melt another 6 sweet chocolate bars, and pour into the hole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, 3 eggs, 1/4 teaspoon vanilla, and 3/4 cup sugar together until smooth; pour over cake. Bake for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle confectioners' sugar on the top of the cake; return to oven and bake until the sugar melts and browns. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
