  "title": "Muddy Chocolate Cake",
  "description": "This muddy chocolate cake has a hole in its center that is filled with melted chocolate, which is how the recipe gets its name. It&#39;s best served hot.",
  "authors": [
    "Murooj Ibraheem"
  ],
  "date_published": "1998-07-02T04:34:11-04:00",
