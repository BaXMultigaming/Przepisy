  "ingredients": [
    "1 tablespoon butter",
    "12 eggs, well beaten",
    "2 (8 ounce) cans refrigerated crescent rolls",
    "1 (.9 ounce) package hollandaise sauce mix",
    "0.66666668653488 cup milk",
    "0.25 cup butter",
    "3 cups diced cooked ham",
    "1 cup shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a nonstick skillet over medium heat. Pour in beaten eggs; cook in hot butter to desired degree of doneness, stirring constantly. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll crescent dough and place rolls on an ungreased 12-inch pizza pan with points facing the center. Press seams together and press up sides of the pan to form a crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare Hollandaise sauce according to the package directions using 2/3 cup milk and 1/4 cup butter. Pour sauce evenly over crescent roll crust. Spread scrambled eggs evenly over sauce, then top with diced ham. Sprinkle with cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bottom of crust is lightly browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
