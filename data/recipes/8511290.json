  "ingredients": [
    "0.5 pound bacon",
    "3 pounds carrots, ends trimmed",
    "0.33 cup pecan-smoked pure maple syrup",
    "2 tablespoons pecan oil",
    "0.5 pound butter",
    "0.5 teaspoon cinnamon (such as Supreme Saigon®)",
    "salt to taste",
    "cayenne pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine maple syrup, pecan oil, melted butter, and cinnamon in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut carrots in half lengthwise. Then cut carrots into 4-inch long pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place carrots in a baking dish and pour maple syrup mixture over them. Toss until well coated. Cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tender, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place bacon in a large heavy skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on a rimmed drop tray. Allow to cool until easy to handle and chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove carrots from oven, discard foil, and sprinkle cooked chopped bacon over carrots. Season with salt and cayenne pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
