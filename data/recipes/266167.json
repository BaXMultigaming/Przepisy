  "ingredients": [
    "1.5 pounds ground beef",
    "1 medium onion, chopped",
    "1 (8 ounce) can tomato sauce, divided",
    "0.5 cup bread crumbs",
    "1 egg",
    "2 cloves garlic, minced",
    "1 teaspoon dried oregano, divided",
    "1 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1.5 cups shredded mozzarella cheese",
    "2 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix beef, onion, 1/2 of the tomato sauce, bread crumbs, egg, garlic, 1/2 teaspoon oregano, salt, and pepper in a large bowl. Pat into a 1/2-inch-thick rectangle on a sheet of waxed paper. Sprinkle mozzarella cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lift up the short side of the waxed paper to start rolling up the meatloaf. Roll tightly, peeling back paper as you go. Seal edges in place. Transfer meatloaf to a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Combine remaining tomato sauce and 1/2 teaspoon oregano; pour over meatloaf and sprinkle with Parmesan cheese. Bake until cheese is melted, about 15 minutes more. Let stand for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
