  "ingredients": [
    "0.5 cup plain yogurt",
    "0.25 cup mayonnaise",
    "1 tablespoon curry powder",
    "0.5 pound shredded cooked chicken breast",
    "1 medium apple, peeled and diced",
    "2 stalks celery, diced",
    "1 stalk green onion, finely chopped, or more to taste",
    "0.5 cup sliced almonds",
    "0.25 cup raisins",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Whisk yogurt and mayonnaise together in a medium bowl until blended. Add curry powder and stir to combine. Stir in shredded chicken until evenly coated. Add apple, celery, green onion, almonds, and raisins; season with salt and pepper. Stir gently to until thoroughly combined and all ingredients are coated with curry-yogurt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve immediately or refrigerate until ready to serve.",
