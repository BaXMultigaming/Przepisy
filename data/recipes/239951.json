  "ingredients": [
    "1 pound ground turkey",
    "0.5 cup Italian bread crumbs",
    "0.25 cup thinly sliced baby spinach",
    "1 large egg",
    "2 tablespoons onion powder",
    "2 tablespoons garlic powder"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OdJpQXzURFSOPOZdNNa3YIxpEnE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-239951-baked-turkey-meatballs-dmfs-step-1-cc1a7f3013984ea283a39efd146ddb1e.jpg"
      ],
      "image": "assets/images/239951/step_01.webp"
    },
    {
      "text": "Mix turkey, bread crumbs, spinach, egg, onion powder, and garlic powder together in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HhqizFvzAE-YdZCyqFRtwfLXK4c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-239951-baked-turkey-meatballs-dmfs-step-2-1a463f210ce04fc59ba1cc1f262bf632.jpg"
      ],
      "image": "assets/images/239951/step_02.webp"
    },
    {
      "text": "Roll mixture into eight palm-sized meatballs and place 2 inches apart on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vHn8z8iX66hysmB8f5Spv1gwvTo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-239951-baked-turkey-meatballs-dmfs-step-3-01280cabdb734aec8cbeac58d388b888.jpg"
      ],
      "image": "assets/images/239951/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center and the outside is browned, 15 to 20 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
