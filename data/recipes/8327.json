  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "0.75 cup unsweetened cocoa powder",
    "2 teaspoons baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "2 eggs",
    "1 cup strong brewed coffee",
    "1 cup milk",
    "0.5 cup vegetable oil",
    "2 teaspoons vanilla extract",
    "1 (10 ounce) jar maraschino cherries, drained",
    "2 cups miniature semisweet chocolate chips",
    "0.5 cup butter, softened",
    "4 cups confectioners' sugar",
    "0.5 teaspoon salt",
    "2 tablespoons vanilla extract",
    "4 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix flour, sugar, cocoa, baking powder, soda and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add eggs, coffee, milk, oil and vanilla. Beat until smooth (batter will be thin).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold in cherries and chocolate chips. Pour batter into 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 35 minutes or until toothpick inserted into middle comes out clean. It's best to leave it in the pan, because the chips and the cherries sort of sink to the bottom and solidify and will stick big time! Frost with white buttercream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the frosting: In a large bowl, combine butter, confectioners sugar, 1/2 teaspoon salt and vanilla. Cream with an electric mixer. Add milk by the tablespoon until frosting is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
