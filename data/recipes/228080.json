  "ingredients": [
    "1 pound ground pork",
    "2 teaspoons finely chopped fresh sage leaves",
    "1 teaspoon finely chopped fresh thyme",
    "1 teaspoon kosher salt",
    "0.75 teaspoon ground black pepper",
    "0.25 teaspoon chopped fresh rosemary",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Mix ground pork, sage, thyme, salt, pepper, rosemary, nutmeg, cayenne pepper, and red pepper flakes in a bowl with your hands until thoroughly combined. Form into 8 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, cook patties in a large skillet over medium heat until browned, 8 to 10 minutes. Flip patties and continue to cook until browned on the other side, 5 to 8 more minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
