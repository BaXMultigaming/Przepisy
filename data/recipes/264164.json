  "ingredients": [
    "0.33333334326744 cup honey",
    "0.33333334326744 cup thinly sliced green onions",
    "2 tablespoons soy sauce",
    "2 teaspoons sesame seeds",
    "1 teaspoon minced garlic",
    "1 teaspoon minced onion",
    "0.75 teaspoon ground ginger",
    "0.5 teaspoon crushed red pepper flakes, or more to taste",
    "0.5 teaspoon red pepper flakes, or more to taste",
