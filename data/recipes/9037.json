  "title": "Smoky Mountain Chicken",
  "description": "This deluxe oven barbecue adds layers of ham and cheese atop chicken breasts, then drenches the whole affair in your favorite barbecue sauce.",
  "authors": [
    "Kellie Ledford"
  ],
  "date_published": "1999-05-08T15:38:29-04:00",
