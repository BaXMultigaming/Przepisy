  "ingredients": [
    "6 tablespoons water",
    "2 tablespoons ground flax seeds",
    "1 cup all-purpose flour",
    "1 cup whole wheat flour",
    "2 teaspoons baking soda",
    "1.5 cups grated carrots",
    "1.5 cups finely chopped apples",
    "1 teaspoon kosher salt",
    "0.75 cup unsweetened applesauce",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "0.5 cup olive oil",
    "2 large eggs",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 20 muffin cups, or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix water and flax seeds together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir all-purpose flour, whole wheat flour, baking soda, and salt together in a large bowl. Add carrots and chopped apples; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir applesauce, white sugar, brown sugar, olive oil, eggs, walnuts, and flax seed mixture into the flour mixture. Mix until batter is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into prepared muffin cups, filling each cup about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and the tops spring back when lightly pressed, about 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
