  "ingredients": [
    "3 cups apples - peeled, cored and diced",
    "10 slices bread, cubed",
    "0.75 cup brown sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.125 teaspoon salt",
    "0.5 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Place apples in a slow cooker.",
