  "ingredients": [
    "0.5 pound whole pork belly, skin removed",
    "0.5 teaspoon smoked paprika, or to taste",
    "kosher salt and ground black pepper to taste",
    "1 tablespoon olive oil, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 200 degrees F (95 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season pork belly all over with smoked paprika, salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n2logDtV-MxHo0qNU8ym5sHzsak=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240136_crispyporkbelly_ddmf_4x3_step_01_JD_5420-28674097b7b84bcf9d3455afc2bb1786.jpg"
      ],
      "image": "assets/images/240136/step_02.webp"
    },
    {
      "text": "Wrap pork in parchment paper; wrap a second time in aluminum foil; wrap a third time in another sheet of aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CgQdiFskwhgjW63rl-Vao5rEc9Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240136_crispyporkbelly_ddmf_4x3_step_02_JD_5421-79225c9fbc7b415f83e1a3a5e6cbb8f7.jpg"
      ],
      "image": "assets/images/240136/step_03.webp"
    },
    {
      "text": "Place pork packet in a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OuLxUAT1bzAZ8BvzjoXOousMoKk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240136_crispyporkbelly_ddmf_4x3_step_03_JD_5436-5b3810ebfa134afeb5ed6af804922df4.jpg"
      ],
      "image": "assets/images/240136/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until tender, about 6 hours. Let cool in wrappings to room temperature; place cooled packet in the refrigerator and chill for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unwrap chilled pork; reserve any rendered fat that falls away when unwrapping pork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut pork into 6 equal portions. Cut 1/8x1/8-inch slashes in the fat-side of pork. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UIGc6-4GKZLBzfhP7RcXuwa4jt0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240136_crispyporkbelly_ddmf_4x3_step_04_JD_5424-a4d0baeeb6e4482b9b8d272123950919.jpg"
      ],
      "image": "assets/images/240136/step_07.webp"
    },
    {
      "text": "Heat 2 tablespoons reserved pork fat in a skillet over medium heat. Place pork belly, fat-side down, in hot fat; cook until browned on all sides and heated through, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/INYVlgjR5Hmbjv3sGEu1khC-Gdw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240136_crispyporkbelly_ddmf_4x3_step_05_JD_5430-77c3244346ce460d99ecf395c41fa444.jpg"
      ],
      "image": "assets/images/240136/step_08.webp"
    },
    {
      "text": "Transfer pork belly to a plate, drizzle with olive oil, and season with pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6TZuoLSZoWT3CRKRzgy5dT9kfeg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240136_crispyporkbelly_ddmf_01_4x3_JD_5459-0d20503c620649bc97f2299792cc3a86.jpg"
