  "ingredients": [
    "2 cups penne pasta",
    "0.66666668653488 cup extra-virgin olive oil",
    "0.25 cup red wine vinegar",
    "2 cloves garlic, crushed",
    "1 tablespoon lemon juice",
    "2 teaspoons dried oregano",
    "salt and pepper to taste",
    "10 cherry tomatoes, halved",
    "1 green bell pepper, chopped",
    "1 red bell pepper, chopped",
    "1 small red onion, chopped",
    "0.5 cucumber, sliced",
    "0.5 cup sliced black olives",
    "0.5 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TbPr_PRzLVVabVnplJEmUnaWSsE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/176650-greek-pasta-salad-ddmfs-4x3-01-fa8d29fef67f445984c95b833d78e424.jpg"
      ],
      "image": "assets/images/176650/step_01.webp"
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in penne and return to a boil. Cook pasta uncovered, stirring occasionally, until tender yet firm to the bite, about 10 minutes; rinse with cold water and drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pQWREik6IcDaLGzeCCACrsRjhUY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/176650-greek-pasta-salad-ddmfs-4x3-02-7d82b27e9bea4039a2ebc114083799fb.jpg"
      ],
      "image": "assets/images/176650/step_02.webp"
    },
    {
      "text": "Whisk olive oil, vinegar, garlic, lemon juice, oregano, salt, and pepper together in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TpbgMGGWhUrHaSZF97Y6-oG3OU0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/176650-greek-pasta-salad-ddmfs-4x3-03-496fe51a58f74f2da2fb17d4959986d0.jpg"
      ],
      "image": "assets/images/176650/step_03.webp"
    },
    {
      "text": "Combine pasta, tomatoes, green and red peppers, onion, cucumber, olives, and feta cheese in a large bowl. Pour vinaigrette over pasta mixture and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kX2g3sTWg42JoHyWIvHrwZ-4YGQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/176650-greek-pasta-salad-ddmfs-4x3-04-caf57274b8244a048f7ac2a2722f0ad8.jpg"
      ],
      "image": "assets/images/176650/step_04.webp"
    },
    {
      "text": "For best flavor, cover salad and chill in the refrigerator before serving to allow flavors to blend. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_b11haUR28NvN5_OK3A1uiFFpEo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/176650-greek-pasta-salad-ddmfs-hero-4x3-ceb96388442c46bc98f439a907439e71.jpg"
