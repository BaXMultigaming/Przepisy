  "ingredients": [
    "2 cups peanut oil, or as needed",
    "0.25 cup unsalted butter, melted",
    "2 tablespoons lemon pepper seasoning",
    "6 pearl onions",
    "16 chicken wings"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer or large saucepan at 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk butter and lemon pepper seasoning together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place onions in the preheated oil and cook until just beginning to brown, about 5 minutes. Remove and discard onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, cook wings in oil until crispy on the outside and cooked through, about 8 minutes. Remove wings to a paper towel-lined plate to drain excess oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss wings with lemon pepper mixture until completely coated. Return to paper towel-lined plate to drain excess liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
