  "ingredients": [
    "1 (20 ounce) can crushed pineapple, undrained",
    "3 tablespoons white sugar",
    "1 (6 ounce) package orange flavored Jell-O®",
    "2 cups buttermilk",
    "1 (8 ounce) container frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Mix pineapple and sugar together in a medium saucepan, and bring to a low boil, stirring occasionally. Stir in gelatin until completely dissolved, remove from heat, and cool to room temperature. Add buttermilk, and refrigerate 1 hour, or until partially set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently fold in whipped topping. Pour mixture into a lightly oiled gelatin mold. Refrigerate 8 hours, or until completely set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
