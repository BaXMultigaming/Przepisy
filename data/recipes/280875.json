  "ingredients": [
    "1.5 cups crushed graham crackers",
    "0.5 cup white sugar",
    "6 tablespoons unsalted butter, melted",
    "1 cup boiling water",
    "1 (3 ounce) package lemon-flavored gelatin mix (such as Jell-O®)",
    "1 (14 ounce) can chilled sweetened condensed milk",
    "1 (8 ounce) package cream cheese, at room temperature",
    "1 large lemon, zested and juiced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham cracker crumbs, sugar, and melted butter in a bowl. Mix until evenly moistened; press into the bottom of a 9-inch pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 8 to 10 minutes. Remove and let cool, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine boiling water and gelatin powder. Let dissolve and cool, 15 to 20 minutes. Do not let set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooled gelatin mixture, condensed milk, cream cheese, and lemon zest and juice in a bowl; beat until well mixed, 3 to 4 minutes. Pour filling into cooled crust; refrigerate until set, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
