  "ingredients": [
    "1.25 cups coconut oil",
    "0.5 cup firmly packed brown sugar",
    "0.5 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.5 cups whole wheat flour",
    "1 teaspoon baking soda",
    "1 teaspoon coarse salt",
    "3 cups quick-cooking Irish oatmeal (such as McCann's®)",
    "1 egg, beaten",
    "0.5 cup golden raisins",
    "0.5 cup chopped almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease 18 muffin cups with coconut oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat coconut oil, brown sugar, and white sugar with an electric mixer in a large bowl until smooth. Mix in the flour mixture until just incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 egg and vanilla extract into the coconut oil mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, and coarse salt together in a bowl; beat into the coconut oil mixture until a dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold oatmeal, raisins, and almonds into dough. Mix beaten egg into dough if needed for moisture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon dough into prepared muffin cups to about half full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until center is set and top is lightly browned, 12 to 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
