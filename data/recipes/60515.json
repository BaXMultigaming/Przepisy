  "ingredients": [
    "3 cups vegetable oil for frying",
    "1 pound okra, finely chopped",
    "1 cup finely chopped onion",
    "0.5 cup water",
    "1 egg",
    "1 teaspoon salt",
    "0.25 teaspoon pepper",
    "0.5 cup all-purpose flour",
    "0.5 cup cornmeal",
    "1 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Heat 1 inch oil in a large skillet over medium-high heat to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix okra, onion, water, egg, salt, and pepper together in a large bowl. Combine flour, cornmeal, and baking powder in a small bowl: add to okra mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lower spoonfuls of okra batter carefully into the hot oil in batches. Fry on each side until golden, about 2 minutes per side. Transfer to a paper towel-lined plate to drain. Repeat with remaining okra batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
