  "ingredients": [
    "1 pound extra-lean ground beef",
    "1 green bell pepper, diced",
    "1 bunch green onions, diced",
    "4 ounces sliced fresh mushrooms",
    "4 ounces saltine crackers, finely crushed",
    "2 eggs",
    "1 (1.25 ounce) package beef with onion soup mix",
    "1.5 cups ketchup",
    "1 tablespoon yellow mustard",
    "2 teaspoons brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, combine the ground beef, green pepper, green onion, mushrooms and saltine crackers. Stir in the eggs and the beef with onion soup mix; mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press mixture into a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small mixing bowl, whisk together the ketchup, yellow mustard and brown sugar. Mix thoroughly and pour over the meat mixture, spreading evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
