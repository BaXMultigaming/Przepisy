  "ingredients": [
    "1 tablespoon chopped fresh basil",
    "1 tablespoon chopped fresh thyme",
    "1 tablespoon chopped fresh parsley",
    "1 tablespoon chopped fresh cilantro",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon cayenne pepper",
    "0.25 teaspoon garlic powder",
    "2 cups cold, cooked white rice",
    "1 (14 ounce) can black beans, rinsed and drained",
    "2 celery stalks, finely chopped",
    "1 (4 ounce) can chopped black olives",
    "3 green onions, chopped",
    "0.25 cup red wine vinegar",
    "0.25 cup extra-virgin olive oil"
  ],
  "steps": [
    {
      "text": "Make a seasoning by mixing together the basil, thyme, parsley, cilantro, salt, pepper, cayenne pepper, and garlic powder in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently mix together the rice, black beans, celery, olives, and green onions in a large bowl. Season the rice mixture with 1 teaspoon of the seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make a dressing by whisking the vinegar and olive oil with the seasoning; allow to rest for 10 minutes. Pour the dressing over the rice mixture; stir to combine.",
