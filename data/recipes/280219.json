  "steps": [
    {
      "text": "Place tea leaves in a tea filter bag and secure.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour water into a pot and bring to a boil. Add tea bag and sugar. Return to a boil and stir until sugar has dissolved, about 3 minutes. Remove from heat and allow tea to steep for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Discard tea bag. Let tea cool to room temperature. Refrigerate for 3 to 4 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill 2 glasses 2/3 full of chilled tea. Slowly pour 1/4 cup coconut milk into each glass.",
