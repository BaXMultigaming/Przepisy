  "ingredients": [
    "1 cup warm water (110 degrees F/45 degrees C)",
    "1 tablespoon white sugar",
    "2.25 teaspoons active dry yeast",
    "3 tablespoons olive oil",
    "1 teaspoon salt",
    "2.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Stir water, sugar and yeast together until dissolved. Add the olive oil and the salt. Stir in the flour until well blended. Let dough rest for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat dough into pan or on to a pizza stone using fingers dipped in olive oil. If desired sprinkle basil, thyme or other seasonings on crust. Top with your favorite pizza toppings and bake for 15 to 20 minutes in a preheated 425 degree oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
