  "ingredients": [
    "4 slices bacon",
    "1 (16 ounce) can pork and beans",
    "0.5 cup chopped onion",
    "2 tablespoons brown sugar, or more to taste",
    "1 tablespoon Worcestershire sauce",
    "1 teaspoon prepared mustard"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain the bacon slices on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pork and beans, onion, brown sugar, Worcestershire sauce, and mustard in a 2-quart casserole dish. Chop drained bacon and stir into pork and beans mixture. Cover dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 90 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
