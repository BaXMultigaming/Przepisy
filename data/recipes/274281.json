  "ingredients": [
    "2 loaves white bread, crusts removed and slices quartered",
    "1 (8 ounce) package cream cheese, softened",
    "1 small onion, minced",
    "2 egg yolks",
    "1 teaspoon paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, onion, and egg yolks in a large bowl; beat with an electric mixer until blended. Spread cream cheese mixture evenly on bread and lightly sprinkle with paprika. Place on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese puffs start to slightly brown, 10 to 15 minutes.",
