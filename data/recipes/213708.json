  "ingredients": [
    "5 fresh tomatillos, husks removed",
    "4 serrano chile peppers, or to taste",
    "2 tablespoons chopped fresh cilantro",
    "1 ripe avocado - peeled, pitted, and quartered",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Blend tomatillos, serrano chile peppers, and cilantro in a blender until smooth. Add 1 avocado quarter and continue blending until avocado is fully incorporated into mixture; repeat with each piece of avocado. Season with salt; continue processing until smooth. Serve immediately.",
