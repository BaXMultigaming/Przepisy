  "ingredients": [
    "2.5 cups vegetable broth",
    "1 cup long grain rice",
    "2 tablespoons olive oil",
    "1 onion, chopped",
    "2 (15 ounce) cans black-eyed peas, rinsed and drained",
    "0.5 teaspoon Cajun seasoning"
  ],
  "steps": [
    {
      "text": "Bring broth and rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a pot over medium-high heat. Sauté onion in hot oil until translucent, 5 to 7 minutes. Stir cooked rice, black-eyed peas, and Cajun seasoning into onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the pot with a lid and cook until flavors blend, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
