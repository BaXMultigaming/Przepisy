  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "1 (8 ounce) package shredded sharp Cheddar cheese",
    "0.25 cup mayonnaise",
    "15 fresh jalapeno peppers, halved lengthwise and seeded",
    "2 eggs, beaten",
    "0.5 tablespoon milk",
    "1.5 cups crushed corn flake cereal"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a medium baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, Cheddar cheese, and mayonnaise in a medium bowl; stuff into jalapeño halves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and milk together in a small bowl. Place crushed corn flakes in a separate small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip 1 stuffed jalapeño half into egg mixture, letting excess drip back into the bowl. Press into crushed corn flakes to coat; place in a single layer on the prepared baking sheet. Repeat with remaining stuffed jalapeños.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is bubbly and lightly browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
