  "ingredients": [
    "2 large eggs, separated",
    "0.25 teaspoon cream of tartar",
    "2 tablespoons mashed avocado",
    "1 teaspoon everything bagel seasoning"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a baking sheet with parchment paper and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites and cream of tartar in a large bowl until stiff peaks form. Stir together mashed avocado and egg yolks. Gently fold into egg whites.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop 1/4 cupfuls of the mixture onto the prepared baking sheet, about 1 inch apart. Smooth out and sprinkle evenly with bagel seasoning",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bottom starts to brown and top is firm to the touch, 30 to 35 minutes. Let rest at least 30 minutes. Remove with a spatula.",
      "section": null,
      "name": null,
      "url": null,
