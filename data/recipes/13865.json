  "ingredients": [
    "1.5 cups vegetable oil",
    "2 cups white sugar",
    "4 eggs, beaten",
    "2 (4 ounce) jars carrot baby food",
    "2 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "1.5 teaspoons ground cinnamon",
    "0.5 cup chopped walnuts",
    "1 (8 ounce) package cream cheese",
    "0.25 pound butter, softened",
    "2 cups confectioners' sugar",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. (175 degrees C). Grease and flour two 8x11 inch pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together the oil, sugar, eggs and carrots. Combine the flour, baking soda, salt and cinnamon. Add to wet ingredients and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into pans and bake for 30 minutes. Remove from oven and allow to cool..",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together cream cheese and butter. Add powdered sugar and vanilla, mix until smooth. Spread frosting on cooled cakes and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
