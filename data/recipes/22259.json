  "title": "Mocha Cake V",
  "description": "This moist yellow cake is studded with chocolate chips and spiked with coffee liqueur. It's topped off with a simple chocolate glaze.",
  "authors": [
    "PIANOJEN8"
  ],
  "date_published": "2000-10-03T17:22:44-04:00",
