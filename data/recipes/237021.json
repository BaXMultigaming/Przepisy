  "ingredients": [
    "1.5 cups long-grain white rice",
    "1 (14 ounce) can coconut milk",
    "1.25 cups water",
    "1 teaspoon white sugar, or more to taste",
    "1 tablespoon shredded coconut, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
