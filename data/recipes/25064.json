  "ingredients": [
    "1 cup butter, softened",
    "0.75 cup white sugar",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "2.25 cups all-purpose flour",
    "0.5 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, sugar, and egg together in a medium bowl with an electric mixer until smooth. Stir in vanilla and almond extracts. Blend in flour, then use your hands to form a soft dough. Take about a teaspoon of dough at a time and roll into balls, logs, or “S” shapes. Place cookies 1 to 2 inches apart on the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 10 minutes. Allow cookies to cool completely before dusting with confectioners’ sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
