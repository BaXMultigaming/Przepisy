    },
    {
      "text": "Roll dough into 1-inch balls and place 2 inches apart on ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W9pUsTLywrq5G0hLq-JPliuK1KE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244614-3-ingredient-peanut-butter-cookies-step-03-4x3-fad707df3d68485f968eb884f4488e60.jpg"
