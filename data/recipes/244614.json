        "https://www.allrecipes.com/thmb/T6w2BryoL8sCP80CKDkKhfEvExY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244614-3-ingredient-peanut-butter-cookies-step-02-01-4x3-03046776a0c140e5832be07a6685d1d5.jpg"
