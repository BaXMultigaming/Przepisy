  "ingredients": [
    "2 tablespoons Sriracha sauce",
    "2 teaspoons mayonnaise",
    "1 teaspoon Asian red chili paste (sambal)",
    "3 (5 ounce) cans Bumble Bee® Solid White Albacore Tuna in Water, drained",
    "0.5 cup chopped fresh cilantro",
    "0.25 cup chopped Thai basil",
    "0.25 cup red bell pepper, diced",
    "0.25 cup diced red onion",
    "1 medium carrot, shredded",
    "6 green onions, chopped, divided",
    "1 medium jalapeno pepper, seeded and minced",
    "4 teaspoons sesame oil",
    "3 teaspoons Asian red chili paste (sambal)",
    "2 teaspoons toasted sesame seeds",
    "2 teaspoons sugar",
    "1 teaspoon salt",
    "0.25 teaspoon black pepper",
    "1 medium lime, juiced",
    "1 clove garlic, minced",
    "3 cups gourmet salad greens",
    "1 teaspoon chopped fresh cilantro",
    "1 teaspoon chopped Thai basil"
  ],
  "steps": [
    {
      "text": "Make the spicy mayo: Mix Sriracha, mayonnaise, and sambal together in a small bowl. Refrigerate until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the lettuce wraps: Empty drained tuna into a large bowl. Break up tuna into large chunks. Add 1/2 cup cilantro, 1/4 cup basil, bell pepper, onion, carrot, 2/3 of the green onions, and jalapeño pepper; gently mix to combine, being careful not to break tuna apart too much.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sesame oil, sambal, sesame seeds, sugar, salt, pepper, lime juice, and garlic together in a small bowl. Pour dressing over tuna mixture and mix carefully.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon tuna mixture onto lettuce leaves and drizzle spicy mayo over top. Garnish with remaining green onions, cilantro, and basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
