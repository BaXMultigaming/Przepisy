  "ingredients": [
    "0.5 cup olive oil",
    "0.25 cup red wine vinegar",
    "2 cloves garlic, minced",
    "1 teaspoon dried oregano",
    "1 teaspoon Dijon mustard",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 (16 ounce) package gemelli pasta",
    "3 cups firmly packed baby spinach leaves",
    "1 pint cherry tomatoes, halved",
    "0.75 medium English cucumber, peeled and diced",
    "0.5 large red onion, thinly sliced",
    "1 (6 ounce) container crumbled feta cheese",
    "0.5 cup pitted Kalamata olives, halved"
  ],
  "steps": [
    {
      "text": "Whisk olive oil, vinegar, garlic, oregano, Dijon, salt, and black pepper together in a small bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook gemelli pasta at a boil, stirring occasionally, until tender yet firm to the bite, 8 to 11 minutes. Drain, rinse under cold water, drain again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer gemelli to a large bowl; add spinach, cherry tomatoes, cucumber, red onion, feta cheese, and olives. Toss salad with vinaigrette until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
