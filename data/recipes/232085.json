  "ingredients": [
    "5 cups old-fashioned oats",
    "1 cup brown sugar",
    "1 cup flaked coconut",
    "1 cup wheat germ",
    "1 tablespoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.5 cup water",
    "0.5 cup vegetable oil",
    "1 tablespoon vanilla extract",
    "0.5 cup raisins",
    "0.5 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, brown sugar, coconut, wheat germ, cinnamon, and nutmeg together in a large bowl. Stir water, oil, and vanilla extract into oat mixture; spread onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring every 15 minutes, until golden brown and crunchy, about 1 hour; transfer to a bowl. Stir raisins and almonds through granola.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
