  "title": "Stuffed Mushrooms II",
  "description": "Fresh parsley and breadcrumbs set these seafood-stuffed mushrooms apart--butter and eggs add extra richness.",
  "authors": [
    "Judy"
  ],
  "date_published": "1999-12-29T08:18:43-05:00",
