  "ingredients": [
    "0.5 cup butter",
    "1 small onion, diced",
    "1 (16 ounce) package egg noodles",
    "1 (16 ounce) container cottage cheese",
    "0.5 cup sour cream",
    "0.5 teaspoon sea salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium heat. Cook and stir onion in melted butter until softened, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Add egg noodles and cook, stirring occasionally, until partially cooked, about 5 minutes. Drain and return to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour onion mixture over noodles, then stir in cottage cheese, sour cream, salt, and pepper. Cook over medium heat, stirring occasionally, until sauce is heated through and noodles are tender, yet firm to the bite, 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
