  "ingredients": [
    "1.25 cups almond milk",
    "1 cup diced mango",
    "2 bananas",
    "0.5 cup rolled oats",
    "4 ounces frozen unsweetened acai pulp (such as Sambazon®)",
    "1 tablespoon chia seeds",
    "2 teaspoons maple syrup"
  ],
  "steps": [
    {
      "text": "Place almond milk, mango, bananas, rolled oats, and acai pulp in a blender; blend until smooth. Pour into 2 bowls and top with chia seeds and drizzle with maple syrup.",
