  "ingredients": [
    "1 pound dry garbanzo beans",
    "1 meaty ham bone",
    "8 cups water",
    "10 new potatoes, halved",
    "5 carrots, chopped",
    "0.5 cup frozen corn",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place garbanzo beans into a large container and cover with several inches of cool water; let stand for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain and rinse beans, then place into the slow cooker. Place ham bone over beans and pour in 8 cups water or enough to cover by several inches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Skim any foam from the top of soup. Remove ham bone, strip as much meat as possible from the bone, and return meat to the slow cooker; discard the bone. Stir in potatoes, carrots, frozen corn, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 1 hour. Turn to High and cook for 1 more hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
