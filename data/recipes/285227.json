  "ingredients": [
    "1 pound bulk pork sausage",
    "1 tablespoon olive oil",
    "1 (10 ounce) package fresh spinach",
    "1 green bell pepper, chopped",
    "1 Roma tomato, chopped",
    "0.5 cup chopped onion",
    "1.5 cups shredded Cheddar cheese",
    "2 (2.5 ounce) packages real bacon bits",
    "12 large eggs",
    "1 teaspoon dried oregano",
    "1 teaspoon dried basil",
    "1 teaspoon sea salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat oil in another skillet over medium heat. Add spinach and saute until just wilted, about 2 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer spinach to the prepared baking pan; sprinkle in bell pepper, tomato, and onion. Add 1/2 of the Cheddar cheese. Sprinkle in sausage and bacon bits. Sprinkle with remaining cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix eggs, oregano, basil, salt, pepper, and garlic powder together in a blender until combined. Pour mixture into the baking pan over the vegetables and meats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
