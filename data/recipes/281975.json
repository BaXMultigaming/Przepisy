  "ingredients": [
    "2 pounds plums, pitted and halved",
    "0.5 cup white sugar, divided",
    "1 small orange, zested and juiced",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1.75 cups whole wheat flour",
    "2 tablespoons whole wheat flour",
    "1 pinch salt",
    "7 tablespoons cold unsalted butter, cut into chunks"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place plums in a baking dish. Add 1/4 cup sugar, orange zest, orange juice, cinnamon, and nutmeg; toss to mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine flour and salt in a mixing bowl. Add chilled butter and rub it in with your fingertips until the mixture resembles bread crumbs. Stir in remaining sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove plums from the oven and scatter topping evenly over top. Return to the oven and bake until golden brown, 25 to 30 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
