  "ingredients": [
    "3 cups white sugar",
    "1 cup butter, melted",
    "1 tablespoon vanilla extract",
    "4 eggs",
    "1.5 cups all-purpose flour",
    "1 cup unsweetened cocoa powder",
    "1 teaspoon salt",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tF2qjySU8Wlp8OI1hdEQ7vde48g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143667-brookes-best-bombshell-brownies-VAT-step-01-8662f646d7d94a67a26913eb8e7ce23c.jpg"
      ],
      "image": "assets/images/143667/step_01.webp"
    },
    {
      "text": "Combine sugar, melted butter, and vanilla in a large bowl. Beat in eggs, one at a time, mixing well after each addition, until thoroughly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cmxVHqLMj3c2-HwUPsDNwtMLKL0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143667-brookes-best-bombshell-brownies-VAT-step-02-8412366488734514a4906227586d7e21.jpg"
      ],
      "image": "assets/images/143667/step_02.webp"
    },
    {
      "text": "Sift flour, cocoa powder, and salt into a separate large bowl. Gradually stir flour mixture into egg mixture until blended; stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/etx4uahNQlUWkDWAzbICqG11AjU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143667-brookes-best-bombshell-brownies-VAT-step-03-88e70212f3ab4cee9d5e2b3f53965755.jpg"
      ],
      "image": "assets/images/143667/step_03.webp"
    },
    {
      "text": "Spread batter evenly into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gPm0iPJo4ivJCBmEaEIiUc9U5xY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143667-brookes-best-bombshell-brownies-VAT-step-04-7f7bc4b181044405a9a848691e9b227f.jpg"
      ],
      "image": "assets/images/143667/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until top is dry and edges have started to pull away from the sides of the pan, about 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JlSL4EWH8m1ILmxX9KEjz7QI2iQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143667-brookes-best-bombshell-brownies-VAT-step-05-b39b3001b23f432fa45a3c81ac3b9a5e.jpg"
      ],
      "image": "assets/images/143667/step_05.webp"
    },
    {
      "text": "Let cool completely before slicing into 24 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/85LvKwUtSwKANtOEO2KdZYvuofg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143667-brookes-best-bombshell-brownies-VAT-step-06-7ce506db48e24bdd819c06abfe8f52c5.jpg"
      ],
      "image": "assets/images/143667/step_06.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DnOUisSGd5mytWVeEVDzWCQz7mE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143667-brookes-best-bombshell-brownies-VAT-Beauty-4x3-771207b56b4a4442a0c7c6e932b7abd6.jpg"
      ],
      "image": "assets/images/143667/step_07.webp"
    }
