  "ingredients": [
    "1 onion, chopped",
    "1 clove garlic, minced",
    "2 teaspoons vegetable oil",
    "2 cups skim milk",
    "1 cup chicken broth",
    "3 tablespoons all-purpose flour",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup grated Parmesan cheese",
    "16 ounces dry fettuccine pasta",
    "1 (16 ounce) package frozen broccoli florets"
  ],
  "steps": [
    {
      "text": "In a medium saucepan, heat oil over medium heat. Add onion and garlic, and sauté until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small saucepan, stir together milk, chicken broth, flour, salt, and pepper over low heat until smooth and thick. Stir into onion mixture. Continue to cook over medium-low heat, frequently stirring, until sauce is thick. Stir in Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook pasta in boiling water. Add broccoli to pasta for the last several minutes of cooking. Continue cooking until pasta is al dente.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta and vegetables, and transfer to a large bowl. Toss with sauce. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
