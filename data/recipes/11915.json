  "title": "Alfredo Light",
  "description": "In this light Alfredo dish, whip up a delightful sauce with skim milk, broth, and flour instead of heavy cream. Parmesan cheese gives it a zing.",
  "authors": [
    "Dorothy"
  ],
  "date_published": "1999-02-24T11:40:51-05:00",
