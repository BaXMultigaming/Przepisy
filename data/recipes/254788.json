  "ingredients": [
    "2 (14 ounce) cans chicken broth",
    "1 (8 ounce) package cream cheese",
    "1 cup shredded Cheddar cheese",
    "0.25 cup butter",
    "1 tablespoon minced onion flakes",
    "1 pint heavy whipping cream",
    "1 (10 ounce) can chicken chunks, or more to taste",
    "3 heads broccoli, broken into florets"
  ],
  "steps": [
    {
      "text": "Combine chicken broth, cream cheese, Cheddar cheese, butter, and onion flakes in a large pot over medium heat; cook and stir until smooth, 3 to 5 minutes. Add heavy cream and chicken; bring to a gentle simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add broccoli, cover, and steam until tender, 4 to 5 minutes. Transfer to a colander to drain excess moisture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour chicken broth mixture into a slow cooker; add broccoli.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until flavors combine, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
