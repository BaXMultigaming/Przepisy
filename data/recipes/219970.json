  "ingredients": [
    "1 cup butter, softened",
    "1 cup white sugar",
    "1 egg, beaten",
    "2 tablespoons milk",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "2.5 cups flour",
    "1 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Cream together the butter, sugar, egg, milk, vanilla extract, and almond extract in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the flour and baking powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate until firm, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide the dough into thirds. On a lightly floured surface, roll out each portion to 1/4-inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut cookies out using a floured cookie cutter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange cookies on an ungreased baking sheet about 1-inch apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until cookies are lightly golden, 6 to 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cookies to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
