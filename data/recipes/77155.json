  "ingredients": [
    "1 tablespoon olive oil",
    "2 (3/4 pound) pork tenderloins",
    "2 Roma (plum) tomatoes, seeded and chopped",
    "0.25 cup chopped green olives",
    "0.25 cup dry white wine",
    "1 teaspoon chopped fresh rosemary",
    "2 cloves garlic, minced",
    "0.5 teaspoon salt",
    "0.25 teaspoon pepper",
    "0.5 cup heavy cream"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Heat the oil in a cast iron skillet over medium-high heat. Brown pork on all sides in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the tomatoes, olives, wine, rosemary and garlic in a bowl. Pour over the pork. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place skillet with pork in the preheated oven, and bake 30 minutes, to a minimum internal temperature of 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pork from skillet, leaving remaining tomato mixture and juices. Place skillet over medium heat, and gradually mix in the cream. Stirring constantly, bring to a boil. Reduce heat to low, and continue cooking 5 minutes, until thickened. Slice pork, and drizzle with the cream sauce to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
