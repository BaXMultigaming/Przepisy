  "ingredients": [
    "3 cups sliced fresh strawberries",
    "3 cups diced rhubarb",
    "1 cup white sugar",
    "3 tablespoons all-purpose flour",
    "1.5 cups all-purpose flour",
    "1 cup packed brown sugar",
    "1 cup rolled oats",
    "1 cup butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
