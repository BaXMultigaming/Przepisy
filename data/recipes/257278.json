  "ingredients": [
    "3 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "3 cups white sugar",
    "1.5 cups butter, softened",
    "5 eggs",
    "1 cup milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a tube pan with some butter and dust lightly with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and butter in a large bowl; beat with an electric mixer until creamy. Add eggs one at a time, beating well between each addition. Beat in flour mixture alternately with milk. Mix in vanilla extract. Pour batter into the prepared tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 1 hour to 1 hour 30 minutes. Cool in the pan for 5 minutes. Invert onto a wire rack and let cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
