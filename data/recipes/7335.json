  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "0.5 teaspoon salt",
    "1 teaspoon baking powder",
    "1 egg",
    "1 (16 ounce) can fruit cocktail",
    "0.5 cup packed brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Spray one 8-inch square baking pan with cooking spray.",
      "section": null,
