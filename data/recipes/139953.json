  "title": "Mango Cheesecake",
  "description": "This baked mango cheesecake has a smooth and creamy filling, topped with chunks of fresh mango glazed with mango nectar for a sweet summer dessert.",
  "authors": [
    "Tracey Narinesingh"
  ],
  "date_published": "2020-06-18T23:29:49-04:00",
