  "ingredients": [
    "nonstick cooking spray",
    "2.5 cups beets",
    "2 cups shredded carrots",
    "0.75 cup chopped walnuts",
    "0.5 cup chopped onions",
    "0.5 cup steel-cut oats",
    "0.5 cup dry bread crumbs",
    "4 large eggs",
    "1.5 teaspoons chopped fresh parsley",
    "1 teaspoon everything bagel seasoning",
    "2 dashes liquid aminos (such as Bragg®)",
    "0.5 cup ketchup, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 2-quart casserole dish with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beets, carrots, walnuts, onions, oats, and bread crumbs in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, parsley, bagel seasoning, and liquid aminos in a smaller bowl. Mix into the veggie mixture and stir to combine. Transfer to the prepared casserole dish and top with ketchup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven for 1 to 1 1/2 hours, depending on how moist or dry you want it.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
