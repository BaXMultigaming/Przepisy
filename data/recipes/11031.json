  "ingredients": [
    "0.75 cup butter",
    "1.5 cups packed brown sugar",
    "2 eggs",
    "0.25 teaspoon baking powder",
    "1.25 cups all-purpose flour",
    "0.5 cup toasted sesame seeds",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Cream together the butter and the brown sugar. Beat in the eggs. Sift together the baking powder and the flour and mix in. Stir in the sesame seeds and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoon on a cookie sheet lined with wax paper. Bake at 325 degrees F (165 degrees C) for about 25 - 30 minutes.",
