  "ingredients": [
    "1 cup butter, softened",
    "1 cup packed brown sugar",
    "1 teaspoon vanilla extract",
    "1 large egg yolk",
    "2 cups all-purpose flour",
    "0.25 teaspoon salt",
    "0.66666668653488 cup milk chocolate chips",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, vanilla extract, and egg yolk in a large bowl; stir in flour and salt. Press dough into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until crust is light brown, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Immediately sprinkle chocolate chips over hot crust. Let stand until soft, about 5 minutes, and spread evenly; sprinkle with nuts. Cool pan on wire rack for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
