  "ingredients": [
    "2 cups white sugar",
    "1.25 cups vegetable oil",
    "3 eggs, lightly beaten",
    "3 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 cups peeled, pitted, and chopped peaches",
    "0.66666668653488 cup brown sugar",
    "0.66666668653488 cup all-purpose flour",
    "0.25 cup butter, softened",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease 16 standard muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the muffins: Beat sugar, oil, and eggs in a bowl with an electric mixer on medium speed until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, cinnamon, baking soda, and salt together in a large bowl. Gradually beat flour mixture into egg mixture until just combined. Fold in peaches. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the streusel topping: Mix brown sugar, flour, butter, and cinnamon together in a bowl until crumbly. Sprinkle over muffin batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, 20 to 25 minutes. Remove from the oven and cool in the pan for 10 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
