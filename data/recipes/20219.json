  "ingredients": [
    "7 cups water",
    "2 cups strong brewed black tea",
    "2 cups whiskey",
    "1 (12 fluid ounce) can frozen lemonade concentrate",
    "1 cup white sugar",
    "1 (6 ounce) can frozen orange juice concentrate",
    "1 liter ginger ale soda",
    "2 lemons - cut into wedges, for garnish"
  ],
  "steps": [
    {
      "text": "Combine water, tea, whiskey, lemonade concentrate, sugar, and orange juice concentrate in a large plastic container; stir well. Freeze for 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop slush into a tall glass, filling 3/4 full. Add ginger ale to fill glass; stir. Garnish with lemon wedges.",
