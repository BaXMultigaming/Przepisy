  "ingredients": [
    "0.66666668653488 cup chopped baby carrots",
    "0.5 cup frozen green peas",
    "2 tablespoons vegetable oil",
    "1 clove garlic, minced, or to taste",
    "2 large eggs",
    "3 cups leftover cooked white rice",
    "1 tablespoon soy sauce, or more to taste",
    "2 teaspoons sesame oil, or to taste"
  ],
  "steps": [
    {
      "text": "Assemble ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JU3yWooolSWtTq7N3X8gpIwAmH4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/79543-Easy_Fried-Rice-DDFMS-Step1-80cfe942417d44b98f07cc17eeb02da8.jpg"
      ],
      "image": "assets/images/79543/step_01.webp"
    },
    {
      "text": "Place carrots in a small saucepan and cover with water. Bring to a low boil and cook for 3 to 5 minutes. Stir in peas, then immediately drain in a colander.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ITosbKq5WtdWHWQwbHbOJ9Ii6E4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/79543-fried-rice-restaurant-style-step-2-93-fbbc06faf5be4c52b62a0564d0b732bb.jpg"
      ],
      "image": "assets/images/79543/step_02.webp"
    },
    {
      "text": "Heat a wok over high heat. Pour in vegetable oil, then stir in carrots, peas, and garlic; cook for about 30 seconds. Add eggs; stir quickly to scramble eggs with vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tiyCjvi5-WYss5znB5Q_X8klug8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/79543-fried-rice-restaurant-style-step-4-99-d4b0488528064e9f99cea7c7f4b0c5aa.jpg"
      ],
      "image": "assets/images/79543/step_03.webp"
    },
    {
      "text": "Stir in cooked rice. Add soy sauce and toss rice to coat. Drizzle with sesame oil and toss again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yHsty5aJeITMK0BN-FXHO4u-F7Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/79543-fried-rice-restaurant-style-step-6-102-2e5637fd5ba144c998c7c2ee9b68d354.jpg"
      ],
      "image": "assets/images/79543/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
