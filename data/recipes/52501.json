  "ingredients": [
    "2 cups seeded and chopped jalapeno pepper",
    "2 (8 ounce) packages cream cheese, softened",
    "2 pounds ground beef",
    "8 (2 ounce) hamburger buns, split"
  ],
  "steps": [
    {
      "text": "Preheat a grill for medium heat. When hot, lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together jalapenos and cream cheese in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide ground beef into 16 portions. Pat out each one to a thickness of 1/4 inch.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon some cream cheese mixture onto the center of 1/2 of the patties. Top with the remaining patties, and press the edges together to seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until well done, about 10 minutes per side. Don’t press down on the burgers as they cook, or the cheese will ooze out.",
