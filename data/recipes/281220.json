  "ingredients": [
    "2 tablespoons ranch dressing",
    "1 teaspoon seafood seasoning (such as Old Bay®)",
    "1 pound rockfish",
    "1 (5.8 ounce) package hard taco shells",
    "2 cups coleslaw mix",
    "0.33333334326744 cup sour cream",
    "2 tablespoons chopped fresh cilantro",
    "1 tablespoon lime juice, or more to taste",
    "1 teaspoon ground cumin",
    "0.5 teaspoon salt",
    "0.25 teaspoon black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ranch dressing and seafood seasoning together. Place rockfish on a rimmed baking sheet and brush fish with ranch mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix coleslaw mix, sour cream, cilantro, lime juice, cumin, salt, and pepper together in a bowl. Refrigerate until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce oven temperature to 325 degrees F (165 degrees C). Arrange taco shells on a baking sheet and bake until crisp, 6 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate cooked rockfish into 1- to 2-inch pieces. Place slaw inside taco shells and top with rockfish pieces. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
