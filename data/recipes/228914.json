  "ingredients": [
    "1.5 cups cooked rice",
    "2 cups milk, divided",
    "0.25 teaspoon salt",
    "0.66666668653488 cup golden raisins",
    "1 egg, beaten",
    "0.33333334326744 cup white sugar",
    "1 tablespoon butter",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/usgRf6bLV4paoj2MOGWrmSQ8m-0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228914-old-fashioned-rice-pudding-DDMFS-4x3-step-01-1-ab9042573d8a4219a170027d4a3f3e46.jpg"
      ],
      "image": "assets/images/228914/step_01.webp"
    },
    {
      "text": "Place cooked rice in a medium saucepan. Add 1 ½ cups milk and salt; cook and stir over medium heat until thick and creamy, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4GTZMBfyqGCPsJl6G2Jkh5exmzs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228914-old-fashioned-rice-pudding-DDMFS-4x3-step-03-1-5765adf3b8524286b12006033f04139c.jpg"
      ],
      "image": "assets/images/228914/step_02.webp"
    },
    {
      "text": "Add remaining 1/2 cup milk, golden raisins, beaten egg, and white sugar; continue cooking, stirring continuously, until well blended, 2 to 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-yuFo5ROAFMOwTePNcNKZ0vsb6k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228914-old-fashioned-rice-pudding-DDMFS-4x3-step-04-1-f8aa6332f723478fa47ff93f9977de10.jpg"
      ],
      "image": "assets/images/228914/step_03.webp"
    },
    {
      "text": "Remove saucepan from heat; stir in butter and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cmgdQXKG-3ItSbWu0iDdtQm1zUE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228914-old-fashioned-rice-pudding-DDMFS-4x3-step-05-1-2376d633057044adab28eeb8b6d4b92e.jpg"
      ],
      "image": "assets/images/228914/step_04.webp"
    },
    {
      "text": "Serve warm and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Zm-_kwgfdX8oRrxUAACJfrNF9YA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228914-old-fashioned-rice-pudding-DDMFS-4x3-90f8e5dcb32f4d11b0434d212a1861e5.jpg"
      ],
      "image": "assets/images/228914/step_05.webp"
    },
    {
      "text": "Store your rice pudding in an airtight container in the refrigerator for about three days. Reheat thoroughly on the stove, adding more milk as-needed to retain the creamy texture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
