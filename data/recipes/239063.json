  "ingredients": [
    "4 teaspoons olive oil",
    "0.75 clove garlic, minced",
    "2 tablespoons vodka",
    "1 (14.5 ounce) can Italian-style diced tomatoes, undrained",
    "1.5 teaspoons dried basil",
    "0.25 teaspoon white sugar",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.33333334326744 cup milk",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a saucepan over medium heat. Cook and stir garlic in hot oil until fragrant, about 1 minute; add vodka, bring to a simmer, and cook until mostly evaporated, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomatoes, basil, sugar, oregano, salt, and pepper with the garlic and vodka in the saucepan; bring to a boil and cook until most of the liquid evaporates, about 5 minutes. Remove saucepan from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk and butter together in a bowl until smooth; pour into tomato sauce and stir until the color is even.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place saucepan over medium-low heat, bring sauce to a simmer, and cook until slightly thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
