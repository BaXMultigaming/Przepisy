  "ingredients": [
    "0.5 cup white sugar",
    "2 tablespoons cornstarch",
    "2 tablespoons cocoa powder",
    "2.5 cups whole milk",
    "1 teaspoon vanilla extract",
    "1 tablespoon butter",
    "0.25 cup miniature semisweet chocolate chips",
    "8 popsicle molds"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0gNKv-rb88sYmpbB9Ty1hBIvl3k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/202825-double-chocolate-fudge-pops-VAT-005-step-01-1991a28860474525ae8cca1239f8832f.jpg"
      ],
      "image": "assets/images/202825/step_01.webp"
    },
    {
      "text": "Combine sugar, cornstarch, cocoa powder, and milk in a small saucepan over medium heat. Bring to a simmer and stir until thick, about 2 minutes. Remove from heat; stir in vanilla and butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4_jrhqy9AYk6F4DT9fEbNzlg-f4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/202825-double-chocolate-fudge-pops-VAT-006-step-02-f890797583ca4f7ca2d666948f719822.jpg"
      ],
      "image": "assets/images/202825/step_02.webp"
    },
    {
      "text": "Transfer to a heatproof bowl and refrigerate until cool, approximately 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CmQ3rjRu5aovHDgPsz3bVxWJ8oY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/202825-double-chocolate-fudge-pops-VAT-007-step-03-5d898675191d48c1866bd08380848169.jpg"
      ],
      "image": "assets/images/202825/step_03.webp"
    },
    {
      "text": "Stir chocolate chips into the cooled chocolate mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QgQ7_zbDXiygujGTg7SMBltjQ6M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/202825-double-chocolate-fudge-pops-VAT-008-step-04-b801a760237642728aa64044b64a7fce.jpg"
      ],
      "image": "assets/images/202825/step_04.webp"
    },
    {
      "text": "Pour into your favorite popsicle molds and freeze until solid, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PCKxWrnIV_TRZtHM-5IUN5llnVI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/202825-double-chocolate-fudge-pops-VAT-009-step-05-30c5947cb97b47a4bd3ca875218a1da9.jpg"
      ],
      "image": "assets/images/202825/step_05.webp"
    },
    {
      "text": "To serve, run warm water over the molds until fudge pops slide out easily.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dfciZA3rlr0VEC9lOpQHYjenar0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/202825-double-chocolate-fudge-pops-VAT-010-step-06-aab27dab92cb42a48f64b4b068690bf6.jpg"
      ],
      "image": "assets/images/202825/step_06.webp"
