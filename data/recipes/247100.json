  "ingredients": [
    "cooking spray",
    "1 cup grated zucchini",
    "0.25 cup grated carrot",
    "0.25 cup seasoned bread crumbs",
    "0.25 cup crumbled feta cheese",
    "0.25 cup chopped fresh basil",
    "1 egg",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.125 teaspoon dried oregano"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a mini muffin tin with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine zucchini and carrot in a large bowl. Squeeze out excess water using a paper towel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs, feta cheese, basil, egg, salt, pepper, and oregano into zucchini-carrot mixture. Scoop mixture with a mini ice cream scoop or two spoons and press into the prepared muffin cups with the back of a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown on top, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
