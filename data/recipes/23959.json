  "ingredients": [
    "0.25 cup blue cheese, crumbled",
    "1 cup vegetable oil",
    "2 tablespoons lemon juice",
    "0.25 cup white wine vinegar",
    "2 cloves garlic, minced",
    "2 teaspoons seasoning salt",
    "1 teaspoon white sugar",
    "0.5 teaspoon dry mustard",
    "hot sauce to taste",
    "2 cups fresh mushrooms, stems removed"
  ],
  "steps": [
    {
      "text": "In a medium bowl, mix together the blue cheese, vegetable oil, lemon juice, white wine vinegar, garlic, seasoning salt, white sugar, dry mustard and hot sauce. Stir in the mushrooms. Cover and refrigerate 4 to 6 hours before serving.",
