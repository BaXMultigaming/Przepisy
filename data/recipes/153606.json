  "ingredients": [
    "1 pound pork shoulder",
    "2 tablespoons Mazola® Corn Oil",
    "0.25 cup chopped onions",
    "0.5 teaspoon Spice Islands® Garlic Powder",
    "1 tablespoon Spice Islands® Chili Powder",
    "0.25 teaspoon Spice Islands® Chipotle Chile Powder",
    "2 tomatillos, finely chopped",
    "0.5 cup finely chopped tomatoes",
    "0.25 cup coarsely chopped fresh cilantro",
    "4 corn tortillas"
  ],
  "steps": [
    {
      "text": "Cut pork into 1-inch cubes; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet or Dutch oven. Add pork, onions, garlic powder, chili powder, and chipotle chile powder; sauté until browned, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add enough water to barely cover pork; bring to a boil. Cover, reduce heat, and simmer 30 minutes. Remove the lid and continue to simmer until liquid has evaporated, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chopped tomatillos, tomatoes, and cilantro in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place an equal amount of pork on each tortilla. Top with tomatillo salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
