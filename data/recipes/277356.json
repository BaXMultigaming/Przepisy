  "ingredients": [
    "1 cup all-purpose flour",
    "2.5 tablespoons white sugar",
    "2 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "1 cup milk",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "3 tablespoons butter, divided",
    "3 tablespoons honey, or to taste"
  ],
  "steps": [
    {
      "text": "Combine flour, sugar, baking powder, cinnamon, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, eggs, and vanilla extract in a separate bowl; slowly stir in flour mixture until batter is combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1 tablespoon butter on a griddle over medium-high heat. Drop batter by large spoonfuls onto the griddle and cook until bubbles form and edges are dry, 3 to 4 minutes. Lightly drizzle with honey. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining butter and batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
