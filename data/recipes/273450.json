  "ingredients": [
    "2 (16 ounce) cans vegetarian baked beans in tomato sauce (such as Bush's® Best Vegetarian Baked Beans), undrained",
    "2 (15 ounce) cans kidney beans, rinsed and drained",
    "0.5 cup green bell peppers, chopped",
    "0.5 cup green onions, chopped",
    "0.5 cup ketchup",
    "2 tablespoons red wine vinegar",
    "2 tablespoons brown sugar",
    "2 tablespoons chili powder",
    "1 teaspoon garlic powder",
    "0.5 teaspoon liquid smoke flavoring",
    "1 drizzle olive oil"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large saucepan over medium heat. Add green bell peppers and green onions; cook and stir until slightly cooked, about 2 minutes. Stir in vegetarian baked beans, kidney beans, ketchup, red wine vinegar, brown sugar, chili powder, garlic powder, and liquid smoke flavoring.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat and let simmer, uncovered, until completely heated, about 15 minutes.",
