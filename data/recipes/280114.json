  "ingredients": [
    "cooking spray",
    "1 (8.5 ounce) package cornbread mix (such as Jiffy®)",
    "1 egg",
    "0.33333334326744 cup milk",
    "1 pound chicken breasts, cut into bite-sized pieces",
    "0.33333334326744 cup water",
    "0.5 (1 ounce) envelope taco seasoning mix",
    "0.25 cup barbecue sauce",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornbread mix, egg, and milk in a bowl. Stir until moistened. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until just set, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While cornbread is baking, cook and stir chicken in a nonstick skillet over medium-high heat until browned, 4 to 5 minutes. Stir in water and taco seasoning. Simmer for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cornbread from the oven and carefully spread barbecue sauce over the soft surface. Gently lay the chicken over the barbecue sauce. Sprinkle Cheddar cheese over the chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue baking until melted and browned, about 15 minutes. Let sit for 5 minutes. Cut into individual pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
