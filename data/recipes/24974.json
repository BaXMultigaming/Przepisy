  "ingredients": [
    "1 pound dried figs",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "0.5 cup buttermilk",
    "1 cup white sugar",
    "0.5 cup unsalted butter, softened",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place dried figs into a saucepan and cover with water. Bring to a simmer over low heat and cook until soft, about 5 minutes. Drain figs, reserving 1/2 cup cooking liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, salt, baking soda, cinnamon, and cloves into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut figs into 1/4-inch cubes. Combine buttermilk and reserved cooking liquid in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter in a large bowl with an electric mixer until light and fluffy. Beat in eggs, one at a time, then stir in vanilla. Beat in flour mixture alternately with buttermilk mixture, then stir in figs and walnuts. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 50 to 60 minutes. Cool in pan for 15 minutes, then turn out onto a wire rack and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
