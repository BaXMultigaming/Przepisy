  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease an 8-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, flour, and butter together in a bowl to make a crumbly topping. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, white sugar, baking powder, baking soda, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat buttermilk, melted butter, egg, and vanilla extract together in another bowl. Stir into dry ingredients. Spread batter into the prepared pan. Sprinkle with raspberries, then with crumbly topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until well browned and a toothpick inserted into the center comes out clean, 35 to 40 minutes.",
