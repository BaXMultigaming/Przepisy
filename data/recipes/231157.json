  "ingredients": [
    "0.5 cup all-purpose flour, or as needed",
    "1.5 pounds boneless country-style pork ribs",
    "1 tablespoon vegetable oil",
    "2 tablespoons butter",
    "1 onion, chopped",
    "0.5 cup ketchup",
    "2 tablespoons vinegar",
    "2 tablespoons Worcestershire sauce",
    "2 tablespoons brown sugar",
    "2 tablespoons dry mustard",
    "0.5 teaspoon salt",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread flour into a shallow dish. Dredge ribs in flour to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a skillet over medium heat; cook ribs in hot oil until completely browned, 2 to 3 minutes per side. Remove ribs to a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in the hot skillet. Cook and stir onion in melted butter until translucent, about 5 minutes. Stir ketchup, vinegar, Worcestershire sauce, brown sugar, mustard, and salt with the onion until you have a smooth sauce. Pour water into the sauce; cook and stir until hot. Pour sauce over the ribs. Cover dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in preheated oven, spooning sauce over meat several times during baking, for 90 minutes. Turn ribs and continue cooking and basting with sauce until the meat is completely tender, about 90 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
