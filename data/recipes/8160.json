  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "2 (16 ounce) packages vanilla frosting",
    "1 drop red food coloring"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 2-quart ovenproof Pyrex glass mixing bowl with shortening and dust with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare cake as directed on box. Pour batter into prepared bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 50-60 minutes or until cake tester inserted into center comes out clean. Cool 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Invert on cake plate with widest part of cake on the bottom. Cool 3 hours before decorating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Insert a clean doll into center of cake. Decorate the skirt with icing tinted any color or use more than one color. Use a decorator tip to make the skirt as fancy as you like and decorate the top of the doll for the top of the dress also.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
