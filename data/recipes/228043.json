  "title": "Whole Grilled Trout",
  "description": "Whole grilled trout is stuffed with herbs and flavorings and cooked directly on grill grates for delicious, flaky, tender fish with crispy skin.",
  "authors": [
    "Trina Cosgrave"
  ],
  "date_published": "2009-05-31T18:28:45-04:00",
