  "ingredients": [
    "2 whole trout, cleaned",
    "1 tablespoon olive oil, divided",
    "1 pinch coarse sea salt to taste",
    "1 pinch ground black pepper",
    "0.5 lemon, thinly sliced",
    "0.5 sweet onion, thinly sliced",
    "1 clove garlic, minced",
    "2 sprigs fresh rosemary",
    "2 sprigs fresh thyme"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub the outside of each trout generously with olive oil and sprinkle with sea salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle inside cavities with salt and black pepper. Place 1/2 of the lemon and onion slices into cavity of each trout as well, along with minced garlic, sprig of rosemary, and sprig of thyme.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn preheated grill down to low and place the trout directly onto the grill; cook until flesh flakes easily and the skins are browned, 6 to 7 minutes per side, flipping once.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
