  "ingredients": [
    "1 cup corn oil, or as needed",
    "0.5 cup all-purpose flour",
    "2 teaspoons salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon paprika",
    "0.5 teaspoon garlic powder",
    "8 skinless chicken thighs"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Heat oil in a large, deep skillet to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3re-m6FtaB3ug1tEliBQ5SYDALM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257306-easy-skinless-fried-chicken-thighs-ddmfs-step-1-0896-911d7d8b4e014dedb949e70c4b008d18.jpg"
      ],
      "image": "assets/images/257306/step_01.webp"
    },
    {
      "text": "Combine flour, salt, pepper, paprika, and garlic powder in a large resealable plastic bag; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hH25tDpohQBTVwRFxbqIlC18mmY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257306-easy-skinless-fried-chicken-thighs-ddmfs-step-2-0900-a43a1a4ca4654ae48891a8884dea39e2.jpg"
      ],
      "image": "assets/images/257306/step_02.webp"
    },
    {
      "text": "Pat chicken thighs dry with paper towels. Add to flour mixture in the plastic bag; seal the bag and shake until thoroughly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DizVmbrckZNPg4fwZzXtklEQNzM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257306-easy-skinless-fried-chicken-thighs-ddmfs-step-3-0904-012ff7a0cbfd41f982499dfd5170077e.jpg"
      ],
      "image": "assets/images/257306/step_03.webp"
    },
    {
      "text": "Fry chicken in hot oil, turning occasionally, until deep golden brown, about 20 minutes. Drain on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xehkKLjSOld8vL4zlOCARUp1o6A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257306-easy-skinless-fried-chicken-thighs-ddmfs-step-5-0907-532391ab87544ed8b89ef441d293a67b.jpg"
