  "ingredients": [
    "1 (18.25 ounce) box red velvet cake mix",
    "2 eggs",
    "0.5 cup water",
    "0.5 cup sour cream",
    "1 (3.9 ounce) package instant chocolate fudge pudding mix",
    "1 (21 ounce) can cherry pie filling",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Grease the crock of your slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend cake mix, eggs, water, sour cream, and chocolate pudding mix together in a bowl with an electric hand mixer until you have a smooth batter. Stir cherry pie filling and chocolate chips into the batter; pour into greased crock.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until set in the middle, about 4 hours.",
      "section": null,
      "name": null,
