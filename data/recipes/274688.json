  "ingredients": [
    "2 tablespoons olive oil",
    "3 medium Yukon Gold potatoes, diced",
    "1 large sweet onion, chopped",
    "0.5 cup diced carrots",
    "0.5 cup diced celery",
    "3 cloves garlic, chopped",
    "0.25 teaspoon red pepper flakes, or more to taste",
    "salt and ground black pepper to taste",
    "1 bunch kale, stems removed and leaves chopped",
    "2 bay leaves",
    "5 cups chicken broth",
    "1 (14 ounce) can garbanzo beans, with liquid",
    "1 (14 ounce) can diced tomatoes",
    "0.5 pound linguica sausage, diced",
    "0.5 pound chorizo sausage, diced"
  ],
  "steps": [
    {
      "text": "Heat oil in a soup pot over medium heat until it sizzles, about 1 minute. Add potatoes, onion, carrots, and celery; cook and stir 3 to 4 minutes. Add garlic, red pepper flakes, salt, and black pepper; cook and stir 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add kale and bay leaves; cover until kale wilts, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken broth, garbanzo beans with their juices, tomatoes, linguica, and chorizo; bring to a boil, about 5 minutes. Reduce heat to medium; simmer until vegetables are tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
