  "ingredients": [
    "1.25 cups all-purpose flour",
    "1.5 teaspoons ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon ground cloves",
    "1 cup shredded zucchini",
    "0.66666668653488 cup packed brown sugar",
    "0.5 cup butter, softened",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 cup quick cooking oats",
    "0.5 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cinnamon, baking soda, and cloves together in a bowl until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap zucchini in a clean towel; wring out to remove any excess moisture. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter together in a large bowl with an electric mixer until creamy; beat in egg and vanilla extract. Stir in flour mixture and oats until just incorporated. Stir in zucchini and raisins until evenly combined. Drop rounded teaspoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bottom edges turn golden brown, 14 to 16 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
