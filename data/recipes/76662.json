  "ingredients": [
    "2 teaspoons vegetable oil",
    "0.25 cup finely chopped onion",
    "1 tablespoon unsweetened cocoa powder",
    "1 teaspoon ground cumin",
    "1 teaspoon dried cilantro",
    "0.125 tablespoon dried minced garlic",
    "1 (10.75 ounce) can condensed tomato soup",
    "1 (4 ounce) can diced green chile peppers"
  ],
  "steps": [
    {
      "text": "Heat oil in a medium saucepan over medium heat. Cook onion in oil until tender. Mix in cocoa powder, cumin, cilantro, and garlic. Stir in tomato soup and green chile peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring sauce to a boil, reduce heat to low, cover, and simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a gravy boat or pour directly over food to serve.",
      "section": null,
