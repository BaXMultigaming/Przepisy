  "ingredients": [
    "0.5 cup butter",
    "0.75 cup all-purpose flour",
    "2 cups milk",
    "3 cups chicken broth",
    "2 cups cooked, boneless and skinless chicken, cut into bite-sized pieces",
    "0.5 cup chopped green chile peppers",
    "salt and pepper to taste",
    "1 pinch garlic powder"
  ],
  "steps": [
    {
      "text": "In a large pot, melt butter or margarine. Add flour and stir resulting paste over medium heat. Add milk and chicken broth and whip to eliminate any lumps. Bring to a boil and reduce heat to simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken. Add chopped green chiles, salt, pepper, and garlic powder to taste. Stir well and cover. Simmer for 30 minutes and serve.",
      "section": null,
      "name": null,
      "url": null,
