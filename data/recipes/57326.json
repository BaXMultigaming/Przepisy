  "ingredients": [
    "1 (15.5 ounce) can sliced peaches in heavy syrup",
    "1 cup distilled white vinegar",
    "12 habanero peppers, seeded and chopped",
    "0.5 cup dark molasses",
    "0.5 cup yellow mustard",
    "0.5 cup light brown sugar",
    "2 tablespoons salt",
    "2 tablespoons paprika",
    "1 tablespoon black pepper",
    "1 tablespoon ground cumin",
    "0.5 teaspoon ground coriander",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground allspice"
  ],
  "steps": [
    {
      "text": "Combine peaches, vinegar, habaneros, molasses, mustard, brown sugar, salt, paprika, black pepper, cumin, coriander, ginger, and allspice in the bowl of a food processor: pulse until blended.",
