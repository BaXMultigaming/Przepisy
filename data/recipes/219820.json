  "ingredients": [
    "3 cups milk",
    "3 tablespoons quick-cooking tapioca",
    "1 egg, beaten",
    "0.5 cup white sugar",
    "0.5 cup chopped chocolate",
    "3 tablespoons unsweetened cocoa powder",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Milk the milk, tapioca, egg, and sugar together in a saucepan until the sugar has dissolved; allow to stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk in the chocolate and cocoa powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place over medium heat, bring to a boil, whisking constantly, and let boil for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and whisk in the vanilla extract. Allow to cool for 20 minutes. Serve warm or chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
