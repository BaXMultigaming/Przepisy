  "ingredients": [
    "6 eggs",
    "1 cup milk",
    "0.5 cup all-purpose flour",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Lightly grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a blender, combine eggs, milk, flour, salt and pepper; cover and process until smooth. Pour into prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until set, about 20 minutes. Sprinkle with cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully loosen edges of omelet from pan. Starting from the short edge of the pan, carefully roll up omelet. Place omelet seam side down on a serving plate and cut into 6 equal sized pieces.",
      "section": null,
      "name": null,
      "url": null,
