  "ingredients": [
    "0.25 cup olive oil",
    "0.5 lemon, juiced",
    "2 teaspoons dried oregano",
    "salt and pepper to taste",
    "7 chicken thighs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease a 9x13-inch baking dish. Whisk oil and lemon juice together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oregano with salt and pepper to taste. Rub well over all chicken pieces. Place into the prepared baking dish and drizzle with 1/2 of the oil-lemon mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Turn chicken pieces and drizzle with remaining oil-lemon mixture. Bake until chicken is no longer pink at the bone and the juices run clear, 15 to 20 more minutes. An instant-read thermometer inserted near the bone should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
