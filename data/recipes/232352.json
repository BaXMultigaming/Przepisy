  "ingredients": [
    "4 cups coconut flakes",
    "1 (14 ounce) can sweetened condensed milk",
    "0.75 cup all-purpose flour",
    "0.5 cup corn syrup",
    "0.33333334326744 cup packed brown sugar",
    "0.25 cup butter, softened",
    "2 teaspoons vanilla extract",
    "0.25 teaspoon salt",
    "1 cup milk chocolate chips",
    "3 tablespoons milk, or as needed",
    "0.5 cup confectioners' sugar",
    "2 tablespoons butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread coconut flakes onto an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake coconut in the preheated oven, stirring every 3 to 5 minutes, until toasted, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sweetened condensed milk, flour, corn syrup, brown sugar, 1/4 cup butter, 2 teaspoons vanilla extract, and salt together in a bowl; fold in toasted coconut. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through and slightly browned, 25 to 35 minutes. Set aside to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat chocolate chips and milk in the top of a double boiler over simmering water, stirring frequently and scraping down the sides with a rubber spatula to avoid scorching. Stir in confectioners' sugar, 2 tablespoons butter, and 1 teaspoon vanilla extract until frosting is smooth, 2 to 4 minutes. Spread frosting over bars. Refrigerate 30 minutes before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
