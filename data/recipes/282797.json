  "title": "Mini Crab Cakes with Curried Tartar Sauce",
  "description": "Deliciously flavored mini crab cake balls are served with a tasty curried tartar sauce that really sets this recipe apart.",
  "authors": [
    "Maria Connors"
  ],
  "date_published": "2015-01-25T07:27:10-05:00",
