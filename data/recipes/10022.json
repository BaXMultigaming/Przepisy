  "ingredients": [
    "cooking spray",
    "12 ounces almond paste",
    "0.5 cup white sugar",
    "1 cup confectioners' sugar",
    "4 egg whites, divided",
    "1.5 cups pine nuts",
    "all-purpose flour for rolling"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 325 degrees F (165 degrees C). Line 2 cookie sheets with foil; lightly grease the foil with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rnha5T6H4sB_LRasEqNinvE4pn8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-10022-pignoli-cookies-i-VAT-step-01-c9d3ed21d2f64a9594f8efbe19c0f6d3.jpg"
      ],
      "image": "assets/images/10022/step_01.webp"
    },
    {
      "text": "Place almond paste and white sugar in a food processor; blend until combined. Add confectioners' sugar and 2 egg whites; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8mFPlFlBPf4HGX9FTA8WXO-hkPs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-10022-pignoli-cookies-i-VAT-step-02-4104976e32384f198dec09c5fe2f2c19.jpg"
      ],
      "image": "assets/images/10022/step_02.webp"
    },
    {
      "text": "Whisk remaining 2 egg whites in a small bowl. Place pine nuts on a shallow plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/szimBRq7mOod80hqPWYQdsg4V-0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-10022-pignoli-cookies-i-VAT-step-03-e1fc7cb3e2234718a2393c47d46c1794.jpg"
      ],
      "image": "assets/images/10022/step_03.webp"
    },
    {
      "text": "With lightly floured hands, roll dough into 1-inch balls. Coat balls in egg whites, shaking off excess, then roll in pine nuts, pressing lightly to stick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AL6zpNGUP7eYyr-V9UBmqw5uAYc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-10022-pignoli-cookies-i-VAT-step-04-30476dbce46c4b159fe1a256c6bfdc33.jpg"
      ],
      "image": "assets/images/10022/step_04.webp"
    },
    {
      "text": "Arrange balls on cookie sheets, and flatten slightly to form a 1 1/2-inch round.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TaMh5E75ASMbduR_d03ruzO4g6w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-10022-pignoli-cookies-i-VAT-step-05-1-handpressing-f4fd48d60b0f4652a3a724bb63319a9a.jpg"
      ],
      "image": "assets/images/10022/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 15 to 18 minutes. Let stand on cookie sheets briefly, then transfer to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lTkUZeCi_RJoEKnHZFr3C2a7Prk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-10022-pignoli-cookies-i-VAT-step-06-013b04f7513449fbb572f858ee305819.jpg"
      ],
      "image": "assets/images/10022/step_06.webp"
    }
  ],
