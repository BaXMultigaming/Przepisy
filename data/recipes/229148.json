  "ingredients": [
    "6 green tomatoes, cut into 1-inch cubes",
    "16 green onions (white and pale green parts only), chopped",
    "3 stalks celery, cut into 1/2-inch pieces",
    "1 bunch cilantro, chopped",
    "0.25 cup olive oil",
    "5 tablespoons soy sauce",
    "1 tablespoon brown sugar",
    "1 tablespoon apple cider vinegar",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "0.5 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine green tomatoes, green onions, celery, and cilantro in a 2-quart casserole dish. Whisk oil, soy sauce, brown sugar, cider vinegar, black pepper, salt, and pepper flakes together in a bowl; pour over green tomato mixture and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until vegetables are tender, about 45 minutes, stirring halfway through to redistribute sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
