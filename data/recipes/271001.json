  "ingredients": [
    "2 pounds red potatoes, scrubbed but not peeled",
    "1 cube chicken bouillon",
    "1 tablespoon chopped fresh rosemary",
    "1 cup shredded Colby-Jack cheese",
    "0.5 cup milk",
    "0.5 cup sour cream",
    "0.25 cup butter, softened",
    "0.25 cup sliced green onions",
    "2 cloves garlic, minced",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Fill a large stockpot with water. Add potatoes, chicken bouillon, and rosemary. Bring to a boil. Cover and simmer until potatoes are tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain potatoes and place in a large bowl. Add cheese, milk, sour cream, and butter; beat with an electric mixer until smooth. Mix in green onions, garlic, salt, and pepper. Transfer mashed potatoes to a serving dish.",
