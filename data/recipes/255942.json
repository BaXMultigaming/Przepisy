  "ingredients": [
    "1 teaspoon softened butter, or as needed",
    "1 pound sausage",
    "1 cup diced raw pumpkin",
    "1 small onion, chopped",
    "0.25 cup diced sun-dried tomatoes",
    "3 cups diced artisanal bread",
    "2 cups heavy whipping cream",
    "2 cups shredded sharp Cheddar cheese",
    "5 eggs",
    "1 cup whole milk",
    "1 cup shredded Gruyere cheese",
    "1 teaspoon kosher salt",
    "1 teaspoon cracked black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sausage, pumpkin, onion, and sun-dried tomatoes in a large skillet over medium heat; cook and stir until sausage is browned, 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer sausage mixture to a large bowl. Mix in bread, heavy cream, Cheddar cheese, eggs, milk, Gruyere cheese, salt, and pepper. Spread mixture in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and golden, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
