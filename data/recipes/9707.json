  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "1 cup solid pack pumpkin puree",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "2.25 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1 cup halved fresh cranberries",
    "0.5 cup chopped walnuts",
    "1 tablespoon orange zest"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until light and fluffy. Beat in pumpkin purée, egg, and vanilla extract until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, baking soda, cinnamon, and salt into pumpkin mixture; stir until well blended. Stir in cranberries, walnuts, and orange zest until evenly distributed. Drop teaspoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 10 to 12 minutes. Transfer cookies to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
