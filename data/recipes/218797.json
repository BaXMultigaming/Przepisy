  "ingredients": [
    "2 tablespoons corn oil",
    "1 extra large onion, thinly sliced",
    "1.5 teaspoons hot pepper sauce (such as Frank's RedHot®)",
    "1 teaspoon prepared yellow mustard",
    "1 teaspoon white sugar",
    "1 teaspoon chili powder",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon ground cayenne pepper",
    "0.5 cup water",
    "2 tablespoons tomato paste"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Add sliced onion; cook and stir until onion has softened and turned translucent, about 5 minutes. Stir in hot sauce, yellow mustard, sugar, chili powder, salt, black pepper, and cayenne pepper. Reduce heat to medium-low, and continue to cook for about 5 minutes. Stir in water and tomato paste; simmer until liquid has reduced, about 20 minutes.",
