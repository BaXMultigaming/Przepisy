  "ingredients": [
    "0.75 cup butter, softened",
    "0.5 cup white sugar",
    "2 egg yolks",
    "1.75 cups all-purpose flour",
    "0.5 cup fruit preserves, any flavor"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ehpAHK1qtM4E7RtgWUynXXok9Cc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-25100-jam-filled-butter-cookies-ddmfs-step-1-029-c9c1fef313b542f49c91344d5f934bd5.jpg"
      ],
      "image": "assets/images/25100/step_01.webp"
    },
    {
      "text": "Beat butter, sugar, and egg yolks together in a medium bowl with an electric mixer until light and fluffy; gradually mix in flour until a soft dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lvtJGGt-U5WU7yU55fXXlEqz3AQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-25100-jam-filled-butter-cookies-ddmfs-step-2-030-e4dd684fb05740f18e95b91291f7c801.jpg"
      ],
      "image": "assets/images/25100/step_02.webp"
    },
    {
      "text": "Roll dough into 1-inch balls; place balls onto ungreased cookie sheets about 2 inches apart. Use your finger or an instrument of similar size to make a well in the center of each cookie; fill the hole with 1/2 teaspoon of preserves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/weOl0DMG1Sr1TAjCDIHjzI4QcGw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-25100-jam-filled-butter-cookies-ddmfs-step-3-038-203a090fc4434f7fafce63491946cb77.jpg"
      ],
      "image": "assets/images/25100/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown on the bottom, 8 to 10 minutes. Remove from cookie sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K9bizN_uE1SVEOBDDAA52SI5p_o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-25100-jam-filled-butter-cookies-ddmfs-step-4-057-a04d13c32cec4babaad39d3379131d31.jpg"
      ],
      "image": "assets/images/25100/step_04.webp"
    }
