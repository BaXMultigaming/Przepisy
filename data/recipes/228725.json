  "ingredients": [
    "4 cups cubed potatoes",
    "6 slices bacon",
    "1 cup diced celery",
    "3 green onions, diced",
    "0.5 cup mayonnaise",
    "0.25 cup vinegar",
    "2 teaspoons white sugar",
    "1 teaspoon Dijon mustard",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low; simmer until tender, about 20 minutes. Drain. Transfer to a large baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels; crumble and sprinkle over potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook celery and green onion in the skillet over medium heat, stirring, until celery is tender, about 5 minutes; transfer to the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, vinegar, sugar, mustard, salt, and black pepper together in a bowl until smooth; pour over potatoes and toss to combine. Sprinkle potato mixture with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, 20 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
