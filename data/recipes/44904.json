  "ingredients": [
    "0.5 cup butter, melted",
    "0.75 cup chocolate chips",
    "0.5 cup all-purpose flour",
    "0.5 cup brown sugar",
    "0.5 cup white sugar",
    "2 eggs, beaten",
    "1 teaspoon vanilla extract",
    "1 cup chopped pecans",
    "0.5 cup flaked coconut",
    "1 (9 inch) deep dish pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour warm melted butter over ¾ cup chocolate chips in a large bowl; stir until smooth. Whisk flour, brown sugar, and white sugar together in a separate bowl; stir into chocolate mixture. Stir in eggs and vanilla extract. Fold in pecans, coconut, and remaining ¼ cup chocolate chips; pour into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is set (it might crack slightly), 35 to 40 minutes. The pie is best if underbaked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
