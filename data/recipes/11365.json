  "ingredients": [
    "6 ounces cream cheese",
    "2 cups all-purpose flour",
    "1 cup butter",
    "1 (14 ounce) package individually wrapped caramels",
    "0.5 cup evaporated milk",
    "0.5 cup white sugar",
    "1 cup shortening",
    "0.33333298563957 cup evaporated milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, butter, and flour; mix to form a dough. Pinch off 48 equal pieces and press into mini tassie pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes or until lightly brown. Cool slightly, then carefully remove from the pans as they can break easily.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt caramels and 1/2 cup evaporated milk in a microwave-safe bowl in the microwave on medium-high heat. Stir until creamy. Pour melted caramel into shells and top with frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the frosting: Beat sugar, 1/3 cup evaporated milk, shortening, and vanilla until light and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
