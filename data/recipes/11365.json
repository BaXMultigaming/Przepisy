  "title": "Caramel Cups",
  "description": "These cute caramel cups have a rich, flaky crust and a sweet caramel filling. This recipe makes 4 dozen bite-sized treats — perfect for a party!",
  "authors": [
    "Dawn"
  ],
  "date_published": "1999-04-06T09:28:50-04:00",
