  "ingredients": [
    "1 (3 pound) beef chuck roast",
    "4 cloves garlic, sliced",
    "1 (16 ounce) jar pepperoncini",
    "8 hoagie rolls, split lengthwise",
    "16 slices provolone cheese"
  ],
  "steps": [
    {
      "text": "Make small cuts in roast, and insert garlic slices in cuts. Place roast in the slow cooker, and pour the entire contents of the jar of pepperoncini, including liquid, over meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook on Low for 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When making the sandwiches, place meat in rolls, top with cheese, and zap in a microwave for a few seconds. Don't forget to use the pepperoncini in the sandwiches!",
      "section": null,
      "name": null,
