  "ingredients": [
    "1.5 pounds lean ground beef",
    "0.5 cup crushed buttery round crackers",
    "0.75 cup shredded Cheddar cheese",
    "1 (1 ounce) package dry onion soup mix",
    "2 eggs, beaten",
    "0.25 cup ketchup",
    "2 tablespoons steak sauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the ground beef, crushed crackers, Cheddar cheese, and onion soup mix in a large bowl until well combined. Whisk the eggs, ketchup, and steak sauce in a separate bowl until smooth. Mix the eggs into the meat until evenly combined, if the mixture seems too dry, add a little water. Press into a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the meatloaf reaches 160 degrees F (71 degrees C) and is no longer pink in the center, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
