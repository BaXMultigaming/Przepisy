  "ingredients": [
    "2 cups all-purpose flour",
    "1.25 cups brown sugar",
    "0.5 cup white sugar",
    "3 (1.23 ounce) packages instant apple-cinnamon oatmeal",
    "1 teaspoon salt",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 cup chopped walnuts, or to taste",
    "0.5 cup raisins, or to taste",
    "1 medium banana",
    "0.25 cup unsweetened cocoa powder",
    "0.25 cup chocolate-flavored almond milk",
    "0.75 cup vegan margarine",
    "0.5 cup orange juice",
    "1 tablespoon vanilla extract",
    "1 tablespoon molasses"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, brown sugar, sugar, instant oatmeal, salt, baking powder, cinnamon, and nutmeg. Stir in walnuts and raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine banana, cocoa, and almond milk in a food processor; process until pureed. Transfer to a bowl and mix in vegan margarine, orange juice, vanilla, and molasses until combined. Pour into the dry mixture and mix with a spatula to combine. Roll dough into 1-inch balls and place 2 inches apart on the prepared cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned but not hardened, about 12 minutes. Cool on the baking sheet for 2 to 4 minutes before removing to a wire rack. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
