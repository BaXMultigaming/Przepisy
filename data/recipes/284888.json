  "title": "Vegan Chocolate Oatmeal Cookies",
  "description": "Perfect for breakfast, snack time, or dessert, these sticky, sweet chocolate oatmeal cookies taste better than any made with dairy.",
  "authors": [
    "nicolelauralis"
  ],
