  "ingredients": [
    "1 cup rolled oats",
    "0.33333334326744 cup brown sugar",
    "0.5 cup all-purpose flour",
    "1 teaspoon finely chopped crystallized ginger",
    "1 teaspoon ground cinnamon",
    "0.25 cup butter",
    "2 tablespoons white sugar",
    "2 tablespoons all-purpose flour",
    "2 teaspoons finely chopped crystallized ginger",
    "8 cups peeled and sliced pears",
    "1 pint vanilla ice cream"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Grease a 2-quart casserole dish or 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NvhsRbJkBswZHy5ikaBsLQjdVBw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/91539-classic-pear-crisp-VAT-step-01-0906ee72ca7b449ab413dfb317565819.jpg"
      ],
      "image": "assets/images/91539/step_01.webp"
    },
    {
      "text": "Stir oats, brown sugar, 1/2 cup flour, 1 teaspoon crystallized ginger, and cinnamon together in a medium bowl; rub in butter until mixture is crumbly with pea sized lumps. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WDkbbdsHjcDQOg007zxAu5UNZoA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/91539-classic-pear-crisp-VAT-step-02-3147f504e4774ceab201b00fbe1413f9.jpg"
      ],
      "image": "assets/images/91539/step_02.webp"
    },
    {
      "text": "Stir white sugar, 2 tablespoons flour, and 2 teaspoons of crystallized ginger together in a separate bowl. Add sliced pears and toss to blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BTtzcIu-nEKYAIpjbMikVNAZgNs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/91539-classic-pear-crisp-VAT-step-03-8d903b8c3b8446d6a5d573975b7ed248.jpg"
      ],
      "image": "assets/images/91539/step_03.webp"
    },
    {
      "text": "Transfer pear mixture into prepared baking dish; sprinkle with crisp topping mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oAVubklm0QOaVuSsbjuG8UWMg6M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/91539-classic-pear-crisp-VAT-step-04-2dfeb29607834c3791af5c835e0695a4.jpg"
      ],
      "image": "assets/images/91539/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until pears are soft and topping is golden brown, about 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dLYeVqaVbq7MN1KpgclHgqQkzvg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/91539-classic-pear-crisp-VAT-step-05-7f0d9802dadf4116843247cc3c3fa377.jpg"
      ],
      "image": "assets/images/91539/step_05.webp"
    },
    {
      "text": "Cool slightly before serving with vanilla ice cream.",
      "section": null,
      "name": null,
      "url": null,
