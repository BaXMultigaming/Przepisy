  "ingredients": [
    "1 cup shortening",
    "1 cup packed brown sugar",
    "0.5 cup white sugar",
    "2 eggs",
    "1.5 teaspoons vanilla extract",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1.5 cups candy-coated milk chocolate pieces (such as M&M's®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat shortening, brown sugar, white sugar, eggs, and vanilla in a mixing bowl until light and fluffy, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dnNc6Inl3AVmgFFwtOln7wNnU3w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10785-RobbisMMCookies-ddmfs-Step1-0901-232f5b78ff1442b28702a2619262867d.jpg"
      ],
      "image": "assets/images/10785/step_02.webp"
    },
    {
      "text": "Add flour, baking soda, and salt; blend well. Stir in 1/2 of the chocolate candies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3ljKGPDeRzQHSp93ZxxwTcyvh24=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10785-RobbisMMCookies-ddmfs-Step2-0902-e05878fd2b1d450bb0ecb6d87626b958.jpg"
      ],
      "image": "assets/images/10785/step_03.webp"
    },
    {
      "text": "Drop dough by teaspoonfuls onto an ungreased baking sheet. Use remaining candies to decorate dough balls; press down slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KlIpDp0upc-Xyub3zAup82yJNjo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10785-RobbisMMCookies-ddmfs-Step4-0904-e612f2b6f7884c3eb0fbe4e0449483a1.jpg"
      ],
      "image": "assets/images/10785/step_04.webp"
    },
    {
      "text": "Bake in batches in the preheated oven until lightly browned with soft centers, 9 to 11 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X8Lr88YsGOV8WCxRF-uBTvjwyys=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10785-robbis-mms-cookies-DDMFS-4x3-1357-57ec5ec5da01448c8666fd73d7789931.jpg"
      ],
      "image": "assets/images/10785/step_06.webp"
    }
