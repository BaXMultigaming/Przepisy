  "title": "Pepper Jack Cornbread Biscuits",
  "description": "Buttery layered biscuits that have a slight taste of cornbread and a subtle spice of pepper jack cheese. These are perfect to go along with a soup or stew.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2023-01-17T10:21:08-05:00",
