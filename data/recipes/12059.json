  "ingredients": [
    "1 (8 ounce) package wide egg noodles",
    "1 pound lean ground beef",
    "1 onion, chopped",
    "1 (4.5 ounce) can sliced mushrooms",
    "1 pinch garlic salt",
    "ground black pepper to taste",
    "1.5 tablespoons white sugar",
    "1 tablespoon Worcestershire sauce",
    "2 (15 ounce) cans tomato sauce",
    "8 ounces sharp Cheddar cheese, shredded"
  ],
  "steps": [
    {
      "text": "Cook pasta in a large pot of boiling salted water until al dente. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, cook ground beef, onion, and mushrooms. Drain grease. Mix in garlic salt, ground black pepper, sugar, Worcestershire sauce, and tomato sauce. Simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a greased 2 quart casserole dish, layer half of the cooked egg noodles, then half of the sauce mixture, followed by half of the grated cheese. Repeat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 375 degree (190 degree C) oven for 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
