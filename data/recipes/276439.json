  "ingredients": [
    "0.5 pound bacon ends and pieces",
    "1 large white onion, chopped",
    "1 tablespoon minced garlic",
    "0.25 teaspoon red pepper flakes, or to taste",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "4 cups water",
    "2 bunches collard greens, coarsely chopped"
  ],
  "steps": [
    {
      "text": "Cook bacon in a heavy pot over medium-high heat, turning occasionally, until fat begins to render, about 5 minutes. Drain and discard ½ bacon drippings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium; add onion. Cook, stirring often, for about 5 minutes. Add garlic, pepper flakes, salt, and black pepper; cook and stir for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase heat to high. Add 3 cups water to the pot; bring to a boil while scraping the browned bits of food off the bottom of the pot with a wooden spoon. Add collard greens and remaining 1 cup water; bring to a boil. Reduce heat; simmer until greens are tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
