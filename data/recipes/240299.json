  "ingredients": [
    "1.5 cups white sugar",
    "1.5 cups brown sugar",
    "0.5 cup butter, softened",
    "1 cup creamy peanut butter",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 (8 ounce) package chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar and brown sugar together in a large bowl using an electric mixer until smooth and fluffy; beat in peanut butter until smooth. Beat eggs and vanilla extract into sugar mixture until creamy. Mix flour and baking soda into sugar mixture until dough is just mixed; fold in chocolate chips. Form dough into ping pong ball-size balls and arrange on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are golden brown, about 20 minutes. Cool cookies on the baking sheet for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
