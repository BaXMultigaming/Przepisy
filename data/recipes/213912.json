  "ingredients": [
    "1 pound ground beef or turkey",
    "1 medium onion, chopped",
    "1 green bell pepper, chopped",
    "1 (14.5 ounce) can Mexican or chili-style stewed tomatoes, undrained",
    "0.5 cup water",
    "1 (1.25 ounce) package taco seasoning mix",
    "2 cups elbow macaroni or small shells, cooked and drained",
    "2 cups Sargento ® Shredded Reduced Fat 4 Cheese Mexican Cheese, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook ground beef, onion, and bell pepper in a large skillet over medium heat until beef is crumbly and no longer pink, about 5 minutes; pour off drippings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5G4Od86u0rM96d2V61o_NV2BGQw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213912-chili-mac-DDMFS-step-1-BG-2763-ee11700d964746a0ab34966a0b6580b5.jpg"
      ],
      "image": "assets/images/213912/step_02.webp"
    },
    {
      "text": "Add tomatoes, water, and taco seasoning; simmer, stirring occasionally, for 5 minutes. Remove from heat. Stir cooked pasta into meat mixture until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P38ZtaXqaBCvGgU7wJ22UQwK8r0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213912-chili-mac-DDMFS-step-2-BG-2766-fe08e5e2053b41899c5d55fbb27d6cec.jpg"
      ],
      "image": "assets/images/213912/step_03.webp"
    },
    {
      "text": "Spoon 3 cups meat mixture into an 11x7-inch baking dish. Sprinkle with 1 cup cheese; top with remaining meat mixture. Cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2vh086MIlxbzvjVCnRGyBCWcEZY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213912-chili-mac-DDMFS-step-3-BG-2772-c3471b316fa0405ebd78e3d0ac73e07e.jpg"
      ],
      "image": "assets/images/213912/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Remove foil; sprinkle with remaining cheese. Continue baking until cheese is melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8wkguCJjJ1Ll4Mz3GFEoxAEu48M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213912-chili-mac-DDMFS-step-4-BG-2780-b17d2d81cbbe424b997a19ab2cf30e20.jpg"
      ],
      "image": "assets/images/213912/step_05.webp"
    }
