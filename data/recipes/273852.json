  "ingredients": [
    "cooking spray",
    "1 large egg, beaten",
    "1.25 cups panko bread crumbs",
    "2 teaspoons garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon ground paprika",
    "1 teaspoon kosher salt",
    "1 teaspoon ground black pepper",
    "4 skinless, boneless chicken tenders, cut into 1/2-inch strips lengthwise"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fuN2SgA5czIdEOam4mWWvmOYNtQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273852-EasyBakedChickenTenders-Step1-0323-285bf6472e2d4678b572354631a61ddf.jpg"
      ],
      "image": "assets/images/273852/step_01.webp"
    },
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with aluminum foil and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place egg in a shallow dish. Place panko, garlic powder, onion powder, paprika, salt, and pepper into a large zip-top freezer bag and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3FHtzni1-xnjRPKSnGjqxsO1_70=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273852-EasyBakedChickenTenders-Step2-0325-b4d0f0aa1d4a40f6b01a0660883a74dd.jpg"
      ],
      "image": "assets/images/273852/step_03.webp"
    },
    {
      "text": "Dip 2 chicken strips into egg, then place into panko mixture and shake to coat. Place coated chicken pieces onto the prepared baking sheet. Repeat with remaining chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-LvVBlDHDVeyJYz0GzyH1a362xk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273852-EasyBakedChickenTenders-Step3-0327-6b758c78000f4c9dafc333c6259a25fd.jpg"
      ],
      "image": "assets/images/273852/step_04.webp"
    },
    {
      "text": "Spray each chicken tender with cooking spray twice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake tenders in the preheated oven for 7 minutes. Flip and continue to bake on opposite side until no longer pink in the centers, about 7 minutes more. Remove from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil tenders in the preheated oven for extra crunch, about 1 to 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I2Re9o1AwfDTEBUfc718a32RHKE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273852-EasyBakedChikenTenders-Step4-0344-873821020bfe4bd7a39e5aa8a17de748.jpg"
      ],
      "image": "assets/images/273852/step_08.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/smc8F-SohMO5r1TaufxlkrULXjo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273852-EasyBakedChikenTenders-3X2-0354-1c36a6289fac49ac8dba9c598602116a.jpg"
      ],
      "image": "assets/images/273852/step_09.webp"
    }
