  "ingredients": [
    "0.75 pound ground round",
    "3 cups water",
    "1 (12 ounce) can tomato paste",
    "0.5 cup sweet pickle relish",
    "0.5 cup chopped onion",
    "2 tablespoons Worcestershire sauce",
    "2 tablespoons prepared mustard",
    "4 teaspoons chili powder, or more to taste",
    "2 teaspoons salt",
    "2 teaspoons white sugar"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Add water, tomato paste, pickle relish, onion, Worcestershire sauce, mustard, chili powder, salt, and sugar; bring to a boil. Reduce heat to medium-low and simmer, stirring occasionally, until sauce is thickened, about 30 minutes.",
