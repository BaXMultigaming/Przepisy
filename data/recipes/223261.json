  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "3 dried chipotle chiles, stemmed and seeded",
    "2 dried guajillo chiles, stemmed and seeded",
    "2 dried ancho chiles, stemmed and seeded",
    "2 cups chicken broth",
    "1 dinner roll, torn into pieces",
    "2 corn tortillas, cut into 1-inch strips",
    "5 tomatillos, cut in half crosswise",
    "2 tomatoes, cut in half crosswise",
    "1 tablespoon lard",
    "1 onion, halved and thinly sliced",
    "0.5 head garlic, peeled and sliced",
    "0.33333334326744 cup chopped peanuts",
    "0.25 cup raisins",
    "2 tablespoons cumin seeds",
    "1 tablespoon dried thyme",
    "6 whole allspice berries",
    "5 whole cloves",
    "3 cinnamon sticks",
    "1 cup chicken broth",
    "5 ounces dark chocolate, coarsely chopped",
    "3 tablespoons white sugar",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T55t9iYU7uN5qPIXEHA2NJuYbcc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223261-authentic-mole-sauce-step1-3x4-01350644-33d7f9b4b8f248d7a41f1515ae41dcf3.jpg"
      ],
      "image": "assets/images/223261/step_01.webp"
    },
    {
      "text": "Toast chipotle, guajillo, and ancho chiles in a dry pan over medium heat, stirring constantly, until warm and aromatic, about 3 minutes. Transfer to a blender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/auEtrHCZpLMPZ5soBkJddFDyAvY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223261-authentic-mole-sauce-step2-3x4-013506441485-d9f63fce5c0649dea5b263ee51154716.jpg"
      ],
      "image": "assets/images/223261/step_02.webp"
    },
    {
      "text": "Heat 2 cups chicken broth in a saucepan until it begins to simmer, about 5 minutes. Pour broth into the blender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X725BzPbW5kpoCIe7XbWjUWt3zw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223261-authentic-mole-sauce-step3-3x4-013506441489-d6f0056280614bd4bbcd9d764468fb70.jpg"
      ],
      "image": "assets/images/223261/step_03.webp"
    },
    {
      "text": "Toast dinner roll pieces and tortilla strips in a dry pan over medium heat, stirring constantly, until lightly browned, about 3 minutes. Transfer to the blender with chicken broth and chiles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3pDsE1AdLCITpZd1vwXkhs2LqIU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223261-authentic-mole-sauce-step4-3x4-013506441494-3359c124ceba454a8f09950bc2921a2c.jpg"
      ],
      "image": "assets/images/223261/step_04.webp"
    },
    {
      "text": "Allow chiles, toasted bread, and tortillas to soak, fully submerged, in the chicken broth until softened, about 10 minutes. Blend the mixture until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mLc-LSNV-Ynxcna_z_moLTUXQuY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223261-authentic-mole-sauce-step5-3x4-013506441503-d83f7268dfc74195b6e0ec038bd1f6a3.jpg"
      ],
      "image": "assets/images/223261/step_05.webp"
    },
    {
      "text": "Cook tomatillos and tomatoes in a dry skillet on medium-high heat until soft and blackened, 3 to 4 minutes per side. Place tomatoes in the blender with the chile puree.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-ibrJmA8w2MBuZVkKshR0zdeI2Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223261-authentic-mole-sauce-step6-3x4-013506441507-729a516d519d4a9087a4b81a11607bb4.jpg"
      ],
      "image": "assets/images/223261/step_06.webp"
    },
    {
      "text": "Melt lard in a large skillet over medium heat. Stir in onion, garlic, peanuts, raisins, cumin seeds, thyme, allspice berries, cloves, and cinnamon sticks; cook and stir until onions are soft and golden, 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TFefU93KE00q-M2s3cZ01pG2x38=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223261-authentic-mole-sauce-step7-3x4-013506441517-2c101f696b8043ceb7f4bbf83c01dd82.jpg"
      ],
      "image": "assets/images/223261/step_07.webp"
    },
    {
      "text": "Remove the cinnamon sticks and other whole spices; add onion mixture to the blender with the chile-tomato mixture and blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P93uyD9fPk546EDdkdicz1v271s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223261-authentic-mole-sauce-step8-3x4-013506441519-d066cdb17f6e4a60b26e2227cca2acba.jpg"
      ],
      "image": "assets/images/223261/step_08.webp"
    },
    {
      "text": "Pour chile puree into a large saucepan over medium heat. Stir in 1 cup chicken broth, chocolate, sugar, and salt. Bring mixture to a simmer; stir until chocolate is melted and sauce is thickened and slightly reduced, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J4fPdAxDr51chVtV2VCsjumiHSs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223261-authentic-mole-sauce-step10-3x4-013506441524-7a849c3d2d1f4186953e503c48e78d4b.jpg"
      ],
      "image": "assets/images/223261/step_09.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_kU_b5XKmXTIo7UVg3QNtOz6B9Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223261-authentic-mole-sauce-beauty-3x4-013506441524-85ae56ddc70b40cfadc791a7ceb0ae8f.jpg"
      ],
      "image": "assets/images/223261/step_10.webp"
    }
  ],
