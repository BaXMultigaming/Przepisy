  "ingredients": [
    "1 cup white sugar",
    "0.25 cup all-purpose flour",
    "1 egg, beaten",
    "3 cups milk",
    "1 teaspoon vanilla extract",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Whisk together sugar and flour in a saucepan. Stir in egg, then gradually mix in milk until well blended. Bring to a boil, constantly stirring. As soon as it boils and becomes thick, remove from the heat and stir in vanilla and butter. Spoon over biscuits or toast and enjoy!",
