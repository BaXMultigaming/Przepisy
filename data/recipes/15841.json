  "ingredients": [
    "1 pound ground beef",
    "1 (1.25 ounce) package taco seasoning mix",
    "1 (10.75 ounce) can condensed tomato soup",
    "3.75 cups water",
    "1 cup chopped onion",
    "4 carrots, chopped",
    "3 potatoes, peeled and cubed",
    "1 stalk celery, chopped",
    "1 (15 ounce) can pork and beans"
  ],
  "steps": [
    {
      "text": "Sauté ground beef in a large pot over medium-high heat. Add taco seasoning, condensed soup, water, onion, carrots, potatoes, celery, and beans. Reduce heat to low. Cover and simmer until the vegetables are tender, about 30 minutes.",
