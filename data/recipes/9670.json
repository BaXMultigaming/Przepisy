  "ingredients": [
    "0.75 cup all-purpose flour",
    "0.75 cup whole wheat flour",
    "0.5 cup ground walnuts",
    "0.75 teaspoon salt",
    "2 teaspoons baking powder",
    "0.5 cup shortening",
    "1.75 cups packed brown sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1.3333300352097 cups granola",
    "0.5 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Lightly grease a 9 inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, cream the shortening, brown sugar, eggs, and vanilla extract. Beat well after the addition of each ingredient.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In small saucepan, cover the cranberries in water and boil for 10 minutes. Drain and chop into small pieces. Add to egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly add in white and wheat flours, walnuts, salt and baking powder. Mix until well blended. Fold in granola and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread dough into baking pan and bake 20 to 25 minutes. Let cool before cutting into bars. Store in airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
