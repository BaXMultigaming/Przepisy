  "ingredients": [
    "2 cups butter, softened",
    "2 cups white sugar",
    "4 egg yolks",
    "4 cups all-purpose flour",
    "1.5 cups raspberry jam"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the butter and sugar until light and fluffy. Blend in the egg yolks. Gradually mix in the flour to form a dough. With lightly floured hands, press half of the dough into the bottom of the prepared pan. Spread evenly with raspberry jam. Flatten pieces of the remaining dough and place them over the raspberry layer to cover the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes in the preheated oven, until lightly golden. Cool slightly before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
