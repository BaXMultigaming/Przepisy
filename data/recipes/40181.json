  "ingredients": [
    "4.5 cups all-purpose flour",
    "2.5 cups white sugar",
    "1 tablespoon baking powder",
    "1 tablespoon baking soda",
    "1 tablespoon ground cinnamon",
    "1.5 teaspoons salt",
    "2 cups vegetable oil",
    "6 eggs",
    "3 cups shredded zucchini",
    "1 (20 ounce) can crushed pineapple, drained",
    "3 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour four 12-cup muffin tins or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking powder, baking soda, cinnamon, and salt together in a large bowl; make a well in the center. Pour oil and eggs into the well: stir in zucchini, pineapple, and vanilla extract until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter among the prepared muffin cups, filling each ⅔ to ¾ full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
