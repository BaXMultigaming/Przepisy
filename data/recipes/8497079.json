  "title": "Donut Pan Egg Sandwiches",
  "description": "Use your donut pan to create these easy egg sandwiches with cheese and sausage.",
  "authors": [
    "Annie Campbell"
  ],
  "date_published": "2022-10-19T11:04:28-04:00",
  "date_modified": "2025-01-29T12:41:57-05:00",
