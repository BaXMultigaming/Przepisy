  "ingredients": [
    "0.5 cup plain yogurt",
    "0.25 cup light sour cream",
    "2 tablespoons ketchup",
    "2 tablespoons minced onion",
    "1 tablespoon lime juice",
    "1 tablespoon finely chopped cilantro",
    "1 teaspoon ground cumin",
    "0.5 teaspoon chili powder, or to taste",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Stir yogurt, sour cream, ketchup, onion, lime juice, cilantro, cumin, chili powder, garlic powder, and salt together in a bowl with a whisk until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bowl with plastic wrap and refrigerate until chilled, at least 10 minutes.",
