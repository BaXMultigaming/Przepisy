  "ingredients": [
    "1 cup honey",
    "2 tablespoons orange juice",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon almond extract",
    "1 (8 pound) fully cooked whole ham"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Stir honey, orange juice, cinnamon, and cloves together in a small bowl; set aside. Stir in almond extract if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ham in a shallow roasting pan. Bake in the preheated oven for 1 hour and 15 minutes. Remove ham from the oven, and baste with the honey glaze. Return to the oven; continue cooking until the ham reaches an internal temperature of 140 degrees F (60 degrees C), about 45 minutes longer. Baste occasionally as the ham finishes baking.",
