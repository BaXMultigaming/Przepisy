  "ingredients": [
    "0.5 pound ground pork",
    "0.5 pound ground beef",
    "0.25 cup rolled oats",
    "0.25 cup milk",
    "1 large egg, lightly beaten",
    "0.75 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "0.13 teaspoon ground black pepper",
    "1 tablespoon olive oil",
    "1 small onion, diced",
    "0.67 cup pure maple syrup",
    "0.25 cup prepared yellow mustard",
    "2 tablespoons ketchup",
    "0.5 teaspoon hot pepper sauce (such as Tabasco®)",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground pork, ground beef, oats, milk, egg, salt, garlic powder, and pepper in a large bowl. Shape into 24 meatballs, about 1 1/2 inches in diameter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Cook meatballs until evenly browned, about 8 to 10 minutes. Place meatballs into an 8x8-inch casserole dish and scatter onion over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine maple syrup, mustard, ketchup, hot pepper sauce, and salt for sauce in a medium bowl. Pour over meatballs and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and cooked through, about 30 minutes, stirring halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
