  "title": "Marry Me Chicken",
  "description": "Marry me chicken is a deliciously creamy chicken dish with a rich sun-dried tomato sauce. So quick and easy, you&#39;re sure to fall in love with it!",
  "authors": [
    "thedailygourmet"
  ],
  "date_published": "2019-09-24T22:47:57-04:00",
  "date_modified": "2025-10-20T09:21:28-04:00",
  "prep_time": "PT15M",
