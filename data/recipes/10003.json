  "ingredients": [
    "1 cup butter",
    "0.5 cup confectioners' sugar",
    "0.25 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.5 cup cornstarch"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together butter, confectioners' sugar, and vanilla in a medium bowl with an electric mixer until smooth. Stir in flour and cornstarch. Pop dough into your cookie press, and away you go! Press cookies out onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes in the preheated oven, or until the peaks are golden.",
      "section": null,
