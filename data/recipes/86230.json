  "ingredients": [
    "4 tablespoons water",
    "2 tablespoons ketchup",
    "1 tablespoon soy sauce",
    "2 teaspoons cornstarch",
    "1 teaspoon honey",
    "0.5 teaspoon crushed red pepper",
    "0.25 teaspoon ground ginger",
    "1 tablespoon vegetable oil",
    "0.25 cup sliced green onions",
    "4 cloves garlic, minced",
    "12 ounces cooked shrimp, tails removed"
  ],
  "steps": [
    {
      "text": "Stir together water, ketchup, soy sauce, cornstarch, honey, crushed red pepper, and ground ginger in a small bowl until combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Cook and stir green onions and garlic in hot oil until fragrant, about 30 seconds. Stir in cooked shrimp; toss to coat with oil. Pour in ketchup mixture. Cook and stir until sauce is bubbly and thickened.",
