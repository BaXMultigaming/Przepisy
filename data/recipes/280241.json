  "ingredients": [
    "1 cup white sugar",
    "0.5 cup unsalted butter, melted",
    "0.75 cup sour cream",
    "3 large eggs",
    "2 teaspoons lemon extract",
    "1.5 cups all-purpose flour",
    "0.25 teaspoon baking soda",
    "1 tablespoon confectioners' sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour an 8x4-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and butter together in a large bowl until light and fluffy. Mix in sour cream, eggs, and lemon extract. Add flour and baking soda; mix until well combined. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove loaf from the pan and dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
