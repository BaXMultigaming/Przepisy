  "ingredients": [
    "4 ounces diced salt pork",
    "2 pounds chicken parts",
    "8 cups water",
    "1 (28 ounce) can whole peeled tomatoes, chopped",
    "3 potatoes, cubed",
    "3 onions, chopped",
    "2 cups canned whole kernel corn",
    "1 (10 ounce) package frozen lima beans",
    "1 tablespoon Worcestershire sauce",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Combine salt pork, chicken, and water in a large pot; bring to a boil. Reduce heat to low, cover, and simmer until chicken is tender, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove meat from chicken, chop into bite-sized pieces, and return to pot; discard skin and bones.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomatoes, potatoes, onions, corn, lima beans, Worcestershire sauce, salt, and pepper. Simmer, uncovered, stirring occasionally, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
