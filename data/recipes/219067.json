  "ingredients": [
    "1 cup butter at room temperature",
    "1 cup firmly packed light brown sugar",
    "0.5 cup white sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2 cups rolled oats",
    "1.5 cups all-purpose flour",
    "0.5 cup chocolate chips",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together in a large bowl until thoroughly combined and creamy. Beat in eggs, one at a time, mixing well after each addition. Stir in vanilla extract until combined. Stir in rolled oats, flour, chocolate chips, raisins, walnuts, baking soda, baking powder, and salt until all ingredients moistened; spread into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes. Let cool in the pan for about 5 minutes before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
