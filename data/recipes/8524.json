  "ingredients": [
    "3 tablespoons olive oil",
    "1 tablespoon minced onion",
    "1 clove crushed garlic",
    "1 teaspoon dried thyme",
    "0.5 teaspoon dried rosemary, crushed",
    "0.25 teaspoon ground sage",
    "0.25 teaspoon dried marjoram",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.125 teaspoon hot pepper sauce",
    "4 bone-in chicken breast halves, with skin",
    "1.5 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, prepare basting sauce by combining olive oil, onion, garlic, thyme, rosemary, sage, marjoram, salt, pepper, and hot pepper sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn chicken breasts in sauce to coat thoroughly. Place skin-side up in a shallow baking dish. Cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast chicken in the preheated oven, basting occasionally with pan drippings, for about 35 to 45 minutes. Remove to a warm platter, spoon pan juices over chicken and sprinkle with fresh parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
