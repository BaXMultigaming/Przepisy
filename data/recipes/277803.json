  "ingredients": [
    "cooking spray",
    "2 tablespoons all-purpose flour",
    "1 pinch dried basil",
    "1 pinch chili powder",
    "salt and ground black pepper to taste",
    "1 egg",
    "1 tablespoon water",
    "3 cups crushed cornflakes",
    "6 skinless, boneless chicken tenders"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Coat a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, basil, chili powder, salt, and pepper together in a bowl. Mix egg and water together in another bowl. Pour crushed cereal into a third bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each tender in the flour mixture first, shaking off excess. Dip in egg and then in crushed cereal. Place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and no longer pink in the centers, 10 to 12 minutes on each side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
