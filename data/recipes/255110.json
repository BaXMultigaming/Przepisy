  "ingredients": [
    "2 cups almond milk",
    "0.5 cup vanilla Greek-style yogurt",
    "0.25 cup melted butter",
    "2 teaspoons vanilla extract",
    "1.75 cups gluten-free flour blend",
    "1 cup gluten-free chocolate chips",
    "0.25 cup gluten-free oat flour",
    "3 tablespoons white sugar",
    "1.5 teaspoons baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, yogurt, butter, and vanilla extract together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix gluten-free flour, chocolate chips, oat flour, sugar, baking powder, and salt together in a bowl. Stir milk mixture into the flour mixture until well incorporated. Let batter stand, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/2 cup of batter onto the preheated iron and bake until crisp and golden, according to manufacturer's instructions, about 3 minutes. Transfer to a wire rack to cool. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
