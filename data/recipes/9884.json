  "title": "Cappuccino Brownies",
  "description": "Great, creamy coffee-flavored milk chocolate brownies. These freeze well, too.",
  "authors": [
    "Mary Beth Davis"
  ],
  "date_published": "1997-08-12T20:25:03-04:00",
