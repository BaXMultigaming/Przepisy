  "ingredients": [
    "5 tomatoes, seeded and diced",
    "4 cloves garlic, minced",
    "0.5 cup chopped fresh basil",
    "0.5 cup olive oil",
    "salt to taste",
    "2 tablespoons grated Parmesan cheese",
    "1 pound pasta"
  ],
  "steps": [
    {
      "text": "Combine tomatoes, garlic, basil, and olive oil in a non-metal bowl. Stir in salt. Cover with plastic wrap. Allow to sit at room temperature at least 2 hours, or as long as 10 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook pasta in a large pot of boiling salted water until al dente. Drain. Pour uncooked sauce over hot pasta, and toss. Add grated Parmesan cheese to your liking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
