  "ingredients": [
    "0.25 cup butter",
    "1.5 cups heavy cream",
    "1 teaspoon Creole mustard",
    "2 (6 ounce) cans crabmeat, drained and flaked",
    "1 (4 ounce) can small shrimp, drained",
    "1 teaspoon Cajun seasoning",
    "salt and pepper to taste",
    "2 pounds grouper fillets",
    "1 tablespoon olive oil",
    "1 lemon, juiced",
    "1 teaspoon chopped fresh parsley",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven broiler. Cover a medium baking dish with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter with cream in a saucepan over medium heat, and blend in Creole mustard. Cook and stir until thickened. Mix in crab and shrimp. Season with Cajun seasoning, salt, and pepper. Cook until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place grouper in the prepared baking dish, and rub with olive oil, lemon juice, and parsley. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil grouper about 4 minutes on each side, until easily flaked with a fork. Spoon the crab and shrimp mixture over fish to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
