  "ingredients": [
    "1 (10 inch) soft flour tortilla",
    "2 eggs",
    "0.5 teaspoon milk",
    "0.5 teaspoon butter",
    "0.25 cup shredded Mexican cheese blend, or more to taste",
    "0.5 avocado - peeled, pitted, and diced",
    "0.25 cup salsa, or to taste",
    "1 pinch paprika, or to taste",
    "1 pinch sea salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Press tortilla into a tortilla shell mold or oven-proof bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, milk, and butter together in a microwave-safe bowl. Stir in Mexican cheese blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake tortilla in the preheated oven until crispy and brown, 5 to 7 minutes. Cool slightly before transferring from mold to serving dish, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook egg mixture in the microwave until set, 30 seconds to 1 minute. Remove egg mixture from the microwave and stir gently with a fork. Cook in the microwave until fully set, about 30 seconds more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cooked eggs in tortilla bowl; top with avocado, salsa, paprika, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
