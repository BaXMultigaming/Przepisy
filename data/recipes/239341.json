  "ingredients": [
    "1 (8 ounce) package cream cheese, at room temperature",
    "4 large whole-wheat sandwich wrap",
    "0.25 cup sweetened dried cranberries (such as Craisins®), or to taste",
    "12 slices turkey lunch meat",
    "1 cup fresh spinach, or to taste"
  ],
  "steps": [
    {
      "text": "Spread 1/4 of the cream cheese onto the middle of each sandwich wrap. Sprinkle 1 tablespoon cranberries onto cream cheese on each wrap. Arrange 3 slices turkey atop each wrap to cover most of wrap. Spread 1/4 cup spinach atop turkey.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Tightly roll wrap around fillings into a cylinder; cut into about twenty 1 1/4-inch slices; arrange on a serving platter.",
