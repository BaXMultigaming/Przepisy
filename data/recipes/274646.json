  "ingredients": [
    "2 tablespoons olive oil",
    "1 bunch scallions, diced",
    "1 teaspoon minced garlic, or more to taste",
    "1 medium zucchini, sliced 1/4-inch thick, or more to taste",
    "1 medium summer squash, sliced 1/4-inch thick, or more to taste",
    "0.25 teaspoon dried Italian seasoning, or to taste",
    "salt and ground black pepper to taste",
    "1 teaspoon chopped fresh basil, or to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a medium skillet over medium heat. Add scallions and garlic; sauté in hot oil until tender and fragrant, about 3 minutes. Add zucchini, summer squash, Italian seasoning, salt, and pepper; sauté until squash is tender, 8 to 12 minutes.",
