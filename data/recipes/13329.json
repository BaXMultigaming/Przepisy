  "ingredients": [
    "2 pounds ground beef",
    "1 onion, finely diced",
    "3 cloves garlic, minced",
    "2 (14.5 ounce) cans diced tomatoes with green chile peppers",
    "1 (15 ounce) can kidney beans",
    "1 (15 ounce) can pinto beans",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (8 ounce) can tomato sauce",
    "1 cup water",
    "2 tablespoons chili powder",
    "2 tablespoons white sugar",
    "1 tablespoon hot pepper sauce",
    "1 tablespoon ground cumin",
    "1 tablespoon salt",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat a large stockpot over medium-high heat. Cook and stir ground beef in the hot pot until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PUgIY05QDzDG0NKWv3cN9Q1P2XY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/758_QuickChili_Shot1_CD_556771-fb4cb293b69d4e12ad865b5c2ae6281e.jpg"
      ],
      "image": "assets/images/13329/step_01.webp"
    },
    {
      "text": "Add onion and garlic to beef and cook until onion is translucent, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TSjr71u8ICMyWMwPQkqCZokSepk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/758_QuickChili_Shot2_CD_556791-607ad5716f2f411c960355f9a60115c7.jpg"
      ],
      "image": "assets/images/13329/step_02.webp"
    },
    {
      "text": "Stir in diced tomatoes with chile peppers, kidney beans, pinto beans, tomatoes, tomato sauce, water, chili powder, sugar, hot pepper sauce, cumin, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mg5yaJbX6qB0vgqyDqK0e5TAy1s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/758_QuickChili_Shot3_CD_556871-807ef72320f84f3181036792aeb23dbb.jpg"
      ],
      "image": "assets/images/13329/step_03.webp"
    },
    {
      "text": "Bring to a boil, reduce heat, and simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-KuRF6Z5GMIM1WcJ_itfoX104rk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/758_QuickChili_Step4_CD_557301-af13bf02aa044be5bec19dd8661b1448.jpg"
      ],
      "image": "assets/images/13329/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
