  "ingredients": [
    "0.5 cup butter, softened",
    "1.5 cups sugar",
    "1 teaspoon vanilla extract",
    "1 cup mashed banana",
    "0.25 cup sour cream",
    "2 eggs, lightly beaten",
    "2 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease 24 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, cream together the butter, sugar, and vanilla. Mix in banana and sour cream. Stir in the eggs. In a separate bowl, mix the flour, baking powder, and baking soda. Mix dry ingredients into the banana mixture until evenly moist. Fold in chocolate chips. Transfer batter to the prepared muffin cups, filling each cup about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 25 minutes in the preheated oven, or until a knife inserted in the center of a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
