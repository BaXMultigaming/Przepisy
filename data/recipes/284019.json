  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill corn for 15 minutes, turning every few minutes. Transfer to a cutting board and let cool for 5 minutes.",
