  "ingredients": [
    "4 cups whole milk",
    "1 tablespoon vanilla extract",
    "1 teaspoon butter",
    "4 eggs",
    "0.5 cup white sugar",
    "3 tablespoons cornstarch"
  ],
  "steps": [
