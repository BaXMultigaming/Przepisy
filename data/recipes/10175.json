  "ingredients": [
    "1.5 cups white sugar",
    "0.5 cup water",
    "2 egg whites",
    "0.5 teaspoon salt",
    "1 tablespoon light corn syrup",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine sugar, water, egg whites, salt, corn syrup, and vanilla in the top of a double boiler. Beat all ingredients about one minute before placing bowl or pan over the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place over rapidly boiling water; beat at high speed until the mixture forms soft peaks. (This may take longer than 7 minutes).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer frosting mixture to large bowl; beat until the mixture is thick and cool enough to spread.",
      "section": null,
