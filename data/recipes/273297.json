  "steps": [
    {
      "text": "Wash and dry parsley and cilantro; place into a food processor. Add ice cubes, chiles, garlic, lemon juice and zest, cumin, coriander, salt, and pepper. Drizzle in 2 tablespoons olive oil. Blend until a smooth paste is achieved, adding more oil as needed.",
      "section": null,
      "name": null,
