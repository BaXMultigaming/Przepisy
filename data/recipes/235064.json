  "ingredients": [
    "1 (10 ounce) package frozen puff pastry shells",
    "4 ounces PHILADELPHIA Neufchatel Cheese, softened",
    "1 cup milk, divided",
    "1 (3.4 ounce) package JELL-O Vanilla Flavor Instant Pudding",
    "1 Granny Smith or Red Delicious apple, chopped",
    "3 tablespoons caramel ice cream topping"
  ],
  "steps": [
    {
      "text": "Heat oven to 425 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pastry shells as directed on package; cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat Neufchatel and 1/4 cup milk with mixer until blended. Add dry pudding mix and remaining milk; beat 2 min. Refrigerate until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove top and doughy center from each pastry shell; discard removed pastry. Fill shells with pudding mixture; top with apples and caramel topping. Serve with pastry tops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
