  "ingredients": [
    "2 tablespoons vegetable oil",
    "2 skinless, boneless chicken breasts, diced",
    "1 pinch seasoned salt, or to taste",
    "ground black pepper to taste",
    "0.5 onion, chopped",
    "0.5 teaspoon minced garlic",
    "4 cups chicken broth",
    "2 cups water",
    "2 large russet potatoes, quartered and thinly sliced",
    "2 carrots, chopped",
    "2 stalks celery, chopped",
    "1 pinch cayenne pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3hb3I0Z0AUEofWg9tRjkC8L0G7A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272232-chicken-potato-soup-DDMFS_4x3_Step_01-5d6ca3eca9c64ffe97ccba5cf013be36.jpg"
      ],
      "image": "assets/images/272232/step_01.webp"
    },
    {
      "text": "Heat oil in a large soup pot over medium-high heat. Season chicken with seasoned salt and pepper, add to the pot, and cook, stirring occasionally, until no longer pink in the center, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ObTNlkHvdehCK-ZJBu-j8Zvhey4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272232-chicken-potato-soup-DDMFS_4x3_Step_02-dd4f7e8bf4a14b25b372d4d0fa6a774f.jpg"
      ],
      "image": "assets/images/272232/step_02.webp"
    },
    {
      "text": "Add onion and cook until almost translucent, about 5 minutes. Add garlic and cook until slightly browned, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0YKFkTkCChzv1D0Cki7ElwgyiYI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272232-chicken-potato-soup-DDMFS_4x3_Step_03-9765d015f5a74b6c91652645aedc91aa.jpg"
      ],
      "image": "assets/images/272232/step_03.webp"
    },
    {
      "text": "Stir in broth, water, potatoes, carrots, and celery; cook until potatoes and carrots are tender, 15 to 20 minutes. Taste and adjust seasoning with salt, pepper, and cayenne.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nRPD9oIfFLh3q9P0r2s7DbC20nI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272232-chicken-potato-soup-DDMFS_4x3_Step_04-0f35669cdd584a24923818ac8c4f4955.jpg"
      ],
      "image": "assets/images/272232/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nfK-43q-YNFMqdAvuCjwIAYl1Dw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272232-chicken-potato-soup-DDMFS_4x3_Beauty-90e3a2f8e96244a7bb96e013b820ddb6.jpg"
      ],
