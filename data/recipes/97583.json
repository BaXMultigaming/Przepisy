  "ingredients": [
    "5 apples - peeled, cored and diced",
    "4 oranges, peeled and diced",
    "1 cup brown sugar",
    "0.75 cup shredded Cheddar cheese",
    "0.75 cup chopped walnuts",
    "0.75 cup coarsely crushed buttery round crackers",
    "0.5 cup butter",
    "3 tablespoons all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground cloves",
    "0.25 cup liquid non-dairy creamer"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss together apples, oranges, brown sugar, cheese, and walnuts in a large bowl. Spread evenly in a 9x13-inch baking dish. Sprinkle crushed crackers over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small saucepan over medium heat and whisk in flour, cinnamon, baking powder, nutmeg, and cloves until well combined. Pour over crushed crackers, then drizzle with creamer. Cover with a lid or aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Remove from the oven and uncover. Stir gently to fold in crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
