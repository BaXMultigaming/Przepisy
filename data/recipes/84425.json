  "ingredients": [
    "2 tablespoons extra virgin olive oil",
    "0.5 white onion, finely chopped",
    "3 cloves garlic, minced",
    "1 (16 ounce) jar pasta sauce",
    "1 pound haddock fillets",
    "1 (14 ounce) can stewed tomatoes, drained",
    "0.75 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat the bottom of a baking dish with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle 1/2 the onion and garlic evenly in the baking dish, and cover with 1/2 the pasta sauce. Place haddock fillets in the dish, top with tomatoes and remaining onion and garlic. Cover with remaining pasta sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 20 minutes in the preheated oven. Top with mozzarella cheese, and continue baking 10 minutes, until cheese is melted and fish is easily flaked with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
