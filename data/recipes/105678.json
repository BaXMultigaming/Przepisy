  "ingredients": [
    "0.5 pound sliced bacon",
    "4 cups potatoes, peeled and cubed",
    "0.5 onion, chopped",
    "6 eggs, beaten",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Cook bacon to desired doneness in a cast iron skillet over the slow burning coals of a campfire. Remove bacon from the skillet and set aside. Stir the potatoes and onion into the hot bacon fat. Cover, and cook until the potatoes are soft, about 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble the bacon into the potatoes. Stir in the eggs, cover, and cook until set through, about 2 minutes. Sprinkle with the cheese, and allow to melt before serving.",
