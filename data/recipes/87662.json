  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease an 8-inch square baking pan and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the streusel, combine 1/3 cup pancake mix, brown sugar, and cinnamon in a mixing bowl. Cut in the margarine with a pastry cutter or 2 knives until mixture is crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together the 2 cups of pancake mix, soy milk, sugar, and egg just until combined. Spread into prepared pan. Sprinkle with cinnamon streusel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 to 25 minutes, or until a toothpick inserted into the center of the cake comes out clean. Cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
