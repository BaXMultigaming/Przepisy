  "ingredients": [
    "8 slices bread without crusts, toasted and cubed",
    "1.5 cups milk",
    "0.25 cup butter or margarine",
    "5 eggs",
    "1.25 cups white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "2 cups diced rhubarb",
    "0.25 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread cubes into prepared baking dish. Heat milk and butter in a saucepan just to the boiling point. Pour over bread cubes; let stand 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, sugar, cinnamon and salt together in a medium bowl. Stir in rhubarb; pour over soaked bread, and gently stir until combined. Sprinkle walnuts over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until nicely browned on top, about 50 minutes. Let stand for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
