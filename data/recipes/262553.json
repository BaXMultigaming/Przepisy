  "ingredients": [
    "3 very ripe black plantains, peeled",
    "0.5 cup white sugar",
    "0.25 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon",
    "1 drop red food coloring, or as needed",
    "1 teaspoon all-purpose flour, or as needed",
    "1 (9 inch) refrigerated pie crust",
    "1 mango, sliced",
    "1 pinch white sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Place plantains in a pot with water to cover. Bring to a boil; cook until tender, about 15 minutes. Drain, transfer to a bowl, and mash until smooth. Add 1/2 cup white sugar, vanilla extract, cinnamon, and red food coloring.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Flour a pie plate; line the plate with the pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the plantain mixture into the pie crust. Arrange sliced mangos on top and sprinkle with a pinch of sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until mostly firm, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
