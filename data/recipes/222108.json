  "ingredients": [
    "0.5 cup butter",
    "0.75 cup white sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "1.5 cups whole wheat pastry flour",
    "1.75 teaspoons baking powder",
    "0.75 cup low-fat (1%) milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar with an electric mixer in a large bowl until light, fluffy, and noticeably lighter in color. Add eggs, one at a time, mixing well after each addition. Beat in vanilla with the last egg. Combine flour and baking powder in a small bowl; mix into butter mixture until well combined. Stir in milk until batter is smooth. Pour or spoon batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the cake springs back to the touch, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
