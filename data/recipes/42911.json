  "ingredients": [
    "2 cups water",
    "1 cup long grain white rice",
    "3 tablespoons olive oil",
    "1 large onion, chopped",
    "1 large red bell pepper, chopped",
    "3 cloves garlic, crushed",
    "1 (14.5 ounce) can whole peeled tomatoes, chopped",
    "3 cups finely chopped zucchini",
    "0.5 teaspoon dried oregano",
    "salt and pepper to taste",
    "1 (15 ounce) can cannellini beans, drained"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a medium saucepan, and stir in the rice. Reduce heat, cover, and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a separate medium saucepan over medium heat. Stir in onion, red bell pepper, and garlic, and cook until tender. Mix in tomatoes and zucchini, and season with oregano, salt, and pepper. Reduce heat, cover, and simmer 20 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cannellini beans into the tomato and zucchini mixture, and continue cooking about 10 minutes. Serve over the cooked rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
