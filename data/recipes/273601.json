  "ingredients": [
    "1 (14 ounce) can sweetened condensed milk",
    "1 (6 ounce) can evaporated milk",
    "6 ounces milk",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "4 cups day-old 12-grain bread (such as Oroweat®), cut into 1-inch cubes",
    "0.75 cup chopped walnuts",
    "0.5 cup raisins",
    "2 ounces Neufchatel cheese, cubed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sweetened condensed milk, evaporated milk, milk, vanilla extract, and cinnamon together in a large bowl. Add bread cubes and stir until well incorporated. Let sit for 5 minutes so bread will absorb some of the liquid. Add walnuts and raisins and stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into the prepared baking dish. Dot with Neufchatel cheese, pressing down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 35 minutes. Let cool 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
