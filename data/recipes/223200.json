  "ingredients": [
    "1 cup white sugar",
    "3 large eggs",
    "0.75 cup olive oil",
    "0.25 cup milk",
    "1 tablespoon orange marmalade",
    "1.5 cups all-purpose flour",
    "1 cup dried cranberries",
    "1 cup pecan halves",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 tablespoon confectioners' sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar and eggs together until smooth, 3 to 4 minutes. Add olive oil, milk, and orange marmalade; beat again until well mixed. Add flour, cranberries, pecans, baking powder, and salt; stir until ingredients are moist. Pour batter into prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 35 to 40 minutes. Cool cake in the pan; sprinkle with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
