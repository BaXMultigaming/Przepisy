  "ingredients": [
    "0.5 cup all-purpose flour",
    "0.125 teaspoon baking powder",
    "0.125 teaspoon salt",
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "2 eggs",
    "2 (1 ounce) squares unsweetened baking chocolate, melted",
    "0.5 teaspoon vanilla extract",
    "1 cup coarsely chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease an 8x8-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until light and fluffy. Beat in eggs until smooth batter forms; beat in chocolate and vanilla extract. Stir flour mixture in just until incorporated; fold in walnuts. Spread batter into prepared square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until top is dry and edges have started to pull away from the sides of the pan, 40 to 45 minutes. Cool completely in square pan, about 30 minutes; cut into 9 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
