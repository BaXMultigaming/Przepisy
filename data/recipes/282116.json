  "ingredients": [
    "1 (3 ounce) package ramen noodles",
    "2 cups water",
    "1 teaspoon chopped scallions"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor smoker to 250 degrees F (120 degrees C) using hickory wood chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove block of noodles from the package and set aside seasoning packet. Run block of noodles under water for 30 seconds on all sides. Place noodles directly on the rack of the smoker and smoke for 1 hour. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring 2 cups of water to a boil in a large saucepan. Add noodles and boil for 3 minutes. Turn heat off, stir in reserved seasoning packet, and let sit for 1 minute. Ladle into bowls and garnish with chopped scallions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
