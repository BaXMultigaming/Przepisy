  "title": "Pineapple Pound Cake",
  "description": "A pound cake made with pineapple and glazed with pineapple sauce. Unlike most cakes, you will not preheat the oven on this one.",
  "authors": [
    "Evelyn Ivy"
  ],
  "date_published": "1999-09-07T00:26:31-04:00",
