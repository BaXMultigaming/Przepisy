  "ingredients": [
    "2 eggs, beaten",
    "3 very ripe bananas, mashed",
    "2 cups all-purpose flour",
    "1 teaspoon salt",
    "0.75 cup white sugar",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease or line 10 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine eggs and bananas. In a separate bowl, mix together flour, salt, sugar and baking soda. Stir banana mixture into flour mixture. Fold in walnuts if desired. Pour batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 to 25 minutes, or until a toothpick inserted into center of a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
