  "ingredients": [
    "1 quart water",
    "giblets from a turkey",
    "0.25 medium yellow onion",
    "1 stalk celery, cut in half",
    "1 cube chicken bouillon",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 (14.5 ounce) cans chicken broth",
    "4 large hard-cooked eggs, chopped",
    "0.5 cup milk",
    "2 tablespoons cornstarch"
  ],
  "steps": [
    {
      "text": "Simmer water, giblets, onion, celery, bouillon, salt, and pepper together in a 2-quart saucepan, 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W92WFRCNPLAeY4Pt4Mn6Dgef-KE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13867-giblet-gravy-i-02-4x3-fafa7e29ab2a4eb8a103838371b12825.jpg"
      ],
      "image": "assets/images/13867/step_01.webp"
    },
    {
      "text": "Transfer liver and neck to a cutting board; remove meat from neck and discard bones. Chop liver and neck meat. Discard celery, onion, and any other giblets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wKGF30-ks9_E3aGR5cGajwZiQ4U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13867-giblet-gravy-i-03-4x3-f267328bfdcf41fbae6478088bb56b49.jpg"
      ],
      "image": "assets/images/13867/step_02.webp"
    },
    {
      "text": "Return meat to the saucepan. Add broth and eggs; set over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EvtJUSbGlrKcu8sVbadw4aQ2tVA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13867-giblet-gravy-i-04-4x3-f20242d523ff4dcb8176c6595038c229.jpg"
      ],
      "image": "assets/images/13867/step_03.webp"
    },
    {
      "text": "Mix milk and cornstarch together in a small bowl until smooth; slowly stir into the saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VNivIC9wuG-IC56Dt6-LMPQGKbY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13867-giblet-gravy-i-05-01-4x3-7fcc7eb2a063444aabaf37c03ac7634e.jpg"
      ],
      "image": "assets/images/13867/step_04.webp"
    },
    {
      "text": "Reduce heat to low; stir until gravy thickens, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VdVCt8OFlMcoNRtfFfTZ9VYamp8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13867-giblet-gravy-i-05-02-4x3-251279a2e89b455a835ffaf0e0f5f5fb.jpg"
