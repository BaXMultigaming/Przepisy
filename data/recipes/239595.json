  "ingredients": [
    "1 prepared pie pastry (such as Pillsbury® Pie Crust)",
    "1 (21 ounce) can apple pie filling",
    "7.5 ounces part-skim ricotta cheese",
    "1 egg, beaten",
    "1.5 ounces shredded Cheddar cheese",
    "0.25 cup all-purpose flour",
    "3 tablespoons brown sugar",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "1 tablespoon butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out pie crust lengthwise to fit into the bottom a 13x9-inch baking dish with a good 1/2-inch of the crust up all sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix apple pie filling, ricotta cheese, egg, and shredded Cheddar cheese together in a bowl; pour over the pastry and flatten into a smooth layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, brown sugar, salt, and cinnamon together in a separate bowl. Mash butter into the flour mixture with a fork or pastry cutter until mixture is crumbly. Sprinkle over the apple pie mixture in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until crust is a good caramel-brown color, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
