  "ingredients": [
    "1 tablespoon sesame oil",
    "2 cloves garlic, minced",
    "0.66666668653488 cup light soy sauce",
    "3 tablespoons rice wine",
    "3 tablespoons rice vinegar",
    "1.5 teaspoons ground ginger",
    "0.5 teaspoon wasabi paste",
    "2 (5 ounce) salmon fillets"
  ],
  "steps": [
    {
      "text": "Heat sesame oil in a skillet over medium heat; stir in garlic. Cook and stir until fragrant, about 1 minute. Transfer to a large glass or ceramic bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add soy sauce, rice wine, rice vinegar, ginger, and wasabi paste to the garlic-sesame oil mixture; whisk to combine. Add salmon fillets and turn to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a rimmed baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove fillets from the marinade, shake off excess, and place on the prepared baking sheet. Discard the remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
