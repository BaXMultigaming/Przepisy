  "ingredients": [
    "2 cups cubed cooked chicken breast",
    "0.75 cup seedless green grapes, halved",
    "0.5 cup chopped celery",
    "0.5 cup chopped pecans",
    "0.25 cup minced fresh parsley",
    "0.5 cup mayonnaise",
    "0.25 cup sour cream",
    "0.75 teaspoon freshly grated ginger",
    "0.125 teaspoon ground white pepper"
  ],
  "steps": [
    {
      "text": "Combine chicken, grapes, celery, pecans, and parsley in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, sour cream, ginger, and white pepper together in a separate bowl; gently stir into chicken mixture. Cover the bowl with plastic wrap; refrigerate until chilled, 1 to 2 hours.",
