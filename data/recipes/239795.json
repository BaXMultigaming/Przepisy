  "ingredients": [
    "0.5 pound bacon",
    "1 cup white sugar",
    "0.5 cup light corn syrup",
    "1 pinch salt",
    "0.5 cup chopped pecans",
    "1 tablespoon bacon grease",
    "1 teaspoon vanilla extract",
    "1.5 teaspoons baking soda"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until crisp and browned, about 10 minutes. Drain the bacon slices on paper towels and reserve 1 tablespoon bacon grease. Crumble bacon once drained and slightly cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a large baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, syrup, and salt in a large microwave-safe bowl. Heat in microwave oven until bubbling, about 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir bacon, pecans, reserved bacon grease, and vanilla extract through the sugar mixture; heat in microwave oven for 3 minutes more. Immediately add baking soda and stir just until foamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working quickly, spread the mixture onto the prepared baking sheet. Let cool until set, about 15 minutes. Break into bite-size pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
