  "ingredients": [
    "1 teaspoon olive oil",
    "1 medium yellow onion, diced",
    "1 poblano pepper, diced",
    "2 cloves garlic, minced",
    "1 (32 ounce) container chicken broth",
    "1.5 pounds shredded cooked chicken breast",
    "2 (15.5 ounce) cans no-salt-added navy beans, rinsed and drained",
    "1 (10 ounce) package frozen corn",
    "1 teaspoon ground cumin",
    "0.5 teaspoon chili powder",
    "0.5 teaspoon ground black pepper",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat a deep skillet over medium heat. Add olive oil, then onion, poblano pepper, and garlic. Saute until onion is translucent, about 5 minutes. Add chicken broth, shredded chicken, navy beans, corn, cumin, chili powder, pepper, and salt; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
