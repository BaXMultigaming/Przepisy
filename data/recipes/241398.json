  "ingredients": [
    "0.25 cup balsamic vinegar",
    "0.25 cup olive oil",
    "0.25 cup honey",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon dried rosemary",
    "2 pounds bone-in chicken thighs, or more to taste",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Whisk balsamic vinegar, olive oil, honey, thyme, and rosemary together in a bowl until smooth; pour into a resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken thighs with salt and black pepper. Add to balsamic marinade, toss to coat, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 2 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken and marinade to a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink at the bone and juices run clear, 35 to 40 minutes. An instant-read thermometer inserted near but not touching the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
