  "ingredients": [
    "1 cup water, or to taste",
    "0.25 cup rolled oats",
    "1 tablespoon maple syrup",
    "1 splash vanilla extract",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Put water, oats, maple syrup, vanilla extract, and salt into a blender. Blend until combined, about 1 minute. If you blend it for too long, it will become slimy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture over a thin towel, or very fine strainer, into a bowl. Strain again for the smoothest result. Pour oat milk into a container or cup and refrigerate until cold, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
