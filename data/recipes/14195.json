    "2 tablespoons fat-free mayonnaise",
    "2 tablespoons plain low-fat yogurt",
    "1 cup chopped celery",
    "2 tablespoons capers",
    "0.125 teaspoon ground black pepper",
    "8 leaves lettuce"
