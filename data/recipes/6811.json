  "total_time": "PT160M",
  "yield": [
    "12",
    "1 (8-inch) loaf"
  ],
  "categories": [
    "Bread"
  ],
  "cuisines": [
    "Italian"
  ],
  "regions": [
    "Italian"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 (.25 ounce) package active dry yeast",
    "1 cup warm water (110 degrees F/45 degrees C)",
    "0.25 cup white sugar",
    "2 eggs",
    "0.5 cup nonfat plain yogurt",
    "1 teaspoon vanilla extract",
    "1 tablespoon grated lemon zest",
    "0.25 teaspoon salt",
    "4 cups unbleached all-purpose flour",
    "0.25 cup dried currants",
    "0.25 cup raisins",
    "1 tablespoon confectioners' sugar",
    "1 tablespoon butter, melted"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IjNmU4OCiioCZk6sdL6iW8JZNcA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-6811-panettone-i-VAT-step-01-3dd4b6c954704d9e883709b116e10f89.jpg"
      ],
      "image": "assets/images/6811/step_01.webp"
    },
    {
      "text": "Combine yeast, water, and sugar In a medium bowl. Cover and let stand 10 minutes, or until foamy. Add eggs, yogurt, vanilla, lemon zest, and salt. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t3uVwVMIM6BOMnyon2BI7MUtJvM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-6811-panettone-i-VAT-step-02-064b25c5df704d8cb4a5c3776bf3fa7c.jpg"
      ],
      "image": "assets/images/6811/step_02.webp"
    },
    {
      "text": "Stir in flour 1/2 cup at a time until dough forms into a manageable ball. Turn out onto a lightly floured surface and knead for 5 to 10 minutes, adding flour as necessary, until dough is soft and pliable, but not sticky. (May need up to 5 cups flour.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/277qPj2hY6TZl1ssft8mZUyNuAI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-6811-panettone-i-VAT-step-03-6b3bf06792c34da9b2dca695ee72efa7.jpg"
      ],
      "image": "assets/images/6811/step_03.webp"
    },
    {
      "text": "Place dough in a large, lightly pan-sprayed bowl, cover, and let rise in a warm place until doubled, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s2Scmqnoby09jOkeJCMSgGhbZRs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-6811-panettone-i-VAT-step-04-eb8473c04dd74ea88becf3bb3490a104.jpg"
      ],
      "image": "assets/images/6811/step_04.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C) and spray a round 8-inch cake pan with non-stick spray. In a small bowl, toss dried fruit with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ic9CQ_UgonCpLemDkzIgdtgHlhg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-6811-panettone-i-VAT-step-05-1db586bed65e4c6ea40c9cc911959204.jpg"
      ],
      "image": "assets/images/6811/step_05.webp"
    },
    {
      "text": "Punch down dough in bowl, transfer to floured surface, and knead in the fruit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZdXke8812eNAFvEjsB2CJH5nrsI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-6811-panettone-i-VAT-step-06-463ba7c51c134d359f8099af8d5c90e0.jpg"
      ],
      "image": "assets/images/6811/step_06.webp"
    },
    {
      "text": "Form dough into a ball, place in prepared cake pan, cover loosely with dish towel, and let rise 30 minutes. (Loaf will rise above the pan sides.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X2So-kmtn0cQRCnyt5pN4Kdj2IY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-6811-panettone-i-VAT-step-07-3c8db3a32965402cb42090eec15badf3.jpg"
      ],
      "image": "assets/images/6811/step_07.webp"
    },
    {
      "text": "Brush with melted butter, if desired. Bake for 45 minutes, or until loaf is golden brown and a toothpick inserted in the center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IiwP3LPhzp__KuleXjSObIn99vo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-6811-panettone-i-VAT-step-08-0583af38714a43d893fc4d954ba10f78.jpg"
      ],
      "image": "assets/images/6811/step_08.webp"
    }
  ],
