  "title": "Panettone Bread",
  "description": "This rich panettone is easy to make with simple baking ingredients, yeast, dried currants, raisins, and lemon zest for a Christmas breakfast treat.",
  "authors": [
    "Lacey Lynn"
  ],
  "date_published": "1998-07-30T21:00:53-04:00",
  "date_modified": "2026-07-01T17:07:38-04:00",
