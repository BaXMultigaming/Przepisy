  "ingredients": [
    "1 tablespoon olive oil",
    "2 small shallots, chopped",
    "2 small garlic cloves, chopped",
    "0.5 cup chopped kale",
    "2 tablespoons condensed cream of chicken soup",
    "1 tablespoon sriracha sauce",
    "1 tablespoon cream cheese",
    "1 tablespoon sour cream",
    "1 (15 ounce) can cut green beans, drained",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Fry shallot and garlic in hot oil until golden brown, 2 to 3 minutes; add kale, cream of chicken soup, sriracha sauce, cream cheese, and sour cream to the skillet. Cook and stir the mixture until the cream cheese melts and the liquid is even in color, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir green beans into the mixture to coat, season with black pepper, reduce heat to medium-low, and simmer until the sauce thickens slightly, 5 to 7 minutes.",
