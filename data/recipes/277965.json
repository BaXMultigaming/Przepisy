  "ingredients": [
    "1.75 cups white sugar",
    "0.75 cup margarine",
    "0.66666668653488 cup evaporated milk",
    "1 pinch salt",
    "1 (13 ounce) jar marshmallow cream",
    "1 (12 ounce) bag semisweet chocolate chips",
    "0.75 cup chopped nuts",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Grease a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, margarine, evaporated milk, and salt in a medium saucepan. Bring to a full rolling boil. Boil for 5 minutes, stirring constantly, until fudge reaches 234 degrees F (112 degrees C) on a candy thermometer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat. Add marshmallow cream, chocolate chips, nuts, and vanilla extract; mix well until blended. Pour into the prepared pan and refrigerate until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut into seventy-eight 1 1/2-inch squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
