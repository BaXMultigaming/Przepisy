  "ingredients": [
    "1 pound carrots, grated",
    "1 cup crushed pineapple",
    "0.5 cup raisins",
    "1 tablespoon honey",
    "2 tablespoons mayonnaise, or to taste",
    "1 dash lemon juice"
  ],
  "steps": [
    {
      "text": "In a large bowl, mix together the carrots, pineapple and raisins. Stir in the honey, mayonnaise and lemon juice until evenly coated. Refrigerate for at least 30 minutes before serving to let the flavors meld.",
