  "ingredients": [
    "1 (16 ounce) container sour cream",
    "1 (16 ounce) jar salsa",
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "1 (8 ounce) can chili beans, drained",
    "0.25 cup diced onion",
    "6 (12 inch) flour tortillas, cut into strips",
    "6 skinless, boneless chicken breast halves - cooked and shredded",
    "4 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sour cream, salsa, condensed soup, chili beans, and onion in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer the bottom of a 9x13-inch baking dish with 1/3 of the tortilla strips. Top with 1/3 of the chicken, 1/3 of the sour cream mixture, and 1/3 of the Cheddar cheese. Repeat layering with remaining ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and bubbly, 20 to 30 minutes. Let stand about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
