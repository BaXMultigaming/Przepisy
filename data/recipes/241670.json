  "ingredients": [
    "3 cups all-purpose flour",
    "1 teaspoon salt",
    "3 large eggs",
    "2 tablespoons butter, melted",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k8zGTUOHZ1aXoMY5dCVkrLmDSpE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241670-unleavened-bread-DDMFS-step-01-1787-c19f7d78b39b45cc9e2e09e184f5e1ce.jpg"
      ],
      "image": "assets/images/241670/step_01.webp"
    },
    {
      "text": "Mix flour and salt in a large bowl; make a well in the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c_8eBCdOabOZFvgGIAnfXp6qqDo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241670-unleavened-bread-DDMFS-step-02-1790-c12ba92d53484e4aae699672deae236d.jpg"
      ],
      "image": "assets/images/241670/step_02.webp"
    },
    {
      "text": "Beat eggs and melted butter together; pour into the well in flour mixture and mix with a fork until crumbly. Slowly add milk to flour mixture, using hands to mix dough into a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KG1K-4ezKtVMutQ8YzqRchCYdIs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241670-unleavened-bread-DDMFS-step-03-1791-7abc5e5c082a4c2889400667f7aa2a40.jpg"
      ],
      "image": "assets/images/241670/step_03.webp"
    },
    {
      "text": "Roll dough into a flat loaf and place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NjFoKDSqcz82wFisuq-7rSrveTE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241670-unleavened-bread-DDMFS-step-04-1792-06f59da27c254f0990d6b84475cf6c70.jpg"
      ],
