  "ingredients": [
    "2 (9 inch) pie crusts",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "0.5 teaspoon salt",
    "0.5 teaspoon freshly ground black pepper",
    "0.25 teaspoon ground nutmeg",
    "15 ounces ricotta cheese",
    "8 ounces mozzarella cheese",
    "1 cup grated Parmesan cheese",
    "2 cups diced Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Press bottom pie crust into a glass pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine spinach, salt, pepper, and nutmeg in a large bowl. Add ricotta, mozzarella, Parmesan, and Cheddar cheeses. Mix together well and pour into the bottom pie crust. Place second pie crust on top of filling, seal and trim edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 minutes. Let stand for 10 minutes and cut into wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
