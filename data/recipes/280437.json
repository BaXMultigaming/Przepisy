  "ingredients": [
    "3 cups grape tomatoes, halved",
    "0.25 cup olive oil",
    "1 teaspoon minced fresh oregano",
    "0.5 teaspoon minced garlic",
    "salt and freshly ground black pepper to taste",
    "1 (16 ounce) package packaged gnocchi",
    "4 tablespoons unsalted butter",
    "3 tablespoons grated Parmesan cheese",
    "1 tablespoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Place tomatoes, olive oil, oregano, garlic, salt, and pepper in a large bowl; stir until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to a boil. Add gnocchi and boil until they float, about 3 minutes. Drain in a colander and shake to remove excess water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large microwave-safe bowl. Stir in Parmesan cheese. Add drained gnocchi and toss until evenly coated. Transfer gnocchi to the air fryer basket. Air fry for a total of 12 minutes, shaking the basket every 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide reserved tomato mixture between serving bowls and top with fried gnocchi. Garnish with chopped parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
