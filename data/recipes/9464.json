  "ingredients": [
    "1 (9 inch) pastry for a 9 inch single crust pie",
    "1.5 cups white sugar",
    "3.5 tablespoons cocoa",
    "0.5 cup butter, melted",
    "1 (5 ounce) can evaporated milk",
    "2 eggs, beaten",
    "1 teaspoon vanilla extract",
    "0.75 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together sugar, cocoa, and melted butter. Stir in evaporated milk, beaten eggs, vanilla, and chopped pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour nut mixture into unbaked pie shell. Bake for 10 minutes. Reduce heat to 325 degrees F (165 degrees C) and bake for 30 minutes.",
