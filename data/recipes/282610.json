  "ingredients": [
    "1.25 pounds Brussels sprouts, trimmed and halved",
    "1 tablespoon olive oil",
    "0.5 teaspoon kosher salt",
    "0.125 teaspoon cayenne pepper",
    "2 tablespoons honey",
    "2 teaspoons balsamic vinegar",
    "0.25 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Place Brussels sprouts in a medium bowl; toss with oil, salt, and cayenne. Place in an air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry until golden brown and crisp around the edges, 13 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk honey and balsamic vinegar together until smooth. Toss cooked sprouts in the glaze and sprinkle with feta cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
