  "ingredients": [
    "4 cups honey graham cereal",
    "3 tablespoons margarine",
    "6 cups miniature marshmallows",
    "0.25 cup light corn syrup",
    "1.5 cups milk chocolate chips"
  ],
  "steps": [
    {
      "text": "Coat a 9x13 inch dish with cooking spray. Place cereal into a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan over low heat, melt margarine. Add marshmallows and corn syrup and stir until melted and smooth. Stir in chocolate chips until melted. Remove from heat and pour over waiting cereal; stir well to coat. Press into prepared pan. Cool completely before cutting into squares.",
