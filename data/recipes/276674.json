  "ingredients": [
    "cooking spray",
    "1 cup oatmeal",
    "1 cup soy milk",
    "1 cup whole wheat flour",
    "0.5 cup brown sugar",
    "0.33333334326744 cup oat bran",
    "0.25 cup ground flax seed",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "3 ripe bananas, mashed",
    "0.5 cup applesauce",
    "0.33333334326744 cup egg substitute",
    "0.75 cup raisins",
    "0.75 cup chopped walnuts",
    "0.75 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Mist 18 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oatmeal and milk in a large bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, brown sugar, oat bran, ground flax seed, baking powder, and salt together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bananas, applesauce, and egg substitute in another bowl. Stir into oatmeal mixture. Stir in flour mixture, followed by raisins, walnuts, and chocolate chips. Divide batter evenly between the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
