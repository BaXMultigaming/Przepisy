  "ingredients": [
    "1 cup roughly chopped garlic scapes",
    "1 lemon, juiced",
    "1 tablespoon white wine vinegar",
    "0.5 teaspoon kosher salt, or to taste",
    "0.25 cup olive oil",
    "0.25 cup canola oil",
    "0.5 cup toasted walnuts"
  ],
  "steps": [
    {
      "text": "Combine garlic scapes, lemon juice, vinegar, salt, olive oil, canola oil, and walnuts in a blender. Blend into a smooth paste. Adjust seasoning if needed.",
