  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix",
    "4 large eggs",
    "1 (8 ounce) carton sour cream",
    "0.75 cup vegetable oil",
    "0.5 cup water",
    "1 cup brown sugar",
    "0.5 teaspoon ground cinnamon",
    "2 cups confectioners' sugar",
    "0.25 cup milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together cake mix, eggs, sour cream, vegetable oil, and water in a large bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/12iDqL7Hjr3JqoO6Ajq0hvRHb_U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219641-Michelles-Honeybun-Cake-ddmfs-4x3-step1-426d4c2cb77d4dbc957e4f428915a9c7.jpg"
      ],
      "image": "assets/images/219641/step_02.webp"
    },
    {
      "text": "Mix brown sugar and cinnamon in a small bowl. Pour 1/2 of the cake batter into the prepared pan. Sprinkle brown sugar mixture over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yKYRMbpC63BTZesZLL-NZZWZ5lY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219641-MichellesHoneybunCake-ddms-4x3-step3-92ec5c40ae6445c09054f5ef959bbf4a.jpg"
      ],
      "image": "assets/images/219641/step_03.webp"
    },
    {
      "text": "Pour remaining batter on top; gently swirl batter a few times with a table knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AmsPoioR4cawgUyYvyKg3m6tmn8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219641-MichellesHoneybunCake-ddms-4x3-step4-bb6a0e459c874b3da850d23f23bd3523.jpg"
      ],
      "image": "assets/images/219641/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until lightly golden brown and a toothpick inserted into the center of the cake comes out clean, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DlCm-NDK9hZFiL7ccSFlPpZt-ts=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219641-MichellesHoneybunCake-ddms-4x3-step5-8033f3ea64894be086f69d2ab8784d41.jpg"
      ],
      "image": "assets/images/219641/step_05.webp"
    },
    {
      "text": "Make icing: Stir together confectioners' sugar, milk, and vanilla extract in a bowl until smooth and runny.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n3hXDhX5S5PO44BvFDDRZ-QPspE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219641-Michelles-Honeybun-Cake-ddmfs-4x3-step6-50f5e350c0824e9d89dbf59221f4063b.jpg"
      ],
      "image": "assets/images/219641/step_06.webp"
    },
    {
      "text": "Pour over hot cake; allow to cool before serving.",
