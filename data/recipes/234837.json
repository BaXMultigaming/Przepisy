  "ingredients": [
    "2 cups milk",
    "2 eggs, beaten",
    "0.5 cup white sugar",
    "1 pinch salt",
    "1 dash vanilla extract",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gFfTeFMv2JKJs7xboC0RYmKfJf0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-234837-Egg-Custard-ddmfs-step-1-c0d83322da544bc1ae22678eae5f9a5d.jpg"
      ],
      "image": "assets/images/234837/step_01.webp"
    },
    {
      "text": "Whisk milk, eggs, sugar, salt, and vanilla together in a bowl until completely combined. Pour egg mixture into 6 custard cups; sprinkle tops with nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O6hHXbrL_KkQI5denQsHN6KJ_N0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-234837-Egg-Custard-ddmfs-step-2-480f5fe8e9ea4b009b844ba2a5c37ba6.jpg"
      ],
      "image": "assets/images/234837/step_02.webp"
    },
    {
      "text": "Place cups in a baking pan and fill the pan with enough hot water to reach halfway up the sides of the custard cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WsiHPtpWY5ogxvf-RdtWywcKMxo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-234837-Egg-Custard-ddmfs-step-3-9a0adb7b03a947a5892a22175eae6129.jpg"
      ],
      "image": "assets/images/234837/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the custard comes out clean and the custards are set, about 1 hour. Cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JIhBrA9D2c823uxWg6V1DWpjjLI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-234837-Egg-Custard-ddmfs-step-4-287f7da75ea4490f9ad0a27b51df5b73.jpg"
      ],
      "image": "assets/images/234837/step_04.webp"
    }
  ],
