  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "2 tablespoons unsalted butter",
    "2 tablespoons light brown sugar",
    "1 teaspoon vanilla extract",
    "1 teaspoon almond extract",
    "1 tablespoon honey"
  ],
  "steps": [
    {
      "text": "Melt butter and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine cream cheese, butter, brown sugar, vanilla and almond extract. Beat with an electric mixer. When mixture starts to stiffen, stop mixer and add honey.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue to beat until light and fluffy. Do not over mix, or it will collapse.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread immediately and store cake in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
