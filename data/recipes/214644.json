  "ingredients": [
    "1 gallon cold water",
    "0.5 cup white sugar",
    "0.5 cup salt",
    "8 ears corn on the cob, husks and silk removed",
    "0.5 cup softened butter, or to taste",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Pour cold water into a large pot; stir in sugar and ½ cup salt until dissolved. Add corn to the pot; soak 30 minutes to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook corn on the preheated grill until slightly charred on all sides, flipping every 2 to 3 minutes. Brush corn with butter; season with salt and black pepper.",
