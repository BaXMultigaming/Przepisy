  "ingredients": [
    "1 small onion, finely chopped",
    "2 tablespoons vegetable oil",
    "2 tablespoons chopped fresh rosemary",
    "1 teaspoon chopped fresh thyme",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1.3333333730698 pounds potatoes, cut into 1-inch chunks"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix onion, oil, rosemary, thyme, salt, and pepper together in a large bowl. Add potatoes and toss to coat. Transfer mixture to the prepared pan and spread into a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, turning occasionally, until potatoes are lightly browned and tender when pierced with a fork, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
