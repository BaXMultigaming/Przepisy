  "ingredients": [
    "cooking spray",
    "1 tablespoon butter",
    "1 tablespoon grapeseed oil",
    "4 (4 ounce) salmon fillets with skin",
    "2.5 teaspoons Greek seasoning (such as Cavender's®), divided",
    "0.25 cup crushed pistachios",
    "0.25 cup panko bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with aluminum foil and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a microwave-safe bowl and melt in the microwave, 15 to 30 seconds. Let cool and stir in grapeseed oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon fillets skin-side down on the baking sheet. Brush with butter mixture and sprinkle evenly with 1 1/2 teaspoons Greek seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix crushed pistachios, bread crumbs, and remaining 1 teaspoon Greek seasoning together in a small bowl. Sprinkle evenly over salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until salmon flakes easily with a fork, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
