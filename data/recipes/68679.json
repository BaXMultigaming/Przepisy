  "ingredients": [
    "1.5 pounds ground beef",
    "1 onion, minced",
    "4 carrots, minced",
    "3 celery ribs, thinly sliced",
    "0.5 cup barley",
    "3 (10 ounce) cans beef broth",
    "1 (28 ounce) can diced tomatoes",
    "2 cups water",
    "1 (10.5 ounce) can condensed tomato soup",
    "1 bay leaf",
    "1 tablespoon parsley",
    "1 teaspoon minced garlic",
    "0.5 teaspoon dried thyme",
    "ground black pepper, to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pklTjBb-8XIvl-RxpGBrauI_xzI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68679-hearty-hamburger-soup-DDMFS-step1-3097-169a14b5047c462da85a4f172af3b805.jpg"
      ],
      "image": "assets/images/68679/step_01.webp"
    },
    {
      "text": "Heat a large soup pot over medium-high heat, and crumble in ground beef. Cook and stir until beef is evenly browned and no longer pink. Drain and discard any excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2KhZNWaownk3S5kvJEb3I95nElY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68679-hearty-hamburger-soup-DDMFS-step2-3100-fb85401937b048fc8d0ba46abb73de9b.jpg"
      ],
      "image": "assets/images/68679/step_02.webp"
    },
    {
      "text": "Stir in onion, carrots, celery, and barley. Pour in beef broth, diced tomatoes, water, and condensed soup. Season with bay leaf, parsley, garlic, thyme, and pepper. Bring to a boil then reduce the heat and cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/La0AX_ne2BrUn8WCWBzwfIkPo8A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68679-hearty-hamburger-soup-DDMFS-step3-3102-8a42d80e413249d1ad348500705f2815.jpg"
      ],
      "image": "assets/images/68679/step_03.webp"
    },
    {
      "text": "Simmer for 2 hours, stirring frequently. Remove bay leaf before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8idE6dH80BlH4upaalkZ4_cQ2SQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68679-hearty-hamburger-soup-DDMFS-step4-3104-b0c30ebbfc084cb58f3db3b99460fb96.jpg"
      ],
      "image": "assets/images/68679/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eygnGjuUWALAD358mFTKb9nQkIk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68679-hearty-hamburger-soup-DDMFS-4x3-9b99bc50a9df47ba902317641b5c7bc8.jpg"
