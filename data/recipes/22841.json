  "title": "Forgotten Cookies",
  "description": "Meltaway meringue cookies with chocolate chips and the option of adding peanuts. Forget about them while they sit in the oven overnight.",
  "authors": [
    "DOGIRL"
  ],
  "date_published": "2000-10-14T14:07:42-04:00",
