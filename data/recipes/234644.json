  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup unsweetened cocoa powder",
    "1 teaspoon baking powder",
    "0.25 teaspoon ground red pepper",
    "0.25 teaspoon salt",
    "2 cups white sugar",
    "0.5 cup sour cream",
    "0.25 cup butter, softened",
    "2 eggs, lightly beaten",
    "1 tablespoon red food coloring",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cocoa powder, baking powder, ground red pepper, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, sour cream, butter, eggs, red food coloring, and vanilla together in a bowl. Add flour mixture to sour cream mixture and stir to combine. Pour batter into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out with fudgy crumbs, 30 to 35 minutes. Cool in the pan before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
