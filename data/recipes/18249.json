  "ingredients": [
    "2 tablespoons olive oil",
    "3 large sweet potatoes",
    "2 pinches dried oregano",
    "2 pinches salt",
    "2 pinches ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Brush some oil on the bottom of a glass or nonstick baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel sweet potatoes; cut into medium cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5a2uBRwm2gxgSzGRHe6WHHfS6w4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18249-Baked-Seet-Potatoes-ddmfs-Step3-5154-4x3-1417b63594864c2a98636fe7a3fbc6e9.jpg"
      ],
      "image": "assets/images/18249/step_02.webp"
    },
    {
      "text": "Transfer sweet potato cubes to the baking dish. Add remaining oil, sprinkle with oregano, salt, and pepper, and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a8BDgyIXoiO2EfJI51AUPUkliwY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18249-Baked-Seet-Potatoes-ddmfs-Step4-5157-4x3-2610b49482e14f5a932a8e704b9308c1.jpg"
      ],
      "image": "assets/images/18249/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until sweet potato cubes are soft and fork-tender, 45 minutes to 1 hour.",
      "section": null,
