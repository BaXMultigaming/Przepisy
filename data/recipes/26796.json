  "ingredients": [
    "1 Fuji apple - peeled, cored and diced",
    "1 cup sliced fresh strawberries",
    "2 kiwis, peeled and sliced",
    "2 bananas, peeled and sliced",
    "1 tablespoon fresh lime juice",
    "2 tablespoons white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 cup oil for frying",
    "6 (10 inch) flour tortillas",
    "3 tablespoons white sugar",
    "1 tablespoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "In a medium bowl, mix together Fuji apple, strawberries, kiwis, bananas, lime juice, white sugar, cinnamon and nutmeg. Cover and chill in the refrigerator approximately 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a medium heavy saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice flour tortillas into triangles. Carefully place tortilla triangles into the hot oil and fry until golden brown, 2 to 4 minutes. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place white sugar and cinnamon in a large ziplock plastic bag. Drop fried tortilla triangles into the bag and shake to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve the cinnamon chips warm with the chilled fruit salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
