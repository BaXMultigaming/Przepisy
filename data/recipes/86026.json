  "ingredients": [
    "1 cup shortening",
    "0.5 cup white sugar",
    "1.5 cups brown sugar, divided",
    "3 eggs, whites and yolks separated",
    "1 tablespoon cold water",
    "1 tablespoon vanilla extract",
    "2 cups all-purpose flour",
    "1 tablespoon baking soda",
    "0.125 teaspoon salt",
    "1 (12 ounce) package semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl; mix together shortening, white sugar, 1/2 cup brown sugar, and egg yolks. Stir in water and vanilla. In a separate bowl, sift together flour, baking soda, and salt. Combine with egg and sugar mixture; blend well. Stir in chocolate chips. Press into the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large glass or metal mixing bowl, beat egg whites until soft peaks form. Gradually add 1 cup brown sugar, continuing to beat until whites form stiff peaks. Spread meringue on top of base, covering completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until meringue has risen and light brown in color, about 15 to 20 minutes. Leave to cool before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
