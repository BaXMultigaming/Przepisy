  "ingredients": [
    "2.5 cups sifted cake flour",
    "2 teaspoons baking powder",
    "2 tablespoons white sugar",
    "1 (14 ounce) can sweetened condensed milk",
    "1 cup freshly squeezed and strained orange juice",
    "1 orange, zested",
    "0.5 cup unsalted butter, melted and cooled",
    "0.5 cup sour cream",
    "1 tablespoon vanilla extract",
    "1 teaspoon baking soda",
    "1 teaspoon white vinegar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cake flour, baking powder, and sugar together in a large bowl and make a well in the middle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine condensed milk, orange juice, orange zest, butter, sour cream, and vanilla extract together in a separate bowl. Pour mixture into the flour well. Mix by hand using a whisk until smooth, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine baking soda and vinegar together in a small cup until bubbling. Fold into the batter using a spatula. Pour batter into the prepared pan and allow to sit for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 30 to 45 minutes. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
