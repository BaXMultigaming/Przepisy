  "ingredients": [
    "2 tablespoons brown sugar",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon reduced-sodium soy sauce",
    "1 teaspoon lemon juice",
    "1 clove minced garlic",
    "0.25 teaspoon freshly ground black pepper",
    "1 dash Sriracha sauce",
    "4 (5 ounce) boneless, center-cut pork chops"
  ],
  "steps": [
    {
      "text": "Combine brown sugar, Worcestershire sauce, soy sauce, lemon juice, garlic, pepper and Sriracha sauce in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork chops in a 6-inch silicone cake pan and pour 1/2 of the brown sugar-soy sauce on top. Transfer the silicone pan to the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 9 minutes. Turn pork chops and cook for another 9 minutes. Pour remaining sauce on top of pork chops and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
