  "ingredients": [
    "1 tablespoon olive oil",
    "1 small onion, diced",
    "12 grape tomatoes, diced",
    "2 cloves garlic, minced",
    "2 large peaches, diced",
    "3 teaspoons honey",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Add onion; cook until soft, 1 to 3 minutes. Add tomatoes and garlic; cook over medium-low heat about 5 minutes. Add peaches, honey, and lemon juice; cook until well combined, 2 to 3 minutes more.",
