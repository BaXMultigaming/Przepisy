  "ingredients": [
    "0.75 cup butter",
    "0.75 cup white sugar",
    "1 egg yolk",
    "1.5 cups all-purpose flour",
    "0.75 cup crushed potato chips",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream butter and sugar until smooth. Stir in the egg yolk. Add the flour and nuts, mix until well blended. Stir in the potato chips last, so they don 't get too crunched up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll the dough into walnut sized balls. Place 2 inches apart on an unprepared cookie sheet. Bake for 10 to 12 minutes in the preheated oven. Remove from cookie sheet to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
