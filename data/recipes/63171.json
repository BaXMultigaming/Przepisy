  "ingredients": [
    "3 cups chopped fresh rhubarb",
    "0.5 cup white sugar",
    "3 tablespoons all-purpose flour",
    "1 (9 inch) unbaked pie shell",
    "1 (8 ounce) package cream cheese, softened",
    "2 eggs",
    "1 (8 ounce) container sour cream",
    "2 tablespoons white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss rhubarb, ½ cup sugar, and flour together in a bowl; pour into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Set aside to cool. Lower the oven temperature to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream cheese and ½ cup sugar together in a bowl until smooth; stir in eggs, one at a time, until well combined. Pour over rhubarb.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, about 30 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sour cream, 2 tablespoons sugar, and vanilla extract together in a bowl; spread over pie while hot. Cool to room temperature, then refrigerate until chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
