  "ingredients": [
    "2 ounces dark chocolate, chopped",
    "0.25 cup extra-virgin olive oil",
    "0.66666668653488 cup tahini",
    "3.5 tablespoons honey",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Place chocolate and olive oil in top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until chocolate is melted, about 5 minutes. Remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tahini, honey, and cinnamon in a bowl. Stir in melted chocolate mixture until smooth and well combined. Refrigerate spread until set and spreadable, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
