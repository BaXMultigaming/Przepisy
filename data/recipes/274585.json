  "ingredients": [
    "olive oil cooking spray",
    "0.75 pound fresh green beans, trimmed",
    "sea salt and freshly ground black pepper to taste",
    "1 pinch garlic powder, or to taste",
    "3 tablespoons shredded Parmesan cheese, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Coat a baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place trimmed green beans into the prepared baking dish. Season with sea salt, pepper, and garlic powder; toss to coat. Sprinkle Parmesan cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until cheese melts and forms a crisp shell over beans, about 10 minutes. Serve immediately.",
      "section": null,
