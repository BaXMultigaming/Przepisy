  "ingredients": [
    "1 cup full-fat plain Greek yogurt",
    "1 cup lightly packed chopped cilantro",
    "2 tablespoons lemon juice",
    "1 tablespoon jarred minced garlic",
    "2 teaspoons kosher salt",
    "1 teaspoon ground cumin",
    "1 teaspoon ground cayenne pepper",
    "1 teaspoon ground black pepper",
    "3.5 pounds chicken thighs"
  ],
  "steps": [
    {
      "text": "Mix Greek yogurt, cilantro, lemon juice, garlic, salt, cumin, cayenne, and pepper together in a large bowl. Place chicken thighs in a large resealable plastic bag; cover with yogurt mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let chicken marinate in the refrigerator, 3 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring chicken to room temperature, about 30 minutes. Pour off marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat grill for medium heat and lightly oil the grate. Grill chicken, turning occasionally, until grill marks form, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
