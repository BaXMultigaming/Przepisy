  "ingredients": [
    "2 bananas",
    "2 squares graham crackers, broken into small pieces",
    "2 tablespoons semisweet chocolate chips",
    "2 tablespoons miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to the manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice the bananas lengthwise, making sure not to cut through the bottom peel. Slightly open the bananas to form a pocket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide graham crackers, chocolate chips, and marshmallows between the pockets. Place the banana boats into the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry until banana skins have blackened and marshmallows are toasted, about 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
