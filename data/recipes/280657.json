  "steps": [
    {
      "text": "Place the air fryer close to an exhaust fan and preheat to 285 degrees F (140 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon onto a cutting board and slice in half crosswise. Stuff each date with 1 almond and wrap with 1/2 slice of bacon. Place the bacon-wrapped dates into the basket of the air fryer, end side down, not touching.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry until fat has been rendered, 10 to 11 minutes. Remove to a paper towel-lined plate to drain. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
