  "ingredients": [
    "1 cup non-fat Greek yogurt",
    "0.25 cup mayonnaise",
    "0.25 cup stone-ground mustard",
    "1 tablespoon pickle juice",
    "1 tablespoon capers",
    "1 teaspoon prepared horseradish",
    "1 clove garlic, crushed",
    "0.5 teaspoon hot pepper sauce (such as Frank's RedHot®)",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon hot paprika"
  ],
  "steps": [
    {
      "text": "Blend yogurt, mayonnaise, mustard, pickle juice, capers, horseradish, garlic, hot pepper sauce, cayenne, and paprika together in the bowl of a food processor. Chill until ready to serve, at least 30 minutes.",
