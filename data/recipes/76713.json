  "ingredients": [
    "6 slices bacon",
    "2 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "10 medium potatoes, peeled and shredded",
    "2 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet over medium-high heat to cook. Remove bacon from the pan and reserve the grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour and baking powder in a medium bowl. Stir in potatoes to make a sticky dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to a boil and add salt. Shape potato mixture into 6 or 7 dumplings, or your desired size. Drop carefully into the boiling water. Simmer for 45 to 60 minutes. Remove to a platter with a slotted spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with bacon grease brushed over the top and crumbled bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
