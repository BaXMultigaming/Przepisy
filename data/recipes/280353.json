  "ingredients": [
    "5 cups cauliflower florets",
    "5 cups broccoli florets",
    "1 pound fresh asparagus, trimmed and halved",
    "4 medium carrots, cut into matchsticks",
    "1 medium red bell pepper, cut into matchsticks",
    "1 medium red onion, sliced and separated into rings",
    "0.5 cup olive oil",
    "3 tablespoons lemon juice",
    "3 cloves garlic, minced",
    "1 tablespoon dried rosemary, crushed",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cauliflower, broccoli, asparagus, carrots, bell pepper, and onion in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, lemon juice, garlic, rosemary, salt, and pepper together in a small bowl until blended. Drizzle over vegetables and toss to coat. Transfer to 2 rimmed baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven, tossing occasionally, until tender, 20 to 25 minutes.",
