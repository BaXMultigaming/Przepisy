  "ingredients": [
    "1 tablespoon olive oil",
    "0.5 medium yellow onion, chopped",
    "1 clove garlic, minced",
    "1 link apple-chicken sausage, diced",
    "2 cups low-sodium chicken broth",
    "1 (15 ounce) can pumpkin puree",
    "0.5 cup light sour cream",
    "0.5 cup 2% milk",
    "2 tablespoons light cream cheese",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 pinch ground cardamom",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a pan over medium-high heat. Add onion and cook until translucent, about 7 minutes. Add garlic and cook until fragrant, about 1 minute. Add sausage; cook and stir for 5 more minutes. Add chicken broth and simmer for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in pumpkin puree, sour cream, milk, cream cheese, cinnamon, nutmeg, and cardamom until well blended. Reduce heat to low and cook, stirring occasionally, until sauce thickens, about 5 minutes. Season with pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
