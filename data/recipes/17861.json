  "ingredients": [
    "1.5 cups graham cracker crumbs",
    "3 tablespoons white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 cup margarine",
    "3 (8 ounce) packages cream cheese",
    "1.5 cups white sugar",
    "4 eggs",
    "2 teaspoons vanilla extract",
    "0.25 teaspoon salt",
    "2 cups sour cream"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). In a medium bowl, combine graham cracker crumbs, 3 tablespoons sugar, cinnamon and melted margarine. Mix all ingredients well and press into bottom and sides of a 9 inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat cream cheese and sugar until smooth. Blend in the eggs one at a time, then stir in the vanilla and salt. Fold in the sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into springform pan. Bake in preheated oven for 1 hour. Turn off oven and leave cake in for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
