  "ingredients": [
    "2 tablespoons olive oil",
    "4 cloves garlic, minced",
    "1 pound Italian sausage",
    "4 green onions, chopped",
    "1 (8 ounce) package fresh mushrooms, sliced",
    "1 tablespoon dried basil",
    "1 tablespoon dried oregano",
    "1 (15 ounce) can tomato sauce",
    "1 (14.5 ounce) can stewed tomatoes",
    "1 (6 ounce) can tomato paste",
    "0.5 cup water",
    "0.5 cup red wine",
    "2 tablespoons white sugar",
    "1 teaspoon red pepper flakes",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large skillet over medium-high heat. Sauté garlic in hot oil until browned. Add sausage and cook for 4 minutes, breaking apart with a spoon. Add green onions and cook until sausage is evenly browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in mushrooms, basil, and oregano; cook for 5 minutes. Stir in tomato sauce, stewed tomatoes, and tomato paste. Add water, red wine, sugar, and red pepper flakes. Season with salt and pepper. Reduce heat to low and simmer for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
