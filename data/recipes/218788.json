  "title": "Faye&#39;s Duck Dressing",
  "description": "A rich, moist cornbread dressing made with duck is a special treat for your holiday table.",
  "authors": [
    "Lu"
  ],
  "date_published": "2018-06-08T09:59:13-04:00",
