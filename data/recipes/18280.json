  "ingredients": [
    "1.5 pounds new potatoes, cut into wedges",
    "4 tablespoons butter",
    "2 teaspoons fresh rosemary",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a hot skillet, melt butter. Stir in rosemary, salt, and pepper. Add potatoes and coat potatoes evenly with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange potatoes in a single layer on a baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are golden brown, 20 to 25 minutes, tossing them occasionally to ensure that they brown on all sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
