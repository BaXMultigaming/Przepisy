  "ingredients": [
    "6 slices maple-cured bacon, chopped",
    "1.5 cups white sugar",
    "1 cup softened butter",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "0.66666668653488 cup cocoa powder",
    "0.75 teaspoon baking soda",
    "0.25 teaspoon salt",
    "2 cups semi-sweet chocolate chunks"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the bacon in a large, deep skillet, and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain the bacon slices on a paper towel-lined plate. Crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the sugar, butter, eggs, and vanilla extract with an electric mixer in a large bowl until fluffy and smooth. Stir in flour, cocoa powder, baking soda, and salt. Mix in the chocolate chips and bacon. Drop cookies by rounded spoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 to 12 minutes in the preheated oven. Let stand 5 minutes before transferring to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
