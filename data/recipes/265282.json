  "ingredients": [
    "1 cup butter, at room temperature",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 large egg",
    "2 teaspoons vanilla extract",
    "2 cups flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 cup chopped hazelnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, white sugar, and brown sugar together in a large bowl using an electric mixer. Add egg and vanilla extract and beat until well combined. Mix flour, baking powder, and salt in a separate bowl and mix into egg mixture until just combined. Fold in chopped hazelnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a tablespoon to cut off little portions of dough; roll them into balls. Place on the prepared baking sheet with room in between.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 10 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
