  "ingredients": [
    "4.5 cups peeled, cored and sliced apples",
    "2 teaspoons lemon juice",
    "2 tablespoons water",
    "0.5 cup honey",
    "1 teaspoon ground cinnamon",
    "0.75 cup brown sugar",
    "0.75 cup all-purpose flour",
    "0.75 cup rolled oats",
    "4 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a medium casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Evenly spread the apple slices in the prepared dish. In a small bowl, mix the lemon juice and water, and pour over the apples. Drizzle apples with honey, and sprinkle with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix the brown sugar, flour, oats, and butter until the mixture resembles coarse crumbs. Sprinkle over the apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 25 minutes in the preheated oven, until apples are tender and topping is lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
