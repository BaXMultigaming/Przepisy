  "ingredients": [
    "1.5 pounds zucchini, grated",
    "0.75 teaspoon salt",
    "0.25 cup all-purpose flour",
    "0.25 cup grated Parmesan cheese",
    "1 large egg, beaten",
    "2 cloves garlic, minced",
    "kosher salt and ground black pepper to taste",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Toss zucchini and salt together in a large colander; place in sink to drain for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UEzOqQtYr3M9C0IVpqWZUGShUrM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241422-ZucchiniFritters-ddmps-step-1-4x3-104314-23dbe1d852ae4d8687682fa5a7a38596.jpg"
      ],
      "image": "assets/images/241422/step_01.webp"
    },
    {
      "text": "Transfer zucchini to the center of a piece of cheesecloth; wrap cheesecloth around zucchini and squeeze to drain as much moisture as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QwZNXmARl-dxRhNATyHz2tQ3Dlw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241422-ZucchiniFritters-ddmps-step-2-4x3-104321-c6047a540868405d943050a0ae92c3a8.jpg"
      ],
      "image": "assets/images/241422/step_02.webp"
    },
    {
      "text": "Combine flour, Parmesan cheese, egg, and garlic in a large bowl. Stir in zucchini; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WP7cXj8v5NhcMydPokQTBJDfEzs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241422-ZucchiniFritters-ddmps-step-3-4x3-104323-f3baddf555fc4bf1b61aac09c0b8896a.jpg"
      ],
      "image": "assets/images/241422/step_03.webp"
    },
    {
      "text": "Heat olive oil in a large skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop tablespoonfuls of zucchini mixture into the hot skillet, working in batches, and fry until golden brown, about 2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G4onwdN36nOtBJos7Xp7MAFT_-g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241422-ZucchiniFritters-ddmps-step-5-4x3-104341-d4c41b1812224b8e8c299c159d09c068.jpg"
      ],
      "image": "assets/images/241422/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gBkKog0-xgXdzuKzSA4063Q-kJM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241422-easy-zucchini-fritters-DDMFS-4x3-bc4d3297e15b479aafee05dbf9eb67d3.jpg"
      ],
      "image": "assets/images/241422/step_06.webp"
    }
