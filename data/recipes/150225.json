  "ingredients": [
    "2.5 pounds hubbard squash - cut into chunks and seeds removed",
    "3 large eggs",
    "0.5 cup firmly packed dark brown sugar",
    "0.5 cup heavy cream",
    "2 tablespoons salted butter, softened",
    "1.5 teaspoons apple pie spice",
    "0.5 teaspoon salt",
    "1 (9 inch) unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange squash on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven until skin is browned and flesh is tender, about 45 minutes; cool before handling. Remove flesh from squash using a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce the oven temperature to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 2 cups squash flesh in the bowl of a food processor; pulse until smooth. Add eggs, brown sugar, cream, butter, apple pie spice, and salt; pulse until smooth. Pour squash filling into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling rises, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
