  "ingredients": [
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup white sugar",
    "0.5 cup butter, room temperature",
    "2 large eggs, room temperature",
    "1 teaspoon vanilla extract",
    "0.75 cup milk, room temperature"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8-inch square baking pan; line the bottom with parchment or wax paper, or dust lightly with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WXVXxiixybqqfCUw3yJJeQbpYag=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7460-butter-cake-Step1-1443-3657a37082014e5dbd9f43292cda75a6.jpg"
      ],
      "image": "assets/images/7460/step_02.webp"
    },
    {
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until light and fluffy. Add eggs one at a time, beating well after each addition. Beat in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nG5nyYHHBKcpFJuit6OZIqn0ZT8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7460-butter-cake-ddmfs-Step2-1444-80cbf8c5e3eb43fe839c96cb4ac63579.jpg"
      ],
      "image": "assets/images/7460/step_03.webp"
    },
    {
      "text": "Add flour mixture in 1/2 cup batches, alternating with milk, beating batter briefly after each addition until just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8jiFFWR9ZzVhYXAsmM6ghDIruqs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7460-butter-cake-ddmfs-Step3-1446-49cb1e605cd649a28648b0f9d011887d.jpg"
      ],
      "image": "assets/images/7460/step_04.webp"
    },
    {
      "text": "Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2-5-GS6TDjbOF62aCIl_cdoO5dI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7460-butter-cake-ddmfs-Step4-1447-b70302f9f18645eda2f48c525d9d28e8.jpg"
      ],
      "image": "assets/images/7460/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes. Let cool in pan for 10 minutes before inverting onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T5SKlKc9ioYDmsPR0MXzmyrRmIo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7460-butter-cake-ddmfs-Step5-1466-3626068ac5774d6abdc88f0077576bfb.jpg"
      ],
      "image": "assets/images/7460/step_06.webp"
    }
