  "ingredients": [
    "0.25 cup margarine",
    "1 cup chopped celery",
    "0.33329999446869 cup chopped onion",
    "3 (14.5 ounce) cans chicken broth",
    "1 tablespoon all-purpose flour",
    "1 cup crunchy peanut butter",
    "2 cups heavy whipping cream"
  ],
  "steps": [
    {
      "text": "In a 4 quart saucepan saute celery and onion in butter overmedium-high heat. Saute until celery and onion are tender, approximately five minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and add the flour and peanut butter, stirring until melted. Once melted gradually stir in chicken broth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to medium-high heat and bring to boil for two minutes. Reduce heat and simmer uncovered approximately 10 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in heavy cream and heat through.",
      "section": null,
