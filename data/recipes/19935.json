  "ingredients": [
    "1 medium head cabbage, shredded",
    "2 cucumbers, thinly sliced",
    "3 carrots, thinly sliced",
    "1 Bermuda onion, thinly sliced",
    "0.75 cup distilled white vinegar",
    "0.75 cup white sugar",
    "0.5 cup vegetable oil",
    "4 tablespoons water",
    "3 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Combine cabbage, cucumbers, carrots, and onion in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together vinegar, sugar, oil, water, and salt in a small bowl. Pour over the cabbage mixture, toss to coat, and refrigerate for at least 12 hours. Drain excess liquid before serving.",
