  "ingredients": [
    "2 pounds beef sirloin steak, sliced thinly across the grain",
    "2 large white onions, sliced into rings",
    "1 cup beef stock",
    "0.5 cup olive oil",
    "0.25 cup distilled white vinegar",
    "2 tablespoons minced garlic",
    "1 (.18 ounce) packet sazon seasoning",
    "1 teaspoon salt",
    "1 pinch dried oregano"
  ],
  "steps": [
    {
      "text": "Combine steak, onions, beef stock, olive oil, vinegar, garlic, Sazón seasoning, salt, and oregano in a large resealable plastic bag; toss to coat steak with marinade. Squeeze out excess air and seal the bag. Marinate in the refrigerator at least 4 hours up to 2 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer steak and marinade to a large deep skillet; bring to a boil. Reduce heat to low; cover and simmer until steak is fork-tender, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
