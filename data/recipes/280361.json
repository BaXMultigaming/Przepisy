  "ingredients": [
    "2 large eggs",
    "1 tablespoon white sugar",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 tablespoon unsalted butter",
    "4 slices white bread"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
