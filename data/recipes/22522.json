  "ingredients": [
    "3 large sweet potatoes",
    "0.5 cup butter, softened",
    "1 tablespoon vanilla extract",
    "2 cups sugar, or more to taste",
    "0.5 teaspoon ground nutmeg",
    "4 eggs, beaten",
    "0.75 cup evaporated milk",
    "2 (9 inch) unbaked pie shells"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil. Add sweet potatoes and cook until tender but still firm, about 30 minutes. Drain and cool; peel and mash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sweet potatoes, butter, sugar, vanilla, and nutmeg in a large bowl. Whisk eggs and milk together in a small bowl; blend into sweet potato mixture. Pour filling into pie shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pies in the preheated oven for 60 minutes, or until a knife inserted in the center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
