  "ingredients": [
    "2 tablespoons vegetable oil",
    "0.5 medium head cabbage, sliced",
    "1 tablespoon butter",
    "salt to taste",
    "1 sheet frozen puff pastry, thawed",
    "1 egg",
    "1 tablespoon water",
    "1.3333333730698 cups shredded Swiss cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Add cabbage and cook for about 18 minutes. Stir in butter and season with salt. Continue cooking until cabbage is soft, about 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll puff pastry out on a lightly floured surface into a large square. Place into a springform pan, allowing the corners to hang over the sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg and water together in a bowl and stir in Swiss cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cooked cabbage into the pastry-lined pan and cover with egg mixture. Fold pastry corners over filling and punch together in the middle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pastry is golden brown, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
