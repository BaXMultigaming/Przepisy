  "title": "Savory Puff Pastry Quiche with Cabbage",
  "description": "This is a simple winter quiche made with puff pastry, sauteed cabbage, egg, and Swiss cheese, perfect for the weekend.",
  "authors": [
    "Natasha Titanov"
  ],
  "date_published": "2019-04-04T00:14:19-04:00",
