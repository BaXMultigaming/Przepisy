  "ingredients": [
    "1 tablespoon duck fat",
    "3 unpeeled red potatoes, diced",
    "1 teaspoon dried parsley",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground white pepper"
  ],
  "steps": [
    {
      "text": "Melt duck fat in a large skillet over medium-high heat until shimmering, about 1 minute. Add potatoes; cook, stirring minimally, until potatoes are golden brown, 5 to 10 minutes. Drain excess fat.",
      "section": null,
