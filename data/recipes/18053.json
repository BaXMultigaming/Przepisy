  "ingredients": [
    "1 cup pancake/waffle mix",
    "2 teaspoons white sugar",
    "1 teaspoon ground cinnamon",
    "0.5 cup cold milk",
    "2 eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
