  "ingredients": [
    "1 cup boiling water",
    "0.5 cup kosher salt",
    "0.5 cup molasses",
    "4 whole cloves",
    "7 cups cold water",
    "4 (2 1/4 inch thick) center cut, bone-in pork chops",
    "0.5 teaspoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Combine boiling water, salt, molasses, and cloves in a large container, stirring until salt and molasses are dissolved. Cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cold water into molasses brine to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Submerge pork chops completely in molasses brine. Cover container and refrigerate for 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pork chops from brine; pat dry with paper towels. Lightly oil each chop. Discard brine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook pork chops on the hottest part of the preheated grill until both sides of each chop is browned, 2 to 3 minutes. Transfer chops to the medium-high part of the grill; cook until slightly pink in centers, 6 to 8 minutes per side. An instant-read thermometer inserted into centers should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
