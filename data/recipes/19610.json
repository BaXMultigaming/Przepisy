  "ingredients": [
    "2 cups tomato juice",
    "0.5 cup butter",
    "0.25 cup finely chopped onion",
    "0.33333334326744 cup ketchup",
    "1 teaspoon dry mustard",
    "1 teaspoon salt",
    "0.5 teaspoon paprika",
    "0.5 teaspoon ground black pepper",
    "1 clove garlic, minced",
    "1 tablespoon Worcestershire sauce",
    "1 dash hot sauce",
    "2 pounds beef sirloin, cut into 1 inch cubes",
    "0.5 pound fresh mushrooms, stems removed",
    "1 pint cherry tomatoes",
    "1 large onion, quartered",
    "1 large green bell pepper, cut into 1 inch pieces",
    "skewers"
  ],
  "steps": [
    {
      "text": "In a saucepan over low heat, mix the tomato juice, butter, onion, ketchup, mustard, salt, paprika, pepper, garlic, Worcestershire sauce, and hot sauce. Simmer for 30 minutes, remove from heat, and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat grill for medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thread the sirloin cubes, mushrooms, cherry tomatoes, onion quarters, and green pepper pieces onto skewers, alternating as desired. Drizzle some of the sauce over the kabobs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Oil the grill grate. Arrange kabobs on the grill. Grill 10 minutes, or until meat is cooked through, occasionally turning kabobs. Baste with sauce during the last 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
