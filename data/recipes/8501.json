  "title": "Buffalo Chicken Fingers",
  "description": "These garlic-and-cayenne-stoked chicken breast morsels are baked instead of fried for a low fat version of Buffalo Wings.",
  "authors": [
    "Bobbi Jo"
  ],
  "date_published": "1999-04-22T02:44:37-04:00",
