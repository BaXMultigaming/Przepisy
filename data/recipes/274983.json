  "ingredients": [
    "4 cups fresh mint leaves, or to taste",
    "2 cups milk",
    "1 cup white sugar",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "2 cups heavy cream",
    "1 cup mini chocolate chips"
  ],
  "steps": [
    {
      "text": "Blend mint, milk, sugar, vanilla, and salt together on high speed until the mint leaf bits are tiny, about 1 minute. Add heavy cream and blend until uniform, about 15 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer's instructions, about 20 minutes, adding chocolate chips during the last 5 minutes. Transfer to an airtight container and freeze until firm, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
