  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "1.5 teaspoons ground allspice",
    "3 overripe bananas, thinly sliced",
    "0.5 cup banana-flavored yogurt",
    "3 tablespoons white sugar",
    "1 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8x4-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup sugar and butter in a bowl; beat with an electric mixer until creamy. Beat in eggs and vanilla extract. Mix in flour and allspice gradually until batter is blended. Fold in bananas and banana-flavored yogurt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 3 tablespoons sugar and cloves together in a small bowl; sprinkle over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
