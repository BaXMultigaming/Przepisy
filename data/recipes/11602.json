  "ingredients": [
    "0.5 cup butter or margarine",
    "1 cup graham cracker crumbs",
    "1.5 cups semisweet chocolate chips",
    "1.5 cups butterscotch chips",
    "1.5 cups flaked coconut",
    "1 cup chopped walnuts",
    "1 (14 ounce) can sweetened condensed milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the butter or margarine in a 9x13 inch baking pan. Sprinkle the graham cracker crumbs evenly over the butter. Sprinkle on the chocolate chips and butterscotch chips. Cover with the flaked coconut. Sprinkle the walnuts on top of the coconut layer. Finally, pour the condensed milk over everything as evenly as you can.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 to 35 minutes in the preheated oven. Cool, and cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
