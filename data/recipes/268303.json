  ],
  "steps": [
    {
      "text": "Place chocolate in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until chocolate is melted, about 5 minutes. Remove from heat and cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a baking sheet with parchment paper. Spoon melted chocolate into a small resealable plastic bag and cut off a small corner.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pipe Christmas tree shape onto the parchment paper and allow to harden in a cool place overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once the chocolate has hardened, carefully remove chocolate trees from paper and use to decorate Christmas cakes or desserts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
