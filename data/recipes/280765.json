  "ingredients": [
    "1 (3 pound) pork tenderloin, trimmed",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 large onion, chopped",
    "0.5 cup cider vinegar",
    "0.33333334326744 cup water",
    "2 tablespoons prepared yellow mustard",
    "2 slices lemon, seeded",
    "1 tablespoon unsalted butter",
    "2 teaspoons honey",
    "0.5 teaspoon cayenne pepper",
    "1 cup ketchup",
    "4 tablespoons Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C) with a rack positioned in the center of the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a Dutch oven over medium-high heat. Season pork with salt and black pepper. Sear in the Dutch oven on all sides, about 5 minutes total. Transfer to a plate; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine onion, vinegar, water, mustard, lemon slices, butter, honey, and cayenne pepper in the Dutch oven; simmer for 20 minutes. Discard lemon slices. Add ketchup and Worcestershire sauce; return to a boil. Add pork; cover the Dutch oven tightly with a lid or aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven until pork is fork-tender, about 3 hours. Check occasionally to see if a bit of water should be added to Dutch oven to keep from burning. Shred pork in sauce using 2 forks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
