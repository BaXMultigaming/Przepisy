  "ingredients": [
    "baking spray",
    "2 cups all-purpose flour",
    "1.25 cups white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon pumpkin pie spice",
    "0.5 teaspoon kosher salt",
    "1 cup applesauce",
    "1 cup apple cider",
    "1 extra large egg, lightly beaten",
    "2 tablespoons unsalted butter, melted",
    "2 teaspoons vanilla extract",
    "0.5 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "4 tablespoons unsalted butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 12-cup muffin pan with baking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, sugar, baking powder, cinnamon, pumpkin pie spice, and kosher salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together applesauce, apple cider, egg, melted butter, and vanilla in a medium bowl until well combined. Stir into flour mixture gradually until ingredients are combined. Spoon batter into the prepared pan, filling each cup 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a donut comes out clean, about 17 minutes. Remove from the oven and let cool for 5 minutes before removing donuts from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make topping: Stir together sugar and cinnamon in a shallow dish until well combined. Brush melted butter on both sides of donuts, then dip into sugar-cinnamon mixture to evenly coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
