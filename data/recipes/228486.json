  "ingredients": [
    "1 pastry for double-crust pie",
    "0.33333334326744 cup butter",
    "0.5 cup thinly sliced onion",
    "1 stalk celery, thinly sliced",
    "0.33333334326744 (12 ounce) package extra-firm tofu, cubed",
    "2 cloves garlic, minced",
    "0.25 cup cubed red potatoes",
    "0.5 teaspoon oregano",
    "salt and ground black pepper to taste",
    "0.33333334326744 cup all-purpose flour",
    "0.66666668653488 cup milk",
    "1.5 cups vegetable broth",
    "1 cup frozen mixed vegetables"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place 1 crust into a 9-inch pie plate; chill until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a large skillet over medium heat. Add onion, celery, tofu, and garlic; cook until onion is tender and translucent, 10 to 15 minutes. Season with oregano, salt, and black pepper; stir in flour until vegetable mixture coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly stir milk into vegetable mixture; cook until begins to thicken, about 5 minutes. Add vegetable broth; cook until mixture thickens, about 5 minutes more. Stir in frozen vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour filling into crust; top with remaining pie crust, crimping edges together to seal. Poke ventilation holes in top crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden brown and filling is bubbling, 30 to 35 minutes. Cool before serving for 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
