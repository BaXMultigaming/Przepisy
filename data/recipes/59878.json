  "ingredients": [
    "2 (8 ounce) bottles Italian dressing",
    "0.5 cup soy sauce",
    "0.25 cup Worcestershire sauce",
    "10 cloves garlic, minced",
    "1 teaspoon ground mustard",
    "1 teaspoon ground ginger",
    "0.33333334326744 cup brown sugar",
    "4 pounds bone-in chicken parts"
  ],
  "steps": [
    {
      "text": "Mix Italian dressing, soy sauce, Worcestershire sauce, garlic, mustard, ginger, and brown sugar in a large container. Place chicken in the container and marinate in the refrigerator, 8 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil grill grate. Discard marinade and place chicken on the grill. Cook until chicken juices run clear, about 30 minutes. Smaller parts will be done more quickly. An instant-read thermometer inserted near the bone should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
