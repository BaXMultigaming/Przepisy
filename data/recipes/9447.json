  "ingredients": [
    "1 cup packed brown sugar",
    "1 teaspoon vanilla extract",
    "2 tablespoons butter",
    "1 cup boiling water",
    "0.5 cup white sugar",
    "0.75 cup all-purpose flour",
    "0.5 cup milk",
    "1 teaspoon baking powder",
    "0.75 cup chopped nuts",
    "0.5 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9 inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together brown sugar, boiling water, vanilla, and butter. Pour into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a clean bowl, mix together white sugar, flour, milk, baking powder, nuts, and raisins. Drop by spoonfuls on top of the mixture in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
