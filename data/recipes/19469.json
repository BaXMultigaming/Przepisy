  "ingredients": [
    "1 cup white sugar",
    "1 tablespoon instant tapioca",
    "1 tablespoon cornstarch",
    "0.125 teaspoon salt",
    "4 cups rhubarb, cut into 1/2 inch pieces",
    "1 cup raspberries",
    "0.5 cup brown sugar",
    "0.5 cup all-purpose flour",
    "0.5 cup quick cooking oats",
    "0.5 cup butter, chilled"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together white sugar, tapioca, cornstarch, and salt in a large bowl until well combined. Add rhubarb and raspberries; toss until evenly coated. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, flour, and oats in a medium bowl. Cut in butter until mixture resembles pea-sized crumbs. Spread on top of fruit mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until rhubarb is tender, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
