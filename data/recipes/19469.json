  "title": "Rhubarb-Raspberry Crunch",
  "description": "This rhubarb raspberry crisp with fresh raspberries features a buttery topping of oats and brown sugar and is great served warm with vanilla ice cream.",
  "authors": [
    "Scott Cole"
  ],
  "date_published": "2000-07-03T21:03:54-04:00",
