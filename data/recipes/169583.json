  "ingredients": [
    "2 cups water",
    "2 cubes chicken bouillon",
    "1 clove garlic, smashed",
    "1 cup uncooked quinoa",
    "2 large cooked chicken breasts - cut into bite size pieces",
    "1 large red onion, diced",
    "1 large green bell pepper, diced",
    "0.5 cup chopped kalamata olives",
    "0.5 cup crumbled feta cheese",
    "0.25 cup chopped fresh parsley",
    "0.25 cup chopped fresh chives",
    "0.5 teaspoon salt",
    "0.66666668653488 cup fresh lemon juice",
    "1 tablespoon balsamic vinegar",
    "0.25 cup olive oil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ihSGU6ibbaNhpFMWjv3uXEWPsg0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/169583-mediterranean-quinoa-salad-VAT-005-step-01-1-9045e0e39cdb4f7f953c7b6027a1809a.jpg"
      ],
      "image": "assets/images/169583/step_01.webp"
    },
    {
      "text": "Bring water, bouillon cubes, and garlic to a boil in a saucepan. Stir in quinoa; reduce heat to medium-low, cover, and simmer until quinoa is tender and water has been absorbed, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
