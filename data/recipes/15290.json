  "ingredients": [
    "1 cup shortening",
    "1.5 cups white sugar",
    "3 eggs",
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 (9 ounce) package condensed mincemeat, crumbled"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the shortening and sugar until fluffy. Add the eggs one at a time, beating after each addition. Sift together the flour, baking soda and salt; stir into the creamed mixture. Finally, stir in the mincemeat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by teaspoons onto the prepared baking sheets. Bake 8 to 10 minutes in the preheated oven. Remove from baking pans to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
