  "ingredients": [
    "5 apples - peeled, cored and sliced",
    "0.66666668653488 cup maple syrup",
    "0.5 cup butter",
    "0.5 cup brown sugar",
    "0.75 cup all-purpose flour",
    "0.75 cup rolled oats",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place apples in an 8x8-inch baking dish. Pour maple syrup over apples. Cream butter and sugar together in a large bowl. Stir in flour, oats, and salt. Sprinkle mixture evenly over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden, bubbly, and apples are tender, about 35 minutes..",
