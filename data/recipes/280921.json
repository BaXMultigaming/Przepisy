  "ingredients": [
    "4 ears corn on the cob, husked",
    "0.25 cup Mexican sour cream",
    "1 tablespoon olive oil",
    "2 teaspoons lime juice",
    "2 teaspoons Mexican seasoning mix (such as Goya® Sazonador Total)",
    "0.25 teaspoon adobo seasoning (such as Goya®)",
    "0.5 cup chopped green onions",
    "0.5 cup finely chopped red bell pepper",
    "1 bunch fresh cilantro, chopped"
  ],
  "steps": [
    {
      "text": "Cut the corn kernels off the cob using a sharp knife.",
