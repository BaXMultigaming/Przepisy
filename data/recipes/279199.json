  "ingredients": [
    "4 cups chopped cauliflower",
    "2 tablespoons water",
    "0.5 (8 ounce) package cream cheese, cubed",
    "1 tablespoon butter",
    "2 green onions, chopped",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
