  "ingredients": [
    "4 cups uncooked glutinous white rice",
    "6 cups cold water",
    "1 (14 ounce) can coconut milk, divided",
    "1.3333333730698 cups white sugar",
    "1.3333333730698 cups brown sugar",
    "3 tablespoons coconut preserves (such as Phil Supreme®)"
  ],
  "steps": [
    {
      "text": "Soak rice overnight in the water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook the soaked rice over medium heat in a saucepan with the soaking water, 1/2 can of coconut milk, and white sugar, stirring constantly, until tender and thickened, about 20 minutes. Pour into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together the brown sugar, remaining 1/2 can of coconut milk, and coconut preserves in a small saucepan, and bring to a boil. Pour the mixture carefully over the rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the topping thickens, about 25 minutes. Cool completely; cut into squares to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
