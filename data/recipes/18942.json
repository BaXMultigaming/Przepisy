  "ingredients": [
    "1 quart water",
    "3 orange spice tea bags",
    "2 cups apple cider",
    "1.5 cups light rum",
    "0.5 cup light brown sugar",
    "2 cinnamon sticks",
    "3 teaspoons butter",
    "6 cinnamon sticks, garnish"
  ],
  "steps": [
    {
      "text": "Pour water into a large saucepan and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and add orange spice tea bags. Cover and let steep for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tea bags and stir in apple cider, rum, brown sugar, and 2 cinnamon sticks. Heat cider over medium-low heat until just steaming.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle hot cider into 6 mugs and drop 1/2 teaspoon butter into each. Garnish with a cinnamon \"swizzle\" stick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
