  "ingredients": [
    "8 strips bacon",
    "1 stalk celery, finely chopped",
    "2 tablespoons minced fresh garlic",
    "5 cups finely chopped cauliflower",
    "2 tablespoons water",
    "1 teaspoon onion powder",
    "2 cups milk",
    "2 cups chicken broth, divided",
    "3 dashes hot sauce, or to taste",
    "2 tablespoons flour",
    "2 cups shredded sharp Cheddar cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large pot over medium heat, turning occasionally, until crispy, 10 to 12 minutes. Transfer to a paper towel-lined plate with a slotted spoon, leaving drippings in the pot. Crumble bacon; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add celery and garlic to the pot; cook until celery is tender, 3 to 4 minutes. Add cauliflower, water, and onion powder; cover pot and steam cauliflower, stirring occasionally, until cauliflower is tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add milk, 1 3/4 cups chicken broth, and hot sauce; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk flour into remaining chicken broth in a small bowl; slowly stir into boiling chowder. Add Cheddar cheese and 1/2 bacon; stir until smooth and cheese has melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with salt, black pepper, and hot sauce. Top servings with remaining 1/2 bacon.",
      "section": null,
      "name": null,
      "url": null,
