      ],
      "image": "assets/images/229993/step_01.webp"
    },
    {
      "text": "Melt butter and margarine in a saucepan over medium-low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eiyqpB95GyOWOaXHJZZMQt09Sfo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229993_White_Sauce_for_Pasta_step_1_02_5942-d246d1a1e368477594d87bd353b09204.jpg"
      ],
      "image": "assets/images/229993/step_02.webp"
    },
    {
      "text": "Add flour and crumbled bouillon; stir until well blended, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C8rPdsbssfBMnLujkPAQksktftE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229993_White_Sauce_for_Pasta_step_2_5943-0ec409c35ea343c3bb488809024d1735.jpg"
      ],
      "image": "assets/images/229993/step_03.webp"
    },
    {
      "text": "Continue to cook and stir until thickened and lightly browned, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d8GpmPYF2wdGQFm2gFAaNoN9enY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229993_White_Sauce_for_Pasta_step_3_5945-3b3d6628ee7d45d3804f30b8c1ea004b.jpg"
      ],
      "image": "assets/images/229993/step_04.webp"
    },
    {
      "text": "Increase the heat to medium and whisk in water until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XI4VLjRZD69SfyftsIaeh5iH7rw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229993_White_Sauce_for_Pasta_step_4_5946-0ed63eb223514c8e95f105ff013ea442.jpg"
