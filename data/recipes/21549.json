  "ingredients": [
    "1 cup brown sugar",
    "1 cup white sugar",
    "2.25 cups all-purpose flour",
    "0.75 cup butter, melted",
    "1 teaspoon vanilla extract",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon ground ginger",
    "1 egg",
    "1 cup buttermilk",
    "0.25 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease and flour a 9x5-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, white sugar, and flour in a large bowl. Stir in melted butter until mixture resembles coarse crumbs. Add vanilla extract. Mix in baking soda, baking powder, cinnamon and ginger. Reserve 1/4 cup this mixture to be used as topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg and buttermilk together in a separate bowl; stir slowly into flour mixture. Pour batter into prepared pan. Sprinkle batter with reserved topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted into center of the cake comes out clean, about 30 minutes. Sprinkle with powdered sugar and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
