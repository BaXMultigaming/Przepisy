  "ingredients": [
    "1 (10 ounce) package silken tofu, drained",
    "2 teaspoons grated lemon zest",
    "1 lemon, juiced",
    "4 cloves garlic, chopped",
    "1 cup water",
    "2 teaspoons vegetarian Worcestershire sauce",
    "3 tablespoons grated Parmesan cheese",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a blender or food processor combine tofu, lemon zest and juice, garlic, water, Worcestershire sauce, Parmesan cheese, salt and pepper. Puree until smooth. If the consistency is too thick, add more water.",
