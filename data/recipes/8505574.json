  "ingredients": [
    "1 tablespoon unsalted butter",
    "2 cloves garlic, minced",
    "0.5 cup chicken broth",
    "0.5 cup whipping cream",
    "1 (3 ounce) package ramen noodles (without flavor packet)",
    "1 teaspoon reduced-sodium soy sauce",
    "0.25 cup chopped cooked chicken",
    "1 pinch everything bagel seasoning (optional)"
  ],
  "steps": [
    {
      "text": "Melt butter in a heavy skillet over medium heat. Add minced garlic and cook, stirring, until fragrant, about 30 seconds. Add chicken broth, cream, and ramen noodles. Cook, stirring occasionally, until noodles soften, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add soy sauce and chopped cooked chicken. Allow to get hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve garnished with everything bagel seasoning if desired.",
      "section": null,
