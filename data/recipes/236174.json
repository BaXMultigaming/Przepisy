  "title": "Japchae",
  "description": "Japchae is a traditional Korean dish made with colorful sweet potato glass noodles, marinated beef strips, and veggies in a delicious sesame sauce.",
  "authors": [
    "kpopkiwi"
  ],
  "date_published": "2020-06-18T23:58:03-04:00",
