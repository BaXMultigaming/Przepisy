  "ingredients": [
    "1 (16 ounce) package dried navy beans",
    "7 cups water",
    "1 ham bone",
    "2 cups diced ham",
    "0.25 cup minced onion",
    "0.5 teaspoon salt",
    "1 pinch ground black pepper",
    "1 bay leaf",
    "0.5 cup sliced carrots",
    "0.5 cup sliced celery"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8YKkf5TS_WaHsyP-R5dZN_rRXBw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13346-bean-soup-ddmfs-4x3-ingredients-0067872feafc4a3791bb15a07bce1e19.jpg"
      ],
      "image": "assets/images/13346/step_01.webp"
    },
    {
      "text": "Rinse beans; transfer to a large stockpot and add water. Bring to a boil and simmer for 2 minutes; remove from heat, cover, and let stand for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7cwOCxEEwQ69iYCDrO-P-1A5okA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13346-bean-soup-ddmfs-4x3-steps-02-4d3dc49a07504bc38fe939d3508326dd.jpg"
      ],
      "image": "assets/images/13346/step_02.webp"
    },
    {
      "text": "Add ham bone, diced ham, onion, salt, pepper, and bay leaf. Bring to a boil; reduce heat to low, cover, and simmer until beans are soft, about 1 hour and 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IdSsDI0B6O32VyJMK2QGgRzODeg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13346-bean-soup-ddmfs-4x3-steps-03-101165e59752439598c203d0d2290f05.jpg"
      ],
      "image": "assets/images/13346/step_03.webp"
    },
    {
      "text": "Add carrots and celery; cook until tender, about 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SXvc8-Op6AVs6usvUSX_Ta6zQng=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13346-bean-soup-ddmfs-4x3-steps-04-5fa6c00019f7403bb7af316084a255fc.jpg"
      ],
      "image": "assets/images/13346/step_04.webp"
    },
    {
      "text": "Remove ham bone from the pot and place on a cutting board until cool enough to handle. Remove any meat from the bones and cut into bite-sized pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jyej3ZYIOcC0bRF-bLZKjEmNhYM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13346-bean-soup-ddmfs-4x3-steps-05-b27ad21c4997492ca96d33f5f5d6c28d.jpg"
      ],
      "image": "assets/images/13346/step_05.webp"
    },
    {
      "text": "Stir into soup until warmed through. Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pq7Saow60Y0DI1PJLNmylJh1i-4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13346-bean-soup-ddmfs-4x3-hero-e67de9a1aefe427c880268a6777044df.jpg"
