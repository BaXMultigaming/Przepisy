  "title": "Chocolate Applesauce Cake I",
  "description": "This cake is moist with applesauce, is full of raisins and pecans. This is a chocolate cake for all you chocolate lovers. This cake has no eggs and is especially dense.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-06-15T16:26:16-04:00",
