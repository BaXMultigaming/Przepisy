  "ingredients": [
    "0.5 cup butter",
    "1.25 cups white sugar",
    "0.5 cup milk",
    "1.5 cups applesauce",
    "2 tablespoons dark rum",
    "2 cups all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "2 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.125 teaspoon salt",
    "1 cup raisins",
    "1 cup chopped pecans",
    "0.25 cup dark rum"
  ],
  "steps": [
    {
      "text": "In a bowl, cream the butter or margarine with the sugar. Beat in the milk, applesauce, and 2 tablespoons of rum.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, stir together the flour, cocoa, baking soda, spices, and salt. Beat into the creamed mixture and then stir in the raisins and pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn the batter into a greased and floured 9x13 inch baking pan. Bake the cake in a preheated 350 degrees F (175 degrees C) oven for 45 minutes, or until it tests done with a toothpick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Immediately after removing the cake from the oven, sprinkle it with the remaining 1/4 cup rum. Let cool on a rack. This cake improves if allowed to sit for a day or so before eating. Serves 20.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
