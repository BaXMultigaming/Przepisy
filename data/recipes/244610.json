  "title": "Juicy Chicken Breast Marinade",
  "description": "This chicken breast marinade with safflower oil, lemon juice, and garlic produces a juicy and delicious chicken breast every time.",
  "authors": [
    "lalalauren"
  ],
  "date_published": "2019-07-10T03:06:26-04:00",
