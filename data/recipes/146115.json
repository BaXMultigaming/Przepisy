  "ingredients": [
    "6 ounces fresh crabmeat, drained and flaked",
    "5 ounces small cooked shrimp, chopped",
    "1 onion, diced",
    "1 green bell pepper, seeded and chopped",
    "1 stalk celery, diced",
    "0.75 cup mayonnaise",
    "2 teaspoons fresh dill, finely chopped",
    "1 teaspoon Worcestershire sauce",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place crabmeat, shrimp, onion, bell pepper, and celery into a bowl. Gently stir in mayonnaise, dill, and Worcestershire sauce until combined; season with salt and black pepper. Refrigerate 1 hour before serving.",
