      ],
      "image": "assets/images/229692/step_04.webp"
    },
    {
      "text": "Stir in white sugar, brown sugar, cinnamon, and butter until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C0XshLi1TqBk2uPhzQwRFoQkmlo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-229692-Easy-Sweet-Potato-Casserole-DDMFS-4x3-step-06-836c122da1b54e6f83155baf30ead39a.jpg"
      ],
      "image": "assets/images/229692/step_05.webp"
    },
    {
      "text": "Transfer sweet potato mixture to the prepared casserole dish. Cover evenly with marshmallows.",
      "section": null,
      "name": null,
      "url": null,
