  "ingredients": [
    "cooking spray",
    "1 (3 pound) boneless pork roast",
    "0.66666668653488 cup grated Parmesan cheese",
    "0.5 cup honey",
    "3 tablespoons low-sodium soy sauce",
    "2 tablespoons dried basil",
    "2 tablespoons minced garlic",
    "2 tablespoons olive oil",
    "0.5 teaspoon salt",
    "2 tablespoons cornstarch",
    "0.25 cup cold water"
  ],
  "steps": [
    {
      "text": "Prepare a slow cooker crock with cooking spray. Lay pork roast into the crock.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk Parmesan cheese, honey, soy sauce, basil, garlic, oil, and salt together in a small bowl; pour over pork roast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until roast is cooked completely through, 6 to 7 hours. An instant-read thermometer inserted into the center should read 160 degrees F (70 degrees C). Remove roast to a cutting board to rest a few minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Skim fat from the cooking juices; discard. Ladle remaining juice to a small saucepan; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cornstarch into cold water in a bowl until dissolved; pour into boiling liquid in the saucepan. Cook the liquid, stirring frequently, until thickened into a gravy, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice pork roast and serve with gravy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
