  "ingredients": [
    "1 teaspoon butter",
    "1 orange, juiced",
    "2 teaspoons brown sugar",
    "3.25 cups kombucha",
    "2 cinnamon sticks",
    "8 whole cloves",
    "0.5 cup brandy"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over low heat. Add orange juice and brown sugar; stir until sugar dissolves, 2 to 3 minutes. Stir in kombucha, cinnamon sticks, and cloves. Simmer gently until flavors combine, about 5 minutes. Stir in brandy and pour into mugs.",
