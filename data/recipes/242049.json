  "ingredients": [
    "0.75 cup butter, softened",
    "1 cup packed brown sugar",
    "1 egg",
    "0.33333334326744 cup peanut butter",
    "1 teaspoon vanilla extract, or more to taste",
    "2 cups chickpea flour",
    "2 tablespoons cornstarch",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1.5 cups chopped chocolate",
    "0.5 cup rolled oats",
    "0.25 cup chopped mixed nuts, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Generously grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, egg, peanut butter, and vanilla extract together in a bowl until smooth. Mix chickpea flour, cornstarch, baking powder, and salt in a separate bowl; add to butter mixture and mix thoroughly into a cookie dough. Fold chocolate, oats, and nuts into the dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill dough in refrigerator for at least 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll cookie dough into heaping tablespoon-sized balls and arrange on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden brown, 10 to 13 minutes. Let cookies cool on baking rack for 2 to 3 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
