  "ingredients": [
    "1 pound sliced bacon",
    "2.5 cups shredded Cheddar cheese",
    "2 tablespoons prepared mustard",
    "1 cup mayonnaise",
    "1 pound sliced pumpernickel party bread"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to broil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl combine the bacon, cheese, mustard and mayonnaise. Stir well. Arrange party bread on a cookie sheet. Spoon mixture onto each slice of bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil for 5 minutes, or until bubbly.",
      "section": null,
      "name": null,
