  "ingredients": [
    "0.33333334326744 cup white sugar",
    "3 tablespoons all-purpose flour",
    "1 tablespoon oats",
    "2 tablespoons cold salted butter, cut into small pieces",
    "0.25 cup applesauce",
    "0.33333334326744 cup white sugar",
    "1 large egg",
    "1 tablespoon lemon zest",
    "0.5 cup lemon juice",
    "0.25 cup sour cream",
    "1.25 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a muffin tin with parchment paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, flour, and oats together in a small bowl until combined. Work butter into the dry ingredients until it resembles damp sand. Set the topping aside while you prepare the muffin batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together applesauce, sugar, egg, and lemon zest in a large bowl. Add lemon juice and sour cream and stir until combined. Add flour, baking powder, and salt. Stir everything together until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each halfway. Sprinkle the topping on each muffin until completely covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick comes out clean, 20 to 25 minutes. Cool in the tin for about 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
