  "ingredients": [
    "0.75 cup sugar",
    "1 tablespoon all-purpose flour",
    "0.25 teaspoon ground cinnamon",
    "1 pinch salt",
    "1 cup sour cream",
    "1 egg, beaten",
    "2 (15 ounce) cans pears, drained and chopped",
    "1 (9 inch) graham cracker crust",
    "0.66666668653488 cup all-purpose flour",
    "0.5 cup sugar",
    "0.66666668653488 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together 3/4 cup sugar, 1 tablespoon flour, cinnamon, and salt in a large bowl until well combined. Mix in sour cream and beaten egg until smooth. Add pears; stir gently until coated. Pour mixture into a graham cracker crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While pie is baking, stir together 2/3 cup flour and 1/2 cup sugar until well combined. Cut in butter until mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pie from the oven and sprinkle the top with butter-flour mixture. Return to the oven and continue baking for 30 more minutes. Cool completely on a wire rack before serving.",
      "section": null,
      "name": null,
      "url": null,
