  "ingredients": [
    "1 tablespoon pan drippings (fond)",
    "4 teaspoons Dijon mustard",
    "1 cup chicken stock",
    "2 tablespoons cold butter"
  ],
  "steps": [
    {
      "text": "Heat pan drippings (fond) in their skillet or roasting pan over high heat. Stir mustard into the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour chicken stock into the skillet and bring to a boil while scraping the browned bits of food off of the bottom of the pan with a wooden spoon. Cook at a boil until sauce has a creamy consistency, 2 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the skillet from heat. Whisk cold butter into sauce until butter is melted and sauce is shiny.",
