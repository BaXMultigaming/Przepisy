  "ingredients": [
    "0.25 cup butter",
    "2 (3 ounce) packages Oriental-flavor ramen noodle soup, seasoning packet reserved",
    "0.5 cup slivered almonds",
    "0.25 cup sesame seeds",
    "1 (16 ounce) package broccoli coleslaw mix",
    "0.5 cup chopped green onion",
    "0.5 cup salad oil",
    "0.5 cup white sugar",
    "0.25 cup apple cider vinegar",
    "2 tablespoons soy sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a microwave-safe bowl in the microwave. Crush ramen noodles into small pieces; stir crushed noodles, almonds, and sesame seeds into melted butter. Spread mixture onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and crunchy, 8 to 10 minutes; allow to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss together coleslaw mix and green onion in a large serving bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make dressing: Whisk together oil, sugar, vinegar, soy sauce, and reserved seasoning packets in a separate bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cooled noodle mixture into dressing. Pour dressing over coleslaw-onion mixture; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
