  "ingredients": [
    "2.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon salt",
    "0.75 cup butter",
    "0.25 cup white sugar",
    "0.25 cup brown sugar",
    "0.25 cup honey",
    "1 egg",
    "1 tablespoon lemon zest",
    "1 cup mashed cooked sweet potato"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, cinnamon, baking soda, nutmeg, allspice, ginger, and salt into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, and brown sugar in a bowl until smooth and creamy. Mix in honey, egg, and lemon zest until well blended. Fold in sweet potato. Stir in flour mixture with a large spoon until dough is just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape tablespoonfuls of dough into balls and place 2 inches apart on ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges start to brown, about 8 minutes. Cool on the baking sheets for 5 minutes; transfer to wire racks to cool completely, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
