  "ingredients": [
    "1 (16 ounce) package spaghetti",
    "1 (8 ounce) can tomato sauce",
    "1 (6 ounce) can tomato paste",
    "1 teaspoon ground cinnamon",
    "0.25 cup vegetable oil",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add spaghetti and cook for 8 to 10 minutes or until al dente; drain and stir in tomato sauce, tomato paste, cinnamon, oil, salt and pepper. Transfer to prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 1 hour, or until top is crunchy.",
