  "ingredients": [
    "1 cup margarine",
    "1 cup white sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "3 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Cream together the margarine, sugar and eggs. Stir in vanilla, flour, baking soda and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out (not too thin) and cut into any shape. Bake at 375 degrees F (190 degrees C) for 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "I have used confectioner sugar frosting, or buttercream frosting, or even canned frosting ( if I'm desperate). Enjoy!",
      "section": null,
