  "ingredients": [
    "aluminum foil",
    "1 pound ground beef",
    "0.75 cup water",
    "1 (1.25 ounce) package taco seasoning mix",
    "1 (18 ounce) package restaurant-style tortilla chips",
    "1 cup shredded sharp Cheddar cheese, or more to taste",
    "1 (15.5 ounce) can refried beans",
    "1 (10 ounce) can pitted black olives, drained and chopped",
    "1 cup salsa",
    "1 cup sour cream, or more to taste",
    "4 green onions, diced",
    "1 (4 ounce) can sliced jalapeno peppers, drained"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V6seVGxNO2PL-LI5AprfeIQK3k8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/51147-SuperNachos-MFS-Step1-0069-213b99124947443191fda77039dc4107.jpg"
      ],
      "image": "assets/images/51147/step_02.webp"
    },
    {
      "text": "Cook and stir ground beef in a skillet over medium heat until crumbly and no longer pink, 5 to 10 minutes. Drain excess grease. Stir in water and taco seasoning mix; simmer until beef mixture has thickened, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AyhQAU4uxF2WS5UnT-rFNcyRb78=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/51147-SuperNachos-MFS-Step2-0071-1c716bb0eafc47fcb26906accf416b49.jpg"
      ],
      "image": "assets/images/51147/step_03.webp"
    },
    {
      "text": "Spread tortilla chips on the prepared baking sheet; top with Cheddar cheese, then dot with refried beans and ground beef mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gBQm-D6QfBc-rJLH2x97yEjtbTo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/51147-SuperNachos-MFS-Step5-0079-217956d4f5214fec981888d8620a8650.jpg"
      ],
      "image": "assets/images/51147/step_04.webp"
    },
    {
      "text": "Broil in the preheated oven until cheese is melted, 3 to 5 minutes. Top nachos with olives, salsa, sour cream, green onions, and jalapeño peppers.",
      "section": null,
      "name": null,
      "url": null,
