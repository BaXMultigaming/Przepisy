  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix",
    "1 large egg",
    "0.5 cup margarine",
    "1 (29 ounce) can pumpkin puree",
    "0.66 cup evaporated milk",
    "0.5 cup white sugar",
    "1.5 teaspoons ground cinnamon",
    "1 cup brown sugar",
    "0.25 cup margarine"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wUQdARfMETXrjnB663Wrk6vAP4U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22838-pumpkin-pie-cake-VAT-step-01-ea96723c8b534b82a9de457821532128.jpg"
      ],
      "image": "assets/images/22838/step_01.webp"
    },
    {
      "text": "Reserve 1 cup cake mix from package; set aside. Combine remaining cake mix, 1 egg, and ½ cup melted butter in a bowl until evenly moistened; press into a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qCMv0OxLR_hD8zw13NG4Hxu2wp0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22838-pumpkin-pie-cake-VAT-step-02-ab88e31b5942491b80d487b2bc3a3083.jpg"
      ],
      "image": "assets/images/22838/step_02.webp"
    },
    {
      "text": "Combine remaining 3 eggs, pumpkin, evaporated milk, white sugar, and cinnamon in the same bowl until blended; pour over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KED-DAtA2cAcutJKXShAZFY-xDo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22838-pumpkin-pie-cake-VAT-step-03-71f25b2254cd4a51a3fead5d24871c74.jpg"
      ],
      "image": "assets/images/22838/step_03.webp"
    },
    {
      "text": "Combine reserved 1 cup cake mix and brown sugar in a separate bowl; cut in ¼ cup butter with 2 knives or a pastry blender until mixture resembles coarse crumbs. Sprinkle over pumpkin filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Tkw3NbJ7FqC249u2ZCFGHNOIqkA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22838-pumpkin-pie-cake-VAT-step-04-50b4dc2e7c234100a10d390f6b32e704.jpg"
      ],
      "image": "assets/images/22838/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 50 minutes. Store in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LvcyiIR1ZYz9uR_hSvERzP8KZOI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22838-pumpkin-pie-cake-VAT-step-05-6f491dec5c8146b38d5826502320f60c.jpg"
      ],
