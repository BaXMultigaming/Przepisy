  "ingredients": [
    "1 cup chicken broth",
    "1 (16 ounce) skinless, boneless chicken breast",
    "salt and ground black pepper to taste",
    "0.5 teaspoon paprika",
    "0.5 teaspoon parsley flakes",
    "0.25 teaspoon dried thyme",
    "0.25 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Pour chicken broth into a multi-functional pressure cooker (such as Instant Pot). Add chicken breast and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together paprika, parsley, thyme, and garlic powder in a small bowl; sprinkle over chicken. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 10 minutes. Allow 10 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 10 minutes. Transfer chicken to a cutting board to cool. Chop or shred for later use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
