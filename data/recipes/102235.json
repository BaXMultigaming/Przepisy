  "ingredients": [
    "0.25 cup all-purpose flour",
    "0.5 cup grated Parmesan cheese",
    "2 teaspoons paprika",
    "0.5 teaspoon salt",
    "0.5 teaspoon black pepper",
    "1 egg, beaten",
    "2 tablespoons milk",
    "4 skinless, boneless chicken breast halves",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Coat a shallow baking dish with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, parmesan, paprika, salt, and pepper in a bowl. In a separate bowl, whisk together the egg and milk. Dip the chicken in the egg, then dredge in the flour mixture. Place in the baking dish, and pour the melted butter evenly over the chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for about 1 hour and 15 minutes in the preheated oven, until the cheese has browned, and the chicken has cooked.",
      "section": null,
      "name": null,
      "url": null,
