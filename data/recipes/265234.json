  "ingredients": [
    "1 large sweet potato, peeled and diced",
    "0.5 medium zucchini, shredded",
    "0.5 medium yellow squash, shredded",
    "1 pound ground turkey",
    "black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place sweet potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain. Mash sweet potatoes with a fork in a large bowl; set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix zucchini and yellow squash into the bowl with the sweet potatoes. Add turkey and black pepper. Form mixture into 1-inch balls and place in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until meatballs are no longer pink in the center, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
