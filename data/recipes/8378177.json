  "title": "Puff Pastry with Egg and Bacon",
  "description": "Serve eggs and bacon inside of a puff pastry square for a special breakfast. It looks fancy but is very easy to make.",
  "authors": [
    "Barbara Sauermann"
  ],
  "date_published": "2022-04-11T11:04:03-04:00",
