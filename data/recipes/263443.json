  "ingredients": [
    "4 egg whites, at room temperature",
    "1 tablespoon strongly brewed espresso",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon cream of tartar",
    "0.125 cup white sugar",
    "1 tablespoon stevia powder",
    "0.33333334326744 cup cacao nibs",
    "1.5 tablespoons unsweetened cocoa powder",
    "1 tablespoon very finely ground coffee"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine egg whites, espresso, vanilla extract, and cream of tartar in the bowl of a stand mixer fitted with the whisk attachment. Beat until egg whites begin to form soft peaks, about 2 minutes. Slowly mix in sugar and stevia powder. Continue to beat until meringue becomes glossy and stiff peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently fold cocoa powder, cacao nibs, and coffee grounds into the meringue. Drop spoonfuls of the mixture onto an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops start to turn golden and crispy, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
