  "ingredients": [
    "1 cup peeled, cored, and chopped pears",
    "0.5 cup white sugar",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon ground cloves",
    "1 cup all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking powder",
    "0.33333334326744 cup vegetable oil",
    "2 large eggs, beaten",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Toss chopped pears with sugar, ginger, and cloves in a large bowl. Set aside until sugar dissolves, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease an 8x4-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, salt, and baking powder in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oil, eggs, and vanilla into pears. Add flour mixture and gently stir until just combined. Pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted in the center comes out clean, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
