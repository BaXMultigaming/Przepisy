  "ingredients": [
    "2 tablespoons vegetable oil",
    "0.75 pound large shrimp in the shell",
    "1 shallot, minced",
    "4 cloves garlic, sliced",
    "1 tablespoon extra-virgin olive oil, or to taste",
    "1 fresh lemon, cut into wedges"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium-high heat and cook shrimp until pink on all sides, 3 to 5 minutes. Reduce heat to low. Add shallot and garlic; cook until soft, about 5 minutes. Drizzle with olive oil and serve with lemon wedges.",
