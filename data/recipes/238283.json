  "ingredients": [
    "16 ounces sesame seeds",
    "2 cups white sugar",
    "1 gallon water, or as needed"
  ],
  "steps": [
    {
      "text": "Cook sesame seeds in a large skillet over medium heat, stirring constantly, until toasted and fragrant, about 5 minutes. Remove skillet from heat; cover with a lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sugar in blender with enough water to fill halfway; add sesame seeds. Blend until smooth; strain through a fine-mesh strainer into a pitcher. Repeat blending and straining for a thinner consistency, adding more water as desired. Refrigerate juice until cooled, about 1 hour.",
