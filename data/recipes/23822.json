  "ingredients": [
    "3 cups sugar",
    "1 cup vegetable oil",
    "4 eggs",
    "0.66666668653488 cup water",
    "1 (15 ounce) can pumpkin puree",
    "2 teaspoons ground ginger",
    "1 teaspoon ground allspice",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cloves",
    "3.5 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1.5 teaspoons salt",
    "0.5 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease two 9x5 inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing, combine sugar, oil and eggs; beat until smooth. Add water and beat until well blended. Stir in pumpkin, ginger, allspice cinnamon, and clove.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In medium bowl, combine flour, soda, salt, and baking powder. Add dry ingredients to pumpkin mixture and blend just until all ingredients are mixed. Divide batter between prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until toothpick comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
