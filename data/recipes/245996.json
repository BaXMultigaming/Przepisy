  "ingredients": [
    "2 tablespoons butter, or more to taste",
    "0.5 head cabbage, cored and cut into 1/4-inch slices",
    "0.5 onion, cut into 1/4-inch slices",
    "1 cup water",
    "1 tablespoon white vinegar",
    "1 tablespoon white sugar",
    "2 teaspoons caraway seeds",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Cook and stir cabbage and onion in butter until onion is translucent, about 5 minutes.",
