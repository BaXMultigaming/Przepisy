  "ingredients": [
    "3 cups vanilla wafer crumbs",
    "3 tablespoons butter, softened",
    "2 (14 ounce) cans sweetened condensed milk",
    "1 teaspoon Key lime zest",
    "1 cup fresh Key lime juice",
    "6 egg yolks",
    "1 teaspoon vanilla extract",
    "2 stalks fresh rhubarb, diced",
    "2 cups chopped fresh strawberries",
    "1 cup white sugar",
    "0.5 cup water",
    "2 teaspoons powdered fruit pectin"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine crumbs and butter in a bowl until evenly moistened; press into the bottom and up the sides of a 10-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sweetened condensed milk, Key lime zest, Key lime juice, egg yolks, and vanilla extract in a bowl with an electric mixer until smooth; pour filling into prepared crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center is slightly jiggly, about 15 minutes. Cool for 10 minutes; refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine rhubarb, strawberries, sugar, water, and pectin in a saucepan over medium heat; boil, stirring often, until rhubarb and berries break down and glaze begins to thicken and resemble jam, about 20 minutes. Cool until lukewarm; glaze will thicken as it cools.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread glaze over pie; refrigerate until chilled before serving, at least 8 hours for the best texture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
