  "ingredients": [
    "2 tablespoons vegetable oil",
    "2 cups cubed fresh pumpkin",
    "0.5 cup vegetable stock",
    "1 tablespoon ground cumin",
    "salt and ground black pepper to taste",
    "12 flour or corn tortillas, warmed",
    "0.75 cup diced fresh tomato",
    "0.5 cup diced onion",
    "0.5 cup diced ripe avocado",
    "3 tablespoons chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Heat the oil in a large skillet over medium heat. Cook the pumpkin in the heated oil 2 to 3 minutes. Stir in the vegetable stock, cumin, salt, and pepper. Cook until the pumpkin cubes are easily pierced through with a fork, 5 to 7 minutes. Fill warm tortillas with pumpkin; top with tomato, onion, avocado, and cilantro as desired.",
