  "ingredients": [
    "2 pounds baby carrots",
    "1 cup chopped onion",
    "1 cup mayonnaise",
    "1 cup grated Cheddar cheese",
    "0.5 cup sugar",
    "10 buttery round crackers, crushed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the carrots and onion into a large saucepan and fill with about 1 inch of water. Bring to a boil, then steam over medium heat until carrots are tender enough to pierce with a fork, 5 to 10 minutes. Drain and allow to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the mayonnaise, sugar and cheese. Stir in the carrots and onion until evenly coated. Transfer to a casserole dish. Top with crumbled crackers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 to 30 minutes in the preheated oven, until sauce is bubbly and the top is toasted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
