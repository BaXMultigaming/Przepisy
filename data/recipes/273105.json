  "ingredients": [
    "4 sweet potatoes, or more to taste",
    "1 teaspoon kosher salt",
    "0.33333334326744 cup olive oil",
    "1.5 teaspoons ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each sweet potato in half crosswise. Quarter each half lengthwise. Cut each quarter evenly into 2 to 4 pieces. Repeat with remaining sweet potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sweet potatoes on a rimmed baking sheet. Add salt. Drizzle olive oil on top. Stir up potatoes to coat with oil; spread out evenly on the baking sheet. Season with pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring every 10 minutes, until browned, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
