  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup white sugar",
    "1 (3.9 ounce) package instant chocolate fudge pudding mix",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking powder",
    "1 cup mashed overripe bananas",
    "1 cup miniature milk chocolate chips",
    "3 large eggs",
    "0.5 cup olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, pudding mix, salt, and baking powder in a bowl; stir in bananas, 3/4 cup chocolate chips, eggs, and oil. Pour batter into the prepared pan; sprinkle remaining 1/4 cup chocolate chips on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
