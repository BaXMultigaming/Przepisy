  "ingredients": [
    "8 slices bread, crusts removed, bread lightly toasted and cubed",
    "1.5 cups milk",
    "0.25 cup unsalted butter",
    "3 cups chopped fresh rhubarb",
    "1.5 cups white sugar",
    "4 large eggs, lightly beaten",
    "0.25 teaspoon cinnamon",
    "0.125 teaspoon salt",
    "0.5 cup packed brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place toasted bread into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat milk in a saucepan over medium-low until bubbles form around the sides. Remove from heat; add butter, stirring until melted. Pour milk mixture over bread; stir until bread evenly coated, then let stand 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rhubarb, white sugar, eggs, cinnamon, and salt together in a bowl; pour into bread mixture and stir. Sprinkle brown sugar over top of rhubarb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and set, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
