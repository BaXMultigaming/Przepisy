  "title": "French Toast Roll Ups",
  "description": "French toast roll ups are a delicious breakfast treat, especially when filled with Nutella®, chocolate chips, and peanut butter!",
  "authors": [
    "lutzflcat"
  ],
  "date_published": "2022-05-05T10:37:13-04:00",
