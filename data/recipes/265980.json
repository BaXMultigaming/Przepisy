  "ingredients": [
    "3 tablespoons soy sauce",
    "2 tablespoons sweet cooking wine (mirin)",
    "1 teaspoon garlic powder",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon ground ginger",
    "1 pound beef chunks, very thinly sliced",
    "3 tablespoons vegetable oil",
    "1 tablespoon sweet cooking wine (mirin)"
  ],
  "steps": [
    {
      "text": "Combine soy sauce, mirin, garlic powder, black pepper, and ground ginger together in a bowl. Add sliced beef and mix well. Leave to marinate at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a frying pan over medium-high heat. Fry beef slices, about 10 minutes, and place on a serving dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour leftover marinade into the same frying pan over low heat. Add mirin and simmer until sauce is slightly thickened, 1 to 2 minutes. Pour sauce over beef and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
