  "ingredients": [
    "1 cup all-purpose flour",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "6 tablespoons unsalted butter, softened",
    "0.5 cup white sugar",
    "0.5 cup sour cream",
    "2 teaspoons grated lemon zest",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon lemon extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, and salt in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter in a large bowl with an electric mixer on medium speed. Gradually beat in sugar until light and fluffy. Beat in sour cream, lemon zest, vanilla extract, and lemon extract. Reduce speed to low; beat in flour mixture until just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoonfuls of dough spaced 1 inch apart onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are set and edges are golden, 10 to 12 minutes. Cool on cookie sheets for 1 minute, then transfer to wire racks using a wide metal spatula to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
