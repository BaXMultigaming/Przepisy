  "ingredients": [
    "1 (14 ounce) package Hillshire Farm® Smoked Sausage, diagonally cut into 1/4-inch slices",
    "3 cloves garlic, minced",
    "1 medium onion, 1/2-inch dice",
    "1 green bell pepper, sliced",
    "1 (12 ounce) package fresh cheese tortellini, cooked according to package directions",
    "1 (24 ounce) jar marinara sauce",
    "2 cups shredded mozzarella cheese, divided",
    "1 teaspoon dried oregano"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large 12-inch oven-safe skillet over medium-high heat and add smoked sausage. Cook until brown. Add garlic, onion, and bell pepper. Lower heat to medium and stir until vegetables are soft, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in cooked tortellini, marinara sauce, 1 cup cheese, and oregano.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with remaining cheese. Bake in the preheated oven until cheese is melted and bubbly, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
