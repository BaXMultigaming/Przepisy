  "ingredients": [
    "1 (.25 ounce) package unflavored gelatin",
    "0.25 cup cold water",
    "1 cup white sugar",
    "4 tablespoons all-purpose flour",
    "0.5 teaspoon salt",
    "1.5 cups milk",
    "0.75 teaspoon vanilla extract",
    "1 cup flaked coconut",
    "0.5 cup heavy whipping cream",
    "3 egg whites",
    "0.25 teaspoon cream of tartar",
    "1 (9 inch) pie crust, baked",
    "2 tablespoons flaked coconut"
  ],
  "steps": [
    {
      "text": "Sprinkle gelatin over cold water; set aside to soften.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 cup sugar, flour, and salt in a saucepan. Gradually stir in milk. Cook over low heat, stirring until it boils. Boil for 1 minute, and remove from heat. Transfer to a large bowl. Stir in softened gelatin. When partially set, beat with a rotary mixer until smooth. Blend in vanilla and 1 cup coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip the cream until stiff. Gently fold into coconut mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a clean bowl until frothy. Beat in cream of tartar and 1/2 cup sugar. Continue beating until egg whites form stiff peaks. Fold into coconut mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pile filling into prepared pie shell. Sprinkle with additional flaked coconut. Chill pie for at least 2 hours or overnight before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
