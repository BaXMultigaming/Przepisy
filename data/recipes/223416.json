  "ingredients": [
    "4 slices bacon, chopped",
    "1 onion, chopped",
    "2 cloves garlic, minced",
    "6 cups chicken stock",
    "3 stalks celery, diced",
    "2 large potatoes, diced",
    "2 large carrots, diced",
    "1 cup fresh corn kernels",
    "ground black pepper to taste",
    "0.5 teaspoon red pepper flakes, or to taste",
    "1 cup scallops",
    "1 cup uncooked medium shrimp, peeled and deveined",
    "0.25 pound halibut, cut into bite-size pieces",
    "1 (12 ounce) can evaporated milk"
  ],
  "steps": [
    {
      "text": "Cook and stir bacon in a skillet over medium heat until browned, 5 to 8 minutes. Drain excess grease. Add onion and garlic to bacon; cook and stir until onion translucent, about 5 minutes. Transfer to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken stock to slow cooker. Stir in celery, potatoes, carrots, and corn; season with black pepper and red pepper flakes. Cover slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir scallops, shrimp, and halibut into slow cooker; cook 1 hour more. Stir in evaporated milk until thoroughly heated; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
