  "ingredients": [
    "1 cup white sugar",
    "3 eggs",
    "1 (8 ounce) can crushed pineapple in juice, undrained",
    "0.5 cup butter, melted",
    "0.5 cup raisins",
    "0.25 cup chopped walnuts",
    "12 slices bread, cut into 1/2-inch pieces",
    "1 tablespoon brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and eggs together in a large bowl until sugar is dissolved. Stir in pineapple, butter, raisins, and walnuts. Add bread cubes; stir until well coated. Pour mixture into the prepared baking dish; sprinkle with brown sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bread is fluffy, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
