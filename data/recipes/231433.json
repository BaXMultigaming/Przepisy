  "ingredients": [
    "1 cup vegan mayonnaise (such as Follow Your Heart® Veganaise®)",
    "2 tablespoons water, or as needed",
    "1 tablespoon agave nectar, or more to taste",
    "2 teaspoons white apple cider vinegar",
    "2 teaspoons chili powder",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon ground cumin",
    "2 teaspoons lime juice",
    "1 pinch cayenne pepper"
  ],
  "steps": [
    {
      "text": "Blend vegan mayonnaise, water, agave nectar, vinegar, chili powder, garlic powder, onion powder, cumin, lime juice, and cayenne pepper in a blender until smooth. Keep refrigerated in an airtight container for 5 to 7 days.",
