  "ingredients": [
    "3 cups water",
    "1 cup yellow cornmeal",
    "1 teaspoon salt",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Lightly grease a 9x5-inch loaf pan; set aside",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat water in a medium saucepan to a boil; reduce heat to medium. Stir in cornmeal and salt; cook, stirring regularly, until thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cornmeal mixture to prepared loaf pan. Cover and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice cornmeal mush into 1-inch-wide slices. Melt butter in a skillet over medium-high heat. Add cornmeal slices; cook until golden brown on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
