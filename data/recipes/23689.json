  "ingredients": [
    "1 (2 pound) package frozen hash brown potatoes, thawed",
    "1 (10.5 ounce) can condensed cream of potato soup",
    "1 (10.5 ounce) can condensed cream of celery soup",
    "1 (16 ounce) container sour cream",
    "0.25 cup milk",
    "0.5 cup chopped onion",
    "1 teaspoon salt",
    "0.5 teaspoon pepper",
    "0.125 teaspoon dried dill weed",
    "1.5 cups shredded Cheddar cheese",
    "paprika to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine hash browns, both condensed soups, sour cream, milk, and onion in a large bowl; mix well. Season with salt, pepper, and dill weed. Spoon mixture into the prepared baking dish and sprinkle with cheese and paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until well browned and bubbly, 1 to 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
