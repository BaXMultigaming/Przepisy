  "ingredients": [
    "6 tablespoons salted butter, divided",
    "0.33333334326744 cup diced onion",
    "3 cloves garlic, minced",
    "9 ounces frozen cubed chicken",
    "1 (8 ounce) can tomato sauce",
    "0.25 cup heavy whipping cream",
    "1 tablespoon tandoori seasoning",
    "2 teaspoons garam masala",
    "1 pinch cayenne pepper",
    "0.25 cup chopped fresh cilantro, or to taste"
  ],
  "steps": [
    {
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select the Sauté function. Add butter, onion, and garlic; sauté until fragrant, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Close and lock the lid. Select high pressure according to manufacturer's instructions. Set timer for 30 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 15 minutes. Release remaining pressure using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in cream, tandoori seasoning, garam masala, and cayenne pepper to combine. Garnish servings with cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
