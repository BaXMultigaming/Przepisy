  "ingredients": [
    "0.25 pound peppered bacon, chopped",
    "1 medium onion, sliced",
    "4 cups fresh green beans, trimmed",
    "1 teaspoon white sugar",
    "1 teaspoon salt",
    "0.5 teaspoon seasoned salt",
    "water as needed"
  ],
  "steps": [
    {
      "text": "Place bacon in a large pot and cook over medium heat, stirring occasionally, for 5 minutes. Add onion; cook until bacon just starts to brown a bit, 4 to 5 minutes. Add green beans and stir until coated in bacon grease. Add sugar, salt, seasoned salt, and just enough water to cover. Bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat, cover, and simmer until beans are soft, about 45 minutes.",
