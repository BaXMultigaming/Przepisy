  "ingredients": [
    "1.5 cups white sugar",
    "2 teaspoons dry mustard powder",
    "2 cups vegetable oil",
    "3 tablespoons poppy seeds",
    "2 teaspoons salt",
    "0.75 cup white vinegar",
    "3 tablespoons onion juice"
  ],
  "steps": [
    {
      "text": "In a 1-quart jar with a lid, mix together the sugar, mustard powder, vegetable oil, poppy seeds, salt, white vinegar, and onion juice; tighten the lid onto the jar, and shake vigorously to combine. Reshake the dressing before using.",
