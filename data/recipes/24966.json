  "ingredients": [
    "1 cup butter",
    "0.5 cup shortening",
    "2.5 cups sugar",
    "5 eggs",
    "2 tablespoons butternut flavored extract",
    "1 (5 ounce) can evaporated milk",
    "3 fluid ounces milk",
    "3 cups all-purpose flour",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Grease and flour a 10 inch tube pan. Mix together the flour and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the evaporated milk and whole milk; Set aside. In a large bowl, cream together the butter, shortening and sugar until light and fluffy. Beat in the eggs one at a time, then stir in the butternut flavoring. Beat in the flour mixture alternately with the milk, mixing just until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into prepared pan. Bake at 325 degrees F (165 degrees C) for 1 hour and 45 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
