  "ingredients": [
    "22 ice cream sandwiches",
    "1 (16 ounce) container frozen whipped topping, thawed",
    "1 (12 ounce) jar caramel ice cream topping",
    "1.5 cups salted peanuts"
  ],
  "steps": [
    {
      "text": "Cut 1 ice cream sandwich in half. Place one whole and one half sandwich along a short side of a high-sided 9x13-inch casserole dish. Repeat until the bottom is covered, alternating whole and half sandwiches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread with 1/2 of the whipped topping. Pour caramel on the top. Sprinkle with 3/4 cup peanuts. Repeat layers with remaining ice cream sandwiches, whipped topping, and peanuts. The pan will be full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and freeze for up to 2 months. Remove from the freezer 20 minutes before serving. Cut into squares.",
      "section": null,
      "name": null,
      "url": null,
