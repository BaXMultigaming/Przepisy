  "ingredients": [
    "1.5 cups half-and-half",
    "0.5 cup packed light brown sugar",
    "0.5 cup white sugar",
    "1 pinch salt",
    "2 large eggs, beaten",
    "1 cup heavy whipping cream",
    "1 teaspoon vanilla extract",
    "2 medium very ripe bananas, mashed",
    "1 cup crushed vanilla wafers"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lyvRFVQulwn6GrhC1KVHGa1bTJI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234652-banana-pudding-ice-cream-VAT-001-step-01-491b540a105443c1b807a614c43b2426.jpg"
      ],
      "image": "assets/images/234652/step_01.webp"
    },
    {
      "text": "Combine half-and-half, both sugars, and salt in a saucepan over medium-low heat; cook and stir until sugars are dissolved, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yYtyr870eIZ4PbMYTi0tLIiGKLg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234652-banana-pudding-ice-cream-VAT-002-step-02-bd121b0b8c4a4255b004a0ab63a05131.jpg"
      ],
      "image": "assets/images/234652/step_02.webp"
    },
    {
      "text": "Remove from the heat and transfer 1/2 of the hot mixture to a large bowl. Add eggs to the bowl and whisk until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PL7q0xTtOuTl3ZDUznsJEwlYyaQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234652-banana-pudding-ice-cream-VAT-004-step-03-02-6c963414101e4bcb8cf6514f11577b7c.jpg"
      ],
      "image": "assets/images/234652/step_03.webp"
    },
    {
      "text": "Pour mixture back into the saucepan. Stir in cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZzHKgPRhlqLoHIsQKe1WvV_WZf8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234652-banana-pudding-ice-cream-VAT-006-step-04-02-502cb0558e4e4691b4b032e2f932fb04.jpg"
      ],
      "image": "assets/images/234652/step_04.webp"
    },
    {
      "text": "Cook and stir over medium-low heat until mixture is thickened and coats the back of a spoon, 5 to 10 minutes. Remove from the heat and stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5vTl-dMVTVGZJ3JizXniye_rKUM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234652-banana-pudding-ice-cream-VAT-007-step-05-25def02fca9e4e16aae65bba906f1bbe.jpg"
      ],
      "image": "assets/images/234652/step_05.webp"
    },
    {
      "text": "Pour cream mixture over a fine mesh sieve into a bowl; cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wNGWAgXv3nJV1WZtFYDI6xhOPu0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234652-banana-pudding-ice-cream-VAT-008-step-06-01-9b30ceb7c13842b1979879958da397e0.jpg"
      ],
      "image": "assets/images/234652/step_06.webp"
    },
    {
      "text": "Stir mashed bananas into cooled cream mixture, then pour into an ice maker and freeze according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n-Xs7A4AXbniBmt2rPj_HjSoF4E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234652-banana-pudding-ice-cream-VAT-010-step-07-42d3321b1ac042248edb3f22f350c96f.jpg"
      ],
      "image": "assets/images/234652/step_07.webp"
    },
    {
      "text": "Fold crushed wafers into ice cream during the last 5 to 10 minutes of freezing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A6NDSFWs8JCKejlcqqmXUOFR_oY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234652-banana-pudding-ice-cream-VAT-011-step-08-f533b071d78140e08db6a51261e5ba1b.jpg"
      ],
      "image": "assets/images/234652/step_08.webp"
    }
