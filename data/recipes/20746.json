  "ingredients": [
    "8 slices bacon",
    "1 small onion, chopped",
    "4 eggs",
    "2 tablespoons milk",
    "2 tablespoons all-purpose flour",
    "1 teaspoon dried parsley",
    "0.25 teaspoon dried thyme",
    "salt and pepper to taste",
    "1 (9 inch) unbaked pie crust",
    "0.25 cup shredded mozzarella cheese",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain, but reserve 1 tablespoon of grease. Crumble bacon and set aside. Heat reserved bacon grease in a skillet and sauté onion until soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat together eggs, milk, flour, parsley, thyme, salt, and pepper. Add bacon, onion, mozzarella, and Cheddar cheese; mix well. Pour mixture into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes, or until lightly brown on top and firm in the middle. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
