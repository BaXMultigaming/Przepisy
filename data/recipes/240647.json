  "ingredients": [
    "1 large egg white",
    "1 tablespoon water",
    "1 pound walnut halves",
    "1 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white and water in a bowl with an electric mixer until frothy. Add walnuts and stir until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, cinnamon, and salt together in a separate bowl. Sprinkle mixture over walnuts and stir until coated. Spread coated walnuts onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring every 15 minutes, until walnuts are fragrant and crisp, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
