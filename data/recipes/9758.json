  "ingredients": [
    "1 cup honey",
    "0.25 cup butter",
    "3 eggs",
    "1.25 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.75 cup grated zucchini",
    "1 cup chopped walnuts",
    "1 cup dates, pitted and chopped",
    "1 pinch salt",
    "0.33333334326744 cup sifted confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the butter over low heat. In a large mixing bowl, combine the butter, honey and eggs. Beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the flour, salt and baking powder and mix well. Mix in zucchini, dates and walnuts until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread mixture into baking pan and bake for 25 to 30 minutes, until lightly brown. Cut into 1 x 3 inch long pieces, and dust with confectioners' sugar while still warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
