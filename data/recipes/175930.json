  "ingredients": [
    "2 large sweet potatoes, shredded",
    "2 eggs, lightly beaten",
    "0.25 cup brown sugar",
    "0.5 cup all-purpose flour",
    "1 tablespoon vanilla extract",
    "1 cup oil for frying",
    "3 tablespoons butter",
    "5 tablespoons confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Place the shredded sweet potatoes into a colander and rinse with cold water; allow to dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together the eggs, brown sugar, flour, and vanilla in a large bowl. Stir in the sweet potatoes; mix well. Form into small patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet to 375 degrees F (190 degrees C). Fry patties in batches until lightly browned, about 3 minutes per side. Spread with butter; sprinkle with powdered sugar and serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
