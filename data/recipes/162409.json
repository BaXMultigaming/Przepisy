  "ingredients": [
    "1 (.25 ounce) package active dry yeast",
    "0.25 cup water",
    "4.25 cups all-purpose flour",
    "0.25 teaspoon salt",
    "0.5 cup white sugar",
    "1 teaspoon ground cardamom",
    "1.25 cups lukewarm milk",
    "0.5 cup butter, melted",
    "1 egg",
    "0.25 cup golden raisins",
    "0.25 cup dried cherries",
    "0.25 cup dried cranberries",
    "2.5 cups confectioners' sugar",
    "0.25 cup milk",
    "1 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Dissolve yeast in warm water in a small cup. Let stand until dissolved, yeast softens, and begins to form a creamy foam, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour, salt, sugar, cardamom, 1 ¼ cups lukewarm milk, melted butter and egg into a bread machine in the order listed. Pour yeast mixture on top. Close the lid and set the machine for Dough setting. Add raisins, dried cherries, and dried cranberries at the beep.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 12 portions, shape into balls, and place into a greased 9x13-inch baking dish. Cover with plastic wrap and set aside to rise until doubled in volume, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, uncovered, until golden brown, 20 to 25 minutes. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk confectioners' sugar, ¼ cup milk, and almond extract in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle confectioners' sugar icing in a cross shape over cooled buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
