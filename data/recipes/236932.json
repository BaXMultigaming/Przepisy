  "ingredients": [
    "2 tablespoons olive oil, divided",
    "1 red onion, chopped",
    "salt and ground black pepper to taste",
    "2 whole Branzino (sea bass) fish, cleaned",
    "4 lemon wedges, divided",
    "2 sprigs fresh rosemary",
    "0.5 cup white wine",
    "0.25 cup lemon juice",
    "1 tablespoon fresh oregano leaves",
    "0.25 cup chopped Italian flat-leaf parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle 1 tablespoon olive oil into a large baking pan; add red onion and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vbecRScQb3B3AP7y4zkMfXnupUE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236932-branzino-mediterranean-ddmfs-step1-0922-e87816ffb6b541f8bfdb5c444a5f5a04.jpg"
      ],
      "image": "assets/images/236932/step_02.webp"
    },
    {
      "text": "Place 2 whole branzino fish into the baking pan. Stuff each cavity with 1 lemon wedge, 1 rosemary sprig, and some of the red onion in the pan. Pour white wine and lemon juice over fish and sprinkle with oregano. Drizzle remaining 1 tablespoon olive oil over fish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0KL5S6AVliAQIQ0snM_XKVf2x3s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236932-branzino-mediterranean-ddmfs-step3-0926-fdd87b136b3a4309a86fd886cf546a05.jpg"
      ],
      "image": "assets/images/236932/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until fish is opaque and flakes easily with a fork, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PgBjsNiDacmiiN2ZmJlEvzQcdxI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236932-branzino-mediterranean-ddmfs-step4-0944-812c6b8d859449f08d0a34b61cd072fd.jpg"
      ],
      "image": "assets/images/236932/step_04.webp"
    },
    {
      "text": "Gently slide a spatula between the bones to separate fish; remove all the bones. Serve fish on a platter; garnish with parsley and 2 lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fb0QrKY_3bxDa4Sf_6GR7sFUCp8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236932-branzino-mediterranean-ddmfs-3X2-0950-9ad9c50f20834dad896624c843523139.jpg"
      ],
      "image": "assets/images/236932/step_05.webp"
    }
