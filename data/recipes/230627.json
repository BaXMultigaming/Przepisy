  "ingredients": [
    "1 tablespoon butter",
    "2 onions, diced",
    "2 eggs",
    "1 cup milk",
    "1 cup old-fashioned oats",
    "0.75 cup golden raisins",
    "0.25 cup slivered almonds",
    "2 tablespoons vinegar",
    "2 tablespoons curry powder, or to taste",
    "1 tablespoon white sugar",
    "2 teaspoons salt",
    "0.75 teaspoon ground turmeric",
    "0.25 teaspoon ground black pepper",
    "2 pounds lean ground beef",
    "4 bay leaves, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a large baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Cook and stir onions in hot butter until browned, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 eggs, 1 cup milk, oats, raisins, almonds, vinegar, curry powder, sugar, salt, turmeric, and black pepper in a large bowl. Add cooked onion and ground beef; mix well. Spread beef mixture evenly into the prepared baking dish; top with bay leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Remove from the oven and drain excess fat from beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together remaining egg and 1/4 cup milk in a small bowl until well combined; pour over beef mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue baking in the oven until the top is beginning to brown, about 30 minutes more. Remove and discard bay leaves to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
