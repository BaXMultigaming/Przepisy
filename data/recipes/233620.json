  "title": "Dad's Basic Moist Pork Roast",
  "description": "Make tender pork roast in the oven. Roasting a pork roast straight from the refrigerator allows for a flavorful crust while keeping the center juicy.",
  "authors": [
    "CHEFSINGLEDAD"
  ],
  "date_published": "2013-09-28T02:00:25-04:00",
  "date_modified": "2025-10-22T12:11:38-04:00",
