    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 tablespoons olive oil",
    "1 tablespoon ground black pepper",
    "1 teaspoon kosher salt",
    "1 (3 pound) boneless top loin pork roast"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zkNMYRkaPFkiFdt1wzqWy-oyyzI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-233620-dads-basic-moist-pork-roast-VAT-step-01-fe5c8eb8dd784c5486c8c6ee0c809f77.jpg"
      ],
      "image": "assets/images/233620/step_01.webp"
    },
    {
      "text": "Combine oil, pepper, and salt in a bowl; rub oil mixture over pork and refrigerate while the oven preheats. Preheat the oven to 475 degrees F (245 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V2K9KcmkwPik40fLCwubjQPQU4U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-233620-dads-basic-moist-pork-roast-VAT-step-02-5ad0b83ece514c2f9de5e011234a9d72.jpg"
      ],
      "image": "assets/images/233620/step_02.webp"
    },
    {
      "text": "Place pork on a roasting rack set in a large roasting pan. Roast in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1b8w_fhnBYBM4zBTyZ8eNEZez8c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-233620-dads-basic-moist-pork-roast-VAT-step-03-5dcd57df0ace46688b3f89b89de09d5c.jpg"
      ],
      "image": "assets/images/233620/step_03.webp"
    },
    {
      "text": "Remove pork from the oven and reduce the heat to 325 degrees F (165 degrees C). Insert an instant-read thermometer into the thickest part of the center. The temperature will range from 80 to 110 degrees F (27 to 43 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7BbQ11vtMBgcaoQ3ADGx_N7Pye0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-233620-dads-basic-moist-pork-roast-VAT-step-04-7302b2c040964935b2c061a783f52844.jpg"
      ],
      "image": "assets/images/233620/step_04.webp"
    },
    {
      "text": "Allow pork to rest uncovered at room temperature until the internal temperature reaches between 115 and 140 degrees F (46 and 60 degrees C), about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/psDnwFbIVWFKEBVpShlrM_ckBMU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-233620-dads-basic-moist-pork-roast-VAT-step-05-5179c30655c44e0687d4246532c8a762.jpg"
      ],
      "image": "assets/images/233620/step_05.webp"
    },
    {
      "text": "Return to oven and continue to cook until internal temperature reaches 145 degrees F (63 degrees C), 15 to 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sI7-LRedJhv4bOUvcmOoXFFBogM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-233620-dads-basic-moist-pork-roast-VAT-step-06-8d5a118480e942b59dddc2db4e5fb35d.jpg"
      ],
      "image": "assets/images/233620/step_06.webp"
    },
    {
      "text": "Let the roast stand uncovered at room temperature for 15 to 20 minutes before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OgMnmfWePrNpolAWPlIRjVEGfXU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-233620-dads-basic-moist-pork-roast-VAT-step-07-7fa73b034ebc4095bfaca1fc42a49c57.jpg"
      ],
      "image": "assets/images/233620/step_07.webp"
    }
  ],
