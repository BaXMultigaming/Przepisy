  "ingredients": [
    "1 cup sugar-free pumpkin spice coffee creamer (such as International Delight®)",
    "0.5 cup pumpkin butter",
    "0.5 cup whole milk",
    "1 tablespoon pumpkin syrup (such as Torani®)",
    "0.5 teaspoon pumpkin spice"
  ],
  "steps": [
    {
      "text": "Com,bine pumpkin pie spice coffee creamer, pumpkin butter, milk, pumpkin syrup and pumpkin spice in a bowl. Use a hand mixer or immersion blender to fully incorporate all ingredients. Pour into Ninja Creami® pint container. Freeze for 24 hours.",
