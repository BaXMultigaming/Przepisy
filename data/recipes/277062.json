  "ingredients": [
    "cooking spray",
    "1 cup white sugar",
    "0.5 cup brown sugar",
    "0.5 cup olive oil",
    "1 tablespoon vanilla extract",
    "2 cups all-purpose flour",
    "0.5 cup cocoa powder (such as Hershey's®)",
    "1.5 teaspoons baking soda",
    "1 teaspoon salt",
    "3 cups shredded zucchini",
    "1 cup vegan chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9-inch square pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, brown sugar, and olive oil in a large bowl; beat with an electric mixer until well combined. Mix in vanilla extract. Add flour, cocoa powder, baking soda, and salt and mix until combined. (Mixture will be dry).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add zucchini and mix with a spoon until incorporated. Allow to sit for 5 minutes until mixture becomes more wet. Stir in vegan chocolate chips. Transfer batter to the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is dry and edges have started to pull away from the sides of the pan, 25 to 30 minutes. Let cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
