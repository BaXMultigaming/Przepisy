  "ingredients": [
    "6 cups heavy cream",
    "6 cups whole milk",
    "9 ounces good-quality white chocolate, chopped",
    "0.5 teaspoon peppermint extract, or to taste",
    "0.5 cup whipped cream, or to taste",
    "0.5 cup crushed peppermint candy canes",
    "12 small peppermint candy canes"
  ],
  "steps": [
    {
      "text": "Bring cream and milk to a simmer in a large, heavy saucepan. Reduce heat to medium-low. Add white chocolate and stir until melted and smooth.",
