  "ingredients": [
    "2 medium onions",
    "2 stalks celery, with leaves",
    "2 medium carrots",
    "2 cloves garlic",
    "2.5 pounds chicken carcass",
    "2 bay leaves",
    "2 tablespoons soy sauce",
    "1 tablespoon cider vinegar",
    "2 teaspoons whole black peppercorns",
    "0.5 teaspoon dried marjoram",
    "0.5 teaspoon dried thyme",
    "8 cups water, or as needed"
  ],
  "steps": [
    {
      "text": "Without peeling any skin or trimming any ends, prepare vegetables: Roughly chop onions. Roughly slice celery and carrots. Smash garlic gloves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken carcasses in a 6-quart multi-functional pressure cooker (such as Instant Pot). Add onions, celery, carrots, garlic, bay leaves, soy sauce, vinegar, peppercorns, marjoram, and thyme. Loosely pack down. Add enough water to reach the max fill level. Close and lock the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Select high pressure according to manufacturer's instructions; set timer for 2 1/2 hours. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer's instructions for 45 minutes. Unlock and remove the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a mesh strainer to strain solids from liquids. Cool and remove the solidified layer of fat if you wish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
