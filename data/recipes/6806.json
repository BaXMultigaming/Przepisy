  "title": "Calzone",
  "description": "Calzone dough for the bread machine gets rolled out and stuffed with pizza sauce, sausage and cheese. Stuff it with whatever you like — they’re delicious!",
  "authors": [
    "dottie"
  ],
  "date_published": "1998-07-26T23:14:31-04:00",
