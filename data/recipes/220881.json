  "ingredients": [
    "1 cup elbow macaroni",
    "1 (15 ounce) can red kidney beans, drained and rinsed",
    "0.5 cup chopped celery",
    "0.5 cup light mayonnaise",
    "0.25 cup chopped onion",
    "2 tablespoons red wine vinegar, or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook macaroni in boiling water, stirring occasionally, until cooked through but firm to the bite, 6 to 8 minutes. Drain and rinse with cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooked macaroni, kidney beans, celery, mayonnaise, onion, red wine vinegar, salt, and pepper in a large serving bowl until well mixed. Chill in the refrigerator for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
