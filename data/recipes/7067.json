  "total_time": "PT45M",
  "yield": [
    "12",
    "12 poppy seed muffins"
  ],
  "categories": [
    "Dessert"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 cups all-purpose flour",
    "0.75 cup white sugar",
    "0.25 cup poppy seeds",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 eggs",
    "1 cup lemon flavored yogurt",
    "0.25 cup vegetable oil",
    "1 tablespoon grated lemon zest",
    "0.33333334326744 cup lemon juice",
    "3 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (205 degrees C). Lightly grease a 12-cup muffin pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lRPdT5w50bqYJwsTc0Lp0djfv7E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7067-lemon-poppy-seed-muffins-i-VAT-step-01-8ba91dd8cff748beaf1a1198633d0802.jpg"
      ],
      "image": "assets/images/7067/step_01.webp"
    },
    {
      "text": "Combine flour, 3/4 cup sugar, poppy seeds, baking powder, baking soda, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/so6160dyOTNjoxAL7IdScgqhfNg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7067-lemon-poppy-seed-muffins-i-VAT-step-02-b1ffdecd79fc47c29ce220b4e876a2f8.jpg"
      ],
      "image": "assets/images/7067/step_02.webp"
    },
    {
      "text": "Mix eggs, yogurt, oil, and lemon zest together in a separate bowl until well blended. Pour over flour mixture, then mix until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/23M55ME-c5vjcKB5xkNhipHSvXE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7067-lemon-poppy-seed-muffins-i-VAT-step-03-419eb8ca6af14dddade7f793aeb0d158.jpg"
      ],
      "image": "assets/images/7067/step_03.webp"
    },
    {
      "text": "Spoon batter evenly between the prepared muffin cups, filling each ¾ full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3U2Fndy875WXRLTecz7ODrFKbKo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7067-lemon-poppy-seed-muffins-i-VAT-step-04-7725a90c418544568660eb9a8a912469.jpg"
      ],
      "image": "assets/images/7067/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 15 minutes. Let muffins cool in the pan for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IzkZa1rJ-PPo2X-dUcYQh_x3WxU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7067-lemon-poppy-seed-muffins-i-VAT-step-05-9ddc39886aeb4a85b5d10a8abff0a75e.jpg"
      ],
      "image": "assets/images/7067/step_05.webp"
    },
    {
      "text": "Meanwhile, make the glaze: Stir lemon juice and 3 tablespoons sugar together until sugar dissolves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3JH1RGeoxjkUOOPHfle3povhtVc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7067-lemon-poppy-seed-muffins-i-VAT-step-06-bcbe79390ac344588cd0c892f3ba8b4b.jpg"
      ],
      "image": "assets/images/7067/step_06.webp"
    },
    {
      "text": "Pierce the top of each muffin several times with a wooden skewer while they are still warm. Slowly pour about 1 tablespoon lemon glaze over the top of each muffin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IOwI91lY24Zg0SCjX2VpwVIu2nA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7067-lemon-poppy-seed-muffins-i-VAT-step-07-4de730e8f97a46558ef8f04b292d8611.jpg"
      ],
      "image": "assets/images/7067/step_07.webp"
    },
    {
      "text": "Let muffins continue to cool in the pan until glaze has set, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SDutJoUHvcN6wjBnltTARY7seSA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7067-lemon-poppy-seed-muffins-i-VAT-step-08-859c34a36b084a56adc453ddc33aa427.jpg"
      ],
      "image": "assets/images/7067/step_08.webp"
    }
  ],
