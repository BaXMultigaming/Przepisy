  "title": "Easy Lemon Poppy Seed Muffins",
  "description": "These lemon poppy seed muffins are moist and delicious with loads of crunchy poppy seeds topped with a tart lemony glaze for even more lemony flavor.",
  "authors": [
    "Karen Gibson"
  ],
  "date_published": "1999-02-12T20:19:53-05:00",
  "date_modified": "2026-05-08T11:40:24-04:00",
  "prep_time": "PT20M",
