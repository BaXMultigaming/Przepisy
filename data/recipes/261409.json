  "ingredients": [
    "2 tablespoons extra-virgin olive oil",
    "2 tablespoons balsamic vinegar",
    "2 tablespoons maple syrup",
    "0.5 teaspoon Dijon mustard",
    "1 clove garlic, finely grated",
    "sea salt",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Stir together olive oil, balsamic vinegar, and maple syrup in a small bowl or cup until well blended. Mix in mustard and grated garlic. Season with salt and pepper.",
