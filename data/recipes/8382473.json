  "ingredients": [
    "3.5 cups romaine lettuce, torn into bite-size pieces",
    "0.5 cup sliced cucumber",
    "0.33 cup sliced green bell pepper",
    "0.25 cup shredded carrots",
    "1 cup cherry tomatoes",
    "1 tablespoon sliced black olives",
    "1 ounce cooked turkey, cut crosswise into thin strips",
    "1 ounce cooked ham, cut into thin strips",
    "0.5 ounce Cheddar cheese, cut into strips",
    "0.5 ounce Swiss cheese, cut into strips",
    "1 large hard-boiled egg, sliced",
    "1 slice cooked bacon, crumbled",
    "1 tablespoon ranch dressing"
  ],
  "steps": [
    {
      "text": "Place torn lettuce leaves on a dinner plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Evenly distribute sliced cucumber and bell pepper strips around the plate, and sprinkle carrots on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cherry tomatoes, all around the plate, and sprinkle on sliced black olives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place alternating pieces of turkey and ham around the plate, then likewise, with the cheeses.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange the hard-boiled egg slices on top, and sprinkle with bacon crumbles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle dressing of choice over all and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
