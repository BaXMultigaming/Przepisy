  "ingredients": [
    "0.75 cup white sugar",
    "0.75 cup shortening",
    "1 egg",
    "1 cup mashed cooked carrots, cooled",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.5 teaspoon vanilla extract",
    "2 tablespoons orange juice",
    "1 tablespoon orange zest",
    "0.33333298563957 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together the sugar, shortening and the egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cooked cooled mashed carrots, flour, baking powder, salt and vanilla. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop on greased cookie sheet and bake for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Frosting: Combine orange juice with the grated rind of one orange. Add enough confectioners' sugar to thicken. Put on cookies while hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
