  "ingredients": [
    "1 pound sea scallops, patted dry",
    "0.25 teaspoon salt",
    "0.25 teaspoon freshly ground black pepper",
    "1.5 tablespoons olive oil",
    "0.25 cup minced shallots",
    "2 cloves garlic, minced",
    "0.5 cup dry white wine",
    "3 tablespoons minced fresh parsley"
  ],
  "steps": [
    {
      "text": "Season scallops with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat until shimmering. Add scallops and sear until browned on the bottom and moisture appears on the top, about 2 minutes. Flip and sear for 2 minutes on the other side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium. Add shallots and garlic; stir until shallots are lightly browned, about 2 minutes, being careful not to burn the garlic. Add wine and stir until the liquid starts to reduce, 1 to 2 minutes. Sprinkle with parsley and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
