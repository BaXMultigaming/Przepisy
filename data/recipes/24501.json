  "ingredients": [
    "1 (10 pound) fully-cooked, bone-in ham",
    "1.25 cups packed dark brown sugar",
    "0.333 cup pineapple juice",
    "0.333 cup honey, or more to taste",
    "0.333 large orange",
    "2 tablespoons Dijon mustard",
    "0.25 teaspoon ground cloves",
    "1.5 teaspoons lemon juice, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Place ham on a rack set in a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vqLihiBEURymXMw3xmG9wUKq5u4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24501-TangyHoney-GlazedHam-mfs-Step-11-08ac5045eb074b41926f7060a8b714b1.jpg"
      ],
      "image": "assets/images/24501/step_01.webp"
    },
    {
      "text": "Bake uncovered in the preheated oven for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, pineapple juice, and honey in a medium saucepan. Zest orange into the saucepan, then squeeze in juice. Add mustard and cloves; whisk over medium-high heat until boiling. Reduce heat and simmer until glaze thickens slightly, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mhiYq60K_xIPaOvQgqiJLIJJy-g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24501-TangyHoney-GlazedHam-mfs-Step-3-97eda926f79e4f0cb4a9b4212e94c688.jpg"
      ],
      "image": "assets/images/24501/step_03.webp"
    },
    {
      "text": "Adjust seasonings with lemon juice for tang, or more honey for sweetness. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove ham from the oven after 2 hours. Brush with glaze. Bake for an additional 30 to 45 minutes, brushing ham with glaze every 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8b8xE7hhpkVdCuxH1EnHVKEAHno=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24501-TangyHoney-GlazedHam-mfs-Step-4-4ce53a7d855d4461b7383afcd0a25ee1.jpg"
      ],
      "image": "assets/images/24501/step_05.webp"
    }
