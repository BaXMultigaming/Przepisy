  "ingredients": [
    "3 cups half-and-half",
    "1 cup 2% milk",
    "0.5 cup white sugar",
    "0.5 cup unsweetened cocoa powder",
    "1 tablespoon vanilla extract",
    "1 tablespoon coconut extract",
    "0.5 teaspoon kosher salt",
    "0.5 cup whipped cream, or more to taste",
    "0.25 cup toasted, shredded coconut"
  ],
  "steps": [
    {
      "text": "Whisk half-and-half, milk, sugar, and cocoa powder in a saucepan over medium-high heat until cocoa and sugar dissolve. Remove from heat when mixture begins to steam, 5 to 10 minutes.",
