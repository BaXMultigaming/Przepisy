  "ingredients": [
    "0.75 pound Italian sausage",
    "0.5 cup diced onion",
    "6 cups chicken broth",
    "1 (15 ounce) can diced tomatoes with basil, garlic, and oregano",
    "5 ounces farfalle pasta",
    "0.5 teaspoon Italian seasoning",
    "0.5 teaspoon salt, or to taste",
    "0.25 teaspoon ground black pepper, or to taste",
    "0.5 cup ricotta cheese",
    "0.5 cup shredded mozzarella cheese",
    "0.25 cup freshly grated Parmesan cheese",
    "2 tablespoons chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Cook Italian sausage and onion in a large skillet over medium-high heat until sausage is browned and crumbly and onion is soft and translucent, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chicken broth, diced tomatoes, farfalle pasta, Italian seasoning, salt, and black pepper; bring to a boil. Reduce heat to low; simmer, stirring occasionally, until pasta is tender, about 10 minutes. Stir in ricotta cheese; cook until fully incorporated, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide soup among 4 bowls; top each with 2 tablespoons mozzarella cheese, 1 tablespoon Parmesan cheese, and ½ tablespoon fresh basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
