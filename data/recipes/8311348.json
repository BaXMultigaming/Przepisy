  "keywords": [],
  "ingredients": [
    "8 ounces fresh green beans, trimmed",
    "2 large eggs",
    "1 large egg white",
    "0.5 teaspoon kosher salt, divided",
    "0.5 teaspoon ground black pepper, divided",
    "0.5 cup seasoned panko bread crumbs",
    "0.25 cup panko bread crumbs",
    "3 tablespoons grated Parmesan cheese",
    "0.5 teaspoon garlic powder",
    "olive oil cooking spray",
    "0.25 cup mayonnaise",
    "2 teaspoons Sriracha sauce",
    "1 teaspoon lemon juice"
  ],
  "steps": [
    {
      "text": "Wash green beans and dry thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together eggs and egg white in a shallow bowl until just frothy. Whisk in 1/4 teaspoon salt and 1/4 teaspoon pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine seasoned and regular panko, Parmesan cheese, garlic powder, and remaining salt and pepper in another shallow bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat 1/3 of the beans lightly with the egg mixture, then toss in the bread crumb mixture until well coated. Place in a single layer in an air fryer basket and spray lightly with olive oil spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry at 400 degrees F (200 degrees C) until beans are golden and crunchy, about 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Repeat Steps 4 and 5 to coat and air-fry the remaining beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together mayonnaise, Sriracha, and lemon juice in a small bowl until well combined. Serve with the air-fried green beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
