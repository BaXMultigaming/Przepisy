  "ingredients": [
    "cooking spray",
    "2 tablespoons butter",
    "3 cloves garlic, minced",
    "2 tablespoons all-purpose flour",
    "0.75 cup milk",
    "0.5 cup freshly grated Parmesan cheese",
    "salt and ground black pepper to taste",
    "2 large potatoes, peeled and thinly sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease 12 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DSkfIicFvlg_LeLpOR77II1LaZk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239730-muffin-tin-potatoes-gratin-VAT-step-01-fbbdde9037324e94b51cc848eb3b0344.jpg"
      ],
      "image": "assets/images/239730/step_01.webp"
    },
    {
      "text": "Heat butter in a saucepan over medium heat. Cook and stir garlic in melted butter until fragrant, about 1 minute. Add flour; cook and stir until mixture is smooth and thickened, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/88WQZeLD3j2oAcsZZI1H5poNs3s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239730-muffin-tin-potatoes-gratin-VAT-step-02-6a0785e305de4135ac7d9c8ef9529a19.jpg"
      ],
      "image": "assets/images/239730/step_02.webp"
    },
    {
      "text": "Pour milk in slowly, whisking continuously, until sauce is smooth and thickened, about 5 minutes. Remove the saucepan from heat and stir in Parmesan cheese until melted. Season with salt and pepper. Set cheese sauce aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Li8HA2Yv5IZJpR1qaojxz7Dvlqs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239730-muffin-tin-potatoes-gratin-VAT-step-03-2d8812da70ce449d999d7b2c6606287e.jpg"
      ],
      "image": "assets/images/239730/step_03.webp"
    },
    {
      "text": "Layer potatoes evenly into the prepared muffin cups. Spoon cheese sauce over potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EZYg1rZlkzyN_tszsdeKwQ75XOo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239730-muffin-tin-potatoes-gratin-VAT-step-04-9f55b4d5174d4e8c8262ff3f8430d4b2.jpg"
      ],
      "image": "assets/images/239730/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until potatoes are tender and a paring knife is easily inserted into the center, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_r8sMraMd2qiKT8h6iaeJ1NeOeU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239730-muffin-tin-potatoes-gratin-VAT-step-05-2de2bcd1305e4b1d9dd56ec0e772248c.jpg"
      ],
      "image": "assets/images/239730/step_05.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/th4OmZnUngI6Vm98BEBh_HAS29s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239730-muffin-tin-potatoes-gratin-VAT-Beauty-4x3-f8fae4c6976a4170b0c6ba75cb01f47d.jpg"
