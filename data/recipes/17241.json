  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 cup white sugar",
    "0.5 cup vegetable oil",
    "3 eggs",
    "1 tablespoon anise extract, or 3 drops anise oil",
    "3.25 cups all-purpose flour",
    "1 tablespoon baking powder"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GSyGAcovUE3ZQ--bR78xqlU_9PY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17241-biscotti-step-01-008-bb1838b7b04843e3a1866bc9d7c98ea2.jpg"
      ],
      "image": "assets/images/17241/step_01.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease two cookie sheets or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, oil, eggs, and anise extract together in a medium bowl until well-blended. Combine flour and baking powder in a separate bowl; stir into egg mixture to form a heavy dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y8LdTvdX1AYJQMC5ijxwkY4eCQU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17241-biscotti-step-02-009-9079fbe9042e4f89ab3a052ad35c2ed1.jpg"
      ],
      "image": "assets/images/17241/step_03.webp"
    },
    {
      "text": "Divide dough into two equal pieces. Form each piece into a log the length of a cookie sheet. Place one log on each of the prepared sheets; and press dough down to 1/2-inch thickness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z1Ep_2X8npExZ-54EKfzBq2Tfxw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17241-biscotti-step-04-011-015ffcb9adea4a3ba6e9ad5d4a0bea73.jpg"
      ],
      "image": "assets/images/17241/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, 25 to 30 minutes. Transfer logs to wire racks; let sit until cool enough to handle, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Mz2PXJMuaAb4Xkvy7Nxizvd0wV0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17241-biscotti-step-05-012-8f3d068f366943cc996e84f60edda820.jpg"
      ],
      "image": "assets/images/17241/step_05.webp"
    },
    {
      "text": "Slice each log crosswise into about eighteen 1/2-inch-thick slices. Place slices cut-sides up back on the cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nlYtcQvxboeA80FqOF1minZaSpE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17241-biscotti-step-06-014-fa6143bbe0e940638a225b83755b77a5.jpg"
      ],
      "image": "assets/images/17241/step_06.webp"
    },
    {
      "text": "Bake until lightly toasted and golden brown, 6 to 10 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lv28HDn22XE9wYr9WMBm9coSrwc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17241-biscotti-step-07-016-981810a7bd804da09014d8c2cef95e02.jpg"
      ],
      "image": "assets/images/17241/step_07.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d17quiW8DYRrf9ZYjClEunWtSSM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17241-biscotti-3x4-022-2c173471f6964db49debe9baa05f2ea0.jpg"
      ],
      "image": "assets/images/17241/step_08.webp"
    }
  ],
