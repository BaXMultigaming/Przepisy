  "ingredients": [
    "cooking spray",
    "1.75 cups all-purpose flour",
    "1.25 cups packed light brown sugar",
    "0.75 cup peanut butter",
    "0.5 cup butter, softened",
    "1 egg",
    "3 tablespoons milk",
    "1 tablespoon vanilla extract",
    "0.75 teaspoon salt",
    "0.75 teaspoon baking soda",
    "1 (6 ounce) package chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Spray the bottom and sides of a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, brown sugar, peanut butter, butter, egg, milk, vanilla extract, salt, and baking soda together in a bowl. Fold chocolate chips into batter. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned and a toothpick inserted in the middle comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
