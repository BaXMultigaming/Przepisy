  "ingredients": [
    "0.5 cup olive oil",
    "5 cloves cloves garlic, minced or pressed through a garlic press",
    "2.5 tablespoons fresh lemon juice, or more to taste",
    "1 tablespoon brown sugar",
    "1 teaspoon dried oregano",
    "1 teaspoon dried thyme",
    "salt and freshly ground black pepper to taste",
    "aluminum foil",
    "1 teaspoon olive oil",
    "1 (3 pound) salmon fillet",
    "0.25 cup chopped fresh parsley",
    "1 lemon, sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 cup olive oil, garlic, lemon juice, brown sugar, oregano, thyme, salt, and pepper in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GIarwxau0OA3t9gzdXM3733b908=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/263217-BakedSalmonInFoil-MFS-Step1-0248-2c07ed5fe8b84b6a914a92c5dbd93ad5.jpg"
      ],
      "image": "assets/images/263217/step_02.webp"
    },
    {
      "text": "Place a large piece of aluminum foil on a baking sheet and brush with 1 teaspoon olive oil. Place salmon, skin-side down, in the middle of the foil. Drizzle with olive oil mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lwTU1JnTxdqxTEUGmJcnkMahpsM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/263217-BakedSalmonInFoil-MFS-Step3-0251-92c6b59dea0746e689984d9f965c058f.jpg"
      ],
      "image": "assets/images/263217/step_03.webp"
    },
    {
      "text": "Fold up the edges of the foil over salmon to create a packet, making sure to seal the edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YVk9i1BRnJMOLitp6CAcOttMZfE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/263217-BakedSalmonInFoil-MFS-Step4-0256-11e49ad1e6664f2b909321d9755f4eb0.jpg"
      ],
      "image": "assets/images/263217/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 20 to 25 minutes. Garnish with fresh parsley and lemon slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
