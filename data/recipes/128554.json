  "ingredients": [
    "1 (16 ounce) container low-fat plain yogurt",
    "1 cucumber, peeled, seeded, and grated",
    "1 tablespoon chopped fresh parsley",
    "1 tablespoon chopped fresh mint",
    "1 tablespoon fresh lemon juice",
    "1 clove garlic, minced",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Line a colander with two layers of cheesecloth; place over a medium bowl. Place yogurt in cheesecloth-lined colander; cover colander with plastic wrap. Drain yogurt in the refrigerator, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place grated cucumber on a paper-towel-lined plate; drain 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine yogurt, cucumber, parsley, mint, lemon juice, garlic, salt, and black pepper in a bowl. Refrigerate before serving, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
