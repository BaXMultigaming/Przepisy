  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1 cup white sugar",
    "0.5 cup shortening",
    "1 egg",
    "1.5 teaspoons vanilla extract",
    "0.75 cup milk",
    "2 apples - peeled, cored and cut into eighths",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 7 x 11 inch baking pan. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and salt togerther in medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream 1 cup sugar and shortening together in a large bowl until well combined. Beat in egg and vanilla extract until fluffy. Add flour mixture to butter mixture in batches, alternating with milk. Spread batter in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press apple chunks lightly into batter. Sprinkle top with remaining 1/4 cup sugar and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apples are tender, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
