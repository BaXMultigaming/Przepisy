  "ingredients": [
    "cooking spray",
    "2 pounds ground ham",
    "1.5 pounds ground pork",
    "1 cup dried bread crumbs",
    "1 cup evaporated milk",
    "2 large eggs",
    "0.125 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1 cup brown sugar",
    "0.25 cup cider vinegar",
    "1 tablespoon mustard powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ham, pork, bread crumbs, evaporated milk, eggs, salt, and pepper in a large bowl; mix well. Form into a loaf and place into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While loaf is baking, make glaze: Stir together brown sugar, vinegar, and mustard powder in a small bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour glaze over loaf and continue baking until an instant-read thermometer inserted into the center of loaf reads at least 160 degrees F (72 degrees C), about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
