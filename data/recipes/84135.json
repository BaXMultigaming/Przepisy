  "ingredients": [
    "4 tablespoons margarine",
    "1 large onion, minced",
    "0.33333334326744 cup minced celery",
    "0.25 cup finely chopped carrots",
    "1 tablespoon all-purpose flour",
    "0.125 teaspoon red pepper flakes",
    "0.25 teaspoon dill weed",
    "6 cups water",
    "3 cubes chicken bouillon",
    "1 teaspoon Worcestershire sauce",
    "3 cups cubed potatoes",
    "0.25 teaspoon black pepper",
    "1.5 cups milk",
    "1 (6 ounce) can crabmeat, drained",
    "1 (6.5 ounce) can chopped clams"
  ],
  "steps": [
    {
      "text": "Heat margarine in a large skillet over medium heat. Stir in onion, celery, and carrots; cook until soft. Stir in flour, red pepper flakes, and dill weed. Mix in water, bouillon cubes, and Worcestershire sauce. Add potatoes, and season with black pepper; cook until potatoes begin to soften, about 10 minutes. Stir in milk, crab meat, and clams; simmer 15 to 20 minutes.",
