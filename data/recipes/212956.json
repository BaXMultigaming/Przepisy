  "ingredients": [
    "2 cups all-purpose flour",
    "0.33333334326744 cup white sugar",
    "0.5 teaspoon salt",
    "0.5 cup water",
    "1 large egg yolk",
    "2 tablespoons all-purpose flour for dusting",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": "Steps to Make It",
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Otjnebw6RWvXJV0RqGGGjWczod0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212956-empanada-dough-ddmfs-step-01-3a06657542ad4d47a20f9432e7f25392.jpg"
      ],
      "image": "assets/images/212956/step_01.webp"
    },
    {
      "text": "Whisk 2 cups flour, sugar, and salt together in a bowl until well blended. Make a well in the center.",
      "section": "Steps to Make It",
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1VGACnManxmhdBH7BTUJmw2MvxM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212956-empanada-dough-ddmfs-step-02-d11ab74363ee435aa1aa6a5f514a816d.jpg"
      ],
      "image": "assets/images/212956/step_02.webp"
    },
    {
      "text": "Whisk water and egg yolk together in a small bowl until smooth; pour into the well and mix to form a stiff dough.",
      "section": "Steps to Make It",
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nulanu72Xjuf7RK7LAaMMq3QAb4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212956-empanada-dough-ddmfs-step-03-f3d4d355308f488ebfbc5f76b96dabfb.jpg"
      ],
      "image": "assets/images/212956/step_03.webp"
    },
    {
      "text": "Transfer the dough to a lightly floured surface and knead until smooth and elastic, about 8 minutes.",
      "section": "Steps to Make It",
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MLKzphV9pdLEYZT4db5eg3Vx3rI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212956-empanada-dough-ddmfs-step-04-8e73379b055647f78c8f72ac6b058636.jpg"
      ],
      "image": "assets/images/212956/step_04.webp"
    },
    {
      "text": "Roll dough with a rolling pin until thin, dusting with flour as needed to prevent sticking.",
      "section": "Steps to Make It",
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MzLO6_8ByrzOsAJ9erYlzJVvVYI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212956-empanada-dough-ddmfs-step-05-90881af6418a441faaa0cda81418a95a.jpg"
      ],
      "image": "assets/images/212956/step_05.webp"
    },
    {
      "text": "Brush melted butter over top and roll dough into a log.",
      "section": "Steps to Make It",
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hoItfQyIk90sl5rnc6olKTxVAx0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212956-empanada-dough-ddmfs-step-06-27baeffc787a482592a227329a37c3e7.jpg"
      ],
      "image": "assets/images/212956/step_06.webp"
    },
    {
      "text": "Cut the log crosswise into about 24 slices. Roll each slice into a disk.",
      "section": "Steps to Make It",
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fNJLQkWv4tklK2U-U6N74J_kbGA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212956-empanada-dough-ddmfs-step-07-ecdd6b2ec7ca4b788bbec627cb3a8a0a.jpg"
      ],
      "image": "assets/images/212956/step_07.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Fill each empanada disk with about 1 tablespoon of your favorite filling. (Try lola's recipe for Empanada Pork Filling to make Filipino-style empanadas.)",
      "section": "To Make the Empanadas:",
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zBV48RDqvE4h_te19pFlTJlzNEU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212956-empanada-dough-ddmfs-step-08-c6b596f6b29b457092b569018f555eec.jpg"
      ],
      "image": "assets/images/212956/step_08.webp"
    },
    {
      "text": "Fold the disk over the filling into a half-moon and seal firmly.",
      "section": "To Make the Empanadas:",
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VXasC6V7lNd76HTCaZgM7EGREe0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212956-empanada-dough-ddmfs-step-09-5e0c29c1f1eb4ddf87aa3433f9f449f3.jpg"
      ],
      "image": "assets/images/212956/step_09.webp"
    },
    {
      "text": "Place empanadas onto a foil-lined baking sheet and brush the tops with beaten egg white.",
      "section": "To Make the Empanadas:",
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iakEntMPuDAxtiVyj0BTqrNaf2A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212956-empanada-dough-ddmfs-step-10-0071acda9f56426281e6e1897d297a8b.jpg"
      ],
      "image": "assets/images/212956/step_10.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 30 minutes.",
      "section": "To Make the Empanadas:",
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xgblsXYaHVKHc8j9UPcqNWZzbbk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212956-empanada-dough-ddmfs-step-11-1813e4cb4d45445993088f88b6246a76.jpg"
      ],
      "image": "assets/images/212956/step_11.webp"
    }
