  "title": "Better Chocolate Chip Zucchini Bread",
  "description": "Take traditional zucchini bread and add healthy flax seed, cinnamon, and applesauce to create this recipe for \"better\" chocolate chip zucchini bread.",
  "authors": [
    "Emma"
  ],
  "date_published": "2020-06-19T00:01:14-04:00",
