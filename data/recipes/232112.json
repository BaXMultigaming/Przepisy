  "ingredients": [
    "1 (16 ounce) package dry navy beans - picked over, rinsed, and drained",
    "10 sprigs fresh parsley",
    "2 sprigs chopped fresh thyme",
    "1 bay leaf",
    "2 large smoked ham hocks",
    "1 carrot, coarsely chopped",
    "1 onion, coarsely chopped",
    "1 clove garlic, coarsely chopped",
    "8 cups cold water",
    "1 pinch kosher salt and freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Place navy beans into a large pot and cover with several inches of cold water. Bring to a boil, reduce heat to low, and simmer for 5 minutes. Remove pot from heat, cover, and let stand for 1 hour; drain and rinse beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T5cGnyDUN5aM26JCngL65dtD09M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232112-Navy-Bean-Soup-Step1-2695-1-ef91bf57cd1d40058208c44f78bbcdd7.jpg"
      ],
      "image": "assets/images/232112/step_01.webp"
    },
    {
      "text": "Use a small piece of kitchen twine to tie parsley, thyme sprigs, and bay leaf into a small bundle. Place soaked beans, herb bundle, ham hocks, carrot, onion, and garlic into a large soup pot or Dutch oven; add 8 cups cold water. Bring to a boil, reduce heat to low, and simmer until beans and ham hocks are tender, about 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CwyvMtx2971LqVZ9-YPXDRsTT2w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232112-Navy-Bean-Soup-Step3-2700-1-576d8ec3ddf44da4bbcf5feaa3b4f932.jpg"
      ],
      "image": "assets/images/232112/step_02.webp"
    },
    {
      "text": "Turn off heat; remove ham hocks and let cool. When they are cool enough to handle, remove meat from the bones; discard bones, fat, and skin. Chop ham into small cubes. Remove and discard herb bundle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iF_CL6Q2ams0fmBjsUZPSBwwH78=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232112-Navy-Bean-Soup-Step4-2709-42e4b94946494d75b1516e8d748c946c.jpg"
      ],
      "image": "assets/images/232112/step_03.webp"
    },
    {
      "text": "Transfer about 3 cups cooked beans along with some cooking liquid into a blender; puree beans. Pour pureed beans back into soup; add ham and bring back to a simmer over medium heat. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/11yudz2OV16R-5KqGX_3c5ulvEM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232112-Navy-Bean-Soup-Step5-2713-8ae7e292b23e40bbafe34defc4ff8d9d.jpg"
      ],
      "image": "assets/images/232112/step_04.webp"
    }
