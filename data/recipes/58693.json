  "ingredients": [
    "2 tablespoons butter",
    "2 cups sliced leeks",
    "1 (9 inch) frozen pie crust, thawed",
    "1 cup shredded Swiss cheese",
    "0.25 cup grated Romano cheese",
    "1 tablespoon all-purpose flour",
    "1.75 cups heavy cream",
    "4 eggs",
    "1 tomato, thinly sliced",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Add leeks; cook until tender. Spread evenly into bottom of pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss Swiss cheese, Romano cheese, and flour together in a bowl; spread over leeks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat heavy cream and eggs together in a separate bowl; pour over cheese layer. Top with tomato slices; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Reduce the oven temperature to 325 degrees F (165 degrees C); continue baking until crust is lightly browned and a knife inserted into center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
