  "ingredients": [
    "6 eggs",
    "1.5 cups white sugar",
    "1 cup butter, melted",
    "1 teaspoon lemon zest",
    "1 teaspoon vanilla extract",
    "3.5 cups all-purpose flour",
    "4 teaspoons baking powder"
  ],
  "steps": [
    {
      "text": "In a medium bowl, beat the eggs with an electric mixer until light. Add the sugar, butter, lemon zest and vanilla, mix well. Stir in the flour and baking powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat pizzelle iron. Drop batter by teaspoonfuls onto the center of the patterns, close the lid and cook for about 30 seconds. Test the cooking time on the first one, because temperatures may vary. Remove cookies carefully from the iron and cool on wire racks.",
      "section": null,
      "name": null,
