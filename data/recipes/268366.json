  "ingredients": [
    "0.5 cup butter",
    "1 large onion, chopped",
    "10 cloves garlic, chopped",
    "1 (12 ounce) can beer",
    "3 (1.41 ounce) packages sazon seasoning with saffron (such as Goya® Azafran)",
    "0.25 cup dry white wine",
    "hot sauce",
    "salt to taste",
    "1 pound large shrimp, shells left on",
