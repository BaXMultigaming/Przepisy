  "ingredients": [
    "1 (15 ounce) can whole kernel corn, drained",
    "1 cup sour cream",
    "2 eggs, beaten",
    "0.25 cup butter, melted",
    "1 cup self-rising cornmeal",
    "1 tablespoon white sugar",
    "2 tablespoons applesauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together corn, sour cream, eggs and melted butter. Gradually stir in the cornmeal, sugar and applesauce. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 25 minutes, or until a toothpick inserted into the center of the loaf comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
