  "ingredients": [
    "1 cup all-purpose flour",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup butter",
    "0.5 cup white sugar",
    "0.33333334326744 cup packed brown sugar",
    "0.5 cup peanut butter",
    "1 large egg",
    "0.5 teaspoon vanilla extract",
    "0.5 cup rolled oats",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lKPTguA2dVM3Ln4tzP8RD3Ljmzo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10141-Outrageous-Chocolate-Chip-Cookies-ddmfs--step-1-212-2bd581b8c98a4a5eb6c8adb703274a7d.jpg"
      ],
      "image": "assets/images/10141/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease two cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, baking soda, and salt together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, and brown sugar together in a bowl with an electric mixer until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jRL_aT4a6jTaPZ_GWDUeWuxAft4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10141-Outrageous-Chocolate-Chip-Cookies-ddmfs--step-2-218-ae4231c277be4b7785a9e7d93e495688.jpg"
      ],
      "image": "assets/images/10141/step_04.webp"
    },
    {
      "text": "Stir in peanut butter, egg, and vanilla until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ezSFht6LD8kuhcpcL9BTxmbLAb8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10141-Outrageous-Chocolate-Chip-Cookies-ddmfs--step-3-220-dca47d320ddd4c42804b5c3918a4908b.jpg"
      ],
      "image": "assets/images/10141/step_05.webp"
    },
    {
      "text": "Mix in flour mixture until just moistened. Stir in chocolate chips and oats until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F-_Sqd88qqK6CHhf-vlGiP9C-V8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10141-Outrageous-Chocolate-Chip-Cookies-ddmfs--step-4-221-2902f051cba54b84a3b7ded25631ba45.jpg"
      ],
      "image": "assets/images/10141/step_06.webp"
    },
    {
      "text": "Drop tablespoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QPYw36xoHwB5kQSU57qqYXvXqNA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10141-Outrageous-Chocolate-Chip-Cookies-ddmfs--step-5-224-b45c80080dc34e5fb67dbef87930693c.jpg"
      ],
      "image": "assets/images/10141/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until the edges start to brown, 10 to 12 minutes. Cool on cookie sheets for about 5 minutes before transferring to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GewH7p5yBxF1g5X5vGhIT1gu5cg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10141-Outrageous-Chocolate-Chip-Cookies-ddmfs--step-6-230-c549159521fe462995e3198a4e23f40e.jpg"
      ],
      "image": "assets/images/10141/step_08.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
