  "ingredients": [
    "2 large onions, cut into rings",
    "1 cup all-purpose flour",
    "2 tablespoons all-purpose flour",
    "1 cup milk",
    "1 egg",
    "2 tablespoons vegetable oil",
    "1 teaspoon salt",
    "vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
