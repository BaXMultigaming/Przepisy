        "https://www.allrecipes.com/thmb/63_ZrOLEsGvJZsN8PU8CCMeeUlM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-238377-fantastic-onion-ring-batter-ddmfs-4x3-Step-04-f9f18af2851e4baabd1bf58e358dfdb6.jpg"
