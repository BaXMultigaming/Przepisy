  "ingredients": [
    "3 cups frozen blueberries, thawed, drained",
    "3 large eggs",
    "1.5 cups white sugar",
    "0.5 cup vegetable oil",
    "1 teaspoon vanilla extract",
    "3 cups all-purpose flour",
    "3 teaspoons baking powder",
    "2 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.75 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree blueberries in a food processor until smooth. Add eggs, sugar, oil, and vanilla extract and mix well. Mix in flour, baking powder, baking soda, cinnamon, and salt. Stir in chocolate chips. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 50 minutes. Let cool for 10 minutes, then invert and remove from the pan. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
