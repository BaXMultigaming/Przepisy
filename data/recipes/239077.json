  "ingredients": [
    "cooking spray",
    "1.75 cups almond milk",
    "0.5 cup unsweetened applesauce",
    "1 egg, beaten",
    "2 tablespoons chia seeds",
    "1 teaspoon vanilla extract",
    "1.25 cups whole wheat flour",
    "0.5 cup rolled oats",
    "0.25 cup flax seed meal",
    "4 teaspoons baking powder",
    "2 teaspoons white sugar, or more to taste",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to the manufacturer’s instructions; spray the inside with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk almond milk, applesauce, egg, chia seeds, and vanilla extract together in a bowl; let sit until chia seeds start to thicken mixture, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, oats, flax seed meal, baking powder, sugar, and salt into almond milk mixture until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop 1/2 cup batter into the preheated waffle iron and cook until crisp and golden, about 5 minutes per waffle. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
