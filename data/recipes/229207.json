  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2.5 cups rolled oats",
    "1.5 cups white sugar",
    "1 cup margarine, melted",
    "1.5 cups apple butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, and salt together in a large bowl; add oats and sugar. Stir in margarine until well incorporated. Press half the oat mixture into the prepared baking pan. Spread apple butter over oat mixture layer. Sprinkle remaining oat mixture over apple butter layer. Press top layer gently with a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until oat mixture is crisp and lightly browned, about 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
