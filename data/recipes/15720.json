  "ingredients": [
    "1 large egg white",
    "1 teaspoon cold water",
    "4 cups whole almonds",
    "0.5 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Lightly grease a 10x15-inch jellyroll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly beat egg white in a large bowl. Add water; beat until frothy but not stiff.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yexYzPGBMSc8dwBuf21atJ6KfiE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15720-cinnamon-roasted-almonds-ddmfs-step-1-0610-2d921665bcc047849f1c5fd98ca2b6ce.jpg"
      ],
      "image": "assets/images/15720/step_02.webp"
    },
    {
      "text": "Stir in nuts until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k7J-SiRpcZdfiPsTh01i0yFE9Q0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15720-cinnamon-roasted-almonds-ddmfs-step-2-0613-fc098e7568c14f9e930a608b1e57af93.jpg"
      ],
      "image": "assets/images/15720/step_03.webp"
    },
    {
      "text": "Mix sugar, cinnamon, and salt in a small bowl. Sprinkle sugar mixture over nuts; toss to coat. Spread evenly onto the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FYzQq-FzCYgTQsDn_UKeNBrwpEI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15720-cinnamon-roasted-almonds-ddmfs-step-4-0620-ad756f253b204fe4b597abb2d2c2ae5e.jpg"
      ],
      "image": "assets/images/15720/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven, stirring occasionally, until golden, about 1 hour. Allow to cool, then store nuts in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gG3j74XhFPmQD-EJhN04bZ3FiJs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15720-cinnamon-roasted-almonds-ddmfs-step-5-0642-d360eb781f994f4d818ea912e1e0790e.jpg"
