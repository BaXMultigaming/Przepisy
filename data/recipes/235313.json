  "ingredients": [
    "1 cup soy milk",
    "2 tablespoons flax seed meal",
    "1 cup Greek yogurt (such as Chobani®)",
    "1 cup fresh strawberries",
    "0.5 banana",
    "3 ounces baby carrots, cut into chunks",
    "1 tablespoon flaked coconut",
    "1 cup frozen blueberries"
  ],
  "steps": [
    {
      "text": "Pour soy milk and flax seeds into a blender. Allow flax seeds to soften, 1 to 3 minutes. Turn blender on and add yogurt, strawberries, banana, carrots, and coconut, blending well after each addition. Add blueberries and blend until smooth.",
