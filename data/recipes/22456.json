  "ingredients": [
    "1.75 cups white sugar",
    "0.75 cup vegetable oil",
    "3 eggs",
    "0.25 cup applesauce",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 cup whole wheat flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "3 cups peeled, cored and cubed apples",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Lightly grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, oil, eggs, applesauce, and vanilla extract in a bowl. Sift all-purpose flour, whole wheat flour, cinnamon, baking soda, and salt into a separate bowl; stir into sugar mixture, mixing until just combined. Fold in apples and walnuts. Divide batter between the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in centers comes out clean, about 70 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
