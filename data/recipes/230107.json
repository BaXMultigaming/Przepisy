  "ingredients": [
    "0.5 cup apple jelly",
    "1 tablespoon honey",
    "1 tablespoon Dijon mustard",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "4 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix apple jelly, honey, mustard, cinnamon, and salt together in a bowl. Brush chicken breasts with glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place glazed chicken breasts on the preheated grill; cook, occasionally brushing chicken with more glaze, until chicken is no longer pink in the center, about 10 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
