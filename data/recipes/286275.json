  "ingredients": [
    "3 (15.8 ounce) cans great northern beans, drained",
    "4 cups chicken broth",
    "1 (10 ounce) can green enchilada sauce",
    "1 (4 ounce) can chopped green chilies",
    "1 small onion, diced",
    "1 (2 ounce) can sliced black olives",
    "1 medium jalapeno pepper, seeded and diced",
    "3 cloves garlic, minced",
    "1 tablespoon taco seasoning",
    "1 (12 ounce) package frozen corn",
    "8 ounces cream cheese"
  ],
  "steps": [
    {
      "text": "Combine beans, broth, enchilada sauce, green chilies, onion, black olives, jalapeno, garlic, and taco seasoning in a large pot. Bring to a boil over medium-high heat, reduce heat to low, and simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in frozen corn and cook until corn is warmed through, 5 more minutes. Add cream cheese and cook, stirring, until cream cheese is incorporated and soup is thickened, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
