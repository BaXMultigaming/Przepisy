  "ingredients": [
    "1 tablespoon olive oil",
    "0.33333334326744 large eggplant",
    "1 egg",
    "1 tablespoon water",
    "1 cup dry bread crumbs",
    "1 tomato, chopped",
    "0.25 cup grated Parmesan cheese",
    "0.25 cup Italian-style salad dressing"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a baking sheet or pizza pan with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice eggplant into 8 rounds, each ¼- to ½-inch thick. Trim skin, maintaining round shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg and water together in a small bowl until smooth. Place bread crumbs in a separate small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip eggplant slices, one at a time, into egg mixture, then press into bread crumbs to evenly coat. Arrange coated eggplant slices in a single layer on the prepared baking sheet. Top slices with tomato, Parmesan cheese, and Italian-style salad dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for about 15 minutes. Turn on the broiler and broil for 3 to 5 minutes; check frequently while broiling to avoid burning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
