  "keywords": [],
  "ingredients": [
    "2 cups water",
    "1 cup butter",
    "1 cup white sugar",
    "2 eggs",
    "0.5 cup water",
    "1 teaspoon white sugar",
    "3 (.25 ounce) packages active dry yeast",
    "1 teaspoon salt",
    "7.5 cups self-rising flour"
  ],
  "steps": [
    {
      "text": "In a large bowl place 2 cups water and butter or margarine. Microwave about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, mix 1 cup sugar and eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate cup, microwave 1/2 cup water for 30 seconds. Add 1 teaspoon sugar and dissolve yeast in this.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter water and sugar and eggs mixture together; add salt. Mix in yeast water. Stir in 7 to 7 1/2 cups flour. Mix well and let rise in the refrigerator overnight, covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to use, dump onto floured surface (DO NOT PUNCH DOWN!) and let warm to room temperature. LIGHTLY KNEAD! Only work in enough extra flour to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape into rolls and place on greased sheet(s). Let rest 30 minutes, or until doubled in size.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 400 degree F (205 degrees C) oven until tops are golden. Brush with oil or butter immediately out of the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
