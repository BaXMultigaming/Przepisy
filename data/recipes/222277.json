  "ingredients": [
    "cooking spray",
    "1 (16 ounce) package hot dogs",
    "1 cup all-purpose flour",
    "1 cup yellow corn meal",
    "0.5 cup white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1 cup milk",
    "1 egg",
    "0.25 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Spray 2 24-cup mini-muffin pans with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut hot dogs into 4 pieces crosswise and cut each piece lengthwise to make 8 pieces per hot dog.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, corn meal, sugar, baking powder, and salt in a bowl; stir in milk, egg, and vegetable oil to make a smooth batter. Stir chopped hot dogs into batter and spoon the mixture into prepared mini muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the corn muffins are lightly browned and set in the center, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
