  "ingredients": [
    "2.5 tablespoons dark brown sugar",
    "2 tablespoons paprika",
    "2 teaspoons mustard powder",
    "2 teaspoons onion powder",
    "2 teaspoons garlic powder",
    "1.5 teaspoons dried basil",
    "1 teaspoon ground bay leaves",
    "0.75 teaspoon ground coriander seed",
    "0.75 teaspoon ground savory",
    "0.75 teaspoon dried thyme",
    "0.75 teaspoon ground black pepper",
    "0.75 teaspoon ground white pepper",
    "0.125 teaspoon ground cumin",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "In a small bowl, mix together brown sugar, paprika, mustard powder, onion powder, garlic powder, basil, bay leaves, coriander, savory, thyme, black pepper, white pepper, cumin, and salt. Store in an airtight jar at room temperature until ready to use.",
