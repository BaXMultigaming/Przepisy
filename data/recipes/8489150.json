  "ingredients": [
    "1.75 cups self-rising flour",
    "0.75 cup vanilla-infused sugar",
    "0.33 cup vegetable oil",
    "1 cup carbonated water",
    "frosting of your choice (optional)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8 x 8-inch baking dish",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour and sugar in a large bowl. Pour in oil and half of the carbonated water. Mix well ensuring the batter is smooth and lump free. Pour in the remaining carbonated water. Stir to thoroughly combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 35 to 40 minutes. Remove from oven and allow to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Frost with your choice of frosting if you like.",
      "section": null,
      "name": null,
      "url": null,
