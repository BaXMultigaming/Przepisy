  "ingredients": [
    "1 large ham hock",
    "2 onions, chopped",
    "1 large carrot, chopped",
    "4 cups water, or more as needed",
    "2 tablespoons chicken base (such as Better Than Bouillon® Roasted Chicken Base)",
    "1 tablespoon rubbed sage leaves",
    "8 sprigs fresh thyme",
    "2 sprigs fresh rosemary",
    "1.5 pounds Yukon Gold potatoes, cubed",
    "1 pound purple potatoes, cubed",
    "0.5 pound red potatoes, cubed",
    "3 small tomatoes, diced",
    "1 cup cubed ham, or more to taste",
    "0.5 cup salted butter",
    "0.5 cup all-purpose flour",
    "1 cup half-and-half",
    "0.25 cup shredded Cheddar cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Combine ham hock, onions, carrot, water, chicken base, sage, thyme, and rosemary in a large slow cooker. Cover and cook on Low, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir potatoes and tomatoes into the soup and cook on Low, 3 to 4 hours more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove ham hock, shredding with 2 forks, leaving behind any meat. Add cubed ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a saute pan over medium heat. Whisk in flour until it is thick, aromatic, and slightly browned, 15 to 20 minutes. Add half-and-half until it is gravy consistency. Add mixture to the slow cooker and mix well. Serve with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
