  "ingredients": [
    "1.5 cups all-purpose flour",
    "2 cups white sugar",
    "0.5 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 tablespoon distilled white vinegar",
    "2 teaspoons vanilla extract",
    "0.33333334326744 cup vegetable oil",
    "1 cup water",
    "0.25 cup butter",
    "0.25 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 9 inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the flour, 1 cup of the sugar, 1/4 cup of the cocoa, the soda, and the salt. Stir in the vinegar, oil, water, and 1 teaspoon vanilla. Beat until smooth. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 30 to 35 minutes. Let cake cool. Then spread chocolate icing over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Chocolate Icing: Combine 1 cup of the sugar, 1/4 cup of the cocoa, the milk, and the butter or margarine. Boil for 1 minute. Stir in 1 teaspoon vanilla and continue stirring until partially cool. Spread over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
