  "ingredients": [
    "cooking spray",
    "1 pound medium yellow-flesh potatoes, scrubbed and chopped into 1-inch cubes",
    "1 pound red potatoes, scrubbed and chopped into 1-inch cubes",
    "1 cup shredded mozzarella cheese",
    "0.5 cup shredded Cheddar cheese",
    "0.5 cup sour cream",
    "0.5 cup mayonnaise",
    "4 tablespoons salted butter, cut into small pieces"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a deep 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-04m_x_YIRFDOzheibTh9SohT8c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272525-grandmas-cheesy-potatoes-VAT-001-Step1-cba7aae8cb5f42f68f0448980db1e19c.jpg"
      ],
      "image": "assets/images/272525/step_01.webp"
    },
    {
      "text": "Place yellow and red potatoes into a large pot and cover with salted water; bring to a boil. Cook until soft, about 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CffCg64tSIwq8MmbP8r6KeIi1rk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272525-grandmas-cheesy-potatoes-VAT-003-Step2-B-c200f2d4819041f2a8967ed2b2a0f7bf.jpg"
      ],
      "image": "assets/images/272525/step_02.webp"
    },
    {
      "text": "Combine mozzarella cheese, Cheddar cheese, sour cream, and mayonnaise in a large bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/piCIbvkKCtOVl4l3YhjOXjM4XK8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272525-grandmas-cheesy-potatoes-VAT-004-Step3-d308f84804224771a2aa05a105641509.jpg"
      ],
      "image": "assets/images/272525/step_03.webp"
    },
    {
      "text": "Slowly add potatoes and toss; use a wooden spoon or flat spatula to avoid mashing potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ailJGnMeaSaSYPUG6Ntm_D06Nyw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272525-grandmas-cheesy-potatoes-VAT-005-Step4-bc8ef541447a40f9ba2b292e65813420.jpg"
      ],
      "image": "assets/images/272525/step_04.webp"
    },
    {
      "text": "Pour potatoes into the prepared baking dish. Dot butter over the top and cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9S8d68af_GO9cfatDcB-nEaaUWw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272525-grandmas-cheesy-potatoes-VAT-006-Step5-A-6d40d298fc594ceda5fdda0c897b67e2.jpg"
      ],
      "image": "assets/images/272525/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes. Remove from the oven and turn on the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nHdqDJannITyVMPQoyhahr3qFvQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272525-grandmas-cheesy-potatoes-VAT-008-Step6-02386ec30b97421ea16afb601ac08cc9.jpg"
      ],
      "image": "assets/images/272525/step_06.webp"
    },
    {
      "text": "Uncover the dish, return to the oven, and broil until the top is golden brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XReiqU6cnOWHzIm665MneI0V0Os=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272525-grandmas-cheesy-potatoes-VAT-009-Step7-15671a3f0a9d4d8fbccf4f1bc9e2eeb4.jpg"
      ],
      "image": "assets/images/272525/step_07.webp"
    }
