  "title": "Sour Cream Marinated Chicken II",
  "description": "Bone-in chicken breasts marinated in a seasoned sour cream mixture, then breaded and baked. This recipe is surprisingly easy and tasty for people of all ages.",
  "authors": [
    "Chris Boyer"
  ],
  "date_published": "2000-03-05T15:04:39-05:00",
