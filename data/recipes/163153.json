        "https://www.allrecipes.com/thmb/bzx40hhcXeWdsqQC5PGVlAbmCmo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/163153-Elegant-Penne-with-Asparagus-and-shrimp-ddmfs-step-08-4x3_8529-3d997e96f329413fa3c96dcd16e72d4a.jpg"
