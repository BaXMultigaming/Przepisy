  "ingredients": [
    "1 tablespoon olive oil",
    "6 roma (plum) tomatoes, diced",
    "2 red bell pepper, seeded and chopped",
    "1 onion, chopped",
    "10 fresh mushrooms, quartered",
    "1 cup fresh corn kernels",
    "1 jalapeno pepper, seeded and minced",
    "1 tablespoon chili powder",
    "1 teaspoon ground cumin",
    "1 teaspoon ground black pepper",
    "2 (15 ounce) cans black beans, drained and rinsed",
    "1.5 cups chicken broth or vegetable broth",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jSvPIT3fRMbPIgBjHZ09yoEEUQU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22924-black-bean-chili-ddmfs-step-1-4e5276f170e74620a5854894a722ab05.jpg"
      ],
      "image": "assets/images/22924/step_01.webp"
    },
    {
      "text": "Heat olive oil in a large saucepan over medium-high heat. Sauté tomatoes, bell pepper, onion, mushrooms, corn, and jalapeño until onion is translucent, about 10 minutes. Season with chili powder, cumin, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NKbLK5DeZ6rW9D3ntkNV6s20XNc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22924-black-bean-chili-ddmfs-step-3-1a4b4858e9034c1487cb0e8bce40ba20.jpg"
      ],
      "image": "assets/images/22924/step_02.webp"
    },
    {
      "text": "Stir in black beans, broth, and salt; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xyRD8oxseeEXw_fcR9wnrFFGNLI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22924-black-bean-chili-ddmfs-step-4-766d9b6c267f4830a03569ada774ed08.jpg"
      ],
      "image": "assets/images/22924/step_03.webp"
    },
    {
      "text": "Reduce heat to medium-low. Remove 1 1/2 cups chili to a food processor or blender; purée until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SPFiMyk_l6ZPw9fILCj1fA2gp9A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22924-black-bean-chili-ddmfs-step-5-101e4357881d4fea94167a867047749d.jpg"
      ],
      "image": "assets/images/22924/step_04.webp"
    },
    {
      "text": "Stir the bean mixture back into the soup. Serve hot by itself or over rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n5FNLfVkwFeMwBtWxylbOlJvRx0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22924-black-bean-chili-ddmfs-step-6-ecb5bb71778a4f9984f2a879bc5b74ee.jpg"
