  "ingredients": [
    "0.25 cup extra-virgin olive oil",
    "1 tablespoon fresh lemon juice",
    "salt and freshly ground black pepper to taste",
    "4 fresh figs",
    "8 cups mixed salad greens",
    "0.5 cup chopped pecans, toasted",
    "0.25 cup flat-leaf Italian parsley leaves",
    "2 tablespoons chopped fresh mint leaves",
    "2 tablespoons chopped fresh dill",
    "2 tablespoons sliced green onion",
    "3 tablespoons crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Whisk olive oil, lemon juice, salt, and black pepper together in a small bowl until well combined. Set vinaigrette aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Quarter figs vertically, cut quarters in half, then cut into slices. Toss figs, mixed greens, pecans, parsley, mint, dill, and green onion together in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour vinaigrette over greens; toss until evenly coated. Sprinkle feta cheese over salad to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
