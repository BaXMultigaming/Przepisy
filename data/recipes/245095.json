  "ingredients": [
    "0.75 cup butter",
    "1 cup diced onion",
    "1 cup diced celery",
    "2 teaspoons poultry seasoning",
    "0.5 teaspoon salt, or to taste",
    "0.25 teaspoon ground black pepper, or to taste",
    "1 cup Swanson® Chicken Broth",
    "1 (1 pound) loaf sliced white bread (air dried at least 2 hours), cut into cubes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter 18 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 3/4 cup butter in large stock pot or Dutch oven over medium heat. Add onion and celery; cook until vegetables are soft, about 8 minutes. Season with poultry seasoning, salt, and black pepper. Remove pot from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir bread cubes into vegetables until cubes are evenly coated. Stir in chicken broth; mix well. Press 1/4 cup mixture into each of the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until muffin tops are golden brown, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
