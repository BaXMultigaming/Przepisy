  "title": "Lemon Sugar Cookies",
  "description": "These lemon sugar cookies, made with fresh lemon and pudding mix, are chewy, sweet, and full of bright, citrus flavor.",
  "authors": [
    "Marianne Williams"
  ],
  "date_published": "2022-08-03T16:38:01-04:00",
