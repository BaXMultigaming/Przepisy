  "ingredients": [
    "0.66666668653488 cup pecans",
    "2 cups all-purpose flour",
    "1.3333333730698 cups packed brown sugar",
    "2 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon nutmeg",
    "0.5 teaspoon salt",
    "1 cup applesauce",
    "0.25 cup water",
    "0.25 cup vegetable oil",
    "1.5 tablespoons cider vinegar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pecans in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pecans in the preheated oven until golden, 5 to 7 minutes. Remove pecans from oven and reduce oven temperature to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, brown sugar, cinnamon, baking soda, baking powder, nutmeg, and salt together in a large bowl. Stir applesauce, water, vegetable oil, and vinegar together in a separate bowl. Stir applesauce mixture into flour mixture until just combined; fold in pecans. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the bread comes out clean, 50 to 60 minutes. Cool bread in the pan for 10 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
