  "ingredients": [
    "0.25 cup butter",
    "0.5 pound fresh mushrooms, thinly sliced",
    "0.5 cup white wine",
    "12 ounces cooked crabmeat",
    "0.25 cup chopped green onions",
    "0.25 pound seedless red grapes, halved",
    "4 ounces Stilton cheese, crumbled"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat, add mushrooms and white wine. Cook stirring until mushrooms are slightly softened, and about 1/4 cup white wine remains. Remove the mushrooms, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange the crabmeat in the bottom of a small baking dish. Layer with the mushrooms, green onions, and grapes. Drizzle with the butter and wine mixture, and top with Stilton cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 10 to 12 minutes in the preheated oven, until the dish is heated through and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
