  "ingredients": [
    "1 (10 inch) flour tortilla",
    "1.5 tablespoons extra-virgin olive oil",
    "1 pinch dried oregano, or to taste",
    "salt and ground black pepper to taste",
    "0.5 cup very thinly sliced zucchini",
    "0.5 tomato, thinly sliced",
    "1 cup baby spinach leaves",
    "0.25 cup sliced green olives",
    "0.25 cup freshly grated Parmesan cheese",
    "1 pinch red pepper flakes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 435 degrees F (225 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tortilla on a pizza stone and brush with 1 tablespoon olive oil. Sprinkle with oregano, salt, and pepper. Layer with zucchini slices, tomato slices, spinach, olives, and Parmesan cheese. Add more oregano, salt, and pepper, then sprinkle with red pepper flakes. Drizzle with remaining olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tortilla is crispy and cheese is melted, about 15 minutes. Remove from the oven, slice, and eat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
