  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup whole wheat flour",
    "0.25 cup ground flax seeds",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "2 ripe bananas",
    "1 cup white sugar",
    "0.5 cup light brown sugar",
    "0.5 cup margarine",
    "3 eggs",
    "0.5 teaspoon vanilla extract",
    "1 cup vanilla yogurt",
    "1 ripe pear, chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line a muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift all-purpose flour, whole wheat flour, ground flax seeds, baking soda, baking powder, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bananas, white sugar, brown sugar, and margarine in a separate bowl; beat with an electric mixer until creamy and fluffy. Beat in eggs one at a time. Stir in vanilla extract. Beat in vanilla yogurt gradually. Beat in flour mixture until well blended. Fold pear into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill muffin cups 1/3 of the way with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are browned and a toothpick inserted into the center comes out clean, 15 to 20 minutes. Transfer to a cooling rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
