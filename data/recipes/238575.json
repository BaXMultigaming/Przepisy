  "ingredients": [
    "0.5 cup chopped fresh cilantro",
    "4 limes, juiced",
    "2 tablespoons garlic salt",
    "2 tablespoons ground black pepper",
    "1 whole whole chicken, cut into 6 pieces"
  ],
  "steps": [
    {
      "text": "Whisk cilantro, lime juice, garlic salt, and black pepper together in a large glass or ceramic bowl. Add chicken; toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator, 30 minutes to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from marinade and shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, turning occasionally, until no longer pink at the bone and juices run clear, about 30 minutes. An instant-read thermometer inserted near but not touching the bone should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
