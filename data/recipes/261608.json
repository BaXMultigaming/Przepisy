  "ingredients": [
    "cooking spray",
    "1 tablespoon olive oil",
    "2 cloves garlic, minced",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "4 cups sliced cauliflower",
    "2 cups cherry tomatoes",
    "1 (15 ounce) can garbanzo beans, drained",
    "1 lime, cut into wedges",
    "1 tablespoon chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with aluminum foil and grease with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine olive oil, garlic, salt, and pepper in a bowl. Add cauliflower, tomatoes, and garbanzo beans; toss until well coated. Spread in a single layer on the prepared baking sheet. Add lime wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until vegetables are caramelized, about 25 minutes. Remove lime wedges and top with fresh cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
