  "ingredients": [
    "butter-flavored cooking spray (such as Pam®)",
    "0.5 (12 count) package Hawaiian bread rolls (such as King's®)",
    "3 eggs",
    "0.75 cup milk",
    "1.5 tablespoons vanilla extract",
    "1 tablespoon ground cinnamon",
    "2 bananas, sliced 1/8-inch thick",
    "0.5 cup brown sugar",
    "0.25 cup chopped pecans",
    "0.25 cup butter, cut into 1/4-inch cubes"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice bread rolls horizontally without separating into individual rolls, creating 2 even halves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a large, shallow bowl until smooth. Stir in milk, vanilla extract, and cinnamon to make a smooth batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip bottom half of bread rolls into batter, coating both sides, and place in baking dish. Cover bread with sliced bananas. Sprinkle brown sugar and pecans on top. Dot with cubes of butter. Dip top half of bread rolls in batter, coating both sides, and place on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until middle is set and top is golden brown, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
