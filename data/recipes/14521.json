  "ingredients": [
    "3 tablespoons hoisin sauce",
    "3 tablespoons sherry",
    "0.25 cup soy sauce",
    "1 teaspoon barbeque sauce",
    "2 green onions, chopped",
    "2 cloves garlic, minced",
    "1 tablespoon minced fresh ginger root",
    "1.5 pounds flank steak",
    "skewers"
  ],
  "steps": [
    {
      "text": "In a small bowl, mix together hoisin sauce, sherry, soy sauce, barbeque sauce, green onions, garlic, and ginger.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut flank steak across grain on a diagonal into 1/4 inch slices. Place slices in a 1 gallon resealable plastic bag. Pour hoisin sauce mixture over slices, and mix well. Refrigerate 2 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat. Discard marinade, and thread steak on skewers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Oil the grill grate. Grill skewers 3 minutes per side, or to desired doneness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
