  "title": "Pink Brain Shooter",
  "description": "A pinkish-white brain with painted veins, made of peach gelatin and peach schnapps, makes the creepiest shooter ever.",
  "authors": [
    "Marie Angel Cat"
  ],
  "date_published": "2020-06-18T23:43:38-04:00",
