  "ingredients": [
    "0.75 cup milk",
    "2 tablespoons pumpkin puree",
    "1 tablespoon pumpkin spice syrup (such as Torani®)",
    "0.5 teaspoon pumpkin pie spice, divided",
    "2 packets stevia sweetener (such as Truvia®)",
    "0.25 cup boiling water",
    "1 tablespoon instant coffee granules",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Combine milk, pumpkin puree, pumpkin spice syrup, 1/4 teaspoon pumpkin pie spice, and sweetener in a saucepan. Bring to a simmer over medium-high heat. Stir until well combined and heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine boiling water, coffee granules, sugar, and remaining 1/4 teaspoon pumpkin pie spice in a tall container. Whip with an immersion blender until foamy, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour pumpkin-milk mixture into a mug and top with coffee foam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
