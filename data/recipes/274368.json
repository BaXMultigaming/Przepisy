  "ingredients": [
    "8 ears corn in the husk",
    "2 cups quartered cherry tomatoes",
    "1 large red bell pepper, chopped",
    "1 small red onion, chopped",
    "0.25 cup chopped fresh basil",
    "0.5 cup olive oil",
    "0.25 cup rice vinegar",
    "2 tablespoons lime juice",
    "1.25 teaspoons salt",
    "1 clove garlic, minced",
    "0.5 teaspoon grated lime zest",
    "0.25 teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Trim corn husks of any long hanging parts and excess silk. Place in a large bowl covered with water; soak for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook corn on the preheated grill, flipping a ¼ turn, about every 6 minutes, until all sides have been grilled, about 24 minutes. Cool corn enough until easy to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove husks; cut kernels off cobs into a bowl. Add cherry tomatoes, bell pepper, onion, and basil to corn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, vinegar, lime juice, salt, garlic, lime zest, and black pepper together in a small bowl until well blended; pour over corn salad and toss to coat. Cover the bowl with plastic wrap; refrigerate at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
