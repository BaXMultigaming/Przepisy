      "image_sources": [
        "https://www.allrecipes.com/thmb/PQBSdFm1CGz-5MC5IdOANtduP2Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/62642-Albondigas-Step-3-0088-4x3-2b9bebcac1a8409095a03c354edd9a94.jpg"
