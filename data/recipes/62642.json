  "ingredients": [
    "1 quart water",
    "4 carrots, sliced",
    "2 small potatoes, peeled and diced",
    "1 medium onion, diced",
    "1.5 cups salsa, medium or hot",
    "2 beef bouillon cubes",
    "1.5 pounds ground beef",
    "0.33333334326744 cup seasoned dry bread crumbs",
    "0.33333334326744 cup milk",
    "1 tablespoon chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Bring water, carrots, potatoes, onion, salsa, and bouillon cubes to a boil in a large stockpot. Reduce heat and cook, stirring occasionally, at a medium simmer for 10 minutes.",
