  "ingredients": [
    "0.25 cup all-purpose flour",
    "0.25 cup margarine",
    "2 cups heavy whipping cream",
    "2 cups chicken broth",
    "1 tablespoon dried parsley",
    "4 egg yolks",
    "0.25 cup lemon juice",
    "1 teaspoon cornstarch, or as needed",
    "4 cooked chicken breasts, broken into chunks"
  ],
  "steps": [
    {
      "text": "Mix flour and margarine together in a saucepan over medium heat, stirring until the flour and margarine form a paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cream into flour mixture about 1/2 cup at a time until smoothly combined; whisk in chicken broth and parsley. Bring sauce to a simmer, whisking constantly until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg yolks and lemon juice together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg yolk mixture slowly into cream mixture, about 1 tablespoon at a time, until the sauce barely comes to a simmer and coats the back of a spoon. Do not boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "If thicker sauce is desired, whisk cornstarch and 1/4 cup of sauce in a small bowl; stir cornstarch mixture back into sauce until thickened, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chicken breast pieces into sauce until chicken is heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
