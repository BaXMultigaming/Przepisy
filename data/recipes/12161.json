  "ingredients": [
    "2 cups milk",
    "0.75 cup white sugar",
    "0.5 cup baking mix",
    "0.25 cup unsalted butter, softened",
    "4 large eggs",
    "1.5 teaspoons vanilla extract",
    "1 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NK0mQQbr7IeX0VYaGQziw8ZZia8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12161-impossible-coconut-pie-i-DDMFS-step01-72720f3031e044bfbbf73fc863b718e6.jpg"
      ],
      "image": "assets/images/12161/step_01.webp"
    },
    {
      "text": "Combine milk, sugar, baking mix, butter, eggs, and vanilla in blender; blend on low speed for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F_JeXgUE4hXStv0ukSpgixEX_hY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12161-impossible-coconut-pie-i-DDMFS-step02-902995b1f0ff4ad6baa6f87de733d67d.jpg"
      ],
      "image": "assets/images/12161/step_02.webp"
    },
    {
      "text": "Pour into the prepared pie plate and let stand for 5 minutes. Sprinkle coconut over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VwA7Y0MMjfoRkcUeMoUqF95yfJA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12161-impossible-coconut-pie-i-DDMFS-step03-9d38c859271d40aa82e08f7b0395c835.jpg"
      ],
      "image": "assets/images/12161/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 40 minutes. Let pie cool briefly before slicing; serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7pdgcGcpfuAtC6FT_ZHMN7lC4eI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12161-impossible-coconut-pie-i-DDMFS-step04-831f341225bd4accbb718bf8e6b6ef1a.jpg"
      ],
      "image": "assets/images/12161/step_04.webp"
    }
  ],
