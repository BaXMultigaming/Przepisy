  "ingredients": [
    "0.25 cup butter",
    "4 yellow summer squash, thinly sliced",
    "1 small yellow onion, thinly sliced",
    "1 cup sour cream",
    "1 egg, lightly beaten",
    "1 cup shredded sharp Cheddar cheese",
    "1 sleeve buttery round crackers (such as Ritz®), crushed and divided",
    "0.25 cup melted butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 1-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1/4 cup butter in a saucepan over medium heat. Cook and stir squash and onion in hot butter until tender, 10 to 15 minutes. Drain and cool vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sour cream and egg together in a large bowl. Add squash mixture, Cheddar cheese, and 1/2 of the crushed buttery round crackers; stir to combine and pour into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir remaining buttery round crackers and melted butter together in a bowl; spread over the top of squash mixture and gently pat down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crackers are lightly browned, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
