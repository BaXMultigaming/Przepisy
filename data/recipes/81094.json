  "ingredients": [
    "1 egg, lightly beaten",
    "0.25 cup ketchup",
    "2 tablespoons barbeque sauce",
    "2 tablespoons steak sauce",
    "1 teaspoon Worcestershire sauce",
    "0.25 cup brown sugar",
    "1 medium onion, finely chopped",
    "2 cloves garlic, minced",
    "1 teaspoon dried parsley",
    "0.5 teaspoon seasoned salt",
    "salt and pepper to taste",
    "1 pound ground beef",
    "0.66666668653488 cup dry bread crumbs",
    "0.33333334326744 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 5x9 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, stir together the egg, ketchup, barbeque sauce, steak sauce, Worcestershire sauce, brown sugar, onion, and garlic, seasoned salt, and salt and pepper. Mix in ground beef, bread crumbs, and Cheddar cheese. Spread into the loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 55 minutes in the preheated oven, to a minimum internal temperature of 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
