  "ingredients": [
    "2 large bone-in chicken breast halves with skin",
    "0.25 cup extra-virgin olive oil",
    "0.5 teaspoon garlic, minced",
    "0.5 teaspoon coarse sea salt",
    "0.5 teaspoon cracked black pepper",
    "0.25 teaspoon dried rosemary",
    "0.25 teaspoon dried basil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FFyKtVDOTvTLtlsC6MZoF8m0N2g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231449-BakedSplit-Chicken-Breast-mfs-STEPS-001-4a516818e8024eb08134b5251e0ece88.jpg"
      ],
      "image": "assets/images/231449/step_01.webp"
    },
    {
      "text": "Rub chicken breasts with olive oil and garlic; sprinkle with salt, black pepper, rosemary, and basil. Arrange chicken in a large baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yVUz8jmPWO4ZYFRN66ooGpDOTSw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231449-BakedSplit-Chicken-Breast-mfs-STEPS-007-13a523a9d43d4090a939a1149a640859.jpg"
      ],
      "image": "assets/images/231449/step_02.webp"
    },
    {
      "text": "Refrigerate for at least 45 minutes. Meanwhile, preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken meat is no longer pink at the bone and the juices run clear, 45 to 60 minutes. An instant-read thermometer inserted in the thickest part of the breast meat should read 165 degrees F (75 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RMR-t1KzFPBsJy4RzrNWK0fW9Ys=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231449-BakedSplit-Chicken-Breast-mfs-STEPS-010-13558d95d171454594e1d0180f38c6df.jpg"
      ],
      "image": "assets/images/231449/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
