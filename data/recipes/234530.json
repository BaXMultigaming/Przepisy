  "ingredients": [
    "1 (22 ounce) package corn chips (such as Fritos®)",
    "1 (15 ounce) can sliced black olives, drained",
    "1 cup water",
    "2 (15 ounce) cans chili without beans (such as Hormel®)",
    "1 (32 ounce) bag shredded Cheddar cheese"
