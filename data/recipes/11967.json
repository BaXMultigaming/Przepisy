  "title": "Angel Chicken Pasta",
  "description": "This angel chicken dinner features boneless chicken baked in a mixture of condensed mushroom soup and cream cheese served over delicate angel hair pasta.",
  "authors": [
    "Marian Collins"
  ],
  "date_published": "1999-03-30T16:50:07-05:00",
