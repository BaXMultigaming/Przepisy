  "ingredients": [
    "0.5 cup chestnut flour",
    "3 tablespoons white rice flour",
    "1 tablespoon potato starch",
    "0.5 teaspoon baking powder",
    "0.5 cup milk",
    "1 egg, separated",
    "1 tablespoon vegetable oil",
    "1 teaspoon honey"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chestnut flour, white rice flour, potato starch, and baking powder together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, egg yolk, vegetable oil, and honey in another bowl. Sift in flour mixture, whisking constantly to prevent lumps in the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white in a glass, metal, or ceramic bowl until peaks form. Fold gently into batter until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter onto preheated waffle iron and cook until golden brown per manufacturer's instructions, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
