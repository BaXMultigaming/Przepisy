  "ingredients": [
    "9 cups all-purpose flour",
    "1 cup nonfat dry milk powder",
    "5 tablespoons baking powder",
    "0.25 cup white sugar",
    "1 tablespoon salt",
    "1 cup vegetable shortening"
  ],
  "steps": [
    {
      "text": "Whisk flour, dry milk powder, baking powder, sugar, and salt in a large bowl until thoroughly combined. Cut shortening into dry ingredients with a pastry cutter, about 1/2 cup at a time, until mixture resembles cornmeal. Store in an air-tight container for up to 3 months.",
