  "ingredients": [
    "0.5 cup tequila, or more to taste",
    "0.5 cup fresh lime juice",
    "0.25 cup orange liqueur",
    "0.25 cup simple syrup",
    "1 jalapeno pepper, halved and seeded",
    "4 thin slices cucumber, or more to taste",
    "4 wedges lime",
    "2 tablespoons kosher salt, or as needed",
    "ice, as needed",
    "4 slices cucumber"
  ],
  "steps": [
    {
      "text": "Combine tequila, lime juice, orange liqueur, and simple syrup in a pitcher with a lid; add jalapeño and 4 thin cucumber slices. Refrigerate until chilled, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, run lime wedges along rims of 4 pint glass; pour salt onto a flat plate. Dip moistened rims into salt to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill prepared glasses with ice; pour chilled margarita over top. Garnish each drink with 1 cucumber slice.",
