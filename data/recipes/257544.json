  "ingredients": [
    "2 cups oil for frying, or as needed",
    "0.75 cup buttermilk",
    "2 large eggs",
    "1 cup all-purpose flour",
    "1 cup bread crumbs",
    "0.25 cup Parmesan cheese",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "2 medium zucchini, sliced into 3-inch sticks"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk buttermilk and eggs together in a shallow dish. Mix flour, bread crumbs, Parmesan cheese, baking powder, and salt together in a separate shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip zucchini sticks into egg mixture; roll in bread crumb mixture to coat. Dip back into egg mixture; roll in bread crumb mixture again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lower breaded zucchini sticks carefully into the hot oil in batches; fry until golden brown, about 3 minutes per batch. Drain on a large paper-towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
