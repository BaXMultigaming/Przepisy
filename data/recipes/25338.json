  "ingredients": [
    "1 (12 ounce) package extra firm tofu",
    "3 tablespoons cornstarch",
    "oil for frying",
    "2 green onions, chopped",
    "2 tablespoons hoisin sauce"
  ],
  "steps": [
    {
      "text": "Cut tofu into 12 cubes. Place cornstarch on a plate or in a shallow bowl and dredge tofu in it, coating thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat enough oil so that tofu will be half-way submerged. Fry tofu in hot oil for 3 to 5 minutes on each side, or until crispy. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle green onions over tofu and drizzle with hoisin sauce. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
