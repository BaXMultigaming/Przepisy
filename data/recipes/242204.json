  "ingredients": [
    "10 ears corn, shucked and kernels removed",
    "1.25 cups butter",
    "2.5 cups lime juice",
    "2.5 cups crema Mexicana (Mexican cream)",
    "1.25 teaspoons chili powder, or to taste",
    "salt to taste",
    "1.25 cups crumbled cotija cheese",
    "10 dashes hot pepper sauce",
    "10 wedges fresh lime"
  ],
  "steps": [
    {
      "text": "Place corn kernels in a saucepan and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 2 to 3 minutes. Drain and return corn to the saucepan to dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HqLssRMsxBYGeMu7OPZ05SJBwe8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242204-corn-in-a-cup-elote-en-vaso-ddmfs-step1-0076-2e2dc2a748fa411881f781e3b741127a.jpg"
      ],
      "image": "assets/images/242204/step_01.webp"
    },
    {
      "text": "Spoon 3/4 cup corn into each of 10 serving bowls. Stir 2 tablespoons butter into each bowl until melted. Mix 1/4 cup lime juice and 1/4 cup crema Mexicana into each bowl. Sprinkle 1/8 teaspoon chili powder on top and season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/InEFcebKmXC0pF46hqbonWSTtII=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242204-corn-in-a-cup-elote-en-vaso-ddmfs-step3-0086-a660b09ab57e4081b2ee850a0dc964ca.jpg"
      ],
      "image": "assets/images/242204/step_02.webp"
    },
    {
      "text": "Top each serving with 2 tablespoons cotija cheese, a dash of hot sauce, and a lime wedge.",
