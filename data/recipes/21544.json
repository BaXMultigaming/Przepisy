  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 unbaked 9 inch pie crust",
    "6 slices bacon",
    "1 onion, chopped",
    "1.5 cups milk",
    "3 large eggs, beaten",
    "0.25 teaspoon salt",
    "1.5 cups shredded Swiss cheese",
    "1 tablespoon all-purpose flour"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Tmlax-A6eFe_kKFYnUIbAl_Jf6Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21544-easy-quiche-lorraine-VAT-step-01-56f4d433101746b2a1f7f00a023eea11.jpg"
      ],
      "image": "assets/images/21544/step_01.webp"
    },
    {
      "text": "Line deep-dish pie crust with a double layer of aluminum foil. Bake in the preheated oven on a baking sheet for 8 minutes. Remove foil and continue baking until crust is lightly golden, 4 to 5 minutes. Reduce oven temperature to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TbIbH8W9Wjk1-FuDJ8yVdM9X2rY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21544-easy-quiche-lorraine-VAT-step-02-51fe10584c304c45be2eec3659576c7b.jpg"
      ],
      "image": "assets/images/21544/step_02.webp"
    },
    {
      "text": "Meanwhile, place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels, crumble, and set aside. Reserve 2 tablespoons bacon grease in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Gw1o74U4uBeOuhARXMtrs_yjesA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21544-easy-quiche-lorraine-VAT-step-03-13311ac5b197420a8a442b613ef8ae86.jpg"
      ],
      "image": "assets/images/21544/step_03.webp"
    },
    {
      "text": "Cook and stir onion in reserved grease in the skillet over medium heat until tender; drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O5PT2gO9SYdZQu8zOfXDmi9e804=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21544-easy-quiche-lorraine-VAT-step-04-fedbf7047ea84ecfa3dce0fe6d505912.jpg"
      ],
      "image": "assets/images/21544/step_04.webp"
    },
    {
      "text": "Mix milk, eggs, and salt in a large bowl. Stir in bacon and onion. Toss Swiss cheese and flour together in a medium bowl; add to egg mixture and stir well. Pour into par-baked crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OT715chKjFEKoTRXl0yTRCqMDpc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21544-easy-quiche-lorraine-VAT-step-05-b62807d254134b03a807e73a322ce37a.jpg"
      ],
      "image": "assets/images/21544/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, 35 to 40 minutes. Cover edges of crust with foil if they begin to get too brown. Let quiche cool for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ytz4qZVwuljNSfwwKhigmgCcJSc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21544-easy-quiche-lorraine-VAT-step-06-25c2309b560e486bb8d86bb3a0f76b2a.jpg"
      ],
      "image": "assets/images/21544/step_06.webp"
    }
  ],
