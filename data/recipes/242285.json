  "ingredients": [
    "2.5 pounds sweet potatoes",
    "cooking spray",
    "2 tablespoons white sugar",
    "2 teaspoons cornstarch",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground ginger",
    "0.5 cup orange juice",
    "3 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Pierce skin of sweet potatoes in several spots with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook sweet potatoes in microwave oven until just tender, 12 to 15 minutes. Refrigerate sweet potatoes until cooled completely, at least 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Prepare a shallow 1 1/2-quart baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel sweet potatoes and cut into cubes; spread into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, cornstarch, salt, and ginger together in a glass measuring cup; pour orange juice into the cup while stirring with a whisk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat orange juice mixture in microwave oven for 1 minute, stir, and continue to heat until thickened and smooth, 30 to 60 seconds more; add butter and stir until melted. Pour the liquid over the sweet potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until sweet potatoes are heated through, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
