  "title": "Gingered Sweet Potatoes with Orange Juice",
  "description": "Use your microwave oven to cook sweet potatoes to then be baked in a thick and buttery orange juice-based sauce with ginger.",
  "authors": [
    "pamela"
  ],
  "date_published": "2020-06-19T00:03:05-04:00",
