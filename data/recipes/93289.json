  "ingredients": [
    "0.75 cup SPLENDA® Sugar Blend",
    "0.75 cup flax seed meal",
    "5 ripe bananas, mashed",
    "0.25 cup skim milk",
    "0.25 cup low-fat sour cream",
    "2 teaspoons egg whites",
    "2 cups whole wheat flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the sugar blend, flax meal, bananas, milk, sour cream and egg whites until well blended. Combine the flour, baking soda and salt; stir into the banana mixture until moistened. Spoon into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour and 10 minutes in the preheated oven, or until a toothpick inserted into the crown of the loaf comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
