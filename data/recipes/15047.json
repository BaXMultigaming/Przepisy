    "publisher-tested"
  ],
  "ingredients": [
    "1 pound bacon",
    "2 medium onions, chopped",
    "2 cups fresh sliced mushrooms",
    "1 tablespoon butter",
    "4 cups frozen hash brown potatoes, thawed",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon garlic salt",
    "4 medium eggs",
    "1.5 cups milk",
    "1 pinch dried parsley",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XpgDCym59QK7W2sXxovBKnoMD8E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15047-Christmas-Brunch-Casserole-ingredients-karen-hibbard-4x3-e942d2f3331244cb9b105cfbdf768a29.jpg"
      ],
      "image": "assets/images/15047/step_01.webp"
    },
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Transfer bacon to a paper towel-lined plate and crumble when cool enough to handle. Drain grease from the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D-OnZ-_dWY3PwDmMAqgtCOT-CWU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15047-Christmas-Brunch-Casserole-step-1-karen-hibbard-4x3-419b0c18edaa4e33ac69d31cce6e3296.jpg"
      ],
      "image": "assets/images/15047/step_02.webp"
    },
    {
      "text": "Cook onions and mushrooms in the residual grease in the skillet until onions are translucent and mushrooms are tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Sg9Czq20sF29Ly1-04IhHkDS6FU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15047-Christmas-Brunch-Casserole-step-3-karen-hibbard-4x3-159b95a5edb543cda7918fb8a59ed098.jpg"
      ],
      "image": "assets/images/15047/step_03.webp"
    },
    {
      "text": "Grease a 9x13-inch casserole dish with 1 tablespoon of butter. Place potatoes into the bottom of the dish; sprinkle with salt, pepper, and garlic salt. Top with crumbled bacon, then add onions and mushrooms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/twJHB21z3TNBXL2JYxr7HmTGB70=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15047-Christmas-Brunch-Casserole-step-5-karen-hibbard-4x3-cf087a15e0324800a682819c2d990367.jpg"
      ],
      "image": "assets/images/15047/step_04.webp"
    },
    {
      "text": "Whisk milk, eggs, and parsley together in a mixing bowl; pour over casserole and top with Cheddar. Cover and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/smQmFzoD3fbKazHxFIQ8jrw3wo4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15047-Christmas-Brunch-Casserole-step-7-karen-hibbard-4x3-ae871ba867c84681a554b87720ecee4a.jpg"
      ],
      "image": "assets/images/15047/step_05.webp"
    },
    {
      "text": "When ready to bake, preheat the oven to 400 degrees F (200 degrees C). Bake in the preheated oven until set, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x3vEuwa3bxHGW_aH3091XqMExl4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15047-Christmas-Brunch-Casserole-step-8-karen-hibbard-4x3-0a14f7a532d84b86ad0059ef58efe738.jpg"
      ],
      "image": "assets/images/15047/step_06.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Bx6u368zzjV40HgFemQlcPtp8Ug=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15047-Christmas-Brunch-Casserole-vat-2318-4x3-8b0a814218d049a6a81c306d62e73b1b.jpg"
      ],
      "image": "assets/images/15047/step_07.webp"
    }
  ],
