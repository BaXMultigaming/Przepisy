  "steps": [
    {
      "text": "Warm chicken and hot sauce in a nonstick skillet over medium heat, stirring to coat chicken evenly with sauce, until heated through, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrape chicken into the center of the pan to form a shape similar to the hot dog bun. Cut Cheddar cheese slice in half and place over chicken; cook until Cheddar is melted, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bottom half of hot dog bun over chicken and cheese mixture, slide a spatula underneath, and invert onto a plate. Place top half of hot dog bun over melted cheese.",
