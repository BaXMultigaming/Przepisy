    {
      "text": "Sprinkle a pinch of baking soda into a 64-ounce, heat-proof glass pitcher. Pour in boiling water and add tea bags. Cover and allow to steep for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eyfwGOQZuBRiy36Kl1PnOWRinl0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-109190-SmothSweetTea-Step-2-0146-e806d4fde013450db87715dc710e130c.jpg"
      ],
      "image": "assets/images/109190/step_02.webp"
    },
    {
      "text": "Remove tea bags and discard; stir in sugar until dissolved. Pour in cool water; refrigerate until cold, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
