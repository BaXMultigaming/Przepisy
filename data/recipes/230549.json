  "ingredients": [
    "2 teaspoons white sugar",
    "2 teaspoons warm water",
    "1 Meyer lemon, juiced and peeled",
    "2 fluid ounces vodka",
    "1 fluid ounce orange-flavored liqueur (such as Cointreau®)",
    "ice",
    "1 teaspoon white sugar, or as needed for rimming"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 teaspoons sugar and warm water in a cocktail shaker; stir to dissolve sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour Meyer lemon juice, lemon peels, vodka, and orange liqueur into the shaker; add ice. Cover and shake vigorously.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove a lemon peel from the shaker and wipe the rim of a martini glass with the peel. Dip the rim of the glass in 1 teaspoon sugar, or as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain martini into prepared glass and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
