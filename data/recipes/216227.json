  "ingredients": [
    "2.5 cups unsalted cashews",
    "2 tablespoons coarsely chopped fresh rosemary",
    "1 tablespoon margarine, melted",
    "1 tablespoon dark brown sugar",
    "1 tablespoon kosher salt",
    "1 teaspoon ground cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Place cashews on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until warmed through, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stir rosemary, margarine, brown sugar, salt, and cayenne pepper together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour warm cashews into the rosemary mixture and toss to coat. Serve warm or allow to cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
