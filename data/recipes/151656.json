  "ingredients": [
    "1.25 cups boiling water",
    "4 tablespoons butter or margarine",
    "4 cups Pepperidge Farm® Herb Seasoned Stuffing",
    "6 skinless, boneless chicken breasts",
    "0.5 teaspoon paprika, or to taste",
    "1 (10.5 ounce) can Campbell's® Condensed Cream of Mushroom Soup or Campbell's® Condensed 98% Fat Free Cream of Mushroom Soup",
    "0.33333334326744 cup milk",
    "1 tablespoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TSjbGuU3DSxNglB7bTFzRZPfRfs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/151656-Chicken--Stuffing-Bake-DDMFS-4x3-step-1-11581-cd384eeb0a264e92921ff8d1aa332f3f.jpg"
      ],
      "image": "assets/images/151656/step_01.webp"
    },
    {
      "text": "Stir together boiling water and butter in a medium bowl until butter is melted. Add stuffing; mix gently until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xjnjliEiGVuPZpJfKs_YSNp__AY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/151656-Chicken--Stuffing-Bake-DDMFS-4x3-step-3-11587-e999238ce749442a93ce317e81ed7436.jpg"
      ],
      "image": "assets/images/151656/step_02.webp"
    },
    {
      "text": "Spoon stuffing along the center of a 3-quart shallow baking dish. Arrange chicken around stuffing and sprinkle with paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tRLr_iCADJMsChYDDkW_oEwDcIM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/151656-Chicken--Stuffing-Bake-DDMFS-4x3-step-4-11589-32ada586b36040d6814ee084495e1006.jpg"
      ],
      "image": "assets/images/151656/step_03.webp"
    },
    {
      "text": "Mix together condensed soup, milk, and parsley in a small bowl; pour over chicken. Cover the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bOW7hobXSC-r9jO3Yqtm4Uz9g2E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/151656-Chicken--Stuffing-Bake-DDMFS-4x3-step-6-11592-9e9e5ae0bf274205afbf41ea06c53903.jpg"
      ],
      "image": "assets/images/151656/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink in the center and the juices run clear, about 30 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pvY9IhW5BWuE7yGt68BnW-F8MhI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/151656-Chicken--Stuffing-Bake-DDMFS-4x3-step-7-11600-453a1e558d014f6d8343fec2dee2f2eb.jpg"
      ],
      "image": "assets/images/151656/step_05.webp"
    }
