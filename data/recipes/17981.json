  "ingredients": [
    "2 cups white sugar",
    "1.75 cups all-purpose flour",
    "0.75 cup unsweetened cocoa powder",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons baking soda",
    "1 teaspoon salt",
    "2 eggs",
    "1 cup milk",
    "0.5 cup vegetable oil",
    "2 teaspoons vanilla extract",
    "1 cup boiling water"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9-inch round baking pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KBw6Fau0sFXL17DuwwDaLAJ2tSM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17981-one-bowl-chocolate-cake-iii-DDMFS-step01-bb2561c4afe04ae092cdf6a445b068a0.jpg"
      ],
      "image": "assets/images/17981/step_01.webp"
    },
    {
      "text": "Stir sugar, flour, cocoa, baking powder, baking soda, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bYSRk37Kuo-GeJdadKUELwzALEI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17981-one-bowl-chocolate-cake-iii-DDMFS-step02-f722553a29e34900ba74658c8614d55c.jpg"
      ],
      "image": "assets/images/17981/step_02.webp"
    },
    {
      "text": "Add eggs, milk, oil and vanilla; mix for 2 minutes on medium speed with an electric mixer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uPMx06BMO7CPy8TlZZw324Dq4JY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17981-one-bowl-chocolate-cake-iii-DDMFS-step03-701068ba9a8f4d93b3180cfd254085ba.jpg"
      ],
      "image": "assets/images/17981/step_03.webp"
    },
    {
      "text": "Stir in the boiling water. The batter will be thin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MWtUswWwqZiMyk8iaNtKXviwazg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17981-one-bowl-chocolate-cake-iii-DDMFS-step04-e9f62313b38746838366025354f1370c.jpg"
      ],
      "image": "assets/images/17981/step_04.webp"
    },
    {
      "text": "Pour evenly into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y9u-Ia0kQptdnWauVoUzB06_QZ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17981-one-bowl-chocolate-cake-iii-DDMFS-step05-e56db9200e944a969f273c8cf47c819b.jpg"
      ],
      "image": "assets/images/17981/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 to 35 minutes. Cool in the pans for 10 minutes, then transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FZyGvSEGDmIqEAP_rDK5e0Ryi2g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17981-one-bowl-chocolate-cake-iii-DDMFS-step06-7324ebfe46eb41218663f513ded5c70a.jpg"
      ],
      "image": "assets/images/17981/step_06.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zb8muWE6CQ5XjclY_LQ2i-QwxN0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17981-one-bowl-chocolate-cake-iii-DDMFS-beauty-4x3-d2e182087e4b42a3a281a0a355ea60d1.jpg"
      ],
      "image": "assets/images/17981/step_07.webp"
    }
