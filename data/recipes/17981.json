  "title": "One Bowl Chocolate Cake",
  "description": "This homemade chocolate cake recipe is easy to make in one bowl; top with your favorite chocolate frosting for a fudgy, moist chocolate layer cake.",
  "authors": [
    "shirleyo"
  ],
  "date_published": "1999-02-25T17:02:44-05:00",
