  "ingredients": [
    "1 cup all-purpose flour",
    "1 tablespoon white sugar",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup buttermilk",
    "1 large egg",
    "1 tablespoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions. Preheat oven to 275 degrees F (135 degrees C). Set a wire rack on a baking sheet and place in the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking soda, and salt together in a bowl. Whisk buttermilk, egg, and oil together in a large bowl. Stir flour mixture into buttermilk mixture just until batter is combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into preheated waffle iron, leaving about 1/2-inch border; close iron and cook according to manufacturer's instructions, 3 to 5 minutes. Transfer cooked waffles to the rack in the oven. Continue cooking waffles with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
