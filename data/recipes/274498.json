  "ingredients": [
    "1 (4 ounce) can diced green chiles",
    "0.5 cup canola oil",
    "0.25 cup chopped fresh cilantro",
    "2 limes, zested and juiced",
    "2 cloves garlic, finely chopped",
    "0.5 jalapeno pepper, ribs and seeds removed, finely minced",
    "1 tablespoon honey",
    "1 teaspoon kosher salt",
    "0.5 teaspoon ground black pepper",
    "1 pound skinless, boneless chicken breasts"
  ],
  "steps": [
    {
      "text": "Combine chiles, canola oil, cilantro, lime zest and juice, garlic, jalapeno, honey, salt, and pepper in a 1-gallon freezer bag and seal completely. Gently massage the bag to combine ingredients well. Add chicken and turn to completely coat with marinade. Place in the refrigerator and allow to marinate for at least 4 hours for best flavor, turning bag occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from the marinade and shake off excess. Discard the remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill chicken, covered, on the preheated grill until chicken is no longer pink and juices run clear, 4 to 6 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from the grill and let rest under aluminum foil to redistribute juices back into the meat, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
