  "ingredients": [
    "0.75 cup butter, softened",
    "0.75 cup white sugar",
    "3 eggs",
    "2.5 teaspoons vanilla extract",
    "1.75 cups all-purpose flour",
    "1.5 teaspoons baking powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease and line a round cake pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar together in a bowl using an electric mixer until light and fluffy. Beat in eggs one at a time, beating well after each addition. Stir vanilla extract into creamed butter mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour and baking powder into creamed butter mixture and stir until batter is well mixed. Spoon batter into the prepared cake pan, smoothing the top with the back of a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the center of the preheated oven until a toothpick inserted in the center comes out clean, about 1 hour 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool cake in the cake pan for 10 to 15 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
