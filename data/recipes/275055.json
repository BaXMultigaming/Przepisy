  "ingredients": [
    "0.33333334326744 cup water",
    "2 tablespoons soy sauce",
    "2 tablespoons brown sugar",
    "1 teaspoon honey",
    "1 teaspoon grated fresh garlic",
    "1 teaspoon grated fresh ginger",
    "1 pound jumbo shrimp",
    "0.5 fresh pineapple, cored and cut into 1 1/2-inch pieces",
    "skewers",
    "2 tablespoons minced fresh cilantro",
    "1 tablespoon toasted sesame seeds"
  ],
  "steps": [
    {
      "text": "Combine water, soy sauce, brown sugar, honey, garlic, and ginger in a small saucepan and bring to a boil over medium-high heat. Reduce heat to medium-low and simmer until sauce has reduced and thickened slightly, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil grate. Thread shrimp and pineapple alternately onto skewers and place on a platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange skewers on the hot grate. Grill 2 to 3 minutes per side, or until shrimp is opaque and cooked through. Turn grill to low heat and brush sauce on both sides of skewers. Transfer to a serving platter and sprinkle with cilantro and sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
