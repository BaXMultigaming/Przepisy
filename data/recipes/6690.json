  "ingredients": [
    "1.75 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.66666668653488 cup white sugar",
    "0.33333334326744 cup butter, softened",
    "2 eggs",
    "1 cup mashed banana",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Grease an 8x4 inch loaf pan. Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, sift together flour, baking powder, baking soda, salt, and sugar. Add butter, eggs, nuts, and mashed banana. Beat until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into prepared pan and bake about 1 hour, or until a toothpick inserted in the center of the loaf comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
