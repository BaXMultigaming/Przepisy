  "ingredients": [
    "1 pound lean ground beef",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 tablespoon avocado oil",
    "0.5 cup minced onion",
    "1 teaspoon minced garlic",
    "1.5 cups marinara sauce",
    "0.5 cup ricotta cheese, drained",
    "0.5 cup shredded Parmesan cheese",
    "1.5 cups shredded mozzarella cheese",
    "1 large egg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add ground beef to a skillet and season with salt and pepper. Cook and stir beef over medium-high heat until browned and crumbled, about 10 minutes. Remove to a strainer and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour oil into the same skillet and heat over medium heat. Add onion and cook until soft and translucent, 4 to 5 minutes. Add garlic and cook until fragrant, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return beef to the skillet. Pour in marinara sauce, mix to combine, and turn off heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ricotta cheese, Parmesan cheese, 1/2 cup mozzarella cheese, and egg together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place meat mixture in an 8x8-inch oven-safe casserole dish. Spread cheese mixture over meat and sprinkle with remaining 1 cup mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until casserole is golden brown and cheese is melted, 20 to 25 minutes. Let rest 10 minutes before serving",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
