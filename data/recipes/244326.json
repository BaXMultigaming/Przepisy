  "ingredients": [
    "1.5 cups farro",
    "4 cups chicken broth",
    "1 teaspoon olive oil",
    "1 teaspoon sea salt, or to taste",
    "0.25 cup extra-virgin olive oil",
    "3 tablespoons fresh lemon juice",
    "1 tablespoon Greek seasoning",
    "1 clove garlic, minced",
    "1 cup seeded, diced tomato",
    "1 cup seeded, diced cucumber",
    "1 cup chopped red bell pepper",
    "0.75 cup thinly sliced red onion",
    "1 cup crumbled feta cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Rinse farro with water; drain. Place farro in a pot; pour in chicken broth to cover farro by at least one inch, adding water if needed. Stir in 1 teaspoon olive oil and sea salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring liquid to a boil; reduce heat to medium and simmer, uncovered, stirring frequently, until tender, about 35 minutes for whole grain farro or about 20 minutes for pearled farro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain farro, rinse with cold water, and set aside to cool completely, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk 1/4 cup extra-virgin olive oil, lemon juice, Greek seasoning, and garlic together in a large bowl. Stir in tomato, cucumber, red pepper, red onion, and feta cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cooled farro into tomato mixture until completely coated with dressing; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
