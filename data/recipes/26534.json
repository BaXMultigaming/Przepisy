  "ingredients": [
    "3 eggs",
    "0.25 cup Worcestershire sauce",
    "1 tablespoon white sugar",
    "0.25 cup white vinegar",
    "1 pinch ground cloves",
    "1 quart mayonnaise",
    "0.75 cup sweet pickle relish",
    "0.5 cup chopped black olives",
    "0.5 cup diced red bell pepper"
  ],
  "steps": [
    {
      "text": "Place eggs in a saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes. Remove from hot water, cool, peel, and chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, whisk together chopped eggs, Worcestershire sauce, sugar, vinegar, cloves, mayonnaise, relish, olives, and red pepper until evenly combined. Chill and serve spooned over fresh greens. Store in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
