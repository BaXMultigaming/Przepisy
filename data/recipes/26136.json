  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.75 teaspoon salt",
    "1 cup white sugar",
    "1 cup brown sugar",
    "1.5 cups rolled oats",
    "0.5 cup flaked coconut",
    "0.75 cup vegetable oil",
    "2 eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, baking soda, salt, white sugar, brown sugar, oats, and coconut in a large bowl. Make a well in the center and pour in oil, eggs, and vanilla. Mix well using your hands or a wooden spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into walnut-sized balls and place 2 inches apart onto the prepared cookie sheets. Flatten slightly with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until very light brown and chewy, 10 to 12 minutes. Let cool briefly on the baking sheets before removing to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
