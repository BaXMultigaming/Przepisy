  "ingredients": [
    "nonstick spray",
    "6 potatoes, sliced",
    "0.25 cup diced onion",
    "2 tablespoons cold margarine",
    "0.25 cup grated Parmesan cheese",
    "0.75 cup shredded mozzarella cheese",
    "0.75 cup shredded Cheddar cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Build a campfire and allow the fire to burn until it has accumulated a bed of coals. Rake the coals into a flat bed on one side of the fire.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut 2 lengths of heavy-duty aluminum foil approximately 18 inches square, placing one on top of the other for strength. Spray the top one with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread potatoes on the prepared foil leaving plenty of room to fold up later. Scatter onion over potatoes, then slice margarine over potatoes. Layer Parmesan, mozzarella, and Cheddar cheeses over potatoes. Season with salt and pepper. Bring opposite edges of the foil together and seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the packet directly onto the campfire and cook until potatoes are soft, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
