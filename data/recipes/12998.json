  "ingredients": [
    "2 quarts water",
    "20 small meatballs",
    "2 (8 ounce) cans tomato sauce",
    "2 cubes beef bouillon cube",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried basil",
    "0.25 teaspoon dried thyme",
    "salt to taste",
    "ground black pepper to taste",
    "2 stalks celery, sliced",
    "2 carrots, sliced",
    "1 clove garlic, minced",
    "1 cup elbow macaroni"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a large saucepan. Add meatballs, tomato sauce, bouillon, oregano, basil, thyme, salt and pepper to taste, celery, carrots, and garlic, and simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add macaroni and cook until pasta is done. Top with parmesan cheese to serve.",
