  "ingredients": [
    "cooking spray",
    "0.33333334326744 cup barbeque sauce (such as Sweet Baby Ray's® Hickory & Brown Sugar)",
    "1.5 tablespoons Asian-flavored barbeque seasoning (such as Savory Spice® Asian Delight BBQ Rub)",
    "1 tablespoon caramel sauce",
    "1 pound chicken tenders"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Spray an 8x8-inch casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rJZZGAp4t3SLFSWPGFGo27Qs3uE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272660-baked-bbq-chicken-tenders-ddmfs-step1-0137-a7454e02676f46a283acc64aa8b18a6e.jpg"
      ],
      "image": "assets/images/272660/step_01.webp"
    },
    {
      "text": "Stir together barbeque sauce, barbeque seasoning, and caramel sauce in a shallow dish until combined. Reserve 2 tablespoons mixture for basting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/paRk_FHlrTUtGVg8uXMP2eJ8OoM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272660-baked-bbq-chicken-tenders-ddmfs-step2-0141-b239df68b7574793a9ba54d68ea7e038.jpg"
      ],
      "image": "assets/images/272660/step_02.webp"
    },
    {
      "text": "Dip each chicken tender into barbeque sauce mixture; coat thoroughly. Place in the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/u-48dH6kCYndq9GPA81X8M5PEwE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272660-baked-bbq-chicken-tenders-ddmfs-step3-0144-d5965ba7a2ea4a63853dc9f743456739.jpg"
      ],
      "image": "assets/images/272660/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink in the center and the juices run clear, about 25 minutes. Baste with reserved sauce and bake 5 minutes more. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7htxiLCOGiemnJlRKhXmlJ_N6T8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272660-baked-bbq-chicken-tenders-ddmfs-step4-0153-ca060be921c2417995e9201442221d0a.jpg"
      ],
      "image": "assets/images/272660/step_04.webp"
    }
