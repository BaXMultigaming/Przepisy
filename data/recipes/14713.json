  "ingredients": [
    "0.25 cup olive oil",
    "0.25 cup soy sauce",
    "1 medium lemon, juiced",
    "3 cloves garlic, crushed",
    "1 teaspoon dried oregano",
    "3 pounds pork tenderloin, cut into 1 inch cubes",
    "2 medium yellow onions, cut into 1 inch pieces",
    "2 medium green bell peppers, cut into 1 inch pieces",
    "skewers"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/egbNyR8pc95ZMufs_iyHANrKxXE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14713-souvlaki-ddmfs-Step-01-bd1fac27c10347738d1453387f1cf17f.jpg"
      ],
      "image": "assets/images/14713/step_01.webp"
    },
    {
      "text": "Mix oil, soy sauce, lemon juice, garlic, and oregano together in a large glass bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QkwENw4NDpKYZm4uNQBUn59DHvE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14713-souvlaki-ddmfs-Step-02-f17e3f6e5d9143f890c73dd646b1a807.jpg"
      ],
      "image": "assets/images/14713/step_02.webp"
    },
    {
      "text": "Add pork, onions, and bell peppers, and stir until coated. Cover and refrigerate for 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UId7zpEsKoN8Re0JBC1yvFGEDNo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14713-souvlaki-ddmfs-Step-03-48725f883c05490cbe908a8e6151c338.jpg"
      ],
      "image": "assets/images/14713/step_03.webp"
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pork and vegetables from marinade and shake off excess; thread onto skewers. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b9Wrz1ZoYfpAjHF2u5f13Qa39rw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14713-souvlaki-ddmfs-Step-04-f00d797a369142c2a416d6b606a64626.jpg"
      ],
      "image": "assets/images/14713/step_05.webp"
    },
    {
      "text": "Cook on the preheated grill, turning frequently, until pork is no longer pink in the middle, 10 to 15 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
