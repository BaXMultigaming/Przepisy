  "ingredients": [
    "3 cups fresh or frozen raspberries",
    "0.33333334326744 cup white sugar",
    "1 tablespoon lemon juice",
    "1 tablespoon water",
    "0.125 teaspoon balsamic vinegar",
    "2 cups white sugar",
    "2 cups water",
    "2 tablespoons lemon juice",
    "1 vanilla bean, split lengthwise",
    "3 peaches, halved and pitted",
    "6 scoops vanilla ice cream",
    "0.25 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SehhPjoWESzkR9oHo3IuVn5IjnQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228645-chef-johns-peach-melba-VAT-005-step-01-aed27770c4224000a5c5c2a5c0f8fe39.jpg"
      ],
      "image": "assets/images/228645/step_01.webp"
    },
    {
      "text": "Combine raspberries, 1/3 cup sugar, 1 tablespoon lemon juice, water, and balsamic vinegar in a saucepan over medium heat. Bring to a simmer and cook until sugar dissolves and berries collapse, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YeYnA8xvm3NNejg0jSLsNDjOyGY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228645-chef-johns-peach-melba-VAT-006-step-02-95d1ee5c4d2d43b2b9721521dcd7a574.jpg"
      ],
      "image": "assets/images/228645/step_02.webp"
    },
    {
      "text": "Remove from heat and strain into a bowl. Cool to room temperature, cover and refrigerate until thoroughly chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n0DkS3TqfphQM2JrttSTA1iB2lw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228645-chef-johns-peach-melba-VAT-007-step-03-dec18add063548a09baf4e8358cd31d9.jpg"
      ],
      "image": "assets/images/228645/step_03.webp"
    },
    {
      "text": "Combine 2 cups sugar, 2 cups water, 2 tablespoons lemon juice, and split vanilla bean in a large saucepan and bring to a simmer over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0rnT7pB-rLRSdSoMDSeFZAJ_RX4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228645-chef-johns-peach-melba-VAT-008-step-04-260e44a646e3406ba144539fb6941157.jpg"
      ],
      "image": "assets/images/228645/step_04.webp"
    },
    {
      "text": "Place peach halves with cut sides up in the syrup and simmer until tender, 5 to 8 minutes per side, basting with the syrup occasionally. Remove from heat and allow to cool in the syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gPfFt8rH1iXUEbmS77z8GPxa_Ns=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228645-chef-johns-peach-melba-VAT-009-step-05-d5af36b61a4841868883bc575d2c8c53.jpg"
      ],
      "image": "assets/images/228645/step_05.webp"
    },
    {
      "text": "Transfer to a bowl, cover, and refrigerate until thoroughly chilled, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NG4kZ3NyznPXNzgFwqN-jNvKSlU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228645-chef-johns-peach-melba-VAT-010-step-06-766408265d6a4684a6b0d0bb53bf8c88.jpg"
      ],
      "image": "assets/images/228645/step_06.webp"
    },
    {
      "text": "Remove peach skins and serve each peach half on top of a scoop of ice cream in a bowl. Spoon the raspberry sauce over the top. Garnish with toasted, slivered almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/74sWl2IUqIUIu9_BdMiugbNbo98=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228645-chef-johns-peach-melba-VAT-003-beauty-4x3-4b79af441fc840e0bc94e6fdbca95bbc.jpg"
      ],
      "image": "assets/images/228645/step_07.webp"
    }
  ],
