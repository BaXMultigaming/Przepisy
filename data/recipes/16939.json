  "ingredients": [
    "4 heads fresh broccoli, chopped",
    "1.5 cups shredded American cheese",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1.5 teaspoons salt",
    "2 teaspoons ground black pepper",
    "3 tablespoons butter",
    "2 cups crushed, seasoned croutons"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a pot of lightly salted water to a boil. Cook broccoli in the boiling water for 1 minute. Drain, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan over medium heat, mix cheese, cream of mushroom soup, salt, and pepper. Stir until cheese is melted. Add broccoli, stirring to coat. Transfer the mixture to a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate saucepan, melt butter over medium heat. Mix in the croutons, and sprinkle over the broccoli mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 30 minutes in the preheated oven, until the topping is browned and the broccoli is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
