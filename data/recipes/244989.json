  "ingredients": [
    "1 cup brown sugar",
    "0.66666668653488 cup butter, softened",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.5 cup all-purpose flour",
    "1 cup pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 24 mini muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, butter, eggs, and vanilla extract together in a bowl using an electric mixer until smooth and creamy. Mix flour and pecans together in a bowl; stir into creamy mixture until batter is smooth. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
