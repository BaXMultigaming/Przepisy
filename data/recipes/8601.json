  "title": "Herbed Chicken Nuggets",
  "description": "These homemade chicken nuggets are baked, not fried, and get their nutty flavor from wheat germ.",
  "authors": [
    "Amy"
  ],
  "date_published": "1999-05-10T11:14:48-04:00",
