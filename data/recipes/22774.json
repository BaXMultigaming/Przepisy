  "ingredients": [
    "1.25 cups brown sugar",
    "1.6666667461395 cups white sugar",
    "1 cup butter",
    "1 cup corn syrup",
    "1.25 cups heavy cream",
    "0.75 cup whole milk",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine brown sugar, white sugar, butter, corn syrup, cream, milk and vanilla in a medium saucepan over medium heat. Heat, stirring occasionally, to 250 to 265 degrees F (121 to 129 degrees C), or until a small amount of syrup dropped into cold water forms a rigid ball. Pour into an 8x8 inch pan. Let cool before cutting.",
