  "ingredients": [
    "3 cups oil for frying",
    "1.5 cups ice-cold water",
    "1 (8 ounce) package tempura batter mix",
    "3 medium ripe bananas, cut into 5 pieces",
    "1 tablespoon confectioners' sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cold water into a large bowl; sprinkle tempura batter mix on top. Whisk until mix is moistened and large lumps dissolve; batter should still be slightly lumpy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip 5 banana slices into batter. Fry in hot oil until lightly golden, 2 to 3 minutes. Drain on paper towels. Repeat to dip and fry remaining banana slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dust with confectioners' sugar to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
