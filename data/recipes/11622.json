  "title": "Pumpkin Raisin Cookies",
  "description": "This quick pumpkin raisin cookie recipe uses up leftover pumpkin, along with raisins, walnuts, and warming spices, making it perfect for the fall season.",
  "authors": [
    "Dawn Brown"
  ],
  "date_published": "1999-10-26T12:37:41-04:00",
