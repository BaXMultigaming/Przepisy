  "ingredients": [
    "1 tablespoon olive oil",
    "1 large onion, chopped",
    "3 cloves garlic, minced",
    "1 teaspoon dried oregano",
    "2 teaspoons dried basil",
    "0.5 pound beef neck bones",
    "1 (29 ounce) can tomato sauce",
    "1 (14.5 ounce) can stewed tomatoes",
    "2 (6 ounce) cans tomato paste",
    "3 cups water",
    "1 pound lean ground beef"
  ],
  "steps": [
    {
      "text": "In a large pot saute onion, garlic, oregano and basil in 1 tablespoon of olive oil. Add the neck bones and let simmer with the lid on until the onions are transparent. Note: if using ground beef cook with onion mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once onions are clear, add the tomato sauce, tomatoes, tomato paste and water. If using meat in your recipe add at this time. Cover and simmer for several hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Before serving, remove neck bones and discard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
