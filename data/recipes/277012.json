        "https://www.allrecipes.com/thmb/3Z8BUOI_lgIeaC3kjd7b5HGc9vA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277012-zucchini-and-ground-beef-skillet-DDMFS-step-05-6862d18b9ac24947b784a566985d57ab.jpg"
