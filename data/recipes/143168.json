  "ingredients": [
    "2 cups fresh blueberries, raspberries, strawberries and sliced bananas, mixed",
    "2 cups plain or vanilla yogurt",
    "0.25 cup white sugar",
    "8 small paper cups",
    "8 popsicle sticks"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z-Pe2HrJG7zIrZiLatdqsbIcgoU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143168-fresh-fruit-and-yogurt-ice-pops-VAT-001-step-01-8833afd50d8c4855a3e65c9847b5874e.jpg"
      ],
      "image": "assets/images/143168/step_01.webp"
    },
    {
      "text": "Place the mixed blueberries, raspberries, strawberries, sliced bananas, yogurt, and sugar into a blender. Cover, and blend until fruit is chunky or smooth, as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Xgk3EEVq74pv1WJ7h81sV0HQpYM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143168-fresh-fruit-and-yogurt-ice-pops-VAT-002-step-02-23c6922c9b9c45debdce5ce464250bac.jpg"
      ],
      "image": "assets/images/143168/step_02.webp"
    },
    {
      "text": "Fill paper cups or popsicle molds 3/4 full with fruit mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LkC8S-aD8-_Bo5I1Ca6AITL3oV4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143168-fresh-fruit-and-yogurt-ice-pops-VAT-004-step-03-f50aefa9e99b409a874f46a45bdd9a3d.jpg"
      ],
      "image": "assets/images/143168/step_03.webp"
    },
    {
      "text": "Cover the top of each cup or mold with a strip of aluminum foil. Poke a popsicle stick through the center of the foil on each cup or mold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gZmk7cGpLk_54fWhcsO6sKUUMjA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143168-fresh-fruit-and-yogurt-ice-pops-VAT-006-step-04-be6ec69a4f074c7caf709b31eb502c3d.jpg"
      ],
      "image": "assets/images/143168/step_04.webp"
    },
    {
      "text": "Place the cups or molds in the freezer for at least 5 hours. To serve, remove foil and paper cup or mold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2-DaQFtD1fu4s6x05J_WD20ccBA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143168-fresh-fruit-and-yogurt-ice-pops-VAT-007-step-05-ea724e7228a34463982fbd56a3ce74ac.jpg"
