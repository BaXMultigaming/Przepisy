  "ingredients": [
    "2 bananas",
    "0.75 cup freshly ground peanut butter",
    "2 teaspoons honey",
    "0.75 cup oat flour",
    "0.5 cup coconut flour",
    "0.25 cup pea protein powder"
  ],
  "steps": [
    {
      "text": "Puree bananas, peanut butter, and honey in a food processor until smooth. Place mixture in a bowl and add oat flour, coconut flour, and pea powder. Stir until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press into a 10-inch square pan and refrigerate until hardened, about 30 minutes.",
