  "ingredients": [
    "1 sheet (18x24-inches) Reynolds Wrap® Heavy Duty Aluminum Foil",
    "4 medium sweet potatoes, peeled and cut into 1/4-inch slices",
    "2 Granny Smith or Golden Delicious apples, cored, thinly sliced into rings",
    "0.5 cup dried cranberries or raisins",
    "0.5 cup packed brown sugar",
    "3 tablespoons butter or margarine, melted",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F or grill to medium-high.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Center sweet potatoes, apples and cranberries on sheet of Reynolds Wrap® Heavy Duty Aluminum Foil. Sprinkle with brown sugar. Combine butter and cinnamon; drizzle over brown sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring up foil sides. Double fold top and ends to seal making one large foil packet, leaving room for heat circulation inside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 25 to 30 minutes on a cookie sheet or in a 13x9x2-inch dish OR GRILL 20 to 25 minutes in covered grill until sweet potatoes are tender.",
      "section": null,
      "name": null,
      "url": null,
