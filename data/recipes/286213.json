  "ingredients": [
    "3.25 cups all-purpose flour",
    "0.33333334326744 cup white sugar",
    "0.33333334326744 cup packed brown sugar (light or dark)",
    "2.5 teaspoons baking powder",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.75 cup cold unsalted butter, cut in small pieces",
    "1 cup buttermilk",
    "1.5 teaspoons vanilla extract",
    "0.75 cup cinnamon chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease or line cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, white sugar, brown sugar, baking powder, cinnamon, baking soda, salt, and nutmeg together in a large bowl; cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs. Add buttermilk and vanilla, mixing just until dough is moistened; fold in cinnamon chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop 1/4 cups of dough 2 inches apart onto a cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 15 to 17 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
