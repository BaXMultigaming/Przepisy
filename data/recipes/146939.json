  "ingredients": [
    "1 (10 ounce) box couscous",
    "1.5 cups boiling water",
    "2 tablespoons olive oil",
    "0.5 onion, diced",
    "2 cloves garlic, minced",
    "3 Roma (plum) tomatoes, diced",
    "0.5 cup shredded Cheddar-Monterey Jack cheese blend"
  ],
  "steps": [
    {
      "text": "Stir together couscous and boiling water in a large, heatproof bowl. Cover with plastic wrap, and set aside for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat olive oil in a skillet over medium heat. Stir in onions and garlic, and cook until the onion has softened and turned translucent, about 5 minutes. Add the diced Roma tomatoes, and cook until the tomatoes release their juice and the mixture begins to thicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fluff the couscous with a fork, then fold in the tomato mixture and cheese. Serve immediately as the cheese is melting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
