  "ingredients": [
    "1 watermelon, cut into bite-size pieces",
    "2 tablespoons lemon juice",
    "2 teaspoons ginger juice",
    "0.5 teaspoon black salt",
    "1 pinch white sugar, or to taste",
    "1 pinch ground black pepper",
    "3 cups cold water",
    "1 cup ice cubes",
    "1 tablespoon mint leaves, or more to taste"
  ],
  "steps": [
    {
      "text": "Place watermelon, lemon juice, ginger juice, salt, sugar, and black pepper in a blender; blend until smooth. Pour mixture through a fine-mesh strainer; discard pulp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour juice back into the blender. Add cold water and ice; blend. Pour lemonade into glasses; stir gently. Garnish with mint leaves.",
      "section": null,
