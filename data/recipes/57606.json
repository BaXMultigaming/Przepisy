  "ingredients": [
    "1.5 cups old-fashioned oatmeal",
    "1.5 cups whole wheat flour",
    "2 teaspoons baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1.5 cups buttermilk",
    "1 cup milk",
    "0.25 cup vegetable oil",
    "1 egg",
    "0.33333334326744 cup sugar",
    "3 tablespoons chopped walnuts"
  ],
  "steps": [
    {
      "text": "Grind the oats in a blender or food processor until fine. In a large bowl, combine ground oats, whole wheat flour, baking soda, baking powder, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, combine buttermilk, milk, oil, egg, and sugar with an electric mixer until smooth. Mix milk mixture into oat mixture with a few swift strokes. Stir in nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil a large skillet or griddle and preheat it over medium heat. Ladle 1/3 cup batter onto the hot skillet; cook pancakes until brown, 2 to 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
