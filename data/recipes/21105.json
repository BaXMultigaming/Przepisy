  "title": "Butter Pecan Ice Cream",
  "description": "This butter pecan ice cream is made with a custard base mixed with brown sugar and toasted nuts, churned, and frozen for a delicious summer treat.",
  "authors": [
    "SUSAN LONG"
  ],
  "date_published": "2000-09-08T13:04:56-04:00",
