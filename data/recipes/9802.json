  "ingredients": [
    "2.6666667461395 cups peanut butter",
    "1 cup butter, softened",
    "2.3333332538605 cups packed brown sugar",
    "2 cups white sugar",
    "6 large eggs",
    "1.5 teaspoons vanilla extract",
    "9 cups rolled oats",
    "4 teaspoons baking soda",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together peanut butter and butter in a large bowl with an electric mixer until light and fluffy. Mix in sugars until well combined. Add eggs one at a time, beating well after each addition. Beat in vanilla extract. Mix oats and baking soda in a separate bowl, then stir into peanut butter mixture. Stir in chocolate chips. Drop by heaping teaspoons onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned and edges are set, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
