  "ingredients": [
    "2 tablespoons soy sauce",
    "2 tablespoons sake",
    "2 tablespoons mirin",
    "1 tablespoon grated fresh ginger root",
    "1 pound thinly sliced pork loin",
    "3 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
