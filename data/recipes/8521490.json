  "ingredients": [
    "2 pounds chicken drummies",
    "1.5 tablespoons olive oil",
    "1 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "0.13 teaspoon freshly ground black pepper",
    "0.75 cup barbecue sauce"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 360 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place drummies in a large bowl. Add olive oil, garlic powder, salt, and pepper. Mix until evenly combined. Spread out drummies in the basket of the air fryer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook drummies for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using tongs, remove drummies from the air fryer and place in a large bowl. Pour barbecue over the top and shake to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place coated drummies back in the basket of the air fryer. Cook until drummies are no longer pink at the bone and the juices run clear, about 5 more minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C). Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
