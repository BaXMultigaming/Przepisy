  "ingredients": [
    "1.5 cups finely chopped fresh spinach",
    "2 tablespoons basil pesto, or to taste",
    "4 skinless, boneless chicken breast halves",
    "2 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix spinach and pesto together in a bowl. Spread 1/2 of the mixture into the bottom of a glass baking dish and place chicken on top. Spread remaining spinach mixture over chicken. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Uncover and sprinkle Parmesan cheese over chicken. Return to the oven and bake until chicken is no longer pink in the center and the juices run clear, about 15 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
