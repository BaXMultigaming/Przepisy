      "image_sources": [
        "https://www.allrecipes.com/thmb/iwUscX-9xOylE20GeCxFtcuLJjA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/267874-easy-keto-alfredo-sauce-ddmfs-1992-4x3-step-01-9ac82513a5ca486da6460810f5f18178.jpg"
      ],
      "image": "assets/images/267874/step_02.webp"
    },
    {
      "text": "Stir in heavy cream and cream cheese. Gradually add Parmesan cheese, stirring constantly until well incorporated and melted, about 5 to 7 minutes.",
