      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Gm-yY8dfgqTuT5-KwytrwOUmaTI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/267874-easy-keto-alfredo-sauce-ddmfs-1998-4x3-step-03-507d6c2b33444a80802d7e8ead44e7df.jpg"
      ],
      "image": "assets/images/267874/step_03.webp"
    },
    {
      "text": "Stir in salt, nutmeg, and white pepper. The sauce will thicken as it cools.",
