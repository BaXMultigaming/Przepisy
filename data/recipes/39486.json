  "ingredients": [
    "1 tablespoon butter",
    "4 mushrooms, sliced",
    "1 clove garlic, minced",
    "2 tablespoons whole black peppercorns",
    "0.25 cup Merlot wine",
    "1 tablespoon balsamic vinegar",
    "3 tablespoons Worcestershire sauce",
    "0.5 teaspoon minced fresh rosemary"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium heat. Stir in mushrooms, garlic, and peppercorns, and sauté until mushrooms are tender. Pour in wine, balsamic, and Worcestershire sauce, increase the heat to medium-high and reduce by 1/3. Stir in rosemary and cook for 1 to 2 minutes, until fragrant.",
