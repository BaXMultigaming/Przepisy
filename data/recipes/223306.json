  "ingredients": [
    "8 jalapeno peppers, halved lengthwise and seeded",
    "1 (8 ounce) package cream cheese, softened",
    "0.25 cup grated Parmesan cheese",
    "0.25 cup shredded Cheddar cheese",
    "0.25 cup crumbled feta cheese",
    "2 cloves garlic, minced",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon chili powder",
    "0.25 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add jalapeño peppers, cover, and steam until slightly tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese with Parmesan, Cheddar, and feta cheeses, garlic, salt, black pepper, cayenne pepper, chili powder, and garlic powder in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange jalapeño peppers on the prepared baking sheet. Spoon cheese mixture into each pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and bubbling, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
