  "ingredients": [
    "6 cups water",
    "2.5 cups white sugar",
    "2 (3 ounce) packages strawberry flavored Jell-O® mix",
    "1 (46 fluid ounce) can pineapple juice",
    "0.66666668653488 cup lemon juice",
    "1 quart orange juice",
    "2 (2 liter) bottles lemon-lime flavored carbonated beverage"
  ],
  "steps": [
    {
      "text": "Bring water, sugar, and strawberry-flavored gelatin to a boil in a large saucepan; boil for 3 minutes. Stir in pineapple juice, lemon juice, and orange juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide mixture between 2 freezer-safe containers. Cover and freeze until solid, at least 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine contents of 1 container frozen juice mixture with 1 bottle lemon-lime flavored carbonated beverage in a punch bowl; stir until slushy. Repeat with remaining portions as needed.",
