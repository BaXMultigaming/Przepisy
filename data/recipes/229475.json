  "ingredients": [
    "Pastry for a single-crust 9-inch pie",
    "1 (16 ounce) can pumpkin",
    "1 (12 ounce) can evaporated fat-free milk",
    "3 eggs",
    "0.33333334326744 cup Truvia® natural sweetener spoonable",
    "1.5 teaspoons Truvia® natural sweetener spoonable**",
    "1 teaspoon vanilla",
    "1.5 teaspoons pumpkin pie spice",
    "0.25 teaspoon Diamond Crystal® kosher salt",
    "1 tablespoon Light whipped topping"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out pastry on floured surface 1 inch larger than inverted 9-inch pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ease pastry into pan; flute and trim edge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pumpkin, evaporated milk, and eggs on medium speed until well blended; add additional ingredients; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into prepared pastry shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 to 40 minutes or until knife inserted into center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool on wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
