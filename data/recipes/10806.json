  "ingredients": [
    "1 egg",
    "1 cup white sugar",
    "0.5 cup shortening",
    "1 teaspoon baking soda",
    "2 teaspoons cream of tartar",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "2 cups all-purpose flour",
    "0.33333298563957 cup granulated sugar for decoration",
    "0.75 cup sweetened condensed milk"
  ],
  "steps": [
    {
      "text": "Mix all ingredients, except flour. Add enough flour to make a rollable dough, about 2 cups.",
      "section": null,
