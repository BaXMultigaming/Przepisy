  "ingredients": [
    "2 large eggs",
    "1 cup white sugar",
    "1 cup milk",
    "1 cup buttermilk",
    "12 tablespoons unsalted butter, melted",
    "2 cups all-purpose flour",
    "2 cups cornmeal",
    "4 teaspoons baking powder",
    "2 teaspoons fine salt",
    "1 teaspoon baking soda",
    "4 cups fresh blueberries"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Generously butter a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ijIg_PbPBVaLCrDRQ66LbU0TTtA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8453372-chef-johns-blueberry-cornbread-VAT-4x3-ingredients-208377e53b0f4e3293f9e58f1dc2bd0e.jpg"
      ],
      "image": "assets/images/8453372/step_01.webp"
    },
    {
      "text": "Whisk eggs and white sugar together in a bowl vigorously for 1 minute; add milk, buttermilk, and melted butter and mix together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/onf4pIqUDSGegThkhf0-60FBnRA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8453372-chef-johns-blueberry-cornbread-VAT-4x3-step-02-2-3a53f8566d7248c4a1ddcd6b0f53aa44.jpg"
      ],
      "image": "assets/images/8453372/step_02.webp"
    },
    {
      "text": "Mix flour, cornmeal, baking powder, salt, and baking soda together in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Vf0B7gE6xQ_88SeiNUqJ6_5TvvM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8453372-chef-johns-blueberry-cornbread-VAT-4x3-step-03-2-3da2484e279848859f9835904c108b13.jpg"
      ],
      "image": "assets/images/8453372/step_03.webp"
    },
    {
      "text": "Stir into the wet ingredients. Fold in blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4CB1mT1ylRFoaG9jfqecOZRnWFU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8453372-chef-johns-blueberry-cornbread-VAT-4x3-step-04-6c2f2586758546b8ae4b86e915a1931f.jpg"
      ],
      "image": "assets/images/8453372/step_04.webp"
    },
    {
      "text": "Transfer batter to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yfJKhQSsH4P9bCzPSm5WIJ5L64o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8453372-chef-johns-blueberry-cornbread-VAT-4x3-step-05-e07857cc300a4dfd83b7772f8f774027.jpg"
      ],
      "image": "assets/images/8453372/step_05.webp"
    },
    {
      "text": "Bake in the center of the preheated oven until a skewer inserted into the center comes out clean, 50 to 60 minutes. Let cool before cutting and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pe10UHsSIWs41LzaCGJvRfkUVP0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8453372-chef-johns-blueberry-cornbread-VAT-4x3-step-06-9c51313f58284290b6c341fbdcc63e39.jpg"
      ],
      "image": "assets/images/8453372/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/49t6yzlw_DTQFzSUK_niqZ-Pa5o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8453372-chef-johns-blueberry-cornbread-VAT-4x3-1-aa0d926a19604346b45da22952045862.jpg"
      ],
      "image": "assets/images/8453372/step_07.webp"
    }
