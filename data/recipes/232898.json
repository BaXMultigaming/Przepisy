  "ingredients": [
    "1 serving Crisco® Original No-Stick Cooking Spray",
    "1.25 cups graham cracker crumbs",
    "0.25 cup sugar",
    "0.25 cup butter, melted",
    "3 (8 ounce) packages reduced fat cream cheese, softened",
    "0.33333334326744 cup unsweetened cocoa powder",
    "3 tablespoons Pillsbury BEST® All Purpose Flour",
    "3 large egg whites",
    "1 (14 ounce) can EAGLE BRAND® Low Fat Sweetened Condensed Milk",
    "1 large egg",
    "0.25 cup semi-sweet chocolate chips, melted",
    "1.5 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Heat oven to 300 degrees F. Spray bottom of 9-inch springform pan with no-stick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham cracker crumbs, sugar and butter; sprinkle evenly into bottom of pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese until fluffy in large bowl. Mix in cocoa and flour. Add remaining ingredients; mix well. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 40 to 50 minutes or until center is set. Cool. Chill. Garnish as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
