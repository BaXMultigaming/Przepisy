  "ingredients": [
    "4 cups water",
    "3 carrots, sliced",
    "1 large onion, sliced",
    "4 stalks celery, sliced",
    "1 tablespoon dried parsley",
    "2 teaspoons salt",
    "1 teaspoon garlic salt",
    "0.5 teaspoon freshly ground black pepper",
    "0.5 teaspoon dried thyme",
    "4 skinless, boneless chicken breasts",
    "3.5 cups egg noodles"
  ],
  "steps": [
    {
      "text": "Combine water, carrots, onion, celery, parsley, salt, garlic salt, pepper, and thyme in a slow cooker; mix well. Place chicken on top and push down slightly into the liquid. Cover and cook on Low for 8 hours or High for 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken and shred meat or cut into bite-sized pieces. Return to the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add noodles and cook on High until noodles are tender, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
