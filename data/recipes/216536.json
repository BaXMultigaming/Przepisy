  "ingredients": [
    "1 pre-baked pizza crust",
    "2 cloves garlic, minced",
    "1 tablespoon Dijon mustard",
    "2 sprigs fresh rosemary, chopped",
    "0.25 cup white wine vinegar",
    "0.5 cup olive oil",
    "0.25 cup crumbled blue cheese",
    "salt and pepper to taste",
    "0.33333334326744 cup shredded mozzarella cheese",
    "2 pears - peeled, cored and sliced",
    "0.25 cup toasted walnut pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pizza crust on a pizza pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until just crisp, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine garlic, Dijon mustard, rosemary, and vinegar in a food processor or blender. With the blender on, drizzle in olive oil slowly until dressing is thickened. Quickly pulse in 1/4 cup blue cheese; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread vinaigrette over pizza crust. Sprinkle remaining 1/4 cup blue cheese evenly over crust, followed by mozzarella cheese. Arrange sliced pears over cheese and sprinkle with walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and bubbly, 7 to 10 minutes. Let cool slightly before cutting into slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
