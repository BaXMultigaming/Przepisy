  "ingredients": [
    "1.5 pounds bacon, chopped",
    "2 teaspoons butter",
    "4 large yellow onions, diced",
    "1 teaspoon salt",
    "0.25 cup brown sugar",
    "0.25 cup sherry vinegar",
    "1.5 teaspoons fresh thyme leaves, divided",
    "1 teaspoon freshly ground black pepper",
    "1 pinch cayenne pepper",
    "0.5 cup water",
    "2 teaspoons balsamic vinegar",
    "2 teaspoons extra-virgin olive oil"
  ],
  "steps": [
    {
      "text": "Place a large, heavy-bottomed pot over medium heat. Add bacon; cook and stir until crispy and rendered fat starts to foam, about 10 minutes. Pour crisped bacon and rendered fat into a strainer placed over a bowl. When fat is drained and bacon is cool enough to handle, remove bacon to a cutting board and finely chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lhSaYv7QVva4WFM1fVUmnMZCTEI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236501-ChefJohnsBaconJam-ddmfs-Step1-0984-de2f7b7797514d76a27c5caa4d1a7dfd.jpg"
      ],
      "image": "assets/images/236501/step_01.webp"
    },
    {
      "text": "Return the pot to medium heat; drizzle 2 teaspoons reserved bacon fat and butter into the pot. Add onions and salt; cook until until soft and translucent, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ky-EJVSGdpA__hPqeP4i0Jemr0A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236501-ChefJohnsBaconJam-ddmfs-Step3-0993-66cbab201f0247c28e79c517127e5bea.jpg"
      ],
      "image": "assets/images/236501/step_02.webp"
    },
    {
      "text": "Stir brown sugar, sherry vinegar, 1 teaspoon thyme leaves, black pepper, and cayenne into onion mixture; add bacon. Stir water into bacon mixture and cook until jam has a brick-brown color and thick consistency, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ECV7ycczQ7sUXmRp3P-BOit4Ugk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236501-ChefJohnsBaconJam-ddmfs-Step4-0994-aded3cee27a04514a9c38212fba7cb55.jpg"
      ],
      "image": "assets/images/236501/step_03.webp"
    },
    {
      "text": "Remove from heat and add balsamic vinegar, olive oil, and remaining 1/2 teaspoon thyme; stir until shiny and heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oz9gkWZf6UdUfUliJw3MaN_hV30=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236501-ChefJohnsBaconJam-ddmfs-Step5-0997-d1547395d75b40ccaea08310c0e72c55.jpg"
      ],
      "image": "assets/images/236501/step_04.webp"
    },
    {
      "text": "Store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MVUIGweVhXwWbrhgGMr5f8kv798=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236501-chef-johns-bacon-jam-MommyFromSeattle-4x3-eb68c5e4e9904fc49e5fd69d02f5c1e3.jpg"
