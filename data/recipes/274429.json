  "ingredients": [
    "1 cup chicken broth",
    "0.5 cup teriyaki sauce",
    "4 tablespoons brown sugar",
    "3 cloves garlic, minced",
    "1 pound chicken, diced"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk chicken broth, teriyaki sauce, brown sugar, and garlic together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken and toss until well coated. Transfer mixture to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until chicken is no longer pink in the center and the juices run clear, 4 to 6 hours. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
