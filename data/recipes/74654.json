  "ingredients": [
    "4 ounces small uncooked seashell pasta",
    "3 tablespoons butter",
    "2.5 tablespoons extra virgin olive oil",
    "1 (8 ounce) can artichoke hearts, drained and quartered",
    "2 cloves garlic",
    "1 sprig fresh basil, chopped"
  ],
  "steps": [
    {
      "text": "Bring a pot of salted water to a boil. Add pasta and cook, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the pasta is cooking, heat butter and oil in a skillet over medium heat until butter melts. Add artichoke hearts, garlic, and basil; cook and stir until heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta. Add to the skillet and toss with artichoke mixture.",
      "section": null,
