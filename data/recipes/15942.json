  "ingredients": [
    "4.5 cups white sugar",
    "1 cup cornstarch",
    "2 teaspoons ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "10 cups water",
    "2 teaspoons salt",
    "3 tablespoons lemon juice",
    "2 drops yellow food coloring",
    "6 pounds apples"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TgVV2jWGZQGAT3Izk0jd3-fvfe4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15942-canned-apple-pie-filling-DDMFS-step-1-c189c2a575c34d37b6dc97cfb8eb42c8.jpg"
      ],
      "image": "assets/images/15942/step_01.webp"
    },
    {
      "text": "Mix sugar, cooking starch, cinnamon, and nutmeg in a large pan. Add water and salt and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5man70T7v8kbbjQXVhX_MWJJcKM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15942-canned-apple-pie-filling-DDMFS-step-2-50495e2f3eed4b23bfad64b744bc5d01.jpg"
      ],
      "image": "assets/images/15942/step_02.webp"
    },
    {
      "text": "Bring to a boil and cook until thick and bubbly. Remove from heat and add lemon juice and food coloring.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/golU5EbO_wchsWaWA4i_U4l9xFg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15942-canned-apple-pie-filling-DDMFS-step-3-ca40fb58ccbf4f348076d85a0cf78c1d.jpg"
      ],
      "image": "assets/images/15942/step_03.webp"
    },
    {
      "text": "Sterilize canning jars, lids, and rings by boiling them in a large pot of water. Peel, core, and slice apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I18xcQgocMWsHlAlqRE894jLjMo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15942-canned-apple-pie-filling-DDMFS-step-4-4571fe1bb05d4057922ccdc50eed4b30.jpg"
      ],
      "image": "assets/images/15942/step_04.webp"
    },
    {
      "text": "Pack the sliced apples into hot canning jars, leaving a 1/2 inch of headspace.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cTPon78Z2_0rfcnoazFbl_QiNgA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15942-canned-apple-pie-filling-DDMFS-step-5-26bfc8cf4f644837bcf2bd4f0529283a.jpg"
      ],
      "image": "assets/images/15942/step_05.webp"
    },
    {
      "text": "Fill jars with hot syrup, and gently remove air bubbles with a knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CriOTJYdVKYHNjHcxjj7Um0OHKU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15942-canned-apple-pie-filling-DDMFS-step-6-7ce9a6790664454eae5bd4934aa65abe.jpg"
      ],
      "image": "assets/images/15942/step_06.webp"
    },
    {
      "text": "Put lids on and process in a water bath canner for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ElTtlOsZJxQhvPvqs1wuAmRn-6Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15942-canned-apple-pie-filling-DDMFS-step-7-47c469fcd1e34484a5d6d49f2cb08784.jpg"
      ],
      "image": "assets/images/15942/step_07.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
