  "ingredients": [
    "1 cup pecan halves or pieces",
    "1.3333333730698 cups light brown sugar",
    "0.5 cup unsalted butter, at room temperature",
    "0.5 cup shortening",
    "2 eggs, at room temperature",
    "2 teaspoons vanilla extract",
    "1.5 cups gluten-free all-purpose baking flour",
    "1 (.25 ounce) package unflavored gelatin",
    "2 teaspoons unflavored gelatin",
    "1 teaspoon baking powder",
    "1 teaspoon kosher salt",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground ginger",
    "3 cups gluten-free oats",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast pecans in the preheated oven until fragrant, about 5 minutes. Let cool for 5 minutes. Chop coarsely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, butter, and shortening in a stand mixer fitted with the paddle attachment; beat until light and fluffy. Beat in eggs one at a time. Beat in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift gluten-free flour, 1 packet plus 2 teaspoons gelatin, baking powder, salt, cinnamon, and ginger together in a bowl. Mix into the brown sugar mixture on low speed. Mix pecans, oats, and raisins into the dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap dough in plastic wrap and chill in the refrigerator for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the the preheated oven until edges are golden, about 13 minutes. Cool on the baking sheets for 5 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
