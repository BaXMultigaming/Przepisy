  "ingredients": [
    "2 (15 ounce) cans pink salmon",
    "1 onion, finely diced",
    "1 egg, beaten",
    "8 saltine crackers, crushed",
    "salt and pepper to taste",
    "1 stalk celery",
    "1 cup cornmeal",
    "0.15000000596046 cup canola oil"
