  "ingredients": [
    "1.5 pounds lean ground beef",
    "1 (15 ounce) can pizza sauce",
    "1 (4 ounce) can sliced mushrooms, drained",
    "0.25 cup sliced pitted ripe olives",
    "1 cup shredded mozzarella cheese, or more to taste",
    "1 (10 ounce) can refrigerated biscuit dough"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sauce, mushrooms, and olives into beef in the skillet. Cook and stir until heated through, about 2 minutes. Transfer mixture to a 2-quart rectangular baking dish. Sprinkle with mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flatten each biscuit with your hands and arrange on top of cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until biscuits are golden, 15 to 17 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
