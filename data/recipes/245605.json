  "ingredients": [
    "1 cup butter",
    "2 cups white sugar",
    "6 eggs",
    "0.25 cup coffee liqueur",
    "5 cups all-purpose flour",
    "0.75 cup dark unsweetened cocoa powder",
    "1 tablespoon baking powder"
  ],
  "steps": [
    {
      "text": "Melt butter in a large saucepan over medium heat. Remove from heat. Stir sugar into saucepan until dissolved. Add eggs and coffee liqueur; mix well to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cocoa powder, and baking powder together in a large bowl. Stir into butter mixture until well-mixed and batter is stiff.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat pizzelle baker according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of batter onto the preheated pizzelle baker. Bake until browned, about 45 seconds. Remove from baker and trim any ragged edges with scissors.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
