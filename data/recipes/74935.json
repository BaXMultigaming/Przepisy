  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.75 cup whole wheat flour",
    "0.75 cup oat flour",
    "2.5 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.25 teaspoon ground nutmeg",
    "1 cup plain yogurt",
    "1 cup white sugar",
    "0.75 cup honey",
    "3 eggs",
    "0.5 cup vegetable oil",
    "0.5 cup unsweetened applesauce",
    "2 teaspoons vanilla extract",
    "1 cup shredded zucchini",
    "1 cup shredded carrots",
    "0.5 cup chopped pecans",
    "0.5 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease two 12-cup muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift all-purpose flour, whole wheat flour, oat flour, cinnamon, salt, baking powder, baking soda, and nutmeg together in a bowl. Beat yogurt, sugar, honey, eggs, vegetable oil, applesauce, and vanilla extract together in a separate bowl; stir in flour mixture then fold in zucchini, carrots, pecans, and raisins. Scoop batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 18 to 20 minutes. Cool 10 minutes before transferring to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
