  "ingredients": [
    "1 tablespoon olive oil",
    "1 small onion, diced",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon dried thyme",
    "2 tablespoons all-purpose flour",
    "1.5 pounds baby spinach, roughly chopped",
    "1 cup half-and-half",
    "1.5 cups shredded Swiss cheese, divided",
    "0.75 cup dry bread crumbs",
    "3 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat and cook onion until soft and translucent, about 5 minutes. Season with salt, pepper, and thyme. Sprinkle flour over onion mixture and cook until a thick paste forms, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place spinach in a large soup pot and cover. Heat on low until spinach begins to wilt, about 4 minutes. Turn heat off and add half-and-half, 1 cup Swiss cheese, and onion mixture. Stir to combine and transfer to a 9-inch gratin dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs and remaining 1/2 cup cheese in a bowl. Pour melted butter over the top and stir to combine. Evenly spread bread crumb mixture over spinach.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven uncovered for 20 minutes. Let cool for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
