  "ingredients": [
    "2 pink or ruby-red grapefruits",
    "2 navel oranges",
    "4 tangerines",
    "0.5 cup pomegranate arils",
    "0.5 cup sour cream",
    "0.25 cup frozen lemonade concentrate, undiluted",
    "fresh mint sprigs for garnish (optional)"
  ],
  "steps": [
    {
      "text": "Peel grapefruits, oranges, and tangerines with a serrated edge knife, being careful to remove the white pith.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice all citrus fruit crossways and remove any seeds. Evenly distribute slices amongst 4 salad plates. Sprinkle pomegranate arils evenly over each salad.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together sour cream and undiluted lemonade concentrate in a small bowl for the dressing until smooth. Drizzle dressing over each salad. Garnish with mint sprigs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
