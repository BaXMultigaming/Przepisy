  "ingredients": [
    "2 teaspoons sesame oil",
    "1 pound lean ground beef",
    "3 cloves garlic, minced",
    "0.25 cup soy sauce",
    "1 tablespoon coconut sugar",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground black pepper",
    "2 cups cauliflower rice",
    "2 tablespoons chopped green onions",
    "1 tablespoon sesame seeds"
  ],
  "steps": [
    {
      "text": "Heat sesame oil in a large skillet over medium-high heat. Cook and stir ground beef and garlic in the hot skillet until browned and crumbly, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soy sauce, coconut sugar, ginger, and pepper in a bowl; whisk until well combined. Pour over ground beef; simmer until sauce thickens, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve over cauliflower rice. Sprinkle with green onions and sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
