  "ingredients": [
    "0.25 cup white wine",
    "1 teaspoon olive oil",
    "1 teaspoon salt",
    "0.5 teaspoon Italian seasoning",
    "0.5 teaspoon liquid smoke flavoring",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon dried thyme",
    "2 lemon wedges",
    "4 artichokes, halved and choke scraped out",
    "olive oil-flavored cooking spray",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Fill a stockpot half full with water; stir in white wine, olive oil, salt, Italian seasoning, liquid smoke, basil, and thyme. Squeeze lemon wedges into mixture; drop wedges into the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring mixture to a boil over medium heat; add artichoke halves. Boil until tender, 20 to 30 minutes. Transfer artichokes, upside down, to a paper towel; drain and cool to the touch. Refrigerate until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil grate. Lightly coat cooled artichoke halves with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook artichoke halves on the preheated grill until edges are slightly charred. Drizzle with melted butter; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
