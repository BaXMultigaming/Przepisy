  "ingredients": [
    "0.75 cup butter, softened",
    "1 cup packed light brown sugar",
    "1.5 cups rolled oats",
    "1.5 cups all-purpose flour",
    "1 teaspoon salt",
    "0.5 teaspoon baking powder",
    "1 (10 ounce) jar raspberry preserves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter and brown sugar until smooth. Combine the oats, flour, salt and baking powder; stir into the creamed mixture. Press half of the mixture into the bottom of the prepared pan. Spread the preserves over the crust. Crumble the remaining crust mixture over the raspberry layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 to 25 minutes in the preheated oven, or until light brown. Cool completely before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
