  "ingredients": [
    "1 tablespoon olive oil",
    "2 (16 ounce) packages sliced fresh mushrooms",
    "2 garlic cloves, pressed",
    "salt and freshly ground black pepper to taste",
    "1 splash dry white wine",
    "2 tablespoons chopped fresh dill",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large skillet over medium heat. Cook and stir mushrooms in hot oil until soft and juices have reduced, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir garlic into mushrooms, season with salt and pepper, and cook for 2 minutes. Add white wine and cook for 1 minute. Stir in dill and parsley.",
