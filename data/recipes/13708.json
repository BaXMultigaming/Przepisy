  "ingredients": [
    "3 eggs, beaten",
    "0.5 cup butter",
    "1 cup white sugar",
    "1 (20 ounce) can crushed pineapple with juice",
    "0.5 cup milk",
    "4 cups soft bread cubes",
    "0.25 teaspoon vanilla extract"
  ],
  "steps": [
    {
