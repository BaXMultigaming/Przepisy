  "ingredients": [
    "0.5 cup white sugar",
    "0.25 cup butter",
    "1 cup all-purpose flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.5 cup milk",
    "2 cups fresh peaches, pitted and sliced",
    "0.25 cup white sugar",
    "0.25 teaspoon ground cinnamon",
    "1.5 cups water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly butter a 9x9-inch glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream 1/2 cup sugar and butter until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, mix together flour, baking powder, and salt. Add to creamed mixture alternately with milk. Spread mixture evenly into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon sliced peaches over batter. Sprinkle with 1/4 cup sugar and cinnamon. Pour water over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until liquid sinks to the bottom and batter puffs and turns golden brown, 45 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
