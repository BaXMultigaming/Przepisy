  "ingredients": [
    "3 tablespoons butter",
    "3 tablespoons all-purpose flour",
    "1 cup evaporated milk",
    "1 cup water",
    "1 teaspoon salt",
    "1 dash white pepper",
    "3 dashes cayenne pepper",
    "6 hard-cooked eggs, sliced",
    "3 slices extra sharp Cheddar cheese, halved",
    "6 slices white bread, toasted and cut into triangles"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Stir in flour until smooth. Gradually whisk in evaporated milk and water. Season with salt, white pepper and cayenne pepper. Cook, stirring frequently, until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange sliced eggs in a medium baking dish. Pour sauce over eggs. Place cheese slices on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 15 to 20 minutes. Place toast on plates, and spoon egg mixture over.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
