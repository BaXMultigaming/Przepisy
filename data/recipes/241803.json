  "keywords": [],
  "ingredients": [
    "10 ounces firm tofu, cut into 6 slices",
    "0.25 cup water",
    "2 tablespoons soy sauce",
    "1 tablespoon balsamic vinegar",
    "1 tablespoon brown sugar",
    "2 teaspoons minced fresh ginger root",
    "1 clove garlic, minced",
    "0.5 teaspoon cornstarch",
    "1 teaspoon sesame oil",
    "1 tablespoon sesame seeds",
    "1 green onion, minced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange tofu slices into a square baking dish in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water, soy sauce, balsamic vinegar, brown sugar, ginger, garlic, and cornstarch together in a small saucepan; bring to a boil while stirring continually. Pour sesame oil into the boiling mixture while stirring to incorporate fully; remove from heat and pour over the tofu.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Marinate tofu for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a small skillet over medium heat. Cook sesame seeds in skillet until fragrant, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake tofu in preheated oven until it looks glazed, about 25 minutes. Garnish with sesame seeds and green onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
