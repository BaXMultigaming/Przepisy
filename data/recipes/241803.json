  "title": "Sesame Seed Baked Tofu",
  "description": "This baked tofu recipe has the tofu marinate in a soy sauce mixture in which is is also baked. Garnish with sesame seeds.",
  "authors": [
    "Burgz"
  ],
  "date_published": "2020-03-05T00:13:09-05:00",
