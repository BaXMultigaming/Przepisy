  "title": "Jamie's Minestrone Soup",
  "description": "This minestrone soup recipe is packed with hearty vegetables, beans, pasta, and herbs in a flavorful tomato broth for the best minestrone soup ever!",
  "authors": [
    "Jamie"
  ],
  "date_published": "1999-01-27T01:50:31-05:00",
