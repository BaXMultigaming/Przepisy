  "ingredients": [
    "0.75 cup shortening",
    "1.5 cups white sugar",
    "2.75 cups cake flour",
    "0.5 teaspoon salt",
    "4 egg whites",
    "1 teaspoon vanilla extract",
    "1 tablespoon buttermilk",
    "1 teaspoon baking powder",
    "1.5 cups buttermilk",
    "0.5 teaspoon baking soda",
    "1 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease and flour 1- 13 x9 inch square cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream shortening and sugar together and add 1 tablespoon buttermilk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour three times and add baking powder and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 1/2 cups buttermilk with 1/2 teaspoon baking soda. Alternate adding buttermilk to shortening mixture with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites until stiff and fold into batter. Stir in the vanilla and almond extracts. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 30 to 40 minutes. Once cool frost with frosting of your choice. If you want you can add orange extract to the frosting, about 1 teaspoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
