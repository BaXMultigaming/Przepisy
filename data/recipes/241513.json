  "ingredients": [
    "3 pounds corned beef brisket",
    "0.25 cup brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 270 degrees F (132 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse corned beef in running water to remove about 1/2 of the salt, then trim away any fat. Place corned beef into a baking dish and spread brown sugar in a 1/4-inch layer over the top. Cover the baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an internal temperature of 145 degrees F (65 degrees C) is reached, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and discard any liquid. Slice the beef as thinly as you can.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
