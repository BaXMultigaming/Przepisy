  "ingredients": [
    "1 egg",
    "2 tablespoons prepared yellow mustard",
    "0.5 teaspoon salt",
    "1.5 cups instant mashed potato flakes",
    "0.25 cup oil for frying",
    "4 (6 ounce) fillets sole"
  ],
  "steps": [
    {
      "text": "In a shallow dish, whisk together the egg, mustard, and salt; set aside. Place the potato flakes in another shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large heavy skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip fish fillets in the egg mixture. Dredge the fillets in the potato flakes, making sure to completely coat the fish. For extra crispy, dip into egg and potato flakes again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry fish fillets in oil for 3 to 4 minutes on each side, or until golden brown.",
      "section": null,
