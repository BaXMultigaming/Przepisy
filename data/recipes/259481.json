    "publisher-tested"
  ],
  "ingredients": [
    "2 cups all-purpose flour, plus more for kneading",
    "5 teaspoons olive oil",
    "0.5 teaspoon fine salt",
    "0.75 cup warm water (110 degrees F (43 degrees C))",
    "2 teaspoons white wine vinegar",
    "0.5 cup cornstarch",
    "2 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4EujPq7yhvZIAhJdRmyEbVYoFxY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-259481-homemade-phyllo-Dough-DDMFS-4x3-step-Ingredients-2fb15bc8a3a246c19376b2a9fe03731a.jpg"
      ],
      "image": "assets/images/259481/step_01.webp"
    },
    {
      "text": "Place 2 cups flour in a mixing bowl and make a well in the center; drizzle in olive oil and add salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YBwcPIUQ_KENUMrCho6xRsVhwPY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-259481-homemade-phyllo-Dough-DDMFS-4x3-step-01-d8c4086162bb468982fe86aab5076cb5.jpg"
      ],
      "image": "assets/images/259481/step_02.webp"
    },
    {
      "text": "Pour in warm water and white wine vinegar, then mix until dough just comes together and pulls away from the sides of the bowl, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dl_ilVNFzsPkSxyvKjuyGsyLaaI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-259481-homemade-phyllo-Dough-DDMFS-4x3-step-02-99a790c48aec413c9332deadd4ca8a86.jpg"
      ],
      "image": "assets/images/259481/step_03.webp"
    },
    {
      "text": "Transfer dough to a lightly floured work surface and knead until smooth, using just enough flour to keep it from sticking to the work surface or your hands, 2 or 3 minutes. Continue to knead until dough is supple and elastic, about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iJVZqochnSBgcaiVc4rjV0aXz6k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-259481-homemade-phyllo-Dough-DDMFS-4x3-step-03-4cada1ac825c4298abfbc6ccbe48d75b.jpg"
      ],
      "image": "assets/images/259481/step_04.webp"
    },
    {
      "text": "Wrap dough ball in plastic wrap and let rest at room temperature, 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D8LLVdsY7ySySkyGjsH3EHhi0Ao=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-259481-homemade-phyllo-Dough-DDMFS-4x3-step-04-1fe476713080452aab945215996038b1.jpg"
      ],
      "image": "assets/images/259481/step_05.webp"
    },
    {
      "text": "Use a kitchen scale to divide dough into twenty 25-gram portions; roll each portion into a ball. Place on a plate and cover with plastic wrap to prevent dough balls from drying out while you begin to roll them out. Work in batches of 5.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7HtITOfiM8NVzvixBmataHVLaSs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-259481-homemade-phyllo-Dough-DDMFS-4x3-step-05-17f718c40bbf489ba0331c5ec3c80041.jpg"
      ],
      "image": "assets/images/259481/step_06.webp"
    },
    {
      "text": "Mix cornstarch and 2 tablespoons flour together in a bowl. Dust a work surface and the first dough ball with cornstarch mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0SItQBTceNpPfi-zcvb0jEZY7XM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-259481-homemade-phyllo-Dough-DDMFS-4x3-step-06-7ba0bf30015640cd8f37a02824c3d3f1.jpg"
      ],
      "image": "assets/images/259481/step_07.webp"
    },
    {
      "text": "Flatten and roll out into a circle, about 5 inches in diameter. Dust again with cornstarch mixture. Set circle to one side. Roll out 4 more dough balls to about the same diameter and stack them on the first one, dusting each layer with more cornstarch mixture to keep them from sticking together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ITwDUNvlBGnVRXCoIJ8PKW4yPzU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-259481-homemade-phyllo-Dough-DDMFS-4x3-step-07-a594c25374cb4f6e8e93bfc99369d7cf.jpg"
      ],
      "image": "assets/images/259481/step_08.webp"
    },
    {
      "text": "When you have 5 circles, roll out the stack to a larger circle about double in size, turning as you go to maintain a round shape. Separate each layer and lay out the circles. Reapply more cornstarch mixture where needed and restack them.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jBcQLIBgf4aU1JoHWjlbDJLWQu0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-259481-homemade-phyllo-Dough-DDMFS-4x3-step-08-8a4c5f3f08d4469dbbcca87ce96de3f3.jpg"
      ],
      "image": "assets/images/259481/step_09.webp"
    },
    {
      "text": "Roll again until the 5-layer stack is paper-thin, about 10 to 12 inches in diameter. Place on a sheet of parchment paper; top with another piece of parchment. Gently roll up the dough; wrap it in plastic wrap and refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BdjetIJhTykHKjKNF1MV-UHNcs8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-259481-homemade-phyllo-Dough-DDMFS-4x3-step-09-d05c5e956abf43b5a0f90a572ce70c2a.jpg"
      ],
      "image": "assets/images/259481/step_10.webp"
    },
    {
      "text": "Repeat with the remaining 15 balls of dough in batches of 5.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X1m8yzEwx5a2lc3WV_ZYWD6s_iQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-259481-homemade-phyllo-Dough-DDMFS-4x3-Beauty-171dc6fc9914413c8c7a0ee3db32423a.jpg"
      ],
      "image": "assets/images/259481/step_11.webp"
    }
  ],
