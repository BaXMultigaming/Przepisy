  "title": "Coconut Cream Cake III",
  "description": "A super moist coconut cake made with cake mix and sour cream. Almond glaze compliments the rich coconut flavor.",
  "authors": [
    "Jennifer Pauley Buckner"
  ],
  "date_published": "2000-10-27T16:50:18-04:00",
