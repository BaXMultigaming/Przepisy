  "ingredients": [
    "3 tablespoons vegetable oil",
    "6 pounds ground beef",
    "1.5 cups chopped onion",
    "3 cloves garlic, minced",
    "1 pinch salt and ground black pepper to taste",
    "3 (26.5 ounce) cans Sloppy Joe sauce (such as Manwich®)",
    "5 ribs celery, chopped",
    "1 large green bell pepper, chopped",
    "5 tablespoons brown sugar",
    "2 tablespoons cider vinegar",
    "0.125 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Heat 1 tablespoon oil in a large skillet over medium-high heat. Add 1/3 of the beef, 1/2 cup onion, and 1 clove garlic. Season with salt and pepper. Cook until browned and crumbly, 5 to 7 minutes. Transfer to a slow cooker. Repeat twice more with remaining oil, beef, onion, garlic, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add Sloppy Joe sauce, celery, green pepper, brown sugar, cider vinegar, and cloves to the slow cooker. Cook on Low for at least 4 hours, adjusting seasoning to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
