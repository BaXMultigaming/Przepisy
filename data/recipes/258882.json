  "ingredients": [
    "1 cup sliced almonds",
    "0.25 cup mayonnaise",
    "1 cup roasted red peppers, drained and patted dry",
    "1 ounce finely grated Parmesan cheese",
    "1 tablespoon balsamic vinegar",
    "1 clove garlic, peeled",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat a skillet over medium heat; cook and stir almonds until toasted and fragrant, 2 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine toasted almonds and mayonnaise in a food processor; process until finely chopped. Add roasted red peppers, Parmesan cheese, balsamic vinegar, garlic, salt, and pepper; process until desired consistency is reached, scraping down the sides as needed.",
