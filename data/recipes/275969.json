  "ingredients": [
    "8 cups apple cider",
    "6 tablespoons caramel ice cream topping, divided",
    "1 tablespoon turbinado sugar",
    "1 teaspoon kosher salt",
    "0.125 teaspoon apple pie spice",
    "1.5 cups spiced rum",
    "8 cinnamon sticks"
  ],
  "steps": [
    {
      "text": "Combine apple cider and ¼ cup caramel ice cream topping in a 4-quart slow cooker until smooth; cover the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 3 to 4 hours or on High for 1 hour and 30 minutes to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, salt, and apple pie spice in a small shallow bowl. Add remaining 2 tablespoons caramel ice cream topping to a small saucer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Moisten rims of 8 mugs or heatproof glasses in caramel topping, then dip into spice mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle hot cider into the prepared mugs; add 3 tablespoons spiced rum to each mug and garnish each with a cinnamon stick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
