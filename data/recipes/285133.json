  "ingredients": [
    "2 medium bananas, sliced",
    "2 cups Greek yogurt",
    "1 cup frozen blueberries",
    "1 cup quartered fresh strawberries",
    "1 scoop vanilla protein powder",
    "0.25 cup almond milk, or to taste",
    "12 (3-ounce) cups",
    "aluminum foil",
    "12 wooden craft sticks"
  ],
  "steps": [
    {
      "text": "Blend bananas, yogurt, blueberries, strawberries, protein powder, and enough almond milk to achieve your preferred consistency in the bowl of an electric blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour liquid into cups until they are 75% full. Cut 12 squares of foil and fold them securely onto the tops of the cups. Slide the wooden sticks through the center of the foil squares. Place cups on a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Freeze for 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the freezer, remove foil, peel away cups, and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
