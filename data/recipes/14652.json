  "ingredients": [
    "1.5 pounds lean ground beef",
    "1 cup tomato juice",
    "0.75 cup rolled oats",
    "1 egg",
    "0.25 cup chopped onion",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine meat, tomato juice, oats, egg, chopped onion, salt, and pepper. Mix lightly but thoroughly. Press into an 8x4 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour, or until meat is no longer pink and juices run clear. Drain. Let stand 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
