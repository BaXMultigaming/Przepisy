  "ingredients": [
    "2 large egg whites, at room temperature",
    "1 pinch salt",
    "1 cup white sugar",
    "1.5 cups pecan halves",
    "1.5 cups whole almonds",
    "4 teaspoons ground cinnamon",
    "0.33333334326744 cup unsalted butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites with salt in a bowl until frothy; add sugar gradually, beating to stiff peaks. Gently fold in pecans, almonds, and cinnamon. Pour mixture onto a 15 1/2 x 10 1/2-inch jelly roll pan, drizzle melted butter over top, and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, tossing every 10 minutes, until nuts are crisp, about 40 minutes. Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
