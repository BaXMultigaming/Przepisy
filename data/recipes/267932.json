  "ingredients": [
    "2 cups sliced almonds",
    "1 cup chopped pecans",
    "1 cup chopped walnuts",
    "1 cup sunflower seeds",
    "0.125 cup sesame seeds",
    "0.5 cup honey",
    "2 tablespoons grass-fed butter",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon kosher salt",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground allspice",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almonds, pecans, walnuts, sunflower seeds, and sesame seeds in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat honey and butter in a saucepan over low heat until butter is melted. Add vanilla extract, cinnamon, salt, cloves, and allspice. Stir together and remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour honey mixture over the nut and seed mixture; mix well. Spread evenly over the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring every 15 minutes, until golden brown, about 40 minutes. Let cool until granola crumbles easily. Add raisins after granola has cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
