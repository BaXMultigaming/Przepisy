  "ingredients": [
    "2.5 cups farfalle (bow-tie) pasta",
    "1 pound ground turkey",
    "0.75 cup ketchup, or to taste",
    "0.25 cup brown sugar",
    "2 teaspoons Italian seasoning blend",
    "1 pinch garlic salt",
    "0.75 cup shredded mozzarella cheese",
    "0.75 cup shredded Cheddar cheese",
    "1 teaspoon poppy seeds"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook bow-tie pasta at a boil, stirring occasionally, until tender yet firm to the bite, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat a large skillet over medium-high heat. Cook and stir ground turkey in the hot skillet until browned and crumbly, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low and add ketchup, brown sugar, Italian seasoning, and garlic salt. Let simmer for 1 to 2 minutes; remove from heat and cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain cooked pasta and pour into a medium casserole dish. Stir in mozzarella cheese, Cheddar cheese, and poppy seeds. Spread turkey mixture on top and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
