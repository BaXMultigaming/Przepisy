  "ingredients": [
    "cooking spray",
    "6 day-old cider donuts, broken into bite-sized pieces",
    "1 large apple - peeled, cored, and chopped",
    "1.5 cups half-and-half",
    "0.25 cup white sugar",
    "2 large eggs, lightly beaten",
    "1 teaspoon vanilla extract",
    "0.75 teaspoon ground cinnamon",
    "2 tablespoons maple syrup, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix donut pieces and apple together in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk half-and-half, sugar, eggs, vanilla, and cinnamon together in a bowl. Pour mixture into the baking dish and let sit, stirring occasionally, until liquid is absorbed, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool for 15 minutes. Drizzle with maple syrup.",
