  "ingredients": [
    "1 tablespoon vegetable oil",
    "0.5 cup chopped onion",
    "2 carrots, chopped",
    "1 cup quinoa, rinsed",
    "2 cups vegetable broth",
    "0.75 cup chopped walnuts",
    "0.25 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Heat oil in a saucepan over medium-high heat. Cook onion in oil for 5 minutes, or until translucent. Add carrot, and cook 3 minutes more. Stir in quinoa and vegetable broth, and bring to a boil. Reduce to a simmer, cover, and cook 15 to 20 minutes, or until quinoa is tender and fluffy.",
