  "title": "Hot Clam Dip",
  "description": "This baked clam dip is super easy to prepare and even more delicious to eat. Minced clams are mixed with lemon, butter, onion, bell pepper, and more.",
  "authors": [
    "Luann Charity"
  ],
  "date_published": "1999-09-24T20:08:21-04:00",
