  "title": "Creamy Strawberry Crepes",
  "description": "These homemade strawberry crepes, with a sweet and creamy whipped filling and fresh strawberries, are perfect for a special brunch or dessert.",
  "authors": [
    "meliss"
  ],
  "date_published": "2019-07-10T03:00:07-04:00",
