  "ingredients": [
    "Reynolds Wrap® Non-Stick Foil",
    "12 chicken wings",
    "0.5 cup creamy peanut butter",
    "0.33333334326744 cup water",
    "2 tablespoons lime juice",
    "2 tablespoons reduced-sodium soy sauce",
    "1 tablespoon honey",
    "1 teaspoon toasted sesame oil",
    "0.5 teaspoon ground ginger",
    "1 small clove garlic",
    "1 tablespoon fresh cilantro leaves, packed",
    "1 tablespoon sesame seeds, toasted"
  ],
  "steps": [
    {
      "text": "Preheat broiler. Line a 15x10x1-inch baking pan with Reynolds Wrap® Non-Stick Foil*. Set pan aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut off and discard tips of chicken wings. Cut wings at joints to form 24 pieces. Put wing pieces into a large bowl set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the peanut butter, water, lime juice, soy sauce, honey, sesame oil, ginger, and garlic in a food processor or a blender. Cover and process or blend until smooth. Remove 1/3 cup of the sauce add it to the chicken wings and stir to coat evenly. Add the cilantro to the remaining sauce in the food processor or blender and process or blend until combined. Set aside. Arrange chicken pieces in a single layer in prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil wings 4 to 5 inches from the heat for 10 minutes. Turn wings. Broil about 10 minutes more or until tender and brown. Drain off fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place wings on a platter to serve, sprinkle with sesame seeds, and serve with the reserved peanut sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
