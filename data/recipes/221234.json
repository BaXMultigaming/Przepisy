  "ingredients": [
    "3 cups peeled and cubed potatoes",
    "1 cup chicken stock",
    "0.5 cup chopped celery",
    "0.5 cup chopped onion",
    "1 teaspoon dried parsley",
    "0.5 teaspoon salt",
    "1 pinch ground black pepper",
    "1.5 cups milk",
    "2 teaspoons all-purpose flour",
    "1 cup chopped ham",
    "0.5 (8 ounce) package cream cheese"
  ],
  "steps": [
    {
      "text": "Place potatoes, chicken stock, celery, onion, and parsley in a slow cooker; season with salt and black pepper. Cover slow cooker. Cook on High until vegetables are tender, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and flour together in a bowl until smooth; stir into slow cooker until thickened. Cook on High for 2 hours more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash potatoes in slow cooker to desired thickness and consistency; stir in ham and cream cheese. Simmer soup until cream cheese has melted, soup is thick and creamy, and ham is heated through, 30 to 60 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
