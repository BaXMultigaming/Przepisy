  "ingredients": [
    "1 tablespoon olive oil",
    "0.5 onion, sliced into rings",
    "1 zucchini, cut into 1/4-inch slices",
    "1 yellow squash, cut into 1/4-inch slices",
    "1 ear corn, kernels cut from cob",
    "4 roma (plum) tomatoes, peeled and chopped",
    "1 clove garlic, minced",
    "1 teaspoon ground cumin",
    "salt and ground black pepper to taste",
    "0.25 cup chopped fresh cilantro, or more to taste",
    "0.5 lime"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Add onion and cook, stirring until tender, 5 to 10 minutes. Add zucchini and yellow squash. Cook until slightly tender, about 3 minutes. Add corn and cook 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomatoes and garlic. Cook, stirring until heated through, about 3 minutes. Season with cumin, salt, and pepper. Cook to desired doneness, 5 to 10 more minutes. Add cilantro and stir until just wilted. Remove from heat and squeeze lime over mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
