  "ingredients": [
    "10 slices bread, cut into cubes",
    "0.5 cup butter, melted",
    "2 tablespoons grated Parmesan cheese, or to taste",
    "1 teaspoon salt",
    "1 teaspoon paprika",
    "1 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put bread cubes in a large bowl; drizzle with melted butter. Toss to evenly coat. Spread onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until croutons are crisp, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Parmesan, salt, paprika, and garlic powder into a bowl; sprinkle over croutons. Toss to coat.",
