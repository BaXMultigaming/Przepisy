  "ingredients": [
    "0.66666698455811 cup uncooked long-grain white rice",
    "1.3333300352097 cups water",
    "6 tablespoons olive oil",
    "6 tablespoons soy sauce",
    "6 tablespoons honey",
    "3 tablespoons distilled white vinegar",
    "1.5 teaspoons dried thyme",
    "1.5 teaspoons ground paprika",
    "0.5 teaspoon ground cayenne pepper",
    "0.5 teaspoon ground allspice",
    "1 teaspoon ground black pepper",
    "4 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix rice and water in a medium saucepan, and bring to a boil. Cover, reduce heat, and simmer 20 minutes, until rice is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, blend the olive oil, soy sauce, honey, and vinegar. Mix in the thyme, paprika, cayenne pepper, allspice, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken breasts in a medium baking dish, and coat with the olive oil mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in the preheated oven, and, basting occasionally with the olive oil mixture, cook 30 minutes, or until no longer pink and juices run clear. Serve over the rice with remaining olive oil mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
