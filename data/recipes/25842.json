  "ingredients": [
    "1 cup pimento-stuffed green olives, crushed",
    "0.5 cup drained kalamata olives, crushed",
    "0.5 cup pepperoncini, drained",
    "0.25 cup roughly chopped pickled cauliflower florets",
    "0.25 cup marinated cocktail onions",
    "2 cloves garlic, minced",
    "2 tablespoons drained capers",
    "1 tablespoon chopped celery",
    "1 tablespoon chopped carrot",
    "1 teaspoon dried oregano",
    "1 teaspoon dried basil",
    "0.75 teaspoon ground black pepper",
    "0.5 teaspoon celery seed",
    "0.5 cup olive oil",
    "0.25 cup canola oil",
    "0.25 cup red wine vinegar",
    "2 (1 pound) loaves Italian bread",
    "8 ounces thinly sliced Genoa salami",
    "8 ounces thinly sliced cooked ham",
    "8 ounces sliced mortadella",
    "8 ounces sliced mozzarella cheese",
    "8 ounces sliced provolone cheese"
  ],
  "steps": [
    {
      "text": "Roughly chop green olives, Kalamata olives, pepperoncini, cauliflower, cocktail onions, garlic, capers, celery, and carrot; transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oregano, basil, black pepper, and celery seeds into olive mixture. Stir in olive oil, canola oil, and vinegar; transfer olive salad to a glass jar (or other nonreactive container). Pour in more oil to cover if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BzIesh475SY1K5twnlDzsQDC22w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25842-Real-Nawlins-Muffuletta-ddmfs-step-1-063-459b414a87ae4fdd8b063351cd70d624.jpg"
      ],
      "image": "assets/images/25842/step_02.webp"
    },
    {
      "text": "Cover jar or container; refrigerate at least 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KRp83OlUtwiAzMsGDEpv-eIV6kI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25842-Real-Nawlins-Muffuletta-ddmfs-step-2-070-4bdb4af81a914d449d6cd6560c1d367a.jpg"
      ],
      "image": "assets/images/25842/step_03.webp"
    },
    {
      "text": "Cut bread loaves in half horizontally; hollow out some excess bread to make room for filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EpBIUs9j6chWHWM-P1GXht8OfVI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25842-Real-Nawlins-Muffuletta-ddmfs-step-3-073-1ca8778373c247ae8ea10515b75f313c.jpg"
      ],
      "image": "assets/images/25842/step_04.webp"
    },
    {
      "text": "Evenly divide olive salad, including oil, among bread pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/imwHfTQcnhxqc45Elk3CGs2j8bg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25842-Real-Nawlins-Muffuletta-ddmfs-step-4-074-1cfa7c03bdd24d3ea54735c1f4042d5b.jpg"
      ],
      "image": "assets/images/25842/step_05.webp"
    },
    {
      "text": "Divide and layer salami, ham, mortadella, mozzarella, and provolone slices between bottom halves of each bread loaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IPyABGCjzNYliKfJM33sKkJUSoo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25842-Real-Nawlins-Muffuletta-ddmfs-step-5-076-769801fd500b4af6bc6c71bd8ef45701.jpg"
      ],
      "image": "assets/images/25842/step_06.webp"
    },
    {
      "text": "Place top halves each loaf over layered meat and cheese. Cut sandwiches into quarters.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PRxKsUS0zze8u3AIGa3fVyw3C2k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25842-Real-Nawlins-Muffuletta-ddmfs-step-7-148-2fde21a72d31428eabe20a2c40d71ddf.jpg"
      ],
      "image": "assets/images/25842/step_07.webp"
    },
    {
      "text": "Serve immediately, or wrap tightly and refrigerate for a few hours to allow the flavors to meld and the olive juice to soak into the bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z3zhDRLVXeZxtbJb0lI6Tmip1YI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25842-real-nawlins-muffuletta-VAT-003-4x3-c5182d34f5a64b95856abdaa5d88f020.jpg"
      ],
      "image": "assets/images/25842/step_08.webp"
    }
