  "ingredients": [
    "1 (18.25 ounce) package marble cake mix",
    "1 (3 ounce) package strawberry flavored Jell-O®",
    "1 cup boiling water",
    "1 (1.3 ounce) envelope whipped topping mix",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "2 cups milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Prepare and bake marble cake as directed on the box. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Poke holes in cooled cake with a fork. Dissolve strawberry gelatin in 1 cup boiling water. Pour gelatin over cake, then refrigerate for 2 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix whipped topping mix, pudding mix, milk, and vanilla in a mixing bowl with an electric mixer on high speed until frosting is thick enough for spreading, about 3 to 5 minutes. Frost the cake and serve. Store any leftovers in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
