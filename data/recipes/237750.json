  "ingredients": [
    "1 (14 ounce) can coconut milk",
    "3 tablespoons white sugar",
    "1 (8 ounce) can crushed pineapple",
    "1 banana, chopped",
    "1 cup chopped kiwi fruit"
  ],
  "steps": [
    {
      "text": "Place coconut milk and sugar in a blender; blend to combine. Add pineapple and banana; blend until smooth.",
