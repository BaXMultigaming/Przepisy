  "title": "Vanilla Wafer Cake IV",
  "description": "This fantastic tube cake uses a box of vanilla wafers instead of flour. The coconut and pecans make it especially toothsome!",
  "authors": [
    "JOYCEBOLD"
  ],
  "date_published": "2020-06-18T23:05:50-04:00",
