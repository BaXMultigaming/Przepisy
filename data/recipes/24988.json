  "ingredients": [
    "1 (8 ounce) package flaked coconut",
    "1 cup ground pecans",
    "0.75 cup butter",
    "1.5 cups white sugar",
    "6 eggs",
    "1 (12 ounce) package vanilla wafers, crushed very fine",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease and flour a 10 inch fluted tube pan such as a Bundt®. Mix together the coconut and ground pecans; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter and sugar until light and fluffy. Beat in the eggs one at a time. Beat in the crushed wafers alternately with the milk. Mix in the coconut and ground pecans. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 60 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
