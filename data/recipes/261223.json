  "ingredients": [
    "0.5 cup low-sodium soy sauce",
    "0.5 cup white sugar",
    "0.25 cup cider vinegar",
    "1 tablespoon water",
    "1.5 teaspoons garlic powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon ground ginger",
    "1 tablespoon cornstarch"
  ],
  "steps": [
    {
      "text": "Combine soy sauce, sugar, vinegar, water, garlic powder, onion powder, and ground ginger in a saucepan over medium heat.",
