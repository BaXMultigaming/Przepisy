  "ingredients": [
    "1 picked over turkey carcass",
    "1.5 cups leftover stuffing",
    "1 onion, peeled and diced",
    "2 carrots, peeled and sliced",
    "2 celery stalks, chopped",
    "1 tablespoon poultry seasoning",
    "1 teaspoon ground sage",
    "2 bay leaves",
    "2.5 quarts chicken broth",
    "1 cup water, or as needed",
    "0.5 teaspoon garlic salt, or to taste",
    "ground black pepper, to taste",
    "2 cups (uncooked) regular long-grain white rice",
    "1 (16 ounce) package frozen green peas"
  ],
  "steps": [
    {
      "text": "Place carcass in a large pot. Add stuffing, onion, carrots, celery, poultry seasoning, sage, and bay leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NCFFauVGYV0Y2iZoqcEIpeHe9fU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/130979-day-after-thanksgiving-turkey-carcass-soup-step-01-1-fa88f738719445e7ac6840aaf0097f5f.jpg"
      ],
      "image": "assets/images/130979/step_01.webp"
    },
    {
      "text": "Pour in chicken broth; add additional water to cover, if needed. Bring to a boil over medium-high heat. Reduce heat to medium; simmer, skimming off and discarding any foam, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bcONAHXOsn8NSAQcUxzy1ExXP50=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/130979-day-after-thanksgiving-turkey-carcass-soup-step-01-2-bf9d974fb7cd4aa5b57e2c5d7070ca02.jpg"
      ],
      "image": "assets/images/130979/step_02.webp"
    },
    {
      "text": "Remove carcass and any bones; pick off any meat. Return meat to the pot and discard bones and skin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z30NA7cZp2OOX3DqnoeCX8ZvNiU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/130979-day-after-thanksgiving-turkey-carcass-soup-step-03-2-6d19ec5682244f30ba8f3d331923ee88.jpg"
      ],
      "image": "assets/images/130979/step_03.webp"
    },
    {
      "text": "Add garlic salt and pepper. Stir in rice and return to a boil over medium-high heat. Reduce heat to medium and simmer for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pDwA5rliW9WlJZVOhviUTw0_hbw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/130979-day-after-thanksgiving-turkey-carcass-soup-step-04-13101344c4b54112b43b65a7cd1c3d16.jpg"
      ],
      "image": "assets/images/130979/step_04.webp"
    },
    {
      "text": "Stir in peas; continue to simmer until rice is tender, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kAoulXOh1_2TqspP0p61UNqV8E0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/130979-day-after-thanksgiving-turkey-carcass-soup-step-05-b5ae0eb0777c4b9aa522d669137f9433.jpg"
      ],
      "image": "assets/images/130979/step_05.webp"
    },
    {
      "text": "Adjust seasonings to taste before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uEvHV7O_S3HwvbgmtvMGGHT6NNY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/130979-day-after-thanksgiving-turkey-carcass-soup-step-06-fd2e09925c99414ead17ece65d992095.jpg"
