  "ingredients": [
    "1.5 cups white sugar",
    "0.33300000429153 cup all-purpose flour",
    "0.25 teaspoon salt",
    "0.5 cup water",
    "1 (12 ounce) package fresh cranberries",
    "0.25 cup lemon juice",
    "1 dash ground cinnamon",
    "2 teaspoons butter",
    "1 recipe pastry for a 9 inch double crust pie"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, flour, salt, and water in a saucepan; bring to a boil and cook, stirring constantly until thick and smooth. Add cranberries, lemon juice, and cinnamon. Cook 5 minutes until mixture is thick and cranberries pop. Remove from heat and stir in butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bottom crust in 9-inch pie plate; spoon in cranberry filling. Roll out top crust and cut into strips for lattice. Place lattice strips on top and seal edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden brown, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
