  "ingredients": [
    "4 cups butternut squash cubes",
    "1 teaspoon salt",
    "2 dashes ground cinnamon, or to taste",
    "1 tablespoon coconut oil",
    "0.5 teaspoon curry powder",
    "1 large Honeycrisp apple - peeled, cored, and diced",
    "0.5 large yellow onion, diced",
    "3.5 cups vegetable broth",
    "0.5 cup almond milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread butternut squash cubes onto a baking sheet. Season salt and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast squash in the preheated oven until fork-tender, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt coconut oil in a large saucepan over medium-high heat. Add curry powder, apple, onion, and salt to taste. Sauté until soft, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add broth, almond milk, and squash. Bring to a boil. Reduce heat to medium-low and simmer, about 20 minutes. Season with salt to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add soup to a blender in batches, if needed, no more than half full. Cover, holding lid in place. Pulse, then purée until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
