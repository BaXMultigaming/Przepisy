  "title": "Cilantro Lime Dressing",
  "description": "Creamy cilantro dressing from el Pollo Loco made with roasted poblano peppers is a spicy addition to any salad and quick and easy to make.",
  "authors": [
    "Isabel"
  ],
  "date_published": "2018-06-08T10:17:47-04:00",
