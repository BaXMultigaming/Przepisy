  "ingredients": [
    "0.5 cup soy sauce",
    "0.5 cup white sugar",
    "0.25 cup vinegar",
    "1 tablespoon cornstarch",
    "1 tablespoon cold water",
    "1.5 teaspoons chopped fresh ginger",
    "1 clove garlic, crushed",
    "0.25 teaspoon black pepper",
    "4 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Mix together soy sauce, sugar, vinegar, cornstarch, cold water, ginger, garlic, and black pepper in a bowl until marinade is well combined. Add chicken breasts and stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour marinade and chicken into a 9x9-inch square baking dish. Cover and marinate chicken in the refrigerator for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake chicken in marinade in the preheated oven until meat is no longer pink in the center and juices run clear, about 40 minutes, turning halfway through cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
