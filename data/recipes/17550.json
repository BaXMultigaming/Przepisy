  "ingredients": [
    "2 tablespoons butter",
    "4 red bell peppers, chopped",
    "1 onion, chopped",
    "4 cloves garlic, minced",
    "24 fluid ounces chicken broth",
    "0.5 cup heavy cream",
    "0.125 teaspoon ground black pepper"
  ],
