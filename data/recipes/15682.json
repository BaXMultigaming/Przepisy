  "ingredients": [
    "1 cup whole wheat pastry flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "1 tablespoon white sugar",
    "0.5 cup lowfat buttermilk",
    "2 tablespoons honey",
    "1 tablespoon white sugar",
    "1 tablespoon cornstarch",
    "1 teaspoon ground cinnamon",
    "1 cup water",
    "2 tablespoons lemon juice",
    "3 cups fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Biscuit Topping: In a medium bowl combine flour, baking powder, baking soda, and 1 tablespoon sugar. Mix well then stir in buttermilk just until all ingredients are moistened and dough forms a ball. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Berry Filling: In a large saucepan combine honey, 1 tablespoon sugar, cornstarch, cinnamon, water, and lemon juice. Mix until smooth, then add berries. Simmer over medium heat, stirring gently, until thickened (about 10 minutes). Spoon berry mixture into an 8x11 inch nonstick casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop biscuit dough onto berry mixture by tablespoonfuls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 minutes, or until biscuits are lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
