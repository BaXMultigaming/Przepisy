  "ingredients": [
    "2.5 pounds bison back ribs, cut into 2 to 3 rib portions",
    "3 cups water to cover",
    "1 medium carrot, sliced",
    "1 medium celery, sliced",
    "1 medium onion, sliced",
    "1 bay leaf",
    "1 cup BBQ sauce"
  ],
  "steps": [
    {
      "text": "Place rib portions into the bottom of a slow cooker. Cover with water. Add carrot, celery, onion, and bay leaf. Cover and cook until tender and no longer pink in the centers, 8 hours on Low or 4 hours on High.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat an outdoor grill for low heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Take the cooked ribs out of the slow cooker and brush generously with the BBQ sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook ribs on the preheated grill just until nicely browned, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
