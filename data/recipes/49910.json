  "ingredients": [
    "2 tablespoons butter, melted",
    "7 (1 ounce) slices day-old bread, torn into small pieces",
    "0.75 cup chopped fresh strawberries",
    "3 eggs",
    "1.25 cups milk",
    "0.75 cup light cream",
    "0.25 cup strawberry preserves",
    "0.75 cup white sugar, or to taste",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter the bottom and sides of an 8-inch square baking dish with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss bread with chopped strawberries; place into the prepared pan. Beat eggs, milk, cream, strawberry preserves, sugar, and vanilla in a medium bowl until frothy. Pour over bread and lightly press down with a spatula until bread has absorbed milk mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 to 45 minutes, or until the top springs back when lightly tapped.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
