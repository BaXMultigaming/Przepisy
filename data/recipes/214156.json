  "ingredients": [
    "5 pounds red potatoes",
    "1 cup extra-virgin olive oil",
    "0.25 cup tarragon vinegar",
    "0.25 cup water",
    "1 (.7 ounce) package dry Italian salad dressing mix (such as Good Seasons®)",
    "1 cup real bacon bits",
    "0.5 cup chopped celery",
    "0.25 cup chopped dill pickle",
    "0.25 cup chopped green onion",
    "3 cups mayonnaise"
  ],
  "steps": [
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain; steam-dry, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, vinegar, water, and Italian dressing mix together in a bowl until well blended. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice potatoes until chunky; place in a large bowl. Stir in dressing; toss to coat, then cool. Stir in bacon, celery, pickle, and green onion; fold in mayonnaise until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
