  "ingredients": [
    "2 ears fresh corn, husked",
    "3 tablespoons olive oil",
    "1 teaspoon chili powder",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon ground black pepper",
    "0.25 cup mayonnaise",
    "2 teaspoons lime juice",
    "1 teaspoon Mexican-style hot sauce (such as Valentina®)",
    "2 tablespoons crumbled cotija cheese",
    "1 tablespoon chopped cilantro"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place an ear of corn on a cutting board and cut in half lengthwise. Cut each half in half lengthwise. Repeat with remaining ear of corn. You should have 8 \"ribs\" total.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together olive oil, chili powder, garlic powder, and black pepper in a small bowl until well combined. Brush onto both sides of each rib and place in the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 12 minutes, flipping halfway through the cook time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk together mayonnaise, lime juice, and hot sauce in a second small bowl until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer corn ribs to a serving plate. Drizzle sauce over ribs; top with cotija cheese and cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
