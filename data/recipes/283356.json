  "title": "Air Fryer Corn Ribs",
  "description": "These air fryer corn ribs are easy to make and feature cutting the ears lengthwise so they curl up like ribs in this Mexican elote-inspired recipe.",
  "authors": [
    "Soup Loving Nicole"
  ],
  "date_published": "2021-02-14T23:33:07-05:00",
