  "ingredients": [
    "1 (15.25 ounce) package white cake mix",
    "0.5 cup vegetable oil",
    "2 large eggs"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
