  "ingredients": [
    "1.75 cups white sugar",
    "1 cup butter",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "3 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until light and fluffy. Add eggs one at a time, beating well after each addition. Beat in vanilla extract. Combine flour, baking soda, salt, and nutmeg; stir into creamed mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VKp9wF8xaP4XnscqRBp3LAUE4_Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25766-grandmas-old-fashione-tea-cakes-ddmfs-step-1-0355-3x4-3752609ca7334587a71f61b04726e911.jpg"
      ],
      "image": "assets/images/25766/step_01.webp"
    },
    {
      "text": "Knead dough for a few turns on a floured board until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_641dDXcLn0IRFnt_NFeEwW6YFs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25766-grandmas-old-fashione-tea-cakes-ddmfs-step-2-0360-3x4-33758cd789854f74a81a7504af9f6bce.jpg"
      ],
      "image": "assets/images/25766/step_02.webp"
    },
    {
      "text": "Cover and refrigerate until firm, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a lightly floured surface, roll the dough out to 1/4 inch in thickness. Cut into desired shapes with cookie cutters. Place cookies 1 1/2 inches apart onto cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/L2Me9r4AU_utU4hs2NWUaHn-CQI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25766-grandmas-old-fashione-tea-cakes-ddmfs-step-3-0475-3x4-ed0be0efd33248668ba1205d07675dfd.jpg"
      ],
      "image": "assets/images/25766/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G_Yf0jUXwIaa8AaMFe02lDSXTpw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25766-grandmas-old-fashione-tea-cakes-ddmfs-step-4-0540-3x4-9b0cde070fe64498ad218d3bcdd08bfa.jpg"
      ],
      "image": "assets/images/25766/step_06.webp"
    },
    {
      "text": "Cool on the cookie sheets briefly before removing to a wire rack to cool completely.",
      "section": null,
