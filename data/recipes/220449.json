  "ingredients": [
    "2 cups half-and-half",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "2 cups heavy whipping cream",
    "1 tablespoon vanilla extract",
    "0.5 cup Irish cream liqueur"
  ],
  "steps": [
    {
      "text": "Beat together half-and-half and sugars in a large bowl with an electric mixer on medium speed until sugars have dissolved. Stir in heavy cream and vanilla until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "About 2 minutes before the end of freezing time, pour Irish cream liqueur into the ice cream maker; allow the machine to finish freezing ice cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer ice cream into a freezer-proof container with a tight lid and place in the freezer until ice cream is hardened, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
