  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "1 tablespoon baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1.5 cups shredded Cheddar cheese",
    "1 cup plain yogurt",
    "2 large eggs, beaten",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GSsrIKgFZEs5rFnOiWNOSntvdTs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-239856-cheddar-cheese-muffins-ddmfs-step-1-7b8438a4326f4778b330ac2669744c3d.jpg"
      ],
      "image": "assets/images/239856/step_01.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 12-cup jumbo muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8aCyMajaQBzhe-YBGN8gcViOGtY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-239856-cheddar-cheese-muffins-ddmfs-step-2-7c3aa60bdf3548feb29ca49882764d10.jpg"
      ],
      "image": "assets/images/239856/step_02.webp"
    },
    {
      "text": "Whisk flour, sugar, baking powder, salt, and baking soda together in a large mixing bowl. Stir in Cheddar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xo0euyC5dqwlnoKwvMAEsdLEDqA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-239856-cheddar-cheese-muffins-ddmfs-step-3-195a78af1e6c4ec1883902ee5e7adbf6.jpg"
      ],
      "image": "assets/images/239856/step_03.webp"
    },
    {
      "text": "Add yogurt, eggs, and melted butter; stir just until the dry ingredients are moistened. Spoon into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yjpzc1VMLmYBNKlF-0nB0krJb6A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-239856-cheddar-cheese-muffins-ddmfs-step-4-75192c9b192f4278be460894217605eb.jpg"
      ],
      "image": "assets/images/239856/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until the tops just start to lightly brown, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qwd-vFIszaywxH-ZhZnu8aoTg9A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-239856-cheddar-cheese-muffins-ddmfs-step-5-86422a3cfb914f51bb1efa11f4df0b4d.jpg"
