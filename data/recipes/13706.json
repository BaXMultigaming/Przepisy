  "ingredients": [
    "3 tablespoons butter",
    "1 cup sliced onion",
    "1 (8.5 ounce) package corn bread mix",
    "0.5 cup milk",
    "1 cup cream-style corn",
    "1 dash hot pepper sauce",
    "1 cup sour cream",
    "1 cup shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray one 10x10 inch pan with non-stick cooking spray.",
