  "ingredients": [
    "cooking spray",
    "0.75 cup all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "0.25 teaspoon salt",
    "0.25 teaspoon baking soda",
    "1.25 cups white sugar",
    "0.5 cup butter, melted and cooled",
    "1 tablespoon vanilla extract",
    "2 eggs",
    "1 cup semisweet chocolate chips",
    "0.5 cup chopped walnuts",
    "1.5 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 2.2-quart glass baking dish with aluminum foil; coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift ¾ cup flour, cocoa powder, salt, and baking soda together into a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, and vanilla extract with an electric mixer in a separate bowl until smooth and fluffy; beat in eggs, one at a time, until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour mixture to sugar mixture, in two to three additions, mixing slowly until batter is just combined. Toss chocolate chips and walnuts with remaining 1 ½ tablespoons flour in a bowl; fold into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared baking dish; level top using a rubber spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are set and start to pull away from the sides of the pan, 20 to 30 minutes. Cool until center firms up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
