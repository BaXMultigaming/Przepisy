  "ingredients": [
    "1 (12 ounce) package tofu, drained and cut into cubes",
    "0.5 teaspoon sesame oil",
    "2 tablespoons apple cider vinegar",
    "1 teaspoon dry mustard",
    "1 teaspoon salt",
    "0.5 teaspoon pepper",
    "0.25 cup peanut oil"
  ],
  "steps": [
    {
      "text": "Place the tofu, sesame oil, cider vinegar, mustard, salt and pepper into the container of a blender. Blend until smooth. Drizzle the peanut oil in a thin stream while blending until thick and pale. Use promptly.",
