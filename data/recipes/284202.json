  "ingredients": [
    "1 (16 ounce) package jumbo pasta shells, dry",
    "4 ears corn, husked",
    "1 pound cherry tomatoes, halved",
    "0.25 cup extra-virgin olive oil",
    "4 ounces prosciutto, diced",
    "2 tablespoons basil pesto",
    "10 leaves basil, thinly sliced",
    "0.5 teaspoon salt",
    "0.25 cup freshly grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to a boil. Add conchiglie and cook, stirring occasionally, until tender yet firm to the bite, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a separate pot of water to a boil. Add corn and boil for 2 minutes. Remove and run under cold water to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Hold each cob upright in the base of a large serving bowl, and cut kernels off with a sharp knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta; add to the corn. Add tomatoes, olive oil, prosciutto, pesto, basil, and salt; toss thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve immediately (or refrigerate for up to 2 days), topped with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
