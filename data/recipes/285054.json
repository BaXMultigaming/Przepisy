  "title": "Homemade Banana Upside-Down Cake",
  "description": "This upside-down banana cake has a layer of sweet, buttery caramelized banana slices on an incredibly moist banana cake for the best banana dessert.",
  "authors": [
    "Orsi"
  ],
  "date_published": "2021-06-18T19:15:19-04:00",
