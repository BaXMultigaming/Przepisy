  "ingredients": [
    "1 (3 pound) corned beef brisket",
    "1 large onion, thinly sliced",
    "1 (32 ounce) package sauerkraut",
    "0.75 cup beef broth",
    "3 tablespoons brown mustard"
  ],
  "steps": [
    {
      "text": "Trim excess fat from corned beef and put in a large enough slow cooker that the brisket can lay almost flat along the bottom. Place onion on top of beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain sauerkraut and pile on top of onion. Mix broth and mustard together and pour over everything in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until brisket is very tender, 7 to 9 hours. An instant-read thermometer inserted into the center should read 160 degrees F (71 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
