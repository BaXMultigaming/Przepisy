  "ingredients": [
    "1 tablespoon olive oil",
    "1 medium onion, chopped",
    "1 clove garlic, minced",
    "6 medium green bell peppers",
    "2 tablespoons chopped fresh dill",
    "0.75 teaspoon salt",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon ground black pepper",
    "1 cup cooked rice",
    "8 ounces ground lamb",
    "1 cup crumbled feta cheese",
    "1 cup tomato sauce",
    "1 cup cold water",
    "1 tablespoon fresh lemon juice",
    "1 teaspoon white sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a medium skillet over medium heat, add onion and cook for four minutes until soft. Stir in garlic and cook one minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice tops off peppers and remove seeds. Stand peppers upright in a a 9x12-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large bowl, combine onion mixture, dill, salt, allspice and pepper. Mix in rice and lamb, fold in feta cheese. Stuff peppers with mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix tomato sauce with water, lemon juice and sugar. Pour half over peppers, and half over bottom of dish. Cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Uncover and continue baking 15 minutes, basing occasionally with sauce, until a meat thermometer inserted in center of filling reads 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
