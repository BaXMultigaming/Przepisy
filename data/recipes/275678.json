  "ingredients": [
    "cooking spray",
    "1 egg, beaten",
    "0.5 cup cornmeal",
    "0.33333334326744 cup self-rising flour",
    "0.33333334326744 cup panko bread crumbs",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 green tomatoes, sliced"
