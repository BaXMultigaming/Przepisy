  "ingredients": [
    "2 (15 ounce) cans pineapple tidbits, drained with juice reserved",
    "2 mangos - peeled, seeded and diced",
    "2 green chile peppers, diced",
    "0.33333334326744 cup chopped fresh cilantro",
    "0.5 cup freshly squeezed lime juice and pulp",
    "0.5 cup fresh orange juice",
    "0.25 cup dark rum",
    "0.5 clove garlic, minced",
    "8 skinless, boneless chicken breasts"
  ],
  "steps": [
    {
      "text": "In a bowl, mix the pineapple and the reserved juice from 1 can, mangos, peppers, cilantro, lime juice and pulp, orange juice, rum, and garlic. Let stand for one hour before adding chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain the juice from the salsa to use for the marinade. Set aside enough salsa without the juice to use for topping the chicken. Marinate the chicken breast halves in the bowl with the remaining salsa and juice mixture for 2 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Discard salsa used for marinating, and bake chicken for 30 minutes in the preheated oven, or until chicken juices run clear. Top with reserved salsa to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
