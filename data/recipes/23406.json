  "ingredients": [
    "1.75 cups cake flour",
    "2.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1.5 cups heavy cream",
    "1.3329999446869 cups white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Grease and flour two 8-inch pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qAc-ohqVzIwkcGi1L5WjRRZhlPc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23406-whipped-cream-cake-ii-VAT-001-step-01-ceff3d10616e488eb78e3dc639fb41c4.jpg"
      ],
      "image": "assets/images/23406/step_01.webp"
    },
    {
      "text": "Sift cake flour, baking powder. and salt together in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M9KyOy8j1EHbsIUbdEip5kTyLwg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23406-whipped-cream-cake-ii-VAT-002-step-02-9e10c35cd60d4ba29935345af26c70f7.jpg"
      ],
      "image": "assets/images/23406/step_02.webp"
    },
    {
      "text": "Whip cream and sugar together in a separate large bowl with an electric mixer until stiff peaks form. Beat in eggs, then stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/15VxWCVa95kgjIqlUPnzoRl_dfo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23406-whipped-cream-cake-ii-VAT-003-step-03-cacd72a610694dbbb152e0ab381d3e3f.jpg"
      ],
      "image": "assets/images/23406/step_03.webp"
    },
    {
      "text": "Fold in flour mixture, mixing just until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9RJu5_dxanBakf5mc9wj4TXe6x0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23406-whipped-cream-cake-ii-VAT-004-step-04-8720821743f84f3ba76422db3a193481.jpg"
      ],
      "image": "assets/images/23406/step_04.webp"
    },
    {
      "text": "Pour cake batter into prepared cake pans. Bake in the preheated oven for 25 minutes, or until a toothpick inserted into the center of the cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5-kgZ4RX9HClSOo_FpwJ48S74hs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23406-whipped-cream-cake-ii-VAT-005-step-05-5c4c26ebc2b84a2097e0a4e19a19cd1a.jpg"
      ],
      "image": "assets/images/23406/step_05.webp"
    },
    {
      "text": "Allow to cool in pans for 10 minutes; invert onto a wire rack and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tTHFEDTPDY4A5SLSXtWAA5_vLjo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23406-whipped-cream-cake-ii-VAT-006-step-06-aa37183111eb41b096ec7dfb8eacde3d.jpg"
