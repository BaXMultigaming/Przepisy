  "ingredients": [
    "2 quarts corn oil for frying",
    "1 cup all-purpose flour",
    "0.75 cup beer",
    "0.25 cup milk",
    "2 eggs",
    "0.5 teaspoon salt",
    "2 pounds cheese curds, broken apart"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Heat corn oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wmvcs0cpwHNstr2XRJLYXUTbe40=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216711-real-wisconsin-fried-cheese-curds-DDMFS-4x3-step-01-207462b529ad4cd89abd2c46f2c8280c.jpg"
      ],
      "image": "assets/images/216711/step_01.webp"
    },
    {
      "text": "Whisk together flour, beer, milk, eggs, and salt to form a smooth, rather thin batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2SXBVNDm3lXvyR8okzpU0XSXg88=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216711-real-wisconsin-fried-cheese-curds-DDMFS-4x3-step-02-a77c063f2a844c8cb7e86d216e016fcc.jpg"
      ],
      "image": "assets/images/216711/step_02.webp"
    },
    {
      "text": "Place cheese curds, about 6 or 8 at a time, into the batter, stir to coat, and remove with a wire strainer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/awtL7IkcHnNDQhPxamyQnInAzIU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216711-real-wisconsin-fried-cheese-curds-DDMFS-4x3-step-03-6b54d5de017c4da98cb1730ecac37b63.jpg"
      ],
      "image": "assets/images/216711/step_03.webp"
    },
    {
      "text": "Shake the curds a time or two to remove excess batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/POsUNNsQBs-ZCmuDnXmTl7-P0v0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216711-real-wisconsin-fried-cheese-curds-DDMFS-4x3-step-04-6c06f9265d064b6383402de618d31b0b.jpg"
      ],
      "image": "assets/images/216711/step_04.webp"
    },
    {
      "text": "Deep fry curds in hot oil until golden brown, 1 or 2 minutes. Drain on paper towels; serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1TJiGvUlFQthZfTYQRfLQc3qplg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216711-real-wisconsin-fried-cheese-curds-DDMFS-4x3-step-05-64de32e97e9a4691aaf315529908eb37.jpg"
      ],
      "image": "assets/images/216711/step_05.webp"
    }
  ],
