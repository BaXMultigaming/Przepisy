  "ingredients": [
    "1.25 cups white sugar",
    "0.5 cup butter, softened",
    "0.5 cup coconut oil",
    "3 egg yolks",
    "1.5 teaspoons vanilla extract",
    "2.25 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a baking sheet lightly or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, and coconut oil together in a large bowl with an electric mixer until light and fluffy. Beat in egg yolks and vanilla extract. Add flour, baking powder, and baking soda gradually; mix until dough just comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix dough with hands to fully incorporate ingredients. Roll dough into walnut-size balls and place 2 inches apart onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are cracked, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
