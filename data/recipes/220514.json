  "ingredients": [
    "8 ounces cream cheese, softened",
    "1 (2.5 ounce) package deli-sliced corned beef (such as Buddig ®), diced",
    "3 green onions, finely chopped",
    "1 tablespoon mayonnaise",
    "2 teaspoons Worcestershire sauce",
    "0.5 teaspoon prepared horseradish",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Combine cream cheese, corned beef, green onions, mayonnaise, Worcestershire sauce, and horseradish in a bowl until thoroughly mixed.",
