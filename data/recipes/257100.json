  "ingredients": [
    "3 tablespoons olive oil",
    "2 onions, finely chopped",
    "1 (28 ounce) can tomato puree",
    "0.5 cup water",
    "2 teaspoons dried oregano",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large saucepan over medium heat. Add onions and sauté in hot oil until just starting to turn golden, 5 to 8 minutes. Stir in tomato purée, water, oregano, basil, salt, and pepper until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring sauce to a simmer. Reduce heat to medium-low, cover, and simmer until flavors blend, about 30 minutes.",
