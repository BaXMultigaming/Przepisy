  "ingredients": [
    "8 (1 ounce) squares unsweetened chocolate",
    "1 cup butter",
    "5 eggs",
    "3 cups white sugar",
    "1 tablespoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.5 cup coffee flavored liqueur",
    "2 cups chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13 inch baking pan. In a heavy saucepan combine the butter and unsweetened chocolate. Cook over low heat, stirring constantly until smooth and well blended. Remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat eggs, sugar and vanilla until thick and pale. Stir in the chocolate mixture and coffee liqueur. Fold in the flour. Stir in chopped walnuts if desired. Spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 to 35 minutes, or until a toothpick inserted in the center comes out almost clean. Be careful not to overbake. Cool for at least 30 minutes before cutting into bars and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
