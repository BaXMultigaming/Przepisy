  "ingredients": [
    "0.5 cup rice vinegar",
    "0.5 onion, chopped",
    "6 cloves garlic, crushed",
    "2 tablespoons kosher salt",
    "1 tablespoon Chinese five-spice powder",
    "1 teaspoon red pepper flakes",
    "2 bay leaves",
    "1 (2 pound) slab baby back ribs, cut into individual ribs",
    "1.5 tablespoons soy sauce",
    "1.5 tablespoons rice vinegar",
    "1.5 tablespoons sambal oelek chili paste",
    "1.5 tablespoons Dijon mustard",
    "1.5 tablespoons ketchup",
    "1.5 tablespoons honey",
    "1.5 tablespoons brown sugar",
    "0.5 teaspoon Chinese five-spice powder"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare ribs: Mix 2 1/2 quarts water, rice vinegar, onion, garlic, salt, five-spice powder, chili flakes, and bay leaves in a large pot. Bring to a boil; then reduce heat to low and simmer for 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ribs in broth; return to a simmer, then turn heat to low and cook for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with a silicone baking mat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare glaze: Whisk together soy sauce, rice vinegar, chili paste, mustard, ketchup, honey, brown sugar, and five-spice powder in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove ribs from broth and transfer into the bowl with soy sauce glaze; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer glazed ribs to the prepared baking sheet. Reserve extra glaze for brushing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake ribs in the preheated oven for 15 minutes. Turn ribs and brush with more glaze. Cook 15 to 20 more minutes, brushing occasionally with remaining glaze if desired. Remove and serve.",
      "section": null,
      "name": null,
      "url": null,
