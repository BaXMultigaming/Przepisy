  "ingredients": [
    "nonstick aluminum foil",
    "1 (1.5 pound) package small creamer potatoes (such as The Little Potato Company® dynamic duo potatoes)",
    "2 tablespoons olive oil",
    "2 tablespoons za'atar seasoning",
    "0.5 teaspoon salt",
    "1 teaspoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a large bowl. Add olive oil, za'atar, and salt; stir to coat. Spread potatoes in a single layer on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 12 minutes. Stir potatoes and roast for an additional 12 minutes. Stir once more and cook until crispy, about 4 more minutes. Garnish with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
