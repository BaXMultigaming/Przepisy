  "ingredients": [
    "0.5 cup white wine",
    "5 cloves garlic, minced",
    "2 teaspoons chopped fresh rosemary, divided",
    "4 (4 ounce) swordfish steaks",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "2 tablespoons lemon juice",
    "1 tablespoon extra virgin olive oil",
    "4 slices lemon, for garnish"
  ],
  "steps": [
    {
      "text": "Stir wine, garlic, and 1 teaspoon rosemary together in an 8-inch square baking dish. Sprinkle fish with salt and pepper. Place in the baking dish, turning to coat. Cover and refrigerate for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together lemon juice, olive oil, and remaining rosemary in a small bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a grill to medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer fish to a paper towel-lined dish, and discard marinade. Lightly oil grill grate to prevent sticking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill fish, turning once, until fish can be easily flaked with a fork, about 10 minutes. Remove fish to a serving plate. Spoon lemon sauce over the fish and top each fillet with a slice of lemon for garnish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
