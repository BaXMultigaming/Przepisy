  "ingredients": [
    "1 medium Pears, raw",
    "1 tablespoon salted butter",
    "1 tablespoon dark brown sugar",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Fill a large pot with warm water, leaving 3 inches of head room. Attach a sous vide cooker to the pot. Set temperature to 175 F degrees (80 degrees C) and timer to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel pear; halve lengthwise. Scoop out seeds using a small spoon. Place pear halves into a resealable plastic bag or silicone bag; add butter, brown sugar, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove excess air; seal bag and immerse into water making sure top of bag does not go below water. Leave in the water for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove bag; place pear halves on dessert plates. Drizzle with cooking liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
