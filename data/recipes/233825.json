    "0.5 cup white sugar",
    "0.5 cup salt",
    "2 ears corn"
  ],
  "steps": [
    {
      "text": "Combine water, sugar, and salt in a container large enough to hold corn until sugar and salt dissolve.",
      "section": null,
      "name": null,
      "url": null,
