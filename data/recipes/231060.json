  "ingredients": [
    "2 pounds prepared pizza dough",
    "1 (28 ounce) can crushed tomatoes",
    "0.5 cup minced pepperoni",
    "0.25 cup olive oil",
    "3 tablespoons grated Romano cheese",
    "3 tablespoons white sugar",
    "1 teaspoon salt",
    "0.75 teaspoon minced garlic",
    "0.75 teaspoon dried oregano",
    "0.5 teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease two baking sheets or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll or press 1/2 of the pizza dough out into a rectangle on one of the prepared baking sheets. Repeat with the remaining pizza dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix crushed tomatoes, pepperoni, 1/4 cup olive oil, Romano cheese, sugar, salt, garlic, oregano, and black pepper in a bowl; stir to dissolve sugar and salt. Spread 1/2 of the sauce evenly over each crust, spreading it all the way to the edges. Drizzle 2 tablespoons olive oil over each pizza.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the crusts are crisp on the bottom and the sauce looks dry at the edges but is still moist in the middle, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cool to room temperature on wire racks, about 20 minutes. Cut each cooled pizza into eight 9x3-inch strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
