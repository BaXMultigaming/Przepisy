  "ingredients": [
    "cooking spray",
    "1 pound ground beef",
    "1 onion, chopped",
    "2 stalks celery, chopped",
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "1 cup cooked rice",
    "0.5 cup slivered almonds",
    "0.5 cup water",
    "3 tablespoons soy sauce",
    "5 ounces chow mein noodles"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet for 5 minutes. Add onion and celery; cook and stir until vegetables have slightly softened, about 5 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together condensed soup, cooked rice, almonds, water, and soy sauce in a large bowl until well combined. Stir in beef mixture. Pour into the prepared baking dish. Top with chow mein noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake casserole in the preheated oven until heated through, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
