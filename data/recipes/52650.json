  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in boiling water until tender yet firm to the bite, 8 to 10 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Sauté carrots, zucchini, and garlic in hot butter until tender. Stir in heavy cream, Parmesan cheese, and dill. Cook and stir until thickened. Add cooked spaghetti and mix until evenly coated.",
