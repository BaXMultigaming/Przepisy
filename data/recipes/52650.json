  "ingredients": [
    "8 ounces spaghetti",
    "2 tablespoons butter",
    "3 large carrots, julienned",
    "1 large zucchini, julienned",
    "2 teaspoons minced garlic",
    "0.75 cup heavy cream",
    "0.75 cup grated Parmesan cheese",
    "1 tablespoon chopped fresh dill"
