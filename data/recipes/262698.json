  "ingredients": [
    "5 eggs",
    "4 tablespoons whole milk",
    "4 tablespoons sunflower seeds",
    "1 teaspoon roasted flax seeds",
    "1 teaspoon dried chervil",
    "0.5 teaspoon dried Italian herbs",
    "1 small clove garlic, minced",
    "0.5 teaspoon sea salt",
    "1 teaspoon freshly ground black pepper",
    "1 tablespoon olive oil",
    "0.25 teaspoon dried basil",
    "3 slices Gouda cheese",
    "4 leaves fresh basil, chopped"
  ],
  "steps": [
    {
      "text": "Combine eggs, milk, sunflower seeds, flax seeds, chervil, Italian herbs, garlic, salt, and pepper in a bowl and mix with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a nonstick skillet over medium heat. Pour in egg mixture. Cook until egg starts to set, about 5 minutes. Sprinkle with dried basil and lay sliced Gouda cheese on top. Cut into 2 halves using a spatula. Fold each omelette in half and turn over. Cook for another minute. Serve garnished with fresh basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
