  "ingredients": [
    "2 tablespoons butter",
    "2 onions, chopped",
    "2 carrots, peeled and sliced into 1 inch pieces",
    "1 stalk celery, cut into 1 inch pieces",
    "2 potatoes, peeled and cubed",
    "3 tablespoons all-purpose flour",
    "3 cups chicken stock",
    "0.25 teaspoon dried marjoram",
    "2 skinless, boneless turkey breast halves, cubed",
    "1 green bell pepper, diced"
  ],
  "steps": [
    {
      "text": "Melt butter in a pot over medium heat. Place onions in the pot and cook until tender. Stir in carrots and celery; cook until tender. Stir in potatoes and flour. Pour in chicken stock and season the soup with marjoram.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place turkey in the pot and bring to a boil. Reduce heat to low, cover, and simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix green bell pepper into the soup and continue cooking until pepper is tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
