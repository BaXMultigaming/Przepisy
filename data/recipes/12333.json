  "ingredients": [
    "14 (4 inch) prepared tart shells",
    "1 egg",
    "1 cup packed brown sugar",
    "3 tablespoons butter, melted",
    "2 tablespoons lemon juice",
    "0.25 teaspoon ground nutmeg",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the egg with the sugar using a fork until well blended. Stir in the melted butter, lemon juice, nutmeg, and raisins. Fill tart shells half full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 20 minutes. Allow tarts to stand for a few minutes in the pans before removing to racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
