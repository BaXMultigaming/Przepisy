  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "2 tablespoons brown sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1 egg",
    "1.25 cups milk",
    "0.33333334326744 cup vegetable oil",
    "2 teaspoons vanilla extract",
    "0.75 cup mini chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly spray 48 miniature muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, white sugar, brown sugar, baking powder, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly beat egg in a separate bowl; stir in milk, vegetable oil, and vanilla extract. Mix egg mixture into flour mixture until incorporated. Fold in mini chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 10 minutes. Cool briefly in the tin before transferring muffins to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
