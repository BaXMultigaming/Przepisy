  "ingredients": [
    "2 (6 ounce) frozen lobster tails",
    "1 tablespoon olive oil",
    "1 teaspoon lemon pepper seasoning"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use kitchen scissors to cut lobster shells open lengthwise down the back. Brush exposed meat with olive oil and season with lemon-pepper seasoning. Place on a broiler pan with the opening facing upwards.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until opaque and slightly browned at the edges, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
