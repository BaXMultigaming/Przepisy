  "ingredients": [
    "1 tablespoon olive oil",
    "1 onion, diced",
    "1 red bell pepper, diced",
    "1 (4 ounce) package sliced fresh mushrooms, or to taste",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (10 ounce) can chicken chunks, drained",
    "1 (18 ounce) bottle barbeque sauce (such as Montgomery Inn)",
    "1 (10 ounce) container refrigerated pizza crust",
    "1 (8 ounce) package shredded 4-cheese blend"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium heat; cook and stir onion, red bell pepper, and mushrooms until tender, 5 to 10 minutes. Add diced tomatoes; cook and stir until heated through, 2 to 3 minutes. Combine vegetable mixture and chicken in a large bowl; add barbeque sauce and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pizza crust onto the prepared baking sheet. Spoon barbeque sauce mixture over crust and top with cheese blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is bubbling and melted, 13 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
