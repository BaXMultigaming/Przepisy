  "ingredients": [
    "1 clove garlic, finely minced, or more to taste",
    "1 lime, zested",
    "2 tablespoons seasoned rice vinegar",
    "2 tablespoons Asian fish sauce",
    "2 tablespoons lime juice",
    "1 tablespoon Asian chile pepper sauce (such as sambal oelek)",
    "1 teaspoon Asian (toasted) sesame oil",
    "4 (4 ounce) fillets sea bass",
    "2 teaspoons vegetable oil, or as needed",
    "salt to taste",
    "1 tablespoon coarsely chopped cilantro leaves, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk garlic, lime zest, rice vinegar, fish sauce, lime juice, chile pepper sauce, and sesame oil in a glass bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush both sides of sea bass fillets with vegetable oil and sprinkle lightly with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until fish is opaque, shows good grill marks, and springs back when pressed lightly, 3 to 4 minutes per side. Transfer fillets to a serving platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk dressing again; taste and and adjust seasoning. Drizzle dressing over warm fish. Sprinkle fillets with cilantro leaves.",
      "section": null,
      "name": null,
      "url": null,
