  "ingredients": [
    "1 sheet (18x24-inches) Reynolds Wrap® Aluminum Foil",
    "1 (10 ounce) package frozen whole kernel corn",
    "1 small onion, chopped",
    "1 cup chopped tomatoes",
    "0.75 cup chopped green bell pepper",
    "2 teaspoons Cajun seasoning",
    "1 tablespoon margarine or butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F or grill to medium-high.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Center vegetables on sheet of Reynolds Wrap® Aluminum Foil. Sprinkle with Cajun seasoning; stir to blend. Top with margarine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring up foil sides. Double fold top and ends to seal making one large foil packet, leaving room for heat circulation inside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 20 to 25 minutes on a cookie sheet in oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "OR grill 12 to 14 minutes in covered grill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
