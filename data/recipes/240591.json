  "ingredients": [
    "1 cup white sugar",
    "0.33333334326744 cup soy milk",
    "0.33333334326744 cup peanut butter",
    "2 tablespoons canola oil",
    "1 teaspoon pure vanilla extract",
    "1 cup whole wheat flour",
    "1 cup rolled oats",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup vegan semi-sweet chocolate chips",
    "0.5 cup walnut pieces"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Oil a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, soy milk, peanut butter, canola oil, and vanilla extract together with a whisk in a large bowl until completely smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, oats, baking soda, and salt in a separate bowl; add to the peanut butter mixture and stir to combine. Fold chocolate chips and walnut pieces into the flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop your batter by large spoonfuls onto prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cookies in preheated oven until browned along the edges, about 10 minutes. Cool cookies on sheet for 10 minutes before removing to a cooling rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
