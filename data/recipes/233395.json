  "ingredients": [
    "2 yellow squash, shaved into thin strips",
    "1 zucchini, shaved into thin strips",
    "1 teaspoon salt",
    "2 tablespoons chopped fresh mint",
    "1 tablespoon olive oil",
    "0.5 teaspoon grated lemon zest",
    "2 teaspoons fresh lemon juice",
    "0.5 teaspoon freshly ground black pepper",
    "3 slices prosciutto, chopped",
    "0.25 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Toss yellow squash and zucchini with salt in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mint, olive oil, lemon zest, lemon juice, and black pepper in a small bowl until well combined; pour over squash mixture and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a small nonstick skillet over medium heat. Add prosciutto; cook and stir until crisp, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide squash salad among 4 plates; sprinkle with prosciutto and feta cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
