  "ingredients": [
    "1 (20 ounce) can crushed pineapple",
    "1 (21 ounce) can LUCKY LEAF® Regular or Premium Cherry Fruit Filling",
    "1 (18.25 ounce) package yellow cake mix",
    "1 cup melted butter or margarine",
    "1 cup chopped macadamia nuts**",
    "1 (7 ounce) package shredded coconut*"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread undrained pineapple in the prepared baking dish. Cover with cherry filling. Sprinkle with cake mix, smoothing evenly to cover. Pour melted butter over the top, covering evenly. Top with nuts and coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until brown on top and bubbly, 50 to 60 minutes. Let cool for 30 minutes. Serve warm or cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
