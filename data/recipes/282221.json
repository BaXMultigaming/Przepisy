  "ingredients": [
    "2 medium russet potatoes",
    "0.5 medium sweet onion, roughly chopped",
    "0.5 cup shredded sharp Cheddar cheese, divided",
    "0.25 cup sour cream",
    "1 tablespoon minced garlic",
    "salt and ground black pepper to taste",
    "2 tablespoons seasoned bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut potatoes in half lengthwise and scoop out the middle of each, leaving enough to keep the skin intact and stable.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put the raw potato flesh into a food processor along with onion, 1/4 cup of Cheddar cheese, sour cream, garlic, salt, and pepper. Blend ingredients together until it is the consistency of a very rough puree (be sure not to blend to a paste). Spoon mixture back into potato shells; top with the remaining Cheddar and sprinkle with bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
