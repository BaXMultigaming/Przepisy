  "ingredients": [
    "1 pound cauliflower florets",
    "1 tablespoon grapeseed oil",
    "1 pinch ground cumin",
    "salt and ground black pepper to taste",
    "2 tablespoons tahini",
    "1 tablespoon Sriracha sauce",
    "2 teaspoons water, or as needed",
    "1 tablespoon chopped cilantro",
    "1 teaspoon sesame seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place a rimmed baking sheet inside to preheat for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss cauliflower with oil, cumin, salt, and pepper in a large bowl. Spread cauliflower carefully on the hot baking sheet. Set the bowl aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until tender and starting to brown, about 15 minutes. Stir and continue roasting until evenly browned, about 5 minutes longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stir tahini and Sriracha sauce together in the bowl. Thin with a little water. Add hot cauliflower and stir gently to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Plate cauliflower and garnish with cilantro and sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
