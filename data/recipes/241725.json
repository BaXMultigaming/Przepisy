  "ingredients": [
    "1 cup all-purpose flour",
    "2 teaspoons salt",
    "1 teaspoon paprika",
    "1 teaspoon garlic powder",
    "0.25 teaspoon ground black pepper",
    "6 cups vegetable oil for frying",
    "12 ounces frozen calamari rings, thawed and drained",
    "2 tablespoons cocktail sauce, or to taste",
    "1 lemon, quartered"
  ],
  "steps": [
    {
      "text": "Stir flour, 2 teaspoons salt, paprika, garlic powder, and black pepper together in a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press calamari rings into flour mixture until evenly coated, shaking off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry calamari rings, in batches, until golden brown, 3 to 4 minutes. Drain on a paper towel-lined plate. Sprinkle with salt. Serve calamari with cocktail sauce and lemon wedges. Repeat with remaining calamari rings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
