  "ingredients": [
    "2 turnips, peeled and sliced into 1/2-inch wedges",
    "1 small beet, thinly sliced",
    "2 cloves garlic, chopped",
    "1 cup distilled white vinegar",
    "1 cup water",
    "1 teaspoon white sugar",
    "1 teaspoon sea salt"
  ],
  "steps": [
    {
      "text": "Inspect two 16-ounce Mason jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until vegetables ready. Wash new, unused lids and rings in warm soapy water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide turnips, beet, and garlic between the hot, sterilized jars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine vinegar, water, sugar, and salt in a saucepan; bring to a boil and boil for 2 minutes. Pour vinegar mixture over turnip mixture, filling to within 1/2 inch of tops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wipe rims with a moist paper towel to remove any residue. Top jars with lids; screw rings on tightly. Pickle in the refrigerator for 1 week.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
