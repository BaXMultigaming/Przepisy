  "title": "Moist Chocolate Zucchini Cake",
  "description": "A delightful moist chocolate zucchini cake made with shredded zucchini and easy pantry ingredients. Delicious topped with cream cheese frosting.",
  "authors": [
    "Jeanrose"
  ],
  "date_published": "2020-06-18T23:06:39-04:00",
