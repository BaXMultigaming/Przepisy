  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter, melted",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup sour cream",
    "0.5 cup chopped walnuts",
    "2 medium bananas, sliced"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zeliJ9A6jO2kgFwV7ON3CZcUqg8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17066-janets-rich-banana-bread-VAT-step-01-03f0b469df704cee8e4f9562967767ba.jpg"
      ],
      "image": "assets/images/17066/step_01.webp"
    },
    {
      "text": "Stir sugar and melted butter together in a large bowl. Add eggs and vanilla; mix well. Combine flour, baking soda, and salt; stir into butter mixture until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v6AlCS2_YUqhLh0gGJgg5-w_4is=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17066-janets-rich-banana-bread-VAT-step-02-1-dfdd9a25278c4ea280a827e90b2b272b.jpg"
      ],
      "image": "assets/images/17066/step_02.webp"
    },
    {
      "text": "Fold in banana slices, sour cream, and walnuts; transfer into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IryjKAobR6WAhMHYk0VEGiWgyY0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17066-janets-rich-banana-bread-VAT-step-03-01-1f0d4307960a4f0396c8f54f02639101.jpg"
      ],
      "image": "assets/images/17066/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the loaf comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uT1g8paWHs9wiaZr346jMn91RPw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17066-janets-rich-banana-bread-VAT-step-04-1-044b9f920d1e492ca514ce86a74f1a73.jpg"
      ],
      "image": "assets/images/17066/step_04.webp"
    },
    {
      "text": "Cool loaf in the pan for 10 minutes before inverting onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/damyNKqXsJaajrIFWu1pKVnimGc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17066-janets-rich-banana-bread-VAT-step-05-1-6455eab804724496b64bd3e4b5e042fb.jpg"
      ],
      "image": "assets/images/17066/step_05.webp"
    },
    {
      "text": "Serve and enjoy!",
