  "ingredients": [
    "8 skinless, boneless chicken breasts",
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "0.33333331346512 cup water",
    "8 slices Swiss cheese",
    "2 cups Italian seasoned bread crumbs",
    "0.5 cup butter, cut into pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F(175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken breasts into a 9x13-inch baking dish. Spread condensed soup over chicken and pour in water. Top each breast with a slice of Swiss cheese, then sprinkle bread crumbs over top. Dot butter over bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink in the center and the juices run clear, about 45 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
