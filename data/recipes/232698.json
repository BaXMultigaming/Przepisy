        "https://www.allrecipes.com/thmb/6uAVcArEs0wfZTWYuVGRtvAZO18=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232698-fresh-cranberry-cake-VAT-step-07-caf9a51421c04a9580e3b43f9db2ee08.jpg"
