    "publisher-tested"
  ],
  "ingredients": [
    "4.5 cups all-purpose flour",
    "1.5 teaspoons salt",
    "0.5 cup shortening",
    "1.25 cups water, or as needed",
    "2 tablespoons olive oil",
    "1 small onion, chopped",
    "1.5 pounds ground beef",
    "2 tablespoons paprika",
    "1 tablespoon cumin",
    "0.5 teaspoon ground black pepper",
    "1 pinch salt",
    "0.5 cup raisins",
    "1 tablespoon white vinegar",
    "2 large hard-cooked eggs, peeled and chopped",
    "1 quart oil for frying, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mF5ctT14F4XpKWeujqVuytKryNA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/71805-fried-empanadas-ddmfs-step-01-4x3.8413-5f3b98b5e94a4bd587e71e1740c5a4fc.jpg"
      ],
      "image": "assets/images/71805/step_01.webp"
    },
    {
      "text": "Make the dough: Stir flour and salt together in a medium bowl. Cut in shortening using a pastry blender until the mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vUyFL-8yBDE-7MPXtiLFcXEsRUg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/71805-fried-empanadas-ddmfs-step-02-4x3.8419-c5edd250d94143fda158e7509be116d5.jpg"
      ],
      "image": "assets/images/71805/step_02.webp"
    },
    {
      "text": "Use a fork to stir in water, a few tablespoons at a time, until the mixture comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vCtsVs2CYbaUs1lKUCXPziiGvC8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/71805-fried-empanadas-ddmfs-step-03-4x3.8421-c3791604b3de4379bb43af9b876b601e.jpg"
      ],
      "image": "assets/images/71805/step_03.webp"
    },
    {
      "text": "Pat into a ball and flatten slightly. Wrap in plastic wrap and refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P06nsugjdlA45Y6F8qdwh1rfBJI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/71805-fried-empanadas-ddmfs-step-04-4x3.8423-069802bc075046319451c3478795ecc0.jpg"
      ],
      "image": "assets/images/71805/step_04.webp"
    },
    {
      "text": "Make the filling while dough is chilling: Heat oil in a large skillet over medium heat. Add onion and cook until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jE9g4q2ZtnYcUqOiNnKxIlFA35U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/71805-fried-empanadas-ddmfs-step-05-4x3.8428-885ae9e221cf4b4d81c7db41591f4466.jpg"
      ],
      "image": "assets/images/71805/step_05.webp"
    },
    {
      "text": "Add beef, paprika, cumin, pepper, and salt; cook and stir until beef is browned and crumbly, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/On4yfVFYfJYe-k3SBfCeWNc8_Xk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/71805-fried-empanadas-ddmfs-step-06-4x3.8433-21b70a0804494713bdf8d6784e017aac.jpg"
      ],
      "image": "assets/images/71805/step_06.webp"
    },
    {
      "text": "Drain excess grease, then stir in the raisins and vinegar. Cover and refrigerate until chilled, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sr-ksVF5kAjCFxXT678dQMWrr5A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/71805-fried-empanadas-ddmfs-step-07-4x3.8435-fb52b82ea5cb4214a052aee9380f8043.jpg"
      ],
      "image": "assets/images/71805/step_07.webp"
    },
    {
      "text": "Remove dough and filling from the refrigerator. Form dough into twenty-four 2-inch balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aATRBF9_EpXPcXZz0QcUUBV7TN8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/71805-fried-empanadas-ddmfs-step-09-4x3.8439-decca34e54ec44b4835f797712d84879.jpg"
      ],
      "image": "assets/images/71805/step_08.webp"
    },
    {
      "text": "Stir hard-cooked eggs into filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wyLkGaaV95zkadW4oCKuke2-Usc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/71805-fried-empanadas-ddmfs-step-08-4x3.8437-6a4ee396c09b4bff8a7feaec82aa8cd9.jpg"
      ],
      "image": "assets/images/71805/step_09.webp"
    },
    {
      "text": "Heat oil in a deep-fryer to 365 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the oil is heating, roll one ball dough on a floured surface into a thin circle. Spoon some filling onto the center, fold dough into a half-moon shape, and press the edges with your fingers to seal. Repeat to fill and form remaining empanadas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qz5ToSCs_PBa4eVbdkhJpYJ3T4c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/71805-fried-empanadas-ddmfs-step-11-4x3.8441-c850352747114db9b4fae37e7ebd7c2c.jpg"
      ],
      "image": "assets/images/71805/step_11.webp"
    },
    {
      "text": "Working in batches, fry 1 to 2 empanadas at a time in hot oil until browned, about 2 1/2 minutes per side. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dwJxHNH1_n5JsSAAjQout4DqB5g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/71805-fried-empanadas-VAT-Beauty-4x3-inline-e72fcc1d705e452f80021a6ad7e3c6d2.jpg"
      ],
      "image": "assets/images/71805/step_12.webp"
    }
  ],
