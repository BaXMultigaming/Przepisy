  "ingredients": [
    "1 head cabbage, finely shredded",
    "1 white onion, halved and sliced 1/4-inch thick",
    "1 large carrot, grated",
    "4 red bird's eye chile peppers, grated",
    "1.5 tablespoons salt, or to taste",
    "3 cups boiling water",
    "0.5 cup vinegar",
    "1 tablespoon oregano"
  ],
  "steps": [
    {
      "text": "Mix cabbage, onion, carrot, and chile peppers together in a large bowl. Sprinkle salt evenly on top. Cover with boiling water. Cool to room temperature, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour vinegar over cabbage mixture; add oregano. Mix together carefully.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate until flavors combine, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
