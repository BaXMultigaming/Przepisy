  "ingredients": [
    "4 boneless skinless chicken breasts, cut into 1/4-inch strips",
    "0.5 cup lime juice",
    "2 (1 ounce) packets taco seasoning mix (such as Old El Paso®)",
    "1.5 cups shredded mozzarella cheese, divided",
    "1 cup sour cream",
    "1 cup salsa",
    "salt and ground black pepper to taste",
    "1 (8 ounce) package no-boil lasagna noodles, or to taste"
  ],
  "steps": [
    {
      "text": "Combine chicken, lime juice, and taco seasoning in a large bowl. Stir to make sure chicken is evenly covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook chicken mixture over medium heat until firm, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1/2 cup mozzarella cheese, sour cream, and salsa in a bowl. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put a few spoonfuls of the sour cream mixture in the bottom of a 9x9-inch baking dish. Layer noodles and chicken on top. Cover with remaining 1 cup mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until noodles are tender and cheese is melted, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
