        "https://www.allrecipes.com/thmb/7h772bzBsXjj1XNId8tvhbSCkrQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Best-Tuna-Pasta-Salad-step-03-026-51110178486047e5957d282b41a8eaf7.jpg"
