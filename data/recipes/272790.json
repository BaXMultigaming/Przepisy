      ],
      "image": "assets/images/272790/step_02.webp"
    },
    {
      "text": "Transfer pasta and peas to a large bowl. Mix in tuna, celery, green onion, dill, and carrot until well blended.",
      "section": null,
      "name": null,
      "url": null,
