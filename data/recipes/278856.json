  "ingredients": [
    "1 cup baby carrots",
    "0.5 cup chopped onion",
    "1 (4 pound) roasting chicken",
    "1 tablespoon salted butter, or more as needed",
    "1 lemon",
    "1 tablespoon dried parsley",
    "0.5 teaspoon kosher salt",
    "0.5 teaspoon poultry seasoning",
    "0.25 teaspoon ground thyme",
    "0.25 teaspoon ground paprika"
  ],
  "steps": [
    {
      "text": "Place carrots and onion in the cavity of the chicken. Rub the skin with butter and place in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut lemon in half and squeeze juice all over the chicken. Cut juiced lemon halves into wheels and place around chicken. Sprinkle parsley, salt, poultry seasoning, thyme, and paprika over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low for 8 to 10 hours or High for 4 to 5 hours. An instant-read thermometer inserted into the thickest part of the thigh, near the bone, should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
