  "ingredients": [
    "1 tablespoon vegetable oil",
    "4 (6 ounce) pork chops, 1 1/2 to 2-inches thick",
    "0.5 teaspoon salt",
    "0.5 teaspoon sage",
    "2 medium tart apples, cored and sliced",
    "0.25 cup brown sugar",
    "2 tablespoons all-purpose flour",
    "1 cup hot water",
    "1 tablespoon white vinegar",
    "0.5 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Season pork chops with salt and sage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Cook chops on each side until browned, about 3 minutes per side. Transfer to a baking dish; reserve drippings in the skillet. Cover chops with apple slices; sprinkle with brown sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour into drippings in the skillet until smooth. Whisk in water and vinegar; simmer over medium-high heat, stirring constantly, until thick. Add raisins; pour over chops. Cover the baking dish with aluminum foil or a lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour, uncover during the last 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
