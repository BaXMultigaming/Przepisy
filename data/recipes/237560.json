  "ingredients": [
    "1 cup rolled oats",
    "1 cup slivered almonds",
    "1 cup wheat germ",
    "1 cup flaked coconut",
    "1.5 cups white sugar",
    "0.5 cup butter",
    "0.5 cup milk",
    "0.25 cup unsweetened cocoa powder"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, almonds, wheat germ, and coconut together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, butter, milk, and cocoa powder together in a saucepan; bring to a boil. Cook and stir cocoa mixture until smooth, about 5 minutes. Pour cocoa mixture over oat mixture; stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop oat mixture, about 1 tablespoon per cookie, onto the prepared baking sheet. Chill in the refrigerator until set, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
