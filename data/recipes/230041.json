  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter, melted",
    "1 egg, beaten",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "1 pinch ground nutmeg",
    "2 cups grated raw sweet potatoes",
    "1 orange, zested",
    "0.5 orange, juiced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
