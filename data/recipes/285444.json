  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "1 cup unsweetened cocoa powder",
    "1.5 teaspoons baking soda",
    "1.5 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.25 teaspoon unsalted butter, softened",
    "2 cups white sugar",
    "3 large eggs",
    "2 teaspoons vanilla extract",
    "1.5 cups milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Generously grease a 6-cup jumbo muffin pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cocoa powder, baking soda, baking powder, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter until smooth in a large bowl. Add sugar and beat for 1 minute. Add eggs and vanilla and beat until thoroughly mixed. Stir in dry ingredients. Add milk and mix until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill the prepared muffin cups 3/4 full with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the centers comes out clean, about 35 minutes. Cool in the pan for 5 minutes. Transfer to a wire rack and let cool completely, about 25 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
