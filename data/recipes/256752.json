  "title": "Awesome Crispy Baked Chicken Wings",
  "description": "These crispy baked chicken wings are easy to make with garlic butter and Parmesan for deliciously crispy skin on the outside, tender and juicy inside.",
  "authors": [
    "MARKANDANGIE"
  ],
  "date_published": "2018-06-27T09:03:02-04:00",
