  "ingredients": [
    "1 (8 ounce) can artichoke hearts, drained and chopped",
    "1 (8 ounce) container cream cheese-style spread (such as Kite Hill™), room temperature",
    "0.5 (6 ounce) package fresh spinach, chopped",
    "2 tablespoons all-purpose flour",
    "0.75 teaspoon garlic salt",
    "0.25 teaspoon thyme leaves",
    "0.25 teaspoon red pepper flakes",
    "cooking spray",
    "1 cup grated Parmesan-style vegan cheese (such as Follow Your Heart®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix artichoke hearts, cream cheese spread, spinach, flour, garlic salt, thyme, and red pepper flakes together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat a large nonstick baking pan with cooking spray; fill pan with the artichoke mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center is hot and dip is bubbling, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle the top of the dip with Parmesan-style cheese.",
