  "ingredients": [
    "vegetable oil cooking spray",
    "8 (4 ounce) skinless salmon fillets",
    "4 tablespoons salted butter",
    "2.5 tablespoons fresh lemon juice",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a baking dish with cooking spray and place salmon fillets in the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a microwave-safe bowl and microwave on high in 30-second increments until melted, 30 seconds to 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix lemon juice, salt, and pepper into the melted butter; pour over the salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 12 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
