  "ingredients": [
    "2.75 cups all-purpose flour",
    "1 tablespoon ground cinnamon",
    "2 teaspoons baking powder",
    "2 teaspoons pumpkin pie spice",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground allspice",
    "1 cup white sugar",
    "3 eggs, room temperature",
    "0.5 cup butter, melted and cooled",
    "1.5 cups canned pumpkin puree",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat pizzelle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cinnamon, baking powder, pumpkin pie spice, nutmeg, and allspice in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and eggs with an electric mixer in a separate bowl until smooth. Beat in the butter until blended, then add pumpkin purée and vanilla extract. Add flour mixture and mix on medium speed until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop a tablespoon of batter onto the preheated iron. Bake until golden, 30 to 40 seconds. Cool on waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
