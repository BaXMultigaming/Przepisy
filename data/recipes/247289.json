  "ingredients": [
    "2 pounds 99%-lean ground turkey",
    "1 small onion, minced",
    "0.5 cup panko bread crumbs",
    "0.25 cup Buffalo wing sauce",
    "0.25 cup chopped fresh parsley",
    "1 egg",
    "3 cloves garlic, minced",
    "1 teaspoon salt",
    "0.5 teaspoon celery seed",
    "0.25 teaspoon ground black pepper",
    "1 pinch cayenne pepper",
    "1 pinch paprika",
    "12 hamburger buns, split",
    "12 slices Monterey Jack cheese",
    "6 tablespoons ranch dressing, or to taste",
    "6 tablespoons Buffalo wing sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat a George Foreman Grill or an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground turkey, onion, panko bread crumbs, ¼ cup Buffalo wing sauce, parsley, egg, garlic, salt, celery seeds, black pepper, cayenne pepper, and paprika in a large bowl; form into 12 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook patties on the preheated grill for 3 minutes; flip. Continue cooking until cooked through, about 2 minutes more. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place each burger inside a bun; top each burger with 1 slice Monterey Jack cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ranch dressing and 6 tablespoons Buffalo wing sauce in a bowl; divide and spread onto each burger.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
