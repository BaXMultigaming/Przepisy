  "steps": [
    {
      "text": "Combine milk, bread crumbs, Worcestershire sauce, and salt in a large bowl. Add ground beef and mix well. Shape into 36 to 48 meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large nonstick skillet over medium heat. Cook meatballs in batches until browned, 2 to 3 minutes per side. Transfer to a plate and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beef broth, tomatoes, corn, celery, cabbage, onion, zucchini, wine, parsley, oregano, basil, garlic powder, salt, and pepper in a large pot. Stir in browned meatballs. Simmer soup until vegetables are tender, 35 to 40 minutes. Stir in broken spaghetti and cook until tender, about 20 minutes more.",
      "section": null,
