    "0.33333334326744 cup milk",
    "0.33333334326744 cup bread crumbs",
    "1.5 teaspoons Worcestershire sauce",
    "0.5 teaspoon salt",
    "1.5 pounds ground beef",
    "4 cups beef broth",
    "1 (28 ounce) can whole peeled tomatoes",
    "1 (12 ounce) can corn, drained",
