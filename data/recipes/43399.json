  "ingredients": [
    "1.5 cups packed fresh mint leaves and stems",
    "2.25 cups boiling water",
    "2 tablespoons lemon juice",
    "1 drop green food color",
    "3.5 cups white sugar",
    "3 fluid ounces liquid pectin"
  ],
  "steps": [
    {
      "text": "Rinse off mint leaves and stems; place them into a medium saucepan. Crush with a potato masher or the bottom of a jar or glass. Add boiling water; cover and let stand for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YhsRe2uCaRXvzgksMRBCedIqchk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/43399-mint-jelly-ddmfs-Step-2-00b61833164d40f4811623600fd297f3.jpg"
      ],
      "image": "assets/images/43399/step_01.webp"
    },
    {
      "text": "Strain mint mixture; measure out 1 2/3 cups mint and return to the saucepan. Stir in lemon juice and food coloring. Mix in sugar and place the pan over high heat. Bring to a boil, stirring constantly. Stir in pectin; boil mixture for 1 minute, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UCn_M3otLXUYoIHAGPJVYxFGThQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/43399-mint-jelly-ddmfs-Step-4-865c02d9778a485ebb92e03468643511.jpg"
      ],
      "image": "assets/images/43399/step_02.webp"
    },
    {
      "text": "Remove from heat and skim foam off the top using a large metal spoon. Transfer mixture to hot, sterile jars and seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-TmWYOlglWWMRg4lxaElOeQnfK0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/43399-mint-jelly-ddmfs-Step-5-7cee55ccbea840bba8abe9da22b227b6.jpg"
      ],
      "image": "assets/images/43399/step_03.webp"
    },
    {
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil over high heat, then carefully lower the jars into the pot using a holder. Leave a 2-inch space between the jars. Pour in more boiling water if necessary until the water level is at least 1 inch above the tops of the jars. Bring water to a full boil, cover the pot, and process for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
