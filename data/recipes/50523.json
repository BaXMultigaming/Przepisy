  "ingredients": [
    "0.5 pound thick sliced bacon",
    "1 (10 ounce) package frozen chopped spinach, thawed",
    "2 tablespoons olive oil",
    "1 onion, finely diced",
    "0.5 pound fresh mushrooms, finely diced",
    "2 cups finely diced smoked ham",
    "1 (8 ounce) container sour cream",
    "salt and pepper to taste",
    "2 (9 inch) unbaked pie crusts",
    "8 ounces Monterey Jack cheese, shredded",
    "8 ounces Cheddar cheese, shredded",
    "4 ounces Parmesan cheese, grated",
    "8 eggs",
    "1.5 cups half-and-half cream",
    "1 tablespoon dried parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in a large, deep skillet over medium-high heat, turning occasionally, until evenly brown. Drain on paper towels. Crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook spinach according to package instructions. Allow to cool, then squeeze dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in the skillet over medium heat. Sauté onion until soft and translucent. Stir in mushrooms; cook until soft, about 2 minutes. Stir in ham and bacon. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sour cream and spinach; season with salt and pepper. Divide evenly between crusts, then divide and arrange bacon mixture on top. Combine Monterey Jack, Cheddar, and Parmesan; divide and sprinkle over bacon mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, half-and-half, and parsley together in a separate bowl; season with salt and pepper. Divide and pour into crusts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange quiche on a baking sheet; bake in the preheated oven on middle shelf until tops puffed and golden brown, 40 minutes. Remove from oven; let stand 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
