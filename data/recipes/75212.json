  "ingredients": [
    "0.66666668653488 cup chopped fresh cilantro",
    "2 tablespoons coarse black pepper",
    "2 teaspoons garlic powder",
    "2 teaspoons onion salt",
    "0.5 cup margarita mix",
    "0.25 cup lime juice",
    "0.25 cup orange juice",
    "3 tablespoons tequila",
    "3 tablespoons triple sec",
    "2 tablespoons honey",
    "1 cup light olive oil",
    "6 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Place cilantro, pepper, garlic powder, and onion salt in the bowl of a blender. Pour in margarita mix, lime juice, orange juice, tequila, triple sec, and honey. Puree on high speed until smooth, then reduce speed to medium-low, and slowly add the olive oil; blend until creamy. Place chicken breasts in a resealable plastic bag or glass bowl; pour marinade overtop and toss to coat. Refrigerate for 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from the marinade, shake off excess, and discard remaining marinade. Grill the chicken until tender and juices run clear, approximately 7 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
