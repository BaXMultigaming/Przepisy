  "ingredients": [
    "1 cup brown rice flour",
    "0.5 cup tapioca starch",
    "0.5 cup potato starch",
    "2.5 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "1 pinch ground ginger",
    "1 pinch ground cloves",
    "0.5 cup quinoa",
    "0.5 cup flax seeds",
    "0.5 cup toasted almonds",
    "0.25 cup sunflower seeds",
    "1 cup plain yogurt",
    "0.75 cup brown sugar",
    "3 eggs, room temperature",
    "0.5 cup coconut oil",
    "0.5 cup agave nectar",
    "2 teaspoons vanilla extract",
    "2 cups shredded zucchini, squeezed dry",
    "2 cups shredded carrot",
    "1 apple, grated",
    "0.75 cup raisins, soaked in hot water and drained"
  ],
  "steps": [
    {
      "text": "Lightly grease 18 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift brown rice flour, tapioca starch, potato starch, cinnamon, baking soda, baking powder, salt, nutmeg, ginger, and cloves together into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place quinoa, flax seeds, almonds, and sunflower seeds in a coffee grinder; pulse until finely ground. Add ground quinoa mixture to rice flour mixture; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat yogurt, brown sugar, eggs, coconut oil, agave nectar, and vanilla together in a large bowl until well combined; stir in rice flour mixture until batter is just blended. Fold in zucchini, carrot, apple, and raisins; divide batter between the prepared muffin cups. Rest batter at room temperature for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 25 to 30 minutes. Cool in the tins for 10 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
