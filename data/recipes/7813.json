  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "1 cup milk",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "3 eggs",
    "0.33333298563957 cup vegetable oil",
    "1.5 cups white sugar",
    "1 cup butter",
    "1 cup fresh lemon juice",
    "6 egg yolks",
    "0.25 cup all-purpose flour",
    "4 tablespoons grated lemon zest"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour three 9-inch round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cake mix, milk, instant vanilla pudding, 3 whole eggs, and oil in a large bowl. Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of cakes comes out clean, about 25 minutes. Set aside cakes on wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, butter, lemon juice, 6 egg yolks, flour, and lemon zest in the top half of a double boiler. Cook, stirring constantly, over medium heat until mixture is thick enough to spread. Remove from heat and allow lemon curd to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Run a knife around the edges of the cake pans. Invert cakes; spread cooled lemon curd between cake layers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
