  "ingredients": [
    "1.5 cups white sugar",
    "0.5 cup butter, melted",
    "2 eggs",
    "2 cups self-rising flour",
    "1 teaspoon vanilla extract",
    "1 (16 ounce) can fruit cocktail"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9 x 13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix sugar and melted butter or margarine. Add eggs, and beat well. Mix in flour and vanilla. Stir in fruit cocktail. Pour batter into prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 to 35 minutes, or until cake tests done.",
      "section": null,
