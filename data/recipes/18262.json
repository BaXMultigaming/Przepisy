  "ingredients": [
    "20 buttery round crackers, crushed",
    "black pepper to taste",
    "1 teaspoon garlic powder",
    "1 pound sea scallops, rinsed and drained",
    "0.5 cup butter, melted",
    "0.25 cup dry white wine",
    "0.5 lemon, juiced",
    "1 tablespoon chopped fresh parsley, for garnish"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease an 8x8 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine crushed crackers, black pepper and garlic powder in a small bowl. Press scallops into mixture so that they are evenly coated, and place them in the greased baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, mix together melted butter, wine and lemon juice; drizzle mixture over scallops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until scallops are lightly browned, about 15 minutes. Garnish with chopped parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
