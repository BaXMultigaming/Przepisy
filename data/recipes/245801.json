  "ingredients": [
    "6 tablespoons soy sauce",
    "2 tablespoons seasoned rice vinegar",
    "2 cloves garlic, pressed",
    "2 teaspoons sesame oil",
    "2 teaspoons tahini",
    "1 teaspoon molasses",
    "1 teaspoon apricot jam",
    "0.66666668653488 teaspoon brown sugar",
    "0.66666668653488 teaspoon miso paste",
    "0.25 teaspoon Chinese five-spice powder",
    "0.125 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Place soy sauce, rice vinegar, garlic, sesame oil, tahini, molasses, apricot jam, brown sugar, miso, five-spice powder, and red pepper flakes in a jar with a tight-fitting lid. Seal jar and shake vigorously to combine.",
