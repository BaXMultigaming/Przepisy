  "ingredients": [
    "cooking spray",
    "2 eggs, lightly beaten",
    "3 tablespoons mayonnaise",
    "1 teaspoon prepared horseradish",
    "1 teaspoon dried parsley",
    "0.5 teaspoon paprika",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon ground black pepper",
    "1 (5 ounce) can tuna packed in water",
    "1 cup soft bread crumbs",
    "0.5 cup chopped onion"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Prepare a glass loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, mayonnaise, horseradish, parsley, paprika, cayenne pepper, and black pepper together in a large bowl until smooth. Add tuna in water, bread crumbs, and onion; mix until evenly moistened. Pack tuna mixture into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until hot and fully cooked in the center, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
