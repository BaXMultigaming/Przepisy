  "ingredients": [
    "0.25 cup butter",
    "6 tablespoons all-purpose flour",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon salt",
    "0.25 teaspoon pepper",
    "2.5 cups milk",
    "0.75 cup shredded Cheddar cheese",
    "0.75 cup shredded Swiss cheese",
    "6 large russet potatoes, sliced into 1/4 inch slices",
    "1 small onion, finely chopped",
    "1 pound cooked ham, chopped",
    "1 (16 ounce) package frozen cauliflower",
    "0.25 cup crushed cornflakes cereal"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease a medium baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To prepare the cheese sauce, melt butter in a medium saucepan over medium heat. Whisk in flour, garlic powder, salt, and pepper. Mix in milk, and stir constantly until thickened. Mix in Cheddar cheese and Swiss cheese, and continue to stir until smooth. Reduce heat to low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer potatoes in the bottom of the prepared baking dish. Layer onion and ham over potatoes. Top with cauliflower. Cover with the cheese sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake covered 1 hour in the preheated oven. Remove cover, sprinkle with crushed cornflakes, and continue baking 10 minutes, until vegetables are tender and surface is bubbly and lightly browned. Allow to cool about 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
