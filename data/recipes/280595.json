  "ingredients": [
    "12 ounces extra-lean ground beef",
    "2 cups water",
    "1 (14.5 ounce) can diced tomatoes in juice, undrained",
    "1 (4 ounce) can Ortega® Mild Diced Green Chiles",
    "1 (1.25 ounce) package Ortega® Taco Seasoning Mix",
    "0.5 cup dried elbow macaroni",
    "1 cup shredded Cheddar cheese, divided",
    "0.66666668653488 cup evaporated milk"
  ],
  "steps": [
    {
      "text": "Cook beef in a large skillet, stirring frequently, until brown; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in water, tomatoes with juice, chiles, and seasoning mix. Cook until mixture comes to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pasta; return to a boil. Reduce heat to low; cover. Cook, stirring occasionally, for 14 to 16 minutes or until pasta is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in evaporated milk. Remove from heat; stir in 1/4 cup cheese. Sprinkle remaining cheese over top. Cover; let stand for 5 to 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
