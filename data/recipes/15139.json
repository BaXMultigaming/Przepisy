  "ingredients": [
    "0.5 cup butter",
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "1 teaspoon baking powder",
    "1 cup milk",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Place butter in a 9x13-inch baking dish and set it on the oven rack to melt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, sugar, and baking powder in a medium bowl. Stir in milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the baking dish from the oven as soon as butter is melted. Pour batter into the dish, but do not stir. Pour fruit evenly into the pan and do not stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase oven temperature to 350 degrees F (175 degrees C). Bake until fruit is bubbling and cobbler is golden on top, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
