  "ingredients": [
    "1 pound fingerling potatoes, halved lengthwise",
    "2 cloves garlic, minced",
    "2 tablespoons grated Parmesan cheese",
    "1 teaspoon lemon zest",
    "0.5 teaspoon salt",
    "0.25 teaspoon freshly ground black pepper",
    "2 tablespoons olive oil",
    "1 tablespoon butter",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jhDMfhpbktCQL30v6LqUhLv0VAE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269519-roasted-garlic-parmesan-fingerling-potatoes-ddmfs-4x3-step-01-1533-8be4117d8a504cb4abcef13aa2d9a250.jpg"
      ],
      "image": "assets/images/269519/step_01.webp"
    },
    {
      "text": "Toss potatoes, garlic, Parmesan cheese, lemon zest, salt, and black pepper together in a bowl. Drizzle with olive oil and toss again until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qC3mzAO7UIBVne6gjelKWL1GQZU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269519-roasted-garlic-parmesan-fingerling-potatoes-ddmfs-4x3-step-02-1536-791fba007c2d4feb920f9e15bab7a423.jpg"
      ],
      "image": "assets/images/269519/step_02.webp"
    },
    {
      "text": "Heat a cast-iron skillet over medium-high heat. Add butter and heat until melted. Add potatoes; cook and toss until evenly coated with butter, about 2 minutes. Move the skillet to the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Yq5VnG-j1sEksczfail1KfBXwF4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269519-roasted-garlic-parmesan-fingerling-potatoes-ddmfs-4x3-step-03-1538-7859f2ac37d4489e8cfdca2b6d00335c.jpg"
      ],
      "image": "assets/images/269519/step_03.webp"
    },
    {
      "text": "Roast in the preheated oven until soft, 15 to 20 minutes, tossing halfway through. Remove from oven and top with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KV_-T7LE5NlUb__U9cRV9OSd3ks=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269519-roasted-garlic-parmesan-fingerling-potatoes-ddmfs-4x3-step-04-1565-acc14e5b49534e88821fc9d7615488f0.jpg"
      ],
      "image": "assets/images/269519/step_04.webp"
    }
