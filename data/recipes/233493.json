  "ingredients": [
    "1.6666667461395 cups all-purpose flour",
    "2 tablespoons ground cinnamon",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.75 cup butter, softened",
    "0.75 cup firmly packed brown sugar",
    "0.33333334326744 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 large egg",
    "1.5 cups cinnamon chips",
    "1.5 cups cinnamon candies (such as Red Hots®)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, cinnamon, baking powder, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, white sugar, and vanilla with an electric mixer in a large bowl until smooth. Beat in the egg until completely incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually beat flour mixture into butter mixture until combined. Fold in cinnamon chips and cinnamon candies, mixing just enough to evenly combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of the dough 2 inches apart onto ungreased baking sheets. Bake in the preheated oven until lightly browned, 8 to 11 minutes. Cool on the pans for 2 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
