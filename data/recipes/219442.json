  "ingredients": [
    "1.5 cups water",
    "0.75 cup uncooked brown rice",
    "2 cups low-fat milk, divided",
    "0.33333334326744 cup white sugar",
    "0.25 teaspoon salt",
    "1 large egg, beaten",
    "0.66666668653488 cup raisins",
    "1 tablespoon butter",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LLlncT0SFD7LGS92bwIE1HiBi8E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-219442-healthier-creamy-rice-pudding-DDMFS-4x3-step-01-444cac9c78174af1969cd51c123fa02e.jpg"
      ],
      "image": "assets/images/219442/step_01.webp"
    },
    {
      "text": "Combine water and rice over high heat in a saucepan and bring to a boil. Reduce heat to medium-low, cover, and simmer until tender, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7KvJOFa6CC6mj1vG09bxhxALogw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-219442-healthier-creamy-rice-pudding-DDMFS-4x3-step-02-9681a20f6287400bb650770316b20478.jpg"
      ],
      "image": "assets/images/219442/step_02.webp"
    },
    {
      "text": "Combine cooked rice, 1 1/2 cups milk, sugar, and salt in a clean saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sJYyzJNkbGF5X_fIgAoAvH4xHyg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-219442-healthier-creamy-rice-pudding-DDMFS-4x3-step-03-8489ea1f6e3540c884ed53333730fa00.jpg"
      ],
      "image": "assets/images/219442/step_03.webp"
    },
    {
      "text": "Cook over medium heat until thick and creamy, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w-3qNnpUbbMmqMKSJs_8frDs1Po=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-219442-healthier-creamy-rice-pudding-DDMFS-4x3-step-04-f0417db160ba4b46bf5927d580c0c3dc.jpg"
      ],
      "image": "assets/images/219442/step_04.webp"
    },
    {
      "text": "Stir in remaining 1/2 cup milk, beaten egg, and raisins. Cook 2 minutes more, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cTJntqprN6HFjt14SxumKQEQOOI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-219442-healthier-creamy-rice-pudding-DDMFS-4x3-step-05-f3e624b7a63145aca374d4c042d1b834.jpg"
      ],
      "image": "assets/images/219442/step_05.webp"
    },
    {
      "text": "Remove from heat and stir in butter and vanilla. Serve warm.",
