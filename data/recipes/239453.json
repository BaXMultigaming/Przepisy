  "ingredients": [
    "1.5 cups Mott's® Natural Applesauce",
    "8 cups thinly sliced unpeeled apples",
    "2 tablespoons granulated sugar",
    "4.5 teaspoons ReaLemon® Lemon Juice",
    "4 teaspoons ground cinnamon, divided",
    "1 cup uncooked rolled oats",
    "0.5 cup firmly packed light brown sugar",
    "0.33333334326744 cup all-purpose flour",
    "0.33333334326744 cup evaporated skim milk",
    "0.25 cup nonfat dry milk powder",
    "1 cup vanilla nonfat yogurt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Spray 2-quart casserole dish with nonstick cooking spray. In large bowl, toss apple slices with granulated sugar, lemon juice and 2 teaspoons cinnamon. Spoon into prepared dish. Spread applesauce evenly over apple mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In medium bowl, combine oats, brown sugar, flour, evaporated milk, dry milk powder and remaining 2 teaspoons cinnamon. Spread over applesauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 35-40 minutes or until lightly browned and bubbly. Cool slightly. Serve warm. Top each serving with a dollop of yogurt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
