  "ingredients": [
    "27 ounces Bavarian-style sauerkraut, undrained",
    "1 (16 ounce) can whole cranberry sauce",
    "1 (12 ounce) bottle tomato-based chili sauce",
    "1 cup water",
    "1 cup packed brown sugar",
    "1 (16 ounce) package frozen meatballs"
  ],
  "steps": [
    {
      "text": "Mix sauerkraut, cranberry sauce, chili sauce, water, and brown sugar together in a mixing bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place meatballs into a slow cooker. Pour in sauce and mix until meatballs are coated. Cover and cook on Medium, stirring occasionally, until an instant-read thermometer inserted into the center reads at least 160 degrees F (71 degrees C), about 4 hours.",
