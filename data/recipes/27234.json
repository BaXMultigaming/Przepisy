  "ingredients": [
    "4 cups all-purpose flour",
    "2 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "1 teaspoon ground cloves",
    "1 teaspoon ground nutmeg",
    "1 cup butter",
    "2 cups white sugar",
    "2 eggs",
    "2.5 cups applesauce",
    "1.5 cups chopped walnuts",
    "2 cups raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease and flour a 9x13 inch pan. Mix together the flour, baking soda, cinnamon, cloves and nutmeg. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter and sugar until light and fluffy. Beat in the eggs one at a time. Beat in the flour mixture alternately with the applesauce. Fold in the walnuts and raisins. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 to 45 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
