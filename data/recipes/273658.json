  "ingredients": [
    "1 pound ground chicken",
    "0.5 cup mozzarella cheese, shredded",
    "0.25 cup freshly grated Parmesan cheese",
    "3 cloves garlic, minced",
    "1 teaspoon Italian seasoning",
    "0.5 teaspoon salt",
    "0.25 teaspoon pepper",
    "1 tablespoon chopped fresh basil"
  ],
