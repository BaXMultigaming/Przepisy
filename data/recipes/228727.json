  "ingredients": [
    "1 tablespoon olive oil",
    "1 sweet onion, diced",
    "4 cloves garlic, minced",
    "1 (8 ounce) package fresh mushrooms, chopped",
    "1 red bell pepper, diced",
    "1 cup fresh flat-leaf parsley, torn",
    "2 tablespoons oregano",
    "2 tablespoons white sugar",
    "2 teaspoons dried basil",
    "1 teaspoon dried rosemary",
    "0.5 teaspoon dried sage",
    "0.5 teaspoon red pepper flakes",
    "0.5 teaspoon salt",
    "ground black pepper to taste",
    "1 (28 ounce) can tomato sauce"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a saucepan over medium heat. Cook and stir onion and garlic until fragrant, about 2 minutes. Add mushrooms, red bell pepper, and parsley; cook and stir until mushrooms are slightly softened, about 2 minutes. Add oregano, sugar, basil, rosemary, sage, red pepper flakes, salt, and black pepper; stir to combine, 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomato sauce into seasoned onion-mushroom mixture; cook over low heat until flavors have combined, 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer half the sauce to a blender; blend until smooth. Return to saucepan with the remaining sauce; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
