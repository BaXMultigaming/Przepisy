  "title": "Fluffy Chocolate Chip Cookies",
  "description": "Fluffy chocolate chip cookies are easy to prepare when you cream margarine, brown sugar, and white sugar together before making the dough.",
  "authors": [
    "ctrew"
  ],
  "date_published": "2020-06-19T00:03:30-04:00",
