  "ingredients": [
    "1 cup packed light brown sugar",
    "0.25 cup butter, softened",
    "0.5 cup quick cooking oats",
    "0.5 cup pumpkin butter",
    "1 egg",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon pumpkin pie spice",
    "0.5 teaspoon ground cinnamon",
    "2 tablespoons milk",
    "0.5 cup chopped pecans",
    "0.5 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter together in a bowl with an electric mixer until smooth; beat in oats, pumpkin butter, and egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, baking powder, salt, pumpkin pie spice, and cinnamon in a separate bowl: add to sugar mixture, alternating with milk, beating after each addition. Fold in pecans and raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 15 minutes. Cool on the baking sheets briefly before transferring cookies to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
