  "title": "Monster Sour Cream Enchiladas",
  "description": "Muenster and longhorn cheeses top corn tortillas stuffed with shredded chicken, sour cream and green chilies to make these the creamiest enchiladas ever.",
  "authors": [
    "Teri Barker"
  ],
  "date_published": "1999-04-24T11:10:31-04:00",
