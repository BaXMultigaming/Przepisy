  "ingredients": [
    "2 cups white sugar",
    "1.5 cups vegetable oil",
    "1.5 cups chopped pecans",
    "3 cups all-purpose flour",
    "2 bananas, peeled and diced",
    "3 eggs",
    "1 (20 ounce) can crushed pineapple with juice",
    "1 teaspoon vanilla extract",
    "1 teaspoon salt",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Mix together sugar, vegetable oil, pecans, flour, and bananas in a 13 x 9 inch pan. Stir in the eggs, pineapple (with juice), vanilla, salt and baking soda. Mix well. Do not mash the bananas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 350 degrees F (175 degrees C) oven for 60 minutes or until cake tests done.",
      "section": null,
