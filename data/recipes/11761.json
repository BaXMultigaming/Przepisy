  "ingredients": [
    "1.25 cups torn spinach leaves",
    "2 tablespoons water",
    "1 egg",
    "0.5 teaspoon salt",
    "1.25 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Combine spinach and water in a saucepan. Cover, and cook till spinach is very tender. Cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place spinach and liquid in a blender container. Add egg and salt. Cover, and blend till smooth. Transfer to a bowl. Add enough flour to make a stiff dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a lightly floured surface. Knead for 1 minute. Roll very thin on a floured surface. Let rest 20 minutes. Roll up loosely. Slice 1/4 inch wide. Unroll. Cut into desired lengths. Spread out on a rack to dry for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
