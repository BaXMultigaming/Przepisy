  "title": "My Best Beef Brisket",
  "description": "Beef brisket marinated in beef broth, soy sauce, and liquid smoke is baked in the oven for 6 hours at 325 degrees F and served with a creamy horseradish sauce.",
  "authors": [
    "Kimber"
  ],
  "date_published": "2019-07-10T02:52:32-04:00",
