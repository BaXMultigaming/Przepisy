  "ingredients": [
    "1 (5 pound) beef brisket",
    "1 (10.5 ounce) can beef broth",
    "0.75 cup soy sauce",
    "0.25 cup lemon juice",
    "0.75 tablespoon liquid smoke flavoring",
    "1 (8 ounce) package cream cheese, at room temperature",
    "1 tablespoon prepared horseradish"
  ],
  "steps": [
    {
      "text": "Place brisket in a stainless steel or glass container. Whisk broth, soy sauce, lemon juice, and liquid smoke together in a small bowl; pour over brisket. Cover and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to cook, preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer brisket to a 9x13-inch baking dish; discard marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fork-tender, about 6 hours. An instant-read thermometer inserted into the center should read between 195 and 205 degrees F (91 and 96 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese and horseradish together in a small bowl until well combined. Serve with brisket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
