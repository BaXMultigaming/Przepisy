  "title": "Apple-Cinnamon Muffins",
  "description": "Grated and chopped fresh apples add fruity flavor to these delicious cinnamon-flavored muffins that are super simple to make.",
  "authors": [
    "hike4diamonds"
  ],
  "date_published": "2013-11-26T13:29:51-05:00",
