  "title": "Detroit-Style Pizza",
  "description": "This Detroit-style pizza recipe from Chef John has plenty of cheese, which fries as it bakes, resulting in a crunchy, crispy, cheese-laden crust.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2018-10-03T00:07:04-04:00",
  "date_modified": "2026-04-29T12:29:51-04:00",
  "prep_time": "PT25M",
  "cook_time": "PT15M",
  "total_time": "PT105M",
  "yield": [
    "9",
    "1 14x10-inch pizza"
  ],
  "categories": [
    "Dinner"
  ],
  "cuisines": [
    "U.S.",
