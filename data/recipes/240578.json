  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift all-purpose flour, cake flour, baking powder, and salt together into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter together with an electric mixer in a large bowl until smooth. Beat egg and vanilla extract into the creamy sugar mixture until smooth. Add the flour mixture and stir until just incorporated. Stir strawberries and 1/2 cup marshmallows into the batter; pour into the prepared dish. Sprinkle 2 tablespoons miniature marshmallows atop the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until set in the center, about 25 minutes.",
