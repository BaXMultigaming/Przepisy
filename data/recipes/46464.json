    },
    {
      "text": "Preheat an outdoor grill for high heat, and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill steaks on the prepared grill 5 to 7 minutes per side, to desired doneness. Discard remaining marinade.",
