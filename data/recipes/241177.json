  "ingredients": [
    "2 cups hot water",
    "2 teaspoons chicken bouillon granules",
    "2 (15 ounce) cans Great Northern beans",
    "0.33333334326744 cup diced carrots",
    "0.33333334326744 cup diced onion",
    "1 small stalk celery, diced",
    "0.5 teaspoon minced garlic",
    "1 bay leaf",
    "0.25 teaspoon ground black pepper",
    "0.5 (8 ounce) pre-cooked ham steak, diced",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a pot; add chicken bouillon and stir until dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain and rinse 1 can Great Northern beans. Reduce heat to low; stir drained beans and remaining can of undrained beans into bouillon mixture. Add carrots, onion, celery, garlic, bay leaf, and black pepper; bring soup to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir ham into soup, reduce heat to low, and simmer until vegetables are tender, about 30 minutes. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
