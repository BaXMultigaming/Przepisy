  "ingredients": [
    "6 (1-inch thick) boneless pork chops",
    "1 tablespoon adobo seasoning",
    "1 (.18 ounce) packet sazon seasoning",
    "0.5 teaspoon garlic powder",
    "0.33333334326744 teaspoon ground black pepper",
    "0.25 teaspoon salt",
    "3 tablespoons Italian dressing, divided",
    "1.5 cups water",
    "0.25 cup margarine",
    "6 (6 ounce) packages dry stuffing mix (such as Stove Top®)",
    "toothpicks",
    "1 tablespoon water, or as desired"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
