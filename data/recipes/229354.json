  "ingredients": [
    "2 cups cone-shaped corn snacks (such as Bugles®)",
    "2 cups cheese-flavored crackers (such as Cheez-It®)",
    "2 cups small pretzels",
    "1 cup crispy corn cereal squares (such as Corn Chex®)",
    "1 cup mini shredded wheat cereal squares",
    "1 cup pecan halves",
    "0.5 cup butter, melted",
    "1 tablespoon maple syrup",
    "1.5 teaspoons Worcestershire sauce",
    "0.75 teaspoon Cajun seasoning",
    "0.25 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 250 degrees F (120 degrees C).",
