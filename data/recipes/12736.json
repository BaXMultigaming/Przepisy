  "ingredients": [
    "3 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon salt",
    "1 cup milk",
    "2 pounds red snapper fillets",
    "0.5 pound cooked medium shrimp, peeled and deveined",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small saucepan, melt butter over medium low heat. Whisk in flour and salt to make a paste. Gradually whisk in milk. Stirring constantly, cook until sauce is thick enough to coat the back of a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Select a pan large enough to accommodate all the fillets in one layer. Coat with cooking spray. Arrange fish in pan, and cover with shrimp.. Pour white sauce over shrimp. Sprinkle with grated cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, for 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
