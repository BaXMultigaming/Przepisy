  "ingredients": [
    "2 tablespoons almond flour",
    "1 tablespoon cacao powder",
    "2 teaspoons coconut flour",
    "0.5 teaspoon baking powder",
    "1 pinch salt",
    "1 egg",
    "1.5 teaspoons honey",
    "1 teaspoon coconut oil",
    "0.5 teaspoon vanilla extract",
    "1 tablespoon dairy-free dark chocolate chips"
  ],
  "steps": [
    {
      "text": "Mix almond flour, cacao powder, coconut flour, baking powder, and salt in a microwave-safe mug. Add egg, honey, coconut oil, and vanilla extract; mix well. Stir in chocolate chips.",
