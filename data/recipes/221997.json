  "title": "Romano Bean Salad",
  "description": "Romano beans are similar to green beans and make a great side dish when marinated with garlic, mint, olive oil, and vinegar.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-04-27T18:38:49-04:00",
