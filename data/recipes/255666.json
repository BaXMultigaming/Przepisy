  "ingredients": [
    "2 tablespoons coconut oil",
    "2 cups chopped carrots",
    "3 stalks celery with leaves, chopped",
    "1 white onion, sliced",
    "3 cloves garlic, minced",
    "3 whole star anise pods",
    "6.3333334922791 cups vegetable broth",
    "0.5 cup stemmed and chopped carrot tops",
    "0.25 cup chopped fresh basil",
    "1 tablespoon chopped fresh tarragon",
    "1 pinch salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat coconut oil in a large pot over medium heat. Add carrots, celery, onion, garlic, and star anise; cook and stir until onion is translucent, 5 to 7 minutes. Pour in vegetable broth; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir carrot tops, basil, and tarragon into the pot; simmer until wilted, about 5 minutes. Season with salt and pepper. Discard star anise before serving.",
      "section": null,
      "name": null,
