  "ingredients": [
    "1 cup butter, softened",
    "1 cup white sugar",
    "1.75 cups self-rising flour",
    "4 large eggs, beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 12-cup muffin tins or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar together in a large bowl with an electric mixer until light and fluffy. Add 1/2 of the flour and 1/2 of the eggs; beat until smooth. Add remaining flour and eggs and beat until batter is light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 10 to 12 minutes. Cool in the tins for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
