  "ingredients": [
    "0.5 cup ketchup",
    "0.33333334326744 cup brown sugar",
    "4 tablespoons lemon juice, divided",
    "1 teaspoon dry mustard",
    "2 pounds lean ground beef",
    "3 slices bread, shredded",
    "0.25 cup diced onion",
    "1 large egg, beaten",
    "1 cube beef bouillon, crumbled"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dxaOPXXaB7MDqrWWE4g4CO22Uvo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20673-glazed-meatloaf-II-ddmfs-step-1-BG-2849-64eafba4977f4132a0a770bcddc85596.jpg"
      ],
      "image": "assets/images/20673/step_01.webp"
    },
    {
      "text": "Stir together ketchup, brown sugar, 1 tablespoon lemon juice, and mustard in a small bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/y5s4IzKoTajfJWaWUCJke60My9Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20673-glazed-meatloaf-II-ddmfs-step-2-BG-2850-42bd4278fe0941a4b5bbebabf1ae2cf8.jpg"
      ],
      "image": "assets/images/20673/step_02.webp"
    },
    {
      "text": "Place beef, bread, 1/3 cup ketchup mixture, onion, beaten egg, remaining 3 tablespoons lemon juice, and bouillon in a large bowl; mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5QTLOvhtbMTswfL7EzYO44QZw5g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20673-glazed-meatloaf-II-ddmfs-step-3-BG-2854-80ae7760b88d49419c8c37317040d930.jpg"
      ],
      "image": "assets/images/20673/step_03.webp"
    },
    {
      "text": "Form into a loaf and place into a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TA_SOMNOFFcPnVBIafkMZ6r5K7w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20673-glazed-meatloaf-II-ddmfs-step-4-BG-2856-6fff9516f3f04091bc9076bb9d86695d.jpg"
      ],
      "image": "assets/images/20673/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Remove from the oven and pour off fat carefully from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p8EsZnLKs8nsz2STZbek4e35p9I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20673-glazed-meatloaf-II-ddmfs-step-5-BG-2890-b8f6b24161214dbe9737332b6fdb8b54.jpg"
      ],
      "image": "assets/images/20673/step_05.webp"
    },
    {
      "text": "Spread remaining ketchup mixture over the top of loaf. Return to the oven and continue baking until no longer pink in the center, about 10 minutes more. An instant-read thermometer inserted into the center of loaf should read at least 160 degrees F (71 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rh8EvqsKoUNEJfTuBBToOyZuGzs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20673-glazed-meatloaf-II-ddmfs-step-6-BG-2892-ae7023c4f96d4d319e729dd84b15e40f.jpg"
      ],
      "image": "assets/images/20673/step_06.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iUt63RgaQt-FpB43hx5lhFmNH60=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20673-glazed-meatloaf-II-ddmfs-beauty-4x3-BG-2967-32cb957e2bf64465a34a0bc21aad58a0.jpg"
      ],
      "image": "assets/images/20673/step_07.webp"
    }
