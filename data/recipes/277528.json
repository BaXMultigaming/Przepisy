  "ingredients": [
    "2.6666667461395 cups all-purpose flour",
    "0.33333334326744 cup unsweetened cocoa powder (such as Hershey's Special Dark)",
    "1 tablespoon espresso powder",
    "0.5 teaspoon salt",
    "1 cup unsalted butter, softened",
    "1 cup white sugar",
    "1 egg",
    "2 teaspoons vanilla extract",
    "0.5 cup crushed peppermint candy canes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 4 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cocoa, espresso, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar together in a large bowl with an electric mixer until pale and fluffy. Add egg and vanilla extract; beat to combine. Add flour mixture and beat on low speed until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1-inch balls. Dip the tops of the cookies into the crushed candy canes. Place candy-side up on the prepared baking sheets, about 1 inch apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm, 14 to 16 minutes. Transfer to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
