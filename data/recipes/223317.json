  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup whole-wheat flour",
    "0.25 cup white sugar",
    "1.5 teaspoons baking powder",
    "1 teaspoon ground cumin",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon salt",
    "0.25 cup cold butter, cut into small pieces",
    "0.75 cup milk",
    "0.5 cup canned garbanzo beans, drained and 1/4 cup liquid reserved",
    "1 tablespoon lemon zest",
    "1 egg",
    "1 cup grapes, halved"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a muffin tin with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir all-purpose flour, whole-wheat flour, sugar, baking powder, cumin, baking soda, garlic powder, and salt in a large bowl. Blend butter into flour mixture with two knives or your fingers until mixture resembles coarse cornmeal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk, reserved garbanzo bean liquid, lemon zest, and egg together until smooth. Stir into dry ingredients until just moistened. Fold garbanzo beans and grapes into batter until incorporated. Spoon batter into prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
