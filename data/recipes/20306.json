  "title": "Sawdust Salad",
  "description": "Sawdust salad is a layered lemon and orange gelatin salad with crushed pineapple, marshmallows, and a custard layer topped with sliced bananas and toasted coconut.",
  "authors": [
    "DThomRN2"
  ],
  "date_published": "2000-07-22T10:32:38-04:00",
