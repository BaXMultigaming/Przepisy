  "ingredients": [
    "1 cup butter",
    "4 cups crispy rice cereal (such as Rice Krispies®)",
    "1 cup brown sugar",
    "1 cup shredded coconut",
    "1 cup chopped pecans",
    "0.5 gallon strawberry ice cream, softened"
  ],
  "steps": [
    {
      "text": "Melt butter in a large saucepan over medium-low heat. Off heat, add rice cereal, sugar, coconut, and pecans to saucepan; stir well. Pat ½ cereal mixture into bottom of a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread ice cream evenly over cereal mixture; layer remaining ½ cereal mixture on top ice cream layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Freeze until set, at least 1 hour. Cut into squares when ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
