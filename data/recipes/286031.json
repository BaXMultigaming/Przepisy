  "ingredients": [
    "1 (4 pound) whole red snapper",
    "1 teaspoon grapeseed oil, or as needed",
    "blackened seasoning to taste",
    "1 medium green bell pepper",
    "1 medium red bell pepper",
    "4 cloves garlic",
    "3 sprigs fresh thyme",
    "2 orange slices",
    "1 slice lime",
    "1 slice lemon"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor charcoal grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Clean red snapper and score fish on both sides. Rub inside and outside with oil, then generously rub with blackened seasoning inside and outside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stuff snapper with bell peppers, garlic, thyme, and orange, lime, and lemon slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place snapper on the hot grill and cook until fish easily flakes with a fork, 3 1/2 to 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
