  "ingredients": [
    "2.5 pounds boneless beef chuck roast",
    "2 teaspoons salt, divided",
    "2 tablespoons canola oil",
    "1 medium white onion, coarsely chopped",
    "1 tablespoon minced garlic",
    "1 tablespoon ground ginger",
    "0.5 tablespoon ground allspice",
    "0.5 tablespoon ground cinnamon",
    "1 cup sweet red wine",
    "2 cups water",
    "1 (6 ounce) can tomato paste",
    "1 tablespoon honey",
    "0.5 teaspoon red pepper flakes",
    "0.5 cup orange juice",
    "0.33333334326744 cup sweetened dried cranberries (such as Craisins®)",
    "2 mandarin oranges, segments halved",
    "9 dried pitted prunes"
  ],
  "steps": [
    {
      "text": "Season beef with 1 teaspoon salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a 4-quart Dutch oven over medium-high heat until shimmering. Sear beef in the hot oil, 3 minutes per side. Remove to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Saute onion and garlic in the Dutch oven until soft, about 5 minutes. Add ginger, allspice, and cinnamon; stir for 1 minute. Pour wine into the pot and bring to a boil while scraping the browned bits of food off the bottom of the pan with a wooden spoon. Add water, tomato paste, honey, red pepper flakes, and remaining salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut seared beef into 1-inch cubes and return to the pot. Bring to a boil; reduce heat and let simmer, covered, for 1 hour. Add orange juice, sweetened dried cranberries, mandarin oranges, and prunes; let simmer, uncovered, for another 20 minutes. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
