  "ingredients": [
    "1 (16 ounce) package lasagna noodles",
    "2 tablespoons olive oil",
    "1 small onion, chopped",
    "1 (16 ounce) package frozen chopped spinach, thawed",
    "7 ounces basil pesto",
    "30 ounces ricotta cheese",
    "1 egg",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon ground nutmeg",
    "2 cups mozzarella cheese, shredded",
    "9 ounces Alfredo-style pasta sauce",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add lasagna and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large skillet over medium heat, sauté onion in olive oil until tender. Stir in spinach; remove from heat and stir in pesto.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl mix ricotta cheese, egg, salt, pepper, and nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 3-quart greased baking dish, layer noodles then spinach mixture, followed by ricotta mixture. Sprinkle with mozzarella cheese. Repeat the layers ending with noodles on top. Spread Alfredo sauce on top of noodles and sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover with foil and bake in the preheated oven for 45 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
