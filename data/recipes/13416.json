  "ingredients": [
    "1 pound ground beef",
    "1 onion, chopped",
    "2 carrots, shredded",
    "1 stalk celery, diced",
    "1 teaspoon dried basil",
    "2 tablespoons dried parsley",
    "4 tablespoons margarine",
    "3 cups chicken broth",
    "3 cups hash brown potatoes",
    "0.25 cup all-purpose flour",
    "8 ounces processed cheese food",
    "1.5 cups milk",
    "salt and pepper to taste",
    "0.25 cup sour cream"
  ],
  "steps": [
    {
      "text": "Heat a 3-quart saucepan over medium-high heat. Add beef; cook and stir until browned and crumbly, 5 to 7 minutes. Remove beef and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 tablespoon butter in the same saucepan; add onion, carrots, celery, basil, and parsley. Cook and stir until vegetables are tender, about 3 to 5 minutes. Add broth, has brown potatoes, and browned beef; bring to a boil. Reduce heat, cover and simmer until potatoes are tender, about 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt remaining 3 tablespoons butter in a small skillet. Add flour; cook and stir until smooth, about 1 minute. Add to soup; cook and stir soup for 2 minutes. Reduce heat to low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cheese, milk, salt, and pepper; cook and stir until cheese melts. Remove from heat; add sour cream and stir well. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
