  "ingredients": [
    "3 high-quality white chocolate, coarsely chopped",
    "0.5 (12 ounce) package pink candy melts",
    "0.25 (12 ounce) package turquoise candy melts",
    "0.5 cup mini marshmallows, or more as needed",
    "1 tablespoon multicolored candy sprinkles",
    "1/4 (8 ounce) package conversation heart candies"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with parchment paper and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place white chocolate in a microwave-safe bowl and microwave in 10-second intervals, stirring after each interval.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place candy melts in separate microwave-safe bowls and melt in the same way, stirring after each 10-second interval.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the melted white chocolate onto the prepared baking sheet and spread it out into a thick rectangular shape. Add dollops of melted pink and blue candy. Swirl the colors together using a clean spatula to create fun patterns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add marshmallows, sprinkles, and heart candies while the chocolate is still melted. Refrigerate until set, about 2 hours. Break up bark into large, irregular pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
