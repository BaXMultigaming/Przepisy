  "ingredients": [
    "1 pound lean ground beef",
    "1 (1 ounce) package taco seasoning mix",
    "0.5 (14.5 ounce) package nacho-flavor tortilla chips",
    "2 cups shredded Cheddar cheese",
    "0.5 (15 ounce) can kidney beans, drained",
    "0.5 cup ranch-style salad dressing",
    "1 chopped tomato",
    "1 cup chopped lettuce",
    "0.25 cup chopped green onion"
  ],
  "steps": [
    {
      "text": "Place ground beef in a large, deep skillet over medium-high heat. Cook, stirring to crumble, until well done; drain. Stir in taco seasoning mix. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chips into a large bowl; crush them into bite-sized pieces. Combine with seasoned meat, cheese, beans, tomatoes, lettuce, and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing on top; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
