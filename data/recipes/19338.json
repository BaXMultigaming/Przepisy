  "ingredients": [
    "2 cups small seashell pasta",
    "0.33333298563957 cup Italian-style salad dressing",
    "salt to taste",
    "1 (15 ounce) can pinto beans",
    "1 (15 ounce) can black beans",
    "1 (15 ounce) can whole kernel corn, drained",
    "3 tomatoes, chopped",
    "1.5 tablespoons ground cumin",
    "0.5 tablespoon chili powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon dried red pepper flakes",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in shells and return to a boil. Cook pasta uncovered, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes. Drain and rinse shells in cold water; place in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir dressing into shells; season with salt. Stir in pinto and black beans. Add corn, tomatoes, cumin, chili powder, onion powder, garlic powder, and pepper flakes. Season with salt and black pepper; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill salad in refrigerator until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
