  "ingredients": [
    "0.25 cup milk",
    "3 large eggs",
    "2.5 tablespoons maple syrup",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "0.33300000429153 cup cornflakes cereal, crumbled",
    "8 slices white bread",
    "2 tablespoons confectioners' sugar for dusting",
    "1 tablespoon vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Whisk milk, eggs, maple syrup, vanilla, and cinnamon together in a medium bowl. Add crumbled cornflakes and stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, soak 1/2 of the bread slices in the mixture for about 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet or griddle over medium-high heat. Cook soaked bread slices in the hot skillet until dark golden brown, 4 to 5 minutes per side. Repeat to soak and cook remaining bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle hot French toast with confectioners' sugar. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
