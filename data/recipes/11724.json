  "ingredients": [
    "1 pound lean ground beef",
    "12 ounces spaghetti",
    "1 onion, chopped",
    "0.33329999446869 cup vegetable oil",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground turmeric",
    "2.5 tablespoons tomato paste",
    "0.66670000553131 cup water"
  ],
  "steps": [
    {
      "text": "Heat oil in a medium skillet. Add chopped onions, and cook until tender. Add ground beef, and brown. Stir in salt and turmeric. Dilute tomato paste in water, and add to the beef mixture. Cook for 30 minutes over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook spaghetti in a large kettle of boiling salted water according to package directions. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beef mixture and noodles in a large kettle. Cover, and cook over medium heat for 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
