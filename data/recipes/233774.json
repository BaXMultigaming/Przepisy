  "ingredients": [
    "1 cup jasmine rice (such as Mahatma®)",
    "2.25 cups water",
    "0.25 cup butter",
    "1 teaspoon salt",
    "1 teaspoon white vinegar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Gather all ingredients. Grease a 2 1/2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WacE0mSjps2BUVnjxdJgZ4qr9LE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-233774-oven-baked-rice-DDMF-Step-1-64a725512e744dfeb9253f4c3e7bc5bd.jpg"
      ],
      "image": "assets/images/233774/step_01.webp"
    },
    {
      "text": "Pour rice into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7RpQDK_jOvdpCBdj6LGythswaYo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-233774-oven-baked-rice-DDMF-Step-2-2800466d95294606a609fe1bfdc3e8a6.jpg"
      ],
      "image": "assets/images/233774/step_02.webp"
    },
    {
      "text": "Stir water, butter, salt, and vinegar together in a saucepan over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rZ5FldpMneQbhl8t_t5Q7Ajld1M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-233774-oven-baked-rice-DDMF-Step-3-492b6eacce814a30a4758144af26d8a5.jpg"
      ],
      "image": "assets/images/233774/step_03.webp"
    },
    {
      "text": "Bring to a rolling boil, then pour over rice; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Zdg0s2462zoDDTs-cT4GNCU2Gm0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-233774-oven-baked-rice-DDMF-Step-4-4989d1c3303b4af889e288274d9bd713.jpg"
