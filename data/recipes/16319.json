  "ingredients": [
    "2 cups dry stuffing mix",
    "1 cup boiling water",
    "2 tablespoons butter",
    "1.5 pounds flank steak, pounded thin for easy rolling",
    "2 green onions, chopped",
    "1 red bell pepper, finely chopped",
    "1 (10.5 ounce) can mushroom gravy",
    "0.25 cup red wine",
    "1 clove garlic, minced",
    "2 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine stuffing mix, water, and butter in a medium bowl; mix well and let stand for 5 minutes. Spoon stuffing onto steak, leaving a 1-inch border; scatter green onions and red bell pepper on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll up from the long edge of steak and secure with wooden toothpicks. Place steak seam-side down in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine gravy, wine, garlic, and cheese in a small bowl; mix well and pour over steak.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until internal temperature reaches 160 degrees F (71 degrees C) for medium, about 1 hour. Let stuffed steak stand for 5 minutes before slicing and serving with sauce from the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
