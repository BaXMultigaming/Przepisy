  "ingredients": [
    "1.5 (.25 ounce) packages active dry yeast",
    "0.5 cup white sugar",
    "2 cups warm water",
    "4 cups all-purpose flour",
    "0.5 cup powdered milk",
    "1.5 teaspoons baking powder",
    "0.5 cup shortening",
    "1 pound lean ground beef",
    "1 pound ground Italian sausage",
    "1 cup chopped onion",
    "3 cups shredded cabbage",
    "3 tablespoons prepared mustard",
    "2 teaspoons salt",
    "2 teaspoons ground black pepper",
    "0.5 cup shredded, processed American cheese",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "To Make Sweet Dough: In a medium bowl combine the yeast, sugar and water and mix together; let stand 10 minutes. Stir in flour, dry milk, baking powder and shortening, then knead mixture for 10 minutes, adding as little flour as necessary. Cover bowl with a damp cloth and let rise in a warm place for 30 minutes, then knead again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Filling: Meanwhile, brown beef, sausage and onion in a large skillet over medium high heat. Drain extra fat from skillet, then stir in cabbage, mustard, salt and pepper and cook for 5 minutes. Add cheese and cook, stirring, until cheese is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flatten a piece of dough. Place large spoonful of meat filling onto dough and fold over to form a round bun. Lay folded-side-down in a lightly greased 9x13 inch baking dish. Repeat with remaining dough and filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
