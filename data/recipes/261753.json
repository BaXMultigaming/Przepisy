  "ingredients": [
    "cooking spray",
    "1.5 cups all-purpose flour",
    "1 cup brown sugar",
    "1 teaspoon ground cinnamon",
    "5 ripe bananas, or more to taste",
    "0.66666668653488 cup coconut oil, melted",
    "2 tablespoons coffee",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease an 8x4-inch loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, brown sugar, and cinnamon together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash bananas to the consistency of oatmeal. Mix in coconut oil, coffee, and vanilla extract. Pour over flour mixture; stir together with a wooden spoon. Pour batter into the greased pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 45 minutes to 1 hour. Cool for 20 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
