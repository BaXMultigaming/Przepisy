  "ingredients": [
    "3 cups sliced apples",
    "1 cup blueberries",
    "1 (9 inch) unbaked deep dish pie crust",
    "0.25 cup all-purpose flour",
    "0.5 cup white sugar",
    "0.25 teaspoon ground cinnamon, or more to taste",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "1 cup plain yogurt",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.5 cup chopped pecans",
    "0.5 cup rolled oats",
    "0.25 cup brown sugar",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss apples and blueberries together in pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ¼ cup flour, white sugar, cinnamon, nutmeg, and salt in a bowl. Stir in yogurt, egg, and vanilla extract; pour over apples and blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining ½ cup flour, pecans, oats, and brown sugar in a bowl; cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes; reduce heat to 350 degrees F (175 degrees C) and continue baking until crust is lightly browned, about 30 minutes. Sprinkle crumb mixture over pie; continue baking until golden brown, about 15 minutes more. Cool before serving, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
