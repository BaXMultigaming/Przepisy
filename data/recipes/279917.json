  "ingredients": [
    "1 (.25 ounce) package active dry yeast",
    "1 teaspoon honey",
    "1 cup warm water (110 degrees F (45 degrees C))",
    "2.5 cups bread flour",
    "0.25 cup freshly grated Parmesan cheese",
    "2 tablespoons olive oil",
    "2 teaspoons Italian seasoning, divided",
    "1 teaspoon salt",
    "0.25 cup melted butter",
    "1 teaspoon garlic salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line baking pans with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve yeast and honey in warm water in the bowl of a stand mixer. Let sit until creamy, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, Parmesan cheese, olive oil, 1 teaspoon Italian seasoning, and salt into the yeast mixture. Beat until smooth and the dough pulls away from the sides of the bowl. Let rest, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough onto a lightly floured surface and pinch off about 3 tablespoons. Roll into a log shape. Place on the prepared baking sheet. Repeat with remaining dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until just golden brown, 13 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While breadsticks are baking, mix butter, garlic salt, and remaining Italian seasoning together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush butter mixture onto the breadsticks and continue to bake until golden brown, about 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
