  "ingredients": [
    "0.25 cup white sugar",
    "0.25 cup light corn syrup",
    "3 tablespoons water",
    "0.125 teaspoon cream of tartar",
    "1 pinch salt",
    "2 egg whites"
  ],
  "steps": [
    {
      "text": "In a small saucepan, combine sugar, corn syrup, water, cream of tartar, and salt. Cook over medium heat, stirring constantly, until mixture comes to a boil and sugar has dissolved. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium mixing bowl, beat egg whites until foamy. With mixer on medium speed, slowly pour the hot syrup mixture over the egg whites. Turn mixer to high speed and beat until stiff peaks form. Spread over top of pie, covering filling completely. May brown meringue in oven if you desire.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
