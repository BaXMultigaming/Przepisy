  "title": "Melting Moments Cookies",
  "description": "These melting moments cookies are delicate, buttery cornstarch cookies with a light, crumbly texture that makes them perfect for tea.",
  "authors": [
    "Lee K"
  ],
  "date_published": "1997-10-30T23:28:41-05:00",
