  "ingredients": [
    "3 tablespoons unsalted butter",
    "0.25 cup freshly squeezed lemon juice",
    "1 tablespoon chopped fresh tarragon",
    "2 tablespoons chopped walnuts",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium heat. Cook, stirring occasionally, until butter is a light-tan, nutty color and fragrant, 6 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir walnuts into butter; cook and stir in hot butter until fragrant, about 1 minute. Add lemon juice, remove skillet from heat, add tarragon, and season with salt and black pepper.",
