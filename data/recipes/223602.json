  "ingredients": [
    "cooking spray",
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 cup chopped walnuts",
    "3 cups apples - peeled, cored, and chopped",
    "1 cup vegetable oil",
    "2 cups white sugar",
    "3 eggs, beaten",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C). Grease two 8x4-inch loaf pans or one 10-inch Bundt pan with cooking spray.",
