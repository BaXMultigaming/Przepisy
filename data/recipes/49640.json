  "ingredients": [
    "0.5 cup confectioners' sugar",
    "1 (3 ounce) package cream cheese",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "1 cup heavy cream",
    "1 (9 inch) baked pie shell",
    "0.33333334326744 cup white sugar",
    "2 tablespoons cornstarch",
    "0.33333334326744 cup water",
    "0.33333334326744 cup grenadine syrup",
    "1 tablespoon lemon juice",
    "2 cups fresh strawberries, hulled"
  ],
  "steps": [
    {
      "text": "Beat confectioners' sugar and cream cheese together in a bowl with an electric mixer until smooth and creamy; stir in vanilla and almond extracts. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip cream in a separate bowl with an electric mixer, until peaks form: fold into cream cheese mixture. Spread into baked pie crust. Chill, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine white sugar and cornstarch in a saucepan; stir in water until smooth. Stir in grenadine and lemon juice; bring to a boil over medium heat, stirring constantly, until thickened, 5 minutes. Cool, then chill in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir strawberries and cooled cornstarch mixture together until strawberries evenly coated: spread over cream cheese layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
