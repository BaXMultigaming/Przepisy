  "ingredients": [
    "1.5 cups butter, softened",
    "1.5 cups white sugar",
    "2 eggs",
    "1 cup buttermilk",
    "1 teaspoon baking soda",
    "2 cups all-purpose flour",
    "0.5 teaspoon salt",
    "0.5 cup butter flavored shortening",
    "1 (8 ounce) package cream cheese",
    "4 cups sifted confectioners' sugar",
    "1 tablespoon milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease and flour 2 round 8 inch pans. Sift the flour and salt together and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar until light and fluffy. Add eggs and mix well. Dissolve baking soda in buttermilk. Alternately add flour and buttermilk, beginning and ending with the flour. Pour into two 8-inch pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (165 degrees C) for about 30 minutes, or until toothpick inserted into cake comes out clean. Cool cake completely before icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the White Velvet Cream Cheese Icing: Beat shortening and cream cheese together. Gradually beat in confectioners sugar. Add milk until a frosting is formed. (Add more milk if necessary.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
