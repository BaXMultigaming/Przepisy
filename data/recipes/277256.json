  "ingredients": [
    "3 tablespoons unsalted butter",
    "2 tablespoons olive oil",
    "2 cups heavy cream",
    "2 cloves garlic, minced",
    "0.25 teaspoon white pepper",
    "0.5 cup freshly grated Parmesan cheese",
    "0.75 cup shredded mozzarella cheese"
  ],
