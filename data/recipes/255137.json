  "ingredients": [
    "1.5 tablespoons olive oil",
    "0.25 cup 1/2-inch long vermicelli",
    "1 cup Egyptian rice (short-grain rice)",
    "salt to taste",
    "1.75 cups water"
  ],
  "steps": [
    {
      "text": "Heat oil in a saucepan over medium heat. Add vermicelli; cook, stirring constantly, until golden brown, 3 to 5 minutes. Remove from heat. Pour in rice and salt; stir until coated with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low. Cook the rice mixture, stirring constantly, until rice turns pasty white, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water to a boil in a saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water into the rice mixture. Cover; cook until most of the water is absorbed, 10 to 15 minutes. Turn off heat; let sit until remaining water is absorbed, about 5 minutes. Fluff rice with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
