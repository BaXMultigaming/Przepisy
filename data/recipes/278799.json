  "ingredients": [
    "1.5 tablespoons olive oil",
    "5 ounces plant-based \"ground beef\" (such as Beyond Meat® Beefy Crumbles)",
    "0.5 cup chopped green bell pepper",
    "0.33333334326744 cup chopped onion",
    "3 cloves garlic, minced",
    "4 eggs",
    "1 tablespoon taco seasoning mix",
    "0.33333334326744 cup chopped cilantro",
    "0.5 cup grated Cheddar cheese",
    "0.5 cup salsa",
    "6 (6 inch) flour tortillas, warmed"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a skillet over medium heat. Cook and stir \"beef\" crumbles, green bell pepper, onion, and garlic in the hot skillet until tender, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, taco seasoning, and cilantro together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour eggs into the skillet and scramble until set, 3 to 4 minutes. Remove from heat and stir in cheese and salsa until cheese has melted and filling is well combined. Serve with warmed flour tortillas.",
