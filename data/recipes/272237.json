  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "1 cup sour cream",
    "2 (16 ounce) cans refried beans",
    "1 (1.25 ounce) package taco seasoning mix",
    "2 cups shredded Cheddar cheese, divided",
    "2 cups shredded Monterey Jack cheese, divided"
  ],
  "steps": [
    {
      "text": "Mix cream cheese and sour cream together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in refried beans, 1 cup Cheddar cheese, 1 cup Monterey Jack cheese, and taco seasoning until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Smooth mixture evenly over the bottom of a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add remaining cheese on top of the mixture, spreading it evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on High until heated through, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
