  "ingredients": [
    "2 cups white sugar",
    "1.5 cups all-purpose flour",
    "1 cup vegetable oil",
    "0.25 cup cocoa powder",
    "4 eggs",
    "1 teaspoon salt",
    "1 teaspoon vanilla extract",
    "1 cup walnut halves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, flour, oil, cocoa powder, eggs, salt, and vanilla extract together in a bowl; beat with an electric mixer for 3 minutes. Fold walnuts into batter. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the brownies comes out clean, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
