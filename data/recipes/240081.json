  "title": "German Chocolate Cake Icing",
  "description": "A quick and easy German chocolate cake frosting without eggs — made with just five ingredients: butter, brown sugar, milk, coconut, and pecans.",
  "authors": [
    "Cindi L"
  ],
  "date_published": "2020-03-05T00:12:41-05:00",
