  "ingredients": [
    "1 cup brown sugar",
    "0.5 cup milk, or more as needed",
    "0.5 cup butter",
    "1 cup flaked coconut, or more to taste",
    "0.25 cup chopped pecans, or more to taste"
  ],
  "steps": [
    {
      "text": "Bring brown sugar, milk, and butter to a boil in a large saucepan, stirring occasionally. Boil until icing thickens and reaches 240 degrees F to 245 degrees F (115 degrees C to 118 degrees C) on a candy thermometer, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and stir in coconut and pecans. If icing is too thick, thin with milk to desired consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
