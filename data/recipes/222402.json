  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "2.5 pounds honeycomb beef tripe",
    "0.5 cup white vinegar",
    "2 teaspoons salt",
    "1 teaspoon vanilla extract",
    "1 large bay leaf",
    "1 tablespoon olive oil",
    "4 ounces pancetta bacon, diced",
    "1 medium onion, diced",
    "6 cloves garlic, minced",
    "3 cups marinara sauce",
    "1 teaspoon red pepper flakes",
    "1 (15 ounce) can garbanzo beans, drained",
    "1 bunch fresh mint leaves, chopped",
    "salt and ground black pepper to taste",
    "0.25 cup freshly grated Parmigiano-Reggiano cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BgpVFHHiOE5nHY7GRqQ9GTJDBhg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222402-roman-style-tripe-ddmfs-Step-01-70a6360767c7477da120edb4ec11a299.jpg"
      ],
      "image": "assets/images/222402/step_01.webp"
    },
    {
      "text": "Fill a large stockpot with 5 quarts cold water, tripe, vinegar, 2 teaspoons salt, vanilla, and bay leaf; bring to a boil over high heat. Skim off any foam, then reduce the heat to medium-low, cover, and simmer for 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/odETtU37LznW9Abf5UfINhh4IXQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222402-roman-style-tripe-ddmfs-Step-03-5781b5afb6234159b21429f397161abc.jpg"
      ],
      "image": "assets/images/222402/step_02.webp"
    },
    {
      "text": "Transfer tripe to a plate and set aside to cool. Reserve 2 cups cooking liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Xbxx1WpEbe8vj9ZeU-PPtY6I5jo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222402-roman-style-tripe-ddmfs-Step-04-36380dfd7e184c9db308414f7a6e98f4.jpg"
      ],
      "image": "assets/images/222402/step_03.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Add pancetta and onion; cook and stir until pancetta is browned and onion is translucent, 6 to 7 minutes. Stir in garlic and cook until fragrant, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2ooB12K7SGvSlBfWQjRkZRdhfX0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222402-roman-style-tripe-ddmfs-Step-06-996056574ec346f9bbd63965a53aa82e.jpg"
      ],
      "image": "assets/images/222402/step_04.webp"
    },
    {
      "text": "Stir in marinara sauce, 1 cup cooking liquid, and pepper flakes. Reduce the heat to low and simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OruKczVrV-mQikKWoRosQL-e6uc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222402-roman-style-tripe-ddmfs-Step-07-4429741fe0bd4d4e846ee1aa016adbba.jpg"
      ],
      "image": "assets/images/222402/step_05.webp"
    },
    {
      "text": "Cut tripe into 1-inch cubes; add to sauce and stir to combine. Simmer for 30 minutes, adding remaining 1 cup cooking liquid if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZHLP0QrWAv94bmccgp9f7lWxf0g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222402-roman-style-tripe-ddmfs-Step-09-41b04f03039a40e9bd45e198a2b7beb5.jpg"
      ],
      "image": "assets/images/222402/step_06.webp"
    },
    {
      "text": "Stir in garbanzo beans and mint, season with salt and pepper, and sprinkle Parmigiano-Reggiano over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YMzGazpAeC-xaHKdGGO_niIT7eg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222402-roman-style-tripe-ddmfs-Step-10-299e3fe5a2b64fb1912a44ef1d262138.jpg"
      ],
      "image": "assets/images/222402/step_07.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WmhC_m5ekSJF7QOvfaAbRZd9DeA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222402-roman-style-tripe-ddmfs-Beauty-3x4-055cc4e847f44a82949e5bbf4a8a9e24.jpg"
      ],
      "image": "assets/images/222402/step_08.webp"
    }
  ],
