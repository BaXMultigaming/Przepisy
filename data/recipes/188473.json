  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 tablespoon butter",
    "1 pound skinless, boneless chicken breasts, cut into bite-size pieces",
    "0.25 cup hot sauce",
    "4 (10 inch) flour tortillas",
    "2 cups shredded lettuce",
    "1 celery stalk, diced",
    "0.5 cup blue cheese dressing"
