  "ingredients": [
    "3 tablespoons vegetable oil",
    "2 tablespoons plain low-fat yogurt",
    "2 tablespoons ketchup",
    "2 tablespoons prepared mustard",
    "1.5 teaspoons garlic powder",
    "2 teaspoons paprika",
    "1.5 teaspoons ground allspice",
    "0.5 teaspoon black pepper",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon curry powder",
    "3 pounds skinless, boneless chicken breast halves - cut into bite-size pieces",
    "0.5 cup mayonnaise",
    "1 cup plain low-fat yogurt",
    "3 cloves garlic, minced",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "In a medium bowl, stir together oil, yogurt, ketchup, and mustard. Season with garlic powder, paprika, allspice, black pepper, cinnamon, and curry powder. Stir in chicken pieces, coating all sides with marinade. Cover bowl, and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make dipping sauce, mix together mayonnaise, yogurt, garlic, and salt. Cover, and refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken pieces to a shallow baking dish. Bake in a preheated oven, 30 minutes.",
