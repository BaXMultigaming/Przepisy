  "ingredients": [
    "0.5 (8 ounce) package Neufchatel cheese, softened",
    "2 tablespoons sour cream",
    "1.5 tablespoons white sugar",
    "1 teaspoon vanilla extract",
    "1 (6 ounce) container blueberries",
    "5 (7 inch) flour tortillas",
    "avocado oil cooking spray",
    "2.5 tablespoons white sugar",
    "0.5 tablespoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Combine Neufchatel cheese, sour cream, sugar, and vanilla extract in a bowl and beat with an electric hand mixer. Carefully fold in blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat tortillas in a large skillet or directly on the grates of a gas stove until soft and pliable. Place 1/4 cup blueberry mixture down the center of each tortilla. Fold top and bottom of tortillas over the filling, then roll each into a burrito shape. Mist with avocado oil and place in the basket of an air fryer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook chimichangas in the air fryer at 400 degrees F (200 degrees C) until golden brown, 4 to 6 minutes. Flip each chimichanga over, mist with cooking spray, and air fry until golden brown, 1 to 2 minutes more. Let cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar and cinnamon in a shallow bowl. Spray each chimichanga with avocado oil and roll in cinnamon sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
