  "ingredients": [
    "2 cups water, more as needed",
    "1 lime, juiced",
    "1 tablespoon garlic powder, or to taste",
    "1 tablespoon onion powder",
    "1 sprig fresh thyme",
    "8 black peppercorns",
    "salt to taste",
    "1.5 pounds boneless pork chops",
    "2 tablespoons olive oil",
    "1 large onion, halved and thinly sliced",
    "3 cloves garlic, peeled and sliced",
    "0.25 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Combine 2 cups water, juice of 1 lime, garlic powder, onion powder, thyme, peppercorns, and salt in a large pot; bring to a boil. Add pork, reduce heat to medium-low, and simmer until pork is very tender, 1 to 1 ½ hours. Add more water as necessary to keep pork covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, rest pork in broth for 30 minutes. Transfer pork to a cutting board; shred using 2 forks, removing and discarding excess fat. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add pork; fry until almost crisp, about 5 minutes. Add onion and garlic; cook until onion is crisp-tender, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in remaining juice of 1 lime and cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
