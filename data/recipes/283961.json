  "ingredients": [
    "12 (6 inch) sandwich rolls",
    "1 (6 ounce) package pepperoni slices",
    "16 ounces sliced mozzarella cheese",
    "1 teaspoon granulated garlic",
    "1 teaspoon dried Italian herbs",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut 5 deep vertical slices into the rolls, making sure to leave the roll connected.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold pepperoni in half and stuff each pepperoni into the vertical slices. Slice each piece of mozzarella cheese in half, and stuff into the vertical slices. Drizzle rolls with olive oil and sprinkle with Italian herbs and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until mozzarella has melted, about 12 minutes.",
      "section": null,
