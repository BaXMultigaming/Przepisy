  "ingredients": [
    "1 cup white sugar",
    "0.5 cup shortening",
    "1 egg",
    "0.25 cup milk",
    "1.5 teaspoons lemon zest",
    "1 teaspoon almond extract",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Beat sugar, butter, egg, milk, lemon zest, and almond extract together in a large mixing bowl with an electric mixer. Combine flour, baking powder, and salt; blend into butter mixture. Fold in blueberries. If you have time, cover and chill dough for 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by teaspoonfuls onto ungreased cookie sheets, about 1½ inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 12 to 15 minutes. Let cookies cool on the baking sheets for a few minutes before transferring to wire racks to cool completely.",
