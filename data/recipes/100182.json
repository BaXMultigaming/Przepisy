  "ingredients": [
    "2 pounds ground beef",
    "0.5 cup chopped onion",
    "1.5 cups ketchup",
    "0.25 cup white sugar",
    "0.25 cup white vinegar",
    "0.25 cup prepared yellow mustard",
    "0.75 teaspoon Worcestershire sauce",
    "0.75 teaspoon salt",
    "0.5 teaspoon celery seed",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ground beef and onion in a large skillet over medium-high heat. Cook, stirring to crumble, until beef is browned; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the beef and onion to a slow cooker and stir in ketchup, sugar, vinegar, and mustard. Season with Worcestershire, salt, celery seed, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and simmer on Low for 3 hours before serving.",
      "section": null,
      "name": null,
