  "ingredients": [
    "2.25 cups water",
    "1 cup bulgur wheat",
    "2 tomatoes, seeded and finely chopped",
    "2 green onions, sliced into thin slivers",
    "0.75 cup coarsely chopped fresh cilantro",
    "2 cloves garlic, minced, or to taste",
    "2 lemons, juiced",
    "2 tablespoons olive oil",
    "1 teaspoon ground cumin",
    "0.5 teaspoon freshly cracked pepper",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a saucepan, turn off the heat, and stir in bulgur wheat. Cover and let sit for 30 minutes to absorb water. Strain off any liquid left unabsorbed, if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bulgur wheat in a large salad bowl, and lightly toss with tomatoes, green onions, cilantro, garlic, lemon juice, olive oil, cumin, pepper, and salt until thoroughly combined. Refrigerate salad for at least 3 hours to blend flavors; serve cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
