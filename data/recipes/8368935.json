  "title": "Shrimp Scampi with Rice",
  "description": "Shrimp scampi in a yummy sauce with garlic, butter, white wine, and lemon served over rice is a quick and easy dinner any day of the week.",
  "authors": [
    "Bibi"
  ],
  "date_published": "2022-03-17T08:44:08-04:00",
