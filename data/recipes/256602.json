  "ingredients": [
    "1 cup tamarind pulp",
    "8 dates",
    "8 dried apricots",
    "0.25 cup white sugar",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon salt",
    "0.5 cup water, or more to taste"
  ],
  "steps": [
    {
      "text": "Combine tamarind pulp, dates, apricots, sugar, pepper, and salt in a blender; blend into a paste. Pour in water; blend until mixture has a sauce-like texture.",
