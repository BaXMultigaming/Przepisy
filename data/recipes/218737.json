  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "0.5 cup sour cream",
    "4 green onions, chopped",
    "1 (1 ounce) package taco seasoning mix",
    "14 (10 inch) flour tortillas"
  ],
  "steps": [
    {
      "text": "Mix cream cheese, sour cream, green onions, and taco seasoning in a bowl until well blended.",
      "section": null,
