  "ingredients": [
    "0.5 cup plain yogurt",
    "0.25 cup water",
    "2 tablespoons fresh lemon juice",
    "1 tablespoon distilled white vinegar",
    "1 tablespoon olive oil",
    "0.5 cup chopped onion",
    "2 cloves garlic, minced",
    "1 tablespoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon ground cumin",
    "0.125 teaspoon ground nutmeg",
    "0.125 teaspoon ground cloves",
    "0.75 teaspoon ground mace",
    "1 teaspoon cayenne pepper",
    "5 pounds boneless lamb shoulder, cut into 1/4-inch-thick strips"
  ],
  "steps": [
    {
      "text": "Place the yogurt, water, lemon juice, vinegar, olive oil, onion, and garlic into a large mixing bowl. Whisk in the salt, black pepper, cumin, nutmeg, clove, mace, and cayenne pepper until evenly blended. Mix in the lamb strips to coat. Cover the bowl with plastic wrap, and marinate in the refrigerator 12 to 24 hours (the longer the better).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over high heat. Cook the lamb strips in a single layer in batches until the fat melts and the meat has browned and is no longer pink on the inside, about 5 minutes, turning occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
