  "ingredients": [
    "2 egg whites",
    "3 tablespoons white sugar",
    "3 tablespoons all-purpose flour",
    "0.25 teaspoon baking powder",
    "1 pinch salt",
    "3 tablespoons milk",
    "2 egg yolks, beaten",
    "1 tablespoon lemon juice",
    "1 teaspoon butter",
    "1 large apple - peeled, cored and thinly sliced",
    "0.25 teaspoon ground cinnamon",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, whip egg whites with an electric mixer until foamy. Sprinkle in 3 tablespoons of sugar while continuing to whip until stiff peaks form. In a separate bowl, stir together the flour, baking powder, and salt. Mix in the milk, egg yolks, and lemon juice until well blended, then fold in the egg whites using a rubber spatula or wooden spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the butter in a large cast-iron (or other oven proof) skillet over medium heat. Spread the batter evenly in the pan. Layer the thinly sliced apple over the batter, and sprinkle with cinnamon and remaining sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the skillet in the oven, and bake for 10 minutes, or until the apples are golden brown and glazed looking. Cut into wedges to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
