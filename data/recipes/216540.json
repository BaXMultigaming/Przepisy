  "ingredients": [
    "1.25 cups all-purpose flour",
    "1 cup quick cooking oats",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "2 large eggs",
    "1.25 cups mashed ripe bananas",
    "2 tablespoons sour cream",
    "0.33333334326744 cup melted butter",
    "0.5 cup white sugar",
    "0.75 cup dried cranberries",
    "0.5 teaspoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease a 2 1/2 x 8 1/2-inch loaf pan with butter. Whisk the flour, oats, baking powder, and salt together in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk the eggs in a mixing bowl until smooth. Beat in the bananas, sour cream, and melted butter. Add the sugar, cranberries, and lemon juice; beat until evenly blended. Fold into the oat mixture until no dry lumps remain. Pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 45 to 50 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
