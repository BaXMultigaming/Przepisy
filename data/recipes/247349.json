  "ingredients": [
    "0.5 pound green beans, trimmed and cut into 1-inch pieces",
    "0.25 cup water",
    "1 tablespoon minced ginger",
    "2 cloves garlic, minced",
    "1 teaspoon sesame oil",
    "2 tablespoons soy sauce",
    "1 tablespoon rice vinegar",
    "0.5 teaspoon white sugar",
    "0.25 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Combine green beans and water in a skillet over medium-high heat. Cover and cook, stirring occasionally, until beans are tender-crisp, 4 to 5 minutes. Add ginger, garlic, and sesame oil; cook, stirring frequently, until garlic is fragrant and golden brown, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix soy sauce, rice vinegar, sugar, and red pepper flakes together in a small bowl. Pour over beans and cook until sauce thickens enough to coat beans, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
