  "ingredients": [
    "12 chicken thighs",
    "1 cup all-purpose flour",
    "salt and pepper to taste",
    "1 cup Italian seasoned bread crumbs",
    "3 eggs",
    "0.5 cup vegetable oil",
    "1 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour in a shallow plate or bowl and season with salt and pepper to taste. Put bread crumbs in another shallow plate or bowl and beat eggs in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DlQyawvn67oE_BoKuJBqQ1Pv3ro=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8841-OvenFriedChicken-ddmfs-step1-104095-4x3-7ccd3590fca747c98860881007fef80a.jpg"
      ],
      "image": "assets/images/8841/step_02.webp"
    },
    {
      "text": "Dredge chicken piece by piece in the flour, then the egg, then the bread crumbs, until all pieces are coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Du2K-CTT0TmWcM3VL2vOnmqpi2w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8841-OvenFriedChicken-ddmfs-step2-104106-4x3-c4098d3d92f047d8b2920b599b0bdcd2.jpg"
      ],
      "image": "assets/images/8841/step_03.webp"
    },
    {
      "text": "Pour oil into a large baking dish; add the breaded chicken thighs and sprinkle with paprika to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fS_1E0x1OXOWtY-S_Mws1wVdOAs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8841-OvenFriedChicken-ddmfs-step3-104111-4x3-c014ba44fc2d4284adeda7a16e78f101.jpg"
      ],
      "image": "assets/images/8841/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 30 minutes, then turn pieces over and bake for another 30 minutes. Remove from the oven and drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N5SOeg4PyXmTsyZ8tSCgA3mn2Ts=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8841-OvenFriedChicken-ddmfs-step4-104159-4x3-8e9c0da38d2f46c98df3df2926519ddc.jpg"
      ],
      "image": "assets/images/8841/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3GBWY5ek7hAcQ8gOpl67-IwEai4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8841-Oven-Fried-Chicken-ddmfs-4x3-104184-1633bf02818a49f9818732cba77216c6.jpg"
      ],
      "image": "assets/images/8841/step_06.webp"
    }
