  "ingredients": [
    "1 cup frozen chopped spinach",
    "1 (16 ounce) package gnocchi",
    "4 tablespoons olive oil, divided",
    "1 (8 ounce) package crimini mushrooms, quartered",
    "3 stalks celery, diced",
    "1 (15 ounce) can cannellini beans",
    "0.33333334326744 cup french-fried onions",
    "0.25 cup white wine",
    "0.5 teaspoon kosher salt",
    "0.5 teaspoon dried sage",
    "0.75 cup vegan pesto",
    "0.5 cup vegetable broth"
  ],
  "steps": [
    {
      "text": "Place spinach in a microwave-safe dish. Cover and microwave on high for 4 minutes. Separate with a fork and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook gnocchi in the boiling water until they float to the top, 2 to 4 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat 2 tablespoons olive oil in a large skillet over medium heat until warm. Add mushrooms and cook until they begin to soften, about 3 minutes. Add celery, cover, and cook for 3 more minutes. Remove mushrooms and celery to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining 2 tablespoons olive oil in the skillet. Add gnocchi and brown, flipping halfway through, 4 to 6 minutes. Add mushroom-celery mixture, cannellini beans, spinach, onions, wine, salt, and sage; simmer until heated through, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together vegan pesto and vegetable broth in a small bowl. Pour into skillet over gnocchi and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
