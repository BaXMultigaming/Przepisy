  "ingredients": [
    "1 (10 ounce) package pita bread, cut in half",
    "3 tablespoons butter",
    "1 teaspoon crushed garlic",
    "1 teaspoon dried Italian-style seasoning",
    "2 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Open pita bread halves and roughly cut into approximately 2 inch pieces. Arrange on a medium baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small saucepan over medium heat, melt butter and mix in garlic and dried Italian-style seasoning. Pour the mixture over pita bread pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle bread with Parmesan cheese, adjusting the amount as desired. Bake in the preheated oven 10 minutes, or until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
