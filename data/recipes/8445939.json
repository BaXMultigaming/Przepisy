  "ingredients": [
    "5 cups rolled oats",
    "2 cups almonds",
    "2 cups unsweetened shredded coconut",
    "1.25 cups maple syrup",
    "0.5 cup coconut oil",
    "1 egg white",
    "2 tablespoons chia seeds",
    "1 teaspoon cinnamon",
    "1 teaspoon cardamom",
    "1 teaspoon kosher salt"
  ],
  "steps": [
    {
      "text": "Gather Ingredients. Preheat oven to 350 degrees F (175 degrees C). Line two rimmed baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/418y0u4P87ZuL6-4awyWY75fcWg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8445939-coconut-granola-ingredients-0b7ffbce992c42d3aa1f1bbc4692514d.jpg"
      ],
      "image": "assets/images/8445939/step_01.webp"
    },
    {
      "text": "Combine all ingredients in a large bowl. Use your hands or a wooden spoon to thoroughly mix, until oats and nuts are well coated. Spread mixture onto prepared baking sheets in an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-RUY9vWG07Px9jaWmRjsXfuixrU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8445939-coconut-granola-step-02-B-a191e085013343cb9f9c73340557a8eb.jpg"
      ],
      "image": "assets/images/8445939/step_02.webp"
    },
    {
      "text": "Bake until golden brown, about 40 minutes. Stir granola and rotate pans 20 minutes into baking time so that it browns evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Vc-KWSEQZ_Gkp5ARf4nFp2GlLXQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8445939-coconut-granola-step-03-204287b49605433f8ce32a73a0a2a2ec.jpg"
      ],
      "image": "assets/images/8445939/step_03.webp"
    },
    {
      "text": "Cool completely, then transfer to lidded containers or jars. Store at room temperature for up to two weeks. Serve with milk, yogurt, or your choice of fruit (I like berries, peaches, mango or pineapple).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AJMnzOaiTMMDGnha-1KkohdQja0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8445939-coconut-granola-step-04-cd9270b655664cb6ae9038da8897966b.jpg"
      ],
      "image": "assets/images/8445939/step_04.webp"
    }
  ],
