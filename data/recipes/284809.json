  "ingredients": [
    "6 medium russet potatoes",
    "1 tablespoon vegetable oil, or as needed",
    "0.25 teaspoon sea salt, or to taste",
    "1 pinch lemon-pepper seasoning, or to taste",
    "12 large squares aluminum foil"
  ],
  "steps": [
    {
      "text": "Gather ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Btz7g2T0udp03hNSa7UzXm0xKT8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-284809-crispy-jacket-potatoes-VAT-step-01-4912a1a8386344f08ae1dba27b89798e.jpg"
      ],
      "image": "assets/images/284809/step_01.webp"
    },
    {
      "text": "Drizzle potatoes with a thin layer of oil. Sprinkle on sea salt and about 1/2 as much lemon-pepper seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6BlY_kCa3h-9Iu7Ja1fiZnt9k4s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-284809-crispy-jacket-potatoes-VAT-step-02-1-0ae34ab6615d4fd1b6ce385c44c5f4d3.jpg"
      ],
      "image": "assets/images/284809/step_02.webp"
    },
    {
      "text": "Wrap each potato in a square of foil, then wrap with a second square. Place foil-wrapped potatoes in a glass or ceramic baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W6EEhb6qjKnQyIOK8YUAt56lSZM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-284809-crispy-jacket-potatoes-VAT-step-03-1-44fb6866b067474eb27d185b20d6157e.jpg"
      ],
      "image": "assets/images/284809/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until the skins are crisp and the flesh is soft, 60 to 90 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9Lo8K0URH_0-bDeEz7wbu2UiqD8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-284809-crispy-jacket-potatoes-VAT-step-04-2-c572c8f7565c4f62a33f97275959878b.jpg"
