  "ingredients": [
    "2 tablespoons vegetable oil",
    "6 skinless, boneless chicken breast halves",
    "0.5 cup teriyaki basting sauce",
    "0.5 cup Ranch-style salad dressing",
    "1 cup shredded Cheddar cheese",
    "3 green onions, chopped",
    "0.5 (3 ounce) can bacon bits",
    "1 tablespoon chopped fresh parsley, for garnish"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add chicken breasts, and sauté until lightly browned, about 4 to 5 minutes on each side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place browned chicken breasts in a 9x13-inch baking dish. Brush with teriyaki sauce, then spoon on salad dressing. Sprinkle with cheese, green onions, and bacon bits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink and juices run clear, 25 to 35 minutes. Garnish with parsley and serve.",
      "section": null,
      "name": null,
      "url": null,
