  "ingredients": [
    "1 spaghetti squash, halved and seeded",
    "1 pound ground beef",
    "0.5 cup diced green bell pepper",
    "0.5 cup diced red bell pepper",
    "0.25 cup diced red onion",
    "1 clove garlic, chopped",
    "1 (14.5 ounce) can Italian-style diced tomatoes, drained",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried basil",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "2.25 cups shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place squash, cut-sides down, on a baking sheet",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tender, about 40 minutes. Cool; scrape flesh into spaghetti-like strands using a fork. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce the oven temperature to 350 degrees F (175 degrees C). Lightly grease a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir ground beef in a large skillet over medium heat until evenly browned and crumbly. Drain. Stir in bell peppers, red onion, and garlic; cook and stir until vegetables are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir squash stands and tomatoes into beef mixture; season with oregano, basil, salt, and black pepper. Cook and stir until heated through. Off heat, stir in 2 cups cheese until melted. Transfer to the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes. Sprinkle remaining ¼ cup cheese over top; continue baking until cheese is melted, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
