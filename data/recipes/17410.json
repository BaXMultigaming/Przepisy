  "ingredients": [
    "1.5 cups graham cracker crumbs",
    "0.33333334326744 cup packed brown sugar",
    "0.5 teaspoon ground cinnamon",
    "0.33333334326744 cup butter, melted",
    "2 (8 ounce) packages cream cheese",
    "2 teaspoons lemon juice",
    "1 pint heavy whipping cream",
    "0.33333334326744 cup white sugar",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Stir graham cracker crumbs, brown sugar, and cinnamon together in a small bowl; add melted butter and mix well. Press into the bottom of an 8- or 10-inch springform pan. Chill until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lYJdjNPNNG0tn9LrLv2ac7RpXi0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17410_BestNo-BakeCheesecake_Step1_CD_555991-4x3-bb05c5e2e8964a679ae76438242b6f9c.jpg"
      ],
      "image": "assets/images/17410/step_01.webp"
    },
    {
      "text": "Beat cream cheese and lemon juice together in a medium bowl until soft. Add whipping cream and beat with an electric mixer until the batter becomes thick. Add sugar and continue to beat until stiff.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NsnyvDD1-WvAM6JRyVM-SiBZd9k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17410_BestNo-BakeCheesecake_Step3_CD_556021-4x3-eb48a8beb2cb4d0181179c407bbd2a92.jpg"
      ],
      "image": "assets/images/17410/step_02.webp"
    },
    {
      "text": "Pour into chilled crust, and top with pie filling or fresh fruit. Chill for several hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8W_Nf5N7Ei9RrXSfCOipIlUZfGM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17410_BestNo-BakeCheesecake_Step3_CD_556051-4x3-9b147844f7804b358aadf81a3899b229.jpg"
      ],
      "image": "assets/images/17410/step_03.webp"
    },
    {
      "text": "Just before serving, remove the sides of the springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sonioQduCuYhKFzfBGuarKOTPno=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17410_BestNo-BakeCheesecake_4x3_CD_556161-4x3-74185af73481413986a2d5ff3eec071b.jpg"
      ],
