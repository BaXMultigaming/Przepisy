  "ingredients": [
    "6 large ripe beefsteak tomatoes, chopped",
    "1 large cucumber, chopped",
    "1 medium green bell pepper, chopped",
    "1 medium yellow bell pepper, chopped",
    "1 large sweet onion, chopped",
    "1 small jalapeno pepper, seeded and diced, or to taste",
    "1 clove garlic, minced",
    "4 tablespoons extra-virgin olive oil",
    "3 tablespoons sherry vinegar",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Set aside a few pieces of tomato, cucumber, and bell peppers for garnish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining tomatoes, cucumber, and bell peppers with onion, jalapeno, and garlic in a food processor; process until all vegetable are finely chopped. Mix in olive oil, sherry vinegar, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate until chilled, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with pepper before serving and garnish with reserved tomatoes, cucumbers, and bell peppers.",
      "section": null,
