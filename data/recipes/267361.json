  "ingredients": [
    "2 packets CARNATION BREAKFAST ESSENTIALS® Rich Milk Chocolate High Protein Powder Drink Mix",
    "0.75 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup applesauce",
    "0.5 cup plain low-fat Greek yogurt",
    "0.33333334326744 cup white sugar",
    "1 egg",
    "0.75 teaspoon vanilla extract",
    "0.5 cup dark chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line 9 muffin wells with cupcake liners or coat with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together powder drink mix, flour, baking soda, baking powder, and salt in a medium bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together applesauce, yogurt, sugar, egg, and vanilla in a large bowl. Add flour mixture; mix until just combined. Fold in chocolate chips. Portion batter evenly into the prepared muffin wells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 7 minutes. Reduce heat to 350 degrees F (175 degrees C) and continue baking until the center of muffins spring back when lightly pressed, 10 to 12 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
