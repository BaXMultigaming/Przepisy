  "ingredients": [
    "2 anchovy fillets",
    "2 cloves garlic, chopped, or to taste",
    "1 cup mayonnaise",
    "0.33333334326744 cup grated Parmesan cheese",
    "0.25 cup half-and-half",
    "2 tablespoons fresh lemon juice",
    "1 tablespoon Dijon mustard",
