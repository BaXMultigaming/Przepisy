  "title": "Chinese Pork Rib Tips",
  "description": "These Chinese pork rib tips are served in a scrumptious sweet and sour sauce made with ginger, soy sauce, rock sugar, and vinegar.",
  "authors": [
    "mengqi"
  ],
  "date_published": "2020-06-19T00:39:22-04:00",
