  "ingredients": [
    "0.5 tablespoon vegetable oil",
    "4 slices fresh ginger",
    "2 pounds pork loin rib tips",
    "1 cup boiling water, or more if needed",
    "2 tablespoons rock sugar, or to taste",
    "1.5 tablespoons white vinegar",
    "1 tablespoon soy sauce"
  ],
  "steps": [
    {
      "text": "Heat a cast iron pan over medium-high heat. Add oil, ginger, and rib tips, in that order, to the hot pan. Stir-fry until the surface of the ribs turns golden on all sides, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour enough boiling water on top of the ribs to just cover. Cover with a lid and cook for 10 minutes. Uncover and continue cooking until water is almost absorbed, 5 to 20 minutes more. Be careful not to burn ribs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add rock sugar, vinegar, and soy sauce. Stir until well combined and cook until sauce thickens, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
