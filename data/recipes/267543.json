  "ingredients": [
    "3 large apples - peeled, cored, and chopped",
    "0.25 cup white sugar",
    "2 tablespoons apple cider vinegar",
    "1 tablespoon dried thyme",
    "1 bay leaf",
    "2 tablespoons brandy (such as Calvados®)",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Combine apples, sugar, vinegar, thyme, and bay leaf in a saucepan over medium-low heat. Cook until the apples are soft and start breaking apart, about 10 minutes, stirring often.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to the slow cooker and cover with lid. Cook on high heat until it thickens, about 1 to 2 hours, stirring regularly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in brandy and season with salt. Transfer to a sterilized jar and let cool, then refrigerate or freeze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
