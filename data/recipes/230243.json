  "ingredients": [
    "2 prepared pie crusts",
    "4 cups peeled and sliced apples",
    "2 cups cranberries",
    "0.75 cup white sugar",
    "1 tablespoon cornstarch",
    "1 teaspoon ground cinnamon",
    "2 tablespoons butter, cut into small pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line the bottom and sides of a 9-inch pie plate with one pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange sliced apples in prepared crust; spread cranberries over apples. Whisk sugar, cornstarch, and cinnamon in a small bowl; sprinkle mixture over cranberries. Distribute butter pieces over pie filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover filling with remaining pie crust; crimp both crusts together, and cut several slits into top crust to vent steam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pie is browned and fruit filling is bubbling, 45 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
