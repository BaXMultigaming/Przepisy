  "ingredients": [
    "1 (8 ounce) package fusilli pasta",
    "1 tablespoon olive oil",
    "2 teaspoons salt",
    "0.33329999446869 cup butter",
    "0.33329999446869 cup all-purpose flour",
    "3 cups milk",
    "0.75 cup grated Parmesan cheese",
    "1 teaspoon salt",
    "0.5 teaspoon garlic salt",
    "0.125 teaspoon ground nutmeg",
    "0.125 teaspoon dried thyme",
    "1.5 cups shredded sharp Cheddar cheese",
    "1.5 pounds fresh broccoli, cooked",
    "0.75 cup shredded Swiss cheese"
  ],
  "steps": [
    {
      "text": "In a large pot of boiling salted water cook rigatoni or fusilli pasta with one tablespoon of oil until al dente. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, in a large saucepan melt butter or margarine. Stir in flour and milk and whisk until mixture boils and thickens. Add grated Parmesan cheese, salt, garlic salt, nutmeg, thyme and grated Cheddar cheese and stir until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cooked broccoli and drained pasta to cheese sauce. Mix well. Pour into a greased 9x13 inch baking dish. Sprinkle with grated Swiss cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered at 350 degrees C(175 degrees C) for 20 minutes. Let stand 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
