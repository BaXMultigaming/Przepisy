      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MtPCb870aKr5Ty_l2ILO3EEpJBQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26673-the-best-sweet-and-sour-meatballs-step3-170-1-e6a6234afb6748ef8b63afca74a889be.jpg"
      ],
      "image": "assets/images/26673/step_03.webp"
    },
    {
      "text": "Stir water, sugar, vinegar, soy sauce, and flour together in a large saucepan until well combined.",
      "section": null,
      "name": null,
      "url": null,
