  "ingredients": [
    "1 pound ground beef",
    "1 onion, diced",
    "1 egg",
    "0.25 cup dry bread crumbs",
    "1.5 cups water",
    "1 cup packed brown sugar",
    "0.25 cup distilled white vinegar",
    "3 tablespoons soy sauce",
    "3 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Mix beef, onion, egg, and bread crumbs together in a medium bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
