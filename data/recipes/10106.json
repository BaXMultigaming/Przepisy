  "ingredients": [
    "1 cup graham cracker crumbs",
    "1 cup semisweet chocolate chips",
    "1 cup chopped walnuts",
    "1 cup shredded coconut",
    "0.25 cup butter, melted",
    "1 (14 ounce) can sweetened condensed milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly grease a 9x9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham cracker crumbs, chocolate chips, walnuts, and coconut in a medium bowl. Pour melted butter over graham mixture and stir. Press into the prepared baking pan. Drizzle condensed milk over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly colored on top, 25 to 30 minutes. Let cool before cutting into 24 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
