  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter",
    "0.25 cup milk",
    "2 eggs, well beaten",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon cream of tartar",
    "1 pinch salt",
    "1 cup mashed bananas",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a bowl using an electric mixer until creamy and smooth; mix in milk, eggs, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, baking soda, cream of tartar, and salt together in a bowl; stir flour mixture into butter mixture until just combined. Fold in bananas and walnuts. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake into the preheated oven until a toothpick inserted in the center of the cake comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
