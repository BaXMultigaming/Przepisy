  "ingredients": [
    "2 tablespoons butter",
    "2 (14 ounce) cans chicken broth",
    "1 teaspoon chicken bouillon granules",
    "1 (12 ounce) package egg noodles"
  ],
  "steps": [
    {
      "text": "Melt butter in a medium saucepan over medium heat; simmer, stirring frequently, until butter is browned, fragrant, and foamy, with brown bits in it, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken broth and bouillon to the pan with the butter; bring to a boil over high heat. Stir in egg noodles, bring to a second boil, cover, and turn off heat; leave pot on the same burner. Let stand for 30 minutes, stirring 2 or 3 times.",
      "section": null,
      "name": null,
