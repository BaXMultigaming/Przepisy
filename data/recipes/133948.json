  "ingredients": [
    "0.25 cup olive oil",
    "1 tablespoon minced garlic",
    "0.5 teaspoon sea salt",
    "8 Roma tomatoes, sliced",
    "2 (12 inch) pre-baked pizza crusts",
    "8 ounces shredded Mozzarella cheese",
    "4 ounces shredded Fontina cheese",
    "10 fresh basil leaves, washed, dried",
    "0.5 cup freshly grated Parmesan cheese",
    "0.5 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Stir together olive oil, garlic, and salt; toss with tomatoes, and allow to stand for 15 minutes. Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush each pizza crust with some of the tomato marinade. Sprinkle the pizzas evenly with Mozzarella and Fontina cheeses. Arrange tomatoes overtop, then sprinkle with shredded basil, Parmesan, and feta cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the cheese is bubbly and golden brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
