  "ingredients": [
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "0.5 cup shortening",
    "0.75 cup cold milk"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X0yIlTciLFE0K8LIFVTWDts6ZXI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20075-Basic-Biscuits-mfs-STEP-001-b3b05daa90a44c9e8698c9a41aa64aad.jpg"
      ],
      "image": "assets/images/20075/step_01.webp"
    },
    {
      "text": "Sift flour, baking powder, and salt together in a large mixing bowl; cut in shortening with a fork or pastry blender until mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XWCBRcmDOsCTaRR7uy15lrbIhEQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20075-Basic-Biscuits-mfs-STEP-010-ae0ac8e0f4554a9981351a47b80d9d13.jpg"
      ],
      "image": "assets/images/20075/step_02.webp"
    },
    {
      "text": "Pour milk into flour mixture while stirring with a fork. Mix in milk until dough is soft, moist and pulls away from the side of the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V7nuBw61eKWWpSRZcIZ5nvasvkw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20075-Basic-Biscuits-mfs-STEP-016-d02d1a44490e413899ede1b007638919.jpg"
      ],
      "image": "assets/images/20075/step_03.webp"
    },
    {
      "text": "Turn dough out onto a lightly floured surface and knead dough briefly, 5 to 7 times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZOj-d3GBWbYaklElbALqDZelwbg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20075-Basic-Biscuits-mfs-STEP-018-98012897b56544a79bfa0afd85886a5e.jpg"
      ],
      "image": "assets/images/20075/step_04.webp"
    },
    {
      "text": "Roll dough out into a 1/2 inch thick sheet and cut out biscuits with a floured cookie cutter. Press together unused dough and repeat rolling and cutting procedure.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B8iRxCFXqTJbH3HGbyjGYfxv_GI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20075-Basic-Biscuits-mfs-STEP-024-ee6347826b6a4c4f867acc9eae2ebcd2.jpg"
      ],
      "image": "assets/images/20075/step_05.webp"
    },
    {
      "text": "Place biscuits on ungreased baking sheets and bake in preheated oven until golden brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vVeRRRQRo0Ta-nCNWkGRC3apYiM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20075-Basic-Biscuits-mfs-STEP-026-4e6f40658141456ebb45abe1447b65ba.jpg"
      ],
      "image": "assets/images/20075/step_06.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DD32k0MHZvLgjRrq4wphlc6-RYU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20075-basic-biscuits-RitaPellegriniAllrecipes-4x3-1ba2cb23e05c41f8a081d132d66c17d9.jpg"
