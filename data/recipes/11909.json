  "ingredients": [
    "1 tablespoon olive oil",
    "1 onion, chopped",
    "2 tablespoons minced garlic",
    "2 (10 ounce) packages frozen chopped spinach, thawed",
    "3 tablespoons sour cream",
    "1 (10.75 ounce) can condensed cream of celery soup",
    "0.5 cup grated Parmesan cheese",
    "1 cup chopped ham",
    "8 ounces spaghetti"
  ],
  "steps": [
    {
      "text": "Cook noodles in a large pot of boiling water until al dente. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile prepare the sauce. Heat oil in a medium saucepan over medium heat. Add onions, and ham if desired. Cook until onion is transparent, 2 to 3 minutes. Add garlic, and cook for 30 seconds. Stir in thawed spinach. Mix in sour cream, cream of celery soup, and Parmesan cheese. Reduce heat to low, and heat through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve spinach sauce over spaghetti or egg noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
