  "ingredients": [
    "1 (8 ounce) package refrigerated crescent rolls",
    "1 (8 ounce) package cream cheese, softened",
    "1 (1 ounce) package Ranch-style dressing mix",
    "2 carrots, finely chopped",
    "0.5 cup chopped red bell peppers",
    "0.5 cup chopped green bell pepper",
    "0.5 cup fresh broccoli, chopped",
    "0.5 cup chopped green onions"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out crescent rolls onto a large nonstick baking sheet. Stretch and flatten to form a single rectangular shape on the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 11 to 13 minutes. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese with 1/2 of the ranch dressing mix in a medium bowl; add more dressing mix to taste. Spread mixture over cooled crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange carrots, bell peppers, broccoli, and green onions on top. Chill in the refrigerator for about 1 hour. Cut into 48 bite-sized squares to serve.",
      "section": null,
      "name": null,
      "url": null,
