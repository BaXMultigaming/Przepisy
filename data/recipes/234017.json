  "ingredients": [
    "1 ham bone with some meat",
    "2.5 cups yellow split peas",
    "5 stalks celery, diced",
    "4 carrots, diced",
    "0.5 large Spanish onion, diced",
    "2 tablespoons kosher salt",
    "2 teaspoons dried thyme",
    "1 bay leaf",
    "1 pinch ground black pepper, or to taste",
    "8 cups water, or as needed"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4ZZQmVeWtUPAGhtJQIf5_Ep0iIw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234017-canadian-yellow-split-pea-soup-with-ham-DDMFS-012-4x3-step-01-1979353ea3bd455a895c34a634edfb4f.jpg"
      ],
      "image": "assets/images/234017/step_01.webp"
    },
    {
      "text": "Place ham bone, yellow split peas, celery, carrots, onion, salt, thyme, bay leaf, and pepper into a large pot; pour in water. Bring mixture to a boil and skim off any foam with a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dpNQ3gO8t2oZFYCf3GTZlAb4dD0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234017-canadian-yellow-split-pea-soup-with-ham-DDMFS-018-4x3-step-02-ff4c91cd0e554b5a838cab28aceee078.jpg"
      ],
      "image": "assets/images/234017/step_02.webp"
    },
    {
      "text": "Reduce heat and place a lid on the pot, slightly ajar to allow some evaporation. Simmer, stirring occasionally, until yellow split peas are tender and soup is thick, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IcXs_a6pwJC4sbbvFqlyJ8a9nrk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234017-canadian-yellow-split-pea-soup-with-ham-DDMFS-018-4x3-step-03-077f20ea990f4ca49e2ac311facf8165.jpg"
      ],
      "image": "assets/images/234017/step_03.webp"
    },
    {
      "text": "Remove ham bone from soup; remove meat from ham bone, chop or shred, and return to the pot.",
