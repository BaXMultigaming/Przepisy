  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 onion, chopped",
    "1 stalk celery, chopped",
    "1 clove garlic, minced",
    "2 (16 ounce) cans white kidney beans, rinsed and drained",
    "1 (14 ounce) can chicken broth",
    "0.25 teaspoon ground black pepper",
    "0.125 teaspoon dried thyme",
    "2 cups water",
    "1 bunch fresh spinach, rinsed and thinly sliced",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Heat oil in a large soup pot over medium-low heat. Add onion and celery; cook and stir until tender, about 5 to 8 minutes. Add garlic, and cook for 30 seconds, continually stirring.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3Oqu2FXbtmt2hIB5ni_mPyeZO3k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13287-creamy-italian-white-bean-soup-ddmfs-step-1-309-0a4cceff00104c0f87aaa4af0f5bc4da.jpg"
      ],
      "image": "assets/images/13287/step_01.webp"
    },
    {
      "text": "Stir in beans, chicken broth, pepper, thyme, and 2 cups water. Bring to a boil, reduce heat, and simmer for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mPbaUATgBJ2MReqqCfEPasf-Lxs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13287-creamy-italian-white-bean-soup-ddmfs-step-2-311-3d0cf0db5960474aab15c1b136fc5126.jpg"
      ],
      "image": "assets/images/13287/step_02.webp"
    },
    {
      "text": "Use a slotted spoon to remove 2 cups of bean and vegetable mixture from soup; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend remaining soup in small batches in a blender at low speed until smooth — it helps to remove the center piece of the blender lid to allow steam to escape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N_vmSg0Kw5kpLO03ataJqvj5Duw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13287-creamy-italian-white-bean-soup-ddmfs-step-3-320-9ddfa4dddb824e9e9a3f0ba6cbf4afc5.jpg"
      ],
      "image": "assets/images/13287/step_04.webp"
    },
    {
      "text": "Pour blended soup back into pot; stir in reserved beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring soup to a boil, occasionally stirring. Stir in spinach and until spinach is wilted, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1BEhbLALOMVlbNnisySlhUr71rY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13287-creamy-italian-white-bean-soup-ddmfs-step-4-323-c53a9ede95bf4708a572864a010d6808.jpg"
      ],
      "image": "assets/images/13287/step_06.webp"
    },
    {
      "text": "Stir in lemon juice and remove from heat. Serve soup with freshly grated Parmesan cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
