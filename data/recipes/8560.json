  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "0.25 cup all-purpose flour for dusting",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "2 tablespoons olive oil",
    "2.5 cups fresh sliced mushrooms",
    "2 cups heavy cream",
    "1 cup champagne"
  ],
  "steps": [
    {
      "text": "Lightly dust chicken breasts with flour and a little salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, lightly brown chicken breasts to a nice golden brown in olive oil. Once browned on both sides, add mushrooms and champagne. Cook over medium heat, champagne should boil a little, for approximately 1/2 hour. When chicken is tender, transfer chicken to a platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cream into skillet. Simmer about 5 minutes, until slightly thickened. Pour sauce over chicken breasts. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
