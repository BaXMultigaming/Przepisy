  "ingredients": [
    "1 large egg white",
    "1 cup sugar",
    "2 tablespoons water",
    "1 teaspoon ground cinnamon",
    "0.75 teaspoon salt",
    "1 pound pecan halves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Lightly butter a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white in a large bowl until foamy. Mix in sugar, water, cinnamon, and salt until combined. Stir in pecan halves, stirring until well coated. Spread on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour, stirring every 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
