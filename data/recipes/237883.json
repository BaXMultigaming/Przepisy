  "ingredients": [
    "1 cup mayonnaise",
    "0.25 cup shredded Parmesan cheese",
    "3 cloves garlic, minced",
    "0.5 teaspoon paprika",
    "0.25 teaspoon red pepper flakes",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "3 large baking potatoes, cut into 1/4-inch slices",
    "1 large sweet onion, sliced",
    "4 12x12-inch squares aluminum foil",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise, Parmesan cheese, garlic, paprika, pepper flakes, salt, and black pepper in a large bowl. Add potatoes and onion; stir to completely coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange aluminum foil squares on a work surface; coat each with cooking spray. Divide potato mixture among foil squares; fold foil to enclose mixture and crimp edges together to form secure packets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until potatoes are tender, about 30 minutes.",
      "section": null,
      "name": null,
