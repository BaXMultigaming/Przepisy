  "ingredients": [
    "1 cup chopped walnuts",
    "1 (12 ounce) package frozen dinner roll dough",
    "1 (5 ounce) package instant vanilla pudding mix",
    "1 cup brown sugar",
    "2 teaspoons ground cinnamon",
    "0.5 cup margarine, melted"
  ],
  "steps": [
    {
      "text": "Sprinkle nuts in the bottom of a greased Bundt pan. Lay frozen roll dough on top of nuts. Sprinkle pudding mix, brown sugar, and cinnamon over dough. Pour melted margarine over mixture. Lay a damp paper towel over the pan and place it in a cold oven for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the pan from the oven in the morning. Discard the paper towel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes. Remove from the oven and let sit for a few minutes, then invert onto a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
