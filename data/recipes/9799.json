  "ingredients": [
    "1 cup all-purpose flour",
    "0.25 cup butter",
    "1 egg",
    "2 tablespoons ground almonds",
    "0.25 cup white sugar",
    "1 cup any flavor fruit jam",
    "0.33333334326744 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift the flour into a bowl and cut in the butter or margarine. Mix in the sugar and almonds. Using a fork, mix in the egg until dough becomes stiff.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead dough on a lightly floured surface until smooth. Roll out dough into a thin layer and cut into rounds, 2 inches wide. Re-roll trimmings and cut until you have 20 rounds. Place rounds on cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 minutes in the preheated oven, or until light brown. Let cool on the sheet for about 3 minutes, then transfer to wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When biscuits are completely cold, spread half of the rounds with a thin layer of preserves and sandwich together. Dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
