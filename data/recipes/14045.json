  "ingredients": [
    "1 (16 ounce) package garden herb tofu, crumbled",
    "2 tablespoons vegetable oil",
    "1 clove garlic, minced",
    "0.5 cup chopped onion",
    "2 teaspoons chili powder",
    "0.25 teaspoon paprika",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon ground cumin",
    "0.25 teaspoon salt",
    "0.5 lime, juiced",
    "0.5 cup tomato sauce",
    "0.25 cup chopped fresh cilantro",
    "8 medium taco shells, heated",
    "2 cups shredded lettuce",
    "2 tomatoes, chopped",
    "1 avocado - peeled, pitted and diced",
    "1 cup shredded Cheddar cheese",
    "0.25 cup salsa"
  ],
  "steps": [
    {
      "text": "Cook tofu, oil, garlic, and onion in a large skillet over medium heat for 5 minutes. Add chili powder, paprika, cayenne, cumin, salt, lime juice, and tomato sauce to the skillet and stir. Cook for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in cilantro. Spoon mixture into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon tofu mixture into taco shells. Top the mixture with lettuce, tomatoes, avocado, cheese, and salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
