  "ingredients": [
    "2 tablespoons olive oil",
    "4 cloves garlic, minced",
    "1 prepared pizza crust",
    "1.5 cups shredded pepper Jack cheese",
    "0.5 cup shredded Cheddar cheese",
    "6 slices bacon, cooked and crumbled",
    "15 hamburger dill pickle chips, or more to taste",
    "1 teaspoon crushed red pepper flakes",
    "1 teaspoon chopped fresh dill"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oil and garlic together in a small bowl and brush over pizza crust. Pre-bake crust in the preheated oven for 2 minutes. Remove from oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Evenly sprinkle pizza crust with pepper Jack cheese and Cheddar cheese and return to the hot oven. Bake until cheese is melted, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Evenly distribute crumbled bacon, pickle slices, and crushed red pepper flakes over the crust. Return to the oven and bake for 2 more minutes. Garnish with dill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
