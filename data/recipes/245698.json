  "ingredients": [
    "3 pounds king crab legs",
    "6 tablespoons butter",
    "1 tablespoon seafood seasoning (such as Old Bay®), or to taste",
    "1 teaspoon lemon juice",
    "1 clove garlic, minced",
    "0.25 cup olive oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Place crab legs in a shallow baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a small saucepan over medium heat until melted, about 3 minutes. Whisk in seafood seasoning, lemon juice, garlic, and olive oil. Brush crab legs with butter mixture and pour any remaining mixture over crab legs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until opaque and flaky, basting regularly with the butter mixture in the pan, 25 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
