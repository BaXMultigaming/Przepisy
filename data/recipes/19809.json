  "ingredients": [
    "1 (14 ounce) can sweetened condensed milk",
    "1 (12 fluid ounce) can evaporated milk",
    "1 cup white sugar",
    "2 tablespoons vanilla extract",
    "1 pinch salt",
    "6 cups milk, or as needed"
  ],
  "steps": [
    {
      "text": "Combine condensed milk, evaporated milk, sugar, vanilla, and salt in freezer canister of ice cream maker, and stir well. Add enough milk to bring mixture to the fill line on canister. Freeze according to manufacturer's directions.",
