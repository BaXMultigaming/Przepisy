  "title": "Tourtière (French Canadian Meat Pie)",
  "description": "Serve this tourtière recipe on holidays for an incredibly impressive, simple, homemade meat pie with savory, spiced pork, beef, and potato filling.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2017-12-12T04:16:12-05:00",
  "date_modified": "2025-12-31T16:33:12-05:00",
  "prep_time": "PT20M",
  "cook_time": "PT120M",
  "total_time": "PT145M",
  "yield": [
    "8",
    "1 (9-inch) pie"
  ],
  "categories": [
    "Dinner"
  ],
