  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "3 cups all-purpose flour",
    "2 sticks unsalted butter, sliced, frozen",
    "1 teaspoon kosher salt",
    "7 tablespoons ice-cold water, or as needed",
    "2 teaspoons distilled white vinegar",
    "2 teaspoons kosher salt",
    "1 teaspoon freshly ground black pepper",
    "1 teaspoon dried thyme",
    "0.5 teaspoon dried sage",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon freshly grated nutmeg",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon ground mustard",
    "0.125 teaspoon ground cloves",
    "1 pinch cayenne pepper",
    "1 large russet potato, peeled, quartered",
    "1 teaspoon kosher salt",
    "1 tablespoon butter",
    "1 large onion, finely chopped",
    "0.5 cup finely diced celery",
    "4 cloves garlic, crushed",
    "1 pound ground pork",
    "1 pound ground beef",
    "1 cup potato cooking water, plus more as needed",
    "1 large egg",
    "1 tablespoon water"
  ],
  "steps": [
    {
      "text": "Add flour, butter, and salt to the bowl of a food processor. Pulse until butter is pea-sized, about 30 seconds. Stir water and vinegar together in a small bowl; drizzle over flour mixture. Pulse until mixture is crumbly, but holds together when pinched, about 10 seconds. Drizzle in more cold water a little at a time if dough is too dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nlKifBQxaCSICwXS5vD4kOhRrvU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-261983-Tourtiere-ddmfs-step-2-df377ce90f364ff8b35a3c1e27a6026b.jpg"
      ],
      "image": "assets/images/261983/step_01.webp"
    },
    {
      "text": "Transfer mixture to a work surface; form a ball, then flatten into a disc. Wrap in plastic; refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rPeyQXaVWlyIg-3dUDLUfMdJqpc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-261983-Tourtiere-ddmfs-step-3-2a7b4a690077416fb1fd3de608e2cb95.jpg"
      ],
      "image": "assets/images/261983/step_02.webp"
    },
    {
      "text": "Mix salt, black pepper, thyme, sage, cinnamon, ginger, nutmeg, allspice, mustard, clove, and cayenne together in a small bowl for the spice blend; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2XLno1izw2jPHnYbDQP_eTQUh7A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-261983-Tourtiere-ddmfs-step-4-1d596abc77d3482c882c42a1460778ff.jpg"
      ],
      "image": "assets/images/261983/step_03.webp"
    },
    {
      "text": "Add potato and 1 teaspoon salt to a medium saucepan; cover with cold water. Bring to a boil over medium-high heat. Reduce heat to low; simmer until tender, 10 to 15 minutes. Transfer potato to a large bowl with a slotted spoon; mash until smooth (reserve cooking water); set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Lb5fovZynJ9qNItNqr0seVlL1oo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-261983-Tourtiere-ddmfs-step-6-4e2966c6763a4046ad0b12c3dd59772a.jpg"
      ],
      "image": "assets/images/261983/step_04.webp"
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add onion and a pinch of salt. Cook until onions are golden, 10 to 15 minutes. Add celery, garlic, and spice blend to the skillet; stir until well combined, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IFCSgqdu_MuG-UKFPO3jKMZOZC4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-261983-Tourtiere-ddmfs-step-7-29e88e8c33704aaea58bf3c4994bfd39.jpg"
      ],
      "image": "assets/images/261983/step_05.webp"
    },
    {
      "text": "Add pork, beef, and about 3/4 cup of reserved cooking water to the skillet for filling. Cook, stirring occasionally, until meat is brown, and most of the liquid has evaporated, about 45 minutes. Stir in potato, turn off the heat, and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XRqjMGRRqIsCYxqt-dL0t6Sc5RI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-261983-Tourtiere-ddmfs-step-8-bda3d01ceb5241059d1aa55153c6c1b4.jpg"
      ],
      "image": "assets/images/261983/step_06.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 2 pieces, 1 slightly larger than the other. Roll larger piece into a 12-inch circle on a lightly floured work surface. Place in a 9-inch, deep-dish pie plate. Roll remaining dough into an 11-inch circle; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q9je5se2Quzz2YDc9fDF7SiPUg0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-261983-Tourtiere-ddmfs-step-9-7daed33a9b254bdf830e9aad3a5f9595.jpg"
      ],
      "image": "assets/images/261983/step_08.webp"
    },
    {
      "text": "Fill bottom crust evenly with meat mixture; whisk egg and water together in a small bowl for egg wash. Brush egg wash over edges of crust. Cover with top crust; press lightly around edges to seal. Trim excess dough; crimp edges. Cut small slits in top crust for steam to escape. Brush surface of pie with egg wash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/56HgjEXwEaefgMCVOVZazlvQOAA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7487665_tourtiere-french-canadian-meat-pie-4x3-5c9c6d268ead4621a665b37ca81acfa3.jpg"
      ],
      "image": "assets/images/261983/step_09.webp"
    },
    {
      "text": "Bake in the preheated oven until crust is deep golden, about 1 hour. Let cool to almost room temperature before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2t6OVTEJjJFdtzI0osazJjt5DMY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/4675430-7f35af366bd047e3b92d2769683804fc.jpg"
      ],
      "image": "assets/images/261983/step_10.webp"
    }
  ],
