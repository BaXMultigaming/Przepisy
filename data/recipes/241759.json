  "title": "Matcha Green Tea Ice Cream",
  "description": "This homemade matcha ice cream made with Japanese green tea powder has an earthy, slightly sweet flavor and a luscious green color to delight matcha fans.",
  "authors": [
    "Jennifer"
  ],
  "date_published": "2020-06-19T00:02:36-04:00",
