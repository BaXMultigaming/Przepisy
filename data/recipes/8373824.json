  "title": "Bohemian Orange Chicken",
  "description": "A caraway-scented sweet and sour sauce coats crispy, pan-seared chicken thighs in Chef John's recipe for Bohemian orange chicken.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2022-04-01T09:00:00-04:00",
  "date_modified": "2023-08-04T13:51:29-04:00",
  "prep_time": "PT15M",
  "cook_time": "PT100M",
  "total_time": "PT115M",
