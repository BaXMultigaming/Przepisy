  "ingredients": [
    "1.5 cups dry pinto beans",
    "0.5 teaspoon white sugar",
    "1 teaspoon minced garlic",
    "2 tablespoons finely chopped onion",
    "2 slices smoked bacon",
    "2 cups water",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Place the beans, sugar, garlic, onion, and bacon into a slow cooker. Pour in the water, cover, and cook on High for 6 hours. Drain off 2/3 of the liquid, and discard bacon. Use a potato masher to mash beans to a chunky consistency. Season with salt to taste, and serve hot.",
