  "ingredients": [
    "2 cups white sugar",
    "3 cups all-purpose flour",
    "2 teaspoons baking soda",
    "2 teaspoons salt",
    "2 teaspoons ground cinnamon",
    "1.3333333730698 cups vegetable oil",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "0.5 cup raisins",
    "4 cups chopped, peeled apple"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the sugar, flour, baking soda, salt, and cinnamon. Make a well in the center, and pour in the oil, eggs and vanilla. Mix until well blended. Fold in the raisins and apples. Spread evenly in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 1/2 hours in the preheated oven, until firm and lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
