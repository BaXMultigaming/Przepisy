  "ingredients": [
    "2 large green bell peppers",
    "0.5 pound ground chicken",
    "1 cup cooked rice",
    "0.25 cup chopped onion",
    "1 clove garlic, minced",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "1 cup tomato sauce",
    "0.75 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ht1ASXEEGacNfORRWonMb0gWTKo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/282482-chicken-stuffed-peppers-recipe-VAT-Step-01-1705bb5b8d8f4818b3b017a2f4b0b5a1.jpg"
      ],
      "image": "assets/images/282482/step_01.webp"
    },
    {
      "text": "Cut tops off green peppers and place peppers in a baking pan. Dice any pepper flesh surrounding stems; set aside. Discard seeds and stems.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W3eLC34TORNqnwJbNHracxkvWJQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/282482-chicken-stuffed-peppers-recipe-VAT-Step-02-f376530707024870a6d47b848c43650f.jpg"
      ],
      "image": "assets/images/282482/step_02.webp"
    },
    {
      "text": "Mix ground chicken, rice, onion, garlic, black pepper, and salt together in a bowl. Mix in diced peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nSqT320UMj2tNKI5HkMtgxofF1s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/282482-chicken-stuffed-peppers-recipe-VAT-Step-03-9ee9352d830a4f028afa55b6aca174bd.jpg"
      ],
      "image": "assets/images/282482/step_03.webp"
    },
    {
      "text": "Scoop chicken mixture into the green peppers and cover with tomato sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TaSPCGKY11bEqxiRSntVVpTa_es=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/282482-chicken-stuffed-peppers-recipe-VAT-Step-04-694479da2f7248ffa4c681c5ec6aebf3.jpg"
      ],
      "image": "assets/images/282482/step_04.webp"
    },
    {
      "text": "Cover baking dish with aluminum foil, and bake in the preheated oven for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q-Nr5iuX31m8GqAJwKNDgTPv9sg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/282482-chicken-stuffed-peppers-recipe-VAT-Step-05-2b8aa27d6bd24c13bab0d7d01ff2185c.jpg"
      ],
      "image": "assets/images/282482/step_05.webp"
    },
    {
      "text": "Remove foil and top peppers with mozzarella cheese; continue to bake until filling is cooked through and cheese is golden, about 15 minutes longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KneZaTIfeHhQEYaaPsD9_h1u5dc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/282482-chicken-stuffed-peppers-recipe-VAT-Step-06-094bc6e1b1d44541849ab443e263a55e.jpg"
