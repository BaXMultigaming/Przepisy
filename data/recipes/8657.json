  "ingredients": [
    "1 pound skinless, boneless chicken breast halves - boiled",
    "0.5 cup raisins",
    "1 cup thinly sliced celery",
    "0.75 cup seedless grapes, quartered",
    "0.5 cup walnuts, toasted and chopped",
    "1 avocado - peeled, pitted and diced",
    "1 tart apple - peeled, cored and chopped",
    "1 cup mayonnaise",
    "1 teaspoon fresh lemon juice"
  ],
  "steps": [
    {
      "text": "In a large bowl toss together the chicken, raisins, celery and grapes. Fold in the avocado and the apple. Mix in the mayonnaise and lemon juice. Chill.",
