  "ingredients": [
    "6 baking apples - peeled and cored",
    "0.5 cup cinnamon red hot candies",
    "1 cup water",
    "1 (29 ounce) can sweet potatoes, drained",
    "0.33333298563957 cup packed brown sugar",
    "0.5 cup crushed pineapple, drained",
    "0.25 cup chopped pecans",
    "6 large marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large pot over medium heat, combine the candies and water. Stir until candies are dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the apples and baste frequently until apples begin to soften. Remove from heat and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the sweet potatoes, brown sugar, pineapple and pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stuff the cooled apples with the sweet potato mixture. Mound any remaining mixture on top of apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in 4 quart casserole dish and bake for 20 minutes; place a marshmallow on each apple, return to oven and cook until marshmallows are golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
