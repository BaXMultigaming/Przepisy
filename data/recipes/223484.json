  "ingredients": [
    "1 (14 ounce) can sweetened condensed milk",
    "1 (12 ounce) can evaporated milk",
    "1.25 cups whole milk",
    "0.5 cup peanut butter (no sweetener added)",
    "0.25 cup white sugar",
    "2 teaspoons vanilla extract",
    "6 peanut butter cups, chopped"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zqEQCiOplSr7qa2ccrip1MD8ZYE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223484-homemade-peanut-butter-ice-cream-VAT-009-step-01-cc378f5512464bde8d93ca0f9acd36b7.jpg"
      ],
      "image": "assets/images/223484/step_01.webp"
    },
    {
      "text": "Combine sweetened condensed milk, evaporated milk, whole milk, peanut butter, sugar, and vanilla extract in an ice cream maker; stir until sugar dissolves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c1qZWdXiYfsgiuhGeDuz6Xd0OVQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223484-homemade-peanut-butter-ice-cream-VAT-010-step-02-83abd92139fa495dbf892ed551f4f78a.jpg"
      ],
      "image": "assets/images/223484/step_02.webp"
    },
    {
      "text": "Freeze according to manufacturer's directions until it reaches soft-serve consistency, about 30 minutes, adding peanut butter cups halfway through freezing cycle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TfwRQw1BkfFY5LeqqmOkfohmLqw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223484-homemade-peanut-butter-ice-cream-VAT-011-step-03-b1be2cdcef8145769ef1c8f3e5bace93.jpg"
      ],
      "image": "assets/images/223484/step_03.webp"
    },
    {
      "text": "Transfer ice cream to a one- or two-quart lidded plastic airtight container; cover surface with plastic wrap and seal. For best results, ice cream should firm in the freezer for at least 2 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sIEoQi_0SvEzgGuZvgxcXKo1hzM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223484-homemade-peanut-butter-ice-cream-VAT-012-step-04-b59d97b171d747939dac3095f22b72e9.jpg"
      ],
