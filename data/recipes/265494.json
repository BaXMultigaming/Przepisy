  "ingredients": [
    "18 chocolate sandwich cookies with extra creme filling (such as Double Stuf Oreos®), or more to taste",
    "4 tablespoons butter, melted",
    "2 cups cold milk",
    "1 (3.4 ounce) package instant chocolate pudding mix (such as Jell-O®)",
    "2 (8 ounce) packages cream cheese, softened",
    "1 (12 ounce) container frozen whipped topping, thawed",
    "0.33333334326744 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mVfkCsr5dXfESkEQlOlArEZ-Fps=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265494-grandma-bowens-girdle-buster-cookie-pie-VAT-Step-01-9692b6f637354d0c85af362ea818286a.jpg"
      ],
      "image": "assets/images/265494/step_01.webp"
    },
    {
      "text": "Blend cookies in a food processor until finely crushed. Mix in melted butter. Press crust mixture into the bottom and 1/4 inch up the edges of a 9x9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8dZ-mGRRkdtCeaLy9SbA91WhM9k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265494-grandma-bowens-girdle-buster-cookie-pie-VAT-Step-02-0895ca3b9ccb4d66bc66689da6ff1beb.jpg"
      ],
      "image": "assets/images/265494/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven for 7 minutes. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h7MVrUuwZieTSGOuRlBUzSiBdvM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265494-grandma-bowens-girdle-buster-cookie-pie-VAT-Step-03-2ac2adbeaeef4db79cfaf45b50e54ac5.jpg"
      ],
      "image": "assets/images/265494/step_03.webp"
    },
    {
      "text": "Whisk milk and pudding mix together for 2 minutes. Let stand until thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pOcX_jf9ZLHILTFas_tbNnpV4kk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265494-grandma-bowens-girdle-buster-cookie-pie-VAT-Step-04-540a8fa52970492caaf9063e538ea288.jpg"
      ],
      "image": "assets/images/265494/step_04.webp"
    },
    {
      "text": "Wipe out food processor and blend together cream cheese, 1 cup whipped topping, and confectioners' sugar. Layer cream cheese mixture over the baked crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mF348RHZ8ohm6iEb87Vy69qFrgw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265494-grandma-bowens-girdle-buster-cookie-pie-VAT-Step-05-f7da79bdef2a4ee8bb5bc837a4c48039.jpg"
