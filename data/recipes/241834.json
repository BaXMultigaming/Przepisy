  "ingredients": [
    "4 cups chopped peeled sweet potato",
    "1 sweet onion, cut into wedges",
    "2 cloves garlic, sliced",
    "3 tablespoons olive oil",
    "1 tablespoon balsamic vinegar, or more to taste",
    "1 pinch salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AuIEfw2YN5sin9vzaGYYjL6r_l8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241834-oven-roasted-sweet-potatoes-DDMFS-7793-4x3-step01-c66e3e99de934450b0a168a6cb2aa140.jpg"
      ],
      "image": "assets/images/241834/step_01.webp"
    },
    {
      "text": "Mix sweet potatoes, onion, and garlic in a bowl. Drizzle olive oil over the mixture and toss to coat; pour into a shallow roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nMILpxaAPOsvZzwc9J6KdJwaLaQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241834-OvenRoastedSweetPotatos-Step3-0253-eb151b0920d54c24a128a6a897f8c56d.jpg"
      ],
      "image": "assets/images/241834/step_02.webp"
    },
    {
      "text": "Roast sweet potato mixture in the preheated oven, turning frequently, until the vegetables are soft and golden brown, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ma3wasfFSUbKR1_InuAiKLrYZ-w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241834-OvenRoastedSweetPotatos-Step4-0255-8768655313764e0e86b487e051aeb7bd.jpg"
      ],
      "image": "assets/images/241834/step_03.webp"
    },
    {
      "text": "Remove from the oven. Drizzle balsamic vinegar over the roasted vegetables; season with salt and pepper. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HovI45BvE5yPDaAIQnZ6seCY-QU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241834-oven-roasted-sweet-potatoes-DDMFS-4x3-b9026d7c92e342398cfeb824c0a094b8.jpg"
