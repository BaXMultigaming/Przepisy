  "ingredients": [
    "15 tart apples - peeled, cored, and finely chopped",
    "1/2 cup golden raisins",
    "1 yellow onion, quartered",
    "3 (1 inch) pieces fresh ginger root, peeled",
    "1/2 cup water",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "0.5 teaspoon cinnamon",
    "0.5 teaspoon ground cardamom",
    "0.5 teaspoon white pepper",
    "0.25 teaspoon ground nutmeg",
    "1 cup white wine vinegar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SHXU2Jb6_xp6falNvGnJH_f3GxQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70037-apple-chutney-ddmfs-shot1-3x4-6805-fe44541d6d704eeebef429b656a1e3cf.jpg"
      ],
      "image": "assets/images/70037/step_01.webp"
    },
    {
      "text": "Place apples, raisins, onion, ginger, water, white sugar, brown sugar, cinnamon, cardamom, pepper, and nutmeg into a large saucepan; bring to a boil over medium-high heat, stirring often.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rpSH1W5GR3AZYxMsuMBpU_c8htA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70037-apple-chutney-ddmfs-shot3-3x4-6810-96d659b2990b4017b78e49daa90f786e.jpg"
      ],
      "image": "assets/images/70037/step_02.webp"
    },
    {
      "text": "Reduce heat to low, cover, and simmer, stirring frequently, until apples are tender, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HEpmx0UkX2s0TmQgEIE7eAGyrK4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70037-apple-chutney-ddmfs-shot4-3x4-6839-e3d7e66f77944505b41f093f6a01f8bd.jpg"
      ],
      "image": "assets/images/70037/step_03.webp"
    },
    {
      "text": "Stir and continue simmering, uncovered, until slightly thickened, about 15 minutes more. Remove from heat; discard onion and ginger for smoother consistency. Stir in white wine vinegar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let chutney cool at least 2 hours at room temperature then transfer into a sterilized jar or container. Seal by canning in boiling water bath, and store in the refrigerator for up to 2 weeks until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GLZc5HtKe0ORJcddkXyb5egl8RU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70037-apple-chutney-ddmfs-shot7-3x4-6846-ef525f3973dd4a42b86b773f72a03b91.jpg"
      ],
      "image": "assets/images/70037/step_05.webp"
    }
  ],
