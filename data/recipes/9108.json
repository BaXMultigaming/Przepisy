  "ingredients": [
    "1 pound fresh or frozen cranberries",
    "8 ounces miniature marshmallows",
    "2 cups white sugar",
    "1 (20 ounce) can crushed pineapple with juice",
    "1 banana, peeled and sliced",
    "1 cup whipped cream"
  ],
  "steps": [
    {
      "text": "If using frozen cranberries let thaw before using. In a food processor or blender grind the cranberries. Add the sugar, crushed pineapple and marshmallows. Let mixture stand overnight.",
