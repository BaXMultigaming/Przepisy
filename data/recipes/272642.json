  "ingredients": [
    "nonstick cooking spray",
    "1 (13.8 ounce) can refrigerated pizza dough (such as Pillsbury®)",
    "1 pound ground beef",
    "1 onion, chopped",
    "1 cup mayonnaise",
    "0.125 cup prepared yellow mustard",
    "1.5 cups shredded Cheddar cheese",
    "0.75 cup chopped dill pickles"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a baking sheet with nonstick cooking spray; unroll pizza dough over the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook and stir beef and onion in a skillet over medium heat until beef is browned and crumbly, 5 to 7 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mayonnaise and mustard together in a small bowl. Spread over the parbaked crust. Layer beef-onion mixture, Cheddar cheese, and pickles on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake until crust is dark golden brown, 6 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
