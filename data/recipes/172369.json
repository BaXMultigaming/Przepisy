  "ingredients": [
    "4 fresh figs",
    "0.5 cup pine nuts",
    "4 peaches, halved and pitted",
    "0.25 cup white sugar",
    "1 cup white wine",
    "0.5 cup brandy"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 375 degrees F (190 degrees C). Line a baking sheet with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the figs and pine nuts in the bowl of a food processor and pulse until fine. Place the halved peaches onto the prepared baking sheet, cut side up. Sprinkle evenly with the white sugar. Pour the white wine over the peaches, and stuff them with the fig mixture. Pour the brandy over the peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
