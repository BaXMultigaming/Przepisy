  "ingredients": [
    "1 tablespoon olive oil",
    "3 cups frozen California-blend vegetables (broccoli, carrot, cauliflower)",
    "0.5 cup water",
    "1 stalk celery, chopped",
    "0.5 medium onion, diced",
    "1 clove garlic, minced",
    "1 pinch paprika, or to taste",
    "salt and ground black pepper to taste",
    "1 pound cod fillets"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a 2-quart baking dish with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mixed vegetables, water, celery, onion, and garlic in the bottom of the prepared baking dish. Season with paprika, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly season cod fillets and layer on top of vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in the preheated oven and immediately reduce the heat to 350 degrees F (175 degrees C). Bake until fish flakes easily with a fork, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
