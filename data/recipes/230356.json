  "ingredients": [
    "2 cups water",
    "2 cups milk",
    "1.5 cups steel-cut oats",
    "1 cup water",
    "1 banana, mashed",
    "3 tablespoons ground flax seed",
    "1.5 tablespoons cocoa powder",
