  "ingredients": [
    "6 cups water",
    "2 cups chicken stock",
    "4 medium celery stalks, sliced",
    "3 medium carrots, sliced",
    "0.5 cup chopped yellow onion",
    "2 tablespoons chopped fresh parsley",
    "2 cloves garlic, minced",
    "1 bay leaf",
    "1 teaspoon ground thyme",
    "0.5 teaspoon paprika",
    "salt and ground black pepper to taste",
    "1 pound chopped cooked chicken",
    "4 cups sliced yellow squash"
  ],
  "steps": [
    {
      "text": "Combine water, stock, celery, carrots, onion, parsley, garlic, bay leaf, thyme, paprika, salt, and black pepper in a large pot; bring to a simmer. Cover and cook until vegetables are soft, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken and squash to the pot and simmer until squash is tender, about 10 minutes more.",
