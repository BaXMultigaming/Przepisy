  "ingredients": [
    "1.5 pounds sweet potatoes, peeled and cut into 2-inch pieces",
    "1 cup heavy whipping cream",
    "0.25 cup freshly grated Parmesan cheese",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.125 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Place sweet potatoes in a lined or greased slow cooker. Add heavy cream, Parmesan cheese, salt, black pepper, and nutmeg. Stir to evenly coat sweet potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until sweet potatoes are fork-tender, stirring occasionally, 2 to 3 hours. Stir and mash sweet potatoes. Scoop into a serving dish.",
