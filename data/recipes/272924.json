  "ingredients": [
    "2 teaspoons olive oil",
    "1 red bell pepper, chopped",
    "0.5 onion, diced",
    "1 cup chopped kale, stems removed",
    "2 teaspoons harissa paste (such as CAVA brand)",
    "1 teaspoon minced garlic",
    "6 eggs, beaten",
    "3 slices cooked bacon, crumbled",
    "0.33333334326744 cup crumbled feta",
    "0.25 cup chopped pepperoncini peppers"
  ],
  "steps": [
    {
      "text": "Heat 1/2 the oil in a nonstick pan over medium high heat. Add bell pepper and onion; cook, stirring frequently, until pepper starts to brown, about 5 minutes. Add remaining oil. Stir kale, harissa, and garlic into the hot oil until well combined. Reduce heat to medium; splash in 1 to 2 tablespoons of water if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually stir eggs into the kale mixture. Cook, stirring frequently, until nearly set, about 2 minutes. Mix in bacon, feta, and pepperoncini. Heat through. Transfer to a bowl or plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
