  "ingredients": [
    "12 links spicy pork sausage, sliced",
    "1 tablespoon vegetable oil",
    "0.75 cup diced onion",
    "1.25 teaspoons minced garlic",
    "2 tablespoons chicken soup base",
    "4 cups water",
    "2 potatoes, halved and sliced",
    "2 cups sliced kale",
    "0.33333334326744 cup heavy cream"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sausage links on a baking sheet and bake 25 minutes, or until cooked through. Slice into 1/2 inch slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large saucepan over medium heat. Saute onions until translucent; add garlic and cook 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in broth, water and potatoes; simmer 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low and add sausage, kale and cream; simmer until heated through and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
