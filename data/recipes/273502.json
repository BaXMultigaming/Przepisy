  "ingredients": [
    "0.5 teaspoon vegetable oil",
    "5 links precooked apple chicken sausage, sliced into rounds",
    "2 sweet potatoes, diced",
    "2 apples, diced",
    "0.25 cup water",
    "0.25 cup brown sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat oil in a large, deep skillet over medium-high heat. Add sausage slices and cook until browned, about 5 minutes. Remove sausage and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sweet potatoes and half the water to the skillet; boil for 5 minutes. Stir in the sausage, apples, remaining water, sugar, and cinnamon. Season with salt and pepper; reduce heat to medium. Cover and cook, stirring occasionally, until potatoes are soft, 10 to 15 minutes. Serve hot.",
