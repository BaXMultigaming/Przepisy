      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TlrOgLCca2Nt1oqICXO3Z3y-B8g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_24052_Brigadeiro_Shot2_12817-956416da930049f19cdddf262f943dd8.jpg"
      ],
      "image": "assets/images/24052/step_02.webp"
    },
    {
      "text": "Transfer mixture into a shallow bowl and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pinch off some of the dough and roll into a small ball; place on a plate. Repeat with remaining mixture, then roll each brigadeiro in chocolate sprinkles.",
