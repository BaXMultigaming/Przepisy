  "ingredients": [
    "0.25 cup butter",
    "3 cloves garlic, chopped",
    "1.5 pounds medium shrimp - peeled and deveined",
    "4 tablespoons tequila",
    "3 tablespoons fresh lime juice",
    "0.5 teaspoon salt",
    "0.25 teaspoon chili powder",
    "0.25 cup chopped fresh cilantro",
    "1 lime, cut into wedges"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Add garlic; cook and stir, about 30 seconds. Add shrimp; cook and stir until pink, about 3 minutes. Add tequila and lime juice; season with salt and chili powder. Simmer until liquid has evaporated, about 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour shrimp on a serving plate; garnish with cilantro. Serve with lime wedges.",
