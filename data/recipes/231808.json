  "ingredients": [
    "1 pound ground beef",
    "2 (15 ounce) cans tomato sauce",
    "1 teaspoon white sugar",
    "1 teaspoon garlic salt",
    "1 teaspoon salt",
    "1 (8 ounce) package egg noodles",
    "1 cup sour cream",
    "3 ounces cream cheese, softened",
    "1 large white onion, diced",
    "0.5 cup shredded sharp Cheddar cheese, or more to taste"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-YPly8odCQVFinMaQ8XTXZfu9fg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231808-GrandmasGroundbeefCasserole-mfs-Step-1-0240a114421d40bf8cf5fccd5e18e429.jpg"
      ],
      "image": "assets/images/231808/step_01.webp"
    },
    {
      "text": "Mix tomato sauce, sugar, garlic salt, and salt into the ground beef; simmer until flavors blend, about 20 minutes. Remove from the heat and cover the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VSccKjYuAagescI5SDHuLh645gk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231808-GrandmasGroundbeefCasserole-mfs-Step-2-7ad0f188cd2843a2b65e5f0f1e961ac8.jpg"
      ],
      "image": "assets/images/231808/step_02.webp"
    },
    {
      "text": "While the sauce is cooking, bring a large pot of lightly salted water to a boil. Cook egg noodles in the boiling water, stirring occasionally until cooked through but firm to the bite, 7 to 9 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the egg noodles are cooking, preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sour cream, cream cheese, and onion together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0fplbqd0mS0063G8oCUX_dRqIzM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231808-GrandmasGroundbeefCasserole-mfs-Step-3-00679cff02344c30b6220067653af4d6.jpg"
      ],
      "image": "assets/images/231808/step_05.webp"
    },
    {
      "text": "Layer 1/2 of the egg noodles into the prepared casserole dish. Top with 1/2 of the sour cream mixture, then 1/2 of the ground beef mixture. Repeat layers once more. Sprinkle Cheddar cheese over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hHeXM8jvVlxZOwde1zbu9liBS1g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231808-GrandmasGroundbeefCasserole-mfs-Step-7-c18505a336ce492fa3f3264f13bedde2.jpg"
      ],
      "image": "assets/images/231808/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and golden brown, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sCQS2DuqlgZ5r5hqTwm7hB-lagk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231808_GrandmasGroundBeefCasserole_MFS-WD1-a0626af0a5d9468985d12f83d40800f2.jpg"
      ],
      "image": "assets/images/231808/step_07.webp"
    }
