  "ingredients": [
    "2 medium fennel bulbs",
    "2 tablespoons grated Parmesan cheese",
    "1 tablespoon extra-virgin olive oil",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper or nonstick aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove stems and core from fennel bulbs. Reserve a handful of fronds. Dice fennel into bite-sized pieces. Toss fennel and fronds with Parmesan cheese, oil, salt, and pepper. Spread in a single layer on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 20 minutes. Turn fennel with a spatula and roast until crisp-tender and browned on both sides, 5 to 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
