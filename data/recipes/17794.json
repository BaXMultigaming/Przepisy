  "ingredients": [
    "1 pound cubed beef stew meat",
    "1 cup chopped onion",
    "1 cup chopped celery",
    "1 cup chopped carrots",
    "0.25 cup beef bouillon granules",
    "0.25 teaspoon dried parsley",
    "1 pinch ground black pepper",
    "5.75 cups water",
    "2.5 cups frozen egg noodles"
  ],
  "steps": [
    {
      "text": "Sauté stew meat, onion, and celery in a large saucepan over medium-high heat until meat is browned on all sides, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in carrots, then season with bouillon, parsley, and pepper. Stir in water and add egg noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring to a boil, reduce heat to low, and simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
