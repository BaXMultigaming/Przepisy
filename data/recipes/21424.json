  "title": "Zesty Taco Casserole",
  "description": "Rice, bell peppers, onion, garlic, chile peppers and salsa baked into a savory casserole topped with chips and cheese.",
  "authors": [
    "Gail and David"
  ],
  "date_published": "2000-09-24T00:15:35-04:00",
