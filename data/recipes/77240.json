  "ingredients": [
    "3 (15.5 ounce) cans French cut green beans, drained",
    "2 (14 ounce) cans artichoke hearts, drained",
    "2 cups Italian seasoned bread crumbs",
    "8 ounces grated Parmesan cheese",
    "8 ounces shredded mozzarella cheese",
    "2 tablespoons garlic powder",
    "salt and pepper to taste",
    "0.5 cup olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the green beans, artichoke hearts, bread crumbs, Parmesan cheese, and mozzarella cheese into a 9x13 inch baking dish. Season with garlic powder, salt and pepper. Stir to blend everything thoroughly. Drizzle olive oil over the top, then cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes in the preheated oven, then remove the aluminum foil, and bake for another 15 minutes to brown the top slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
