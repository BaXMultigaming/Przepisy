  "ingredients": [
    "2 (8 ounce) containers plain yogurt",
    "2 cucumbers - peeled, seeded, and diced",
    "3 tablespoons olive oil, divided",
    "1 tablespoon chopped fresh dill",
    "0.5 lemon, juiced",
    "3 cloves garlic, peeled",
    "salt and ground black pepper to taste",
    "1 (1 pound) beef top sirloin steak, cut into thin strips",
    "5 pita bread rounds",
    "1 tomato, chopped",
    "0.5 small onion, thinly sliced",
    "1 (4 ounce) package crumbled feta cheese",
    "0.5 cup shredded lettuce",
    "1 (2.25 ounce) can sliced ripe olives, drained"
  ],
  "steps": [
    {
      "text": "Blend yogurt, cucumbers, 2 tablespoons olive oil, dill, lemon juice, garlic, salt, and pepper in a blender until tzatziki sauce is evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining 1 tablespoon olive oil in a large skillet over medium heat; cook and stir steak in the hot skillet until no longer pink, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer 1/2 of each pita with steak, tomato, onion, feta cheese, lettuce, olives, and tzatziki sauce. Bring the edge of each pita over the filling and secure with a toothpick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
