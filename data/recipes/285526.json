  "ingredients": [
    "2 tablespoons extra-virgin olive oil, or more to taste",
    "1.5 cups sliced fresh mushrooms",
    "1 small onion, thinly sliced",
    "1 stick butter",
    "1 tablespoon steak sauce",
    "1 teaspoon Worcestershire sauce",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium heat. Pour olive oil into the skillet. Add mushrooms and onion to hot oil; sauté until soft, 5 to 7 minutes. Add butter, steak sauce, and Worcestershire; cook until butter melts, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low and simmer, uncovered, until mushrooms are very soft, 15 to 20 minutes. Season with salt and pepper. Serve hot over any type of steak.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
