  "ingredients": [
    "2 tablespoons vegetable oil",
    "1 cup chopped onion",
    "1 cup chopped mushrooms",
    "14 ounces sauerkraut - drained, rinsed and minced",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "2 tablespoons sour cream"
