  "keywords": [],
  "ingredients": [
    "0.5 pound butternut squash, cubed",
    "0.5 cup white sugar",
    "0.5 cup all-purpose flour",
    "0.5 cup whole wheat flour",
    "0.5 cup wheat bran",
    "2 teaspoons baking powder",
    "0.75 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground cardamom",
    "0.25 teaspoon ground star anise",
    "0.25 teaspoon ground allspice",
    "0.75 cup milk",
    "1 egg",
    "1 tablespoon vegetable oil",
    "0.5 cup crushed pecans, or to taste",
    "3 tablespoons brown sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spread butternut squash over a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until soft, about 25 minutes. Remove and let cool. Leave oven on. Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, all-purpose flour, whole wheat flour, wheat bran, baking powder, cinnamon, salt, ginger, nutmeg, cardamom, star anise, and allspice in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix milk, egg, and oil in another bowl. Mash cooled squash with a fork; mix into the milk mixture. Pour over flour mixture and fold until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop 1/3 of the batter into each muffin cup. Combine pecans and brown sugar in a small bowl; sprinkle over the muffins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until a toothpick inserted into the center of a muffin comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
