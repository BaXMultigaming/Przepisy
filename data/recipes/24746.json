  "ingredients": [
    "2 eggs",
    "2 tablespoons milk",
    "2 (14.75 ounce) cans creamed corn",
    "2 tablespoons butter, diced",
    "1 tablespoon all-purpose flour",
    "1 tablespoon white sugar",
    "0.5 teaspoon black pepper",
    "0.5 teaspoon celery salt",
    "0.5 teaspoon onion powder",
    "0.25 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together eggs and milk in a large bowl until combined. Blend in corn and butter. Stir in flour, sugar, black pepper, celery salt, onion powder, and garlic powder until well combined. Transfer to a glass pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is golden and bubbly, 45 to 60 minutes. Allow to cool for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
