  "ingredients": [
    "2 cups graham cracker crumbs",
    "1.5 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 cup butter",
    "0.25 cup white sugar",
    "1.25 cups packed brown sugar",
    "2 large eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Stir together graham cracker crumbs, flour, cinnamon, baking soda, and salt in a mixing bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the butter, white sugar, and brown sugar with an electric mixer in a large bowl until smooth. Beat in the eggs one at a time, allowing each egg to blend into the butter mixture before adding the next. Mix in vanilla. Mix in the flour mixture. Scoop the dough out onto ungreased baking sheets by rounded spoonfuls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until slightly browned at the edges, 9 to 11 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
