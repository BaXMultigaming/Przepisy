  "ingredients": [
    "1 egg",
    "0.66666668653488 cup milk",
    "0.25 teaspoon salt",
    "2 tablespoons white sugar",
    "1.3333333730698 cups sifted all-purpose flour",
    "0.75 teaspoon baking powder",
    "1 quart vegetable oil for frying",
    "0.25 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Pour 1-inch-deep oil into a heavy pan; heat to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together egg and milk in a large bowl. Sift flour, salt, sugar, and baking powder into the bowl; beat into egg mixture until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter through a funnel over hot oil with a circular motion to form a spiral. Fry in hot oil until bottom is golden brown; flip and continue cooking until golden brown all over. Drain on paper towels. Continue cooking remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle cakes with confectioner’s sugar while still warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
