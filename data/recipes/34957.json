  "ingredients": [
    "1 cup lemon juice",
    "0.25 cup vegetable oil",
    "0.25 cup vinegar",
    "1 tablespoon dried oregano",
    "2 teaspoons garlic powder",
    "1 whole chicken, cut into pieces",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a large glass bowl mix lemon juice, vegetable oil, vinegar, oregano, and garlic powder. Place chicken pieces in the bowl, and season with salt and pepper. Cover, and marinate in the refrigerator at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat, and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On the prepared grill, cook chicken until no longer pink and juices run clear. Periodically brush chicken with the remaining marinade mixture while cooking. Discard any leftover marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
