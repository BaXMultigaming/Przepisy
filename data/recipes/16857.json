  "ingredients": [
    "1 (9 inch) pie crust, baked",
    "2 (8 ounce) packages cream cheese, softened",
    "0.25 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "2 cups sliced peaches, drained",
    "0.25 cup raspberry preserves",
    "1 teaspoon lemon juice"
