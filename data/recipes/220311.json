  "ingredients": [
    "6 slices bacon",
    "1 tablespoon bacon drippings",
    "0.5 sweet onion, chopped",
    "0.5 cup white sugar",
    "0.5 cup cider vinegar",
    "3 tablespoons sweet pickle relish",
    "1 (2 ounce) jar chopped pimento peppers",
    "2 (15 ounce) cans French-cut green beans, drained"
  ],
  "steps": [
    {
      "text": "Place the bacon in a large, deep skillet, and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain the bacon slices on a paper towel-lined plate, reserving about 1 tablespoon bacon drippings in the skillet. Crumble bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 275 degrees F (135 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir the onion in the reserved bacon drippings over medium-high heat until onion has softened and turned translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooked onion, sugar, cider vinegar, relish, pimento peppers, and green beans in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer mixture to a baking dish and cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned, about 1 1/2 hours. Remove foil and stir lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow green beans to rest for 15 minutes before topping with crumbled bacon and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
