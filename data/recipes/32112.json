  "ingredients": [
    "1 tablespoon butter",
    "2 tablespoons finely chopped onion",
    "1 slice fully cooked luncheon meat (e.g. Spam)",
    "1 egg, beaten",
    "2 slices bread",
    "1 slice American cheese",
    "1 slice tomato"
  ],
  "steps": [
    {
      "text": "Melt butter in a small skillet over medium-high heat. Saute the onion in butter until soft. Mash up the slice of luncheon meat with a fork, and add it to the skillet. Cook for 2 or 3 minutes, until browned. Pour the egg into the skillet so that it covers all of the meat and onion. Cook until firm, then flip to brown the other side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the egg and meat onto one slice of the bread and top with cheese and tomato if desired. Place the other piece of bread on top. Bread can also be toasted first.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
