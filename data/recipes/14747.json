  "ingredients": [
    "4 pork chops",
    "salt and pepper to taste",
    "0.25 cup all-purpose flour",
    "2 tablespoons vegetable oil",
    "1 cup sour cream",
    "0.25 cup dry sherry",
    "0.25 cup ketchup",
    "1 teaspoon Worcestershire sauce",
    "0.25 teaspoon paprika",
    "1 bay leaf"
  ],
  "steps": [
    {
      "text": "Season pork chops with salt and pepper to taste. Dredge seasoned chops in flour. Heat oil in a large skillet and brown seasoned chops in oil (covering skillet with lid if desired). Pour off fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sour cream, sherry, ketchup, Worcestershire sauce, paprika and bay leaf in a medium bowl until combined; pour mixture over chops in skillet. Cover and let simmer gently over low heat for about 1 hour, or until chops are tender and cooked through. An instant-read thermometer inserted into the center of a chop should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
