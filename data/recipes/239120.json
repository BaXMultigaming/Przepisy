  "ingredients": [
    "0.875 cup butter, softened, or as needed",
    "0.25 cup confectioners' sugar",
    "2 cups all-purpose flour",
    "0.25 teaspoon salt",
    "2 eggs",
    "1 cup brown sugar",
    "3 tablespoons butter, melted",
    "1 tablespoon vanilla extract",
    "0.5 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 7/8 cup butter and confectioners' sugar together with a spoon in a large bowl until smooth. Stir in flour and salt. Press mixture into a 9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden, about 14 minutes. Remove to cool 10 for minutes, leaving oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, brown sugar, 3 tablespoons melted butter, and vanilla extract together in a bowl. Sprinkle raisins over cooled crust; pour egg mixture over raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top springs back when touched, about 30 minutes. Cool completely before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
