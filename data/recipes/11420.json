  "ingredients": [
    "0.66670000553131 cup shortening",
    "0.75 cup white sugar",
    "1 egg",
    "0.5 cup orange juice",
    "1 teaspoon orange zest",
    "2 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups confectioners' sugar",
    "2 tablespoons butter",
    "2 tablespoons orange juice",
    "1 teaspoon orange zest"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, baking powder, baking soda and salt. Stir 1/2 cup orange juice and 1 teaspoon rind into the flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream shortening and white sugar together. Mix egg into the sugar mixture thoroughly. Slowly blend flour mixture into the egg and sugar mixture. Drop by teaspoonful onto greased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the icing: Mix confectioner's sugar and 2 tablespoons butter together until smooth. Pour 2 tablespoons orange juice and 1 teaspoon orange rind into the sugar and butter mixture, mix well. When the cookies have cooled spread the icing generously over the tops of the cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
