  "ingredients": [
    "2 teaspoons vegetable oil",
    "0.25 cup all-purpose flour",
    "1 teaspoon paprika",
    "1 teaspoon mustard powder",
    "1 pinch salt",
    "0.5 teaspoon ground black pepper",
    "4 large sweet potatoes, cut into wedges"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Drizzle a medium baking sheet with vegetable oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large, resealable plastic bag, mix flour, paprika, mustard powder, salt, and pepper. Place sweet potato wedges in the bag, and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange coated sweet potato wedges on the prepared baking sheet. Bake 20 to 30 minutes in the preheated oven, until browned and crisp.",
