  "ingredients": [
    "1 cup milk",
    "0.66666668653488 cup dry bread crumbs",
    "1.5 pounds ground beef",
    "0.25 cup diced onion",
    "1 egg, beaten",
    "1 teaspoon salt",
    "ground black pepper to taste",
    "0.25 cup ketchup",
    "3 tablespoons brown sugar",
    "1 teaspoon ground mustard",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk over bread crumbs in a large bowl; soak until crumbs are softened, at least 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, bread crumb mixture, onion, egg, salt, and black pepper; shape into a loaf and transfer to a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir ketchup, brown sugar, mustard, and nutmeg together in a bowl until smooth; spread over meatloaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
