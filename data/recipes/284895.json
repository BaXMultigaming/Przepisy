  "title": "Soft Lemon Cookies with Glaze",
  "description": "These super easy, soft-baked lemon cookies with glaze are the perfect dessert for summer parties or bake sales.",
  "authors": [
    "rissanddave"
  ],
  "date_published": "2011-09-24T23:38:16-04:00",
