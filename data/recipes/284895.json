  "ingredients": [
    "2.5 cups all-purpose flour",
    "1.5 cups white sugar",
    "2 teaspoons baking soda",
    "0.25 teaspoon salt",
    "0.75 cup vegetable oil",
    "0.5 cup lemon juice",
    "2 teaspoons vanilla extract",
    "1 cup powdered sugar",
    "0.33333334326744 cup lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, baking soda, and salt together in a medium bowl. Use a spoon to make a well in the center of the mixture. Pour oil, lemon juice, and vanilla extract in the well. Mix and knead until a dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll into balls and flatten with the heel of your hand or anything with a flat surface. Place about 2 inches apart on ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 8 minutes for a softer cookie, 10 to 12 minutes for a crispier cookie. Cool on the baking sheet for 1 minute before removing to a wire rack to cool, 8 to 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While cookies cool, whisk together the powdered sugar and lemon juice and glaze cookies however you like.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
