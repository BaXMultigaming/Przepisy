  "ingredients": [
    "1 (8 ounce) can pineapple, drained and juice reserved",
    "1 cup white sugar",
    "0.5 cup ketchup",
    "0.25 cup white vinegar or apple cider vinegar",
    "0.5 cup water",
    "2 tablespoons cornstarch",
    "2 medium carrots, chopped"
  ],
  "steps": [
    {
      "text": "Stir reserved pineapple juice, sugar, ketchup, and vinegar in a saucepan over medium heat until blended, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk water and cornstarch in a bowl until cornstarch is dissolved; stir into pineapple juice mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pineapple and carrots into the sauce; bring to a boil, reduce heat to medium-low, and cook at a simmer until the sauce thickens, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
