  "ingredients": [
    "4 cups water",
    "2 potatoes, cubed",
    "1 onion, chopped",
    "1 bunch fresh parsley, chopped",
    "4 ounces cod fillets, cubed",
    "1 lemon, juiced",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Put water in a large saucepan and bring to a boil over high heat. Add the potatoes, onion and parsley. Heat for 10 to 15 minutes and add the fish. Heat for 10 more minutes, then squeeze in lemon juice and season with salt and pepper to taste.",
