  "ingredients": [
    "3 (6 ounce) packages white chocolate baking squares",
    "1 (14 ounce) can EAGLE BRAND® Sweetened Condensed Milk",
    "0.125 teaspoon salt",
    "3 cups coarsely crushed chocolate creme-filled sandwich cookies"
  ],
  "steps": [
    {
      "text": "In a heavy saucepan over low heat, melt white chocolate squares, sweetened condensed milk, and salt. Remove from heat; stir in crushed cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread evenly into a wax paper-lined 8-inch square pan. Chill in the refrigerator until firm, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn chilled fudge onto a cutting board; peel off wax paper. Cut fudge into squares. Store leftovers covered in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
