  "ingredients": [
    "9 pounds pork shoulder, cut into cubes",
    "0.25 cup fennel seed",
    "3 tablespoons garlic powder",
    "2 tablespoons crushed red pepper flakes",
    "2 tablespoons dried parsley",
    "4 teaspoons salt",
    "2 teaspoons ground black pepper",
    "0.5 cup dry white wine",
    "15 feet 1 1/2 inch diameter hog casings, rinsed"
  ],
  "steps": [
    {
      "text": "Combine pork, fennel seed, garlic powder, red pepper flakes, parsley, salt, and pepper in a meat grinder; grind through a coarse plate. Mix in white wine and grind again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stuff mixture into rinsed hog casings, twisting into 4-inch lengths. Cover and refrigerate until flavors meld, 8 hours to overnight. Cook as desired, or portion sausages into 1-quart freezer bags and store in the freezer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
