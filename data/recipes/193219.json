  "ingredients": [
    "1 (3 1/2) pound boneless pork shoulder, trimmed and cut into 2 inch chunks",
    "2 oranges, quartered",
    "1 large white onion, quartered",
    "6 cloves garlic, peeled and crushed",
    "0.25 cup kosher salt",
    "1 tablespoon ground cumin",
    "1 tablespoon whole black peppercorns",
    "2 bay leaves"
  ],
  "steps": [
    {
      "text": "Place pork shoulder, oranges, onion, garlic, kosher salt, cumin, black peppercorns, and bay leaves into a large Dutch oven. Add water to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring to a boil over high heat, reduce heat to medium-low, and simmer for 10 minutes. Skim off any foam that rises to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover loosely and simmer until meat is tender, about 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow pork to cool, covered, in broth for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred meat with two forks.",
      "section": null,
