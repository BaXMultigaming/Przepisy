  "ingredients": [
    "0.5 cup distilled white vinegar",
    "2 tablespoons vegetable oil",
    "1 tablespoon white sugar",
    "1 (16 ounce) package frozen corn, thawed",
    "1 cucumber, peeled, seeded, and diced",
    "0.75 cup chopped fresh mint",
    "0.25 cup diced sun-dried tomatoes"
  ],
  "steps": [
    {
      "text": "Whisk vinegar, oil, and sugar together in a large bowl until sugar has dissolved. Add corn, cucumber, mint, and sun-dried tomatoes; stir until evenly coated. Cover the bowl; refrigerate before serving, 1 hour.",
