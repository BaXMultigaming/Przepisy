  "ingredients": [
    "0.75 cup all-purpose flour",
    "0.75 cup whole wheat flour",
    "0.75 cup white sugar",
    "0.25 cup oat bran",
    "0.25 cup quick cooking oats",
    "0.25 cup wheat germ",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup blueberries",
    "0.5 cup chopped walnuts",
    "1 cup buttermilk",
    "1 medium banana, mashed",
    "1 large egg",
    "1 tablespoon vegetable oil",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin pan with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir both flours, sugar, oat bran, oats, wheat germ, baking powder, baking soda, and salt together in a large bowl. Gently stir in blueberries and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix buttermilk, mashed banana, egg, oil, and vanilla together in a separate bowl. Pour wet ingredients into dry ingredients; mix until just blended. Spoon batter into the prepared muffin cups, filling all the way to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
