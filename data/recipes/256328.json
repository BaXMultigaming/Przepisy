  "ingredients": [
    "cooking spray",
    "3.25 pounds pork ribs",
    "1 pinch salt and ground black pepper to taste",
    "1 cup hoisin sauce",
    "1 cup white sugar",
    "0.5 cup soy sauce",
    "0.33333334326744 cup white wine",
    "2 tablespoons tomato paste",
    "4 cloves garlic, crushed",
    "2 teaspoons Asian chili-garlic sauce",
    "0.5 teaspoon Chinese five-spice powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a slow cooker insert with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pork ribs evenly on a baking sheet; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk together hoisin sauce, sugar, soy sauce, white wine, tomato paste, garlic, chili-garlic sauce, and five-spice powder in a medium bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pork ribs to the prepared slow cooker insert. Cover evenly with hoisin sauce mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low, stirring halfway through, until pork ribs are tender, about 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
