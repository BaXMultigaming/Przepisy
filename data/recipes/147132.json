  "ingredients": [
    "5 apples - peeled, cored, and shredded",
    "1 tablespoon ground cinnamon",
    "1 tablespoon white sugar",
    "2 eggs",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "0.5 cup olive oil",
    "0.33333334326744 cup orange juice",
    "1.5 cups white spelt flour",
    "1.5 teaspoons xanthan gum",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a 9 inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss together the shredded apple, 1 tablespoon cinnamon, and 1 tablespoon sugar in a bowl until evenly coated. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together the eggs, 1/2 cup sugar, and vanilla in a large bowl until the mixture is fluffy. Stir in the olive oil, orange juice, flour, xanthan gum, baking powder, salt, and 2 teaspoons cinnamon to make a batter. Fold the apple mixture into the batter. Pour mixture into the prepared bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until toothpick inserted into center of cake comes out clean, about 60 minutes. Cool in the pan for about 15 minutes before turning out of the pan onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
