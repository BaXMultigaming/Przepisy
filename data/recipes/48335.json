  "ingredients": [
    "0.25 cup mayonnaise",
    "0.25 cup prepared brown mustard",
    "0.5 cup dry bread crumbs",
    "0.25 cup shredded coconut",
    "0.25 cup chopped mixed nuts",
    "1 teaspoon granulated sugar",
    "1 teaspoon salt",
    "0.5 teaspoon cayenne pepper",
    "1 pound whitefish fillets"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease a medium baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, blend mayonnaise and brown mustard. In a medium bowl, mix dry bread crumbs, shredded coconut, chopped mixed nuts, sugar, salt, and cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip fish in the mayonnaise mixture, then in the bread crumb mixture. Arrange coated fish fillets in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 20 minutes in the preheated oven, until fish is easily flaked with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
