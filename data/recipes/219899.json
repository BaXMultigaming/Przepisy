  "ingredients": [
    "1 (15 ounce) jar chunky-style blue cheese salad dressing (such as Marzetti®)",
    "1 (8 ounce) package cream cheese, softened",
    "3 cooked chicken breasts, shredded",
    "1 (12 ounce) bottle Buffalo wing sauce (such as Frank's RedHot®)",
    "1 (4 ounce) package blue cheese crumbles"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together blue cheese salad dressing and cream cheese in a mixing bowl until smooth. Stir in chicken, Buffalo wing sauce, and blue cheese crumbles; pour chicken mixture into a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling, 15 to 20 minutes.",
