    "publisher-tested"
  ],
  "ingredients": [
    "2 tablespoons canola oil",
    "0.5 onion, diced",
    "2 teaspoons salt, divided",
    "2 pounds beef stew meat, cut into 1-inch cubes",
    "1 teaspoon freshly ground black pepper",
    "3 cloves garlic, minced",
    "0.5 teaspoon dried thyme",
    "2 tablespoons soy sauce",
    "3 cups chopped mushrooms",
    "2 tablespoons all-purpose flour",
    "3 cups chicken broth",
    "1 (16 ounce) package wide egg noodles",
    "0.75 cup sour cream, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CDjz29ep3ouV63b_jGyj0h1LWt4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-258468-Beef-Stroganoff-for-instant-pot-ddmfs-Step-1-8d41d7fab1d143ea94cf73bc3e0864a4.jpg"
      ],
      "image": "assets/images/258468/step_01.webp"
    },
    {
      "text": "Turn on a multi-functional pressure cooker (such as an Instant Pot) and select Sauté function. Heat oil for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ecnuNusgYH29OaBzPIfv8L-6-hg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-258468-Beef-Stroganoff-for-instant-pot-ddmfs-Step-2-9b8de287b8ce460a8e0fc924b63c7156.jpg"
      ],
      "image": "assets/images/258468/step_02.webp"
    },
    {
      "text": "Add onion and 1/2 teaspoon salt to pot; cook and stir until onion begins to soften, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NbHwBVxrxXGZl4geYK-7D1uUNsk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-258468-Beef-Stroganoff-for-instant-pot-ddmfs-Step-3-47d76c3167554faaa4f9690e095d05b1.jpg"
      ],
      "image": "assets/images/258468/step_03.webp"
    },
    {
      "text": "Sprinkle beef with 1 teaspoon salt and the pepper. Add to the pot. Cook and stir until beef is evenly browned, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X1VcNlojryQ8TogwEjtmZyNhClc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-258468-Beef-Stroganoff-for-instant-pot-ddmfs-Step-4-999ed42f6e0f4aa087b1f87a0cf77634.jpg"
      ],
      "image": "assets/images/258468/step_04.webp"
    },
    {
      "text": "Add garlic and thyme; cook until fragrant, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kbUPvbPFXdXXQw-QlT-Pul3Q_5U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-258468-Beef-Stroganoff-for-instant-pot-ddmfs-Step-5-1f8e4569ca91403cbc842968bfd8509a.jpg"
      ],
      "image": "assets/images/258468/step_05.webp"
    },
    {
      "text": "Pour in soy sauce. Stir mushrooms into the pot. Stir in flour until incorporated. Stir in chicken broth and remaining 1/2 teaspoon salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Qwd0m-PiRwMw5d7a53nCBRBtdr0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-258468-Beef-Stroganoff-for-instant-pot-ddmfs-Step-6-b5a820ee4e0d46e494559d3eecdc5ada.jpg"
      ],
      "image": "assets/images/258468/step_06.webp"
    },
    {
      "text": "Close and lock the lid. Set to high pressure according to manufacturer's instructions for 10 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lglNHGOB0ZCPuKGvOudrGYbgWy0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-258468-Beef-Stroganoff-for-instant-pot-ddmfs-Step-7-6ddd4eea633b4f5eb2d5bdd413961e0f.jpg"
      ],
      "image": "assets/images/258468/step_07.webp"
    },
    {
      "text": "Release pressure carefully using the quick-release method.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9u1kzZcCS-_I0JoaoqZWwhDA0_E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-258468-Beef-Stroganoff-for-Instant-pot-ddmfs-step-8-f21df431a13449a5b4baf965d8a4b90c.jpg"
      ],
      "image": "assets/images/258468/step_08.webp"
    },
    {
      "text": "Open pot; stir in egg noodles. Close and lock the lid. Set to high pressure according to manufacturer's instructions for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rAN9x7wDlWL-s_iHrIHEIUwXBa0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-258468-Beef-Stroganoff-for-Instant-pot-ddmfs-step-9-057954c7e2184ac9b5376f612fe76f4f.jpg"
      ],
      "image": "assets/images/258468/step_09.webp"
    },
    {
      "text": "Release pressure naturally for 5 minutes according to manufacturer's instruction. Release remaining pressure using the quick-release method. Open pressure cooker; stir in sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yeXpCrJtaieGJzuwAsiQ-I3aeY8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-258468-Beef-Stronanoff-for-Instant-Pot-ddmfs-step-10-ec13723094294749a2655bd2d3236911.jpg"
      ],
      "image": "assets/images/258468/step_10.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hPxY6kthXSZonfJjG12qT9tByz8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-258468-Beef-Stroganoff-for-Instant-Pot-ddmfs-4x3-c4a5e12cb9c54afeb4a5a3c0cb6f4634.jpg"
      ],
      "image": "assets/images/258468/step_11.webp"
    }
