  "ingredients": [
    "cooking spray",
    "16 (1 inch thick) slices French bread, cut diagonally",
    "1.25 cups light coconut milk",
    "1.25 cups egg substitute",
    "0.5 cup white sugar",
    "1 tablespoon vanilla extract",
    "0.5 cup sweetened flaked coconut"
  ],
  "steps": [
    {
      "text": "Spray the inside of a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bread slices in a single layer in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk coconut milk, egg substitute, sugar, and vanilla extract together in a bowl until evenly combined; pour over bread. Turn bread over to coat. Cover baking dish with plastic wrap and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Remove plastic wrap from baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn bread slices over and sprinkle coconut over bread; let stand for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until egg is set and coconut is golden, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
