  "ingredients": [
    "cooking spray",
    "1 cup sour cream",
    "1 cup white sugar",
    "0.33333334326744 cup canola oil",
    "2 eggs, beaten",
    "3 tablespoons limoncello liqueur",
    "1 lemon, zested",
    "2 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "1 pinch salt",
    "0.5 cup confectioners' sugar",
    "2 tablespoons limoncello liqueur"
