  "ingredients": [
    "1 (28 ounce) can crushed tomatoes",
    "1 (15 ounce) can tomato sauce",
    "1 (14.5 ounce) can diced tomatoes",
    "1.5 tablespoons capers",
    "1 tablespoon minced garlic",
    "2 teaspoons white sugar",
    "2 teaspoons dried parsley",
    "1 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon ground black pepper",
    "1 pinch crushed red pepper flakes",
    "1 pound spaghetti"
  ],
  "steps": [
    {
      "text": "Combine crushed tomatoes, tomato sauce, diced tomatoes, capers, minced garlic, sugar, parsley, garlic powder, salt, oregano, basil, black pepper, and crushed red pepper in a large saucepan. Cover and bring to a boil. Reduce heat and simmer, covered, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of salted water to a boil while sauce simmers. Cook spaghetti until tender yet firm to the bite. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss spaghetti with sauce.",
      "section": null,
