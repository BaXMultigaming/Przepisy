  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 large clove garlic, crushed",
    "0.5 teaspoon grated fresh ginger",
    "1 (12 ounce) package Green Giant® Riced Cauliflower Medley",
    "2 tablespoons soy sauce",
    "1 egg, lightly beaten and scrambled"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a large nonstick skillet and cook garlic and ginger over medium heat 1 minute.",
