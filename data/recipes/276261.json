  "ingredients": [
    "5 cups apple - peeled, cored and sliced",
    "lemon, juiced",
    "2 tablespoons light brown sugar",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "6 ounces plain sesame halva, crumbled",
    "0.5 cup rolled oats",
    "0.33333334326744 cup all-purpose flour",
    "1 pinch salt",
    "aluminum foil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease an 8-inch or 9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together apples, lemon juice, brown sugar, cinnamon, and nutmeg in a bowl. Evenly spread fruit in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix halva, oats, flour, and salt to a crumbly consistency. Sprinkle over the fruit and cover with aluminum foil to prevent top from browning too quickly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and well browned, about 45 minutes. Let cool to allow the topping to harden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
