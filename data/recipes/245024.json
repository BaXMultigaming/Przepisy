  "ingredients": [
    "2 cups chicken broth",
    "1 (15 ounce) can pumpkin puree",
    "0.25 cup milk",
    "2 tablespoons brown sugar",
    "2 tablespoons white sugar",
    "2 tablespoons butter",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground cinnamon",
    "0.125 teaspoon ground cloves",
    "0.125 teaspoon nutmeg",
    "1 (30 ounce) package cheese ravioli",
    "0.33333334326744 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Combine chicken broth, pumpkin purée, milk, white sugar, brown sugar, butter, ginger, cinnamon, cloves, and nutmeg in a large saucepan; bring to a boil. Reduce heat to medium; simmer, stirring occasionally, until butter melts and sauce is heated through, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, fill a large pot with lightly salted water and bring to a boil; stir in ravioli and return to a boil. Cook uncovered, stirring occasionally, until ravioli float to the top and the filling is hot, 6 to 8 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pasta to a serving bowl; top with pumpkin sauce and Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
