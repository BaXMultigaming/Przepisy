  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter",
    "0.75 cup all-purpose flour",
    "4 cups sliced apples",
    "1 teaspoon ground cinnamon",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and butter together in a bowl with an electric mixer. Blend in flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place apples into the prepared baking dish and sprinkle with cinnamon. Pour in water, then sprinkle sugar-butter mixture evenly over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apples are tender and the crust is golden, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
