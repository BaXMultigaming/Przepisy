  "ingredients": [
    "1 teaspoon matcha powder",
    "1 medium lemon, juiced",
    "1 tablespoon honey, or more to taste",
    "1 cup cold water"
  ],
  "steps": [
    {
      "text": "Combine matcha and lemon juice in a pint-sized Mason jar, and whisk until fully blended. Add honey, whisking well, and stir in the cold water.",
      "section": null,
