  "ingredients": [
    "2 cloves garlic, peeled",
    "1 (1/2 inch) piece fresh ginger",
    "2 tablespoons vegetable oil, divided, or as needed",
    "1 onion, chopped",
    "1 teaspoon ground cumin",
    "1 teaspoon ground coriander",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon ground turmeric",
    "2 potatoes, peeled and chopped",
    "2 roma (plum) tomatoes, chopped",
    "2 bunches fresh spinach, chopped",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Grind garlic and ginger together to make a paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 tablespoon oil in a pot over medium-high heat. Saute onion in the hot oil until translucent, 5 to 7 minutes. Add cumin, coriander, cayenne, and turmeric. Add ginger-garlic paste. Mix well. Stir in remaining oil, potatoes, and tomatoes; cook until oil leaves the side of the pan, about 5 minutes. Add spinach and salt; continue to cook over medium heat until potatoes are tender, about 20 minutes. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
