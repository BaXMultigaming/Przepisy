  "ingredients": [
    "1 cup all-purpose flour",
    "0.25 cup white sugar",
    "0.5 teaspoon salt",
    "1 cup milk",
    "3 eggs",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, and salt together in a bowl; add milk and eggs in that order. Stir until just a few lumps remain in the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a 9- or 10-inch oven-proof skillet over medium heat. Pour batter into skillet and wait for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place skillet in the preheated oven and bake until puffed and mostly set, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
