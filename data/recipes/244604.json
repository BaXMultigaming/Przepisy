  "ingredients": [
    "2 tablespoons oil",
    "2 cups 1-inch pieces pork",
    "1.5 cups chopped onion",
    "0.25 pound mushrooms, sliced",
    "2 cups chicken broth",
    "2 cups sliced celery",
    "0.25 teaspoon salt",
    "0.25 teaspoon black pepper",
    "2 cups fresh bean sprouts",
    "0.5 cup sliced almonds",
    "3 tablespoons reduced-sodium soy sauce",
    "2 tablespoons cornstarch"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Add pork; cook and stir until lightly browned, 5 to 7 minutes. Add onion and mushrooms; cook until slightly tender, 2 to 3 minutes. Add chicken broth, celery, salt, and black pepper; bring to a boil. Cover the skillet, reduce heat to medium-low, and simmer until pork is tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir bean sprouts and almonds into pork mixture until incorporated. Whisk soy sauce and cornstarch together in a small bowl until smooth; stir into pork mixture until thickened, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
