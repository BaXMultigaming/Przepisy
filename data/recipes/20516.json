  "ingredients": [
    "8 cups fresh broccoli",
    "0.5 cup butter",
    "2 tablespoons all-purpose flour",
    "1 small onion, chopped",
    "1.25 cups milk",
    "salt and pepper to taste",
    "4 cups shredded Swiss cheese",
    "2 large eggs, beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place broccoli in a steamer over 1 inch boiling water. Cover and cook until crisp-tender, 2 to 6 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a medium saucepan over medium heat. Add flour and stir, cooking until bubbly. Stir in onion, then milk. Bring to a boil and cook for 1 minute. Remove from heat and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cheese and eggs and stir until cheese melts. Add broccoli and stir to coat. Transfer mixture to a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
