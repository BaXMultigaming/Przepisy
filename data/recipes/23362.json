  "title": "Kapusta",
  "description": "Kapusta is a Polish cabbage dish baked with onions, mushrooms, and sauerkraut. This grandmother&#39;s recipe can be served as a side or a vegetarian main dish.",
  "authors": [
    "Holly"
  ],
  "date_published": "2000-10-31T03:37:33-05:00",
