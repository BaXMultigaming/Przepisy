  "ingredients": [
    "2 (6 ounce) fillets salmon",
    "salt and ground black pepper to taste",
    "1 lemon, juiced, divided",
    "7 pitted green olives, sliced",
    "3 tablespoons olive oil, or more to taste",
    "1 tablespoon capers",
    "1 teaspoon chopped fresh dill, or to taste"
  ],
  "steps": [
    {
      "text": "Bring 1 to 2 inches of water to a boil in a large saucepan. Season salmon with salt and pepper and sprinkle with 1/2 of the lemon juice; place in a steamer basket. Insert the steamer basket into the saucepan, cover, and steam until salmon is easily flaked with a fork, 7 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While salmon cooks, whisk olives, olive oil, capers, and remaining lemon juice together in a bowl. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon on serving plates, spoon dressing over top, and sprinkle with dill.",
