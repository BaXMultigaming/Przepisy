  "ingredients": [
    "1 egg",
    "1 (5 ounce) can tuna, drained and flaked",
    "3 tablespoons mayonnaise",
    "2 stalks celery, chopped",
    "2 tablespoons sweet pickle relish",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Place egg in a saucepan and cover with cold water. Bring water to a boil and immediately remove the pan from heat. Cover and let egg stand in hot water for 10 to 12 minutes. Remove egg from hot water; cool for 5 minutes. Peel and chop into bite-sized pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together tuna and mayonnaise in a medium bowl. Mix in chopped egg, celery, relish, and black pepper.",
