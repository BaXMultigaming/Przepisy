  "ingredients": [
    "0.75 cup brown sugar",
    "0.75 cup white sugar",
    "0.5 cup margarine",
    "0.5 cup shortening",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "0.66666668653488 cup cocoa powder",
    "0.75 teaspoon baking soda",
    "0.25 teaspoon salt",
    "2 cups semisweet chocolate chips",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, white sugar, margarine, shortening, eggs, and vanilla extract together in a large bowl with an electric mixer until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cocoa powder, baking soda, and salt together in a separate bowl; beat into sugar mixture until you have a dough. Stir chocolate chips and walnuts into dough. Drop rounded teaspoonfuls of dough 2 inches apart onto baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and set, 8 to 10 minutes. Cool briefly on the baking sheets before transferring to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
