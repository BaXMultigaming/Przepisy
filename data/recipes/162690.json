  "ingredients": [
    "1 pound beef short ribs",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 tablespoons all-purpose flour",
    "1 tablespoon olive oil",
    "1 tablespoon butter",
    "1 onion, sliced",
    "1 clove garlic",
    "1 (12 fluid ounce) can or bottle stout beer",
    "1 cup beef stock"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zWzDtYU9QDhcfwEpLBww8osWIdM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/162690-simple-beef-short-ribs-Step-01-1-9bdcd8a5adfc4b0da63668240cb74654.jpg"
      ],
      "image": "assets/images/162690/step_01.webp"
    },
    {
      "text": "Season ribs with salt and pepper. Dredge in flour until coated; shake off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nVVHLgZSe0V_u5H1qfGGV4Kefg8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/162690-simple-beef-short-ribs-Step-03-1-8d9f5f1042844a67bbaca5cfe8e4e428.jpg"
      ],
      "image": "assets/images/162690/step_02.webp"
    },
    {
      "text": "Heat olive oil and butter in a Dutch oven or large skillet over medium-high heat. Cook ribs until browned, about 5 minutes per side. Remove ribs and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UPcim_2dgwWb3epTmQ74geHPwdM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/162690-simple-beef-short-ribs-Step-04-1-8a3f32b60432426d9112a62a1c4d5c6f.jpg"
      ],
      "image": "assets/images/162690/step_03.webp"
    },
    {
      "text": "Add onion and garlic to the pot; cook and stir until onion is tender, about 5 minutes. Return ribs to the pot; pour in beer while scraping the browned bits of food off the bottom of the pot. Pour in beef stock.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/leCZmaouXkqMdiRdTPKW67nQidQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/162690-simple-beef-short-ribs-Step-07-1-df0431ec1eb544bdb1b5e65e59b01270.jpg"
      ],
      "image": "assets/images/162690/step_04.webp"
    },
    {
      "text": "Cover and simmer over low heat until ribs are very tender, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HH-hnz9yMiqWkMznWHvBEJLQf1I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/162690-simple-beef-short-ribs-Step-08-1-6e6c5063de244a6c843bb1afab7c6854.jpg"
      ],
      "image": "assets/images/162690/step_05.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0hFVobimonXW2mznUbh5VtU8fLI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/162690-simple-beef-short-ribs-Beauty-3x4-ef1834d544e64d87a291f5ace337ffcd.jpg"
