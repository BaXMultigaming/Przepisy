  "ingredients": [
    "2 large eggs",
    "1 tablespoon water",
    "salt and ground black pepper to taste",
    "1 ounce rosemary-flavored bread, cubed",
    "1 tablespoon olive oil",
    "0.25 cup chopped onion",
    "0.5 cup chopped fresh spinach",
    "2 ounces chopped cooked ham"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly beat eggs and water together in a bowl until well blended. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread cubes in the egg mixture and press lightly to submerge; let soak for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a small, oven-safe, nonstick skillet (no larger than 10 inches) over medium heat. Cook onions in the hot oil until they begin to turn translucent, 3 to 5 minutes. Stir in spinach and ham. Pour egg-bread mixture into the skillet. Stir gently and remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the skillet to the preheated oven and bake for 5 minutes. Use an egg turner to flip the skillet contents. Bake until eggs are set, about 10 minutes longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
