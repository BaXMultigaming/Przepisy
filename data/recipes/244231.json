  "ingredients": [
    "8 hot dogs",
    "1 (8 ounce) package refrigerated crescent rolls (such as Pillsbury® Grands! Big and Flaky)",
    "1 teaspoon yellow mustard, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3RxZc2bahIfQGbiCh-_d2PGSQ_o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244231-hot-dog-mummies-VAT-step-01-969eb71e9c0643dc9e2a2e9f1a2ad980.jpg"
      ],
      "image": "assets/images/244231/step_01.webp"
    },
    {
      "text": "Place hot dogs in a saucepan and cover with water; bring to a boil. Reduce heat to medium-low and simmer until warmed through, about 5 minutes. Drain and pat dry with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Hd1hNLWnWecDHOGFJ9IfXQfEt4M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244231-hot-dog-mummies-VAT-step-02-7e03c87520b5422db059e873e07f554a.jpg"
      ],
      "image": "assets/images/244231/step_02.webp"
    },
    {
      "text": "Unroll crescent dough and separate into 8 strips. Wrap 1 strip of dough around each hot dog, leaving small gaps for the eyes, to create the look of a mummy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y4h0EA8tVNMhNkYVEZjeSEnnVlw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244231-hot-dog-mummies-VAT-step-03-1231a24add7a4f3680d302cd97d4ce6f.jpg"
      ],
      "image": "assets/images/244231/step_03.webp"
    },
    {
      "text": "Place dots of mustard on the top of each for the eyes, nose, and mouth. Arrange hot dogs on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NKJ_Vc1Jbqx-FMfejy3BtW8Eg9A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244231-hot-dog-mummies-VAT-step-04-ca7866fb9ab144a18547c2ec322012f0.jpg"
      ],
      "image": "assets/images/244231/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until crescent dough is golden brown and flaky, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WZR-0LljrXCyX96GPOjMPPpDOJ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244231-hot-dog-mummies-VAT-step-05-45139621d1a44789a17704bc99a8903a.jpg"
      ],
      "image": "assets/images/244231/step_05.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SPHbThfwEQoYHBx-168daiWMMDg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244231-hot-dog-mummies-VAT-Beauty-4x3-424b4afbe99f4b679b49b5da85345935.jpg"
