    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 cups Italian seasoned bread crumbs",
    "0.5 cup olive oil",
    "2 pounds pork tenderloin"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yu9oHvYOItaqyQ0VF-3XqtLB36o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22224-easy-and-elegant-pork-tenderloin-VAT-step-01-30c2393c4f294815b8a039f7a4d3c2e6.jpg"
      ],
      "image": "assets/images/22224/step_01.webp"
    },
    {
      "text": "Mix bread crumbs and olive oil in bowl to reach consistency that would be moist enough to stick to the meat when pressed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qwBCJxl3-L9wmWUbg5sQ1HkPlBw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22224-easy-and-elegant-pork-tenderloin-VAT-step-02-84ce2715933a4b2f877813ce4646c4ed.jpg"
      ],
      "image": "assets/images/22224/step_02.webp"
    },
    {
      "text": "Place pork on a shallow cooking sheet. Press the crumb mixture onto all sides of the meat until there is no pink showing, usually 1/4 inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OjQlBtxlbKXWXzAeI-1K7U7Kx2M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22224-easy-and-elegant-pork-tenderloin-VAT-step-03-6fcdf240dd684ce29a9b9dd3af105e0b.jpg"
      ],
      "image": "assets/images/22224/step_03.webp"
    },
    {
      "text": "Bake for at least 35 minutes until a meat thermometer reads 165 degrees F (75 degrees C) or until there is no pink when the pork is cut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1_W3uomCqq9W_-c601Gm50kcyQQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22224-easy-and-elegant-pork-tenderloin-VAT-step-04-dd041d0ba0f34e87be42b0f9c50d9f14.jpg"
      ],
      "image": "assets/images/22224/step_04.webp"
    },
    {
      "text": "Let the pork rest for 10 minutes, then cut into 1/2 inch slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tHmUlUNQpc3H1XMj2JCgQOoDFzc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22224-easy-and-elegant-pork-tenderloin-VAT-step-05-0d7dd8abc20340e7b5010a620a753d58.jpg"
      ],
      "image": "assets/images/22224/step_05.webp"
    },
    {
      "text": "Serve with your favorite sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3P0Zb9Vbpql_G2FM5qq8aytbPGY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22224-easy-and-elegant-pork-tenderloin-hero-03-VAT-4x3-adb4a680129440df85397158bdec9780.jpg"
      ],
