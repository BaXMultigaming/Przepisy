  "title": "Bay Scallop Chowder",
  "description": "In this seafood chowder, scallops and mushrooms are sauteed in white wine and butter before adding them to a creamy chicken broth and vegetable soup base seasoned with parsley and thyme.",
  "authors": [
    "Kathy J Bourdess"
  ],
  "date_published": "2000-02-05T22:03:29-05:00",
