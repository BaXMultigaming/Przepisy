  "ingredients": [
    "2 tablespoons softened butter",
    "1 (16.9 ounce) package frozen pierogies",
    "0.5 (16 ounce) can sauerkraut, drained",
    "0.25 pound deli sliced corned beef, chopped",
    "8 (1 ounce) slices Swiss cheese",
    "1 cup thousand island salad dressing",
    "0.5 cup rye bread crumbs"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with softened butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ibmfp6KMSVgVRk5WLKH2EbO0Bpw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216693-Reuben-Pierogie-Casserole-DDMFS-step-01-8b25eb9248064b08b54ad883034168a2.jpg"
      ],
      "image": "assets/images/216693/step_01.webp"
    },
    {
      "text": "Arrange frozen pierogies into the prepared baking dish. Sprinkle sauerkraut on top, then layer with corned beef and Swiss cheese. Spread salad dressing over Swiss cheese, and sprinkle evenly with bread crumbs. Wrap the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DH8pTFqJlBXHEe4UqOExpOQ-ExA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216693-Reuben-Pierogie-Casserole-DDMFS-step-02-1d679cb91e2f4ef1839e8d145d031542.jpg"
      ],
      "image": "assets/images/216693/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Remove the aluminum foil, and continue baking until hot and bubbly, 10 to 20 minutes more.",
      "section": null,
