  "ingredients": [
    "3 eggs",
    "1.5 cups white sugar",
    "0.5 cup butter, softened",
    "3 tablespoons all-purpose flour",
    "1 cup buttermilk",
    "1 tablespoon lemon juice",
    "1 teaspoon vanilla extract",
    "0.125 teaspoon freshly grated nutmeg",
    "1 (9 inch) unbaked pie crust"
  ],
