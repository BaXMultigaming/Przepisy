  "ingredients": [
    "0.66666668653488 cup white sugar",
    "0.33333334326744 cup all-purpose flour",
    "0.25 teaspoon salt",
    "3 eggs, beaten",
    "2 cups milk",
    "2 tablespoons butter, softened",
    "0.5 teaspoon vanilla extract",
    "2 bananas, peeled and sliced",
    "0.5 (12 ounce) package vanilla wafer cookies"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M3KuhtnCjGeVvLRya-X37yNJnvQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-18990-banana-pudding-DDMFS-step-01-efc9a7c57206490f9fbca3bb48c3a8c3.jpg"
      ],
      "image": "assets/images/18990/step_01.webp"
    },
    {
      "text": "Combine sugar, flour, and salt together in a medium saucepan. Whisk in eggs and milk; cook mixture over low heat, stirring constantly (and patiently), until mixture has thickened enough to coat the back of a spoon, up to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1dELRrzVI6cnBRaag95dqdLMR7Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-18990-banana-pudding-DDMFS-step-03-68e4ec728c33446d9fe1a8463052c66a-8a1c0a7728564683bb02a7e4f6e86592.jpg"
      ],
      "image": "assets/images/18990/step_02.webp"
    },
    {
      "text": "Remove from heat and continue to stir until pudding has cooled slightly; whisk in butter and vanilla until incorporated and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pudding into a large serving dish; layer with sliced bananas and vanilla wafers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SVc1RUUt7HeBdrRHXr-vfQnQlmk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-18990-banana-pudding-DDMFS-step-05-f4d388423d1e4b05a2cbf7051e97ad00.jpg"
      ],
      "image": "assets/images/18990/step_04.webp"
    },
    {
      "text": "Chill at least 1 hour in the refrigerator before serving.",
