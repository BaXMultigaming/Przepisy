  "ingredients": [
    "0.5 cup shortening",
    "1.5 cups white sugar",
    "3 eggs",
    "0.5 cup molasses",
    "2.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground allspice",
    "1 teaspoon ground ginger",
    "1.5 cups raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together shortening and sugar until smooth. Beat in the eggs one at a time, then stir in the molasses. Combine the flour, baking soda, cinnamon, allspice, and ginger; blend into the molasses mixture. Stir in raisins. Drop dough by tablespoonfuls onto prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes in preheated oven, or until the center is set. Cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
