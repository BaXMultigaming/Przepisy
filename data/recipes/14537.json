  "ingredients": [
    "2.5 tablespoons paprika",
    "2 tablespoons garlic powder",
    "1 tablespoon salt",
    "1 tablespoon onion powder",
    "1 tablespoon dried thyme",
    "1 tablespoon ground cayenne pepper",
    "1 tablespoon ground black pepper",
    "4 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Preheat the grill for medium-high heat. Lightly oil the grill grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together paprika, garlic powder, salt, onion powder, thyme, cayenne pepper, and ground black pepper in a bowl. Set aside 3 tablespoons spice mixture; store remainder in an airtight container for later use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub reserved 3 tablespoons spice mixture all over chicken breasts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook chicken on the preheated grill until juices run clear, 6 to 8 minutes on each side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
