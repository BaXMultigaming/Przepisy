  "ingredients": [
    "1 cup vegetable oil",
    "0.5 cup white sugar",
    "0.25 cup cider vinegar",
    "1 teaspoon salt",
    "1 teaspoon ground paprika",
    "1 teaspoon celery seed",
    "1 teaspoon onion powder",
    "1 large head broccoli, cut into bite-sized florets",
    "1 (16 ounce) package sliced fresh mushrooms",
    "2 stalks green onion, sliced"
  ],
  "steps": [
    {
      "text": "Combine oil, sugar, vinegar, salt, paprika, celery seed, and onion powder in a jar. Seal the jar, shake, and refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine broccoli, mushrooms, and green onion in a large bowl. Remove dressing from the refrigerator and shake. Pour over veggies, toss to coat, and refrigerate for at least 1 hour before serving.",
