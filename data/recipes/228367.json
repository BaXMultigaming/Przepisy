  "ingredients": [
    "2 cups chicken broth",
    "1 (14.5 ounce) can diced tomatoes",
    "0.5 cup all-purpose flour",
    "0.33333334326744 cup chili powder",
    "2 teaspoons ground cumin",
    "1 clove garlic",
    "1 teaspoon oregano",
    "1 teaspoon salt, or to taste",
    "1 pinch cayenne pepper, or more to taste",
    "4 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Place chicken broth, tomatoes, flour, chili powder, garlic, cumin, oregano, salt, and cayenne into a blender; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken breasts in a slow cooker; pour blended sauce over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover slow cooker. Cook on Low 8 to 9 hours (or on High 4 to 6 hours).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred chicken with 2 forks; stir into sauce.",
