  "ingredients": [
    "1 cup chickpea flour",
    "1 cup water",
    "cooking spray",
    "2 tablespoons oil",
    "1.5 teaspoons Italian seasoning",
    "1.5 teaspoons chopped dried rosemary",
    "ground black pepper to taste",
    "1 pinch salt to taste"
  ],
  "steps": [
    {
      "text": "Whisk chickpea flour and water together in a bowl until smooth; let sit at room temperature, 2 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Spray the inside of an 8-inch metal pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Skim foam from the top of chickpea-water mixture. Add oil, Italian seasoning, and rosemary and stir until combined. Pour mixture into the prepared pan; sprinkle black pepper and salt over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges begin to brown, about 15 minutes. Remove bread from pan and cut into wedges.",
