  "ingredients": [
    "2 tablespoons vegetable oil",
    "2 teaspoons salt-free herb seasoning",
    "2 teaspoons ground paprika",
    "1 teaspoon salt",
    "1 (1 pound) flank steak, thinly sliced against the grain",
    "1 (14.5 ounce) can diced tomatoes, undrained",
    "1 (8 ounce) package sliced mushrooms",
    "1 medium onion, thinly sliced",
    "1 medium green bell pepper, thinly sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil, herb seasoning, paprika, and salt in a 9x13-inch baking pan. Add steak slices, undrained tomatoes, mushrooms, onion, and bell pepper; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, uncovered, until vegetables are tender and steak is cooked through, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
