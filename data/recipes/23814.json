  "ingredients": [
    "0.5 cup soy sauce",
    "0.25 cup orange juice",
    "2 tablespoons sugar",
    "1 clove garlic, minced",
    "0.5 teaspoon ground ginger",
    "2 tablespoons raisins",
    "4 (8 ounce) skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "To Marinate: Combine soy sauce, orange juice, sugar, garlic, ginger and raisins in a nonporous glass dish or bowl. Mix well, then add chicken and turn to coat. Cover dish or bowl and refrigerate to marinate for 2 to 3 hours, turning once or twice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in a 9x13 inch baking dish and pour marinade evenly over all.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes, basting often.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
