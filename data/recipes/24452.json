  "ingredients": [
    "1 cup margarine",
    "1.5 cups white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1 cup sour cream",
    "5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "In a large bowl, cream together the margarine and sugar. Beat in the eggs, vanilla and sour cream. Combine the flour, baking powder, salt and nutmeg, stir into the creamed mixture until just blended. Dough will be light and sticky. Cover or wrap dough and chill overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). On a lightly floured surface, roll the dough out to 1/8 inch thickness. Cut into desired shapes using cookie cutters. Place cookies 1 inch apart onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 8 to 10 minutes, until cookies turn a very light brown. Remove from baking sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
