  "ingredients": [
    "vegetable cooking spray",
    "2 tablespoons olive oil",
    "2 tablespoons grated Parmesan cheese",
    "1 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "0.125 teaspoon ground black pepper",
    "3 medium zucchini, cubed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly spray a 15 1/2x10 1/2-inch rimmed baking pan with vegetable cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix olive oil, Parmesan cheese, salt, garlic powder, and pepper together in a large bowl. Add zucchini and toss to coat. Spread zucchini in a single layer on the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until zucchini is tender but not too soft, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
