  "title": "Navajo Fry Bread",
  "description": "Navajo fry bread made with flour, baking powder, salt, and warm milk, is shaped into thin rounds, deep-fried until golden, and served hot.",
  "authors": [
    "Saundra"
  ],
  "date_published": "2000-03-18T20:23:15-05:00",
