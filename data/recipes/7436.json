  "ingredients": [
    "0.5 cup chopped dried cherries",
    "0.5 cup hot water",
    "0.5 teaspoon almond extract",
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1 cup white sugar",
    "1 (8 ounce) container vanilla yogurt",
    "0.5 cup vegetable oil",
    "1 egg",
    "1 egg white",
    "0.25 cup chopped pecans",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Combine cherries, hot water, and almond extract: let stand 20 minutes. Drain cherries, and pat dry between layers of paper towels. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine flour, salt, baking powder, and 1 cup white sugar. Add yogurt, eggs, and oil. Stir well. Fold in cherries. Pour batter into a greased and floured 9 inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pecans and 1 tablespoon white sugar together. Sprinkle on top of batter in pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 35 minutes, or until wooden pick comes out clean. Cool in pan on wire rack 10 minutes. Serve warm, or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
