  "ingredients": [
    "12 carrots, chopped",
    "6 small white potatoes, peeled",
    "1 cup chopped onion",
    "1 tablespoon canola oil",
    "1 (3 pound) boneless beef chuck roast",
    "1 (15 ounce) can tomato sauce",
    "0.25 cup packed brown sugar",
    "2 tablespoons Worcestershire sauce, or more to taste",
    "2 tablespoons cider vinegar",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Combine carrots, potatoes, and onion in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat canola oil in a large skillet over medium-high heat. Add beef roast; cook until completely browned, 2 to 3 minutes per side. Transfer beef to the slow cooker on top vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk tomato sauce, brown sugar, Worcestershire sauce, vinegar, and salt together in a bowl; pour over beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover slow cooker. Cook on Low for 10 to 12 hours (or on High for 5 to 6 hours).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer beef and vegetables to a serving platter. Pour sauce in a skillet; cook over medium-high heat until thickened, 5 to 10 minutes. Serve sauce with beef and vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
