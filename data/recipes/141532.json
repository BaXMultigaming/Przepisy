  "ingredients": [
    "1 egg",
    "0.33333334326744 cup peanut butter",
    "0.5 cup mashed banana",
    "1 tablespoon honey",
    "1 cup whole wheat flour",
    "0.5 cup wheat germ",
    "1 egg white, lightly beaten, for brushing"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together the egg, peanut butter, banana, and honey in a medium bowl; blend thoroughly. Stir in the flour and wheat germ; mix well. Turn dough out onto a floured board and roll to 1/4 inch thick. Cut into desired shapes with a cookie cutter, place on prepared baking sheet, and brush tops with egg white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake biscuits in preheated oven until dried and golden brown, about 30 minutes, depending on size. Remove from oven and cool on a wire rack.",
