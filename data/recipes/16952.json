  "ingredients": [
    "1 cup white sugar",
    "0.5 cup margarine, softened",
    "2 eggs",
    "1.5 cups mashed banana",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and margarine in a bowl until smooth. Beat in eggs, then bananas. Add flour and baking soda, stirring just until combined. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick in the center comes out clean, about 1 hour. Remove from the pan and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Store in the refrigerator or freeze.",
      "section": null,
      "name": null,
      "url": null,
