  "ingredients": [
    "cooking spray",
    "0.5 cup white sugar",
    "1 teaspoon ground cinnamon",
    "1 large apple - peeled, cored, and chopped into 20 chunks",
    "1 (1 pound) loaf frozen bread dough, thawed",
    "0.5 stick butter, melted",
    "0.5 cup brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a fluted tube pan (such as Bundt®) with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix white sugar and cinnamon together in a medium bowl. Add apple chunks and stir to coat thoroughly. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 20 pieces. Wrap 1 piece of dough around a coated apple chunk and pinch to seal shut. Dip in melted butter, then roll in brown sugar. Arrange balls of dough in even circles in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully invert pan onto a large plate so caramel mixture runs over each piece. Cool briefly before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
