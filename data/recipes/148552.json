  "ingredients": [
    "2 eggs",
    "0.75 cup white sugar",
    "2 cups heavy cream",
    "1 cup whole milk",
    "1 teaspoon vanilla extract",
    "0.75 teaspoon root beer extract"
  ],
  "steps": [
    {
      "text": "Whip eggs in a bowl until foamy; slowly pour in sugar while continually whipping eggs until ribbony. Fold in cream, milk, vanilla extract, and root beer extract until evenly mixed.",
