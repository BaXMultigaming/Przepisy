  "ingredients": [
    "1 pound ground turkey",
    "0.25 cup minced red onion",
    "1 tablespoon Dijon mustard",
    "1 teaspoon coarse salt",
    "1 tablespoon olive oil, or as needed",
    "4 whole wheat hamburger buns",
    "1 cup baby arugula",
    "1 avocado - peeled, pitted, and sliced",
    "4 slices green bell pepper",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Mix ground turkey, minced red onion, Dijon mustard, and coarse salt in a bowl; form into 4 patties and refrigerate 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle olive oil over the burgers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook burgers on the preheated grill until no longer pink in the center and the juices run clear, 4 to 5 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve on whole wheat hamburger buns topped with baby arugula, avocado, green bell pepper, and Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
