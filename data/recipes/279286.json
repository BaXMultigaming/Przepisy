  "ingredients": [
    "1 pound ground pork",
    "1 teaspoon sea salt",
    "1 teaspoon rubbed sage",
    "1 teaspoon crushed red pepper",
    "0.5 teaspoon dried marjoram",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon dried thyme"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground pork, sea salt, sage, red pepper, marjoram, onion powder, pepper, and thyme in a large bowl. Mix with your hands well until evenly combined. Form mixture into 8 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 4 patties in the basket of the air fryer and cook for 5 minutes. Carefully flip the patties and cook for 5 minutes more. Transfer to a paper towel-lined plate and repeat with remaining patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
