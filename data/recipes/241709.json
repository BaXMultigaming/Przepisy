  "ingredients": [
    "cooking spray",
    "2 tablespoons soy sauce",
    "2 tablespoons agave nectar",
    "1 tablespoon toasted sesame oil",
    "1 teaspoon minced garlic",
    "1 teaspoon minced fresh ginger",
    "1 tablespoon sesame seeds, or to taste",
    "1 pound tofu, sliced into 8 even pieces"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aOw-GO9ufTwvNnFx0t8KbkIdjvA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241709-Baked-Tofu-ddmfs-step-0-272-1796deffd4e2443b80dc171fa4746ec8.jpg"
      ],
      "image": "assets/images/241709/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a large baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4ZWI0HW9PyHNrG7o7vfgZBOCTmU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241709-Baked-Tofu-ddmfs-step-1-274-2d3467e30bcf436baef647faa3108fea.jpg"
      ],
      "image": "assets/images/241709/step_02.webp"
    },
    {
      "text": "Whisk soy sauce, agave, sesame oil, garlic, and ginger together in a bowl until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1vplP5i8gg7YsvLtIJUBcB-YAHo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241709-Baked-Tofu-ddmfs-step-4-279-18274895b25640b283036aca5c7afbe9.jpg"
      ],
      "image": "assets/images/241709/step_03.webp"
    },
    {
      "text": "Gently press tofu pieces to release as much water as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JEvgQM5lrW2Y8o0dOOEuYkhQP5Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241709-Baked-Tofu-ddmfs-step-2-275-202a664e23a949acbfa9f67b27103fcf.jpg"
      ],
      "image": "assets/images/241709/step_04.webp"
    },
    {
      "text": "Arrange tofu on the prepared baking sheet and brush with 1/2 of the soy mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uGbAan9EpnIP-JY9t5U8pgA0VnA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241709-Baked-Tofu-ddmfs-step-5-282-7ea02c2d856f452da52ab79646599867.jpg"
      ],
      "image": "assets/images/241709/step_05.webp"
    },
    {
      "text": "Bake tofu in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FSBALnyzyv3qKw9YbCiqeyiZl2o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241709-Baked-Tofu-ddmfs-step-6-285-1f960e78f63b41df8b4558016412977c.jpg"
      ],
      "image": "assets/images/241709/step_06.webp"
    },
    {
      "text": "Flip tofu and brush with remaining soy mixture. Sprinkle sesame seeds over top. Continue baking until tofu is crisp, about 30 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LoVRl5XwR4P57VTggrQ-lq5Yabs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241709-Baked-Tofu-ddmfs-step-7-286-44c3c47dc5444eaa8afffd82e1ba8068.jpg"
      ],
      "image": "assets/images/241709/step_07.webp"
    },
    {
      "text": "Remove from the oven and use a spatula to transfer tofu to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MuLY0BVVto8sqZw8WAmWGyQeGfY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241709-Baked-Tofu-ddmfs-step-8-341-572c8d2174554928abc4c9fe064cce26.jpg"
