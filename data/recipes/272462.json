  "ingredients": [
    "2 refrigerated unbaked 9-inch pie crusts",
    "1 whole rotisserie chicken",
    "0.33333334326744 cup butter",
    "0.33333334326744 cup chopped onion",
    "0.33333334326744 cup all-purpose flour",
    "salt and ground black pepper to taste",
    "1.75 cups chicken broth",
    "0.5 cup milk",
    "1 (16 ounce) bag frozen mixed vegetables, thawed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place 1 pie crust in a 9-inch pie plate. Set aside second crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove skin from rotisserie chicken and shred meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Add onion and cook until tender, about 5 minutes. Add flour, salt, and pepper; stir until a paste is formed, 2 to 3 minutes. Add broth and milk, stirring until thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken and vegetables, stirring until combined. Pour mixture into the prepared pie plate. Place second crust on top, sealing edges and making several slashes on top. Wrap edges with foil to prevent them from browning too fast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
