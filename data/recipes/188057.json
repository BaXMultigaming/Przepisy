  "ingredients": [
    "2 cups reduced-fat mayonnaise",
    "1 hard-cooked egg, peeled and chopped",
    "0.25 onion, minced",
    "2 tablespoons dill pickle relish",
    "2 teaspoons cayenne pepper",
    "1 teaspoon seasoned salt"
