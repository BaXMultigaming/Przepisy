  "steps": [
    {
      "text": "Place longaniza in a microwave-safe bowl, cover with a paper towel, and microwave for 1 minute. Remove bowl from microwave and break up longaniza. Cover with paper towel and microwave 1 minute more. Remove bowl, stir longaniza, cover, and microwave 1 additional minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove bowl from microwave and stir in eggs, mixing until well incorporated. Return bowl to the microwave and cook for 45 seconds. Stir and continue cooking until eggs have set, 45 more seconds. Season to taste with salt and pepper.",
      "section": null,
