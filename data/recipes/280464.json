  "ingredients": [
    "1 pound bacon",
    "1 bunch broccoli, finely chopped",
    "0.5 cup sunflower seeds",
    "0.5 cup diced red onion",
    "0.75 cup mayonnaise",
    "0.25 cup white sugar",
    "2 tablespoons white vinegar"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels and let cool enough to handle, 5 to 10 minutes. Crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine crumbled bacon with broccoli, sunflower seeds, and red onion in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mayonnaise, sugar, and vinegar together in a separate bowl. Pour over broccoli mixture and mix together. Refrigerate for at least 20 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
