  "ingredients": [
    "2 cups rolled oats",
    "1 (12 ounce) package semisweet chocolate chips",
    "1 cup shredded coconut",
    "1 cup chopped almonds",
    "1 cup white sugar",
    "0.5 cup milk",
    "0.5 cup butter",
    "1 pinch salt",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oats, chocolate chips, coconut, and almonds together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, milk, butter, and salt together in a saucepan; bring mixture to a boil, add vanilla, and remove from heat. Pour milk mixture over chocolate chips mixture; stir until well-combined. Drop spoonfuls of chocolate mixture onto prepared baking sheet. Chill in the refrigerator until haystacks are set, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
