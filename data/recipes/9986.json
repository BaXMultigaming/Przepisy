  "title": "Chocolate Peanut Butter Cup Cookies",
  "description": "A peanut butter cookie filled with chocolate chips, peanut butter chips, and peanut butter cups. If you like peanut butter and chocolate - these cookies are for you!",
  "authors": [
    "Joanna Knudsen"
  ],
  "date_published": "1997-08-11T16:23:16-04:00",
