  "ingredients": [
    "2 tablespoons brown sugar",
    "1 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "1 tablespoon chili powder",
    "1.5 teaspoons ancho chile powder",
    "1 teaspoon chipotle chile powder",
    "1 tablespoon salt-free seasoning blend",
    "salt and black pepper to taste",
    "1 (2 pound) flat iron steak",
    "0.25 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Mix the brown sugar, garlic powder, onion powder, chili powder, ancho chile powder, chipotle chile powder, salt-free seasoning blend, salt, and pepper together in a bowl until thoroughly blended. Sprinkle over both sides of the steak, and rub into the meat. Cover, and refrigerate at least 30 minutes, or up to 2 days.",
      "section": null,
      "name": null,
