  "ingredients": [
    "0.25 cup butter",
    "1 medium onion, diced",
    "1 cup uncooked pearl barley",
    "0.5 cup pine nuts",
    "2 green onions, thinly sliced",
    "0.5 cup sliced fresh mushrooms",
    "0.5 cup chopped fresh parsley",
    "0.25 teaspoon salt",
    "0.125 teaspoon pepper",
    "2 (14.5 ounce) cans vegetable broth"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium-high heat. Add onion, barley, and pine nuts; cook and stir until barley is lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in green onions, mushrooms, and parsley; season with salt and black pepper. Transfer barley mixture to a 2-quart casserole dish; stir in vegetable broth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until liquid has been absorbed and barley is tender, about 1 hour and 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
