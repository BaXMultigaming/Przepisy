  "ingredients": [
    "8 medium yellow squash, shredded",
    "1 onion, shredded",
    "1.5 tablespoons salt",
    "1 cup shredded Cheddar cheese",
    "1 cup all-purpose flour",
    "0.5 cup cornmeal",
    "1 egg, lightly beaten",
    "ground black pepper to taste",
    "1 tablespoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Place squash and onion in a colander; sprinkle with salt and drain until no longer moist, about 30 minutes. Wrap vegetables in a clean kitchen towel and squeeze out as much moisture as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix squash and onion mixture, cheese, flour, cornmeal, and egg in a bowl; season with pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat. Drop squash mixture by heaping tablespoonfuls into the skillet; cook patties until crisp and golden brown, about 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
