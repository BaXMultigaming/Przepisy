  "ingredients": [
    "1 pound Italian sausage links, casings removed and cut into pieces",
    "1 tablespoon olive oil",
    "0.5 pound lean ground beef",
    "1 onion, chopped",
    "1 clove garlic, chopped",
    "1 (16 ounce) can canned tomatoes",
    "1 (15 ounce) can canned tomato sauce",
    "1 teaspoon salt",
    "1 teaspoon dried basil",
    "1 teaspoon dried oregano",
    "1 bay leaf",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium heat; add sausage and cook until browned, about 10 minutes. Remove sausage and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in the same skillet over medium heat. Stir in ground beef, garlic, and onion. Cook and stir until beef is browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in tomatoes and tomato sauce; stir in cooked sausage. Season with salt, basil, oregano, bay leaf, and pepper. Simmer uncovered for 1 hour, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove bay leaf before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
