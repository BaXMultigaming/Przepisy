  "ingredients": [
    "3 eggs",
    "1 banana, cut into chunks",
    "1 (18.25 ounce) package yellow cake mix",
    "1 (15.25 ounce) can apple pie filling, or more to taste",
    "0.75 cup brown sugar",
    "0.5 cup flaked coconut",
    "0.5 cup chopped pecans",
    "1 tablespoon ground cinnamon",
    "0.75 cup confectioners' sugar",
    "5 teaspoons milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and banana together in a bowl until smooth. Add cake mix and apple pie filling to eggs; beat until batter is combined. Pour batter into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar, coconut, pecans, and cinnamon together in a bowl; sprinkle over batter in the baking dish. Swirl coconut mixture into batter using a knife or toothpick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the cake comes out clean, about 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk confectioners' sugar and milk together in a bowl until icing is smooth. Drizzle icing over the top of the hot cake. Cool cake in the baking dish to room temperature, cover the dish with plastic wrap, and refrigerate until cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
