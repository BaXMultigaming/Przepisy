  "title": "Easy Apple Pie Coffee Cake",
  "description": "Coffee cake gets a fresh take with the addition of apple pie filling, coconut, and pecans.",
  "authors": [
    "CDabis"
  ],
  "date_published": "2020-06-19T00:00:33-04:00",
