  "ingredients": [
    "1 (8 ounce) package angel hair pasta",
    "0.5 cup butter",
    "2 cloves garlic, sliced",
    "1.5 pounds shrimp, peeled and deveined",
    "0.33333334326744 cup white wine",
    "0.75 cup dry bread crumbs",
    "3 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to a boil. Add angel hair pasta and return pot to boil. Cook until al dente. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan, melt butter, saute garlic until tender, remove garlic and discard. Add shrimp and cook until colored pink. Stir in white wine. The bread crumbs are used as thickening, so stir in a little at a time until desired thickness is reached.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve shrimp over angel hair pasta, sprinkled with Parmesan cheese.",
      "section": null,
      "name": null,
