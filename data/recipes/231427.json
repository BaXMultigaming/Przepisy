  "ingredients": [
    "1 pound ground beef",
    "1 pound ground sausage",
    "1 yellow onion, chopped",
    "2 (14.5 ounce) cans stewed tomatoes",
    "1 (15 ounce) can tomato sauce",
    "1 (15 ounce) can light red kidney beans, drained and rinsed",
    "1 (15 ounce) can dark red kidney beans, drained and rinsed",
    "1 (8 ounce) jar mild salsa",
    "0.25 cup chili seasoning mix",
    "0.5 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Add beef, sausage, and onion; cook and stir until beef and sausage are completely browned, 7 to 10 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in stewed tomatoes, tomato sauce, kidney beans, salsa, chili seasoning mix, and garlic powder. Bring to a boil, then reduce the heat to medium-low and simmer until flavors meld, 1 1/2 to 2 hours.",
      "section": null,
      "name": null,
