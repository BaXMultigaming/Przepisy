  "ingredients": [
    "1 bunch thin asparagus spears, trimmed",
    "0.5 tablespoon olive oil",
    "0.5 tablespoon balsamic vinegar",
    "0.5 teaspoon garlic powder",
    "2 sprigs fresh rosemary, minced",
    "0.5 teaspoon sea salt",
    "freshly ground black pepper to taste",
    "1 medium lemons, quartered"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine asparagus, olive oil, balsamic vinegar, garlic powder, rosemary, sea salt, and black pepper in a large bowl. Toss to evenly coat the asparagus.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry in a single layer (on the top rack if using an oven-style air fryer) until the asparagus spears begin to char, 7 to 10 minutes. Serve as-is with a lemon wedge for squeezing. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
