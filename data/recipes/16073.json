  "ingredients": [
    "3 medium russet potatoes, peeled",
    "1 large egg, beaten, or more to taste",
    "2 tablespoons all-purpose flour",
    "1 tablespoon grated onion",
    "0.5 teaspoon salt, or more to taste",
    "0.25 cup peanut oil for frying, or as needed"
  ],
  "steps": [
    {
      "text": "Grate potatoes in a food processor fitted with the grater attachment. Transfer to cheesecloth; wring well to remove as much moisture as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sVpPoTW-FLWy2zq5MCIxZAlxzfk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-16073-potato-latkes-i-VAT-step-02-1c17bb9e71ea46ff9b9c021d9fa11ed8.jpg"
      ],
      "image": "assets/images/16073/step_01.webp"
    },
    {
      "text": "Place 2 cups potatoes in a medium bowl (save any extra for another use). Add egg, flour, onion, and salt; stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HY1tczqKoNkRuu5Efym5yQXZxqM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-16073-potato-latkes-i-VAT-step-03-88767a6316334a23b9839cbd4b527e85.jpg"
      ],
      "image": "assets/images/16073/step_02.webp"
    },
    {
      "text": "Heat 1/4 inch of oil in a large, heavy-duty skillet over medium-high heat. Add large spoonfuls of potato mixture, pressing down to form 1/4- to 1/2-inch-thick patties. Cook until golden brown, 4 to 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cyUmaI-QNHFRQPYx5Ovea5KGkhk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-16073-potato-latkes-i-VAT-step-04-1dcfbe80c0434c7b8935e0d7eacd62ce.jpg"
      ],
      "image": "assets/images/16073/step_03.webp"
    },
    {
      "text": "Drain on paper towel-lined plates.",
      "section": null,
      "name": null,
      "url": null,
