  "ingredients": [
    "3 slices bacon, chopped",
    "2 rutabagas, peeled and diced",
    "2 tablespoons butter",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place bacon in a skillet over medium heat; cook and stir until crisp, about 10 minutes. Remove bacon from skillet, reserving 1 to 2 tablespoons bacon grease, to your preference.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to a boil. Cook rutabagas in the boiling water until very tender, 15 to 20 minutes. Drain rutabagas and return to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix reserved bacon grease, butter, salt, and pepper into rutabagas; blend using an electric mixer until smooth. Stir chopped bacon into the rutabaga mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
