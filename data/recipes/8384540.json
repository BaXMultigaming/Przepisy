  "ingredients": [
    "1 bunch raw radish greens",
    "2 tablespoons olive oil",
    "0.5 teaspoon kosher salt"
  ],
  "steps": [
    {
      "text": "When cutting off the greens of each radish, leave 1/4 inch of the radish attached to the greens. Place in a bowl. Add olive oil and salt, and toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 360 degrees F (180 degrees C) for 5 minutes while the radish greens absorb the oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place greens in the air fryer, radish slice-down. Cook for 6 minutes. Transfer to a paper towel-lined plate and let cool for 3 minutes. Snack immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
