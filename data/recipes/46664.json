  "ingredients": [
    "1 cup vegetable oil",
    "0.5 cup apple cider vinegar",
    "0.25 cup egg substitute",
    "1 teaspoon garlic powder",
    "1 teaspoon ground paprika",
    "1 teaspoon poultry seasoning",
    "1 tablespoon salt",
    "1 teaspoon black pepper",
    "10 skinless chicken thighs"
  ],
  "steps": [
    {
      "text": "In a jar with a lid, combine the vegetable oil, apple cider vinegar, egg substitute, garlic powder, paprika, poultry seasoning, salt, and pepper. Close the lid, and shake to blend. Place chicken in a shallow glass baking dish. Pour about 3/4 of the marinade over it, and reserve the rest for basting. Cover chicken, and refrigerate 8 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil the grill grate. Place chicken on the grill, and discard marinade from the dish. Cook the chicken for 10 minutes on each side, or until juices run clear. Brush reserved sauce onto chicken just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
