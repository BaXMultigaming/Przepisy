  "ingredients": [
    "2 tablespoons vegetable oil",
    "0.5 onion, diced",
    "1 tomato, diced",
    "10 large roasted green chile peppers, seeded and chopped",
    "0.5 cup shredded queso asadero (white Mexican cheese)",
    "0.25 cup shredded Monterey Jack cheese",
    "0.25 cup milk",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Heat the vegetable oil in a skillet over medium heat. Stir in the onion and tomato; cook and stir until the onion has softened and turned translucent, about 5 minutes. Add the green chile; cook for 2 minutes then stir in the cheese and milk. Reduce heat to low and simmer, stirring frequently, until the cheese has melted.",
