  "ingredients": [
    "0.5 cup powdered peanut butter (such as PB2®)",
    "0.25 cup sugar",
    "2.5 tablespoons unsalted butter, softened",
    "2 tablespoons all-purpose flour",
    "1 large egg",
    "1 pinch salt",
    "1/2 teaspoon peanut butter flavor",
    "0.25 teaspoon baking powder",
    "0.25 cup mini candy-coated milk chocolate (such as M&M's®)"
