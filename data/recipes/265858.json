  "ingredients": [
    "4 mangoes, peeled and cubed",
    "2 cups heavy whipping cream",
    "0.75 cup packed dark brown sugar",
    "0.25 cup light corn syrup",
    "4 tablespoons spiced rum",
    "0.5 teaspoon kosher salt"
  ],
  "steps": [
    {
      "text": "Combine mangoes, heavy cream, brown sugar, and corn syrup in a blender or the bowl of a food processor; blend on high for 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer mango mixture to an airtight container; stir in spiced rum and salt. Refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer's instructions, about 20 minutes. Transfer to an airtight container and freeze until firm, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
