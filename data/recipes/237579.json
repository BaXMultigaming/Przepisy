  "ingredients": [
    "1 onion, finely chopped",
    "1 cup finely chopped mushroom",
    "0.75 cup milk",
    "0.66666668653488 cup seasoned bread crumbs",
    "2 eggs, beaten",
    "1 teaspoon salt",
    "1.5 pounds ground beef",
    "0.5 cup ketchup",
    "0.25 cup brown sugar",
    "2 teaspoons ground mustard",
    "1 teaspoon Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Mix onion, mushroom, milk, bread crumbs, eggs, and salt together in a large bowl. Break ground beef into small pieces and add to onion mixture; stir. Shape the beef mixture into a round loaf and place into a 5-quart slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until no longer pink in the center, 5 to 6 hours. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk ketchup, brown sugar, mustard, and Worcestershire sauce together in a small bowl; spoon over the meatloaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue cooking glazed meatloaf until the glaze is warmed, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove meatloaf to a cutting board and let rest 10 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
