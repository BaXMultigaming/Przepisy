  "ingredients": [
    "1 cup ground beef",
    "1 (1.25 ounce) package dry taco seasoning mix",
    "1 (14 ounce) package prepared pizza dough, or as needed",
    "0.5 cup pizza sauce",
    "0.25 teaspoon ground cumin",
    "1 pinch salt",
    "1.25 cups shredded mild Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Add ground beef and taco seasoning; cook and stir until beef is browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide pizza dough in half. Flatten each half into a thin crust and place onto a nonstick baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the crusts are baking, mix pizza sauce, cumin, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove crusts from the oven and spread 1/2 of the sauce mixture over each one. Sprinkle beef and Cheddar evenly over top. Return to the oven and bake until cheese is melted and the crusts are crunchy, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
