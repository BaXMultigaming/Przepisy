  "ingredients": [
    "3 pounds lean ground beef",
    "1 (10.75 ounce) can condensed tomato soup",
    "1 (10.5 ounce) can condensed French onion soup",
    "0.5 cup ketchup",
    "0.5 cup packed brown sugar",
    "10 hamburger buns"
  ],
  "steps": [
    {
      "text": "In a large skillet over medium heat, brown the ground beef; drain fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in tomato and French onion soups. Fill each can a quarter full with water to rinse the cans out. Pour into meat mixture. Add ketchup and brown sugar. Mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let simmer for 30 minutes. Serve on hamburger buns.",
