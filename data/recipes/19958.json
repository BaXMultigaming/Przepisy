  "ingredients": [
    "1 (8 ounce) package uncooked spaghetti",
    "1 tablespoon vegetable oil",
    "1 (12 ounce) container fully cooked luncheon meat (e.g. Spam), cubed",
    "0.5 green onion, chopped",
    "1 clove garlic, chopped",
    "1 tablespoon soy sauce",
    "0.5 cup water",
    "0.5 tablespoon sesame oil",
    "1 teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat vegetable oil in a medium saucepan over medium heat. Add luncheon meat, green onion and garlic and saute until light brown. Stir in cooked spaghetti , then stir in soy sauce, water, sesame oil and pepper. Mix all together, heat through and serve.",
