  "ingredients": [
    "1 cup hot brewed tea",
    "0.75 cup dried currants",
    "0.75 cup golden raisins",
    "0.75 cup demerara sugar",
    "1.25 cups self-rising flour",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Pour hot tea over currants and raisins in a bowl; soak 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and line a 2-pound loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir demerara sugar into tea and fruit mixture until dissolved completely; mix in flour and egg until completely integrated into a batter. Spread batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden-brown and a toothpick inserted into the center comes out clean, about 40 minutes. Cool in the pan briefly before transferring to a rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
