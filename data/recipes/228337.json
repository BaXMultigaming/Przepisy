  "ingredients": [
    "2 tablespoons extra virgin olive oil",
    "1 bunch curly kale, torn",
    "0.5 cup nutritional yeast",
    "0.33333334326744 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 200 degrees F (95 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle olive oil over the kale in a large bowl and sprinkle with the nutritional yeast and salt. Stir with your hands to coat kale.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread kale onto baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until kale begins to get slightly crisp; rotate racks and flip the chips, and continue baking until completely crisp, 45 to 60 minutes total. Make sure to keep an eye on them to make sure they don't burn; if you notice certain chips ready much sooner than others, take them out.",
