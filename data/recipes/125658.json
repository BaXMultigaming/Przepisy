  "ingredients": [
    "2 tablespoons vegetable oil, or more as needed",
    "12 corn tortillas",
    "3 cooked boneless skinless chicken breast halves, shredded",
    "12 ounces shredded Monterey Jack cheese, divided",
    "0.75 cup minced onion",
    "0.25 cup butter",
    "0.25 cup all-purpose flour",
    "2 cups chicken broth",
    "1 cup sour cream",
    "1 (4 ounce) can chopped green chiles, drained",
    "0.5 cup chopped green onions",
    "0.5 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CTUjxb8nz3o4T8GZSxM1xKafJAo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/125658-chicken-enchiladas-DDMFS-step-1-010-92809c5cb0644eb6addd0b7bc54d2fdb.jpg"
      ],
      "image": "assets/images/125658/step_01.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 2 tablespoons oil in a skillet over medium-high heat. Fry tortillas (one at a time) for 5 seconds on each side to soften and make them pliable. Add more oil to the pan as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-VPFeNS0Mh3da6rYYCtR_KPfUoM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/125658-chicken-enchiladas-DDMFS-step-2-025-83739835d76941f3b9e127aaacbcb11f.jpg"
      ],
      "image": "assets/images/125658/step_03.webp"
    },
    {
      "text": "Drain between layers of paper towel and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v6KxWzVwFDKTGKK7X_0oEt1HHTU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/125658-chicken-enchiladas-DDMFS-step-3-026-070bd62a1aa2466c94864cd25469fdf1.jpg"
      ],
      "image": "assets/images/125658/step_04.webp"
    },
    {
      "text": "Divide chicken, 10 ounces Monterey Jack cheese, and onion among 12 tortillas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vFs2InZyh7M_d3Q-CM4pM3c1Pbg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/125658-chicken-enchiladas-DDMFS-step-4-028-07cf3848754e4603813fd183560eab41.jpg"
      ],
      "image": "assets/images/125658/step_05.webp"
    },
    {
      "text": "Roll up each tortilla and place seam-side down in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KZgOTMkMzsg3NKyCFtI3IA_BGGo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/125658-chicken-enchiladas-DDMFS-step-5-029-cbc93b13f0e94f3e9fcba30b108272c0.jpg"
      ],
      "image": "assets/images/125658/step_06.webp"
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Add flour and whisk until mixture begins to boil. Slowly add chicken broth, stirring with a whisk until thickened. Mix in sour cream and green chiles, stirring occasionally. Heat thoroughly but do not boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Nwr8bFSo_3_OOmR38gSZRj04Up8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/125658-chicken-enchiladas-DDMFS-step-9-037-819eab7c4c2d4b96858797069c083bc8.jpg"
      ],
      "image": "assets/images/125658/step_07.webp"
    },
    {
      "text": "Pour mixture over enchiladas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zjakwsLZMplryAqguOpDsYHJQWQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/125658-chicken-enchiladas-DDMFS-step-10-042-3bf74d91f2b84592b3808856bebe9184.jpg"
      ],
      "image": "assets/images/125658/step_08.webp"
    },
    {
      "text": "Bake in the preheated oven until bubbly and heated through, about 20 minutes. Top with remaining Monterey Jack cheese and bake for 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with chopped green onions and cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P7_43-_jtg402cleTqszHtmKblc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/125658-chicken-enchiladas-DDMFS-4x3-d94bb69d07a7451ca78c0a8a59ca74f4.jpg"
      ],
      "image": "assets/images/125658/step_10.webp"
    }
