  "ingredients": [
    "2 eggs",
    "2 tablespoons white sugar",
    "1 tablespoon baking powder",
    "1 tablespoon quinoa flour",
    "1 tablespoon sorghum flour",
    "1 tablespoon millet flour",
    "1 tablespoon olive oil",
    "1 tablespoon peanut butter, or more to taste",
