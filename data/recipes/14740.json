  "ingredients": [
    "1 pound boneless pork loin, cubed",
    "0.5 cup all-purpose flour",
    "1.5 tablespoons peanut oil",
    "0.25 cup chicken broth",
    "0.25 cup water, or more as needed",
    "2 tablespoons soy sauce",
    "1 tablespoon sherry",
    "2 tablespoons thinly sliced green onion",
    "1 clove garlic, minced",
    "1 teaspoon white sugar",
    "1 teaspoon ground ginger",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine cubed pork and flour in a resealable plastic bag. Seal the bag and shake until pork is coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet or wok. Add coated pork and brown quickly, about 5 minutes. Transfer pork with a slotted spoon to a bowl; discard remaining oil from the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken broth, 1/4 cup water, soy sauce, and sherry to the skillet. Stir in green onion, garlic, sugar, ginger, salt, and pepper. Add pork cubes and bring to a boil. Reduce the heat, cover, and simmer until pork is tender, about 15 minutes. Check occasionally to make sure sauce is not thickening too much. If needed, add more water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
