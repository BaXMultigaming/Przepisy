  "title": "Dad's Favorite Peanut Butter Cookies",
  "description": "My dad's sister gave me this recipe for killer peanut butter cookies made with shortening.",
  "authors": [
    "Kendra Amaro"
  ],
  "date_published": "1997-12-30T23:47:20-05:00",
  "date_modified": "2023-02-04T22:13:26-05:00",
