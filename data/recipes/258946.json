  "ingredients": [
    "1 tablespoon extra-light olive oil, or as needed",
    "2 slices Italian bread",
    "2 tablespoons mayonnaise",
    "3 slices deli ham, or more to taste",
    "2 slices Cheddar cheese",
    "1 slice firm-ripe tomato",
    "1 thin slice onion",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Drizzle olive oil on 1 side of each bread slice. Spread 1 tablespoon mayonnaise on other side of each slice.",
