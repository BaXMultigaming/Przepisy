  "ingredients": [
    "0.5 cup chopped walnuts",
    "0.25 cup white sugar",
    "0.25 cup brown sugar",
    "0.5 teaspoon ground cinnamon",
    "2.25 cups all-purpose flour",
    "1 cup white sugar",
    "0.5 cup brown sugar",
    "2 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup vegetable oil",
    "2 large eggs, beaten",
    "1 cup sour milk",
    "2 cups apples - peeled, cored, and chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the topping: Mix walnuts, both sugars, and cinnamon together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the cake: Mix flour, both sugars, cinnamon, baking soda, and salt together in a large bowl. Make a well in the center and pour in sour milk, oil, and eggs. Beat with an electric mixer until smooth, then fold in chopped apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared pan and sprinkle topping mixture evenly over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
