  "ingredients": [
    "0.5 cup sesame seeds",
    "0.5 cup sunflower seeds",
    "1 pinch salt",
    "0.5 cup chopped dates",
    "0.5 cup raisins",
    "0.5 cup dried apricots",
    "0.5 cup dried cherries",
    "0.5 cup semisweet chocolate chips",
    "7 cups crisp rice cereal",
    "1 cup rolled oats",
    "1.5 cups crunchy peanut butter",
    "1 cup corn syrup",
    "1 cup white sugar",
    "1 cup powdered milk",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Combine sesame seeds and sunflower seeds in a dry skillet over medium heat. Cook, stirring until fragrant and toasted. Salt lightly, then set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine dates, raisins, apricots, cherries, chocolate chips, and toasted seeds in the bowl of a food processor. Pulse to chop until small but not pasty. Transfer to a large bowl and mix in crisp rice cereal and oats until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together peanut butter, corn syrup, and sugar in a microwave-safe bowl. Heat in the microwave until bubbly. Stir in powdered milk, vanilla, and almond extract until smooth. Pour peanut butter mixture over dried fruit-cereal mixture and mix with a wooden spoon until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press mixture into a greased 10x15-inch jellyroll pan using wet hands. Cut into squares and allow to cool completely before removing from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
