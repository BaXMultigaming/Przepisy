        "https://www.allrecipes.com/thmb/c5-cOupMHcgHhK9j9-IT5uUF3PI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7622825-10f5e7b789bc4b8eab23280b81f12ff3.jpg"
      ],
