  "ingredients": [
    "4 cups cold water",
    "0.25 cup kosher salt",
    "1 tablespoon whole black peppercorns",
    "1 bay leaf",
    "4 (5 ounce) center-cut pork chops on the bone",
    "0.5 cup packed brown sugar",
    "1 teaspoon garlic powder",
    "1 teaspoon paprika",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon dry mustard powder",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon freshly ground black pepper",
    "1 tablespoon olive oil, or more as needed",
    "aluminum foil"
  ],
  "steps": [
    {
      "text": "Make the brine: Combine cold water, salt, peppercorns, and bay leaf in a bowl. Place pork chops in a shallow baking dish and pour brine over top. Let sit for 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make the rub: Combine brown sugar, garlic powder, paprika, onion powder, mustard powder, salt, and pepper in a small mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pork chops from brine, rinse under cold water, and pat dry. Rub pork chops generously on both sides with the seasoning mix. Discard brine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a cast iron skillet over medium-high heat. Add oil to the hot skillet. Add pork chops to the hot oil and sear until browned, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn pork chops and place skillet in the preheated oven. Bake until no longer pink in the center, 6 to 8 minutes. Remove from the oven, tent with aluminum foil, and let rest for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
