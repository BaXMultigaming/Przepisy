  "ingredients": [
    "1 pound bulk pork sausage",
    "8 large eggs",
    "2.5 cups milk",
    "1 teaspoon salt",
    "1 teaspoon ground mustard",
    "6 slices white bread, cut into 1/2-inch cubes",
    "1 cup shredded Cheddar cheese",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dZqOoVv5o7l8qE8OXunrjTy-C0U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-222595-SausageandEggCasserole-ddmfs-Step1-3x4-5875-03b1e72fa99d4bfc97190cabd348c3fc.jpg"
      ],
      "image": "assets/images/222595/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat and stir in sausage. Cook and stir until sausage is crumbly, evenly browned, and no longer pink, about 10 minutes. Drain and discard any excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qbwfo_mtIMJd_lroA3zdj40Zwzs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-222595-SausageandEggCasserole-ddmfs-Step2-3x4-5885-63db5d8503284b04aeedc09f7dca82c1.jpg"
      ],
      "image": "assets/images/222595/step_02.webp"
    },
    {
      "text": "Beat eggs in a large bowl; stir in milk, salt, and mustard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jjQL-b9Hd9vGFII-DAW-pauu3gk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-222595-SausageandEggCasserole-ddmfs-Step3-3x4-5893-530c2699c0834a4ca64e1781395802fa.jpg"
      ],
      "image": "assets/images/222595/step_03.webp"
    },
    {
      "text": "Fold bread cubes, Cheddar cheese, and sausage into the egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IIfqsoQrqt2GemshgUyaCfhrZD4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-222595-SausageandEggCasserole-ddmfs-Step4-3x4-5896-29c1a8f9be574bb4b0005468af353e9e.jpg"
      ],
      "image": "assets/images/222595/step_04.webp"
    },
    {
      "text": "Pour into a lightly greased 7x11-inch baking dish. Cover and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-RAUXjdUvvs6meTSLrlasy8JjBM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-222595-SausageandEggCasserole-ddmfs-Step5-3x4-5898-06ec099fc70f49d3812e6083988d9863.jpg"
      ],
      "image": "assets/images/222595/step_05.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Remove casserole from the refrigerator 30 minutes before baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted near the center comes out clean, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8nXTnhHvmUljP7yJ98qSmR5H4Wk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_222595-SausageandEggCasserole-ddmfs-step7-3x4-6028-9b11188d070b4530b5a79901a7edcdc6.jpg"
      ],
