  "ingredients": [
    "3 tablespoons fresh lemon juice",
    "1 tablespoon soy sauce",
    "1 tablespoon Dijon mustard",
    "2 cloves garlic, minced",
    "1 tablespoon brown sugar",
    "2 teaspoons curry paste",
    "1 pound medium shrimp - peeled and deveined"
  ],
  "steps": [
    {
      "text": "Combine lemon juice, soy sauce, mustard, garlic, brown sugar, and curry paste in a shallow dish or resealable bag. Add shrimp and turn to coat. Cover or seal and refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat. Lightly oil the grate. Thread shrimp onto skewers or place in a grill basket. Transfer marinade to a saucepan; bring to a boil and cook for 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill shrimp, turning once and basting occasionally with the boiled marinade, until opaque and cooked through, about 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
