  "ingredients": [
    "4 thick cod steaks (or other firm white fish)",
    "2 tablespoons oil",
    "4 teaspoons Maille® Dijon Originale mustard",
    "1 tablespoon finely chopped flat parsley"
  ],
  "steps": [
    {
      "text": "Trim fish, then season on both sides. Heat oil in a pan (which can be transferred to the oven.) Fry steaks on one side until crisp underneath. Using a pastry brush, paint Maille® Dijon Originale mustard over the top side of the cod.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in a pre-heated oven at 400 degrees F for around 5 minutes, depending on thickness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with chopped parsley and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
