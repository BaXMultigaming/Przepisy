  "ingredients": [
    "8 country style pork ribs",
    "1 cup honey",
    "1 cup ketchup",
    "2 tablespoons molasses",
    "1 (18 ounce) bottle barbeque sauce"
  ],
  "steps": [
    {
      "text": "Preheat grill for medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil grill grate. Grill ribs for 12 minutes, turning once during cooking. Transfer ribs to an 11x16 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). In a large bowl, stir together the honey, ketchup, molasses, and barbecue sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake ribs, uncovered, for 1 hour. Remove from the oven, and drain fat. Coat ribs with the honey sauce. Continue baking for another 1 1/2 hours, or until ribs are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
