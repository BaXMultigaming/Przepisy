  "title": "Date Orange Bread",
  "description": "The orange flavor in this date-nut bread is delicious! Orange juice and zest add a citrus accent to this quick-make bread, heavy with dates and nuts.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-08-31T16:11:26-04:00",
