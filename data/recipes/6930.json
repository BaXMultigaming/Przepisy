  "ingredients": [
    "1 large egg",
    "2 tablespoons butter, softened",
    "1 cup white sugar",
    "0.67 cup fresh orange juice",
    "0.33 cup boiling water",
    "3 tablespoons grated orange zest",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.75 teaspoon salt",
    "0.5 cup chopped walnuts",
    "1 cup dates, pitted and chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine orange juice, water, and orange zest in a liquid measuring cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg slightly in a bowl. Add butter and sugar; beat until smooth. Add orange juice mixture and stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, baking soda, and salt in a separate bowl. Stir in walnuts and dates. Pour into batter and stir to moisten. Spoon into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cool in the loaf pan for 10 minutes, then turn out onto a wire rack and finish cooling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
