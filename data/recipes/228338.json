  "ingredients": [
    "0.75 cup white sugar",
    "0.5 cup vinegar",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 cup extra-virgin olive oil",
    "1 bunch kale, stems removed and leaves chopped",
    "0.5 (16 ounce) package frozen shelled edamame (soybeans), thawed",
    "0.25 red onion, sliced thin",
    "1 cup shredded carrot",
    "0.66666668653488 cup fresh blueberries",
    "0.5 cup sweetened dried cranberries (such as Ocean Spray® Craisins®)",
    "0.5 cup cashew pieces",
    "0.5 cup shelled, roasted sunflower seeds"
  ],
  "steps": [
    {
      "text": "To make the dressing: Whisk sugar, vinegar, salt, pepper, and olive oil together in a bowl until well combined and sugar is dissolved. Set dressing aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss kale, edamame, red onion, carrot, blueberries, dried cranberries, cashew pieces, and sunflower seeds together in a bowl. Pour about half the dressing over the mixture and toss to coat. Cover bowl with plastic wrap and refrigerate 4 to 6 hours. Serve remaining dressing on side.",
      "section": null,
