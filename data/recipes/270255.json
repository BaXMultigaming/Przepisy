  "ingredients": [
    "cooking spray",
    "3 tablespoons water",
    "1 tablespoon flaxseed meal",
    "1 cup whole wheat flour",
    "1 cup finely ground steel-cut oats",
    "0.5 cup brown sugar",
    "0.5 teaspoon salt",
    "3 ripe bananas, mashed",
    "0.25 cup honey",
    "0.25 cup nonfat plain Greek yogurt",
    "1 egg, lightly whisked",
    "3 tablespoons applesauce",
    "3 tablespoons coconut oil",
    "1.5 teaspoons vanilla extract",
    "0.5 cup chocolate chips",
    "0.5 cup ground walnuts",
    "1 tablespoon cinnamon sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place a rack in the lower third of the oven. Spray a mini muffin pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water and flaxseed meal in a bowl and let sit 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk flour, oats, brown sugar, and salt together in a bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix thickened flaxseed, bananas, honey, yogurt, egg, applesauce, coconut oil, and vanilla extract together in a bowl. Stir flour mixture into the banana mixture. Fold in chocolate chips and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use an ice cream scooper to scoop batter into the prepared muffin tin. Sprinkle cinnamon sugar on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean but without overbaking, about 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let muffins cool in the pan for 5 minutes. Transfer to a wire rack to cool completely. Freeze if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
