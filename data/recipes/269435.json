  "ingredients": [
    "1 tablespoon olive oil",
    "2 ounces leeks, chopped",
    "1 bunch raw radish greens",
    "8 large eggs",
    "4 tablespoons grated Parmesan cheese",
    "2 tablespoons heavy whipping cream",
    "4 radishes, shredded"
  ],
  "steps": [
    {
      "text": "Heat oil in a large oven-safe skillet over medium heat. Add leeks; cook and stir until softened, 3 to 5 minutes. Add radish tops; cook until wilted, 3 to 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, Parmesan cheese, and cream together in a bowl; add to the skillet. Reduce heat to medium-low; cover the skillet and cook until edges are firm and begin to pull away from sides of the skillet, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated broiler until lightly brown on top, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rest for 10 minutes; top with shredded radishes. Serve warm or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
