  "ingredients": [
    "1 pound bulk pork sausage",
    "2 (8 ounce) packages refrigerated crescent rolls",
    "1 (8 ounce) package cream cheese, softened"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YNIdER5coBPEjkTWzwdVzpFiIrI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-231348-sausage-and-cream-cheese-pinwheels-VAT-step-01-56acef010f54489c80127416cc372eee.jpg"
      ],
      "image": "assets/images/231348/step_01.webp"
    },
    {
      "text": "Cook and stir sausage in a large skillet over medium-high heat until browned and crumbly, about 10 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vWUkQHiCX5qT6kdD11G0QMgsm6Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-231348-sausage-and-cream-cheese-pinwheels-VAT-step-02-19b08187765141a49c04ba4e76a63455.jpg"
      ],
      "image": "assets/images/231348/step_02.webp"
    },
    {
      "text": "Spread dough from one package crescent rolls out onto a work surface; pinch perforations together to create a single sheet of dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1TJLZPhMb8P4q1BkU__JaTUapk4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-231348-sausage-and-cream-cheese-pinwheels-VAT-step-03-07ddc0ac926346eaad27dd0a510b87f6.jpg"
      ],
      "image": "assets/images/231348/step_03.webp"
    },
    {
      "text": "Spread 1/2 of the cream cheese over dough, leaving a 1/2-inch margin on each edge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Iz1N3GnoRvHS8yjv73m4avijDg4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-231348-sausage-and-cream-cheese-pinwheels-VAT-step-04-699628167bee43c683c5f6c0d5413b7e.jpg"
      ],
      "image": "assets/images/231348/step_04.webp"
    },
    {
      "text": "Sprinkle 1/2 of the cooked sausage evenly over cream cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1CehN-HzD5ZM9GY1G8UxA_hFY2o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-231348-sausage-and-cream-cheese-pinwheels-VAT-step-05-0abee0b7848b498c9f7a943d1fe8379a.jpg"
      ],
      "image": "assets/images/231348/step_05.webp"
    },
    {
      "text": "Starting at a long edge, roll dough around filling into a log; wrap in plastic wrap or parchment paper. Repeat to make and wrap a second roll. Refrigerate rolls until firm, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P0dhIye5hQkixIFkcPBn-gD3mHE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-231348-sausage-and-cream-cheese-pinwheels-VAT-step-06-8f3a19118ee243c58cb1275e6ed5eac3.jpg"
      ],
      "image": "assets/images/231348/step_06.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Remove rolls from the refrigerator and unwrap. Cut rolls into 1/2-inch-thick slices and place onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hZ2z43wAz4953uECsnXpBAo312U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-231348-sausage-and-cream-cheese-pinwheels-VAT-step-07-1ece85f52de142a0b042099be9a9bab6.jpg"
      ],
      "image": "assets/images/231348/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oubGDCeH1FRROQhrPhc7x0zKnu4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-231348-sausage-and-cream-cheese-pinwheels-VAT-step-08-738d218a04ca4f3aacb9facb2faf4a36.jpg"
      ],
      "image": "assets/images/231348/step_08.webp"
    }
  ],
