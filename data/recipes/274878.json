  "ingredients": [
    "0.25 cup soy sauce",
    "0.25 cup fish sauce",
    "3 tablespoons brown sugar",
    "2 tablespoons chopped cilantro",
    "1 tablespoon sesame oil",
    "1 tablespoon minced fresh ginger root",
    "1 tablespoon Sriracha sauce",
    "1 tablespoon minced garlic",
    "1 tablespoon lime juice",
    "1 teaspoon lemongrass paste (such as Gourmet Garden®)",
    "2 pounds boneless, skinless chicken thighs"
  ],
  "steps": [
    {
      "text": "Whisk soy sauce, fish sauce, brown sugar, cilantro, sesame oil, ginger, Sriracha, garlic, lime juice, and lemongrass paste together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put chicken thighs in a resealable plastic bag, pour marinade over chicken and marinate for 2 hours or overnight for an even better flavor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill to medium-high heat and oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken thighs from marinade, discarding marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill chicken thighs until they are no longer pink in the center and juices run clear, about 3 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from grill and allow to rest for a few minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
