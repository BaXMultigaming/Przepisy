  "ingredients": [
    "0.5 cup white sugar",
    "0.33333334326744 cup unsweetened cocoa powder",
    "0.125 teaspoon ground cinnamon",
    "1 pinch salt",
    "0.33333334326744 cup boiling water",
    "3 cups milk",
    "1 cup half-and-half, divided",
    "0.75 teaspoon vanilla extract",
    "8 large marshmallows"
  ],
  "steps": [
    {
      "text": "Whisk together sugar, cocoa powder, cinnamon, and salt in a saucepan; stir in boiling water. Whisk until sugar is dissolved.",
