  "ingredients": [
    "2 teaspoons smoked paprika",
    "2 teaspoons onion powder",
    "2 teaspoons kosher salt",
    "1 teaspoon garlic powder",
    "1 teaspoon ground ancho chile powder",
    "1 teaspoon ground black pepper",
    "1 (4 pound) boneless pork shoulder",
    "0.5 cup chicken broth",
    "1 teaspoon liquid smoke flavoring",
    "0.5 cup keto barbecue sauce"
  ],
  "steps": [
    {
      "text": "Combine smoked paprika, onion powder, salt, garlic powder, chile powder, and black pepper in a small bowl. Rub spice mixture all over the surface of the pork shoulder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place seasoned pork in a slow cooker. Add broth and liquid smoke.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until pork is cooked through, 7 to 8 hours. Remove pork from slow cooker and shred.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour liquid from the slow cooker in a 2-quart saucepan, add barbecue sauce, and bring to a boil, stirring constantly, over medium-high heat. Cook until liquid has reduced to about 1/2 cup, 7 to 8 minutes. Pour over shredded pork and mix to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
