  "steps": [
    {
      "text": "Preheat a mini waffle iron (such as Dash) and spray with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 3/4 cup plus 1 tablespoon water into a large bowl. Stir in flour, sugar, vanilla, and salt to make a batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream in a chilled glass or metal bowl with an electric mixer until soft peaks form. Fold into the batter, being careful not to overmix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle a couple of tablespoons of batter onto the preheated iron and cook until golden brown, 3 to 5 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
