  "ingredients": [
    "4 medium Yukon Gold potatoes",
    "3 tablespoons melted butter",
    "1 tablespoon olive oil",
    "3 cloves garlic, crushed",
    "0.5 teaspoon ground paprika",
    "salt and ground black pepper to taste",
    "1 tablespoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C) and gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tCuWdtWGk-Oho1mcWrL4LS0hXL8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277077-air-fryer-hasselback-potatoes-step-1-0983-d816750182bd4d9294f09100a67bc831.jpg"
      ],
      "image": "assets/images/277077/step_01.webp"
    },
    {
      "text": "Cut 1/4-inch slices into each potato, making sure the knife only cuts through to the bottom 1/2-inch, keeping the bottom of potato intact. Combine butter, olive oil, garlic, and paprika in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mxpPpwzC1oVvI4ZS9plmj6tAlro=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277077-air-fryer-hasselback-potatoes-step-2-0986-f8f6be681ea04400bb7acf704a5b00f7.jpg"
      ],
      "image": "assets/images/277077/step_02.webp"
    },
    {
      "text": "Brush some of the mixture over each potato and into the slits. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yspQ9obQyHETFaai0qAxSp84Dq4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277077-air-fryer-hasselback-potatoes-step-3-0987-40a8fea8d4444a42a5833ff6a88db346.jpg"
      ],
      "image": "assets/images/277077/step_03.webp"
    },
    {
      "text": "Place potatoes in the basket and cook in the preheated air fryer for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Pp1Y8VOTYsDHB-0DYgT0Q_w4TYM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277077-air-fryer-hasselback-potatoes-step-4-0988-2b532d9fe76b4fa79cbe946256c51e02.jpg"
      ],
      "image": "assets/images/277077/step_04.webp"
    },
    {
      "text": "Brush potatoes with butter mixture, making sure it drips down the fanned-out slices to ensure potatoes will not be dry. Cook until potatoes are cooked through, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OwyASRuHLTU5XgCilWEo-U9sGSc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277077-air-fryer-hasselback-potatoes-step-5-1022-28358905056c4d078e212b7e3f11ab71.jpg"
      ],
      "image": "assets/images/277077/step_05.webp"
    },
    {
      "text": "Remove potatoes from the basket and brush with any remaining butter mixture. Sprinkle with chopped parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JVcs7iEzdLV3RMlJjukUIAqG1LM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277077-air-fryer-hasselback-potatoes-DDMFS-4x3-a1ca938351bc43b4b78d08b25672133b.jpg"
      ],
      "image": "assets/images/277077/step_06.webp"
    }
