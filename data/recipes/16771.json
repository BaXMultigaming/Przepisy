  "ingredients": [
    "6 potatoes, thinly sliced",
    "1 small onion, chopped",
    "0.25 cup chopped green bell pepper",
    "salt and pepper to taste",
    "0.25 cup butter or margarine",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat grill for medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat one side of a piece of aluminum foil large enough to hold all the potatoes and vegetables with cooking spray. Place the potatoes, onion, and green bell pepper in the center of the foil, and season with salt and pepper to taste. Then place small pats of the butter or margarine over the vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully seal all the edges of the foil around the vegetables to form a packet. (Note: Double wrapping will help to prevent burning.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place packet on the preheated grill, and grill for 20 minutes. Turn packet, and grill for 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully open packet, check for tenderness with a fork. If tender, sprinkle the cheese over the vegetables and allow it to melt. Transfer to a platter, and serve with your main entree.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
