  "ingredients": [
    "2 tablespoons soy sauce",
    "4 teaspoons sesame oil",
    "4 cloves garlic, minced, divided",
    "4 cups cooked diced chicken breast",
    "3 (8 ounce) packages reduced-fat cream cheese",
    "1 cup chopped fresh cilantro, divided",
    "0.5 teaspoon salt",
    "0.5 cup salted peanuts, chopped",
    "8 medium green onions, thinly sliced",
    "1 teaspoon sweet chile sauce"
  ],
  "steps": [
    {
      "text": "Combine soy sauce, sesame oil, and 2 cloves of garlic in a large bowl. Add cooked chicken and toss to coat. Refrigerate and marinate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, 1/4 cup cilantro, remaining garlic, and salt in another bowl; beat with an electric mixer until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread dip onto a large serving platter and top with marinated chicken. Sprinkle chicken with peanuts, green onions, and remaining cilantro, and drizzle sweet chile sauce over top. Cover and refrigerate for at least 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
