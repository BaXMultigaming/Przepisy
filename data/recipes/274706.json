  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 tablespoon baking soda",
    "0.5 tablespoon pumpkin pie spice, or more to taste",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking powder",
    "0.33333334326744 cup raisins",
    "0.33333334326744 cup chopped pecans",
    "1 cup white sugar",
    "0.25 cup butter",
    "1 cup pumpkin puree",
    "3 eggs",
    "0.25 cup orange juice",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, pumpkin pie spice, salt, and baking soda together in a large bowl. Toss raisins and pecans with 1 tablespoon flour mixture in a separate bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until fluffy. Add pumpkin purée, eggs, orange juice, and vanilla extract; beat until well combined. Slowly add flour mixture; blend thoroughly. Fold in raisins and pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter evenly between the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm and tops spring back when lightly pressed, 30 to 40 minutes. Cool completely on wire racks before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
