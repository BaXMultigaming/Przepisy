  "ingredients": [
    "1 pound young carrots, preferably with their green tops",
    "3 tablespoons olive oil",
    "2 tablespoons orange juice",
    "1 tablespoon cumin seeds",
    "sea salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrub carrots and peel, if desired. Place carrots on a piece of parchment paper large enough to create a packet.",
