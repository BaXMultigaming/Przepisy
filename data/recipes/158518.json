  "ingredients": [
    "4 beef ribs, trimmed from a cooked prime rib roast",
    "2 cups beef stock",
    "1 potato, peeled and cut into 3/4 inch pieces",
    "1 large carrot",
    "1 (8 ounce) package sliced fresh mushrooms",
    "1 teaspoon salt",
    "1 teaspoon black pepper",
    "0.25 cup chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gPvDPGpX97TRbTej9i5gjxUlEOw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/158518-prime-rib-soup-DDMFS-step-1-BG-1247-841525e630844a75a6742372c0919c00.jpg"
      ],
      "image": "assets/images/158518/step_01.webp"
    },
    {
      "text": "Place ribs in a large pot and cover with water. Bring to a boil; reduce heat to medium-low, cover, and simmer until the meat is falling from the bones, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pWavhrAL0YCuQpAv9Ff7Jtnn3PI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/158518-prime-rib-soup-DDMFS-step-2-BG-1261-7c0be219f3c5440ba9097ca7741c9202.jpg"
      ],
      "image": "assets/images/158518/step_02.webp"
    },
    {
      "text": "Remove ribs and allow to cool. Trim the meat from the ribs and cut into bite-sized pieces; refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OJxZh2jmzvtxZRKSYGhpIXkc9CY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/158518-prime-rib-soup-DDMFS-step-3-BG-1342-8f1c7d1e8fe6462bbba6df92bcbbf85e.jpg"
      ],
      "image": "assets/images/158518/step_03.webp"
    },
    {
      "text": "Continue simmering broth until reduced to 1 cup; refrigerate until the fat congeals to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h6h70gZ9MUEjHu-LrIG0QM4J82w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/158518-prime-rib-soup-DDMFS-step-4-BG-1349-908359a5b17e489f820bf49cc144d274.jpg"
      ],
      "image": "assets/images/158518/step_04.webp"
    },
    {
      "text": "Skim and discard congealed fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TMkPuT3-fihspe35iOPPaV_VQ0E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/158518-prime-rib-soup-DDMFS-step-5-BG-1366-b156eabe0b7e4bbdb9f3a51ee9864be9.jpg"
      ],
      "image": "assets/images/158518/step_05.webp"
    },
    {
      "text": "Pour broth into a saucepan along with meat trimmings, beef stock, potato, carrots, mushrooms, salt, and pepper. Bring to a boil; reduce heat to medium-low, cover, and simmer until potatoes are tender, about 20 minutes. Sprinkle with chives to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q9CF31yNbvsqoKca5eHAnSG0-48=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/158518-prime-rib-soup-DDMFS-step-6-BG-1363-18b8c27abf73403395f437c9b62d3250.jpg"
      ],
      "image": "assets/images/158518/step_06.webp"
