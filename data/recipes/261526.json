  "ingredients": [
    "canola oil for frying",
    "2 cups Italian seasoned bread crumbs",
    "2 cups all-purpose flour",
    "0.75 cup grated Parmesan cheese, divided",
    "3 large eggs, beaten",
    "1 eggplant, peeled and sliced",
    "1 (13.5 ounce) jar roasted garlic flavored spaghetti sauce (such as Ragu® Roasted Garlic Pasta Sauce)",
    "0.5 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Heat canola oil to 350 degrees F (175 degrees C) in a large saucepan over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs, flour, and 1/2 cup Parmesan cheese together in a bowl. Place eggs in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip eggplant slices in the eggs, then the bread crumb mixture. Drop into oil a few slices at a time until breading turns golden brown, about 2 1/2 minutes. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat spaghetti sauce in a saucepan over medium heat until heated through, about 10 minutes. Stir in remaining 1/4 cup Parmesan cheese and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
