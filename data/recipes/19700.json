  "ingredients": [
    "2 pounds pepperjack cheese",
    "2 cups half-and-half cream",
    "1 large tomato, diced",
    "1 onion, diced",
    "0.5 cup diced red bell pepper",
    "3 cups spinach, rinsed and chopped"
  ],
  "steps": [
    {
      "text": "Over a double boiler slowly melt the pepperjack cheese. When the cheese is melted whisk in half and half until smooth and creamy. Stir in tomato, onion, red bell pepper and chopped spinach. Transfer to a serving bowl. Serve warm with tortilla chips or bread.",
