  "ingredients": [
    "1 (1 ounce) square unsweetened chocolate, chopped",
    "0.5 cup shortening",
    "0.75 cup white sugar",
    "2 eggs",
    "0.5 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.5 cup chocolate malt powder",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "2 tablespoons butter",
    "0.25 cup chocolate malt powder",
    "1 pinch salt",
    "1 cup confectioners' sugar",
    "1.5 tablespoons heavy cream"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8x8 inch baking pan. In a bowl over a pan of simmering water, or in the microwave, melt the unsweetened chocolate, stirring occasionally until smooth. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the shortening and white sugar until light and fluffy. Beat in the eggs, one at a time then stir in the vanilla. Mix in the melted chocolate Combine the flour, 1/2 cup chocolate malt powder, baking powder and salt; stir into the chocolate mixture. Spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 to 25 minutes in the preheated oven, until set. Let bars cool in the pan before frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make frosting, cream together the butter, 1/4 cup of malt powder and salt. Gradually beat in the confectioners' sugar and heavy cream until smooth and spreadable. Spread over cooled bars before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
