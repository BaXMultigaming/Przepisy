  "ingredients": [
    "2 tablespoons olive oil",
    "2 teaspoons ground cumin",
    "2 teaspoons salt",
    "1 teaspoon freshly ground black pepper",
    "1 teaspoon dried Italian herb seasoning",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground coriander",
    "1 teaspoon paprika",
    "4 pounds lamb breast, separated in two pieces",
    "aluminum foil",
    "0.5 cup chopped Italian flat leaf parsley",
    "0.33333334326744 cup white wine vinegar, more as needed",
    "1 lemon, juiced",
    "2 cloves garlic, crushed",
    "1 teaspoon honey",
    "0.5 teaspoon red pepper flakes",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, cumin, salt, black pepper, Italian herb seasoning, cinnamon, coriander, and paprika in a large bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat lamb breasts in spice mixture, then place fat-side-up in a roasting pan. Tightly cover the roasting pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until meat is tender when pierced with a fork, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine chopped parsley, vinegar, fresh lemon juice, garlic, honey, red pepper flakes, and salt in a bowl. Mix well and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SSOWKqOQTlxZc96ZmlofFB7Oez8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221996-RoastedLambBreast-ddms-4x3-step2-8799614ca3214eb4ab257f88a57308bf.jpg"
      ],
      "image": "assets/images/221996/step_05.webp"
    },
    {
      "text": "Remove meat from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase oven temperature to 450 degrees F (230 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove lamb from the roasting pan and cut into 4 pieces. Place lamb pieces on the prepared baking sheet. Brush tops with fat drippings from the roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until meat is browned and edges are crispy, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn the oven broiler to high and brown meat until top is golden brown, about 4 minutes. Serve lamb topped with parsley-vinegar sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5vWU-JZPfKJqclNhMK6cjz0zcmw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221996-roasted-lamb-breast-ddmfs-3X4-0454-9c45349c869d4544a1e9bb8bcdaad641.jpg"
      ],
      "image": "assets/images/221996/step_10.webp"
    }
  ],
