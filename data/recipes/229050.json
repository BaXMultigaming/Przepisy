  "ingredients": [
    "3 teaspoons butter",
    "3 ears fresh corn, husks and silks removed",
    "1 teaspoon garlic powder",
    "1 (15 ounce) can black beans, drained",
    "0.25 cup chopped fresh cilantro",
    "0.25 cup olive oil",
    "2 tablespoons red wine vinegar",
    "2 tablespoons lime juice",
    "1.5 teaspoons minced garlic",
    "1 teaspoon white sugar",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon chili powder",
    "0.25 teaspoon salt",
    "0.25 teaspoon black pepper"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1 teaspoon butter on each ear corn; sprinkle with garlic powder. Wrap ears in aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until corn is hot and steaming, about 15 minutes. Unwrap corn; grill ears until kernels are golden, about 5 minutes more, flipping once. Cool; cut kernels from cobs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine corn, black beans, and cilantro in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, vinegar, lime juice, fresh garlic, sugar, cumin, chili powder, salt, and black pepper together in a bowl; gently toss into corn mixture to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
