  "title": "Zucchini Bundt Cake",
  "description": "This zucchini Bundt cake recipe is made with grated zucchini and pineapple for a moist cake. Finish with a white glaze for a beautiful presentation.",
  "authors": [
    "Geri Knoll"
  ],
  "date_published": "1998-06-15T18:09:56-04:00",
