  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons ground cinnamon",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 cups white sugar",
    "4 eggs",
    "1 cup vegetable oil",
    "2 cups grated zucchini",
    "1 cup chopped walnuts",
    "1 (8 ounce) can crushed pineapple, drained",
    "2 teaspoons vanilla extract",
    "1 cup confectioners' sugar",
    "2 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a Bundt or tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cinnamon, baking powder, baking soda, and salt together onto a piece of waxed paper. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar and eggs together in a large bowl with an electric mixer until light colored; beat in oil. Add flour mixture; beat for 2 minutes. Stir in zucchini, walnuts, pineapple, and vanilla; mix thoroughly. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour 20 minutes. Cool in the pan for 30 minutes before inverting onto a plate, then cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk confectioners' sugar and milk together in a small bowl until smooth and runny; pour over cooled cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
