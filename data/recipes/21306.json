  "ingredients": [
    "2 rainbow trout fillets",
    "1 tablespoon olive oil",
    "2 teaspoons garlic salt",
    "1 teaspoon ground black pepper",
    "2 sheets heavy-duty aluminum foil",
    "1 fresh jalapeno pepper, sliced",
    "1 lemon, sliced"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-SK8L2UDTWmqAV-Q1EYk4fRXgz4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-21306-fish-in-foil-ddmfs-Step-1-726297ed061c43e3897ef7c4d5e6904c.jpg"
      ],
      "image": "assets/images/21306/step_01.webp"
    },
    {
      "text": "Rinse and pat fillets dry. Rub fillets with olive oil, and season with garlic salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JnfL-0EmB_6aKfrr0ZmCLtWLSmQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-21306-fish-in-foil-ddmfs-Step-2-6d40c3d6c8f04be7b80e7c21789e65c4.jpg"
      ],
      "image": "assets/images/21306/step_02.webp"
    },
    {
      "text": "Place each fillet on a large sheet of aluminum foil. Top with jalapeno slices, and squeeze the juice from the ends of the lemon over fillets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NGo697znXMan-Drul-CpU4QD5z0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-21306-fish-in-foil-ddmfs-Step-3-c45b79cd3215414e9c59a54da0d0cbb2.jpg"
      ],
      "image": "assets/images/21306/step_03.webp"
    },
    {
      "text": "Arrange remaining lemon slices on top of fillets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pS77DGD722zzRd6TSi4FgYysZGA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-21306-fish-in-foil-ddmfs-Step-4-b10f74b766f945f5b991546d6ec1f557.jpg"
      ],
      "image": "assets/images/21306/step_04.webp"
    },
    {
      "text": "Carefully seal all edges of the foil to form enclosed packets. Place packets on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/abAySsrApvjhEMmkA3r81e9oC4s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-21306-fish-in-foil-ddmfs-Step-5-ffaeb8eb315e44a08996b0345713ea82.jpg"
      ],
      "image": "assets/images/21306/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 15 to 20 minutes depending on size of fillets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Qx3fTgqy-nvUP8FHGOIEMe4qmj0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-21306-fish-in-foil-ddmfs-4x3-3fea5bf84c9b404f9c64506f996d8ee8.jpg"
