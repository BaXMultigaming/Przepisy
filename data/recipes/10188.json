  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together brown sugar, 1/2 cup butter or margarine, egg, buttermilk, and 1 teaspoon of root beer extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour, baking soda, and salt; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop teaspoon-sized pieces of dough 2 inches apart on greased cookie sheets. Bake for 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make root beer glaze: Mix together confectioner's sugar, 1/3 cup butter or margarine, 1 1/2 teaspoons of root beer extract, and hot water. Brush on top of hot cookies.",
