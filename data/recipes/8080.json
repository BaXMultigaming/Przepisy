  "ingredients": [
    "1 (14.75 ounce) can cream-style corn",
    "0.5 cup packed brown sugar",
    "0.75 cup white sugar",
    "3 eggs",
    "1 cup vegetable oil",
    "1 tablespoon baking powder",
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Stir together flour, baking powder, baking soda, cinnamon, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, combine corn and sugars. Beat in eggs and oil till well blended. Mix flour mixture into batter. Stir in raisins and nuts. Pour batter into greased 9 x 13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 30 to 35 minutes, or till cake tests done. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
