  "ingredients": [
    "2 eggs, beaten",
    "4 cups milk",
    "0.5 cup white sugar",
    "0.5 cup uncooked white rice",
    "1 tablespoon butter",
    "1 teaspoon vanilla extract",
    "0.5 cup raisins",
    "0.125 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C). Grease a 2 quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together the eggs and milk. Stir in white sugar, uncooked rice, butter, vanilla extract, raisins, and nutmeg. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 2 to 2 1/2 hours in the preheated oven. Stir frequently during the first hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
