  "ingredients": [
    "0.25 cup olive oil",
    "0.25 cup red wine vinegar",
    "1 tablespoon chopped fresh oregano",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 pound extra-large shrimp, peeled and deveined",
    "1 medium zucchini, cut into 1-inch pieces",
    "1 cup diced red onion",
    "0.25 cup tahini",
    "2 tablespoons lemon juice",
    "2 teaspoons maple syrup",
    "1 clove garlic, minced",
    "3 tablespoons water",
    "3 cups warm cooked farro",
    "2 cups cherry tomatoes, halved",
    "2 tablespoons chopped fresh mint",
    "1 medium lemon, cut into wedges"
  ],
  "steps": [
    {
      "text": "Whisk oil, vinegar, oregano, salt, and pepper together in a large bowl. Add shrimp, zucchini, and onion; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thread shrimp and vegetables onto eight 8-inch skewers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill to medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, for dressing, whisk tahini, lemon juice, maple syrup, and garlic together in a small bowl. Slowly add the water, whisking constantly until smooth and drizzling consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill skewers, covered, turning once halfway through, until shrimp are opaque and vegetables are crisp-tender, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide farro among 4 bowls. Top with shrimp and vegetables, tomatoes, and mint. Drizzle with dressing. Serve with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
