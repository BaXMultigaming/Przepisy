  "ingredients": [
    "1 green plantain",
    "5 tablespoons oil for frying",
    "3 cups cold water",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
