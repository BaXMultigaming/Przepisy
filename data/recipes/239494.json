  "ingredients": [
    "1 (15 ounce) can black-eyed peas, undrained",
    "1 (14 ounce) can coconut milk",
    "0.5 (12 ounce) package frozen corn",
    "1 (5.5 ounce) can tomato paste",
    "2 tablespoons Jamaican-style curry powder",
    "1 tablespoon white sugar",
    "0.75 teaspoon salt, or to taste",
    "4 cups water, or as needed",
    "1.75 cups basmati rice",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Mix black-eyed peas, coconut milk, corn, tomato paste, curry powder, sugar, and 3/4 teaspoon salt in a pot until smooth and evenly combined; simmer over medium-low heat, stirring often, until curry sauce is heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour enough water into a separate pot to almost fill and bring to a boil; season with a pinch of salt. Add rice to boiling water and cook, stirring occasionally, until rice is very soft, about 15 minutes. Drain excess water from rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix rice and curry sauce together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
