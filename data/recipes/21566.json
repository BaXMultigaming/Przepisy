  "ingredients": [
    "4 cups water",
    "4 cups quick cooking oats",
    "0.5 onion, chopped",
    "0.5 cup spaghetti sauce",
    "0.5 cup chopped pecans",
    "0.33300000429153 cup vegetable oil",
    "0.25 cup nutritional yeast",
    "2 teaspoons garlic powder",
    "2 teaspoons onion powder",
    "1 teaspoon dried basil",
    "1 teaspoon ground coriander",
    "1 teaspoon sage",
    "1 teaspoon active dry yeast"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water to a boil in a large pot. Stir in oatmeal. Cover, reduce heat to low, and cook until oats are tender and water is absorbed, 5 to 10 minutes. Remove from heat and let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion, spaghetti sauce, pecans, oil, nutritional yeast, garlic powder, onion powder, basil, coriander, sage, and active yeast to oatmeal in the pot; mix well. Form into patties and place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Turn patties over and bake for 15 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
