  "ingredients": [
    "10 ounces boneless, skinless chicken thighs, trimmed of fat and diced into 1/4-inch cubes",
    "0.5 cup Italian-seasoned bread crumbs",
    "0.25 cup chopped onion",
    "0.25 cup shredded mozzarella cheese",
    "1 egg",
    "0.25 cup mayonnaise",
    "0.5 teaspoon salt",
    "0.25 teaspoon black pepper",
    "0.25 teaspoon garlic powder",
    "2 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Mix chicken, bread crumbs, onion, mozzarella cheese, egg, mayonnaise, salt, pepper, and garlic powder in a bowl until well combined. Shape mixture into 8 equal-sized patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet. Fry patties until lightly browned, about 5 minutes. Flip and fry for an additional 3 to 5 minutes. Transfer fritters to a paper towel-lined plate.",
