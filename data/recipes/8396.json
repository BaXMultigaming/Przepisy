  "ingredients": [
    "2 cups white sugar",
    "3 cups all-purpose flour",
    "2 teaspoons baking soda",
    "0.5 teaspoon salt",
    "0.5 cup unsweetened cocoa powder",
    "2 cups water",
    "1 cup vegetable oil",
    "2 tablespoons distilled white vinegar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, flour, baking soda, salt, and cocoa together in a large bowl. Add water, oil, vinegar, and vanilla; whisk by hand until smooth. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 40 minutes.",
