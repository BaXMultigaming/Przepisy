  "ingredients": [
    "2 (16 ounce) packages Brussels sprouts",
    "1 tablespoon olive oil",
    "1 teaspoon smoked paprika",
    "0.25 teaspoon sea salt",
    "0.25 cup heavy whipping cream",
    "3 tablespoons grated Parmesan cheese",
    "3 tablespoons olive oil",
    "1 lemon, zested and juiced",
    "1 tablespoon red wine vinegar",
    "2 cloves garlic, minced",
    "1 teaspoon brown mustard",
    "1 teaspoon smoked paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Trim stems off Brussels sprouts. Quarter large sprouts lengthwise; halve small ones. Rinse and dry thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss sprouts in a bowl with olive oil and paprika. Spread out on a baking sheet and sprinkle with sea salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes, removing loose leaves after 5 minutes and turning whole sprouts every 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make dressing: Whisk together heavy cream, Parmesan cheese, olive oil, lemon zest and juice, red wine vinegar, garlic, brown mustard, and paprika in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer whole sprouts and loose leaves to a serving bowl; pour in dressing and toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
