  "ingredients": [
    "2 tablespoons brown rice",
    "4 cups water",
    "4 teaspoons green tea leaves"
  ],
  "steps": [
    {
      "text": "Put rice in a small skillet and toast over medium-low heat until it turns dark in spots. Move to a small saucepan. Pour in water and bring to a boil. Immediately reduce heat to low; cover and simmer 1 minute. Remove from heat and allow to steep 3 minutes more. Add tea and let it steep another 3 minutes. Strain and discard rice and tea leaves from liquid. Serve tea hot.",
