  "ingredients": [
    "1 (16 ounce) package frozen peas",
    "1 (1 pound) package smoked sausage, cut into 1/2-inch pieces",
    "1 (15 ounce) can yellow corn, drained",
    "1 (12 ounce) bottle chili sauce",
    "0.25 cup finely chopped onion",
    "1 tablespoon dried basil",
    "0.25 teaspoon ground black pepper",
    "2 cups shredded Cheddar cheese, divided"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a pot of water to boil; cook peas in the boiling water until cooked through, about 5 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix peas, sausage, corn, chili sauce, onion, basil, black pepper, and 1 3/4 cup Cheddar cheese together in a 3-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until casserole is bubbling, 30 to 40 minutes. Sprinkle remaining 1/4 cup Cheddar cheese over casserole and bake until cheese is melted, about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
