  "title": "Drunken Mussels",
  "description": "This mussels recipe from Chef John cooks the mussels in a delicious broth made with white wine, garlic, and lemon for one of the easiest shellfish recipes ever.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-06-06T16:22:07-04:00",
