  "ingredients": [
    "4 cups sliced yellow squash",
    "0.5 cup chopped onion",
    "0.25 cup water, or more as needed",
    "35 buttery round crackers, crushed",
    "1 cup shredded Cheddar cheese",
    "2 eggs, beaten",
    "0.75 cup milk",
    "0.25 cup butter, melted",
    "1 teaspoon salt",
    "ground black pepper to taste",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a 9x13-inch casserole dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iCdFhDkkCJz6gwTtetgHZUt_PBM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18045-Yellow-Squash-Casserole-mfs-Step-1-4x3-a8334056b59043afb48ee58edc592bca.jpg"
      ],
      "image": "assets/images/18045/step_01.webp"
    },
    {
      "text": "Place squash, onion, and water in a large skillet over medium heat. Cover and cook until squash is tender, about 5 minutes. Drain well and transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q9ghKkxI13zfFnDLnk3M97oOHYM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18045-Yellow-Squash-Casserole-mfs-Step-2-4x3-91ab2e00b0994469b8560427765a2c0d.jpg"
      ],
      "image": "assets/images/18045/step_02.webp"
    },
    {
      "text": "Mix cracker crumbs and cheese together in a separate bowl. Stir half of the cracker mixture into cooked squash mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g4esPh8TciNxaNmb51vh9wYevw4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18045-Yellow-Squash-Casserole-mfs-Step-4-4x3-c42d9a5e9cb841e9bfa3dc06bf14c1f7.jpg"
      ],
      "image": "assets/images/18045/step_03.webp"
    },
    {
      "text": "Mix eggs and milk together in a small bowl, then add to squash mixture; stir in 1/4 cup melted butter, and season with salt and pepper. Spread mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g2i1ZysmnXS18p-qA7rOIm9tn5w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18045-Yellow-Squash-Casserole-mfs-Step-8-4x3-7aa7a95a46954d3991213e5721b6961d.jpg"
      ],
      "image": "assets/images/18045/step_04.webp"
    },
    {
      "text": "Sprinkle with remaining cracker mixture, and dot with 2 tablespoons butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s2lxeMuF_PJfcLSNBlv7eQHItF0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18045-Yellow-Squash-Casserole-mfs-Step-10-4x3-d99e8ff82ba54265b4e7a054061df02a.jpg"
      ],
      "image": "assets/images/18045/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown on top and set, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NsssoyGVRA5eTItBy54U0702__s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18045-Yellow-Squash-Casserole-mfs-Step-11-4x3-b5482f3e98724ae1a9b31ae1b03b681b.jpg"
      ],
      "image": "assets/images/18045/step_06.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d9ml_xvhLPX7GvGsjGcxVn5Fyn0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-18045-yellow-squash-casserole-hero-4x3-ef601d03ba58480180a7e54d9c7b67a9.jpg"
