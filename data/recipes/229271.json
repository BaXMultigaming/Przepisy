  "ingredients": [
    "1 tablespoon vegetable oil",
    "0.5 cup chopped fatty ham scraps",
    "4 (1/4 inch thick) slices ham",
    "salt and freshly ground black pepper to taste",
    "0.125 teaspoon cayenne pepper, or to taste",
    "1 teaspoon all-purpose flour",
    "0.66666668653488 cup brewed coffee"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9kc45idNLkmoTVYiS56FIGTrZdI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229271-ham-with-red-eye-gravy-DDMFS-138-step-01-5ccefd4d386b4e3c9a613fb2633fae0a.jpg"
      ],
      "image": "assets/images/229271/step_01.webp"
    },
    {
      "text": "Heat oil in a medium skillet over medium heat. Cook and stir ham scraps until browned, about 5 minutes. Remove to a plate, reserving the grease in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xYz48mviAHIRof8WKFqL1fArIQ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229271-ham-with-red-eye-gravy-DDMFS-139-step-02-d8dbe771201f47eb8fda03f0b655cca4.jpg"
      ],
      "image": "assets/images/229271/step_02.webp"
    },
    {
      "text": "Place ham slices in the pan and cook over medium heat until browned, about 5 minutes on each side. Season both sides with salt, black pepper, and cayenne pepper. Remove ham and reserve on a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nHTzmLUULZUVZnpa_T26xBaEXDY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229271-ham-with-red-eye-gravy-DDMFS-140-step-03-f5a702b6524048f6a1bab7608d97d69b.jpg"
      ],
      "image": "assets/images/229271/step_03.webp"
    },
    {
      "text": "Reduce heat to medium-low and sprinkle flour over the pan drippings. Cook and stir for 2 minutes. Increase heat to medium-high and pour coffee into the pan. Cook and stir until combined and thickened. Season to taste. Return ham to the pan to warm through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XMH8CU5k1563PjYf3YtdYfplp5c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229271-ham-with-red-eye-gravy-DDMFS-164-step-04-2b37a7f7ee5a48b2a216f9e4b306825b.jpg"
      ],
      "image": "assets/images/229271/step_04.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
