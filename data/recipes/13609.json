  "ingredients": [
    "2 pounds crookneck yellow squash, sliced",
    "1 small onion, chopped",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1 (8 ounce) container sour cream",
    "0.25 cup butter, melted",
    "1.5 cups bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place squash and onion in a large saucepan with just enough water to cover. Bring to a boil over medium heat, and cook until tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the squash, onion, and remaining liquid from the saucepan to a 2 1/2 quart casserole dish. Stir in chicken soup, sour cream, and melted butter. The liquid from cooked squash should be enough to make the mixture is slightly soupy. Sprinkle bread crumbs overtop. The bread will absorb some of the liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, for 30 to 45 minutes in the preheated oven, until browned and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
