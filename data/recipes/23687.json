  "ingredients": [
    "2.5 pounds yellow squash, sliced",
    "1 pound Monterey Jack cheese, shredded",
    "4 eggs",
    "0.5 cup milk",
    "1 (4 ounce) can chopped green chile peppers",
    "3 tablespoons all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1.25 cups coarsely crushed corn chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of salted water to a boil. Add squash; cook until tender yet still firm, about 15 minutes. Drain. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cheese, eggs, milk, chiles, flour, baking powder, and salt in a large bowl; mix well. Fold in squash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle ½ crushed corn chips into the prepared dish; spoon squash mixture on top and cover with remaining ½ crushed corn chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
