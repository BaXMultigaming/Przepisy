  "ingredients": [
    "6 Eggland's Best Eggs, hard cooked and peeled",
    "3 tablespoons fresh salsa or chunky salsa, drained, if necessary",
    "1 tablespoon sour cream",
    "2 teaspoons fresh salsa",
    "1 teaspoon Chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Cut eggs in half lengthwise. Remove egg yolks; place yolks into bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash yolks with fork. Add 3 tablespoons salsa and sour cream; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon about 1 tablespoon egg yolk mixture into each egg white half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top each with about 1/2 teaspoon salsa and garnish with cilantro, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate until serving time or up to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
