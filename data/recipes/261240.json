  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "2 cups shredded Monterey Jack cheese",
    "1 pound bacon strips, cooked and crumbled",
    "0.75 cup salsa verde (green salsa)",
    "2 tablespoons chopped green onion",
    "2 tablespoons chopped canned jalapeno peppers"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cream cheese and Monterey Jack cheese in top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until cheese is melted, about 5 minutes. Transfer to a baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bacon, green salsa, green onions, and jalapeno peppers in with the cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake dip in the preheated oven until warm and bubbly, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
