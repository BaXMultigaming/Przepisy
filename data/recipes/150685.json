  "ingredients": [
    "1 (2 pound) flat iron steak",
    "2.5 tablespoons olive oil",
    "2 cloves garlic, minced",
    "1 teaspoon chopped fresh parsley",
    "0.25 teaspoon chopped fresh rosemary",
    "0.5 teaspoon chopped fresh chives",
    "0.25 cup Cabernet Sauvignon (or other dry red wine)",
    "0.5 teaspoon salt",
    "0.75 teaspoon ground black pepper",
    "0.25 teaspoon dry mustard powder"
  ],
  "steps": [
    {
      "text": "Place steak inside a large resealable bag. Stir olive oil, garlic, parsley, rosemary, chives, red wine, salt, pepper, and mustard powder together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cFjleuiEZVXKSKv9cG50hnLyT1o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/150685-perfect-flat-iron-steak-ddmfs-step-1-010-4x3-4e5585d8ce284336b3f023be59b9a8ab.jpg"
      ],
      "image": "assets/images/150685/step_01.webp"
    },
    {
      "text": "Pour marinade over steak in the bag. Press out as much air as you can and seal the bag. Marinate in the refrigerator for 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9gRDJOXAuKmsoaXdyVWguNGBnCc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/150685-perfect-flat-iron-steak-ddmfs-step-2-062-4x3-faa4ca27b62e49a8a8fb7d6f249e708b.jpg"
      ],
      "image": "assets/images/150685/step_02.webp"
    },
    {
      "text": "Heat a nonstick skillet over medium-high heat. Place steak in the hot skillet and discard any remaining marinade; sear and cook steak for 3 to 4 minutes on each side for medium rare, or to your desired degree of doneness. An instant-read thermometer inserted into the center should read 130 degrees F (54 degrees C) for medium rare.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ptif95NoGTEfc9m0Lm88BKKSsiY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/150685-perfect-flat-iron-steak-ddmfs-step-4-079-4x3-957abf1de98b4a229522d0ebd73e1bb0.jpg"
      ],
      "image": "assets/images/150685/step_03.webp"
    },
    {
      "text": "Allow steak to rest for about 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q1Mb_CvWRJxv17E1RwT7sHnYjuQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/150685-perfect-flat-iron-steak-DDMFS-4x3-3249da60e56343388122d1c615eb4c88.jpg"
