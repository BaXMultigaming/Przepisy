  "ingredients": [
    "1 head cauliflower, cut into bite-sized pieces",
    "3 stalks celery, sliced",
    "1 medium green bell pepper, chopped",
    "0.33333334326744 cup finely chopped onion, or more to taste",
    "1.25 cups mayonnaise (such as Duke's®)",
    "1 tablespoon vinegar",
    "1 tablespoon mustard",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "6 hard-boiled eggs, peeled and chopped"
  ],
  "steps": [
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer; bring water to a boil. Add cauliflower; cover and steam until tender, about 7 minutes. Immediately rinse with cold water; set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine celery, bell pepper, and onion in a large bowl; stir in mayonnaise, vinegar, mustard, salt, and black pepper. Lightly toss in cauliflower and eggs until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl with plastic wrap; chill in the refrigerator until flavors meld, 6 to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
