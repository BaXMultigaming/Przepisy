  "ingredients": [
    "1 (1 pound) eggplant, cut into 1-inch cubes",
    "1 zucchini, sliced",
    "1 small green bell pepper, chopped",
    "1 onion, coarsely chopped",
    "cooking spray",
    "0.25 teaspoon ground black pepper, divided",
    "1 tomato, chopped",
    "1 tablespoon extra-virgin olive oil",
    "0.25 cup chopped fresh parsley",
    "0.375 teaspoon salt, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange eggplant, zucchini, bell pepper, and onion on a greased or foil-lined baking sheet. Spray vegetables with cooking spray. Season with 1/8 teaspoon black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven, stirring and rotating pan once during cooking, until vegetables are lightly browned and tender, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stir together tomato, oil, parsley, and 1/8 teaspoon each salt and black pepper in a large bowl. Add cooked vegetables and remaining 1/4 teaspoon salt. Toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
