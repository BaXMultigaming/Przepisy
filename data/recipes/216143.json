  "ingredients": [
    "1 cup rice flour",
    "1 tablespoon white sugar",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking powder",
    "0.33333334326744 cup vegetable shortening",
    "3 tablespoons cold water",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Whisk rice flour, sugar, salt, and baking powder together in a bowl. Cut in shortening until the mixture resembles sand. Stir in water and vanilla extract until dough forms a ball.",
