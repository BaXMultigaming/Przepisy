  "ingredients": [
    "6 large potatoes",
    "6 tablespoons butter",
    "8 ounces Swiss cheese, grated",
    "salt to taste",
    "ground black pepper to taste",
    "2 tablespoons hot water"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes. Drain, and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once cool, peel and grate potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 3 tablespoons of butter in large nonstick skillet. Add a layer of potatoes and a layer of cheese, then sprinkle with salt and pepper. Repeat layers. Dot each layer with remaining butter. Sprinkle 2 tablespoons hot water over the top layer, cover, and cook over low to medium heat until bottom layer browns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn potato cake with spatula and brown other side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
