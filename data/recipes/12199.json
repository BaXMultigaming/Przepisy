  "ingredients": [
    "2 eggs",
    "0.75 cup white sugar",
    "1 cup butter, melted",
    "0.75 cup dark corn syrup",
    "0.75 cup quick cooking oats",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "0.75 cup flaked coconut",
    "1 recipe pastry for a 9 inch single crust pie"
  ],
  "steps": [
    {
      "text": "In a medium bowl, beat the eggs well. Stir in sugar, butter or margarine, corn syrup, oatmeal, vanilla, and salt. Pour mixture into the pie shell, and top with coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 30 to 35 minutes. Cool before serving.",
