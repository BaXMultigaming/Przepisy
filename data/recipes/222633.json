  "ingredients": [
    "2 tablespoons olive oil",
    "1 (28 ounce) can crushed tomatoes",
    "2 leaves basil, chopped",
    "3 cloves garlic, chopped",
    "1 pinch salt and ground black pepper to taste",
    "1 pinch grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a saucepan. Pour crushed tomatoes into the saucepan and place over low heat. Stir basil, garlic, salt, and black pepper into the tomatoes; bring to a simmer. Add Parmesan cheese to sauce to serve.",
