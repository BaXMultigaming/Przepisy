  "title": "Clara's White German Chocolate Cake",
  "description": "A lovely three layer cake made with white chocolate, with coconut and pecans mixed in.",
  "authors": [
    "Sallie"
  ],
  "date_published": "2020-06-18T23:06:39-04:00",
