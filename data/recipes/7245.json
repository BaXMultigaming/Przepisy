  "ingredients": [
    "1.5 cups warm water (110 degrees F/45 degrees C)",
    "2.25 teaspoons active dry yeast",
    "0.5 teaspoon brown sugar",
    "2 tablespoons olive oil",
    "1 teaspoon salt",
    "3.3333332538605 cups all-purpose flour, divided"
  ],
  "steps": [
    {
      "text": "Stir together warm water, yeast, and brown sugar in a large mixing bowl; let sit for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oil and salt into yeast mixture. Mix in 2 1/2 cups flour until incorporated. Turn dough out onto a clean, floured surface. Knead dough, adding remaining flour, a little at a time, until dough is no longer sticky. Place dough into an oiled bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Dzx-Dtd0Zc7nk49PawaoR-1i2ok=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7245-jays-signature-pizza-crust-step1-4x3-886dc4192ab74af5852d4c92135d24dd.jpg"
      ],
      "image": "assets/images/7245/step_02.webp"
    },
    {
      "text": "Cover with a towel and let rise until doubled in size, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yYHT1YDQwwmusWaI-BELnEAGf2o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7245-jays-signature-pizza-crust-step2-4x3-4819690c9bc54fda93530b5a0740f5e9.jpg"
      ],
      "image": "assets/images/7245/step_03.webp"
    },
    {
      "text": "Punch down dough and form it into a tight ball. Allow dough to relax for 1 minute before rolling out.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xpuPDih0o_gMcNJsDn4t8Mef0gc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7245-jays-signature-pizza-crust-step4-4x3-5770ba3f57834c35a532ee3f85062c23.jpg"
      ],
      "image": "assets/images/7245/step_04.webp"
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "If baking dough on a pizza stone, place toppings on dough and bake immediately. If baking dough on a pan, lightly oil the pan and let dough rise for 15 to 20 minutes before topping and baking it.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and crust is golden brown, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5QvL1eBw8VbJqgmeZG-Z5eTosS8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7245-jays-signature-pizza-crust-DDMFS-4x3-2072304aa461449d8f00637c3cec83f1.jpg"
      ],
      "image": "assets/images/7245/step_07.webp"
    }
