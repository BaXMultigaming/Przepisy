  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "0.5 cup sour cream",
    "0.25 cup mayonnaise",
    "4 (4 ounce) cans small shrimp, drained",
    "1.5 cups seafood cocktail sauce",
    "1 green bell pepper, diced",
    "4 green onions, diced",
    "2 cloves garlic, minced",
    "1 tomato, diced",
    "2.5 cups shredded mozzarella cheese",
    "crackers"
  ],
  "steps": [
    {
      "text": "In a bowl, combine the cream cheese, sour cream, and mayonnaise until well-blended. Spread into a 9x13 inch baking dish. Scatter the shrimp generously over the top of the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, stir together the cocktail sauce, green pepper, green onions, garlic, and tomato.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in layers, spread a portion of the cocktail sauce mixture over the shrimp. Sprinkle with a portion of mozzarella cheese. Repeat process until all ingredients are used up, finishing with a layer of mozzarella cheese on top. Serve with assorted crackers for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
