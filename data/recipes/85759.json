  "ingredients": [
    "7 (16 ounce) cans kidney beans, rinsed and drained",
    "0.5 cup minced onion",
    "1 clove garlic, minced",
    "2 cups mayonnaise",
    "2 cups sweet relish",
    "1 teaspoon salt",
    "1 dash white pepper",
    "2 teaspoons dry mustard"
  ],
  "steps": [
    {
      "text": "In a medium bowl, stir together beans, onion, garlic, mayonnaise, and relish. Season with salt, white pepper, and mustard. Mix well, and refrigerate for several hours before serving.",
