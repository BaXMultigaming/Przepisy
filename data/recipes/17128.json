  "ingredients": [
    "1 (9 inch) frozen pie crust, thawed",
    "1 (8 ounce) package cream cheese, softened",
    "0.33329999446869 cup white sugar",
    "4 kiwi, peeled and sliced",
    "1 (11 ounce) can mandarin oranges, drained",
    "1 cup fresh strawberries, halved",
    "1 cup fresh raspberries",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll pie crust on a lightly floured surface into an 11-inch circle. Lay flat on a baking sheet or pizza pan; prick several times with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light brown, 12 to 15 minutes. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and sugar together in a bowl until creamy and smooth; spread evenly onto cooled crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange kiwi, oranges, strawberries, raspberries, and blueberries in a decorative pattern over cream cheese layer. Chill in the refrigerator until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
