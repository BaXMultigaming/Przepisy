  "ingredients": [
    "3 cups all-purpose flour",
    "1.5 cups white sugar",
    "2 lemons, zested and juiced, divided",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground nutmeg",
    "1 cup buttermilk",
    "0.66666668653488 cup vegetable oil",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "12 ounces fresh blueberries",
    "2 cups confectioners' sugar",
    "0.5 cup butter, melted",
    "0.25 cup hot water",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line two 12-cup muffin tins with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, sugar, 1 tablespoon lemon zest, baking soda, salt, and nutmeg together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk buttermilk, oil, eggs, lemon juice, and vanilla extract together in a medium bowl. Stir into the flour mixture until just moistened. Fold in blueberries. Spoon batter into muffin cups, filling them about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 20 to 25 minutes. Transfer muffins onto a wire rack to cool for about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine confectioners' sugar, butter, hot water, vanilla extract, and remaining zest in a medium bowl. Whisk to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip cooled muffin tops in glaze. Cool until glaze firms up, about 10 minutes. Dip muffins a second time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
