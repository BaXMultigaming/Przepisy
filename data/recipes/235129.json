  "ingredients": [
    "2 egg yolks, well beaten",
    "1 cup white sugar",
    "0.25 cup all-purpose flour",
    "0.25 teaspoon salt",
    "1 cup skim milk",
    "1.5 teaspoons lemon zest",
    "0.25 cup lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg yolks together in a small bowl until well combined. Whisk sugar, flour, and salt in a large bowl; stir in yolks, milk, lemon zest, and lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until stiff peaks form; fold into lemon-flour mixture. Pour into a 1-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set the baking dish in a baking pan; add enough hot water to come about 1 inch up the sides of the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set in the center, about 50 minutes. Serve warm or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
