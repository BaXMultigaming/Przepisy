  "ingredients": [
    "8 tablespoons olive oil",
    "2 teaspoons lemon juice",
    "4 cloves crushed garlic",
    "1 tablespoon dried oregano",
    "salt and pepper to taste",
    "4 skinless, boneless chicken breasts",
    "4 slices feta cheese",
    "4 slices bacon, fried and drained"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl combine the oil, lemon juice, garlic, oregano, salt and pepper. Mix together. Place chicken in a 9x13 inch baking dish and pour oil mixture over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stuff each chicken breast with 1 slice feta cheese and 1 slice bacon. Secure open sides with toothpicks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered at 350 degrees F (175 degrees C) for 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
