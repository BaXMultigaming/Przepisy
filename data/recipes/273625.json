  "ingredients": [
    "3 cups water",
    "1 (12 fluid ounce) can frozen limeade concentrate",
    "1 cup white sugar",
    "0.5 cup white rum (such as Bacardi®)",
    "0.5 cup dark rum (such as Bacardi® Gold)",
    "0.5 cup amaretto liqueur",
    "0.25 cup orange liqueur (such as Grand Marnier®)"
  ],
  "steps": [
    {
      "text": "Heat water and sugar in a saucepan over low heat until sugar dissolves, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir frozen limeade, white rum, dark rum, amaretto liqueur, and orange liqueur into sugar mixture; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into a freezer-safe bowl; freeze for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop frozen concoction into cocktail glasses; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
