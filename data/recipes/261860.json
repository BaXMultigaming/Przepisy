  "title": "Easy Chocolate Cookie Bars with Cake Mix",
  "description": "Make these easy chocolate cookie bars with cake mix, eggs, chocolate chips, and condensed milk the next time you need dessert in a hurry.",
  "authors": [
    "Caitlin"
  ],
