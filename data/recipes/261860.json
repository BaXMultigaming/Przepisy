  "ingredients": [
    "cooking spray",
    "1 (18.25 ounce) package white cake mix",
    "2 large eggs",
    "0.33333334326744 cup vegetable oil",
    "1 (14 ounce) can sweetened condensed milk",
    "1 cup semisweet chocolate chips",
    "0.25 cup margarine"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, eggs, and oil in a bowl using an electric mixer until well blended, 1 to 2 minutes. Set aside 1/3 of the mixture; press remaining mixture into the bottom of the prepared pan to form a crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sweetened condensed milk, chocolate chips, and margarine in a microwave-safe bowl. Melt in the microwave in 30 second intervals, stirring and checking for completion, about 2 minutes. Pour evenly over the crust. Drop teaspoonfuls of the reserved crust mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes. Cool completely before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
