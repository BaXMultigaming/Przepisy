  "ingredients": [
    "nonstick cooking spray",
    "6 tablespoons oat milk",
    "2 tablespoons ground flax seeds",
    "1.5 medium zucchini",
    "0.5 cup packed brown sugar",
    "0.5 cup vegetable oil",
    "0.33333334326744 cup honey",
    "1 teaspoon vanilla extract",
    "1.6666667461395 cups all-purpose flour",
    "0.33333334326744 cup unsweetened cocoa powder",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray an 8 1/2x4 1/2-inch loaf pan with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together oat milk and ground flax seeds in a small bowl until well combined, then place in the refrigerator for 15 minutes to set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred zucchini and gently press out moisture. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the oat milk/flax seed mixture, brown sugar, oil, honey, and vanilla extract in a large bowl with a hand mixer until smooth. Add flour, cocoa powder, salt, baking soda, and baking powder, and mix until well combined. Stir in zucchini. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 55 to 65 minutes. Cool in the pan for 15 minutes before removing the bread from the pan to cool on a wire rack completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
