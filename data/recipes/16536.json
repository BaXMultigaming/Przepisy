  "ingredients": [
    "20 ounces porterhouse steak",
    "1 teaspoon olive oil",
    "1 tablespoon meat tenderizer",
    "1 teaspoon steak seasoning"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mGNNu9ooD-c5hvWRNrKVpNEEIqU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16536-perfect-porterhouse-steak-DDMFS-step-01-3011-2773ed417cd2436ba19790658e5e8550.jpg"
      ],
      "image": "assets/images/16536/step_01.webp"
    },
    {
      "text": "Place steak onto a plate; coat with olive oil, rub with tenderizer, then gently rub with steak seasoning. Cover with plastic wrap and let stand for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s3P3G9nYzJJAumMW5utFg8q3jTk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16536-perfect-porterhouse-steak-DDMFS-step-02-3012-d04dfe927da748c68308a4914b4ccce8.jpg"
      ],
      "image": "assets/images/16536/step_02.webp"
    },
    {
      "text": "Meanwhile, preheat a grill for high heat. When hot, lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J-8UH3e22K1D5Z-x8gtkRQAHxMM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16536-perfect-porterhouse-steak-DDMFS-step-02-3015-77d2fae6ca0b4d00ba5e18f6125208d5.jpg"
      ],
      "image": "assets/images/16536/step_03.webp"
    },
    {
      "text": "Cook steak on the preheated grill until hot, slightly pink in the center, and beginning to firm, 3 to 5 minutes per side. An instant-read thermometer inserted into the center should read 140 degrees F (60 degrees C) for medium.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SRfcXBSbNQ2twsvvu5M1jabQP1Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16536-perfect-porterhouse-steak-DDMFS-step-03-3017-b2d04f48107c4e1a85349676d59111fc.jpg"
      ],
      "image": "assets/images/16536/step_04.webp"
    }
