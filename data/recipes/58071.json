  "ingredients": [
    "1 (8 ounce) package imitation crab or lobster meat",
    "0.25 cup mayonnaise",
    "1 tablespoon finely chopped red onion",
    "1 teaspoon lemon juice",
    "0.25 teaspoon OLD BAY® Seasoning",
    "1 tablespoon butter, softened",
    "2 hot dog buns"
  ],
  "steps": [
    {
      "text": "Flake crabmeat into a medium bowl. Mix in mayonnaise, onion, lemon juice, and seasoning. Cover and refrigerate until flavors mingle, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Spread butter on the inside of the hot dog buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast buns under the preheated broiler. Remove from the oven, fill with crab salad, and serve.",
      "section": null,
