  "ingredients": [
    "28 graham crackers, crushed",
    "0.5 cup butter, melted",
    "1 cup milk",
    "2 (1.3 ounce) envelopes dry whipped topping mix (such as Dream Whip®)",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup white sugar",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Combine crushed graham crackers and melted butter in a bowl; press mixture into a 9x11-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk and whipped topping mix together in a bowl until fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and sugar together in a separate bowl until fully incorporated; stir into whipped topping mixture until smooth. Spread mixture onto graham cracker crust. Refrigerate until set, 1 to 2 hours. Top with cherry pie filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
