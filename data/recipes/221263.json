    "0.5 cup Dijon mustard",
    "0.5 cup mayonnaise",
    "0.5 lemon, juiced and zested",
    "1 teaspoon chopped fresh dill",
    "1 clove garlic, minced",
    "1 (1.5 pound) salmon fillet, skin removed"
