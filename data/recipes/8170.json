  "title": "Apple Spice Cake",
  "description": "This moist apple spice cake is flavored with cinnamon, nutmeg, and allspice and loaded with chunks of tender apples and sweet raisins in every bite.",
  "authors": [
    "Krissyp"
  ],
  "date_published": "1999-03-18T17:03:47-05:00",
