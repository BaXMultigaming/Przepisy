  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground allspice",
    "0.5 teaspoon salt",
    "1 cup butter, softened",
    "2 cups white sugar",
    "4 eggs",
    "1 teaspoon baking soda",
    "1 tablespoon warm water",
    "1 teaspoon vanilla extract",
    "3 apples - peeled, cored and chopped",
    "0.5 cup raisins",
    "0.25 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Butter a 10-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gsZusgg5OiuEb4x_ekIv6wP73jQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8170-apple-spice-cake-VAT-step-01-dc8b183495274b18a27ca5dd79891b6a.jpg"
      ],
      "image": "assets/images/8170/step_01.webp"
    },
    {
      "text": "Cover raisins with warm water and let soak for 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TQ0O7qGAMEnZcDSZOrZYA18fZ6M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8170-apple-spice-cake-VAT-step-02-21c557b05336459f8c053d44edb90c1e.jpg"
      ],
      "image": "assets/images/8170/step_02.webp"
    },
    {
      "text": "Whisk flour, spices, and salt together in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QhWQu-PEbUOMOYz7bTA-i_7yh4w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8170-apple-spice-cake-VAT-step-03-db6d9d3163e145b9b615ce5b56b7b05b.jpg"
      ],
      "image": "assets/images/8170/step_03.webp"
    },
    {
      "text": "Beat butter and sugar together in a large bowl until fluffy. Add eggs and vanilla. Stir baking soda and 1 tablespoon warm water together until smooth; stir into sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b8701WhweejEYp-HWlxvMYxAjZ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8170-apple-spice-cake-VAT-step-04-1ee16c53ca2b44b1938c4144fce0ecb1.jpg"
      ],
      "image": "assets/images/8170/step_04.webp"
    },
    {
      "text": "Mix in flour mixture, apples, and strained raisins until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aDE26cz2JZXLHW9I1bg6hcnM0IM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8170-apple-spice-cake-VAT-step-05-3a150f5ed30b4f5eb64087917d08022d.jpg"
      ],
      "image": "assets/images/8170/step_05.webp"
    },
    {
      "text": "Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VvSA6XmEoOuMo4rZCai7TiCGajA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8170-apple-spice-cake-VAT-step-06-1613f63b51c0474f9dcfbed5c7144cd8.jpg"
      ],
      "image": "assets/images/8170/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 1 hour. Cool cake in pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5Gsg5ujpwh9cyjKe6vruqJGn0QA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8170-apple-spice-cake-VAT-step-07-7e7f3f1e37234867947b54c3dffa302d.jpg"
      ],
      "image": "assets/images/8170/step_07.webp"
    },
    {
      "text": "Once cool, shake pan to loosen cake. Turn onto plate, and dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/87mhubP770QVamfMbyCm4yCP2gU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8170-apple-spice-cake-VAT-step-08-a1eed6441a1a487180718a3530674d6a.jpg"
      ],
      "image": "assets/images/8170/step_08.webp"
    }
