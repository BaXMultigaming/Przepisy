  "ingredients": [
    "1 cup all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1.5 cups white sugar",
    "0.75 cup melted butter",
    "1.5 teaspoons vanilla extract",
    "3 eggs",
    "0.5 cup chocolate syrup (such as Hershey's®)",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the flour, cocoa powder, baking powder, and salt in a bowl; set aside. Whisk the sugar, butter, and vanilla extract in a mixing bowl. Add the eggs and chocolate syrup; mix until evenly incorporated. Stir in the flour mixture and chocolate chips; stir until just moistened and pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is dry and the edges have started to pull away from the sides of the pan, about 40 minutes. Cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
