  "ingredients": [
    "1 pound cooked small shrimp",
    "1 tablespoon olive oil, or to taste",
    "3 cloves garlic, minced",
    "salt to taste",
    "2 tomatoes, diced",
    "1 mango, diced",
    "1 avocado, diced",
    "0.5 green bell pepper, diced",
    "3 tablespoons lime juice",
    "1 green chile pepper, diced",
    "1 teaspoon white sugar",
    "2 cups chopped fresh cilantro",
    "0.25 cup tequila",
    "3 tablespoons lime juice",
    "12 warm corn tortillas, or as needed"
  ],
  "steps": [
    {
      "text": "Combine shrimp, olive oil, garlic, and salt in a bowl. Let sit while you prepare the salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tomatoes, mango, avocado, bell pepper, 3 tablespoons lime juice, chile pepper, and sugar in a bowl. Mix until salsa is evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium heat. Add shrimp; cook and stir until moisture evaporates, 3 to 5 minutes. Stir in cilantro, tequila, and 3 tablespoons lime juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve hot shrimp and salsa over corn tortillas.",
