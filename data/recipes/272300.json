  "ingredients": [
    "0.5 cup warm water",
    "4 tablespoons white sugar",
    "1 (.25 ounce) package active dry yeast",
    "1 cup cooked white rice",
    "2 large eggs",
    "0.33333334326744 cup raisins",
    "1 teaspoon salt",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "1 teaspoon freshly grated nutmeg",
    "0.75 cup all-purpose flour",
    "0.25 cup crushed cashews",
    "oil for frying",
    "2 tablespoons confectioners' sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Combine water and sugar in a small bowl. Add yeast and let stand until foamy, about 10 minutes. Add rice and stir well. Cover with plastic wrap and leave at room temperature, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly mash the rice mixture, leaving some grains intact. Stir in eggs, raisins, salt, vanilla extract, cinnamon, and nutmeg. Mix in flour and cashews until well incorporated. Cover and let rise in a warm place for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat enough oil in a large saucepan to cover the beignets. Drop spoonfuls of batter into the hot oil; cook until browned, turning once, about 5 minutes. Drain on paper towels. Promptly sprinkle with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
