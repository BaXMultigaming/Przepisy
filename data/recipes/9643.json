  "ingredients": [
    "0.5 cup shortening",
    "1 cup packed brown sugar",
    "2 eggs",
    "1 (8 ounce) can crushed pineapple",
    "0.5 teaspoon rum",
    "0.75 cup all-purpose flour",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.75 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 9 inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large mixing bowl, cream shortening and brown sugar. Add eggs, pineapple and rum, mix well. In separate bowl, mix together the flour, baking powder and salt. Slowly add to egg mixture and beat until well blended. Blend in coconut and spread batter evenly in bottom of pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 25 to 30 minutes. Let cool on wire rack before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
