  "ingredients": [
    "1 pound sliced bacon",
    "1 head iceberg lettuce, finely chopped",
    "1 head cauliflower, florets finely chopped",
    "1 large red onion, shaved thin",
    "1 cup mayonnaise",
    "3 tablespoons white sugar",
    "0.33333334326744 cup grated Parmesan cheese",
    "1 dash ground black pepper"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Chop into small pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer lettuce, cauliflower, onion, chopped bacon, mayonnaise, sugar, and Parmesan cheese in a large bowl, in that order. Cover the bowl tightly with plastic wrap. Place a heavy pan on top to press down salad.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate for 24 to 36 hours, checking occasionally that salad remains pressed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss salad to serve; season with black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
