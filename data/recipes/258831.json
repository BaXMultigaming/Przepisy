  "title": "Make-Ahead Cauliflower Salad",
  "description": "Cauliflower, crispy bacon, iceberg lettuce, and mayonnaise are layered in this make-ahead salad that's pressed for a day before serving.",
  "authors": [
    "Iwnbb"
  ],
  "date_published": "2020-06-19T00:22:59-04:00",
