  "ingredients": [
    "3 cups all-purpose flour",
    "1 (8 ounce) package cream cheese, softened",
    "1 cup butter, softened",
    "12 ounces any flavor fruit jam"
  ],
  "steps": [
    {
      "text": "Mix cream cheese and butter well in large bowl until well blended and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add in flour slowly, beating well after each addition. Roll dough into 1-inch balls and wrap well in cellophane. Store in fridge, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out dough balls flat and place a 1/2 teaspoon full of the jam in the center. Fold sides over and place on ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until brown and jam starts to bubble hard, 13 to 15 minutes. Cool for 3 minutes and place on cooling rack. Sprinkle with powdered sugar if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
