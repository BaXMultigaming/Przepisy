  "ingredients": [
    "3 cups ice, or as needed",
    "2 fluid ounces vodka",
    "2 fluid ounces pomegranate juice",
    "1 lime, juiced",
    "0.5 fluid ounce orange-flavored liqueur",
    "2.5 fluid ounces club soda, or as needed",
    "1 teaspoon pomegranate seeds, or to taste"
  ],
  "steps": [
    {
      "text": "Fill 2 highball glasses and a cocktail shaker with ice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add vodka, pomegranate juice, lime juice, and orange-flavored liqueur to the cocktail shaker and secure the lid. Place one hand on the lid and one hand on the shaker; shake vigorously until the outside of the shaker frosts, about a slow count to 10.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour evenly into the prepared glasses. Top with soda and pomegranate seeds; stir before serving.",
      "section": null,
