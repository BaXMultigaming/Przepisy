  "ingredients": [
    "2 tablespoons extra-virgin olive oil",
    "1 extra-large Spanish onion, chopped",
    "2 tablespoons water",
    "2 pounds lean ground beef",
    "4 cloves garlic, minced",
    "2 tablespoons grated fresh ginger root",
    "1 serrano chile pepper, finely chopped",
    "2 teaspoons chopped fresh cilantro",
    "1 tablespoon ground coriander",
    "1.5 teaspoons salt",
    "1.5 teaspoons ground cumin",
    "1 teaspoon ground cayenne pepper",
    "1 teaspoon ground turmeric",
    "3 potatoes, peeled and diced",
    "1 (28 ounce) can diced tomatoes",
    "1 cup frozen green peas",
    "1 teaspoon garam masala"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rMohOIlKMs2SD5Mvri6mmrMovYI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231026-keema-aloo-DDMFS-step-01-16267690d2aa40c2ab0a37b1c431bd33.jpg"
      ],
      "image": "assets/images/231026/step_01.webp"
    },
    {
      "text": "Heat olive oil in a large saucepan over medium-high heat. Add onion; cook and stir until soft and beginning to brown, about 12 minutes. If browned bits of onion are stuck to the bottom of the pan, add water and stir to loosen.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PLmqzkOoEa1Y1Pxg3hGiLyUndnM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231026-keema-aloo-DDMFS-step-02-41fe1d82b15241b9ba24950ef840f96d.jpg"
      ],
      "image": "assets/images/231026/step_02.webp"
    },
    {
      "text": "Stir ground beef, garlic, ginger, serrano chile, and cilantro into the pan; cook and stir until beef is browned and crumbly, 10 to 15 minutes. Reduce heat to medium-low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/obZcG3of9RwCODqXtmnkzlIMnbI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231026-keema-aloo-DDMFS-step-03-061da3da98ae468d922fa002d2bb34e0.jpg"
      ],
      "image": "assets/images/231026/step_03.webp"
    },
    {
      "text": "Stir in coriander, salt, cumin, cayenne pepper, and turmeric; cook and stir until flavors blend, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fqdXio_7iIrxGbzMFFqg2mPB79w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231026-keema-aloo-DDMFS-step-04-6a83d5401a4443e486bf56d32c68ab3b.jpg"
      ],
      "image": "assets/images/231026/step_04.webp"
    },
    {
      "text": "Add potatoes and tomatoes; cover and simmer until potatoes are tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bEBpYmeIBacDRs7VAQqFHS-MQWY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231026-keema-aloo-DDMFS-step-05-29e3b641705945429d61dd962439c2a1.jpg"
      ],
      "image": "assets/images/231026/step_05.webp"
    },
    {
      "text": "Stir in green peas and cook until sauce has slightly thickened and flavors have blended, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JrpbyulQh28UoCAOQLuqGPPXmGs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231026-keema-aloo-DDMFS-step-06-9587ff33fe5c4ecbadfa8bca8e7faf6a.jpg"
      ],
      "image": "assets/images/231026/step_06.webp"
    },
    {
      "text": "Sprinkle garam masala over top, cover, and let stand for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C_KEkev9QkPT2DZsGi4bp5Hv5Vo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231026-keema-aloo-DDMFS-step-07-0711c322dffd428893956c1d8b9082e1.jpg"
      ],
