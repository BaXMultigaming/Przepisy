  "ingredients": [
    "0.25 cup all-purpose flour",
    "1 (10.5 ounce) can beef broth",
    "2 tablespoons white sugar",
    "2 tablespoons soy sauce",
    "1 pound boneless round steak, cut into bite size pieces",
    "0.25 teaspoon chopped fresh ginger root",
    "1 clove garlic, minced",
    "4 cups chopped fresh broccoli"
  ],
  "steps": [
    {
      "text": "In a small bowl, combine flour, broth, sugar, and soy sauce. Stir until sugar and flour are dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet or wok over high heat, cook and stir beef 2 to 4 minutes, or until browned. Stir in broth mixture, ginger, garlic, and broccoli. Bring to a boil, then reduce heat. Simmer 5 to 10 minutes, or until sauce thickens.",
