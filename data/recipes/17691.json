  "title": "Pineapple Upside-Down Cake",
  "description": "This classic pineapple upside-down cake is made in a cast iron skillet to create a delicious caramelized brown sugar, pineapple, and cherry topping.",
  "authors": [
    "Anne"
  ],
  "date_published": "1999-03-15T14:49:38-05:00",
