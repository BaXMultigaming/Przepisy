    "publisher-tested"
  ],
  "ingredients": [
    "1 (20 ounce) can pineapple rings",
    "0.25 cup water, or as needed",
    "0.5 cup unsalted butter",
    "1 (16.25 ounce) package white cake mix (such as Betty Crocker Super Moist)",
    "0.5 cup vegetable oil",
    "3 large egg whites",
    "1.5 cups brown sugar",
    "7 maraschino cherries"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lk_8uw_ApDdpKHXmPdgqiDFHeI0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17691-pineapple-upside-down-cake-vii-ddmfs-4x3-step-01-39e05e75bccd4f8c8bcf7ae755e713df.jpg"
      ],
      "image": "assets/images/17691/step_01.webp"
    },
    {
      "text": "Drain canned pineapple into a 1-cup measure. Add water if needed to measure 1 cup. Set aside juice and 9 pineapple rings for the cake. Set any remaining juice and pineapple rings aside for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xtzpImCR8gPF4fC27LM1-tGnqfg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17691-pineapple-upside-down-cake-vii-ddmfs-4x3-step-03-21da1f0d1b5940e2946b27439dd47d72.jpg"
      ],
      "image": "assets/images/17691/step_02.webp"
    },
    {
      "text": "Melt butter in a 12-inch cast iron skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n6X8JVp9LW1lNXTfI-JpFQNEPRU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17691-pineapple-upside-down-cake-vii-ddmfs-4x3-step-04-1ebe7f2d69074dff8c9df029b2e67930.jpg"
      ],
      "image": "assets/images/17691/step_03.webp"
    },
    {
      "text": "While butter is melting, combine cake mix, reserved 1 cup pineapple juice, vegetable oil, and egg whites in a mixing bowl. Beat with an electric mixer on medium speed for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iA49a_cQX8S7ZbB15c_d2ad-pl0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17691-pineapple-upside-down-cake-vii-ddmfs-4x3-step-05-7d96c3e528da4805ae24a49fc89c4d24.jpg"
      ],
      "image": "assets/images/17691/step_04.webp"
    },
    {
      "text": "Remove melted butter from the heat and sprinkle brown sugar evenly over top until all the butter is covered. Arrange 8 pineapple rings around the outer edge of the skillet and place the remaining pineapple ring in the center without overlapping. Place a maraschino cherry into the center of each pineapple ring; pour cake batter on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Bqkdco8ee1qCFF_a9jd0brac-Tw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17691-pineapple-upside-down-cake-vii-ddmfs-4x3-step-07-9658455331b84f0ab0f1ffd3e67a9798.jpg"
      ],
      "image": "assets/images/17691/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the cake comes out clean, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qmIMI_SbhoQl2tiP11zw6_LeHcY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17691-pineapple-upside-down-cake-vii-ddmfs-4x3-step-08-49a6a42f728943b3a7fb2dfe387bd43e.jpg"
      ],
      "image": "assets/images/17691/step_06.webp"
    },
    {
      "text": "Remove from the oven and let cool in the skillet for 10 minutes; don't let the cake cool too much or it will stick to the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MlFeXwJrgCXYGXDwVgTJBs7HWx4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17691-pineapple-upside-down-cake-vii-ddmfs-4x3-step-09-2f7adc647a054919a1d6d2eb3942e006.jpg"
      ],
      "image": "assets/images/17691/step_07.webp"
    },
    {
      "text": "Run an offset spatula around the edges to gently loosen cake. Place a plate over the skillet, then flip and carefully turn the warm cake out onto a plate. Transfer any fruit or glaze that sticks in the skillet back to the cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4a4xMzKYMJqmSGy1Av_A9bwacRE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17691-pineapple-upside-down-cake-vii-ddmfs-4x3-step-10-c617e1a3518541b89cfac9ea5e05f630.jpg"
      ],
      "image": "assets/images/17691/step_08.webp"
    }
  ],
