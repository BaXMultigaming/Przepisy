  "ingredients": [
    "3 pounds ground beef",
    "0.25 cup minced onion",
    "3 tablespoons Worcestershire sauce",
    "4 cups beef broth",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "2 teaspoons butter",
    "12 hamburger buns, split"
  ],
  "steps": [
    {
      "text": "Crumble ground beef and onion into a large skillet over medium-high heat. Cook, stirring to break up lumps, until no longer pink. Drain off the grease and return to the stove. Add the Worcestershire sauce, beef broth, salt, pepper, and butter. Bring to a boil, then reduce the heat to low and simmer uncovered until the liquid is almost completely gone, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat. Cover and let rest for 15 minutes before serving on buns.",
