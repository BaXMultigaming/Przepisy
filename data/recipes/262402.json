  "ingredients": [
    "1 very ripe banana",
    "2 eggs, beaten",
    "0.33333334326744 cup white sugar",
    "0.25 cup honey",
    "0.25 cup oil",
    "0.25 teaspoon vanilla extract",
    "1 cup whole wheat flour",
    "0.5 cup all-purpose flour",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 zucchini, grated",
    "1 carrot, grated",
    "0.25 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash banana in a large bowl; whisk in eggs, sugar, honey, oil, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine whole wheat flour, all-purpose flour, cinnamon, baking soda, baking powder, and salt in a separate bowl; stir into banana mixture until batter is moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir zucchini, carrot, and chocolate chips into batter until evenly distributed; pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into center comes out clean, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
