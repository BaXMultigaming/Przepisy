  "ingredients": [
    "1 pound sausages",
    "4 potatoes, peeled and cubed",
    "2 carrots, chopped",
    "1 onion, chopped",
    "3 (15 ounce) cans crushed tomatoes with juice",
    "1.5 teaspoons salt",
    "1 pinch ground black pepper",
    "1 pinch dried oregano"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove casings from sausages and cut into 1-inch pieces. Place these into a 10x15-inch roasting pan. Layer the potatoes, carrots and onions over the sausages. Then pour the tomatoes over all. Season with salt, ground black pepper and oregano.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake at 375 degrees F (190 degrees C) for 60 minutes, then uncover and bake for 15 to 20 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
