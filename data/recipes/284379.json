  "ingredients": [
    "1 (14 ounce) package chocolate sandwich cookies (such as Oreo®)",
    "2 cups heavy whipping cream",
    "0.5 (14 ounce) can sweetened condensed milk",
    "2 tablespoons white sugar",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Crush 20 cookies; reserve remaining cookies for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream in a chilled glass or metal bowl with an electric mixer until stiff peaks form. Gently fold in crushed cookies, sweetened condensed milk, sugar, and vanilla extract trying not to deflate whipped cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer ice cream mixture to a freezer-safe container; freeze until firm, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
