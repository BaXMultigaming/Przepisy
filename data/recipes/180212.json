  "ingredients": [
    "2 tablespoons olive oil",
    "6 cloves garlic, minced",
    "5 large tomatoes, chopped",
    "1 teaspoon dried oregano",
    "1 pound Alaskan cod",
    "0.5 pound large shrimp, peeled and deveined",
    "salt to taste",
    "1 tablespoon dried oregano, or to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a skillet over medium-high heat. Add garlic; cook and stir until golden brown, taking care not to burn garlic. Add tomatoes; cook and stir until juices released. Stir in 1 teaspoon oregano.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cod and shrimp on tomato mixture; season with salt. Cover skillet; simmer 3 minutes. Flip cod; season with salt and 1 tablespoon oregano; cover and cook 3 minutes more. Remove cover; cook until juices evaporate slightly, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
