  "ingredients": [
    "1 (1 pound) ground chorizo sausage (or favorite flavor sausage)",
    "1 cup chopped onion",
    "1 teaspoon minced fresh garlic",
    "1 (32 ounce) carton low-sodium chicken broth",
    "1 (15 ounce) can black beans, rinsed and drained",
    "1 (14.5 ounce) can fire-roasted tomatoes (diced or whole)",
    "1 cup diced zucchini (1/2-inch)",
    "1 cup frozen roasted or plain corn",
    "0.75 cup UNCLE BEN'S® Flavor Infusions Garlic & Butter Rice",
    "1 teaspoon dried Italian seasoning",
    "0.5 cup shredded Parmesan cheese"
  ],
  "steps": [
    {
      "text": "In a Dutch oven over medium heat, brown sausage (10 to 12 minutes).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion and garlic. Continue cooking, stirring occasionally, until onion is softened (4 to 5 minutes).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add remaining ingredients except Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low; continue cooking 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop into individual bowls and sprinkle with 1 tablespoon Parmesan cheese. Refrigerate leftovers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
