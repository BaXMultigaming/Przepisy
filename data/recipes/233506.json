  "ingredients": [
    "3 tablespoons butter",
    "1 large apple, cored and sliced",
    "0.5 cup white sugar, divided",
    "2 teaspoons ground cinnamon",
    "4 large eggs",
    "0.33333334326744 cup milk",
    "0.33333334326744 cup all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon vanilla extract",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in an oven-safe skillet over medium heat. Add apple slices, 1/4 cup sugar, and cinnamon; cook and stir until apples are tender, about 5 minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, milk, flour, remaining 1/4 cup sugar, baking powder, vanilla, and salt in a large bowl until smooth. Pour batter evenly over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pancake is golden brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven. Run a spatula around the edges to loosen. Invert carefully over a large plate to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
