  "ingredients": [
    "0.25 cup sugar",
    "0.25 teaspoon Chinese five-spice powder",
    "1 egg, beaten",
    "1 teaspoon water",
    "2 tablespoons butter",
    "3 large peaches, each cut into 8 wedges",
    "1 (15 ounce) package refrigerated pie pastry"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a baking sheet with a silicone baking mat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar and Chinese five-spice powder together in a small bowl. Beat egg and water together in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. When the butter foams, arrange peaches in a single layer in the skillet. Pour sugar mixture over the peaches; cook, turning peaches once, until sugar is melted, bubbling, and syrup has a tan color, about 2 minutes. Transfer peaches and syrup to a bowl to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut pie crusts into eight 4 1/2-inch rounds. Set rounds on prepared baking sheet and fold edges of each crust up to form a 1/2-inch rim. Brush each crust with egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 2 peach slices, pit-sides facing each other, in the center of each tart. Place 1 peach slice in center, skin-side up, in between the other two peaches. Drizzle excess syrup over the peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and bubbling, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x4m_i48NrUMkyaGQmV7Ugh6FiTo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3701996-397edaf5f5ae4d0f93ed150a2a95fc5d.jpg"
      ],
