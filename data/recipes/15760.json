  "title": "Old-Fashioned Carrot Cake",
  "description": "This old-fashioned carrot cake with cream cheese icing is made with buttermilk, coconut, pineapple, and walnuts for a moist, cinnamon-spiced treat.",
  "authors": [
    "Marc"
  ],
  "date_published": "1999-12-23T12:36:14-05:00",
