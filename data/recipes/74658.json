  "ingredients": [
    "3 cups all-purpose flour",
    "1 tablespoon ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 cups white sugar",
    "1.25 cups vegetable oil",
    "3 large eggs, lightly beaten",
    "2 cups peeled, pitted, and chopped peaches"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Grease 16 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lT8Hte12fkoIGbuy_F-6Oys6-p0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74658-peach-muffins-VAT-006-step-01-dca77308d8e34a96aa23c9bd3947bc28.jpg"
      ],
      "image": "assets/images/74658/step_01.webp"
    },
    {
      "text": "Combine flour, cinnamon, baking soda, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o68Yee26TW9Q7fwEVXsdg1bI1D8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74658-peach-muffins-VAT-007-step-02-d523fdab4fbb4eac9a9d9e9354322216.jpg"
      ],
      "image": "assets/images/74658/step_02.webp"
    },
    {
      "text": "Beat sugar, oil, and eggs together in a separate bowl; stir into flour mixture until moist. Fold in chopped peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PQMUK2Ylweg_b2r6nsCrKxEn_zQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74658-peach-muffins-VAT-008-step-03-b754cedd5a844ec8ac26c78392a2ef20.jpg"
      ],
      "image": "assets/images/74658/step_03.webp"
    },
    {
      "text": "Spoon muffin batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8P5bXonxGRqmRcMMsiqHx12bi0U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74658-peach-muffins-VAT-009-step-04-d35b6a158adf4216835354aea9861883.jpg"
      ],
      "image": "assets/images/74658/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 20 to 25 minutes. Cool for 10 minutes before turning out onto wire racks to cool completely.",
