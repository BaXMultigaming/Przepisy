  "ingredients": [
    "1.5 cups wheat cereal squares",
    "1.5 cups unsalted mixed nuts",
    "1 cup toasted oat cereal",
    "1 cup small pretzels",
    "1 cup bite-sized cheese crackers",
    "0.5 cup unsalted sunflower seeds",
    "3 tablespoons unsalted butter",
    "2.5 tablespoons honey",
    "1 tablespoon Worcestershire sauce",
    "0.75 teaspoon salt",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon chili powder",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion powder",
    "1 cup dried cherries",
    "2 (1.5 ounce) packages 100% smoked beef sticks, cut into bite-sized pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine wheat cereal squares, mixed nuts, oat cereal, pretzels, crackers, and sunflower seeds in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, honey, Worcestershire sauce, salt, cayenne pepper, chili powder, garlic powder, and onion powder in a small saucepan over medium-low heat until butter is melted and spices are blended; pour over wheat cereal square mixture and stir until well combined. Transfer to a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour, stirring every 15 minutes. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in dried cherries and smoked beef stick pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
