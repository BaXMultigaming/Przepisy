  "ingredients": [
    "3 tablespoons ketchup",
    "1 tablespoon milk",
    "1 pound extra-lean ground beef",
    "1 egg",
    "0.25 cup dried plain bread crumbs",
    "1 teaspoon Greek seasoning",
    "2 (20 ounce) jars marinara sauce, or more to taste",
    "1 pinch white sugar",
    "0.25 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Blend ketchup and milk together in a bowl. Mix in beef, egg, bread crumbs, and Greek seasoning to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat marinara sauce to a simmer in a 2-quart pot over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll beef mixture with your hands to form meatballs. Drop into the simmering sauce. Add sugar and cayenne pepper. Cook, stirring gently and regularly, until meatballs are no longer pink and sauce is heated through, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
