  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "2 tablespoons white sugar",
    "1 teaspoon salt",
    "2 cups milk",
    "2 eggs",
    "2 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "In a large bowl, stir together flour, baking powder, sugar and salt. Add milk, eggs and oil; mix well.",
