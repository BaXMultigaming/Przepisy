  "ingredients": [
    "0.5 cup soy sauce",
    "0.25 cup apricot preserves",
    "0.75 teaspoon grated fresh ginger root",
    "1 teaspoon crushed garlic",
    "0.5 cup white wine",
    "0.5 teaspoon white sugar",
    "2 Cornish game hens, halved lengthwise"
  ],
  "steps": [
    {
      "text": "In shallow dish, mix the soy sauce, apricot preserves, ginger, garlic, wine, and sugar. Place the hens in the dish, and coat with the marinade. Cover, and allow to marinate in the refrigerator 8 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange the hen halves in a baking dish. Pour remaining marinade over the hens. Bake uncovered 1 hour and 15 minutes in the preheated oven, basting frequently with the marinade, until hen juices run clear.",
      "section": null,
      "name": null,
      "url": null,
