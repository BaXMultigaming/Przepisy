  "ingredients": [
    "0.5 pound bacon",
    "1 pound fresh chicken livers",
    "4 tablespoons honey"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut bacon slices in half; wrap bacon around each chicken liver, securing with toothpicks. Place on a broiler pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until bacon is cooked and crisp and livers are cooked through, 12 to 16 minutes, flipping halfway through. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with honey in a small dipping bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
