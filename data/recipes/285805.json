  "ingredients": [
    "2 (4 ounce) swordfish steaks",
    "1 medium orange bell pepper, thinly sliced",
    "2 cups white wine",
    "0.5 cup minced shallot"
  ],
  "steps": [
    {
      "text": "Place swordfish in a 9x13-inch baking dish. Place bell pepper slices around the fish. Pour wine over top and sprinkle with shallots. Cover and marinate in the refrigerator for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Remove fish from the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, basting occasionally with the wine marinade, until fish flakes easily with a fork, 20 to 30 minutes.",
      "section": null,
