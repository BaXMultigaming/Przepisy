  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat. Lightly coat a sheet of aluminum foil with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash black beans in a medium bowl with a fork until thick and pasty.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gcoNi7VRxbJSR-mgQiZzX7CEsEU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/85452-Homemade-Black-Bean-Veggie-Burger-ddmfs-Step-1-103019-4x3-04d268b8c9d846628ac5130b8a4c6973.jpg"
      ],
      "image": "assets/images/85452/step_02.webp"
    },
    {
      "text": "Finely chop bell pepper, onion, and garlic in a food processor. Stir chopped vegetables into mashed beans.",
