  "ingredients": [
    "3 large carrots, shredded",
    "1 cup raisins",
    "1 cup walnuts",
    "0.25 cup finely chopped celery",
    "2 tablespoons shredded coconut",
    "0.5 cup mayonnaise",
    "2 tablespoons sour cream",
    "1 tablespoon cider vinegar",
    "0.5 teaspoon white sugar",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Combine carrots, raisins, walnuts, celery, and coconut in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together mayonnaise, sour cream, vinegar, sugar, and salt in a medium bowl until well combined; stir into carrot mixture until evenly coated. Chill in the refrigerator before serving, 2 to 3 hours.",
      "section": null,
