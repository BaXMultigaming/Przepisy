  "ingredients": [
    "1 fresh, ripe mango",
    "0.5 red onion, finely diced",
    "1 bunch cilantro, finely chopped",
    "0.5 green bell pepper, minced",
    "1 fresh red chile pepper, seeded and chopped",
    "4 skinless, boneless chicken breasts",
    "1 egg",
    "0.25 cup milk",
    "1 cup dried bread crumbs",
    "0.25 cup olive oil",
    "1 sprig fresh cilantro, for garnish"
  ],
  "steps": [
    {
      "text": "TO MAKE SALSA: In a small bowl, combine the mango, onion, cilantro, green bell pepper and red chile pepper. Put aside until serving time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly pound the chicken breasts with a mallet to flatten. Beat the egg and milk together. Then coat them in the egg/milk mixture then the breadcrumbs. Chill for 1/2 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Saute the chicken in olive oil until cooked through and juices run clear. Drain and serve with the mango salsa. Garnish with cilantro leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
