  "ingredients": [
    "1.5 tablespoons brown sugar",
    "1.5 tablespoons white sugar",
    "1 teaspoon cinnamon",
    "1.25 cups all-purpose flour",
    "1 teaspoon cinnamon",
    "1 teaspoon baking powder",
    "1.25 cups white sugar",
    "0.5 cup unsalted butter",
    "3 large eggs",
