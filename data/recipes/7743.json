  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour one 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the cake mix, 1 box of the instant pistachio pudding, the vegetable oil, club soda, eggs, and 1/2 cup of the chopped walnuts. Stir until just combined and pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 45 minutes. Let cake cool then frost.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Frosting: Beat the milk into the remaining box of pistachio pudding. Prepare topping mix according to package directions. Fold into pudding mixture. Spread over top of cooled cake and sprinkle with walnuts and maraschino cherries.",
