  "ingredients": [
    "2.5 cups peeled, cored and sliced apples",
    "1 teaspoon ground cinnamon",
    "1 teaspoon white sugar",
    "1 cup white sugar",
    "0.75 cup margarine, melted",
    "0.5 cup chopped pecans",
    "1 cup all-purpose flour",
    "1 egg, lightly beaten",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9 inch pie pan with margarine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill 2/3 of the pan with sliced apples. Sprinkle with cinnamon and 1 teaspoon sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix 1 cup sugar with the melted margarine. Stir in pecans, flour, egg and salt. Mix well. Spread mixture over the apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 65 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
