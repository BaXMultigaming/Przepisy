  "ingredients": [
    "100 (3.5 inch square) wonton wrappers",
    "1.75 pounds ground pork",
    "1 tablespoon minced fresh ginger root",
    "4 cloves garlic, minced",
    "2 tablespoons thinly sliced green onion",
    "4 tablespoons soy sauce",
    "3 tablespoons sesame oil",
    "1 egg, beaten",
    "5 cups finely shredded Chinese cabbage"
  ],
  "steps": [
    {
      "text": "Combine pork, ginger, garlic, green onion, soy sauce, sesame oil, egg and cabbage in a large bowl. Stir until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EiTUFKJrmavgsaEhgupKztkgbAU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14759-pork-dumplings-step-1-262-3x4-3de0d890311f49c79a525f977a8345cc.jpg"
      ],
      "image": "assets/images/14759/step_01.webp"
    },
    {
      "text": "Place 1 heaping teaspoon of pork filling in the center of each wonton wrapper. Moisten edges with water and fold over to form a triangle. Press edges firmly to seal. Keep filled dumplings covered with a damp towel to prevent drying out until ready to cook.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rWnSmbpCOzkKq6tmdxINqE7yu9o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14759-pork-dumplings-step-4-280-3x4-f3bd400bfe894efdb6c4048397e61fde.jpg"
      ],
      "image": "assets/images/14759/step_02.webp"
    },
    {
      "text": "Arrange dumplings in a covered bamboo or metal steamer lined with parchment, making sure they're not touching to prevent them from sticking together; steam over simmering water until pork is cooked through, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iQ3tCOkPON-tOhhHinUNQk8rSVE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14759-pork-dumplings-step-7-294-3x4-0399cdac8a8f46d6977af0ff83e6e34e.jpg"
      ],
      "image": "assets/images/14759/step_03.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
