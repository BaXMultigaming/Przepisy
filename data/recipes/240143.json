  "ingredients": [
    "2 cups water",
    "0.66666668653488 cup nonfat dry milk powder",
    "0.5 cup margarine, melted",
    "6 tablespoons white sugar",
    "2 eggs",
    "0.25 cup sucralose sugar substitute (such as Splenda®)",
    "4 teaspoons baking powder",
    "2.5 teaspoons salt",
    "2 teaspoons ground thyme",
    "1 teaspoon baking soda",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon dried minced onion",
    "0.25 teaspoon black pepper",
    "2 cups all-purpose flour",
    "2 cups whole wheat flour",
    "2 sweet-tart apples (such as Gala), cored and chopped",
    "0.5 cup chopped celery"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease 24 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk water, milk powder, margarine, white sugar, eggs, sucralose, baking powder, salt, thyme, baking soda, onion powder, garlic powder, minced onion, and black pepper together in a large bowl. Whisk all-purpose flour and whole wheat flour into milk powder mixture until batter is thick. Fold apples and celery into batter; spoon into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Rotate muffin pans and bake until set and golden, 5 to 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
