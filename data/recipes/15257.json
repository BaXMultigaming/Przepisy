  "steps": [
    {
      "text": "Combine 4 cups water and chicken broth in a large saucepan over high heat; bring to a boil. Add chicken, carrots, celery, onion, and bouillon cubes. Reduce the heat to low, cover, and simmer until vegetables are tender, about 15 minutes.",
      "section": null,
      "name": null,
