  "ingredients": [
    "0.5 cup vegetable oil",
    "1 cup milk",
    "2 eggs",
    "3.5 cups all-purpose flour",
    "1 cup white sugar",
    "4 teaspoons baking powder",
    "1 teaspoon salt",
    "1 cup chopped strawberries",
    "1 cup blueberries",
    "2 tablespoons strawberry jam"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease 12 muffins cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, milk, and eggs together in a bowl. Combine flour, sugar, baking powder, and salt together in a separate bowl; fold in strawberries, blueberries, and jam. Stir milk mixture into flour mixture until just combined. Fill muffin cups with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, about 25 minutes. Cool in the muffin tin for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
