  "ingredients": [
    "cooking spray",
    "0.66666668653488 cup packed brown sugar",
    "0.5 cup unsalted butter, melted",
    "3 cups fresh apricots, pitted and sliced",
    "1.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.66666668653488 cup white sugar",
    "0.5 cup unsalted butter, softened",
    "2 eggs",
    "0.5 cup sour cream",
    "0.5 cup water",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a fluted tube pan (such as Bundt®) with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar and melted butter in a small bowl and spread evenly over the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat the apricot slices with a paper towel to soak up any excess liquid. Line them on the bottom of the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, salt, and cinnamon together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar and softened butter in a bowl using an electric mixer until creamy and fluffy. Beat in eggs until thoroughly mixed. Add the flour mixture, sour cream, water, and vanilla extract. Beat well. Spread the batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the center of the preheated oven, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
