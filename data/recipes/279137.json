  "ingredients": [
    "2 cups rolled oats",
    "1 cup peanut butter",
    "1 cup crushed walnuts",
    "0.5 cup semisweet chocolate chips",
    "0.25 cup honey, or more as needed"
  ],
  "steps": [
    {
      "text": "Beat oats, peanut butter, walnuts, chocolate chips, and honey in the bowl of a stand mixer fitted with the paddle attachment until well combined, adding more honey if mixture is not holding together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop mixture with a cookie scoop and form into 24 balls; place on a cookie sheet. Refrigerate until firm, 30 to 60 minutes.",
      "section": null,
