  "ingredients": [
    "3 (1 pound) packages Farmland® Fresh Ground Pork",
    "1 small sweet onion, chopped",
    "0.75 cup feta cheese crumbles",
    "0.75 cup shredded Cheddar cheese",
    "0.25 cup Worcestershire sauce",
    "0.25 cup hot sauce",
    "2 tablespoons minced garlic",
    "Fresh cracked black pepper",
    "Coarse sea salt"
  ],
  "steps": [
    {
      "text": "Heat charcoal or gas grill to medium. Combine ground pork, onion, cheeses, Worcestershire sauce, hot sauce and garlic in large bowl; mix well with hands. Shape into 1-inch thick patties (9 to 12); sprinkle pepper and salt on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "If a smokier flavor is wanted, add a small handful of pecan or oak wood chips to fire about 10 minutes before putting patties on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill burgers approximately 15 minutes until internal temperature reaches 165 degrees F, turning every 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
