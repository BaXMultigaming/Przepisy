  "ingredients": [
    "4 (1 ounce) squares semisweet chocolate, chopped",
    "2 (8 ounce) packages cream cheese, softened",
    "0.5 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "2 eggs",
    "1 (9 inch) prepared chocolate cookie crumb crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C.) In the top of a double boiler, heat chocolate, stirring occasionally, until chocolate is melted and smooth. Remove from heat and allow to cool to lukewarm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat the cream cheese, sugar and vanilla until smooth. Slowly beat in eggs, one at a time. Blend in melted chocolate. Pour filling into crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 minutes, or until filling is set. Allow to cool. Refrigerate for at least 3 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
