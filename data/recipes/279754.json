  "ingredients": [
    "0.5 cup packed all-purpose flour",
    "0.25 teaspoon fine salt",
    "0.25 teaspoon pure vanilla extract",
    "3 large eggs, at room temperature",
    "0.66666668653488 cup milk, at room temperature",
    "3 tablespoons clarified butter, melted",
    "0.33333334326744 cup fresh blueberries, or more to taste",
    "1 tablespoon unsalted butter, melted",
    "0.5 Meyer lemon, juiced",
    "2 tablespoons powdered sugar, or to taste",
    "2 tablespoons maple syrup, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, salt, vanilla extract, eggs, and milk in a high-speed blender. Blend on high speed until completely smooth and very thin, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a 9- or 10-inch cast iron skillet over high heat; add clarified butter into the skillet and use a pastry brush to grease the sides. Heat butter until just starting to smoke.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Quickly and carefully pour the batter into the center of the skillet, then sprinkle blueberries over top. Transfer skillet to the center of the preheated oven and bake until browned and nicely puffed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully remove from the oven and immediately brush the top with melted butter. Squeeze lemon juice over top as Dutch baby deflates. Dust with powdered sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut in wedges to serve and drizzle with maple syrup.",
      "section": null,
      "name": null,
      "url": null,
