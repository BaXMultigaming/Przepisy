  "ingredients": [
    "cooking spray",
    "1 pound ground beef",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "1 (10.5 ounce) can condensed cream of celery soup",
    "1 (8 ounce) can sliced water chestnuts, drained",
    "1 cup diced celery",
    "0.75 cup water",
    "0.66666668653488 cup shredded Colby-Jack cheese",
    "0.5 cup sliced almonds",
    "0.5 cup sliced mushrooms",
    "2 tablespoons soy sauce",
    "0.5 teaspoon ground black pepper",
    "1 (5 ounce) can chow mein noodles"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0frTKRporIeQlZZDRbrV0igJga8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236244-ground-beef-chinese-casserole-VAT-step-01-adef431846754472b1b557b520723582.jpg"
      ],
      "image": "assets/images/236244/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Transfer beef to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3OE8pvdgD5wFkkNmavDgpd5iMYY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236244-ground-beef-chinese-casserole-VAT-step-02-f0a4c0168bcb4804a1f66c107b5b3500.jpg"
      ],
      "image": "assets/images/236244/step_02.webp"
    },
    {
      "text": "Add condensed soups, water chestnuts, celery, water, Colby-Jack cheese, almonds, mushrooms, soy sauce, and pepper to the baking dish; stir with beef until well combined. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OLYCr5mRrXhQnTs-XrMB9JA4OpM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236244-ground-beef-chinese-casserole-VAT-step-03-f6baae2f0747493b9cd644bb1c6c100f.jpg"
      ],
      "image": "assets/images/236244/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Remove foil and sprinkle chow mein noodles over top of casserole. Continue baking until casserole is browned around the edges, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M6hi9DBd9Y54Qx58Cx9NxyCQ82A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236244-ground-beef-chinese-casserole-VAT-step-04-82b1946ac0a04c478586525c519d991d.jpg"
      ],
      "image": "assets/images/236244/step_04.webp"
    }
