  "ingredients": [
    "1 (14 ounce) package individually wrapped caramels, unwrapped",
    "0.33333334326744 cup sweetened condensed milk",
    "1 (18.25 ounce) package German chocolate cake mix",
    "0.75 cup butter, melted",
    "0.5 cup sweetened condensed milk",
    "1 cup semisweet chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place caramels and 1/3 cup condensed milk in a microwave-safe bowl. Microwave until caramels melted, stirring every 30 seconds. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, melted butter, and 1/2 cup condensed milk in a large bowl; stir well. Pour 1/2 the batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cake from oven; cover with caramel mixture, chocolate chips, and walnuts. Pour remaining batter on top. Bake 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
