  "title": "Rye Beer Bread",
  "description": "Beer and rye complement each other well in this robust light bread, each bringing out the unique flavors of the other. Be sure to use a quality beer to ensure a good result.",
  "authors": [
    "Kitty"
  ],
  "date_published": "1998-07-16T19:07:34-04:00",
