  "title": "Oatmeal Banana Nut Cookies",
  "description": "An easy, oatmeal-based, drop cookie with the addictive taste of banana nut bread.",
  "authors": [
    "Shay Shih"
  ],
  "date_published": "1998-01-12T00:57:36-05:00",
