  "title": "Angela's Awesome Chicken Enchiladas",
  "description": "These creamy chicken enchiladas are stuffed with tender chicken and green chiles with enchilada sauce and cheese for an easy, family-pleasing dinner.",
  "authors": [
    "MomSavedbyGrace"
  ],
  "date_published": "2005-03-03T22:33:57-05:00",
