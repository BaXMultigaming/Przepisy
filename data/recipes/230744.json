  "ingredients": [
    "1 bunch fresh asparagus, trimmed",
    "2 tablespoons vegetable oil",
    "salt and ground black pepper to taste",
    "0.5 cup lemon juice",
    "1 tablespoon butter",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Set the oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat asparagus with oil on a baking sheet and arrange in an even layer. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook under the preheated broiler until lightly browned at the tips, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine lemon juice, butter, 1 teaspoon salt, and 1 teaspoon black pepper in a microwave-safe bowl. Heat in the microwave on high until butter is completely melted, about 1 minute; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour butter mixture over broiled asparagus and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
