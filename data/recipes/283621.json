  "ingredients": [
    "12 large hard-boiled eggs, peeled",
    "0.33333334326744 cup mayonnaise",
    "1 tablespoon pickle relish",
    "1 teaspoon Dijon mustard",
    "1 teaspoon yellow mustard",
    "1 teaspoon apple cider vinegar",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 teaspoon ground paprika"
  ],
  "steps": [
    {
      "text": "Slice eggs in half lengthwise and remove yolks. Place yolks in a medium bowl and set whites aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash yolks with a fork. Add mayonnaise, relish, Dijon, yellow mustard, vinegar, salt, and pepper; stir until well combined and smooth. Transfer to a large zip-top bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange egg whites on a tray. Snip off the bottom corner of the zip-top bag. Fill each white with about 1 1/2 to 2 teaspoons filling. Sprinkle with paprika.",
      "section": null,
      "name": null,
      "url": null,
