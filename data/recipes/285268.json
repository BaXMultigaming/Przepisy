  "ingredients": [
    "2 pounds mixed potatoes, chopped",
    "1 medium lemon, zested and juiced, divided",
    "4 tablespoons extra virgin olive oil, divided",
    "2 cloves garlic, minced",
    "kosher salt and freshly ground black pepper to taste",
    "0.25 cup roughly chopped fresh dill",
    "0.25 cup roughly chopped basil leaves",
    "2 tablespoons chopped fresh chives",
    "8 ounces burrata cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss potatoes, lemon juice, 2 tablespoons olive oil, garlic, and a small pinch each of kosher salt and pepper together on a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 20 minutes. Toss and continue roasting until golden and crisp, 20 to 25 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile combine remaining 2 tablespoons of olive oil, dill, basil, chives, and lemon zest in a small bowl. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove potatoes from the oven and transfer to a serving plate. Tear burrata cheese into pieces and place over top. Drizzle with lemon-herb mix and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
