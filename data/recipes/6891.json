  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup chopped walnuts",
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1 cup apples - peeled, cored and shredded"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, baking soda, and salt together in a medium bowl. Stir in walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat sugar, butter, and one egg until smooth. Beat in remaining egg, then vanilla. Stir in shredded apples, then stir in flour mixture just until moistened. Spread into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 50 to 60 minutes. Let stand for 10 minutes, then remove from the pan and finish cooling on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
