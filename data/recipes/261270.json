  "ingredients": [
    "cooking spray",
    "2 cups peeled and shredded sweet potatoes",
    "1 (16 ounce) package lean breakfast turkey sausage links",
    "2 cups fresh spinach",
    "12 large egg whites",
    "0.25 cup almond milk",
    "0.75 teaspoon dried sage",
    "0.25 teaspoon red pepper flakes",
    "0.25 teaspoon ground thyme",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon dried basil",
    "1 pinch ground nutmeg",
    "salt and ground black pepper to taste",
    "1 tablespoon grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread sweet potatoes evenly over the bottom of the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large saucepan over medium heat. Add turkey sausage and spinach; cook and stir until turkey is browned and spinach is wilted, about 5 minutes. Remove from heat. Add to sweet potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crack egg whites into a large bowl; add almond milk, sage, red pepper flakes, thyme, oregano, basil, nutmeg, salt, and pepper. Stir well. Pour egg mixture over the top of the casserole. Sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, about 45 minutes. Cut casserole into 6 pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
