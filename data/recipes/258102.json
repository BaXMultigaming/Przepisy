  "title": "Weenieladas",
  "description": "Hot dogs wrapped in corn tortillas and topped with chili and cheese are a fun dinner to serve on Halloween. Just call them Hallo-weenieladas!",
  "authors": [
    "russmichaels"
  ],
  "date_published": "2020-06-23T17:52:20-04:00",
