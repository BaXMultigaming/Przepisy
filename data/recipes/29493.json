  "ingredients": [
    "2 tablespoons oil",
    "2 cloves garlic, crushed",
    "0.25 cup brown sugar",
    "3 green onions, sliced",
    "0.25 cup oyster sauce",
    "1 cup water",
    "2 pounds salmon fillets",
    "1 tablespoon cornstarch",
    "2 tablespoons warm water"
  ],
  "steps": [
    {
      "text": "Heat oil in a medium skillet over medium heat. Stir in garlic and brown sugar, and cook until garlic is lightly browned. Stir in green onions, and cook until tender. Mix in oyster sauce and water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon fillets into skillet, and reduce heat to medium low. Spoon sauce mixture over fillets. Cook 10 to 15 minutes, until fish is easily flaked with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove fish from skillet, and set aside. Mix cornstarch and warm water into the remaining sauce mixture. Stir until thickened to desired consistency. Pour over salmon to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
