  "ingredients": [
    "2 cups penne pasta",
    "2 tablespoons butter",
    "0.5 cup heavy whipping cream",
    "0.5 cup half-and-half",
    "0.5 teaspoon garlic salt",
    "1 cup shredded Gruyere cheese",
    "1 cup shredded mozzarella cheese, divided",
    "0.5 cup shredded Parmesan cheese",
    "0.5 cup Oaxaca cheese, shredded",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a saucepan over medium heat. Stir in cream, half-and-half, and garlic salt. Add Gruyere cheese, 1/2 cup mozzarella cheese, Parmesan cheese, and Oaxaca cheese. Stir into cream until melted. Drain pasta and add to the sauce; stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a casserole dish with cooking spray and pour in pasta mixture. Sprinkle with remaining 1/2 cup mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is bubbly and slightly browned, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
