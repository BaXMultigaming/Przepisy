    "10 large marshmallows"
  ],
  "steps": [
    {
      "text": "Place chocolate chips in a microwave-safe bowl; microwave in 30-second intervals, stirring after each interval, until melted. Do not overheat or chocolate will scorch.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pierce marshmallows with a toothpick or fork; dip into chocolate. Place on waxed paper or aluminum foil; freeze. Set aside marshmallows at room temperature before serving for 5 minutes.",
