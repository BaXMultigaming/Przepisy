  "title": "Croissants",
  "description": "This authentic French croissant recipe requires a methodical approach and patience, but the delicious flaky results are totally worth the effort.",
  "authors": [
    "Katherine Foster"
  ],
  "date_published": "1998-09-03T22:34:54-04:00",
