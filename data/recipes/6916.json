    "publisher-tested"
  ],
  "ingredients": [
    "3 tablespoons warm water (110 degrees F/45 degrees C)",
    "1.25 teaspoons active dry yeast",
    "1 teaspoon white sugar",
    "1.75 cups all-purpose flour",
    "0.66666668653488 cup warm milk",
    "2 teaspoons white sugar",
    "1.5 teaspoons salt",
    "2 tablespoons vegetable oil",
    "0.66666668653488 cup unsalted butter, chilled",
    "1 large egg",
    "1 tablespoon water"
  ],
  "steps": [
    {
      "text": "Combine warm water, yeast, and 1 teaspoon sugar in a small bowl. Let stand until yeast softens and begins to form a creamy foam, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Measure flour into a mixing bowl. Combine warm milk, 2 teaspoons sugar, and salt in a separate bowl; blend milk mixture, yeast mixture, and oil into flour. Mix well and knead until smooth. Cover, and let rise until over tripled in volume, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nRaH4ER2yYMUXg5DhpWQhUY693s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6916_Croissants_ddmfs_Shot1_3x4_3699-524d80e7da8948cfa94f987ed963730a.jpg"
      ],
      "image": "assets/images/6916/step_02.webp"
    },
    {
      "text": "Deflate gently, and let rise again until doubled, about another 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j5uQDBJZeXUWGrkBqvfcaeUjdoA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6916_Croissants_ddmfs_Shot2_3x4_3822-0e3e65115c484f3b97e2ad5010a59858.jpg"
      ],
      "image": "assets/images/6916/step_03.webp"
    },
    {
      "text": "Deflate dough and chill for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Massage butter until pliable, but not soft and oily. Pat dough into a 14x8-inch rectangle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KLw2iPizX3tEmgZ1iOthfGPiPdA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6916_Croissants_ddmfs_Shot3_3x4_3825-bfbbac6404bb40d79c0c88c3cbb7f601.jpg"
      ],
      "image": "assets/images/6916/step_05.webp"
    },
    {
      "text": "Smear butter over top two-thirds, leaving a 1/4-inch margin all around. Fold unbuttered third over middle third, and buttered top third down over that.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/so0DNw3He8GO4IF39jMwoz-v1p0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6916_Croissants_ddmfs_Shot5_3x4_3829-21cc88b88c08450e9359e73aad6e5a3b.jpg"
      ],
      "image": "assets/images/6916/step_06.webp"
    },
    {
      "text": "Turn 90 degrees, so that folds are to left and right. Roll out to a 14x6-inch rectangle. Fold in three again. Sprinkle lightly with flour, and put dough in a resealable plastic bag. Refrigerate for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a-BsCjGHrm4Kdf4ax_yAT1tyBxI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6916_Croissants_ddmfs_Shot6_3x4_3830-8d12cfe96a9d4fc0864c2e80ecc44102.jpg"
      ],
      "image": "assets/images/6916/step_07.webp"
    },
    {
      "text": "Unwrap, sprinkle with flour, and deflate gently. Roll to a 14x6-inch rectangle, and fold again. Turn 90 degrees, and repeat. Wrap and chill 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 475 degrees F (245 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To shape, roll dough out to a 20x5-inch rectangle. Cut in half crosswise, and chill half while shaping the other half. Roll out to a 15x5-inch rectangle. Cut into three 5x5-inch squares. Cut each square in half diagonally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7kxZEuJXlBbtETiDaThaMQWKyts=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6916_Croissants_ddmfs_Shot7_3x4_3833-09345a6ead0342ca9d08fbccdd6fcdbc.jpg"
      ],
      "image": "assets/images/6916/step_10.webp"
    },
    {
      "text": "Roll each triangle lightly to elongate the point, and make it 7 inches long. Grab the other 2 points, and stretch them out slightly as you roll it up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0GZyB6t4XWXwX_yq47rIQxgAHz0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6916_Croissants_ddmfs_Shot9_3x4_3838-0cf477e0f2cf4477b99cb6712748b61e.jpg"
      ],
      "image": "assets/images/6916/step_11.webp"
    },
    {
      "text": "Place on a baking sheet, curving slightly. Let shaped croissants rise until puffy and light.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NjknU8XTkMk0a7TDVA__3SZRCYg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6916_Croissants_ddmfs_Shot10_3x4_3845-c9f6162a30004a1c9811e402a0aa25f6.jpg"
      ],
      "image": "assets/images/6916/step_12.webp"
    },
    {
      "text": "In a small bowl, beat together egg and 1 tablespoon water. Glaze croissants with egg wash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crisp, flaky, and golden brown, about 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/umNXK2x2E144GBZVzOxUkfg0VYo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6916_Croissants_ddmfs_3x4_3880-247a81a8597748cd8381d00f8ae31d36.jpg"
      ],
      "image": "assets/images/6916/step_14.webp"
    }
  ],
