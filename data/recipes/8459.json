  "title": "Walnut Pumpkin Roll",
  "description": "This is the best walnut pumpkin roll recipe I've ever made. Everyone who tastes it asks for the recipe. Dust with confectioners' sugar for a nice presentation.",
  "authors": [
    "BUCHKO"
  ],
  "date_published": "1999-11-18T07:19:33-05:00",
