  "ingredients": [
    "4 cups bow-tie pasta (farfalle)",
    "0.25 cup butter",
    "0.25 cup chicken broth",
    "3 tablespoons lemon juice",
    "0.25 teaspoon oregano",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon minced garlic",
    "1 pinch salt and ground black pepper to taste"
  ],
  "steps": [
