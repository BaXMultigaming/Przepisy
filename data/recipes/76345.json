  "ingredients": [
    "1 (16 ounce) package uncooked macaroni",
    "8 hard-cooked eggs, grated",
    "1 medium red onion, finely chopped",
    "1 (10 ounce) jar dill pickle relish, partially drained",
    "1 (6 ounce) can black olives, drained and chopped",
    "0.5 cup mayonnaise, or as needed",
    "1 tablespoon prepared yellow mustard, or to taste",
    "salt and black pepper to taste",
    "4 hard-cooked eggs, sliced",
    "paprika to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss cooked macaroni, grated eggs, onion, relish with some of the liquid, and olives in a large bowl. Stir in mayonnaise and mustard; season with salt and pepper. Top with sliced eggs and sprinkle with paprika to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
