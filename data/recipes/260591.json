  "title": "Hawaiian Beef Stew",
  "description": "This hearty Hawaiian beef stew is made of beef chuck, potatoes, and carrots simmered together and enhanced with tomato paste, red wine, and spices.",
  "authors": [
    "Laurie Sueko Lau"
  ],
  "date_published": "2020-06-19T00:24:46-04:00",
