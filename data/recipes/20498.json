  "title": "Asparagus Quiche",
  "description": "This asparagus quiche is packed with fresh spring asparagus, crispy bacon, and Swiss cheese baked in a flaky pie crust for a delicious brunch dish.",
  "authors": [
    "Michele O'Sullivan"
  ],
  "date_published": "2000-06-09T00:31:14-04:00",
