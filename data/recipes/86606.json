  "ingredients": [
    "1 (16 ounce) package shredded coleslaw mix",
    "0.25 cup finely chopped sweet onion",
    "0.5 cup cider vinegar",
    "3 tablespoons white sugar",
    "1 teaspoon salt",
    "0.5 cup mayonnaise",
    "0.5 cup sour cream",
    "0.5 cup crumbled blue cheese",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Toss together the coleslaw mix and onion in a bowl. In a saucepan, mix the vinegar, sugar, and 1 teaspoon salt. Bring to a boil. When sugar has dissolved, pour over the slaw mix and onion. Toss to coat, and let stand 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain the slaw mix in a colander, and return to the bowl. Toss with mayonnaise, sour cream, and blue cheese. Season with salt and pepper. Cover and chill at least 1 hour in the refrigerator before serving.",
      "section": null,
