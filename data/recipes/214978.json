  "title": "Custard Ice Cream Base",
  "description": "This ice cream base makes a classic custard ice cream with egg yolks, heavy cream, and sugar for the richest, smoothest, creamiest homemade ice cream.",
  "authors": [
    "Autumn Pumpkin"
  ],
  "date_published": "2020-06-18T23:42:47-04:00",
