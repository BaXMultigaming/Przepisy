  "ingredients": [
    "1 cup all-purpose flour",
    "0.75 cup yellow cornmeal",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "2 eggs, well beaten",
    "1 cup canned unsweetened pumpkin puree",
    "0.5 cup packed dark brown sugar",
    "0.25 cup canola oil",
    "1 cup coarsely chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Grease muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir flour, cornmeal, baking powder, baking soda, and salt and make a well in the center. In a small bowl, stir together the eggs, pumpkin, sugar, and oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make a well in the center of the dry ingredients and pour in the egg mixture. Stir just until blended; do not over mix. Fold in pecans. Divide the batter evenly among prepared muffin tin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 15 to 18 minutes, until a toothpick inserted into center of a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
