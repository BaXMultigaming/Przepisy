  "ingredients": [
    "2 slices whole wheat bread",
    "2 pounds ground beef",
    "1 cup medium salsa",
    "1 green onion, chopped",
    "2 tablespoons chopped onion",
    "2 tablespoons whole grain Dijon mustard",
    "2 tablespoons minced garlic",
    "1 teaspoon Worcestershire sauce",
    "salt and pepper to taste",
    "1 tablespoon barbeque sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Soak bread in enough warm water to cover in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beef in a large bowl. Add salsa, green onion, onion, Dijon mustard, garlic, Worcestershire sauce, salt, and pepper to the bowl. Drain bread and add to beef. Mix by hand until well blended. Form into a loaf and place into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Drain off excess fat and top with barbeque sauce. Return to the oven and bake for 15 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
