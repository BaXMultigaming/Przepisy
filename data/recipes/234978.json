  "ingredients": [
    "1 cup white sugar",
    "0.75 cup vegetable oil",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon salt",
    "3 McIntosh apples, peeled and coarsely chopped, or more to taste",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease or line 12 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and oil together in a bowl using an electric mixer until smooth, about 2 minutes. Beat eggs and vanilla extract into sugar mixture until smooth, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cinnamon, baking soda, and salt together in a separate bowl; beat into sugar mixture until batter is just combined. Fold apples and walnuts into batter; spoon into muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
