  "ingredients": [
    "5 tablespoons white sugar",
    "2 teaspoons ground cinnamon",
    "4 medium baking apples - peeled, cored, and sliced",
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "1 cup vegetable oil",
    "4 large eggs",
    "1 orange, juiced",
    "3 teaspoons baking powder",
    "2.5 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a fluted tube pan (such as Bundt).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 5 tablespoons sugar and cinnamon in a large bowl; add apples and toss to coat. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 2 cups sugar, oil, eggs, orange juice, baking powder, and vanilla extract in a separate large bowl until batter is moist and thick. Pour some batter into the prepared pan to cover the bottom; layer with some sugared apple slices. Repeat layering batter and apples into the pan, finishing with batter on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
