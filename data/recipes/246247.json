  "ingredients": [
    "1 small head cabbage, shredded",
    "0.25 cup rock salt",
    "1 small carrot, cut into thin strips",
    "3 tablespoons vinegar",
    "2 tablespoons vegetable oil",
    "1 tablespoon white sugar, or to taste",
    "1 teaspoon sesame oil",
