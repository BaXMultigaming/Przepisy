  "ingredients": [
    "24 vanilla wafer cookies",
    "2 (8 ounce) packages cream cheese, softened",
    "0.75 cup white sugar",
    "2 eggs",
    "2.5 tablespoons lemon juice",
    "1 teaspoon vanilla extract",
    "1 (12 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two 12-cup muffin tins with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 vanilla wafer in the bottom of each muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, sugar, eggs, lemon juice, and vanilla in a bowl until fluffy. Spoon mixture into the muffin cups, filling each ⅔ full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is set, 15 to 20 minutes. Cool completely, about 1 ½ hours. Spoon pie filling with about 2 or 3 cherries over each cheesecake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
