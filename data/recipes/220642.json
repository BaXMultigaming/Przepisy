  "ingredients": [
    "2 tablespoons canola oil",
    "2 garlic cloves, peeled",
    "2 (15 ounce) cans pinto beans",
    "1 teaspoon cumin",
    "1 teaspoon chili powder",
    "salt to taste",
    "0.5 lime, juiced"
  ],
