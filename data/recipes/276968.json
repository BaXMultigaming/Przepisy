  "ingredients": [
    "1.5 tablespoons vegetable oil",
    "0.75 pound cubed beef stew meat",
    "2 tablespoons chili powder",
    "1 teaspoon ground cumin",
    "2 tablespoons all-purpose flour",
    "1 (28 ounce) can diced tomatoes",
    "1 (16 ounce) can black beans, rinsed and drained",
    "1 (16 ounce) can kidney beans, rinsed and drained",
    "1.75 cups beef broth, divided",
    "1 large onion, chopped",
    "1 small green or red bell pepper, chopped",
    "0.25 cup chopped fresh parsley",
    "2 tablespoons barbecue sauce",
    "1.5 tablespoons brown sugar",
    "2 cloves garlic, or more to taste, minced",
    "0.75 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VANS2vJiG8-GS0T7frT3S--A_4Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276968-SlowCookedStewMeatChili-ddmfs-Step1-3x4-8564-bed4ac99bfab407d86a95bda278bab11.jpg"
      ],
      "image": "assets/images/276968/step_01.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add beef; cook and stir until browned, about 3 to 5 minutes. Add chili powder and cumin; cook and stir until fragrant, about 1 minute. Stir in flour and cook for 1 minute more. Transfer meat to a large slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uzWABDS685ii_ocB1eE_nAYPGF8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276968-SlowCookedStewMeatChili-ddmfs-Step4-3x4-8570-352981df9de94e5c8274c5dee10475a5.jpg"
      ],
      "image": "assets/images/276968/step_02.webp"
    },
    {
      "text": "Stir in diced tomatoes, black beans, kidney beans, 1 1/2 cups beef broth, onion, bell pepper, parsley, barbecue sauce, brown sugar, garlic, and salt until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/__zykkhWp0_dfjFHmgc-7lekyP0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276968-SlowCookedStewMeatChili-ddmfs-Step5-3x4-8574-da5c967d62d3495d854c77accb507ef2.jpg"
      ],
      "image": "assets/images/276968/step_03.webp"
    },
    {
      "text": "Cover and cook on Low, stirring occasionally, until beef is tender, 6 to 8 hours. Thin chili with remaining beef broth as it cooks if the consistency is too thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/78hKyFNAn3lkwHpx9vEToK6Gf94=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276968-SlowCookedStewMeatChili-ddmfs-Step6-3x4-8769-10e435d902464d059708363a5911a27a.jpg"
