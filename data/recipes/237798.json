  "ingredients": [
    "0.66666668653488 cup creamy peanut butter",
    "0.33333334326744 cup corn syrup (such as Karo®)",
    "3 cups crushed sugar-frosted corn flake cereal (such as Frosted Flakes®)",
    "0.5 gallon coffee ice cream, softened",
    "2 tablespoons chocolate syrup, or to taste"
  ],
  "steps": [
    {
      "text": "Combine peanut butter and corn syrup in a bowl; heat in microwave until it can easily be stirred into a smooth mixture, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir crushed cereal into the peanut butter mixture; spread into a pie plate to make a crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon softened ice cream over the crust and smooth into a flat layer. Drizzle chocolate syrup over the ice cream layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put pie in freezer and freeze until firm in the center, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
