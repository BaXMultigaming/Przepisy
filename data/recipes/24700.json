  "ingredients": [
    "1 cup water",
    "2.5 tablespoons white sugar",
    "2 tablespoons vegetable oil",
    "0.5 teaspoon salt",
    "1 cup all-purpose flour",
    "2 quarts oil for frying",
    "0.5 cup white sugar, or to taste",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MIveOMoJ64J3GPv4MT1idyI3_dI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24700-churros-VAT-step-01-f000c7683f2141a9bf29aa480a373791.jpg"
      ],
      "image": "assets/images/24700/step_01.webp"
    },
    {
      "text": "Combine water, 2 ½ tablespoons sugar, 2 tablespoons vegetable oil, and salt in a small saucepan over medium heat; bring to a boil then remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VVcqkLhfRfFDazofGhL-1WNrZvM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24700-churros-VAT-step-02-bcbbe479617c459fa6109acd12abd6af.jpg"
      ],
      "image": "assets/images/24700/step_02.webp"
    },
    {
      "text": "Stir in flour, stirring constantly, until mixture forms a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m9TGM3tEnF2SexDlwSRakMZ1rD8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24700-churros-VAT-step-03-6f15e13df48d4b73bd166d6349e950d1.jpg"
      ],
      "image": "assets/images/24700/step_03.webp"
    },
    {
      "text": "Heat 2 quarts oil in a deep fryer or deep pot to 375 degrees F (190 degrees C). Transfer dough to a sturdy pastry bag fitted with a medium star tip.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZFmiIhs2f19oZksvNm0mbtAA7VY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24700-churros-VAT-step-04-b28be73b25ee43faa739d2c68d370e7b.jpg"
      ],
      "image": "assets/images/24700/step_04.webp"
    },
    {
      "text": "Carefully pipe dough, working in batches of a few 5- to 6-inch strips at a time, into the hot oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TzAhHyZk-BB1f8P22eQcsucUAzg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24700-churros-VAT-step-05-b064a2c4a096423d8aa48f240002e142.jpg"
      ],
      "image": "assets/images/24700/step_05.webp"
    },
    {
      "text": "Cook until golden; transfer churros to paper towels to drain using a spider or slotted spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Kxs_dmg5ad6iYY-d2KGt4yzbiQ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24700-churros-VAT-step-06-dc93d4d120f94cd88a907a76cd6ba6b5.jpg"
      ],
      "image": "assets/images/24700/step_06.webp"
    },
    {
      "text": "Combine ½ cup sugar and cinnamon in a bowl; roll churros in cinnamon and sugar mixture. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qq9s8jlKplKUDEo3Gtk15EAJpHc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24700-churros-VAT-hero-03-4x3-a7f6af1860934b0385f84ab9f13f2613.jpg"
