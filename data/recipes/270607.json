  "ingredients": [
    "0.5 cup water",
    "1 pound fresh broccoli, chopped",
    "2 green onions, chopped",
    "4 ounces cream cheese",
    "1 tablespoon butter",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup shredded Cheddar cheese",
    "2 tablespoons real bacon bits"
  ],
  "steps": [
    {
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot®). Add water, broccoli, green onions, cream cheese, butter, salt, and pepper. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 1 minute. Allow 10 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a potato masher, mash mixture to desired consistency. Add Cheddar cheese and bacon. Stir until cheese is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
