  "ingredients": [
    "1 tablespoon oil, or as needed",
    "1 clove garlic, minced",
    "2 pounds ground beef",
    "1.5 cups water, divided, or more as needed",
    "ground black pepper to taste",
    "2 medium red potatoes, cubed",
    "10 baby carrots, or more to taste, cubed",
    "6 tablespoons soy sauce, divided",
    "0.5 cup raisins, or more to taste",
    "1.5 (6.5 ounce) cans tomato sauce with salt (such as Contadina®)",
    "0.5 medium orange bell pepper, diced",
    "4 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DDRnO1wUk7dvdJYyPgaDtKzHGvQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265040-Filipino-Beef-Giniling-ddmfs-step-1-190-8fe6d8d68d7241f78f8dacf1355d02b9.jpg"
      ],
      "image": "assets/images/265040/step_01.webp"
    },
    {
      "text": "Heat oil in a large saucepan over medium heat. Add garlic and cook until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B1TtkcSdVIxgsPxwgpOwPj81-Gg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265040-Filipino-Beef-Giniling-ddmfs-step-2-191-6403b40c46da4b9498ea50604d1dd4c9.jpg"
      ],
      "image": "assets/images/265040/step_02.webp"
    },
    {
      "text": "Add beef and 1/2 cup water; cook and stir until browned and crumbly, 5 to 7 minutes. Season with black pepper and add more water as needed; do not let beef dry out.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OfqXofz9cGlxxFhuJxmUhwoLwPc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265040-Filipino-Beef-Giniling-ddmfs-step-3-B-194-e3fd3416911040f5b6b8988e4618f272.jpg"
      ],
      "image": "assets/images/265040/step_03.webp"
    },
    {
      "text": "Add potatoes, carrots, and 3 tablespoons soy sauce; cook for 4 minutes, adding more water if mixture is too dry. Add raisins and cook for 2 to 3 minutes, again adding water as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z-ZYKdsrxo0z1CYFr0EzLhF7fLo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265040-Filipino-Beef-Giniling-ddmfs-step-5-199-aa5bd759b37c4f8d9af8f70c4f8666ff.jpg"
      ],
      "image": "assets/images/265040/step_04.webp"
    },
    {
      "text": "Pour in one can tomato sauce. Fill the can with water and swirl to remove excess sauce; pour into the saucepan. Stir in remaining 1/2 can sauce until combined. Add more water as needed to create a saucy but not soupy consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zJ6UIjxZA4aKS44PMzMUXlnU14o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265040-Filipino-Beef-Giniling-ddmfs-step-6-200-b2d43a257946452089cf6a40b37b8401.jpg"
      ],
      "image": "assets/images/265040/step_05.webp"
    },
    {
      "text": "Stir in bell pepper, sugar, and remaining 3 tablespoons soy sauce. Cook, stirring occasionally and adding water as needed so sauce does not dry out, until all vegetables are tender, about 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PphlYH--53RLN96l5ofiV5iRwsM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265040-Filipino-Beef-Giniling-ddmfs-step-7-202-51aa9fd1320c4d48b01287c777cde71b.jpg"
      ],
      "image": "assets/images/265040/step_06.webp"
    }
