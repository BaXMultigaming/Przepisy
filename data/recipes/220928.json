  "ingredients": [
    "cooking spray",
    "2 large egg whites",
    "0.5 teaspoon almond extract",
    "1 (7 ounce) package shredded coconut",
    "0.33333334326744 cup white sugar",
    "3 tablespoons all-purpose flour",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Coat a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg whites in a glass, metal, or ceramic bowl until frothy. Whisk in almond extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine coconut, sugar, flour, and salt in a large bowl. Gently fold in egg white mixture until batter comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoonfuls of batter onto the prepared baking sheet spaced 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges start to brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cookies to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
