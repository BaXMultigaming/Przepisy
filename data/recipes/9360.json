  "ingredients": [
    "2 cups margarine",
    "4 (3 ounce) packages cream cheese",
    "4 cups all-purpose flour",
    "2.5 cups packed brown sugar",
    "3 eggs",
    "3 tablespoons melted butter",
    "0.5 teaspoon vanilla extract",
    "1 pinch salt",
    "1.5 cups chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease mini tart pans or mini muffin pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and cream cheese with an electric mixer in a large bowl until smooth. Beat in flour, 1 cup at a time, until mixture forms a smooth dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MT9idde0A_zxs-ohHGk3qRU7U1o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9360-pecan-tassies-VAT-step-02-f1b16d8755bc4291b136c00bba13b373.jpg"
      ],
      "image": "assets/images/9360/step_02.webp"
    },
    {
      "text": "Roll into small balls, and press into the bottoms and sides of prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5VO4N97l8dwhfpAQDLv4PfAQqQ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9360-pecan-tassies-VAT-step-03-b8ac45ba615842568c28a8b59eb22373.jpg"
      ],
      "image": "assets/images/9360/step_03.webp"
    },
    {
      "text": "Mix brown sugar, eggs, melted butter, vanilla, and salt together in a medium bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2apXUOssgX-mEqdFXMsjcDKpR9M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9360-pecan-tassies-VAT-step-04-101a93904e434782b8702efd0b4e388d.jpg"
      ],
      "image": "assets/images/9360/step_04.webp"
    },
    {
      "text": "Stir in pecans; spoon mixture into each crust until 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yfKaQG1FNBhwH6b1rwOAt39I2-w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9360-pecan-tassies-VAT-step-05-04c62b69ba9448a49f105a7688d3cbab.jpg"
      ],
      "image": "assets/images/9360/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until crust is golden brown and filling has puffed up, about 15 to 18 minutes. Let cool in the pans briefly before carefully transferring them onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ptwPVhS2JJA0JEheRYaN51uZPEE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9360-pecan-tassies-VAT-step-06-28435f541e0b48779eb57c96b6b176fd.jpg"
      ],
      "image": "assets/images/9360/step_06.webp"
    }
