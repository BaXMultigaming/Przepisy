  "ingredients": [
    "1 cup butter, softened",
    "0.5 cup white sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon peppermint extract",
    "2.75 cups all-purpose flour",
    "1 teaspoon cream of tartar",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 (5 ounce) milk chocolate candy bar, chopped",
    "1 cup coarsely chopped peppermint candy canes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the butter and sugar until smooth. Beat in the eggs one at a time, then stir in the vanilla and peppermint extracts. Combine the flour, cream of tartar, baking soda, and salt; stir into the creamed mixture until all of the dry has been absorbed. Mix in the chocolate chunks and chopped candy cane. Form spoonfuls of dough into balls, and place them 2 inches apart onto an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
