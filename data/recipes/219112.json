  "ingredients": [
    "1 pound ground bison",
    "0.5 cup plain breadcrumbs",
    "1 egg, beaten",
    "2 cloves garlic, minced",
    "1 teaspoon salt",
    "0.5 teaspoon freshly ground black pepper",
    "0.5 teaspoon Worcestershire sauce",
    "1 tablespoon vegetable oil",
    "3 cups water",
    "0.5 cup orange marmalade",
    "0.25 cup rice vinegar",
    "2 tablespoons Asian chile pepper sauce",
    "1 tablespoon soy sauce"
  ],
  "steps": [
    {
      "text": "Combine bison, bread crumbs, egg, garlic, salt, black pepper, and Worcestershire sauce in a large bowl; form into 24 meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a skillet over medium heat. Add meatballs; cook until nicely browned on all sides, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add water, orange marmalade, rice wine vinegar, chili sauce, and soy sauce to the skillet; bring to a simmer, reduce heat to medium-low, and cook until sauce thickens, about 1 hour.",
      "section": null,
