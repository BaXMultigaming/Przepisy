  "ingredients": [
    "1 tablespoon olive oil",
    "0.5 pound ground beef",
    "0.5 (1 ounce) packet taco seasoning mix",
    "1 (10 ounce) container refrigerated pizza crust",
    "0.75 cup pizza sauce",
    "1.5 cups shredded Mexican cheese blend",
    "1 cup 1/2-inch thick halloumi cheese slices",
    "2 tablespoons sliced black olives, or to taste",
    "1 jalapeno pepper, seeded and minced",
    "1 cup tortilla chips, crushed, or to taste",
    "10 cherry tomatoes, quartered",
    "0.5 small head lettuce, shredded",
    "1 small onion, chopped",
    "0.25 cup salsa, or to taste",
    "2 tablespoons sour cream, or to taste",
    "1 teaspoon hot sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium-high heat. Cook and stir ground beef until browned, about 5 minutes. Remove from heat; drain excess grease. Stir in taco seasoning mix and let cool, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pizza crust on a pizza pan or large baking sheet. Cover with pizza sauce. Sprinkle Mexican cheese blend on top. Cover cheese with beef mixture, halloumi cheese, olives, and jalapeno pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the crust is crispy and the Mexican cheese blend is melted, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle crushed tortilla chips over pizza. Top with cherry tomatoes, lettuce, and onion. Garnish with salsa, sour cream, and hot sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
