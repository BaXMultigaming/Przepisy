  "ingredients": [
    "1 pound butter",
    "1 large onion, chopped",
    "5 pounds large shrimp in shell (21 to 25 per lb), peeled and deveined",
    "3 (12 fluid ounce) bottles beer",
    "1 tablespoon salt"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium-high heat. Add onion; cook until translucent, about 5 minutes. Add shrimp, beer, and salt; simmer until shrimp turn pink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pot from the heat; let shrimp sit at least 30 minutes. Serve warm, or refrigerate and reheat before serving.",
