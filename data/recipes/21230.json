  "title": "Indonesian Pork Satay",
  "description": "For a Southeast Asian treat, try these grilled pork skewers, marinated in a spicy ginger-peanut sauce.",
  "authors": [
    "Debbie"
  ],
  "date_published": "2000-09-06T13:32:05-04:00",
