  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup packed brown sugar",
    "0.5 teaspoon ground cinnamon",
    "1 cup unsalted butter",
    "2 cups white sugar",
    "4 eggs",
    "0.5 cup flour",
    "0.5 teaspoon salt",
    "4 cups diced rhubarb",
    "2 cups sliced strawberries",
    "1 cup blueberries",
    "0.5 cup flour",
    "0.5 cup brown sugar, packed",
    "0.5 cup rolled oats",
    "0.25 cup butter, melted",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 13x9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make crust: Mix together flour, brown sugar, and cinnamon in a large bowl until well combined. Cut butter into flour mixture until crumbs form; press into the bottom of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake crust in the preheated oven until golden brown, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make filling: Blend sugar, eggs, flour, and salt in a blender until smooth; pour into a large bowl. Fold in rhubarb, strawberries, and blueberries until incorporated, then spread onto baked crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make topping: Mix together flour, brown sugar, oats, melted butter, and cinnamon in a medium bowl until well combined; sprinkle over fruit mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned on top and the filling has set, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
