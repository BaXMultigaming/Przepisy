  "ingredients": [
    "2 cups water",
    "1 tablespoon Chinese five-spice powder",
    "1.5 teaspoons butter",
    "1 cube beef bouillon",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon black pepper",
    "1 cup red quinoa, rinsed and drained"
  ],
  "steps": [
    {
      "text": "Combine water, Chinese five-spice powder, butter, bouillon, ginger, and black pepper in a saucepan over medium heat; bring to a boil and stir until bouillon dissolves. Add quinoa, reduce heat to a simmer, and cover. Cook until liquid is absorbed and quinoa is tender, about 20 minutes. Fluff with a fork before serving.",
