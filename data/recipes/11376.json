  "ingredients": [
    "4 ounces saltine crackers",
    "1 cup butter",
    "1 cup dark brown sugar",
    "2 cups semisweet chocolate chips",
    "0.75 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Gather all ingredients, and preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RCxfx1rlCr1JLYwFcJcoQ0NgRK8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-11376-saltine-toffee-cookies-VAT-step-01-58f1bfe4bab945128585c8bd86f39dae.jpg"
      ],
      "image": "assets/images/11376/step_01.webp"
    },
    {
      "text": "Line a rimmed baking sheet with saltine crackers in single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PBiUDzIvLGP4lu_-pEjqMVF1R1E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-11376-saltine-toffee-cookies-VAT-step-02-5c7fc7a7fc314f82833d37db69439460.jpg"
      ],
      "image": "assets/images/11376/step_02.webp"
    },
    {
      "text": "Combine butter and sugar in a saucepan. Bring to a boil; boil for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JntqcpJePGBwDU8oHeCAFnSUo-8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-11376-saltine-toffee-cookies-VAT-step-03-2a02471d7b58412eb9b700b57f8ee78c.jpg"
      ],
      "image": "assets/images/11376/step_03.webp"
    },
    {
      "text": "Immediately pour over saltines and spread to cover crackers completely. Bake in the preheated oven for 5 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CYbxqz2Q0yOADendT0dh4XlJdK0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-11376-saltine-toffee-cookies-VAT-step-04-1869e0cd1ca947b794240362c2b3c267.jpg"
      ],
      "image": "assets/images/11376/step_04.webp"
    },
    {
      "text": "Remove from the oven and sprinkle chocolate chips over top. Let sit 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vA0rN6w9NcsHP5e1S_ITFDYv4Vs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-11376-saltine-toffee-cookies-VAT-step-05-bbe761d56cc644928f1dec6b4f531888.jpg"
      ],
      "image": "assets/images/11376/step_05.webp"
    },
    {
      "text": "Spread softened chocolate evenly. Sprinkle with pecans. Allow to cool completely, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vfoVrVT1Qb_sAtZikFpKa9CUFnY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-11376-saltine-toffee-cookies-VAT-step-06-b936eeb215b241bbb63ded6972af450b.jpg"
      ],
      "image": "assets/images/11376/step_06.webp"
    },
    {
      "text": "Break toffee into pieces. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sZTcsAVW157Eb04F-HIJbqimP8Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-11376-saltine-toffee-cookies-hero-02-VAT-4x3-916a7c0490734a19bb0313dc03719ab2.jpg"
      ],
      "image": "assets/images/11376/step_07.webp"
    }
