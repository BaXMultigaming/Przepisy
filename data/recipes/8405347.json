  "ingredients": [
    "1 medium very ripe banana, mashed",
    "0.25 cup tomato paste",
    "0.25 cup apple cider vinegar",
    "2 tablespoons brown sugar",
    "2 teaspoons vegetable oil",
    "2 teaspoons freshly grated ginger",
    "0.5 teaspoon onion powder",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon kosher salt, or to taste",
    "0.125 teaspoon ground allspice",
    "0.125 teaspoon ground turmeric",
    "0.25 cup water",
    "½ cup prepared banana ketchup",
    "0.75 cup lemon-lime soda (such as 7-Up®)",
    "0.5 cup soy sauce",
    "1 medium lemon, juiced",
    "2 tablespoons brown sugar",
    "4 cloves crushed garlic",
    "1 teaspoon freshly ground black pepper",
    "2.5 pounds skinless, boneless chicken thighs, cut in half",
    "3 tablespoons reserved banana ketchup",
    "3 tablespoons soy sauce",
    "1 tablespoon brown sugar",
    "1 tablespoon vegetable oil",
    "1 teaspoon fish sauce"
  ],
  "steps": [
    {
      "text": "Mash banana, tomato paste, vinegar, 2 tablespoons brown sugar, 2 teaspoons oil, ginger, onion powder, garlic powder, cayenne pepper, salt, allspice, and turmeric together in a medium saucepan; stir in water to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OIhphF2jk6dNjVOu7cu21SmKEuE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8405347-filipino-style-barbecue-chicken-VAT-step-02-aadbb77aeda443b394d2e8557599b8c7.jpg"
      ],
      "image": "assets/images/8405347/step_01.webp"
    },
    {
      "text": "Place over medium-high heat; bring to a simmer. Reduce heat to medium; simmer until reduced and thickened, 7 to 10 minutes. Reserve 3 tablespoons ketchup for basting sauce, leaving about ½ cup for marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XR5O8TTrsHMzNvU1OIfK389XsDQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8405347-filipino-style-barbecue-chicken-VAT-step-03-4a73819755dd4ae3a42d864ef1fa0529.jpg"
      ],
      "image": "assets/images/8405347/step_02.webp"
    },
    {
      "text": "Whisk ½ cup reserved banana ketchup, lemon-lime soda, ½ cup soy sauce, lemon juice, 2 tablespoons brown sugar, garlic, and black pepper in a large bowl until marinade is combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ak7yaA21nsapk7opqHY0Enc4lTY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8405347-filipino-style-barbecue-chicken-VAT-step-04-4ebfea3a24214ce9a0edbdd02947cd82.jpg"
      ],
      "image": "assets/images/8405347/step_03.webp"
    },
    {
      "text": "Add halved chicken thighs to marinade; toss to coat. Cover the bowl with plastic wrap; marinate in the refrigerator for 4 to 18 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ukDTYj8MPCDj3zpEOcyXQasDPjk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8405347-filipino-style-barbecue-chicken-VAT-step-05-bdb0e18abe164de3b0907654796e41ba.jpg"
      ],
      "image": "assets/images/8405347/step_04.webp"
    },
    {
      "text": "Whisk reserved 3 tablespoons banana ketchup, 3 tablespoons soy sauce, 1 tablespoon brown sugar, 1 tablespoon oil, and fish sauce together in a small bowl until basting sauce smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3GDvdaOOCjKL83X17ClZDOxmwQ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8405347-filipino-style-barbecue-chicken-VAT-step-06-8906ceacfa62414290516e8dc3ee2d7c.jpg"
      ],
      "image": "assets/images/8405347/step_05.webp"
    },
    {
      "text": "Preheat an outdoor grill with a pile of charcoal until the coals are very hot. Thread chicken halves onto metal skewers, folding each in half with smooth sides facing outward and rougher sides folded inward.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6zcX6p6QL--EiuOpXueZribKxeI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8405347-filipino-style-barbecue-chicken-VAT-step-07-76ca07d2aeed4f7b8671ce758c03fe8a.jpg"
      ],
      "image": "assets/images/8405347/step_06.webp"
    },
    {
      "text": "Grill chicken, in batches, over hot coals until no longer pink in centers, 15 to 20 minutes, turning and basting every 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ww2k_mAaW5tWBvUrMMM8KUiti08=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8405347-filipino-style-barbecue-chicken-VAT-step-08-200b061b4da84a86950c338aa2f168b7.jpg"
      ],
      "image": "assets/images/8405347/step_07.webp"
    },
    {
      "text": "Serve with accumulated juices or extra basting sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0cTKh2E7vlB3dZma2Sejg_MC1U8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8405347-filipino-style-barbecue-chicken-VAT-4x3-8180d042147942f5b0b3eb0b0706e908.jpg"
      ],
      "image": "assets/images/8405347/step_08.webp"
    }
  ],
