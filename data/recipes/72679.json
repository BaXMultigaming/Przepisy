  "ingredients": [
    "3 tablespoons beef drippings",
    "2 tablespoons all-purpose flour",
    "2 cups water",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Sprinkle flour over the beef drippings in a skillet over medium heat. Cook, stirring constantly, until smooth and brown. Gradually stir in the water so that no lumps form. Boil until thickened, about 10 minutes, stirring constantly. Season with salt and pepper.",
