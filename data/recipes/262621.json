  "ingredients": [
    "2 tablespoons golden syrup",
    "8 ounces self-rising flour",
    "4 ounces white sugar",
    "1 teaspoon ground ginger",
    "4 ounces margarine",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 180 degrees F (82 degrees C). Grease 2 baking sheets or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm golden syrup in a saucepan over low heat, about 2 minutes. Allow to cool slightly in the saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, and ginger in a bowl. Rub in margarine. Mix in baking soda. Stir flour mixture into the golden syrup in the saucepan until dough is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Take a small, walnut-sized piece of dough and roll it into a ball; continue with remaining dough. Space biscuits evenly apart on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until biscuits are slightly cracked on the surface, 10 to 15 minutes. Transfer to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
