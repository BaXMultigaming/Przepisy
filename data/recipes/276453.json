  "ingredients": [
    "1.5 pounds ground turkey",
    "1 cup panko bread crumbs",
    "0.5 cup basil pesto",
    "2 tablespoons grated Pecorino Romano cheese",
    "1 egg",
    "0.5 teaspoon salt, or to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a sheet pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine turkey, bread crumbs, pesto, Pecorino Romano cheese, egg, salt, and pepper in a mixing bowl and mix with your hands until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll mixture into small, walnut-sized meatballs. Place onto the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the centers, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
