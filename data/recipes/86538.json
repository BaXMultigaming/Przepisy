  "ingredients": [
    "1 cup all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 tablespoon white sugar",
    "0.25 teaspoon salt",
    "1 pinch ground cinnamon",
    "2 large eggs, separated, divided",
    "1 cup buttermilk",
    "0.25 cup unsalted butter, melted",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, baking soda, sugar, salt, and cinnamon in a bowl. Beat egg whites in a separate bowl with an electric mixer until stiff peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk buttermilk, melted butter, egg yolks, and vanilla together in a medium bowl until well blended. Stir in flour mixture until combined, then fold in egg whites.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon 1/3 of the batter onto the preheated waffle iron; cook until waffle is golden brown and the iron stops steaming, about 5 minutes. Repeat to cook remaining two waffles.",
      "section": null,
      "name": null,
