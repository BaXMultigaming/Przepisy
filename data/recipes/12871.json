  "ingredients": [
    "2 cups cornmeal",
    "0.5 cup all-purpose flour",
    "1 teaspoon ground cayenne pepper",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "salt and pepper to taste",
    "4 (1 pound) fresh lobster tails, cleaned and halved but still in shell",
    "2 quarts oil for frying, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sMADYo6Bi31g0v38d_XpELE-gPw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-12871-deep-fried-lobster-step-1-cb5f81e9146346d89d88f3937eaaeab2.jpg"
      ],
      "image": "assets/images/12871/step_01.webp"
    },
    {
      "text": "Combine cornmeal, flour, cayenne, garlic powder, onion powder, salt, and pepper in a 1-gallon resealable plastic bag; shake until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x2o5x25Cl9KTS_ymHuTOZ6MyoVs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-12871-deep-fried-lobster-step-2-e9975e8e6258485495c2fc0501d1ccca.jpg"
      ],
      "image": "assets/images/12871/step_02.webp"
    },
    {
      "text": "Place one lobster tail half into the bag; seal and shake until fully coated, then remove to a plate. Repeat to coat remaining lobster tails.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WuUDhGK_V41I-S0BfsgEN8khjlo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-12871-deep-fried-lobster-step-3-67cb2e8b31ca49308b91de9949a8f8ab.jpg"
      ],
      "image": "assets/images/12871/step_03.webp"
    },
    {
      "text": "Heat oil in a deep fryer to 365 degrees F (180 degrees C). Place one coated lobster tail into the preheated oil; cook until meat turns white and coating is lightly browned, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xvGVJ9N0wRdsxSWwE3ppnHY3D5Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-12871-deep-fried-lobster-step-4-18e46c26f8c943e59d9407b63b88b73d.jpg"
      ],
      "image": "assets/images/12871/step_04.webp"
    },
    {
      "text": "Drain on a paper towel-lined plate. Repeat to fry remaining lobsters.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5n0wOVhTdqqnjc6NRkrssKvwYPA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-12871-deep-fried-lobster-step-5-f6b4413de387417f8b53511285f98b3a.jpg"
      ],
      "image": "assets/images/12871/step_05.webp"
    }
  ],
