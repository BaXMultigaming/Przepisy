  "ingredients": [
    "1 pound bacon",
    "2 (8 ounce) cans water chestnuts",
    "0.33333334326744 cup packed brown sugar",
    "0.33333334326744 cup mayonnaise",
    "0.33333334326744 cup chili sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each strip of bacon in half. Wrap a bacon strip around each water chestnut. Secure with a wooden toothpick and place in a shallow baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While wraps are baking, mix together brown sugar, mayonnaise, and chili sauce in a small bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove wraps from grease to a second shallow baking dish. Pour chili sauce mixture over wraps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and continue baking until bacon is crispy, 10 to 15 minutes. Serve hot out of the dish with toothpicks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
