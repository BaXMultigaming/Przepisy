  "ingredients": [
    "1 cup raisins",
    "1 cup warm water",
    "1 cup orange juice",
    "1 cup orange marmalade",
    "0.25 cup white sugar",
    "2 tablespoons cornstarch",
    "0.25 teaspoon salt",
    "1 pinch ground cloves"
  ],
  "steps": [
    {
      "text": "In a small saucepan, combine raisins, water, orange juice and marmalade. Bring mixture to a boil over medium-high heat.",
      "section": null,
