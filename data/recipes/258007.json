  "ingredients": [
    "1 (12 ounce) box Barilla® Gluten Free Elbows",
    "2 boneless, skinless chicken breast halves",
    "salt and pepper to taste",
    "2 tablespoons olive oil, divided",
    "0.5 cup mayonnaise",
    "0.5 cup sour cream",
    "3 tablespoons red wine vinegar",
    "2 tablespoons sugar",
    "1 tablespoon celery seed",
    "0.5 cup diced celery",
    "3 large tomatoes, diced"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, season the chicken with salt & pepper and 1 tablespoon of olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill the chicken about 4 minutes per side or until fully cooked - set aside to cool. Cut into bite-size pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook pasta according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the mayonnaise, sour cream, red wine vinegar, sugar and celery seed - stir to combine. Then, season with salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain the pasta and toss with 1 tablespoon olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once the pasta has slightly cooled, toss with the sauce and vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with grilled chicken & serve immediately - do not chill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
