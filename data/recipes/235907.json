  "ingredients": [
    "2 tablespoons corn oil",
    "2 cups diced onions",
    "2 teaspoons Louisiana-style hot pepper sauce",
    "1 teaspoon sugar",
    "1 teaspoon chili powder",
    "0.5 cup water",
    "2 tablespoons tomato paste",
    "40 RITZ Crackers",
    "5 cooked hot dogs, sliced into 8 pieces each",
    "3 tablespoons prepared yellow mustard"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add onions; cook and stir until fluid has evaporated and onions are soft, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in hot pepper sauce, sugar, and chili powder. Simmer for about 2 minutes. Add water and tomato paste; stir. Simmer for 5 more minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange RITZ crackers on a serving platter and top each cracker with a slice of cooked hot dog. Spoon a small amount of onions on top of each. Drizzle mustard on top of onions and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
