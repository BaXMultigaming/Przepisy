  "ingredients": [
    "1 (12 fluid ounce) can evaporated milk",
    "8 ounces cubed Cheddar cheese",
    "4 large eggs",
    "0.25 medium onion, diced",
    "1 pinch salt",
    "1 pinch ground black pepper",
    "1 pinch garlic powder",
    "1 pinch dried parsley",
    "1 pinch dried sage",
    "1 (14.75 ounce) can salmon, drained, flaked and bones removed",
    "1 (9 inch) frozen pie crust",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine evaporated milk, cubed Cheddar, eggs, onion, salt, pepper, garlic powder, parsley, and sage in a blender; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread salmon over the pie crust and sprinkle with 1/2 of the shredded Cheddar. Pour in egg mixture, then top with remaining shredded Cheddar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
