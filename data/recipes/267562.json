  "keywords": [],
  "ingredients": [
    "2 leaves green lettuce",
    "1 tablespoon butter",
    "1 tablespoon diced onion",
    "1 slice American cheese, cut in half",
    "0.25 pound cooked hamburger patty, cut in half",
    "2 eggs",
    "1 teaspoon milk",
    "2 slices cooked bacon, crumbled",
    "1 tablespoon diced tomato",
    "1 tablespoon diced dill pickle",
    "1 tablespoon Thousand Island dressing"
  ],
  "steps": [
    {
      "text": "Place lettuce leaves on a plate and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a small skillet over medium heat. Add butter and swirl to coat the skillet. Add onion and cook until soft, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place American cheese on hamburger halves. Microwave for approximately 20 seconds to melt the cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and milk together in a small bowl until slightly frothy. Pour egg mixture into the skillet. Cover skillet with a lid and cook until eggs are just set, about 5 minutes. Place hamburger halves on one side of the eggs. Top with onion, bacon, tomato, and pickle. Fold the other half of the eggs on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place omelet on the lettuce leaves and top with Thousand Island dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
