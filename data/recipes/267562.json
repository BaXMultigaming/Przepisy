  "title": "Bacon Cheeseburger Omelet",
  "description": "Switch things up for brunch by adding a hamburger patty, crumbled bacon, and American cheese to your omelet!",
  "authors": [
    "bdweld"
  ],
  "date_published": "2020-06-19T00:31:43-04:00",
