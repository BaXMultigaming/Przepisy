  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup sour cream",
    "4 cups shredded medium Cheddar cheese",
    "6 ounces beer",
    "1.5 tablespoons chopped canned jalapeno peppers",
    "0.25 teaspoon garlic powder",
    "0.125 teaspoon onion powder"
  ],
  "steps": [
    {
      "text": "Beat cream cheese in a medium bowl until smooth. Add ingredients in the following order, mixing with the beater after each one: sour cream, Cheddar cheese, beer, jalapeno peppers, garlic powder, onion powder. Cover and refrigerate until flavors have blended and dip has thickened, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the refrigerator 15 minutes before servings.",
