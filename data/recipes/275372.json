  "ingredients": [
    "1 tablespoon finely chopped fresh rosemary",
    "1 teaspoon finely chopped fresh chives",
    "1 teaspoon finely minced fresh garlic",
    "0.5 teaspoon salt, or to taste",
    "0.25 teaspoon ground black pepper, or to taste",
    "2 tablespoons cold unsalted butter",
    "2.75 pounds skin-on, bone-in split turkey breast"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VKvhXwp0gPGV4Vu0au29cm_xhcQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275372-air-fryer-turkey-breast-VAT-step-01-40175310baa044fa91a9aac12322d4f5.jpg"
      ],
      "image": "assets/images/275372/step_01.webp"
    },
    {
      "text": "Place rosemary, chives, garlic, salt, and pepper onto a cutting board. Cut butter into thin slices on top of herbs and seasonings and mash until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WYDgWfYfV6RhG9ItvchWk6CLYWY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275372-air-fryer-turkey-breast-VAT-step-02-2925e03bd59242e0b48951f59526c028.jpg"
      ],
      "image": "assets/images/275372/step_02.webp"
    },
    {
      "text": "Pat turkey breast dry and rub with herbed butter on both sides and under the skin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FFVfAzR2LOhqI-w5vTXzB9hRhDU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275372-air-fryer-turkey-breast-VAT-step-03-5294589b519844af9a8f3bc9a4542c99.jpg"
      ],
      "image": "assets/images/275372/step_03.webp"
    },
    {
      "text": "Place turkey into the air fryer basket, skin-side down, and air fry for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CVVNGTCXwcVnWIfEP47KC5WbxgM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275372-air-fryer-turkey-breast-VAT-step-04-72836cb71add4333aba62780c06a9952.jpg"
      ],
      "image": "assets/images/275372/step_04.webp"
    },
    {
      "text": "Turn turkey to skin-side up carefully and continue frying until an instant-read thermometer inserted near the bone reads 165 degrees F (74 degrees C), about 18 minutes more. Transfer to a platter and tent with aluminum foil; allow to rest for 10 minutes. Slice and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RLfRA6eS00Xl8H1ty-p7muzZdkQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275372-air-fryer-turkey-breast-VAT-step-05-59c763ea4b1a44eab4cef1c394b15665.jpg"
