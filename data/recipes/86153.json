  "ingredients": [
    "1 pound rhubarb, cut into 1/4 inch slices",
    "1 cup white sugar",
    "1 (3 ounce) package strawberry flavored Jell-O® mix",
    "1 (18.25 ounce) package yellow cake mix",
    "1 cup water",
    "0.25 cup margarine, melted"
