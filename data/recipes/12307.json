  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and butter together. Add flour and nutmeg; mix until crumbly. Spread 1/2 of the mixture in pie crust. Arrange peaches on top of crumb mixture. Sprinkle remaining 1/2 of crumb mixture on top of peaches.",
      "section": null,
      "name": null,
      "url": null,
