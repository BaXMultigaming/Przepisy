  "ingredients": [
    "4 plums, halved and pitted",
    "0.5 cup orange juice",
    "2 tablespoons packed brown sugar",
    "0.5 teaspoon ground cinnamon",
    "0.125 teaspoon ground nutmeg",
    "0.125 teaspoon cumin",
    "0.125 teaspoon ground cardamom",
    "0.25 cup toasted slivered almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a shallow baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place plums, cut-side up, in a single layer in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together orange juice, brown sugar, cinnamon, nutmeg, cumin, and cardamom in a bowl; drizzle over plums.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until plums are hot and sauce is bubbly, about 20 minutes. Top with toasted almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
