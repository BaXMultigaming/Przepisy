  "ingredients": [
    "1 spaghetti squash, halved and seeded",
    "3 tablespoons light margarine",
    "1 small yellow onion, thinly sliced",
    "1 teaspoon red pepper flakes",
    "0.25 teaspoon garlic powder",
    "salt and freshly ground black pepper to taste",
    "0.75 cup fat-free sour cream",
    "1 cup shredded light Cheddar cheese",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Place spaghetti squash in a covered dish and add 1/4 inch of water. Microwave for 10 to 12 minutes. Scrape insides of squash with a fork and transfer to a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat margarine in a medium skillet over medium heat while spaghetti squash is cooking and cook onion, red pepper flakes, garlic powder, salt, and pepper until the onion is browned, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a baking dish with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix spaghetti squash, onion mixture, sour cream, and 1/2 of the Cheddar cheese together. Transfer to the prepared baking dish and top with remaining Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 to 25 minutes. Turn on broiler for the last 2 to 3 minutes and broil until gratin is golden brown on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
