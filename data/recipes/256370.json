  "ingredients": [
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "0.33333334326744 cup shortening",
    "3 tablespoons butter, softened",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 teaspoon almond extract",
    "2 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup chopped pistachios, or more to taste",
    "0.5 cup coconut flakes, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, brown sugar, shortening, butter, egg, vanilla extract, and almond extract in a large bowl with an electric mixer until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, and salt together in a separate large bowl; slowly beat into shortening mixture until thoroughly combined. Stir in pistachios and coconut flakes using a large spoon or your hands until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop heaping spoonfuls of dough 2 inches apart onto 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bottoms are light golden brown, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
