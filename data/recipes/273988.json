  "ingredients": [
    "cooking spray",
    "1 pound pork roast, diced",
    "3 teaspoons minced garlic",
    "1 (15 ounce) can black beans, drained",
    "1 cup recaito (such as Goya®)",
    "1 (5 ounce) jar pitted green olives",
    "1 (1.41 ounce) package sazon seasoning with achiote",
    "3 cups long grain rice, rinsed",
    "2.75 cups water, or as needed"
  ],
  "steps": [
    {
      "text": "Spray a large stockpot with cooking spray and set over medium-high heat. Add pork and sauté until browned, about 7 minutes. Stir in garlic and cook until fragrant, about 1 minute. Add beans, recaito, olives, and sazón seasoning. Reduce the heat and simmer for about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add rice to the pot and stir to coat. Add water and bring to a boil. Cover and simmer for 20 minutes. Uncover and stir rice at the top, avoiding the slight crust on the bottom of the pot. Remove from the stove if rice has absorbed most of the liquid; if not, cook for up to 10 minutes longer.",
      "section": null,
