  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup whole wheat flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon ground cinnamon",
    "0.75 cup dark brown sugar",
    "2 tablespoons white sugar",
    "2 eggs",
    "0.5 cup olive oil",
    "1.5 cups mashed banana",
    "0.25 cup whole-milk Greek yogurt",
    "1 teaspoon vanilla extract",
    "3 tablespoons chopped walnuts",
    "1 tablespoon Demerara sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease and flour a 10x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift all-purpose flour, whole wheat flour, baking powder, baking soda, salt, and cinnamon together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, white sugar, and eggs in a stand mixer or with a hand-held electric mixer until light and fluffy, about 5 minutes. Reduce speed to low and slowly drizzle in olive oil until evenly combined. Beat in bananas, Greek yogurt, and vanilla extract until combined. Fold in 1/3 of the flour mixture with a spatula; repeat twice more until flour is fully incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared loaf pan. Sprinkle walnuts and Demerara sugar over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 55 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
