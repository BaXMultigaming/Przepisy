  "ingredients": [
    "2 pounds mahi mahi fillets",
    "0.5 cup all-purpose flour",
    "1 large egg",
    "10 oz seasoned fish fry coating (such as Louisiana® Fish Fry Products)",
    "nonstick cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut mahi mahi fillets into 1 1/2-inch sized nuggets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare a breading station with flour in 1 shallow dish, beaten egg in another shallow dish, and fish fry coating in a third shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip the fish nuggets first in flour, then egg, and then into the breadcrumbs. Place nuggets in batches into the air fryer basket. Spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry for 12 minutes. Repeat with remaining nuggets. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
