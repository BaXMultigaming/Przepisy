  "ingredients": [
    "0.5 cup sour cream",
    "4 tablespoons unsalted butter, softened",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon lemon juice",
    "0.25 teaspoon salt",
    "2.75 cups confectioners' sugar"
  ],
  "steps": [
    {
