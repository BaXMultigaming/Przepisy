  "title": "Chocolate-Cran-Oat Cookies",
  "description": "A chewy chocolate mix with dried cranberries - a holiday treat! I prefer to use white whole wheat flour because it's not as heavy as regular whole wheat flour.",
  "authors": [
    "Diana Stephens"
  ],
  "date_published": "1999-11-25T10:37:02-05:00",
