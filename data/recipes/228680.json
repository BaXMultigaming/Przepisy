  "ingredients": [
    "1 pound ground beef",
    "0.5 pound bulk hot Italian sausage",
    "1 medium onion, chopped",
    "1 medium bell pepper, chopped",
    "2 tablespoons all-purpose flour",
    "1 teaspoon salt",
    "0.25 teaspoon dried oregano",
    "0.125 teaspoon ground black pepper, or to taste",
    "1 (26 ounce) jar spaghetti sauce",
    "1 (16 ounce) package frozen mixed vegetables, thawed",
    "1 (8 ounce) package refrigerated crescent roll dough",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir ground beef, sausage, onion, and bell pepper in a large skillet over medium heat until meat is completely browned and crumbled, 7 to 10 minutes. Drain grease from the skillet and return to the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, salt, oregano, and pepper into the skillet. Pour in spaghetti sauce and add mixed vegetables. Bring to a simmer and cook for 5 minutes. Transfer mixture to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll crescent dough into a flat layer. Place dough over beef mixture and sprinkle Cheddar cheese over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until dough is golden and cheese is melted, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
