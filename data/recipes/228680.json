  "title": "Michele's Ground Beef Casserole",
  "description": "This ground beef and sausage casserole is topped with prepared crescent roll dough and Cheddar cheese.",
  "authors": [
    "Michele"
  ],
  "date_published": "2019-04-02T02:58:32-04:00",
