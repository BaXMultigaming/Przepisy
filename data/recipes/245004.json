  "ingredients": [
    "1 (16 ounce) package light brown sugar",
    "2 cups baking mix (such as Bisquick ®)",
    "4 eggs",
    "1 cup chopped pecans",
    "2 tablespoons melted margarine, cooled",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, baking mix, eggs, pecans, margarine, and vanilla extract together in a bowl; spread into the prepared baking dish.",
