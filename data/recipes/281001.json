  "ingredients": [
    "1 pound lean ground beef",
    "3 cups cooked brown rice",
    "2 cups frozen peas",
    "1 (10.75 ounce) can condensed cream of celery soup",
    "0.25 cup milk",
    "2 tablespoons soy sauce",
    "1 clove garlic, minced",
    "1 cup shredded Cheddar-Monterey Jack cheese blend, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0qWQ9FNZLDWej78TbgMqz_87Cjo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281001-ground-beef-casserole-with-brown-rice-ddmfs-step-01-6d277dca10404d9f9a924d9fe6a6a202.jpg"
      ],
      "image": "assets/images/281001/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat. Add ground beef; cook and stir until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Transfer ground beef to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Mxg3xG9Uvxw2CMJ-jMLPEGE_MBE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281001-ground-beef-casserole-with-brown-rice-ddmfs-step-02-37f80882e1b842659fa6ae10859a9a5e.jpg"
      ],
      "image": "assets/images/281001/step_02.webp"
    },
    {
      "text": "Add brown rice, peas, soup, milk, soy sauce, and garlic to ground beef; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Cq_IicOUTFLraSMlnWoluJkIQmI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281001-ground-beef-casserole-with-brown-rice-ddmfs-step-03-4b722813a58d422a99c57fa84d1a4184.jpg"
      ],
      "image": "assets/images/281001/step_03.webp"
    },
    {
      "text": "Transfer to a 9x13-inch baking dish. Top with Cheddar-Monterey Jack cheese; cover dish with a lid or aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CNCGxWxjtemIPN2QPnMFHuUEhps=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281001-ground-beef-casserole-with-brown-rice-ddmfs-step-04-4a3598e09a0b40e69b84de16494ef194.jpg"
      ],
      "image": "assets/images/281001/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until heated through and bubbly, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
