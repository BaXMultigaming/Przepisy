  "ingredients": [
    "1 pound linguine pasta",
    "1 pound fresh broccoli, chopped",
    "3 tablespoons extra virgin olive oil",
    "1 tablespoon butter",
    "3 cloves garlic, minced, or more to taste",
    "1 red bell pepper, thinly sliced",
    "1 pinch garlic salt",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until al dente, 8 to 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Steam broccoli with 2 tablespoons water in the microwave for 6 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat olive oil and butter in a 10-inch skillet over low heat. Stir in garlic (more or less to suit your tastes), then red pepper slices; sauté gently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain broccoli and add to skillet. Sprinkle lightly with garlic salt and sauté broccoli with peppers until soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss vegetable mixture with hot pasta. Sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
