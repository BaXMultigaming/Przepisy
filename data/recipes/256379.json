    "2 tablespoons unsalted butter",
    "1 tablespoon medium-chain triglyceride (MCT) oil",
    "1 tablespoon cacao powder",
    "1 tablespoon cacao butter",
    "0.125 teaspoon vanilla powder",
    "6 drops liquid stevia, or to taste",
