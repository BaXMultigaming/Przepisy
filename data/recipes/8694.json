  "ingredients": [
    "1 tablespoon butter",
    "0.5 cup chopped green onions",
    "0.5 teaspoon garlic powder",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "1 (4 ounce) can diced green chiles",
    "0.5 cup sour cream",
    "1.5 cups cubed cooked chicken breast meat",
    "1 cup shredded Cheddar cheese, divided",
    "6 (12 inch) flour tortillas",
    "0.25 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a large baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a medium saucepan over medium heat. Sauté green onions in hot butter until tender, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SqXFk3_TwweNaXC8IYgGAHUuRnw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8694-Chicken-Enchildas-ddmfs-167-step1-7305f70bb8c148dea7e27b615a62cb35.jpg"
      ],
      "image": "assets/images/8694/step_02.webp"
    },
    {
      "text": "Add garlic powder, then stir in condensed soup, green chiles, and sour cream. Mix sauce until well combined. Reserve 3/4 of the sauce in a bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mKxe84izPvyPPJaEGP9r1ZPoyM8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8694-Chicken-Enchildas-ddmfs-168-step2-9b81579695b742f0b4183114986b3fe6.jpg"
      ],
      "image": "assets/images/8694/step_03.webp"
    },
    {
      "text": "Add chicken and 1/2 cup cheese to remaining sauce in the pan; stir until cheese is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F-ndpZzmAXYWbGUjIKLSliSjZLY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8694-Chicken-Enchildas-ddmfs-169-step3-eefbd7f757ee41a2bd9203316bd068d1.jpg"
      ],
      "image": "assets/images/8694/step_04.webp"
    },
    {
      "text": "Fill each flour tortilla with chicken mixture and roll up. Place seam-side down in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7dmI3BGae05IvmJO41pKiJgsvy0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8694-Chicken-Enchildas-ddmfs-171-step5-0b632ca46bcd4ed681cbb53051d6bd72.jpg"
      ],
      "image": "assets/images/8694/step_05.webp"
    },
    {
      "text": "Stir milk into reserved sauce in the bowl and spoon over rolled tortillas. Top with remaining 1/2 cup cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ew1ZivmZxnEtUaKcLNOcSNeyyXQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8694-Chicken-Enchildas-ddmfs-173-step7-a5e708d1305249fc96d50984c63d3a36.jpg"
      ],
      "image": "assets/images/8694/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is bubbly, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/laVb99o9XzDZdX2nMbNXY-vrzak=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8694-Chicken-Enchildas-ddmfs-178-4x3-b212961062d64c1bbeae21697a681222.jpg"
      ],
      "image": "assets/images/8694/step_07.webp"
    }
