  "title": "Zucchini Chocolate Chip Cake",
  "description": "This zucchini chocolate chip cake is tender, moist, full of rich cocoa flavor, and a delicious way to use up fresh summer squash from the garden.",
  "authors": [
    "H Sankey"
  ],
  "date_published": "2020-06-18T23:45:24-04:00",
