  "ingredients": [
    "0.5 cup milk",
    "1 teaspoon distilled white vinegar",
    "2.5 cups all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "1.5 cups white sugar",
    "0.5 cup butter, softened",
    "0.5 cup vegetable oil",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2 cups grated zucchini",
    "1 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/InzSY2HTeoy6eXSVumD8J5dhqo0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-218622-zucchini-chocolate-chip-cake-VAT-step-01-2bc1ae6fc09c4553abedff59f6a43d9f.jpg"
      ],
      "image": "assets/images/218622/step_01.webp"
    },
    {
      "text": "Combine milk and vinegar in a large bowl; let stand to sour milk, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2sMQpMBD0tnJ8rdrLg5sxk3Zp8g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-218622-zucchini-chocolate-chip-cake-VAT-step-02-04a3d9ff27414f2a8ca0e61e9fca3da0.jpg"
      ],
      "image": "assets/images/218622/step_02.webp"
    },
    {
      "text": "Meanwhile, combine flour, cocoa powder, baking soda, and baking powder in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4b9MPcdG5_UCAxX2S3ZRB8QvM7U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-218622-zucchini-chocolate-chip-cake-VAT-step-03-2-09793bc2191d4cce8a6533a87b1723ae.jpg"
      ],
      "image": "assets/images/218622/step_03.webp"
    },
    {
      "text": "Add sugar, butter, oil, eggs, and vanilla to soured milk; beat until incorporated. Add flour mixture; stir until just combined. Fold in zucchini.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/26Zo2ZZWR-a4ICPqEt__V1iRbBo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-218622-zucchini-chocolate-chip-cake-VAT-step-04-2-a528c4da060545f2b1faf84b42a8e560.jpg"
      ],
      "image": "assets/images/218622/step_04.webp"
    },
    {
      "text": "Pour batter into the prepared baking dish. Sprinkle with chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BuKmD-gYi9YGUxlCtpErwoJOmI8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-218622-zucchini-chocolate-chip-cake-VAT-step-05-1-912d7f567a0249368519a0c273d11002.jpg"
      ],
      "image": "assets/images/218622/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of cake comes out clean, about 45 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t_MKNbq2GpoF_TZGqT4TIoYq_eY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-218622-zucchini-chocolate-chip-cake-VAT-step-06-2-eb0376f1b011454489bf18d1e66e727e.jpg"
      ],
      "image": "assets/images/218622/step_06.webp"
    }
  ],
