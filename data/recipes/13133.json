  "title": "Rich Cream of Mushroom Soup",
  "description": "Rich cream of mushroom soup, beats the canned variety any day. Garnish bowls with fresh chives and thyme.",
  "authors": [
    "Michelle Chen"
  ],
  "date_published": "1999-02-27T22:28:30-05:00",
