  "ingredients": [
    "4 tablespoons butter",
    "6 ounces smoked ham, diced",
    "4 green onions, chopped, white and green parts separated",
    "1 red bell pepper, finely diced",
    "0.5 cup finely diced celery",
    "1 fresh jalapeno pepper, finely diced",
    "2 cloves garlic, minced",
    "2 teaspoons Cajun seasoning",
    "3 tablespoons flour",
    "3.5 cups cold chicken broth",
    "0.25 teaspoon Worcestershire sauce",
    "1 pound small raw shrimp, peeled and deveined",
    "1 pinch salt, or to taste",
    "1 pinch cayenne pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a deep skillet over medium heat. Add ham; cook until lightly browned, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in green onion white parts, bell pepper, celery, jalapeño, and garlic; cook and stir until softened, about 5 minutes. Stir in Cajun seasoning; cook 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour; cook and stir until flour is no longer gritty, about 3 minutes. Stir in chicken broth and Worcestershire sauce; increase heat to medium-high. Cook until vegetables are soft and liquid is reduced and thick, 10 to 15 minutes. Reduce heat to medium-low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in shrimp; cook and stir until shrimp are cooked through, 2 to 3 minutes. Season with salt and cayenne pepper. Garnish with green onion green parts.",
      "section": null,
      "name": null,
      "url": null,
