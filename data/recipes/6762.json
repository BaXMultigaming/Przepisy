  "ingredients": [
    "1.75 cups all-purpose flour",
    "0.33333334326744 cup white sugar",
    "2.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.75 cup milk",
    "1 egg, lightly beaten",
    "0.33333334326744 cup butter, melted",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease muffin cups, or line them with muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk together flour, sugar, baking powder, and salt. Add milk, egg, and butter; mix until ingredients are moistened. Do not overmix. Stir in fresh fruit. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the tops spring back when lightly touched, 20 to 25 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
