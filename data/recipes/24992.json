  "ingredients": [
    "2.25 cups sifted cake flour",
    "1.25 cups white sugar",
    "2.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup shortening",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "3 bananas, mashed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease and flour a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, sift together the flour, sugar, baking powder, baking soda and salt. Make a well in the center and add shortening, eggs, vanilla and bananas. Beat 2 minutes at medium speed with electric mixer. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
