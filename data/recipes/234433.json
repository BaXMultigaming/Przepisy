  "ingredients": [
    "0.25 cup soy sauce",
    "1 tablespoon honey",
    "4 large ripe bananas, each cut into 5 chunks",
    "10 slices bacon, halved crosswise",
    "20 toothpicks"
  ],
  "steps": [
    {
      "text": "Whisk soy sauce and honey together in a large bowl. Add bananas and stir to coat bananas in marinade. Refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove banana chunks and reserve marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap each banana chunk with a bacon slice and secure by threading a toothpick through the bacon. Dip wrapped bananas in reserved marinade and arrange on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until bacon is browned and crispy, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
