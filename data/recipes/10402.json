  "ingredients": [
    "2 cups white sugar",
    "1.5 cups butter, softened",
    "4 eggs",
    "1 teaspoon vanilla extract",
    "5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OZ23pgfy9D_Hb2AQ6CI69AxSNWg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10402-the-best-rolled-sugar-cookies-ddmfs-3235-4x3-step-01-123f745f4d534549961601cd9eb0207c.jpg"
      ],
      "image": "assets/images/10402/step_01.webp"
    },
    {
      "text": "Beat sugar and softened butter together in a large bowl with an electric mixer until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tagaY3SslBAEluZ7mJMcDNA-lWI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10402-The-best-rolled-sugar-cookies-mfs-Step2-081-11adfa1021d84d28bcb9c362b88a7dec.jpg"
      ],
      "image": "assets/images/10402/step_02.webp"
    },
    {
      "text": "Beat in eggs and vanilla. Stir in flour, baking powder, and salt. Cover, and chill dough for at least 1 hour (or overnight).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n8ABQ1NAcbHkiBRF73RVfrUWWvo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10402-The-best-rolled-sugar-cookies-mfs-Step2-083-7bb00f69d1514bf09f40bdef396be892.jpg"
      ],
      "image": "assets/images/10402/step_03.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly dust a work surface with flour. Roll out dough to 1/4 to 1/2 inch thickness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ib-U7zb8NzhZpp03f-fxZXVAJAU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10402-The-best-rolled-sugar-cookies-mfs-Step3-084-28843acc8f574bcf9a4eb0c0fa93e22d.jpg"
      ],
      "image": "assets/images/10402/step_04.webp"
    },
    {
      "text": "Cut into shapes with any cookie cutter. Place cookies 1 inch apart on ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Jkho8rEr0i7_G2IbdzozrCOQYYA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10402-The-best-rolled-sugar-cookies-mfs-Step4-085-4dc05c1cd624468d8748af4d76175d42.jpg"
      ],
      "image": "assets/images/10402/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until cookies are lightly browned, 6 to 8 minutes. Carefully transfer cookies to a wire rack and cool completely before decorating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5Ut1KY2JX-gSU25kh88EkT4flVw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10402-The-best-rolled-sugar-cookies-mfs-093-a575bf0d59ac49899b04bd2feac28adf.jpg"
      ],
      "image": "assets/images/10402/step_06.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_ny7XzRjYztbPM8Gi_tMd95aOZg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10402-The-best-rolled-sugar-cookies-DDMFS-4x3-257b10612f064df5a4b33dc331dcc4b4.jpg"
      ],
