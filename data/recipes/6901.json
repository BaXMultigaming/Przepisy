  "ingredients": [
    "2 eggs",
    "0.5 cup vegetable oil",
    "1 cup white sugar",
    "1 cup grated zucchini",
    "0.5 cup crushed pineapple, drained",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.75 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 9x5x3 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, oil, and sugar in a large bowl. Stir in zucchini, pineapple, and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, measure and combine flour, soda, baking powder, salt, cinnamon, nutmeg, and nuts. Pour all at once into batter. Stir to moisten. Pour into greased loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in 350 degree F (175 degree C) oven for 1 hour until bread tests done. Cool for 10 minutes. Turn loaf out of pan to cool on rack. Wrap. Cut in thin slices and spread with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
