  "title": "Zucchini Pineapple Loaf",
  "description": "Add crunchy hazelnuts or pecans to this spiced zucchini bread laden with golden pineapple.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-08-31T15:35:25-04:00",
