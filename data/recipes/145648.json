  "ingredients": [
    "1 teaspoon shortening",
    "3.5 cups all-purpose flour",
    "4 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1.5 cups white sugar",
    "1 cup unsalted butter, softened to room temperature",
    "4 eggs, beaten",
    "0.33333334326744 cup orange juice",
    "0.33333334326744 cup milk",
    "2 tablespoons anise extract",
    "1 drop lemon extract",
    "1 cup chopped dates",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a fluted tube pan (such as Bundt) with shortening and dust with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift 3 ½ cups flour, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a bowl with a spoon until creamy. Mix in eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine orange juice and milk in a separate bowl; add to sugar mixture. Stir in flour mixture, anise extract, and lemon extract until well combined. Fold in dates and walnuts; pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top of cake springs back when touched and a toothpick inserted in the center comes out clean, 45 to 60 minutes. Cool in the pan for 20 minutes, then transfer to a wire rack to finish cooling, 15 to 25 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
