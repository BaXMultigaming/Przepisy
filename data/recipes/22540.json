  "ingredients": [
    "0.25 cup mayonnaise",
    "1 tablespoon prepared Dijon-style mustard",
    "1 tablespoon prepared horseradish",
    "1 tablespoon fresh lemon juice",
    "0.25 cup dry bread crumbs",
    "1 tablespoon grated Parmesan cheese",
    "4 (4 ounce) fillets halibut",
    "1 tablespoon margarine, melted",
    "0.25 cup dry bread crumbs",
    "1 tablespoon grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix together mayonnaise, mustard, horseradish, and lemon juice. Stir in 1/4 cup bread crumbs and 1 tablespoon Parmesan cheese. Arrange fish fillets on the prepared baking sheet. Spread bread crumb mixture evenly over fish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix together melted margarine, 1/4 cup bread crumbs, and 1 tablespoon Parmesan cheese. Sprinkle over the coated halibut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 18 minutes, or until fish flakes easily with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
