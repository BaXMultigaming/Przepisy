  "ingredients": [
    "1 (9 inch) deep-dish pie crust",
    "1 tablespoon olive oil",
    "0.5 cup sliced onion",
    "0.5 cup chopped green bell pepper",
    "0.5 cup mushrooms, sliced",
    "0.5 cup chopped zucchini",
    "1 large tomato, sliced",
    "2 tablespoons all-purpose flour",
    "2 teaspoons dried basil",
    "3 large eggs, beaten",
    "0.5 cup milk",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1.5 cups shredded Colby-Jack cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sFAcfasFpmtaW5CghrGpqnovH-U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228426-Loaded-Vegetarian-Quiche-DDMFS-4x3-ingredients-ddece5d966cd441ca9f52aef9c49b72a.jpg"
      ],
      "image": "assets/images/228426/step_01.webp"
    },
    {
      "text": "Bake pie crust in preheated oven until firm, about 8 minutes. Remove crust from the oven and set aside. Reduce oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S7IA0ho7DWUdvXfYONbUc14JXPs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228426-Loaded-Vegetarian-Quiche-DDMFS-4x3-step-01-b51d5ef8ed7d42ef90c7bddb776a4db9.jpg"
      ],
      "image": "assets/images/228426/step_02.webp"
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat. Add onion, bell pepper, mushrooms, and zucchini and cook, stirring, until softened, 5 to 7 minutes. Remove vegetables from skillet and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nPa7JiHa-Zvk9flixv9fv9RsRog=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228426-Loaded-Vegetarian-Quiche-DDMFS-4x3-step-02-4a3614426f5d47c7844313dd8184f6d3.jpg"
      ],
      "image": "assets/images/228426/step_03.webp"
    },
    {
      "text": "Sprinkle tomato slices with flour and basil; cook in the skillet over medium heat for 1 minute per side. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RGZ0sc-q9dnj7oJ7p1tcnpJQGp8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228426-Loaded-Vegetarian-Quiche-DDMFS-4x3-step-03-0d2a904b852341ad9e783890f8abb43b.jpg"
      ],
      "image": "assets/images/228426/step_04.webp"
    },
    {
      "text": "Whisk eggs, milk, salt, and pepper together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vASWiaNFsZ_qba4NI7xeYaW-Pak=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228426-Loaded-Vegetarian-Quiche-DDMFS-4x3-step-04-58f9909eb6db4b18b4a56162e711c151.jpg"
      ],
      "image": "assets/images/228426/step_05.webp"
    },
    {
      "text": "Spread 1 cup cheese in the bottom of pie crust. Layer vegetable mixture over the cheese, then top with tomato slices. Pour egg mixture over top and sprinkle with remaining 1/2 cup cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hekx2yrljINCa4DCCLZxfzNi0Bo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228426-Loaded-Vegetarian-Quiche-DDMFS-4x3-step-05-1641ab7d62ae4735a19901a53780d516.jpg"
      ],
      "image": "assets/images/228426/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until a knife inserted near the center comes out clean, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y4jcG60TTg1guLExrw9GMjwLoRM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228426-Loaded-Vegetarian-Quiche-DDMFS-4x3-step-06-8366747ce61744aaa6ac606e8874e88d.jpg"
      ],
      "image": "assets/images/228426/step_07.webp"
    },
    {
      "text": "Cool 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3KdHUKdh5uR9WafDYCDdym2okQU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228426-Loaded-Vegetarian-Quiche-DDMFS-4x3-beauty-d89f70ab0a2647f1839c20befab3608c.jpg"
      ],
      "image": "assets/images/228426/step_08.webp"
    }
  ],
