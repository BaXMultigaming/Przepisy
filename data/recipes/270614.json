  "ingredients": [
    "1 serving olive oil cooking spray",
    "1 acorn squash, halved and seeded",
    "1 tablespoon olive oil",
    "1 pinch salt and freshly ground black pepper to taste",
    "0.5 pound sage-flavored ground breakfast sausage",
    "0.5 onion, diced",
    "0.5 cup thinly sliced cabbage",
    "0.5 cup matchstick-cut carrots",
    "1 pear - peeled, cored, and diced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking pan with aluminum foil and spray with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub or brush 1/2 tablespoon oil on the flesh of each acorn squash half. Season with salt and pepper. Place squash halves onto the prepared baking pan, cut-side down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until softened, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, brown sausage in a large skillet over medium heat. Add onion, cabbage, and carrots. Saute until onion is soft and translucent, 5 to 7 minutes. Add diced pear and cook until softened but still crunchy, 2 to 3 minutes longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove acorn squash from oven and turn over using tongs. Stuff with sausage-pear mixture. Return to oven and roast for an additional 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
