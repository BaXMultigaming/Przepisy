  "ingredients": [
    "1 (16 ounce) package baby carrots, sliced",
    "2 medium onions, sliced",
    "1 cup shredded Cheddar cheese",
    "3 tablespoons butter",
    "3 tablespoons all-purpose flour",
    "1.5 cups milk",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1 tablespoon butter",
    "1 cup fine dry bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place carrots and onions in a pot with enough lightly salted water to cover, and bring to a boil. Cook 5 minutes, or until tender but firm. Drain, and spread 1/2 the carrots and onions in a baking dish. Cover with 3/4 cup cheese, layer with remaining carrots and onions, and top with remaining cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan, melt 3 tablespoons butter and mix in flour until smooth. Gradually stir in milk until thickened, and season with salt and pepper. Pour over the carrots, onions, and cheese in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1 tablespoon butter in a small pot, and mix in bread crumbs. Sprinkle evenly in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 20 minutes in the preheated oven, or until bubbly and lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
