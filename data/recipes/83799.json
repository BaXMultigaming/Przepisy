  "ingredients": [
    "1 large yellow onion, chopped",
    "2 tablespoons olive oil",
    "1 teaspoon brown sugar",
    "1 bunch red Swiss chard, rinsed and chopped",
    "0.25 cup kalamata olives",
    "2 tablespoons capers",
    "0.5 teaspoon coarse sea salt, or to taste",
    "freshly ground black pepper to taste",
    "1 lemon, juiced"
  ],
  "steps": [
    {
      "text": "In a cast iron skillet, cook onions in olive oil over medium-high heat until they begin to brown. Stir in brown sugar, and continue cooking for a few minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When onions are brown and tender, stir in chard and olives. Cook until chard is slightly wilted. Stir in capers and salt, and continue cooking until chard is completely wilted, about 3 minutes. Season with black pepper and squeeze lemon over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
