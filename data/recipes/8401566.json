    "Middle Eastern"
  ],
  "regions": [
    "Middle Eastern"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 slice whole grain bread, toasted",
    "0.5 medium yellow onion, diced",
    "0.33 cup chopped Italian parsley",
    "4 cloves garlic, minced",
    "8 ounces ground beef",
    "4 ounces ground lamb",
    "1.25 teaspoons kosher salt",
    "0.5 teaspoon freshly ground black pepper",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon paprika",
    "0.25 teaspoon ground cardamom",
    "0.125 teaspoon ground nutmeg",
    "0.25 teaspoon cayenne pepper",
    "2 tablespoons water",
    "4 bamboo skewers, soaked for at least 1 hour"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5Pv-D5a0gAGjmFQZTio8irWlh6E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8401566-chef-johns-kofta-kebabs-VAT-step-01-20a06e1539804569bcb649406ee33881.jpg"
      ],
      "image": "assets/images/8401566/step_01.webp"
    },
    {
      "text": "Cut toasted bread slice into thin strips on a cutting board; cut strips across into a small dice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xr4EEW0mVtihlBJkJSv-N6lIwOs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8401566-chef-johns-kofta-kebabs-VAT-step-02-b72429ece10c4ac0af5d716a19882625.jpg"
      ],
      "image": "assets/images/8401566/step_02.webp"
    },
    {
      "text": "Place onion, parsley, and garlic on top of diced bread on the cutting board; chop until mixture is finely diced.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sEqyCfJ9xxbfSX9NagcL4EbojKM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8401566-chef-johns-kofta-kebabs-VAT-step-03-0c15c82abd754677bb3b8e026eb3a1b7.jpg"
      ],
      "image": "assets/images/8401566/step_03.webp"
    },
    {
      "text": "Season beef and lamb with kosher salt, black pepper, allspice, paprika, cardamom, nutmeg, and cayenne. Add onion mixture and water. Mix and mash with your hands until well combined. Wrap in plastic wrap and refrigerate until chilled, at least 1 hour, up to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AE7qBsihT6GQHoBk9XJ7H3L_MJY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8401566-chef-johns-kofta-kebabs-VAT-step-04-c44f8682370b4cb0af9007816fede39a.jpg"
      ],
      "image": "assets/images/8401566/step_04.webp"
    },
    {
      "text": "Remove meat from the refrigerator and roll ¼ of the mixture into a ball using wet hands. Pierce in the middle with a bamboo skewer. Shape meat into a uniform log, about 6 inches long and 2 inches wide.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4RtWCvpOqZ8VpXD10WSrCr58FbA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8401566-chef-johns-kofta-kebabs-VAT-step-06-052f4437e21043679aedefe7a5ede0d8.jpg"
      ],
      "image": "assets/images/8401566/step_05.webp"
    },
    {
      "text": "Meanwhile, preheat a charcoal grill until coals are very hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RkAHfeoKE-21rymZ96fC3wdsavI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8401566-chef-johns-kofta-kebabs-VAT-step-07-059bb73855c74ae6ade06f1097622925.jpg"
      ],
      "image": "assets/images/8401566/step_06.webp"
    },
    {
      "text": "Place kebabs on the hot grill until browned and cooked through, about 12 minutes, turning every 3 minutes or so. An instant-read thermometer inserted into the center of a kebab should read at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OQoZjeGM-2LM-XkxnJxlFJqqvJ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8401566-chef-johns-kofta-kebabs-VAT-step-08-8e65d3aed562458a8cad7ea7036376dc.jpg"
      ],
      "image": "assets/images/8401566/step_07.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_BDideDNePM8odpBf-z6g_z7A-Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8401566-chef-johns-kofta-kebabs-VAT-4x3-01-526799a2236340e2be810c0191d22603.jpg"
      ],
      "image": "assets/images/8401566/step_08.webp"
    }
  ],
