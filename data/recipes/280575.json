  "ingredients": [
    "1 cup self-rising flour",
    "0.75 cup freshly shredded sharp Cheddar cheese",
    "0.5 cup milk",
    "2 tablespoons canned chopped green chile peppers",
    "0.75 teaspoon taco seasoning mix",
    "0.75 teaspoon garlic powder",
    "0.25 teaspoon ground cumin",
    "1 pinch white sugar",
    "1 serving cooking spray",
    "0.25 cup salted butter, melted",
    "2 teaspoons taco seasoning mix"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C) for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, Cheddar cheese, milk, green chile peppers, taco seasoning, garlic powder, cumin, and sugar in a medium bowl. Blend together until a dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line the air fryer basket with a parchment paper round. Spray with nonstick cooking spray. Drop dough into the basket using a spring-hinged scoop. Air fry for 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix melted butter and taco seasoning mix together for the topping. Separate biscuits and brush with taco-seasoned butter. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
