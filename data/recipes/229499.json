  "ingredients": [
    "2 pounds baby bok choy, halved",
    "2 tablespoons liquid amino acid (such as Bragg®)",
    "4 teaspoons olive oil",
    "6 slices fresh ginger",
    "3 cloves garlic, sliced",
    "1 teaspoon ground turmeric",
    "1 teaspoon curry powder",
    "0.5 teaspoon fines herbs",
    "0.5 teaspoon dried basil",
    "0.125 teaspoon red pepper flakes",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bok choy, liquid amino acid, olive oil, ginger, garlic, turmeric, curry powder, fines herbs, basil, red pepper flakes together in a large bowl; season with black pepper. Place coated bok choy on the prepared baking sheet; pour remaining liquid over bok choy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until thickest ends of bok choy are tender, 6 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
