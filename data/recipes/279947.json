  "ingredients": [
    "6 large eggs",
    "0.33333334326744 cup finely diced bacon",
    "0.25 cup mayonnaise",
    "0.25 cup chopped green onions",
    "1 tablespoon chopped fresh dill",
    "1 tablespoon lemon juice",
    "1 teaspoon Dijon mustard",
    "0.5 teaspoon prepared yellow mustard"
  ],
  "steps": [
    {
      "text": "Place eggs in a saucepan and cover with water. Bring to a boil, remove from heat, and let eggs stand in hot water for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "At the same time, place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bacon, mayonnaise, green onions, dill, lemon juice, Dijon, yellow mustard together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove eggs from hot water, cool under cold running water, and peel. Chop eggs into 1/4-inch cubes. Mix into mayonnaise mixture and refrigerate until cold, at least 1 hour. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
