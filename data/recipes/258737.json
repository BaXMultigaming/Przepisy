  "ingredients": [
    "1 (13.5 ounce) can full-fat coconut milk",
    "5 tablespoons Dutch-process cocoa powder",
    "0.25 cup white sugar, or less to taste",
    "0.25 cup fresh raspberries",
    "0.25 teaspoon almond extract",
    "5 popsicle sticks or molds"
  ],
  "steps": [
    {
      "text": "Combine coconut milk, cocoa powder, sugar, raspberries, and almond extract in a blender. Blend on high speed until mixture is thick and fluffy like pudding, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into disposable cups, smoothing over the tops. Insert sticks and freeze until solid, at least 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To serve, run hot water over the bottoms of the cups until fudge pops slide out easily.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
