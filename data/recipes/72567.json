  "ingredients": [
    "0.33333334326744 cup skim milk",
    "1 (.25 ounce) envelope unflavored gelatin",
    "2.5 cups heavy cream",
    "0.5 cup white sugar",
    "1.5 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x1wTcZn9XrcYd1_CCsiMBxo16JI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72567-Panna-cotta-ddmfs-step-01-9ed3f3fceaf34012bca83ba04d9f0d05.jpg"
      ],
      "image": "assets/images/72567/step_01.webp"
    },
    {
      "text": "Pour milk into a small bowl. Sprinkle gelatin powder over milk and stir until combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GoWmTfuMgsGOSbVn7VjeH32hzXY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72567-Panna-cotta-ddmfs-step-02-8721ffccc5a24f47a601b2559616819c.jpg"
      ],
      "image": "assets/images/72567/step_02.webp"
    },
    {
      "text": "Stir heavy cream and sugar together in a saucepan. Set over medium heat and bring to a boil; watch carefully as the cream can quickly bubble up and boil over.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nJfP8r6sCSxLcT2rZHZWEOhFa-Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72567-Panna-cotta-ddmfs-step-03-2c7db22dc74b485dab42b23eec3b89e3.jpg"
      ],
      "image": "assets/images/72567/step_03.webp"
    },
    {
      "text": "Immediately stir gelatin mixture into boiling cream, stirring until completely dissolved. Cook and stir for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fF26LS4JZntkgLOE3KA-FP4Nluk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72567-Panna-cotta-ddmfs-step-4-32ca0f1e664b4ab4b9ad32fdef5f4cc9.jpg"
      ],
      "image": "assets/images/72567/step_04.webp"
    },
    {
      "text": "Remove the pan from the heat and stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NmwUgjjLlOB4EmeHlbpWnmJviMY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72567-Panna-cotta-ddmfs-step-05-424ed09992d543ffa8ccb03b4cc4bf7d.jpg"
      ],
      "image": "assets/images/72567/step_05.webp"
    },
    {
      "text": "Pour cream mixture into 6 individual ramekins. Leave to cool, uncovered, until no longer warm, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xDgqbRGrB7kVW_JT7BAUsQoyd5k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72567-Panna-cotta-ddmfs-step-06-a98b3ba6355147a9878da1771da3f2cf.jpg"
      ],
      "image": "assets/images/72567/step_06.webp"
    },
    {
      "text": "When cool, cover with plastic wrap. Refrigerate until set, at least 4 hours but preferably overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NlP50cO2BjJdN4uGvl5JhW0Rx2A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72567-Panna-cotta-ddmfs-4x3-14ae724a2a8e4ca3a79c5e27b2b61994.jpg"
      ],
      "image": "assets/images/72567/step_07.webp"
    }
