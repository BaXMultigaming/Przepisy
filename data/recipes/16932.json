  "ingredients": [
    "3 cups all-purpose flour",
    "1.5 teaspoons salt",
    "1.5 teaspoons baking powder",
    "1.5 tablespoons poppy seeds",
    "2.5 cups white sugar",
    "1.125 cups vegetable oil",
    "3 eggs",
    "1.5 cups milk",
    "1.5 teaspoons vanilla extract",
    "1.5 teaspoons lemon extract",
    "0.25 cup orange juice",
    "0.75 cup white sugar",
    "0.5 teaspoon lemon extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease three 8x4 inch bread pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, stir together the flour, salt, baking powder, poppy seeds and 2 1/2 cups white sugar. Add the eggs, milk, oil, vanilla and lemon extract; mix until smooth, about 1 minute. Pour batter evenly into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 50 to 55 minutes, or until a toothpick inserted into the center of the loaves comes out clean. Cool loaves in the pans for 10 minutes before removing to a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine orange juice with remaining 3/4 cup sugar and desired flavor of extract; stir well. Pour this mixture over the loaf while it is still hot. Allow loaf to cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
