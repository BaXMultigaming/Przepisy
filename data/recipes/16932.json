  "title": "Lemon Poppy Seed Bread",
  "description": "Lemon extract provides the flavor point in this citrus loaf, gilded with a sweetened orange juice sauce.",
  "authors": [
    "Margie"
  ],
  "date_published": "1999-10-05T15:32:57-04:00",
