  "ingredients": [
    "1 tablespoon olive oil",
    "2 large onions, chopped",
    "8 cups vegetable broth",
    "0.5 cup uncooked long-grain wild rice",
    "4 cloves garlic, minced",
    "1 pound fresh kale, chopped",
    "12 ounces fresh spinach, chopped",
    "2 ounces goat cheese, crumbled",
    "1 tablespoon lemon juice",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a small frying pan over medium-high heat. Cook and stir onions in the hot oil until until translucent, about 5 minutes. Reduce heat to low and continue cooking and stirring until onion is very tender and dark brown, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour vegetable broth into a pot and place over medium heat. Add rice and minced garlic; stir in kale and spinach, adding more broth if necessary. Add onions to the pot. Allow the greens to reduce and rice to fully cook, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use an immersion blender to blend to desired consistency. Add goat cheese and use the blender again to create a creamy texture. Stir in lemon juice, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
