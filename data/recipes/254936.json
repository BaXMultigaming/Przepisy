  "ingredients": [
    "1.75 cups all-purpose flour",
    "0.75 cup rolled oats",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.66666668653488 cup vegetable oil",
    "0.5 cup orange juice concentrate, thawed",
    "0.25 cup water",
    "1 egg, beaten",
    "0.25 teaspoon vanilla extract",
    "1 cup frozen blueberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, rolled oats, baking powder, baking soda, salt, and nutmeg together in a large bowl. Combine vegetable oil, orange juice concentrate, water, egg, and vanilla extract in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oil mixture into flour mixture; mix until batter is smooth. Fold in blueberries; stir until combined. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and cooked through, about 17 minutes. Cool in the pans for about 1 minute before removing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
