  "ingredients": [
    "6 slices bacon, chopped",
    "0.33333334326744 cup sliced almonds",
    "2 tablespoons minced garlic",
    "4 pounds Brussels sprouts, trimmed and thinly sliced",
    "2 tablespoons red wine vinegar",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large, deep skillet over medium heat until browned and crisp, 5 to 10 minutes. Transfer bacon to a paper-towel-lined plate using a slotted spoon; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add almonds and garlic to drippings in the skillet; cook briefly over medium heat until toasted. Add Brussels sprouts; quickly toss to coat with drippings. Sprinkle red wine vinegar over sprouts; toss to coat. Cook, stirring frequently, until sprouts are wilted. Off heat, stir in bacon; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
