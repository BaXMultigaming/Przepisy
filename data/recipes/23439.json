  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "1 (14 ounce) can EAGLE BRAND® Sweetened Condensed Milk",
    "2 large eggs",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "1 (9 inch) unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nlcbPNtAj2fOgDR8x6xca-sx7Gw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23439-perfect-pumpkin-pie-ddmfs-0673-4x3-step01_previewcopy-e95e92430fd84cf0be770e7dc9be04c6.jpg"
      ],
      "image": "assets/images/23439/step_01.webp"
    },
    {
      "text": "Whisk pumpkin puree, condensed milk, eggs, cinnamon, ginger, nutmeg, and salt together in a medium bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B9DFcUVMndNbddW27_xBN9Cmj_E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23439_PerfectPumpkinPie_179_Step2-6a2f9a77b5964e5a8608c71f2c22aa40.jpg"
      ],
      "image": "assets/images/23439/step_02.webp"
    },
    {
      "text": "Pour into crust. Bake in the preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cz8SKUz_PuKKdu53kW7fXKAHhxg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23439_PerfectPumpkinPie_197_Step3-4b3e7b22b82d4499b7d3daf1ec7981b7.jpg"
      ],
      "image": "assets/images/23439/step_03.webp"
    },
    {
      "text": "Reduce oven temperature to 350 degrees F (175 degrees C) and continue baking until a knife inserted 1 inch from the crust comes out clean, 35 to 40 minutes. Let cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zs4c7gkhTG3yKwgNzr9wrVSz818=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23439_PerfectPumpkinPie_001_Step4-f788a670b23544af848110c0800ebc8b.jpg"
      ],
      "image": "assets/images/23439/step_04.webp"
    },
    {
      "text": "Enjoy!",
