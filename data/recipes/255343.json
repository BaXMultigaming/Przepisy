  "ingredients": [
    "3 cups white whole wheat flour",
    "2 cups quick-cooking oats",
    "1 cup white sugar",
    "0.5 cup unsweetened cocoa powder",
    "0.25 cup chia seeds",
    "1 tablespoon baking powder",
    "1 teaspoon sea salt",
    "4.5 cups almond milk, or more to taste, divided",
    "0.5 cup coconut oil, melted"
  ],
  "steps": [
    {
      "text": "Mix flour, oats, sugar, cocoa powder, chia seeds, baking powder, and salt together in a large bowl. Add 3 cups almond milk and coconut oil; stir with a wooden spoon until batter is just combined. Cover and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a Belgian waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir 1 1/2 to 2 cups almond milk into the batter to thin it to the consistency of cake batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop 1/2 cup batter onto the preheated iron and spread to the edges. Close iron and cook until iron stops steaming, about 5 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
