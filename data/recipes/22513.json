  "ingredients": [
    "1 cup biscuit baking mix",
    "1 teaspoon dried oregano",
    "1 teaspoon seasoning salt",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon salt",
    "1 teaspoon dried parsley",
    "0.33300000429153 cup grated Parmesan cheese",
    "0.5 cup grated onion",
    "4 eggs, beaten",
    "0.33300000429153 cup vegetable oil",
    "1 zucchini, sliced into rounds"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x9-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BGcQKiE3GkOTqb0b2heRP4mYEaE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22513-zucchini-quiche-DDMFS-28607-step-01-ef1754e5dfec4a77bf974f824bc82e3d.jpg"
      ],
      "image": "assets/images/22513/step_01.webp"
    },
    {
      "text": "Combine biscuit mix, oregano, seasoning salt, garlic powder, salt, parsley, and Parmesan cheese in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ytLu7chtQgYSAl8L3wHXmoANy0c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22513-zucchini-quiche-DDMFS-28609-step-02-f1cdc455d2794f28a8bdd3d25d17cfa9.jpg"
      ],
      "image": "assets/images/22513/step_02.webp"
    },
    {
      "text": "Stir in onion, eggs, and oil. Mix well and add zucchini.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xhz3AKSjH3IAlzXKoAIIb8OkisM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22513-zucchini-quiche-DDMFS-28611-step-03-c0c77cb487e343f2966b32f7f482d29c.jpg"
      ],
      "image": "assets/images/22513/step_03.webp"
    },
    {
      "text": "Pour into prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-Vvrv7ajaesdtRAaIMi8zYjnSMU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22513-zucchini-quiche-DDMFS-28612-step-04-3bc67edd32854ba9bc18662d1bb5a953.jpg"
      ],
      "image": "assets/images/22513/step_04.webp"
    },
    {
      "text": "Bake in preheated oven until cooked through and golden brown on top, about 30 to 35 minutes. Let cool for 5 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
