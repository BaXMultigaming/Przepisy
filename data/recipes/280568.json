  "ingredients": [
    "1 bunch arugula",
    "3 tablespoons olive oil",
    "2 tablespoons lemon juice",
    "1 teaspoon poppy seeds",
    "2 avocados, cut into a large dice",
    "sea salt and freshly ground black pepper to taste",
    "1 tablespoon pepitas (pumpkin seeds)"
  ],
  "steps": [
    {
      "text": "Wash arugula and discard any wilted or damaged leaves. Trim the ends, shake, and either pat or spin dry in a salad spinner to remove excess water. Chop roughly and transfer to a large mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine olive oil, lemon juice, and poppy seeds in a glass jar and shake until emulsified.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add avocados to your bowl, reserving about 1/2 cup to use as a garnish. Pour the dressing over the salad, season with salt and pepper, and toss gently to combine. Taste and adjust seasonings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scatter the reserved avocado and pepitas on top and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
