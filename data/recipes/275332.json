  "ingredients": [
    "3 cups all-purpose flour",
    "0.5 cup white sugar",
    "2 tablespoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "1 cup moist prunes, chopped",
    "1.5 cups pumpkin puree",
    "1 cup orange juice",
    "0.75 cup milk",
    "2 eggs",
    "2 oranges, zested",
    "1 teaspoon vanilla extract",
    "0.5 cup butter, melted",
    "1 tablespoon confectioners' sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 12-cup muffin trays or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sugar, baking powder, cinnamon, and salt together in a large bowl. Mix in prunes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pumpkin, orange juice, milk, eggs, orange zest, and vanilla extract together in a separate bowl. Fold into flour mixture. Add melted butter and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter between the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove muffins from the oven and place on wire racks to cool, 20 to 30 minutes. Dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
