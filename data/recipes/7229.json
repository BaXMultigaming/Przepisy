  "ingredients": [
    "2 tablespoons light corn syrup",
    "0.5 cup butter",
    "1 cup packed brown sugar",
    "1 (1 pound) loaf unsliced white bread, with crust trimmed",
    "5 eggs",
    "1.5 cups milk",
    "1 tablespoon vanilla extract",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Combine light corn syrup, butter, and sugar in a saucepan; simmer until syrup-like. Pour mixture over the bottom of a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice bread into 12 to 16 slices; place over the syrup. Layer as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together eggs, milk, vanilla, and salt. Pour over bread. Cover with plastic wrap. Refrigerate 8 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degree F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut into squares. Invert and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
