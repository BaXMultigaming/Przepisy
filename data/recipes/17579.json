  "ingredients": [
    "2 cups strong brewed coffee",
    "1.5 cups white sugar",
    "0.5 cup butter",
    "1 cup raisins",
    "1 teaspoon ground allspice",
    "1 teaspoon ground cinnamon",
    "3 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan. Sift together the flour, baking soda and baking powder. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan combine the coffee, sugar, butter, raisins, allspice and cinnamon. Bring to a boil, remove from heat and set aside to cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour mixture until well combined. Pour into a 9x13 inch pan. Bake in preheated oven for 45 to 50 minutes, or until a toothpick inserted into the center of cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
