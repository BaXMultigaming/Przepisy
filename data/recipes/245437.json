  "ingredients": [
    "1 (20 ounce) can white hominy",
    "1 tablespoon chopped jalapeno pepper, or to taste",
    "1 clove garlic, minced",
    "0.5 cup sour cream",
    "1 tablespoon butter, or to taste",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine hominy, jalapeño, and garlic in a large saucepan; bring to a boil. Reduce heat and simmer until hominy is tender, 15 to 20 minutes. Strain out liquid; transfer hominy mixture to a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in sour cream and butter until well combined; sprinkle top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
