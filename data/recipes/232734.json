  "ingredients": [
    "1 cup rolled oats",
    "1 cup all-purpose flour",
    "0.5 cup brown sugar",
    "0.5 cup butter, melted",
    "2 cups chopped strawberries",
    "2 cups chopped rhubarb",
    "1 cup cold water",
    "0.5 cup white sugar",
    "1 tablespoon cornstarch"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, flour, brown sugar, and butter together in a bowl; press mixture into the bottom of a 9-inch pie pan. Top with strawberries and rhubarb.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water, white sugar, and cornstarch together in a saucepan. Bring to simmer, constantly whisking, until mixture bubbles and thickens; pour over fruit layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
