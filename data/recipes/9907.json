  "ingredients": [
    "1 cup shortening",
    "0.75 cup packed brown sugar",
    "0.75 cup white sugar",
    "2 eggs",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 cups rolled oats",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl cream shortening, brown sugar and granulated sugar. Add eggs and mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the baking soda, salt and flour and stir into creamed mixture",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add oatmeal and chocolate chips and stir until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoonfuls onto greased cookie sheet. Bake for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
