  "ingredients": [
    "3 tomatoes, diced",
    "1 small onion, chopped",
    "1 small jalapeno pepper, chopped",
    "2 tablespoons chopped fresh cilantro",
    "2 cloves garlic, minced",
    "1 lime, juiced, or more to taste",
    "0.5 teaspoon salt",
    "3 cups dry black-eyed peas",
