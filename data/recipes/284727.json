  "ingredients": [
    "1.5 cups graham cracker crumbs",
    "0.5 cup unsalted butter, melted",
    "1 (14 ounce) can sweetened condensed milk",
    "1.5 cups white chocolate chips",
    "1.5 cups dried cranberries",
    "1 cup flaked coconut",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cracker crumbs and melted butter. Press into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine condensed milk, chocolate chips, cranberries, coconut, and pecans in a bowl; mix well. Gently spread over the crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the edges are brown and the chips have almost fully melted, 25 to 28 minutes. Remove from the oven and cool to room temperature, about 30 minutes. Cut into 36 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
