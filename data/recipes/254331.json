  "ingredients": [
    "1 (10.75 ounce) can condensed cream of celery soup",
    "1 cup grated Cheddar cheese",
    "1 (7 ounce) can tuna, drained",
    "0.75 cup milk",
    "0.5 cup sour cream",
    "0.5 cup mayonnaise",
    "2 tablespoons chopped parsley",
    "1 tablespoon lemon juice",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 pound cooked pasta",
    "1.5 cups bread crumbs, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soup, Cheddar cheese, tuna, milk, sour cream, mayonnaise, parsley, lemon juice, salt, and black pepper in a 9x5-inch loaf pan; stir until sauce is well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pasta into sauce until thoroughly coated; sprinkle bread crumbs over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bread crumbs are golden brown and sauce is bubbly, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
