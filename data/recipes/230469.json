  "ingredients": [
    "4 cups fresh raspberries",
    "1.3333333730698 cups white sugar",
    "2 eggs",
    "1.5 cups half-and-half",
    "1 cup heavy whipping cream",
    "0.25 cup light corn syrup",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Purée raspberries in a blender or the bowl of a food processor; pour mixture through a strainer to remove seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and eggs together in a bowl until smooth; stir in raspberry purée, half-and-half, heavy cream, corn syrup, and lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour raspberry-cream mixture into an ice cream maker and freeze according to manufacturer's instructions. Transfer to an airtight container and freeze until firm, about 3 hours.",
