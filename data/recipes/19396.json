  "title": "Not Red Spaghetti Sauce",
  "description": "Italian sausage, mushrooms, zucchini and green onions are sauteed with sherry for an alternative pasta sauce.",
  "authors": [
    "Sheila"
  ],
  "date_published": "2000-05-31T18:48:16-04:00",
