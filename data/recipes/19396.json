  "ingredients": [
    "1.5 pounds Italian sausage",
    "4 ounces fresh mushrooms, sliced",
    "0.5 cup butter",
    "2 cubes chicken bouillon",
    "0.5 cup sherry",
    "1.5 pounds zucchini, sliced",
    "0.5 cup chopped green onion",
    "1 (16 ounce) package spaghetti"
  ],
  "steps": [
    {
      "text": "In large skillet, over medium heat, cook sausage and mushrooms in butter, until sausage is brown. Add bouillon cubes and sherry and stir until bouillon is dissolved. Add zucchini and onion and cook, uncovered, until zucchini is crisp-tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the sauce is cooking, bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally until cooked through but firm to the bite, about 12 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve pasta sauce over hot spaghetti.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
