  "ingredients": [
    "3 cups ice",
    "2 fluid ounces tequila",
    "1 fluid ounce lime juice",
    "2.5 teaspoons low-calorie natural sweetener (such as Swerve®)",
    "1 tablespoon coarse salt",
    "2 lime wedges",
    "1 pint-sized Mason jar",
    "2 fluid ounces orange-flavored sparkling water (such as La Croix®)"
  ],
  "steps": [
    {
      "text": "Fill a shaker half-full with ice. Add tequila, lime juice, and sweetener to the shaker. Seal and shake vigorously until outside is frosted, 10 to 15 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salt on a plate. Run 1 lime wedge along the rim of the Mason jar. Press the rim down into salt. Fill the jar with ice cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain margarita into the jar. Top with sparkling water; stir. Garnish with remaining lime wedge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
