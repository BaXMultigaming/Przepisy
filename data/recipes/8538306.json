  "ingredients": [
    "6 ounces fresh Mexican chorizo",
    "1.5 cups shredded Oaxaca cheese"
  ],
  "steps": [
    {
      "text": "Remove casing from chorizo and place in a deep microwave safe bowl. Cover with paper towels and cook for 4 to 5 minutes, stirring and recovering every 1 minute until fully cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, place 3/4 cup cheese and microwave until cheese is melted, 1 to 2 minutes. Top with half of the chorizo and the remaining cheese. Microwave again until cheese is melted, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with remaining chorizo and serve immediately.",
      "section": null,
