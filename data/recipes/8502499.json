  "ingredients": [
    "1 medium head cauliflower, cut into bite-size pieces",
    "1 tablespoon olive oil",
    "0.5 teaspoon salt, or to taste",
    "0.25 teaspoon freshly ground black pepper",
    "0.5 cup chopped celery",
    "0.5 cup raisins",
    "0.5 cup shredded carrots",
    "0.5 cup mayonnaise",
    "0.25 cup chopped red onion",
    "2 teaspoons white sugar, or to taste",
    "0.33 cup toasted chopped pecans",
    "3 strips cooked bacon, crumbled"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (210 degrees C) and line a 12 x 18 inch baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cauliflower pieces, olive oil, salt, and pepper in a large bowl and toss to combine. Spread out seasoned cauliflower in a single layer on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until the edges of the cauliflower begin to brown, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and allow to cool, slightly, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine celery, raisins, carrots, mayonnaise, red onion, and sugar in the same bowl. Add roasted cauliflower pieces and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer salad to a serving bowl and garnish with toasted pecan pieces and crumbled bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
