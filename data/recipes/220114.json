  "ingredients": [
    "1 pound chicken, cut into cubes",
    "0.25 cup soy sauce",
    "2 tablespoons vegetable oil",
    "0.5 cup apple cider vinegar",
    "0.75 cup white sugar",
    "0.5 cup water",
    "3 tablespoons cornstarch",
    "0.5 cup water",
    "1 (8 ounce) can pineapple chunks - drained with juice reserved",
    "0.33333334326744 cup tomato soup",
    "1 carrot, thinly sliced",
    "0.5 onion, cut into chunks",
    "0.5 green bell pepper, sliced"
  ],
  "steps": [
    {
      "text": "Marinate chicken cubes in soy sauce in a bowl for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a skillet on medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from soy sauce and cook and stir in the heated skillet until no longer pink in the center and the juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from the skillet and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vinegar, sugar and 1/2 cup water together over medium heat in the same skillet until the sugar dissolves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornstarch and 1/2 cup water in a bowl and add to the vinegar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mixture and lower heat to medium-low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour pineapple juice and tomato soup into vinegar mixture and simmer for about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in carrots, onion, and bell pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Simmer for 20 to 25 minutes; until sauce is reddish-yellow and the vegetables are cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the pineapple chunks and cooked chicken to the sauce and heat for 2 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
