  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup rolled oats",
    "0.5 cup packed brown sugar",
    "0.5 cup butter",
    "2 egg whites",
    "2 cups pumpkin puree",
    "1 (12 fluid ounce) can evaporated milk",
    "0.75 cup white sugar",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground cloves",
    "0.5 cup chopped walnuts",
    "0.5 cup packed brown sugar",
    "2 tablespoons butter",
    "1 cup whipped cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, rolled oats, brown sugar, and ½ cup butter together in a bowl; transfer and press into prepared pan. Bake until golden brown, 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a large deep metal bowl until soft peaks form; add pumpkin, evaporated milk, sugar, salt, cinnamon, ginger, and clove. Pour over baked rolled oats crust. Bake until firm, 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chopped walnuts, brown sugar, and 2 tablespoons butter together; sprinkle over pumpkin mixture and bake for an additional 10 to 15 minutes. Cool. Cut into squares and top with whipped cream if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
