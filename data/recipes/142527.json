  "ingredients": [
    "0.5 cup shortening",
    "4 large ripe bananas",
    "2 cups Amish Friendship Bread Starter (see footnote for recipe link)",
    "3 large eggs",
    "1 cup white sugar",
    "1 cup chopped walnuts",
    "0.5 cup milk",
    "2 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash together shortening and bananas in a large bowl, then stir in Amish starter, eggs, sugar, walnuts, and milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking powder, baking soda, and salt. Fold into the banana mixture. Divide batter evenly into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted into the center of the loaves comes out clean, about 1 hour and 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool loaves until they loosen evenly from the pan before removing to a wire rack to cool completely, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
