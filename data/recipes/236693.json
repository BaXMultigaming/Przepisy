  "ingredients": [
    "4 cups all-purpose flour",
    "5 teaspoons baking powder",
    "0.5 cup raisins",
    "1 cup milk",
    "3 eggs",
    "0.5 cup butter, softened",
    "0.5 cup white sugar",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour and baking powder together in a bowl; stir in raisins. Whisk milk and eggs together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, sugar, and salt together in a bowl with an electric mixer until light and fluffy, about 1 minute. Beat in egg mixture, then stir in flour mixture until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a lightly floured surface and pat or roll out until 1-inch thick. Cut into 24 biscuits with a biscuit cutter or juice glass; place onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
