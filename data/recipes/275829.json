  "ingredients": [
    "1 (15 ounce) can whole kernel corn, drained",
    "1 (15 ounce) can cream-style corn",
    "1 (8.5 ounce) package corn muffin mix",
    "1 cup sour cream",
    "0.5 cup unsalted butter, melted",
    "0.25 cup diced pickled jalapeno pepper slices",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together whole kernel corn, cream-style corn, muffin mix, sour cream, melted butter, jalapeño peppers, and salt in a large bowl until combined. Pour batter into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 45 to 60 minutes.",
