  "ingredients": [
    "4 tablespoons capers",
    "2 cloves garlic, crushed",
    "2 tablespoons olive oil",
    "0.5 large lemon, juiced",
    "1 teaspoon coriander seeds, crushed",
    "freshly ground black pepper to taste",
    "1 (8.8 ounce) package halloumi cheese, sliced",
    "1 tablespoon olive oil",
    "0.5 cup chopped cilantro leaves",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Cover capers with fresh water in a bowl and soak for 5 minutes to remove excess salt; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chop capers coarsely. Stir together capers, garlic, 2 tablespoons olive oil, lemon juice, and crushed coriander seeds in a small bowl. Season with ground black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush the halloumi slices with the remaining 1 tablespoon olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook halloumi slices directly on the grill grate until golden, about 2 minutes. Turn and cook on the other side until soft in the center and golden on the outside, about 2 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place halloumi slices on a serving plate. Drizzle with caper sauce and sprinkle with fresh cilantro leaves. Season to taste with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
