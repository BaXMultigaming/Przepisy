  "ingredients": [
    "0.25 cup butter",
    "2 pounds ground beef",
    "2 teaspoons salt",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground black pepper",
    "4.5 cups chicken broth",
    "2 cups long grain white rice",
    "2 tablespoons butter",
    "0.5 cup pine nuts"
  ],
  "steps": [
    {
      "text": "Heat 1/4 cup butter in a large saucepan over medium-high heat. Add ground beef and season with salt, allspice, cinnamon, and black pepper. Cook and stir until beef is browned and crumbly, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chicken broth and rice into beef in the saucepan; bring to a boil. Reduce heat to low, cover, and cook until liquid is absorbed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt 2 tablespoons butter in a small skillet over medium heat. Cook and stir pine nuts in hot butter until lightly browned, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pine nuts into beef-rice mixture before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
