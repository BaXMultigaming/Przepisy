  "ingredients": [
    "1 pound kielbasa sausage",
    "1 tablespoon olive oil",
    "1 medium red bell pepper, cut into chunks",
    "1 medium onion, cut into chunks",
    "2 teaspoons minced garlic",
    "salt and ground black pepper to taste",
    "1 medium apple, cut into chunks",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Remove skin from kielbasa and slice into bite-sized pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large pan over medium heat. Cook and stir kielbasa, bell pepper, onion, and garlic in hot oil until vegetables have softened, 5 to 7 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in apple, then cover with Cheddar cheese. Cover the pan and cook until cheese is melted, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
