  "ingredients": [
    "0.25 cup butter, softened",
    "0.75 cup white sugar",
    "2 eggs",
    "2 teaspoons grated lemon peel",
    "2 cups all-purpose flour",
    "1 teaspoon salt",
    "2.5 teaspoons baking powder",
    "0.75 cup milk",
    "0.5 cup chopped walnuts",
    "2 tablespoons white sugar",
    "2 teaspoons lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease 1 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter and 3/4 cup sugar until light and fluffy. Stir in the eggs one at a time, beating well with each addition, then stir in the lemon peel. In a separate bowl, sift together the flour, salt and baking powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend the flour mixture into the egg mixture, alternately with the milk; stir just to combine. Fold in the nuts; mixing just enough to evenly combine. Pour batter into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 50 to 55 minutes, until a toothpick inserted into center of loaf comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, dissolve 2 tablespoons sugar in the lemon juice. After loaf has cooled for 10 minutes, spoon glaze over loaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
