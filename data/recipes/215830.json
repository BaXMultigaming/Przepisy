  "ingredients": [
    "1.5 teaspoons ground black pepper",
    "0.5 teaspoon paprika",
    "0.25 teaspoon cayenne pepper",
    "1 teaspoon minced garlic",
    "1 tablespoon Dijon mustard",
    "1 tablespoon brown sugar",
    "0.5 teaspoon onion powder",
    "0.25 teaspoon salt",
    "1 tablespoon olive oil",
    "2 (6 ounce) salmon fillets",
    "2 tablespoons olive oil",
    "1.5 tablespoons minced onion"
  ],
  "steps": [
    {
      "text": "Combine black pepper, paprika, cayenne pepper, minced garlic, Dijon mustard, brown sugar, onion powder, and salt in a small bowl. Stir in 1 tablespoon olive oil to make a paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread paste over salmon fillets; set aside to marinate at room temperature for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining 2 tablespoons olive oil in a small pan over medium heat. Stir in onion; cook until tender and golden brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a separate nonstick skillet over medium-high heat. Cook salmon fillets in the hot skillet until golden brown on each side and no longer translucent in the center, about 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour caramelized onions and olive oil over salmon fillets to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
