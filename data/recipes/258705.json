      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_S6Zr2Xvi2bTl5rafOHV_hC1qTM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/258705-strawberry-crisp-DDMFS-010-step-02-4b5d119d0c7e4eb3b61ce977213d46df.jpg"
