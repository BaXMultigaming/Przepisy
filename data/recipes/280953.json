  "ingredients": [
    "1 tablespoon vegetable oil",
    "2 acorn squash",
    "0.5 cup brown sugar",
    "2 tablespoons unsalted butter",
    "1 teaspoon coarse sea salt",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground allspice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Cover a baking pan with aluminum foil and coat with vegetable oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove acorn squash stems, cut in half lengthwise, and clean out the seeds. Place squash cut side-down onto the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until tender, 30 to 60 minutes, depending on the size of the squash",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While squash roasts, place brown sugar, butter, sea salt, cinnamon, and allspice in a small bowl. Microwave to melt the butter, about 30 seconds; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove squash from the oven, turn over, and coat with the sugar mixture. Continue to roast for 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
