  "ingredients": [
    "2 medium sweet potatoes, scrubbed",
    "2 cups white sugar",
    "1 cup sweetened condensed milk",
    "0.5 cup unsalted butter, softened",
    "2 large eggs",
    "2 teaspoons all-purpose flour",
    "1 pinch ground cinnamon, or to taste",
    "1 pinch ground nutmeg, or to taste",
    "1 pinch ground allspice, or to taste",
    "1 pinch ground cloves, or to taste",
    "2 (9 inch) pie crusts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a pot of water to a boil; add sweet potatoes and boil until soft, 20 to 30 minutes. Drain, then remove and discard skins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash sweet potatoes in a bowl until no lumps remain; transfer 1 cup to a large bowl, and reserve the rest for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sugar, condensed milk, butter, eggs, flour, cinnamon, nutmeg, allspice, and cloves to sweet potatoes in the large bowl. Mix until well combined, then divide batter evenly between pie crusts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
