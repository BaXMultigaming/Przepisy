  "ingredients": [
    "4 cups sweet potatoes, peeled and cubed",
    "2 cups white sugar",
    "2 cups miniature marshmallows",
    "0.75 cup margarine, melted",
    "1 cup evaporated milk",
    "1 cup flaked coconut",
    "4 eggs, beaten",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground cinnamon",
    "1.5 cups crushed cornflakes cereal",
    "1 cup chopped pecans",
    "0.5 cup packed brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x13-inch baking dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sweet potatoes in a large bowl; stir in sugar, marshmallows, ¾ cup margarine, evaporated milk, coconut, eggs, nutmeg, and cinnamon to combine. Transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until sweet potatoes are tender, 20 minutes; leave oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine crushed cornflakes, pecans, remaining ¾ cup margarine, and brown sugar; spread over baked casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return casserole to the preheated oven; bake 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
