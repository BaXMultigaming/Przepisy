  "ingredients": [
    "1 (28 ounce) can diced tomatoes",
    "1 (14 ounce) can 100% pure pumpkin",
    "1 cup vegetable juice",
    "1 cup chopped okra",
    "1 cup chopped broccoli",
    "1 carrot, peeled and chopped",
    "1 small zucchini, diced",
    "1 small onion, diced",
    "2 tablespoons pumpkin pie spice",
    "2 tablespoons white sugar",
    "2 tablespoons white vinegar",
    "1 teaspoon chili powder, or to taste",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 (12 ounce) package vegetarian ground beef crumbles",
    "1 (19 ounce) can fava beans, drained",
    "2 cups chopped spinach"
  ],
  "steps": [
    {
      "text": "Combine the tomatoes, pumpkin, vegetable juice, okra, broccoli, carrot, zucchini, onion, pumpkin pie spice, sugar, vinegar, chili powder, salt, and pepper in a slow cooker; cook on High until the vegetables are tender, 3 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the vegetarian ground beef crumbles, fava beans, and spinach into the tomato mixture; continue cooking until completely warmed, 20 to 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
