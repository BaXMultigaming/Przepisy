  "ingredients": [
    "1 (17.5 ounce) package frozen puff pastry, thawed",
    "1 cup dulce de leche",
    "2 tablespoons confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll puff pastry over a floured surface; cut into 1 1/2-inch squares. Place on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden and crispy, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer baked squares to a wire rack and let cool completely, about 5 minutes. Slice each square in half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 2 tablespoons dulce de leche on 1/2 of the puff pastry squares; top with remaining puff pastry squares. Dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
