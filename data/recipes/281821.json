  "ingredients": [
    "1 bunch kale",
    "2 tablespoons olive oil",
    "1 tablespoon malt vinegar",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wash kale and tear leaves away from the ribs. Dry kale leaves completely and discard ribs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, vinegar, and salt together in a large bowl. Gently stir in kale \"chips\" until evenly coated. Let sit for 5 minutes for flavors to absorb.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide kale evenly and spread on the prepared baking sheets, making sure no pieces overlap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Use tongs to carefully flip each chip over and bake until crispy, about 5 minutes longer. Transfer chips that are done to a paper towel. Bake any larger chips that were not done in 2 minute intervals until desired doneness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
