  "title": "Salt and Vinegar Kale Chips",
  "description": "Salt and vinegar chip lovers will delight in this crispy, crunchy, and healthier snack that uses kale instead of potatoes.",
  "authors": [
    "Soup Loving Nicole"
  ],
  "date_published": "2019-04-28T22:24:48-04:00",
