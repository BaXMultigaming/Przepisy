  "ingredients": [
    "2 tablespoons paprika",
    "1 tablespoon salt",
    "2 teaspoons onion powder",
    "2 teaspoons garlic powder",
    "2 teaspoons cayenne pepper",
    "1.5 teaspoons ground white pepper",
    "1.5 teaspoons ground black pepper",
    "1 teaspoon dried thyme",
    "1 teaspoon dried oregano",
    "4 (6 ounce) fillets red snapper",
    "1.5 cups butter, melted"
  ],
  "steps": [
    {
      "text": "Mix paprika, salt, onion powder, garlic powder, cayenne pepper, white pepper, black pepper, thyme, and oregano together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large cast iron skillet over high heat until extremely hot, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip fish fillets into melted butter and sprinkle each fillet generously with seasoning mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fish fillets in the hot skillet and pour 1 tablespoon of butter over each fillet. Cook until coating on the underside of fillet turns black, 3 to 5 minutes. Turn fillets over and pour another tablespoon of butter over each fillet; cook until fish flakes easily with a fork, about 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
