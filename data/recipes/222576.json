  "ingredients": [
    "2 medium zucchini, trimmed",
    "2 large eggs, beaten",
    "1 sleeve buttery round crackers (such as Ritz®), crushed",
    "2 tablespoons olive oil",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Cut zucchini crosswise into 1/2-inch slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each zucchini slice into beaten egg, then press into cracker crumbs until both sides are coated. Shake off excess and place in a single layer on a plate; do not stack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BTdPP1sgOHq2j7YME7wACUk823U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222576-EasyFriedZucchini-mfs-Step1-1074-536e5c88f577454f9d92ebf754bdfa7c.jpg"
      ],
      "image": "assets/images/222576/step_02.webp"
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat. Pan-fry zucchini in the hot oil until crust browns and zucchini softens, about 3 minutes per side.",
