  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "0.5 cup butter, softened",
    "0.25 cup brown sugar",
    "0.25 cup confectioners' sugar",
    "1 teaspoon apple pie spice",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon vanilla extract",
    "0.33333334326744 cup chopped pecans",
    "2 tablespoons brown sugar",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Beat cream cheese and butter together in a bowl using an electric mixer until smooth and creamy; add 1/4 cup brown sugar, confectioners' sugar, apple pie spice, 1/2 teaspoon cinnamon, and vanilla extract and beat until smooth. Transfer cheese mixture to a piece of plastic wrap. Wrap plastic wrap around cheese, forming a ball; refrigerate until set, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pecans, 2 tablespoons brown sugar, and 1/4 teaspoon cinnamon together on a shallow plate. Unwrap cheese ball and roll in the pecan mixture until evenly coated, pressing to help topping stick to cheese ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
