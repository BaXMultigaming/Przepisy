  "ingredients": [
    "0.75 cup all-purpose flour",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.33333334326744 cup firmly packed brown sugar",
    "0.33333334326744 cup superfine sugar",
    "0.75 cup rolled oats",
    "0.75 cup dried cranberries",
    "0.75 cup white chocolate chips",
    "0.5 cup butter, melted and cooled",
    "1 egg, lightly beaten",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Sift flour, baking powder, baking soda, and salt into a bowl; pour flour mixture into a 4-cup glass jar. Layer brown sugar and superfine sugar in the jar, pressing firmly between each layer. Layer oats, cranberries, and chocolate chips. Seal jar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make cookies: Preheat oven to 375 degrees F (190 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Empty dry cookie mix in large bowl. Stir in butter, egg, and vanilla extract until combined. Roll the dough into tablespoon-sized balls and place 2 inches apart onto prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until lightly browned, 10 to 15 minutes. Cool on the sheets for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
