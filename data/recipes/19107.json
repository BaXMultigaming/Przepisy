  "ingredients": [
    "1 cup brown sugar",
    "1.25 cups water",
    "1 cup raisins",
    "0.33300000429153 cup shortening",
    "0.5 teaspoon salt",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground cinnamon",
    "2 cups all-purpose flour",
    "5 teaspoons baking powder"
  ],
  "steps": [
    {
      "text": "In a saucepan, combine brown sugar, water, raisins, shortening, nutmeg and cinnamon. Bring to a boil, and continue boiling for 3 minutes. Remove from heat and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9 inch square pan. Sift together flour and baking powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the raisin mixture with the flour mixture. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 45 minutes in the preheated oven, or until a toothpick inserted into the cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
