  "ingredients": [
    "2.6666667461395 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "2 cups packed brown sugar",
    "1 cup butter, softened",
    "2 eggs",
    "1 tablespoon vanilla extract",
    "2 tablespoons white sugar",
    "2 tablespoons ground cinnamon",
    "0.125 teaspoon ground ginger",
    "1 cup confectioners' sugar",
    "0.25 cup heavy whipping cream",
    "1 tablespoon ground cinnamon",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together in a bowl. Beat brown sugar, butter, eggs, and 1 tablespoon vanilla extract together in a bowl using an electric mixer until smooth and creamy. Stir flour mixture into creamed butter mixture until batter is well combined and thick; spread into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, 2 tablespoons cinnamon, and ginger together in a bowl; sprinkle over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until blondies are beginning to pull away from the sides of the pan and are set in the middle, 25 to 30 minutes. Allow blondies to cool, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat confectioners' sugar, cream, 1 tablespoon cinnamon, and 1 teaspoon vanilla extract together in a bowl until glaze is smooth; drizzle onto blondies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
