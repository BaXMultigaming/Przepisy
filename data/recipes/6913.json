  "ingredients": [
    "2 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.5 cups fresh cranberries",
    "0.5 cup pecans, coarsely chopped",
    "1 tablespoon grated orange zest",
    "1 cup white sugar",
    "0.25 cup margarine, softened",
    "1 egg",
    "0.75 cup orange juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EQLMY0HuyfeslO0TUJb1_BgJEOY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6913-cranberry-orange-loaf-VAT-step-01-fb07e608e79648c5a0431b6584e4d388.jpg"
      ],
      "image": "assets/images/6913/step_01.webp"
    },
    {
      "text": "Whisk flour, baking powder, baking soda, and salt together in a large bowl. Stir in cranberries, pecans, and zest. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ykp9KhScuMOLPdgwPQelumRxnQA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6913-cranberry-orange-loaf-VAT-step-03-0b0ab21033c34064af09b0e9ea989ac1.jpg"
      ],
      "image": "assets/images/6913/step_02.webp"
    },
    {
      "text": "Beat sugar, butter, and egg together in another large bowl until smooth. Stir in orange juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZeVaqczlJe-VrR46q28tki-EzhY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6913-cranberry-orange-loaf-VAT-step-02-12e6028affc24b71ae97e30ebbea2743.jpg"
      ],
      "image": "assets/images/6913/step_03.webp"
    },
    {
      "text": "Beat in flour mixture until just moist. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I6-7JFcCGHW9pv2ALwt4Yf58gIY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6913-cranberry-orange-loaf-VAT-step-04-af83939ad6a04ed18ff5cac26ffa2114.jpg"
      ],
      "image": "assets/images/6913/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until bread springs back when lightly touched, about 1 hour. Let stand 10 minutes; turn out onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
