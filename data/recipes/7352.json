  "ingredients": [
    "8 tablespoons shortening",
    "2 (1 ounce) squares unsweetened chocolate, melted",
    "2 eggs",
    "1 teaspoon baking soda",
    "1 cup milk",
    "1 cup white sugar",
    "1.75 cups all-purpose flour",
    "0.5 teaspoon salt",
    "2.5 teaspoons vanilla extract",
    "1 teaspoon instant coffee granules",
    "0.25 cup milk",
    "0.25 cup unsweetened cocoa powder",
    "6 tablespoons butter",
    "5 cups confectioners' sugar",
    "1.5 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease one 13x9 inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together the shortening and the white sugar. Add the melted chocolate and eggs, mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift the flour with baking soda and salt. Add alternately with 1 cup milk to shortening mixture. Mix in 1 teaspoon vanilla. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 25 to 30 minutes or until a toothpick stuck into the center of the cake comes out clean. Once cool frost with Coffee Frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Frosting: Mix together instant or leftover coffee, 1/4 cup milk or cream, cocoa powder, butter, 1 1/2 teaspoons vanilla extract, and confectioners' sugar until of spreading consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
