  "title": "Cream Cheese Sugar Cookies",
  "description": "These sugar cookies with cream cheese are soft, chewy, and simple to make by rolling out the chilled dough, cutting out desired shapes, and icing.",
  "authors": [
    "Karin Christian"
  ],
  "date_published": "1998-11-13T19:40:07-05:00",
