    "publisher-tested"
  ],
  "ingredients": [
    "1 cup white sugar",
    "1 cup butter, softened",
    "1 (3 ounce) package cream cheese, softened",
    "1 large egg yolk",
    "0.5 teaspoon salt",
    "0.5 teaspoon almond extract",
    "0.5 teaspoon vanilla extract",
    "2.25 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/omdgXcMi5JAKhPHt7A7U0bEr_8I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/CreamCheeseSugarCookiesRecipe_11116_ingredients-de5395bb45294060bdc3fc6ec22c61aa.jpg"
      ],
      "image": "assets/images/11116/step_01.webp"
    },
    {
      "text": "Beat together sugar, butter, cream cheese, egg yolk, salt, almond extract, and vanilla in a large bowl with an electric mixer until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x3DnBvhhBO4Zj7PPwF89lMe6bKs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/CreamCheeseSugarCookiesRecipe_11116_step2_0310-80bed22539594762bba71ba9df900c62.jpg"
      ],
      "image": "assets/images/11116/step_02.webp"
    },
    {
      "text": "Gradually mix in flour until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yb6_5XpOq3vtvNisjIwh8I3BuXE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/CreamCheeseSugarCookiesRecipe_11116_step3_0312-23d6195d769349dcb3f9b5870418aac8.jpg"
      ],
      "image": "assets/images/11116/step_03.webp"
    },
    {
      "text": "Divide dough into thirds and form each piece into a disk. Wrap tightly with plastic wrap and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WFQf9jkovIMCIjS3LdEr-JCSuEY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/CreamCheeseSugarCookiesRecipe_11116_step4_0314-9b8f297820124b4b9ca4d924bf318ad4.jpg"
      ],
      "image": "assets/images/11116/step_04.webp"
    },
    {
      "text": "When ready to bake, preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working with one disk at a time, roll dough on a lightly floured surface to an 1/8-inch thickness; keep other disks refrigerated until ready to roll.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wcJj7hlGoK3Mlz82F8VYeZ9Edrg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/CreamCheeseSugarCookiesRecipe_11116_step5_0318-0949f7a786484f26a21508c0a41e8c81.jpg"
      ],
      "image": "assets/images/11116/step_06.webp"
    },
    {
      "text": "Cut dough into desired shapes with lightly floured cookie cutters. Place cookies 1 inch apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PGy43_Jb_wqk6XWAUj9LmTauVjA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/CreamCheeseSugarCookiesRecipe_11116_step6_0320-77fb83e9b89f43b88774d3bb234380ec.jpg"
      ],
      "image": "assets/images/11116/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until cookies are light golden brown, 7 to 10 minutes, switching racks halfway through. Remove from the oven and transfer cookies to wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TwiSsq7hMkH3o6xnOcXQBk-XzK0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/CreamCheeseSugarCookiesRecipe_11116_step8_0325-da7f5cdc63b34fac85ee3fed126ec855.jpg"
      ],
      "image": "assets/images/11116/step_08.webp"
    },
    {
      "text": "Cool cookies completely before frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-JfOZZhAVA0-hMrMaKcE6aXl94Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/CreamCheeseSugarCookiesRecipe_11116_beauty_4x3_0335-b6ce072466814fed9e4eadaa8a635a75.jpg"
      ],
      "image": "assets/images/11116/step_09.webp"
    }
  ],
