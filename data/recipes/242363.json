  "ingredients": [
    "2 tablespoons olive oil",
    "1 cup chopped onion",
    "0.75 cup diced celery",
    "0.75 cup diced carrots",
    "2 cloves garlic, finely chopped",
    "2 teaspoons kosher salt",
    "0.75 cup tomato sauce",
    "2 cups green or brown lentils",
    "2 cups water",
    "4 cups low-sodium chicken or vegetable broth",
    "1 bay leaf",
    "1 sprig fresh thyme",
    "1 teaspoon balsamic or sherry vinegar",
    "0.25 cup olive oil",
    "2 tablespoons balsamic or sherry vinegar",
    "1 clove garlic, minced",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Cook onion, celery, carrots, and garlic with salt, stirring occasionally, until limp and browning, about 10 minutes. Transfer vegetables to a slow cooker with tomato sauce, lentils, water, broth, bay leaf, thyme, and vinegar. Cook on Low for 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For vinaigrette, whisk together olive oil, vinegar, garlic, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Taste soup for salt, then serve with a drizzle of vinaigrette over each bowl.",
