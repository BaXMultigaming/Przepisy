  "ingredients": [
    "2 tablespoons olive oil",
    "1 onion, diced",
    "0.25 bell pepper, diced",
    "2 (1/2 pound) venison steaks, cubed",
    "1 (1 ounce) package dry onion and mushroom soup mix",
    "3.5 cups water",
    "2 tablespoons all-purpose flour"
