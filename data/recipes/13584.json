  "ingredients": [
    "1 (9x9 inch) pan cornbread, cooled and crumbled",
    "1 (8 ounce) package herb-seasoned dry bread stuffing mix",
    "2 tablespoons chopped fresh parsley",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon salt",
    "0.75 cup butter",
    "1 cup chopped celery",
    "1 cup chopped onion",
    "2 cups chopped apples",
    "0.5 cup chopped pecans",
    "2 cups apple juice",
    "3 eggs, beaten"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter a 3 quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the butter in a heavy saucepan, and saute the celery and onion for 8 to 10 minutes, or until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the cornbread, stuffing mix, parsley, ginger, and salt. Mix in the celery and onion mixture, chopped apple, chopped pecans, apple juice, and beaten eggs. Spoon dressing into prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 to 35 minutes in the preheated oven, or until heated through, and lightly browned on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
