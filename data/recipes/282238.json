  "ingredients": [
    "2 tablespoons sunflower seed oil",
    "2 pounds carrots, grated",
    "1.5 quarts whole milk",
    "2 cups white sugar",
    "0.5 cup raisins",
    "1.5 teaspoons ground cardamom",
    "1 pinch saffron threads",
    "8 tablespoons chopped pistachio nuts"
  ],
  "steps": [
    {
      "text": "Heat ghee in a large saucepan over medium heat and add carrots. Cook and stir briefly, about 3 minutes. Pour in milk and increase heat; bring to a boil and cook, stirring constantly, for 5 minutes. Reduce heat to low and simmer gently, uncovered, and stirring occasionally until moisture evaporates, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring carrot mixture back to a boil; add sugar, raisins, cardamom, and saffron. Cook and stir until mixture has thickened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle carrot halwa into 8 individual serving dishes. Top each serving with 1 tablespoon pistachios. Serve warm or chill before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
