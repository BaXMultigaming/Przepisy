  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "6 potatoes",
    "2 green bell peppers, sliced",
    "1 cup cubed carrots",
    "2 onions, quartered",
    "1 dash Worcestershire sauce",
    "1 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 9x13 inch baking dish, place the chicken breasts. Add the potatoes, bell peppers, carrot and onion, all cubed or quartered. Sprinkle all liberally with Worcestershire sauce and a dash of paprika. Cover dish and bake in the preheated oven for 1 1/2 hour. That's it! Enjoy!",
      "section": null,
