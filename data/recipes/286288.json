  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a rimmed baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Clean mushrooms and brush with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine hash browns, spinach, sour cream, 1/4 cup Cheddar cheese, blue cheese, jalapeno peppers, onion, garlic powder, onion powder, and salt in a bowl; mix until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pack a heaped tablespoon hash brown mixture into each mushroom and transfer to the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
