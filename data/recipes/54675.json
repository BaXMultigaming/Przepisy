      ],
      "image": "assets/images/54675/step_01.webp"
    },
    {
      "text": "Preheat the oven to 450 degrees F (220 degrees C). Grease a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine olive oil and garlic in a large resealable bag. Add cauliflower, seal the bag, and toss until cauliflower is coated. Pour into the prepared casserole dish and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zTTU2-q6_6IsWjB1dT_luDh3Ai0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/54675-RoastedGarlicCauliflower-mfs-step2-1344-80c01559b2714085b800d14bb0137822.jpg"
      ],
      "image": "assets/images/54675/step_03.webp"
    },
    {
      "text": "Roast in the preheated oven for 25 minutes, stirring halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and turn on the broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle Parmesan cheese and parsley over the cauliflower.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xEZ97_KEZYccsuUQoN0SXGZoKkQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/54675-RoastedGarlicCauliflower-mfs-Step3-1369-280232d7477a4a01b524f73440ac2de4.jpg"
      ],
      "image": "assets/images/54675/step_06.webp"
    },
    {
      "text": "Return to the oven and broil until golden brown, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nNPK3kWyN58EnPPfnL9nE78gVw8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/54675-RoastedGarlicCauliflower-mfs-Step4-1387-7fc2bd5ade56481e92623227cda46915.jpg"
