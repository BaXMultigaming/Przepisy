  "ingredients": [
    "2 pounds ground turkey",
    "1 cup finely crushed tortilla chips",
    "1 egg",
    "2 cups Dannon Oikos Plain Greek Nonfat Yogurt",
    "0.5 cup chopped cilantro",
    "1 cup prepared (jar) picante sauce or salsa, divided",
    "1 cup frozen corn kernels, thawed",
    "1 cup black beans",
    "1 teaspoon cumin",
    "1 teaspoon ground chipotle chili powder, divided"
  ],
  "steps": [
    {
      "text": "In a bowl Mix together yogurt, salsa, cumin and chipotle chili powder. Set 1 1/2 cups aside in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl mix together turkey, crushed chips, egg, remaining seasoned yogurt, cilantro, corn, black beans. Using a small scoop spoon, make tablespoon sized balls, and place on a lightly greased shallow baking sheet and bake in a preheated 400 degrees F for 20-25 minutes or until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve meat balls on shredded lettuce with reserved sauce for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
