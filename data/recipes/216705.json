  "ingredients": [
    "3 cups cooked mashed sweet potatoes",
    "1 cup white sugar",
    "1 (8 ounce) can crushed pineapple, drained",
    "0.5 (14 ounce) bag flaked coconut, or more to taste",
    "0.5 cup butter, melted",
    "0.33333334326744 cup milk",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1 cup firmly packed brown sugar",
    "1 cup finely chopped pecans",
    "0.33333334326744 cup all-purpose flour",
    "0.33333334326744 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sweet potatoes, white sugar, pineapple, coconut, 1/2 cup melted butter, milk, eggs, and vanilla extract together in a large bowl until smooth; pour into the prepared pan and set aside. Combine brown sugar, pecans, flour, and 1/3 cup melted butter in a separate bowl; sprinkle over sweet potato mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until casserole is bubbly and topping is browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
