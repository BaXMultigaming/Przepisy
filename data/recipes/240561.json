  "ingredients": [
    "1 tablespoon butter",
    "2 tablespoons white sugar",
    "2 tablespoons all-purpose flour",
    "1 tablespoon nonfat dry milk powder",
    "0.125 teaspoon baking powder",
    "0.125 teaspoon ground cinnamon",
    "1 pinch salt",
    "2 tablespoons water",
    "1 (4 ounce) container diced peaches, well drained"
  ],
  "steps": [
    {
      "text": "Place butter in a microwave-safe mug. Microwave on high until melted, about 20 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, flour, milk powder, baking powder, cinnamon, and salt in a small bowl: stir in water. Stir sugar mixture into melted butter in the mug with a fork until batter is well mixed; add peaches on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on 70 percent power for 2 minutes. Let stand, about 1 minute. Cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
