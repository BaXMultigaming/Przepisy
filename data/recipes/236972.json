  "ingredients": [
    "0.25 cup boiling water",
    "0.5 teaspoon lapsang souchong tea leaves",
    "2 tablespoons brown sugar",
    "0.75 cup pineapple juice",
    "0.5 cup tamari (dark soy sauce)",
    "0.5 cup canola oil",
    "1 (1 1/2 inch) piece fresh ginger root, peeled and chopped",
    "2 cloves garlic, minced",
    "2 tablespoons sherry",
    "1 tablespoon honey"
  ],
  "steps": [
    {
      "text": "Pour boiling water over tea leaves in a mug and steep for 3 minutes; strain and discard tea leaves. Dissolve brown sugar into the tea and set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pineapple juice, tamari, canola oil, ginger, garlic, sherry, and honey in a jar; add tea mixture. Seal jar and shake until the oil emulsifies into the marinade.",
      "section": null,
