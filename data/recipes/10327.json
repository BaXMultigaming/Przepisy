  "ingredients": [
    "2 (1 ounce) squares unsweetened chocolate",
    "1 (14 ounce) can sweetened condensed milk",
    "1 pinch salt",
    "1 tablespoon water",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "In heavy saucepan, over medium heat, melt chocolate with sweetened condensed milk and salt. Cook and stir until it thickens, about 10 minutes.",
