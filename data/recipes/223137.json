  "ingredients": [
    "2 teaspoons coconut oil, or as needed",
    "0.25 cup raisins",
    "1 cup warm water",
    "0.25 cup coconut oil, softened",
    "0.25 cup butter, softened",
    "0.5 cup brown sugar",
    "2 eggs, beaten",
    "2 ripe bananas, mashed",
    "4.5 ounces applesauce",
