  "ingredients": [
    "1 acorn squash, halved and seeded",
    "0.25 cup butter, divided",
    "0.25 cup packed brown sugar, divided"
  ],
  "steps": [
    {
      "text": "Place squash halves, cut-sides up, on a microwave-safe plate or dish. Place 2 tablespoons butter and 2 tablespoons brown sugar in cavity of each half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on full power until squash flesh is soft, 8 to 10 minutes. Rotate squash about twice to ensure even cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop flesh with sugar and butter into a bowl; slightly mash to blend.",
      "section": null,
      "name": null,
      "url": null,
