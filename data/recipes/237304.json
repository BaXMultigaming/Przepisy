  "ingredients": [
    "1 cup unsalted butter, softened",
    "1 cup crunchy peanut butter",
    "1 cup barley malt syrup",
    "1 cup white sugar",
    "2 eggs",
    "2.5 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Beat butter, peanut butter, barley malt syrup, and white sugar together in a bowl using an electric mixer until smooth and creamy. Beat eggs into creamed butter mixture until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, baking powder, and salt together in a bowl; stir into creamed butter mixture until dough is just mixed. Refrigerate dough for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1-inch balls and arrange on baking sheets. Flatten each ball using a fork, making a crisscross pattern.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated until edges of cookies are browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
