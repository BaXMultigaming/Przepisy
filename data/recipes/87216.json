  "ingredients": [
    "1 (48 fluid ounce) can chicken broth",
    "3 cups water",
    "2 frozen skinless, boneless chicken breast halves - diced",
    "1 small onion, diced",
    "1 cup thinly sliced carrots",
    "1 teaspoon lemon pepper",
    "1 teaspoon dried oregano",
    "1 dash garlic salt",
    "2 cups fresh broccoli florets",
    "1 (9 ounce) package frozen cheese tortellini",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring the broth and water to a boil in a large pot, and mix in chicken, onion, and carrots. Season with lemon pepper, oregano, and garlic salt. Reduce heat to low, and simmer 25 minutes, or until chicken juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the broccoli into the pot, and cook 10 minutes. Stir in the tortellini, and continue cooking 10 minutes, or until tortellini is al dente. Mix in the Paremsan cheese just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
