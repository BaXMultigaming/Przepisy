  "ingredients": [
    "1 cup white sugar",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "10 (8 inch) flour tortillas",
    "3 cups oil for frying"
  ],
  "steps": [
    {
      "text": "Combine sugar, cinnamon, and nutmeg in a large resealable plastic bag. Seal and toss to mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep fryer or deep skillet to 375 degrees F (190 degrees C). Fry 4 or 5 tortilla strips until golden brown, about 30 seconds. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While still warm, place fried tortillas in a bag and shake to coat with sugar mixture. Serve at once or store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
