  "ingredients": [
    "8 ounces uncooked elbow macaroni",
    "6 ounces Colby-Jack cheese, cubed",
    "2 dill pickles, chopped",
    "1 (5 ounce) can albacore tuna in water, drained and flaked",
    "0.5 cup light mayonnaise",
    "0.5 teaspoon prepared yellow mustard",
    "1 teaspoon dill pickle juice",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a saucepan of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 7 minutes. Rinse under cold running water, then drain well, and pat lightly with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine macaroni, Colby-Jack cheese, pickles, tuna, mayonnaise, and mustard in a large bowl; season with pickle juice, salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bowl; refrigerate before serving, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
