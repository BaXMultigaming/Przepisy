  "ingredients": [
    "cooking spray",
    "3 cups crispy rice cereal",
    "3 cups toasted oat cereal rings (such as Cheerios®)",
    "1.5 cups raw unsalted sunflower seeds",
    "1 cup raisins",
    "0.75 cup chocolate chips",
    "1 cup honey",
    "0.75 cup brown sugar",
    "2 cups peanut butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Spray a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix crispy rice cereal, oat cereal rings, sunflower seeds, raisins, and chocolate chips together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir honey and brown sugar in a saucepan, place over high heat, and bring to a boil. Stir and boil for 1 minute. Remove from heat and stir in peanut butter and vanilla extract until smooth and well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the hot peanut butter mixture into the dry ingredients and stir until all dry ingredients are moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press the mixture into the prepared baking dish to make an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cool and cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
