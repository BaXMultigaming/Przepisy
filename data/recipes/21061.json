  "ingredients": [
    "3 slices bacon",
    "8 crimini mushrooms",
    "1 tablespoon butter",
    "1 tablespoon chopped onion",
    "0.75 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, dice and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove mushroom stems. Set aside caps. Chop the stems.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan over medium heat, melt the butter. Slowly cook and stir the chopped stems and onion until the onion is soft. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the mushroom stem mixture, bacon and 1/2 cup Cheddar. Mix well and scoop the mixture into the mushroom caps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 15 minutes, or until the cheese has melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the mushrooms from the oven, and sprinkle with the remaining cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
