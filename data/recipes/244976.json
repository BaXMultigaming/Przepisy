  "ingredients": [
    "3 large Yukon Gold potatoes, peeled and cut into sticks",
    "2 tablespoons olive oil",
    "2 teaspoons dried chervil",
    "0.5 teaspoon dried dill",
    "0.5 teaspoon dried rosemary",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potato sticks in a large bowl; pour olive oil over potatoes. Crush chervil, dill, rosemary, onion powder, and garlic powder together with a mortar and pestle; sprinkle herb mixture over potatoes and toss to coat completely. Spread potatoes on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tender and browned, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
