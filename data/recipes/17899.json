  "title": "Chocolate Sheet Cake I",
  "description": "Good old fashioned chocolate cake with homemade chocolate frosting. A family favorite for many many years.",
  "authors": [
    "Kim"
  ],
  "date_published": "2000-03-25T22:30:02-05:00",
