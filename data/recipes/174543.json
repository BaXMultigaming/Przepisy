  "ingredients": [
    "2 tablespoons butter",
    "2 tablespoons vegetable oil",
    "4 large skinless, boneless chicken thighs, cut into bite-sized pieces",
    "1 onion, diced",
    "3 cloves garlic, minced",
    "1 (6 ounce) can tomato paste",
    "1 tablespoon curry paste",
    "2 teaspoons curry powder",
    "2 teaspoons tandoori masala",
    "1 teaspoon garam masala",
    "15 green cardamom pods",
    "1 (14 ounce) can coconut milk",
    "1 cup low-fat plain yogurt",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HBUfpyqggrdW69ECbB1KHf2fCCE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-174543-slow-cooker-butter-chicken-DDMFS-4x3-step-01-b81d9423a3214070aabaa1074c36783f.jpg"
      ],
      "image": "assets/images/174543/step_01.webp"
    },
    {
      "text": "Heat butter and vegetable oil in a large skillet over medium heat. Stir in chicken, onion, and garlic. Cook and stir until onion has softened and turned translucent, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dtt4pPzK6-o2LehfygV4ZzCDt6g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-174543-slow-cooker-butter-chicken-DDMFS-4x3-step-02-52e4901f17d743eaa80d11d585b04bb9.jpg"
      ],
      "image": "assets/images/174543/step_02.webp"
    },
    {
      "text": "Stir in tomato paste, curry paste, curry powder, tandoori masala, and garam masala until no lumps of tomato paste remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WYmCtBlMBokbzz3oVoLGYahYY0Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-174543-slow-cooker-butter-chicken-DDMFS-4x3-step-03-b93e091660ae44c197b732a2e2098b7d.jpg"
      ],
      "image": "assets/images/174543/step_03.webp"
    },
    {
      "text": "Pour mixture into a slow cooker. Stir in cardamom pods, coconut milk, and yogurt; season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4aOVqAEDMrq-fLDNxtTGAMnIz8Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-174543-slow-cooker-butter-chicken-DDMFS-4x3-step-04-b88447f5d81d4e50a9f6385318ccd966.jpg"
      ],
      "image": "assets/images/174543/step_04.webp"
    },
    {
      "text": "Cook on High for 4 to 6 hours or Low for 6 to 8 hours, or until chicken is tender and sauce has reduced to the desired consistency. Remove and discard cardamom pods before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c1pEcL59S2RT85dGbJpyi7CSENw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-174543-slow-cooker-butter-chicken-DDMFS-4x3-e2aa838d73c44b2d84a0ecd716113ba1.jpg"
      ],
      "image": "assets/images/174543/step_05.webp"
    }
  ],
