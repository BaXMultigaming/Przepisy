  "ingredients": [
    "6 tablespoons butter",
    "1.125 cups all-purpose flour",
    "0.5 cup rolled oats",
    "6 tablespoons packed brown sugar",
    "0.125 teaspoon salt",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rorv4NcqGC8It7s03ciUr8Wh5tY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12291-cherry-crumble-VAT-009-step-01-e2ffaf07d13440af9390b286c40aa16a.jpg"
      ],
      "image": "assets/images/12291/step_01.webp"
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Remove from heat, then stir in flour, oats, brown sugar, and salt until mixture resembles dry crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bFU3jIGd0YNs4rGBAqE9y0n9Q3k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12291-cherry-crumble-VAT-0010-step-02-1911c61989ba48758e89ad637f99508e.jpg"
      ],
      "image": "assets/images/12291/step_02.webp"
    },
    {
      "text": "Press about 2/3 of the crumbs evenly into the bottom of a 9-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/456WuuP20wDyTXl8opHJnlnCDLQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12291-cherry-crumble-VAT-0012-step-03-2a2bac28466e478093c95bcbdad86b68.jpg"
      ],
      "image": "assets/images/12291/step_03.webp"
    },
    {
      "text": "Top with cherry pie filling and sprinkle with remaining crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/psb_5Pd8DwogSmqrqNpEJKY-fjQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12291-cherry-crumble-VAT-0013-step-04-d91a13f9ed3c4be8bb65ee7209fca545.jpg"
      ],
      "image": "assets/images/12291/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until cherries are bubbling and top is golden brown, 40 to 45 minutes. Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/haLPzuG2k08YJg8E11gIM4MWO9s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12291-cherry-crumble-VAT-0014-step-05-64990c1411db4b238e8f62e84c04f93f.jpg"
      ],
