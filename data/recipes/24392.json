  "ingredients": [
    "4 cups vegetable broth",
    "1 (28 ounce) can whole peeled tomatoes",
    "1.5 cups shredded cooked turkey",
    "2 roma (plum) tomatoes, chopped",
    "1 onion, chopped",
    "1 (4 ounce) can chopped green chile peppers",
    "2 cloves garlic, crushed",
    "1 tablespoon lime juice",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon ground cumin",
    "salt and pepper to taste",
    "1 avocado - peeled, pitted and diced",
    "0.5 teaspoon dried cilantro",
    "1 cup shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Combine broth, canned tomatoes, turkey, fresh tomatoes, onion, green chiles, garlic, and lime juice in a large pot over medium heat; season with cayenne pepper, cumin, salt, and black pepper. Bring to a boil, then reduce heat; simmer 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in avocado and cilantro; simmer until slightly thickened, 15 to 20 minutes. Serve hot, topped with Monterey Jack cheese.",
      "section": null,
      "name": null,
