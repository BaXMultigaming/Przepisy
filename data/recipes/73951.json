  "ingredients": [
    "3 cups fresh blueberries",
    "1.5 cups white sugar, divided",
    "1 egg",
    "2 tablespoons shortening",
    "1.5 cups all-purpose flour",
    "1 cup milk",
    "2 teaspoons baking powder",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place blueberries in a casserole dish; sprinkle with 1 cup sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat remaining ½ cup sugar, egg, and shortening together in a large bowl; beat in flour, milk, baking powder, and salt until evenly combined. Drop spoonfuls of batter over blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
