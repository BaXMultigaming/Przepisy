  "title": "Ham Bone and Green Split Pea Soup",
  "description": "This split pea soup with ham bone is quick to prepare. The addition of onion, celery, carrots, and garlic create a hearty combination of flavors.",
  "authors": [
    "Mark"
  ],
  "date_published": "2020-02-01T02:52:01-05:00",
