  "ingredients": [
    "0.25 cup butter",
    "0.25 cup white sugar",
    "1 egg, beaten",
    "2 tablespoons milk",
    "0.5 cup self-rising flour"
  ],
  "steps": [
    {
      "text": "Cream butter and sugar in a medium bowl until smooth. Grandually mix in egg and milk, being careful the batter doesn't curdle. Sift in flour, then fold gently to incorporate. Transfer to a 1-pint microwave-safe bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and microwave on full power until pudding appears set when gently jiggled and the top is sticky, about 3 1/2 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
