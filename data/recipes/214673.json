  "ingredients": [
    "1 quart strawberries, sliced",
    "1 pint fresh blueberries",
    "0.25 cup white sugar",
    "1 (8 ounce) package cream cheese, softened",
    "1 (7 ounce) container marshmallow creme",
    "2.3333332538605 cups baking mix (such as Bisquick ®)",
    "0.5 cup milk",
    "3 tablespoons white sugar",
    "3 tablespoons melted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine strawberries, blueberries, and ¼ cup sugar in a bowl until evenly coated; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese and marshmallow cream in a separate bowl until smooth; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine baking mix, milk, 3 tablespoons sugar, and melted butter in a separate bowl until smooth; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden brown on top, 12 to 15 minutes. Cool shortcake in the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread berry mixture and juice over cooled shortcake, reserving a few pretty berries for garnish. Gently press down on berries with a spatula to allow juices to soak into cake; spread cream cheese mixture over top. Garnish with reserved berries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill in the refrigerator before cutting into squares, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
