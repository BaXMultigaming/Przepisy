  "ingredients": [
    "0.5 cup butter flavored shortening",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2.25 cups all-purpose flour",
    "0.33300000429153 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.75 cups grated zucchini"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat shortening, white sugar, and brown sugar together in a bowl with an electric mixer until smooth; beat in egg and vanilla extract until well combined. Whisk flour, cocoa powder, baking soda, and salt together in a separate bowl; gradually stir into shortening mixture. Fold in zucchini until incorporated. Drop rounded spoonfuls of batter onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 8 to 10 minutes. Cool cookies on the baking sheets for 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
