  "ingredients": [
    "1 (12 ounce) package maple flavored sausage",
    "3 tablespoons butter",
    "0.25 cup all-purpose flour",
    "3 cups whole milk",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
