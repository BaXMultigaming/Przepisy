  "title": "Byron's Delicious Strawberry Cake",
  "description": "This homemade strawberry cake is baked from scratch with pureed fresh strawberries and strawberry extract. It is perfect for any spring or summer get-together.",
  "authors": [
    "ByronTheCook"
  ],
  "date_published": "2020-06-18T23:48:18-04:00",
