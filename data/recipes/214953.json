  "ingredients": [
    "3 cups nonfat Greek yogurt",
    "0.66666668653488 cup white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Stir together yogurt, sugar, and vanilla in a bowl until sugar is dissolved. Cover and refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k0yaE71XZIZz_KvzpLMqE9_2Q8g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214953-Vanilla-Frozen-Yogurt-Step1a-4x3.2616-494fb6b34a9640818922cdb7f33df021.jpg"
      ],
      "image": "assets/images/214953/step_01.webp"
    },
    {
      "text": "Pour chilled mixture into an ice cream maker and freeze according to the manufacturer's directions until it reaches \"soft-serve\" consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GDH7WsELTrUr8XD0zi9neJATxLw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214953-Vanilla-Frozen-Yogurt-Step3-4x3.2626-29e195fc62804c5594490fc2fc527a3e.jpg"
      ],
      "image": "assets/images/214953/step_02.webp"
    },
    {
      "text": "Transfer to a 1- or 2-quart plastic container with a lid; cover surface with plastic wrap and seal. Allow frozen yogurt to ripen in the freezer for at least 2 hours or overnight.",
