  "ingredients": [
    "1 (6 ounce) jar roasted red peppers, drained and coarsely chopped",
    "0.25 cup roasted garlic",
    "1 teaspoon hot pepper sauce, or to taste",
    "0.5 cup freshly squeezed lemon juice",
    "0.25 teaspoon dried oregano",
    "0.125 teaspoon ground white pepper",
    "8 ounces crumbled feta",
    "4 ounces cream cheese, softened",
    "0.25 cup extra-virgin olive oil",
    "0.25 cup half-and-half"
  ],
  "steps": [
    {
      "text": "Place roasted red peppers, roasted garlic, hot pepper sauce, lemon juice, oregano, and white pepper into a blender; puree until smooth. Add feta and cream cheese, and puree until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With blender running, slowly pour in olive oil until incorporated and thickened. Stir in half-and-half if needed to achieve a dip consistency. Cover and store in the refrigerator until ready to serve.",
