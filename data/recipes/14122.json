  "ingredients": [
    "1 bunch fresh cilantro",
    "1 clove garlic",
    "1 tablespoon minced fresh ginger root",
    "1 minced hot green chile peppers",
    "1 tablespoon peanuts",
    "salt to taste",
    "2 tablespoons lemon juice"
  ],
  "steps": [
    {
      "text": "Blend the following in a food processor until smooth: cilantro, garlic, ginger, green chili, peanuts, salt to taste, and lemon juice. Add a few drops of water if the mixture is too dry.",
