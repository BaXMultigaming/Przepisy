  "ingredients": [
    "2 cups packed brown sugar",
    "2 cups white sugar",
    "0.75 cup butter, softened",
    "1 cup shortening",
    "4 eggs",
    "2 teaspoons vanilla extract",
    "1.5 cups all-purpose flour",
    "1.5 cups whole wheat flour",
    "2 teaspoons salt",
    "2 teaspoons baking soda",
    "3 cups rolled oats",
    "1.5 cups semisweet chocolate chips",
    "1.5 cups chopped walnuts",
    "2 cups flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream sugars, butter and shortening. Beat in eggs and vanilla until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in sifted flours, salt and baking soda and stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in remaining ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop in teaspoon size balls on greased baking sheet about 2 inches apart. Bake 8 minutes or until edges are brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
