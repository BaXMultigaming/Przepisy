  "ingredients": [
    "2 cups rigatoni pasta",
    "2 cups shredded cooked chicken breast",
    "1 teaspoon dry ranch salad dressing mix (such as Hidden Valley Ranch®)",
    "1 teaspoon salt",
    "0.5 teaspoon black pepper",
    "0.5 teaspoon garlic powder",
    "1 (8 ounce) package Neufchatel cheese",
    "1 (8 ounce) container sour cream",
    "0.5 cup Buffalo wing sauce (such as Frank's RedHot®)",
    "0.5 cup shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook rigatoni in the boiling water, stirring occasionally until tender yet firm to the bite, about 12 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LN5sVvqgIX6s5kRSaFzPvfS1M8M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273599-buffalo-chicken-pasta-VAT-step-01-c870e8dd1e86407c9ee919f266d3e73a.jpg"
      ],
      "image": "assets/images/273599/step_01.webp"
    },
    {
      "text": "Season chicken with ranch dressing mix, salt, pepper, and garlic powder. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GiVspFbJH5ALwux1iCeZLgf_DTY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273599-buffalo-chicken-pasta-VAT-step-02-87939a8a579a428e83a6b5edc120a09f.jpg"
      ],
      "image": "assets/images/273599/step_02.webp"
    },
    {
      "text": "Meanwhile, combine Neufchatel cheese, sour cream, and Buffalo wing sauce in a large saucepan over low heat. Cook, stirring constantly, until well combined, about 3 minutes. Add Cheddar cheese and stir well until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iCGHP-11HE6QVq8ILiEKfrj63PA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273599-buffalo-chicken-pasta-VAT-step-03-d31a1d6bfc324a96906db842e887c377.jpg"
      ],
      "image": "assets/images/273599/step_03.webp"
    },
    {
      "text": "Add pasta and chicken and continue cooking until well incorporated and heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xNwOj_67Lr-IRuswzwbTsXDI-AI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273599-buffalo-chicken-pasta-VAT-step-04-fa5216ed6c784efdbd012675abeb4a65.jpg"
