  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix",
    "0.5 cup unsalted butter, melted",
    "1 (21 ounce) can cherry pie filling",
    "0.33 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Grease a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cake mix and melted butter together in a bowl until butter is evenly distributed and mixture is crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pie filling in the prepared slow cooker. Sprinkle cake mix-butter mixture evenly over top, then sprinkle with walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low for 4 hours or on High for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow to cool for at least 20 to 30 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
