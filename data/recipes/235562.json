  "ingredients": [
    "3 racks St. Louis style ribs",
    "salt and pepper to taste",
    "1 cup all-purpose flour for dredging",
    "6 eggs, beaten",
    "2 sleeves RITZ Crackers",
    "1 tablespoon coarsely ground black pepper",
    "1 teaspoon granulated garlic",
    "1 teaspoon kosher salt",
    "4 cups vegetable oil for frying",
    "2 tablespoons Cajun seasoning, for ribs",
    "1.25 cups mayonnaise",
    "1 cup buttermilk",
    "0.25 cup finely chopped chives",
    "0.25 cup freshly grated Parmigiano-Reggiano cheese",
    "2 tablespoons Cajun seasoning",
    "2 tablespoons red wine vinegar",
    "2 teaspoons minced garlic"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Place a wire rack over a shallow baking pan and pour 1 cup water into the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season ribs with salt and pepper. Place ribs onto the prepared rack, meaty side up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until you can gently tear the meat between the bones or an instant-read thermometer inserted into the meat reads 180 degrees F (83 degrees C), 2 1/2 to 3 hours. Remove from the oven and set aside to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ribs are cooled, cut into individual ribs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour in a shallow bowl. Place beaten eggs in a small bowl. Pulse crackers in a food processor until finely crushed; you should get about 2 cups crumbs. Mix together crumbs, 1 tablespoon coarse black pepper, granulated garlic, and 1 teaspoon kosher salt in a second shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge ribs in flour, dip in eggs, then press in crumb mixture to coat. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep 9-inch skillet to 350 degrees F (175 degrees C). Place ribs meat-side down into hot oil; ribs should be about 3/4 covered with oil. Working in batches, fry ribs in hot oil until crispy and golden brown, 1 1/2 to 2 minutes. Drain ribs on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While ribs are still hot, sprinkle with Cajun seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make dressing: Whisk together mayonnaise, buttermilk, chives, cheese, Cajun seasoning, vinegar, and garlic in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve ribs with dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TQBkl5rKJiyq6NUroqiK3T_6Rg0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/1075058-77f38ed890014b828790b58ededd269c.jpg"
      ],
