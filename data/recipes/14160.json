  "ingredients": [
    "1 pound bacon",
    "4 cups broccoli florets",
    "5 green onions, chopped",
    "0.25 cup sunflower seeds",
    "0.25 cup golden raisins",
    "1 cup mayonnaise",
    "0.5 cup white sugar",
    "6 tablespoons red wine vinegar"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet. Cook over medium-high heat until evenly browned. Cool, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss together broccoli, green onions, sunflower seeds, raisins, and crumbled bacon in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together mayonnaise, sugar, and red wine vinegar in a small bowl. Toss with vegetables to coat. Cover and chill in the refrigerator until serving.",
      "section": null,
