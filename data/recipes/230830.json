  "ingredients": [
    "1 cup quinoa",
    "2 cups nonfat milk",
    "1 pinch salt",
    "3 tablespoons maple syrup",
    "0.5 lemon, zested",
    "1 cup blueberries",
    "2 teaspoons flax seed"
  ],
  "steps": [
    {
      "text": "Rinse quinoa with cold water in a fine-mesh strainer until water runs clear and is no longer frothy to remove bitterness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat milk in a saucepan over medium heat until warm, 2 to 3 minutes. Stir quinoa and salt into milk; simmer over medium-low heat until most liquid has been absorbed, about 20 minutes. Off heat, stir in maple syrup and lemon zest; gently fold in blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide quinoa mixture between 2 bowls; top each with 1 teaspoon flax seed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
