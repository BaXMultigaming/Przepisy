  "ingredients": [
    "1.5 cups all-purpose flour",
    "3.5 teaspoons baking powder",
    "1 tablespoon white sugar",
    "0.25 teaspoon salt, or more to taste",
    "1.25 cups milk",
    "3 tablespoons butter, melted",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IeQxUZWp8LNovpf1QBjVAyGTmCU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21014-good-old-fashioned-pancakes-VAT-006-step-01-bcdc01eae3054391a8fc12fb231a7226.jpg"
      ],
      "image": "assets/images/21014/step_01.webp"
    },
    {
      "text": "Sift flour, baking powder, sugar, and salt together in a large bowl. Make a well in the center and add milk, melted butter, and egg; mix until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fQn7oqrkg-2-5NLVPfBKJ2EPXag=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21014-good-old-fashioned-pancakes-VAT-007-step-02-01-903b507442f34e51b54346c5f08f950b.jpg"
      ],
      "image": "assets/images/21014/step_02.webp"
    },
    {
      "text": "Heat a lightly oiled griddle or pan over medium-high heat. Pour or scoop the batter onto the griddle, using approximately 1/4 cup for each pancake; cook until bubbles form and the edges are dry, about 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Qh5kv7qvxK3FROmv69G-f6baiA8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21014-good-old-fashioned-pancakes-VAT-008-step-03-2bd38c6cadd142849ed8635bea029dbd.jpg"
      ],
      "image": "assets/images/21014/step_03.webp"
    },
    {
      "text": "Flip and cook until browned on the other side. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oPWZUPTP39_Q4ETTnMzzlxZeL9w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21014-good-old-fashioned-pancakes-VAT-009-step-04-9d5a399cb2e34900a9a789eb6f0831ea.jpg"
      ],
      "image": "assets/images/21014/step_04.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ywrODZNVX6SDdyA3XqkgeqBF1M4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21014-good-old-fashioned-pancakes-VAT-004-4x3-02-d6ce3b61def840fcaf40a43f805b733e.jpg"
