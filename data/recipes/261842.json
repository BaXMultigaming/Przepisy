  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup chopped walnuts",
    "0.66666668653488 cup butter",
    "0.66666668653488 cup brown sugar",
    "2 (8 ounce) packages cream cheese, softened",
    "0.5 cup white sugar",
    "2 eggs",
    "0.25 cup milk",
    "2 tablespoons lemon juice",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, walnuts, butter, and brown sugar together in a bowl. Line a 9x13-inch baking pan with half the crust mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned, about 15 minutes. Remove crust and leave oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese and white sugar together in another bowl using an electric mixer until blended. Add eggs, milk, lemon juice, and vanilla extract; mix until blended. Pour on top of the baked crust. Sprinkle with remaining crust mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the hot oven until set, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
