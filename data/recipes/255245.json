        "https://www.allrecipes.com/thmb/11S7o_mHF-uGeWFKTd3iB2RUUn4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255245-award-winning-white-chicken-chili-DDMFS-step-4-d7ee726a5f6c483085e64b4cd0a7197d.jpg"
