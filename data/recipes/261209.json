  "ingredients": [
    "3 vegetarian sausage links, or more to taste",
    "0.5 onion, minced",
    "1 cup mushrooms",
    "1 clove garlic",
    "1 tablespoon Italian seasoning",
    "1 (15 ounce) can pumpkin puree",
    "1 quart vegetable broth",
    "1 cup light cream",
    "0.25 cup grated Parmesan cheese",
    "2 teaspoons hot sauce"
  ],
  "steps": [
    {
      "text": "Cook sausage in a skillet over medium heat until heated through, 3 to 5 minutes. Transfer sausage to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place onion, mushrooms, garlic, and Italian seasoning into the skillet over medium heat; cook until soft, about 5 minutes. Stir in pumpkin puree. Add vegetable broth. Reduce heat and simmer until flavors are blended, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in sausage, light cream, Parmesan cheese, and hot sauce; simmer 10 to 15 minutes more.",
      "section": null,
