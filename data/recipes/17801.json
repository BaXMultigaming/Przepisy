  "ingredients": [
    "2 tablespoons butter",
    "2.5 cups cooked and cubed ham",
    "2 green onions, chopped",
    "1 cup pineapple chunks, drained",
    "1.3329999446869 cups pineapple juice",
    "4 teaspoons cider vinegar",
    "2 tablespoons brown sugar",
    "2 teaspoons prepared mustard",
    "2 tablespoons cornstarch"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Sauté ham, onions, and pineapple chunks in hot butter for about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pineapple juice, vinegar, brown sugar, mustard, and cornstarch in a separate medium bowl; mix well and pour over ham mixture in the skillet. Stir well and allow to heat through and thicken, about 5 minutes.",
