  "ingredients": [
    "2.5 cups milk, divided",
    "2 tablespoons cornstarch",
    "2 cups shredded Colby longhorn cheese",
    "0.5 teaspoon garlic salt",
    "0.125 teaspoon ground red pepper",
    "4 drops yellow food coloring"
  ],
  "steps": [
    {
      "text": "In a small bowl combine 1/2 cup milk with cornstarch; mix well and set aside.",
      "section": null,
