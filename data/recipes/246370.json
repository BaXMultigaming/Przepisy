  "ingredients": [
    "1 pound white raisins",
    "1 pound red and green candied cherries, chopped",
    "1 pound dates, pitted and chopped",
    "6 slices candied pineapple, chopped",
    "1 cup bourbon whiskey, divided, or as needed",
    "1 cup butter, softened",
    "1 cup brown sugar",
    "3 eggs",
    "1 tablespoon vanilla extract",
    "1 tablespoon ground cinnamon",
    "28 ounces pecans, chopped",
    "3 cups self-rising flour"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/U3Xx9Pkb56PvLPBwY-9Tt_LqDkk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246370-aunt-berts-fruitcake-cookies-VAT-step-01-1f877a90326147a9a50e143c64e75223.jpg"
      ],
      "image": "assets/images/246370/step_01.webp"
    },
    {
      "text": "Place raisins, candied cherries, dates, and candied pineapple in a bowl; stir in 1/2 cup bourbon whiskey; set aside to soak.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w3NP3Y7FNiYkLkIaJRk0qowDpcw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246370-aunt-berts-fruitcake-cookies-VAT-step-02-45c734ba823b46e795b82a42fb539f05.jpg"
      ],
      "image": "assets/images/246370/step_02.webp"
    },
    {
      "text": "Beat butter and brown sugar together in a large bowl with an electric mixer until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xd5r5m-yQFQ0A_6ESvmPabJuz9M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246370-aunt-berts-fruitcake-cookies-VAT-step-03-e3bcf56bef2844e3a945b931c630db82.jpg"
      ],
      "image": "assets/images/246370/step_03.webp"
    },
    {
      "text": "Beat one egg at a time into the butter mixture; beat in vanilla extract and cinnamon with last egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cOs-NlGGaq461R_SUby7oAHSPiY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246370-aunt-berts-fruitcake-cookies-VAT-step-04-555c8d31166b4a209c1d3eae9d1e0a5d.jpg"
      ],
      "image": "assets/images/246370/step_04.webp"
    },
    {
      "text": "Stir pecans and fruit mixture into butter mixture; stir in self-rising flour alternately with remaining bourbon whiskey as needed to form a soft dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-kmhu3BDIav0GwLbzP59W1UaPHU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246370-aunt-berts-fruitcake-cookies-VAT-step-05-94cbfbd1aa834e9c9ddb2ff148b0166d.jpg"
      ],
      "image": "assets/images/246370/step_05.webp"
    },
    {
      "text": "Drop tablespoonfuls of dough 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jOqE8YRWw8nNXyKc1mYCfUNkHQ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246370-aunt-berts-fruitcake-cookies-VAT-step-06-e6c54a65f2af48f79ba2192236a208ba.jpg"
      ],
      "image": "assets/images/246370/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven just until cookies begin to look dry, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9tZMampTZIPfgNRtfeWxKss1gEA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246370-aunt-berts-fruitcake-cookies-VAT-step-07-dc7abf70accf4a9a9667431c3fe400b4.jpg"
      ],
      "image": "assets/images/246370/step_07.webp"
    },
    {
      "text": "Cool cookies on a wire rack; store in a sealed container lined with waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_d2l220noyhYkBJxQMUQ2CVwD_g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246370-aunt-berts-fruitcake-cookies-VAT-step-08-a0421f94c7c9426caab65f95dfaa71ba.jpg"
      ],
      "image": "assets/images/246370/step_08.webp"
    }
