  "ingredients": [
    "1 (32 ounce) jar sauerkraut with juice",
    "1 pound pork roast, cut into 1 inch cubes",
    "0.5 (12 fluid ounce) can or bottle beer",
    "1 tablespoon minced garlic",
    "1 teaspoon onion salt",
    "1 teaspoon dry mustard",
    "1.5 teaspoons fresh dill weed",
    "0.5 medium apple, peeled and cored"
  ],
  "steps": [
    {
      "text": "Stir undrained sauerkraut, pork cubes, beer, garlic, onion salt, dry mustard, and dill together in a slow cooker until well combined. Press apple half under other ingredients to submerge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for 1 hour. Reduce the heat to Low and continue cooking until pork is cooked through, about 5 more hours. Discard apple and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
