  "ingredients": [
    "1 cup sour cream",
    "1 cup mayonnaise",
    "1 tablespoon dried minced onion",
    "2 tablespoons dried parsley",
    "2 teaspoons dried dill weed",
    "2 teaspoons Beau Monde ™ seasoning",
    "0.25 teaspoon seasoning salt",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "In a medium bowl, mix sour cream, mayonnaise, onion, parsley, dill weed, Beau Monde ™ seasoning, seasoning salt and pepper. Cover and chill in the refrigerator 8 hours, or overnight, before serving. Enjoy!",
