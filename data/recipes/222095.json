  "ingredients": [
    "1 whole egg",
    "3 egg whites",
    "1 tablespoon water",
    "2 cups whole wheat bread crumbs",
    "3 eggplant, peeled and thinly sliced",
    "6 cups spaghetti sauce, divided",
    "0.75 pound part-skim mozzarella cheese, shredded and divided",
    "0.5 cup grated Parmesan cheese, divided",
    "0.5 teaspoon dried basil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together egg, egg whites, and water in a shallow bowl until well combined. Place bread crumbs on a large plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip eggplant slices in egg mixture, then bread crumbs until evenly coated. Place in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fork tender, 7 to 10 minutes on each side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread spaghetti sauce to cover the bottom of a 9x13-inch baking dish. Place a layer of baked eggplant slices in sauce. Sprinkle with some mozzarella and Parmesan cheese. Repeat with remaining ingredients, ending with cheeses. Sprinkle basil on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
