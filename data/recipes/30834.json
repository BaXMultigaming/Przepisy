  "ingredients": [
    "4 pounds beef short ribs",
    "0.5 cup brown sugar",
    "1 cup ketchup",
    "2 tablespoons water",
    "2 tablespoons apple cider vinegar",
    "0.5 cup lemon juice",
    "0.5 cup grated celery",
    "0.5 cup grated onion",
    "salt and pepper to taste"
  ],
