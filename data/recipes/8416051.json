  "ingredients": [
    "1 (1 pound) loaf round sourdough bread, unsliced",
    "1 pound Monterey Jack cheese, sliced",
    "0.5 cup butter, melted",
    "0.5 cup chopped green onion, green parts only",
    "3 teaspoons poppy seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut bread widthwise into 1-inch slices to within 1/2 inch from the bottom of the loaf. Repeat cuts in opposite direction. Tear cheese slices into small pieces. Place cheese inside cuts of bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter, green onions, and poppy seeds. Drizzle over bread, brushing sides of bread with butter mixture. Wrap bread in foil and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Unwrap bread and continue to bake until cheese is melted, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
