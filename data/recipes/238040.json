  "ingredients": [
    "Crisco® No-Stick Cooking Spray",
    "1.5 cups Martha White® Self-Rising Flour",
    "0.5 cup Martha White® Self-Rising Enriched White Corn Meal Mix",
    "1 teaspoon sugar",
    "0.33333334326744 cup Crisco® All-Vegetable Shortening*",
    "0.75 cup buttermilk, plus",
    "2 tablespoons buttermilk"
  ],
  "steps": [
    {
      "text": "Heat oven to 450 degrees F. Lightly spray a cookie sheet with no-stick cooking spray. Combine flour, corn meal mix and sugar in medium bowl; mix well. With pastry blender or fork, cut in shortening until mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add buttermilk; stir with fork until a soft dough forms and mixture pulls away from sides of bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead dough on lightly floured surface with floured hands just until smooth. Roll out dough to 1/2-inch thickness. Cut with floured 2-inch round cutter; place biscuits on prepared cookie sheet",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 10 to 12 minutes or until golden brown. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
