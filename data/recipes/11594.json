  "ingredients": [
    "0.5 cup butter, softened",
    "0.75 cup granulated artificial sweetener",
    "2 tablespoons water",
    "0.5 teaspoon vanilla extract",
    "1 egg, beaten",
    "1.125 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup semisweet chocolate chips",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together butter and sugar substitute. Mix in water, vanilla, and egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking soda, and salt; stir into the creamed mixture. Mix in the chocolate chips and pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by heaping teaspoonfuls onto cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 10 to 12 minutes. Remove from the cookie sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
