  "ingredients": [
    "1 cup packed brown sugar",
    "1 (3.4 ounce) package instant butterscotch pudding mix",
    "0.25 cup white sugar",
    "2 teaspoons ground cinnamon",
    "24 ounces frozen dinner roll dough",
    "0.5 cup chopped walnuts",
    "0.5 cup melted butter"
  ],
  "steps": [
    {
      "text": "Grease and flour a 9- or 10-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together brown sugar and pudding mix in a small bowl. Mix together white sugar and cinnamon in a second small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange a single layer of frozen dinner rolls in the prepared pan. Sprinkle with some of the brown sugar mixture, then sprinkle with some of the white sugar mixture. Cover with 1/2 of the nuts, then drizzle with 1/2 of the melted butter. Repeat layers with remaining rolls and toppings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let sit uncovered on the counter for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Let stand for a few minutes, then turn the pan onto a serving platter and lift to release bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
