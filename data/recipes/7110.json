  "title": "Quick and Easy Monkey Bread",
  "description": "This monkey bread with made frozen rolls is baked with cinnamon, sugar, butterscotch pudding mix, butter, and nuts for a sweet, gooey pull-apart treat.",
  "authors": [
    "MARBALET"
  ],
  "date_published": "1999-03-22T13:48:44-05:00",
