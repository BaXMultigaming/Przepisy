  "ingredients": [
    "10 slices white sandwich bread, quartered",
    "12 slices honey ham, chopped",
    "1.5 cups shredded Swiss cheese",
    "2 tablespoons spicy brown mustard",
    "2 tablespoons mayonnaise",
    "20 dill pickle slices",
    "20 toothpicks"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Divide quartered bread slices evenly between 2 large baking sheets .",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ham, Swiss cheese, mustard, and mayonnaise in a large bowl and mix well. Place 1 tablespoon of mixture on top of each piece of bread on 1 of the baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake topped bread in the preheated oven for 4 minutes. Add baking sheet with plain bread to the oven and continue baking 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove both baking sheets from the oven. Place a dill pickle slice on each topped bread slice; cover with a piece of plain toasted bread. Secure each mini sandwich with a toothpick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
