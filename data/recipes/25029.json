  "ingredients": [
    "4 cups rolled oats",
    "1 cup brown sugar",
    "0.5 cup white sugar",
    "1 cup butter, melted",
    "1 cup milk chocolate chips",
    "0.75 cup peanut butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the oats, brown sugar and white sugar. Stir in the melted butter until well blended. Pat the mixture evenly into the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 minutes in the preheated oven, until toasty. In the microwave or in a heat-proof bowl over simmering water, melt chocolate chips and peanut butter together, stirring occasionally until smooth. Spread over the baked crust. Let cool before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
