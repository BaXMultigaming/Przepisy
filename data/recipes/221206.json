  "regions": [],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 cups brown sugar",
    "1 pound bacon",
    "2 cups heavy whipping cream",
    "1 cup milk",
    "0.5 cup maple syrup"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place brown sugar into a shallow bowl; press bacon slices into brown sugar on both sides to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay bacon slices onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until bacon is crisp and brown sugar has formed a glaze, about 20 minutes. Remove from sheet and cool thoroughly; chop bacon and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cream, milk, and maple syrup in a bowl until thoroughly combined; stir in candied bacon pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into an ice cream maker and freeze according to manufacturer's instructions. Serve soft or pack ice cream into lidded container and freeze to harden if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
