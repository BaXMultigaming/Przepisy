  "title": "Pig Candy Ice Cream",
  "description": "Rich maple ice cream is full of candied bacon pieces instead of pecans for a special savory-sweet ice cream treat that will please your family of bacon lovers.",
  "authors": [
    "PUDDINMOM"
  ],
  "date_published": "2020-03-05T00:08:48-05:00",
