  "ingredients": [
    "1.5 pounds venison, slightly frozen and sliced into 1/16-inch slices",
    "8 garlic scapes, minced",
    "0.33333334326744 cup canola oil",
    "0.25 cup soy sauce",
    "4 hamburger buns, split",
    "4 slices sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Place venison strips in a bowl; sprinkle with garlic scapes. Pour in canola oil and soy sauce; mix well. Cover bowl and let venison marinate for at least one hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat grill fitted with fine grate grill topper to medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Evenly spread venison on the grill topper. Stir occasionally to evenly cook meat until no longer pink, about 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm hamburger buns on warming rack of grill. Divide venison among the buns and top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
