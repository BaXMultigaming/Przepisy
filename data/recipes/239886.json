  "ingredients": [
    "1 cup cornmeal, or more as needed",
    "0.25 cup tapioca flour",
    "3 tablespoons rice flour",
    "2.6666667461395 tablespoons buckwheat flour",
    "2.75 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "3 tablespoons butter, softened",
    "0.75 cup milk",
    "2 eggs, beaten",
    "2 tablespoons honey",
    "1 teaspoon vinegar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour 4 muffin cups or ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift cornmeal, tapioca flour, rice flour, buckwheat flour, baking powder, baking soda, and salt into a large bowl. Add butter to cornmeal mixture and stir until well combined. Mix milk, eggs, honey, and vinegar into cornmeal mixture just until batter is combined, adding more cornmeal if batter is too runny. Pour batter into the prepared muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are firm and lightly browned, 20 to 25 minutes; cool in the muffin cups for 3 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
