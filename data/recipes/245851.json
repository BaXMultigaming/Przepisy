  "ingredients": [
    "cooking spray",
    "5 tablespoons bacon grease",
    "1 tablespoon lemon juice",
    "1 clove garlic, minced",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon brown sugar",
    "0.25 teaspoon dried thyme",
    "2 pounds red snapper fillets",
    "2 cups stewed tomatoes",
    "2 onions, chopped",
    "0.25 teaspoon Worcestershire sauce",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Combine bacon fat, lemon juice, garlic, salt, pepper, brown sugar, and thyme together in a bowl. Spread a small amount of the bacon fat mixture in bottom of baking dish. Lay snapper fillets into baking dish; cover with remaining bacon fat mixture. Cover baking dish with plastic wrap and marinate in the refrigerator, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove plastic wrap from baking dish; add tomatoes, onions, and Worcestershire sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until fish flakes easily with a fork, 40 to 60 minutes. Garnish with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
