  "ingredients": [
    "0.75 cup vegetable oil",
    "1 (1 ounce) package dry Ranch-style dressing mix",
    "1.5 teaspoons garlic salt",
    "1 teaspoon ground cayenne pepper",
    "1 teaspoon lemon pepper",
    "1.5 (15 ounce) packages mini pretzels"
  ],
  "steps": [
    {
      "text": "Mix together oil, dressing mix, garlic salt, cayenne, and lemon pepper in a small bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pretzels in a large resealable plastic bag. Pour in ranch dressing mixture. Seal the bag and shake to coat. Allow pretzels to marinate for about 2 hours before serving. Shake occasionally to maintain coating.",
      "section": null,
