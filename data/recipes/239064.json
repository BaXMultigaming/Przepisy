  "ingredients": [
    "0.5 cup grapeseed oil",
    "0.33333334326744 cup granulated sugar",
    "3 tablespoons cider vinegar",
    "2 tablespoons fresh lime juice",
    "1 tablespoon grated lime zest",
    "1 clove garlic, minced",
    "0.5 teaspoon salt",
    "0.5 teaspoon poppy seeds",
    "0.5 teaspoon paprika",
    "0.5 teaspoon dry mustard",
    "0.5 cup pecans",
    "2 oranges, peeled and sectioned",
    "2.5 cups bite-size broccoli florets",
    "1 red apple, chopped",
    "1 cup grapes, halved"
  ],
  "steps": [
    {
      "text": "Beat grapeseed oil, sugar, cider vinegar, lime juice, lime zest, garlic, salt, poppy seeds, paprika, and mustard together in a bowl with a whisk until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a small skillet over medium heat. Toast pecans in hot skillet, stirring frequently, until fragrant, 4 to 5 minutes.; spread onto a cutting board to cool completely before chopping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss orange sections, broccoli, apple, and grapes together in a bowl. Drizzle dressing over salad and toss gently to coat. Cover bowl with plastic wrap and refrigerate until chilled, 2 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle chopped pecans over salad.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
