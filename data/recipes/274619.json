  "ingredients": [
    "2 cups water",
    "1 (3 ounce) package beef-flavored ramen noodles",
    "1 cup thinly sliced shiitake mushrooms",
    "0.5 cup frozen shelled edamame",
    "1 tablespoon reduced-sodium soy sauce",
    "2 teaspoons Sriracha sauce, or more to taste",
    "1 (4 ounce) beef top sirloin, thinly sliced",
    "1 tablespoon chopped fresh cilantro, or to taste"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a large saucepan. Add ramen noodles and seasoning packet; cook and stir for 1 minute. Add mushrooms, edamame, soy sauce, and Sriracha; cook for 1 more minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sirloin and cook until firm and reddish-pink and juicy in the center, 1 to 2 minutes. An instant-read thermometer inserted into meat should read 130 degrees F (54 degrees C) for medium-rare.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle soup into bowls. Garnish with cilantro and more Sriracha if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
