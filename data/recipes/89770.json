  "ingredients": [
    "0.5 cup bacon grease",
    "0.75 cup cornmeal",
    "0.33333334326744 cup all-purpose flour",
    "0.25 teaspoon ground black pepper",
    "0.25 cup milk",
    "1 egg",
    "1 green tomato, cut into 1/4 inch slices"
  ],
  "steps": [
    {
      "text": "Heat bacon grease in a large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cornmeal, flour, and black pepper together in a shallow bowl until well combined. Whisk milk and egg together in a separate shallow bowl until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip tomato slices into milk mixture, then press into cornmeal mixture until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in hot bacon grease until browned on each side, 3 to 4 minutes per side. Bacon grease burns easily, so adjust heat as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
