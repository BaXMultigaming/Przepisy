  "ingredients": [
    "1.3333333730698 cups water",
    "0.66666668653488 cup quinoa",
    "1 bunch kale, torn into bite-sized pieces",
    "0.5 avocado - peeled, pitted, and diced",
    "0.5 cup chopped cucumber",
    "0.33333334326744 cup chopped red bell pepper",
    "2 tablespoons chopped red onion",
    "1 tablespoon crumbled feta cheese",
    "0.25 cup olive oil",
    "2 tablespoons lemon juice",
    "1.5 tablespoons Dijon mustard",
    "0.75 teaspoon sea salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring 1 1/3 cups water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa tender and water absorbed, 15 to 20 minutes. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a steamer basket into a saucepan with 1 inch water; bring water to a boil. Add kale, cover, and steam until hot, about 45 seconds; transfer to a large plate. Top kale with quinoa, avocado, cucumber, bell pepper, red onion, and feta cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, lemon juice, Dijon mustard, sea salt, and black pepper together in a bowl until emulsified; pour over salad.",
      "section": null,
      "name": null,
