  "ingredients": [
    "6 large clams in shells",
    "12 unsalted soda crackers, crushed",
    "3 tablespoons garlic powder",
    "2 tablespoons chopped fresh parsley",
    "0.5 cup butter",
    "1 medium lemon, juiced",
    "0.5 teaspoon hot pepper sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a saucepan of water to a boil. Cook clams in the boiling water until all shells are open, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the clams are cooking, combine crushed crackers, garlic powder, and parsley in a large resealable bag. Seal the bag and crush the mixture until finely ground and well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Add cracker crumb mixture and cook, stirring constantly, until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain clams. Remove and discard the empty half shell from each clam. Transfer full halves to a baking sheet; spoon crumb mixtureinto each shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is browned and crispy, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve clams with lemon juice and hot pepper sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
