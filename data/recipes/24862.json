  "ingredients": [
    "1 (12 ounce) package fresh or frozen cranberries",
    "0.75 cup white sugar",
    "0.75 cup coarsely chopped walnuts",
    "0.75 cup orange marmalade",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cranberries in a small, shallow baking dish. Sprinkle with sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover cranberries with aluminum foil. Bake in the preheated oven approximately 35 minutes. Remove from heat, sprinkle with walnuts and recover. Continue baking 10 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir marmalade and lemon juice into cranberry mixture. Cool to room temperature. Transfer to sterile containers, cover and chill in the refrigerator at least 3 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
