  "ingredients": [
    "1.5 cups couscous",
    "3 cups chicken stock",
    "1 tablespoon curry powder",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper",
    "2 tablespoons extra-virgin olive oil",
    "0.5 cup raisins",
    "1 bunch cilantro, chopped",
    "0.5 cup slivered almonds, toasted"
  ],
  "steps": [
    {
      "text": "Pour couscous into a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together chicken stock, curry powder, salt, pepper, olive oil, and raisins in a large saucepan and bring to a boil; remove from heat and pour boiling liquid over couscous. Seal the bowl with plastic wrap and let sit for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
