  "ingredients": [
    "3 eggs, beaten",
    "1 cup raisins",
    "1 teaspoon vanilla extract",
    "1 cup butter",
    "1 cup packed brown sugar",
    "1 cup white sugar",
    "2.5 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "2 teaspoons baking soda",
    "2 cups rolled oats",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Combine eggs, vanilla and raisins in a small bowl; cover and let stand for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together in a large bowl until creamy. Sift flour, cinnamon, and baking soda together; stir into the creamed mixture. Stir in the raisin mixture, oats, and pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoonfuls onto an ungreased baking sheet. Bake in the preheated oven until lightly browned, about 10 minutes. Let cool briefly on the baking sheets before transferring to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
