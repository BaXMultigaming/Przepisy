  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter, melted",
    "2 large eggs",
    "0.5 cup self-rising flour",
    "0.33300000429153 cup unsweetened cocoa powder",
    "0.25 teaspoon salt",
    "1 teaspoon vanilla extract",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour an 8x8- or 9x9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together sugar and butter in a medium bowl. Add eggs and mix well. Combine flour, cocoa, and salt; stir into sugar mixture. Mix in vanilla, then stir in walnuts. Spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are firm, 25 to 30 minutes. Cool before cutting into squares.",
