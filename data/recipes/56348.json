  "ingredients": [
    "1 (18 pound) whole turkey",
    "8 cups prepared stuffing",
    "0.5 cup unsalted butter, softened",
    "salt and freshly ground black pepper to taste",
    "1.5 quarts turkey stock, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Place a rack in the lowest position of the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LzWlJxz4aLed6dCE9iH6MXMcrro=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-56348-a-simply-perfect-roast-turkey-VAT-4x3-step-01-b27b061877d9443684cf0336eb3d257e.jpg"
      ],
      "image": "assets/images/56348/step_01.webp"
    },
    {
      "text": "Remove turkey neck and giblets; pat dry with paper towels. Place breast-side up, on a rack in a large roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J3Un5BxK5MFlbk54ouvWQk9MJ8E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-56348-a-simply-perfect-roast-turkey-VAT-4x3-step-02-46eddaa150a94e038d85a8cb182b5633.jpg"
      ],
      "image": "assets/images/56348/step_02.webp"
    },
    {
      "text": "Loosely fill cavity with stuffing. Rub skin with butter; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zns43jJRpVkvUSDF905LqsDSTFw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-56348-a-simply-perfect-roast-turkey-VAT-4x3-step-03-b55e1fdd5d88449ab970ad0e04a32bd8.jpg"
      ],
      "image": "assets/images/56348/step_03.webp"
    },
    {
      "text": "Pour 2 cups of turkey stock into the roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1B-U6p-wJclrJSTPzPU1kBD2pzY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-56348-a-simply-perfect-roast-turkey-VAT-4x3-step-04-904af2a2ecee4f08894fed8cfa297778.jpg"
      ],
      "image": "assets/images/56348/step_04.webp"
    },
    {
      "text": "Loosely tent turkey with aluminum foil; roast for 2 ½ hours, basting with pan juices every 30 minutes. When drippings evaporate, add remaining stock to the pan, 1 to 2 cups at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_V9bjbSkbsli3RRj8z-PARDvuVU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-56348-a-simply-perfect-roast-turkey-VAT-4x3-step-05-34fcdb5fb79948e7a8aba011da383ea2.jpg"
      ],
      "image": "assets/images/56348/step_05.webp"
    },
    {
      "text": "Remove foil and continue roasting until a meat thermometer inserted in thickest part of thigh reads 165 degrees F (75 degrees C), about 1 ½ hours more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TAAzpJqNpFi1-NyKmeSo1GCFw7w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-56348-a-simply-perfect-roast-turkey-VAT-4x3-step-06-6fc1ca1ac9c043a8be434e8bf39a6044.jpg"
      ],
      "image": "assets/images/56348/step_06.webp"
    },
    {
      "text": "Let stand for 20 to 30 minutes before carving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a0vg_b66qOOHkt8vSEy2BFO0mm0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-56348-a-simply-perfect-roast-turkey-VAT-4x3-step-07-49e535fe01e7467486a784e8f19b40ad.jpg"
      ],
      "image": "assets/images/56348/step_07.webp"
    }
