  "ingredients": [
    "4 tablespoons butter",
    "0.25 cup finely chopped onion",
    "0.5 cup water",
    "8 cloves garlic, finely chopped",
    "2 (1.41 ounce) packages sazon seasoning with saffron (such as Goya® Azafran)",
    "1 lemon, juiced",
    "salt and ground black pepper to taste",
    "0.5 (12 ounce) bottle beer",
    "2 teaspoons hot sauce (such as Tabasco®), or to taste",
    "1 pound uncooked medium shrimp, peeled and deveined"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium heat. Sauté onion in hot butter until slightly golden, about 5 minutes. Stir in water, garlic, sazon seasoning, lemon juice, salt, and pepper; cook for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in beer and hot sauce; bring to a boil. Add shrimp and cook until bright pink on the outside and the meat is opaque, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
