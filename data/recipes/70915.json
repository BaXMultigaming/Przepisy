  "ingredients": [
    "4 cloves garlic, crushed",
    "3 tablespoons soy sauce",
    "2 tablespoons rice vinegar",
    "2 teaspoons honey",
    "0.25 teaspoon ground cardamom",
    "6 chicken thighs",
    "0.75 teaspoon kosher salt",
    "0.75 teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Place garlic, soy sauce, rice vinegar, honey, and cardamom in a resealable plastic bag. Place chicken thighs in the bag and squeeze to coat. Press out most of the air; seal the bag. Marinate in the refrigerator for 4 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from marinade; discard excess marinade. Place chicken on a broiling pan or baking sheet. Season with kosher salt and freshly ground black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until chicken is browned, crisp, no longer pink in the center, and the juices run clear, about 40 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
