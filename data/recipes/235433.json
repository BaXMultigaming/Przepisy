  "title": "Copycat V8 Juice",
  "description": "This V8 drink recipe is made with tomatoes, celery, onion, bell pepper, beet, carrot, and garlic juice flavored with Worcestershire and horseradish.",
  "authors": [
    "Lisa"
  ],
  "date_published": "2020-06-18T23:57:13-04:00",
