  "ingredients": [
    "1.5 pounds tomatoes, chopped",
    "0.33333334326744 large onion, chopped",
    "3 tablespoons chopped celery",
    "0.375 carrot, chopped",
    "0.25 beet",
    "0.125 green bell pepper, seeded and chopped",
    "0.33333334326744 clove garlic",
    "2.3333332538605 cups water, or as needed",
    "1.5 teaspoons lemon juice",
    "1.25 teaspoons white sugar",
    "0.25 teaspoon horseradish",
    "0.25 teaspoon Worcestershire sauce, or to taste",
    "0.125 teaspoon ground black pepper",
    "1 (1 quart) sterilized canning jar with lid and ring",
    "1 tablespoon white sugar",
    "1.25 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LqlDxfaQpdwlJm3PLbXuNgFyyfc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235433-CopyCatV8Juice-ddmfs-step1-4x3-0168-859a1ed9133a48b1be1b0559cad7293a.jpg"
      ],
      "image": "assets/images/235433/step_01.webp"
    },
    {
      "text": "Process tomatoes, onion, 3 tablespoons plus 1/2 teaspoon celery, carrot, beet, green bell pepper, and garlic through a juicer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RZkgK6HG_JuGEbu7aoVd8eE0u6c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235433-CopyCatV8Juice-ddmfs-step2-4x3-0171-de08ae2873f844e381837a7f8f9810aa.jpg"
      ],
      "image": "assets/images/235433/step_02.webp"
    },
    {
      "text": "Stir together vegetable juices, water, lemon juice, 1 1/4 teaspoons sugar, horseradish, Worcestershire sauce, and black pepper in a large pot. Bring to a boil and cook until flavors blend, about 20 minutes. Meanwhile, sterilize the jar and lid in boiling water for at least 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V9zvNaqxZpGHX6kpaKQf2Y_b7W8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235433-CopyCatV8Juice-ddmfs-step3-4x3-0184-7de3589ba8754995b86a9401cc25e32e.jpg"
      ],
      "image": "assets/images/235433/step_03.webp"
    },
    {
      "text": "Ladle juice into the jar. Stir 1 tablespoon sugar and salt into juice. Wipe the rim of the jar with a moist paper towel to remove any residue. Top with the lid and screw on the ring.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nhFzACj-Qdo80cA5-7hjdDINHbQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235433-CopyCatV8Juice-ddmfs-step4-4x3-0192-6e7043c25e36448fa6ea2fc1205c0f39.jpg"
      ],
      "image": "assets/images/235433/step_04.webp"
    },
    {
      "text": "Process juice in a pressure canner at 10 pounds of pressure for 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mU-E561ni-ynxWHLB5RpMIriB8g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235433-CopyCatV8Juice-ddmfs-step7-4x3-0235-0b480a8bae974e01a98149e0c0b00a73.jpg"
      ],
      "image": "assets/images/235433/step_05.webp"
    },
    {
      "text": "Remove the jar from the pressure canner and place onto a cloth-covered or wooden surface until cool. Press the center of the lid with a finger to ensure the lid does not move up or down. Remove the ring for storage and store in a cool, dark area.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/U9jc04X-ywRVYN9j5snp4JNLtj8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235433-CopyCatV8Juice-ddmfs-step8-4x3-0237-764f4d8a13d4446aa15274fda8ff381b.jpg"
      ],
      "image": "assets/images/235433/step_06.webp"
    }
