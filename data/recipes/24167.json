  "ingredients": [
    "6 pita breads",
    "1 (6.5 ounce) can tomato sauce",
    "1 (4 ounce) can sliced black olives, drained",
    "1 ounce diced pimento peppers, drained",
    "2 small tomatoes, thinly sliced",
    "4 ounces shredded mozzarella cheese",
    "4 ounces blue cheese, crumbled",
    "1 pinch dried basil",
    "1 pinch dried oregano",
    "1 pinch crushed coriander seed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm pitas in a microwave until soft, about 1 minute. Lightly spread tomato sauce on each pita, pressing to flatten while spreading. Sprinkle each pita with black olives, pimento peppers, tomatoes, mozzarella cheese, blue cheese, basil, oregano, and coriander.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange prepared pitas on a large baking sheet and place in the preheated oven until the pita bread has reached desired crispness, about 8 minutes. Serve whole or cut into slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
