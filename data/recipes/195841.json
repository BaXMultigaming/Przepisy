  "ingredients": [
    "2 tablespoons olive oil",
    "1.25 pounds ground turkey",
    "1 cup finely chopped white onion",
    "1 clove garlic, minced",
    "0.25 teaspoon ground black pepper",
    "1.5 tablespoons prepared yellow mustard, divided",
    "0.125 teaspoon cayenne pepper",
    "0.125 teaspoon chili powder",
    "1 cup water",
    "0.25 cup finely chopped jalapeno",
    "5 hamburger buns"
  ],
  "steps": [
    {
      "text": "Heat the olive oil over medium-low heat; cook and stir the ground turkey, using the back of a wooden spoon to work the meat into small crumbles as it cooks. When the meat is about half browned, stir in the onion, garlic, and black pepper; cook and stir until the turkey is crumbly, evenly browned, and no longer pink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in 1 tablespoon of the prepared mustard, the cayenne pepper, chili powder, and water. Bring the mixture to a boil, reduce the heat, and simmer, stirring, until the water has evaporated, about 20 minutes. Stir in the remaining mustard and the chopped jalapeno, and cook until heated through, about 5 more minutes. Spoon the mixture onto the hamburger buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
