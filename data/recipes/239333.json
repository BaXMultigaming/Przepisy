  "ingredients": [
    "1.5 cups warm water",
    "2 (.25 ounce) packages active dry yeast**",
    "1 cup Idahoan® Original Mashed Potatoes*",
    "2 tablespoons sugar",
    "2 tablespoons melted, cooled butter or oil",
    "1 tablespoon salt",
    "4.5 cups all-purpose flour, or more as needed"
  ],
  "steps": [
    {
      "text": "Combine warm water and yeast in a mixing bowl; let stand for several minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in mashed potatoes, sugar, butter, and salt; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour to make a soft dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a floured surface and knead until dough is smooth and elastic, adding flour as needed, for 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place dough in bowl, cover, and let rise for 1 hour. Punch dough down, divide in half, and shape each half into a loaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place doughs in 4x8-inch loaf pans, cover, and let rise until doubled, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 30 to 35 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
