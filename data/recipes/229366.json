  "ingredients": [
    "2 cups biscuit mix",
    "1 cup shredded mild Cheddar cheese",
    "0.66666668653488 cup milk",
    "0.25 cup butter",
    "0.25 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine biscuit mix, Cheddar cheese, and milk in a bowl with a wooden spoon until batter is soft and doughy, 30 seconds. Drop spoonfuls of batter onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until biscuits lightly browned and cooked through, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter with garlic powder in a saucepan over low heat, about 5 minutes; brush over cooked biscuits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
