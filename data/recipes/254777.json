  "title": "Zucchini Carrot Cake",
  "description": "This stunning zucchini carrot cake is decorated with a pineapple and walnut cream cheese frosting for three layers of absolute deliciousness!",
  "authors": [
    "Lori O'Neill Harpel"
  ],
  "date_published": "2006-12-07T15:38:28-05:00",
