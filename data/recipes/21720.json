  "ingredients": [
    "1.5 pounds ground pork sausage",
    "1 (14 ounce) can sweetened condensed milk",
    "1 cup yellow cornmeal",
    "0.125 teaspoon coarsely ground black pepper"
  ],
  "steps": [
    {
      "text": "Place sausage in a large, deep skillet. Cook over medium high heat until evenly brown. Drain and rinse in colander under cold water, breaking sausage into pea sized pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to skillet along with the condensed milk, and heat over medium until just bubbling. Immediately stir in the cornmeal and pepper and reduce heat to simmer. Continue cooking, 5 minutes total; mush will be stiff.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pack into 8x4 loaf pan, cover and chill overnight. To serve, cut into 1/4 to 1/2 inch slices and saute until golden in nonstick skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
