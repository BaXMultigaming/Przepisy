      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lV9Jh94CrPSAgOqqd8leWzM78j8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9368-fudge-mfs225-1x1-1-eb60c40a7a9c4a6887a782aa660c32c1.jpg"
