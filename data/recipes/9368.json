  "ingredients": [
    "3 cups semisweet chocolate chips",
    "1 (14 ounce) can sweetened condensed milk",
    "0.25 cup unsalted butter, cut into pieces",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LYIC0Ag14ZI5Z87WmnZFYCCEnqc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9368-fudge-ddmfs-step-01-1-f6e18e143db0439993c78e5c6f839632.jpg"
      ],
      "image": "assets/images/9368/step_01.webp"
    },
    {
      "text": "Combine chocolate chips, condensed milk, and butter in large microwave-safe bowl. Microwave on medium heat until chips are melted, 3 to 5 minutes, stirring once or twice during the cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V15ilLKS8tix82lFBhXfCqLqVeo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9368-fudge-ddmfs-step-02-1-2c775c2851b1468b8be63de743efd8c0.jpg"
      ],
      "image": "assets/images/9368/step_02.webp"
    },
    {
      "text": "Meanwhile, generously grease an 8-inch square glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f-GScWJ6Ezgl54_qTfVX2n35yH8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9368-fudge-ddmfs-step-03-1-1ba5e0e7e8df411e9bf6ad353e34112c.jpg"
      ],
      "image": "assets/images/9368/step_03.webp"
    },
    {
      "text": "Remove chocolate mixture from the microwave and stir in nuts. Pour into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xCGcVtDsaqpxeO8KbhwdFDn-A6k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9368-fudge-ddmfs-step-04-1-8eac651ee01d4779b7a0d382350f0469.jpg"
      ],
      "image": "assets/images/9368/step_04.webp"
    },
    {
      "text": "Refrigerate until fudge is set, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nNhXOJiXZvHFLudTXhuTwaor5vM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9368-fudge-ddmfs-step-05-1-5030bef6592b474d8da63412be48f2f4.jpg"
      ],
      "image": "assets/images/9368/step_05.webp"
    },
    {
      "text": "Cut into 16 squares.",
