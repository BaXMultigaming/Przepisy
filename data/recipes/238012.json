  "ingredients": [
    "1 cup almond meal",
    "0.5 teaspoon ground flax seed",
    "0.5 teaspoon chia seeds",
    "0.25 teaspoon baking soda",
    "2 eggs",
    "1 tablespoon honey",
    "0.5 teaspoon apple cider vinegar",
    "0.5 ripe banana",
    "0.75 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 4 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almond meal, flax seed, chia seeds, and baking soda in a medium bowl. Whisk eggs, honey, and vinegar together in a separate bowl; stir in almond meal mixture until batter is just combined. Mash banana into batter; fold in blueberries. Scoop batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until slightly browned, about 15 minutes. Cool muffins in the tin for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
