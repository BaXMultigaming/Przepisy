  "ingredients": [
    "2 pounds ground beef",
    "1 onion, chopped",
    "2 (4 ounce) cans chopped green chilies",
    "1 (1 ounce) package taco seasoning",
    "2 (10.5 ounce) cans cream of chicken soup",
    "1 (16 ounce) container sour cream",
    "12 flour tortillas",
    "2 cups shredded Cheddar cheese",
    "1.5 cups shredded lettuce",
    "1 small tomato, chopped",
    "0.25 cup black olives, sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir ground beef, onion, 1 can green chiles, and taco seasoning in a large skillet over medium-high heat until beef is crumbly and browned, 6 to 8 minutes. Drain excess fat. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine canned soup, sour cream, and remaining 1 can green chiles in a medium saucepan over medium-low heat until warm, about 10 minutes; transfer ½ to a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon ground beef mixture in a line across middle of each tortilla; roll up tortillas. Place into the baking dish on top sour cream mixture; pour remaining ½ sour cream mixture over enchiladas. Top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until hot and bubbling, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top enchiladas with lettuce, tomatoes, and olives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
