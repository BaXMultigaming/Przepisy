  "ingredients": [
    "1 (1 ounce) square unsweetened chocolate",
    "3 tablespoons butter",
    "0.5 cup white sugar",
    "1 egg, lightly beaten",
    "0.5 teaspoon vanilla extract",
    "0.25 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 2 serving-size oven-proof custard dishes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate and butter in a small microwaveable bowl. Microwave on high 1 minute. Stir until chocolate melts completely. Add sugar. Stir in beaten egg and vanilla extract. Mix thoroughly. Add flour; mix well. Divide brownie batter between 2 prepared custard dishes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until center of brownies has risen and surface appears glossy, 25 to 30 minutes. Let cool slightly before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
