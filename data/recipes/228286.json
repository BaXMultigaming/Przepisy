  "ingredients": [
    "4 bagels, cut into 1/8-inch thick slices",
    "0.25 cup olive oil",
    "2 teaspoons garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bagel slices into a large mixing bowl and drizzle with olive oil while tossing lightly; sprinkle bagel slices with garlic powder and toss again. Arrange bagel chips onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes; turn the chips over and bake until chips are crisp and dry, about 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
