  "ingredients": [
    "24 ounces white American cheese, cubed",
    "12 ounces Monterey Jack cheese, cubed",
    "1 pint half-and-half",
    "1 pint heavy whipping cream",
    "1 (4 ounce) can diced jalapeno peppers, drained",
