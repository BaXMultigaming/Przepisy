  "ingredients": [
    "1.75 cups whole wheat flour",
    "1.5 cups all-purpose flour",
    "0.33333334326744 cup wheat germ",
    "0.25 cup ground flax seed",
    "2 tablespoons poppy seeds",
    "2 tablespoons dried onion flakes",
    "1 tablespoon parsley flakes",
    "1 tablespoon dried basil",
    "1 tablespoon dried oregano",
    "1 teaspoon garlic salt",
    "1 teaspoon baking powder",
    "0.5 teaspoon smoked paprika",
    "0.25 teaspoon cayenne pepper",
    "1.25 cups water",
    "0.5 cup extra-virgin olive oil",
    "3 tablespoons sesame oil",
    "kosher salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together whole wheat and all-purpose flours, wheat germ, flax seed, poppy seeds, onion flakes, parsley flakes, basil, oregano, garlic salt, baking powder, paprika, and cayenne in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water, olive oil, and sesame oil in a separate bowl; add to flour mixture and stir until dough is just moistened and easy to handle. Gather into a ball and divide into 4 equal pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll 2 pieces into thin sheets and place on ungreased cookie sheets. Prick with a fork or dough docker and cut into squares of desired size with a pizza cutter or pastry edger. Sprinkle with kosher salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 12 to 15 minutes; watch carefully so crackers do not burn. Remove from the oven and transfer to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Repeat steps 4 and 5 with remaining dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
