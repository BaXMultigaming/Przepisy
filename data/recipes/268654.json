  "ingredients": [
    "5 ounces plain coconut milk yogurt",
    "3 tablespoons cashew butter",
    "3 tablespoons dairy-free mayonnaise",
    "1 tablespoon stone-ground mustard",
    "2 tablespoons seasoned salt (such as Trader Joe's® Everything But the Bagel)",
    "1 tablespoon dehydrated onion flakes",
    "1 tablespoon dehydrated celery flakes",
    "1 teaspoon snipped chives, or to taste"
  ],
  "steps": [
    {
      "text": "Combine coconut yogurt, cashew butter, mayonnaise, and mustard in a medium bowl. Whisk until there are no lumps. Stir in seasoned salt, onion flakes, and celery flakes. Cover and refrigerate until dehydrated vegetables are softened, 20 to 30 minutes.",
      "section": null,
      "name": null,
