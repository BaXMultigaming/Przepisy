  "ingredients": [
    "1 (8 ounce) package seashell pasta",
    "1 cup mayonnaise",
    "0.5 cup chopped deseeded dill pickles",
    "0.25 cup finely chopped red onion",
    "1 tablespoon lemon juice",
    "1 tablespoon Dijon mustard",
    "0.5 teaspoon hot pepper sauce (such as Tabasco®)",
    "0.5 teaspoon dried dill, or to taste",
    "kosher salt and ground black pepper to taste",
    "6 ounces diced Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to a boil. Add shells and cook, stirring occasionally, until tender yet firm to the bite, about 9 minutes. Drain. Rinse with cold water, drain, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise, pickles, onion, lemon juice, mustard, hot sauce, dill, salt, and black pepper in a large bowl; fold in pasta shells and Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
