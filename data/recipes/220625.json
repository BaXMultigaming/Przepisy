  "ingredients": [
    "2 slices bacon, diced small",
    "0.5 cup minced onion",
    "1 clove garlic, crushed",
    "0.5 cup yellow bell pepper, diced",
    "1 cup diced potato",
    "0.75 cup asparagus, trimmed and cut into 1/4-inch pieces",
    "8 ounces crabmeat",
    "2 cups skim milk",
    "1 cup half-and-half",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Cook and stir the bacon and onion in a saucepan over medium-high heat until the onion is translucent, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the garlic and yellow bell pepper into the bacon mixture; cook and stir together another 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the diced potato, asparagus, crabmeat, skim milk, half-and-half, salt, and black pepper into the bacon mixture; bring to a simmer, reduce heat to medium, and cook until the potatoes are tender, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
