  "ingredients": [
    "1 (16 ounce) package frozen green peas",
    "0.5 cup chopped almonds",
    "0.5 cup chopped green onions",
    "0.5 cup crumbled feta cheese",
    "0.75 cup mayonnaise",
    "2 tablespoons balsamic vinegar",
    "black pepper to taste"
  ],
