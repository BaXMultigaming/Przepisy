      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iWInMDfzGbVXO2ykw7LA4C0dOmM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/89805-balsamic-pea-salad-VAT-010-step-02-b03550a1633244c0898a234975fcf67b.jpg"
      ],
      "image": "assets/images/89805/step_02.webp"
    },
    {
      "text": "Toast almonds in a skillet over medium heat until nuts start to turn golden brown and become fragrant, about 3 to 5 minutes.",
