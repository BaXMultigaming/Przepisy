  "ingredients": [
    "4.5 cups rolled oats",
    "1 cup all-purpose flour",
    "0.66666668653488 cup butter, softened",
    "0.5 cup honey",
    "0.33333334326744 cup packed brown sugar",
    "1 teaspoon baking soda",
    "1 teaspoon vanilla extract",
    "2 cups miniature semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C). Line 9x13 inch pan with parchment paper or foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V-udHxIFBevzAn9tItLRRT6lQMQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11382-chewy-granola-bars-ddmfs-step1-3x4-d1bb08f4b22e4a29a7aafd595f0a0d07.jpg"
      ],
      "image": "assets/images/11382/step_01.webp"
    },
    {
      "text": "Combine oats, flour, butter, honey, brown sugar, baking soda, and vanilla in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uIAUqVD_sVVcyO7MSumUMuRdbI8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11382-chewy-granola-bars-ddmfs-step3-3x4-e5a20ec3ef1e41718a7cb9203f82bb8f.jpg"
      ],
      "image": "assets/images/11382/step_02.webp"
    },
    {
      "text": "Stir in chocolate chips until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_euhedjxsvZIIfpz5dXRqg5cXbw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11382-chewy-granola-bars-ddmfs-step4-3x4-cb27035e46d1411abc6e96ed8c4fb93e.jpg"
      ],
      "image": "assets/images/11382/step_03.webp"
    },
    {
      "text": "Lightly press oat mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KxAdlEmpXF22A1lyAet_qEgZzo8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11382-chewy-granola-bars-ddmfs-step5-3x4-af8203c0f61e4be69951bd80b197218f.jpg"
      ],
      "image": "assets/images/11382/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, 18 to 22 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JFv9gR-ZoFJ5RhdTZXBg96w-YtE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11382-chewy-granola-bars-ddmfs-step6-3x4-8129bd9fd93143239f9508eb73502127.jpg"
      ],
      "image": "assets/images/11382/step_05.webp"
    },
    {
      "text": "Let cool in the pan for 10 minutes, then cut into bars. Cool completely in the pan before removing or serving bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
