  "ingredients": [
    "2 tablespoons olive oil, divided",
    "1 onion, diced",
    "6 cloves garlic, crushed",
    "2 teaspoons ground coriander",
    "2 teaspoons ground turmeric",
    "2 teaspoons garam masala",
    "2 teaspoons red pepper flakes",
    "2 teaspoons curry powder",
    "2 teaspoons ground cumin",
    "1 teaspoon salt",
    "2 (10 ounce) packages frozen chopped spinach, thawed and drained",
    "3 tomatoes, diced",
    "1 cup water",
    "2 tablespoons grated fresh ginger root",
    "2 cups cubed paneer"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BgmpMZ8bXTxKwKCmwykQS4fUOl0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256164-Easy-Palak-Paneer-gw-ddmfs-4x3-step-01-f1fa43b1b7d7488589034dc2b72b7cac.jpg"
      ],
      "image": "assets/images/256164/step_01.webp"
    },
    {
      "text": "Heat 1 tablespoon olive oil in a skillet over medium heat; cook and stir onion in hot oil until slightly tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Xqlv8QTCKXpaAUjtUSrK22OvN_w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256164-Easy-Palak-Paneer-gw-ddmfs-4x3-step-02-6b1154c5b569408385e790d06210db60.jpg"
      ],
      "image": "assets/images/256164/step_02.webp"
    },
    {
      "text": "Add garlic, coriander, turmeric, garam masala, red pepper flakes, curry powder, cumin, and salt; cook and stir until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Lfw1gXlx1UjhwXmb3XT0u77DVZw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256164-Easy-Palak-Paneer-gw-ddmfs-4x3-step-03-107efecb88cd4eb9ad1e2637b7b33b3e.jpg"
      ],
      "image": "assets/images/256164/step_03.webp"
    },
    {
      "text": "Mix spinach, tomatoes, water, and ginger into onion mixture; simmer for 20 minutes. Remove from heat and cool slightly, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/loMDYLrMKj0f09fuhCtSxRt8A8Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256164-Easy-Palak-Paneer-gw-ddmfs-4x3-step-05-3ace769ad5784d37a977aa51ce1e1cc5.jpg"
      ],
      "image": "assets/images/256164/step_04.webp"
    },
    {
      "text": "Transfer spinach mixture to a blender and blend until smooth. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hee0pC0TirlOvgzI9RQ5u3rFEEs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256164-Easy-Palak-Paneer-gw-ddmfs-4x3-step-06-526071e639fd4e7d9769bcc42ca1742e.jpg"
      ],
      "image": "assets/images/256164/step_05.webp"
    },
    {
      "text": "Heat remaining 1 tablespoon olive oil in the same skillet over medium heat; cook and stir paneer in hot oil until lightly browned, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c-d2mPzSPudv9kzmaC9CR7m8Abw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256164-Easy-Palak-Paneer-gw-ddmfs-4x3-step-07-7fbfd462f7f742b4903509934ea6e14c.jpg"
      ],
      "image": "assets/images/256164/step_06.webp"
    },
    {
      "text": "Stir in puréed spinach mixture and cook until heated through, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K80ZwjLIY2mEBcksfhukZa1FtVc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256164-Easy-Palak-Paneer-gw-ddmfs-4x3-step-08-f08736aa04f54a24be6e25a966ba309a.jpg"
