  "title": "Aunt Kate's Strawberry Cake",
  "description": "This strawberry cake gets strawberry flavor in the batter and in the frosting by using mashed fresh strawberries. It is the perfect cake for any special occasion.",
  "authors": [
    "Drea217"
  ],
  "date_published": "2020-06-18T23:48:21-04:00",
