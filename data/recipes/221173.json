  "ingredients": [
    "1 cup white sugar",
    "0.5 cup shortening",
    "2 eggs, room temperature",
    "1 teaspoon vanilla extract",
    "1 cup mashed fresh strawberries",
    "0.5 teaspoon baking soda",
    "2 cups all-purpose flour",
    "0.5 teaspoon salt",
    "2 cups confectioners' sugar",
    "0.25 cup butter, room temperature",
    "0.25 cup mashed fresh strawberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar and shortening together until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, one at a time, into sugar mixture until well mixed; stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir 1 cup strawberries and baking soda in a large bowl until baking soda is dissolved. This will help strawberries foam and rise in the cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour and salt together in a separate bowl. Stir flour mixture and strawberry mixture by hand, into sugar mixture, alternating flour mixture, then strawberry mixture, beginning and ending with flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat confectioners' sugar, butter, and 1/4 cup strawberries in a bowl with an electric mixer until blended; frost the cooled strawberry cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
