  "ingredients": [
    "4 cups water",
    "1 skinless, boneless chicken breast half",
    "0.5 leek, sliced",
    "0.5 small onion, finely chopped",
    "1 carrot, sliced",
    "1 stalk celery, sliced",
    "1.5 cubes chicken bouillon",
    "0.25 teaspoon ground thyme",
    "0.25 teaspoon poultry seasoning",
    "freshly ground black pepper to taste",
