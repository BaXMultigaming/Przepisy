  "ingredients": [
    "9 potatoes",
    "0.5 cup vegetable oil",
    "0.25 cup tarragon vinegar",
    "0.25 cup beef consomme",
    "0.25 cup chopped green onions",
    "2 tablespoons chopped fresh parsley",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender but still firm, 15 to 20 minutes. Drain and cool slightly. Peel potatoes; slice into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, vinegar, consommé, green onion, parsley, salt, and black pepper together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently toss warm potatoes with vinaigrette. Serve at room temperature, or cover and chill before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
