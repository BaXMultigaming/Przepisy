    "publisher-tested"
  ],
  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "garlic salt to taste",
    "18 (6 inch) corn tortillas, torn in half",
    "1 (28 ounce) can green chile enchilada sauce",
    "1 (16 ounce) package shredded Monterey Jack cheese",
    "1 (8 ounce) container reduced fat sour cream"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a medium baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AUSf0a2ImpRDcywu37zUTLGr3vQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/44989-quick-and-easy-green-chile-chicken-enchilada-casserole-VAT-step-01-deae8159e98047ca8684b1554b70458c.jpg"
      ],
      "image": "assets/images/44989/step_01.webp"
    },
    {
      "text": "Season chicken with garlic salt; arrange in the prepared baking dish. Bake in the preheated oven until no longer pink and juices run clear, about 45 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ixx-QXn97XUp8vwZOm5THpiI7WY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/44989-quick-and-easy-green-chile-chicken-enchilada-casserole-VAT-step-02-e5cf726101884c1ca6d7d43f810847fd.jpg"
      ],
      "image": "assets/images/44989/step_02.webp"
    },
    {
      "text": "Cool chicken, shred with two forks, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hTL5m0CSRKcuLPyPBSfSSB0YKRw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/44989-quick-and-easy-green-chile-chicken-enchilada-casserole-VAT-step-03-063b5914161e4922809b40c20d441a7b.jpg"
      ],
      "image": "assets/images/44989/step_03.webp"
    },
    {
      "text": "Meanwhile, char each tortilla half over the open flame of a gas stove burner using metal tongs until lightly puffed, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TInJmpzUMdK-bXh_Ao2bntA9vuk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/44989-quick-and-easy-green-chile-chicken-enchilada-casserole-VAT-step-04-d16b304fbc5d4aa18e5760b2d97ca383.jpg"
      ],
      "image": "assets/images/44989/step_04.webp"
    },
    {
      "text": "Pour about 1/2 inch enchilada sauce into the bottom of a medium baking dish; arrange 6 tortillas in a single layer on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5mcn33lx-_JJAsdGB_14qi-1g0g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/44989-quick-and-easy-green-chile-chicken-enchilada-casserole-VAT-step-05-edbe3dc45a9b4348bb0b929ac1093095.jpg"
      ],
      "image": "assets/images/44989/step_05.webp"
    },
    {
      "text": "Sprinkle with 1/2 of the chicken, 1/3 of the cheese, 1/2 of the sour cream, and 1/3 of the remaining enchilada sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cBdAwvDe1s7kV8J5npS2YXS2fSw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/44989-quick-and-easy-green-chile-chicken-enchilada-casserole-VAT-step-06-15d8cca6bc3c4ab6a071462e124e587e.jpg"
      ],
      "image": "assets/images/44989/step_06.webp"
    },
    {
      "text": "Repeat layers. Coat remaining tortillas thoroughly with some of the remaining enchilada sauce and arrange on top. Sprinkle with remaining cheese and top with any remaining enchilada sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZS6Pr53x7tWJNpOux-du9Ay3l3s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/44989-quick-and-easy-green-chile-chicken-enchilada-casserole-VAT-step-07-6648bbcbd8004457a700be25acb188b0.jpg"
      ],
      "image": "assets/images/44989/step_07.webp"
    },
    {
      "text": "Cover and bake in the preheated oven for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M8cjDncDMsvVgV11Ogvzei3JKuI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/44989-quick-and-easy-green-chile-chicken-enchilada-casserole-VAT-step-08-ee70b38e419d4967ae3eff71f5a0b26c.jpg"
      ],
      "image": "assets/images/44989/step_08.webp"
    },
    {
      "text": "Cool slightly before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9V7ZpQFYrudTE_QIIn2MFTDvuKg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/44989-quick-and-easy-green-chile-chicken-enchilada-casserole-VAT-Beauty-4x3-5065251bfea94f509e829b3a187d569e.jpg"
      ],
      "image": "assets/images/44989/step_09.webp"
    }
  ],
