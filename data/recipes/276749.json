  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup white sugar",
    "2 teaspoons butter, at room temperature",
    "0.5 teaspoon vanilla extract",
    "0.5 cup flaked coconut",
    "8 maraschino cherries, chopped, or more to taste",
    "0.5 cup graham cracker crumbs"
  ],
  "steps": [
    {
      "text": "Beat cream cheese, sugar, butter, and vanilla together in a bowl using an electric mixer; beat in coconut and cherries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place graham cracker crumbs in a shallow bowl. Drop batter by teaspoonfuls into crumbs; form into balls. Roll again; place on wax paper-lined baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate for 2 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
