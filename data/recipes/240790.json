  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1.5 cups white wine",
    "1 cup water, or more as needed",
    "0.66666668653488 cup white wine vinegar",
    "1 yellow onion, chopped",
    "2 cloves garlic, minced",
    "1 cup whole yellow mustard seeds",
    "0.25 cup dry mustard",
    "1 tablespoon garlic powder",
    "1 teaspoon salt",
    "4 1-pint canning jars with lids and rings"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KciFAJKynYZ2Fyxi0AZj4YspOKs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-240790-chef-johns-dijon-mustard-ddmfs-step1-3x4-c9ed3c6dff2e40b5bae642eed505b434.jpg"
      ],
      "image": "assets/images/240790/step_01.webp"
    },
    {
      "text": "Combine white wine, water, vinegar, onion, and garlic in a saucepan; bring to a boil, reduce heat to medium low, and simmer until flavors combine, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k1K5tSu8Cme2u698fwjomt-sEgE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-240790-chef-johns-dijon-mustard-ddmfs-step2-3x4-ab691d1be8b64d3eaeb1f7d174914c2a.jpg"
      ],
      "image": "assets/images/240790/step_02.webp"
    },
    {
      "text": "Cool to room temperature and pour through a strainer into a large bowl; reserve liquid and discard onion and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WLNeD-LdWf685VINtaaMYMS40nw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-240790-chef-johns-dijon-mustard-ddmfs-step3-1-3x4-bcb8f1b4552846f0ac44d0efcc12ade4.jpg"
      ],
      "image": "assets/images/240790/step_03.webp"
    },
    {
      "text": "Stir mustard seeds, dry mustard, garlic powder, and salt into strained liquid; cover the bowl with plastic wrap and let sit at room temperature until mixture thickens, 24 to 48 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GsA8H_d2Upv8WOTr2xby7RgQ9KA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-240790-chef-johns-dijon-mustard-ddmfs-step4-3x4-82b10f23413643dda0f02a24590d9650.jpg"
      ],
      "image": "assets/images/240790/step_04.webp"
    },
    {
      "text": "Purée mustard mixture to desired consistency using a stick blender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UN-Utsq5h7mLdlKXK2cXxrKPRW8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-240790-chef-johns-dijon-mustard-ddmfs-step5-1-3x4-c3af5ced770a43e191063d860aa88dd5.jpg"
      ],
      "image": "assets/images/240790/step_05.webp"
    },
    {
      "text": "Transfer mustard mixture to a saucepan and add enough water to reach a smooth consistency. Bring mustard to a simmer, reduce heat to medium, and cook, stirring constantly, until flavors combine, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tDLyau4geLC7-CDwGZWQHeZM7AU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-240790-chef-johns-dijon-mustard-ddmfs-step6-3x4-f3073bdc1c71458c92f702a99bc7faf8.jpg"
      ],
      "image": "assets/images/240790/step_06.webp"
    },
    {
      "text": "Pack mustard into hot, sterilized jars, filling to within 1/4 inch of the top. Run a knife or thin spatula around the insides of the jars after they have been filled to remove any air bubbles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f583qAnDpoKrONvzBREiTW-xgm0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-240790-chef-johns-dijon-mustard-ddmfs-step7-3x4-a9b88363076d4b9a8c5f4d6ba33f914d.jpg"
      ],
      "image": "assets/images/240790/step_07.webp"
    },
    {
      "text": "Wipe the rims of the jars with a moist paper towel to remove any food residue. Top with the lids and screw on the rings. Refrigerate mustard until flavors blend, at least 1 week.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aG9GHhhzTezuzssO22dARRM1vL0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-240790-chef-johns-dijon-mustard-ddmfs-step8-3x4-2e91be6800e14a66ae3d969ca971ab44.jpg"
      ],
      "image": "assets/images/240790/step_08.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sYYqf-t5unFTByZ8NrkVMB1DxAQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-240790-chef-johns-dijon-mustard-ddmfs-3x4-b6e96e9393d645b0a8f362455641eb7e.jpg"
      ],
      "image": "assets/images/240790/step_09.webp"
    }
  ],
