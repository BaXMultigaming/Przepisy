  "title": "Chef John&#39;s Dijon Mustard",
  "description": "This Dijon mustard recipe with white wine, vinegar, onion, and garlic is Chef John&#39;s DIY homemade version for a delicious condiment or hostess gift.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2015-01-05T20:14:22-05:00",
  "date_modified": "2026-03-09T12:45:14-04:00",
