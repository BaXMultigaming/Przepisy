  "title": "Chef John&#39;s Hot and Sour Soup",
  "description": "This Chinese hot and sour soup is bursting with flavor thanks to fresh ginger, mushrooms, tofu, soy sauce, white pepper, and seasoned rice vinegar.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2021-01-22T17:59:50-05:00",
  "date_modified": "2025-02-19T15:54:55-05:00",
  "prep_time": "PT20M",
