  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "0.75 ounce dried shiitake mushrooms",
    "2 tablespoons soy sauce, or more to taste",
    "0.25 cup seasoned rice vinegar",
    "1 teaspoon ground white pepper, or to taste",
    "0.25 teaspoon sesame oil",
    "3 tablespoons cornstarch, or as needed",
    "3 tablespoons water, or as needed",
    "2 teaspoons vegetable oil",
    "1 teaspoon minced fresh ginger root",
    "0.25 cup sliced green onions",
    "4 cups chicken broth",
    "0.25 cup grated carrot",
    "2 tablespoons thinly sliced red bell pepper",
    "0.5 cup bamboo shoots",
    "1 cup cubed tofu",
    "2 large eggs, beaten"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sgfOaIixqMK9vvUhukKeArraKQs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283133-chef-johns-hot-and-sour-soup-DDMFS-KH-ingredients-bdf3c4d2c4fc4c77877fe7e67e8f8d8e.jpg"
      ],
      "image": "assets/images/283133/step_01.webp"
    },
    {
      "text": "Soak dried shiitake mushrooms in hot water, stirring occasionally, until soft, 15 to 20 minutes. Drain well and slice into thin strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NpMPb54kCetCxl2i7Ecy0yOM7W4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283133-chef-johns-hot-and-sour-soup-DDMFS-KH-step02-ff83d5ba4d274115bf4de44347cdd2ab.jpg"
      ],
      "image": "assets/images/283133/step_02.webp"
    },
    {
      "text": "Whisk soy sauce, vinegar, ground white pepper, and sesame oil together in a small bowl for hot and sour mixture; set aside until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JN-mA5MBs5mb5dAP28UInU39Xdo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283133-chef-johns-hot-and-sour-soup-DDMFS-KH-step3-e62a0d2facb24f43bfa4edf4067aaafe.jpg"
      ],
      "image": "assets/images/283133/step_03.webp"
    },
    {
      "text": "Whisk cornstarch and water together in another small bowl for slurry; set aside until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HbwUdYoPPHK6h0KDluKj8liZtAs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283133-chef-johns-hot-and-sour-soup-DDMFS-KH-step4-2bd6d71a003b41bd824fb40528612fad.jpg"
      ],
      "image": "assets/images/283133/step_04.webp"
    },
    {
      "text": "Heat vegetable oil in a saucepan over medium-high heat. Add ginger, sliced green onions, and shiitake mushrooms. Cook, stirring, for about 2 minutes. Pour in chicken broth and bring up to a simmer. Reduce heat to medium and simmer for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/arlWK3BP88ciTRHKOeaJUZ0xbfQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283133-chef-johns-hot-and-sour-soup-DDMFS-KH-step5-aed361aa33da4721ad2d8c4c310589da.jpg"
      ],
      "image": "assets/images/283133/step_05.webp"
    },
    {
      "text": "Stir in carrot, red pepper, bamboo shoots, tofu, and the hot and sour mixture. Let simmer for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gF65dWoFSioirLOLPjmVlmVHWqI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283133-chef-johns-hot-and-sour-soup-DDMFS-KH-step6-7382aba1f1174c42a4ec26525430bc4e.jpg"
      ],
      "image": "assets/images/283133/step_06.webp"
    },
    {
      "text": "Raise heat to medium-high and bring to a boil. Stir the soup slowly with a spoon while transferring in the beaten eggs in a steady stream to create thin ribbons. Keep stirring until the soup comes back to a boil. Reduce heat to medium.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hCxPQObCL9E0UbIWiBQdKZ5cSYY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283133-chef-johns-hot-and-sour-soup-DDMFS-KH-step7-b9593db1c45940778a08bfd9bfad3262.jpg"
      ],
      "image": "assets/images/283133/step_07.webp"
    },
    {
      "text": "Stir the cornstarch slurry to make sure it's well blended, then slowly drizzle it into the soup while stirring constantly. Soup should thicken up within 1 to 2 minutes. Turn off heat, taste for seasoning, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P2ntwi-flT2oQze-XSUFu31ZPTU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283133-chef-johns-hot-and-sour-soup-DDMFS-KH-step8-692f502ee4734af48390276ad964793e.jpg"
      ],
      "image": "assets/images/283133/step_08.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v_E5BuFN7TzlOvc2aEZc3_Yj2YM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283133-chef-johns-hot-and-sour-soup-DDMFS-KH-4x3-37b0961b53254b33a604a5f00609e3f3.jpg"
      ],
      "image": "assets/images/283133/step_09.webp"
    }
  ],
