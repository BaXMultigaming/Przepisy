  "ingredients": [
    "9 ounces penne pasta",
    "2 tablespoons butter",
    "0.5 cup grated Parmesan cheese",
    "3 tablespoons crumbled Gorgonzola cheese",
    "0.5 cup heavy whipping cream",
    "1 large pear, peeled and cubed",
    "0.5 cup chopped toasted walnuts",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a rolling boil. Cook penne in the boiling water, stirring occasionally, until tender yet firm to the bite, about 11 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return drained pasta to the pot; stir butter, Parmesan cheese, and Gorgonzola cheese into pasta and place over medium heat; cook until the cheese is completely melted. Pour cream into pasta mixture; stir. Remove from heat and fold in pear. Top with walnuts. Season with pepper and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
