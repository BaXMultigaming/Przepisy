    "0.5 cup white sugar",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "0.33333334326744 cup frozen pink lemonade concentrate, thawed",
    "1 egg",
    "1.75 cups all-purpose flour",
    "2 cups confectioners' sugar",
