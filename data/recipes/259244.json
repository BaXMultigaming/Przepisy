  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat ½ cup butter in a large bowl with an electric mixer until smooth. Add white sugar, baking powder, and baking soda; beat until blended. Beat in ⅓ cup lemonade concentrate and egg until well combined. Beat in flour until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded spoonfuls 2 inches apart onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 10 to 12 minutes. Transfer to a wire rack to cool, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat confectioners' sugar, 2 tablespoons lemonade concentrate, and 2 tablespoons butter in a medium bowl with an electric mixer until smooth. Stir in food coloring until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread icing over cooled cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
