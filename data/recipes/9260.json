  "ingredients": [
    "2 lemons",
    "3 large oranges",
    "1 (6 ounce) can frozen lemonade concentrate",
    "1 liter club soda",
    "2 (750 milliliter) bottles sparkling apple cider",
    "1 tablespoon white sugar",
    "2 trays ice cubes"
  ],
  "steps": [
    {
      "text": "Thinly slice the lemons and the oranges and place in a large punch bowl. Pour in the thawed lemonade. Gently stir in the club soda and the sparkling apple cider. Add sugar to taste. Add ice.",
