  "ingredients": [
    "0.75 cup milk",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.75 cups all-purpose flour",
    "0.33333334326744 cup white sugar",
    "0.33333334326744 cup chopped fresh lemon verbena",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.25 cup cold butter",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, egg, and vanilla extract together until smooth; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour, sugar, lemon verbena, baking powder, and salt in the bowl of a food processor; pulse until lemon verbena is finely chopped. Add butter; pulse until pea-sized.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer flour mixture to a bowl; fold in blueberries. Stir in milk mixture until just moistened. Spoon batter into the prepared muffin cups, filling each ¾ full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and tops spring back when lightly pressed, about 20 minutes. Cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
