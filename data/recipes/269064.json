    "publisher-tested"
  ],
  "ingredients": [
    "1 cup all-purpose flour",
    "0.25 teaspoon kosher salt",
    "0.33333334326744 cup cold water",
    "1 stick high-quality unsalted butter, fully softened, divided",
    "0.75 cup white sugar",
    "0.25 cup water",
    "1 tablespoon water",
    "1 cinnamon stick",
    "1 lemon, zested in large strips",
    "0.33333334326744 cup all-purpose flour",
    "0.25 teaspoon kosher salt",
    "1.5 cups milk",
    "6 large egg yolks",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine flour, salt, and cold water in a bowl. Mix with a wooden spoon until dough just comes together and pulls away from the sides of the bowl. Dough should be sticky; adjust with more flour or water to achieve what's shown in the video.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cgWzUvM_Mgl28eHUV_RLcnNczq4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269064_Portuguese-Custardtarts-mfs-Step-01-af90a7bc46fa40e4b083b55d05647f9a.jpg"
      ],
      "image": "assets/images/269064/step_01.webp"
    },
    {
      "text": "Transfer dough onto a well-floured surface. Dust a little more flour over the top. Knead for 1 to 2 minutes to form a round. Cover and let rest for 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rs6WsZSvpS1sIqZ1TCsVzmpApm8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269064_Portuguese-Custardtarts-mfs-Step-02-1f4b12b312b645a9a59c9f699d60f6ea.jpg"
      ],
      "image": "assets/images/269064/step_02.webp"
    },
    {
      "text": "Roll dough into a square about 1/8-inch-thick, dusting with flour as necessary; dough should still be sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NPs22orOkDCKdJIir5oxGM9hWR8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269064_Portuguese-Custardtarts-mfs-Step-03-35ae25ad05bf4a08b78f206fc388a112.jpg"
      ],
      "image": "assets/images/269064/step_03.webp"
    },
    {
      "text": "Spread 1/3 of the butter over 2/3 of the square using a silicone spatula, leaving a 1/2-inch border. Flip the unbuttered side over the middle of the square and fold the opposite end over it like a letter. Straighten the edges as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0vgVFZwxDeeeicpKCZQmSiDKGNQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269064_Portuguese-Custardtarts-mfs-Step-05-ca766d72b4374128b213082dfedc12dd.jpg"
      ],
      "image": "assets/images/269064/step_04.webp"
    },
    {
      "text": "Turn dough with a bench scraper to unstick it from the counter; dust with flour. Flip and sprinkle more flour on top. Roll dough into a 1/8-inch-thick rectangle, carefully stretching edges as needed. Spread another 1/3 of the butter over 2/3 of the dough. Fold into thirds. Transfer onto a lined baking sheet and freeze until butter is slightly chilled, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2O5Ut89a3cvL2s_W6Zy8xP5gBvQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269064_Portuguese-Custardtarts-mfs-Step-06-ed4a30659eb0465a86d61d52b6365f4e.jpg"
      ],
      "image": "assets/images/269064/step_05.webp"
    },
    {
      "text": "Sprinkle dough with flour and roll into a square a little over 1/8-inch-thick. Spread remaining butter over the dough, leaving a 1- to 1 1/2-inch border on the top edge. Dip your finger in water and lightly moisten the unbuttered edge. Roll dough into a log starting from the bottom edge. Dust with more flour and polish the ends as needed. Seal with plastic wrap and refrigerate at least 2 hours, preferably overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WtCrWMuKWxEhvSbNR7sSGAJp1Us=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269064_Portuguese-Custardtarts-mfs-Step-07-3f7be6fb2cce47a4a1b8f99c97eb28a1.jpg"
      ],
      "image": "assets/images/269064/step_06.webp"
    },
    {
      "text": "Combine sugar, 1/4 cup plus 1 tablespoon water, cinnamon, and lemon zest in a pot. Boil over medium heat, without stirring, until syrup reaches 210 to 215 degrees F (100 degrees C). Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Zo9JSDf4JIXdGcQgURYLNB4wmng=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269064_Portuguese-Custardtarts-mfs-Step-08-b6cef8367c6843b4ae63d5a4b18c9100.jpg"
      ],
      "image": "assets/images/269064/step_07.webp"
    },
    {
      "text": "Preheat the oven to 550 degrees F (288 degrees C). Grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, salt, and cold milk together very thoroughly in a cold pot. Cook over medium heat, whisking constantly, until milk thickens, about 5 minutes. Remove from heat and let cool for at least 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UjVdzbiZnDg56PtYHgueS1ow2J4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269064_Portuguese-Custardtarts-mfs-Step-09-358ded6d6ba342d2b45059bc30cb791e.jpg"
      ],
      "image": "assets/images/269064/step_09.webp"
    },
    {
      "text": "Whisk egg yolks into the cooled milk. Add sugar syrup and vanilla extract. Mix until combined. Strain custard into a glass measuring cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6CKjhRyXc36MaMDU46BVnLF5b_E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269064_Portuguese-Custardtarts-mfs-Step-10-5b7f892bca104f9491722b8b39768c0b.jpg"
      ],
      "image": "assets/images/269064/step_10.webp"
    },
    {
      "text": "Unwrap the dough and trim any uneven bits on the ends. Score log into 12 even pieces using a knife; cut through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Isl85Z4x9N6RBzQqQWUYvkRKk70=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269064_Portuguese-Custardtarts-mfs-Step-11-7818040b1bbb425e90de5c86f892ab09.jpg"
      ],
      "image": "assets/images/269064/step_11.webp"
    },
    {
      "text": "Place a piece of dough in each muffin cup. Dip your thumb lightly in some cold water. Press your thumb into the center of the swirl; push dough against the bottom and up the sides of the cup until it reaches least 1/8 inch past the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P3IOckRFHBHvGC_Y0TqJ5fiYv9k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269064_Portuguese-Custardtarts-mfs-Step-13-666e65251ccb43deb6996ad51aaea77e.jpg"
      ],
      "image": "assets/images/269064/step_12.webp"
    },
    {
      "text": "Fill each cup 3/4 of the way with custard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kabY8kPBH4mCseye3dxytGl4FQE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269064_Portuguese-Custardtarts-mfs-Step-14-b25ff9b0f7fa40a0b9f7638d395226b2.jpg"
      ],
      "image": "assets/images/269064/step_13.webp"
    },
    {
      "text": "Bake in the preheated oven until the pastry is browned and bubbly, and the tops start to blister and caramelize, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/945OXpfSKcALXq2LAADpI6sF4nc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269064_Portuguese-Custardtarts-mfs-Step-15-21401576d36e49378f84b730452249d1.jpg"
      ],
      "image": "assets/images/269064/step_14.webp"
    },
    {
      "text": "Cool tarts briefly and serve warm. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c6pXHgY2ZrUfr7qqRcvlAdtEs38=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269064-portuguese-custard-tarts-pasteis-de-nata-DDMFS-4x3-a5a570c3f2be49629572c535b0166e33.jpg"
      ],
      "image": "assets/images/269064/step_15.webp"
    }
  ],
