  "title": "Portuguese Custard Tarts (Pasteis de Nata)",
  "description": "These pasteis de nata, with their signature flaky crust and sweet custard filling, are so utterly delicious — you might want to make a double batch!",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2018-11-07T00:41:44-05:00",
  "date_modified": "2026-01-22T05:20:15-05:00",
  "prep_time": "PT60M",
  "cook_time": "PT25M",
  "total_time": "PT240M",
  "yield": [
    "12",
    "12 tarts"
  ],
  "categories": [
    "Dessert"
  ],
  "cuisines": [
    "Spanish"
  ],
  "regions": [
    "Spanish"
  ],
  "breadcrumbs": [],
