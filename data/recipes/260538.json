  "ingredients": [
    "5 eggs",
    "0.5 cup white sugar",
    "1 pinch salt",
    "4 cups milk",
    "2.5 cups flour",
    "6 tablespoons vegetable oil",
    "1 teaspoon vegetable oil, or as needed, divided"
  ],
  "steps": [
    {
      "text": "Mix eggs, sugar, and salt together in a bowl. Add milk, flour, and oil. Mix until batter is smooth and thin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 2 small nonstick skillets over medium heat. Lightly oil the skillets. Pour in enough batter to just cover the bottom of each skillet. Tilt the pans to spread batter evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lift the blini carefully when edges start to brown, about 2 minutes. Flip and cook until the other side is browned, about 1 minute more. Stack blini on a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
