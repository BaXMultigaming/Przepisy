  "ingredients": [
    "1 cup all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "2 eggs, beaten",
    "0.5 cup milk",
    "1 pound cheese curds",
    "1 quart oil for frying"
  ],
  "steps": [
    {
      "text": "Sift flour, baking powder, and salt together in a large bowl. Stir in eggs and milk; mix until smooth. Add more milk for a thinner batter. Coat cheese curds in batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large, heavy skillet over medium heat. Fry cheese curds until golden, about 1 minute. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
