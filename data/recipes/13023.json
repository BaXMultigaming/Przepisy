  "ingredients": [
    "1 (3 pound) beef chuck roast",
    "0.5 cup barley",
    "1 bay leaf",
    "2 tablespoons oil",
    "3 carrots, chopped",
    "3 stalks celery, chopped",
    "1 onion, chopped",
    "1 (16 ounce) package frozen mixed vegetables",
    "4 cups water",
    "1 (28 ounce) can chopped stewed tomatoes",
    "4 cubes beef bouillon cube",
    "1 tablespoon white sugar",
    "0.25 teaspoon ground black pepper, or more to taste",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Place chuck roast in a slow cooker. Cook on High until tender, 4 to 5 hours. Add barley and bay leaf during the last hour of cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hqr0dh4xiitrThZ8DM8598m2YG4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13023-beef-barley-vegetable-soup-ddmfs-step1-5167-4x3-55f104cf21f241ce9ca3b6a92bda20ef.jpg"
      ],
      "image": "assets/images/13023/step_01.webp"
    },
    {
      "text": "Remove meat; chop into bite-size pieces. Discard bay leaf. Set beef, broth, and barley aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h1Sxves9_wRflNcoiI0du8jlsvE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13023-beef-barley-vegetable-soup-ddmfs-step2-5171-4x3-eb546910061e4ac4912499c667756ace.jpg"
      ],
      "image": "assets/images/13023/step_02.webp"
    },
    {
      "text": "Heat oil in a large stock pot over medium-high heat. Sauté carrots, celery, onion, and frozen mixed vegetables until tender, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/42h8ocSpYdA9L4YD9OTko_36JAo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13023-beef-barley-vegetable-soup-ddmfs-step3-5177-4x3-6a0403610de3491f8764ed5a4e668974.jpg"
      ],
      "image": "assets/images/13023/step_03.webp"
    },
    {
      "text": "Add water, stewed tomatoes, beef bouillon cubes, sugar, 1/4 teaspoon pepper, and beef-barley-broth mixture. Bring to boil, reduce heat, and simmer 10 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TnEZ45UAL9G0IemPrp_2vIlu1KM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13023-beef-barley-vegetable-soup-ddmfs-step4-5180-4x3-6974088badf54d1a935599c3791cb0c8.jpg"
      ],
      "image": "assets/images/13023/step_04.webp"
    },
    {
      "text": "Season with salt and pepper before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q62i2-plnW3Wqdvq3BfCJ9k-2vI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13023-beef-barley-vegetable-soup-ddmfs-3X4-5181-345e847a4699417fb369ac25ec586eb0.jpg"
