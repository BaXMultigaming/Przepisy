  "ingredients": [
    "1 pound fresh asparagus, trimmed",
    "sea salt and ground black pepper to taste",
    "brown paper bag",
    "0.5 lemon, juiced",
    "0.5 lemon, sliced into rounds",
    "3 tablespoons extra-virgin olive oil, or as needed",
    "1 bay leaf"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place asparagus inside the paper bag. Season with salt and pepper and drizzle with lemon juice. Place lemon slices and bay leaf in the bag. Drizzle olive oil all over asparagus and rub some olive oil on the outside of the bag. Close bag tightly and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast on the center rack of the preheated oven until asparagus is tender, about 15 minutes. Open the bag carefully, remove and discard bay leaf, and empty onto a serving platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
