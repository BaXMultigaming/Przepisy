  "ingredients": [
    "1 egg white",
    "0.5 cup white sugar",
    "0.25 teaspoon salt",
    "0.5 teaspoon vanilla extract",
    "0.5 cup shredded coconut",
    "1 cup cornflakes cereal"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white in a bowl with an electric hand-mixer until stiff peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually beat sugar, 1 tablespoon at a time, into egg whites until fully incorporated. Stir salt and vanilla extract into egg whites until thoroughly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold coconut and corn flakes into the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop coconut mixture by the teaspoon onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cookies in the preheated oven until lightly crisp, 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cookies to wire rack to cool, at least 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
