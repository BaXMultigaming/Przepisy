  "ingredients": [
    "2 cups whole wheat flour",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "0.75 cup vegetable oil",
    "3 eggs",
    "0.5 cup brown sugar",
    "0.5 cup white sugar",
    "0.25 cup canola oil",
    "1 teaspoon vanilla extract",
    "3 apples, peeled and diced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
