  "ingredients": [
    "cooking spray",
    "1 cup stone ground cornmeal",
    "1 cup gluten-free all-purpose flour (such as Tom Sawyer®)",
    "0.33333334326744 cup white sugar, or more to taste",
    "1 tablespoon gluten-free baking powder",
    "1 teaspoon salt",
    "1 teaspoon xanthan gum",
    "0.25 cup unsalted butter, softened",
    "1 cup 1% milk",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray a 8-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cornmeal, flour, sugar, baking powder, salt, and xanthan gum together in a bowl. Cut in butter with 2 knives until reduced to pea-sized pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and egg together in a bowl; stir into the cornmeal mixture until just combined. Pour batter into prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is light brown, about 22 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
