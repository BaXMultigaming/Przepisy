  "ingredients": [
    "2 teaspoons olive oil",
    "0.25 cup onion, diced",
    "1 clove garlic, diced, or more to taste",
    "1 teaspoon Italian seasoning, or to taste",
    "0.25 teaspoon crushed red pepper flakes, or to taste",
    "1 splash red wine",
    "1 (8 ounce) can tomato sauce"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a small pot over medium-high heat. Saute onion, garlic, Italian seasoning, and red pepper flakes in the hot oil until onions start to soften, about 5 minutes. Add a splash of red wine; stir for a few seconds. Add tomato sauce and stir.",
