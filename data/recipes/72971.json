  "ingredients": [
    "2 tablespoons garlic powder",
    "1 teaspoon salt",
    "1 teaspoon pepper",
    "4 pork chops",
    "4 tablespoons minced garlic",
    "0.25 cup Worcestershire sauce",
    "0.5 cup water, divided",
    "2 cups fresh mushrooms, sliced",
    "1 medium onion, sliced"
  ],
  "steps": [
    {
      "text": "Mix garlic powder, salt, and pepper together in a bowl. Rub pork chops on both sides with spice mixture and minced garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Worcestershire sauce and 1/4 cup water in a skillet over medium heat. Add pork chops and cook for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flip pork chops. Add mushrooms, onion, and remaining 1/4 cup water. Cook until chops are no longer pink in the center, about 10 minutes. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C).",
