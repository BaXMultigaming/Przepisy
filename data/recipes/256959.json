  "ingredients": [
    "24 frozen bite-size potato nuggets (such as Tater Tots®)",
    "cooking spray",
    "1 cup chopped mushrooms",
    "1 cup chopped onion",
    "0.5 cup chopped red bell pepper",
    "0.5 cup chopped fresh spinach",
    "3 green onions, chopped",
    "0.25 cup chopped sun-dried tomatoes, or to taste",
    "10 slices cooked bacon, chopped",
    "12 eggs",
    "1 teaspoon heavy whipping cream",
    "0.5 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon ground black pepper",
    "0.5 cup shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Spread potato nuggets onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until nuggets are half-cooked, 10 to 12 minutes. Allow to cool until easily handled. Cut each nugget in half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce oven temperature to 350 degrees F (175 degrees C). Spray 12 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium heat; cook and stir mushrooms, onion, red bell pepper, spinach, green onions, and sun-dried tomatoes for 5 minutes. Drain excess liquid and stir in chopped bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, cream, salt, garlic powder, onion powder, and pepper together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon bacon mixture into the prepared muffin cups and top each with Monterey Jack cheese. Pour egg mixture over cheese layer until each cup is nearly full. Place 4 potato nugget halves into each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set in the middle, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
