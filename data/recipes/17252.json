  "ingredients": [
    "1 cup margarine, softened",
    "2 cups white sugar",
    "4 eggs",
    "6 bananas, mashed",
    "2 teaspoons vanilla extract",
    "3 cups all-purpose flour",
    "2 teaspoons baking soda",
    "0.25 cup unsweetened cocoa powder",
    "1 cup lite sour cream",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease two 9x5 inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together margarine, sugar and eggs. Stir in bananas and vanilla. Sift in flour, baking soda and cocoa; mix well. Blend in sour cream and chocolate chips. Pour batter into prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 60 minutes, or until a toothpick inserted into center of a loaf comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
