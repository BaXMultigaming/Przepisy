  "title": "Roasted Tomato Soup",
  "description": "This roasted tomato soup is packed with flavor thanks to a blend of roasted ripe tomatoes, caramelized onions, and garlic for a naturally sweet and smoky soup.",
  "authors": [
    "Cindy Anschutz Barbieri"
  ],
  "date_published": "2019-04-02T03:02:40-04:00",
