  "ingredients": [
    "1 (19.8 ounce) package brownie mix",
    "0.25 cup vegetable oil",
    "0.25 cup all-purpose flour",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1/2 teaspoon kosher salt",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C) with racks positioned in middle and lower third. Line two baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jULJw98nJgrry0JsDdtGkeBQttQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222721-easy-brownie-mix-cookies-VAT-step-01-bb0548d3b6f54aa29494729bc59726fb.jpg"
      ],
      "image": "assets/images/222721/step_01.webp"
    },
    {
      "text": "Stir brownie mix, oil, 3 tablespoons of the flour, eggs, vanilla, and salt in a large bowl until just combined, adding up to 1 tablespoon more flour if dough is too loose; fold in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t2G0GF0Y8f2x2hJIyz8kIlnrS1Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222721-easy-brownie-mix-cookies-VAT-step-02-41e73d5fe3364cdaa076a506ff857b9a.jpg"
      ],
      "image": "assets/images/222721/step_02.webp"
    },
    {
      "text": "Drop dough by rounded tablespoons 2 inches apart onto prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qagc-XSZW8YEO75J5r7XKKzDVJ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222721-easy-brownie-mix-cookies-VAT-step-03-f9602699ffe846a39b78dfb6a3c9b3ac.jpg"
      ],
      "image": "assets/images/222721/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until cookies are just set, about 10 minutes, rotating pans to opposite racks halfway through. Let cool on baking sheets briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S58oTSnVSeZ_WDSlOCmkxHZjnLM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222721-easy-brownie-mix-cookies-VAT-step-05-b8b7b4ee27574120b7c592e70f1680aa.jpg"
      ],
      "image": "assets/images/222721/step_04.webp"
    }
  ],
