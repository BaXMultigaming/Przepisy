  "ingredients": [
    "3 cups fusilli pasta",
    "0.75 cup broccoli florets",
    "0.75 cup cauliflower florets",
    "0.5 cup red onion, sliced",
    "0.5 cup thinly sliced carrots",
    "0.5 cup red bell pepper, chopped",
    "0.5 cup chopped green bell pepper",
    "0.5 cup chopped mushrooms",
    "0.5 cup chopped celery",
    "0.75 cup light mayonnaise",
    "0.25 cup distilled white vinegar",
    "0.25 cup white sugar",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook pasta in boiling water, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes; drain. Rinse pasta under cold water; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooked pasta, broccoli, cauliflower, onion, carrots, bell peppers, mushrooms, and celery in a large bowl; toss.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, vinegar, and sugar together in a medium bowl until smooth; pour over pasta-vegetable mixture and mix well. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
