  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.25 cup butter",
    "2 tablespoons lemon juice",
    "2 teaspoons lemon zest",
    "1 teaspoon vanilla extract",
    "5 cups confectioners' sugar"
  ],
