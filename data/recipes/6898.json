  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5x3-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter, sugar, and 1 egg in a large bowl. Beat well. Beat in second egg. Stir in milk and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl measure in flour, baking powder, and salt. Stir in raisins. Pour all at once into batter. Stir to moisten only. Spoon into greased loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour or until it tests done. Cool 10 minutes. Turn out of the pan. Cool on a rack. Wrap to store. Allow it to ripen a day or two to improve flavor. Serve buttered.",
      "section": null,
      "name": null,
      "url": null,
