  "ingredients": [
    "1 (8 ounce) package egg noodles",
    "1.3333333730698 tablespoons olive oil",
    "1 onion, chopped",
    "1 cup chopped, cooked chicken meat",
    "1 red bell pepper, chopped",
    "2 stalks celery, chopped",
    "1 cup chicken stock",
    "1.5 cups sour cream",
    "0.5 teaspoon dried oregano",
    "1 pound fresh asparagus, trimmed and cut into 2 inch pieces",
    "8 tablespoons grated Parmesan cheese, divided"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 1 1/2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K7hftUfpZmMCisCtuXvLw52KTtI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8656-Fresh-Asparagus-Chicken-Casserole-ddmfs-step-1-070-e988cb39bda547a7ac5d22214464f634.jpg"
      ],
      "image": "assets/images/8656/step_01.webp"
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until almost tender, about 5 minutes. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a heavy skillet over medium heat; stir in onion and cook for 4 to 5 minutes, stirring frequently. Add cooked chicken, red bell pepper, celery, and chicken stock. Bring to a boil and simmer for 5 minutes. Stir in sour cream and oregano.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KKqBW_-jI-gcOD1V4xiFE7KGnUo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8656-Fresh-Asparagus-Chicken-Casserole-ddmfs-step-3-076-257759c18ca04cb382687314044b31d2.jpg"
      ],
      "image": "assets/images/8656/step_03.webp"
    },
    {
      "text": "Spread 1/2 of the chicken mixture into the prepared dish; arrange asparagus on top. Spread cooked noodles evenly over asparagus and top with 5 tablespoons of Parmesan cheese. Cover with remaining chicken mixture and sprinkle remaining 3 tablespoons Parmesan cheese on top. Bake in the preheated oven until cheese has melted and top is golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S76MADmj5ZaAcOKSfkvDWi0JMFU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8656-Fresh-Asparagus-Chicken-Casserole-ddmfs-step-8-093-730f02e632694dd5b5f7c5b1aedb911e.jpg"
      ],
