  "ingredients": [
    "1 teaspoon vegetable oil",
    "0.5 cup chopped onions",
    "2 cloves minced garlic",
    "0.75 cup chili sauce",
    "0.5 cup beer",
    "0.25 cup honey",
    "2 tablespoons Worcestershire sauce",
    "0.5 teaspoon dry mustard",
    "3.5 pounds country style pork ribs"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-3oc2eUv3YEbAmI9EJEguWMMGyw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234522-Oven-Roasted-Ribs-step-0-009-f3b659a3f2e94bfe814ac1eb950f2f8e.jpg"
      ],
      "image": "assets/images/234522/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a saucepan over medium-high heat. Cook and stir onions and garlic in hot oil until fragrant and softened, 4 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zPjlHtOrpE95jyMDS2xlb7wA0G0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234522-Oven-Roasted-Ribs-step-2-014-fa6c4ba808a84b2fa84bf2e30d765e3c.jpg"
      ],
      "image": "assets/images/234522/step_03.webp"
    },
    {
      "text": "Stir in chili sauce, beer, honey, Worcestershire sauce, and dry mustard. Bring to a boil, reduce heat to low, and simmer until sauce thickens and flavors develop, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OEyR0HnAEBsGCk9H9CJeEEvLbP8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234522-Oven-Roasted-Ribs-step-3-052-eb5c3637caa946599b98cafecd149948.jpg"
      ],
      "image": "assets/images/234522/step_04.webp"
    },
    {
      "text": "Meanwhile, arrange ribs evenly in a large baking dish. Bake ribs in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FrHejEXWyAbVQzjvxofhI4qbQIQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234522-Oven-Roasted-Ribs-step-5-053-9d74818363f8482ba442c5c3dc5c0e19.jpg"
      ],
      "image": "assets/images/234522/step_05.webp"
    },
    {
      "text": "Spread sauce over ribs and continue baking until sauce bubbles and ribs are tender, about 1 hour more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1L9ID0fXjZkAc6jjDXmkR5xUSMw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234522-Oven-Roasted-Ribs-step-6-054-34104fa56c0c4995927db67e07c72ffd.jpg"
      ],
      "image": "assets/images/234522/step_06.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C8CvJyqRG_dH6m12AhvtWfbxjgo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234522-Oven-Roasted-Ribs-step-7-119-2da576bc57564a55af3d3d120e43a40e.jpg"
      ],
      "image": "assets/images/234522/step_07.webp"
    }
