  "ingredients": [
    "1 (8 ounce) package thin rice noodles",
    "0.5 pound skinless, boneless chicken legs, cut into bite-size pieces",
    "0.5 pound pork tenderloin, cut into bite-size pieces",
    "0.5 cup soy sauce",
    "ground black pepper to taste",
    "0.5 medium head cabbage, shredded",
    "2 carrots, shredded",
    "0.5 pound shrimp, peeled and deveined",
    "2 green onions, chopped into 1 inch pieces"
  ],
  "steps": [
    {
      "text": "Place rice noodles in a large bowl; cover with warm water. Set aside until noodles are softened; cut into 4-inch lengths. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brown chicken and pork in a skillet over medium heat until no pink shows; season with soy sauce and black pepper. Transfer to a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook cabbage and carrots in the same skillet until tender. Stir in noodles, shrimp, and green onions; cook for 4 to 5 minutes. Stir in chicken and pork; cook 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
