  "ingredients": [
    "1 large egg",
    "salt to taste",
    "1 cup panko bread crumbs",
    "0.75 pound chicken breast cutlets",
    "avocado oil cooking spray",
    "1 tablespoon barbecue sauce",
    "1 tablespoon chopped green onions"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to the manufacturer's recommendations.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg and salt lightly in a shallow bowl or a small casserole dish. Place panko bread crumbs on a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each cutlet into egg mixture, allowing excess to drip back into the bowl. Turn cutlets in panko bread crumbs so both sides are coated well, pressing the cutlets gently into the crumbs. Set on a piece of parchment paper. Spray each side with cooking spray and place in the basket of the air fryer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry for 5 minutes, turn, and air-fry for an additional 4 minutes. Serve with barbecue sauce and garnish with green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
