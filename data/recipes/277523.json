  "ingredients": [
    "2 tablespoons olive oil",
    "1 medium yellow onion, thinly sliced",
    "salt and ground black pepper to taste",
    "3 large carrots, peeled and chopped",
    "4 cloves garlic, smashed",
    "4 cups vegetable broth",
    "0.25 cup Italian parsley, chopped",
    "2 tablespoons grated fresh ginger",
    "3 sprigs fresh thyme",
    "2 sprigs fresh sage, leaves finely chopped",
    "0.5 cup coconut cream",
    "0.25 cup coconut milk",
    "0.5 cup pesto",
    "2 tablespoons maple syrup",
    "1 cup sour cream"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large pot over medium heat. Add onion, salt, and pepper. Saute, stirring occasionally, until onion is soft, 8 to 10 minutes. Add carrots and smashed garlic; saute for 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in broth, parsley, ginger, thyme, and sage. Reduce to a simmer and cook until carrots are soft, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the sprigs of thyme with a fork or spatula. Transfer soup to a blender and blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return soup to the pot. Add coconut cream, coconut milk, pesto, and maple syrup; let simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle into serving bowls and add a dollop of sour cream to each bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
