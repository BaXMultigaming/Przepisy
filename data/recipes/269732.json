  "ingredients": [
    "1.5 pounds lean ground beef",
    "1 small onion, chopped",
    "1 cup crushed tortilla chips",
    "0.75 cup shredded pepper Jack cheese",
    "1 (1 ounce) packet taco seasoning mix",
    "2 large eggs, beaten",
    "0.5 cup milk",
    "0.25 cup mild red taco sauce, or more to taste"
  ],
