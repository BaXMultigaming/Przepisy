  "ingredients": [
    "2 cups white sugar",
    "0.5 cup butter",
    "0.5 cup milk",
    "0.33333298563957 cup unsweetened cocoa powder",
    "0.66666698455811 cup peanut butter",
    "3 cups quick cooking oats",
    "0.5 cup chopped peanuts",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Place a piece of wax paper or foil on cookie sheet. Combine sugar, butter, milk and cocoa in medium saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook over medium heat, stirring constantly, until mixture comes to rolling boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat; cool 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add peanut butter; stir to blend. Add oats, peanuts and vanilla; stir to mix well. Quickly drop mixture by heaping teaspoons onto wax paper or foil. Cool completely. Store in cool, dry place.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
