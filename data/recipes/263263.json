  "ingredients": [
    "2 cups whole wheat flour",
    "1 tablespoon chopped fresh parsley",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1 teaspoon ground thyme",
    "1 pinch ground cumin",
    "1 medium onion, finely chopped",
    "1 jalapeno pepper, finely chopped",
    "2 (14.75 ounce) cans salmon, drained and flaked",
    "2 large eggs, or as needed",
    "1 cup water",
    "0.25 cup vegetable oil for frying, or as needed"
  ],
  "steps": [
    {
      "text": "Mix together flour, parsley, baking powder, salt, thyme, and cumin in a large bowl. Add chopped onion and jalapeño pepper; mix until incorporated. Add salmon and eggs; mash salmon and mix until combined. Add water and stir until a thick batter forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1/4 inch oil in a frying pan just below the medium heat setting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches of 3, drop 1 tablespoonful scoops of batter per fritter into hot oil; fry until golden brown, 3 to 5 minutes per side. Drain on a paper towel-lined plate. Repeat with remaining batter for about 16 fritters in total.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
