  "ingredients": [
    "0.75 cup white sugar",
    "3 (.25 ounce) envelopes unflavored gelatin powder",
    "3 cups hot brewed coffee",
    "1.3333333730698 cups water",
    "1 tablespoon lemon juice",
    "1 cup sweetened whipped cream for garnish"
  ],
  "steps": [
    {
      "text": "In a saucepan, stir together the sugar and gelatin. Mix in hot coffee and water. Cook over low heat, stirring frequently until the gelatin and sugar have completely dissolved. Remove from heat, and stir in lemon juice. Pour into a 4 1/2 cup mold. Refrigerate until set, at least 6 hours or overnight. Serve with whipped cream.",
