  "ingredients": [
    "0.75 cup white sugar",
    "0.25 cup applesauce",
    "1 large egg, at room temperature",
    "1 tablespoon vegetable oil",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "2.5 cups apples - peeled, cored, and chopped",
    "0.5 cup chopped nuts",
    "0.25 cup brown sugar",
    "2 tablespoons butter",
    "2 tablespoons heavy cream",
    "0.5 teaspoon corn syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, applesauce, egg, oil, and vanilla with an electric mixer in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, cinnamon, and salt together in a second bowl. Add to sugar mixture and stir to combine. Fold in apples and nuts. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, 45 to 55 minutes. Cool on a wire rack for 10 minutes. Remove from pan and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, butter, heavy whipping cream, and corn syrup in a small saucepan. Bring to a boil and cook, stirring constantly, for 1 minute. Let caramel cool, then drizzle over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
