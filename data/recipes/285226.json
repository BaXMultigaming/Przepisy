  "title": "Caramel Apple Loaf Cake",
  "description": "A super moist apple cake made in a loaf pan drizzled with homemade caramel sauce. Serve with a scoop of ice cream, whipped cream, or by itself.",
  "authors": [
    "Yoly"
  ],
  "date_published": "2021-08-06T01:54:09-04:00",
