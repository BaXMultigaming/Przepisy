  "ingredients": [
    "2 tablespoons extra-virgin olive oil",
    "0.5 head green cabbage, cut into 4 wedges",
    "1 pinch garlic powder, or to taste",
    "1 pinch red pepper flakes, or to taste",
    "salt and ground black pepper to taste",
    "2 lemons, halved"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
