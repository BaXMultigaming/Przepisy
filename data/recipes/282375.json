  "ingredients": [
    "2 medium ripe bananas, mashed",
    "0.75 cup packed brown sugar",
    "0.33333334326744 cup unsweetened applesauce",
    "1 large egg, lightly beaten",
    "1 teaspoon almond extract",
    "1 cup whole wheat flour",
    "2 teaspoons baking powder",
    "1.25 teaspoons salt",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "1 cup quick-cooking oats",
    "1 cup diced fresh peaches"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease twelve 2 1/2-inch muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together bananas, brown sugar, applesauce, egg, and almond extract in a large bowl. Sift together flour, baking powder, salt, cinnamon, and baking soda in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour mixture and oats to banana mixture; gently stir just until combined. Do not overmix. Fold in peaches. Spoon batter evenly into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the centers comes out clean, 15 to 20 minutes. Remove muffins from pan, transfer to a wire rack, and let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
