  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease a shallow 1 quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, white sugar, 2 tablespoons cocoa powder, and salt together in a large bowl. Mix in the milk, oil, and vanilla extract. Stir in nuts. Pour batter into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar and remaining 1/4 cup cocoa powder together; sprinkle over batter in baking dish. Pour the boiling water slowly over the top of the batter and topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 minutes. The top of the cake will be set and the bottom will be soft. Invert hot cake onto a platter to serve.",
      "section": null,
