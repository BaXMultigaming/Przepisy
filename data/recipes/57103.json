  "ingredients": [
    "1 cup butter",
    "0.75 (16 ounce) package frozen French cut green beans",
    "2 onions, chopped",
    "2 leeks, chopped",
    "1 tablespoon garlic and herb seasoning blend",
    "2 eggs, lightly beaten",
    "1 (16 ounce) package seasoned dry bread cube stuffing mix",
    "2 cups hot water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease a medium baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a skillet over medium heat, melt 2 tablespoons butter, and saute the green beans, onions, and leeks until tender. Season with garlic and herb seasoning blend. Mix in the remaining butter until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, toss together the green bean mixture, eggs, and dry stuffing mix. Gradually blend in the water. Transfer the mixture to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 40 minutes in the preheated oven, or until lightly brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
