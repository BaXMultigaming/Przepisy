  "ingredients": [
    "1 green bell pepper, chopped",
    "1 yellow onion, chopped",
    "2 tablespoons olive oil",
    "2 tablespoons chicken stock",
    "1 pound ground beef",
    "3 tablespoons taco seasoning",
    "2 large roma (plum) tomatoes, chopped",
    "0.5 teaspoon salt",
    "1 (8 ounce) package shredded Cheddar cheese",
    "12 large romaine lettuce leaves"
  ],
  "steps": [
    {
      "text": "Cook and stir green bell pepper and yellow onion in a skillet over medium heat with olive oil and chicken broth until onion is translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ground beef in a separate skillet over medium heat. Cook and stir with taco seasoning until beef is browned and crumbly, 5 to 8 minutes. Drain excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle tomatoes with salt in a bowl. Place Cheddar cheese into a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each lettuce leaf with about 2 tablespoons beef filling; top with 1 to 2 teaspoons green pepper mixture, tomato, and about 1 1/2 tablespoons Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
