  "title": "Air Fryer Eggplant Parmesan",
  "description": "These air fryer eggplant Parmesan rounds are deliciously crispy and crunchy without all the oil; easy to make for a tasty vegetarian appetizer.",
  "authors": [
    "Yoly"
  ],
  "date_published": "2019-03-03T03:07:12-05:00",
