  "ingredients": [
    "2 tablespoons olive oil, or as needed",
    "1 cup chopped onion",
    "2 carrots, chopped",
    "1 stalk celery, chopped",
    "4 cloves garlic, chopped",
    "5.25 cups chicken broth",
    "2.5 cups water",
    "2 (14 ounce) cans white beans, drained and rinsed",
    "20 frozen cooked small meatballs",
    "1 (5 ounce) bag baby spinach, coarsely chopped",
    "0.5 cup finely grated Asiago cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over high heat. Saute onion, carrots, celery, and garlic until onion is pale golden, about 4 minutes. Pour broth and water into pot; cover the pot and bring mixture to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir beans and meatballs into broth mixture; bring to a boil, reduce heat to medium-low, cover the pot, and simmer, stirring occasionally, until vegetables are tender and meatballs are heated through, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix spinach, Asiago cheese, salt, and pepper into soup; simmer until spinach wilts, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
