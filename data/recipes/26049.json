  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "2 teaspoons baking soda",
    "2 eggs",
    "1 (20 ounce) can crushed pineapple, with juice",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 10x15 inch sheet pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the flour, sugar and baking soda into a large bowl. Stir together the eggs, pineapple with juice and vanilla. Make a well in the flour mixture and pour in the pineapple mixture. Mix well and spread into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
