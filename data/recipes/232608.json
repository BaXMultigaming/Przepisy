  "ingredients": [
    "1 (8 ounce) can DOLE® Crushed Pineapple",
    "1 (18.25 ounce) package white cake mix",
    "1 (3 ounce) package lemon flavored gelatin",
    "2 eggs",
    "0.75 cup water",
    "0.33333334326744 cup vegetable oil",
    "1 (16 ounce) can prepared vanilla frosting",
    "Multi-colored sprinkles, as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Line mini-muffin pan with mini-cupcake papers (1-1/2 inch in diameter).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together pineapple with juice, cake mix, gelatin, eggs, water and oil in large bowl. Spoon level tablespoon into each cupcake paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 10 to 12 minutes or until toothpick inserted in center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool completely on wire racks. Pipe frosting creating a small flower on top of each cake bite, decorate with sprinkles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
