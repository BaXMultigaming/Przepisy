  "title": "Thanksgiving Bacon Stuffing",
  "description": "Onion and bacon stuffing baked in muffin tins is the perfect individual-size side dish for Thanksgiving dinner.",
  "authors": [
    "Nickolasa"
  ],
  "date_published": "2015-11-19T02:17:41-05:00",
