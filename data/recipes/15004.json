  "ingredients": [
    "4.5 cups all-purpose flour",
    "2 teaspoons baking soda",
    "2 cups butter, softened",
    "1.5 cups packed brown sugar",
    "0.5 cup white sugar",
    "2 (3.4 ounce) packages instant vanilla pudding mix",
    "4 eggs",
    "2 teaspoons vanilla extract",
    "4 cups semisweet chocolate chips",
    "2 cups chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour and baking soda in a medium bowl, set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together butter, brown sugar, and white sugar in a large bowl. Beat in instant pudding mix until blended. Stir in eggs and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour mixture to the butter mixture until it's well incorporated. Fold in chocolate chips and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop cookies by rounded spoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in batches in the preheated oven until the edges are golden brown, 10 to 12 minutes, switching racks halfway through.",
      "section": null,
      "name": null,
      "url": null,
