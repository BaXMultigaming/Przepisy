  "ingredients": [
    "1 (18.25 ounce) package moist yellow cake mix",
    "1 cup water",
    "3 large eggs",
    "1/3 cup vegetable oil",
    "2 cups diced rhubarb",
    "1.25 cups white sugar",
    "0.5 pint whipping cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare cake batter by combining cake mix, water, eggs, and oil together in a large bowl; beat with an electric mixer on low speed until moistened. Increase speed to medium and beat for 2 minutes. Pour batter into prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine rhubarb and sugar together in a bowl; spoon over batter in the pan. Drizzle whipping cream over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 40 minutes. Let cake cool completely before turning it out onto a serving dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
