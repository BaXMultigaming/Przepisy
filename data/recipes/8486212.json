  "title": "Farmer Cheese Dumplings",
  "description": "Chef John&#39;s American-style farmer cheese dumplings are easy to make and can be simmered in any type of liquid like gravy, soups, or stews.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2022-09-29T11:51:00-04:00",
  "date_modified": "2024-12-02T11:17:17-05:00",
  "prep_time": "PT30M",
