  "ingredients": [
    "2 tablespoons butter",
    "0.5 (8 ounce) package cream cheese, softened",
    "0.5 cup shredded Gouda cheese",
    "0.25 cup mayonnaise",
    "0.25 cup chicken broth",
    "2 tablespoons dry ranch dressing mix (such as Hidden Valley Ranch®)",
    "2 cups chopped cooked broccoli",
    "1.75 cups diced cooked chicken",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1.5 cups shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Whisk in cream cheese, Gouda cheese, mayonnaise, chicken broth, and ranch dressing mix. Reduce heat to low; cook, stirring constantly, until completely incorporated, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in broccoli, chicken, salt, and pepper until combined. Transfer to a casserole dish and top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and broccoli-chicken mixture is heated through, about 25 minutes. Switch the oven to broil; cook until cheese starts to brown, 2 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
