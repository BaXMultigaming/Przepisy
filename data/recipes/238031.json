  "ingredients": [
    "0.75 cup coconut milk",
    "2 tablespoons white vinegar",
    "1 cup all-purpose flour",
    "2 tablespoons white sugar",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 egg",
    "2 tablespoons butter, melted",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Stir coconut milk and vinegar together in a bowl; set aside until the coconut milk tastes sour, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, baking powder, baking soda, and salt together in a large mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg and melted butter into the coconut milk mixture; pour into the flour mixture and whisk together until no lumps remain in the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare a large skillet with cooking spray and place over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle batter into the skillet 1/4 cup at a time; cook until bubbles appear on the top of the pancake, about 5 minutes. Flip the pancake and continue cooking until the bottom is browned and the center is cooked through, 2 to 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
