  "ingredients": [
    "standing rib roast",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HFg3TDSBKLhC8eCuzYx5loYYzss=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/97621-FoolProofRibRoast-mfs-Step1-1502-6700894a78484926956e73a8ad6af01d.jpg"
      ],
      "image": "assets/images/97621/step_01.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Place a rack in a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine salt, pepper, and garlic powder in a small cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place room-temperature roast on the rack in the roasting pan with the fatty side up and the rib side on the bottom. Rub the seasoning onto the roast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VDA-K41nUOSgzAptdal7NBsmtVM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/97621-FoolProofRibRoast-mfs-Step2-1511-acb36f39d68a49c6918c429aa0d8f525.jpg"
      ],
      "image": "assets/images/97621/step_04.webp"
    },
    {
      "text": "Roast for 1 hour in the preheated oven. Turn the oven off and leave the roast inside for 3 hours, without opening the door.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r4Z-BWCBzVwXEeJZh-00p9B-GK0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/97621-FoolproofRibRoast-mfs-Srep3-1568-2a477b7baf634e709db92f04140dd10c.jpg"
      ],
      "image": "assets/images/97621/step_05.webp"
    },
    {
      "text": "Turn the oven back on to 375 degrees F (190 degrees C) and reheat the roast for 30 to 40 minutes. The internal temperature should be at least 145 degrees F (62 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let rest for 10 minutes before carving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0s0YEdx07OXXSNnaoERmCN1BAhQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/97621-FoolproofRibRoast-mfs-Step4-1621-653e95d3e457495aa41b3bba8d3d3ce0.jpg"
      ],
      "image": "assets/images/97621/step_07.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
