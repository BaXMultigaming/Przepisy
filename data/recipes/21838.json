  "ingredients": [
    "5 apples, peeled and cored",
    "3 eggs",
    "1.5 cups white sugar",
    "0.75 cup vegetable oil",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 tablespoon vanilla extract",
    "2 cups all-purpose flour",
    "0.75 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan. Cut the apples into 1-inch wedges; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk eggs and sugar together until blended. Mix in baking soda, oil, cinnamon, and vanilla. Stir in flour until just incorporated. Fold in apples and walnuts. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 55 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool slightly; this cake is best served warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
