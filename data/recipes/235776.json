  "ingredients": [
    "1 cup water, or as desired",
    "1 teaspoon lemon juice, or as needed",
    "2 medium Granny Smith apples - peeled, cored, and sliced, or more to taste",
    "0.33333334326744 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "1 (8 ounce) package cream cheese, softened",
    "0.25 cup white sugar",
    "1 large egg",
    "0.5 teaspoon vanilla extract",
    "1 (10 inch) graham cracker crust",
    "0.33333334326744 cup quick-cooking oats"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water and lemon juice together in a medium bowl; add apples. Whisk 1/3 cup sugar and cinnamon together in a small bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and 1/4 cup sugar together in a large bowl with an electric mixer until smooth; add egg and vanilla extract. Mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain apples and transfer to crust. Sprinkle cinnamon-sugar mixture and oats evenly over apples. Pour cream cheese mixture over apple mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 40 minutes. Cool on a wire rack, 1 to 2 hours. Refrigerate until completely set, 3 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
