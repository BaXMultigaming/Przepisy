  "ingredients": [
    "3 fresh peaches - peeled, pitted, and sliced",
    "1.5 cups white sugar",
    "1 teaspoon ground cinnamon",
    "0.5 cup shortening",
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup milk",
    "3 tablespoons butter",
    "2 cups boiling water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 10x10-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together peaches, 1 1/2 cups sugar, and cinnamon in a medium bowl until well combined; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together remaining 1 cup sugar and shortening in a large bowl until light and fluffy. Stir together flour, baking powder, and salt in a small bowl; add to shortening mixture alternately with milk, mixing after each addition until just combined. Pour biscuit batter into the prepared baking dish; top with peach mixture. Drop butter in boiling water and pour all over peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
