  "ingredients": [
    "1.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1 teaspoon ground ginger",
    "0.5 teaspoon baking soda",
    "1 cup brown sugar",
    "0.5 cup butter",
    "2 eggs",
    "1 cup maple nut granola",
    "1 cup shredded coconut",
    "0.5 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a large cookie sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, ginger, and baking soda together in a medium bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter in a separate bowl with an electric mixer on medium speed until forms a smooth paste. Beat in eggs until creamy. Beat in flour mixture until a smooth dough forms. Fold in granola, coconut, and chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop teaspoonfuls of dough 2 inches apart onto the prepared cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly brown on top, about 10 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
