  "ingredients": [
    "2 bananas, mashed",
    "0.5 cup milk",
    "2 cups all-purpose flour",
    "3 teaspoons baking powder",
    "0.5 teaspoon salt",
    "2 eggs, beaten",
    "1 tablespoon margarine, melted",
    "1 quart vegetable oil for frying",
    "0.5 cup confectioners' sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bananas and milk in a large mixing bowl; sift in flour, baking powder, and salt. Add eggs and margarine; mix well to combine. Heat oil in a large, deep skillet to 365 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully place spoonfuls of the fritter mixture into the hot oil; cook, flipping once, until golden brown, about 5 minutes. Remove, and drain on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dust fritters with confectioners' sugar and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
