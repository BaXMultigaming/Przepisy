  "ingredients": [
    "cooking spray",
    "0.25 cup Greek yogurt",
    "0.25 cup reduced-fat mayonnaise",
    "4 tablespoons lime juice",
    "3 tablespoons diced red onion",
    "1 tablespoon rice vinegar",
    "1 tablespoon dried cilantro",
    "0.25 teaspoon hot sauce",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground ancho chile powder",
    "3 cups shredded cabbage",
    "1.5 pounds tilapia fillets",
    "2 tablespoons lime juice",
    "1 teaspoon ground cumin",
    "0.5 teaspoon paprika",
    "0.125 teaspoon salt",
    "0.125 teaspoon garlic powder",
    "8 (8 inch) flour tortillas"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking pan with aluminum foil. Spray generously with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Greek yogurt, mayonnaise, lime juice, onion, vinegar, cilantro, hot sauce, salt, and ancho chile powder in a bowl. Stir in shredded cabbage to make the slaw.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tilapia fillets on the prepared baking pan. Squeeze lime juice over fish. Combine cumin, paprika, salt, and garlic powder in another bowl. Sprinkle spice mixture over the fish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake under the preheated broiler until fish flakes easily with a fork, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tortillas between 2 damp paper towels. Warm in the microwave, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon the cooked tilapia onto each tortilla and top with the slaw.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
