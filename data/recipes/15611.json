  "ingredients": [
    "1 large head cabbage",
    "1.5 teaspoons garlic powder, or to taste",
    "salt and pepper to taste",
    "aluminum foil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat grill for medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hycKoncKnR-TPM2tEMH99qA8LiA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15611-cabbage-on-the-grill-VAT-step-01-c802911f991c48e5b797c6cc3edf7401.jpg"
      ],
      "image": "assets/images/15611/step_01.webp"
    },
    {
      "text": "Cut cabbage into 8 wedges, and remove the core.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5_xNAQDFe1MtyAwM9bqwu8tZqlY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15611-cabbage-on-the-grill-VAT-step-02-310035afeb214e6b81260e43c7e23045.jpg"
      ],
      "image": "assets/images/15611/step_02.webp"
    },
    {
      "text": "Place cabbage wedges on a piece of aluminum foil large enough to wrap them all. Season wedges on both sides with garlic powder, salt, and pepper; seal the foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lAEmava_YRtUPbgntH4Sj_yBfXc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15611-cabbage-on-the-grill-VAT-step-03-2532f6160fe24c79919160e25daf4802.jpg"
      ],
      "image": "assets/images/15611/step_03.webp"
    },
    {
      "text": "Cook on the preheated grill until cabbage is tender, about 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-kBU0WI0X-uJtKhJYSXfO9mGxbg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15611-cabbage-on-the-grill-VAT-step-04-645406e420a34bedb5a2c9bbceeaf91f.jpg"
      ],
      "image": "assets/images/15611/step_04.webp"
    },
    {
      "text": "If you want to char the wedges for a smokier flavor, sear the cooked cabbage wedges directly on a greased grill for about 1 minute on each side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LDIr3g72L1VdJXky1FJ9EzgOx20=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15611-cabbage-on-the-grill-VAT-step-05-4877597d8b7d465c940dd886067cb929.jpg"
      ],
      "image": "assets/images/15611/step_05.webp"
    }
