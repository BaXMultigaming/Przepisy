  "ingredients": [
    "1.25 cups graham cracker crumbs",
    "0.75 cup margarine, melted",
    "1 (8 ounce) package cream cheese",
    "0.5 cup white sugar",
    "1 dash vanilla extract",
    "1 dash almond extract",
    "1 cup heavy cream",
    "1 (12 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham cracker crumbs and melted margarine in a small bowl; stir well and press into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 5 minutes. Place in the refrigerator to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat cream cheese, sugar, vanilla, and almond extract in a large bowl with an electric mixer until smooth. Whip cream in a medium bowl until stiff peaks form; fold into cream cheese mixture. Spread over cooled crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dot top with cherry pie filling; smooth with a knife or spatula to cover. Chill in the refrigerator until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
