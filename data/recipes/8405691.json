  "ingredients": [
    "nonstick cooking spray",
    "1 (22 ounce) can lemon pie filling",
    "1 (15.25 ounce) package lemon cake mix",
    "1 (8 ounce) package cream cheese, cubed",
    "0.5 cup salted butter, cut into small pieces",
    "1 (8 ounce) container frozen whipped topping (such as Cool Whip®), thawed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F0us_Z3Z_AmXQzCyPpkzl-IR_gs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8405691-lemon-dump-cake-VAT-step-01-1fa1c1655c2f41be85de9ece310343b7.jpg"
      ],
      "image": "assets/images/8405691/step_01.webp"
    },
    {
      "text": "Spread the lemon pie filling onto the bottom of the prepared baking dish in an even layer with a spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/U4_OX8JpvTbggef6v0_R18UGQA8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8405691-lemon-dump-cake-VAT-step-02-909dbe88646445239a126df74f82d53f.jpg"
      ],
      "image": "assets/images/8405691/step_02.webp"
    },
    {
      "text": "Sprinkle half of the cake mix in an even layer over the lemon pie filling. Add small pieces of the cream cheese evenly over the cake mix, then top with the remaining cake mix in an even layer. Add the butter pieces, spaced out evenly over the top of final cake mix layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yOHF-r2M7UvmJ7quHekAEXOX3iQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8405691-lemon-dump-cake-VAT-step-03-7bb605b7a8214de39568d6133821893d.jpg"
      ],
      "image": "assets/images/8405691/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until the topping is browned and the cake mix powder has all absorbed and baked, 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v-_teQNwgg7jQGyg34MvcCBhXfY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8405691-lemon-dump-cake-VAT-step-04-43559f9a6e314051bd5f3ac43cbb2414.jpg"
      ],
      "image": "assets/images/8405691/step_04.webp"
    },
    {
      "text": "Serve dump cake warm with whipped topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eY35Se4Er5EBB7Q5i9IHUvPksh8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8405691-lemon-dump-cake-VAT-step-05-fcb15a6aa29d41009fa3aadf1dd41519.jpg"
