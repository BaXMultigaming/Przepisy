  "ingredients": [
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "4 very ripe bananas",
    "0.75 cup white sugar",
    "1 tablespoon vanilla extract",
    "1.5 teaspoons ground cinnamon",
    "2 cups oil for frying, or as needed",
    "1 tablespoon confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Combine flour, baking powder, and salt in a bowl. Mash bananas, sugar, vanilla extract, and cinnamon together in a separate bowl. Stir flour mixture into banana mixture until batter is well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 2 inches of oil into a heavy pot and heat over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, drop batter by the tablespoon into hot oil; cook until lightly golden brown, 2 to 3 minutes per side. Transfer banana balls to a paper towel-lined plate to drain and cool slightly. Dust banana balls with confectioners’ sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
