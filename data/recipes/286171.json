  "ingredients": [
    "nonstick cooking spray",
    "1.5 cups all-purpose flour",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "0.75 teaspoon ground ginger",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon pumpkin pie spice",
    "1 cup pumpkin puree",
    "0.75 cup white sugar",
    "0.75 cup vegetable oil",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "0.5 cup powdered sugar",
    "2 tablespoons half-and-half",
    "0.5 teaspoon pumpkin pie spice",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray 15 standard-sized muffin cups with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cinnamon, baking soda, ginger, nutmeg, allspice, baking powder, salt, and pumpkin pie spice in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat pumpkin puree, sugar, oil, eggs, and vanilla in a large bowl until well combined. Slowly mix in dry ingredients until well blended and smooth. Distribute the batter evenly among the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the centers comes out clean, 15 to 18 minutes. Cool in the tin for 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the muffins are cooling, blend powdered sugar, half-and-half, pumpkin pie spice, vanilla, and cinnamon for glaze until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove muffins from the tin and dip the tops into the glaze. Set on a wire rack until glaze sets, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
