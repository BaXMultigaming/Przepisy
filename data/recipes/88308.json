  "ingredients": [
    "vegetable oil for frying",
    "1 egg, beaten",
    "0.33333334326744 cup milk",
    "4 (6 ounce) fillets cod",
    "2 tablespoons all-purpose flour for coating",
    "2 cups quick-cooking oats",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together egg and milk in a bowl. Coat cod fillets with flour; shake off excess. Dip cod in egg mixture; allow excess to drip off. Coat cod with oats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fish one at a time in hot oil; fry for 2 to 3 minutes, then turn over, and fry 2 to 3 minutes more. Remove to paper towels. Season to taste with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
