  "ingredients": [
    "cooking spray",
    "3 eggs",
    "0.5 avocado, mashed",
    "1 teaspoon vanilla extract",
    "1 (15 ounce) can black beans, rinsed well and drained",
    "0.5 cup brown sugar",
    "0.33333334326744 cup unsweetened dark cocoa powder",
    "0.5 cup miniature semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9-inch square baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, mashed avocado, and vanilla extract together in a large bowl. Add black beans; purée with an immersion blender until beans are mashed and batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and cocoa powder in a separate bowl; add to batter and mix by hand with a wooden spoon until completely combined. Stir in chocolate chips. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, 25 to 30 minutes. Cool completely before cutting and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
