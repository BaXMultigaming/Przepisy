  "ingredients": [
    "6 cups day-old bread cubes, crust removed",
    "1 cup raisins, or to taste",
    "4 cups milk",
    "8 eggs",
    "0.66666668653488 cup white sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill an 11x12-inch pan with dried bread cubes and sprinkle with raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, eggs, sugar, cinnamon, vanilla extract, and salt in a bowl. Beat with an electric mixer until smooth. Pour milk-egg mixture over bread cubes and raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, 1 to 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
