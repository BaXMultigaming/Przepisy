  "ingredients": [
    "0.5 cup white sugar",
    "0.33333334326744 cup unsweetened cocoa powder",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "2 cups milk",
    "2 large eggs",
    "1 tablespoon vegetable oil",
    "0.5 teaspoon vanilla extract",
    "4 day-old biscuits, crumbled"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, cocoa powder, cinnamon, and salt in a small bowl. Whisk milk, eggs, vegetable oil, and vanilla in a medium bowl. Add sugar mixture to milk mixture; stir until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bottom of the prepared baking dish with an even layer of crumbled biscuits. Pour custard mixture evenly over biscuits; press down onto the biscuits with the back of a large spoon to moisten them.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the baking dish into a larger high-sided baking pan. Place dish on oven rack; add enough hot water to come halfway up the sides of the dish. Bake in preheated oven for 45 minutes, or until pudding is set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
