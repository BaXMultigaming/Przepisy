  "ingredients": [
    "0.66666668653488 cup peanut butter",
    "0.33333334326744 cup shortening",
    "0.5 cup white sugar",
    "0.5 cup honey",
    "1 large egg",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "0.5 cup chopped peanuts"
  ],
  "steps": [
    {
      "text": "Combine peanut butter, shortening, sugar, honey, and egg in a large bowl; beat with an electric mixer until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, salt, and baking soda together in a bowl. Add to the wet ingredients and mix until blended. Stir in peanuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into a 10x2-inch log. Wrap in waxed paper and chill in the refrigerator for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove dough from the refrigerator and cut into 1/8-inch slices. Place 1 inch apart on the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 8 to 10 minutes. Cool on the baking sheet briefly before removing to a wire rack to cool completely. Repeat to bake remaining cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
