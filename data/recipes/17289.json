  "title": "Chocolate Zucchini Bread",
  "description": "This easy chocolate zucchini bread is moist, fudgy, and made with a double dose of chocolate for a delicious way to use up a surplus of zucchini.",
  "authors": [
    "Diane"
  ],
  "date_published": "1999-10-04T10:50:43-04:00",
