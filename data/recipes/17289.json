    "publisher-tested"
  ],
  "ingredients": [
    "2 (1 ounce) squares unsweetened chocolate",
    "2 cups white sugar",
    "2 cups grated, drained zucchini",
    "1 cup vegetable oil",
    "3 large eggs",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "0.75 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Generously grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uf7Gn_-2JhY8_1Sbpv5HXQ18e20=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17289-chocolate-zucchini-bread-ddmfs-Step1-0208-4c20879502fe484395f78f101c0d5a68.jpg"
      ],
      "image": "assets/images/17289/step_01.webp"
    },
    {
      "text": "Melt chocolate squares in a microwave-safe glass or ceramic bowl in 15-second intervals, stirring after each interval, 1 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wIHC00eE5bca3swXk9Dcf-U-YkE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17289-chocolate-zucchini-bread-ddmfs-Step2-0211-fe9cfd4a8cd541168b95e908b8041a36.jpg"
      ],
      "image": "assets/images/17289/step_02.webp"
    },
    {
      "text": "Beat sugar, zucchini, oil, eggs, and vanilla in a large bowl with an electric mixer until well combined. Beat in melted chocolate. Stir in flour, baking soda, salt, and cinnamon until just blended. Fold in chocolate chips. Pour batter into the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8wbqf8Zm7QyOT6icUHMgVW2HNic=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17289-chocolate-zucchini-bread-ddmfs-Step3-0212-4a5869cd858a4835bddffc0a0e121a62.jpg"
      ],
      "image": "assets/images/17289/step_03.webp"
    },
    {
      "text": "Bake loaves in the preheated oven until a toothpick inserted into the center of each loaf comes out clean, 60 to 70 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XkZ3ZC87g0Vl3_1gko8lqHZk63k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17289-chocolate-zucchini-bread-ddmfs-Step5-0215-90fb43e3104c422dadc7998b568b3127-4b9433637c59439b88cd141791c8fba2.jpg"
      ],
      "image": "assets/images/17289/step_04.webp"
    },
    {
      "text": "Cool to room temperature before slicing. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P6309KE4L-qqFdqg2k9vcPDOVLs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17289-chocolate-zucchini-bread-ddmfs-3X4-0229-526b46022bb342518036417af9e919f6-7c4c7a7f2203464b948222824467f6b5.jpg"
      ],
      "image": "assets/images/17289/step_05.webp"
    }
  ],
