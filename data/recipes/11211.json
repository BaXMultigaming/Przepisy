  "ingredients": [
    "1 cup shortening",
    "0.5 cup butter",
    "4 tablespoons water",
    "1.5 tablespoons vanilla extract",
    "2 pounds confectioners' sugar",
    "0.125 teaspoon salt"
  ],
  "steps": [
