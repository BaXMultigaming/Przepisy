  "ingredients": [
    "1.5 cups semisweet chocolate chips",
    "1 (19 ounce) can garbanzo beans, rinsed and drained",
    "4 eggs",
    "0.75 cup white sugar",
    "0.5 teaspoon baking powder",
    "1 tablespoon confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate chips in a microwave-safe bowl. Microwave until chocolate melted and smooth, about 2 minutes, stirring every 20 seconds after 1 minute. If you have a powerful microwave, reduce the power to 50 percent.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine garbanzo beans and eggs in the bowl of a food processor; process until smooth. Add sugar and baking powder; pulse to blend. Pour in melted chocolate; process until smooth, scraping corners to make sure chocolate is completely mixed. Transfer batter to the prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, about 40 minutes. Cool in the pan on a wire rack for 10 to 15 minutes before inverting onto a serving plate. Dust with confectioners' sugar just before serving.",
      "section": null,
      "name": null,
      "url": null,
