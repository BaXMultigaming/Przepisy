  "ingredients": [
    "1 (15.5 ounce) can black beans, rinsed and drained",
    "0.75 cup white sugar",
    "0.25 cup cocoa powder",
    "3 large eggs",
    "3 tablespoons vegetable oil",
    "1 teaspoon instant coffee",
    "1 teaspoon vanilla extract",
    "1 pinch salt",
    "0.5 cup milk chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UKCD61hCx7AwB7aKygzLxOzUKn0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161701-black-bean-brownies-step-01-45aab4e4217e4e66a482c22ec87f16f1.jpg"
      ],
      "image": "assets/images/161701/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beans, sugar, cocoa powder, eggs, oil, instant coffee, vanilla, and salt in a blender; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b_IL9PMCLfuGKKd2fFiduhZsPqw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161701-black-bean-brownies-step-02-3a5c03ae73384a0898ddabc8ab92d484.jpg"
      ],
      "image": "assets/images/161701/step_03.webp"
    },
    {
      "text": "Pour into the prepared baking dish. Sprinkle chocolate chips over the surface.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RtmONY4E4BHJD9k5QShMGYaeraQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161701-black-bean-brownies-step-04-5eb4ab449ba346fea17444880b1a99f5.jpg"
      ],
      "image": "assets/images/161701/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until the top is dry and the edges start to pull away from the sides of the pan, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5HVkAE5c4wC3xq8FavQCngXETy8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161701-black-bean-brownies-step-05-2f96c4b8d75c488f820777fbe6b55650.jpg"
      ],
      "image": "assets/images/161701/step_05.webp"
    },
    {
      "text": "Let cool to room temperature before cutting into 16 squares. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8UubyJ0-3Z4DO3pOC26BineK-bg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161701-black-bean-brownies-beauty-3x4-773fbea03b304a3dbc772dc8ce5481e8.jpg"
