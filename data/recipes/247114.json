  "ingredients": [
    "1.5 cups brown sugar",
    "0.5 cup chile sauce",
    "0.5 cup grape jelly",
    "0.5 cup yellow mustard",
    "0.25 cup vinegar",
    "0.25 cup soy sauce",
    "0.25 cup honey",
    "0.5 teaspoon salt",
    "0.125 teaspoon chipotle chile powder",
    "1 tablespoon cornstarch"
  ],
  "steps": [
    {
      "text": "Combine brown sugar, chile sauce, grape jelly, mustard, vinegar, soy sauce, honey, salt, and chipotle powder in a saucepan over medium-low heat. Cook, whisking well until brown sugar and jelly are dissolved, about 5 minutes. Bring just to a boil; remove from heat. Add cornstarch; whisk sauce until smooth and thickened.",
