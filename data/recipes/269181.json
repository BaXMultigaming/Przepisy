  "ingredients": [
    "4 ounces thinly sliced pancetta",
    "0.33333334326744 cup Calabrian chili peppers in oil",
    "12 ounces sliced salami",
    "2 tablespoons olive oil, or more as needed",
    "0.25 cup butter, at room temperature"
  ],
  "steps": [
    {
      "text": "Add pancetta to a cold pan. Cook over medium heat, tossing occasionally, until pancetta just starts to crisp up, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pepper stems and, if desired, seeds. Reserve 2 or 3 tablespoons of the oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate salami pieces slightly and place in a food processor. Add the pancetta, chili oil, and Calabrian peppers. Pulse on and off until mixture is finely ground. Add olive oil and butter. Process until as smooth and spreadable as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer spread to a bowl. Cover with plastic wrap and refrigerate, 8 hours to overnight, for best flavor.",
      "section": null,
      "name": null,
      "url": null,
