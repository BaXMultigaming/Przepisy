  "ingredients": [
    "1.25 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup butter",
    "0.5 cup packed brown sugar",
    "0.5 cup white sugar",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1.3333300352097 cups flaked coconut"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/76V4zXxrC2ud0GMmqoQWTQPaiLo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9589-chewy-coconut-cookies-VAT-step-01-861b4989d9714252b581ed73d9e61a5f.jpg"
      ],
      "image": "assets/images/9589/step_01.webp"
    },
    {
      "text": "Combine flour, baking soda, and salt together in a medium bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Nywjz8YfiTupU1QfJheRYNRZ66g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9589-chewy-coconut-cookies-VAT-step-02-93103548cb52427ea38e373390fb68db.jpg"
      ],
      "image": "assets/images/9589/step_02.webp"
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together in a large bowl with an electric mixer until smooth. Add egg and vanilla; beat until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/koKya3BSqeTscF4KFJBpEkNI6NY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9589-chewy-coconut-cookies-VAT-step-03-A-104bd64007ff4a41af94daef8b41050a.jpg"
      ],
      "image": "assets/images/9589/step_03.webp"
    },
    {
      "text": "Gradually blend in flour mixture, then stir in coconut until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1zTUcZBeng5EuiZCvypgZvgITnA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9589-chewy-coconut-cookies-VAT-step-04-A-32b8a897cf194d68b4330d48471375d9.jpg"
      ],
      "image": "assets/images/9589/step_04.webp"
    },
    {
      "text": "Drop dough by teaspoonfuls onto ungreased cookie sheets, about 3 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dD6vqthdPdt84FfH28eUp1cOODg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9589-chewy-coconut-cookies-VAT-step-05-5dbab5ad7e0e41bf98f8cddaf45b222f.jpg"
      ],
      "image": "assets/images/9589/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 8 to 10 minutes. Allow cookies to cool briefly on the baking sheet before transferring them to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ISraeRXpvwisXIjcZGC2RHb-I2s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9589-chewy-coconut-cookies-VAT-step-06-d124bd7bcb664c18a384273867f8c8e2.jpg"
      ],
      "image": "assets/images/9589/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gxiOgvBMVywEyAb_2RNXyhimvWY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9589-chewy-coconut-cookies-VAT-4x3-A-dc1e5cacff504fa48097f62fcd7436c6.jpg"
      ],
      "image": "assets/images/9589/step_07.webp"
    }
