  "ingredients": [
    "2 cups white sugar",
    "2 eggs",
    "1 cup cold coffee",
    "3 cups all-purpose flour",
    "2 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon salt",
    "3 cups chopped rhubarb",
    "1.5 cups sliced strawberries",
    "0.5 cup brown sugar",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar and eggs together in a large bowl until smooth; beat in coffee. Whisk flour, baking soda, cinnamon, and salt together in a separate bowl; beat into sugar-coffee mixture until just combined. Stir rhubarb and strawberries into batter; pour into the prepared pan. Sprinkle top with brown sugar and pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake is golden brown and a toothpick inserted into center comes out clean, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
