  "title": "Almond Sauce Chicken Breasts",
  "description": "Chicken breasts are dipped in egg and almond crumbs, browned then baked onions and mushrooms in a luscious almond cream sauce",
  "authors": [
    "Rebecca Swift"
  ],
  "date_published": "2000-10-11T16:39:22-04:00",
  "date_modified": "2025-04-06T16:09:06-04:00",
