  "keywords": [],
  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "salt and pepper to taste",
    "1 egg",
    "0.5 cup water",
    "2 cups finely chopped almonds",
    "0.25 cup butter",
    "3 tablespoons olive oil",
    "1 pound fresh mushrooms",
    "1 onion, sliced into rings",
    "2 cloves garlic, crushed",
    "1 cup heavy cream",
    "0.25 cup almond paste",
    "0.5 teaspoon freshly ground nutmeg"
  ],
  "steps": [
    {
      "text": "Pound chicken breasts to flatten; Season with salt and pepper to taste. In a small bowl, beat together egg and water to make egg wash. Place almond crumbs in a shallow dish or bowl; dip chicken in egg wash, then dredge in almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter with olive oil in a medium skillet over medium high heat. Brown coated chicken quickly, then transfer to a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In same skillet, brown the mushrooms and onions with the garlic. Mix together and spread mixture over the chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In same skillet, combine the cream and almond paste and mix together; heat through, then stir in nutmeg. Pour sauce over chicken, mushrooms and onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 40 minutes, or until chicken is cooked through and no longer pink inside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
