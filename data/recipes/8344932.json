  "ingredients": [
    "cooking spray",
    "1 pound ground beef",
    "0.5 pound ground chorizo",
    "0.5 cup grated Parmesan cheese",
    "0.5 cup Italian bread crumbs",
    "1 large egg",
    "1 large clove garlic, minced",
    "1 (18 ounce) bottle barbeque sauce (such as Sweet Baby Ray's® Sweet 'n Spicy)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a large glass baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef, chorizo, Parmesan cheese, bread crumbs, egg, and garlic together until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form mixture into about 36 meatballs. Place meatballs in rows the prepared baking dish. Drizzle barbecue sauce over each meatball until a small puddle forms at the base.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until an instant-read thermometer inserted into the centers reads at least 160 degrees F (71 degrees C), 18 to 22 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
