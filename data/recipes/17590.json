  "ingredients": [
    "1 (9 inch) prepared graham cracker crust",
    "1 (1 ounce) package sugar-free instant vanilla pudding mix",
    "1 cup cold milk",
    "1 (8 ounce) can crushed pineapple, drained",
    "1 (8 ounce) container frozen whipped topping, thawed",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "In a medium bowl, whisk together pudding mix and milk. Fold in pineapple, whipped topping, and pecans. Pour mixture into prepared crust. Chill at least 2 hours before serving.",
