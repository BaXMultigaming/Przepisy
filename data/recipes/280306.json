  "ingredients": [
    "4 chicken leg quarters with skin",
    "2 teaspoons lemon-pepper seasoning",
    "1.5 teaspoons salt",
    "1 teaspoon dried parsley",
    "2 teaspoons olive oil"
  ],
  "steps": [
    {
      "text": "Coat the leg quarters with lemon-pepper, salt, and parsley. Let sit in the refrigerator, covered, for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium-high heat. Sear chicken, skin-side down, to help crisp the skin, about 5 minutes per side. Transfer to a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the centers and juices run clear, about 1 hour. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
