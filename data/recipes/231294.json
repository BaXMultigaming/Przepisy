  "ingredients": [
    "cooking spray",
    "0.75 cup white sugar",
    "6 tablespoons butter, softened",
    "6 tablespoons ground flax seed",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "2 cups all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "3 ripe bananas, mashed",
    "0.75 cup chocolate chips",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray muffin cups with cooking spray or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, flax seed, vanilla, and eggs together in a bowl with an electric mixer until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, salt, and baking soda together in a separate bowl. Mix creamed sugar mixture, 1/2 cup at a time, into the flour mixture until fully incorporated and batter is stiff. Beat bananas into batter with an electric mixer on low. Fold chocolate chips and walnuts into batter; spoon into the prepared muffin cups, filling each cup 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, about 25 minutes. Cool in the tins for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
