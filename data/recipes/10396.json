  "ingredients": [
    "1 cup butter",
    "0.75 cup white sugar",
    "1 egg",
    "0.5 cup almond paste",
    "1 teaspoon almond extract",
    "2 cups all-purpose flour",
    "2.5 ounces sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter in a large mixing bowl; gradually add sugar, beating until light and fluffy. Add egg yolk (reserve egg white), almond paste, and flavoring; beat until well blended. Stir in flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread mixture in a 13 x 9 x 2 inch baking pan. Beat egg white (at room temperature) until foamy; brush over entire surface of dough, and sprinkle with almonds. Bake for 35 minutes or until lightly browned. Cool thoroughly, and cut into 2 inch squares. Store in airtight containers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
