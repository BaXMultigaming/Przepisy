  "keywords": [],
  "ingredients": [
    "6 slices bacon",
    "24 spears fresh asparagus, trimmed",
    "1 (8 ounce) package cream cheese, softened",
    "2 tablespoons finely chopped chives",
    "12 slices white bread, crusts removed",
    "2 tablespoons butter, melted",
    "3 tablespoons grated Parmesan cheese, divided"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain the bacon slices on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When bacon is cool, crumble and set aside in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place asparagus spears into a large skillet and pour in about 1 inch of water. Place over medium heat, cover the skillet, and simmer asparagus until bright green and slightly tender, about 5 minutes. Remove asparagus and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cream cheese and chives into the bowl with bacon and stir to evenly combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll each bread slice with a rolling pin on a work surface until the slices are thin and flat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cream cheese mixture evenly over each slice of bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Center 2 asparagus spears on a bread slice, and roll the slice around the asparagus into a tidy and compact cylinder. Place seam side down onto the prepared baking sheet. Repeat with remaining ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush each roll with melted butter and sprinkle each with about 1 1/2 teaspoon Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden brown and hot, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6zNrUHkPy3HtXnA1GjpfRCCD5eA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/807036-asparagus-roll-ups-lutzflcat-1x1-1-fb491028b7a44b2b92ed6db3fbcf8a02.jpg"
      ],
