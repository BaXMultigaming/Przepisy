  "ingredients": [
    "2 cups water",
    "1 cup white sugar",
    "2 teaspoons cream of tartar",
    "30 buttery round crackers",
    "0.5 teaspoon ground cinnamon",
    "1 tablespoon lemon juice",
    "1 (9 inch) prepared pie shell",
    "1 cup crushed buttery round crackers",
    "0.5 cup packed brown sugar",
    "0.5 teaspoon ground cinnamon",
    "0.33333334326744 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the pie: Bring water, sugar, and cream of tartar to a boil in a medium saucepan over medium-high heat. Drop in whole crackers and boil for 5 minutes. Remove from the heat and pour mixture into pie shell; sprinkle with cinnamon and drizzle with lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the topping: Mix crushed crackers, brown sugar, melted butter, and cinnamon together in a small bowl; sprinkle over pie filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Reduce the heat to 375 degrees F (190 degrees C) and continue to bake for 15 to 20 more minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
