  "ingredients": [
    "2 cups eggnog",
    "1.5 cups coconut flakes",
    "0.75 cup white sugar",
    "0.5 cup all-purpose flour",
    "3 eggs",
    "6 tablespoons butter",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 10-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend eggnog, coconut flakes, sugar, flour, eggs, butter, and vanilla extract in a blender until well mixed; pour into prepared pie plate. Sprinkle nutmeg over the surface of the blended mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until set in the middle, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool pie at room temperature until the pie plate is no longer hot. Refrigerate pie until chilled completely, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
