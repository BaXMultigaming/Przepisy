  "ingredients": [
    "0.25 cup olive oil",
    "2 cups brown mushrooms, sliced",
    "0.5 cup fresh spinach, or more to taste",
    "2 cloves garlic, minced",
    "2 cups frozen riced cauliflower",
    "0.33333334326744 cup heavy cream",
    "1 teaspoon paprika",
    "1 pinch garlic salt, or to taste",
    "salt and ground black pepper to taste",
    "0.5 cup cherry tomatoes, halved"
  ],
  "steps": [
    {
      "text": "Heat a cast iron skillet over medium-low heat. Add olive oil, followed by mushrooms, spinach, and garlic. Simmer just until mushrooms get soft, spinach is wilted, and garlic is fragrant, making sure not to burn, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in cauliflower rice and cook until a rice-like consistency is reached, 5 to 7 minutes more. Pour in heavy cream, paprika, garlic salt, salt, and pepper; let simmer for 5 minutes more. Stir in tomatoes until just softened, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
