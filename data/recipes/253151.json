  "title": "Perfect Tempura Ice Cream",
  "description": "In this tempura ice cream recipe, balls of ice cream are wrapped in pound cake slices and re-frozen, then coated with batter and deep fried.",
  "authors": [
    "Lactaid"
  ],
  "date_published": "2016-06-03T01:23:09-04:00",
