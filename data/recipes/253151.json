  "ingredients": [
    "1 (12 ounce) prepared pound cake",
    "1 (32 ounce) container LACTAID® Vanilla Ice Cream",
    "2 cups vegetable oil for frying, or more as needed",
    "1 cup all-purpose flour, plus more for dusting",
    "1 cup sparkling water, chilled",
    "1 egg",
    "1 tablespoon Chocolate syrup"
  ],
  "steps": [
    {
      "text": "Cut pound cake in medium-size slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop a ball of ice cream and wrap completely with cake slices, patching where needed with smaller pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap balls tightly with plastic wrap, forming a round shape. Freeze at least 5 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep fryer or heavy pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cold sparkling water very slowly into flour; whisk in egg to create batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove ice cream balls, one at a time, from the freezer. Dust the surface with flour. Dip into batter, coating completely. Quickly lower coated ice cream balls into oil; fry until golden, about 25 seconds. Remove with a slotted spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with a drizzle of chocolate sauce before ice cream melts!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
