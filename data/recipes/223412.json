  "ingredients": [
    "1 (12 ounce) package tri-color coleslaw mix (with green cabbage, red cabbage and carrots)",
    "0.75 cup halved and thickly sliced celery stalks",
    "0.5 cup salted sunflower kernels",
    "0.33333334326744 cup sliced green onions",
    "2 tablespoons chopped white onion",
    "0.5 cup mayonnaise, or to taste",
