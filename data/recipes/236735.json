  "ingredients": [
    "0.5 cup shortening",
    "0.5 cup honey",
    "2 tablespoons brown sugar",
    "1 egg, beaten",
    "0.5 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup chocolate chips",
    "0.5 cup chopped almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat shortening, honey, and brown sugar with an electric mixer in a large bowl until smooth. Add egg and vanilla extract; beat until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, and salt together in a bowl; stir into honey mixture until just incorporated and dough comes together. Fold chocolate chips and almonds into dough. Drop spoonfuls of the dough 2 inches apart onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges just begin to brown, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
