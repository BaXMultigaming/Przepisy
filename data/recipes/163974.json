  "ingredients": [
    "1 cup natural peanut butter",
    "2 tablespoons peanut oil",
    "0.5 cup brewed black tea",
    "0.5 tablespoon minced fresh ginger",
    "3 cloves garlic, minced",
    "0.5 jalapeno pepper, minced",
    "0.5 teaspoon salt",
    "1.5 teaspoons white sugar",
    "1 tablespoon light soy sauce",
    "2 tablespoons rice vinegar",
    "1.5 tablespoons sesame oil",
    "2 pounds cooked egg noodles",
    "1 cup peeled, seeded, and julienned cucumber",
    "1 cup fresh cilantro leaves"
  ],
  "steps": [
    {
      "text": "Stir together the peanut butter, peanut oil, tea, ginger, garlic, jalapeno pepper, salt, sugar, soy sauce, vinegar, and sesame oil in a large mixing bowl until incorporated. Place the egg noodles in a large bowl; add the cucumber and cilantro and mix together with your hands. Pour the peanut sauce over the noodles; mix with your hands until evenly coated.",
