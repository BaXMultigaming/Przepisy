  "ingredients": [
    "0.75 cup soy sauce",
    "0.75 cup water",
    "3 tablespoons white vinegar",
    "2 tablespoons sesame oil",
    "0.5 large onion, minced",
    "0.25 cup minced garlic",
    "0.25 cup dark brown sugar",
    "2 tablespoons white sugar",
    "1 tablespoon black pepper",
    "3 pounds Korean-style short ribs (beef chuck flanken, cut 1/3- to 1/2-inch-thick across bones)"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yM6P7Zri5i3940jg0aHw6_5Cqhs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-141716-Korean-BBQ-Short-Ribs-Galbi-DDMFS-4x3-Ingredients-490b6afb224240eda6154138fbd7c864.jpg"
      ],
      "image": "assets/images/141716/step_01.webp"
    },
    {
      "text": "Pour soy sauce, water, vinegar, and sesame oil into a large, non-metallic bowl. Whisk in onion, garlic, brown sugar, white sugar, and pepper until sugars dissolve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oMJ8eRzuYlN-g4ZzERlXRuCcPeQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-141716-Korean-BBQ-Short-Ribs-Galbi-DDMFS-4x3-Step-01-A-fc8f4591bf304293aacdfb5888850db8.jpg"
      ],
      "image": "assets/images/141716/step_02.webp"
    },
    {
      "text": "Submerge ribs in marinade; cover the bowl and refrigerate 7 to 12 hours -the longer, the better.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/44IQ8HIzwZllQAXNd_PUAgxdsEQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-141716-Korean-BBQ-Short-Ribs-Galbi-DDMFS-4x3-Step-02-bb1b3bd49ef74f3cbd2a2cde72fa8071.jpg"
      ],
      "image": "assets/images/141716/step_03.webp"
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat. Remove ribs from marinade and shake off excess; discard marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rqkf5JrzV-dFuoygBIUiIPmpB4Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-141716-Korean-BBQ-Short-Ribs-Galbi-DDMFS-4x3-Step-03-84da6d1633d34f7385c63d504d321c83.jpg"
      ],
      "image": "assets/images/141716/step_04.webp"
    },
    {
      "text": "Cook on the preheated grill until the meat is no longer pink, 5 to 7 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BTEXE2w4VFGg5QjpN86zIQmUW2g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-141716-Korean-BBQ-Short-Ribs-Galbi-DDMFS-4x3-Step-04-22da206f80924acf94181b06e840e8fe.jpg"
