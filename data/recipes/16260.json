  "ingredients": [
    "1 teaspoon vegetable oil",
    "2 pounds boneless beef roast",
    "salt and pepper to taste",
    "1 onion, quartered",
    "16 baby carrots",
    "4 cloves garlic, minced",
    "2 tablespoons chopped fresh parsley",
    "1 (10.75 ounce) can condensed cream of mushroom soup"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add roast and sauté until well browned on all sides, about 15 minutes. Season with salt and pepper and turn off the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place onion, carrots, garlic, and parsley in the bottom of a slow cooker. Place the roast on top, then pour the soup over the roast and vegetables. Cover and cook on Low for 8 to 10 hours, stirring once.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer roast to a serving platter and arrange vegetables around it. Pour gravy from the slow cooker into a gravy boat.",
      "section": null,
      "name": null,
