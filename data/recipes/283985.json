  "ingredients": [
    "0.5 cup unsalted butter",
    "1 cup uncooked long grain rice",
    "3 cloves garlic, diced",
    "1 teaspoon salt",
    "2 cubes chicken bouillon",
    "2 cups boiling water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Melt butter in an oven-proof dish in the oven while it preheats, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove dish from the oven and add rice, garlic, and salt. Return to the oven for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve bouillon cubes in the boiling water, then add to the rice mixture. Return to the oven and bake, uncovered, until water is absorbed and rice is tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
