  "ingredients": [
    "oil for frying",
    "2 eggs, beaten",
    "0.25 cup milk",
    "1 tablespoon all-purpose flour",
    "0.5 (8 ounce) package panko bread crumbs",
    "0.5 cup seasoned bread crumbs",
    "1 pound halibut, cut into 2-inch squares"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, milk, and flour together in a shallow bowl. Stir panko bread crumbs and seasoned bread crumbs together in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently dip halibut into egg mixture, then press gently into bread crumbs to coat both sides. Place the breaded halibut, unstacked, onto a plate. Repeat with remaining halibut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lower halibut carefully into the hot oil in batches. Fry until golden brown and crisp on the outside, 4 to 5 minutes. Transfer to a paper towel-lined plate to drain. Repeat with remaining halibut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
