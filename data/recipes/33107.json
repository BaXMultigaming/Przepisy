  "ingredients": [
    "1 quart vegetable oil for frying",
    "2.25 cups all-purpose flour",
    "0.33333334326744 cup sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground mace",
    "0.5 teaspoon ground cinnamon",
    "0.75 cup milk",
    "0.25 cup canola oil",
    "1 egg, lightly beaten",
    "1 cup sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Heat oil in deep-fryer to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix flour, 1/3 cup sugar, baking powder, salt, mace and 1/2 teaspoon cinnamon. Create a well in the center of the mixture, and pour in milk, canola oil and egg. Thoroughly stir into the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In batches, drop the mixture by rounded teaspoonfuls into the hot oil. Fry on all sides, 2 to 4 minutes, until golden brown. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a resealable plastic bag, mix 1 cup sugar and 1 teaspoon cinnamon. While still warm, place balls a few at a time into the bag, and toss to coat.",
      "section": null,
      "name": null,
