  "ingredients": [
    "3 tablespoons olive oil",
    "2 cloves garlic, peeled and minced",
    "2 tablespoons tarragon vinegar",
    "0.5 teaspoon dried tarragon",
    "freshly ground black pepper to taste",
    "1.5 pounds fresh tuna steaks"
  ],
  "steps": [
    {
      "text": "In a medium bowl, whisk together olive oil, garlic, tarragon vinegar, dried tarragon and pepper. Place tuna steaks into the mixture. Cover and marinate in the refrigerator at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill tuna steaks 8 to 10 minutes per side, until the tuna flakes easily and is opaque in the center.",
