  "ingredients": [
    "1 (14.1 ounce) package ready-to-use refrigerated pie crusts",
    "2 small Granny Smith apples",
    "1 egg",
    "1 tablespoon water",
    "11 OREO Cookies, divided",
    "3 tablespoons powdered sugar"
  ],
  "steps": [
    {
      "text": "Heat oven to 375 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll 1 pie crust on work surface; use 4-inch cutter to cut into 9 rounds, re-rolling scraps as necessary. Repeat with remaining pastry crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Core apples; cut crosswise into a total of 9 rings. Whisk egg and water until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 9 pastry rounds in single layer on parchment-covered baking sheet; brush edges with egg. Top each with 1 each apple ring and cookie. Cover with remaining pastry rounds; press edges together to seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crush remaining cookies finely; sprinkle over pies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 18 to 22 min. or until golden brown. Cool completely. Dust with sugar just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
