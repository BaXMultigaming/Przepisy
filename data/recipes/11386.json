  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup butter flavored shortening",
    "1 cup white sugar",
    "1 medium banana, peeled and mashed",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "0.33333334326744 cup confectioners' sugar",
    "3 tablespoons unsalted butter, softened",
    "1 tablespoon milk, or more as needed",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the cookies: Combine flour, baking soda, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat shortening and white sugar in a bowl with an electric mixer until smooth. Beat in banana, eggs, and vanilla. Add dry ingredients and mix until combined; batter will be sticky. Drop rounded tablespoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, switching racks halfway through, until lightly browned, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the cookies are baking, make the glaze: Beat confectioners' sugar, butter, milk, and vanilla in a medium bowl until well combined. Add more milk as needed to attain a drizzling consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cookies from the oven and transfer to wire racks. Drizzle glaze over warm cookies, then let cool for 25 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
