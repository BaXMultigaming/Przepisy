  "ingredients": [
    "1 cup unsalted butter, at room temperature",
    "0.75 cup powdered sugar, divided, or more as needed",
    "0.25 cup fat-free sour cream",
    "2 tablespoons fat-free milk",
    "1 teaspoon vanilla extract",
    "2.25 cups all-purpose flour",
    "0.5 teaspoon salt",
    "1 pinch ground cinnamon",
    "1 cup chopped walnuts",
    "2 tablespoons sour cream, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, powdered sugar, sour cream, milk, and vanilla in a bowl. Add flour, salt, and cinnamon; mix well. Mix in walnuts. Roll into 1-inch balls and place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and immediately roll balls in remaining powdered sugar to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
