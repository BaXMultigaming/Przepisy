  "ingredients": [
    "2 cups all-purpose flour",
    "3 teaspoons ground cinnamon",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "0.25 teaspoon baking powder",
    "2 cups grated zucchini",
    "1.5 cups white sugar",
    "1 cup vegetable oil",
    "3 eggs, lightly beaten",
    "2 teaspoons vanilla extract",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cinnamon, baking soda, salt, and baking powder in a bowl. Mix zucchini, sugar, vegetable oil, eggs, and vanilla in a separate bowl. Add flour mixture to zucchini mixture and stir until just combined. Stir in walnuts, then pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
