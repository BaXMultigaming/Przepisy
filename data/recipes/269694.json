  "ingredients": [
    "1 pound ground beef",
    "0.25 cup Worcestershire sauce",
    "0.25 cup Italian bread crumbs",
    "0.5 tablespoon steak sauce (such as A.1.®)",
    "0.5 tablespoon liquid smoke flavoring",
    "4 slices sharp Cheddar cheese",
    "4 hamburger buns, split"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef, Worcestershire sauce, bread crumbs, steak sauce, and liquid smoke together in a bowl using your hands. Form mixture into 4 hamburger patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill burgers for 5 minutes on the preheated grill. Flip and grill to your desired degree of doneness, about 4 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove burgers from grill and cover each with a slice of Cheddar cheese. Allow to rest and serve on hamburger buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
