  "ingredients": [
    "0.25 cup butter",
    "1 cup coarsely chopped celery",
    "1 cup coarsely chopped onion",
    "2.5 cups Swanson® Chicken Broth",
    "1 (12 ounce) package Pepperidge Farm® Herb Seasoned Stuffing"
  ],
  "steps": [
    {
      "text": "Heat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the butter in a 3-quart saucepan over medium heat. Add the celery and onion and cook for 5 minutes or until tender-crisp, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add Swanson® Chicken Broth to the saucepan and heat to a boil. Remove the saucepan from the heat. Add the stuffing and mix lightly. Spoon the stuffing mixture into a greased 9x13x2-inch baking dish. Cover the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes or until the stuffing mixture is hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
