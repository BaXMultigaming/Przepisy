  "ingredients": [
    "1.5 pounds red potatoes, diced",
    "1 (16 ounce) package frozen corn",
    "3 tablespoons almond flour",
    "1 teaspoon dried thyme",
    "1 teaspoon dried oregano",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "salt and ground black pepper to taste",
    "6 cups chicken stock",
    "0.25 cup coconut milk",
    "2 tablespoons ghee (clarified butter)"
  ],
  "steps": [
    {
      "text": "Combine red potatoes, corn, almond flour, thyme, oregano, garlic powder, onion powder, salt, and pepper in a freezer bag. Freeze until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour frozen red potato mixture into a slow cooker. Add chicken stock, coconut milk, and ghee.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until potatoes are tender and flavors combine, about 8 hours.",
      "section": null,
