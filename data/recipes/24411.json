  "ingredients": [
    "0.75 cup butter",
    "1.3300000429153 cups all-purpose flour",
    "3 quarts seafood stock",
    "salt and pepper to taste",
    "1.5 pounds medium shrimp - peeled, deveined and shells reserved",
    "1 pound onions, minced",
    "0.25 cup tomato paste",
    "3 tablespoons paprika",
    "2 cloves garlic, minced",
    "3 fluid ounces brandy",
    "1 quart heavy cream, heated",
    "0.5 teaspoon Old Bay Seasoning TM",
    "3 dashes hot pepper sauce",
    "3 dashes Worcestershire sauce",
    "0.5 cup dry sherry"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tQEWQVpNIxHM8IxR5zShQ9b2pBc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24411-shrimp-bisque-ii-VAT-step-01-62503fdeafd043baa2a03b26dd4bdd96.jpg"
      ],
      "image": "assets/images/24411/step_01.webp"
    },
    {
      "text": "Melt 3/4 cup butter in a large saucepan over medium heat; stir in flour and cook until flour taste disappears, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xC-qnVdgRrlgIKoonFJPtlMuePw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24411-shrimp-bisque-ii-VAT-step-02-f5c4d8ccdd7c4ea3ad39b72e3bda3034.jpg"
      ],
      "image": "assets/images/24411/step_02.webp"
    },
    {
      "text": "Stir in seafood stock; season with salt and black pepper. Simmer 15 minutes, then remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yrFgFQ_YB-hlymVolVICC38EiE8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24411-shrimp-bisque-ii-VAT-step-03-cc6fcba41aa14c20b256bf5f8c9e4b51.jpg"
      ],
      "image": "assets/images/24411/step_03.webp"
    },
    {
      "text": "Melt remaining 1/4 cup butter in a separate large saucepan over medium heat. Add shrimp shells and onions; cook until onions are translucent. Stir in tomato paste, paprika, and garlic; cook until brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/idJOx4KzpCBmi9j3AhP_WYuWsbY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24411-shrimp-bisque-ii-VAT-step-04-02a111a5c6a540b08b928eab5f97c656.jpg"
      ],
      "image": "assets/images/24411/step_04.webp"
    },
    {
      "text": "Stir in brandy; light it on fire. Simmer until reduced and thickened. Stir in reserved stock mixture, reduce heat, and simmer 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Kr1dTYIWiOqfFT5C9aBjnE73Jp0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24411-shrimp-bisque-ii-VAT-step-05-424f1d1a2121435fb3e497c43f7756fe.jpg"
      ],
      "image": "assets/images/24411/step_05.webp"
    },
    {
      "text": "Strain stock mixture through a fine-mesh sieve or cheesecloth into a bowl; return it to the saucepan. Heat strained stock mixture to a simmer; add cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HMrGEvamvAGz_YgVGTkwPsTRxuk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24411-shrimp-bisque-ii-VAT-step-06-f677df158a8749afb607590cc9bfecea.jpg"
      ],
      "image": "assets/images/24411/step_06.webp"
    },
    {
      "text": "Dice shrimp; add to a medium skillet over medium heat and cook until opaque.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uhbvB8RW7deM87nc8TSLw0EEF6E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24411-shrimp-bisque-ii-VAT-step-07-a13548d855d348829678b4fc3c7e6988.jpg"
      ],
      "image": "assets/images/24411/step_07.webp"
    },
    {
      "text": "Stir into bisque; simmer 5 minutes. Season with Old Bay, pepper sauce, and Worcestershire sauce. Stir in sherry just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Tlfl1dD0kICq3FzflEx8ATxEdvc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24411-shrimp-bisque-ii-VAT-step-08-6971dcf7e61e44f1a886681570353975.jpg"
      ],
      "image": "assets/images/24411/step_08.webp"
    }
  ],
