  "ingredients": [
    "0.66666698455811 cup white sugar",
    "1 teaspoon salt",
    "0.33333298563957 cup butter, softened",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "0.75 cup cornmeal",
    "1.3333300352097 cups milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease an 8 inch skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat together sugar, salt, butter and vanilla until creamy. Stir in eggs one at a time, beating well after each addition. In a separate bowl, mix together flour, baking powder and cornmeal. Stir flour mixture into egg mixture alternately with the milk. Beat well until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 minutes, or until golden brown. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
