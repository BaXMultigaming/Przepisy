  "ingredients": [
    "4 slices bacon",
    "2 cups all-purpose flour",
    "3 teaspoons baking powder",
    "0.25 teaspoon baking soda",
    "2 tablespoons white sugar",
    "1 tablespoon wheat germ",
    "0.5 teaspoon salt",
    "2 eggs, beaten",
    "0.33300000429153 cup milk",
    "1 cup canned cream-style corn",
    "0.25 cup butter, melted",
    "0.25 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine flour, baking powder, baking soda, sugar, wheat germ and salt. In a separate bowl, combine eggs, milk, corn, butter, oil and bacon. Stir egg mixture into dry ingredients, just until combined. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 to 25, until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
