  "ingredients": [
    "2 egg whites",
    "2 teaspoons vanilla extract",
    "1 cup brown sugar",
    "1 cup white sugar",
    "0.5 teaspoon salt",
    "5 cups whole almonds",
    "1 tablespoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites and vanilla extract in a large bowl; add almonds and toss to coat. Stir brown sugar, white sugar, cinnamon, and salt into almonds until blended. Spread almond mixture into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring every 15 minutes, until coating is dry, about 1 hour and 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
