  "ingredients": [
    "1.5 cups unsifted all-purpose flour",
    "1.5 cups white sugar",
    "1 teaspoon baking soda",
    "0.75 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon ground ginger",
    "1 cup pumpkin puree",
    "0.5 cup vegetable oil",
    "2 eggs, beaten",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking soda, salt, cinnamon, nutmeg, cloves, baking powder, and ginger in a large bowl. Make a well in the center; add pumpkin purée, oil, and eggs. Stir well, then fold in walnuts. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 90 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
