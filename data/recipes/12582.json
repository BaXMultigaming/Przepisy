  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter and chocolate over low heat, stirring constantly, until chocolate is melted; cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With hand beater, beat eggs, sugar, salt, chocolate mixture and corn syrup. Stir in pecans and pour mixture into pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until set, 40 to 50 minutes. Cool slightly. Serve warm, or refrigerate and serve with nondairy whipped topping.",
