  "ingredients": [
    "1 recipe pastry for a 9 inch single crust pie",
    "0.33333298563957 cup butter",
    "2 (1 ounce) squares unsweetened chocolate",
    "3 eggs",
    "0.66666698455811 cup white sugar",
    "0.5 teaspoon salt",
    "1 cup light corn syrup",
    "1 cup pecan halves"
