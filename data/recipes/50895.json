  "ingredients": [
    "1.6666667461395 cups uncooked brown rice",
    "2.5 cups water",
    "1 cup low fat sour cream",
    "1 tablespoon red wine vinegar",
    "1 tablespoon fresh lime juice",
    "2 teaspoons honey",
    "0.5 teaspoon ground cumin",
    "0.25 teaspoon chili powder",
    "0.25 teaspoon salt",
    "0.125 teaspoon black pepper",
    "2 slices bacon",
    "1 cup diced red bell pepper",
    "1 cup chopped green onions",
    "0.5 cup frozen green peas, thawed",
    "0.25 cup toasted almond slices",
    "2 tablespoons chopped cilantro"
  ],
  "steps": [
    {
      "text": "Place rice and water in a medium saucepan, and bring to a boil. Reduce heat to low, cover, and simmer 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix the sour cream, red wine vinegar, lime juice, honey, cumin, chili powder, salt, and pepper. Refrigerate until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a skillet. Cook over medium high heat until evenly brown. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix the rice, dressing mixture, bacon, bell pepper, green onions, peas, almonds, and cilantro. Chill at least 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
