  "ingredients": [
    "2 pounds pork shoulder roast",
    "salt and ground black pepper to taste",
    "0.5 cup ketchup",
    "0.5 cup brown sugar",
    "0.33333334326744 cup red wine vinegar"
  ],
  "steps": [
    {
      "text": "Preheat a slow cooker on Low for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, season pork shoulder with salt and black pepper; set aside. Combine ketchup, brown sugar, and vinegar in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork in the preheated slow cooker; pour sauce over top. Cover the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pork to a large platter; slice into 3 to 4 pieces. Shred pork with 2 forks; return to the slow cooker. Cook on Low 1 hour more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
