  "ingredients": [
    "12 eggs",
    "0.5 cup butter, melted",
    "0.33300000429153 cup vegetable oil",
    "6 cups all-purpose flour",
    "1 tablespoon salt",
    "2 tablespoons coarsely ground black pepper",
    "3 tablespoons baking powder"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to boil over medium-high heat. Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat eggs. Stir in melted butter and oil. In a separate bowl, mix together flour, salt, pepper and baking powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make a well in the center of the flour mixture and pour in the egg mixture. Mix until dough pulls together. Turn dough out onto a lightly floured surface and knead briefly. Divide dough into 12 equal pieces. Roll each piece into an 8 inch long cylinder. Bend each cylinder into a ring shape and pinch ends together. With a sharp knife, score each ring around its outside edge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop rings two at a time into boiling water and boil for 1 minute. Remove rings from water and place on lightly greased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 minutes, until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
