  "ingredients": [
    "cooking spray",
    "1 (16 ounce) container BREAKSTONE'S or KNUDSEN Sour Cream",
    "1 (8 ounce) package PHILADELPHIA Cream Cheese, softened",
    "0.5 teaspoon ground black pepper",
    "4 cups milk",
    "1 (30 ounce) package ORE-IDA® Shredded Hash Brown Potatoes",
    "1 (8 ounce) package KRAFT Shredded Sharp Cheddar Cheese",
    "8 slices cooked OSCAR MAYER Bacon, crumbled",
    "4 green onions, thinly sliced"
  ],
  "steps": [
    {
      "text": "Spray a slow cooker with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sour cream, cream cheese, and pepper to the prepared slow cooker; stir to combine. Gradually stir in milk until combined. Add potatoes, cheese, and bacon; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low for 3 to 4 hours, or High for 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with onions before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
