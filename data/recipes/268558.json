  "ingredients": [
    "1 pound salmon fillet",
    "olive oil cooking spray",
    "sea salt and ground black pepper to taste",
    "1 teaspoon dried basil",
    "2.5 tablespoons crushed garlic, divided",
    "0.25 cup heavy cream",
    "25 leaves fresh spinach, or more to taste, divided",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon cayenne pepper",
    "0.25 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray salmon with olive oil and place in a baking dish. Season with sea salt, black pepper, basil, and 1 1/2 tablespoons crushed garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream, 12 spinach leaves, remaining crushed garlic, salt, black pepper, and cayenne pepper in a food processor. Blend until smooth and pour mixture over salmon in the baking dish. Cover with remaining spinach leaves and shredded mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and salmon flakes easily with a fork, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
