  "ingredients": [
    "2 cups semisweet chocolate chips",
    "1 cup raisins",
    "1 cup dry-roasted peanuts",
    "1 cup chow mein noodles"
  ],
  "steps": [
    {
      "text": "In a large microwave safe bowl, microwave chocolate chips on high power, stirring every 30 seconds until smooth and melted. Stir in the raisins, peanuts and chow mein noodles. Roll into walnut sized balls using your hands and set onto waxed paper to cool. Chill or let sit until hard. Enjoy!",
