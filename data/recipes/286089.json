  "ingredients": [
    "nonstick cooking spray",
    "1 cup white masa harina (corn flour)",
    "1 cup all-purpose flour",
    "0.5 cup cornmeal",
    "1 teaspoon cream of tartar",
    "1 teaspoon salt",
    "1 cup brown sugar",
    "0.5 cup unsalted butter, at room temperature",
    "1 large egg",
    "2 tablespoons milk",
    "1 cup dried blueberries",
    "0.25 cup white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray 2 baking sheets with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift corn flour, flour, cornmeal, cream of tartar, and salt together into a large bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter in a second bowl with an electric mixer until creamy, 2 to 3 minutes. Add egg and beat until well combined. Add dry ingredients and mix until just combined. Add milk and blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a medium cookie scoop, scoop out pieces of dough, shape into balls, and roll in white sugar. Place cookie balls 2 inches apart on the prepared baking sheets and flatten with the bottom of a glass.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the bottoms start to brown, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
