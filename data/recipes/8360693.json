  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup unsalted butter, softened",
    "2 tablespoons chopped fresh chives",
    "1 tablespoon poppy seeds",
    "0.5 tablespoon toasted sesame seeds",
    "0.5 tablespoon black sesame seeds",
    "0.5 teaspoon garlic salt",
    "0.5 teaspoon lemon zest"
  ],
  "steps": [
    {
      "text": "Beat together cream cheese and butter with an electric mixer on medium-high speed until well blended and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chives, poppy seeds, toasted and black sesame seeds, garlic salt, and lemon zest; beat at medium speed until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and chill in the refrigerator for 30 minutes or up to 1 day before serving.",
