  "ingredients": [
    "0.75 cup panko bread crumbs",
    "0.33333334326744 cup chopped fresh parsley",
    "0.25 cup chopped fresh dill",
    "0.25 cup chopped fresh chives",
    "1 tablespoon extra-virgin olive oil",
    "1 teaspoon finely grated lemon zest",
    "1 teaspoon sea salt",
    "0.25 teaspoon ground black pepper",
    "4 (6 ounce) halibut fillets"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a baking sheet with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine panko bread crumbs, parsley, dill, chives, extra-virgin olive oil, lemon zest, sea salt, and black pepper in a bowl. Taste and adjust with more salt if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse halibut fillets and pat dry with a paper towel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place halibut fillets onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Generously spoon the herbed crumbs over the fish, and lightly press crumb mixture onto each fillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crumb topping is lightly browned and fish flakes easily with a fork, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
