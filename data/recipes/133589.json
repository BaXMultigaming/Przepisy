  "ingredients": [
    "2 tablespoons olive oil",
    "1 (4 ounce) package sliced fresh mushrooms",
    "2 cloves garlic, chopped",
    "0.5 cup diced celery",
    "0.33333334326744 cup diced onion",
    "0.5 cup water",
    "1.5 cubes chicken bouillon",
    "2 (12 ounce) cans garbanzo beans, drained and rinsed",
    "1 egg",
    "2 teaspoons dried sage",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a glass baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the olive oil in a large skillet. Cook the mushrooms, garlic, celery, and onion in the olive oil 3 to 5 minutes. Add the water and bouillon; cook and stir until the bouillon is dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the garbanzo beans, egg, sage, salt, and pepper in a bowl. Mash together with your hands until thoroughly mixed; stir in the vegetable mixture; transfer to the prepared baking dish. Cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 30 minutes; remove the foil and bake uncovered another 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
