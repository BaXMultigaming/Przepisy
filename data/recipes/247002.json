  "steps": [
    {
      "text": "Heat oven to 375 degrees F. Grease 12-cup muffin pan; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, 1/3 cup melted butter and egg in bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 3/4 cup sugar, baking powder, salt and nutmeg in bowl. Add milk mixture; stir just until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into prepared pan. Bake 15-20 minutes or until toothpick inserted comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1/3 cup melted butter in bowl. Combine 1/2 cup sugar and cinnamon in another bowl. Remove muffins from pan; let stand 2 minutes on cooling rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip tops of warm muffins into melted butter, then into cinnamon sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve warm with Butter with Canola Oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
