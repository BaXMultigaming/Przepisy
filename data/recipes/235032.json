  "ingredients": [
    "1 pound ground beef (80% lean)",
    "2 cups fresh salsa",
    "1 teaspoon taco seasoning mix",
    "0.125 teaspoon ground black pepper",
    "1.5 cups hot water",
    "1.5 cups elbow macaroni",
    "1 cup milk",
    "1 (8 ounce) package processed cheese food (such as Velveeta®), cut into cubes",
    "4 ounces shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Heat a large, deep skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return skillet to heat. Stir salsa, taco seasoning mix, and black pepper into the beef; simmer the mixture until hot, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water, macaroni, and milk into the beef mixture; bring to a boil, reduce heat to medium-low, place a cover on the skillet, and simmer the mixture until the pasta is tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cheese food and Cheddar cheese into the pasta mixture; cook until the cheese melts completely, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
