  "ingredients": [
    "5 pounds potatoes, peeled and cubed",
    "1 cup sour cream",
    "0.5 cup butter",
    "0.5 cup grated Parmesan cheese",
    "6 ounces cream cheese, softened",
    "4 ounces extra-sharp Cheddar cheese, shredded",
    "4 stalks green onions, chopped",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the potatoes are cooking, preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain potatoes and return to the pot. Mash while hot. Add sour cream, butter, Parmesan cheese, cream cheese, Cheddar cheese, green onions, salt, and pepper; beat until well blended. Transfer to a 3-quart casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Serve piping hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
