  "ingredients": [
    "3 tablespoons butter, melted",
    "1 cup all-purpose flour",
    "0.25 teaspoon salt",
    "1 teaspoon baking powder",
    "0.5 cup milk",
    "1 cup white sugar",
    "1 tablespoon cornstarch",
    "1 cup boiling water",
    "3.5 cups fresh cherries, pitted",
    "0.75 cup white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cherries in the bottom of a 9-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 3/4 cup sugar, butter, flour, salt, baking powder, and milk together in a bowl. Spread dough over cherries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup sugar and cornstarch in a small bowl. Stir in boiling water. Pour mixture over dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Serve warm.",
