  "ingredients": [
    "1 (1 pound) salmon side, bones removed with pliers",
    "1 cup chicken broth",
    "2 tablespoons minced fresh ginger root",
    "2 tablespoons soy sauce",
    "1 tablespoon dried minced onion",
    "1 tablespoon mirin (Japanese sweet wine)",
    "1 tablespoon sesame oil"
  ],
  "steps": [
    {
      "text": "Quarter or halve salmon side; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chicken broth, ginger, soy sauce, minced onion, mirin, and sesame oil in a large, heavy pot over medium-high heat; bring to a boil, then reduce heat to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a steamer insert into the pot; arrange salmon in a single layer in the insert. Cover pot; steam, 5 to 7 minutes, checking for desired doneness. Transfer salmon to a platter; keep warm. Remove insert.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Boil broth mixture until reduced into a sauce consistency, 2 to 4 minutes; spoon over salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
