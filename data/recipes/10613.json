  "ingredients": [
    "5 pounds all-purpose flour",
    "4.5 cups brown sugar",
    "12 large eggs",
    "2 cups butter",
    "1 teaspoon vanilla extract",
    "1 teaspoon salt",
    "2 tablespoons whiskey"
  ],
  "steps": [
    {
      "text": "Beat butter and sugar together. Add eggs, one at a time, beating well after each addition. Beat in vanilla, salt, and whiskey.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour in small batches and mix by hand after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate dough overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly grease and heat the cookie iron over a gas burner set to medium heat. Roll about 1 tablespoon of dough into a small cigar-like shape. Place dough on the preheated iron and press together. Cook until golden, about 30 seconds per side. Remove cookie from the iron and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
