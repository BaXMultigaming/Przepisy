  "ingredients": [
    "2 pounds baking potatoes, each cut into six wedges",
    "2 tablespoons olive oil",
    "0.5 teaspoon dried thyme leaves",
    "0.25 teaspoon ground black pepper",
    "salt to taste",
    "0.25 cup shredded Cheddar cheese"
