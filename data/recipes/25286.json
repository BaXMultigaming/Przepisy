  "ingredients": [
    "0.5 cup uncooked long-grain rice",
    "6 slices bacon",
    "1 large onion, chopped",
    "1 (10 ounce) package chopped frozen broccoli, thawed",
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "1 cup milk",
    "1 (16 ounce) jar processed cheese sauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan bring 1 cup water to a boil. Add rice and stir. Reduce heat, cover and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside. Saute onions in bacon drippings over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 9x13 inch baking dish combine cooked rice, bacon, onions, broccoli, soup, milk and cheese sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
