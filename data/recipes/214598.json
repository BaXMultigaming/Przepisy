  "ingredients": [
    "10 slices white bread, cubed",
    "1 (15 ounce) can pumpkin puree",
    "6 eggs, beaten",
    "1 cup milk",
    "0.66666668653488 cup white sugar",
    "1 (5 ounce) can evaporated milk",
    "0.5 cup chopped pecans",
    "1 teaspoon ground cinnamon",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground nutmeg",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Coat a 9x13-inch baking dish with cooking spray; add bread cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin, eggs, milk, sugar, evaporated milk, pecans, cinnamon, vanilla, ginger, nutmeg, and salt in a bowl; pour over bread cubes. Cover the bowl with plastic wrap; refrigerate 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until pumpkin mixture is set and a toothpick inserted into center comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
