  "ingredients": [
    "2 cups shelled raw peanuts",
    "1.5 teaspoons peanut oil",
    "0.5 teaspoon white sugar",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spread peanuts on a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake peanuts, stirring every 2 minutes, until golden brown and fragrant, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine peanuts, peanut oil, sugar, and salt in a food processor fitted with a metal blade; process until peanuts are chopped and the mixture forms a ball, about 2 minutes. Scrape down the food processor bowl; continue processing to desired consistency, 1 to 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
