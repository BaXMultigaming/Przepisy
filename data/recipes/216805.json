  "ingredients": [
    "1 tablespoon olive oil",
    "2 teaspoons crushed garlic",
    "0.25 white onion, chopped",
    "1 pound trimmed Brussels sprouts",
    "salt and ground black pepper to taste",
    "1 pinch garlic powder, or to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bVgEAhT6QJY7f6sHWs2R0PscfwI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216805-pan-fried-brussels-sprouts-ddmfs-4x3-01-2769-60851a4fa3fd4743b50f81e115dc5fbd.jpg"
      ],
      "image": "assets/images/216805/step_01.webp"
    },
    {
      "text": "Heat olive oil in a cast-iron skillet over medium-low heat. Add garlic and stir until golden brown and fragrant, about 2 to 3 minutes. Add onion and cook until soft, stirring often, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VqciD2hdD4hLw3RpqbXSJw_q-z0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216805-pan-fried-brussels-sprouts-ddmfs-4x3-03-2772-bc6c8be356b848a3bfa64be78a9e26c3.jpg"
      ],
      "image": "assets/images/216805/step_02.webp"
    },
    {
      "text": "Add Brussels sprouts and cook until one side of the sprouts turns golden brown, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5BCBAI17s7iKnA1rw-5mN_F2rJA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216805-pan-fried-brussels-sprouts-ddmfs-4x3-05-2774-5c3215da07aa4dbf99b9ce62f3253be8.jpg"
      ],
      "image": "assets/images/216805/step_03.webp"
    },
    {
      "text": "Stir to turn sprouts over and cook until evenly golden brown, another 5 to 7 minutes. Season with salt, black pepper, and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gprxpQz4HiK1njIftKlyeF8qEtQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216805-pan-fried-brussels-sprouts-ddmfs-4x3-06-2775-20fc001064a64cd6a72beffd4c518e50.jpg"
