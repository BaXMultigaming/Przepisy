  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 (15 ounce) can black-eyed peas, rinsed and drained",
    "1 cup finely chopped red onion",
    "1 cup frozen corn",
    "1 cup cooked white rice, cold",
    "1.5 teaspoons chopped fresh thyme leaves",
    "0.5 teaspoon garlic salt",
    "0.125 teaspoon cayenne pepper",
    "2 cups lightly packed fresh spinach leaves"
  ],
  "steps": [
    {
      "text": "Heat a wok or 12-inch skillet over medium-high heat. Add oil and rotate wok or skillet to coat the sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add black-eyed peas, onion, corn, rice, thyme, garlic salt, and cayenne; stir-fry until heated through, 3 to 4 minutes. Add spinach and stir-fry until it begins to wilt, 1 to 2 minutes.",
