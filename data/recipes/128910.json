  "ingredients": [
    "2.5 cups olive oil",
    "0.75 cup tequila",
    "0.5 cup chopped fresh cilantro",
    "0.5 cup fresh lime juice",
    "0.5 cup pineapple juice",
    "0.25 cup white vinegar",
    "0.25 cup garlic salt",
    "0.25 cup ground black pepper",
    "1 tablespoon chopped fresh oregano",
    "1 teaspoon seasoned salt",
    "30 medium shrimp - peeled and deveined"
  ],
  "steps": [
    {
      "text": "Combine the olive oil, tequila, cilantro, lime juice, pineapple juice, vinegar, garlic salt, pepper, oregano, and seasoned salt in a blender; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the shrimp in a bowl and pour the olive oil mixture over the shrimp; toss to combine. Cover and allow to marinate in the refrigerator 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a skillet over medium heat. Cook and stir the shrimp in the skillet until cooked through, about 15 minutes.",
      "section": null,
