  "ingredients": [
    "1 cup butter",
    "1 clove garlic, minced",
    "0.25 teaspoon dried rosemary",
    "0.25 teaspoon dried basil",
    "3 tablespoons lemon juice",
    "2 tablespoons dry white wine",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 pounds medium shrimp, peeled and deveined",
    "6 12x12-inch squares of aluminum foil"
  ],
  "steps": [
    {
      "text": "Preheat grill for medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat; cook and stir garlic, rosemary, and basil in the hot butter until garlic is fragrant and beginning to brown, about 5 minutes. Stir lemon juice, white wine, salt, and black pepper into butter and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange about 6 shrimp onto each square of aluminum foil and drizzle the butter and herb mixture over shrimp. Gather up the corners of the foil squares and twist the tops to form tight packets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill the packets on the preheated grill until shrimp are opaque and pink, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
