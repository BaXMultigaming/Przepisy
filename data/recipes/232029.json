  "ingredients": [
    "0.5 cup teriyaki sauce",
    "0.33333334326744 cup brown sugar",
    "3 tablespoons minced fresh ginger root",
    "18 slices bacon, halved crosswise",
    "12 large sea scallops, cut into thirds",
    "36 toothpicks"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line 2 baking sheets with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk teriyaki sauce, brown sugar, and ginger together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap each scallop piece with 1 half-strip bacon; secure with a toothpick. Dip bacon-wrapped scallops in teriyaki mixture; arrange on one of the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until lightly charred, about 6 minutes. Flip scallops; transfer to the clean baking sheet. Broil until bacon is charred on second side, about 6 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
