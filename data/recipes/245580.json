  "ingredients": [
    "7 Granny Smith apples",
    "0.75 cup white sugar",
    "2 tablespoons butter, softened",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "3 tablespoons all-purpose flour",
    "2 (9 inch) frozen deep-dish pie crusts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel, core, and halve apples. Cut into 1/2-inch slices, then slice into 1/2-inch cubes. Combine sugar, butter, cinnamon, nutmeg, and salt together in a large bowl; add apples and toss to coat evenly. Add flour and toss again to distribute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour apple mixture into 1 pie crust. Roll out 2nd pie crust, top pie, and pinch crust edges together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pie on baking sheet and bake in the preheated oven until golden brown, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
