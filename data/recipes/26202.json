  "ingredients": [
    "0.5 cup butter, softened",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "0.33300000429153 cup peanut butter",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup rolled oats",
    "1 cup semisweet chocolate chips",
    "0.5 cup confectioners' sugar",
    "0.25 cup peanut butter",
    "3 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, and brown sugar together in a large bowl until smooth. Beat in ⅓ cup peanut butter, egg, and vanilla. Whisk flour, baking soda, and salt together in a separate bowl; stir into peanut butter mixture. Mix in rolled oats; spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are firm, 20 to 25 minutes. Remove from oven; sprinkle chocolate chips over top, let stand for 5 minutes, then spread to cover and let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine confectioners' sugar and ¼ cup peanut butter in a small bowl until smooth. Stir in milk, 1 tablespoon at a time, until reaches drizzling consistency. Drizzle over chocolate layer; cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
