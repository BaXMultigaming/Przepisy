  "ingredients": [
    "1.5 cups shredded Cheddar cheese",
    "4 eggs",
    "1 cup heavy cream",
    "1 cup milk",
    "3 drops hot sauce",
    "0.25 teaspoon salt",
    "0.25 teaspoon pepper",
    "0.25 teaspoon paprika",
    "1 (9 inch) unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Spread shredded cheese in the bottom of pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine eggs, cream and milk. Season with hot sauce, salt, pepper and paprika. Pour filling over shredded cheese in the pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 to 50 minutes, or until golden brown. Cool 10 minutes before serving.",
      "section": null,
