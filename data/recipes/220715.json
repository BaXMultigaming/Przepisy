  "ingredients": [
    "2 cups vegetable oil for frying, or as needed",
    "1 cup milk",
    "2 eggs",
    "1.5 cups biscuit mix",
    "0.5 cup grated Parmesan cheese",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 bunch fresh asparagus, trimmed"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and eggs together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir biscuit mix, Parmesan cheese, salt, and black pepper together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip asparagus into milk mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll and coat asparagus in dry ingredient mixture. Repeat with a second layer for each asparagus.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully place coated asparagus in the hot oil; fry until golden brown, 2 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
