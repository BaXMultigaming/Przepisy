  "ingredients": [
    "2 tablespoons butter",
    "2 tablespoons chopped onion",
    "1 (16 ounce) package frozen chopped spinach, thawed and drained",
    "3 eggs",
    "1.5 cups heavy cream",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon ground nutmeg",
    "0.5 cup shredded Swiss cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Spray a 9 inch pie pan with non-stick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 2 tablespoons butter in a large saucepan over medium-high heat. Add onions and cook, stirring occasionally, until onions are soft. Squeeze extra water out of the spinach and add the spinach to the skillet. Continue cooking until the spinach is heated through and the extra water evaporates. Spoon mixture into pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat together eggs and cream. Stir in salt, pepper and nutmeg. Pour into pie pan, top with shredded Swiss cheese. dot with remaining 1 tablespoon of butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 25 to 30 minutes until set and golden brown. Cool 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
