  "ingredients": [
    "1.5 pounds turnips",
    "2 tablespoons olive oil",
    "0.5 teaspoon dried thyme",
    "salt and freshly ground black pepper to taste",
    "chopped fresh parsley for garnish (optional)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel and trim turnips. Then cut into 1-1/4 inch pieces and place into a bowl. Drizzle with olive oil and season with thyme, salt, and pepper; toss until turnips are well coated. Spread out in 1 layer on a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast for 15 minutes. Turn and roast until fork-tender and lightly browned, 10 to 15 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
