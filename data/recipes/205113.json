  "ingredients": [
    "2.5 cups all-purpose flour, or as needed",
    "0.75 teaspoon salt",
    "1 envelope Fleischmann's® RapidRise Yeast*",
    "1 cup very warm water (120 degrees F to 130 degrees F)",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Combine 2 cups flour, salt, and yeast in a large bowl. Stir in very warm water and oil until combined, then stir in just enough of remaining 1/2 cup flour to make a soft dough. Knead on a lightly floured surface until smooth and elastic, 4 to 6 minutes. Cover and let rest for 10 minutes.",
