  "ingredients": [
    "0.5 cup firmly packed brown sugar",
    "0.5 cup honey",
    "1 cup peanut butter",
    "1 teaspoon vanilla extract",
    "1.5 cups quick-cooking rolled oats",
    "1.5 cups crispy rice cereal",
    "1 cup raisins",
    "0.5 cup shredded coconut",
    "0.5 cup sunflower seeds"
  ],
  "steps": [
    {
      "text": "Lightly grease an 8-inch glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring brown sugar and honey to a boil in a saucepan, stirring constantly. Remove from heat and stir peanut butter and vanilla into the sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, rice cereal, raisins, coconut, and sunflower nuts in a large bowl; add peanut butter mixture and blend. Press mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool mixture completely before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
