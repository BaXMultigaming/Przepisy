  "ingredients": [
    "1 serving cooking spray",
    "3 tablespoons olive oil",
    "2 tablespoons minced garlic",
    "0.5 cup brown sugar",
    "4 bone-in chicken breast halves",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking dish with aluminum foil and lightly coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil and garlic in a small saucepan over medium heat; saute until fragrant, about 2 minutes. Reduce heat, add brown sugar, and stir until liquid, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay chicken breasts in the prepared baking dish and pour brown sugar sauce over top. Sprinkle with black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink at the bone and the juices run clear, about 30 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
