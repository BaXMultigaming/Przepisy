  "ingredients": [
    "1 pound uncooked medium shrimp, peeled and deveined",
    "0.5 cup Italian-style salad dressing",
    "0.5 cup lime juice",
    "2 medium red bell peppers, chopped",
    "1 medium onion, finely chopped",
    "1 stalk celery, chopped",
    "1 tablespoon chopped fresh cilantro",
    "1 pound romaine lettuce, torn"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill shrimp until they are bright pink on the outside and the meat is opaque, about 2 minutes per side. Let cool 10 minutes and transfer to a non-metal bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour Italian dressing and lime juice over cooled shrimp and toss to coat. Add red bell peppers, onion, celery, and cilantro; mix lightly. Cover and refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place lettuce on a serving plate. Top with shrimp mixture and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
