  "ingredients": [
    "5 cups all-purpose flour",
    "1.5 cups white sugar",
    "2.6666667461395 tablespoons baking powder",
    "2 eggs",
    "2 cups milk",
    "2 cups raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a 12-inch cast iron skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sugar, and baking powder together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs with milk in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir egg mixture into flour mixture until moistened; batter will be very thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold in raisins until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter into prepared cast iron skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
