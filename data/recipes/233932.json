  "ingredients": [
    "0.25 cup butter",
    "0.25 cup white wine",
    "1 tablespoon lemon juice",
    "1 tablespoon dried dill weed",
    "1 teaspoon white sugar",
    "salt and ground black pepper to taste",
    "4 salmon fillets"
  ],
  "steps": [
    {
      "text": "Combine butter, wine, lemon juice, dill, sugar, salt, and black pepper together in a microwave-safe casserole dish; place cover on dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave butter mixture until butter is melted, 45 to 60 seconds. Add salmon, skin-side up, to butter mixture and place cover on dish. Microwave until salmon flakes easily with a fork, about 6 minutes.",
