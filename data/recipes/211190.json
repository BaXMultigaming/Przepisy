  "ingredients": [
    "0.33333334326744 cup soy sauce",
    "0.33333334326744 cup brown sugar",
    "2 tablespoons lime juice",
    "2 tablespoons orange juice",
    "1 tablespoon Thai-style sweet chili sauce",
    "1 teaspoon chile-garlic sauce (such as Sriracha®)",
    "3 cloves garlic, minced",
    "0.25 teaspoon curry powder",
    "4 skinless, boneless chicken thighs"
  ],
  "steps": [
    {
      "text": "Place the soy sauce, brown sugar, lime juice, orange juice, sweet chili sauce, chili-garlic sauce, garlic, and curry powder in a large plastic zipper bag. Seal and knead the bag with your fingers to mix all the ingredients and dissolve the sugar. Place the chicken thighs into the marinade, squeeze out the air from the bag, zip the bag closed, and refrigerate for 4 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-low heat; lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the chicken from the bag, pour the excess marinade into a small saucepan, and bring to a full boil for about 1 minute to sterilize the marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill the chicken thighs until they are no longer pink in the middle and show grill marks, about 25 minutes, basting them generously with the sterilized marinade as they grill.",
      "section": null,
      "name": null,
      "url": null,
