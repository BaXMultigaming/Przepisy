  "ingredients": [
    "0.5 teaspoon ground paprika",
    "0.5 teaspoon salt",
    "0.25 teaspoon pepper",
    "2 large eggs",
    "1 cup Italian seasoned bread crumbs",
    "3 large boneless, skinless chicken breasts, cut into 2-inch pieces",
    "0.5 cup white sugar",
    "0.5 cup lemon juice",
    "1.5 teaspoons curry powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a rimmed baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir paprika, salt, and pepper together in a small bowl. Beat eggs in another bowl. Place bread crumbs in a third bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle seasoning over chicken pieces. Dip pieces in beaten egg, then dredge in bread crumbs. Arrange chicken pieces in a single layer on the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes, turning halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stir sugar, lemon juice, and curry powder together in a small saucepan over medium-low heat. Cook and stir until sugar dissolves, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "After chicken has cooked for 15 minutes, remove from the oven and drizzle lemon sauce over top. Return to the oven and bake for 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
