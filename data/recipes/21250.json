  "ingredients": [
    "1 pound elbow macaroni",
    "2 tablespoons olive oil",
    "2 onions, chopped",
    "salt and pepper to taste",
    "1 (15 ounce) can tomato sauce",
    "2 cups water",
    "1 (15 ounce) can peas",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While pasta water is boiling, heat olive oil in a large skillet over medium heat. Cook onions in oil until tender. Stir in salt, pepper, tomato sauce, water and peas. Reduce heat and simmer until pasta is done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cooked pasta into tomato mixture. Increase heat and bring to a boil briefly. Remove from heat, stir in cheese, cover and let rest 10 minutes. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
