  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "2 tablespoons white sugar",
    "0.5 teaspoon salt",
    "2 egg whites",
    "2 egg yolks",
    "2 tablespoons grated lemon zest",
    "1 teaspoon vanilla extract",
    "2 cups milk",
    "6 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk the flour, baking powder, sugar, and salt together in a mixing bowl; set aside. Beat egg whites until foamy in a separate large glass or metal mixing bowl. Whisk the egg yolks, lemon zest, and vanilla extract together in a third bowl; whisk in the milk. Stir in the flour mixture until smooth. Fold in the melted butter and then the beaten egg whites until just incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook the waffles according to manufacturer's instructions until golden brown.",
      "section": null,
      "name": null,
      "url": null,
