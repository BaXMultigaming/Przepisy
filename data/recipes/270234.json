  "ingredients": [
    "1 tablespoon olive oil",
    "1 stalk celery, diced",
    "1 shallot, diced",
    "1 teaspoon fresh ginger, peeled and smashed",
    "1 clove garlic, smashed",
    "1.25 pounds purple carrots, sliced",
    "0.5 pound potatoes, diced",
    "5 cups vegetable broth, divided",
    "4 tablespoons sour cream",
    "4 tablespoons chopped pistachio nuts"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat. Add celery, shallot, ginger, and garlic. Cook until fragrant, about 5 minutes. Add carrots, potatoes, and 3 cups broth. Bring to a boil, reduce heat, and simmer until vegetables are soft, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée soup with an immersion blender until smooth, adding enough remaining 2 cups broth to reach desired consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with sour cream and pistachios.",
