  "ingredients": [
    "2 tablespoons Italian seasoning",
    "1 tablespoon chopped fresh basil",
    "1 tablespoon paprika",
    "1 tablespoon ground black pepper",
    "0.25 cup olive oil",
    "1 yellow squash, sliced into 8 rounds",
    "1 zucchini, sliced into 8 rounds",
    "12 pearl onions",
    "2 Roma tomatoes, each sliced into quarters",
    "4 skewers, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Italian seasoning, basil, paprika, and black pepper in a large bowl. Add olive oil and stir until well combined. Add squash, zucchini, onions, and tomatoes; stir until evenly coated. Set aside to marinate for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slide vegetables onto the skewers, alternating the different types as you go.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook skewers on the bottom rack of the preheated grill, turning every 2 minutes, until vegetables are tender, 6 to 8 minutes total.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
