  "ingredients": [
    "1.5 pounds sweet onions, peeled and cut into wedges",
    "1 pound tomatoes, cored and quartered",
    "1 pound carrots, cut into 1-inch pieces",
    "1 pound green bell pepper, cut into 1-inch pieces",
    "0.5 pound turnips, cubed",
    "2 tablespoons olive oil",
    "1 pound celery, cut into 1-inch pieces",
    "1 bunch fresh parsley, chopped",
    "3 cloves garlic",
    "6 whole black peppercorns",
    "3 whole cloves",
    "1 bay leaf",
    "1 gallon water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place onions, tomatoes, carrots, bell peppers, and turnips in a large roasting pan; drizzle with olive oil and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DitayNJqpiaElf7-NBNUeZ-PAVw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14033-worlds-greatest-vegtable-broth-ddmfs-Step1-1450-4x3-a9f51ab4c74b441ab3da868959ea8291.jpg"
      ],
      "image": "assets/images/14033/step_02.webp"
    },
    {
      "text": "Roast in the preheated oven, stirring every 15 minutes, until vegetables are tender and onions are caramelized, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eo4-nYnnPO2OHimeW7yq5M3fP7U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14033-worlds-greatest-vegtable-broth-ddmfs-Step2-1479-4x3-3bc255b60bc34f14b83b3c3929603f4c.jpg"
      ],
      "image": "assets/images/14033/step_03.webp"
    },
    {
      "text": "Transfer roasted vegetables into a large stockpot. Add celery, parsley, garlic, peppercorns, cloves, and bay leaf. Pour in water and bring to a boil over high heat. Reduce heat to medium-low and simmer, uncovered, until liquid is reduced by half, 20 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6gfQ6QUOk0rnFLlxB9fan2lvsWo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14033-worlds-greatest-vegtable-broth-ddmfs-Step2-1512-4x3-4934dcc7c24c4beebb0b86aa8cde92a5.jpg"
      ],
      "image": "assets/images/14033/step_04.webp"
    },
    {
      "text": "Strain broth into a large bowl, reserving vegetables for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qobhASfvGnCzXuQE0eeRs7dpIZ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14033-worlds-greatest-vegtable-broth-ddmfs-Step3-1517-4x3-c07911d165194a80b40777326e383949.jpg"
      ],
      "image": "assets/images/14033/step_05.webp"
    }
  ],
