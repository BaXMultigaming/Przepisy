  "title": "World's Greatest Vegetable Broth",
  "description": "This vegan broth is made with caramelized roasted vegetables, fresh parsley, garlic, and black peppercorns for 2 quarts of broth with terrific flavor.",
  "authors": [
    "Tom West"
  ],
  "date_published": "1999-08-18T17:42:43-04:00",
