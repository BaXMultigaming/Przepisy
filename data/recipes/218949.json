  "ingredients": [
    "1 cup white sugar",
    "0.5 cup water",
    "2 cups vegetable shortening",
    "1 cup vegetable oil",
    "1 teaspoon clear vanilla extract",
    "8 cups confectioners' sugar",
    "1 tablespoon water, or more as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WZjgEftbd7wxtqQiFfv4Xn_EC8I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218949-holland-cream-white-cream-filling-ddmfs-step-1-BG-3115-92eb9d8958664e22bc001b162aa7805c.jpg"
      ],
      "image": "assets/images/218949/step_01.webp"
    },
    {
      "text": "Stir sugar and 1/2 cup water together in a saucepan over medium heat until sugar has dissolved and mixture comes to a boil. Remove from the heat and let cool completely, 15 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g6OHfQvQDl6kHHPMMknO9bqoS2c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218949-holland-cream-white-cream-filling-ddmfs-step-2-BG-3120-d2118b0e01da457e84b7f9875640c1f6.jpg"
      ],
      "image": "assets/images/218949/step_02.webp"
    },
    {
      "text": "Pour cooled syrup into a large mixing bowl. Add shortening, oil, and vanilla; beat with an electric mixer on high speed until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aQkvHDwVrDQxgv8QnIJ4ZrahZyI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218949-holland-cream-white-cream-filling-ddmfs-step-3-BG-3124-603cf3a75e2544398731a3e0932c9854.jpg"
      ],
      "image": "assets/images/218949/step_03.webp"
    },
    {
      "text": "Beat in confectioners' sugar, 1 cup at a time, until filling is thick and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XWxrWFntZfp-p9TaUOKgu8T-3Oo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218949-holland-cream-white-cream-filling-ddmfs-step-4-BG-3126-c6ce2ffefd7b4b3ebc97f978858d6ab8.jpg"
      ],
      "image": "assets/images/218949/step_04.webp"
    },
    {
      "text": "Mix in water, 1 tablespoon at a time, if filling is too thick.",
      "section": null,
      "name": null,
      "url": null,
