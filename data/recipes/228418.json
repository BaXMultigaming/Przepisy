    },
    {
      "text": "Mix balsamic vinegar with brown sugar in a saucepan over medium heat, stirring constantly until sugar has dissolved. Bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7E43dtf4GyhEXDbiCb9Kvw3H4Gg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228418-balsamic-glaze-ddmfs-step-2-c058cf3a462f41d7997c45469ee33846.jpg"
      ],
      "image": "assets/images/228418/step_02.webp"
    },
    {
      "text": "Reduce heat to low and simmer until glaze is reduced by half and coats the back of a spoon, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dr_07NOm9fg4_zUUm4jVcgM_AGo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228418-balsamic-glaze-ddmfs-step-3-555ac43f06614fd5b588090706490141.jpg"
      ],
      "image": "assets/images/228418/step_03.webp"
    },
    {
      "text": "Let cool, then pour into a lidded jar. Seal and store in the refrigerator.",
