  "ingredients": [
    "0.5 cup butter",
    "0.5 cup lard",
    "1.5 cups white sugar",
    "2 eggs",
    "3 tablespoons sour cream",
    "0.5 teaspoon baking soda",
    "3 cups sifted all-purpose flour",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Cream butter, lard and sugar. Add eggs and beat. Mix sour cream and baking soda together and add to egg mixture. Add flour and salt and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill dough until firm enough to roll.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out dough and cut with cookie cutter. It's wise to keep dough in refrigerator between rolling out batches. Bake for 5 - 7 minutes.",
