  "ingredients": [
    "1 (17.5 ounce) package frozen puff pastry, thawed",
    "7 large eggs, beaten",
    "2 cups chopped fresh baby spinach",
    "0.66666668653488 cup milk",
    "0.5 cup ricotta cheese",
    "0.33333334326744 cup freshly shredded Parmesan cheese",
    "0.25 cup shredded mozzarella cheese",
    "3 tablespoons shredded fontina cheese",
    "0.25 teaspoon kosher salt",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each puff pastry sheet into 9 squares. Roll each square to fit individual 3-inch pie pans. Set puff pastry inside pie pans and place on a rimmed baking sheet. Pour a small amount of ceramic beads into each pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whip together eggs, spinach, milk, ricotta cheese, Parmesan cheese, mozzarella cheese, fontina cheese, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pie pans from the oven and remove the ceramic beads. Ladle egg mixture into each pie tin. Bake until light golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
