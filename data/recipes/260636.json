  "ingredients": [
    "2 tablespoons sultana raisins",
    "1 tablespoon brown sugar",
    "2 sheets puff pastry",
    "2 small apples, peeled and cored",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 320 degrees F (160 degrees C). Line the air fryer basket with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix raisins and sugar together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 puff pastry sheet on a work surface; put one apple in center of pastry. Fill core with 1/2 of the raisin mixture. Fold pastry around apple to fully cover. Repeat with remaining apple, remaining pastry, and remaining 1/2 of the raisin mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer dumplings to the prepared basket; brush with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until pastry is golden and apples are tender, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
