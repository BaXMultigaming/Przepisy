  "ingredients": [
    "1 pound salmon fillets or steaks",
    "0.25 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 teaspoon onion powder",
    "1 teaspoon dried dill weed",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
