  "ingredients": [
    "1 pound ground bison",
    "1 teaspoon ground cumin",
    "1 teaspoon dried oregano",
    "0.5 teaspoon ground thyme",
    "0.25 teaspoon ground dried chipotle pepper",
    "0.75 cup portobello mushrooms",
    "0.5 cup shredded Cheddar cheese",
    "0.25 cup finely chopped onion",
    "salt and ground black pepper to taste",
    "4 whole wheat hamburger buns, split and toasted"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bison, cumin, oregano, thyme, and chipotle in a bowl. Add mushrooms, Cheddar cheese, and onion; mix until well distributed. Season with salt and pepper. Divide mixture evenly into 4 sections and shape into patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place patties on grill and reduce heat slightly. Grill until browned, 3 to 4 minutes. Flip over and grill until other side is browned, 3 to 4 minutes more. Serve on toasted whole wheat buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
