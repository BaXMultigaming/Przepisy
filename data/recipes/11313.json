  "ingredients": [
    "0.5 cup butter",
    "0.66666698455811 cup white sugar",
    "1 egg",
    "1 teaspoon lime extract",
    "0.5 cup cornmeal",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 cup all-purpose flour",
    "0.25 cup white sugar",
    "1 teaspoon grated lime zest",
    "0.33333298563957 cup confectioners' sugar for decoration",
    "1 tablespoon lime juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease your baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the butter and 2/3 cup sugar together until creamy. Mix in the egg and lime extract. Blend well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, combine the cornmeal, baking powder, salt and flour. Add the flour mixture to the butter mixture and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop teaspoonfuls of the dough onto the prepared baking sheets. Dip the bottom of a glass, or similar round, flat object in the 1/4 cup sugar, and slightly flatten the balls of dough. Bake at 375 degrees F (190 degrees C) for 10 to 12 minutes or until cookie bottoms are lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Icing: Combine the lime zest, confectioners' sugar, and enough lime juice to make a spreadable glaze. Spread over the tops of cooled cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
