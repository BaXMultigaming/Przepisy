  "ingredients": [
    "0.5 cup packed brown sugar",
    "0.5 cup white sugar",
    "0.5 cup unsalted butter, softened",
    "1 large egg",
    "1 tablespoon brandy",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "1 cup dried cranberries",
    "0.75 cup white chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 2 cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, white sugar, and butter with an electric mixer in a large bowl until creamy. Add egg and brandy and beat until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/U78CLVCBwWVyoHPIgXpveJCNop8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10917-white-chocolate-and-cranberry-cookies-mfs-step-1-005--e8b36eb9f4b447b99b83fcadaea34513.jpg"
      ],
      "image": "assets/images/10917/step_02.webp"
    },
    {
      "text": "Combine flour and baking soda in a separate bowl. Stir flour mixture into the butter mixture until just combined. Fold in cranberries and white chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C34SNtY3uc1S7HgJPomCF6ggy7M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10917-white-chocolate-and-cranberry-cookies-mfs-step-2-007--baad9973d5284cbbaf565b4bda11915d.jpg"
      ],
      "image": "assets/images/10917/step_03.webp"
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TdpaS_4gLHIwwxD7yEmx0OahykA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10917-white-chocolate-and-cranberry-cookies-mfs-step-3-008-1-92bd53a458ac45d29719204b96738f26.jpg"
      ],
      "image": "assets/images/10917/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 8 to 10 minutes, switching racks halfway through; cookies will still appear slightly doughy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool briefly on the cookie sheets before transferring to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D_ejVnjgXc0f4LnuAjAzR7Kx0_o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10917-white-chocolate-and-cranberry-cookies-mfs-step-4-010--e5eb7a6c267e41f7b88c08607c6eff19.jpg"
      ],
      "image": "assets/images/10917/step_06.webp"
    }
