  "ingredients": [
    "2 cups whole milk",
    "8 ounces sour cream",
    "1 (8 ounce) container frozen whipped topping, thawed",
    "1 (5 ounce) package instant vanilla pudding mix",
    "1 (16 ounce) package vanilla wafer cookies",
    "4 medium bananas, peeled and sliced"
  ],
  "steps": [
