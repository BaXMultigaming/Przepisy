  "ingredients": [
    "2 cups baking mix (such as Bisquick®)",
    "0.5 cup applesauce",
    "0.5 cup white sugar, divided",
    "0.25 cup milk",
    "1 large egg",
    "2 tablespoons vegetable oil",
    "1.25 teaspoons ground cinnamon, divided",
    "2 tablespoons unsalted butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 30 mini muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine baking mix, applesauce, ¼ cup sugar, milk, egg, oil, and 1 teaspoon cinnamon in a bowl until just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each ¾ full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place melted butter in a shallow bowl. Combine remaining ½ cup sugar and remaining ¼ teaspoon cinnamon in a separate shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip warm puffs in melted butter, then roll in cinnamon-sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
