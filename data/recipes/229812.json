  "ingredients": [
    "1.5 pounds Brussels sprouts, trimmed",
    "2 tablespoons olive oil",
    "1 onion, thinly sliced",
    "2 cloves garlic, minced",
    "0.25 cup balsamic vinegar",
    "2 tablespoons butter",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add Brussels sprouts and cook until slightly tender, about 2 minutes. Drain and immediately immerse in ice water for several minutes to stop the cooking process. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium heat; cook and stir onion and garlic in the hot oil until onion is just tender, 5 to 10 minutes. Add Brussels sprouts; cook and stir until sprouts are tender, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix balsamic vinegar, butter, salt, black pepper, and garlic powder into Brussels sprouts mixture; toss to coat.",
      "section": null,
