  "ingredients": [
    "6 slices Farmland® Thick Cut Bacon",
    "1 package Farmland® Cubed Ham",
    "0.5 cup red peppers, roasted, sliced",
    "0.5 cup corn",
    "1 quart-size canning jar",
    "8 cherry tomatoes, halved",
    "1 ounce Monterey Jack cheese, shredded",
    "2 cups mixed salad greens",
    "0.25 cup crispy tortilla strips",
    "0.25 cup salsa"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in a large skillet over medium-high heat until crisp. Drain on a paper-towel lined plate. Crumble when cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, spread ham, peppers, and corn in separate sections on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 10 minutes, tossing halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer corn in bottom of Mason jar; top with cherry tomatoes, ham, bell peppers, cheese, and mixed greens. Top with bacon and tortilla strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
