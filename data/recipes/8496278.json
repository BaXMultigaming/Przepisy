  "ingredients": [
    "0.25 cup freshly squeezed lemon juice",
    "3 large cloves garlic, finely grated",
    "2 tablespoons canola oil",
    "2 tablespoons chopped fresh rosemary",
    "2.5 teaspoons kosher salt",
    "2 teaspoons freshly ground black pepper",
    "2 teaspoons Dijon mustard",
    "2 (10 ounce) skinless, boneless chicken breasts",
    "lemon wedges for serving"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C-agYdk3HCncIYezPhSP15FgLe8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8496278-grilled-lemon-pepper-chicken-mfs-step-1-4279d9edfb134340a902cc1876e6c298.jpg"
      ],
      "image": "assets/images/8496278/step_01.webp"
    },
    {
      "text": "Stir lemon juice, garlic, oil, rosemary, salt, pepper, and mustard together in a bowl until well combined. Using a fork, prick each chicken breast all over 8 to 10 times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/axPQutaJNR8iCCynv8lXCU9uyIE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8496278-grilled-lemon-pepper-chicken-mfs-step-2-f7313b75c56949e3ba6991924292b71e.jpg"
      ],
      "image": "assets/images/8496278/step_02.webp"
    },
    {
      "text": "Add chicken breasts to bowl with lemon juice mixture and toss to coat completely, using your hands to gently massage lemon juice mixture into each chicken breast. Cover bowl with plastic wrap and refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KsZmc2vU_OUNvjyjabjP4y783uc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8496278-grilled-lemon-pepper-chicken-mfs-step-3-83aef542e6fd4f1fb4a538a5ef47866e.jpg"
      ],
      "image": "assets/images/8496278/step_03.webp"
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken breasts on oiled grates; grill, covered, until chicken breasts are lightly charred, no longer pink in the center and the juices run clear, 10 to 12 minutes per side. An instant-read thermometer inserted into the center should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QTnjV_UzF7LbvddeM0BZWoGFb5M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8496278-grilled-lemon-pepper-chicken-mfs-step-4-00ac716a493e4e6dbddae0ff559ffde2.jpg"
      ],
      "image": "assets/images/8496278/step_05.webp"
    },
    {
      "text": "Transfer chicken breasts to serving platter; serve with lemon wedges.",
      "section": null,
      "name": null,
