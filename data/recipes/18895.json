  "ingredients": [
    "1 (15 ounce) can cream-style corn",
    "1 (11 ounce) can whole niblet style corn",
    "1 (8.5 ounce) package dry corn bread mix",
    "1 cup sour cream",
    "0.5 cup butter, melted",
    "2 eggs",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8 x12-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream corn, niblet corn, cornbread mix, sour cream, butter, and eggs, in a large bowl. Pour into the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle cheese over top; continue baking until center is firm, about 15 minutes more.",
      "section": null,
