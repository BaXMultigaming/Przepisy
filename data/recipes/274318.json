  "ingredients": [
    "cooking spray",
    "1 cup butter, melted",
    "0.5 cup corn syrup",
    "2 tablespoons corn syrup",
    "0.33333334326744 cup brown sugar",
    "1 teaspoon vanilla extract",
    "4 cups quick cooking oats",
    "0.5 cup chopped strawberries",
    "0.25 cup white chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 13x9-inch glass baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a large microwave-safe bowl and microwave for 1 minute. If butter has not melted, microwave 30 seconds longer. Pour 1/2 cup plus 2 tablespoons corn syrup, brown sugar, and vanilla extract into melted butter; stir until combined. Add oats and mix to combine; mixture may be a bit thick but do not add additional liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in strawberries and white chocolate chips. Spoon batter into the prepared baking dish and lightly press mixture into the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden on top, about 25 minutes. Allow to cool before slicing into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
