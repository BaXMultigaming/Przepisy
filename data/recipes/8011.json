  "ingredients": [
    "1.75 cups all-purpose flour",
    "1 cup unsweetened cocoa powder",
    "1.25 teaspoons baking soda",
    "0.125 teaspoon salt",
    "0.75 cup unsalted butter, softened",
    "0.66666668653488 cup white sugar",
    "0.66666668653488 cup packed brown sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "1.5 cups buttermilk",
    "0.75 cup unsalted butter, softened",
    "1 (16 ounce) package confectioners' sugar, sifted",
    "3 (1 ounce) squares unsweetened chocolate, melted",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Sift together flour, cocoa, baking soda, and salt in a small mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, cream 3/4 cup butter and white and brown sugars at medium speed until light and fluffy. Add eggs, one at a time, beating after each addition. Add 2 teaspoons vanilla. At low speed, begin by adding a little of the flour mixture to the butter mixture. Alternate with buttermilk until all are blended together. Start and end with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line bottoms of 2 9-inch pans with waxed paper; grease and flour. Pour batter in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 350 degrees F (175 degrees C) oven for 25-30 minutes. Test with toothpick. Cool in pans for 10 minutes before turning onto racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Frosting: Cream together 3/4 cup butter and confectioners' sugar. Slowly add melted chocolate and 2 teaspoons vanilla. Beat until light and fluffy. Frost cooled cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
