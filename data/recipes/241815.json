  "ingredients": [
    "1 cup butter, softened",
    "0.5 cup white sugar",
    "2 cups all-purpose flour",
    "1 teaspoon cornstarch",
    "1.3333333730698 cups white sugar",
    "0.66666668653488 cup lemon juice",
    "0.66666668653488 cup all-purpose flour",
    "4 large eggs",
    "1 tablespoon lemon zest",
    "1 tablespoon mini chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking dish with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and 1/2 cup sugar together in a bowl with an electric mixer until creamy. Add 2 cups flour and cornstarch; beat until mixture forms a dough. Press dough into the bottom of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is light golden brown, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 1/3 cups sugar, lemon juice, 2/3 cup flour, eggs, and lemon zest together in a bowl with an electric mixer until smooth. Pour lemon mixture over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven until lemon mixture is set, 25 to 30 minutes. Cool to room temperature before removing from baking dish. Cut into desired \"Peep\" shapes using shaped cookie cutters. Place 2 mini chocolate chips onto each \"Peep\" to create \"eyes.\"",
      "section": null,
      "name": null,
      "url": null,
