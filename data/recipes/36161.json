  "ingredients": [
    "1.5 pounds ground beef",
    "1 onion, chopped",
    "0.375 cup raisins, chopped",
    "1.5 teaspoons chopped flat leaf parsley",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground coriander",
    "1 pinch ground nutmeg",
    "0.5 teaspoon white sugar",
    "salt and pepper to taste",
    "skewers",
    "1 tablespoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together ground beef, onion, raisins, and parsley. Season with cayenne pepper, cinnamon, coriander, nutmeg, sugar, salt, and pepper, and mix well. Form into 6 flat sausages around skewers. Lightly brush sausages with oil; this prevents sticking to the grill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange skewers on hot grill grate. Cook for approximately 15 minutes, turning occasionally to brown evenly, until well done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
