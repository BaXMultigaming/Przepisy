  "ingredients": [
    "1 pound lean ground beef",
    "3 ounces bacon, chopped",
    "1 cup chopped onion",
    "0.5 cup sliced celery",
    "0.5 cup chopped carrots",
    "0.5 cup COLLEGE INN® Fat Free & Lower Sodium Beef Broth, or red or white wine",
    "1 (28 ounce) can CONTADINA® Crushed Tomatoes",
    "0.75 cup whole milk",
    "Cooked pasta"
  ],
  "steps": [
    {
      "text": "Brown beef, bacon, onion, celery and carrots in a large saucepan over medium-high heat until browned and crisp, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add broth; simmer until evaporated, scraping browned bits from bottom of pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomatoes and milk. Simmer over medium-low heat until sauce is thickened, about 15 minutes. Serve over pasta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
