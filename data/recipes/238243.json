  "ingredients": [
    "1 sweet potato, diced",
    "1.25 cups water",
    "0.25 yellow onion, chopped",
    "3 cloves garlic, minced",
    "1 (.87 ounce) package dry brown gravy mix",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon curry powder",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon ground turmeric",
    "0.5 teaspoon salt",
    "1 cup shredded leftover pot roast",
    "0.5 cup peas",
    "0.5 cup frozen corn",
    "1 frozen deep-dish pie crust",
    "0.5 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Put sweet potato into a saucepan with enough water to cover completely; bring to a boil. Reduce heat to medium-low and simmer until just tender, about 15 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water, onion, and garlic in a saucepan; bring to a boil, reduce heat to low, and cook at a simmer until onion softens, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir gravy mix, cumin, cinnamon, curry powder, ginger, black pepper, turmeric, and salt into the water; add leftover pot roast, sweet potatoes, peas, and corn. Cook the mixture, stirring occasionally, until heated through, about 5 minutes; pour into the frozen pie crust. Sprinkle feta cheese over the filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until crust is golden brown around edges, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
