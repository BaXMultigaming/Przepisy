  "ingredients": [
    "1 pastry for a 9-inch pie crust",
    "1 cup white sugar",
    "0.5 cup light brown sugar",
    "0.25 cup all-purpose flour",
    "2.5 tablespoons dark cocoa powder",
    "1.5 tablespoons cornmeal",
    "0.5 teaspoon salt",
    "3 large eggs",
    "0.5 cup buttermilk",
    "0.5 cup butter, melted",
    "0.25 cup whiskey",
    "1 teaspoon vanilla bean paste",
    "0.75 cup toasted sliced almonds"
  ],
  "steps": [
    {
      "text": "Place pastry crust in a pie plate. Refrigerate for 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, brown sugar, flour, cocoa powder, cornmeal, and salt in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, buttermilk, butter, whiskey, and vanilla paste together in a large bowl. Add sugar mixture and blend until smooth. Stir in almonds by hand until incorporated. Pour mixture into the chilled pastry crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden and center is set, 50 to 60 minutes. Transfer pie to a wire rack and cool to room temperature before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
