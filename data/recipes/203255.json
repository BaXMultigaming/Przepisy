  "ingredients": [
    "1.5 cups shredded Cheddar cheese",
    "1.25 cups mayonnaise",
    "6 green onions, chopped",
    "1 pinch salt",
    "1 pinch garlic salt",
    "1 pinch ground black pepper",
    "1 (12 ounce) package English muffin, split"
  ],
  "steps": [
    {
      "text": "Preheat the oven broiler. Set the oven rack about 6 inches from the heat source.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together Cheddar cheese, mayonnaise, green onions, salt, garlic salt, and pepper in a bowl. Spread cheese mixture over each English muffin half. Cut muffins into quarters and place them on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until cheese is bubbly, 4 to 6 minutes.",
      "section": null,
