  "ingredients": [
    "1.5 cups instant tea powder",
    "2 cups powdered non-dairy creamer",
    "0.5 cup dry milk powder",
    "1 cup confectioners' sugar",
    "0.25 cup brown sugar",
    "1 teaspoon ground ginger",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cloves",
    "1 teaspoon ground cardamom",
    "1 teaspoon ground allspice",
    "1 teaspoon vanilla powder"
  ],
  "steps": [
    {
      "text": "In a food processor, combine instant tea, powdered creamer, milk powder, confectioners' sugar and brown sugar. Add ginger, cinnamon, cloves, cardamom, allspice and vanilla powder. Process for 2 minutes. Store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
