  "ingredients": [
    "4 cups ice cubes, or as needed",
    "8 cups strong freshly brewed coffee",
    "1 cup white sugar, or to taste",
    "4 cups whole milk"
  ],
  "steps": [
    {
      "text": "Add 2 cups ice cubes to a 2-quart pitcher. Slowly pour coffee over ice; stir until ice is melted. Stir in sugar; mix thoroughly until completely dissolved. Add milk, stirring just until combined. Stir in remaining 2 cups ice, adding more as needed; refrigerate until well chilled, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a tall glass with ice; stir coffee mixture, then pour into glass. Or pour into sterilized serving-size glass bottles or insulated tumblers.",
