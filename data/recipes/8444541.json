  "title": "Focaccia Panzanella",
  "description": "Chef John uses leftover focaccia and fresh tomatoes to create this summer-ready panzanella salad.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2022-08-02T09:00:00-04:00",
