  "ingredients": [
    "3 cups milk",
    "3 cups water",
    "1 cup dry polenta",
    "2 tablespoons white sugar",
    "0.5 teaspoon salt",
    "0.5 cup sour cream",
    "1 tablespoon white sugar",
    "6 tablespoons blackberry jam"
  ],
  "steps": [
    {
      "text": "In a medium pan over high heat, bring to boil milk and water. Reduce heat to simmer liquid. Stirring constantly, pour in polenta in a thin, steady stream, breaking up any lumps that form. Stir in 2 tablespoons sugar and salt. Simmer, stirring often, until polenta is soft and creamy, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix sour cream and 1 tablespoon sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle polenta into bowls, and top with about 1 tablespoon of jam and a dollop of sweetened sour cream.",
