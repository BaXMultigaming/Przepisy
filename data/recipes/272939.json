  "ingredients": [
    "2 tablespoons extra-virgin olive oil",
    "2 tablespoons white vinegar",
    "2 large heirloom tomatoes, sliced",
    "6 ounces arugula",
    "2 medium nectarines, sliced",
    "1 large avocado, sliced",
