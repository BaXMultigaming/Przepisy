  "title": "Ground Beef Shepherd&#39;s Pie",
  "description": "This shepherd&#39;s pie with ground beef is packed with fresh vegetables for a baked casserole topped with creamy mashed potatoes and Cheddar cheese.",
  "authors": [
    "GINGER P"
  ],
  "date_published": "2000-02-15T20:26:34-05:00",
