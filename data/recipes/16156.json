  "ingredients": [
    "cooking spray",
    "1 tablespoon vegetable oil",
    "1 onion, chopped",
    "1 pound lean ground beef",
    "1 teaspoon dried basil",
    "1 cup green beans",
    "1 cup tomatoes, diced",
    "1 clove garlic, minced",
    "2 potatoes, cooked and mashed",
    "0.5 cup water",
    "1 large egg, beaten",
    "0.25 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/66NdYNWugBArAoi6EfGy1qLjjCI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16156-ground-beef-shepherds-pie-ddmfs-step-1-130eeb61865541108091456969b2b30c.jpg"
      ],
      "image": "assets/images/16156/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uJCqjaypFh3VclOzcviNpIUwyJ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16156-ground-beef-shepherds-pie-ddmfs-step-2-ebc1b76278194f7383b6faa75b0ec400.jpg"
      ],
      "image": "assets/images/16156/step_02.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Cook and stir onion in hot oil until translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fe0I8sjIUzjc0Y0q0WfTJt2n3e8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16156-ground-beef-shepherds-pie-ddmfs-step-3-0981347a232c4d51a8a588da092799a9.jpg"
      ],
      "image": "assets/images/16156/step_03.webp"
    },
    {
      "text": "Add ground beef and basil. Cook and stir until beef is crumbly and browned, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gL7geOIi0pOHBzsO1LydaeoIubA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16156-ground-beef-shepherds-pie-ddmfs-step-4-b27abd41bf0247bcacee3d31b14a2df9.jpg"
      ],
      "image": "assets/images/16156/step_04.webp"
    },
    {
      "text": "Mix in green beans, tomatoes, and garlic; cook until beans are slightly softened, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/whnA3blWhAWclhvIs3UwbZuB0WU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16156-ground-beef-shepherds-pie-ddmfs-step-5-264d91ecb3fd4defafbe2890fda5002b.jpg"
      ],
      "image": "assets/images/16156/step_05.webp"
    },
    {
      "text": "Transfer to the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cJQ16BN71pGeURUvufADYDL3l-Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16156-ground-beef-shepherds-pie-ddmfs-step-6-7411bf536a2c43b38653869e11c98a3c.jpg"
      ],
      "image": "assets/images/16156/step_06.webp"
    },
    {
      "text": "Mix together mashed potatoes, water, and beaten egg in a medium bowl until smooth. Spread evenly over beef mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rVJdYNGmnLa1AahQiA_3MJYeMlw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16156-ground-beef-shepherds-pie-ddmfs-step-7-95578848b1584f2ea9a908f9d54b0d5c.jpg"
      ],
      "image": "assets/images/16156/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until potatoes start to brown on top, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ftTr8uJ9VhJ-fpnoy2_Mz1UYa9I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16156-ground-beef-shepherds-pie-ddmfs-step-8-34784771380648c091a8d6d0b484d74a.jpg"
      ],
      "image": "assets/images/16156/step_08.webp"
    },
    {
      "text": "Sprinkle with cheese and continue baking until cheese is melted, about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IBr_VFo0LB9ocQIkOZRsbvBCOG8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16156-ground-beef-shepherds-pie-ddmfs-step-9-8e0c2fb35b6f48db9987ef8591fc171a.jpg"
      ],
      "image": "assets/images/16156/step_09.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JyKYawZASnSFYNiPNhZX03Mic5w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16156-ground-beef-shepherds-pie-ddmfs-4x3-05e4f322c29c463f83bffa74833d287b.jpg"
      ],
      "image": "assets/images/16156/step_10.webp"
    }
