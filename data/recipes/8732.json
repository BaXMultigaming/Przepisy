  "ingredients": [
    "6 skinless, boneless chicken breast halves - diced",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1 (8 ounce) container sour cream",
    "2 tablespoons dry sherry",
    "salt and pepper to taste",
    "8 ounces buttery round crackers, crushed",
    "1.5 tablespoons poppy seeds",
    "0.5 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in the prepared baking dish. Combine soup, sour cream, and sherry in a bowl; pour or spoon over chicken. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine crushed crackers and poppy seeds; sprinkle over chicken. Season with salt and black pepper. Drizzle melted butter over cracker layer. Cover baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 45 minutes, uncover for the last 5 minutes. Let stand before serving, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
