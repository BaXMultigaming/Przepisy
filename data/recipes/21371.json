  "keywords": [],
  "ingredients": [
    "2 (8 ounce) packages corn bread mix",
    "3 tablespoons butter",
    "0.5 cup chopped onions",
    "0.5 cup diced celery",
    "2 (8 ounce) cans oysters, liquid reserved",
    "2 eggs",
    "0.5 teaspoon ground black pepper",
    "1 tablespoon poultry seasoning",
    "1.5 teaspoons dried sage",
    "1 (14.5 ounce) can chicken broth"
  ],
  "steps": [
    {
      "text": "Prepare the corn bread according to package directions. Allow bread to cool, then crumble into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x9 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Over medium-low heat melt butter in a large saucepan. Mix in the onions and celery. Cook slowly, stirring occasionally until onions are soft. Transfer to the bowl with bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chop the oysters. Mix oysters, eggs, pepper, poultry seasoning, sage, chicken broth and reserved oyster liquid into the corn bread mixture. Transfer to the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered in the preheated oven 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
