  "title": "Microwave English Muffin Bread",
  "description": "Try this microwaved bread recipe for delicate English muffin bread that&#39;s baked in your microwave! Add cinnamon and raisins if desired.",
  "authors": [
    "Larry"
  ],
  "date_published": "2000-10-01T11:41:11-04:00",
