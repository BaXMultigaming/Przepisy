  "ingredients": [
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 cup butter, softened",
    "0.75 cup white sugar",
    "0.75 cup packed brown sugar",
    "1 teaspoon vanilla extract",
    "2 large eggs",
    "2 cups semisweet chocolate chips",
    "0.5 cup shortening",
    "0.5 cup butter, softened",
    "1 teaspoon vanilla extract",
    "4 cups confectioners' sugar",
    "2 tablespoons milk, or more as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 mini muffin pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, and salt in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, white sugar, brown sugar, and vanilla extract in a large bowl; beat with an electric mixer until creamy. Add eggs one at a time, beating well after each addition. Gradually beat in the flour mixture. Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop rounded tablespoons of the dough into the prepared mini muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are light golden brown, 9 to 12 minutes. Cool before removing from the pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat shortening, butter, and vanilla extract together with an electric mixer in a mixing bowl. Beat in confectioners' sugar gradually, 1 cup at a time. Beat in milk until icing is smooth. Add a little more milk if icing is still dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill the center of each cooled cookie cup with icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
