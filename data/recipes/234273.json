  "ingredients": [
    "1.5 cups water",
    "0.25 cup margarine",
    "1 (6 ounce) package dry bread stuffing mix",
    "8 slices deli turkey breast",
    "1 (12 ounce) jar turkey gravy"
  ],
  "steps": [
    {
      "text": "Boil water and margarine together in a medium saucepan; stir in stuffing mix. Cover and remove from heat. Let stand until stuffing softens, about 5 minutes. Fluff with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide stuffing between turkey slices. Roll turkey around stuffing; arrange rolls in a microwave-safe dish, seam-side down. Pour gravy over rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat in the microwave on high until gravy is bubbly, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
