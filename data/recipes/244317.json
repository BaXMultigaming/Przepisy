  "ingredients": [
    "3 leaves fresh basil, divided",
    "1 teaspoon cane sugar",
    "0.5 cup ice cubes, or as needed",
    "3 fluid ounces limoncello",
    "3 fluid ounces soda water",
    "sea salt as needed"
  ],
  "steps": [
    {
      "text": "Place 2 basil leaves and cane sugar in a cocktail shake; muddle together until basil is broken down. Add ice, limoncello, and soda water. Cover shaker and shake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread sea salt onto a shallow plate. Wet the rim of a glass with water and press rim into sea salt. Pour cocktail into glass and garnish with 1 basil leaf.",
