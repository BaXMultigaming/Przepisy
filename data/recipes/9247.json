  "ingredients": [
    "1 pound ground pork sausage",
    "1 teaspoon mustard powder",
    "0.5 teaspoon salt",
    "4 large eggs",
    "2 cups milk",
    "6 slices white bread, toasted and cut into cubes",
    "8 ounces mild Cheddar cheese, shredded"
  ],
  "steps": [
    {
      "text": "Crumble sausage into a medium skillet. Cook over medium heat until evenly brown; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lAJ61vVX8CH4arcArjVOH7PusC4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9247-christmas-breakfast-sausage-casserole-step-1-248-df919a8ebdf84a339fc0a59704ccb7eb.jpg"
      ],
      "image": "assets/images/9247/step_01.webp"
    },
    {
      "text": "In a medium bowl, mix together mustard powder, salt, eggs and milk. Add the sausage, bread cubes, and cheese, and stir to coat evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B6LI0uTG6RP6Igr_fz1yJSUUd54=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9247-christmas-breakfast-sausage-casserole-step-2-256-949ebf4e99ed4c68a5cba5d43e3a3013.jpg"
      ],
      "image": "assets/images/9247/step_02.webp"
    },
    {
      "text": "Pour into a greased 9x13 inch baking dish. Cover, and chill in the refrigerator for 8 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rvua_mLKd-ydJa_409GMYdgZdj0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9247-christmas-breakfast-sausage-casserole-step-3-259-63e824ceb66546ffa765e6acbd18e915.jpg"
      ],
      "image": "assets/images/9247/step_03.webp"
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Cover, and bake 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Uncover, and reduce temperature to 325 degrees F (165 degrees C). Bake for an additional 30 minutes, or until set",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YUdn_AlEP0Y4pPI6h8uuitxaQ1U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9247-christmas-breakfast-sausage-casserole-step-4-326-73a88261136d4825856a400e8f75efba.jpg"
      ],
      "image": "assets/images/9247/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4myqzUvQ_sKTxIcQuE_odSoSWWk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9247-christmas-breakfast-sausage-casserole-DDMFS-4x3-293f309a68ba433d8065347bccf448f6.jpg"
