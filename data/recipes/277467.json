  "ingredients": [
    "0.5 cup unsalted butter, at room temperature",
    "0.25 cup white sugar",
    "0.25 cup light brown sugar",
    "0.5 cup peanut butter",
    "1 large egg",
    "1 tablespoon sour cream",
    "0.5 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.125 teaspoon baking soda",
    "0.5 cup strawberry jam"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 3 to 4 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, white sugar, and brown sugar together in a bowl using an electric mixer. Beat in peanut butter and egg. Stir in sour cream and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, baking powder, and baking soda together in a separate bowl. Add to the peanut butter mixture; stir to blend well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop a teaspoonful of dough and shape into mini balls. Place about 2 inches apart on the prepared baking sheets. Indent the center of each cookie using a chopstick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 15 minutes. Let cool completely, 20 to 30 minutes. Fill each with strawberry jam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
