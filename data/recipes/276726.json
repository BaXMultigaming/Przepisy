  "ingredients": [
    "3 skinless, boneless chicken breast halves",
    "1 (8 ounce) package penne pasta",
    "0.5 (16 ounce) jar Alfredo sauce",
    "1.5 cups shredded mozzarella cheese, divided",
    "0.25 cup milk",
    "1 tablespoon onion powder",
    "1 tablespoon garlic powder",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken into a pot and cover with water. Bring to a boil over high heat; reduce heat and simmer until no longer pink in the centers and juices run clear, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "At the same time, bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain cooked chicken and cut into bite-size pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jbiu1RLIbIffKztYiG4tspaFNXA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276726-ChickenAlfredoCasserole-mfs-Step1-0039-a5fff82fdaa140f297528ff90e4be296.jpg"
      ],
      "image": "assets/images/276726/step_04.webp"
    },
    {
      "text": "Place chicken, noodles, Alfredo sauce, 1/2 mozzarella cheese, milk, onion powder, and garlic powder in a large bowl and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4FPJXLVfNAM9WNMOhUoWENDIjEU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276726-ChickenAlfredoCasserole-mfs-Step3-0047-b053e89b459b434d8357a8c98fcc2f89.jpg"
      ],
      "image": "assets/images/276726/step_05.webp"
    },
    {
      "text": "Pour into a 1 1/2-quart casserole dish. Layer remaining mozzarella cheese and Cheddar cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SxYGk-pT7_Aew_IpI1yrEISZfR8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276726-ChickenAlfredoCasserole-mfs-Step4-0048-7fde3a4884ba4bc892b0d2c38fb66ad9.jpg"
      ],
      "image": "assets/images/276726/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until melted and bubbly, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
