  "ingredients": [
    "1 (3 ounce) package cream cheese, softened",
    "0.5 cup butter",
    "1 cup all-purpose flour",
    "0.75 cup packed brown sugar",
    "1 egg",
    "1 tablespoon butter",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "2.3333330154419 cups chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the crust: Beat softened cream cheese and 1/2 cup butter together in a large bowl. Stir in flour and mix to form a smooth dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 24 1-inch balls, then press into the bottoms and up the sides of ungreased mini muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make filling: Beat sugar, egg, 1 tablespoon butter, vanilla, and salt together until smooth; stir in walnuts. Spoon mixture into each crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden and filling is set, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
