  "ingredients": [
    "4 cups thinly sliced apples",
    "0.25 cup orange juice",
    "1 cup white sugar",
    "0.75 cup all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 pinch salt",
    "0.5 cup cold butter, cubed"
  ],
  "steps": [
