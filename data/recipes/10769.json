  "ingredients": [
    "1.25 cups butter",
    "2 cups white sugar",
    "2 egg",
    "2 teaspoons vanilla extract",
    "2.5 cups all-purpose flour",
    "0.75 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "54 milk chocolate candy kisses, unwrapped",
    "0.33333298563957 cup granulated sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large bowl mix butter and sugar till fluffy, add eggs and vanilla mix well. Sift together flour, cocoa, baking soda, and salt, and add to creamed mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into balls about 1 inch in diameter then roll in white sugar. Place balls on ungreased cookie sheet and bake for 8 to 10 minutes. Place unwrapped chocolate kiss in the center of each cookie while still hot. Let cool and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
