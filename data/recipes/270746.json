  "ingredients": [
    "cooking spray",
    "1 pound ground turkey",
    "0.25 cup corn flake crumbs",
    "1 egg",
    "3 scallions, chopped",
    "1 tablespoon minced fresh ginger root",
    "1 tablespoon low-sodium soy sauce",
    "2 teaspoons sesame oil",
    "1 teaspoon dried parsley",
    "0.5 teaspoon salt",
    "1 clove garlic, minced",
    "2 tablespoons low-sodium soy sauce",
    "2 tablespoons water",
    "1 tablespoon chile-garlic paste (sambal oelek)",
    "1 tablespoon palm sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a large baking tray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine turkey, corn flake crumbs, egg, scallions, ginger, soy sauce, sesame oil, parsley, salt, and garlic in a large bowl. Shape into 1-inch meatballs. Arrange on the prepared baking tray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soy sauce, water, chile-garlic paste, and palm sugar in a separate bowl to make the glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake meatballs in the preheated oven until no longer pink on the outside, about 10 minutes. Coat the meatballs with the glaze. Continue baking until glaze thickens, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
