  "ingredients": [
    "6 ounces kale leaves",
    "1.5 tablespoons olive oil",
    "0.5 teaspoon kosher salt",
    "0.5 teaspoon paprika",
    "0.25 teaspoon garlic powder",
    "1 pinch ground black pepper to taste",
    "1 pinch cayenne pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 360 degrees F (180 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir kale leaves off the stems and chop into small pieces. Place in a large bowl; add olive oil, salt, paprika, garlic powder, pepper, and cayenne. Toss until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add a layer of kale leaves to the air fryer basket. Cook for 3 minutes. Shake the basket and pour kale out onto a cutting board or baking sheet to cool and crisp up. Repeat with remaining kale, working in batches to prevent it from steaming and getting soggy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
