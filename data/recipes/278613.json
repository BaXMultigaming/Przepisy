  "ingredients": [
    "1 medium orange",
    "1 small lemon",
    "2 cinnamon sticks, crushed",
    "1 tablespoon whole allspice berries",
    "1 tablespoon whole cloves",
    "0.5 tablespoon cardamom pods",
    "0.5 tablespoon whole black peppercorns"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 200 degrees F (95 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Zest and peel orange and lemon. Cut peels into thinnest strips possible. Distribute zest and peels evenly on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until zest and peels are dry, 60 to 75 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine dried zest, dried peels, crushed cinnamon, allspice, cloves, cardamom and peppercorns in a large bowl.",
