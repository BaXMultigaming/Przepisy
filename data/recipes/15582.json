  "ingredients": [
    "0.5 cup shortening",
    "1 tablespoon milk",
    "1 cup packed brown sugar",
    "1 egg, beaten",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.125 teaspoon salt",
    "1 teaspoon vanilla extract",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour one 8x8 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine shortening and milk in large saucepan. Place over low heat until shortening melts. Remove from heat, add the brown sugar and egg. Stir until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the flour, baking powder and salt; stir into sugar mixture. Stir in vanilla and nuts. Spread evenly into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 20 to 25 minutes or until toothpick inserted in middle comes out clean. Cool and cut into 2x2 inch squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
