  "ingredients": [
    "1 cup unsalted butter, softened",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "6 tablespoons powdered sugar",
    "1 cup finely chopped walnuts",
    "0.33333334326744 cup powdered sugar, or more as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ytM5M8zMQgwzYoL1Lo8-OOQTaaE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10192-russian-tea-cakes-ingredients-8da14a1f0299402d9e6d72ab5f54f68b.jpg"
      ],
      "image": "assets/images/10192/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and vanilla together in a medium bowl with an electric mixer until smooth, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JrHOPdaF7hfH2792ibEV6wuVKYA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10192-russian-tea-cakes-step-02-1-6be858f4997e4c18be2daa701238948c.jpg"
      ],
      "image": "assets/images/10192/step_03.webp"
    },
    {
      "text": "Whisk flour and 6 tablespoons powdered sugar together in separate bowl. Add to the butter mixture and stir until just blended. Add walnuts and mix until incorporated; mixture may be crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dc_A2tNf0GpqRRCYNMN4gIyHl-Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10192-russian-tea-cakes-step-02-3-cac723fb5e3a42abb2bae7f0cdb15a10.jpg"
      ],
      "image": "assets/images/10192/step_04.webp"
    },
    {
      "text": "Take small scoops of dough and roll between your hands into 1-inch balls. Place balls 2 inches apart on ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LJAd9MtdCH8b8eTpIW0J6bSa6YI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10192-russian-tea-cakes-step-03-1705576b41c84dd08f707c62edcebb49.jpg"
      ],
      "image": "assets/images/10192/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are just turning golden, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and transfer to a wire rack to cool for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place remaining 1/3 cup powdered sugar in a small bowl. Roll cooled cookies in the powdered sugar once or twice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tNdtH8_AWcvhmC-KmL1W6o-G2Xs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10192-russian-tea-cakes-step-04-6e0e29c876e44af2a58ffcd21c71f2fe.jpg"
      ],
      "image": "assets/images/10192/step_08.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
