  "title": "South African Brown Pudding",
  "description": "A traditional South African dessert that comes together quickly. A sauce is prepared while the pudding is baking and then poured over the pudding when it comes out of the oven.",
  "authors": [
    "Olivia"
  ],
  "date_published": "2020-06-18T23:42:38-04:00",
