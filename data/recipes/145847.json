  "ingredients": [
    "1 (16 ounce) container sour cream",
    "1 cucumber, peeled, grated and squeezed as dry as possible",
    "1 cup fresh dill, chopped",
    "0.25 cup lemon juice, or to taste",
    "1 teaspoon salt, or to taste"
  ],
  "steps": [
    {
      "text": "Mix the sour cream, cucumber, and dill together in a bowl until thoroughly blended. Stir in the lemon juice and salt. Adjust seasonings to taste. Cover and refrigerate 1 to 2 hours.",
