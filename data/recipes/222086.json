  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease muffin cups or line with muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together 1/2 cup sugar, 1/3 cup flour, butter, and cinnamon in a small bowl with a fork until mixture resembles coarse crumbs. Set topping aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 1/2 cups flour, remaining 3/4 cup sugar, and baking powder in a large bowl. Place applesauce into a 1-cup measuring cup; add egg and enough milk to measure 1 cup; stir well, then mix into flour mixture until just combined. Fold in blueberries. Fill the prepared muffin cups to the top and sprinkle with topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and the tops spring back when lightly pressed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
