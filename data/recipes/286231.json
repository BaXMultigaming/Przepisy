  "ingredients": [
    "2 medium honeynut squashes",
    "4 teaspoons butter",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon sea salt",
    "0.25 teaspoon ground Saigon cinnamon",
    "4 teaspoons maple syrup",
    "2 tablespoons chopped pecans"
  ],
  "steps": [
    {
      "text": "Scrub any dirt off the squashes, slice them in half lengthwise, remove the seeds, and lay them cut-side up on a cutting board.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put 1 teaspoon butter in the cavity of each squash half, and sprinkle with salt, pepper, and cinnamon. Place them directly on the air fryer basket pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set air fryer to air-roast at 400 degrees F (200 degrees C) and cook until the squash is tender, about 25 minutes. Drizzle with maple syrup and sprinkle with chopped pecans if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
