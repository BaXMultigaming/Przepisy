  "ingredients": [
    "cooking spray",
    "1 cup butter",
    "4 (1 ounce) squares unsweetened chocolate",
    "2 cups white sugar",
    "4 large eggs",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "1 pinch salt",
    "1 cup semisweet chocolate chips",
    "1 cup chopped walnuts",
    "0.66666668653488 cup oats"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter and unsweetened chocolate together in the top of a double boiler over simmering water, stirring frequently and scraping down the sides with a rubber spatula to avoid scorching. Remove from heat and pour chocolate mixture into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, eggs, and vanilla extract into chocolate mixture using a fork. Stir flour and salt into chocolate mixture until batter is smooth; fold in chocolate chips, walnuts, and oats. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until brownies are beginning to pull away from sides and middle is done, 25 to 30 minutes. Cool before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
