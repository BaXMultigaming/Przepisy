  "ingredients": [
    "4 pounds beef heart",
    "0.25 cup all-purpose flour",
    "salt and pepper to taste",
    "3 tablespoons butter",
    "1 onion, chopped",
    "2 carrots, chopped",
    "2 potatoes, chopped",
    "2 teaspoons dried thyme",
    "1 cup beef broth",
    "0.5 cup red wine"
  ],
  "steps": [
    {
      "text": "Wash the heart and remove any fat and arteries. Slice the heart in half, then slice it into 1/2 inch thick slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge heart in flour and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the butter in large saute pan over medium-high heat. Add the heart slices and cook for 30 to 45 seconds per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the onion, carrots, potatoes, thyme, beef broth and wine. Reduce heat to low, cover and simmer for 1 hour. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
