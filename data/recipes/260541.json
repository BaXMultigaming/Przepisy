  "ingredients": [
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup milk",
    "1 large egg",
    "0.5 cup blueberries",
    "2 tablespoons chia seeds",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Whisk flour, baking powder, and salt together in a bowl. Make a well in the center; add milk and egg to the well. Whisk batter until combined; gently fold in blueberries and chia seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a nonstick skillet over medium-high heat; lightly coat with cooking spray. Drop ¼ cupfuls batter per pancake into the skillet; cook until edges look dry and bubbles on top begin to pop, about 2 minutes. Flip; cook 1 minute more. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
