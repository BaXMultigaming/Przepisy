  "ingredients": [
    "4 cups shredded zucchini",
    "0.75 cup water",
    "0.75 teaspoon salt",
    "0.5 teaspoon basil",
    "2 cups warm milk",
    "3 tablespoons all-purpose flour",
    "0.5 teaspoon salt",
    "3 tablespoons butter",
    "2 tablespoons minced onion",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Stir zucchini, water, salt, and basil together in a pot; bring to a boil, reduce heat to medium-low, and simmer until zucchini is tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour zucchini mixture into a blender no more than half full. Cover and hold lid down; pulse a few times before leaving on to blend until smooth. Puree in batches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk warm milk, flour, and salt together in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Cook and stir onion in melted butter until translucent, 5 to 7 minutes. Pour pureed zucchini and milk mixture into the skillet; bring to a boil while stirring continually. Season with pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
