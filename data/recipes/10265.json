  "title": "Jumbo Raisin Cookies",
  "description": "Juicy raisins are the star in these popular cookies! They're great as a snack with coffee.",
  "authors": [
    "MBMCD"
  ],
  "date_published": "1998-01-06T08:51:08-05:00",
