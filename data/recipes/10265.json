  "ingredients": [
    "2 cups raisins",
    "1 cup water",
    "3.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 cup shortening",
    "1.75 cups white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Place water and raisins in a small saucepan, and bring to boil. Boil 3 to 4 minutes. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, baking soda, salt, cinnamon, and nutmeg; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together shortening and sugar. Beat in eggs and vanilla. Stir in raisins along with the liquid in which they were boiled. Blend in flour mixture, then mix in the walnuts. Drop by tablespoonfuls onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes in preheated oven, or until firm. Remove from cookie sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
