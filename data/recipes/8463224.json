  "title": "Alfajor Cake",
  "description": "Shortbread-like cookies are layered with dulce de leche filling in this alfajor cake recipe. Perfect for a birthday party.",
  "authors": [
    "Pam Lolley"
  ],
  "date_published": "2022-08-25T16:16:50-04:00",
  "date_modified": "2023-02-23T12:40:19-05:00",
