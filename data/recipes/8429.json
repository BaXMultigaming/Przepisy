  "title": "Best Pineapple Upside-Down Cake",
  "description": "This pineapple upside down cake has 2 layers of tender cake with perfectly caramelized crushed pineapple and pineapple rings for the best dessert.",
  "authors": [
    "Donna"
  ],
  "date_published": "1999-10-17T20:27:43-04:00",
