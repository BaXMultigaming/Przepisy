  "ingredients": [
    "2 cups shredded mozzarella cheese",
    "2 ounces cream cheese",
    "1 cup finely ground almond flour",
    "1 large egg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mozzarella and cream cheese in a microwaveable bowl. Sprinkle almond flour over top. Cover bowl with a paper towel and microwave until cheese is bubbly, but not burnt, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cheeses and almond flour evenly until they form a ball of dough. Let cool, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add egg to mixture and reform dough ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out dough between 2 sheets of parchment paper to a 1/8-inch thickness; the thinner, the crispier. Cut into small 1-inch squares. Place squares on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 5 minutes. Flip crackers and bake until golden, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
