  "title": "Paximade",
  "description": "This bread is a greek type of bread that tastes almost like cake, although the sugar content is much lower. It makes a terrific breakfast bread.",
  "authors": [
    "jessica"
  ],
  "date_published": "1999-08-13T18:27:10-04:00",
