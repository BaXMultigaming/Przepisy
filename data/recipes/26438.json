  "ingredients": [
    "1 pound ground beef",
    "1 onion, chopped",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (15 ounce) can tomato sauce",
    "1 (16 ounce) can pinto beans",
    "1 teaspoon chili powder",
    "1 teaspoon ground cumin",
    "0.5 teaspoon ground cayenne pepper",
    "1 teaspoon minced garlic"
  ],
  "steps": [
    {
      "text": "In a large saucepan over medium-high heat, cook beef and onion until meat is no longer pink. Stir in tomatoes, tomato sauce, beans, chili powder, cumin, cayenne and garlic. Cover, reduce heat and simmer 20 minutes.",
