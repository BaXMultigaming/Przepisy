  "ingredients": [
    "9 eggs",
    "5 cups bread crumbs",
    "3 cups finely chopped walnuts",
    "3 cups grated sharp Cheddar cheese",
    "3 medium onions, finely chopped",
    "2 cups cottage cheese",
    "0.5 cup vegetable oil",
    "6 tablespoons minced garlic",
    "4 teaspoons dried basil",
    "2 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix eggs, bread crumbs, walnuts, Cheddar cheese, onions, cottage cheese, oil, garlic, basil, and salt together in a bowl with your hands until thoroughly blended. The batter will be very stiff.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill mixture in the refrigerator for 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll into 1-inch balls and place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 8 minutes, turn meatballs, and continue to bake for another 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
