  "ingredients": [
    "1 CAULIPOWER® Three Cheese Pizza",
    "4 ounces Brussels sprouts, thinly sliced",
    "3 teaspoons olive oil, divided",
    "salt and ground black pepper to taste",
    "0.5 small red onion, thinly sliced",
    "2 slices crisp-cooked bacon, crumbled",
    "2 tablespoons grated Parmesan cheese",
    "0.25 teaspoon red pepper flakes, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place pizza on a sheet pan or pizza pan. Do not allow to thaw before placing in the oven; it should be frozen.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss Brussels sprouts with 2 teaspoons olive oil in a medium bowl and season with salt and pepper. Scatter the Brussels sprouts on the pizza.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss the red onion slices with the remaining 1 teaspoon olive oil, and arrange on top of the Brussels sprouts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle the bacon over the onions, and top with grated Parmesan cheese and crushed red pepper flakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 13 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
