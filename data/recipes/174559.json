  "ingredients": [
    "2.5 cups bread flour",
    "0.5 teaspoon salt",
    "1 teaspoon cream of tartar",
    "1 teaspoon baking soda",
    "0.5 cup white sugar",
    "1 teaspoon apple pie spice",
    "0.33333334326744 cup cold butter",
    "1.25 cups sourdough starter",
    "2 tablespoons milk",
    "2 tablespoons coarse sugar, for garnish"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, salt, cream of tartar, baking soda, sugar, and apple pie spice together in a bowl. Cut in butter with a knife or pastry blender until mixture resembles coarse crumbs. Add sourdough starter and mix by hand to form a soft dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a lightly floured surface and divide it into 4 pieces. Pat or roll one piece of dough into a 1/2-inch thick round. Cut it into 4 wedge-shaped pieces and place the prepared baking sheet about 1 inch apart. Repeat with the remaining pieces of dough. Brush the tops of scones with milk and sprinkle with coarse sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until scones begin to turn golden, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
