  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C). Line the air fryer basket with parchment paper and spray with avocado oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix salmon, panko, onion, 1/3 cup mayonnaise, lemon juice, egg, dill, seafood seasoning, salt, and pepper in a bow until well combined. Shape into 3 equal-sized patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon patties into the basket and spray with avocado oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry until patties are golden brown, 8 to 10 minutes. Flip patties over, spray with avocado oil, and air fry an additional 4 to 7 minutes. Serve on buns spread with remaining mayonnaise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
