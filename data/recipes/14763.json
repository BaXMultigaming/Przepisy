  "ingredients": [
    "4 (1 1/4 inch) thick pork chops",
    "4 slices onion",
    "4 slices lemon",
    "0.25 cup packed brown sugar",
    "0.25 cup ketchup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chops in a 9x13-inch baking dish; top each chop with 1 onion slice and 1 lemon slice. Add 1 tablespoon brown sugar and 1 tablespoon ketchup on top of each chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover dish with aluminum foil and bake in the preheated oven for 30 minutes. Remove cover and bake another 30 minutes or until the internal temperature has reached 160 degrees F (70 degrees C). While baking, baste occasionally with pan juices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
