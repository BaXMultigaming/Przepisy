  "ingredients": [
    "1 (14 ounce) can EAGLE BRAND® Sweetened Condensed Milk",
    "1.5 cups cold water",
    "1 (4-serving size) package instant vanilla pudding mix",
    "2 cups whipping cream, whipped",
    "36 vanilla wafers",
    "3 medium bananas, sliced and dipped in",
    "lemon juice"
  ],
  "steps": [
    {
      "text": "In large bowl, combine sweetened condensed milk and water. Add pudding mix; beat until well blended. Chill 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold in whipped cream. Spoon 1 cup pudding mixture into 2 1/2-quart glass serving bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with one-third each of the vanilla wafers, bananas and remaining pudding. Repeat layering twice, ending with pudding mixture. Chill thoroughly. Garnish as desired. Store leftovers covered in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
