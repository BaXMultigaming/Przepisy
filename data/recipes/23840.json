  "ingredients": [
    "3 tablespoons margarine",
    "2.5 cups macaroni",
    "1 teaspoon salt",
    "1 teaspoon black pepper",
    "1 (8 ounce) package Cheddar cheese, shredded",
    "4 cups milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place margarine in 9x13 inch baking dish and put in oven to melt. When margarine is completely melted, pour in macaroni, salt and pepper. Stir until macaroni is coated with butter. Sprinkle cheese over macaroni and then pour milk over all. Do not stir and do not cover dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 60 minutes. Do not stir while baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
