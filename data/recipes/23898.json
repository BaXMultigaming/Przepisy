  "ingredients": [
    "2 large eggs",
    "0.5 cup milk",
    "0.5 cup sifted all-purpose flour",
    "1 pinch ground nutmeg",
    "1 pinch salt",
    "2 tablespoons butter",
    "2 tablespoons confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7CjloIEgMTE1QyK3lqnkOEtg_kQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23898-Dutch-Babies-dmfs-step01-4x3-1414-169293c3481043c49bfe8682bbdd90e5.jpg"
      ],
      "image": "assets/images/23898/step_01.webp"
    },
    {
      "text": "Place a 10-inch cast iron skillet into the oven and preheat to 475 degrees F (245 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a medium bowl until light. Whisk in milk, then gradually whisk in flour, nutmeg, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yLbvVIclAK6jVCgfKT0h8m2MCfg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23898-Dutch-Babies-dmfs-step04-4x3-1421-b4350c0e87d142b184bbe375d9eab6f7.jpg"
      ],
      "image": "assets/images/23898/step_03.webp"
    },
    {
      "text": "Remove the skillet from the oven and reduce the heat to 425 degrees F (220 degrees C). Place butter into the hot skillet and swirl to melt over the bottom and sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TmiqulhLVHHhMoVHID_PwX_kBP4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23898-Dutch-Babies-dmfs-step05-4x3-1426-645b066e3d6648368cda97b5f778d8a9.jpg"
      ],
      "image": "assets/images/23898/step_04.webp"
    },
    {
      "text": "Pour batter into the skillet and return to the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8gAlnyLlIsjRC97ZcGBU8jXlNnI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23898-Dutch-Babies-dmfs-step06-4x3-1427-999bcb328bf04293919fd71d57a27d1c.jpg"
      ],
      "image": "assets/images/23898/step_05.webp"
    },
    {
      "text": "Bake until puffed and lightly browned, about 12 minutes. Remove and immediately sift confectioners' sugar over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1EVDFYrHJsyvsVQ3vNFiS8JYTZg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23898-Dutch-Babies-dmfs-step06--4x3-1430-085acfb04a9643b490950f9db94faeb8.jpg"
      ],
      "image": "assets/images/23898/step_06.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5aRY8tnjLZ2BJegTzy1DOUQjpZc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23898-Dutch-Babies-dmfs-4x3-1450-3303f8da8ae54f1db55ed8366b71ec8e.jpg"
