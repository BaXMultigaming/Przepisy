  "ingredients": [
    "1.25 cups ramps leaves, rinsed and dried",
    "2 tablespoons pine nuts",
    "1 clove garlic, peeled and chopped",
    "10 tablespoons extra-virgin olive oil",
    "1.25 cups finely grated Parmesan cheese",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Combine ramp leaves, pine nuts, and garlic in the bowl of a food processor; pulse until finely chopped. Add olive oil, while the processor is running; process until smooth. Transfer mixture to a bowl. Stir in Parmesan cheese; season pesto with salt.",
