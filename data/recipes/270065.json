  "ingredients": [
    "8 1-inch-thick beef tenderloin steaks",
    "salt and ground black pepper to taste",
    "3 tablespoons butter",
    "0.5 cup dry red wine",
    "1 cup heavy whipping cream",
    "0.5 cup beef stock",
    "1 cup chopped tomatoes",
    "0.5 cup chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Pat filets dry; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a heavy skillet over medium heat. Add filets; cook to desired doneness, 4 to 5 minutes for medium. Transfer filets to a serving plate; discard fat from skillet. Add wine to skillet; bring to a boil, scraping any browned bits of food off the bottom of the skillet with a wooden spoon. Stir in cream and stock; boil sauce until thickened, 3 to 5 minutes. Off heat, stir in tomatoes and basil until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve filets with pan sauce.",
      "section": null,
