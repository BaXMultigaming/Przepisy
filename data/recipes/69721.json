  "ingredients": [
    "1.5 pounds ground beef",
    "4 slices day-old bread, torn into small pieces",
    "0.5 cup water",
    "0.25 cup lemon juice",
    "0.25 cup chopped onion",
    "1 egg, beaten",
    "2 teaspoons seasoning salt",
    "0.5 cup ketchup",
    "0.33333334326744 cup brown sugar",
    "1 teaspoon mustard powder",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon ground cloves",
    "6 slices lemon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch (or similar size) baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, bread, water, lemon juice, onion, egg, and seasoned salt in a bowl until well blended. Shape into 6 individual loaves; place in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine ketchup, brown sugar, mustard powder, allspice, and cloves. Spoon sauce over loaves. Top each loaf with 1 lemon slice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue baking until meatloaves are cooked through, about 30 minutes more. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
