  "ingredients": [
    "0.25 cup butter, melted",
    "0.75 teaspoon paprika",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "4 (6 ounce) fillets monkfish",
    "4 tablespoons bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine the melted butter, paprika, salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the fish fillets on a non-stick or parchment lined baking sheet. Brush the fillets evenly with the butter mixture and sprinkle the bread crumbs over the tops of each fillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 to 20 minutes or until the fish flakes easily with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
