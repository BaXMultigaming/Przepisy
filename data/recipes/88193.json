  "ingredients": [
    "Cooking spray",
    "0.25 cup flour",
    "1 teaspoon salt",
    "1 pinch cinnamon",
    "1 butternut squash - peeled, seeded and sliced",
    "4 apples - peeled, cored and sliced",
    "0.5 sweet onion, thinly sliced",
    "1 cup chicken stock",
    "1 cup shredded sharp Cheddar cheese",
    "3 slices bacon, cooked and crumbled"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350. Spray 9- x 11-inch glass baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour, salt, and cinnamon into a large plastic bag. Add squash, apples, and onions; shake until lightly dusted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In glass dish, layer 1/2 of squash, apples, and sweet onion. Pour 1/2 cup chicken stock over the top, then sprinkle 1/2 of cheese. Layer with remaining squash, apple, and onions. Pour remaining chicken stock over the top, and cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Take out and sprinkle with bacon crumbles and remaining cheese. Return, uncovered, to oven; bake for another 5 minutes. Let sit for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
