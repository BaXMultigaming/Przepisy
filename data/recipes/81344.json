  "ingredients": [
    "2 (10 ounce) cans chunk chicken, drained",
    "4 hard-cooked eggs, chopped",
    "0.25 cup Parmesan curls, shaved with a vegetable peeler",
    "0.25 cup chopped pine nuts",
    "2 tablespoons sweet dill pickle relish",
    "0.25 cup chopped white onion",
    "0.33333334326744 cup mayonnaise",
    "0.33333334326744 cup cole slaw dressing",
    "salt and freshly ground black pepper to taste",
    "10 slices sandwich bread",
    "5 lettuce leaves",
    "5 slices ripe tomato",
    "2 avocados, sliced",
    "5 slices Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Lightly combine the canned chicken, eggs, Parmesan cheese, pine nuts, pickle relish, chopped onion, mayonnaise, cole slaw dressing, and salt and pepper to taste in a large bowl. Cover and refrigerate for 30 minutes to blend the flavors.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To assemble sandwiches, spread a generous serving on each of 5 slices of sandwich bread, and place lettuce leaves, sliced tomato, sliced avocado, and Monterey Jack cheese slices over the salad. Top with remaining sandwich bread slices.",
