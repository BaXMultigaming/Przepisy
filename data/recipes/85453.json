  "ingredients": [
    "0.5 cup butter",
    "2 (1 ounce) squares unsweetened chocolate, chopped",
    "1 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.5 cup potato starch",
    "3 tablespoons matzo meal",
    "0.5 teaspoon salt",
    "0.5 cup chopped walnuts",
    "0.5 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small saucepan over medium heat. Off heat, stir in unsweetened chocolate until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and eggs together in a bowl with an electric mixer on medium speed for about 5 minutes. Reduce speed to low; beat in chocolate mixture, then beat in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk potato starch, matzo meal, and salt together in a separate bowl; stir into chocolate mixture with a spoon until well combined. Stir in walnuts and chocolate chips. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, until brownies are dry on top and begin to pull away from the sides, 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
