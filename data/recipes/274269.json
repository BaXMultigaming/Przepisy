  "ingredients": [
    "cooking spray",
    "2 ripe avocados, halved and pitted",
    "0.5 cup raw honey",
    "0.25 cup white sugar",
    "2 large eggs",
    "1.5 teaspoons pure vanilla extract",
    "0.5 cup unbleached all-purpose flour",
    "0.5 cup unsweetened cocoa powder (such as Fry's®)",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop out avocado pulp and place into the bowl of a food processor. Add honey and sugar; blend until smooth. Add eggs and vanilla extract and blend, scraping down the sides of the bowl as needed. Add flour, cocoa powder, baking soda, and salt; pulse until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the blade from the food processor and scrape down the sides to ensure the batter is completely blended. Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour brownie mixture into the prepared baking dish and spread evenly using a spoon that has been sprayed with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
