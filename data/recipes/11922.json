  "ingredients": [
    "1 pound spaghetti",
    "1 (16 ounce) bottle Italian-style salad dressing",
    "1 tablespoon Italian seasoning",
    "8 ounces shredded Cheddar cheese",
    "2 tomatoes, chopped",
    "1 green bell pepper, chopped",
    "0.5 onion, chopped",
    "1 cucumber, peeled and chopped"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
