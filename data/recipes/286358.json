  "ingredients": [
    "2 cups flour",
    "2.5 teaspoons baking powder",
    "1 teaspoon white sugar",
    "0.5 teaspoon salt",
    "6 tablespoons butter",
    "0.75 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 390 degrees F (195 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, sugar, and salt into a bowl. Cut butter into flour mixture, using a pastry cutter. Add buttermilk until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flour a work surface and, using your hands, bring dough together and fold 5 to 6 times, ending with a 1-inch thick rectangle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut biscuits with a 2 1/2-inch biscuit cutter. Bring leftover dough together to be able to cut more biscuits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place biscuits into the air fryer basket and air-fry until golden brown, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
