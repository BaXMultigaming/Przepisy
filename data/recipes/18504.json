  "ingredients": [
    "2 cups self-rising flour",
    "0.25 cup white sugar",
    "0.5 teaspoon salt",
    "0.25 cup shortening",
    "0.67 cup heavy cream",
    "1 cup buttermilk",
    "1 tablespoon butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Lightly grease one baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together flour, sugar and salt. Cut in shortening until mixture resembles coarse meal. Stir in cream and buttermilk until dough resembles cottage cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Generously sprinkle a smooth surface with flour. Spoon out batter into four lumps spaced well apart on the floured surface. Flour the top of the dough and your hands. Turn dough balls in the flour, shake off excess flour and place on prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 to 25 minutes, or until lightly browned. Remove from oven, brush with melted butter and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
