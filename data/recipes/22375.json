  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "1.5 cups white sugar",
    "0.5 teaspoon baking soda",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1.25 cups milk",
    "1 egg",
    "2 tablespoons vegetable oil",
    "1 teaspoon vanilla extract",
    "1 cup semisweet chocolate chips",
    "0.75 cup chopped walnuts",
    "0.33300000429153 cup whole almonds",
    "4 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In medium bowl, Sift together flour, cocoa, sugar, baking powder, baking soda and salt. In large bowl stir in milk, egg, oil and vanilla. Mix dry ingredients to large bowl; beat well. Add chocolate chips and walnuts, stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill muffin cups 3/4 full. Poke almonds into tops of unbaked muffins. Sprinkle muffins with sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 to 25 minutes, or until toothpick inserted in center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
