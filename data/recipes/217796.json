  "ingredients": [
    "1 tablespoon butter",
    "1 tablespoon olive oil",
    "1 red onion, sliced",
    "0.5 bunch fresh asparagus, trimmed",
    "salt to taste",
    "1 red bell pepper, sliced",
    "0.25 cup Parmesan cheese",
    "1 tablespoon balsamic vinegar",
    "1 tablespoon sesame seeds",
    "1 tablespoon toasted pine nuts"
  ],
  "steps": [
    {
      "text": "Melt butter and oil in a large skillet over medium heat. Add red onion, asparagus, and salt; cook until onion begins to soften, about 5 minutes. Stir in bell pepper; cook until onion caramelizes, about 5 minutes more.",
