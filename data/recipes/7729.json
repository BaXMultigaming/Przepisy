  "ingredients": [
    "1 (18.25 ounce) package devil's food cake mix",
    "3 ounces cream cheese",
    "0.33333334326744 cup white sugar",
    "1 egg",
    "1 pinch salt",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease muffin pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare cake mix according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese and sugar, cream until light and fluffy. Add egg and salt, beating well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into greased muffin pans filling 2/3 full. Drop a few semisweet chocolate morsels in the center and spoon 1 teaspoon of the cream cheese mixture on top of the chocolate morsels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 25 minutes. Let cupcakes cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
