  "ingredients": [
    "6 (6 ounce) skinless, boneless chicken breast halves",
    "0.5 cup water",
    "0.5 large white onion, diced",
    "3 large cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Combine chicken, water, onion, and garlic in the bottom of a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until you can press on the chicken with the back of a fork and it falls apart and is no longer pink in the center, about 5 hours. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pull out each piece of chicken and shred in a large bowl with 2 forks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When all chicken is shredded, combine with any water remaining in the slow cooker--this keeps the shredded chicken moist.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
