  "ingredients": [
    "cooking spray",
    "8 fresh peaches - peeled, pitted, and sliced",
    "0.5 cup butter, cut into pieces",
    "0.5 cup brown sugar",
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1 cup vegetable oil",
    "2 eggs, lightly beaten",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange peaches in the prepared pan. Scatter butter over peaches, then sprinkle brown sugar evenly over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, white sugar, baking powder, and salt together in a bowl. Stir oil and beaten egg together in another bowl; add to dry ingredients and stir to combine. Spoon mixture over peaches, then sprinkle cinnamon over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is lightly browned, about 45 minutes.",
