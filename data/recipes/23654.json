  "ingredients": [
    "1 cup brown sugar",
    "0.5 cup white sugar",
    "1 teaspoon all-purpose flour",
    "2 eggs",
    "2 tablespoons milk",
    "1 teaspoon vanilla extract",
    "0.5 cup melted butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C.)",
      "section": null,
      "name": null,
