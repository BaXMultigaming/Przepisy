  "ingredients": [
    "1 cup diced fresh mango",
    "0.5 cup white sugar",
    "0.5 cup skim milk powder",
    "0.5 cup yogurt",
    "0.5 cup sunflower oil",
    "0.25 cup hot water",
    "2 cups whole wheat flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mango, sugar, milk powder, yogurt, oil, and water in a blender; blend until smooth. Pour purée into a bowl. Sift flour, baking powder, and baking soda together into a separate bowl; fold into mango purée. Transfer mango mixture to the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
