  "ingredients": [
    "12 slices bacon",
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "0.75 cup unsweetened cocoa powder",
    "2 teaspoons baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon sea salt",
    "1 cup cold, strong, brewed coffee",
    "1 cup buttermilk",
    "0.5 cup vegetable oil",
    "2 eggs",
    "1 tablespoon unsweetened cocoa powder, for dusting"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Place 24 paper liners in two 12-cup muffin tins; coat liners with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in a large, deep skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels; crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, ¾ cup cocoa powder, baking soda, baking powder, and salt together in a bowl. Make a well in the center; pour in coffee, buttermilk, oil, and eggs. Stir just until blended. Mix in ¾ bacon; reserve ¼ for garnish. Divide batter among the prepared cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool in tins set on a wire rack. When cool, arrange cupcakes on a serving platter; frost with your favorite chocolate frosting. Sprinkle reserved bacon crumbles on top; dust with remaining 1 tablespoon cocoa powder.",
      "section": null,
      "name": null,
      "url": null,
