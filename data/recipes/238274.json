  "ingredients": [
    "2 large cucumbers, peeled and sliced",
    "0.5 cup diced sweet onion (such as Vidalia®)",
    "2 tablespoons white vinegar",
    "2 tablespoons white sugar",
    "1.5 tablespoons sour cream",
    "1 teaspoon salt",
    "0.5 teaspoon cracked black pepper"
  ],
  "steps": [
