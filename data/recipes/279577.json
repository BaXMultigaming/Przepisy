  "ingredients": [
    "1 pound gnocchi",
    "2 tablespoons salted butter",
    "1 tablespoon olive oil",
    "2 zucchini, sliced",
    "2 teaspoons chopped garlic",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook gnocchi in the boiling water until they float to the top, 2 to 4 minutes. Drain, reserving 1/4 cup cooking liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat and add olive oil. Add zucchini and garlic. Saute until tender, 5 to 7 minutes. Add cooked and drained gnocchi, Parmesan cheese, and reserved cooking liquid. Stir until nice and creamy.",
