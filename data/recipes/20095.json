  "ingredients": [
    "1 tablespoon soy sauce",
    "2 teaspoons cornstarch",
    "1 clove garlic, minced",
    "0.25 teaspoon crushed red pepper",
    "1 pound sirloin steak, cut into bite size strips",
    "2 tablespoons vegetable oil",
    "3 cups fresh broccoli florets",
    "2 small onions, cut into wedges",
    "1 (8 ounce) can water chestnuts, drained",
    "0.25 cup chicken broth",
    "0.5 cup peanuts"
  ],
  "steps": [
    {
      "text": "Stir together soy sauce, cornstarch, garlic, and crushed red pepper in a non-metal bowl. Add steak and toss to coat. Cover the bowl and refrigerate for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a wok or large skillet over high heat. Stir-fry beef in hot oil until no longer pink, about 5 minutes. Add broccoli, onions, and water chestnuts; cook and stir for 2 minutes. Pour in broth and bring to a boil. Stir in peanuts; cook for 1 minute and serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
