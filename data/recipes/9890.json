  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup chopped walnuts",
    "0.5 cup butter, melted",
    "0.25 cup packed brown sugar",
    "2 cups sliced fresh strawberries",
    "1 cup white sugar",
    "6 tablespoons pasteurized liquid egg whites",
    "2 tablespoons lemon juice",
    "1 cup heavy whipping cream, whipped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, walnuts, melted butter, and brown sugar in a bowl; mix well. Spread into a shallow baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes, stirring occasionally. Set aside crumb mixture until cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press ⅔ crumb mixture into a 9x13-inch baking dish; set aside. Combine sliced strawberries and sugar in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat pasteurized egg whites and lemon juice together in a large bowl with an electric mixer until stiff peaks form; stir in strawberries, then fold in whipped cream. Spoon strawberry mixture over crumb crust; sprinkle remaining crumbs on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Freeze 6 hours to overnight. Cut into squares; garnish with whole strawberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
