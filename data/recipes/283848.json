  "ingredients": [
    "6 large eggs",
    "salt and freshly ground black pepper to taste",
    "1.25 cups gluten-free flour",
    "1.25 cups Gluten free crackers",
    "2 pounds boneless, skinless chicken breast, cut in 1-inch pieces",
    "0.25 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Whisk eggs in a shallow bowl and season with salt and pepper. Place flour in a second bowl and cracker crumbs in a third bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge chicken pieces first in flour, then in eggs, and finally in cracker crumbs. Place on an air fryer rack, making sure pieces don't touch. Brush tops of chicken with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry chicken at 375 degrees F (190 degrees C) until cooked through and crisp, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
