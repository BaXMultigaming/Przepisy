  "ingredients": [
    "1 (6 ounce) can pink salmon, drained",
    "0.5 cup Greek yogurt",
    "0.25 cup chopped celery",
    "1 tablespoon Dijon mustard",
    "0.5 teaspoon lemon juice",
    "0.25 teaspoon garlic powder",
    "0.125 teaspoon salt",
    "0.125 teaspoon ground black pepper",
