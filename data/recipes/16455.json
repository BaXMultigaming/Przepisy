  "ingredients": [
    "cooking spray",
    "8 large potatoes, peeled and sliced",
    "14 slices Cheddar cheese",
    "0.5 cup all-purpose flour",
    "salt and pepper to taste",
    "1 cup skim milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13 casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange a layer of potatoes in the bottom of the prepared casserole dish. Cover with a layer of cheese, then dust with some flour. Season with salt and pepper. Repeat the layering process with remaining potatoes, cheese, and flour. Pour milk over the top. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are fork tender, about 45 minutes. Remove foil and continue baking until cheese is bubbly and begins to brown, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
