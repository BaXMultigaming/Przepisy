        "https://www.allrecipes.com/thmb/8l9uqc4_4ll4wSRIdl8ALp3TmJM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/1638795-7bc736c3d00341feb77059cce0d0d8af.jpg"
      ],
