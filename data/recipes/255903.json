  "ingredients": [
    "6 slices bacon",
    "1 (16.3 ounce) can refrigerated biscuit dough",
    "6 eggs",
    "0.5 cup Borden® Cheddar and Monterey Jack Shreds",
    "3 tablespoons Borden® Cheddar and Monterey Jack Shreds, for topping"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Crumble or chop into small pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate 6 biscuits into 2 rounds each. Press rounds into 12 cups of a muffin tin, pressing up sides to form biscuit dough cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix eggs, bacon pieces, and 1/2 cup shredded cheese together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill muffin pan biscuits with egg mixture about 3/4 full. Sprinkle remaining 3 tablespoons cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until egg mixture is set, 18 to 22 minutes. Let cool 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
