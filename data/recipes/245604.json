  "ingredients": [
    "4 cups whole wheat flour",
    "4 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground ginger",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon ground black pepper",
    "1 cup butter",
    "1 cup white sugar",
    "0.5 cup brown sugar",
    "0.25 cup molasses",
    "1 teaspoon grated orange zest",
    "6 medium eggs"
  ],
  "steps": [
    {
      "text": "Preheat pizzelle baker according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix whole wheat flour, baking powder, cinnamon, ginger, allspice, cloves, and black pepper together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Remove from heat. Stir white sugar, brown sugar, molasses, and orange zest into saucepan until well-combined. Add 1/2 of the flour mixture, stirring until smooth. Add eggs; mix until smooth. Stir in remaining flour mixture, mixing until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of batter onto the preheated pizzelle baker. Bake until browned, about 1 1/2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
