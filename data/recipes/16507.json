  "ingredients": [
    "2 cups white sugar",
    "1 cup vegetable oil",
    "3 eggs",
    "2 teaspoons vanilla extract",
    "2 cups grated zucchini",
    "1 cup crushed pineapple",
    "3 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "0.75 teaspoon ground nutmeg",
    "0.25 teaspoon baking powder",
    "1 cup raisins",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, oil, eggs, and vanilla together in a bowl with an electric mixer until thick; stir in zucchini and pineapple. Stir in flour, baking soda, cinnamon, salt, nutmeg, and baking powder until incorporated; fold in raisins and walnuts. Divide batter among the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour. Cool in the pans for 10 minutes before removing from pans and transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
