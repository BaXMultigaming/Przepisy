  "ingredients": [
    "6 pork chops",
    "2 tablespoons steak seasoning",
    "1 (12 fluid ounce) can or bottle beer",
    "1 (18 ounce) bottle barbeque sauce",
    "2 onions, sliced"
  ],
  "steps": [
    {
      "text": "Sprinkle pork chops with steak seasoning. Brown both sides in a skillet, then transfer to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour beer into the skillet and stir until all browned bits have been incorporated. Pour in barbecue sauce, then add pork chops and onions. Reduce the heat to low, cover, and simmer for 1 to 2 hours. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C).",
