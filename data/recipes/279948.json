  "ingredients": [
    "1 cup sourdough starter",
    "1 cup plain yogurt",
    "1 cup all-purpose flour",
    "1 tablespoon brown sugar",
    "1 egg",
    "0.25 cup butter, melted and cooled",
    "1 teaspoon vanilla extract",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Combine sourdough starter and yogurt in a bowl; stir in flour and brown sugar, stirring continuously until well combined. Cover batter; rest in the refrigerator, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a large bowl; add melted butter and vanilla extract. Stir in baking soda and salt. Add sourdough mixture; stir until batter is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into waffle iron and cook until golden brown, about 3 minutes per waffle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
