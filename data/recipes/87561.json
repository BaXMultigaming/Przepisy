  "ingredients": [
    "1 large cucumber, chopped",
    "2 roma (plum) tomatoes, chopped",
    "1 (5 ounce) jar pitted kalamata olives",
    "1 (4 ounce) package feta cheese, crumbled",
    "1 red onion, halved and thinly sliced",
    "0.5 (10 ounce) package baby greens",
    "0.5 (10 ounce) package romaine lettuce leaves",
    "6 tablespoons olive oil",
    "1 teaspoon garlic powder",
    "1 teaspoon dried oregano",
    "1 teaspoon dried basil",
    "1 teaspoon Dijon mustard",
    "1 teaspoon lemon juice",
    "1.5 cups red wine vinegar"
  ],
  "steps": [
    {
      "text": "In a large bowl, mix the cucumber, tomatoes, olives, feta cheese, red onion, baby greens, and romaine. In a separate bowl, mix the olive oil, garlic powder, oregano, basil, mustard, lemon juice, and red wine vinegar. Pour dressing over the vegetables, and toss to coat.",
