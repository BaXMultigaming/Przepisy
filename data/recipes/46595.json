  "ingredients": [
    "1.5 cups warm water (110 degrees F/45 degrees C)",
    "1 teaspoon white sugar",
    "1 tablespoon active dry yeast",
    "1 tablespoon olive oil",
    "1 teaspoon salt",
    "2 cups whole wheat flour",
    "1.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Pour warm water into a large bowl; stir in sugar to dissolve. Sprinkle yeast on top and let stand until foamy, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GJLaW3dFx0DUKTkO44b2l77W26U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46595-amazing-whole-wheat-pizza-crust-step-1-BP-3040-345a66cfeae74b0bb5b232fd9de35a0b.jpg"
      ],
      "image": "assets/images/46595/step_01.webp"
    },
    {
      "text": "Stir olive oil and salt into yeast mixture; mix in whole wheat flour and 1 cup all-purpose flour until dough starts to come together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SrM2mRBynBn1jPr9R0fgTvzinv4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46595-amazing-whole-wheat-pizza-crust-step-2-BP-3044-4e1d932c86fd4033b08aed8794e57af3.jpg"
      ],
      "image": "assets/images/46595/step_02.webp"
    },
    {
      "text": "Turn dough out onto a surface floured with remaining all-purpose flour; knead until all of the flour has been absorbed and dough becomes smooth, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G84fo1J7Ht1U79FRFOO-VrQXQWE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46595-amazing-whole-wheat-pizza-crust-step-3-BP-3047-e0d52ad6a15f436d98095d0b5fc932ed.jpg"
      ],
      "image": "assets/images/46595/step_03.webp"
    },
    {
      "text": "Place dough in an oiled bowl and turn to coat the surface. Cover loosely with a towel; let stand in a warm place until doubled in size, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VrICWSUkRTfeAudw_a5yl9gMppo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46595-amazing-whole-wheat-pizza-crust-step-4-BP-3048-a40156bcb983422190cbaa6719774c5b.jpg"
      ],
      "image": "assets/images/46595/step_04.webp"
    },
    {
      "text": "Turn dough out onto a lightly floured surface; divide into 2 pieces for 2 thin crusts, or leave whole to make one thick crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into a tight ball; place dough back into an oiled bowl and turn to coat the surface. Cover loosely with a towel; let stand in a warm place until doubled in size, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a large pizza pan. Roll a ball of dough with a rolling pin until it will not stretch any further. Then, drape it over both of your fists, and gently pull the edges outward, while rotating crust. When the circle has reached the desired size, place on the prepared pizza pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pTE6zVLACKG1pyRv_9gxnw8qR4g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46595-amazing-whole-wheat-pizza-crust-step-8-BP-3082-6cabaacda02e4039bdc69aa6e4dff176.jpg"
      ],
      "image": "assets/images/46595/step_07.webp"
    },
    {
      "text": "Bake with sauce, cheese and toppings.",
