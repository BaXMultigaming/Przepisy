  "ingredients": [
    "3 tablespoons olive oil",
    "2 tablespoons balsamic vinegar",
    "1 tablespoon lemon juice",
    "1 tablespoon Greek seasoning",
    "2 teaspoons kosher salt",
    "0.5 teaspoon freshly ground black pepper",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon ground thyme",
    "4 large russet potatoes, peeled and diced into 1-inch cubes",
    "3 ounces crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine olive oil, balsamic vinegar, lemon juice, Greek seasoning, salt, pepper, garlic powder, oregano, and thyme in a large plastic bag or bowl. Add potatoes and shake until potatoes are coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place into a baking dish that's large enough to accommodate potatoes in a single, snug layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 minutes, stirring every 10 minutes. Top with feta cheese. Return to the oven and bake for another 5 minutes. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
