  "steps": [
    {
      "text": "Spread caramel topping into graham crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together milk and pudding mix in a large bowl for 2 minutes; let stand for 5 minutes. Stir in whipped topping and toffee. Spoon over caramel in crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pie in the freezer until set, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To serve, let pie sit at room temperature to remove chill before cutting, about 15 minutes. Store any leftovers in the refrigerator.",
      "section": null,
