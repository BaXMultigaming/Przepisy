  "ingredients": [
    "1.75 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup milk",
    "1 cup shredded unpeeled zucchini",
    "0.25 cup butter, melted",
    "1 egg, lightly beaten",
    "1 clove garlic, minced",
    "0.75 cup shredded Cheddar cheese",
    "0.25 cup freshly grated Parmesan cheese",
    "4 slices bacon, cooked crisp and crumbled"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, baking soda, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk, zucchini, butter, egg, and garlic together in a separate bowl until well blended. Mix flour mixture into milk mixture, ½ cup at a time, stirring well after each addition, until the flour mixture is incorporated. Fold in Cheddar, Parmesan, and crumbled bacon: pour batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 30 to 35 minutes. Cool slightly before removing from muffin cups. Serve warm; refrigerate leftovers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
