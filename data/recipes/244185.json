  "ingredients": [
    "2 cups heavy whipping cream",
    "0.75 cup white sugar",
    "4 egg yolks",
    "1.5 cups whole freshly roasted coffee beans",
    "1 cup whole milk",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Place the bowl of ice cream maker in the freezer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream, sugar, and egg yolks in a saucepan; cook and stir over medium-low heat until mixture is heated through but not boiling, 10 to 15 minutes. Remove saucepan from heat and add coffee beans. Transfer cream mixture to a bowl and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain coffee beans out of cream mixture. Stir milk, vanilla extract, and salt into cream mixture; transfer to bowl of ice cream maker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Process cream mixture in the ice cream maker according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
