  "ingredients": [
    "1 cup packed brown sugar",
    "3 tablespoons butter",
    "0.25 cup heavy cream",
    "1 teaspoon vanilla extract",
    "3 tablespoons peanut butter, or to taste",
    "2 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Combine brown sugar, butter, cream, vanilla, and peanut butter in a large sauce pan. Bring to a boil over medium-high heat, stirring frequently. Remove from heat and add confectioners' sugar and mix well. Pour over a cooled cake and spread frosting quickly.",
