    "0.66666668653488 cup dark brown sugar",
    "3.5 tablespoons rum",
    "1.5 teaspoons vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "3 bananas, peeled and sliced lengthwise and crosswise",
