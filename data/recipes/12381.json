  "ingredients": [
    "1 recipe pastry for a 9 inch single crust pie",
    "2 cups semisweet chocolate chips",
    "3 eggs",
    "0.125 teaspoon salt",
    "0.66670000553131 cup packed brown sugar",
    "1.5 cups chopped pecans",
    "12 pecan halves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Over hot, not boiling, water melt 1 cup chocolate chips. Remove from heat, and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, beat the eggs and salt; beat with an electric mixer at high speed until very thick and lemon colored, about 5 minutes. Gradually beat in the brown sugar and melted chocolate. Stir in chopped pecans and remaining 1 cup chocolate morsels. Pour filling into the unbaked pie crust. Decorate top with pecan halves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
