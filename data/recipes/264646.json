  "ingredients": [
    "1 cucumber, diced",
    "2 Roma tomatoes, diced",
    "0.5 medium red onion, diced",
    "2 serrano peppers, seeded and deveined",
    "0.25 cup chopped cilantro",
    "6 medium limes, divided",
    "1.5 teaspoons salt, divided",
    "0.5 teaspoon ground black pepper to taste",
    "0.5 pound raw shrimp, peeled and deveined",
    "1 small avocado, diced"
  ],
  "steps": [
    {
      "text": "Combine cucumber, tomatoes, red onion, serrano peppers, and cilantro in a bowl. Add 1 teaspoon salt and squeeze 1 lime. Gently mix and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Squeeze the remaining limes into another bowl. Add remaining salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a 1- to 2-quart pot of water to a boil. Place shrimp into the boiling water for 45 seconds. Quickly remove from the water using a strainer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chop the partially cooked shrimp into small pieces and add to the bowl with the seasoned lime mixture. Let sit for 20 minutes. Combine with the cucumber mixture and top with avocados.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
