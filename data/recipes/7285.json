  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "3 eggs",
    "1 (21 ounce) can apple pie filling",
    "0.5 cup applesauce"
  ],
  "steps": [
    {
      "text": "Stir pie filling, cake mix, eggs, and applesauce together in a bowl until moist. Pour into a microwave-safe Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on high for 13 minutes, turning halfway through if your microwave doesn't have a carousel. Remove from the microwave and cover the bowl with a plate. Let stand until the cooking process is finished, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Invert cake onto the plate and serve.",
      "section": null,
