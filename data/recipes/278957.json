  "ingredients": [
    "0.25 cup brown sugar",
    "0.25 cup finely chopped walnuts",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup unsalted butter, softened",
    "0.5 cup white sugar",
    "2 large eggs",
    "1 cup sour cream",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease or line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, walnuts, and cinnamon in a bowl for the filling/topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, sugar, and eggs together in a large bowl with an electric mixer on medium speed until creamy. Add sour cream and vanilla extract and combine well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, baking soda, and salt together in a small bowl. Add to the butter mixture and combine well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon 1 tablespoon of batter into each prepared muffin cup. Sprinkle 1 teaspoon of filling mixture in the middle of each muffin and top with 1 tablespoon of batter. Sprinkle remaining walnut mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 25 minutes. Remove from the pan and cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
