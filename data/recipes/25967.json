  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "0.25 cup white sugar",
    "3 eggs",
    "1 (8 ounce) package cream cheese, room temperature",
    "0.5 cup vegetable oil",
    "1 teaspoon vanilla extract",
    "1.25 cups blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 10-inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cake mix and sugar together in a large bowl. Make a well in the center; add eggs, cream cheese, oil, and vanilla. Beat on low speed until blended. Scrape down the sides of the bowl; beat on medium speed for 4 minutes. Stir in blueberries. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 40 to 45 minutes. Let cool in pan for 10 minutes, then turn out onto a wire rack and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
