  "ingredients": [
    "1 pound ground turkey sausage",
    "4 eggs, lightly beaten",
    "4 green onions, finely chopped",
    "1 (16 ounce) package frozen hash brown potatoes",
    "0.5 cup milk",
    "1.5 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Place turkey sausage in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together eggs, green onions, hash browns, milk, Cheddar cheese, and cooked sausage. Pour mixture into a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
