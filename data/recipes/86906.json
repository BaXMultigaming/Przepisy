  "ingredients": [
    "1 large head cauliflower, cut into florets",
    "salt and pepper to taste",
    "2 medium tomatoes, sliced",
    "0.5 cup butter, melted",
    "8 ounces Swiss cheese, shredded"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cauliflower in a microwave-safe baking dish with just enough water to cover bottom of dish. Cook in the microwave on High for 5 minutes, or until slightly tender. Drain, and season with salt and pepper. Arrange tomato slices around the cauliflower. Drizzle cauliflower and tomatoes evenly with melted butter, and top with cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 40 minutes in the preheated oven, until cheese is bubbly.",
