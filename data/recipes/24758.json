  "ingredients": [
    "1 pound bacon",
    "2 (28 ounce) cans baked beans",
    "1 (12 ounce) bottle chili sauce",
    "1 large sweet onion, chopped",
    "2 cups packed brown sugar"
  ],
  "steps": [
