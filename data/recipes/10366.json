  "ingredients": [
    "1.5 cups butter",
    "1.5 cups shortening",
    "1.5 cups white sugar",
    "1.5 cups confectioners' sugar",
    "4.5 teaspoons vanilla extract",
    "3 eggs",
    "6.75 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "1.5 teaspoons cream of tartar",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Cream butter, shortening and sugars until light and fluffy. Beat in eggs and vanilla. Sift dry ingredients, add to creamed mixture; mix to blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 1 inch balls. Dip in regular or colored sugar or decorator sprinkles. Place on lightly greased cookie sheet. Flatten slightly with the bottom of a water glass.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 10-12 minutes. *Larger cookies bake at 350 degrees F (175 degrees C) for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
