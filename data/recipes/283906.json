  "ingredients": [
    "1 cup frozen sliced strawberries",
    "0.5 medium red onion, chopped",
    "0.5 cup white wine vinegar",
    "0.25 cup white sugar",
    "1 cup avocado oil",
    "0.5 tablespoon poppy seeds"
  ],
  "steps": [
    {
      "text": "Place strawberries, red onion, vinegar, and sugar in a blender; slowly pour in avocado oil in a slow steady stream with the blender running until smooth and emulsified, 10 to 15 seconds. Add poppy seeds; pulse to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer dressing to an airtight container; cover. Chill in the refrigerator before serving, 3 hours.",
