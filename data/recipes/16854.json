  "ingredients": [
    "4 apples - peeled, cored and sliced",
    "0.5 cup brown sugar",
    "1 cup all-purpose flour",
    "0.75 cup white sugar",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "1 egg, beaten",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 9 inch square baking pan, mix sliced apples with brown sugar. In a large bowl, mix together flour, white sugar, cinnamon and salt. In a small bowl, beat together egg and melted butter. Stir into flour mixture. Spread evenly over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 to 40 minutes, or until topping is golden and crisp.",
      "section": null,
      "name": null,
      "url": null,
