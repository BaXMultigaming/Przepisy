  "ingredients": [
    "cooking spray",
    "2 pounds flounder fillets, rinsed and patted dry",
    "0.25 teaspoon salt",
    "3 tablespoons lemon juice, divided",
    "0.5 cup grated Parmesan cheese",
    "0.25 cup butter, melted",
    "3 tablespoons mayonnaise",
    "3 tablespoons chopped green onions"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 9x13-inch baking dish with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season flounder fillets on both sides with salt. Place into the prepared baking dish and brush with 1 tablespoon lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Parmesan, melted butter, mayonnaise, green onions, and remaining 2 tablespoons lemon juice together in a bowl. Spoon mixture over fillets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Turn on the broiler and broil until fillets are just browned on top, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
