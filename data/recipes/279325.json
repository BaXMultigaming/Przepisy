  "ingredients": [
    "1.5 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1 cup white sugar",
    "0.5 cup oil",
    "2 eggs, at room temperature",
    "0.5 teaspoon vanilla extract",
    "2 cups grated apples",
    "0.5 cup chopped nuts",
    "0.5 cup white sugar",
    "2 tablespoons ground cinnamon",
    "2 tablespoons all-purpose flour",
    "0.25 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, cinnamon, and salt in a bowl. Add sugar, oil, eggs, and vanilla extract. Add shredded apples and chopped nuts. Mix until combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the streusel: Mix sugar, cinnamon, and flour together in a bowl. Cut in butter until mixture is crumbly. Place 1/2 of the streusel on the bottom of the prepared loaf pan. Pour in batter and top with remaining streusel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 60 to 75 minutes. Cool on a wire rack for 10 minutes before removing from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
