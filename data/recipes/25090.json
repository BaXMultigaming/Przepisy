  "title": "Jammin Good Bars",
  "description": "Sweet and simple little bar cookies with a tasty layer of raspberry preserves through the middle.",
  "authors": [
    "Mary Yamasaki"
  ],
  "date_published": "2020-06-18T23:05:59-04:00",
