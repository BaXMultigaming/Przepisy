  "ingredients": [
    "0.5 cup butter",
    "2 tablespoons ground turmeric",
    "2 teaspoons cumin seed",
    "1 green chile pepper, seeded and diced",
    "2 cloves garlic, chopped",
    "1 pound chopped fresh mustard greens",
    "1 pound chopped fresh spinach",
    "1 teaspoon ground cumin",
    "1 teaspoon ground coriander",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet or wok over medium-high heat; cook and stir turmeric, cumin seed, chile pepper, and garlic until fragrant, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t963mcwpnDJZq4-mlU7WHf7MZR8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/64066-IndianSaag-mfs-step1-0307-c3e53aef429b4c7181ccbf9349620ea8.jpg"
      ],
      "image": "assets/images/64066/step_01.webp"
    },
    {
      "text": "Stir in chopped mustard greens and spinach a little at a time, adding the tougher stems and thicker leaves first. Cook and stir until greens are thoroughly wilted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oPkFDcqS0nakpCAqjzthcJSn2gI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/64066-IndianSaag-mfs-step2-0309-528f842df9fd41b883d0b94b267c812d.jpg"
      ],
      "image": "assets/images/64066/step_02.webp"
    },
    {
      "text": "Stir in ground cumin, coriander, and salt. Cover, reduce heat, and simmer until greens are tender, about 10 minutes; add water as needed to keep greens moist.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GvWVTt3WKlAqigeRl6JaGaddwb4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/64066-IndianSaag-mfs-step3-0312-84cf954ac4da474db7b89d2545fc5ff9.jpg"
      ],
