  "ingredients": [
    "0.25 cup peanut oil for frying",
    "2 tablespoons butter",
    "3 yellow plantains (very ripe), peeled and cut in 1-inch-thick slices",
    "3 tablespoons brown sugar",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Round up all your ingredients, and heat peanut oil and butter in a large skillet over medium-high heat until butter begins to sizzle.",
      "section": null,
      "name": null,
      "url": null,
