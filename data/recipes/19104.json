  "ingredients": [
    "cooking spray",
    "all-purpose flour for dusting",
    "2 cups milk",
    "1 (3.4 ounce) package non-instant chocolate pudding mix",
    "1 (15.25 ounce) package devil's food cake mix",
    "1 cup semi-sweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk and non-instant pudding mix in a saucepan. Cook over medium heat, stirring constantly, until pudding is thickened. Remove the pan from heat and stir in cake mix until batter is smooth. Pour into the prepared baking dish. Sprinkle with chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of cake comes out clean, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
