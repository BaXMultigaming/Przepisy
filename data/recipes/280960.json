  "ingredients": [
    "1 cooking spray (such as Pam®)",
    "0.33333334326744 cup light vanilla soy milk",
    "2 tablespoons lemon juice, divided",
    "2 cups whole wheat flour",
    "1 teaspoon ground cinnamon",
    "0.75 teaspoon baking soda",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon salt",
    "3 ripe bananas, mashed",
    "0.5 teaspoon vanilla extract",
    "0.5 cup agave nectar",
    "1.25 cups fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x5-inch loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix soy milk and 1 tablespoon lemon juice in a bowl and stir. Let sit until curdled, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix whole wheat flour, cinnamon, baking soda, baking powder, and salt together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mashed bananas with remaining lemon juice and vanilla extract in a large bowl. Add soy milk mixture and agave nectar syrup. Stir well. Add flour mixture until combined, but don't overmix. Mix in blueberries until dispersed. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 to 60 minutes. Cool bread before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
