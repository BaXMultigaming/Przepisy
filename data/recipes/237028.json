  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup whole wheat flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "1 teaspoon cinnamon",
    "1.25 cups vegetable oil",
    "1.5 cups white sugar",
    "0.5 cup brown sugar",
    "3 eggs",
    "1 teaspoon vanilla",
    "4 apples, thinly sliced",
    "1.5 cups finely chopped walnuts",
    "1 cup brown sugar",
    "0.5 cup butter",
    "0.25 cup milk",
    "0.5 cup finely chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make cake: Whisk together all-purpose flour, whole wheat flour, baking soda, baking powder, salt, and cinnamon in a large bowl until well combined. Whisk together oil, white sugar, brown sugar, eggs, and vanilla in a separate bowl until well combined. Stir flour mixture into sugar mixture; fold in apples and walnuts until evenly distributed. Pour batter into a 10x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake is set, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "A few minutes before cake is done baking, make topping: Stir together brown sugar, butter, and milk in a large microwave-safe bowl. Microwave on high until sugar is dissolved and mixture boils, about 2 minutes and 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cake from the oven and pierce surface in several places with a large fork. Sprinkle walnuts over hot cake and pour brown sugar mixture over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
