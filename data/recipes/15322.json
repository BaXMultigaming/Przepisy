  "title": "Fruit Cocktail Drop Cookies",
  "description": "A flavorful cookie with fruit and nuts. Great for a picnic!",
  "authors": [
    "Judy Sommavilla"
  ],
  "date_published": "1999-04-11T15:32:07-04:00",
