  "ingredients": [
    "1 cup finely chopped red onion",
    "1 jalapeno pepper, seeded and finely chopped - or more to taste",
    "2 limes, juiced",
    "2.5 cups Roma (plum) tomatoes, seeded and chopped",
    "0.5 cup chopped fresh cilantro",
    "1 teaspoon salt"
