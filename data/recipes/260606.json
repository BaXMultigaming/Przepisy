  "ingredients": [
    "0.25 cup mayonnaise",
    "0.25 cup extra-virgin olive oil",
    "2 tablespoons medium-chain triglyceride (MCT) oil",
    "2 tablespoons lemon juice",
    "1 tablespoon Dijon mustard",
    "2 cloves garlic, peeled and crushed",
    "1 pinch Himalayan pink salt",
    "ground black pepper to taste",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Combine mayonnaise, olive oil, MCT oil, lemon juice, Dijon mustard, and garlic in a jar. Season with salt and pepper. Add chopped parsley; close the jar tightly with a lid and shake until well mixed.",
