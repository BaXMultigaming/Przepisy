  "ingredients": [
    "1 (8 ounce) package wide egg noodles",
    "2 cups small curd cottage cheese",
    "1.5 cups sour cream",
    "0.5 cup white sugar",
    "0.5 cup raisins",
    "3 large eggs, beaten",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground cinnamon",
    "0.125 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kNDFFJk7VfnDttyxR2Kc3uw4xB4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/285980-sweet-noodle-kugel-DDMFS-018-4x3-step-01-569d1af1747d47fdb1584854b71e556f.jpg"
      ],
      "image": "assets/images/285980/step_01.webp"
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pHgVRpFv1O9GkuKorITy57UjM8I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/285980-sweet-noodle-kugel-DDMFS-018-4x3-step-02-ddc64bfa5bae4daf98003aee1abc9c2d.jpg"
      ],
      "image": "assets/images/285980/step_02.webp"
    },
    {
      "text": "Mix cottage cheese, sour cream, sugar, raisins, eggs, salt, cinnamon, and nutmeg together in a large bowl. Mix in cooked noodles. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pzpmLmQpdOkUwSVRf4MwysaAZ6U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/285980-sweet-noodle-kugel-DDMFS-022-4x3-step-03-8c7eee76ed10422a81ec0635177b3b82.jpg"
      ],
      "image": "assets/images/285980/step_03.webp"
    },
    {
      "text": "Bake, uncovered, in the preheated oven, until golden brown on top, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
