  "ingredients": [
    "1 pound whole turkey ham",
    "1 cup baby carrots",
    "4 large red potatoes, cubed",
    "6 cloves garlic",
    "0.5 head cabbage, cut into 6 wedges",
    "2 cups low-sodium chicken broth, as needed",
    "12 pearl onions"
  ],
  "steps": [
    {
      "text": "Arrange a bed of baby carrots and red potatoes in a slow cooker; place turkey ham flat-side down on top. Add garlic cloves and place cabbage wedges over turkey ham. Pour in enough chicken broth to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 8 hours; stir in pearl onions and continue to cook until onions are tender, about 30 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
