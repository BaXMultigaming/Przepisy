  "title": "Spinach Quiche",
  "description": "This spinach quiche packs lots of veggies, plus herbed feta and Cheddar in a deep-dish pie crust for cheesy deliciousness in every bite.",
  "authors": [
    "Bailey"
  ],
  "date_published": "2000-03-04T08:45:39-05:00",
