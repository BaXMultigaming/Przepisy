  "ingredients": [
    "0.5 cup butter",
    "1 small onion, chopped",
    "3 cloves garlic, chopped",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "1 (4.5 ounce) can mushrooms, drained",
    "1 (6 ounce) package herb and garlic feta, crumbled",
    "1 (8 ounce) package shredded Cheddar cheese, divided",
    "salt and pepper to taste",
    "1 deep-dish pie shell",
    "4 eggs",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WaVx_GmbNMm1qwPR634vYE1BkQw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16664-Spinach-Quiche-DDMFS-Step-01a-6f1337a833f640609dd7fc19b8909028.jpg"
      ],
      "image": "assets/images/16664/step_01.webp"
    },
    {
      "text": "Melt butter in a medium skillet over medium heat. Add onion and garlic and saute until lightly browned, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9RqcYolbpTIGDzMJitnAhYiFfzY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16664-Spinach-Quiche-DDMFS-Step-01b-9fa59a6ab7f14b378386a6f6e1def0f5.jpg"
      ],
      "image": "assets/images/16664/step_02.webp"
    },
    {
      "text": "Stir in spinach, mushrooms, feta, and 1/2 cup Cheddar. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sgYhzT5D55ayhW67PJpwBCmEqM4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16664-Spinach-Quiche-DDMFS-Step-02-fc12b2f5c58d4fd1941fc2450a294805.jpg"
      ],
      "image": "assets/images/16664/step_03.webp"
    },
    {
      "text": "Spoon mixture into prepared pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/msXu987Zx212OFIWtsnwocxozPc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16664-Spinach-Quiche-DDMFS-Step-03-173daba61b1b4cb584438b012a391f16.jpg"
      ],
      "image": "assets/images/16664/step_04.webp"
    },
    {
      "text": "Whisk eggs and milk together in a medium bowl until combined. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bGJIOGzGkmklD8YgC1h5wWxkMNk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16664-Spinach-Quiche-DDMFS-Step-04-b45aae195ec341219bcf2038543341ce.jpg"
      ],
      "image": "assets/images/16664/step_05.webp"
    },
    {
      "text": "Pour over the spinach mixture in pie crust, allowing egg mixture to thoroughly combine with spinach mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jNIHv6BzkBQel7HT3ylHhlcHRQI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16664-Spinach-Quiche-DDMFS-Step-05-99e58a9288bd4a84b2fe1e7da1b9f6c0.jpg"
      ],
      "image": "assets/images/16664/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w7QvtI3mwReWC21IHEU3JqzPY7g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16664-Spinach-Quiche-DDMFS-Step-06-f7d0f59bd04f4897920f7384190305fd.jpg"
      ],
      "image": "assets/images/16664/step_07.webp"
    },
    {
      "text": "Sprinkle the top with remaining Cheddar and bake until set in center, 35 to 40 minutes longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gkfHo8FcRs9rrzcr6-iFhWiX2Ho=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16664-Spinach-Quiche-DDMFS-Step-07-dd4686d5deef44a09ccd2122629bc18a.jpg"
      ],
      "image": "assets/images/16664/step_08.webp"
    },
    {
      "text": "Allow to cool briefly before slicing and serving, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6aGLP48yB39H8v4HvLC4X_K5gZM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16664-Spinach-Quiche-DDMFS-4x3-495a9566ad664c69827bb81f24c44072.jpg"
      ],
      "image": "assets/images/16664/step_09.webp"
    }
