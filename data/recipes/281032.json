  "ingredients": [
    "5 cups crushed and strained tomatoes (such as Aurora®)",
    "1 teaspoon dried basil",
    "1 teaspoon dried parsley",
    "1 teaspoon dried oregano",
    "1 teaspoon salt",
    "1 pinch red pepper flakes",
    "ground black pepper to taste",
    "1 pound lean ground chicken",
    "1 large egg",
    "0.5 cup fresh bread crumbs",
    "0.5 cup finely grated Parmesan cheese",
    "0.25 cup grated onion",
    "2 tablespoons olive oil",
    "1 tablespoon chopped fresh parsley",
    "1 large clove garlic, minced",
    "0.5 teaspoon salt",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Prepare the sauce by whisking tomatoes, basil, parsley, oregano, salt, red pepper flakes, and black pepper in a slow cooker. Adjust heat to High.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground chicken, egg, bread crumbs, Parmesan cheese, onion, olive oil, parsley, garlic, salt, and pepper in a medium bowl. Use your hands to gently mix together. Roll into 1 1/2-inch balls and place into the sauce. Use a spoon to cover the meatballs with sauce; do not stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the lid on the slow cooker and drape a thick kitchen towel over it. Cook on High for 2 1/2 hours until meatballs are cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
