  "ingredients": [
    "4 carrots, chopped",
    "2 potatoes, peeled and cubed",
    "1 cup sliced fresh mushrooms",
    "1 onion, chopped",
    "3 stalks celery, chopped",
    "3 pounds cubed stew meat",
    "1 packet dry onion soup mix",
    "1 (10.75 ounce) can condensed golden mushroom soup",
    "1.75 cups water"
  ],
  "steps": [
    {
      "text": "Place carrots, potatoes, mushrooms, onion, and celery in the slow cooker. Place stew meat over vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine soup mix with can of soup. Add water and mix together well. Pour this in the slow cooker over meat and vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add water as needed so that liquid comes just to the bottom of meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low setting overnight, adding more water as necessary in the morning. Continue cooking all day to reach 24 hours total.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
