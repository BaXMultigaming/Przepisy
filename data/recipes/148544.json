  "ingredients": [
    "1 (5 pound) bone-in pork shoulder roast",
    "1 tablespoon kosher salt",
    "0.5 teaspoon ground black pepper, or to taste",
    "1.5 cups apple cider vinegar",
    "2 tablespoons brown sugar",
    "1.5 tablespoons hot pepper sauce",
    "2 teaspoons cayenne pepper",
    "2 teaspoons crushed red pepper flakes"
  ],
  "steps": [
    {
      "text": "Place pork shoulder into a slow cooker and season with salt and pepper. Pour vinegar around the pork. Cover, and cook on Low for 12 hours. Pork should easily pull apart into strands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N4NSn7QWwAC1zWV3r5Cqrdc9mhY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/148544_slowcookercarolinabbq_ddmfs_step1_4x3_2661-52766e6cc49f44f5a7d31c7b15fb194a.jpg"
      ],
      "image": "assets/images/148544/step_01.webp"
    },
    {
      "text": "Remove pork from the slow cooker and discard any bones. Strain off the liquid, reserving 2 cups (discard any extra). Shred pork using tongs or two forks, and return to the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bla5DG7kUJ6noVk7kIS-V_ZKgPg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/148544_slowcookercarolinabbq_ddmfs_step5_4x3_2665-36d6a31206684f3f9db9c4bda1248a0e.jpg"
      ],
      "image": "assets/images/148544/step_02.webp"
    },
    {
      "text": "Stir brown sugar, hot pepper sauce, cayenne pepper, and red pepper flakes into the reserved liquid. Mix into pork in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sx9dejYIe9JnRlhw9-QtMlnV-8E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/148544_slowcookercarolinabbq_ddmfs_step6_4x3_2668-e646a668142e4eacbf7c28dfad6312dc.jpg"
      ],
      "image": "assets/images/148544/step_03.webp"
    },
    {
      "text": "Cover and keep on Low setting until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HUHJyGCo82FqcW16bglwM9MAgnM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/148544_slowcookercarolinabbq_ddmfs_4x3_2693-0974f3c8b09f43c6858390f5267f1f8b.jpg"
