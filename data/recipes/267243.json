  "ingredients": [
    "3 tablespoons butter",
    "0.5 cup heavy cream",
    "1.5 cups freshly grated Parmesan cheese",
    "0.25 teaspoon garlic powder",
    "2 pinches freshly grated nutmeg, or to taste",
    "freshly ground black pepper to taste",
    "1 teaspoon chopped fresh parsley, or to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a heavy saucepan over medium heat. Slowly add cream, stirring until well combined, about 3 minutes. Add Parmesan cheese; cook and stir until well incorporated, about 3 minutes. Stir in garlic powder, nutmeg, and black pepper and cook for 2 minutes. Serve sprinkled with fresh parsley.",
