  "ingredients": [
    "6 eggs",
    "2 tablespoons mayonnaise",
    "1 teaspoon prepared Dijon-style mustard",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon ground cayenne pepper"
  ],
  "steps": [
    {
      "text": "Place eggs in a medium saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes. Remove from hot water, cool, and peel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice eggs in half lengthwise. Remove yolks and place in a medium bowl; set aside egg whites. Use a fork to mash egg yolks with mayonnaise, Dijon-style mustard, salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill hollowed egg white halves with yolk mixture. Sprinkle with cayenne pepper. Cover and chill in the refrigerator until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
