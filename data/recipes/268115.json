  "ingredients": [
    "2 cups milk",
    "1 cup heavy cream",
    "3 tablespoons white sugar",
    "2 teaspoons vanilla sugar",
    "4 teaspoons cornstarch, or more as needed",
    "0.25 teaspoon ground cinnamon, or to taste"
  ],
  "steps": [
    {
      "text": "Combine milk, cream, sugar, vanilla sugar, and cornstarch in a saucepan and whisk until well combined. Slowly bring to a boil over medium heat and cook, stirring constantly, until thickened and mixture coats the back of a spoon, 10 to 15 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour pudding into 4 dessert bowls and allow to cool to room temperature, about 30 minutes. Refrigerate until chilled, 1 more hour. Sprinkle with cinnamon to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
