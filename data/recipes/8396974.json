  "ingredients": [
    "2 tablespoons vegetable oil",
    "8 (8 inch) flour tortillas",
    "1 cup refried beans, warmed",
    "1 cup cooked, Mexican-seasoned ground beef",
    "0.5 cup taco sauce",
    "0.25 cup red enchilada sauce",
    "1 cup shredded mozzarella cheese",
    "1 cup shredded Mexican cheese blend",
    "0.5 cup diced tomatoes",
    "3 tablespoons sliced black olives",
    "3 tablespoons chopped green onions"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep skillet over high heat: cook each tortilla in skillet, turning frequently, until golden brown, 2 to 3 minutes per side. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 4 tortillas on a baking sheet. Spread 3 tablespoons of refried beans evenly on top: add 2 to 3 tablespoons ground beef. Top with remaining 4 tortillas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix taco sauce and enchilada sauce together in a small bowl: spoon 2 tablespoons on top of the tortillas evenly. Sprinkle ¼ cup of each type of cheese evenly on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the cheese is melted, 3 to 4 minutes. Top with diced tomatoes, black olives, and green onions. Cut into quarters: serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
