  "ingredients": [
    "1 (10 ounce) package frozen broccoli florets, thawed",
    "3 tablespoons butter, melted, or to taste",
    "salt and pepper to taste",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Place broccoli in a steamer over 1 inch of boiling water and cover. Cook until tender but still firm, 2 to 6 minutes. Drain and transfer to a microwave-safe casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour melted butter over broccoli and season with salt and pepper. Sprinkle cheese over the top and microwave on high until cheese is melted, about 1 minute.",
