  "ingredients": [
    "4 eggs",
    "1.5 cups packed brown sugar",
    "0.75 cup butter, melted",
    "2 teaspoons vanilla extract",
    "1.5 cups all-purpose flour",
    "1.5 cups whole wheat flour",
    "1 cup rolled oats",
    "1 tablespoon baking powder",
    "0.5 teaspoon baking soda",
    "1.5 teaspoons ground cinnamon",
    "0.25 teaspoon salt",
    "1.5 cups coarsely grated unpeeled pears"
  ],
  "steps": [
    {
      "text": "Stir together the flours, oats, baking powder, baking soda, cinnamon, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat the eggs. Gradually beat in the brown sugar until the mixture is thick. Beat in the melted butter or margarine and the vanilla. Beat flour mixture into the liquid mixture, and then stir in the grated pears. Turn the batter into a greased and floured tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (165 degrees C) for 70 minutes, or until it tests done with a toothpick. Transfer cake to a rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
