  "ingredients": [
    "1 egg white",
    "1 tablespoon water",
    "1 pound pecans",
    "0.75 cup white sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white with water in a large bowl until frothy. Stir in pecans and mix to coat. Combine sugar, cinnamon, and salt in a small bowl; stir into pecan mixture. Spread pecans on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, stirring every 15 minutes, in the preheated oven for 1 hour. Store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
