  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine black beans, corn, pumpkin, salsa verde, chicken, and 1 cup Mexican cheese in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place about 1/2 of the mixture evenly in the corn tortillas and roll up. Place rolled tortillas, seam-side down, in an 8x11-inch baking dish. Top tortillas with the remaining mixture and sprinkle with remaining cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and bubbling, about 35 minutes.",
