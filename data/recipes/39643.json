  "ingredients": [
    "1 pound bacon, cooked and crumbled",
    "0.5 cup mayonnaise",
    "0.25 cup green onions, chopped",
    "2 tablespoons chopped fresh parsley",
    "24 cherry tomatoes"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat for 6 to 8 minutes, or until evenly brown. Once cooled, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, stir together mayonnaise, bacon, green onions, and parsley until well blended. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut a small slice from the top of each tomato. Using a melon baller or small spoon, scoop out the inside of each tomato and discard. Fill each tomato with the bacon mixture, and refrigerate for 1 hour. Serve chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
