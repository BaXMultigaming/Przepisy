  "ingredients": [
    "0.66666668653488 cup butter, softened",
    "0.66666668653488 cup packed brown sugar",
    "2 large eggs",
    "1.5 cups rolled oats",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.25 cups dried cranberries",
    "0.66666668653488 cup coarsely chopped white chocolate"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar with an electric mixer in a large bowl until light and fluffy; beat in eggs one at a time. Combine oats, flour, baking soda, and salt; stir into butter mixture one cup at a time, mixing well after each addition. Stir in dried cranberries and white chocolate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 10 to 12 minutes. Cool on the baking sheet briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
