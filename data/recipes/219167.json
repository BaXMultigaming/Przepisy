  "ingredients": [
    "2 cups all-purpose flour",
    "2 tablespoons brown sugar",
    "1 tablespoon white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.5 cups milk",
    "1 cup pumpkin puree",
    "1 egg",
    "2 tablespoons lemon juice",
    "2 tablespoons vegetable oil",
    "2 teaspoons grated lemon zest",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground allspice",
    "1 teaspoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Combine flour, brown sugar, white sugar, baking powder, baking soda, and salt in a large bowl; whisk together until aerated, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin puree, egg, lemon juice, 2 tablespoons vegetable oil, lemon zest, cinnamon, ginger, and allspice in a second large bowl. Mix in flour mixture and stir just until batter is moistened. Do not overmix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat a large skillet with 1 teaspoon vegetable oil over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared skillet 1/4 cup at a time and cook until pancakes are golden brown, about 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
