  "ingredients": [
    "4 cups all-purpose flour",
    "0.5 teaspoon ground nutmeg",
    "0.5 cup white sugar",
    "0.75 cup light molasses",
    "1.25 teaspoons baking soda",
    "0.5 cup butter",
    "1.5 teaspoons ground cinnamon",
    "2 eggs",
    "0.5 teaspoon ground cloves",
    "0.33333334326744 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Stir together flour, sugar, baking soda, spices, and dash black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large saucepan, combine molasses and butter; heat and stir until butter melts. Cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in eggs. Add dry ingredients to molasses mixture; mix well. Cover. Chill several hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape into 1\" balls. Place on greased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (180 degrees C) for 12 to 14 minutes or until cookies are done. Remove. Cool. Roll in powdered sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
