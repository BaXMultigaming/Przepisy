  "ingredients": [
    "1 pound lean ground beef",
    "1 medium onion, chopped",
    "2 teaspoons minced garlic",
    "1 (29 ounce) can tomato sauce",
    "1 (6 ounce) can tomato paste",
    "1.5 teaspoons salt",
    "1 teaspoon dried oregano",
    "16 ounces shredded mozzarella cheese",
    "12 ounces cottage cheese",
    "0.5 cup grated Parmesan cheese",
    "1 (12 ounce) package lasagna noodles"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8vaLAy76WXDQPhmOq-5IyyTysMA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-202007-slow-cooker-lasagna-ddmfs-Step-1-ea669ec7f16b4f77be4538a66ed5a04e.jpg"
      ],
      "image": "assets/images/11959/step_01.webp"
    },
    {
      "text": "Cook ground beef, onion, and garlic in a large skillet over medium heat until the meat is browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7h4RpgidY4lEcuZU6udRCdgfjUg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-202007-slow-cooker-lasagna-ddmfs-Step-2-3639b986a7534f1a9f05312b31f21547.jpg"
      ],
      "image": "assets/images/11959/step_02.webp"
    },
    {
      "text": "Add tomato sauce, tomato paste, salt, and oregano and stir until well combined and heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZUBmJ-7BVK06aUnN65otvIy7Jbs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-202007-slow-cooker-lasagna-ddmfs-Step-3-2ea67a3657504d9c8c79e2b11c1c6414.jpg"
      ],
      "image": "assets/images/11959/step_03.webp"
    },
    {
      "text": "Stir mozzarella, cottage cheese, and Parmesan together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sQ5i5WQY1U5c8ut4O4a8MY5yNW0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-202007-slow-cooker-lasagna-ddmfs-Step-4-fac7c16184384b7898028f7466ae37e6.jpg"
      ],
      "image": "assets/images/11959/step_04.webp"
    },
    {
      "text": "Spoon a layer of the meat mixture onto the bottom of a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kpjXBumJF2r2s7QPc5qN317_eD8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-202007-slow-cooker-lasagna-ddmfs-Step-5-34c18194473e46e8b4583da53c9597c0.jpg"
      ],
      "image": "assets/images/11959/step_05.webp"
    },
    {
      "text": "Add a double layer of uncooked lasagna noodles, breaking noodles to fit into cooker as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eakB87RmWhWATjxn71-FjlmELfQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-202007-slow-cooker-lasagna-ddmfs-Step-6-8f8e35cf34fd470298a29564bf7118c8.jpg"
      ],
      "image": "assets/images/11959/step_06.webp"
    },
    {
      "text": "Top noodles with a portion of cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B6qcEfsUQ_0vmngJIadhtQEzJsc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-202007-slow-cooker-lasagna-ddmfs-Step-7-f2cd222d876c4f8b9d0c2632cbba75f3.jpg"
      ],
      "image": "assets/images/11959/step_07.webp"
    },
    {
      "text": "Repeat the layering of sauce, noodles, and cheese until all the ingredients are used.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e3jZW7dRuT7nztlWYc7LrYP_7gI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-202007-slow-cooker-lasagna-ddmfs-Step-9-a0c7960c2bf641f78ce3dd7d1156b763.jpg"
