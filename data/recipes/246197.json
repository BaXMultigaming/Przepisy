  "ingredients": [
    "1 pound ground beef",
    "0.5 onion, diced",
    "2 cups beef broth",
    "1 (15 ounce) can pinto beans, rinsed and drained",
    "1 (14.5 ounce) can diced tomatoes, undrained",
    "1 cup frozen corn",
    "1 (6 ounce) package Knorr® Fiesta Sides™ - Taco Rice",
    "1 tablespoon buttery spread",
    "0.5 cup shredded cheese, or more to taste",
    "0.5 cup sour cream, or more to taste"
  ],
  "steps": [
    {
      "text": "Heat a heavy pot over medium heat. Add ground beef and onion; cook and stir until beef is browned and crumbled and onion begins to turn translucent, about 5 minutes. Drain grease from pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add beef broth, beans, tomatoes, corn, and rice; stir in buttery spread and bring to a boil. Reduce heat, cover, and simmer until rice is tender, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let stand, off heat, at least 2 minutes, then stir. Top servings with cheese and sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
