  "ingredients": [
    "1 French baguette",
    "1 cup orange juice",
    "0.5 cup heavy whipping cream",
    "2 eggs",
    "1 teaspoon ground cinnamon",
    "0.25 cup white sugar",
    "1 dash ground nutmeg",
    "3 tablespoons butter",
    "2 tablespoons confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Cut loaf ends off and reserve for another use. Cut remaining loaf into 1 1/2 inch slices; let stand 4 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 9x13 inch baking pan, combine orange juice, cream, eggs ground cinnamon and white sugar. Place bread slices in pan and turn until liquid is absorbed, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, melt butter over medium heat. Add bread slices and cook until browned on both sides, about 5 minutes. Dust generously with confectioners' sugar and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
