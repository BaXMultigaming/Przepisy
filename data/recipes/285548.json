  "ingredients": [
    "1 cup pumpkin puree",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup white sugar",
    "0.5 teaspoon pumpkin pie spice",
    "1 (9 inch) prepared graham cracker crust",
    "0.5 (8 ounce) container whipped topping (such as Cool Whip®)"
  ],
  "steps": [
    {
      "text": "Blend pumpkin, cream cheese, sugar, and pie spice together in a bowl. Pour some of mixture into the pie crust until it is 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir whipped topping into the remaining pumpkin mixture. Pour into the pie crust, over the first layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate for at least 30 minutes, or until ready to serve.",
      "section": null,
