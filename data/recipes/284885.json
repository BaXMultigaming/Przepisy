  "title": "Blackstrap Molasses Cookies (Eggless)",
  "description": "These soft, chewy, blackstrap molasses cookies are made with whole wheat, ginger, and maple syrup, but contain no eggs.",
  "authors": [
    "Terri Driver"
  ],
  "date_published": "2012-01-07T14:31:35-05:00",
