  "ingredients": [
    "1 (8 ounce) package uncooked tri-color rotini pasta",
    "6 ounces pepperoni sausage, diced",
    "6 ounces provolone cheese, cubed",
    "1 medium red onion, very thinly sliced and cut into 1-inch pieces",
    "1 small cucumber, thinly sliced",
    "0.75 cup chopped green bell pepper",
    "0.75 cup chopped red bell pepper",
    "1 (6 ounce) can pitted black olives, drained",
    "0.25 cup minced fresh parsley",
    "0.25 cup grated Parmesan cheese",
    "0.5 cup olive oil",
    "0.25 cup red wine vinegar",
    "2 cloves garlic, minced",
    "1 teaspoon dried basil",
    "1 teaspoon dried oregano",
    "0.5 teaspoon ground mustard seed",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S0UyuXNdKJibEzMctISVIUCPDJ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/73963_PastaSaladWithHomemadeDressingRecipe_step1_mfs_0018-1-c07a6bb3d3ee4201b5fda2b52ff8f7d6.jpg"
      ],
      "image": "assets/images/73963/step_01.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add rotini and cook until tender yet firm to the bite, 8 to 10 minutes. Drain, rinse with cold water, and drain again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer drained, cooked pasta to a large bowl. Add pepperoni, provolone cheese, red onion, cucumber, bell peppers, olives, parsley, and Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cgFqBSJxjVNITOz87wwu42nD8Fo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/73963_PastaSaladWithHomemadeDressingRecipe_step2_mfs_0022-1-04412091a294464aa83677b03c7a25ee.jpg"
      ],
      "image": "assets/images/73963/step_03.webp"
    },
    {
      "text": "Mix olive oil, vinegar, garlic, basil, oregano, ground mustard, salt, and pepper for dressing in a jar with a lid. Seal the jar, and shake until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zrAnRlp05ZBTfJWN6hoHXzlBqSc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/73963_PastaSaladWithHomemadeDressingRecipe_step4_mfs_0028-1-7a459e6f70e54adc8189029ce977645b.jpg"
      ],
      "image": "assets/images/73963/step_04.webp"
    },
    {
      "text": "Pour dressing over the pasta salad; toss until well coated. Serve immediately, or cover and chill in the refrigerator for up to 8 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/91eDi0k4XyOm0825Jj7-M7v859E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/73963-pasta-salad-with-homemade-dressing-DDMFS-4x3-7e31a543fc6844afbc004b88c25fe525.jpg"
      ],
