  "ingredients": [
    "2 cups heavy whipping cream",
    "1 cup half-and-half",
    "0.75 cup white sugar",
    "5 tablespoons amaretto liqueur (such as Disaronno®)",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Stir heavy cream, half-and-half, and sugar together in a large bowl until sugar dissolved. Stir in liqueur and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer's instructions until ice cream reaches 'soft-serve' consistency. Transfer to an airtight container and freeze about 2 hours before serving.",
