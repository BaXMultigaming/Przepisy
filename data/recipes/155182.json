  "ingredients": [
    "0.5 cup molasses",
    "0.25 cup honey",
    "0.25 cup shortening",
    "0.25 cup margarine",
    "2 large eggs",
    "4 cups all-purpose flour",
    "0.75 cup white sugar",
    "0.5 cup brown sugar",
    "2 teaspoons anise extract",
    "2 teaspoons ground cinnamon",
    "1.5 teaspoons ground cardamom",
    "1.5 teaspoons baking soda",
    "1 teaspoon ground cloves",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground ginger",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "1 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Place molasses, honey, shortening, and margarine in a medium saucepan over medium heat; stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lvemqVfRTLP3SFfTJVAoXXEeTS0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/155182-pfeffernusse-cookies-step-01-1-0f9cc0ea981244fa905a684cbe254af9.jpg"
      ],
      "image": "assets/images/155182/step_01.webp"
    },
    {
      "text": "Remove from heat and cool to room temperature; beat in eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oeNRCQxybMiAjBPq3iYBevxngKc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/155182-pfeffernusse-cookies-step-03-1-8aa9c208e33d4c3997a30df22bd2300a.jpg"
      ],
      "image": "assets/images/155182/step_02.webp"
    },
    {
      "text": "Combine flour, white sugar, brown sugar, anise extract, cinnamon, cardamom, baking soda, cloves, nutmeg, ginger, pepper, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AH-d0DbHsaWtdNpxWHHn9pZQfhs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/155182-pfeffernusse-cookies-step-04-1-7808eeb578194041802d409cbefd2b9c.jpg"
      ],
      "image": "assets/images/155182/step_03.webp"
    },
    {
      "text": "Add molasses mixture; stir until well combined. Refrigerate until chilled, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D5vg7xEd3znsNnwhF6JrvGp_EBo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/155182-pfeffernusse-cookies-step-05-2-dd3b2d868cfc4175b2a9c75b4cd7ad11.jpg"
      ],
      "image": "assets/images/155182/step_04.webp"
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Roll dough into acorn-sized balls; place 1 inch apart on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TZ877FiOlmt8sK2teK6PjNhKEbE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/155182-pfeffernusse-cookies-step-08-2-8a3497fca0734f858521a00df396a389.jpg"
      ],
      "image": "assets/images/155182/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until firm and slightly crackled, 10 to 15 minutes. Cool on the baking sheets briefly; transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AnQ5ibbJp-VC1Ay17t76-B14fco=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/155182-pfeffernusse-cookies-step-09-6c775c846c3b4225927c5a3d9c49a95a.jpg"
      ],
      "image": "assets/images/155182/step_06.webp"
    },
    {
      "text": "Dust cookies with confectioners' sugar. Store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bV7bmUNFbOQSBhvY9bvlhDasbJA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/155182-pfeffernusse-cookies-step-11-6baa5b85f829491eb50607f22f70edc4.jpg"
