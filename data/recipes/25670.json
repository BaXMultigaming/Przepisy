  "ingredients": [
    "1 tablespoon olive oil",
    "1 small red onion, chopped",
    "1 zucchini, chopped",
    "1 tablespoon minced garlic",
    "2 (14.5 ounce) cans chicken broth",
    "1 (28 ounce) can crushed tomatoes",
    "0.25 cup red wine",
    "1 tablespoon white sugar",
    "1 tablespoon Italian seasoning",
    "1 dash hot pepper sauce",
    "1 (11 ounce) can white corn, undrained",
    "0.5 cup freshly grated Parmesan cheese",
    "8 ounces cheese tortellini"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat. Add onion, zucchini and garlic; cook until onion is translucent, about 3 minutes. Stir in broth, crushed tomatoes, wine, sugar, Italian seasoning, and pepper sauce; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat. Stir in corn and Parmesan cheese; simmer 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tortellini; simmer until tortellini are tender, 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
