  "ingredients": [
    "3 pounds pork spareribs",
    "1 cup applesauce",
    "1 cup pure maple syrup",
    "6 tablespoons lemon juice",
    "0.5 cup ketchup",
    "0.25 teaspoon paprika",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place ribs in a large pot with enough water to cover, and bring to a boil. Reduce heat to low, and simmer 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix the applesauce, syrup, lemon juice, ketchup, paprika, cinnamon, garlic powder, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ribs in the prepared baking dish, and brush with 1/2 the sauce. Bake uncovered, basting frequently with remaining sauce, for 1 1/2 hours, until done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
