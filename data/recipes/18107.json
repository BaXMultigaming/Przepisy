  "ingredients": [
    "8 skinless, boneless chicken breasts",
    "salt to taste",
    "2 tablespoons vegetable oil",
    "4 cloves garlic, crushed",
    "1 bay leaf",
    "0.25 teaspoon dried thyme",
    "0.25 teaspoon ground black pepper",
    "4 tomatoes, peeled and quartered",
    "20 pimento-stuffed green olives",
    "1.25 cups dry white wine",
    "1.25 cups chicken broth"
  ],
  "steps": [
    {
      "text": "Season chicken with salt. Heat oil in a large skillet over medium high heat; brown chicken in oil, about 5 minutes each side. Add garlic, bay leaf, thyme and pepper and mix well, then stir in tomatoes, olives, wine and broth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low and simmer, uncovered, for 45 minutes or until chicken is cooked through and juices run clear. Remove garlic and bay leaf and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
