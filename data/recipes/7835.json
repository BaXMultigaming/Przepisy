  "ingredients": [
    "2 (8 ounce) packages cream cheese",
    "0.75 cup white sugar",
    "1 (15 ounce) can pumpkin puree",
    "1.25 teaspoons ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground nutmeg",
    "2 eggs",
    "0.25 teaspoon salt",
    "2 prepared 8 inch pastry shells"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-Rc5cSnmfAZxTRSlkj4vq4x2Ua4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7835-pumpkin-cheesecake-i-VAT-step-01-dfa9df53c51c47d3ae085310efef420a.jpg"
      ],
      "image": "assets/images/7835/step_01.webp"
    },
    {
      "text": "Beat cream cheese and sugar together until combined; add pumpkin and spices. Beat in eggs one at a time. Add salt; beat until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KOzSvgdZq-W23naSSYwSwwfrac4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7835-pumpkin-cheesecake-i-VAT-step-02-17217dd065024e82adc3921efbac0537.jpg"
      ],
      "image": "assets/images/7835/step_02.webp"
    },
    {
      "text": "Pour the mixture evenly into the two prepared crusts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qlCeFsyBOUeHtEIc1L1OlNiqXfg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7835-pumpkin-cheesecake-i-VAT-step-03-3e1f8e1e723d42afbbbe2bbeee20f7b1.jpg"
      ],
      "image": "assets/images/7835/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, about 50 minutes. Let cheesecake cool completely in the pan on a wire rack. Refrigerate at least 4 hours before serving for best results.",
      "section": null,
      "name": null,
