  "ingredients": [
    "4 cups chicken broth",
    "3 tablespoons grated fresh ginger root",
    "2 cloves garlic, minced",
    "1 cup chopped zucchini",
    "2 cups cubed cooked chicken",
    "1 (2 ounce) package cellophane noodles",
    "4 cups fresh spinach"
  ],
  "steps": [
    {
      "text": "Bring chicken broth, ginger, and garlic to a boil in a large saucepan. Reduce the heat to medium and cook for 10 minutes. Add zucchini and cook until tender, about 10 minutes more.",
