  "ingredients": [
    "parchment paper",
    "0.5 cup butter",
    "0.75 cup white sugar",
    "1 egg, beaten",
    "1 cup quick cooking oats (such as Quaker™)",
    "3 tablespoons all-purpose flour",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "0.25 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil and grease with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a microwave-safe bowl in the microwave until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hKyAHwXQiaH47lrFTS0k-BsMScQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274070-grandmas-lace-cookies-step-1-0977-e511ff78a2e642a8bd9160067e8044dd.jpg"
      ],
      "image": "assets/images/274070/step_02.webp"
    },
    {
      "text": "Add sugar and stir to combine. Add beaten egg and mix well. Stir in oats, flour, vanilla, salt, and baking powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ut6_5uBsetGDai7n-cxHexLzgjk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274070-grandmas-lace-cookies-step-2-0978-6222e70f6969418984bed0864c2fe4cf.jpg"
      ],
      "image": "assets/images/274070/step_03.webp"
    },
    {
      "text": "Drop spoonfuls of dough 3 inches apart onto the prepared baking sheet as the dough will spread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zibgIUGKUvQkCUtz_DOkUgeRyGE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274070-grandmas-lace-cookies-step-3-0980-c02938e89c8b4da38512aa21fd3f96a6.jpg"
      ],
      "image": "assets/images/274070/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are golden brown, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OYkTo3WcXTRHgdj2aLPt7nO_ny4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274070-grandmas-lace-cookies-step-4-0989-866ae77d01ee4cf18fa92cd8d0e2a888.jpg"
      ],
      "image": "assets/images/274070/step_05.webp"
