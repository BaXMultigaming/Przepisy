  "ingredients": [
    "2 medium potatoes, peeled and cubed",
    "2 teaspoons olive oil",
    "1 clove garlic, chopped",
    "0.33333334326744 cup cream",
    "2 tablespoons salted butter, melted",
    "1 teaspoon dried thyme",
    "0.125 teaspoon dried rosemary, crushed",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain and transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a pan over medium heat. Add garlic and cook until light brown and fragrant, 1 to 2 minutes. Remove from the heat and add to potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cream, butter, thyme, rosemary, salt, and pepper to potatoes; beat with an electric mixer until fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
