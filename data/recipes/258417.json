  "ingredients": [
    "2 cups all-purpose flour",
    "1.5 cups white sugar, divided",
    "0.5 cup butter",
    "3 nectarines, sliced, divided",
    "1 tablespoon cornstarch",
    "2 eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and ½ cup sugar in a 9x13-inch baking pan; cut in butter until mixture is crumbly. Press firmly into an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is lightly brown, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ⅓ nectarine slices in a blender; blend until smooth. Add cornstarch; blend until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl using an electric mixer until light; gradually beat in remaining 1 cup sugar until well combined. Stir in nectarine mixture; pour over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until almost set, about 30 minutes. Cool completely on a wire rack, 30 to 60 minutes. Cut into bars; top with remaining ⅔ nectarine slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
