  "ingredients": [
    "1 cup light mayonnaise",
    "1 tablespoon white sugar",
    "0.25 teaspoon salt",
    "1 teaspoon white vinegar",
    "2 teaspoons skim milk",
    "1 cup imitation crabmeat, flaked",
    "1 stalk celery, chopped",
    "1 tablespoon finely chopped green bell pepper"
  ],
  "steps": [
    {
      "text": "In a medium bowl, whisk together the mayonnaise, sugar, salt, vinegar and milk. Add the crabmeat, celery and green pepper and stir until evenly combined. Refrigerate until ready to use.",
