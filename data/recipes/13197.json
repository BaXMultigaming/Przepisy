  "ingredients": [
    "2 pounds fresh green beans",
    "1 clove garlic, minced",
    "1 sprig fresh parsley",
    "1 pinch salt",
    "2 slices bacon",
    "3 tablespoons all-purpose flour",
    "1 onion, chopped",
    "1 cup sour cream",
    "3 tablespoons vinegar"
  ],
  "steps": [
    {
      "text": "In a large pot over medium heat, combine green beans, garlic, parsley, salt and water to cover and cook until beans are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry bacon until crisp, set aside. Add onion and flour to bacon grease, stirring until smooth and brown. Add some water from the beans, stirring slowly and constantly to prevent lumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook to thicken a bit, then add it to the bean soup and bring to a boil. Stir crisp bacon, sour cream and vinegar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
