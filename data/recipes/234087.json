  "ingredients": [
    "0.5 cup wheat germ",
    "2 cups whole wheat flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "3 cups buttermilk",
    "2 eggs, lightly beaten",
    "1 tablespoon canola oil",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread wheat germ over a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until toasted, about 5 minutes. Cool slightly, then transfer wheat germ to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, baking soda, and salt into wheat germ. Beat buttermilk, eggs, and oil in another bowl until smooth; pour egg mixture into flour mixture and stir until batter is just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat griddle over medium-high heat and coat with cooking spray. Pour 1/4 cup portions of batter onto the griddle and cook until bubbles form and the edges are dry, about 2 minutes. Flip and cook until browned on the other side, about 3 minutes more. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
