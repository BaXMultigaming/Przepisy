  "ingredients": [
    "1 medium onion, cut into chunks",
    "1 bunch fresh cilantro",
    "1.5 cups fresh mint leaves",
    "1 green chile pepper",
    "1 tablespoon tamarind juice or lemon juice",
    "0.5 teaspoon salt",
    "0.25 cup water, or as needed"
