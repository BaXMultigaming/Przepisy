  "ingredients": [
    "2.5 cups pumpkin",
    "1 cup evaporated milk",
    "2 eggs",
    "0.5 cup white sugar",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground ginger",
    "1 (18.25 ounce) package yellow cake mix",
    "0.5 cup butter, melted",
    "1 cup pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the pumpkin, evaporated milk, eggs, sugar, cinnamon, nutmeg, cloves and ginger. Transfer to the baking dish. Sprinkle the cake mix over the pumpkin mixture. Drizzle with melted butter. Top with pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 50 minutes in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
