  "ingredients": [
    "4 cups vegetable broth",
    "2.5 ounces rice",
    "3 eggs",
    "2 small lemons, juiced",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring vegetable broth to a boil in a 2-quart saucepan. Reduce heat to medium-low and stir in rice. Cover the saucepan; simmer until rice is tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and lemon juice together in a small bowl. Slowly add 1 ladle of hot soup, stirring constantly. Repeat with another ladle of soup, if necessary, to bring egg mixture up to the temperature of soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir egg mixture into broth and rice. Reduce heat to low and cook until soup is hot, about 5 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
