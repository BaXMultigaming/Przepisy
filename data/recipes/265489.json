  "ingredients": [
    "3 tablespoons soy sauce",
    "1 tablespoon sesame oil",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon white pepper",
    "2 tablespoons olive oil",
    "1 onion, diced",
    "2 cloves garlic, minced",
    "2 carrots, peeled and grated",
    "0.5 cup frozen corn",
    "0.5 cup frozen peas",
    "3 cups cooked brown rice",
    "2 cups diced pineapple",
    "0.5 cup diced ham",
    "2 green onions, sliced"
  ],
  "steps": [
    {
      "text": "Whisk soy sauce, sesame oil, ground ginger, and white pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet or wok over medium-high heat. Add onion and cook, stirring often, until soft and translucent, 3 to 4 minutes. Add garlic and cook for an additional 30 seconds. Stir in carrots, corn, and peas and stir-fry until vegetables are tender, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in brown rice, pineapple, ham, green onions, and soy sauce mixture. Cook, stirring constantly, until heated through, about 2 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
