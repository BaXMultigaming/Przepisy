  "ingredients": [
    "1 pastry for a 9-inch double crust pie",
    "4 cups peeled chopped sweet potatoes",
    "1.5 cups white sugar",
    "3 eggs",
    "0.33333334326744 cup milk",
    "0.25 cup margarine",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon lemon extract",
    "0.33333334326744 teaspoon ground cloves",
    "0.25 teaspoon ground allspice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Press the pie pastries into two 9-inch pie dishes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sweet potatoes into a large pot and cover with water; bring to a boil, reduce heat to medium-low, and simmer until tender, 15 to 20 minutes. Drain potatoes and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat potatoes, sugar, eggs, milk, margarine, vanilla extract, lemon extract, cloves, and allspice together in a bowl until smooth; pour into the prepared crusts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pies are set in the middle, 40 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
