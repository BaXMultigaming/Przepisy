  "ingredients": [
    "12 eggs",
    "1 teaspoon granulated garlic",
    "1.5 teaspoons salt, or to taste",
    "1.5 teaspoons ground black pepper, or to taste",
    "1 cup chopped spinach",
    "0.75 cup shredded Muenster cheese",
    "0.5 cup chopped onion"
  ],
  "steps": [
    {
      "text": "Beat eggs in a medium bowl until yellow and frothy. Add garlic, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss spinach, Muenster cheese, and onion together in a small bowl. Divide evenly among the cavities of a silicone egg mold. Pour beaten eggs into each cavity, filling each 3/4 full. Cover mold with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/2 cup water into a multi-functional pressure cooker, such as Instant Pot. Place egg mold inside. Close and lock the lid, sealing the vent. Select Steam function; set timer for 13 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure naturally according to manufacturer's instructions, 10 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
