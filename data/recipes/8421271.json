  "ingredients": [
    "2 teaspoons butter",
    "1 clove garlic, minced",
    "1 (7.6 ounce) can canned table cream (media crema)",
    "0.25 teaspoon freshly ground white pepper",
    "0.25 teaspoon salt",
    "1 cup freshly grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium heat. Add minced garlic and sauté until garlic is fragrant, about 30 seconds.",
      "section": null,
