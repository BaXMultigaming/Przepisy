  "ingredients": [
    "cooking spray",
    "1.5 cups white sugar",
    "1 cup whole wheat flour",
    "1 cup cocoa powder",
    "1.5 teaspoons baking powder",
    "0.125 teaspoon salt",
    "1 cup plain nonfat Greek yogurt",
    "0.5 cup brewed coffee",
    "0.5 cup applesauce",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray an 8-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, flour, cocoa powder, baking powder, and salt together in a large bowl. Push mixture to the sides of the bowl to form a well in the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine yogurt, coffee, applesauce, and vanilla extract in a small bowl. Pour yogurt mixture into the flour mixture. Fold gently with a spatula until just combined. Spread in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center is firm to the touch, 45 to 55 minutes. Cool slightly before cutting into squares, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
