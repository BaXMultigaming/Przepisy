  "ingredients": [
    "1 tablespoon butter",
    "1 pound baby carrots",
    "1 shallot, chopped",
    "2 tablespoons vegetable stock",
    "0.5 teaspoon thyme",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground sumac",
    "0.5 teaspoon chopped fresh rosemary",
    "0.5 teaspoon chopped fresh sage",
    "salt and ground white pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat butter in a large pan over medium heat until completely melted. Add carrots and shallot to pan; cook and stir until the carrots are coated in butter and shallots are slightly soft, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir vegetable stock, thyme, ground nutmeg, and ground sumac into the carrots; cover pan, reduce heat to low, and cook and stir until most of the liquid has disappeared, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pan from heat and garnish carrots with rosemary, sage, salt, and white pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
