  "ingredients": [
    "2 (1 ounce) squares semisweet baking chocolate",
    "2 cups crushed chocolate wafers (such as Oreo®), filling discarded",
    "0.25 cup corn syrup",
    "0.25 cup dark rum",
    "0.25 cup chocolate sprinkles, or as needed"
  ],
  "steps": [
    {
      "text": "Melt chocolate in a microwave-safe glass or ceramic bowl for 15 seconds at a time, stirring after each interval, until almost melted, 1 to 3 minutes. Mix crushed wafers, corn syrup, and rum into melted chocolate until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate until firm enough to handle, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape into 24 balls and roll in chocolate sprinkles to coat. Place in a covered container and refrigerate for 2 days to allow flavors to develop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
