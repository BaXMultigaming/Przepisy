  "ingredients": [
    "2 cups whole wheat flour",
    "0.33333334326744 cup brown sugar",
    "0.5 teaspoon ground cinnamon",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1.5 cups mashed bananas",
    "4 egg whites",
    "1 teaspoon vanilla extract",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 12-cup muffin pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix whole wheat flour, brown sugar, cinnamon, baking powder, and baking soda. In a separate bowl, mix bananas, egg whites, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix banana mixture into flour mixture until smooth. Fold in blueberries. Spoon batter into the prepared muffin pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 16 minutes in the preheated oven, or until a toothpick inserted in the center of a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
