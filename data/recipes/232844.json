  "ingredients": [
    "2 tablespoons butter",
    "0.5 cup orzo pasta",
    "0.5 cup diced onion",
    "2 cloves garlic, minced",
    "2 cups chicken broth",
    "0.5 cup white rice",
    "1 cup chopped spinach",
    "0.5 cup chopped Bulgarian feta cheese"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium-low heat; cook and stir orzo in melted butter until golden brown, 3 to 5 minutes. Stir in onion and cook, stirring occasionally, until translucent, 5 to 10 minutes. Stir in garlic until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add broth and rice to orzo-onion mixture; bring to a boil. Reduce heat to medium-low, cover the skillet, and simmer until rice is tender and liquid is absorbed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and stir in spinach and feta. Cover and let stand until spinach is wilted and feta is melted, about 5 minutes. Fluff with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
