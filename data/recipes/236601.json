  "title": "Chef John's Corned Beef and Cabbage",
  "description": "My best corned beef and cabbage recipe braises a beef brisket in a Dutch oven with red potatoes, carrots, and cabbage for hours for an Irish feast.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2014-02-12T19:58:42-05:00",
