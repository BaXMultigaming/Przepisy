  "ingredients": [
    "1 (4 pound) corned beef brisket with spice packet",
    "3 quarts water",
    "1 onion, quartered",
    "3 carrots, cut into large chunks",
    "3 stalks celery, cut into 2-inch pieces",
    "1 teaspoon salt",
    "2 pounds red potatoes, halved",
    "1 small head cabbage, cut into eighths"
  ],
  "steps": [
    {
      "text": "Combine corned beef and spice packet contents, water, onion, carrots, celery, and salt together in a large pot or Dutch oven; bring to a simmer, skimming off any foam that rises to the surface.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JL3ucqIr2hs6OaI_n9L4gx1yKkY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23660-chef-johns-corned-beef-and-cabbage-Step-01-535549a0a78b42f0b4084b376584ba26.jpg"
      ],
      "image": "assets/images/236601/step_01.webp"
    },
    {
      "text": "Cover the pot, reduce heat to low, and simmer until meat is almost fork-tender, about 3 hours. Add potatoes and simmer, uncovered, until potatoes are almost tender, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hDZHxz7cot92ghEewduRFXACWX0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23660-chef-johns-corned-beef-and-cabbage-Step-02-4df63a4026754d74ad4781e00d54edd9.jpg"
      ],
      "image": "assets/images/236601/step_02.webp"
    },
    {
      "text": "Place cabbage pieces on top of and around meat, cover the pot, and simmer until cabbage is tender, 20 to 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WGUq7xqCek-h32BMdVJ-B1h7ojk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23660-chef-johns-corned-beef-and-cabbage-Step-03-0563761173b041ce99fd80e087c1c497.jpg"
      ],
      "image": "assets/images/236601/step_03.webp"
    },
    {
      "text": "Remove meat to a cutting board and let rest 10 to 15 minutes. Cut across the grain and serve in a bowl; ladle vegetables and broth over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xRVLlnvhlr7EUeKmgK4uqWv76rI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23660-chef-johns-corned-beef-and-cabbage-Step-04-b23300645dca43fe9dbac20ff5a0f90e.jpg"
      ],
      "image": "assets/images/236601/step_04.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W5MNaGa8r-EBx2F7fALQKVE5aqU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23660-chef-johns-corned-beef-and-cabbage-PICS-beauty-4x3-f7ed224412b3441b8445c3de9ded3447.jpg"
      ],
