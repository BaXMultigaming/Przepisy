  "ingredients": [
    "3 cups white sugar",
    "1 cup water",
    "6 tablespoons fresh lemon juice",
    "3.5 cups mashed banana",
    "1 tablespoon whole cloves",
    "6 half pint canning jars with lids and rings"
  ],
  "steps": [
    {
      "text": "Combine the sugar and water in a saucepan; bring to a boil, and boil for 10 minutes. Stir in the lemon juice, mashed banana, and cloves. Reduce heat to low; simmer, stirring frequently, until the mixture thickens, about 45 minutes. Strain to remove cloves.",
      "section": null,
      "name": null,
