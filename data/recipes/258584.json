  "ingredients": [
    "1 butternut squash, halved and seeded",
    "2 sweet potatoes, halved lengthwise",
    "2.75 cups water",
    "0.25 teaspoon salt",
    "1.5 cups whole grain couscous",
    "5 links precooked apple chicken sausage, sliced into rounds",
    "1 green bell pepper, diced",
    "0.5 cup diced green onion",
    "1 (12 ounce) package shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Place butternut squash and sweet potatoes cut-side down on the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until softened, about 30 minutes. Cool until easily handled, 5 to 10 minutes. Scoop flesh out of the skins; place in a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and salt to a boil in a small saucepan. Stir in couscous; simmer over medium-high heat until couscous is soft, about 5 minutes. Drain excess water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir couscous, sausage, green bell pepper, and green onion into the casserole dish. Sprinkle mozzarella cheese on top. Cover casserole dish tightly with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until hot and bubbly, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
