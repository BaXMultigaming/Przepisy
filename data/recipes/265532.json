  "title": "Jamaican Jerk Shrimp in Foil",
  "description": "Shrimp is grilled in a bowl of foil filled with habanero peppers, green onions, soy sauce, vinegar, and Jamaican jerk seasoning.",
  "authors": [
    "JOHN MITSCHKE"
  ],
  "date_published": "2020-03-05T00:17:56-05:00",
