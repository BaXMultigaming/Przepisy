  "ingredients": [
    "3 tablespoons all-purpose flour",
    "3 pounds chuck roast",
    "15 ounces tomato sauce",
    "0.5 cup chopped onion",
    "0.33333334326744 cup brown sugar",
    "2 cubes beef bouillon",
    "1.5 teaspoons chili powder",
    "1 clove garlic, minced",
    "1 teaspoon mustard powder"
  ],
  "steps": [
    {
      "text": "Rub the flour into the roast. Place roast in bottom of slow cooker. Pour in the tomato sauce, onion, brown sugar, bouillon, chili powder, garlic and mustard powder. Mix well.",
