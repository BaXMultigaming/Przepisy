  "ingredients": [
    "1 pound ground beef",
    "1 envelope taco seasoning mix",
    "2 cups shredded Cheddar cheese",
    "2 cups ranch dressing",
    "0.5 cup Italian-style salad dressing",
    "1 red onion, diced",
    "1 head lettuce, shredded",
    "1 (17 ounce) package nacho-flavor tortilla chips, crushed into bite-size pieces"
  ],
  "steps": [
    {
      "text": "Cook ground beef in a skillet over medium heat, breaking it up as it cooks, until browned and crumbly, about 10 minutes. Drain and discard excess grease; stir taco seasoning into beef. Cool beef mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beef mixture, Cheddar cheese, ranch dressing, Italian dressing, and onion in a large bowl. Chill until cold, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently stir in lettuce and tortilla chips just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
