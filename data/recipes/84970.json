  "keywords": [],
  "ingredients": [
    "2 ounces macadamia nuts",
    "4 ounces plain bread crumbs",
    "6 (6 ounce) mahi mahi fillets",
    "4 ounces butter",
    "2 ounces shallots, diced",
    "4 cups chicken stock",
    "4 ounces pineapple, rough chopped",
    "4 ounces papaya, rough chopped",
    "4 ounces mango, rough chopped",
    "1 tablespoon shredded coconut",
    "2 habanero peppers, seeded",
    "salt and pepper to taste",
    "white sugar to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a food processor or blender, pulse together macadamia nuts and breadcrumbs until finely ground. Pour nut mixture onto a plate, and coat fish fillets on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a large skillet over medium heat. Fry fillets on both sides until nuts are golden brown. Remove to a baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add shallots to skillet, and cook until translucent. Stir in chicken stock. Mix in pineapple, papaya, mango, coconut, and habanero peppers. Season with salt, pepper, and sugar to taste. Simmer until sauce is thick, about 30 minutes. Strain to remove peppers, fruit, and shallots. Reserve sauce in a pan over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake mahi mahi in preheated oven about 10 minutes, until internal temperature reaches 140 degrees F. Remove fish, and lightly coat with sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
