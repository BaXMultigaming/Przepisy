  "ingredients": [
    "1.5 cups whole grain spelt flour",
    "1 tablespoon pumpkin pie spice",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking powder",
    "0.5 cup maple syrup",
    "0.33333334326744 cup melted butter",
    "2 large eggs",
    "1 cup pumpkin puree",
    "0.25 cup golden raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, pumpkin pie spice, baking soda, salt, and baking powder together in a bowl until combined; stir in maple syrup, melted butter, and eggs until incorporated. Stir in pumpkin purée just until batter is combined; fold in raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter among the prepared muffin cups, filling each to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 20 to 25 minutes. Cool in the tins for 5 minutes, before transferring muffins to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
