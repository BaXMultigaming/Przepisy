  "ingredients": [
    "1 cup plain soy milk",
    "1 tablespoon apple cider vinegar",
    "1.5 cups unbleached all-purpose flour",
    "1 cup white sugar",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.33333334326744 cup canola oil",
    "0.25 cup water",
    "1 tablespoon lemon juice",
    "1 tablespoon vanilla extract",
    "0.25 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir soy milk and vinegar together in a large glass measuring cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking soda, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Briskly stir canola oil, water, lemon juice, vanilla extract, and almond extract into soy milk mixture using a fork; stir into flour mixture until batter is lump-free. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
