  "ingredients": [
    "1 cup buttermilk",
    "1.5 cups wheat bran",
    "1 egg",
    "0.66666668653488 cup packed brown sugar",
    "0.33333334326744 cup canola oil",
    "1 ripe banana, mashed",
    "0.5 teaspoon vanilla extract",
    "0.75 cup whole wheat flour",
    "0.5 cup oat bran",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 cup chopped walnuts",
    "0.75 cup fresh or frozen blueberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix buttermilk with wheat bran. In another bowl, beat together egg, sugar, oil, banana, and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together flour, oat bran, baking soda, and baking powder. Stir buttermilk mixture and egg mixture into flour mixture until flour is just moistened. Stir in berries and walnuts. Spoon batter into muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 minutes, or until done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
