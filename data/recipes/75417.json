    "1 pound sliced bacon, cut in half"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice dates in half and open them up. Pinch off pieces of blue cheese and place them into the center of dates; press date halves together to close. Wrap each date with a half-slice of bacon and secure with a toothpick. Arrange in a baking dish or on a baking sheet with sides to catch any grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bacon is crisp, 30 to 40 minutes. Turn dates over after the first 20 minutes for even cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
