  "ingredients": [
    "0.25 cup oil-packed sun-dried tomatoes, drained and chopped",
    "8 ounces cream cheese, room temperature",
    "0.5 cup sour cream",
    "0.25 cup mayonnaise",
    "2 cloves garlic, minced",
    "hot pepper sauce to taste",
    "0.75 teaspoon salt",
    "0.75 teaspoon freshly ground black pepper",
    "0.25 cup fresh basil"
  ],
  "steps": [
    {
      "text": "Combine sun-dried tomatoes, cream cheese, sour cream, mayonnaise, garlic, hot pepper sauce, salt, and pepper in a food processor; process until well blended. Add basil and process until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate for at least 1 hour before serving.",
