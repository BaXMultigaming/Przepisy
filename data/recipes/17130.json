  "ingredients": [
    "1 pound cheese tortellini",
    "2 large portobello mushrooms",
    "0.25 cup white wine",
    "1 tablespoon chopped fresh parsley",
    "2 cloves garlic, minced",
    "8 ounces Alfredo-style pasta sauce",
    "salt and pepper to taste",
    "0.33333334326744 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, prepare mushrooms by rinsing and thinly slicing the mushroom caps; discard the stems.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium skillet over low heat, combine wine, parsley, garlic and mushrooms; stirring frequently, saute for approximately 5 minutes or until mushrooms are cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove skillet from heat and slowly add Alfredo sauce, stirring to blend; season with salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate hot pasta into four portions and spoon sauce over pasta. Garnish with cheese and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
