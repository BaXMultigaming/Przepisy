  "ingredients": [
    "1 small onion, chopped",
    "0.5 cup roasted red peppers, drained and chopped",
    "1 (14.5 ounce) can red salmon, drained and flaked",
    "24 saltine crackers, crushed",
    "0.5 cup milk",
    "1 egg, beaten",
    "0.75 teaspoon Worcestershire sauce",
    "3 drops cayenne pepper sauce (such as Frank's® RedHot®)",
    "0.125 teaspoon cayenne pepper",
    "black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend onion and roasted red pepper in a blender until liquefied; transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix salmon, saltine crackers, milk, egg, Worcestershire sauce, cayenne pepper sauce, cayenne pepper, and black pepper with the onion mixture in the large bowl; transfer to the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an instant-read thermometer inserted into the center reads at least 160 degrees F (70 degrees C), about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
