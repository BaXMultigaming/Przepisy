  "ingredients": [
    "1 tablespoon salt",
    "1 tablespoon ground black pepper",
    "1 tablespoon garlic powder",
    "1 tablespoon Montreal steak seasoning",
    "1 (3 pound) chuck roast, or more to taste",
    "0.5 cup barbeque sauce",
    "0.25 cup brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat a smoker to 275 degrees F (135 degrees C) according to manufacturer's directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine salt, black pepper, garlic powder, and steak seasoning in a bowl; rub evenly over roast. Place roast in a baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook roast in the preheated smoker until an instant-read thermometer inserted into center reads 165 degrees F (74 degrees C), 4 to 4 ½ hours. Wrap roast in aluminum foil; continue smoking until reaches an internal temperature of 195 degrees F (90 degrees C), about 1 hour more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer roast to a cutting board; let sit for 20 minutes. Leave smoker on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut roast into cubes; return to the baking dish. Add barbecue sauce and brown sugar; stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Smoke for 1 ½ to 2 hours more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
