  "total_time": "PT555M",
  "yield": [
    "12",
    "12 muffins"
  ],
  "categories": [],
  "cuisines": [],
  "regions": [],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup white sugar",
    "0.25 cup unsalted butter, softened",
    "1 cup vanilla Greek yogurt",
    "1 large egg, at room temperature",
    "1.5 teaspoons coconut extract",
    "1 cup chopped fresh pineapple",
    "0.5 cup sweetened shredded coconut",
    "0.5 cup chopped pecans",
    "1 cup brown sugar",
    "2 tablespoons fresh pineapple juice"
  ],
  "steps": [
    {
      "text": "Sift flour, baking powder, baking soda, and salt together in a bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and butter in a second bowl with an electric mixer. Add Greek yogurt, egg, and coconut extract; beat until well combined. Add in flour mixture and mix until just combined. Fold in pineapple, coconut, and pecans. Cover and refrigerate batter for 8 to 12 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12-cup muffin tin or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each liner with batter using an ice cream scoop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, 20 to 25 minutes. Cool for 5 minutes in the pan, then transfer to a wire rack. Cool completely before glazing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and pineapple juice for glaze in a microwave-safe bowl. Microwave until sugar has melted, 20 to 25 seconds. Dip each muffin into the glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
