  "ingredients": [
    "1.5 cups milk",
    "0.5 cup quick cooking oats",
    "2 tablespoons white sugar",
    "0.25 teaspoon ground cinnamon",
    "1 pinch ground nutmeg",
    "1 pinch salt",
    "0.25 teaspoon lemon zest"
  ],
  "steps": [
    {
      "text": "Combine milk, oats, sugar, cinnamon, nutmeg, and salt in a saucepan. Add lemon zest, if using. Bring to a boil, stirring constantly, until oats are tender, about 2 minutes.",
