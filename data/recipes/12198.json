  "ingredients": [
    "0.75 cup all-purpose flour",
    "0.5 cup milk",
    "1 (3 ounce) package non-instant vanilla pudding mix",
    "1 egg",
    "3 tablespoons butter",
    "2.5 cups canned sliced peaches, syrup reserved",
    "1 (8 ounce) package cream cheese",
    "0.5 cup white sugar",
    "1 tablespoon white sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8- or 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, milk, pudding mix, egg, and butter in a large bowl; beat well. Pour into the prepared pie plate. Arrange drained peaches on top, just to the edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, ½ cup sugar, and 3 tablespoons reserved peach syrup together in a medium bowl until smooth and creamy. Carefully spoon mixture on top peaches, just to the edges. Combine 1 tablespoon sugar and cinnamon in a small bowl; sprinkle over top of pie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 35 minutes. Do not overbake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
