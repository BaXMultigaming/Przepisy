  "ingredients": [
    "cooking spray",
    "0.5 cup ketchup",
    "0.5 cup brown sugar",
    "1.5 pounds ground beef",
    "0.75 cup French-fried onions",
    "0.75 cup bread crumbs",
    "2 large eggs",
    "0.5 cup sour cream",
    "0.25 cup milk",
