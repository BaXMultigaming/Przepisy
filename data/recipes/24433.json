  "ingredients": [
    "0.33333334326744 cup butter, softened",
    "1 cup brown sugar",
    "0.33333334326744 cup shortening",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 tablespoons unsweetened cocoa powder",
    "3 tablespoons confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter, shortening and brown sugar until smooth. Beat in the egg and vanilla. Combine the flour, baking soda, salt and cocoa; gradually stir into the creamed mixture. Drop by rounded spoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes in the preheated oven. Allow cookies to cool on baking sheet for 5 minutes before removing to a wire rack to cool completely. When cookies are cool, dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
