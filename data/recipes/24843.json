  "title": "Lemon Blueberry Bread",
  "description": "This moist lemon blueberry bread, bursting with juicy blueberries, and flavored with lemon juice and zest, is topped with a sweet and tangy glaze.",
  "authors": [
    "Mama's Cafe"
  ],
  "date_published": "2001-01-17T12:20:56-05:00",
