  "ingredients": [
    "4 large eggs",
    "3 (14 ounce) cans coconut milk, divided",
    "1 (14 ounce) can full-fat coconut cream",
    "2 cups white sugar",
    "2 tablespoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Whisk eggs for about 30 seconds and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 2 cans of coconut milk and coconut cream together; add sugar and whisk. Mix in vanilla; mix in eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into a 4-quart ice cream maker, add enough remaining coconut milk until you reach the max line, and freeze according to manufacturer's instructions, about 20 minutes. Transfer to an airtight container and freeze until firm, about 4 hours.",
