  "ingredients": [
    "3 tablespoons butter",
    "3 tablespoons minced onion",
    "20 ounces broccoli florets",
    "1.5 cups sour cream",
    "2 teaspoons distilled white vinegar",
    "2 teaspoons white sugar",
    "1.5 teaspoons poppy seeds",
    "1 teaspoon paprika",
    "0.5 teaspoon salt",
    "0.125 teaspoon cayenne pepper",
    "0.25 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium-high heat. Stir in onion, and cook until the onion has begun to turn golden brown, about 5 minutes. Meanwhile, place broccoli in a steamer over 1 inch of boiling water, and cover. Cook until tender but still firm, about 6 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When the onions have turned golden brown, remove the saucepan from the heat, and whisk in the sour cream, vinegar, sugar, poppy seeds, paprika, salt, and cayenne pepper. Place the cooked broccoli into a serving dish, and pour the sauce overtop. Sprinkle with chopped pecans to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
