  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup panko bread crumbs",
    "1 tablespoon seasoned salt",
    "1 teaspoon garlic powder",
    "0.25 teaspoon lemon pepper",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon onion powder",
    "0.125 teaspoon cayenne pepper",
    "2 eggs",
    "0.25 cup oil",
    "1 pound tilapia fillets, cut into chunks",
    "24 corn tortillas",
    "0.5 (8 ounce) bottle ranch dressing, or to taste",
    "0.25 cup hot chunky salsa",
    "0.5 lime, juiced",
    "1 canned chipotle chile, thinly sliced",
    "1 small head shredded cabbage, or to taste"
  ],
  "steps": [
    {
      "text": "Place 1/2 cup flour in a small bowl. Combine remaining flour with panko bread crumbs, seasoned salt, garlic powder, lemon pepper, black pepper, onion powder, and cayenne pepper in a shallow bowl. Whisk eggs in a separate small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll tilapia in flour, dip in the egg mixture, roll in the panko-flour mixture, and place in the hot oil. Fry until light brown, about 3 minutes per side. Place on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat tortillas in a separate skillet over medium-low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ranch dressing, salsa, lime, and chipotle chile in a small bowl for the salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide tilapia over the warmed tortillas and serve with salsa and cabbage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
