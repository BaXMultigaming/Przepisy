  "ingredients": [
    "cooking spray",
    "1 large egg",
    "1 small onion, chopped",
    "0.5 cup dill pickle juice",
    "0.75 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 slice bread, torn into small pieces",
    "1 pound lean ground beef",
    "0.25 cup chopped dill pickles",
    "0.25 cup ketchup",
    "2 tablespoons water",
    "1 tablespoon brown sugar",
    "0.5 teaspoon Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a mixing bowl. Whisk in onion, pickle juice, salt, and pepper. Stir in bread until soggy, then mix in ground beef until evenly combined. Form into a loaf and place into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together chopped pickles, ketchup, water, sugar, and Worcestershire sauce; pour over the meatloaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
