  "ingredients": [
    "2 tablespoons vegetable oil",
    "1 onion, thinly sliced",
    "0.5 teaspoon ground cumin",
    "1 cup Basmati rice",
    "2 cups water",
    "0.75 teaspoon salt",
    "0.5 teaspoon garam masala",
    "0.75 cup frozen mixed vegetables"
  ],
  "steps": [
    {
      "text": "In a large pan heat oil over medium heat and saute onions and cumin until onions are tender, but not browned. Rinse the rise several times and drain well. Add the rice to the pan with the onions and pour in the 2 cups of water. Stir in salt, garam masala and vegetables. Cover the pan and increase the heat to high.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring the mixture to a boil and then reduce the heat to low, keeping the rice covered at all times. After cooking for about 10 minutes, gently stir the rice to distribute the spices evenly. Cook 25 to 30 minutes, or until all of the water has evaporated and the rice is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
