    "0.33333334326744 cup quinoa",
    "1 cup shredded coconut",
    "1 cup rolled oats",
    "1 cup all-purpose flour",
    "0.75 cup brown sugar",
    "2 ripe bananas, mashed",
    "0.5 cup applesauce",
