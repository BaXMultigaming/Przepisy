  "steps": [
    {
      "text": "Bring water and quinoa to a boil in a saucepan. Place a cover on the saucepan, reduce heat to medium-low, and simmer until water is completely absorbed, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cooked quinoa, coconut, oats, flour, brown sugar, mashed bananas, applesauce, peanut butter, vanilla, salt, baking soda, and baking powder together in a large bowl. Fold chocolate chips into quinoa mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by spoonfuls onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned around the edges, 20 to 25 minutes. Allow cookies to cool and firm a few minutes on the baking sheets before transferring them to a rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
