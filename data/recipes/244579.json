  "ingredients": [
    "cooking spray",
    "2 pounds fresh asparagus, trimmed",
    "1 tablespoon olive oil",
    "salt and ground black pepper to taste",
    "0.5 cup Swanson® Vegetable Broth",
    "3 ounces soft goat cheese, crumbled",
    "1 teaspoon grated lemon zest",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (218 degrees C). Coat a roasting pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss asparagus and olive oil together in the prepared pan; season with salt and black pepper. Pour in broth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until asparagus is tender, about 20 minutes, stirring once during cooking. Top with goat cheese, lemon zest, and lemon juice before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
