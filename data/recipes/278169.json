  "ingredients": [
    "4 boneless, skinless chicken breasts",
    "1 large sweet onion, chopped",
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "2.5 cups water",
    "1 (8 ounce) package yellow rice mix (such as Zatarain's®)",
    "1 tablespoon butter",
    "1 (15 ounce) can whole kernel corn, drained",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Place chicken in the bottom of a slow cooker. Scatter onion over the top. Cover with condensed soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 7 to 8 hours or High for 3 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When chicken is almost finished cooking, combine water, rice mix, and butter in a 2-quart saucepan until well blended. Bring to a boil. Reduce heat to low, cover, and simmer until rice is tender, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cooked rice, corn, and Cheddar cheese into the slow cooker a few minutes before serving. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
