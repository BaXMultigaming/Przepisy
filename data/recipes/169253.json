  "ingredients": [
    "1 cup couscous",
    "1 teaspoon salt, or to taste",
    "0.5 teaspoon ground cumin",
    "1.25 cups boiling water",
    "1 clove unpeeled garlic",
    "1 (15 ounce) can black beans, rinsed and drained",
    "1 cup canned whole kernel corn, drained",
    "0.5 cup finely chopped red onion",
    "0.25 cup chopped fresh cilantro",
    "3 tablespoons olive oil",
    "3 tablespoons fresh lime juice, or to taste",
    "1 jalapeno pepper, minced"
  ],
  "steps": [
    {
      "text": "Combine couscous, salt, and cumin in a large bowl; stir in boiling water. Cover the bowl with plastic wrap; set aside for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook unpeeled garlic clove in a small skillet over medium-high heat until toasted and skin has turned golden brown; peel and mince garlic. Stir garlic, black beans, corn, onion, cilantro, olive oil, lime juice, and jalapeño into couscous. Serve warm or cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
