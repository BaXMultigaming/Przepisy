  "requested_url": "https://www.allrecipes.com/recipe/269557/chocolate-yule-log/",
  "title": "Chocolate Yule Log",
  "description": "This Christmas Yule log recipe from Chef John makes a show-stopping bûche de Noël featuring a rolled chocolate cake with rich buttercream and ganache.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2018-12-10T22:28:07-05:00",
  "date_modified": "2026-02-24T20:05:47-05:00",
  "prep_time": "PT50M",
  "cook_time": "PT10M",
  "total_time": "PT195M",
  "yield": [
    "10",
    "1 (13-inch) Yule log"
  ],
  "categories": [
    "Dessert",
    "Cake"
  ],
  "cuisines": [
    "French"
  ],
  "regions": [
    "French"
  ],
  "breadcrumbs": [],
  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "1.6666667461395 cups powdered sugar",
    "0.5 cup unsalted butter, at room temperature",
    "2 tablespoons coffee-flavored liqueur",
    "1.5 tablespoons unsweetened cocoa powder",
    "1 pinch salt",
    "0.33333334326744 cup mascarpone cheese",
    "2 tablespoons melted butter",
    "0.5 cup unsweetened cocoa powder",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon kosher salt",
    "5 large eggs, at room temperature",
    "0.66666668653488 cup white sugar",
    "0.5 teaspoon vanilla",
    "2 tablespoons powdered sugar, or as needed",
    "1 cup heavy cream, boiling-hot",
    "1 (8 ounce) package dark chocolate chips"
  ],
  "steps": [
    {
      "text": "Whip 1 ⅔ cups confectioners' sugar, ½ cup butter, coffee-flavored liqueur, 1 ½ tablespoons cocoa powder, and 1 pinch salt together in the bowl of a stand mixer fitted with the whisk attachment on high speed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4A5i9FXdoxXQ10LHGazJ9Uqzdos=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-01-7-2362f63dca584a1daa813b1e229faa20.jpg"
      ],
      "image": "assets/images/269557/step_01.webp"
    },
    {
      "text": "Transfer filling to a separate bowl; stir in mascarpone cheese until combined. Set aside. Clean and dry the stand mixer bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gMfIdeqqzUZ4uCl3YcXFvNtwTFo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-01-12-139c3da6f7ac44cb86566287df821bfd.jpg"
      ],
      "image": "assets/images/269557/step_02.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush a 13x18-inch rimmed baking sheet with a little melted butter. Line the baking sheet with parchment paper; brush parchment with remaining melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_Z3qMnED_bDmwun0aJuNk56Ur5s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-03-2-68ee8afb02104fc4a52cbddeadd4d193.jpg"
      ],
      "image": "assets/images/269557/step_04.webp"
    },
    {
      "text": "Whisk ½ cup cocoa powder, flour, and ½ teaspoon kosher salt together in a bowl, making sure to break up any clumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Zcg50I5NXuIexMxHfVXHLmZj42w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-04-5-d36f30b434b24ebe97bb3bf303c6bf85.jpg"
      ],
      "image": "assets/images/269557/step_05.webp"
    },
    {
      "text": "Place eggs in the clean stand mixer bowl fitted with the whisk attachment. Add sugar; whip until fluffy, thick, and very light in color, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G5yaJBiuMk5_98Nul37ZktU_Ozc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-05-2-0d4c5bf99ec047939abe95a40e165e71.jpg"
      ],
      "image": "assets/images/269557/step_06.webp"
    },
    {
      "text": "Add vanilla extract and ½ cocoa powder mixture; mix on low speed for a few seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mnTYu3VVQEWjJzgWLYs2BwPG5v4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-05-5-e01773f8ed4a4dc7b73d36ccb180003a.jpg"
      ],
      "image": "assets/images/269557/step_07.webp"
    },
    {
      "text": "Add remaining ½ cocoa mixture; mix on low for a few seconds. Switch to high speed; mix until the mixture is moistened but not fully blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EwZo9H2gRURdgy41n9i_lnLYc1I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-05-9-474e31093ddc41c3b791215439d4c142.jpg"
      ],
      "image": "assets/images/269557/step_08.webp"
    },
    {
      "text": "Pull off the whisk attachment and use it to whisk the batter by hand until evenly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a4z_x_GKypD76YAl0eFeXLlV-PU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-05-10-f2956b49d6744f91bb2acdb3a64ef42f.jpg"
      ],
      "image": "assets/images/269557/step_09.webp"
    },
    {
      "text": "Pour batter onto the prepared baking sheet; spread out with a spatula, almost to the edges, but not quite. Tap the baking sheet on the counter several times to remove any large air bubbles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-cOAoWimbCmJnlw19D4ZXpvKl-4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-06-3-6b3087009ed247c2965a3713bc665edf.jpg"
      ],
      "image": "assets/images/269557/step_10.webp"
    },
    {
      "text": "Bake in the preheated oven until the top is dry and the edges start to pull away from the sides, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nUFrK5JOLtlor2ql66HfLSvPwY0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-07-1-bd5b6ed0f4354734b7b2dbf852bebcb2.jpg"
      ],
      "image": "assets/images/269557/step_11.webp"
    },
    {
      "text": "Meanwhile, sift some confectioners' sugar onto a clean kitchen towel to cover an area slightly larger than the sponge cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8fO-NX5OGygr6vskAoTOTlLVUdo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-08-1-dd6d5d4025b94e45966e74807ebf7696.jpg"
      ],
      "image": "assets/images/269557/step_12.webp"
    },
    {
      "text": "Remove cake from the oven. Run a knife around edges of the baking sheet. Dust some confectioners' sugar over top of cake. Run a spatula under the parchment paper to make sure it's not stuck to the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O4FJWaTG2B9VTjeySPkPLnIHYlY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-08-3-d4d2cc4f33b641468b236427ebcbb00f.jpg"
      ],
      "image": "assets/images/269557/step_13.webp"
    },
    {
      "text": "Quickly flip the baking sheet on top of the sugared area on the towel to invert the cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hjgoW7hEFw4U3a84VcMPItzKqfY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-09-2-984e2261baa44a648d440c5f0b353b17.jpg"
      ],
      "image": "assets/images/269557/step_14.webp"
    },
    {
      "text": "Carefully remove the parchment paper, then sift more confectioners' sugar over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/crTyp-koOSn9fNswVa4UZ31TK24=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-09-3-5361ff12ca6449a8b13b9ccbfdc688b9.jpg"
      ],
      "image": "assets/images/269557/step_15.webp"
    },
    {
      "text": "Gently roll cake up inside the towel; set aside to cool for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4jOU79NffyxrX0mxKY2FmK7IB4c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-09-4-1ed3871fa4814961959c03ae23c869d9.jpg"
      ],
      "image": "assets/images/269557/step_16.webp"
    },
    {
      "text": "Carefully unroll the cooled cake. Dollop as much buttercream filling as you like on top, reserving some for later; spread to the edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X-Ujttz2SKPPwVA4cUx5tzRrgLA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-10-3-659004714f144f9087169fdaca22c4e5.jpg"
      ],
      "image": "assets/images/269557/step_17.webp"
    },
    {
      "text": "Roll cake up over the filling, using the towel to lift it if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7O4qnPxi8qC0TjYm9YhRKJhtybk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-10-4-e2857edf7b25487099277b21444af3be.jpg"
      ],
      "image": "assets/images/269557/step_18.webp"
    },
    {
      "text": "Sprinkle more confectioners' sugar over top of log; wrap in plastic wrap. Refrigerate until firm, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RTnzgb7CxPdO1O8m4XGwG7OTUuQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-10-8-d1aae678b47d45f0b02f7f04148d8cd9.jpg"
      ],
      "image": "assets/images/269557/step_19.webp"
    },
    {
      "text": "Pour hot cream over chocolate chips in a bowl; set aside for 1 minute, then whisk until chocolate is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0oE9WjFj2ZLbuAT1IPxEg3zj1sc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-11-3-986a2d8aa8f7420da7ffcac9eb249f61.jpg"
      ],
      "image": "assets/images/269557/step_20.webp"
    },
    {
      "text": "Cut log at an angle 3 inches from one end of log. Place log on a parchment-lined baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nvQ5gvCK7VHNAqEkjvtW4lLHmXU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-12-1-bde6faabc37b4298ba68a192f58df0ea.jpg"
      ],
      "image": "assets/images/269557/step_21.webp"
    },
    {
      "text": "Spread some filling on the angled slice; attach it to one side of the log.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TPV3gdTfaXghvl17XdoOJJCHyrg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-12-3-16545b5e3f364aa69f5976cdfe5e59f3.jpg"
      ],
      "image": "assets/images/269557/step_22.webp"
    },
    {
      "text": "Spread a layer of ganache all over cake, except for the swirls on the ends. Refrigerate until ganache firms up, 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gwOkO3txjIN6DxAUsIAMr1v0xIg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-12-6-f1862d5c449e4875a2bda124eebbaad3.jpg"
      ],
      "image": "assets/images/269557/step_23.webp"
    },
    {
      "text": "Carve lines into ganache to create the appearance of tree bark using the tip of a knife. Refrigerate until completely chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2ta5TIQyUFLjXFXCtq5_nnAaVqg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-step-13-1-47907e8ec77c4725a570637924b54272.jpg"
      ],
      "image": "assets/images/269557/step_24.webp"
    },
    {
      "text": "Dust with cocoa powder and confectioners' sugar before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rhPf_Lo7EehNuBnIRanQVyQz-ZY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269557-chocolate-yule-log-vat-4X3-3-1b895177b23a4bddacc5037caa2260d3.jpg"
      ],
      "image": "assets/images/269557/step_25.webp"
    }
  ],
