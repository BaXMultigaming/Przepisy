  "ingredients": [
    "3.5 cups water",
    "1 cup steel-cut oats",
    "0.25 cup heavy whipping cream",
    "0.25 cup brown sugar, or more to taste",
    "2 tablespoons butter",
    "1 teaspoon ground cinnamon",
    "1 banana, diced",
    "0.5 cup chopped walnuts",
    "1 teaspoon vanilla extract",
    "1 banana, sliced"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a saucepan. Stir in oats; cook until tender, 10 to 20 minutes. Stir heavy cream, brown sugar, butter, and cinnamon into the oats; simmer for 5 minutes. Add diced banana and walnuts; cook for 1 to 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove oats from heat and stir in vanilla extract. Serve in bowls topped with sliced banana.",
