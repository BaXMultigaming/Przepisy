  "ingredients": [
    "2 tablespoons butter",
    "0.5 cup white sugar",
    "3 tablespoons all-purpose flour",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground allspice",
    "0.125 teaspoon salt",
    "1 egg",
    "2 tablespoons white vinegar",
    "1 cup water",
    "1 (9 inch) unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan combine sugar, flour, cinnamon, cloves, allspice, and salt. Mix well, then whisk in egg, vinegar, and water. Add butter and cook mixture over low heat until thick, stirring constantly. Pour mixture into pastry shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pastry in preheated oven for 3 minutes. Pour in filling and bake for 20 to 25 minutes, or until crust is brown on edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
