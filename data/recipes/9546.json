  "ingredients": [
    "0.5 cup butter",
    "30 large marshmallows",
    "1.5 teaspoons green food coloring",
    "1 teaspoon vanilla extract",
    "4 cups cornflakes cereal",
    "2 tablespoons cinnamon red hot candies"
  ],
  "steps": [
    {
      "text": "Gather ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nJLQ_lu4aI83G7SWSi0qn4XjGLI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9546-christmas-wreaths-VAT-ingredients-4x3-b2709b740276472cb1f073c94c0ba956.jpg"
      ],
      "image": "assets/images/9546/step_01.webp"
    },
    {
      "text": "Melt butter in a large saucepan over low heat. Add marshmallows, and cook stirring constantly, until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mTRFcS7IARobOYuXMMDfJgbU1QU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9546-christmas-wreaths-VAT-step-01-1-4x3-2b19fb1455854a208cc388e79e2a2a34.jpg"
      ],
      "image": "assets/images/9546/step_02.webp"
    },
    {
      "text": "Remove from the heat, stir in food coloring and vanilla, then stir in cornflakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yFL7pcxcCUNytcJq8j1ARA0zG14=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9546-christmas-wreaths-VAT-step-01-2-4x3-03c14f94af4041a4b9b618da96a58e53.jpg"
      ],
      "image": "assets/images/9546/step_03.webp"
    },
    {
      "text": "Set out one or two sheets of waxed paper. Fill a skillet with 1 inch of very hot water. Place the saucepan into the skillet so cookie dough stays warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OKv5IkDt2MWGti67kx5VPwKW_3Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9546-christmas-wreaths-VAT-03-4x3-c477226fb3c6411cbb4a2f4a1564e7a3.jpg"
      ],
      "image": "assets/images/9546/step_04.webp"
    },
    {
      "text": "Quickly drop a heaping tablespoonful of cookie dough onto the waxed paper, and use lightly greased fingers to form it into a wreath shape. Immediately decorate cookie with red hot candies. Repeat to shape and decorate remaining cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oTgQKrkIgVJLJtyuUlGxTf1ko2A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9546-christmas-wreaths-VAT-step-05-3-4x3-4844cc4cb13e43f7881760ef71ad4b8f.jpg"
      ],
      "image": "assets/images/9546/step_05.webp"
    },
    {
      "text": "Allow cookies to cool to room temperature before removing from waxed paper, about 15 minutes. Store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D2rjtwwe27pu3-hvqJRSyjk7t30=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9546-Christmas_Wreaths_0512-4x3-8d28d0a2e15e4c1abe36a6bc38e90524.jpg"
      ],
      "image": "assets/images/9546/step_06.webp"
    }
