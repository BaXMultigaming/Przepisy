    "0.5 cup powdered sugar",
    "0.25 cup milk",
    "2 tablespoons maple syrup",
    "1 teaspoon brown sugar",
    "0.25 teaspoon ground cinnamon",
    "6 slices white bread, cut into thirds",
    "nonstick cooking spray"
