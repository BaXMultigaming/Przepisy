  "ingredients": [
    "1 tablespoon vegetable oil",
    "2 pounds beef flank steak",
    "1 cup beef broth",
    "1 (8 ounce) can tomato sauce",
    "1 (6 ounce) can tomato paste",
    "1 green bell pepper, seeded and sliced into strips",
    "1 small onion, sliced",
    "2 cloves garlic, chopped",
    "1 teaspoon ground cumin",
    "1 teaspoon chopped fresh cilantro",
    "1 tablespoon olive oil",
    "1 tablespoon white vinegar"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a large skillet over medium-high heat. Add flank steak and cook until browned, about 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X9MUwUHhjhMD36Gkpch3H3b9UEk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/79301-cuban-ropa-vieja-step1-002-1-194816dfcb43423b95b39559deb780d4.jpg"
      ],
      "image": "assets/images/79301/step_01.webp"
    },
    {
      "text": "Transfer steak to a slow cooker; pour in beef broth and tomato sauce. Add tomato paste, bell pepper, onion, garlic, cumin, cilantro, olive oil, and vinegar; stir until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mwsGQfx7WfL6NwnYjkBWvVuVzIE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/79301-cuban-ropa-vieja-step2-006-1-73be168bcb204c4e87c51b7f3e958261.jpg"
      ],
      "image": "assets/images/79301/step_02.webp"
    },
    {
      "text": "Cover and cook on Low for up to 10 hours, or on High for 4 hours.",
      "section": null,
      "name": null,
      "url": null,
