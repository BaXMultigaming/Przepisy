  "ingredients": [
    "cooking spray",
    "2 cups sifted all-purpose flour",
    "1 tablespoon baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "3 (6 ounce) containers vanilla-flavored yogurt (such as Yoplait®)",
    "1 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, baking soda, and salt in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix yogurt, sugar, eggs, and vanilla extract together in a large bowl. Stir in flour mixture a little at a time, mixing well between each addition to avoid lumps. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
