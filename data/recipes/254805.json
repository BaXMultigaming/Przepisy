  "ingredients": [
    "3 cups shredded zucchini",
    "2 eggs",
    "1 tablespoon vegetable oil",
    "0.25 teaspoon onion powder",
    "1 pinch salt",
    "0.5 cup dry potato flakes",
    "0.25 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat a waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
