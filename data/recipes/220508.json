  "ingredients": [
    "1 cup vegetable broth",
    "0.5 cup couscous",
    "1 tablespoon canola oil",
    "1 teaspoon ajwain (carom) seeds",
    "1 clove garlic, coarsely chopped",
    "1 teaspoon turmeric powder",
    "1 teaspoon curry powder",
    "0.5 teaspoon hing powder (asafoetida)",
    "1 pinch chili powder",
    "1 pinch ground cinnamon",
    "1 (12 ounce) package frozen shelled edamame (green soybeans)",
    "1 bunch broccoli, cut into florets",
    "sea salt to taste",
    "ground black pepper to taste",
    "1 tablespoon toasted sesame oil"
  ],
  "steps": [
    {
      "text": "Bring the vegetable broth to a boil in a saucepan. Add couscous and reduce heat to medium; simmer until broth is absorbed and couscous is tender, about 10 minutes. Fluff with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat canola oil in a large skillet or wok over medium-high heat. Add ajowan seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When seeds begin to sputter, stir in garlic and reduce heat to medium.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir turmeric, curry powder, hing powder, chili powder, and cinnamon into the garlic mixture until garlic is browned, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir edamame and broccoli in the spice mixture until vegetables are tender, about 5 minutes. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle sesame oil atop vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon vegetables over couscous to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
