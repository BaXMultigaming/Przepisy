  "ingredients": [
    "0.75 cup dark brown sugar",
    "0.33333334326744 cup cold water",
    "0.33333334326744 cup fish sauce",
    "0.33333334326744 cup rice vinegar",
    "4 cloves garlic, crushed",
    "1 tablespoon soy sauce",
    "1 tablespoon fresh grated ginger",
    "1 teaspoon vegetable oil",
    "8 boneless, skinless chicken thighs, quartered",
    "0.5 cup roasted peanuts",
    "1 bunch green onions, chopped",
    "2 fresh jalapeno peppers, seeded and sliced",
    "fresh cilantro sprigs, for garnish"
  ],
  "steps": [
    {
      "text": "Whisk brown sugar, water, fish sauce, rice wine vinegar, garlic, soy sauce, and ginger together in a bowl until brown sugar completely dissolved, about 1 minute; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over high heat; add chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/3 cup brown sugar mixture over chicken; cook and stir until mixture has a syrup-like consistency, 6 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in remaining brown sugar mixture; cook until chicken tender and no longer pink inside, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in in peanuts, green onions, and jalapeños; cook until warmed through, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with cilantro and serve.",
      "section": null,
      "name": null,
      "url": null,
