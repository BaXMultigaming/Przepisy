  "ingredients": [
    "0.25 cup raw cashews",
    "1 tablespoon white miso paste",
    "0.75 teaspoon lemon juice",
    "0.75 teaspoon white vinegar",
    "0.25 cup water",
    "7 tablespoons vegan mayonnaise",
    "0.5 teaspoon dried parsley",
    "0.5 teaspoon dried dill weed",
    "0.25 teaspoon dried mushroom powder",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion powder",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring a pot of water to a boil; add the cashews and boil for 20 minutes. Drain and rinse with cold water to cool them off.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the cashews are boiling, add miso paste, lemon juice, vinegar, and 3 1/2 tablespoons water to a blender cup and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise, parsley, dill, mushroom powder, garlic powder, onion powder, and pepper in a mixing bowl with a whisk; it will be very thick. Transfer to the refrigerator until cashews are done boiling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once the cashews are boiled and rinsed, add them to the blender cup and blend until very smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the blended cashew mixture into the mayonnaise mixture and whisk to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
