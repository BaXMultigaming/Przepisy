  "ingredients": [
    "1 pound bacon",
    "4 cups all-purpose flour",
    "2 cups shredded Cheddar cheese",
    "2 tablespoons baking powder",
    "1 teaspoon garlic salt",
    "0.5 teaspoon ground black pepper",
    "2 eggs",
    "2 cups milk",
    "0.5 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large skillet over medium-high heat until crisp, about 10 minutes. Drain the bacon slices on paper towels and crumble once cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Coat 24 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, Cheddar cheese, baking powder, garlic salt, and black pepper together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, milk, and vegetable oil together in a small bowl; stir into flour mixture just until moistened. Gently fold bacon through the batter. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 15 to 20 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
