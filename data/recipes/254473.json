  "ingredients": [
    "1 cup coconut water, or to taste",
    "1 banana, frozen",
    "0.75 cup fresh blueberries",
    "0.25 cup kale",
    "0.25 cup spinach",
    "2 Medjool dates, pitted and chopped",
    "1 tablespoon almond butter",
    "1 tablespoon hemp seed hearts",
    "1 tablespoon flax seeds",
    "1 tablespoon oats",
    "1 scoop vanilla protein powder",
    "2 tablespoons graham cracker crumbs"
  ],
  "steps": [
    {
      "text": "Combine coconut water, banana, blueberries, kale, spinach, dates, almond butter, hemp seed hearts, flax seeds, oats, and protein powder in a blender. Cover and puree until smooth. Top with graham cracker crumbs.",
