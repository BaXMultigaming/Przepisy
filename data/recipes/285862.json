  "ingredients": [
    "4 (1 ounce) squares semisweet baking chocolate",
    "0.5 cup unsalted butter",
    "1 tablespoon red wine",
    "1 teaspoon pure vanilla extract",
    "1 cup powdered sugar",
    "0.25 teaspoon ground ginger",
    "2 large eggs",
    "1 large egg yolk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease the bottom and sides of two 6-ounce ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until chocolate is melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat and whisk in wine and vanilla. Whisk in powdered sugar and ginger until smooth. Allow to cool slightly, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk in eggs and egg yolk. Pour mixture into the prepared ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until sides are firm and centers are soft, about 10 minutes. Remove from the oven and let stand for 1 minute, then loosen edges with a knife and invert each ramekin onto a serving plate. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
