  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix",
    "1 (11 ounce) can mandarin orange segments",
    "4 large eggs",
    "1 cup vegetable oil",
    "1 (20 ounce) can crushed pineapple with juice",
    "1 (8 ounce) container frozen whipped topping, thawed",
    "1 (3.5 ounce) package instant vanilla pudding mix"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, mandarin oranges with juice, eggs, and oil in a large bowl; beat with an electric mixer until smooth. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 35 to 40 minutes. Set aside to cool for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat pineapple with juice, whipped topping, and dry pudding mix together in a large bowl until blended. Spread on cooled cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
