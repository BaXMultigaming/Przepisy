  "ingredients": [
    "1.5 cups brown sugar",
    "1 cup white sugar",
    "0.75 cup butter, softened",
    "2 eggs",
    "1 tablespoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking powder",
    "1 cup oats",
    "1 cup crispy rice cereal (such as Rice Krispies®)",
    "1 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, white sugar, and butter together with an electric mixer in a large bowl until smooth. Add 1 egg one at a time, allowing the first egg to blend into butter mixture before adding the next egg with vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, baking soda, salt, and baking powder together in a bowl. Beat into butter mixture until just incorporated into a dough. Fold oats, crispy rice cereal, and coconut into dough; mixing just enough to evenly combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop cookie dough by teaspoonful onto baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until browned, 8 to 9 minutes. Cool cookies slightly on baking sheets before moving to cooling racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
