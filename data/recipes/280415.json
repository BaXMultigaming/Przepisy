  "ingredients": [
    "1 tablespoon unsalted butter",
    "1 cup Israeli couscous",
    "1 cup low-sodium chicken broth",
    "0.5 cup orange juice",
    "0.33333334326744 cup finely chopped dried apricots",
    "0.25 cup sweetened dried cranberries (such as Ocean Spray® Craisins®)",
    "1 tablespoon minced fresh ginger root",
    "1 tablespoon chopped fresh mint"
  ],
  "steps": [
    {
      "text": "Heat butter in a medium saucepan over medium heat. Add Israeli couscous and stir occasionally until lightly browned and toasted, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring chicken broth to a boil in a saucepan over medium-high heat. Pour over couscous and add orange juice. Stir in apricots, dried cranberries, and ginger. Bring back to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium-low, cover, and simmer until liquid has been absorbed, 10 to 11 minutes. Fluff with a fork, garnish with chopped mint, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
