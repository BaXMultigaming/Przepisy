  "title": "Hot Chocolate Cookies with Marshmallow Glaze",
  "description": "Hot chocolate cookies with marshmallow glaze are easy, chewy cookies made with cocoa mix for a yummy flavor reminiscent of childhood.",
  "authors": [
    "Stacey Hahn"
  ],
  "date_published": "2018-06-08T10:45:32-04:00",
