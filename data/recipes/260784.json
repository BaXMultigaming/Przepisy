  "ingredients": [
    "8 (1 ounce) envelopes instant hot cocoa mix",
    "0.5 cup butter, softened",
    "2 eggs",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1 cup confectioners' sugar",
    "2 tablespoons milk",
    "5 large marshmallows",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine hot cocoa mix, 1/2 cup butter, and eggs in a large bowl; beat with an electric mixer until creamy. Add flour, baking powder, and salt gradually; mix well. Drop teaspoonfuls of the dough onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are dry, about 8 minutes. Let cool on the baking sheets for 5 minutes. Transfer to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix confectioners' sugar and milk together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine marshmallows and 1 tablespoon butter in a microwave-safe bowl. Microwave until marshmallows melt, about 30 seconds. Stir into confectioners' sugar mixture with a fork until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle marshmallow glaze over cooled cookies. Let stand until set, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
