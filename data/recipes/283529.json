  "ingredients": [
    "1 cup rotini pasta",
    "1 (10.75 ounce) can (1/2 stick) unsalted butter",
    "1 cup shredded Cheddar cheese",
    "0.5 cup imitation crabmeat, diced",
    "0.5 cup milk",
    "0.25 teaspoon seafood seasoning (such as Old Bay®)",
    "0.125 teaspoon Cajun seasoning",
    "0.125 teaspoon ground black pepper",
    "0.25 cup dry bread crumbs",
    "2 tablespoons salted butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 1 ½-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil; cook rotini at a boil until tender yet firm to the bite, about 8 minutes. Drain and transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir soup, Cheddar cheese, imitation crab, milk, seafood seasoning, Cajun seasoning, and black pepper into rotini until combined. Transfer to the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs and melted butter in a small bowl until crumbs are moist; spread evenly over casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven until bubbly and topping is golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
