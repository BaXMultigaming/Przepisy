  "ingredients": [
    "1.25 cups warm milk",
    "1 egg, beaten",
    "2 tablespoons butter, softened",
    "0.25 cup honey",
    "0.75 teaspoon salt",
    "2.75 cups bread flour",
    "1 cup whole wheat flour",
    "1.25 teaspoons bread machine yeast",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Place ingredients in the pan of the bread machine in the order recommended by the manufacturer. Select dough cycle; press start.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When dough cycle has finished, turn dough out onto a lightly floured surface and roll out 3/4 inch thick. Cut out rolls with a 3 to 4 inch diameter biscuit cutter. Place on lightly greased cookie sheets; cover and let rise until doubled, about 1 hour. Meanwhile, preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 10 to 15 minutes. When rolls are finished baking, brush with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
