  "ingredients": [
    "9 ounces cream cheese",
    "1 cup butter",
    "3 egg yolks",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "1 pinch salt",
    "0.5 teaspoon baking powder",
    "3 egg whites",
    "8 ounces ground walnuts",
    "1 cup white sugar",
    "0.33333000540733 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "In a medium bowl, cream butter and cream cheese. Stir in egg yolks and vanilla. Stir together flour, salt, and baking powder. Add flour mixture a little at a time until it is fully incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 5 parts, wrap in plastic, and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, beat egg whites to soft peaks. Add sugar a little at a time while continuing to beat to stiff peaks. Fold in ground walnuts, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a lightly floured surface, roll dough out until it is 1/4 to 1/8 inch thick. Cut into 3-inch squares. Place 1/2 teaspoon filling in the center of each square and roll up from corner to corner. Place on cookie sheets and refrigerate until hardened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cookies in the preheated oven for 10 to 12 minutes, until lightly browned. Roll in confectioners' sugar when cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
