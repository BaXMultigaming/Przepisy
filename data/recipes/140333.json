  "ingredients": [
    "0.25 teaspoon softened butter",
    "2 teaspoons heavy cream",
    "2 eggs",
    "salt and pepper to taste",
    "1 teaspoon minced fresh chives",
    "1 teaspoon grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub the inside of a 6-ounce ramekin with butter. Pour cream into the ramekin, then crack eggs on top of cream without breaking yolks. Use a spoon to position yolks towards the center of the ramekin, then sprinkle with salt, pepper, chives, and Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until whites of eggs have set and yolks are still soft, 12 to 15 minutes. Remove from oven, and allow to set for 2 to 3 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
