  "ingredients": [
    "cooking spray",
    "3 large eggs, beaten",
    "1 tablespoon apple cider vinegar",
    "3 medium ripe bananas, mashed",
    "0.25 cup coconut oil, melted",
    "0.25 cup honey",
    "1 teaspoon vanilla extract",
    "3 cups almond flour",
    "1 teaspoon ground cinnamon",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon salt"
  ],
