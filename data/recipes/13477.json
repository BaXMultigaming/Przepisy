  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "0.5 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "2 large eggs",
    "1 (9 inch) prepared graham cracker crust",
    "0.5 cup pumpkin puree",
    "0.5 teaspoon ground cinnamon",
    "1 pinch ground cloves, or more to taste",
    "1 pinch ground nutmeg, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yNjvfMllvIFPJpc15XI3u1ZTuZA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13477-double-layer-pumpkin-cheesecake-VAT-step-01-c26e5ef6adae4e65b6ae82914c5d05fb.jpg"
      ],
      "image": "assets/images/13477/step_01.webp"
    },
    {
      "text": "Beat cream cheese, sugar, and vanilla extract together in a large bowl with an electric mixer until smooth. Add eggs, one at a time, blending cheesecake layer until well combined after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Iv0YgU2mXzm5R92TmS6rAj1VFZY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13477-double-layer-pumpkin-cheesecake-VAT-step-02-623db973c08c4a319a86f60f9e5f81e0.jpg"
      ],
      "image": "assets/images/13477/step_02.webp"
    },
    {
      "text": "Spread 1 cup batter in crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ByJxZQ_wFKADb34g3NjxvpmjmW8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13477-double-layer-pumpkin-cheesecake-VAT-step-03-f7bb88dcf32a42f28b49ecffde9f8529.jpg"
      ],
      "image": "assets/images/13477/step_03.webp"
    },
    {
      "text": "Add pumpkin puree, cinnamon, cloves, and nutmeg to remaining batter; stir gently until pumpkin layer is well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4Ce9uPQE93EMYYmZ9F5gVtOQdvU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13477-double-layer-pumpkin-cheesecake-VAT-step-04-34d9fa6634b94eefb24b690b2bdcaf6b.jpg"
      ],
      "image": "assets/images/13477/step_04.webp"
    },
    {
      "text": "Carefully spread on top of cheesecake layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7keklgSjHB7T6_C5zd6_qOaFrOI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13477-double-layer-pumpkin-cheesecake-VAT-step-05-9ee34beeb6db463dada15a889114d65c.jpg"
      ],
      "image": "assets/images/13477/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until edges puff and surface is firm except for a small spot in center that jiggles when the pan is gently shaken, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KfrNQZOwFxUkwlVToDY-UYXU6jo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13477-double-layer-pumpkin-cheesecake-VAT-step-06-45b8c1103a00455f8a0b139a82352d6f.jpg"
      ],
      "image": "assets/images/13477/step_06.webp"
    },
    {
      "text": "Remove from the oven, set on a wire rack; cool to room temperature, 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TbR9Fp67IZfAODawrCni6wdzI9o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13477-double-layer-pumpkin-cheesecake-VAT-step-07-9b81bc8a5aea424d88085f16149b1632.jpg"
      ],
      "image": "assets/images/13477/step_07.webp"
    },
    {
      "text": "Refrigerate until set, at least 3 hours or overnight, before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RM4QUKU-wBnLFo80IUOPXdNsjzo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13477-double-layer-pumpkin-cheesecake-VAT-4x3-904eb668e0c3482bb15d79730307cde3.jpg"
      ],
      "image": "assets/images/13477/step_08.webp"
    }
  ],
