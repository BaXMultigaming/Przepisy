  "ingredients": [
    "3 cups water",
    "2 Assam tea bags",
    "2 Ceylon tea bags",
    "0.125 cup Chinese lump white sugar",
    "1 (1/4 inch thick) slice fresh ginger",
    "0.5 inch cinnamon stick",
    "2 dried rose buds",
    "3 pods green cardamom",
    "2 pods black cardamom",
    "1 cup evaporated milk"
