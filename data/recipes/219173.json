  "ingredients": [
    "1 tablespoon vegetable oil",
    "3.5 pounds beef chuck pot roast",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper",
    "1 cup diced carrots",
    "1 cup diced celery",
    "1 cup diced onion",
    "0.25 cup butter",
    "1 teaspoon dried rosemary"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 275 degrees F (135 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9RYJOFnegUBgB8XiqO5kZu_Rdbg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-219173-simple-beef-pot-roast-ddmfs-4x3-ingredients-509d247082204fe0b038a39504b6a17f.jpg"
      ],
      "image": "assets/images/219173/step_01.webp"
    },
    {
      "text": "Heat vegetable oil into a large oven-safe pot over medium-high heat. Season chuck roast with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kXa1RlbLG1te8jNq1H86zXydjrU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-219173-simple-beef-pot-roast-ddmfs-4x3-steps-03-49413402e87d40499ec30e8d6d3d1f85.jpg"
      ],
      "image": "assets/images/219173/step_02.webp"
    },
    {
      "text": "Cook in hot oil until brown on both sides; transfer to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6tCaVueXtbkG8nMdqqlTg3q14WA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-219173-simple-beef-pot-roast-ddmfs-4x3-steps-04-dc2480fb3717478c985eee9783237f42.jpg"
      ],
      "image": "assets/images/219173/step_03.webp"
    },
    {
      "text": "Add carrots, celery, and onion into the pot. Cook and stir until vegetables start to release their juices, scraping any brown flavor bits off the bottom of the pot, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hPojZpHqF4LS2IdB268b2_oV_ZI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-219173-simple-beef-pot-roast-ddmfs-4x3-steps-05-fd1294b03f7d4b8189910b1b5674c85b.jpg"
      ],
      "image": "assets/images/219173/step_04.webp"
    },
    {
      "text": "Add butter, and cook until onions are translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/slTGBjTigr8299z6A0I36uKpHVU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-219173-simple-beef-pot-roast-ddmfs-4x3-steps-06-2e9c33be65c14fd7beb2b14431680fe5.jpg"
      ],
      "image": "assets/images/219173/step_05.webp"
    },
    {
      "text": "Sprinkle in rosemary; return roast to the pot and cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EYGQUyRSI6wpMgdqJZrvhtQhgiI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-219173-simple-beef-pot-roast-ddmfs-4x3-steps-08-07724102ac5a4159b7a69b950a584f6f.jpg"
      ],
      "image": "assets/images/219173/step_06.webp"
    },
    {
      "text": "Roast in the preheated oven until the chuck roast is tender, about 2 1/2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HngDFMfCKA2yuvKkM2jFflbq1G8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-219173-simple-beef-pot-roast-ddmfs-4x3-steps-08a-f653fcca4dc84fbfab470c82b6a19969.jpg"
      ],
      "image": "assets/images/219173/step_07.webp"
    },
    {
      "text": "Season vegetables with additional salt and black pepper, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KvrQRue38PEskBAhpH1Z4YdS_ow=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-219173-simple-beef-pot-roast-ddmfs-4x3-hero-bfbccdbc20864624b556675b6d51ae04.jpg"
      ],
      "image": "assets/images/219173/step_08.webp"
    }
