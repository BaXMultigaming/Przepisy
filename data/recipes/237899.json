  "ingredients": [
    "1.5 pounds pork belly, cut into small pieces",
    "3 cloves garlic, crushed",
    "2 bay leaves",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 cups oil for frying, or as needed"
  ],
