    "2 cloves garlic, minced",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "0.5 cup water",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon salt"
