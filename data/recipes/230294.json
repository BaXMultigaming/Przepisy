  "steps": [
    {
      "text": "Beat both amounts of meringue powder, 1 cup warm water, cream of tartar, then confectioners' sugar in a large bowl using an electric mixer on low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrape down sides of bowl and increase mixer speed to medium; beat until fluffy and shiny, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "If frosting is too stiff, beat in 2 tablespoons warm water, or as needed, adding water in small amounts. Keep frosting covered with a damp towel until needed.",
