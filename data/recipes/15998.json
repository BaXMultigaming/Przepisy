  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, shortening, and salt in a large bowl using a pastry blender. Mix in 6 to 8 tablespoons ice water until mixture forms a ball. Divide ball in half.",
