  "ingredients": [
    "0.25 cup soy sauce",
    "3 green onions, thinly sliced",
    "1 tablespoon black sesame oil",
    "1 tablespoon rice vinegar",
    "1 teaspoon grated ginger",
    "0.5 teaspoon garlic, minced",
    "12 ounces smoked salmon, chopped",
    "2 cups cooked brown rice",
    "0.25 cup diced mango",
    "0.25 cup diced cucumber",
    "0.25 cup diced avocado",
    "0.25 cup sliced fresh strawberries",
    "1 teaspoon black sesame seeds, or to taste"
  ],
  "steps": [
    {
      "text": "Combine soy sauce, green onions, sesame oil, rice vinegar, ginger, and garlic in a bowl. Mix until thoroughly combined. Add salmon and marinate in the refrigerator for 30 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide brown rice among 4 serving bowls. Top with salmon, mango, cucumber, avocado, and strawberries. Sprinkle black sesame seeds on top.",
