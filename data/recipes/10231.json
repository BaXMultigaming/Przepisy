  "ingredients": [
    "3 ounces cream cheese",
    "0.5 cup butter, softened",
    "1 cup all-purpose flour",
    "0.5 cup any flavor fruit jam",
    "0.33333334326744 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ykz40JMzHuk_Wuf8CFsw6mB_ANk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10231-cream-cheese-kolacky-ingredients-878926ae7f03424986ec39dc8ac000ac.jpg"
      ],
      "image": "assets/images/10231/step_01.webp"
    },
    {
      "text": "Mix cream cheese and butter together in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xe2l1Q-EFDBFk3oZ_FkaKmhkKuU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10231-cream-cheese-kolacky-step-01-2-11bdf0a51ee743cc9419a80a2bc6308f.jpg"
      ],
      "image": "assets/images/10231/step_02.webp"
    },
    {
      "text": "Gradually stir in flour until just combined. Shape dough into a ball; cover the bowl and refrigerate for at least 3 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/riwNOp3rDZzdv-yu4Atq-6mNPr0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10231-cream-cheese-kolacky-step-02-95eeb88c6002466db9bf59c05a88edc4.jpg"
      ],
      "image": "assets/images/10231/step_03.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out dough on a floured pastry board to a thickness of 1/8 inch. Cut into 2 ½-inch squares and place about 1/2 teaspoon of jam or preserves in the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PW02aJB7C2inNsFAHcnOQJzxNis=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10231-cream-cheese-kolacky-step-05-4-661f8d5388a04d35af25eca65e917bbc.jpg"
      ],
      "image": "assets/images/10231/step_05.webp"
    },
    {
      "text": "Overlap opposite corners and pinch together to seal. Place on ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IDU7pTRrVJy8prf9QPNnj13spMI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10231-cream-cheese-kolacky-step-06-2-979da6d74a13437c98effa37e6b3304b.jpg"
      ],
      "image": "assets/images/10231/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until golden, about 10 to 12 minutes. Cool on wire racks. Dust kolacky lightly with confectioners sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XSZW81y6BUxSsJXfjLbZE1W34fo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10231-cream-cheese-kolacky-vat-4X3-2-07755b1ade8d42cf88cdccfb79a95041.jpg"
