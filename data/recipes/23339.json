  "ingredients": [
    "0.5 cup butter",
    "1 cup white sugar",
    "3 egg yolks",
    "1 teaspoon vanilla extract",
    "0.25 cup all-purpose flour",
    "1 cup evaporated milk",
    "1 cup chopped walnuts",
    "1 (9 inch) pie shell, baked"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream the butter and sugar until light and fluffy. Beat in the egg yolks and add vanilla. Beat in the flour and evaporated milk. Stir in chopped walnuts. Pour into pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 60 minutes, or until golden brown.",
      "section": null,
      "name": null,
