  "ingredients": [
    "nonstick cooking spray",
    "1 pound bacon",
    "1 (16 ounce) package shredded Cheddar cheese",
    "1 tablespoon all-purpose flour",
    "12 large eggs",
    "1 cup milk",
    "0.75 teaspoon kosher salt",
    "0.75 teaspoon ground black pepper",
    "0.75 teaspoon seasoned salt",
    "0.25 teaspoon dry mustard",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Spray a 9x13-inch casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place Cheddar cheese into the bottom of the prepared dish and sprinkle with flour. Toss together with your fingers to distribute evenly. Sprinkle bacon evenly over the cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, milk, salt, pepper, seasoned salt, dry mustard, onion powder, garlic powder, and paprika in a bowl. Pour over the bacon and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until the center is set and the top has browned, about 45 minutes. Let stand for 5 minutes before cutting and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
