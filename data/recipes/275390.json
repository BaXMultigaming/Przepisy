  "steps": [
    {
      "text": "Grab your ingredients, and preheat an air fryer to 400 degrees F (200 degrees C). Lightly grease the inside of the air fryer basket with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xcLVicMW21BxxRf3v4HBy4CpvRo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275390-air-fryer-sausage-patties-ddmfs-step1-121-752b8f35364b4e15a5dc05d8896d8b9a.jpg"
      ],
      "image": "assets/images/275390/step_01.webp"
    },
    {
      "text": "Arrange sausage patties in a single layer in the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DoK1SkZnSgZA7jDRMlEMtLBn130=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275390-air-fryer-sausage-patties-ddmfs-step2-125-9176a979e74e4e7da3bb93d43ffbcbca.jpg"
      ],
      "image": "assets/images/275390/step_02.webp"
    },
    {
      "text": "Cook in the preheated air fryer for 5 minutes; flip the patties and cook about 3 minutes more. An instant-read thermometer inserted into the center of a patty should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8lNrLXAGoJjYy50rBUZmiWBesKk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275390-air-fryer-sausage-patties-ddmfs-step4-140-21dde06a985a44088f11325a59744791.jpg"
      ],
      "image": "assets/images/275390/step_03.webp"
    },
    {
      "text": "Serve hot and enjoy!",
