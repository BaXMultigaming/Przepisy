  "ingredients": [
    "1 cup buckwheat groats",
    "1.5 cups boiling water",
    "1 cup spelt flour",
    "0.5 cup unsweetened shredded coconut",
    "2 teaspoons baking powder",
    "1 cup soy milk",
    "1 egg",
    "2 tablespoons oil",
    "2 tablespoons honey",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Place buckwheat groats in a bowl. Pour boiling water over groats and set aside for groats to absorb water, about 10 minutes. Retain water if it doesn't all absorb.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, coconut, and baking powder together in a separate bowl. Beat milk, egg, oil, and honey together in a third bowl. Stir buckwheat groats mixture and flour mixture into milk mixture until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray skillet with cooking spray. Pour batter, 1/4 to 1/3 cup per pancake, into heated skillet. Cook until bubbles form and the edges are dry, about 2 minutes. Flip and cook until browned on the other side, 2 more minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
