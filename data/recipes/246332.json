  "ingredients": [
    "1 (6 pound) pork butt roast",
    "1.5 tablespoons salt",
    "1 tablespoon dried oregano",
    "2 teaspoons ground cumin",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon chile powder",
    "0.5 teaspoon paprika",
    "2 tablespoons olive oil, or more to taste",
    "1 cup orange juice",
    "1 onion, coarsely chopped",
    "4 cloves garlic, diced, or more to taste"
  ],
  "steps": [
    {
      "text": "Trim excess fat from pork butt; cut pork into 2-inch cubes and transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n_4ThFKhiytHykQTj1AtUwB7QW0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246332-carnitas-pressure-cooker-ddmfs-4x3-step1-0014-6450ad0d06b24dc9baa4d8e0940739cc.jpg"
      ],
      "image": "assets/images/246332/step_01.webp"
    },
    {
      "text": "Combine salt, oregano, cumin, black pepper, chile powder, and paprika in a small bowl. Rub pork cubes with spice mixture. Coat seasoned pork cubes lightly in olive oil; transfer to a pressure cooker. Cover pork cubes with orange juice, onion, and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-MEXhqDBZJ4sQuXGj-WF86Cqm7I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246332-carnitas-pressure-cooker-ddmfs-4x3-step2-0016-2c580ab068014a57bf19998bb3bbac72.jpg"
      ],
      "image": "assets/images/246332/step_02.webp"
    },
    {
      "text": "Cover pork cubes with orange juice, onion, and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AEw8h94jlSyLbBZ4E9J3SibwBw8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246332-carnitas-pressure-cooker-ddmfs-4x3-step3-0017-76124eb967954922a8add6513956f682.jpg"
      ],
      "image": "assets/images/246332/step_03.webp"
    },
    {
      "text": "Place lid on the pressure cooker and lock; bring to full pressure over medium heat until pork is no longer pink in the center, about 60 minutes. Let pressure come down naturally, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wOuvOYWT0nGpT7446Y36lZXEkXk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246332-carnitas-pressure-cooker-ddmfs-4x3-step4-0081-2c931484ae954f46b5e177fb812f1fb2.jpg"
      ],
      "image": "assets/images/246332/step_04.webp"
    },
    {
      "text": "Remove pork from the pressure cooker and shred meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Fs6aT-muiFVFyh92hjTz5LrZii0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246332-carnitas-pressure-cooker-DDMFS-4x3-0010d829834f4832b9bf386e1b9f49bb.jpg"
