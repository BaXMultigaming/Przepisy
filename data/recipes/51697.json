  "ingredients": [
    "1 pint heavy cream",
    "1 tablespoon confectioners' sugar",
    "2 cups sour cream",
    "3 cups miniature marshmallows",
    "1 (20 ounce) can crushed pineapple, drained",
    "1 pint strawberries, hulled and sliced",
    "1 pint fresh blueberries",
    "1.5 cups flaked coconut"
  ],
  "steps": [
    {
      "text": "Beat heavy cream and confectioners' sugar in a large bowl with an electric mixer until thick but not grainy; beat in sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold in marshmallows, pineapple, strawberries, blueberries, and coconut with a rubber spatula until well combined. Cover the bowl with plastic wrap; chill before serving, 4 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
