  "ingredients": [
    "0.75 pound plums, pitted and chopped",
    "0.5 medium red onion, minced",
    "3 habanero peppers, seeded and minced",
    "3 tablespoons minced fresh cilantro",
    "1 teaspoon sugar",
    "1.5 cups water",
    "1 cup uncooked basmati rice, rinsed and drained",
    "0.75 pound boneless, skinless chicken breasts",
    "2 teaspoons fresh rosemary, minced",
    "salt and pepper to taste",
    "2 teaspoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Combine plums, onion, habaneros, cilantro, and sugar in a bowl. Cover the bowl with plastic wrap; refrigerate salsa about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and rice to a boil in a medium saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and water has been absorbed, about 20 minutes. Cool slightly; fluff with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, season chicken with fresh rosemary, salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add chicken breasts; brown about 1 minute per side. Reduce heat to medium; cook about 5 minutes more per side. Serve chicken over rice with plum salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
