  "ingredients": [
    "1 (9 inch) pie shell",
    "0.25 cup butter, softened",
    "1 cup white sugar",
    "2 eggs",
    "2 cups applesauce",
    "0.25 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium mixing bowl combine butter or margarine, sugar, and eggs. Beat until smooth. Add applesauce and vanilla. Mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour custard mixture into pie shell. Sprinkle top lightly with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 to 40 minutes or until set in center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
