  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B4zRycavzk3NbwAegFrl46R80D8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/267904-oven-baked-bacon-ddmfs-step-1-037cad0f3a3a4fd6b443aae985c2a7b4.jpg"
      ],
      "image": "assets/images/267904/step_01.webp"
    },
    {
      "text": "Place bacon slices, one next to the other, on the prepared baking sheet. Bake in the preheated oven for 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d4YRXycExkslORoBsMeOm-ZThnQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/267904-oven-baked-bacon-ddmfs-step-2-42dac5e288b44defbd6245cc764d55de.jpg"
      ],
      "image": "assets/images/267904/step_02.webp"
    },
    {
      "text": "Remove from the oven to flip bacon slices with kitchen tongs and then return to the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qJIrVcp7zK8R5SEE_QM8lEguQKc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/267904-oven-baked-bacon-ddmfs-step-3-1d679b0edab44c59a4e0b21d5a4415ab.jpg"
      ],
      "image": "assets/images/267904/step_03.webp"
    },
    {
      "text": "Bake until crispy, 15 to 20 minutes more. Thinner slices will need less time, about 20 minutes total. Drain on a plate lined with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7b9u0RVfGg_5L73WslvoF5iw404=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/267904-oven-baked-bacon-ddmfs-step-4-2047b87a02bb4cf5babe2ef0b99fbe20.jpg"
      ],
      "image": "assets/images/267904/step_04.webp"
    },
    {
      "text": "Enjoy!",
