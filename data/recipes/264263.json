  "ingredients": [
    "1 cup frozen mango chunks",
    "1 cup frozen pineapple chunks",
    "7 ounces frozen unsweetened acai pulp (such as Sambazon®)",
    "1 cup iced water, or as needed",
    "1 tablespoon lime juice",
    "0.25 cup unsweetened shredded coconut",
    "1 teaspoon chia seeds",
    "1 teaspoon agave nectar"
  ],
  "steps": [
    {
      "text": "Place mango, pineapple, acai, water, and lime juice in a blender; pulse until smooth and creamy. Pour mixture into 2 bowls; sprinkle with shredded coconut and chia seeds. Drizzle with agave.",
