  "ingredients": [
    "1 tablespoon olive oil",
    "2 cups stemmed and chopped rainbow chard",
    "1 cup fresh spinach",
    "0.5 cup arugula",
    "2 cloves garlic, minced",
    "4 eggs, beaten",
    "0.5 cup shredded Cheddar cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium-high heat. Saute chard, spinach, and arugula until tender, about 3 minutes. Add garlic; cook and stir until fragrant, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix eggs and cheese together in a bowl; pour into the chard mixture. Cover and cook until set, 5 to 7 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
