  "ingredients": [
    "0.5 cup butter",
    "2.25 cups all-purpose flour",
    "1 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon baking soda",
    "0.125 teaspoon ground cloves",
    "3 ripe bananas, mashed",
    "1 teaspoon baking powder",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter or margarine with an electric mixer on medium to high speed for 30 seconds. Add one cup of the flour, the sugar, eggs, baking powder, vanilla, cinnamon, soda, and cloves. Beat until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the remaining flour. Beat in bananas and nuts. Drop by rounded teaspoons 2 inches apart onto a greased cookie sheet. Bake for 8 to 10 minutes or until edges are lightly browned. Cool cookies on a rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
