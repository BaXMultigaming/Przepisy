  "ingredients": [
    "1 cup peanut butter",
    "0.5 cup low-calorie natural sweetener (such as Swerve®)",
    "1 egg",
    "1 teaspoon sugar-free vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_pLNP5_SiKnWplJbKAdbFCkIOMo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-261181-4-ingreddient-keto-peanut-butter-cookies-DDMFS-Step-1-97795854025749f9ab64b75361828efd.jpg"
      ],
      "image": "assets/images/261181/step_01.webp"
    },
    {
      "text": "Combine peanut butter, sweetener, egg, and vanilla extract in a bowl; mix well until a dough is formed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tPswLFgu2oRwlrgUdMuIeXhZrog=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-261181-4-ingreddient-keto-peanut-butter-cookies-DDMFS-Step-4-1-148aa66b16424fd190b315c4bc75c7dd.jpg"
      ],
      "image": "assets/images/261181/step_02.webp"
    },
    {
      "text": "Roll dough into 12 (1-inch) balls. Place on the prepared baking sheet and press down twice with a fork in a criss-cross pattern.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YC6w3RtcVaCapg7UbM8nGTUHIbY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-261181-4-ingreddient-keto-peanut-butter-cookies-DDMFS-Step-4-2-521ea3c0bda44942aa9f359b9d905766.jpg"
      ],
      "image": "assets/images/261181/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/buCbTVsHmUpFLh0faFziD7tWSS8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-261181-4-ingreddient-keto-peanut-butter-cookies-DDMFS-Step-5-50b2344b99f64d3081de50f5bbdcebaf.jpg"
      ],
      "image": "assets/images/261181/step_04.webp"
    },
    {
      "text": "Cool for 1 minute before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BEDguP8_rI98MhfxO3zXyUjQl7o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-261181-4-ingreddient-keto-peanut-butter-cookies-DDMFS-Step-6-a65c9933fca7414b87fb78eb3052a745.jpg"
