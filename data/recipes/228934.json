  "ingredients": [
    "1 recipe pastry for a single 9-inch pie crust",
    "1 (28 ounce) can sliced peaches, drained",
    "1 cup white sugar",
    "1 egg",
    "1 tablespoon all-purpose flour",
    "1 teaspoon butter",
    "0.25 teaspoon ground cinnamon, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press crust into a 9-inch pie plate; fill with peaches. Combine sugar, egg, flour, butter, and cinnamon in a bowl; sprinkle evenly over peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Reduce the oven temperature to 350 degrees F (175 degrees C); continue baking until filling is bubbling and crust is lightly brown, 40 to 45 minutes more.",
      "section": null,
