  "ingredients": [
    "2 tablespoons popping sorghum",
    "1 teaspoon canola oil",
    "1 teaspoon white sugar",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Pour sorghum into a small brown paper bag and fold shut. Microwave on High until the majority of sorghum is popped, 1 to 1 1/2 minutes. Transfer popped sorghum into a bowl and drizzle with canola oil; sprinkle with sugar and cinnamon. Toss to coat.",
