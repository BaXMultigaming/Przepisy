  "ingredients": [
    "cooking spray",
    "4.5 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "1.5 cups white sugar",
    "1.5 cups brown sugar",
    "1 ripe banana",
    "4 large eggs",
    "1 tablespoon vanilla extract",
    "5 cups chocolate chips",
    "2 cups sweetened flaked coconut",
    "2 cups chopped almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, brown sugar, and banana together in a separate bowl until smooth and creamy; beat in eggs, one at a time, until well mixed. Stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir banana mixture into flour mixture until batter is well mixed; fold in chocolate chips, coconut, and almonds. Drop batter by rounded spoonfuls onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges of cookies are beginning to crisp, 8 to 10 minutes. Cool cookies on baking sheet for 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
