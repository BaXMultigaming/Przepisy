  "ingredients": [
    "10 shrimp - peeled, deveined, and chopped",
    "1 onion, chopped",
    "1 potato, diced",
    "1.5 cups all-purpose flour",
    "1 cup water",
    "0.5 cup frozen corn",
    "1 egg",
    "1 teaspoon chicken bouillon granules",
    "1 teaspoon salt",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.25 cup hot water",
    "vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Combine shrimp, onion, potato, flour, 1 cup water, corn, egg, chicken bouillon, salt, baking powder, and baking soda in a bowl. Mix in hot water until well combined. Let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat oil in a wok over medium- to medium-high heat. Drop spoonfuls of batter into the hot oil. Cook fritters in batches, flipping halfway, until browned on both sides, 3 to 4 minutes. Drain on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
