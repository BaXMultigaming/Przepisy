  "ingredients": [
    "2 tablespoons vegetable oil",
    "0.5 cup chopped onion",
    "4 (1/2-inch thick) pork chops",
    "0.5 teaspoon salt",
    "ground black pepper to taste",
    "2 apples - peeled, cored and sliced",
    "0.75 cup hot water",
    "2 tablespoons brown sugar",
    "0.5 teaspoon ground mustard",
    "0.125 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet. Sauté onion until tender, about 1 minute. Remove onion and set aside. Brown pork chops on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chops in an 8x12-inch baking dish and sprinkle them with salt and pepper. Cover chops with apples and cooked onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water, brown sugar, mustard, and cloves in a small bowl. Pour over chops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake in the preheated oven for 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
