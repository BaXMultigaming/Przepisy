  "ingredients": [
    "0.5 pound potatoes, peeled and cut into 1 1/2-inch cubes",
    "1 teaspoon salt",
    "1 cup unsweetened coconut cream",
    "3 green chile peppers, chopped",
    "4 fresh curry leaves",
    "0.5 teaspoon cayenne pepper",
    "0.75 teaspoon saffron powder",
    "1 clove garlic, minced",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "Combine the potatoes, salt, coconut cream, green chiles, curry leaves, cayenne pepper, saffron powder, garlic, and water in a saucepan. Cook over medium heat, stirring frequently, until the coconut cream thickens, about 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Test the potatoes for doneness by piercing them with the tip of a paring knife. When the potatoes are tender, remove the pan from the heat. Let stand for 5 minutes before serving. Serve with plain rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
