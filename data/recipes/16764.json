  "ingredients": [
    "1 cup all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon chili powder",
    "1 teaspoon garlic powder",
    "2 eggs",
    "1 cup beer",
    "0.5 quart vegetable oil",
    "2 cups sliced jalapeno peppers"
  ],
  "steps": [
    {
      "text": "Mix flour, salt, pepper, red chili powder, garlic powder, eggs, and beer together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep fryer, or large pot heat oil to 365 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip the sliced jalapeños in the batter. Place battered jalapeños in deep fryer. The jalapeños are fully cooked when they float to the surface of the oil. They should be golden brown and crispy.",
