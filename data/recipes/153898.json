  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 cup chopped celery",
    "1 cup chopped onion",
    "8 cups dry bread crumbs",
    "2 tablespoons chopped fresh parsley",
    "3 cups oysters, liquid reserved",
    "3 large eggs, beaten",
    "1.5 teaspoons salt",
    "1 teaspoon poultry seasoning",
    "0.5 teaspoon dried thyme",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add celery and onion; stir until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P4DzCp0fXup61sWqjhR9ffrHQ50=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/153898-oyster-dressing-stuffing-VAT-03-4x3-50680cc8f29e42c38db95cb438c3cdb3.jpg"
      ],
      "image": "assets/images/153898/step_02.webp"
    },
    {
      "text": "Mix in bread crumbs and parsley; remove from the heat. Stir in oysters, eggs, salt, poultry seasoning, thyme, and pepper. Add enough reserved oyster liquid to moisten mixture, stirring until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KHptTCZ9LHoFZXjkxVHnVTQJXsE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/153898-oyster-dressing-stuffing-VAT-06-4x3-4bcda39286224a50b070040e8425f9e2.jpg"
      ],
      "image": "assets/images/153898/step_03.webp"
    },
    {
      "text": "Transfer to the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5TfxZAzcXFTQWTlbyA571WITfiE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/153898-oyster-dressing-stuffing-VAT-08-4x3-27241dd95342473dbcf5923d38a30fbe.jpg"
      ],
      "image": "assets/images/153898/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until the top is golden, and a knife inserted into the center comes out clean, about 45 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KtbrvrMCuEOgObsosknZheAmqis=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/153898-oyster-dressing-stuffing-VAT-09-4x3-93da549572954dd59c37be44d2c8c1dc.jpg"
      ],
      "image": "assets/images/153898/step_05.webp"
    }
  ],
