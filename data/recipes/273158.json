  "ingredients": [
    "1 pound ground turkey",
    "salt and ground black pepper to taste",
    "4 medium potatoes, peeled and thickly sliced",
    "6 medium carrots, peeled and thickly sliced",
    "1 small onion, roughly chopped",
    "2 (10.75 ounce) cans tomato soup",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon seasoned salt (such as Lawry's®)",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Add ground turkey to the hot skillet; season with salt and pepper. Cook and stir until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer turkey to a slow cooker. Add potatoes, carrots, and onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together tomato soup, Worcestershire sauce, seasoned salt, and 1 teaspoon pepper in a large bowl; stir into the slow cooker until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until vegetables are tender, 6 to 8 hours, or on High, 3 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
