  "ingredients": [
    "2 cups confectioners' sugar",
    "0.25 cup multicolored candy sprinkles",
    "3 tablespoons whole milk",
    "1 tablespoon lemon juice",
    "1 teaspoon vanilla extract",
    "1 pinch salt",
    "2 cups all-purpose flour",
    "2 tablespoons brown sugar, or more to taste",
    "1.5 tablespoons baking powder",
    "0.75 teaspoon kosher salt",
    "1 cup milk",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.25 cup unsalted butter, melted",
    "0.25 cup multicolored candy sprinkles",
    "vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Whisk confectioners' sugar, 1/4 cup sprinkles, 3 tablespoons milk, lemon juice, 1 teaspoon vanilla extract, and 1 pinch salt together in a bowl to make a smooth glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N82o5d8leL_smzTQvcvSsCDAxeU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246607_Funfetti-Donut-Holes-glaze-4x3-ca53b1f1fe42401096bd32a03d356264.jpg"
      ],
      "image": "assets/images/246607/step_01.webp"
    },
    {
      "text": "Whisk flour, brown sugar, baking powder, and 3/4 teaspoon salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup milk, egg, and 1 teaspoon vanilla extract in a small bowl. Stir into the flour mixture. Add melted butter and 1/4 cup sprinkles; mix until a soft dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JTzNUeiIRSIXZUprJ1HEansoNyg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246607_Funfetti-Donut-Holes-dough-4x3-63487afee38c4f7b8bd9a1494d3e6fee.jpg"
      ],
      "image": "assets/images/246607/step_03.webp"
    },
    {
      "text": "Heat at least 2 inches of oil in a large pot to 350 degrees F (175 degrees C). Line a baking sheet or wire rack with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop a few tablespoons of dough into the hot oil using a small ice cream scoop. Fry donut holes until golden brown, about 1 minute per side. Transfer donut holes to the paper towels using a slotted spoon; let drain and cool slightly. Repeat with remaining dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a wire rack on a baking sheet. Dip one donut hole at a time into the glaze and place on the wire rack; allow excess glaze to drip off before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3gyLGfBWPbn2696FKfRLZ1UpuI0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246607_Funfetti-Donut-Holes-4x3-cooling-rack-4594adfe58f54d3c9563d3c8c32b319f.jpg"
      ],
      "image": "assets/images/246607/step_06.webp"
    }
  ],
