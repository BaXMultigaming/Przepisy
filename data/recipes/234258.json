  "ingredients": [
    "1 cup unbleached flour",
    "1 cup instant whole-grain hot cereal (such as Coach's Oats®)",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.75 cup sugar",
    "0.5 cup applesauce",
    "0.5 cup non-fat vanilla-flavored Greek-style yogurt",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2 cups fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray 12 muffin cups with cooking spray or use paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, oats, baking powder, and cinnamon together in a bowl. Stir sugar, applesauce, yogurt, egg, and vanilla extract together in a separate bowl. Stir flour mixture into applesauce mixture until just combined. Fold blueberries into batter. Fill prepared muffin cups 2/3 full with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
