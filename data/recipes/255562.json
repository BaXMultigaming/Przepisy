  "ingredients": [
    "cooking spray",
    "1.5 cups canned pumpkin",
    "0.5 cup shortening",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "2 teaspoons ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two baking sheets with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pumpkin, shortening, and vanilla together thoroughly in a bowl. Stir flour, sugar, cinnamon, nutmeg, baking soda, and baking powder into the pumpkin mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoonfuls of cookie dough 2 inches apart on the baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 12 to 14 minutes.",
      "section": null,
