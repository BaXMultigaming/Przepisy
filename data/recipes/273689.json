  "ingredients": [
    "1 cup ice water",
    "1 egg",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "2 cups all-purpose flour, divided",
    "4 skinless, boneless chicken breasts, cut into cubes",
    "vegetable oil for frying",
    "4 tablespoons cornstarch",
    "3 tablespoons water",
    "1 cup white sugar",
    "0.5 cup ketchup",
    "0.5 cup white vinegar",
    "0.5 cup water",
    "0.5 cup orange marmalade",
    "0.5 cup chopped fresh pineapple",
    "2 tablespoons pineapple juice",
    "2 teaspoons soy sauce",
    "1.5 teaspoons minced fresh ginger root",
    "1 teaspoon minced garlic",
    "0.25 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Beat ice water and egg together in a bowl using a whisk or a fork. Add baking soda and salt; beat to combine. Add 1 cup flour; beat until blended but lumpy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place remaining 1 cup flour in a separate bowl. Dredge chicken pieces in flour, then dip in egg mixture, letting excess batter drip off.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a wok or large, deep skillet over medium heat until a drop of water crackles when dropped in oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully lower chicken into the hot oil; fry until golden brown and no longer pink in centers, 3 to 4 minutes, flipping if needed. Set aside and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornstarch and 3 tablespoons water in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, ketchup, vinegar, 1/2 cup water, orange marmalade, pineapple, pineapple juice, soy sauce, ginger, garlic, and pepper flakes in a medium saucepan; bring to a boil. Add cornstarch mixture. Reduce heat; simmer, stirring frequently, until reaches desired thickness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sauce over chicken and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
