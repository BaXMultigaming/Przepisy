  "title": "Cheeseburger Wellington",
  "description": "A budget-friendly version of Beef Wellington with a bacon cheeseburger twist that will impress your guests.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2022-12-02T09:00:00-05:00",
  "date_modified": "2024-11-28T17:47:05-05:00",
  "prep_time": "PT30M",
  "cook_time": "PT35M",
  "total_time": "PT105M",
