  "ingredients": [
    "1 cup all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.5 cup white sugar",
    "0.25 cup shortening",
    "1 egg",
    "0.33333334326744 cup milk",
    "2 cups fresh blueberries",
    "0.25 cup softened butter",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1 cup flour, baking powder, and salt together in a medium bowl until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat ½ cup sugar and shortening together in a large bowl with an electric mixer until light and fluffy. Beat in egg until well combined. Add flour mixture, alternating with milk, mixing until just incorporated. Pour batter into the prepared dish. Sprinkle blueberries evenly over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining ½ cup sugar, remaining ⅓ cup flour, butter, and cinnamon in a small bowl with a fork until crumbly and evenly mixed; sprinkle evenly over blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 35 minutes. Cool before serving warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
