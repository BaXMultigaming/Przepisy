  "ingredients": [
    "5 slices bacon",
    "6 large eggs",
    "1 cup milk",
    "2 tablespoons butter, melted",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 cup chopped green onions",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). If you don't have a 10-inch oven-proof skillet, lightly grease a 7x11-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yQR5aRr2yHyZ9gH_nK6v6Evdg7g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222584-bacon-cheese-frittata-step-1-0729-14c5f7e9d09645588f4b89ca9676d6ab.jpg"
      ],
      "image": "assets/images/222584/step_01.webp"
    },
    {
      "text": "Place bacon in a large oven-proof skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NJFP14dX1jkiLNhxyVPW2l8dwiE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222584-bacon-cheese-frittata-step-2-0730-01dbc337f13d48f693e38594f0f3c2aa.jpg"
      ],
      "image": "assets/images/222584/step_02.webp"
    },
    {
      "text": "Whisk eggs, milk, melted butter, salt, and pepper together in a bowl; pour into oven-proof skillet or prepared baking dish. Sprinkle with green onions and crumbled bacon. Cover with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dkYl4JDM0pX8zxHDb_r9VCdQU2g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222584-bacon-cheese-frittata-step-4-0733-0097f01a39cf466c9466b3c6ca48517d.jpg"
      ],
      "image": "assets/images/222584/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until a knife inserted near the center comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/suo78_q5T1jGL0ZGXtWd8EeykvA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222584-bacon-cheese-frittata-4x3-0775-577af3bbcf8047b193c5ee69d366c3ce.jpg"
      ],
      "image": "assets/images/222584/step_04.webp"
    }
