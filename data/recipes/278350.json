  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "2 cups white sugar",
    "4 eggs",
    "1 cup coconut oil",
    "0.5 cup olive oil",
    "3 cups whole wheat flour",
    "2 cups hemp hearts",
    "0.5 cup wheat germ",
    "0.5 cup ground flax seeds",
    "0.5 cup brewers' yeast",
    "2 teaspoons baking soda",
    "2 teaspoons baking powder",
    "1.5 teaspoons ground cinnamon, or more to taste",
    "1 teaspoon salt",
    "1 (1.1 oz) package hemp protein powder",
    "2 cups dark chocolate chips",
    "0.25 cup blackstrap molasses"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line 36 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pumpkin, sugar, eggs, coconut oil, and olive oil together in a mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, hemp, wheat germ, flax seeds, yeast, baking soda, baking powder, cinnamon, salt, and hemp powder in another bowl. Blend into pumpkin mixture. Stir in dark chocolate chips and molasses.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill the prepared muffins tins evenly with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
