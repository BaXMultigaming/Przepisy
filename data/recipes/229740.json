  "ingredients": [
    "1 medium navel orange",
    "1 (12 ounce) package fresh cranberries",
    "0.5 cup white sugar",
    "0.125 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Grate 2 teaspoons zest from orange; set aside. Peel orange and divide into segments.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Lal9UZ8OMZXCJYYUU0A6zHL0KTg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229740-easy-cranberry-relish-ddmfs-step-02-68575f1dde3a4bb78cfc17a03c1c06a5.jpg"
      ],
      "image": "assets/images/229740/step_01.webp"
    },
    {
      "text": "Place segments, zest, cranberries, sugar, and cinnamon in a food processor; pulse until finely chopped.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nhh2dlqkSzsfetrg4lJTP--fWwI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229740-easy-cranberry-relish-ddmfs-step-03-1ff0d92adf334e3a837f89c9075ab1fe.jpg"
      ],
      "image": "assets/images/229740/step_02.webp"
    },
    {
      "text": "Transfer to a bowl. Cover and refrigerate until flavors have blended, at least 2 hours and up to 3 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oVZIR4SRCO8KIeKIFUmuPsKgp7k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229740-easy-cranberry-relish-ddmfs-step-04-70ee548f0a3d427080ebbc461ea912e0.jpg"
