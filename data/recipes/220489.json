  "ingredients": [
    "2 tablespoons butter",
    "0.5 onion, chopped",
    "1 pound cooked corned beef, cut into bite-size pieces",
    "0.5 cup chili sauce",
    "0.5 cup mayonnaise",
    "1 (14 ounce) can sauerkraut, drained",
    "1.5 cups shredded Swiss cheese, divided",
    "1 (12 ounce) can refrigerated biscuit dough"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a skillet over medium heat until bubbly. Cook and stir onion in the melted butter until browned, about 8 minutes. Set onion aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir corned beef, chili sauce, and mayonnaise together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread sauerkraut in the bottom of the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon corned beef mixture on top of sauerkraut. Sprinkle cooked onions on top of corned beef mixture. Top onions with 1/2 cup Swiss cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover casserole dish with aluminum foil and place in preheated oven. Bake 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut individual biscuits in half. Remove casserole from oven and place halved biscuits on top of casserole. Bake until biscuits are lightly golden brown, about 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle remaining 1 cup Swiss cheese on top of casserole. Return to oven and bake until cheese is melted, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
