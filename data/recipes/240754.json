  "ingredients": [
    "1 (12 ounce) bag chocolate chips",
    "1.5 cups confectioners' sugar",
    "0.5 cup egg substitute",
    "0.25 cup butter, softened",
    "1 teaspoon mint extract",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Line a baking sheet or plate with waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate in the top of a double boiler over simmering water, stirring frequently and scraping down the sides with a rubber spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat confectioners' sugar, egg substitute, and butter together in a bowl with an electric mixer until smooth and creamy. Add melted chocolate and beat until incorporated. Beat mint extract and vanilla extract into chocolate mixture until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop chocolate mixture by the heaping teaspoonful onto prepared baking sheet. Chill in the refrigerator until firm, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
