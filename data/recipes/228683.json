  "ingredients": [
    "1 teaspoon butter",
    "2 tablespoons brown sugar",
    "3 teaspoons vanilla sugar",
    "3 teaspoons ground cinnamon",
    "1 teaspoon ground nutmeg",
    "6 large apples - peeled, cored, and sliced",
    "3.5 tablespoons water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a large baking dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, vanilla sugar, cinnamon, and nutmeg in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O2q764HPiORHwU7MNByBAr8BL_U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228683-delicious-cinnamon-baked-apples-ddmfs-Step1-1406-a63f44de0c954533b269c5195693815c.jpg"
      ],
      "image": "assets/images/228683/step_02.webp"
    },
    {
      "text": "Layer about 1/3 of the apples in the prepared baking dish; sprinkle with 1/3 of the sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VVylyzzZiU9t9v1p3eESXlcDEjQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228683-delicious-cinnamon-baked-apples-ddmfs-Step2-1409-f7a025d3c3094e95a089132b49e799b4.jpg"
      ],
      "image": "assets/images/228683/step_03.webp"
    },
    {
      "text": "Repeat layers twice more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/u7fJ4rbLPfvkPkzBRaV75f0_Wz4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228683-delicious-cinnamon-baked-apples-ddmfs-Step2-1411-f3cffb5fb681464189085947051ccc57.jpg"
