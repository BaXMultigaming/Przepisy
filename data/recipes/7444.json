  "ingredients": [
    "1.6666699647903 cups white sugar",
    "3 eggs",
    "1 teaspoon vanilla extract",
    "1 cup mayonnaise",
    "4 (1 ounce) squares semisweet chocolate",
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "1.3333300352097 cups water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, eggs, and vanilla together in a large bowl with an electric mixer at high speed until light and fluffy, 3 minutes. Add mayonnaise and melted chocolate; reduce speed to low and beat until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, and baking powder in a separate bowl. Add flour mixture in 4 batches, alternating with water, beating batter briefly after each addition. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 45 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
