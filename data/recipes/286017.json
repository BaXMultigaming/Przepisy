  "ingredients": [
    "nonstick cooking spray",
    "0.25 cup grated Parmesan cheese",
    "0.25 cup panko bread crumbs",
    "0.75 teaspoon garlic powder",
    "4 (6 ounce) bone-in, skin on chicken thighs",
    "salt and freshly ground black pepper to taste",
    "0.25 cup mayonnaise"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with foil and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Parmesan cheese, panko, and garlic powder in a shallow bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle chicken on both sides with salt and pepper. Brush skin liberally with mayonnaise. Press each thigh, skin-side down, into crumb mixture. Place thighs on baking sheet, skin-side up, and mist lightly with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink in the center and juices run clear, 35 to 40 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
