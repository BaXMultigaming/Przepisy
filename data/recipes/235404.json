  "ingredients": [
    "4 cups rolled oats",
    "0.5 cup white sugar",
    "1 tablespoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground ginger",
    "0.5 teaspoon ground allspice",
    "0.25 teaspoon ground cloves",
    "2.5 cups water",
    "1.5 cups sliced apple",
