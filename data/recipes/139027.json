  "ingredients": [
    "0.66666668653488 cup mirin (Japanese sweet rice wine)",
    "1 cup soy sauce",
    "4.5 teaspoons rice vinegar",
    "1 teaspoon sesame oil",
    "0.33333334326744 cup white sugar",
    "7 cloves garlic, minced",
    "1 tablespoon minced fresh ginger",
    "1 dash red pepper flakes",
    "black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring mirin to a boil in a saucepan over high heat. Reduce heat to medium-low, and simmer for 10 minutes. Pour in soy sauce, rice vinegar, sesame oil, and sugar. Season with garlic, ginger, pepper flakes, and black pepper; simmer an additional 5 minutes. Store in a tightly sealed container in the refrigerator.",
