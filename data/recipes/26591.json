  "ingredients": [
    "1 tablespoon olive oil",
    "1 pound round steak, thinly sliced into 2 inch pieces",
    "salt to taste",
    "ground black pepper to taste",
    "1 large onion, thinly sliced",
    "2 cups fresh broccoli florets, chopped",
    "1 (10.75 ounce) can condensed cream of broccoli soup",
    "0.25 cup water",
    "3 tablespoons soy sauce"
  ],
  "steps": [
    {
      "text": "In a large skillet, heat the olive oil over high heat. Stir in the steak and season with salt and pepper. Cook until beef is almost completely browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in onions and saute until tender. Stir in broccoli, condensed cream of broccoli soup, water and soy sauce. Blend well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat and cover. Cook to desired doneness.",
