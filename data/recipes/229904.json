  "ingredients": [
    "4 cups sliced carrots",
    "2 eggs",
    "1 cup evaporated milk",
    "0.75 cup packed brown sugar",
    "2 tablespoons honey",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground allspice",
    "1 single pie crust"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil. Cook carrots in the boiling water until very tender, about 15 minutes. Drain and transfer to a blender. Cover and hold lid down; pulse a few times before leaving on to blend. Puree in batches until very smooth. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl. Add carrots, evaporated milk, brown sugar, honey, salt, cinnamon, nutmeg, cloves, and allspice; beat until smooth. Fit pie crust into a 9-inch pie dish and pour carrot mixture into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center of the pie comes out clean, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
