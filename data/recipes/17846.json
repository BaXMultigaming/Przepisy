      "image_sources": [
        "https://www.allrecipes.com/thmb/qU8paHe2zhNgV2sxMd3lpqJmg2k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17846-incredibly-easy-chicken-and-noodles-ddmfs-Step5-3c3d31f1b3384896bd9a17dbe64403b8.jpg"
      ],
      "image": "assets/images/17846/step_03.webp"
