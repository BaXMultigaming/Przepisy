  "ingredients": [
    "6 tablespoons unsalted butter",
    "1.5 cups chopped onions",
    "1.5 cups chopped celery",
    "4 cups water",
    "8 potatoes, peeled and cubed",
    "15 slices American cheese - broken into pieces",
    "2.3333299160004 cups milk",
    "4 tablespoons all-purpose flour",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium heat. Sauté onions and celery in hot butter until tender, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in water and potatoes. Bring to a boil and simmer until potatoes are tender. Add cheese and stir until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk and flour together in a medium bowl until flour is mostly dissolved; pour slowly into soup, stirring constantly. Cook until soup is thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Portion soup into bowls and garnish with parsley to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
