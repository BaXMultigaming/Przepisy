  "ingredients": [
    "0.5 cup margarine",
    "0.5 cup white sugar",
    "1.5 cups rolled oats",
    "2 tablespoons unsweetened cocoa powder",
    "1 teaspoon vanilla extract",
    "2 tablespoons cold coffee",
    "0.5 cup pearl sugar"
  ],
  "steps": [
    {
      "text": "In a large bowl, cream together the margarine and sugar until smooth. Stir in the oats, cocoa and vanilla until well blended then stir in the coffee. Roll the dough into balls slightly smaller than a ping pong ball. Pour the pearl sugar into a saucer and roll the balls in the sugar. Refrigerate cookies for 1 hour before serving.",
