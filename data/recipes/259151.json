      "image_sources": []
    },
    {
      "text": "Place chicken breasts in the bottom of a slow cooker. Add green bell pepper, red bell pepper, salt, pepper, and taco seasoning. Pour in broth, ensuring chicken is just covered in liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set slow cooker to Low; cook for 6 hours.",
