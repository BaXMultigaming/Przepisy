  "ingredients": [
    "1 large sweet potato, diced",
    "1 tablespoon water, or as needed",
    "salt to taste",
    "1 tablespoon olive oil",
    "1 small white onion, diced",
    "1 cup diced ham steak",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon cayenne pepper",
    "1 teaspoon brown sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6zsWLSfc3ZynawpPpXBFQuygt1Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233328-savory-sweet-potato-hash-DDMFS-095-4x3-step-01-68dfa4a2dcdf4bfaaba64201ff2d57f3.jpg"
      ],
      "image": "assets/images/233328/step_01.webp"
    },
    {
      "text": "Place sweet potato in a microwave-safe bowl; add water and salt. Microwave until partially softened, 2 to 3 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZiyoIKeql_mqoTzpbTJVEl-2-Pk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233328-savory-sweet-potato-hash-DDMFS-097-4x3-step-02-501e174d010f40a793c2cdb9bb724a1f.jpg"
      ],
      "image": "assets/images/233328/step_02.webp"
    },
    {
      "text": "Heat olive oil in a skillet over medium heat; cook and stir onion in hot oil until slightly softened, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oPwA_lBkgnss5rcaWXSZVXIZpGI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233328-savory-sweet-potato-hash-DDMFS-098-4x3-step-03-f87831d5904e439d9cb28ed23ed5ba9f.jpg"
      ],
      "image": "assets/images/233328/step_03.webp"
    },
    {
      "text": "Stir sweet potato, ham, cinnamon, cayenne pepper, and salt into onion; cover skillet with a lid. Cook sweet potato mixture, stirring occasionally, until sweet potatoes are cooked through, about 10 minutes; sprinkle with brown sugar. Cook and stir until brown sugar is dissolved, 1 to 2 more minutes.",
