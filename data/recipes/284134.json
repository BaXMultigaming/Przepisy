  "ingredients": [
    "5 cups cavatappi pasta",
    "1 cup creamy salad dressing (such as Miracle Whip®)",
    "0.25 cup sour cream",
    "0.25 cup pickle juice",
    "0.25 cup white sugar",
    "2 tablespoons honey-Dijon mustard",
    "1 teaspoon salt",
    "0.75 teaspoon garlic salt",
    "0.75 teaspoon freshly ground black pepper",
    "2 stalks celery, chopped",
    "1 large sweet onion (such as Vidalia®), chopped",
    "1 medium red bell pepper, chopped",
    "1 cup cubed Cheddar cheese",
    "1 cup cubed fully cooked ham",
    "3 large hard-boiled eggs, chopped",
    "1 (5 ounce) can flaked tuna, drained"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook cavatappi in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain, run under cold water, and drain again. Set aside until completely cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine salad dressing, sour cream, pickle juice, sugar, Dijon mustard, salt, garlic salt, and black pepper in a large bowl. Stir in celery, onion, bell pepper, Cheddar cheese, ham, eggs, and tuna, then stir in cooled cavatappi until well combined. Refrigerate for at least 3 hours, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
