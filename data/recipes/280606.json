  "ingredients": [
    "2 tablespoons vegetable oil",
    "1.5 pounds boneless chicken breast, cut into 1-inch pieces",
    "4 cups water",
    "1 package Bear Creek® Chicken Noodle Soup Mix",
    "1 medium zucchini, halved lengthwise and sliced",
    "2 cups halved grape tomatoes",
    "2 cups baby spinach leaves",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Heat oil in large nonstick skillet over medium-high heat and brown chicken in 2 batches. Transfer to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water and soup mix into the skillet and bring to a boil over high heat. Return chicken to skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low and simmer 5 minutes. Stir in zucchini and cook 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomatoes and spinach and cook 2 minutes or until noodles are tender. Stir in lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
