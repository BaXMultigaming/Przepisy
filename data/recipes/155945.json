  "ingredients": [
    "1 cup butter, divided",
    "1 tablespoon minced garlic",
    "2 tablespoons fresh lemon juice",
    "2 teaspoons dried cilantro",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients,",
      "section": null,
