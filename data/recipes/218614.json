  "ingredients": [
    "1.5 cups whole wheat flour",
    "0.75 cup white sugar",
    "0.5 teaspoon salt",
    "2 teaspoons baking powder",
    "0.33333334326744 cup vegetable oil",
    "1 egg",
    "0.33333334326744 cup milk",
    "0.5 cup unsweetened applesauce",
    "1 pint fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 12-cup muffin tin or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, salt, and baking powder together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk vegetable oil, egg, milk, and applesauce together in a separate bowl until smooth; stir into flour mixture until just moistened. Gently fold in blueberries. Spoon batter into prepared muffin cups, filling each about 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until muffins rise and tops are golden brown, about 20 minutes. A toothpick inserted into the center of a muffin should come out clean. Cool in the pan for 5 minutes, then transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
