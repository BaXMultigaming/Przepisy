  "ingredients": [
    "8 Granny Smith apples",
    "8 wooden sticks",
    "1 (16 ounce) package brown sugar",
    "0.66666668653488 cup dark corn syrup",
    "0.75 cup water",
    "2 tablespoons bourbon whiskey"
  ],
  "steps": [
    {
      "text": "Insert wooden sticks 3/4 of the way into the stem end of each apple. Place apples on a cookie sheet covered with lightly greased aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, corn syrup and water in a large saucepan and bring to a boil over medium-high heat. Reduce heat to medium-low and simmer until thermometer registers 290 degrees F (143 degrees C). Remove from the heat and stir in the bourbon if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Keep the saucepan over low heat to keep the caramel liquid for dipping the apples. Working quickly, carefully dip apples in the caramel. Place apples on the greased aluminum foil until coating has cooled and hardened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
