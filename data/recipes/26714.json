  "ingredients": [
    "4 eggs",
    "1.5 pounds unsliced bologna",
    "6 medium sweet pickles",
    "0.25 cup mayonnaise"
  ],
  "steps": [
    {
      "text": "Place eggs in a medium saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes. Remove from water, cool and peel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a food processor, place eggs, bologna and sweet pickles. Blend to a spreadable consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer mixture to a medium bowl. Mix in mayonnaise, increasing the amount as necessary to make the mixture smooth. Cover and chill in the refrigerator until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
