  "ingredients": [
    "0.5 cup butter, room temperature",
    "2 cups packed brown sugar",
    "3 eggs",
    "0.5 teaspoon vanilla extract",
    "3.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "1 teaspoon cream of tartar",
    "0.5 teaspoon salt",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "In a large bowl, cream together butter and brown sugar until smooth. Beat in the eggs one at a time then stir in the vanilla. Sift together the flour, baking soda, cream of tartar and salt; blend into the creamed mixture. Mix in the walnuts. Form dough into long roll about 2 inches in diameter. Wrap in waxed paper and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease cookie sheets or line with parchment paper. Unwrap the roll of dough and using a sharp knife, slice the roll into 1/4 inch coins. Place cookies 2 inches apart onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 to 12 minutes in the preheated oven. Remove from cookie sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
