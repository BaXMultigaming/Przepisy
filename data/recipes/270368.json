  "ingredients": [
    "0.75 cup all-purpose flour",
    "0.33333334326744 cup white sugar",
    "0.33333334326744 cup unsweetened cocoa powder",
    "6 tablespoons cold butter",
    "1 (8 ounce) package cream cheese, at room temperature",
    "0.25 cup white sugar",
    "1 egg",
    "1 teaspoon peppermint extract",
    "5 drops green food coloring",
    "0.25 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, and cocoa powder in a large bowl. Cut in butter until mixture resembles fine crumbs. Set aside 1 cup of the crumbs to be used as the topping. Press remaining crumb mixture into an ungreased 8x8-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake crust in the preheated oven until set, about 15 minutes. Remove and let cool. Keep oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While crust is cooling, beat cream cheese and sugar with an electric mixer until fluffy. Add egg, peppermint extract, and green food coloring; beat well. Stir in milk until batter is smooth. Pour batter over the cooled crust. Sprinkle reserved crumb mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until filling is set, 20 to 25 minutes. Cool before cutting into 25 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
