  "ingredients": [
    "2 cups white sugar",
    "6 tablespoons all-purpose flour",
    "4 large egg yolks",
    "6 tablespoons water",
    "4 cups milk",
    "5 large ripe bananas, mashed, or more to taste",
    "1 teaspoon vanilla",
    "1 (12 ounce) package vanilla wafers"
  ],
  "steps": [
    {
      "text": "Combine sugar and flour in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine egg yolks and water in a second bowl and beat with an electric mixer until light and fluffy. Add the sugar mixture and mix until batter is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk into a saucepan and bring to a boil over medium heat. Add batter and stir until mixture thickens and comes to a boil, about 5 minutes. Remove from heat. Stir in bananas and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer vanilla wafers and banana pudding alternately into a glass bowl. Cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
