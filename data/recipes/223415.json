      ],
      "image": "assets/images/223415/step_04.webp"
    },
    {
      "text": "Place 1/2 of the cookie crumbs into the bottom of a 9x12-inch dish; spread evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wE4FuPHdlFbgbDovrvywDJ4UjzE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223415-dirt-pudding-ddmfs-4x3-step-05-5cc329c12bb44d9f86cd44180d1cd756.jpg"
