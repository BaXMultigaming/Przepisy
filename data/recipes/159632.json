  "keywords": [],
  "ingredients": [
    "1 apple",
    "1 teaspoon ground cinnamon",
    "1 pinch ground nutmeg",
    "1 tablespoon white sugar",
    "2 tablespoons cream cheese",
    "1 tablespoon dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut the stem out of the apple and hollow out the center until it is about 1 1/2 inches wide without going through the bottom. In a small cup, stir together the cinnamon, nutmeg and sugar. Set aside half of this mixture, and mix the rest with the cream cheese and dried cranberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle some of the reserved cinnamon sugar into the apple's cavity. Fill with the cream cheese mixture, and sprinkle the remaining cinnamon sugar on the top. Place the apple in a small baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 to 40 minutes, until the apple is tender enough to easily pierce with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
