  "ingredients": [
    "0.5 cup steak seasoning sauce (such as Dale's Steak Seasoning®)",
    "0.5 cup brown sugar, divided",
    "3 scallions, chopped",
    "2 tablespoons bourbon (such as Jim Beam®), or more to taste",
    "1 (1 1/2-pound) salmon fillet, cut into 2-inch cubes",
    "0.5 pound bacon strips, cut in half",
    "15 toothpicks, or as needed"
  ],
  "steps": [
    {
      "text": "Combine steak seasoning sauce, 6 tablespoons brown sugar, scallions, and bourbon in a large bowl. Add salmon cubes; toss to coat. Cover the bowl with plastic wrap; marinate in the refrigerator, 4 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove salmon cubes from marinade and shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap each salmon cube with 1 halved bacon strip; secure with a toothpick. Sprinkle remaining 2 tablespoons brown sugar on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, turning frequently, until bacon begins to crisp, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
