  "ingredients": [
    "0.5 cup butter",
    "0.5 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "3 cups almond flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup semisweet chocolate chips",
    "0.25 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar together in a bowl with an electric mixer until smooth and creamy; add eggs and vanilla extract and beat until smooth. Fold almond flour, baking soda, and salt into butter mixture until dough comes together. Stir in chocolate chips and cranberries. Drop dough by the teaspoonful onto prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and set, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
