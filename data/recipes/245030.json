  "ingredients": [
    "1.75 cups water",
    "0.25 teaspoon Himalayan pink salt",
    "1 cup rolled oats",
    "3 large ripe bananas, mashed",
    "3 tablespoons sunflower seed butter",
    "2 tablespoons agave nectar"
  ],
  "steps": [
    {
      "text": "Bring water and salt to a boil in a saucepan; add oats and simmer until desired consistency is reached, about 5 minutes. Remove saucepan from heat and stir in bananas, sunflower seed butter, and agave nectar.",
