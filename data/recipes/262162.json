  "ingredients": [
    "2 tablespoons olive oil",
    "4 (3 ounce) fillets salmon fillets",
    "2 red bell peppers, chopped",
    "1 yellow bell pepper, chopped",
    "1 onion, sliced",
    "6 tablespoons lemon juice",
    "3 tablespoons olive oil",
    "2 tablespoons water",
    "1 tablespoon maple syrup",
    "5 cloves garlic",
    "1.5 teaspoons salt",
    "1.5 teaspoons red pepper flakes",
    "1 teaspoon ground cumin",
    "0.5 bunch fresh parsley, chopped",
    "1 lemon, sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a sheet pan with 2 tablespoons olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon fillets, red and yellow bell peppers, and onion on the prepared sheet pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk lemon juice, 3 tablespoons olive oil, water, maple syrup, minced garlic, salt, red pepper flakes, cumin, and parsley in a small bowl until combined. Drizzle two-thirds of the sauce over the salmon and vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until salmon flakes easily with a fork and vegetables are tender, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with lemon slices and remaining sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
