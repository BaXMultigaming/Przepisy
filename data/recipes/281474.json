  "ingredients": [
    "1 pound ground pork",
    "0.25 cup shredded Cheddar cheese",
    "1 jalapeno pepper, seeded and minced",
    "2 teaspoons taco seasoning",
    "0.5 teaspoon ground coriander",
    "4 hamburger buns"
  ],
  "steps": [
    {
      "text": "Combine ground pork, Cheddar cheese, jalapeno, taco seasoning, and coriander in a large bowl. Using your hands, mix well until evenly combined. Form into 4 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill patties for 4 minutes. Flip and grill for 3 minutes more. Remove from grill and let rest for 5 minutes. Serve on buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
