  "ingredients": [
    "1 (16 ounce) package frozen cut green beans, thawed",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "0.5 cup milk, or more to taste",
    "0.5 cup sour cream",
    "0.5 cup shredded Swiss cheese",
    "1 (2.8 ounce) package French-fried onions, divided",
    "1 teaspoon garlic salt",
    "1 teaspoon soy sauce",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix beans, soup, milk, sour cream, cheese, 1/2 of the fried onions, garlic salt, soy sauce, and pepper together in a large casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4SI6ySQRw-sn_BRMrWzhmXckE2k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281788-green-bean-casserole-with-frozen-green-beans-VAT-step-01-31c0ba9c32c143d69b898a8de733a4b0.jpg"
      ],
      "image": "assets/images/281788/step_02.webp"
    },
    {
      "text": "Cover and bake in the preheated oven for 30 minutes. Add more milk halfway through baking for a creamier consistency, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qsZ4W-s--eRQSbRbghYTtKi029w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281788-green-bean-casserole-with-frozen-green-beans-VAT-step-02-b6d9eabc6dff45009aafc3d47c63db14.jpg"
      ],
      "image": "assets/images/281788/step_03.webp"
    },
    {
      "text": "Top with remaining 1/2 of the fried onions; bake, uncovered, until bubbly, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YTE8h5aZkM3ifDPCb6Vn_inPKuQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281788-green-bean-casserole-with-frozen-green-beans-VAT-step-03-c565279364a24f6487f4464a4eaffdc0.jpg"
