  "ingredients": [
    "4 eggs",
    "0.25 cup vegetable oil",
    "salt and pepper to taste",
    "1 teaspoon baking powder",
    "1 cup all-purpose baking mix",
    "1.5 cups sliced zucchini",
    "1.5 cups sliced yellow squash",
    "0.25 cup chopped onion",
    "1 large ripe tomato, sliced",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9 inch deep dish pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together eggs and oil in a bowl with salt and pepper. Stir in baking powder and baking mix until moistened. Gently fold in zucchini, summer squash, and onion. Pour into prepared pie plate, and arrange sliced tomato over top. Sprinkle with Parmesan cheese to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until puffed and golden brown, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
