  "ingredients": [
    "2.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "0.25 cup butter, cut into small pieces",
    "1 cup hot water",
    "3 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Mix flour, baking powder, and salt in a large bowl; add butter and crush into flour mixture with hands until it resembles breadcrumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix hot water and garlic into flour mixture until it all comes together into a dough; turn out onto a cutting board dusted with flour. Knead dough 3 or 4 times. Cut dough into 10 pieces, roll into balls, and flatten into disks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover dough with a clean kitchen towel and let sit for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a cast iron skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out one of the dough disks to about the size of your skillet. Cook in the hot skillet until golden and puffy, 1 to 2 minutes per side. Remove to a platter and cover with a clean kitchen towel to keep warm. Repeat with remaining dough portions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
