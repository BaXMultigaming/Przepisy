  "ingredients": [
    "2.5 cups lukewarm water",
    "1 teaspoon salt",
    "2 cups pre-cooked white cornmeal (such as P.A.N.®)",
    "0.25 cup vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Stir water and salt together in a medium bowl; gradually stir in cornmeal with your fingers until the mixture forms a soft, moist, malleable dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y_MboaQ_S33Sh9-Lq4x4RRAHNmY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/238510-HomemadeArepas-ddmfs-Step1-0415-505e0a8115344a299a4f019e315278ad.jpg"
      ],
      "image": "assets/images/238510/step_01.webp"
    },
    {
      "text": "Form dough into eight 2-inch diameter balls; pat each ball to flatten into a 3/8-inch-thick arepa patty.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HEc_o6VU5eZ4aZwrRKY6_374SeI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/238510-HomemadeArepas-ddmfs-Step2-0416-6dba9a26140244fe890a90fc44468589.jpg"
      ],
      "image": "assets/images/238510/step_02.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium heat; fry arepas in batches until golden brown, about 4 to 5 minutes per side. Transfer cooked arepas to a paper towel-lined plate to drain until cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/La9d2lfbWbvP2IcnY1ywYGsQeG0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/238510-HomemadeArepas-ddmfs-Step3-0428-8bf152714b5a403fb0f6cd01a1e340cf.jpg"
      ],
      "image": "assets/images/238510/step_03.webp"
    },
    {
      "text": "Slice halfway through each arepa horizontally with a thin serrated knife to form a pita-like pocket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5xAAkr-R2NT20t_VMrwfaZQUD2Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/238510-HomemadeArepas-ddmfs-Step4-0437-4ce893c1a09943d7ba8ca69a986dacbe.jpg"
      ],
      "image": "assets/images/238510/step_04.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
