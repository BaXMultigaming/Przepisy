  "ingredients": [
    "1 cup canned pumpkin",
    "0.25 cup brown sugar",
    "2 teaspoons ground cinnamon",
    "2 teaspoons pumpkin pie spice",
    "2 sheets frozen puff pastry, thawed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pumpkin, brown sugar, cinnamon, and pumpkin pie spice together in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll puff pastry sheets into 12x12-inch squares; cut each sheet into nine 4-inch squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide pumpkin mixture between centers of pastry squares; wet edges of each square with water. Fold over, corner to corner; pinch edges together. Transfer to the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pastry is puffed and golden, about 15 minutes. Cool for 10 minutes. Transfer pastries to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
