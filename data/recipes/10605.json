  "ingredients": [
    "1 cup butter, softened",
    "1.25 cups packed brown sugar",
    "0.5 cup white sugar",
    "2 eggs",
    "2 tablespoons milk",
    "1 teaspoon vanilla extract",
    "1.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2.5 cups rolled oats",
    "2 cups semisweet chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together margarine and sugars until creamy. Add eggs, milk, and vanilla; beat well. Add combined flour, baking soda, and salt; mix well. Stir in oats, chocolate chips, and nuts; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop rounded tablespoonfuls onto ungreased cookie sheet. Bake 9 to 10 minutes. Cool for 1 minute on cookie sheet; remove to wire rack.",
