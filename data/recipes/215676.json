  "ingredients": [
    "0.25 cup olive oil",
    "2 tablespoons brown sugar",
    "1.5 tablespoons lemon juice",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried thyme",
    "1 pinch salt",
    "1 pinch fresh ground black pepper",
    "1 pound broccoli florets"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together olive oil, brown sugar, lemon juice, cayenne pepper, garlic powder, oregano, thyme, salt, and black pepper in a bowl until thoroughly combined. Add broccoli florets and toss until evenly coated with the seasoning. Spread broccoli florets out onto a baking sheet with a rim.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the broccoli is just browned on the top, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
