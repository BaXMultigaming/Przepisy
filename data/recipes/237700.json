  "ingredients": [
    "1 (9 inch) pie crust pastry",
    "8 ounces smoked salmon, or more to taste, broken into small pieces",
    "5 ounces cream cheese",
    "1 teaspoon dill",
    "8 eggs, or more to taste",
    "0.75 cup milk",
    "salt and ground black pepper to taste",
    "1 (8 ounce) package shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Press pie crust pastry into a pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange salmon into the baked pie crust to cover evenly. Spread cream cheese over over salmon layer using your hands. Sprinkle dill over cream cheese layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, milk, salt, and pepper together in a bowl; pour over cream cheese layer just below crust edge. Sprinkle mozzarella cheese over egg layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until quiche is set and middle has risen, 40 to 50 minutes. Cool for 5 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
