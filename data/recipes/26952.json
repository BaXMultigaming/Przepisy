  "ingredients": [
    "6 eggs",
    "0.25 cup mayonnaise",
    "1 (4.5 ounce) can shrimp, rinsed and drained",
    "2 tablespoons chopped green onions",
    "1 tablespoon chopped fresh dill weed",
    "1 tablespoon lime juice",
    "2 teaspoons prepared Dijon-style mustard",
    "0.25 teaspoon hot pepper sauce",
    "1 pinch ground black pepper",
    "fresh dill weed"
  ],
  "steps": [
    {
      "text": "Place eggs in a medium saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes. Remove from hot water, cool and peel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice eggs in half lengthwise. Remove yolks. Set aside whites.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mash egg yolks with a fork. Mix together with mayonnaise, shrimp, green onions, fresh dill weed, lime juice, prepared Dijon-style mustard, hot pepper sauce and ground black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon approximately 1 tablespoon egg yolk mixture into each egg white. Garnish with fresh dill weed. Chill in the refrigerator until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
