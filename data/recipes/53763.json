  "ingredients": [
    "1 pound ground beef",
    "0.5 pound ground pork",
    "0.5 cup chopped onion",
    "0.75 cup bread crumbs",
    "1 egg",
    "0.5 cup milk",
    "1 tablespoon dried parsley",
    "1 tablespoon Worcestershire sauce",
    "2 teaspoons salt",
    "1 teaspoon pepper",
    "0.25 cup vegetable oil",
    "0.25 cup all-purpose flour",
    "1 teaspoon paprika",
    "1 tablespoon salt",
    "1 teaspoon pepper",
    "2 cups boiling water",
    "0.75 cup sour cream"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine ground beef, ground pork, chopped onion, bread crumbs, egg, and milk. Season with parsley, Worcestershire sauce, 2 teaspoons salt, and 1 teaspoon pepper. Mix well with your hands. Shape into walnut-size balls, and place on baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes in preheated oven. Turn frequently so they brown evenly on all sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the sauce: In a saucepan, combine oil, flour, paprika, 1 tablespoon salt, and 1 teaspoon pepper. Cook over medium heat until sizzling. Stir in hot water and sour cream until smooth and heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When meatballs have cooked 30 minutes, pour sauce over the top, and return to the oven for 20 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
