  "ingredients": [
    "0.25 cup vegetable oil",
    "1.5 onions, chopped",
    "1 clove garlic",
    "2 tablespoons water",
    "8 tomatoes",
    "1 large green bell pepper",
    "1 tablespoon salt",
    "2 teaspoons garam masala",
    "1 teaspoon chili powder",
    "0.5 cup heavy cream",
    "0.25 cup butter",
