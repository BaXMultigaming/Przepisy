    "publisher-tested"
  ],
  "ingredients": [
    "1 pound walnut halves",
    "1 cup white sugar",
    "6 tablespoons milk",
    "2 teaspoons ground cinnamon",
    "0.25 teaspoon salt",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HDU9OqmXwDPsPWCmuiz-d31-ccg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9443-dawns-candied-walnuts-DDMFS-01-11504-25cd5177100d482cb28db56f8ed31c35.jpg"
      ],
      "image": "assets/images/9443/step_01.webp"
    },
    {
      "text": "Spread walnuts onto a baking sheet in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F7pHl9wydXtBGu-guUq5EF8q4Dk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9443-dawns-candied-walnuts-DDMFS-02-11505-ff4a4eefa25a40caaf3e525a1e739249.jpg"
      ],
      "image": "assets/images/9443/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until fragrant and walnuts begin to turn brown, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_LEs0pW4x0anwxo8vXWsnzBw2bM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9443-dawns-candied-walnuts-DDMFS-03-11511-8732b369e6a84a429a9f61d2cb839387.jpg"
      ],
      "image": "assets/images/9443/step_03.webp"
    },
    {
      "text": "Meanwhile, combine sugar, milk, cinnamon, and salt in a medium saucepan over medium-high heat; attach a candy thermometer to the saucepan and bring mixture to a boil. Cook, without stirring, until mixture reaches 240 degrees F (115 degrees C), about 8 minutes. A small amount of syrup dropped into cold water should form a soft ball that flattens when removed from the water and placed onto a flat surface. Remove from heat; immediately stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qmoe0iSc9Yvh2179m9wb6SLdfe0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9443-dawns-candied-walnuts-DDMFS-04-11517-27ea38a0dc4e4317918ac0851ee11696.jpg"
      ],
      "image": "assets/images/9443/step_04.webp"
    },
    {
      "text": "Stir walnuts into sugar mixture until well coated. Transfer walnuts to a piece of waxed paper; use a fork to break up any clumps. Cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z4zIdxoVwiOCwXgteUlDjd2fMsA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9443-dawns-candied-walnuts-DDMFS-05-11518-c4384edb22cd49bf90eba6d60e7bee85.jpg"
      ],
      "image": "assets/images/9443/step_05.webp"
    }
  ],
