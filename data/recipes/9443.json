  "title": "Candied Walnuts",
  "description": "Candied walnuts coated in a sweet, cinnamon-spiced mixture are easy to make at home for a special festive treat or to give as gifts during holiday season.",
  "authors": [
    "Dawn Timmerman"
  ],
  "date_published": "1999-11-11T15:45:42-05:00",
