  "title": "Pork Enchiladas",
  "description": "Leftover cooked pork gets a Mexican-style makeover when mixed with chilies and enchilada sauce, wrapped in tortillas, and topped with melted cheese.",
  "authors": [
    "STEPHZ2003"
  ],
  "date_published": "2018-03-21T12:51:29-04:00",
