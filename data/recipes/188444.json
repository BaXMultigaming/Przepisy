  "ingredients": [
    "2 cups cooked brown rice",
    "1 (15.25 ounce) can whole kernel corn, drained",
    "1 (15 ounce) can kidney beans, rinsed and drained",
    "1 (15 ounce) can black beans, rinsed and drained",
    "1 small onion, diced",
    "1 green bell pepper, diced",
    "2 jalapeno peppers, seeded and diced",
    "0.25 cup chopped cilantro leaves",
    "1 lime, zested and juiced",
    "1.5 teaspoons ground cumin",
    "1 teaspoon minced garlic",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Combine brown rice, corn, kidney beans, black beans, onion, bell pepper, jalapeño peppers, cilantro, lime zest and juice, cumin, and garlic in a large bowl; gently toss until well mixed. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate salad for 1 hour, toss again, and serve.",
      "section": null,
