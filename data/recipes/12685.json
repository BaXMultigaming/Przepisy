  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups rolled oats",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1.5 cups packed brown sugar",
    "1.5 cups butter",
    "2 quarts peeled, cored and sliced apples"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, oatmeal, cinnamon, nutmeg, and brown sugar in a large bowl; cut in butter until mixture is crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon half of the mixture into the bottom of a 9x13-inch baking dish; pat down with the back of a spoon to form an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover crumb mixture with apple slices, then sprinkle apple slices with remaining crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apples are tender, about 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
