  "title": "Sprinkles Muffins",
  "description": "A sweet muffin made with white chocolate chips, strawberry yogurt, and sprinkles! These will make any occasion seem festive.",
  "authors": [
    "Sarah"
  ],
  "date_published": "2020-06-18T23:08:32-04:00",
