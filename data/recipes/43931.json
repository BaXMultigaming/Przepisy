  "ingredients": [
    "0.25 cup butter",
    "0.25 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.5 cup milk",
    "0.25 cup strawberry flavored yogurt",
    "1.5 cups self-rising flour",
    "0.25 cup white chocolate chips",
    "0.25 cup multicolored candy sprinkles"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a muffin tin, or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the butter and sugar until light and fluffy. Beat in the egg and vanilla, then gradually stir in the milk and yogurt. Add the flour, and mix until just blended. Fold in the white chocolate chips and sprinkles. Spoon into 6 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 20 minutes in the preheated oven, or until the tops spring back when lightly touched. Cool muffins before removing from the tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
