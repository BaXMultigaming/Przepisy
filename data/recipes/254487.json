  "ingredients": [
    "1 gallon vegetable broth",
    "1.5 cups sea salt",
    "0.33333334326744 cup brown sugar",
    "2 tablespoons black peppercorns",
    "1 tablespoon dried rosemary",
    "1 tablespoon dried sage",
    "1 tablespoon dried thyme",
    "2 gallons water",
    "0.5 cup apple cider vinegar",
    "3 apples, cut into quarters",
    "1 onion, cut into quarters",
    "0.5 cup Worcestershire sauce",
    "3 cloves garlic, peeled"
  ],
  "steps": [
    {
      "text": "Combine vegetable broth, sea salt, brown sugar, peppercorns, rosemary, sage, and thyme in a large stockpot. Bring to a boil, stirring frequently until salt and sugar dissolve. Remove from heat and let cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the water, broth mixture, and apple cider vinegar into a 5-gallon bucket; stir until brine is combined. Add the apples, onion, Worcestershire sauce, and garlic to the brine mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
