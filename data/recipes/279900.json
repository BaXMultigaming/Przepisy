  "ingredients": [
    "1 (7 ounce) can chipotle peppers in adobo sauce",
    "1 cup lime juice",
    "2 tablespoons honey",
    "2 tablespoons dried cilantro",
    "2 tablespoons onion powder",
    "1 tablespoon garlic powder",
    "3 teaspoons chili powder",
    "2 teaspoons ground black pepper",
    "1 teaspoon cayenne pepper",
    "1 teaspoon salt",
    "6 skinless, boneless chicken breasts, or more to taste"
  ],
  "steps": [
    {
      "text": "Combine chipotle peppers, adobo sauce, lime juice, honey, cilantro, onion powder, garlic powder, chili powder, black pepper, cayenne, and salt in a blender or food processor and puree, making sure chipotle chiles are chopped very fine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a layer of chicken in a slow cooker and cover with about 1/2 of the liquid mixture. Lay on remaining chicken and pour remaining liquid over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until chicken is no longer pink in the center and juices run clear, about 6 hours, or on High, about 3 hours. Turn off the heat and let rest for at least 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
