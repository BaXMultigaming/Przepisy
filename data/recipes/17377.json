  "ingredients": [
    "1.3333333730698 cups all-purpose flour",
    "0.75 cup unsweetened cocoa powder",
    "2 teaspoons baking powder",
    "0.25 teaspoon baking soda",
    "0.125 teaspoon salt",
    "1.5 cups white sugar",
    "3 tablespoons butter, softened",
    "2 large eggs",
    "0.75 teaspoon vanilla extract",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a muffin pan with paper or foil liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon flour into a measuring cup and level off with a knife. Sift flour, cocoa, baking powder, baking soda, and salt into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UxpLFD2TNBvlTREgx3UYyC1wnYY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17377-chocolate-cupcakes-ddmfs-step-1-528-3x4-3bc2aebfe3754354ac4e4cc23f15718c.jpg"
      ],
      "image": "assets/images/17377/step_02.webp"
    },
    {
      "text": "Beat sugar and butter together in a separate large bowl with an electric mixer until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IkH_uIZ27uE7_ZSVN46W_envnqc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17377-chocolate-cupcakes-ddmfs-step-2-530-3x4-bf7463912cb8421eb220fddcea4473a6.jpg"
      ],
      "image": "assets/images/17377/step_03.webp"
    },
    {
      "text": "Add eggs, one at a time, beating well after each addition. Stir in the vanilla. Add flour mixture in two batches, alternating with milk; mix only until no streaks of flour remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GvKaR8UZ3TiKrU2HE9YzTvszv6I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17377-chocolate-cupcakes-ddmfs-step-4-536-3x4-47b07c1055b14b7691371964cd8abec6.jpg"
      ],
      "image": "assets/images/17377/step_04.webp"
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 1/2 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6mYOMNH0IF8XGqa8PeuVlXttrvc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17377-chocolate-cupcakes-ddmfs-step-5-545-3x4-1a215b969ca2429b9f06f66bc1bb816a.jpg"
      ],
      "image": "assets/images/17377/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the centers comes out clean, 15 to 17 minutes. Remove from the oven and let cool in the pan for a few minutes before transferring to a wire rack to cool completely before serving or frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/riDYvmalWk8QgJDBT_pZRkpfpR0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17377-chocolate-cupcakes-DDMFS-4x3-622a7a66fcd84692947794ed385dc991.jpg"
      ],
      "image": "assets/images/17377/step_06.webp"
    }
