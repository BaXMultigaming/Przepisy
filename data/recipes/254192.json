  "ingredients": [
    "2.5 cups cold water, divided",
    "1 cup white sugar",
    "0.25 cup fresh mint leaves",
    "1 lemon, zested, or more to taste",
    "1 cup fresh lemon juice",
    "0.5 cup limoncello liqueur"
  ],
  "steps": [
    {
      "text": "Combine 1 cup water, sugar, and fresh mint leaves in a saucepan over medium heat. Bring to a light boil, stirring occasionally, until sugar is dissolved, about 5 minutes. Remove from heat; stir in lemon zest. Let syrup cool slightly, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix remaining 1 1/2 cup water, lemon juice, and limoncello liqueur into syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into an ice cream maker; churn according to the manufacturer's instructions, 10 to 15 minutes. Freeze until firm, about 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
