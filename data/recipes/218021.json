  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 cup milk",
    "0.25 cup melted margarine",
    "2 cups fresh blackberries",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, 1/2 cup sugar, and baking powder together in a mixing bowl. Stir in milk and melted margarine until a batter forms; scrape into the prepared baking dish. Scatter blackberries over top, then sprinkle on remaining 1/2 cup sugar. Pour in water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until batter rises and top is brown, 45 minutes to 1 hour. Cool 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
