  "ingredients": [
    "0.5 cup salted butter",
    "4 cups crispy rice cereal squares (such as Rice Chex®)",
    "2 cups salted cashews",
    "2 cups pecans",
    "2 cups gluten-free pretzels",
    "1 cup dried cranberries",
    "1 teaspoon dried parsley",
    "1 teaspoon dried dill weed",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon dried chives",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line 2 large baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a microwave-safe bowl and melt in the microwave, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix rice cereal squares, cashews, pecans, pretzels, and cranberries together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add parsley, dill, garlic powder, onion powder, chives, salt, and black pepper to the bowl with the melted butter. Toss with cereal mixture and spread onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Sprinkle baking sheets evenly with Parmesan cheese and return to the oven; bake 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve immediately or store in a tightly sealed jar in the refrigerator for 1 week.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
