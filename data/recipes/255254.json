  "ingredients": [
    "1.25 cups white cornmeal",
    "0.5 cup white sugar",
    "0.25 cup gluten-free all-purpose flour",
    "1 tablespoon gluten-free baking powder",
    "1 cup milk",
    "0.25 cup butter, melted",
    "1 egg",
    "1 (14.75 ounce) can cream-style corn"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease an 8-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cornmeal, sugar, flour, and baking powder together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, butter, and egg together in another bowl. Stir into cornmeal mixture just until combined and some lumps remain. Fold in corn. Pour batter into the pan and smooth out the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
