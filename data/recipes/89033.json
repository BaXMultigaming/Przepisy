  "ingredients": [
    "0.5 sweet onion, chopped",
    "0.5 green bell pepper, coarsely chopped",
    "0.25 cup fresh cilantro",
    "5 slices pickled jalapeno peppers, or to taste",
    "6 fresh tomatoes, quartered",
    "2 teaspoons olive oil",
    "2 teaspoons red wine vinegar",
    "0.5 lime, juiced",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Place onion, bell pepper, cilantro, and jalapeños in the bowl of a food processor; pulse until finely chopped. Add tomatoes; pulse several times until tomatoes are coarsely chopped. Transfer to a bowl with a tight-fitting lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, red wine vinegar, lime juice, and salt together in a small bowl until vinaigrette well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour vinaigrette over tomato mixture; stir well. Cover; refrigerate before serving for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
