  "ingredients": [
    "0.5 cup white (shiro) miso",
    "0.5 cup sake (Japanese rice wine)",
    "0.5 cup soy sauce",
    "0.25 cup light brown sugar",
    "2 teaspoons Asian (toasted) sesame oil",
    "1 pound boneless, skinless chicken breast, cut into strips"
  ],
  "steps": [
    {
      "text": "Mix white miso, sake, soy sauce, brown sugar, and sesame oil together in an ovensafe glass or ceramic baking dish. Stir in chicken strips. Cover with plastic wrap and let marinate in the refrigerator, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until marinade has thickened and an instant-read thermometer inserted into the chicken reads at least 165 degrees F (74 degrees C), 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
