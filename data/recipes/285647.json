  "ingredients": [
    "1 (12 ounce) package chicken sausage, sliced in 1/2-inch rounds",
    "1.5 cups sliced zucchini",
    "1 cup grape tomatoes, halved",
    "0.5 cup diced red onion",
    "1 tablespoon olive oil",
    "12 large eggs",
    "1 cup milk",
    "0.75 teaspoon kosher salt",
    "0.5 teaspoon ground black pepper",
    "0.25 cup crumbled feta cheese",
    "1 tablespoon chopped fresh dill"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k5MdSfLn-Xl3hbWQ3ULGhkjtd9A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/sheet-pan-mediterranean-frittata-recipe-11695211-VAT-010-step-01-6169b0064bca46e5b748ceeba14017ae.jpg"
      ],
      "image": "assets/images/285647/step_01.webp"
    },
    {
      "text": "Place sausage, zucchini, grape tomatoes, and red onion on a rimmed baking sheet. Drizzle with olive oil and toss to combine. Spread into a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jSTy5i4ZMXIhgm0T2zw5k9pbYBk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/sheet-pan-mediterranean-frittata-recipe-11695211-VAT-011-step-02-59cb9ddff9114bae9a01c48a150d77e3.jpg"
      ],
      "image": "assets/images/285647/step_02.webp"
    },
    {
      "text": "Roast in the preheated oven until browned around the edges, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/651sXMCxo8Hehss8Bq39wEriNfg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/sheet-pan-mediterranean-frittata-recipe-11695211-VAT-012-step-03-d695004d78da41b18cc10073b10876cf.jpg"
      ],
      "image": "assets/images/285647/step_03.webp"
    },
    {
      "text": "Remove sausage mixture from the oven and reduce heat to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zFVjpIk5nOwKCvsD_F8W6roHDmw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/sheet-pan-mediterranean-frittata-recipe-11695211-VAT-013-step-04-6cd6009cf67a489b8f50e31d48bd0578.jpg"
      ],
      "image": "assets/images/285647/step_04.webp"
    },
    {
      "text": "Whisk eggs, milk, salt, and pepper together in a bowl. Pour evenly over the sausage mixture and sprinkle feta cheese over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eqH-D9e-ZcFWPqqhR0CrkkB93fE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/sheet-pan-mediterranean-frittata-recipe-11695211-VAT-014-step-05-6e89411edc7a4c48887822191c235a56.jpg"
      ],
      "image": "assets/images/285647/step_05.webp"
    },
    {
      "text": "Return to the oven and bake until eggs are set, about 17 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aayXMXEb4JdPT7ChEFXJ_wngsQg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/sheet-pan-mediterranean-frittata-recipe-11695211-VAT-015-step-06-7aa992cff7ad4455a1fa1e251e687294.jpg"
      ],
      "image": "assets/images/285647/step_06.webp"
    },
    {
      "text": "Sprinkle with dill and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/23F8BMh3YnYc7xOKOGEVj0sfgm4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/sheet-pan-mediterranean-frittata-recipe-11695211-VAT-016-step-07-2dd47f1f866941a29885d0f4457d5104.jpg"
