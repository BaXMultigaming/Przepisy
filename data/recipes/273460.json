  "ingredients": [
    "1 (8 ounce) package shredded sharp Cheddar cheese, divided",
    "0.5 cup heavy cream",
    "0.5 teaspoon dry mustard",
    "0.5 teaspoon salt",
    "0.5 teaspoon paprika",
    "10 large eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease an 8x8-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bottom of the prepared pan with 1/2 of the sharp Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together heavy cream, dry mustard, salt, and paprika in a bowl. Pour 1/2 of the mixture over the cheese in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Break eggs over the top, making sure not to break yolks. Cover with remaining cream mixture and top with remaining sharp Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until eggs are set, about 20 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
