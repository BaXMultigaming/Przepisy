  "ingredients": [
    "0.5 cup butter",
    "2 tablespoons white sugar",
    "2 tablespoons golden syrup",
    "4 teaspoons cocoa powder",
    "1 (8 ounce) package rich tea biscuits, crushed",
    "0.25 cup raisins, or to taste",
    "7 ounces milk chocolate chips",
    "7 ounces dark chocolate chips"
  ],
  "steps": [
    {
      "text": "Combine butter, sugar, golden syrup, and cocoa powder in a saucepan over medium-low heat; cook and stir until smooth, 2 to 4 minutes. Stir in biscuits and raisins. Pour mixture onto a rimmed 8 x 12-inch jelly roll pan; press to flatten.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt milk chocolate and dark chocolate in top of a double boiler over simmering water, stirring frequently and scraping down the sides with a rubber spatula to avoid scorching, 3 to 4 minutes. Pour melted chocolate over base in the jelly roll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate until set, about 1 hour. Cut into 20 pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
