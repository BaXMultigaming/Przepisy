  "title": "Creamy Broccoli Casserole",
  "description": "Broccoli is smothered with melted cream cheese and baked between layers of crushed crackers.",
  "authors": [
    "Menda"
  ],
  "date_published": "2018-06-08T09:15:30-04:00",
  "date_modified": "2022-07-14T17:18:10-04:00",
