  "ingredients": [
    "cooking spray",
    "2 (21 ounce) cans apple pie filling",
    "0.5 cup caramel sauce",
    "1 (15.25 ounce) package spice cake mix",
    "1 cup salted butter, melted",
    "1 cup coarsely chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread apple pie filling in an even layer in the pan. Drizzle caramel sauce evenly over apples. Sprinkle with cake mix. Drizzle with melted butter. Sprinkle with walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake is golden and top is bubbling, 50 to 55 minutes. Let cool at least 15 minutes. Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
