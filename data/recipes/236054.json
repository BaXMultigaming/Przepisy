  "ingredients": [
    "1 (15.25 ounce) can whole kernel corn, drained",
    "1 (15 ounce) can black beans, rinsed and drained",
    "1 cup salsa verde",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon ground coriander",
    "1 (22 ounce) package Tyson® Grilled & Ready® Frozen Fajita Chicken Breast Strips",
    "1.5 cups shredded Mexican cheese blend",
    "0.5 cup crushed tortilla chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine corn, beans, salsa, cumin, and coriander in a 2-quart casserole dish; stir in chicken strips and 1 cup cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until bubbly, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle on remaining 1/2 cup cheese; bake until cheese is melted, 3 to 5 minutes. Sprinkle crushed tortilla chips on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
