  "ingredients": [
    "0.5 pound butter, softened",
    "2.5 cups sifted all-purpose flour",
    "1 cup sifted confectioners' sugar",
    "1 tablespoon milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (170 degrees C). Grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter in a mixer until light. Add flour, confectioners' sugar, milk, and vanilla; mix until well combined and velvety.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll 1/2 of the dough to about 1/4-inch thickness using the smallest amount of flour possible. Cut out into desired shapes and place on the prepared baking sheets. Roll and cut out remaining dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 12 minutes. Cookies will be almost white when cooked.",
      "section": null,
      "name": null,
      "url": null,
