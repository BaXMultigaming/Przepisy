  "ingredients": [
    "0.5 cup mayonnaise",
    "1 teaspoon Cajun seasoning",
    "1.3333333730698 pounds ground beef sirloin",
    "0.5 cup diced white onion",
    "1 jalapeno pepper, seeded and chopped",
    "1 clove garlic, minced",
    "1 teaspoon Worcestershire sauce",
    "4 slices pepperjack cheese",
    "4 hamburger buns, split",
    "4 leaves lettuce",
    "4 slices tomato"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise and 1 teaspoon Cajun seasoning in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground sirloin, onion, remaining 3 teaspoons Cajun seasoning, jalapeño, garlic, and Worcestershire sauce in a large bowl. Divide into 4 balls; flatten into patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until burgers are no longer pink in centers, about 5 minutes per side, topping each burger with 1 cheese slice, during the last 2 minutes. An instant-read thermometer inserted into centers should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread mayo on buns, add burgers, lettuce, and tomatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
