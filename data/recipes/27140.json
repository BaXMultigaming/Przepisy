  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "0.5 cup butter",
    "0.5 cup shortening",
    "1 cup white sugar",
    "1 (5 ounce) can evaporated milk",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Bake cake according to package directions in a 9x13 inch pan. Cool and cut into bars. Cut each bar in half lengthwise to make two layers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat butter with an electric mixer until creamy. Beat in shortening, a little at a time, until fluffy. Gradually beat in sugar. Combine evaporated milk and vanilla and beat into filling, scraping the bowl, until fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sandwich the bars with the fluffy filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
