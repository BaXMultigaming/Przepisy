  "ingredients": [
    "1.5 cups white sugar",
    "0.5 cup butter",
    "0.5 cup shortening",
    "2 eggs",
    "0.5 teaspoon rum extract",
    "0.5 teaspoon brandy extract",
    "2.75 cups all-purpose flour",
    "2 teaspoons cream of tartar",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.25 cup colored sugar",
    "2 teaspoons ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, shortening, eggs, rum extract, and brandy extract together in a large bowl until smooth. Stir in flour, cream of tartar, baking soda, and salt; mix until dough is just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix colored sugar and nutmeg together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1 1/4-inch balls; coat with colored sugar mixture and place 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are beginning to crisp, 8 to 10 minutes. Cool on the baking sheet for 1 minute before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
