  "title": "Chef John's Hot Spinach Artichoke Dip",
  "description": "This rich, delightful, hot spinach-artichoke dip is the perfect accompaniment for watching a game or as an elegant appetizer.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-04-16T13:22:19-04:00",
