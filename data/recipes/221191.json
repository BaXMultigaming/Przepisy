  "ingredients": [
    "2 tablespoons butter",
    "0.5 cup green onions, white and light green parts only, thinly sliced",
    "2 cloves garlic, minced",
    "salt",
    "1 (14 ounce) can artichoke hearts, drained and chopped",
    "1 (10 ounce) package frozen chopped spinach , thawed, drained and squeezed dry",
    "8 ounces cream cheese",
    "0.5 cup shredded Gruyere cheese",
    "0.5 cup finely grated Parmigiano-Reggiano cheese",
    "0.25 teaspoon hot sauce",
    "1 pinch ground nutmeg",
    "salt and freshly ground black pepper to taste",
    "0.25 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium-low heat; stir in onions and pinch of salt. Cook, stirring occasionally, until onions are soft, about 5 minutes. Stir garlic into onions and remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix green onion mixture, spinach, artichoke hearts, cream cheese, Gruyere, Parmigiano-Reggiano, hot sauce, nutmeg, salt, and pepper in a large bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon artichoke mixture into two ramekins. Top each with shredded mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are golden brown and bubbling, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
