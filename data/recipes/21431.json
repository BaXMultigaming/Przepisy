  "title": "Turkey and Stuffing",
  "description": "This delicious turkey with sage stuffing adds sage to the bread mixture and provides a special pungent flavor to this simple and classic recipe.",
  "authors": [
    "VICKI C"
  ],
  "date_published": "2000-03-25T17:46:47-05:00",
