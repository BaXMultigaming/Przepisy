  "ingredients": [
    "1 (12 ounce) package dry bread stuffing mix",
    "5 cups water",
    "1 large onion, chopped",
    "4 celery, chopped",
    "4 tablespoons dried sage",
    "12 pounds whole turkey, neck and giblets removed"
  ],
  "steps": [
    {
      "text": "Prepare stuffing according to package directions, and set aside in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water to boil in a medium saucepan over medium heat, and stir in onion, celery, and sage. Boil 10 minutes, or until onion is soft. Stir into prepared stuffing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse turkey, and pat dry. Loosely fill body and neck cavities with stuffing mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place turkey in a large roasting pan and cook 3 to 3 1/2 hours in the preheated oven, or until the internal temperature of the thigh meat is 180 degrees F (80 degrees C) and stuffing is at least 165 degrees F (75 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
