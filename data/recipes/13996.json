  "ingredients": [
    "3 large cucumbers",
    "1 teaspoon salt",
    "0.25 cup white sugar",
    "0.25 cup distilled white vinegar",
    "0.25 cup chopped onion",
    "0.125 cup water",
    "0.5 teaspoon celery seed"
  ],
  "steps": [
    {
      "text": "Peel cucumbers, slice wafer-thin, sprinkle with salt. Set aside for 30 minutes; squeeze cucumbers to release moisture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, vinegar, onion, water, and celery seeds in a bowl; add cucumbers and stir until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
