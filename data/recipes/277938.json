  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 eggs",
    "1 cup white sugar",
    "3 medium ripe bananas, mashed",
    "0.33333334326744 cup oil",
    "1 teaspoon vanilla extract",
    "0.5 cup chocolate chips",
    "0.5 cup yogurt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, baking soda, and salt in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the eggs with an electric mixer until foamy. Add sugar; beat until fluffy. Continue beating while adding mashed bananas, oil, and vanilla extract. Add flour mixture in 2 batches, alternating with yogurt, beating batter briefly after each addition, and until creamy following last flour addition. Stir in chocolate chips. Fill the prepared muffin cups to the top with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 22 to 25 minutes. Cool in the tin for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
