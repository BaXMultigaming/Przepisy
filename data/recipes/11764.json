  "ingredients": [
    "1 cup macaroni",
    "1 green bell pepper, chopped",
    "0.75 cup cubed Cheddar cheese",
    "1 stalk celery, chopped",
    "0.5 cup frozen green peas, thawed",
    "0.33329999446869 cup chopped onion",
    "0.25 cup mayonnaise",
    "0.25 cup sour cream",
    "2 tablespoons milk",
    "1.5 tablespoons sweet pickle relish"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook macaroni in the boiling water until tender yet firm to the bite, 7 to 10 minutes; drain. Rinse pasta under cold water; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine macaroni, bell pepper, celery, cheese, peas, onion, mayonnaise, sour cream, milk, and pickle relish in a large bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl; refrigerate before serving, at least 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
