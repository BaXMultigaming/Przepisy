  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 tablespoon white sugar",
    "1.5 teaspoons baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1 cup Greek yogurt",
    "1 egg",
    "0.25 cup water, or more as needed",
    "1 teaspoon vanilla extract",
    "1 teaspoon vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Mix flour, sugar, salt, and baking powder together in a large bowl. Mix yogurt, egg, water, and vanilla extract together in a small bowl. Pour yogurt mixture into flour mixture; mix until well incorporated. Add additional water by the tablespoon if needed to reach the right consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a griddle or skillet over medium heat. Use approximately 1/4 cup of batter per pancake. Cook until golden brown, 2 to 3 minutes per side.",
