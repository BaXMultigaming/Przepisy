  "ingredients": [
    "0.25 cup butter",
    "1 pound confectioners' sugar",
    "1 cup sweetened condensed milk",
    "2 cups flaked coconut",
    "9 (1 ounce) squares semisweet chocolate",
    "2 tablespoons shortening"
  ],
  "steps": [
