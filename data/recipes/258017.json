  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "1 cup milk",
    "3 eggs",
    "0.5 cup white sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground ginger",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground cloves",
    "1 (18.25 ounce) package butter cake mix",
    "0.75 cup butter, melted",
    "0.75 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk pumpkin puree, milk, eggs, sugar, cinnamon, ginger, nutmeg, salt, and cloves together in a bowl; pour into the prepared pan. Drizzle butter on top. Sprinkle cake mix over butter and top with pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
