  "ingredients": [
    "8 whole cloves",
    "1 teaspoon chopped crystallized ginger",
    "4 cups white sugar",
    "12 drops peppermint extract",
    "2 teaspoons vanilla extract",
    "1 teaspoon anise extract",
    "15 drops yellow food coloring",
    "2 (750 milliliter) bottles vodka"
  ],
  "steps": [
    {
      "text": "Place the cloves and ginger in a small jar and add enough vodka to cover. Seal and soak for 3 days. NO MORE! Strain the liquid, discarding the solids.",
