  "ingredients": [
    "2 cups pecan halves",
    "2 (12 ounce) bags chocolate chips",
    "25 individually wrapped caramels, unwrapped",
    "2 tablespoons water",
    "0.5 cup butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange pecans on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pecans in the preheated oven until fragrant and lightly browned, 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate chips in the top of a double boiler over simmering water, stirring frequently and scraping down the sides with a rubber spatula to avoid scorching.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a baking sheet with aluminum foil; grease with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine caramels, water, and butter in a saucepan over low heat; cook, stirring occasionally, until caramels are melted and smooth. Fold in pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop caramel mixture by the spoonful onto the prepared baking sheet. Allow to cool and harden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle chocolate over caramel nut clusters. Refrigerate to set, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
