  "ingredients": [
    "1.5 cups whole milk",
    "1.5 cups light cream",
    "1 cup white sugar",
    "2 tablespoons ground coffee",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Mix milk, cream, and sugar together in a large bowl. Refrigerate to let sugar dissolve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, brew coffee grounds with water in a coffee maker or French press. Refrigerate coffee until completely cooled, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk mixture using an electric mixture until slightly thickened to the consistency of buttermilk. Stir coffee into milk mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer’s instructions, 20 to 30 minutes. Serve or transfer to an airtight container and store in the freezer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
