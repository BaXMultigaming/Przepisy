  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter and flour a 9-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, ¼ cup white sugar, cinnamon, and allspice; stir in 1 stick melted butter. Beat in 1 ⅓ cups flour until well combined. Set topping aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat ¾ cup white sugar and 6 tablespoons butter together in a bowl until creamy. Add eggs. one at a time, beating well after each addition. Add sour cream, vanilla extract, and lemon zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift 1 ¼ cups flour, baking powder, and baking soda together in a separate bowl; stir into sour cream mixture, then fold in blueberries. Spoon batter into the prepared cake pan; sprinkle with topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
