  "ingredients": [
    "2 (8 ounce) packages refrigerated crescent rolls",
    "8 ounces maple apple chicken sausage",
    "1 tablespoon unsalted butter",
    "4 large eggs",
    "salt and freshly ground black pepper to taste",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll crescent dough and separate into triangles. Slice sausage into coin-sized pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium-high heat. Add eggs and sausage pieces and season with salt and pepper. Cook, stirring, until cooked through, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place about 2 tablespoons of filling and some Cheddar cheese onto 8 of the crescent triangles. Place remaining crescents on top of filling. Pinch to seal triangle pockets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer until golden brown, about 5 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
