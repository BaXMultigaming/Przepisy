  "ingredients": [
    "1 bunch kale",
    "1 tablespoon olive oil",
    "1 teaspoon flaked sea salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jJWJnjETI-FBOswpxRRUxEISC7Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/176957-baked-kale-chips-DDMFS-7776-4x3-step01-594963b8a1ce4da69778474d74f1d7d8.jpg"
      ],
      "image": "assets/images/176957/step_01.webp"
    },
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a rimmed baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove kale leaves carefully from thick stems using a knife or kitchen shears; tear into bite-sized pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/51WtsIFX4W8q5ABAgAxeLxovGmA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/176957-Step2_BakedKaleChips_9903-b90d2b8af28946a49e098cb8f384cb44.jpg"
      ],
      "image": "assets/images/176957/step_03.webp"
    },
    {
      "text": "Wash and thoroughly dry kale with a salad spinner.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X3Pk5lg9gdnxqjgpZcTQsFYEsWU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/176957-Step3_BakedKaleChips_9906-3b7f76cb624a458e8a94f5235d60f7f0.jpg"
      ],
      "image": "assets/images/176957/step_04.webp"
    },
    {
      "text": "Drizzle kale leaves with olive oil; toss to coat. Spread leaves in an even layer on the prepared baking sheet without overlapping; sprinkle with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w21vGqBDhRYgrzOQfGyQq5QoSoA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/176957-Step4_BakedKaleChips_9913-1e2dcc2220a9435ba093964945ba2d01.jpg"
      ],
      "image": "assets/images/176957/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until edges start to brown but are not burnt, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k_tj36iVLpf16NA-EMY6lQ3c1J4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/176957-Step5_BakedKaleChips_9916-657dc0f25132478e87079bf3e6bcb5eb.jpg"
      ],
      "image": "assets/images/176957/step_06.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mG3tpzT8HHjiYp3Ho9-YbGqa0No=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/176957-baked-kale-chips-DDMFS-4x3-40fcece9965d47278e7f590304d6861c.jpg"
