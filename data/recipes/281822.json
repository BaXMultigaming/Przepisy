  "ingredients": [
    "1 tablespoon canola oil, or to taste",
    "1 bunch kale - rinsed, dried and chopped",
    "0.25 teaspoon garlic powder, or to taste",
    "0.25 teaspoon sea salt, or to taste",
    "0.25 teaspoon dried dill weed, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Pour oil into a spritzer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread kale over a large baking sheet. Spray oil evenly over kale, then sprinkle with garlic powder, sea salt, and dill; stir until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring every 5 minutes, until crispy, 10 to 15 minutes total.",
