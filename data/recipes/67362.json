  "ingredients": [
    "1 (4 pound) boneless ham",
    "1 (8 ounce) can pineapple slices, canned in syrup",
    "10 whole cloves",
    "2 cups water",
    "2 tablespoons butter",
    "1 cup maple syrup",
    "0.25 cup brown sugar",
    "2 tablespoons honey"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prick ham with a fork. Place pineapple slices on ham, securing with toothpicks. Press cloves into ham. Place ham in a baking dish. Pour water into the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small saucepan over low heat. Mix in maple syrup, brown sugar, and honey until glaze is smooth and heated through. Pour 1/2 of the glaze over ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour and 30 minutes, basting frequently with remaining glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pan drippings into a saucepan over medium heat. Cook and stir until thickened; serve with ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
