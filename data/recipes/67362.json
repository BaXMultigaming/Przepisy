  "title": "Mapled Ham",
  "description": "This maple glazed ham with pineapple and cloves is cooked with maple syrup, butter, brown sugar, and honey for an impressive and tasty holiday main dish.",
  "authors": [
    "Colleen Criswell"
  ],
  "date_published": "2020-03-04T23:58:31-05:00",
