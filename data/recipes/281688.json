  "ingredients": [
    "12 medium jalapeño peppers",
    "12 tablespoons cream cheese, softened",
    "1.5 pounds cooked chopped brisket",
    "12 slices thick-cut bacon",
    "kosher salt and ground black pepper to taste",
    "0.5 (12 ounce) bottle BBQ sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice jalapeños in the shape of a \"T.\" Cut a straight vertical line from top to bottom with a crosscut directly under the stem, making sure to cut only halfway through the jalapeños. Use a spoon to remove and discard all seeds and membranes. Place jalapeños on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/00-959BqnxTEb-4XUGbIUJJLsvE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281688-texas-twinkies-ddmfs-step1-0417-99a1bb99f19a444a84ff103f6e3a6e48.jpg"
      ],
      "image": "assets/images/281688/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer jalapeños to a bowl of ice water for a few minutes to extract the rest of the seeds' oil. Blot dry with a paper towel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1Po-R5OioKcMvSnABiUmtri8348=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281688-texas-twinkies-ddmfs-step2-0419-4a76529ae099437e91f6b5dcc46f8277.jpg"
      ],
      "image": "assets/images/281688/step_04.webp"
    },
    {
      "text": "Increase oven temperature to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1 tablespoon cream cheese inside each jalapeño. Place about 2 ounces brisket inside each, then wrap with a slice of bacon. Place poppers on a baking sheet and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jfmoSkIazQBzo2vVuSmX9mERwH0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281688-texas-twinkies-ddmfs-step3-0421-435047071e804bc4aa802bf38b62f105.jpg"
      ],
      "image": "assets/images/281688/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Remove from the oven and brush the tops with BBQ sauce. Return to the oven and bake 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yLk1fNAmb9tG2uq2pBcspj7P5_g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281688-texas-twinkies-ddmfs-step5-0459-38a6bc5dd54c4bd58f4c2f1374680080.jpg"
      ],
      "image": "assets/images/281688/step_07.webp"
    }
  ],
