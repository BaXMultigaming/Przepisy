  "ingredients": [
    "butter flavored cooking spray",
    "4 (4 ounce) fillets tilapia",
    "4 teaspoons margarine, melted",
    "7 tablespoons lemon juice, divided",
    "4 tablespoons chopped fresh dill, divided",
    "1 tablespoon lemon-pepper seasoning",
    "4 teaspoons cream cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (175 degrees C). Grease a baking tray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tilapia fillets on the prepared tray and coat them lightly with cooking spray. Spoon melted margarine over each fillet, then drizzle with 2 tablespoons lemon juice. Season with 2 tablespoons dill and lemon pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish is opaque and flakes easily with a fork, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine remaining 5 tablespoons lemon juice, remaining 2 tablespoons dill, and cream cheese in a small bowl. Heat in the microwave for 1 minute 10 seconds, then stir to blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fillets onto serving plates and spoon sauce around them in a decorative fashion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
