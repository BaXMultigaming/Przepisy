  "ingredients": [
    "0.75 cup unsalted butter",
    "1 cup brown sugar",
    "1 teaspoon ground cinnamon",
    "3 large apples, peeled and sliced",
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "1 teaspoon baking powder",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1/2 cup butter in an 8-inch square baking dish in the preheated oven, 3 to 4 minutes. Remove from the oven and set aside. Increase the oven temperature to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt remaining 1/4 cup butter in a skillet over low heat. Add brown sugar and cinnamon; cook for 2 minutes. Stir in sliced apples and remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, white sugar, and baking powder together in a medium bowl. Add milk and mix well. Pour batter into the baking dish with melted butter. Pour apples evenly into the dish. Do not stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
