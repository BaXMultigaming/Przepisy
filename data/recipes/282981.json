  "title": "Apple Cobbler",
  "description": "This baked apple cobbler is a delicious, easy, comforting dessert to take to your next party or potluck.",
  "authors": [
    "Erica Thomas Cox"
  ],
  "date_published": "2006-10-27T10:55:41-04:00",
