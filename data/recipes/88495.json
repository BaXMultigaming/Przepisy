  "ingredients": [
    "0.75 cup soy sauce",
    "0.25 cup fresh lemon juice",
    "1 tablespoon brown sugar",
    "1 tablespoon chili sauce",
    "0.25 teaspoon garlic powder",
    "8 center cut pork chops",
    "vegetable oil for the grill"
  ],
  "steps": [
    {
      "text": "Combine soy sauce, lemon juice, brown sugar, chili sauce, and garlic powder in a large resealable bag. Place pork chops into the bag and seal. Marinate for 6 to 12 hours in the refrigerator. Turn the bag over about halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil the grate. Arrange pork chops on the grate and cook 5 to 7 minutes on each side until the internal temperature reaches 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
