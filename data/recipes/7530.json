  "ingredients": [
    "2 cups white sugar",
    "1.5 cups butter, softened",
    "1.3333333730698 cups flaked coconut",
    "4 eggs",
    "0.66666668653488 cup unsweetened cocoa powder",
    "1.5 cups chopped pecans",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "2 teaspoons vanilla extract",
    "12 ounces marshmallow creme",
    "3.75 cups confectioners' sugar",
    "2 tablespoons evaporated milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease one 13x9 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together 1/3 cup of the cocoa, white sugar, and 1 cup of the butter or margarine until light and fluffy. Add the eggs, and 1 teaspoon of the vanilla and beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, coconut, and chopped pecans together. Stir flour mixture into the egg mixture and stir until just combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 40 to 50 minutes. Smooth marshmallow cream over top of cake while still hot. Let cake cool completely then ice with chocolate icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Chocolate Icing: Beat together the confectioner's sugar, the remaining 1/3 cup cocoa, 1 teaspoon vanilla, and 1/2 cup butter or margarine. Continue to beat and add enough evaporated milk to make icing spread on cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
