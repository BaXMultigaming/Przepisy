  "ingredients": [
    "0.5 pound white fish, cut into thin slices (such as pomfret)",
    "salt to taste",
    "0.5 cup grated coconut",
    "5 red Kashmiri chiles",
    "4 cloves garlic, peeled",
    "1.5 tablespoons coriander seeds",
    "4 whole peppercorns",
    "0.5 teaspoon ground turmeric",
    "2 pieces kokum (fruit from the mangosteen family)"
  ],
  "steps": [
    {
      "text": "Season fish pieces with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grind coconut, red chiles, garlic, coriander, and peppercorns together with a morter and pestle until a fine paste forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine paste and turmeric powder in a pot and bring to a boil; add fish. Lower temperature to medium and cook until fish flakes easily with a fork, about 15 minutes. Add kokum and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
