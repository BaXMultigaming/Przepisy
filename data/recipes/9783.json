  "ingredients": [
    "1 cup butter",
    "1 cup white sugar",
    "1 tablespoon milk",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "1 cup finely chopped red and green candied cherries",
    "0.5 cup chopped pecans",
    "1 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "In mixing bowl beat butter or margarine until softened. Add the sugar and beat until fluffy. Add the milk and vanilla and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the flour and beat until well mixed. Stir in the cherries and pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape into three 7-inch long rolls. Roll in the coconut to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap in plastic wrap and chill for several hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut rolls into 1/4-inch slices and place on an ungreased cookie sheet. Bake about 12 minutes or until done. Remove to a wire rack and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
