  "ingredients": [
    "2 tablespoons vegetable oil",
    "0.66666698455811 cup applesauce",
    "1 cup 1% low-fat milk",
    "0.66666698455811 cup low-fat plain yogurt",
    "1 extra large egg",
    "2.5 tablespoons strawberry jam",
    "1 tablespoon vanilla extract",
    "2.75 cups bran flakes cereal",
    "1 cup whole wheat flour",
    "1.25 cups wheat bran",
    "1.25 cups buckwheat flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "1.5 tablespoons brown sugar",
    "2 teaspoons ground ginger",
    "0.25 teaspoon pumpkin pie spice",
    "0.25 teaspoon allspice",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly coat muffin cups with cooking spray or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, beat together oil, applesauce, milk, yogurt, egg, strawberry jam, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a food processor, grind bran flake cereal to a fine powder; this should make about 1 1/4 cups flour. Transfer to a large bowl, and stir together with whole wheat flour, wheat bran, buckwheat flour, baking powder, baking soda, brown sugar, ground ginger, pumpkin pie spice, allspice, and ground nutmeg. Pour in applesauce mixture, and mix thoroughly. Spoon mixture into prepared muffin cups, filling until level with the top of the muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 26 to 30 minutes, or until muffins test done with a toothpick. Remove muffins from pan, and cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
