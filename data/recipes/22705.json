  "ingredients": [
    "10 ounces lasagna noodles",
    "1.5 pounds lean ground beef",
    "3 cups cottage cheese",
    "2 eggs",
    "1 teaspoon garlic powder",
    "2 tablespoons dried parsley",
    "salt and pepper to taste",
    "1 (6 ounce) can tomato paste",
    "2 (6.5 ounce) cans tomato sauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add lasagna noodles and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a skillet, brown ground beef. Using a fork, mix cottage cheese, eggs, garlic powder, parsley, salt and pepper. In a separate bowl combine tomato paste and tomato sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 9x13 inch baking pan, layer noodles, ground beef, tomato sauce mixture and cottage cheese mixture. Two layers of each will fit. Cover with tin foil and bake for 30 minutes. Remove tin foil the last 8 minutes of baking time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
