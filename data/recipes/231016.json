  "ingredients": [
    "1 (15 ounce) package flour tortillas, cut into wedges",
    "1 tablespoon white sugar, or as needed",
    "ground cinnamon, or as needed",
    "0.5 cup butter, melted",
    "2 (8 ounce) packages cream cheese, softened",
    "0.5 cup brown sugar",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 (8 ounce) package toffee baking bits (such as Heath®)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread tortilla wedges onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1 tablespoon white sugar and cinnamon together in a small bowl. Drizzle melted butter evenly over tortilla wedges; sprinkle with cinnamon-sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chips are crisp, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese, brown sugar, 1/2 cup white sugar, and vanilla extract together with an electric mixer until smooth; fold in toffee bits. Chill brickle dip until serving time. Serve warm chips with brickle dip.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
