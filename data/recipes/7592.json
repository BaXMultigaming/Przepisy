  "ingredients": [
    "1 cup white sugar",
    "1 cup butter, softened",
    "3 eggs",
    "2 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons baking soda",
    "0.5 cup sour cream",
    "1 cup chopped walnuts",
    "0.75 cup white sugar",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease one 8x12 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together 1 cup of the white sugar with 1 cup butter. Add the eggs and beat well. Mix in the flour, baking soda, baking powder, and sour cream, stir until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/2 of the batter into the prepared pan then sprinkle with 3/4 of the filling. Pour the remaining cake batter on top and sprinkle top with the remaining filling. Bake at 350 degrees F (175 degrees C) for 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Filling: Combine chopped nuts, ground cinnamon, and 3/4 cup white sugar and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
