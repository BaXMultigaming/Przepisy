  "ingredients": [
    "6 tablespoons margarine, divided",
    "1 small onion, chopped",
    "1 (30 ounce) package frozen shredded hash brown potatoes, thawed",
    "ground black pepper to taste",
    "2 cups shredded sharp Cheddar cheese",
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "1 (10.5 ounce) can condensed cream of celery soup",
    "1 (8 ounce) container sour cream",
    "0.5 pound diced ham",
    "2 cups cornflakes",
    "2 tablespoons margarine"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 4 tablespoons margarine in a Dutch oven over medium heat. Add onion; sauté until translucent, about 5 minutes. Stir in 2 tablespoons margarine until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, stir in hash brown potatoes and black pepper until evenly combined. Add Cheddar cheese, condensed soups, sour cream, and ham; stir until combined. Transfer to a large baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss cornflakes with 2 tablespoons melted margarine until coated; sprinkle on top of potato casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
