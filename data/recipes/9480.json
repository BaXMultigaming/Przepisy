  "ingredients": [
    "2 cups semisweet chocolate chips",
    "1 cup butter",
    "4 cups confectioners' sugar",
    "2.6666667461395 cups evaporated milk",
    "1 teaspoon vanilla extract",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "In a large saucepan, combine chocolate chips and butter. Cook and stir over low heat until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually mix in confectioners' sugar and milk. Increase heat to a boil. Cook, stirring constantly, for 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat, then stir in vanilla and salt. Serve warm. Store in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
