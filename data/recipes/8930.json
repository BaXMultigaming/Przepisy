  "ingredients": [
    "1 cup all-purpose flour for coating",
    "1 teaspoon cocoa powder",
    "1 pound chicken tenders",
    "1 egg, beaten",
    "1 cup seasoned dry bread crumbs",
    "2 cups olive oil for frying"
  ],
  "steps": [
    {
      "text": "Mix flour and cocoa powder in a shallow dish or plate. One by one, coat chicken pieces in flour mixture, then dip in beaten egg, then in seasoned bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a cast iron skillet to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry coated chicken pieces in oil until cooked through and juices run clear (approximately 5 minutes). Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
