  "ingredients": [
    "1 tablespoon butter",
    "3 cups dry bread cubes",
    "1 teaspoon vegetable oil",
    "1 strip bacon, chopped",
    "0.25 cup minced onion",
    "0.25 cup minced red bell pepper",
    "0.33333334326744 cup chicken broth, or more as needed",
    "0.33333334326744 cup heavy cream",
    "1 large egg",
    "0.5 lemon, juiced",
    "1 tablespoon chopped fresh tarragon",
    "1 teaspoon fresh lemon zest",
    "4 ounces fresh lump crabmeat",
    "salt and fresh ground pepper to taste",
    "1 pinch cayenne pepper, or to taste",
    "0.5 tablespoon distilled white vinegar",
    "2 eggs",
    "0.25 cup hollandaise sauce",
    "1 pinch cayenne pepper, for garnish"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Butter the insides of 2 (10-ounce) ramekins and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread cubes into a large bowl, set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a large skillet over medium heat; cook and stir bacon in hot oil until browned and almost crisp, 5 to 6 minutes. Remove excess oil from skillet and discard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in onion and cook for about 2 minutes. Stir in red pepper and cook for an additional minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chicken broth and heavy cream; cook until mixture begins to simmer, about 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cream mixture over bread cubes and mix thoroughly until all liquid is absorbed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in 1 egg, lemon juice, tarragon, and lemon zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in crabmeat, salt, black pepper, and cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon Mixture into prepared ramekins and bake in a preheated oven until tops are golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove ramekins from oven and top each bread pudding with a poached egg. Spoon hollandaise sauce over each egg. Garnish with cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
