      ],
      "image": "assets/images/80919/step_01.webp"
    },
    {
      "text": "Cut each potato in half lengthwise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1rpVjzB_IRah0wD-AuliIwR-vIg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-80919-Foil-Potatoes-DDMFS-Step-02-a-b36aceb0425d4102916b0d53219467d9.jpg"
      ],
      "image": "assets/images/80919/step_02.webp"
    },
    {
      "text": "Place 1/2 tablespoon butter on the cut side of each potato half and season with garlic powder and salt. Close potato halves to form full potatoes and wrap each tightly with a square of aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1GoApwcs9cyqS3dQsou4YZtno6s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-80919-Foil-Potatoes-DDMFS-Step-02-b-7dc51912346d4d42857e427fdd8eccb4.jpg"
      ],
      "image": "assets/images/80919/step_03.webp"
    },
    {
      "text": "Bake potatoes directly on the rack of the preheated oven until tender, about 40 to 60 minutes.",
      "section": null,
