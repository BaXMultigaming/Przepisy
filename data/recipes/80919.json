  "ingredients": [
    "4 12x12-inch squares aluminum foil",
    "4 medium baking potatoes, scrubbed",
    "4 tablespoons butter",
    "4 teaspoons garlic powder",
    "2 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
