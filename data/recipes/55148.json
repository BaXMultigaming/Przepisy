  "ingredients": [
    "1 (14 ounce) round 4 1/4-inch diameter round Brie cheese",
    "0.5 cup brown sugar",
    "2 tablespoons water",
    "6 fresh figs, stemmed and quartered",
    "0.5 cup toasted almonds",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 C). Place Brie in a round baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat brown sugar and water in a small saucepan over medium heat until sugar is completely dissolved. Add figs and vanilla; cook until softened, about 10 minutes. Stir in almonds and vanilla, then pour mixture over Brie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until softened but not melted, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
