  "ingredients": [
    "2 cups frozen hash brown potatoes",
    "0.5 cup shredded carrot",
    "0.25 cup chopped onion",
    "2 tablespoons chopped fresh parsley",
    "2 tablespoons butter",
    "1 to taste salt and pepper to taste",
    "8 eggs",
    "0.5 cup milk",
    "0.25 teaspoon dry mustard",
    "1 dash hot pepper sauce",
    "1 cup cubed cooked ham",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "In a non-metallic 2 quart casserole dish, stir together potatoes, carrot, onion, parsley and butter. Cover and microwave on High for 5 minutes, stirring once or twice. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, beat together, eggs, milk, mustard and hot pepper sauce. Stir in cubed ham. Pour egg mixture into casserole, stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover dish and microwave on high for 3 minutes. Draw cooked egg toward middle of dish and microwave on medium for 10 to 12 minutes. If you do not have a turntable rotate dish 2 to 3 times. Sprinkle cheese on top, cover and microwave for 30 to 60 seconds until cheese is melted. Let stand 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
