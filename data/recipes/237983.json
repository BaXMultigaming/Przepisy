  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 pound ground beef",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 small onion, chopped",
    "2 (15 ounce) cans pinto beans, rinsed and drained",
    "2 (15 ounce) cans crushed tomatoes",
    "1 (15 ounce) can cream-style corn",
    "1 (6 ounce) box cornbread mix",
    "1 large egg, lightly beaten",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XIR1Tr-f8TuTM3zGMoqn72pg4YE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-237983-easy-tamale-casserole-DDMFS-Step-01-e14dc07ea18d4a7cbc41e2688385e3f5.jpg"
      ],
      "image": "assets/images/237983/step_01.webp"
    },
    {
      "text": "Heat a cast iron skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Season beef with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/URgdLhYsf6_846U9dqDi9yyCM8M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-237983-easy-tamale-casserole-DDMFS-Step-02-c2e3c2d5e7d3405bb96919a201970e70.jpg"
      ],
      "image": "assets/images/237983/step_02.webp"
    },
    {
      "text": "Stir onion into ground beef; cook and stir over medium heat for 1 minute, then immediately remove the skillet from heat. Stir in pinto beans and crushed tomatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TOUczuz5jtE3nzKwjNoK-oWJCM4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-237983-easy-tamale-casserole-DDMFS-Step-03-d8494bfb892a40a181452edcfd6263ec.jpg"
      ],
      "image": "assets/images/237983/step_03.webp"
    },
    {
      "text": "Beat together cream-style corn, cornbread mix, and egg in a large bowl until smooth; spread over ground beef mixture in the skillet. Sprinkle with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gCNTfGP79D6wMDk7JmFJH461yAM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-237983-easy-tamale-casserole-DDMFS-Step-04-e4805683a91b448f889ec5926264a01b.jpg"
      ],
      "image": "assets/images/237983/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and cornbread is set in the middle, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BVuYLRkONfCIX_XZeaqunvBwl4o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-237983-easy-tamale-casserole-DDMFS-Step-06-9084f9f714884e64a1be20462e137eb7.jpg"
      ],
      "image": "assets/images/237983/step_05.webp"
    }
  ],
