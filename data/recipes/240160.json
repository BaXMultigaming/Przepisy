  "ingredients": [
    "1 (40 ounce) can cut yams, drained",
    "1 cup white sugar",
    "0.5 cup whole milk",
    "0.5 cup salted butter, softened",
    "2 eggs, beaten",
    "1.5 cups brown sugar",
    "1 cup chopped pecans",
    "0.5 cup salted butter, softened",
    "0.5 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put yams in a microwave safe bowl; heat in the microwave oven until softened, about 75 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cooked yams to a large mixing bowl; add white sugar, milk, 1/2 cup butter, and eggs and beat with a hand mixer until smooth. Pour the yam mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, pecans, 1/2 cup butter, and flour together in a bowl with a wooden spoon until crumbly, sprinkle over the yam mixture to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
