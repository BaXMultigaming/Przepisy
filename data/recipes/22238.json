  "ingredients": [
    "5 potatoes, peeled and thinly sliced",
    "1 onion, quartered then sliced",
    "2.5 cups Cheddar cheese, shredded",
    "1 cup milk",
    "3 tablespoons butter",
    "salt and pepper to taste",
    "5 pork chops"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the sliced potatoes and sliced onion in a greased 9x13 inch baking dish; mix gently. Cover the potatoes and onions with cheese. Fill dish with milk halfway. Place butter in several places on top of the cheese. Place the pork chops on top. Salt and pepper to taste. Bake 60 minutes or until potatoes are tender. Turn pork chops over halfway through cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
