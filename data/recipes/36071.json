  "ingredients": [
    "1.25 cups sifted all-purpose flour",
    "0.5 tablespoon white sugar",
    "1 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 egg yolk",
    "1 cup sour cream",
    "0.25 cup coconut milk",
    "0.75 cup chopped fresh pineapple",
    "5 tablespoons unsalted butter, melted",
    "2 large egg whites, beaten"
  ],
  "steps": [
    {
      "text": "Preheat a lightly greased waffle iron.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, sift together flour, sugar, baking powder, baking soda and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate medium bowl, mix egg yolk, sour cream, coconut milk, pineapple and butter. Thoroughly mix in the flour mixture. Gently fold in egg whites.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the mixture into the prepared waffle iron, and cook until golden brown.",
