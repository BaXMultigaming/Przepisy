  "ingredients": [
    "1 Reynolds® Slow Cooker Liner",
    "4 (10 ounce) packages frozen whole-kernel corn, thawed*",
    "1.5 cups half and half, light cream, or whole milk",
    "1 cup chopped onion",
    "0.5 cup finely shredded Parmesan cheese",
    "0.25 cup butter, cut up",
    "0.5 teaspoon salt",
    "0.75 cup shredded Monterey Jack cheese",
    "6 thick slices peppered bacon, crisp-cooked and chopped",
    "0.5 cup chopped tomato",
    "2 tablespoons snipped fresh basil"
  ],
  "steps": [
    {
      "text": "Line a 5- to 6-quart slow cooker with a Reynolds® Slow Cooker Liner.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 2 packages of the corn in a blender with the cream or milk. Cover and blend until smooth. Transfer to prepared slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir remaining corn, onion, Parmesan cheese, butter, and salt into the corn mixture in cooker. Stir gently with a rubber spatula to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook for 2 hours on high or for 4 hours on low. Transfer to a serving dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with Monterey Jack cheese, bacon, tomato, and basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
