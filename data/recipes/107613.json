  "ingredients": [
    "1 pound chicken drumsticks",
    "1 tablespoon adobo seasoning",
    "0.5 (.18 ounce) packet sazon seasoning",
    "0.5 teaspoon salt",
    "5 large red potatoes, peeled and thickly sliced",
    "1 large onion, chopped",
    "1 large red bell pepper, seeded and chopped",
    "1 large green bell pepper, seeded and chopped",
    "1 bunch fresh cilantro, chopped",
    "0.5 cup dry red wine",
    "2 tablespoons olive oil",
    "5 cloves garlic, minced",
    "1 teaspoon ground cumin",
    "1 teaspoon dried oregano",
    "2 fresh or dried bay leaves"
  ],
  "steps": [
    {
      "text": "Wash chicken; pat dry. Place chicken in a large bowl; season with adobo seasoning, Sazón seasoning, and salt. Transfer chicken to a slow cooker; cover with potato slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine onion, bell peppers, cilantro, wine, olive oil, garlic, cumin, and oregano in a blender; blend until puréed. Pour over chicken; add bay leaves. Cover slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until chicken easily falls off the bone, 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
