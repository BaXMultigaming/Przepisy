  "title": "Great Easter Appetizer",
  "description": "Hard cooked eggs are topped with a ham and cream cheese mixture and seasoned bread crumbs, then baked.",
  "authors": [
    "May"
  ],
  "date_published": "2000-04-12T17:58:53-04:00",
