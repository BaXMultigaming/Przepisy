  "ingredients": [
    "3 cloves garlic, or more to taste",
    "2 tablespoons tahini, or more to taste",
    "1 (8 ounce) container plain yogurt",
    "1 lemon, juiced and zested",
    "0.5 teaspoon ground cumin",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Place garlic cloves in a blender or the bowl of a food processor; process until minced. Add tahini; process about 3 seconds. Add yogurt, lemon zest, lemon juice, and cumin; process until smooth. Season with salt. Transfer to a serving dish.",
