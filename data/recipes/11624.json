  "ingredients": [
    "1 cup shortening",
    "1.5 cups white sugar",
    "2 eggs",
    "2.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "2 teaspoons cream of tartar",
    "0.5 teaspoon salt",
    "2 tablespoons white sugar",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the shortening and 1 1/2 cups sugar. Stir in the eggs. Sift together the flour, baking soda, cream of tartar, and salt; stir into the creamed mixture until well blended. In a small bowl, stir together the 2 tablespoons of sugar, and the cinnamon. Roll dough into walnut sized balls, then roll the balls in the cinnamon-sugar. Place them onto an unprepared cookie sheet, two inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes in the preheated oven. Edges should be slightly brown. Remove from sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
