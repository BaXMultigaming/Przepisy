  "ingredients": [
    "8 small (3 to 4 inches) russet potatoes",
    "2 tablespoons olive oil",
    "Coarse salt and freshly ground pepper to taste",
    "1 (15 ounce) can HORMEL® Chili With Beans",
    "2 cups shredded sharp Cheddar cheese",
    "0.5 cup sour cream",
    "0.5 cup sliced green onions"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Pierce potatoes several times with the tip of a knife; arrange on a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tender, 45 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice potatoes in half; scoop out flesh (reserve for mashing or potato pancakes), leaving ¼-inch flesh in shell. Brush inside and outside potato shells with oil; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange potato shells on the baking sheet. Bake until crisp and golden brown, about 10 minutes, flipping once.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon chili into potato shells; top with cheese. Bake until cheese is melted, 3 to 5 minutes. Top with sour cream and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
