  "ingredients": [
    "1 (20 ounce) can green jackfruit in brine, rinsed and shredded",
    "2 tablespoons curry powder",
    "2 tablespoons chili powder",
    "1 teaspoon salt, or to taste",
    "1 teaspoon ground cardamom",
    "1 teaspoon dried parsley",
    "0.5 teaspoon ground turmeric",
    "0.5 teaspoon ground cinnamon",
    "2 tablespoons vegetable oil",
    "3 cloves garlic, minced",
    "1 teaspoon ground ginger",
    "0.5 teaspoon ground cumin",
    "1 small onion, chopped",
    "1 cup water",
    "5 tablespoons coconut milk",
    "0.25 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Combine jackfruit, curry powder, chili powder, salt, cardamom, parsley, turmeric, and cinnamon in a bowl. Let rest for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a pan over medium heat. Add garlic, ginger, and cumin; cook and stir until fragrant, about 1 minute. Add onion and cook and stir for 2 minutes. Add seasoned jackfruit, water, and coconut milk; mix well. Reduce heat and simmer for 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn off heat, add cilantro, and mix well. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
