  "ingredients": [
    "1 (15 ounce) can garbanzo beans, drained",
    "0.5 cup canned diced tomatoes with green chile peppers and onions",
    "1 canned roasted red pepper, diced",
    "1 small jalapeno pepper, diced",
    "1 teaspoon sriracha sauce",
    "1 teaspoon garlic powder",
    "1 teaspoon chili powder",
    "0.5 (1 ounce) packet taco seasoning mix"
  ],
  "steps": [
    {
      "text": "Combine garbanzo beans, diced tomatoes, roasted red pepper, jalapeno pepper, sriracha sauce, garlic powder, and chili powder in a saucepan over medium heat. Cook and stir until beans are soft and heated through, about 15 minutes. Drain all but 1 tablespoon liquid from the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir taco seasoning into the bean mixture; cook until flavors combine, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour bean mixture into a food processor; puree to desired consistency. Spoon dip into a serving bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
