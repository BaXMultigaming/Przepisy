  "ingredients": [
    "1 head cauliflower, broken into florets",
    "3 tablespoons butter",
    "1 clove garlic, minced, or to taste",
    "0.5 teaspoon cumin",
    "0.5 teaspoon ground coriander",
    "0.5 teaspoon garam masala",
    "0.5 teaspoon ground turmeric",
    "0.25 teaspoon minced fresh ginger, or to taste",
    "1 pinch cayenne pepper, or more to taste",
    "salt and ground black pepper to taste",
    "1 lime, cut into wedges",
    "0.25 cup chopped fresh cilantro, or to taste"
  ],
  "steps": [
    {
      "text": "Process cauliflower florets in a blender or food processor until broken into small pieces about the size of rice.",
      "section": null,
