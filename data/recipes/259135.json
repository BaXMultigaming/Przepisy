      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a skillet over medium-high heat; add cauliflower rice, garlic, cumin, coriander, garam masala, turmeric, ginger, cayenne pepper, salt, and black pepper. Cook, stirring occasionally, until cauliflower is softened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
