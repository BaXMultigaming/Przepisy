  "ingredients": [
    "1 cup unsalted butter, softened",
    "1 cup white sugar",
    "3 tablespoons packed light brown sugar",
    "1 tablespoon vanilla extract",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1.75 cups all-purpose flour",
    "4 eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x5-inch loaf pan with parchment paper, leaving an overhang on 2 sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, brown sugar, vanilla extract, baking powder, and salt in a large bowl with an electric mixer until fluffy; beat in flour. Beat in eggs, one at a time, scraping the bowl after each addition. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lift cake out of the pan using the overhanging parchment paper. Place on a wire rack; cool completely before slicing, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
