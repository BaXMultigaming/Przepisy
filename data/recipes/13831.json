  "ingredients": [
    "3 pounds apples - peeled, cored and sliced",
    "2 cups all-purpose flour",
    "1.5 cups white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "2 eggs, beaten",
    "1 cup vegetable oil",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8aS4Yi7iNl7pjk1wwGv2GMqCdQQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13831-apple-dumpling-cake-VAT-step-01-20de0d2671d94c91bf4ed78b6819da0f.jpg"
      ],
      "image": "assets/images/13831/step_01.webp"
    },
    {
      "text": "Place sliced apples in baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xryertg5EkyTWKfqNM0OsKqANig=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13831-apple-dumpling-cake-VAT-step-02-635213f9cc9a4115970c2a7d32423e7f.jpg"
      ],
      "image": "assets/images/13831/step_02.webp"
    },
    {
      "text": "In a medium bowl, mix together the flour, sugar, baking powder, and salt. Stir in eggs and oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aWD8yg_FTadtbDsBJ2sHyJod7m4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13831-apple-dumpling-cake-VAT-step-03-d498272bf8c64bcfa0f76bbd70175ee4.jpg"
      ],
      "image": "assets/images/13831/step_03.webp"
    },
    {
      "text": "Pack mixture on top of apples. Sprinkle with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x9OarCNxgx09AbaHfD5l4xkZ65Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13831-apple-dumpling-cake-VAT-step-04-cdd1aedf38ca435f9ebbb65591265bce.jpg"
