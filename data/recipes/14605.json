  "ingredients": [
    "1 tablespoon ground black pepper",
    "1 tablespoon paprika",
    "2 teaspoons chili powder",
    "0.5 teaspoon celery salt",
    "0.5 teaspoon ground cayenne pepper",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon mustard powder",
    "1 (4 pound) rump roast",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "Mix pepper, paprika, chili powder, celery salt, cayenne pepper, garlic powder, and mustard powder together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub seasoning mixture over surface of roast. Place roast into a slow cooker and pour in water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until meat is tender and well done, 8 to 10 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer roast to a serving platter. Skim fat from juices and strain. Serve juice with meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
