  "ingredients": [
    "0.25 cup butter",
    "0.33333334326744 cup onion, chopped",
    "2 tablespoons finely chopped flat-leaf parsley",
    "1.75 pounds tomatoes, sliced",
    "salt to taste",
    "1.25 cups grated Parmesan cheese, divided",
    "9 ounces sour cream",
    "2 eggs"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium-low heat and cook onion and parsley until soft, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a casserole dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread out tomato slices in one layer in the casserole dish and season with salt. Distribute 1/2 of the onion mixture and 1/2 of the Parmesan cheese on top. Layer another row of tomato slices, season with salt, and sprinkle with remaining 1/2 of the onions. Finish with the final layer of tomatoes and season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together sour cream, eggs, and salt and spread over tomatoes. Sprinkle with remaining Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and lightly browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
