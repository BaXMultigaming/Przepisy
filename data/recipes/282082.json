  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup cold butter, cut into pieces",
    "0.5 cup powdered sugar",
    "2 cups white sugar",
    "1 cup flaked coconut",
    "0.25 cup all-purpose flour",
    "4 large eggs",
    "2 medium lemons, zested and juiced",
    "0.25 teaspoon baking powder",
    "2 tablespoons powdered sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, butter, and powdered sugar for crust in a food processor; pulse until fine crumbles form. Press into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake crust in the preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine sugar, coconut, flour, eggs, lemon zest, lemon juice, and baking powder in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove crust from the oven and pour filling over top. Return to the oven and bake until just golden around the edges, 20 to 25 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool, about 30 minutes. Place in the refrigerator until completely chilled, about 2 hours. Dust with powdered sugar and cut into 24 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
