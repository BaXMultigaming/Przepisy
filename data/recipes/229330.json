  "ingredients": [
    "2 pounds ground beef",
    "0.5 onion, chopped",
    "0.75 cup small chunks of bread",
    "2 large eggs, beaten",
    "0.5 cup milk",
    "0.5 cup chopped green bell pepper",
    "1.5 teaspoons salt",
    "0.25 teaspoon sage",
    "0.25 teaspoon ground black pepper",
