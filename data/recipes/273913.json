  "ingredients": [
    "1 cup chocolate-hazelnut spread (such as Nutella®)",
    "0.5 cup peanut butter chips",
    "0.5 cup all-purpose flour",
    "1 egg",
    "2 tablespoons brown sugar"
  ],
  "steps": [
    {
      "text": "Combine chocolate hazelnut-spread, peanut butter chips, flour, egg, and brown sugar in a mixing bowl; beat with an electric mixer until smooth. Place dough in the freezer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1-inch balls and place 2 inches apart on an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the edges begin to firm up, 8 to 10 minutes. Remove from the oven and cool on the baking sheet until the cookies are set, then remove to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
