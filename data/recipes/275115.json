  "ingredients": [
    "cooking spray",
    "1 cup shortening",
    "1 cup white sugar",
    "0.5 cup brown sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "1.5 teaspoons salt",
    "1 teaspoon baking soda",
    "1 (12 ounce) bag semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly spray an 18-inch pizza pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine shortening, white sugar, brown sugar, eggs, and vanilla extract in a large bowl. Beat with an electric mixer until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, salt, and baking soda together. Mix into the shortening mixture. Stir in chocolate chips to finish cookie dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon dough into the center of the prepared pizza pan. Press dough from the center towards the rim of the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are firm and center looks set, 10 to 12 minutes. Let cool before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
