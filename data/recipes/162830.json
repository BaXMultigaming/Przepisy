  "ingredients": [
    "1 cup plain yogurt",
    "1 cup sour cream",
    "1 small cucumber - peeled, seeded, and finely chopped",
    "1 green onion",
    "0.25 cup crumbled feta cheese",
    "1 garlic clove, minced",
    "1 teaspoon white vinegar",
    "0.5 teaspoon oregano",
    "0.5 teaspoon lemon juice",
    "0.25 teaspoon lemon zest",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine yogurt, sour cream, cucumber, green onion, feta cheese, garlic, vinegar, oregano, lemon juice, lemon zest, salt, and black pepper in a bowl; cover and chill before serving, 8 hours to overnight.",
