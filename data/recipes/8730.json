  "ingredients": [
    "0.25 cup butter, melted",
    "0.25 cup lemon juice",
    "2 tablespoons Worcestershire sauce",
    "2 tablespoons soy sauce",
    "2 teaspoons dried oregano",
    "1 teaspoon garlic powder",
    "6 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the melted butter or margarine, lemon juice, Worcestershire sauce, soy sauce, oregano and garlic powder. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in an ungreased 7x11 inch baking dish. Pour the butter/oregano mixture over the chicken. Bake in the preheated oven for 15 minutes. Baste juices over the chicken. Bake for an additional 15 minutes. Transfer the chicken to a serving platter and serve the pan drippings over hot cooked rice, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
