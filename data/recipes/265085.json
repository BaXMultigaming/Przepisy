  "ingredients": [
    "4 cups water",
    "0.5 cinnamon stick",
    "2.25 cups uncooked white rice",
    "4 cups whole milk",
    "4 cups evaporated milk",
    "1.25 cups white sugar",
    "2 pinches ground cinnamon"
  ],
  "steps": [
    {
      "text": "Combine water and cinnamon stick in a saucepan over high heat. Bring to a boil and cook until cinnamon releases its color and flavor, about 5 minutes. Add rice, reduce heat to low, cover, and cook until rice is tender and water is absorbed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually add whole milk to rice, then evaporated milk. Stir in sugar. Cook uncovered until sugar is dissolved and mixture has thickened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve warm or cold. Sprinkle each portion with ground cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
