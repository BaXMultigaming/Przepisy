  "ingredients": [
    "3 cups small pretzel twists",
    "0.25 cup packed brown sugar",
    "0.5 cup butter, melted",
    "0.75 cup butter, cubed",
    "0.75 cup semisweet chocolate chips",
    "0.75 cup packed brown sugar",
    "0.66666668653488 cup white sugar",
    "3 eggs, beaten",
    "3 tablespoons heavy whipping cream",
    "4.5 teaspoons all-purpose flour",
    "1 teaspoon vanilla extract",
    "0.25 cup caramel topping"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pretzel twists and 1/4 cup brown sugar in a food processor; process until finely chopped. Stir in 1/2 cup melted butter. Press mixture over the bottom and sides of an ungreased 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 3/4 cup butter and chocolate chips in a microwave-safe bowl. Heat in the microwave, stirring once, until melted, 1 to 2 minutes. Stir in 3/4 cup brown sugar and white sugar until dissolved. Beat in eggs. Stir in heavy cream, flour, and vanilla extract until filling is smooth. Pour over the crust in the pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center puffs up and looks set, about 50 minutes. Let cool completely, 1 to 2 hours. Drizzle caramel topping on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
