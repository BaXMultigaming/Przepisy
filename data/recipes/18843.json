  "title": "Layered Eggplant Hamburger Casserole",
  "description": "Eggplant goes great with tomato, hamburger and garlic in this easy-to-prepare and well-seasoned recipe.",
  "authors": [
    "Mari"
  ],
  "date_published": "2000-06-28T09:52:48-04:00",
