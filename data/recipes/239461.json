  "ingredients": [
    "1 cup Mott's® Natural Applesauce",
    "1 cup sugar",
    "0.5 cup chunky peanut butter",
    "1 large egg",
    "1 cup flour",
    "1 cup rolled oats",
    "1 cup shredded coconut, lightly toasted",
    "0.5 cup raisins",
    "1 teaspoon cinnamon",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Combine sugar, applesauce, peanut butter and egg in large bowl. Mix until smooth. Stir in remaining ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon dough by rounded tablespoons onto lightly greased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 15 minutes, until lightly browned. Allow to cool slightly before removing cookies to cool completely.",
