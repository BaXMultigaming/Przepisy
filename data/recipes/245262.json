  "ingredients": [
    "8 cups old-fashioned rolled oats",
    "4 cups all-purpose flour",
    "3 cups brown sugar",
    "0.5 cup white sugar",
    "1 tablespoon salt",
    "1 tablespoon ground cinnamon",
    "1.5 teaspoons ground cloves",
    "1.5 teaspoons ground ginger",
    "2 cups vegetable oil",
    "1 cup honey",
    "0.75 cup molasses",
    "4 eggs, beaten",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease two 9x13-inch baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, flour, brown sugar, white sugar, salt, cinnamon, cloves, and ginger in a large bowl. Stir in oil, honey, molasses, and eggs. Mix until well-combined. Pat mixture onto baking sheets using your hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges begin to brown and center no longer looks glossy, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool for about 10 minutes; cut into bars while still warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
