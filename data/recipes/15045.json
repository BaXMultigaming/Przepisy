  "ingredients": [
    "0.5 cup butter",
    "1.5 cups white sugar",
    "2 eggs",
    "1 cup sour cream",
    "1 teaspoon vanilla extract",
    "2.75 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1 cup shortening",
    "0.25 cup milk",
    "2 egg whites",
    "0.25 cup all-purpose flour",
    "2 teaspoons vanilla extract",
    "1 pound confectioners' sugar"
  ],
  "steps": [
    {
      "text": "In a medium bowl, cream together the butter and sugar. Stir in the eggs and vanilla, then the sour cream. Sift together the flour, baking powder, salt and baking soda, stir into the creamed mixture. Cover and chill for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop cookies by heaping teaspoonfuls onto cookie sheets. Bake for 10 to 12 minutes in the preheated oven. Remove from baking sheets to cool on wire racks. Frost the flat side with icing when cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the icing, combine the shortening, milk, egg whites, 1/4 cup of flour, vanilla and confectioners' sugar in a medium bowl. Mix on the high speed of an electric mixer until fluffy. The longer you mix, the fluffier it will be.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
