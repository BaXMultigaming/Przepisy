  "ingredients": [
    "1 serving cooking spray",
    "2 pounds frozen rockfish",
    "2 tablespoons melted butter",
    "1 cup finely chopped pecans",
    "1 cup panko bread crumbs",
    "2 teaspoons seafood seasoning (such as Old Bay®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a rimmed baking sheet with foil or parchment paper, then grease with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place frozen rockfish on the prepared baking sheet and pour melted butter over fish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together pecans, bread crumbs, and seafood seasoning in a medium bowl until well combined. Sprinkle evenly over fish, pressing gently into the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, about 20 minutes. Turn on the oven's broiler. Broil for 1 to 2 minutes, making sure not to burn crust. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
