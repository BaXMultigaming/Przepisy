  "ingredients": [
    "cooking spray",
    "7 large eggs, at room temperature",
    "0.5 cup butter, melted and cooled",
    "2 tablespoons olive oil",
    "2 cups blanched almond flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon xanthan gum",
    "0.5 teaspoon sea salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l1aBI1uw4ZKU8n6Kzc2L0lHt4Fc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/263033-Best-Keto-Bread-065-step1-70f33f3c28aa47ff9e60dc8e0a53a071.jpg"
      ],
      "image": "assets/images/263033/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 8½ × 4½-inch silicone loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a bowl until smooth and creamy, about 3 minutes. Add melted butter and olive oil; mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C-JczAGtz_f3Diu5ii0HDKfaTKw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/263033-Best-Keto-Bread-066-step2-5714a9a9943b4ee28688c3fc60e68b80.jpg"
      ],
      "image": "assets/images/263033/step_03.webp"
    },
    {
      "text": "Combine almond flour, baking powder, xanthan gum, and salt in a separate bowl; mix well. Add gradually to the egg mixture, mixing well until a thick batter is formed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/28d5otqE5OnW460ORu6j2O9AfXY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/263033-Best-Keto-Bread-068-step4-5338da32fdd44f529364af8c41383b29.jpg"
      ],
      "image": "assets/images/263033/step_04.webp"
    },
    {
      "text": "Pour batter into the prepared pan and smooth the top with a spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S3qG7-gpYhSWLibBEHDqgjqkD6U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/263033-Best-Keto-Bread-069-step5-0f31127a998b4c2eaa34591e74c1b8bc.jpg"
      ],
      "image": "assets/images/263033/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1dJ8OySCoVCBJGQ54DrBj_G1628=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/263033-Best-Keto-Bread-074-4x3-9a1f3c531b12420cb9472daed8973d58.jpg"
