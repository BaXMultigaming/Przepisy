  "ingredients": [
    "0.5 cup chopped dill pickles",
    "2 stalks celery, chopped",
    "3 tablespoons chopped onion",
    "2 tablespoons dill pickle juice",
    "1 (15 ounce) can chickpeas (garbanzo beans), drained and rinsed",
    "0.5 cup rolled oats",
    "3 tablespoons mayonnaise",
