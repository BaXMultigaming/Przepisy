  "ingredients": [
    "1 pound sliced bacon",
    "1 (16 ounce) package elbow macaroni",
    "1 cup mayonnaise",
    "0.5 cup sour cream",
    "0.25 cup white sugar",
    "0.25 cup cider vinegar",
    "2 tablespoons prepared yellow mustard",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "4 hard-cooked eggs, chopped",
    "3 tomatoes, seeded and chopped",
    "1 large cucumber, peeled and chopped",
    "0.5 cup chopped celery",
    "0.5 cup sliced green olives"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until crisp and evenly browned, about 10 minutes. Drain on paper towels. Crumble; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes. Drain and rinse with cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, sour cream, sugar, vinegar, mustard, salt, and black pepper together in a large bowl until sugar dissolves. Add bacon, macaroni, eggs, tomato, cucumber, and celery; gently fold until evenly coated in dressing. Sprinkle with sliced olives; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
