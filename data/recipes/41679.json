  "title": "Banana Cranberry Bread",
  "description": "Cranberry sauce and mashed bananas blend with walnuts, ground cinnamon, nutmeg, and vanilla in this easy, moist banana cranberry quick bread recipe.",
  "authors": [
    "LINDA VOLLRATH"
  ],
  "date_published": "2020-06-18T23:08:16-04:00",
