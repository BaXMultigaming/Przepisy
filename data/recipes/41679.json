  "ingredients": [
    "2.5 cups white sugar",
    "1 cup shortening",
    "3 eggs",
    "3 mashed bananas",
    "1 cup cranberry sauce",
    "0.5 cup milk",
    "1 teaspoon vanilla extract",
    "4 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "1.5 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and shortening together in a large bowl until light and fluffy. Beat in eggs, one at a time, then beat in bananas, cranberry sauce, milk, and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, baking powder, cinnamon, and nutmeg together in a bowl; gradually stir into banana mixture. Fold in walnuts. Pour into the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 50 to 60 minutes. Cool in pans for 10 minutes, then turn out onto a wire rack, and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
