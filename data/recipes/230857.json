        "https://www.allrecipes.com/thmb/fUKbVEBFhavGXWc9crilUxJexV8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230857-easy-tuna-patties-ddmfs-step-04-3x4-1274-469b0d15bcc642b1aa762c73a5f7aff2.jpg"
