  "ingredients": [
    "2 eggs",
    "2 teaspoons lemon juice",
    "10 tablespoons Italian-seasoned bread crumbs",
    "3 tablespoons grated Parmesan cheese",
    "3 (5 ounce) cans tuna, drained",
    "3 tablespoons diced onion",
    "1 pinch ground black pepper",
    "3 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HA9yv3skl97Wjvoc1mK8KdfWXb8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230857-easy-tuna-patties-ddmfs-ingredients-3x4-1267-d5ca24a3b204449b80b6487499ef0b9e.jpg"
      ],
      "image": "assets/images/230857/step_01.webp"
    },
    {
      "text": "Beat eggs and lemon juice in a bowl; stir in bread crumbs and Parmesan cheese to make a paste. Fold in tuna and onion until well combined; season with black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OrSg-W-mA5Qu-gZr0DugNTIob1Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230857-easy-tuna-patties-ddmfs-step-02-3x4-1270-539bf8382cb74c47826f5dc645695ea6.jpg"
      ],
      "image": "assets/images/230857/step_02.webp"
    },
    {
      "text": "Use your hands to shape tuna mixture into 8 (1-inch-thick) patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lThxFyVFxBnx6fSkeTPgx5TTaj8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230857-easy-tuna-patties-ddmfs-step-03-3x4-1272-672a731546ab41c69897945a8bfcf80f.jpg"
      ],
      "image": "assets/images/230857/step_03.webp"
    },
    {
      "text": "Heat vegetable oil in a skillet over medium heat. Fry patties in the hot oil until golden brown, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
