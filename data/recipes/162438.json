  "ingredients": [
    "0.5 cup soy sauce",
    "0.5 cup pineapple juice",
    "0.25 cup vegetable oil",
    "1 tablespoon packed brown sugar",
    "2 teaspoons ground ginger",
    "1 teaspoon garlic salt",
    "1 teaspoon dry mustard powder",
    "0.25 teaspoon black pepper",
    "6 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Combine soy sauce, pineapple juice, oil, brown sugar, ginger, garlic salt, mustard powder, and black pepper in a medium saucepan; bring to a boil, stirring to dissolve sugar, about 5 minutes. Set aside to cool, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in a large resealable bag; add soy sauce marinade. Squeeze out excess air, seal the bag, and toss until chicken coated with marinade. Marinate in the refrigerator for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a grill for medium-low heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from marinade and shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook chicken on the preheated grill until the juices run clear, turning occasionally to prevent burning, 20 to 25 minutes. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
