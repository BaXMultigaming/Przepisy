  "ingredients": [
    "1 (16 ounce) package chicken drumettes",
    "2 (10.75 ounce) cans condensed tomato soup",
    "0.5 cup chopped fresh cilantro",
    "1 tablespoon onion powder",
    "1 tablespoon ground black pepper",
    "1 tablespoon garlic salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place drummettes in a 9x13 inch baking dish. In a medium bowl, combine the soup, cilantro, onion powder, pepper and garlic salt. Mix well, and pour mixture over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (165 degrees C) for 1 hour, or until chicken is cooked through and juices run clear.",
      "section": null,
