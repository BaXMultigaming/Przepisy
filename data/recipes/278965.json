  "ingredients": [
    "1 pound cod fillets",
    "1 tablespoon olive oil",
    "1 lime, zested and juiced, divided",
    "1 teaspoon ground cumin",
    "0.5 teaspoon ground coriander",
    "0.5 teaspoon smoked paprika",
    "0.25 teaspoon cayenne pepper",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 cup sour cream",
    "1 clove garlic, minced",
    "1 pinch salt",
    "1 small head red cabbage, shredded",
    "0.5 teaspoon white vinegar",
    "6 (7 inch) flour tortillas",
    "1 tomato, diced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cod fillets in a casserole dish and drizzle with olive oil and 1 tablespoon lime juice. Season with cumin, coriander, smoked paprika, cayenne, 1/2 teaspoon salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, about 20 minutes. Remove from the oven and break apart the fish in the baking dish with 2 forks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine sour cream, garlic, lime zest, 1/4 teaspoon lime juice, and a pinch of salt for crema in a bowl. Combine cabbage, 1/4 teaspoon lime juice, and vinegar for cabbage slaw in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm tortillas in the microwave on default mode with a dampened paper towel draped over, 30 to 45 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Assemble tacos by layering each tortilla with cod, cabbage slaw, crema, and tomato. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
