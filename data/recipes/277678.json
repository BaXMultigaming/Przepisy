  "ingredients": [
    "1 pound ground pork",
    "2 tablespoons pure maple syrup",
    "1 teaspoon salt",
    "1 teaspoon dried sage",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon red pepper flakes",
    "0.25 teaspoon ground marjoram",
    "0.25 teaspoon ground coriander",
    "1 pinch ground cloves",
    "1 tablespoon olive oil"
  ],
  "steps": [
    {
      "text": "Combine pork, maple syrup, salt, sage, onion powder, black pepper, red pepper flakes, marjoram, coriander, and cloves in a bowl; mix well. Form into 10 small patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat. Add patties, in batches; cook until no longer pink and juices run clear, 3 to 4 minutes per side. An instant-read thermometer inserted into centers should read at least 160 degrees F (71 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
