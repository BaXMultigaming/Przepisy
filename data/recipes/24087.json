  "title": "Restaurant-Style Buffalo Chicken Wings",
  "description": "Try this hot wings recipe for Buffalo chicken wings that taste just like those served at a popular restaurant chain. They're so easy to make at home with basic ingredients.",
  "authors": [
    "Kelly"
  ],
  "date_published": "2000-05-29T11:25:36-04:00",
