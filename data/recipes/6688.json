  "ingredients": [
    "2 large eggs",
    "1 cup milk",
    "3 tablespoons butter, melted",
    "2 cups sifted all-purpose flour",
    "4 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground cinnamon",
    "0.75 cup white sugar",
    "0.25 cup chopped pecans",
    "0.25 cup chopped blanched almonds",
    "0.25 cup chopped candied citron",
    "0.25 cup currants",
    "2 tablespoons chopped candied cherries",
    "2 tablespoons chopped candied lemon peel"
  ],
  "steps": [
    {
      "text": "Whisk eggs in a medium bowl. Mix in milk and melted butter until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, salt, and cinnamon into a large mixing bowl. Stir in sugar, pecans, almonds, citron, currants, cherries, and lemon peel until well combined. Add wet ingredients and stir just enough to blend. Pour batter into a generously greased 8x4-inch loaf pan. Let stand for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the center of the preheated oven until a toothpick inserted into the center comes out clean, 60 to 70 minutes. Remove from the oven and turn out onto a wire rack; let cool for 3 hours before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
