  "ingredients": [
    "1 cup soy sauce",
    "0.75 cup water",
    "0.5 cup brown sugar",
    "1 tablespoon honey",
    "1 dash lemon juice",
    "4 pork chops",
    "1 cup ketchup",
    "0.5 cup cocktail sauce",
    "0.25 cup brown sugar",
    "2 tablespoons water",
    "1.5 teaspoons ground dry mustard"
  ],
  "steps": [
    {
      "text": "In a saucepan over medium heat, mix the soy sauce, water, brown sugar, honey, and lemon juice. Bring to a boil, remove from heat, and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the pork chops in a large, resealable plastic bag. Pour the soy sauce mixture into the bag, seal, and marinate in the refrigerator for 3 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain the pork chops, and discard remaining marinade. Arrange the pork chops in a baking dish, cover, and bake 30 minutes in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, blend the ketchup, cocktail sauce, brown sugar, water, and mustard. Pour over the pork chops, and continue baking 30 minutes, to an internal temperature of 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
