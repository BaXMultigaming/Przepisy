  "ingredients": [
    "2.5 cups white sugar",
    "0.66666668653488 cup eggnog",
    "0.5 cup butter",
    "8 ounces vanilla candy melts, cut into pieces",
    "1 (7 ounce) jar marshmallow creme",
    "1 teaspoon rum extract",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Line a 9-inch square baking pan with aluminum foil, leaving an overhang on both sides. Grease aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, eggnog, and butter in a large saucepan over medium heat; bring to a boil, stirring constantly, about 5 minutes. Off heat, add vanilla candy and marshmallow creme; stir until smooth. Stir in rum extract. Pour fudge mixture into the prepared baking pan. Lightly sprinkle nutmeg on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool fudge to room temperature, about 30 minutes. Score fudge into 36 pieces. Refrigerate until firm, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lift up aluminum foil ends to remove fudge from the pan. Cut through scored lines with a large knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
