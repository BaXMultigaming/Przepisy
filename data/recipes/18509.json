  "ingredients": [
    "9 potatoes, peeled and cubed",
    "1 cup sour cream",
    "6 ounces cream cheese",
    "2 tablespoons butter",
    "2 teaspoons onion powder",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to a boil. Add potatoes; cook until tender yet still firm, about 15 minutes. Transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash potatoes until smooth. Stir in sour cream, cream cheese, butter, onion powder, salt, and pepper. Cover; refrigerate 8 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a medium-sized baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer potato mixture to the prepared baking dish. Bake in the preheated oven about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
