  "ingredients": [
    "cooking spray",
    "4 very ripe bananas",
    "1 (30 ounce) can pumpkin pie mix",
    "3 cups all-purpose flour",
    "1 cup brown sugar",
    "0.75 cup butter, softened",
    "3 eggs, beaten",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash bananas into a paste in a large bowl. Add pumpkin pie mix, flour, brown sugar, butter, eggs, baking soda, and salt; beat with an electric mixer until creamy. Pour into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour and 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
