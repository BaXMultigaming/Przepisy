  "ingredients": [
    "2 large eggs, beaten",
    "1 cup mashed bananas",
    "0.5 cup vegetable oil",
    "0.33333334326744 cup buttermilk",
    "1.75 cups all-purpose flour",
    "1.5 cups white sugar",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup chopped pecans"
  ],
  "steps": [
