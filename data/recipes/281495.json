  "ingredients": [
    "1.5 teaspoons kosher salt",
    "1.5 teaspoons light brown sugar",
    "1.5 teaspoons ground black pepper",
    "1 teaspoon paprika",
    "0.5 teaspoon ground mustard",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.25 teaspoon oregano",
    "6 bone-in center-cut pork chops (about 1-inch thick)"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the smoker to 250 degrees F (120 degrees C). Add wood chips according to the manufacturer's directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vmP98U-2NoTOf7m6mc6KN3yRCKk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281495-smoked-pork-chops-ddmfs-step1-3x4-11197-a544b5fa9978410ca52e2c185fc9969f.jpg"
      ],
      "image": "assets/images/281495/step_01.webp"
    },
    {
      "text": "Combine salt, brown sugar, pepper, paprika, ground mustard, garlic powder, onion powder, and oregano in a small bowl. Sprinkle over both sides pork chops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TLTnvQRkL75fCrulLzxI8FHNmEA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281495-smoked-pork-chops-ddmfs-step3-3x4-11201-f0e13192225e45e4a3183e7ea9e3abdc.jpg"
