  "ingredients": [
    "0.5 cup lemon juice",
    "0.5 cup olive oil",
    "2 1 1/4-inch-thick tuna steaks",
    "0.25 cup spicy brown mustard",
    "1 teaspoon mustard powder",
    "3 tablespoons white sugar",
    "2 tablespoons white wine vinegar",
    "0.33333334326744 cup olive oil",
    "3 tablespoons dried dill"
  ],
  "steps": [
    {
      "text": "Combine lemon juice and 1/2 cup olive oil in a large resealable plastic bag; seal the bag and shake. Add tuna steaks; seal the bag and place into the refrigerator to marinate while the grill preheats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together brown mustard, mustard powder, sugar, vinegar, and 1/3 cup olive oil in a medium bowl; stir in dill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tuna steaks from marinade and place on the preheated grill; discard marinade. Cook steaks until fish flakes easily with a fork, about 6 minutes per side. Drizzle steaks with mustard-dill sauce to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
