  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "0.5 teaspoon baking soda",
    "1 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.75 teaspoon ground cinnamon",
    "0.75 cup shortening",
    "1 egg, beaten",
    "1 cup mashed ripe bananas",
    "1.75 cups rolled oats",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the flour, sugar, baking soda, salt, cinnamon and nutmeg. Cut in shortening until almost no lumps remain. Stir in the egg and bananas; mix well. Finally, stir in the oats and walnuts. Drop by teaspoonfuls 2 inches apart onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes in the preheated oven, or until edges are browned. Remove from pans immediately to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
