  "title": "Rhubarb Cookies",
  "description": "These delicious rhubarb cookies made with oats have a soft and chewy texture; chunks of rhubarb and crystallized ginger add a sweet-tangy flavor.",
  "authors": [
    "Liv Dansky"
  ],
  "date_published": "2022-09-14T13:41:57-04:00",
