  "ingredients": [
    "4 eggs, lightly beaten",
    "1.3333333730698 cups milk",
    "1 cup all-purpose flour",
    "2 tablespoons butter, melted",
    "2 tablespoons white sugar",
    "0.5 teaspoon salt"
  ],
  "steps": [
