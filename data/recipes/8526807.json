  "title": "Ground Beef Stroganoff Noodles",
  "description": "Here&#39;s Chef John&#39;s shortcut version of the classic comfort food: a one-pan meal featuring flavorful ground beef, mushrooms, and noodles.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2023-01-10T09:00:00-05:00",
