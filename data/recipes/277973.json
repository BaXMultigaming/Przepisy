  "ingredients": [
    "1 small banana",
    "1 small apple - peeled, cored, and cut into chunks",
    "1 small pear - peeled, cored, and cut into chunks",
    "3 cubes ice",
    "0.5 cup plain skyr (Icelandic yogurt)",
    "0.25 cup grated fresh coconut, divided",
    "1 teaspoon blue spirulina powder",
    "0.5 white dragon fruit"
  ],
  "steps": [
    {
      "text": "Combine the banana, apple, and pear in an electric blender. Add ice cubes, skyr, all but one big spoonful of coconut, and spirulina.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove 3 or 4 balls of dragon fruit using a fruit baller, then add the remaining dragon fruit to the blender. Blend until smooth. Pour into a bowl. Top with reserved dragon fruit balls and remaining coconut.",
