  "title": "Zucchini Nachos",
  "description": "These low-carb nachos use zucchini slices in place of tortilla chips and ground chicken instead of beef as a healthier alternative to traditional nachos.",
  "authors": [
    "France Cevallos"
  ],
  "date_published": "2018-09-20T23:41:21-04:00",
