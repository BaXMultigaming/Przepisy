  "ingredients": [
    "2.5 cups white sugar",
    "2 cups persimmon pulp",
    "2 large eggs, beaten",
    "0.5 teaspoon baking soda",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon vanilla extract",
    "1 pinch salt",
    "2.5 cups milk",
    "4 tablespoons melted butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/52nshUf1YIPGNIOqFg9M9KK7SBg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-13715-persimmon-pudding-step-01-650b7d65f65843cfa4ffc20915c4db55.jpg"
      ],
      "image": "assets/images/13715/step_01.webp"
    },
    {
      "text": "Combine sugar, persimmon pulp, eggs, and baking soda in a mixing bowl. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wMlPZzPgEiYKv0Y8QvjMRUxyCio=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-13715-persimmon-pudding-step-02-ecd23fc8750d423cb4056c26d00c373a.jpg"
      ],
      "image": "assets/images/13715/step_02.webp"
    },
    {
      "text": "Add flour, baking powder, cinnamon, vanilla, and salt. Pour in milk and melted butter. Stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aoL9TL7R6XYeZK8gHZ2nZO14O6c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-13715-persimmon-pudding-step-03-5c61dcd607534bd9a50b891e870391bd.jpg"
      ],
      "image": "assets/images/13715/step_03.webp"
    },
    {
      "text": "Pour into the baking pan and bake in the preheated oven for 55 minutes. The pudding will rise but will fall when removed from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/62Pz7VXjEXZyWvW_USVZlRLMn1Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-13715-persimmon-pudding-step-04-e3574e36692d44b1aec264689313c2c8.jpg"
      ],
      "image": "assets/images/13715/step_04.webp"
    },
    {
      "text": "Serve with whipped cream or caramel sauce, if desired. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kIpua64BHHhwniaq1dqh9o6NFIc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-13715-persimmon-pudding-step-05-3cdffe84279241a4827f74d3be4ae439.jpg"
      ],
      "image": "assets/images/13715/step_05.webp"
    }
  ],
