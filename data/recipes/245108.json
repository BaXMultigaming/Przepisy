  "ingredients": [
    "3 cups Swanson® Chicken Broth",
    "1 cup farro, rinsed",
    "1 cup red cherry tomatoes, halved",
    "1 cup shredded mozzarella cheese",
    "0.5 cup basil chiffonade (thinly sliced fresh basil leaves)",
    "0.5 cup slivered almonds",
    "0.25 cup thinly sliced red onion",
    "3 tablespoons balsamic vinaigrette salad dressing"
  ],
  "steps": [
    {
      "text": "Combine chicken broth and farro in a saucepan; bring to a boil. Reduce heat to medium-low and simmer until tender, about 30 minutes. Drain; cool completely.",
