  "ingredients": [
    "4 cups all-purpose flour, plus more as needed",
    "1.5 cups water",
    "1 cup salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, water, and salt in a large bowl; mix well. Knead for 10 minutes until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lFkMOr8EnslFIWRmB0yGB4qrfMw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9528-ornament-dough-step-02-b6439e48a5e34a08b80bc64139b04d1e.jpg"
      ],
      "image": "assets/images/9528/step_02.webp"
    },
    {
      "text": "Transfer dough to a floured work surface; continue kneading until soft and pliable, adding more flour as needed if sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RPYXTF7Va-oxA5AbFLAHZs04IWk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9528-ornament-dough-step-03-02-437f7351c0e04b348535a5a6fdc987df.jpg"
      ],
      "image": "assets/images/9528/step_03.webp"
    },
    {
      "text": "Roll out dough to ⅛-inch thickness; cut into desired shapes with cookie cutters.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Tfb6rHjTVH8wxCjAhR7y5z9HM7E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9528-ornament-dough-step-05-ce56354e07704970b817397796fd326a.jpg"
      ],
      "image": "assets/images/9528/step_04.webp"
    },
    {
      "text": "Place shapes on ungreased baking sheets. Use a toothpick or skewer to make a small hole in each ornament for hanging.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7KfsmEhvaiLjISKA0ss8CNxCytI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9528-ornament-dough-step-06-0d81e69f6d39466d8da9402f71f57f64.jpg"
      ],
      "image": "assets/images/9528/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until firm and dry, about 30 to 60 minutes depending on size and thickness. Cool completely on a wire rack before decorating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
