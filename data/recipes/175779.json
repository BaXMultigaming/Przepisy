  "ingredients": [
    "4 eggs",
    "1 pound shredded Cheddar cheese",
    "1 teaspoon minced onion",
    "2 jalapeno peppers, seeded and chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the eggs into a food processor, and process until light and frothy. Add Cheddar cheese, onion, and jalapeno peppers, and process until smooth. Pour into an ungreased 8x8 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, 25 to 30 minutes. Cool for 5 minutes; cut into squares to serve.",
      "section": null,
