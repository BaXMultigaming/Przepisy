  "ingredients": [
    "1.5 cups miniature marshmallows",
    "1 (7 ounce) bar milk chocolate candy",
    "0.5 cup milk",
    "2 cups heavy whipping cream",
    "1 (9 inch) pie shell, baked"
  ],
  "steps": [
    {
      "text": "Heat marshmallows, bar chocolate, and milk in a saucepan over low heat until marshmallows and chocolate are melted, stirring constantly. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat heavy cream in a large bowl until stiff peaks form. Gently fold cooled chocolate mixture into whipped cream until well combined. Pour into pie shell. Refrigerate until set, about 3 hours.",
