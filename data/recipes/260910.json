  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup dark brown sugar",
    "1 teaspoon vanilla extract",
    "2 cups miniature marshmallows",
    "0.5 cup finely chopped peanuts",
    "0.5 cup miniature semisweet chocolate chips",
    "5 apples, cored and chopped"
  ],
  "steps": [
    {
      "text": "Blend cream cheese, brown sugar, and vanilla extract together in a large bowl until smooth. Mix in marshmallows, peanuts, and chocolate chips. Add chopped apples and toss until coated. Cover with plastic wrap and refrigerate until marshmallows have softened, at least 2 hours.",
