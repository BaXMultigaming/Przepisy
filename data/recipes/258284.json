  "ingredients": [
    "1 small head green cabbage, cored and thinly sliced",
    "1 (15 ounce) can black beans, rinsed and drained",
    "2 cups frozen corn, thawed",
    "2 cups grated carrots",
    "2 bell peppers, diced",
    "1 cup chopped cilantro",
    "1.5 cups sour cream",
    "1.5 cups chopped fresh cilantro",
    "3 green onions, green parts only, chopped",
    "2 limes, zested and juiced",
    "1 clove garlic",
    "0.5 teaspoon kosher salt",
    "1 pinch cayenne pepper"
  ],
  "steps": [
    {
      "text": "Combine cabbage, black beans, corn, carrots, bell peppers, and 1 cup cilantro in a large bowl. Toss lightly until mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sour cream, 1 1/2 cups cilantro, green onions, lime juice and zest, garlic, salt, and cayenne in the bowl of a food processor. Pulse on and off 5 or 6 times to completely blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing over cabbage mixture and toss to coat evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
