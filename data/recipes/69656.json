  "ingredients": [
    "6 tablespoons unsalted butter",
    "1 cup self-rising flour",
    "1.75 cups white sugar, divided",
    "1.5 tablespoons unsweetened cocoa powder",
    "0.5 cup milk",
    "1 teaspoon vanilla extract",
    "0.25 cup unsweetened cocoa powder",
    "1.5 cups boiling water"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Place butter into an 8-inch square baking dish and set in the oven to melt while it preheats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/54ZQdcysjLqw6LOyNODQZt0OHjg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3231-Chocolate-Cobbler-DDMFS-Step-01-2929-2c4d24431f2c4c72acfea3b03e2b7d7a.jpg"
      ],
      "image": "assets/images/69656/step_01.webp"
    },
    {
      "text": "Sift flour, 3/4 cup sugar, and 1 ½ tablespoons cocoa together into a medium bowl. Stir in milk and vanilla until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lFJFx3eMo81kcWTJ-dP1kNaD5YI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3231-Chocolate-Cobbler-DDMFS-Step-02-2930-3ceb13d0201c4533ac0ffab402a3c19f.jpg"
      ],
      "image": "assets/images/69656/step_02.webp"
    },
    {
      "text": "Stir remaining 1 cup sugar and 1/4 cup cocoa powder together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k2Ac5xP9-D9JxZWhm9SuAwhvOv0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3231-Chocolate-Cobbler-DDMFS-Step-03-2932-a1149290bad34632a90b6cf66c4ba751.jpg"
      ],
      "image": "assets/images/69656/step_03.webp"
    },
    {
      "text": "Remove the baking dish from the oven. Pour flour-sugar mixture over melted butter, then sprinkle sugar-cocoa mixture over top. Slowly pour boiling water over everything.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9cosrBCDZiDA7YPrqW-pymsLYfY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3231-Chocolate-Cobbler-DDMFS-Step-04-2934-7ad94fa2b67947769c0ca92313136d63.jpg"
      ],
      "image": "assets/images/69656/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until set, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q85WASqVVRgtKVq3r0ttUaQ_vgo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3231-Chocolate-Cobbler-DDMFS-Step-05-2965-cc12a1fd71fa48c8996835e5368ab684.jpg"
