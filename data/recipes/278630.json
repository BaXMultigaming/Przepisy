  "ingredients": [
    "1 (28 ounce) can diced tomatoes, undrained",
    "2 boneless, skinless chicken breasts, cut into 1-inch pieces",
    "2 large bell peppers, coarsely chopped",
    "1 cup uncooked long-grain white rice",
    "1 cup water",
    "1 small onion, chopped",
    "1 (1 ounce) package taco seasoning mix",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Combine tomatoes, chicken, bell peppers, rice, water, onion, taco seasoning, salt, pepper, and cayenne in a slow cooker; stir to combine. Cook on Low for 6 to 8 hours, or on High for 3 to 4 hours.",
