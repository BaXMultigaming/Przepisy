  "ingredients": [
    "nonstick cooking spray",
    "2 (10 ounce) packages frozen French-cut green beans, thawed",
    "2 tablespoons light butter",
    "0.33333334326744 cup onion, chopped",
    "2 tablespoons all-purpose flour",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 cup light sour cream",
    "1 cup shredded reduced-fat Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Spray a shallow 1 1/2-quart casserole dish with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beans in a large pot and halfway cover with salted water; bring to a boil. Cook until tender, 4 to 6 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Add onion and cook until tender, 5 to 7 minutes. Blend in flour, salt, and pepper. Stir in sour cream, stirring constantly, cooking until smooth and thickened. Mix in cooked beans, then pour into the prepared casserole. Cover and refrigerate until ready to bake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove casserole from the refrigerator and sprinkle Cheddar cheese over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly, 15 to 20 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
