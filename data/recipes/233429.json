  "ingredients": [
    "6 tablespoons flour",
    "1/4 bup brown sugar",
    "2 tablespoons butter",
    "1 cup white sugar",
    "0.5 cup margarine, softened",
    "1 egg",
    "1.5 teaspoons vanilla extract",
    "1.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup grated zucchini",
    "1 cup cranberries",
    "0.5 cup walnut pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 12-cup muffin tin with liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and brown sugar together in a medium bowl. Cut in butter until mixture forms coarse crumbs. Set topping aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar and butter in a large bowl with an electric mixer until light and fluffy. Beat in egg and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, baking soda, and salt together in a separate bowl; gradually beat into butter mixture. Fold in zucchini, cranberries, and walnuts. Spoon batter into the prepared muffin cups, filling almost to top. Sprinkle topping over each muffin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
