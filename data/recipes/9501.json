  "ingredients": [
    "6 cups apple cider",
    "0.25 cup real maple syrup",
    "2 cinnamon sticks",
    "6 whole cloves",
    "6 whole allspice berries",
    "1 orange peel, cut into strips",
    "1 lemon peel, cut into strips"
  ],
  "steps": [
    {
      "text": "Pour apple cider and maple syrup into a large stainless steel saucepan.",
