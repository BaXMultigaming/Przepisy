  "ingredients": [
    "nonstick cooking spray",
    "8 cups halved fresh strawberries",
    "0.75 cup white sugar",
    "5 teaspoons cornstarch",
    "2 teaspoons freshly grated lemon zest",
    "1 cup all-purpose flour",
    "2 cups old-fashioned oats",
    "0.75 cup dark brown sugar",
    "1 tablespoon ground cinnamon",
    "1 teaspoon kosher salt",
    "1 cup cold unsalted butter, cubed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place strawberries, white sugar, cornstarch, and lemon zest in a large bowl; stir to combine. Let stand for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RVMYveifAd8OFWvMLm3jB_BTeYk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8448339-strawberry-crumble-mfs-step-1-30458360c59a4075b985dd7fb6f0bd4a.jpg"
      ],
      "image": "assets/images/8448339/step_02.webp"
    },
    {
      "text": "Combine flour, oats, brown sugar, cinnamon, and salt in another large bowl. Stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nVnmyEMTZL9RQV8XiZsB6TmnNok=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8448339-strawberry-crumble-mfs-step-2-8da33a26c4a945fe876357cc92eba676.jpg"
      ],
      "image": "assets/images/8448339/step_03.webp"
    },
    {
      "text": "Cut cold butter pieces into flour mixture with a pastry blender until mixture is crumbly and butter is about pea-sized.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y9k7BMRqRy8_8mQLH153ffIyvNk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8448339-strawberry-crumble-mfs-step-3-376d3a9c712d4c2a88bedac6b18ec62d.jpg"
      ],
      "image": "assets/images/8448339/step_04.webp"
    },
    {
      "text": "Evenly spoon strawberry mixture into the prepared baking dish. Sprinkle oat mixture on top of the strawberries, making an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lT5BnivXqBZizSM_mKROgSsCStY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8448339-strawberry-crumble-mfs-step-4-f3b5e18147bf4e489723e073f543099a.jpg"
      ],
      "image": "assets/images/8448339/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until the strawberry liquid is bubbling and the surface has browned, 35 to 40 minutes. Remove from oven and allow to cool for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AnXCK0N77PVJQhpFu-Hnksk3q78=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8448339-strawberry-crumble-mfs-beauty-2x3-80c3852c91a6494b8e24225f58bddfe0.jpg"
      ],
      "image": "assets/images/8448339/step_06.webp"
    }
