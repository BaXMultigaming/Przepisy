  "ingredients": [
    "2 cups bite-size wheat square cereal (such as Wheat Chex®)",
    "2 cups bite-size corn square cereal (such as Corn Chex®)",
    "2 cups bite-size rice square cereal (such as Rice Chex®)",
    "2 cups toasted oat cereal rings (such as Cheerios®)",
    "2 cups cheese-flavored crackers (such as Cheez-It®)",
    "2 cups pretzels",
    "2 cups mixed nuts",
    "1 cup butter",
    "2.5 teaspoons garlic powder",
    "3 tablespoons Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iqJiT9YPKeeUgBSP2bKxWl3cYmg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-162641-grandma-jensens-nuts-and-bolts-step-01-27b3baa17ff249558b371af6c427ad54.jpg"
      ],
      "image": "assets/images/162641/step_01.webp"
    },
    {
      "text": "Preheat an oven to 225 degrees F (110 degrees C). Combine the wheat cereal, corn cereal, rice cereal, oat cereal, cheese-flavored crackers, pretzels, and mixed nuts in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HoqpimbdxdQKwHu0geaFBmQvwyQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-162641-grandma-jensens-nuts-and-bolts-step-02-2deac7f776dd42dd8634a427a337d8bb.jpg"
      ],
      "image": "assets/images/162641/step_02.webp"
    },
    {
      "text": "Melt the butter in a saucepan over medium heat. Whisk in the garlic powder and Worcestershire sauce until evenly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FX2xanCSyRu3mVhHTrqTgorjbu0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-162641-grandma-jensens-nuts-and-bolts-step-03-fc1f1bf59a994eb184b9e32c8f367986.jpg"
      ],
      "image": "assets/images/162641/step_03.webp"
    },
    {
      "text": "Pour over the cereal mixture, and gently stir until the cereal is evenly coated with the seasoned butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j_MN3PtmAMNLtlCZzOkTZPReZyc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-162641-grandma-jensens-nuts-and-bolts-step-04-A-57fd057afd0c47d098400489515d2573.jpg"
      ],
      "image": "assets/images/162641/step_04.webp"
    },
    {
      "text": "Spread the cereal mixture onto baking sheets, and bake in the preheated oven for 1 hour, stirring every 15 minutes. Allow to cool to room temperature before storing in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LQAuGZ9dAMCjIluUh19LhsV_qos=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-162641-grandma-jensens-nuts-and-bolts-step-05-363cc85718f243f09d19169bb950c8c6.jpg"
      ],
