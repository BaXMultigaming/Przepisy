  "steps": [
    {
      "text": "Combine blueberries, pineapple chunks with juice, and 1 1/2 teaspoons flour in a saucepan over medium heat; cook, stirring frequently, until mixture thickens, about 5 minutes. Spread mixture into an 8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup flour, oats, brown sugar, cinnamon, and sea salt together in a bowl; mix in butter until topping is crumbly. Sprinkle topping over blueberry mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is lightly browned, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
