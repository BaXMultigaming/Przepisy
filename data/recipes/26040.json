  "ingredients": [
    "1.5 cups self-rising flour",
    "1.5 cups white sugar",
    "1 cup milk",
    "0.66670000553131 cup vegetable oil",
    "3 eggs",
    "2 tablespoons creamy peanut butter",
    "1 tablespoon vanilla extract",
    "1 cup crunchy peanut butter",
    "1 (16 ounce) package confectioners' sugar",
    "1 teaspoon vanilla extract",
    "2 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour an 8 inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the flour and sugar. Make a well in the center and pour in the milk, oil, eggs, 2 tablespoons peanut butter and vanilla. Mix well and pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 35 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the frosting: In a large bowl, combine 1 cup peanut butter and confectioners' sugar. Beat in vanilla, then milk to desired consistency. Spread on cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
