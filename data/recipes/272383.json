  "ingredients": [
    "1 large egg",
    "2 tablespoons white sugar",
    "1 cup sourdough starter",
    "1 cup all-purpose flour",
    "1 cup buttermilk",
    "1.5 teaspoons baking soda",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Add egg, sugar, sourdough starter, flour, and buttermilk to a large bowl in the order listed. Mix thoroughly before adding baking soda; batter will be light and bubbly. Do not mix again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly greased griddle over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter by large spoonfuls onto the preheated griddle; cook until bubbles appear and the edges are slightly dry, 3 to 4 minutes. Flip and cook until pancakes sound hollow when tapped with a spatula, 2 to 3 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
