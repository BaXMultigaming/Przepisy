  "ingredients": [
    "2.25 cups heavy cream",
    "1 cup milk",
    "0.75 cup white sugar",
    "0.25 teaspoon salt",
    "0.5 cup raspberry preserves",
    "0.25 cup fresh raspberries",
    "2 tablespoons grated lemon zest"
  ],
  "steps": [
    {
      "text": "Whisk cream, milk, sugar, and salt together in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine raspberry preserves, fresh raspberries, and lemon zest in a small bowl, breaking up preserves; add to cream mixture, whisking until nicely blended and no clumps remain. Chill in the refrigerator for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into an ice cream maker and freeze according to the manufacturer's instructions until soft ice cream consistency, 25 to 30 minutes. Enjoy immediately, or transfer to an airtight container and freeze until firm, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
