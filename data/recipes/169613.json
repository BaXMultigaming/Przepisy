  "ingredients": [
    "1 pound ground beef",
    "0.5 pound ground pork",
    "1 egg",
    "0.33333334326744 cup finely chopped apple",
    "0.5 cup finely chopped onion",
    "2 tablespoons Worcestershire sauce",
    "0.5 teaspoon salt",
    "0.25 teaspoon pepper",
    "1 cup shredded Cheddar cheese",
    "0.5 cup bread crumbs",
    "0.5 cup quick cooking oats"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the beef, pork, egg, apple, onion, Worcestershire sauce, salt, and pepper in a mixing bowl until evenly mixed. Add the Cheddar cheese, bread crumbs, and oats; mix again until evenly mixed. Pack the meat mixture into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the center should read at least 160 degrees F (72 degrees C). Allow the meatloaf to rest for 10 minutes before slicing to keep the meat from crumbling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
