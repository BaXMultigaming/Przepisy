  "title": "Easy Pumpkin Cornbread",
  "description": "Quick and easy cornbread baked with pumpkin puree is a great way to enjoy sweet winter squash.",
  "authors": [
    "dlwings"
  ],
  "date_published": "2020-06-19T00:01:24-04:00",
