  "ingredients": [
    "1 cup milk",
    "0.25 cup white sugar",
    "1 tablespoon butter",
    "1 cup pumpkin puree",
    "2 cups cornmeal",
    "2 eggs, separated",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk, sugar, and butter together in a saucepan over medium-high heat until butter and sugar melt, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix milk mixture and pumpkin puree together in a bowl. Add cornmeal into pumpkin mixture 1/2 cup at a time, stirring batter well after each addition. Stir egg yolks and salt into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a glass or metal bowl until stiff peaks form. Lift your beater or whisk straight up: the tip of the peak formed by the egg whites will form sharp peaks. Fold egg whites into batter. Pour batter into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cornbread comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
