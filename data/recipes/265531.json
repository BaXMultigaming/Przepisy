  "ingredients": [
    "2 tablespoons butter",
    "1 teaspoon Dijon mustard",
    "1 pinch garlic powder, or to taste",
    "cooking spray",
    "1 tilapia fillet",
    "2 buttery round crackers (such as Ritz®), or more to taste, crumbled"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Add Dijon mustard and garlic; whisk well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a baking dish with cooking spray; add tilapia. Brush fillet with most of the butter mixture. Top with crumbled crackers. Brush more sauce on top. Pour the dregs of the sauce over the fish if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
