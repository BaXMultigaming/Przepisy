  "ingredients": [
    "3.5 cups all-purpose flour",
    "2 cups packed dark brown sugar",
    "1 (15 ounce) can pumpkin puree",
    "1 cup vegetable oil",
    "0.66670000553131 cup coconut milk",
    "0.66670000553131 cup white sugar",
    "2 teaspoons baking soda",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 teaspoon salt",
    "1 cup chopped walnuts, toasted",
    "0.66670000553131 cup unsweetened flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 8 x 4-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, brown sugar, pumpkin, oil, coconut milk, white sugar, baking soda, cinnamon, nutmeg, and salt together until well combined. Fold in walnuts and flaked coconut. Pour evenly into prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until a toothpick inserted into the center comes out clean, about 1 hour and 15 minutes. Remove from the oven and wrap tightly with foil; let steam 10 minutes. Turn out onto a rack. Tent lightly with foil; let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
