  "ingredients": [
    "1 cup mayonnaise",
    "3 tablespoons cider vinegar",
    "3 tablespoons white sugar",
    "2 crowns broccoli, cut into bite-size pieces",
    "1 cup seedless red grapes, halved",
    "0.75 cup chopped walnuts",
    "0.5 cup sweetened dried cranberries (such as Craisins®)",
    "0.25 cup sunflower seed kernels",
    "0.25 red onion, finely chopped",
    "0.25 cup bacon bits"
  ],
  "steps": [
    {
      "text": "Whisk mayonnaise, cider vinegar, and sugar together in a small bowl until sugar dissolves and dressing is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine broccoli, grapes, walnuts, cranberries, sunflower seeds, red onion, and bacon bits in a large bowl; drizzle dressing over salad and gently toss until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bowl with plastic wrap; refrigerate 3 to 4 hours. Stir before serving.",
