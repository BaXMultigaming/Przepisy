  "ingredients": [
    "1 tablespoon unsalted butter",
    "1 tablespoon olive oil",
    "0.5 medium onion, chopped",
    "0.5 medium red bell pepper, chopped",
    "1 medium zucchini, cut into 1/4-inch slices",
    "1 medium yellow squash, cut into 1/4-inch slices",
    "salt and freshly ground black pepper to taste",
    "1 clove garlic, minced",
    "minced chives (optional)"
  ],
  "steps": [
    {
      "text": "Heat butter and olive oil together in a large non-stick skillet over medium-high heat. Add onion once butter is bubbly; cook and stir for 2 minutes. Add bell pepper and cook for 1 minute. Stir in yellow squash and zucchini slices. Season with salt and pepper. Cook, stirring, for about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in minced garlic and cook, stirring, about 1 minute. Keep cooking, stirring continuously, until squash has desired texture, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with minced chives before serving.",
      "section": null,
