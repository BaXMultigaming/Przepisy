  "ingredients": [
    "0.5 cup olive oil",
    "0.5 cup fresh lime juice",
    "2 tablespoons chopped onion",
    "2 teaspoons dried tarragon",
    "1 teaspoon salt",
    "0.5 teaspoon hot sauce",
    "salt and pepper to taste",
    "2 pounds bone-in chicken thighs"
  ],
  "steps": [
    {
      "text": "Place olive oil, lime juice, onion, tarragon, 1 teaspoon salt, and hot sauce in a large, resealable plastic bag; shake to combine. Add chicken thighs, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from marinade and shake off excess. Discard remaining marinade. Season chicken with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until no longer pink in the center, about 30 minutes. (Chicken thighs don't dry out easily, so don't be afraid to cook them a bit longer if needed.)",
      "section": null,
      "name": null,
      "url": null,
