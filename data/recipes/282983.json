  "ingredients": [
    "1 cup all-purpose flour",
    "2 tablespoons white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon, or more to taste",
    "0.25 teaspoon salt",
    "2 medium apples - peeled, cored, and chopped, or more to taste",
    "0.25 cup milk",
    "1 large egg, beaten",
    "1 quart oil for frying, or as needed"
  ],
  "steps": [
    {
      "text": "Combine flour, sugar, baking powder, cinnamon, and salt in a large bowl; stir to blend. Stir in apples, milk, and egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a deep-fryer or Dutch oven half full with oil and heat to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches if necessary, drop tablespoonfuls of batter into the hot oil and fry until golden brown, about 5 minutes. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
