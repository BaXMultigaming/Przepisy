  "ingredients": [
    "1 tablespoon water",
    "1 teaspoon soy sauce, or to taste",
    "0.5 teaspoon white sugar",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Mix water, soy sauce, and sugar together in a small bowl until sugar is dissolved. Add egg and beat until egg mixture is combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat skillet over medium heat until a drop of water evaporates almost immediately. Pour egg mixture into pan. Cook until the bottom of the omelet has solidified, 3 to 5 minutes. Flip and fold omelet into a square and transfer to a plate.",
      "section": null,
