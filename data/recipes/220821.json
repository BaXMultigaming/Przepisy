  "ingredients": [
    "8 chicken drumsticks",
    "4 small ears corn",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 cup barbeque sauce",
    "1 tablespoon butter, melted",
    "1 (15 ounce) can pinto beans, rinsed and drained"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Lightly grease 4 large (12x18-inch) sheets aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 2 drumsticks and 1 ear corn in center of each foil sheet; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon barbecue sauce onto drumsticks. Drizzle butter onto corn. Divide beans among foil sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold foil around chicken-corn-bean mixtures; loosely seal edges. Transfer foil packets to a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink at bones and juices run clear, about 40 minutes. An instant-read thermometer inserted near but not touching the bone should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
