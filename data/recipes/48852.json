  "ingredients": [
    "2 eggs",
    "4 slices bacon",
    "5 cups fresh spinach, rinsed and torn into bite-size pieces",
    "1 cup sliced fresh strawberries",
    "0.5 cup sliced fresh mushrooms",
    "0.5 cup thinly sliced onion",
    "1 kiwi, sliced",
    "0.5 mandarin orange, peeled and segmented",
    "0.25 cup ketchup",
    "0.25 cup water",
    "0.25 cup olive oil",
    "0.25 cup brown sugar",
    "2 tablespoons cider vinegar",
    "0.5 teaspoon spicy brown mustard",
    "1 dash garlic powder",
    "salt and pepper to taste",
    "1 cup seasoned croutons"
  ],
  "steps": [
    {
      "text": "Place eggs in a saucepan and cover with water. Bring to a boil, remove from heat, and let eggs stand in hot water for 15 minutes. Remove eggs from hot water, cool under cold running water, peel, and chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook bacon in a skillet over medium-high heat until crisp and evenly brown. Drain on paper towels, then crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss eggs, bacon, spinach, strawberries, mushrooms, onion, kiwi, and orange together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ketchup, water, olive oil, brown sugar, cider vinegar, and brown mustard in a separate bowl: season dressing with garlic powder, salt, and black pepper. Toss salad with dressing: top with croutons.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
