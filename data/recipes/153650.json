  "ingredients": [
    "0.5 gallon apple cider",
    "0.5 gallon cranberry juice",
    "1 cup lemon juice",
    "1.25 cups pineapple juice",
    "1 large orange, thinly sliced",
    "24 whole cloves",
    "0.25 cup clover honey",
    "0.5 cup white sugar",
    "4 cinnamon sticks",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground allspice",
    "0.5 teaspoon ground ginger",
    "12 fresh mint leaves",
    "12 orange slices for garnish"
  ],
  "steps": [
    {
      "text": "In a large saucepan or pot, combine cider, cranberry juice, lemon juice, pineapple juice, orange slices, cloves, honey, sugar, and cinnamon sticks. Bring to a boil. Reduce the heat to a simmer; add nutmeg, ginger, and allspice. Simmer for 10 to 15 minutes, stirring occasionally.",
      "section": null,
