  "ingredients": [
    "3 cups dry navy beans, soaked overnight or boiled for one hour",
    "6 slices thick cut bacon, cut into 1 inch pieces",
    "1 large onion, chopped",
    "1.5 cups ketchup",
    "1.5 cups water",
    "1 cup brown sugar",
    "0.25 cup molasses",
    "1 tablespoon dry mustard",
    "1 tablespoon salt"
  ],
