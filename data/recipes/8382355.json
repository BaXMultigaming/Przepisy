  "ingredients": [
    "1 bagel, sliced in half",
    "1 tablespoon cooking oil",
    "1 large egg",
    "1 small avocado, peeled and pitted",
    "salt and ground black pepper to taste",
    "2 tablespoons softened cream cheese"
  ],
