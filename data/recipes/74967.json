  "ingredients": [
    "4 cups fresh blueberries",
    "1 cup all-purpose flour",
    "0.75 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup mayonnaise"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place blueberries into an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, and cinnamon in a medium bowl. Stir in mayonnaise until mixture resembles coarse crumbs. Sprinkle over the top of blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is lightly browned, 35 to 40 minutes.",
