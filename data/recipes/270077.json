  "ingredients": [
    "1.5 pounds ripe bananas",
    "0.5 pound ripe strawberries",
    "2 tablespoons tahini",
    "1 tablespoon vanilla extract",
    "1 tablespoon vegan brown sugar",
    "0.25 cup vegan mini chocolate chips"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with parchment paper. Peel and slice bananas and place on the prepared baking sheet. Freeze for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place strawberries in a blender and pulse a few times until blended but still chunky. Pour blended strawberries into a bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine frozen banana slices, tahini, vanilla extract, and brown sugar in a blender; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each ice pop mold 1/4 full with blended strawberries. Add banana-tahini mixture until molds are 3/4 full. Sprinkle mini chocolate chips on top. Insert sticks and freeze 4 hours or until frozen solid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
