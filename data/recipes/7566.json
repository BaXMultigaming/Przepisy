  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "4 eggs",
    "2 (3.5 ounce) packages instant vanilla pudding mix",
    "0.5 cup vegetable oil",
    "2 teaspoons orange extract",
    "1 (11 ounce) can mandarin orange segments",
    "1 (12 ounce) container frozen whipped topping, thawed",
    "1 (8 ounce) can crushed pineapple, drained"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, eggs, 1 package pudding mix, vegetable oil, orange extract, and mandarin oranges, and beat well for about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in three 9-inch greased and floured round cake pans for 20 to 25 minutes in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold remaining package pudding mix and pineapple into whipped topping for frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Frost chilled cake and keep refrigerated until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
