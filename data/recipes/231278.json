  "ingredients": [
    "3 tablespoons butter",
    "0.5 cup all-purpose flour",
    "0.5 cup milk",
    "2 large eggs, beaten",
    "1 teaspoon white sugar",
    "0.25 teaspoon salt",
    "0.25 lemon, juiced",
    "1 tablespoon confectioners' sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a 9-inch pie dish. Place in the preheating oven until butter is melted, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk together flour, milk, eggs, white sugar, and salt in a bowl. Pour mixture into butter in dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the edges are light brown, and a toothpick inserted into the center comes out clean, 20 to 24 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle lemon juice over pancake and dust with confectioners' sugar. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
