  "ingredients": [
    "1 tablespoon vegetable oil",
    "2 skinless, boneless chicken breasts, cut into bite-sized pieces",
    "0.5 large white onion, chopped",
    "2 cloves garlic, chopped",
    "2 (14 ounce) cans chicken broth",
    "2 small red potatoes, chopped",
    "0.25 head cabbage, chopped",
    "1 large carrot, chopped",
    "2 eggs, beaten",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N5Pn0145y4rBKyfFpQoDU1-ntzk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257184-perfect-chicken-vegetable-soup-DDMFS-KH-ingredients-7765b33242ab40d58fbfacb48ad85352.jpg"
      ],
      "image": "assets/images/257184/step_01.webp"
    },
    {
      "text": "Heat vegetable oil in a large pot over medium heat. Add chicken breasts, onion, and garlic; cook and stir until chicken is no longer pink in the center, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i_5r5qjQJDZz0YeDz2oJbooHdVM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257184-perfect-chicken-vegetable-soup-DDMFS-KH-step2-f85facd02c55412d82b60f45d595fc3e.jpg"
      ],
      "image": "assets/images/257184/step_02.webp"
    },
    {
      "text": "Pour chicken broth into the pot; bring to a boil. Stir in potatoes, cabbage, and carrot. Simmer soup until potatoes are tender, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vkGfOIhJTfzZ8qvIRhsR2PJDx-o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257184-perfect-chicken-vegetable-soup-DDMFS-KH-step3-342da9a6c7a7415f8b612c53cf064bc4.jpg"
      ],
      "image": "assets/images/257184/step_03.webp"
    },
    {
      "text": "Bring soup back to a boil. Drizzle in eggs and stir until cooked, about 1 minute. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
