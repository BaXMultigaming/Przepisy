  "ingredients": [
    "1 CAULIPOWER® Cauliflower Pizza Crust",
    "3 tomatoes, halved and sliced",
    "0.33333334326744 cup prepared pizza sauce",
    "1.5 cups shredded mozzarella cheese",
    "4 ounces fresh mozzarella cheese, sliced",
    "1 link fully cooked roasted red pepper and Asiago chicken sausage, sliced into thin rounds",
    "0.33333334326744 cup pesto sauce",
    "0.25 cup fresh basil leaves, torn"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange tomato slices on a few sheets of paper towels to absorb excess moisture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pizza crust onto a baking sheet or baking steel. Spread pizza sauce evenly over the crust. Top evenly with shredded mozzarella cheese. Next, add the tomato slices and fresh mozzarella cheese. Top with chicken sausage. Dot evenly with pesto sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and crust is golden brown, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven and immediately top with torn basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
