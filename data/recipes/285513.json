  "ingredients": [
    "nonstick cooking spray",
    "3 tablespoons olive oil",
    "4 cloves garlic, minced",
    "kosher salt and freshly cracked black pepper to taste",
    "1 pound fresh asparagus, trimmed",
    "0.25 cup shredded mozzarella cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a foil-lined baking sheet with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix olive oil, garlic, salt, and pepper together in a small bowl. Arrange asparagus on the prepared baking sheet, and drizzle oil mixture over top; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until spears are vibrant in color and just beginning to get tender, 10 to 12 minutes. Remove from the oven and turn on the broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top asparagus with mozzarella cheese. Return to the oven and broil until cheese melts and becomes golden, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
