  "ingredients": [
    "1 cup butter, softened",
    "0.75 cup white sugar",
    "0.75 cup brown sugar",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "3 cups whole wheat flour",
    "1 teaspoon baking soda",
    "0.75 teaspoon salt",
    "1 (12 ounce) bag semisweet chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, and brown sugar with an electric mixer in a large bowl until smooth. Add eggs and vanilla extract; beat until light and fluffy. Add flour, baking soda, and salt and stir until dough just combined. Stir in chocolate chips and walnuts. Dough will be very crumbly. Press and compact dough using your hands and a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 36 (1 1/2-inch) balls and place on a baking sheet. Press down slightly to flatten.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 8 to 12 minutes. Allow to cool before removing from the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
