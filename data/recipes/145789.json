  "ingredients": [
    "2 cups cubed honeydew melon",
    "2 cups passion fruit juice",
    "2 cups crushed ice",
    "1 cucumber, peeled, seeded and chopped",
    "8 sprigs fresh mint, or amount to taste"
  ],
  "steps": [
    {
      "text": "Combine honeydew melon, passion fruit juice, ice, and cucumber in a blender. Pull leaves from mint sprigs; add leaves to blender and discard stems. Blend mixture until smooth. Divide between 2 tall glasses.",
