  "ingredients": [
    "1 cup honey",
    "0.75 cup coconut oil, softened",
    "4 eggs",
    "2 bananas, mashed",
    "3.3333332538605 cups spelt flour",
    "2 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "1.5 teaspoons pink Himalayan salt",
    "0.125 teaspoon stevia powder",
    "2 cups fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line two 12-cup muffin tins with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir honey, coconut oil, eggs, and mashed bananas together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together spelt flour, baking soda, cinnamon, salt, and stevia powder in separate bowl. Gradually add flour mixture to honey-banana mixture, stirring until combined. Gently fold in blueberries. Scoop batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 22 minutes. Cool in the tins for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
