  "ingredients": [
    "2.5 cups coconut milk",
    "1 pound raw taro root, peeled and cut into 1/2-inch cubes",
    "0.75 cup white sugar",
    "0.25 cup palm sugar",
    "0.5 teaspoon salt",
    "1 cup unsweetened coconut cream"
  ],
  "steps": [
    {
      "text": "Bring coconut milk to a boil in a saucepan; reduce heat to medium-low to maintain a simmer. Add taro root; simmer until tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir white sugar, palm sugar, and salt into taro root mixture until sugars entirely dissolved. Stir in coconut cream; continue cooking until just hot.",
