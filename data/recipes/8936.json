  "ingredients": [
    "6 skinless, boneless chicken breast halves",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 (12 fluid ounce) can evaporated milk",
    "6 slices American processed cheese, cut into 1-inch pieces"
  ],
  "steps": [
    {
      "text": "In a large skillet, brown chicken on both sides. In the meantime, in a medium bowl combine the soup, milk and cheese. Mix together. When chicken is browned, pour mixture over chicken pieces. Cook over medium low heat until chicken is done and juices run clear. Serve.",
