  "ingredients": [
    "1.5 pounds fingerling potatoes",
    "1 small lemon, juiced",
    "2 teaspoons olive oil",
    "2 teaspoons garlic powder",
    "1 teaspoon kosher salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wash potatoes and pat dry. Cut abnormally large potatoes in half so all potatoes are around the same size (no bigger than 1/2 of a ping pong ball). Transfer to a metal baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix lemon juice and olive oil together and drizzle over potatoes. Sprinkle with garlic powder and salt. Toss until well coated and spread evenly in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Stir and bake until tender, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
