  "ingredients": [
    "8 hard-boiled eggs",
    "6 tablespoons mayonnaise",
    "3 teaspoons honey mustard",
    "1.5 teaspoons freshly squeezed lemon juice",
    "3 tablespoons minced fresh tarragon",
    "1.5 tablespoons minced sweet onion",
    "salt and freshly ground black pepper to taste",
    "16 leaves tarragon leaves"
  ],
  "steps": [
    {
      "text": "Peel hard-boiled eggs, cut in half lengthwise, and spoon out yolks. Place whites cut-side up on a plate and place yolks in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash yolks with a fork. Add mayonnaise, honey mustard, and lemon juice; beat until smooth and fluffy. Using a mini food processor works great for this step, making the filling smooth, creamy, and lump-free. Mix in minced tarragon, onion, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Evenly spoon filling into egg whites with a teaspoon. Use a piping bag or a small plastic sandwich bag with a corner snipped off if you prefer a more decorative look.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish deviled eggs with tarragon leaves and chill in the refrigerator until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
