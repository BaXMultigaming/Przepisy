  "ingredients": [
    "2 slices white sandwich bread",
    "1 slice Bologna, beef",
    "1 teaspoon mayonnaise",
    "1 slice Cheddar cheese",
    "1 slice tomato",
    "1 leaf lettuce",
    "1 teaspoon Dijon mustard"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 bread slice in the air fryer basket and cook in the preheated air fryer for 1 minute. Transfer to a plate. Repeat with remaining bread slice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove casing from bologna, then use a knife to make 4 slits to prevent curling. Place in the air fryer basket and cook for 3 minutes. Flip bologna over and cook for 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread mayonnaise onto 1 bread slice. Layer with cheese, bologna, tomato, and lettuce. Spread mustard onto remaining bread slice and top sandwich.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
