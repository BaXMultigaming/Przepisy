  "ingredients": [
    "6 slices bacon, cut into 1-inch pieces",
    "4 (16 ounce) cans pork and beans",
    "1 cup chopped onion",
    "0.5 cup packed brown sugar",
    "6 tablespoons molasses",
    "2 teaspoons yellow mustard"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large skillet over medium-high heat, stirring occasionally, until crisp, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pork and beans, onion, brown sugar, molasses, and mustard into bacon in the skillet; bring to a boil, reduce heat to medium-low, and simmer, stirring occasionally, until thickened, 15 to 20 minutes.",
      "section": null,
