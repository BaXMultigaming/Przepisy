  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "3 eggs",
    "1 (21 ounce) can apple pie filling",
    "0.75 cup packed brown sugar",
    "1 tablespoon all-purpose flour",
    "1 tablespoon butter",
    "1 teaspoon ground cinnamon",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, eggs, and apple pie filling together in a large bowl. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, flour, butter, cinnamon and walnuts. Sprinkle over the top of the cake batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 35 to 40 minutes. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
