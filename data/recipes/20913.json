  "title": "Easy Sausage Strata",
  "description": "This strata recipe is made with layers of cubed bread, pork sausage, and Cheddar cheese baked in creamy egg custard for a yummy breakfast casserole.",
  "authors": [
    "Allrecipes Member"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
