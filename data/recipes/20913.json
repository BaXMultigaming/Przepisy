  "ingredients": [
    "cooking spray",
    "1 pound pork sausage",
    "6 (1 ounce) slices bread, cubed",
    "2 cups shredded Cheddar cheese",
    "2 cups milk",
    "6 large eggs",
    "1 teaspoon salt",
    "1 teaspoon ground dry mustard"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fSFCaug5HRsh4vfi0bnJQRtTtC4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20913-easy-sausage-strata-ddmfs-step-1-BG-2622-075a152659e34858ad6a8e27015cf8dd.jpg"
      ],
      "image": "assets/images/20913/step_01.webp"
    },
    {
      "text": "Lightly grease a 7x11-inch baking dish with cooking spray; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large, deep skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eLCcJXKb5aafTaYyA3DXMcaOK0s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20913-easy-sausage-strata-ddmfs-step-2-BG-2636-abf2b578765f424aa8eb64f6d7aa99da.jpg"
      ],
      "image": "assets/images/20913/step_03.webp"
    },
    {
      "text": "Layer bread cubes, cooked sausage, and cheese in the prepared baking dish. Beat together milk, eggs, salt, and mustard in a medium bowl. Pour over bread mixture. Cover and refrigerate for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m4iU0REidYfOblHBrNAEr_1pAd8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20913-easy-sausage-strata-ddmfs-step-6-BG-2656-4a2c824b2a3b4a9eb9a03e3e3c1843b0.jpg"
      ],
      "image": "assets/images/20913/step_04.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). While the oven is heating, let casserole sit at room temperature for at least 30 minutes before baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake casserole in the preheated oven until a knife inserted into the center comes out clean, 50 to 60 minutes. Let casserole stand for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KgNXKZoZL-mFjFWta_lqjuMOgXg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20913-easy-sausage-strata-ddmfs-step-8-BG-2666-524ec7bd1eae4d3fa9d9be220218d4a0.jpg"
      ],
      "image": "assets/images/20913/step_06.webp"
    },
