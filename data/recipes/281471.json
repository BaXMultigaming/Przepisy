  "ingredients": [
    "0.25 cup extra-virgin olive oil",
    "3 medium limes, zested and juiced",
    "1 medium orange, zested and juiced",
    "6 cloves garlic, finely chopped",
    "1 teaspoon dried oregano",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon ground cumin",
    "1 pound large shrimp - peeled, deveined, and butterflied",
    "2 tablespoons extra-virgin olive oil"
  ],
  "steps": [
    {
      "text": "Make the marinade: Whisk oil, lime zest and juice, orange zest and juice, garlic, oregano, salt, pepper, and cumin together in a glass or ceramic bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Marinate the shrimp: Place shrimp into marinade and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for 1 to 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove shrimp from marinade, shaking off any excess. Reserve marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Add shrimp and cook until bright pink and opaque, 4 to 5 minutes. Transfer shrimp to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour reserved marinade into the skillet. Simmer over medium-low heat until slightly thickened, 5 to 8 minutes. Serve alongside shrimp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
