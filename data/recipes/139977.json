  "ingredients": [
    "5 cups shredded red cabbage",
    "1 cup sliced green apples",
    "0.25 cup white sugar",
    "2 tablespoons butter",
    "0.33333334326744 cup apple cider vinegar",
    "3 tablespoons water",
    "2.25 teaspoons salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon ground cloves"
  ],
