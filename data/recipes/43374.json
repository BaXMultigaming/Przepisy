  "ingredients": [
    "2 links pork sausage",
    "2 slices Canadian-style bacon",
    "2 slices bacon",
    "3 large eggs, beaten",
    "1 large pita bread, cut in half"
  ],
  "steps": [
    {
      "text": "Cook pork sausage, Canadian-style bacon, and bacon in a skillet over medium heat until evenly browned, 7 to 10 minutes. Remove to a paper towel-lined plate and drain almost all grease from the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble bacon; chop sausage and Canadian-style bacon. Return all to the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crack eggs into the skillet, and cook over medium heat, scrambling with bacon and sausage until no longer runny, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, microwave pita bread on high until warm, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon scrambled egg mixture into pita bread halves. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
