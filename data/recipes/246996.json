  "ingredients": [
    "0.5 cup margarine",
    "3 tablespoons margarine",
    "2 tablespoons golden syrup",
    "2 teaspoons boiling water",
    "1 teaspoon baking soda",
    "2 cups rolled oats",
    "1 cup all-purpose flour",
    "0.75 cup raw sugar",
    "0.5 cup dried shredded coconut",
    "0.5 cup diced dried apricots"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 1 baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 cup plus 3 tablespoons margarine and golden syrup in a microwave-safe bowl. Heat in the microwave until margarine is melted, 30 seconds to 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix boiling water and baking soda in a small bowl until baking soda is dissolved. Stir into margarine mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, all-purpose flour, sugar, coconut, and apricots together in a large bowl. Add water and margarine mixture; mix until dough is combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into small balls and place on prepared baking sheet; flatten slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
