  "ingredients": [
    "3 tablespoons butter or margarine, melted",
    "9 cups Corn Chex(r), Rice Chex(r) or Wheat Chex(r) cereal (or combination)",
    "2 cups bite-size pretzel twists",
    "2 cups bite-size cheese crackers",
    "0.5 cup grated Parmesan cheese",
    "1 (1 ounce) package ranch dressing and seasoning mix"
  ],
  "steps": [
    {
      "text": "Place butter in a large microwave-safe bowl. Cook uncovered in the microwave on high until melted, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cereal, pretzel twists, and crackers into melted butter until evenly coated. Stir in cheese and dressing mix until evenly coated. Cook uncovered in the microwave on high for 3 minutes, stirring each minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cereal mixture on waxed paper or aluminum foil and allow to cool, about 15 minutes. Store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
