  "ingredients": [
    "2 tablespoons olive oil",
    "4 cups thinly sliced yellow squash",
    "3 cups thinly sliced zucchini",
    "1 pound medium shrimp - peeled and deveined",
    "0.25 cup fresh lemon juice",
    "3 cloves garlic, minced",
    "1 teaspoon dried basil",
    "1 teaspoon dried oregano",
    "0.5 teaspoon salt",
    "0.25 teaspoon black pepper",
    "0.5 pound dried penne pasta",
    "0.5 cup minced fresh chives or green onions",
    "0.25 cup freshly grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Stir in yellow squash and zucchini; cook 10 minutes. Stir in shrimp; cook 3 minutes. Stir in lemon juice, garlic, basil, oregano, salt, and pepper; cook 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes. Strain; add to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add shrimp and squash mixture to penne; stir in chives and Parmesan.",
      "section": null,
