  "ingredients": [
    "0.5 cup olive oil",
    "0.25 cup balsamic vinegar",
    "4 cloves garlic, pressed",
    "4 (4 ounce) fillets salmon",
    "1.5 teaspoons garlic salt",
    "1 tablespoon chopped fresh cilantro",
    "1 tablespoon chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Mix oil and vinegar together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange salmon fillets in a shallow baking dish. Rub garlic onto salmon, then pour oil and vinegar mixture over top, turning once to coat. Season with garlic salt, then scatter cilantro and basil over top. Let sit for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove salmon from marinade and shake off excess. Reserve a few tablespoons marinade for basting; discard the remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil salmon in the preheated oven, turning once and brushing occasionally with reserved marinade during the first 6 to 8 minutes of cooking, until browned on both sides and fish flakes easily with a fork, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
