  "title": "Mediterranean Salmon",
  "description": "This Mediterranean-inspired salmon is loaded with flavor thanks to a balsamic vinegar and fresh herb marinade that's also used as a basting sauce.",
  "authors": [
    "ARIEL1O1"
  ],
  "date_published": "2019-04-02T02:46:45-04:00",
