  "ingredients": [
    "4 pounds baking potatoes",
    "2 pounds carrots",
    "1 onion",
    "seasoning salt to taste",
    "0.5 cup butter",
    "1.25 cups sour cream"
  ],
  "steps": [
    {
      "text": "Peel and cut up the potatoes and carrots into bite-size chunks. Chop up onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine all veggies in tin foil or foil baking bag. Season with desired amount of seasoning salt and top with butter. Seal foil well (you may need more than one bag, so the vegetables are done evenly).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill until potatoes and carrots are soft, about 40 minutes (flip bags at least 3-4 times during grilling). Remove from grill and place the veggies in a large bowl and add the sour cream, mixing well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
