  "ingredients": [
    "0.75 cup butter, softened",
    "0.5 cup packed light brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.5 cups rolled oats",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup chopped pecans",
    "2 cups toffee baking bits"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line cookie sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together butter and brown sugar. Stir in egg and vanilla until smooth. Sift together flour, salt, and baking soda; stir into creamed mixture. Then stir in rolled oats. Finally, stir in pecans chopped candy bar pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded tablespoons onto prepared cookie sheets, and flatten slightly. Bake for 10 to 18 minutes in the preheated oven. Cookies will have a dry appearance when finished baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
