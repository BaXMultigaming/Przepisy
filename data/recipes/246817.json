  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cloves",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup white sugar",
    "4 large eggs",
    "0.25 cup light brown sugar",
    "0.5 teaspoon vanilla extract",
    "0.75 cup canned pumpkin",
    "0.75 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease an 8½ x 4½-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cXEXbxiqmjh6dwO-EOrMxk5stco=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246817-copycat-starbucks-pumkin-bread-ddmfs-0650-4x3-step01-98982f4a7ad548dfa498e6e888175b89.jpg"
      ],
      "image": "assets/images/246817/step_01.webp"
    },
    {
      "text": "Whisk flour, baking soda, nutmeg, cinnamon, cloves, baking powder, and salt together in a bowl; set aside. Beat white sugar, eggs, brown sugar, and vanilla extract together in a separate bowl with an electric mixer on high speed until combined, about 30 seconds; beat in pumpkin and oil. Mix in flour mixture until batter is blended and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/esz5MATWCu1FjtbKhDphaZpr1Zs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246817-copycat-starbucks-pumkin-bread-ddmfs-0651-4x3-step02-1a69798c9b6b49499a1a92b2f4b05180.jpg"
      ],
      "image": "assets/images/246817/step_02.webp"
    },
    {
      "text": "Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IQ1xnTrPBqf0xjdDXWLpYS8GFZ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246817-copycat-starbucks-pumkin-bread-ddmfs-0653-4x3-step03-508aff0ca97b4d56ada5f2625248b5f1.jpg"
      ],
      "image": "assets/images/246817/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until top is dark brown and a toothpick inserted into center comes out clean, about 70 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R9_B4scnGl7p16HlL8Qh8KdaHes=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246817-copycat-starbucks-pumkin-bread-ddmfs-0670-4x3-step04-2ef03a7b405d4c77b1123abba37ea0c3.jpg"
      ],
      "image": "assets/images/246817/step_04.webp"
    },
    {
      "text": "Cool in the pan for about 30 minutes, then invert loaf onto a wire rack to cool completely. Cut into 1-inch-thick slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yheEsvTGkwyHrW7HOtWcf3fs3Dk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246817-copycat-starbucks-pumkin-bread-ddmfs-0671-4x3-step05-644e23e4431e4bc3a0c865f5c18b790c.jpg"
      ],
      "image": "assets/images/246817/step_05.webp"
    }
