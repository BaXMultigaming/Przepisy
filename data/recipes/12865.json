  "ingredients": [
    "1.5 cups vegetable oil",
    "4 pounds large shrimp - peeled and deveined",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "8 large eggs",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Heat oil in a medium saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the oil is heating, stir shrimp, salt, and pepper together in a medium bowl. Whisk eggs, flour, and baking powder together in a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in small batches, dredge shrimp in egg mixture. Lower shrimp carefully into the hot oil in batches. Fry until golden, 1 to 2 minutes. Transfer to a paper towel-lined plate to drain. Repeat with remaining shrimp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
