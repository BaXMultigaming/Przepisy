    "2 tablespoons butter",
    "0.66666668653488 cup sliced green onion",
    "1.3333333730698 cups uncooked long-grain rice",
    "4 cups water",
    "1 teaspoon chicken bouillon granules",
    "0.25 teaspoon ground black pepper",
