  "ingredients": [
    "1.5 cups butter",
    "1.5 cups all-purpose flour",
    "1.5 cups white sugar",
    "1.5 cups milk",
    "10 fresh peaches - peeled, pitted, and sliced",
    "1 pinch ground cinnamon, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Melt butter in a 9x13-inch baking dish in the preheating oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, and milk together in a large bowl; pour into baking dish with melted butter. Spread peaches over the batter and sprinkle with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cobbler is bubbling and lightly browned, about 45 minutes. Let cool about 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
