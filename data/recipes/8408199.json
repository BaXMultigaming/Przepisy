  "ingredients": [
    "4 tostada shells",
    "1 (15.25 ounce) can black beans, rinsed and drained",
    "0.25 cup prepared salsa",
    "0.5 cup prepared guacamole",
    "2 tablespoons vegetable oil",
    "4 frozen hash brown patties",
    "4 eggs",
    "0.5 cup shredded Cheddar cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Divide tostada shells between 4 plates.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beans in a bowl. Add salsa and stir to combine. Divide mixture between the tostada shells. Place a dollop of guacamole on top of each bean mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Place frozen hash brown patties in the skillet and cook 3 minutes. Flip and cook 3 minutes more. Transfer patties to a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the same skillet, crack eggs and cook for 2 minutes. Flip and cook 2 minutes more, or until desired doneness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a hash brown patty on top of each tostada, pressing down in the guacamole so it sticks. Top each patty with shredded cheese and a fried egg. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
