  "ingredients": [
    "1 serving cooking spray",
    "3 cups baking mix",
    "2 cups milk",
    "3 eggs",
    "0.25 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon",
    "1 cup blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a large baking sheet or jelly roll pan with parchment paper; coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine baking mix, milk, eggs, vanilla extract, and cinnamon in a large bowl; pour onto the prepared baking sheet. Sprinkle blueberries evenly on top of batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lift parchment paper with pancake from baking sheet; set on a cutting board. Slice into squares using a pizza cutter or into desired shapes with a cookie cutter.",
      "section": null,
