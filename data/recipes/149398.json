  "ingredients": [
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "1 teaspoon vanilla extract",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Combine white sugar, brown sugar, flour, and cinnamon in a small saucepan. Stir in vanilla extract and water, then bring to a rolling boil over medium heat, stirring often. Continue to boil, stirring constantly, until the mixture thickens to a syrup consistency, about 3 to 5 minutes. Remove from heat and let cool for 10 minutes before serving.",
