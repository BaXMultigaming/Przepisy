  "ingredients": [
    "1 serving cooking spray",
    "0.33333334326744 cup melted butter, at room temperature",
    "0.25 cup honey",
    "2 large eggs, lightly beaten",
    "1 teaspoon vanilla extract",
    "0.5 cup light brown sugar",
    "0.5 cup all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Spray a 24-cup mini muffin tin with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk butter, honey, eggs, and vanilla extract together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar, flour, baking powder, and salt together in a bowl. Make a well in the center, and pour butter mixture into the well. Stir just until batter is combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle 1/2 of the chopped pecans into the bottoms of the prepared muffin cups. Spoon batter evenly over top, until just about full and sprinkle with remaining pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 10 to 12 minutes. Leave the muffins in the pan for about 5 minutes before removing to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
