  "ingredients": [
    "3 cups fresh cranberries",
    "3 cups coarsely chopped, peeled apples",
    "0.75 cup white sugar",
    "1 cup rolled oats",
    "0.33333334326744 cup all-purpose flour",
    "0.5 cup chopped pecans",
    "0.5 cup dark brown sugar",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 3 quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, toss together the cranberries, apples and white sugar. Pour into the prepared casserole. Mix together the oats, flour, pecans and brown sugar in the same bowl. Spread evenly over the fruit in the dish. Pinch off small pieces of butter and arrange them on top of the oat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, covered, for 50 minutes in the preheated oven. Remove the lid and bake for an additional 10 minutes, or until the top is toasted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
