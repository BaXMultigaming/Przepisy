  "ingredients": [
    "4 slices bacon",
    "6 medium red new potatoes",
    "1.3333333730698 cups mayonnaise",
    "1 tablespoon soy sauce",
    "1 teaspoon sugar",
    "1 teaspoon sesame oil",
    "0.125 teaspoon dry hot mustard",
    "0.125 teaspoon salt",
    "0.75 cup chopped bok choy",
    "1 medium red bell pepper, seeded and diced",
    "0.5 cup chopped green onion",
    "0.25 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels and crumble when cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the bacon is cooking, bring a large pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes. Drain and let cool for 15 minutes. Chop into bite-sized chunks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mayonnaise, soy sauce, sugar, sesame oil, mustard powder, and salt together in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine potatoes, bacon, bok choy, bell pepper, green onion, and cilantro in a large bowl. Pour dressing over top and mix until well combined. Refrigerate until flavors have blended, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
