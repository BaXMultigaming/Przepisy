  "ingredients": [
    "2.75 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 cup white sugar",
    "0.5 cup margarine, softened",
    "2 eggs",
    "1.5 cups mashed ripe bananas",
    "1 cup plums, pitted and chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and baking soda into a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash sugar and margarine together in a separate bowl until creamy; beat in eggs until incorporated. Stir in flour mixture in 3 batches, alternating with mashed bananas, beating briefly after each addition, until smooth and well combined. Fold in plums. Transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
