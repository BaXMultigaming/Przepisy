  "ingredients": [
    "1 (13.8 ounce) package refrigerated pizza crust",
    "0.25 cup butter, melted",
    "6 cloves garlic, minced",
    "1 tablespoon minced fresh basil",
    "1 cup shredded Cheddar cheese",
    "0.5 cup grated Romano cheese",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Lightly grease a 10x15-inch baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press dough onto the prepared baking sheet. Combine butter, garlic, and basil in a small bowl; drizzle over dough. Sprinkle with Cheddar, Romano, and Parmesan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crisp, 10 to 12 minutes. Cut into 12 squares and serve warm.",
