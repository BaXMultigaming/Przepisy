  "ingredients": [
    "1 serving cooking spray",
    "1 cup white sugar",
    "0.33333334326744 cup butter, softened",
    "1.5 cups pawpaw pulp",
    "0.33333334326744 cup tepid water",
    "2 eggs",
    "1.3333333730698 cups all-purpose flour",
    "0.5 cup chopped walnuts",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray an 8-inch pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and butter in a large bowl; beat together until smooth. Add pulp, water, and eggs; beat until well combined. Stir in flour, walnuts, baking soda, salt, and baking powder. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 75 minutes. Let cool before serving, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
