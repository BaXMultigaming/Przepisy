  "ingredients": [
    "1 tablespoon olive oil",
    "1 pound skinless, boneless chicken breast halves, cut into 1/2-inch cubes",
    "1 onion, chopped",
    "2 cloves garlic, chopped",
    "2 (15.5 ounce) cans great Northern beans, rinsed and drained",
    "1 (14.5 ounce) can chicken broth",
    "2 (4 ounce) cans chopped green chiles",
    "1 teaspoon salt",
    "1 teaspoon ground cumin",
    "1 teaspoon dried oregano",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon cayenne pepper",
    "1 cup sour cream",
    "0.5 cup heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Gather ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1fJ_inH1a66PuVpP7m2zdT3mAlI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229949-creamy-white-chili-ddmfs-4x3-step1-0015-2011b4c853f54a71b6d5f6f348d0eb33.jpg"
      ],
      "image": "assets/images/229949/step_01.webp"
    },
    {
      "text": "Heat olive oil in a large saucepan over medium heat. Add chicken, onion, and garlic; cook and stir until chicken is no longer pink in centers and the juices run clear, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H8dHu1WQt9zs0xBn-M7HZ0CPQP0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229949-creamy-white-chili-ddmfs-4x3-step2-0018-c0248954ceeb45ffabec382ee04962c7.jpg"
      ],
      "image": "assets/images/229949/step_02.webp"
    },
    {
      "text": "Stir in beans, chicken broth, green chiles, salt, cumin, oregano, black pepper, and cayenne pepper; bring to a boil. Reduce heat; simmer until flavors have blended, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ORBIWrGNC2Fj_xI-VS2QTDYt6l8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229949-creamy-white-chili-ddmfs-4x3-step3-0019-4a288d50155841cf8b3cd7789f10dcda.jpg"
      ],
      "image": "assets/images/229949/step_03.webp"
    },
    {
      "text": "Off heat, stir in sour cream and heavy cream until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MG6r89I9mrCu2_3AYxAuy2mXrB0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229949-creamy-white-chili-ddmfs-4x3-step4-0022-bbb1306cc7af46d9bda900b89d500787.jpg"
      ],
      "image": "assets/images/229949/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
