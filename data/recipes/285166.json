  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup coarse or turbinado (raw) sugar",
    "0.33333334326744 cup cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup water",
    "0.33333334326744 cup grapeseed oil",
    "1 teaspoon vanilla extract",
    "1 teaspoon apple cider vinegar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease one 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, sugar, cocoa powder, baking soda, and salt. Mix in water, grapeseed oil, vanilla extract, and apple cider vinegar. Mix together until smooth. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes. Cool on a wire rack for 5 minutes. Run a table knife around the edges to loosen. Invert carefully onto a serving plate or cooling rack. Let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
