  "ingredients": [
    "1 (10 ounce) can refrigerated biscuit dough",
    "0.5 cup packed light brown sugar",
    "0.25 cup chopped pecans",
    "1 teaspoon ground cinnamon",
    "2 tablespoons margarine, melted",
    "2 tablespoons dark corn syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease an 8-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each biscuit in half and form each piece into a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, pecans, and cinnamon in a small bowl. Dip each biscuit half into margarine, then into the sugar mixture. Place in prepared cake pan. Mix remaining margarine and sugar mixture and spoon over biscuit balls. Drizzle corn syrup over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 to 12 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
