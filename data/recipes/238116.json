  "ingredients": [
    "2 cups ketchup",
    "2 cups tomato sauce",
    "1 cup apple cider vinegar",
    "1 cup packed brown sugar",
    "0.25 cup Worcestershire sauce",
    "2 teaspoons Dijon mustard",
    "0.75 teaspoon garlic powder",
    "1 teaspoon lemon juice",
    "1 teaspoon cayenne pepper",
    "0.25 cup water",
    "0.25 teaspoon ground black pepper",
    "1 teaspoon paprika",
    "0.5 teaspoon salt",
    "2 teaspoons butter, melted",
    "2 tablespoons hickory-flavored liquid smoke flavoring",
    "2 cups tomato juice",
    "0.75 cup molasses",
    "1 cup unsweetened applesauce",
    "1 cup whiskey (such as Jack Daniel's® Tennessee Honey)"
  ],
  "steps": [
    {
      "text": "Combine ketchup, tomato sauce, apple cider vinegar, brown sugar, Worcestershire sauce, Dijon mustard, garlic powder, lemon juice, cayenne pepper, water, black pepper, paprika, salt, butter, liquid smoke, tomato juice, molasses, applesauce, and whiskey, respectively, in a large pot; bring to a boil. Reduce heat to low and simmer until sauce is smooth and thickened, about 1 hour.",
