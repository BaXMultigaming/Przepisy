  "ingredients": [
    "1 cup butter",
    "0.75 cup brown sugar",
    "1 tablespoon ground cinnamon",
    "1 cup crushed saltine crackers",
    "water, as needed",
    "1 acorn squash, halved and seeded"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium-low heat. Stir cinnamon and brown sugar through the melted butter; remove from heat and stir crushed saltine crackers into the butter until moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour enough water into a baking dish to be about 1 inch deep. Lay the acorn squash into the water with the rounded sides down. Fill the cavity of the squash with the saltine cracker mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the squash is easy to pierce with a fork, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
