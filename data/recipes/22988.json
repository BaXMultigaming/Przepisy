  "ingredients": [
    "3 cups all-purpose flour",
    "0.25 cup white sugar",
    "4 teaspoons baking powder",
    "0.75 teaspoon cream of tartar",
    "1 cup cold butter, cubed",
    "0.66666668653488 cup heavy cream",
    "1 large egg, beaten",
    "3 cups sliced fresh strawberries",
    "3 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, 1/4 cup sugar, baking powder, and cream of tartar in a large bowl until well combined. Cut in cold butter with 2 knives or pastry blender until mixture resembles coarse crumbs. Stir in cream and beaten egg until incorporated. Turn dough out onto a lightly floured surface and knead for 2 minutes. Press dough into a 1/2-inch-thick sheet. Cut into squares and place on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 20 minutes. Allow shortcakes to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place strawberries in a medium bowl. Sprinkle with 3 tablespoons sugar; stir to evenly coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut cooled shortcakes in half lengthwise and spread with sugared berries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
