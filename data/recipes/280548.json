  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill corn and poblano peppers on the preheated grill until corn has charred and peppers have softened, 12 to 15 minutes. Remove from the grill and let cool enough to handle, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut corn off cobs and dice poblanos; place into a bowl. Add jalapenos, onion, cilantro, lime juice, salt, and pepper and mix together.",
