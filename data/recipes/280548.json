  "ingredients": [
    "6 ears sweet corn",
    "2 poblano peppers",
    "2 jalapeno peppers, diced",
    "0.5 red onion, diced",
    "0.33333334326744 cup chopped fresh cilantro",
    "1 tablespoon lime juice",
    "1 pinch salt and ground black pepper to taste"
