  "ingredients": [
    "4 (4 ounce) tilapia fillets",
    "2 tablespoons Miami-style sazon seasoning (sazon completa)",
    "1 serving olive oil cooking spray (such as PAM®)",
    "0.5 cup grated Parmesan cheese",
    "2 tablespoons butter-margarine blend (such as Smart Balance®), melted",
    "1.5 tablespoons fat-free mayonnaise (such as Kraft®)",
    "2 tablespoons lemon juice",
    "2 teaspoons grated lemon zest",
    "0.125 teaspoon dried basil",
    "0.125 teaspoon ground black pepper",
    "0.125 teaspoon onion powder",
    "0.125 teaspoon celery salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven's broiler and set the oven rack about 6 inches from the heat source. Line a broiler pan with aluminum foil. Spray the broiler pan's rack with olive oil cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle tilapia with sazon seasoning and arrange on the prepared broiler rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook the fillets under the preheated broiler until fish is barely opaque, 2 to 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the Parmesan cheese, butter-margarine blend, fat-free mayonnaise, lemon juice, lemon zest, basil, black pepper, onion powder, and celery salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the Parmesan cheese blend over the fish fillets, return to oven, and continue cooking until the topping is golden brown and the fish flakes easily, 3 to 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
