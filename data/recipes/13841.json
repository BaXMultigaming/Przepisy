  "ingredients": [
    "0.25 cup butter",
    "1 onion, chopped",
    "0.25 cup all-purpose flour",
    "3 cups chicken broth",
    "3 cups milk",
    "2 (8 ounce) packages shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Melt butter in a 3-quart saucepan over medium-high heat. Add onion and cook until tender, about 5 minutes. Stir in flour to make a roux. Add broth and cook, stirring constantly, until the mixture is slightly thickened. Add milk and cook until just boiling, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, blend the soup in a blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return the soup to the saucepan and cook over medium heat until just boiling. Remove from the heat and whisk in cheese until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
