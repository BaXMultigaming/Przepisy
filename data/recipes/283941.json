  "ingredients": [
    "4 cups Italian-style tipo 00 flour",
    "2 medium eggs",
    "0.75 cup superfine sugar",
    "2 tablespoons superfine sugar",
    "1 medium lemon, zested",
    "1 stick cold, unsalted butter, cut into cubes",
    "5 tablespoons cold, unsalted butter, cut into cubes",
    "1 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Put the flour in a mixing bowl. Make a well in the center. Add eggs, 3/4 cups plus 2 tablespoons sugar, and lemon zest. Mix by hand, working in circles, pulling in the flour little-by-little until all the ingredients are incorporated into a dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 1 stick plus 5 tablespoons cubed cold butter and baking powder. Quickly work the dough with your hands until a smooth ball is formed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap in plastic wrap and refrigerate for at least 20 minutes before rolling out.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
