  "ingredients": [
    "2 cups whole milk",
    "2 cups chicken broth",
    "1.75 cups cooked pulled pork",
    "2 tablespoons barbecue sauce",
    "2 teaspoons chili powder",
    "2 teaspoons ground black pepper",
    "1.5 teaspoons dried oregano",
    "1 teaspoon salt",
    "2 tablespoons dried parsley"
  ],
  "steps": [
    {
      "text": "Combine milk and chicken broth in a large pot. Add pulled pork and barbecue sauce and stir. Stir in chili powder, black pepper, oregano, and salt. Let simmer over low heat, stirring occasionally, for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide into 6 bowls and top with parsley.",
