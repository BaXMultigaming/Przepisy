  "ingredients": [
    "6 eggs",
    "1 cup milk",
    "1 cup all-purpose flour",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "2 tablespoons salted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, milk, flour, vanilla extract, cinnamon, and salt together in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a 9x11-inch baking dish in the preheated oven, making sure it doesn't burn, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the baking dish with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue baking until pancake is puffed and no longer moist in the center, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
