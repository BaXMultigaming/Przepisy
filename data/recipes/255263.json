      "image_sources": []
    },
    {
      "text": "Arrange chicken pieces in the baking pan. Sprinkle salt, pepper, paprika, garlic powder, and oregano over both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
