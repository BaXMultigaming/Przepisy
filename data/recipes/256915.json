  "ingredients": [
    "8 Ball Park® Hot Dog Buns",
    "2 cups tomato sauce",
    "3 teaspoons garlic granules",
    "3 teaspoons dried Italian herb blend",
    "1 teaspoon sweet paprika",
    "1 teaspoon kosher salt",
    "1 teaspoon ground black pepper",
    "1 pound bulk mild Italian sausage",
    "2 tablespoons extra virgin olive oil",
    "1 teaspoon garlic granules",
    "1 teaspoon dried Italian herb blend",
    "0.5 pound pepperoni slices",
    "1 cup grated mozzarella cheese",
    "0.5 cup grated Parmesan cheese",
    "3 sprigs Fresh oregano sprigs",
    "1 pinch Crushed red pepper"
  ],
  "steps": [
    {
      "text": "To make the sauce, combine tomato sauce, garlic, 3 teaspoons herbs, paprika, salt and pepper in a sauce pan over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When sauce bubbles, reduce to a low simmer and stir. Cover and allow to simmer over very low heat for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble Italian sausage in a pan and cook over medium heat until no longer pink, about 15 minutes. Drain over paper towels. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix olive oil, garlic and 1 teaspoon herb blend in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Open hot dog buns and arrange on sheet pans covered in foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate buns in halves along the folds if you want to make 16 appetizers; leave whole if you want to make 8 pizzas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush the buns with the olive oil mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast buns in the oven for about 5 minutes, just until edges begin to brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pan from oven and spread each of the buns with the warm tomato sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with browned Italian sausage, pepperoni slices, mozzarella and Parmesan cheeses.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return pan to the oven and bake at 400 degrees F for 5 to 10 minutes or until cheeses are bubbling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve garnished with fresh oregano leaves and crushed red pepper, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
