  "ingredients": [
    "1 cup butter, softened",
    "1 cup brown sugar",
    "1 cup white sugar",
    "2 large eggs",
    "1.75 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "2.5 tablespoons all-purpose flour",
    "0.25 teaspoon salt",
    "1.5 teaspoons baking soda",
    "0.25 teaspoon baking powder",
    "1.75 cups rolled oats",
    "1.75 cups corn flake cereal",
    "0.5 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together in a bowl until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat in eggs and vanilla extract until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, whisk together both amounts of flour, salt, baking soda, and baking powder. Mix flour mixture into the liquid ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently mix rolled oats, corn flakes, and coconut into the dough until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop the dough by tablespoons onto baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the cookies are light golden brown, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
