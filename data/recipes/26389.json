  "ingredients": [
    "1.5 pounds ground beef",
    "1 tablespoon vegetable oil",
    "0.5 teaspoon salt",
    "1 (10.5 ounce) can condensed French onion soup",
    "1 tablespoon chili powder",
    "2 teaspoons ground cumin",
    "0.5 teaspoon ground black pepper",
    "1 (6 ounce) can tomato paste",
    "1 (8 ounce) can tomato sauce",
    "2 (15 ounce) cans kidney beans",
    "2 teaspoons unsweetened cocoa",
    "1 cup cola-flavored carbonated beverage"
  ],
  "steps": [
    {
      "text": "In a deep skillet or large saucepan, cook beef with oil and salt over medium heat until brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, puree French onion soup in a blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain meat. Stir pureed soup into meat, reduce heat and simmer 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chili powder, cumin, pepper, tomato paste, tomato sauce, and beans until well combined. Stir in cocoa and cola. Heat through and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
