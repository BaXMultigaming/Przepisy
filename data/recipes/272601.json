  "ingredients": [
    "4 slices bacon, diced",
    "1 medium onion, peeled and halved",
    "1 jalapeno pepper, seeded and halved",
    "1 (29 ounce) can canned black beans (such as Goya®)",
    "1 (12 ounce) can unsweetened coconut water",
    "0.5 cup white Spanish cooking wine",
    "0.5 tablespoon ground cumin",
    "1 bay leaf"
  ],
  "steps": [
    {
      "text": "Cook and stir bacon, onion, and jalapeno over medium heat in a medium-sized soup pot until bacon begins to brown and is mostly cooked through, about 5 minutes. Stir in black beans, coconut water, white cooking wine, cumin, and bay leaf. Cover and cook over medium heat until thickened, about 1 hour.",
