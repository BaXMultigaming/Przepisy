  "ingredients": [
    "1 pound ground beef",
    "1 (14.5 ounce) can French cut green beans",
    "12 frozen hash brown patties, thawed",
    "1 (10 ounce) can canned whole kernel corn",
    "salt to taste",
    "pepper to taste"
