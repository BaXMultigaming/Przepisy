  "ingredients": [
    "2 cups warm milk (110 degrees F/45 degrees C)",
    "0.25 cup margarine, melted",
    "0.25 cup warm water",
    "0.25 cup white sugar",
    "2 (.25 ounce) packages instant yeast",
    "2 teaspoons salt",
    "6 cups all-purpose flour, or as needed"
  ],
  "steps": [
    {
      "text": "In a large bowl, stir together milk, margarine, warm water, sugar, and yeast. Let stand for about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in salt and gradually stir in flour until you have a soft dough. Divide into 25 pieces, and form into balls. Place on baking sheets, so they are 2 to 3 inches apart. Let rise for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Bake rolls for 15 minutes in the preheated oven. Cool slightly, then split them in half horizontally to fill with your favorite burgers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
