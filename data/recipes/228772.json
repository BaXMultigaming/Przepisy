  "ingredients": [
    "1 (8.25 ounce) can cream-style corn",
    "1 cup yellow cornmeal",
    "0.75 cup buttermilk",
    "3 large eggs",
    "0.5 cup corn oil",
    "3 ounces shredded Cheddar cheese",
    "2 jalapeno peppers, minced",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Move an oven rack to the center position.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cream-style corn, cornmeal, buttermilk, eggs, corn oil, Cheddar cheese, jalapeño peppers, salt, and baking soda in a large bowl until batter is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put butter into a 9-inch square baking dish and place in the preheated oven until melted, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter over melted butter in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted into the center comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
