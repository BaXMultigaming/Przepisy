  "title": "Sfoof (Lebanese Semolina Turmeric Cake)",
  "description": "Sfoof is a Lebanese dessert that is not overly sweet. This version mixes semolina and regular flour to make a light cake, topped with pine nuts.",
  "authors": [
    "Lara"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
