  "ingredients": [
    "1.5 cups semolina flour",
    "0.5 cup all-purpose flour",
    "1 teaspoon ground turmeric",
    "1.5 teaspoons baking powder",
    "1.125 cups white sugar",
    "1 cup milk",
    "0.5 cup vegetable oil",
    "1 tablespoon pine nuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch round baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix semolina, flour, turmeric and baking powder. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir milk and sugar until sugar is dissolved. Add flour mixture and oil and beat with an electric beater at medium speed for 5 minutes. This step is essential, do not use any shortcuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into a prepared 9-inch round pan. Sprinkle top with pine nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until wooden pick inserted in center comes out dry, 25 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
