  "ingredients": [
    "0.5 cup butter, melted",
    "1.5 cups crushed cornflakes",
    "0.25 cup grated Parmesan cheese",
    "0.25 cup dried parsley flakes",
    "1 teaspoon seasoned salt",
    "1 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "6 (5 ounce) boneless, skinless chicken thighs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place melted butter in a shallow dish. Mix crushed cornflakes, Parmesan cheese, parsley flakes, seasoned salt, salt, and pepper together in another shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chicken thighs in butter and then in cornflake mixture. Place in a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until chicken is no longer pink in the center and the juices run clear, about 1 hour. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
