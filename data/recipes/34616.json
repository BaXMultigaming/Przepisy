  "ingredients": [
    "1.5 cups olive oil",
    "1 tablespoon red wine vinegar",
    "0.25 cup lemon juice",
    "1 tablespoon Worcestershire sauce",
    "2 tablespoons anchovy paste",
    "0.5 teaspoon mustard powder",
    "4 cloves garlic, crushed",
    "3 tablespoons sour cream",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "In a food processor or blender, combine olive oil, vinegar, lemon juice, Worcestershire sauce, anchovy paste, mustard, garlic, sour cream, and Parmesan cheese. Process until smooth. Pour into a glass container, seal, and refrigerate until ready to use.",
