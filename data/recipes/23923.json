  "ingredients": [
    "3 tablespoons vegetable oil",
    "1 medium onion, chopped",
    "2 pounds cubed beef stew meat",
    "3 cups water, divided",
    "0.25 cup soy sauce",
    "0.25 cup Worcestershire sauce",
    "1 teaspoon garlic powder",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 (.75 ounce) packet dry brown gravy mix"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over high heat. Add onion and saute until almost translucent, about 3 minutes. Add stew meat and cook, stirring occasionally, until browned on all sides; about 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZSWBLa3wd9s0WxcijutgYY5cNqY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23923-beef-tips-ddmfs-step2-0113-381db046989c496781b9e53c0523fd5d.jpg"
      ],
      "image": "assets/images/23923/step_01.webp"
    },
    {
      "text": "Pour 2 cups water, soy sauce, and Worcestershire sauce into the skillet. Stir in garlic powder, salt, and pepper; bring to a boil. Reduce the heat, cover, and simmer until meat is tender, 1 1/2 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QXEpZTZKzsnEmd7gka0kqJIxjnU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23923-beef-tips-ddmfs-step3-0116-4c8b15d66c6b42e18ef21bb32c682358.jpg"
      ],
      "image": "assets/images/23923/step_02.webp"
    },
    {
      "text": "When the meat is almost finished, mix remaining 1 cup water and gravy mix until thoroughly combined; stir into the meat mixture and bring to a boil. Cook, stirring frequently, until slightly thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7403NRDLpCuOchsv6myQD4E0V88=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23923-beef-tips-DDMFS-4x3-7477f073cf824257a280eb452ccb7adc.jpg"
      ],
      "image": "assets/images/23923/step_03.webp"
    }
  ],
