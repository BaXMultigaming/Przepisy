  "steps": [
    {
      "text": "Place a rice cooker in your garage or on an outside porch if possible; the garlic will release a very strong odor as it cooks. Place garlic in the rice cooker. Cover and cook on the Keep Warm setting for 2 weeks, without opening the lid.",
      "section": null,
      "name": null,
      "url": null,
