  "ingredients": [
    "2 cups light brown sugar",
    "2 cups white sugar",
    "1 cup margarine",
    "1 cup butter",
    "4 eggs",
    "2 teaspoons vanilla extract",
    "4 cups all-purpose flour",
    "4 cups rolled oats",
    "2 teaspoons baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "2 cups semisweet chocolate chips",
    "1 cup candy-coated chocolate pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, white sugar, margarine, and butter together in a very large bowl until smooth. Beat in eggs, one at a time, then stir in vanilla. Whisk flour, oats, baking soda, baking powder, and salt together in a separate bowl; stir into sugar mixture until just combined. Stir in chocolate chips and candy-coated chocolate pieces. Drop by tablespoonfuls onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 10 to 11 minutes (for chewy cookies, take them out before they look done).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
