  "ingredients": [
    "3 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons baking soda",
    "1 teaspoon salt",
    "1.5 cups white sugar",
    "1 cup vegetable oil",
    "4 large eggs",
    "2 teaspoons vanilla extract",
    "1.5 teaspoons ground cinnamon",
    "0.75 teaspoon ground nutmeg",
    "2 cups finely grated zucchini, excess moisture squeezed out",
    "1 (8 ounce) can crushed pineapple, drained"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, oil, eggs, vanilla, sugar, cinnamon, and nutmeg together in a large bowl. Stir in zucchini and drained pineapple, then stir in dry ingredients. Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
