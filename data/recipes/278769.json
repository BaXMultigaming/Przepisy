  "title": "Authentic Greek Moussaka",
  "description": "This moussaka has layers of fried eggplant, beef sauce with cinnamon and allspice, and a rich and creamy bechamel sauce for a delicious Greek classic.",
  "authors": [
    "Diana Moutsopoulos"
  ],
  "date_published": "2020-06-19T00:44:33-04:00",
  "date_modified": "2026-06-18T12:11:57-04:00",
