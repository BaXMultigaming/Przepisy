    "publisher-tested"
  ],
  "ingredients": [
    "4 medium eggplants, cut lengthwise into 1/3-inch slices",
    "salt to taste",
    "4 cups milk",
    "1 stick butter",
    "6 tablespoons all-purpose flour",
    "3 large egg yolks, beaten",
    "7 tablespoons olive oil, divided",
    "2 medium onions, grated",
    "3 cloves garlic, finely chopped",
    "1 pound lean ground beef",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon white sugar",
    "1 pinch ground cinnamon",
    "salt and ground black pepper to taste",
    "1 (14 ounce) can tomato sauce",
    "4 tablespoons chopped fresh parsley",
    "1 large egg white, lightly beaten",
    "1.5 cups freshly grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xHVUAqWeP-1hOzpIy5YTEffa1hI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/4089-Authentic-Greek-Moussaka-Step1-3x4-19033-c50f55d65c054d908afb7cd8e2f7183c.jpg"
      ],
      "image": "assets/images/278769/step_01.webp"
    },
    {
      "text": "Sprinkle eggplant slices with salt and place in a colander set in the sink or over a plate. Let sit for 30 minutes to 1 hour so the salt can draw out any bitterness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iNqueDD9Q69g_gfXbyAahdN_Cz8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/4089-Authentic-Greek-Moussaka-Step2-3x4-19035-812f26a2d0c445a98715eb8c115aa234.jpg"
      ],
      "image": "assets/images/278769/step_02.webp"
    },
    {
      "text": "Meanwhile, to make bechamel sauce: Heat milk in a saucepan almost to a boil. Melt butter in a skillet over medium heat. Whisk in flour until a smooth paste forms. Lower heat and gradually pour in hot milk, whisking constantly until bechamel sauce thickens. Season with salt. Remove from heat and allow to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ChoK8nSxHPzVgvvAWT61YaoHWgQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/4089-Authentic-Greek-Moussaka-Step-03-f1800e07692d44f3ad8e55828e280919.jpg"
      ],
      "image": "assets/images/278769/step_03.webp"
    },
    {
      "text": "Rinse eggplant slices under cold running water. Squeeze out liquid and pat dry with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GTn1kweyVhvYtuMkJvX4DsNxEMQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/4089-Authentic-Greek-Moussaka-Step-04-df0144fc8c194454b64ecb090c0d107f.jpg"
      ],
      "image": "assets/images/278769/step_04.webp"
    },
    {
      "text": "Whisk egg yolks into the cooled bechamel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k6yors8ejDeQd2wK2a1GgsgrDgY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/4089-Authentic-Greek-Moussaka-Step-05-85893d90a2c542d58a481d9e3299e685.jpg"
      ],
      "image": "assets/images/278769/step_05.webp"
    },
    {
      "text": "Heat 3 tablespoons olive oil in a large skillet and cook eggplant slices in batches until each side is lightly browned, about 3 minutes per side. Drain on a large plate lined with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lFQInTA8NcDCSgT5eccJ0cskNG4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/4089-Authentic-Greek-Moussaka-Step-06-b66c96d69f384c5c80d9b92f671b9432.jpg"
      ],
      "image": "assets/images/278769/step_06.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish with olive oil. Heat remaining 4 tablespoons olive oil in a large skillet over low heat. Cook grated onion until soft, about 4 minutes. Add garlic and cook for 1 minute. Increase heat to medium-high and add ground beef. Cook and stir until browned and crumbly, about 5 minutes. Season with allspice, sugar, cinnamon, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VEp6wyzvDV2Y6ELvflLMMFWHtxA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/4089-Authentic-Greek-Moussaka-Step-07-de7cfa42914e4c1087354f174b677835.jpg"
      ],
      "image": "assets/images/278769/step_07.webp"
    },
    {
      "text": "Stir in tomato sauce and bring to a simmer. Cook until all excess liquid has evaporated and mixture appears dry, 15 to 20 minutes. Stir in parsley and remove from heat. Allow to cool slightly, then stir in the egg white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wOqvsJETtDM_1t4PWBM5g2A1jeo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/4089-Authentic-Greek-Moussaka-Step-08-aae67de7e1194382b6a04d29b47fa3e1.jpg"
      ],
      "image": "assets/images/278769/step_08.webp"
    },
    {
      "text": "Arrange a layer of eggplant in the prepared baking dish. Cover eggplant with all of the beef mixture and sprinkle with 1/3 of the Parmesan cheese. Cover with remaining eggplant and sprinkle another 1/3 of Parmesan cheese on top. Pour bechamel sauce over the top and sprinkle with remaining Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2vI3h8djOQfKOaszZUGzbCzcj3k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/4089-Authentic-Greek-Moussaka-Step-09-c794ada69793427ab654cbc0ea67638a.jpg"
      ],
      "image": "assets/images/278769/step_09.webp"
    },
    {
      "text": "Bake in the preheated oven until the top of the moussaka is set and golden, 45 minutes to 1 hour. Remove from oven and let rest at room temperature for 10 to 15 minutes before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5XsDswgpxAUYApz98sc48qllNw4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/4089-Authentic-Greek-Moussaka-Step-10-14eea3e62fa44b9aa42ddbc925ce9fcc.jpg"
      ],
      "image": "assets/images/278769/step_10.webp"
    }
  ],
