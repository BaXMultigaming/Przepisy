  "ingredients": [
    "1 (9 inch) pie shell",
    "1 cup white sugar",
    "1 egg",
    "0.5 cup half-and-half cream",
    "3 tablespoons all-purpose flour",
    "2 cups heavy whipping cream",
    "2 tablespoons butter, melted",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sugar, egg, half-and-half, flour, whipping cream, and butter or margarine in blender. Beat until thoroughly combined. Pour into pie shell and sprinkle with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 60 to 70 minutes, until set in center.",
