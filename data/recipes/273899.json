    },
    {
      "text": "Pour apple pie filling into a bowl. Dice the apple slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tortilla inside a small oven-proof bowl so that it forms a cup. Brush the inside of the tortilla with melted butter; liberally sprinkle with cinnamon sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crisp, 10 to 12 minutes. Carefully remove from the bowl and cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop ice cream into the taco cup and top with the apple pie filling. Garnish with a dollop of whipped cream and cinnamon.",
