  "ingredients": [
    "spray-on cooking oil",
    "4 cups chow mein noodles",
    "3 cups miniature marshmallows",
    "3 tablespoons butter",
    "30 small jellybeans"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with aluminum foil; coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place noodles in a large bowl. Combine marshmallows and 3 tablespoons butter in a medium saucepan over medium heat; stir until melted and smooth. Pour marshmallow mixture over noodles; stir until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub hands with some butter; form noodle mixture into 6 round balls. Place balls on the prepared baking sheet. Press center of each ball with the back of a teaspoon to make a hollow indentation. Set nests aside until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each nest with candies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
