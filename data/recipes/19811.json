  "ingredients": [
    "5 large eggs",
    "2 (12 fluid ounce) cans evaporated milk",
    "1 (14 ounce) can sweetened condensed milk",
    "1.5 cups white sugar",
    "0.5 pint heavy cream",
    "1 teaspoon vanilla extract",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "4 cups milk, or as needed"
  ],
  "steps": [
    {
      "text": "Beat eggs, evaporated milk, condensed milk, sugar, cream, and vanilla together in a large bowl with an electric mixer. Beat in pudding mix until smooth. Pour into freezer canister of an ice cream maker and add enough milk to bring mixture to fill line. Freeze according to manufacturer's directions.",
