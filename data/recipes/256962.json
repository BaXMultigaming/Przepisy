  "ingredients": [
    "1 (12 ounce) package bacon",
    "6 eggs",
    "2 tablespoons milk",
    "1 teaspoon butter, melted",
    "0.25 teaspoon dried parsley",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup diced ham",
    "0.25 cup shredded mozzarella cheese",
    "6 slices Gouda cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until starting to brown, about 5 minutes. Drain bacon slices on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line 6 cups of a nonstick muffin tin with bacon slices. Chop leftover bacon slices and sprinkle over the bottom of each cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, milk, butter, parsley, salt, and pepper together in a large bowl. Stir in ham and mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour egg mixture into the bacon-lined cups; top with Gouda cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until Gouda cheese is melted and eggs are set, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
