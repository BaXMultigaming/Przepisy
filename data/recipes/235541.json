  "ingredients": [
    "2 (32 ounce) cartons chicken broth",
    "0.5 cooked rotisserie chicken, meat removed from bones and chopped",
    "1 cup sliced carrots",
    "1 Macintosh apple, cored and diced",
    "0.5 onion, diced",
    "0.5 cup sliced celery",
    "0.25 cup grated Parmesan cheese",
    "1 bay leaf",
    "2 cups orzo pasta"
  ],
  "steps": [
    {
      "text": "Combine chicken broth, chicken, carrots, apple, onion, celery, Parmesan cheese, and bay leaf in a large pot; bring to a boil. Reduce heat to medium-low; simmer until vegetables are soft, about 30 minutes.",
