  "ingredients": [
    "1 green bell pepper, seeded and halved",
    "1 red bell pepper, seeded and halved",
    "1 yellow bell pepper, seeded and halved",
    "1 tablespoon canola oil, or as needed",
    "2 Roma (plum) tomatoes, chopped",
    "0.33333334326744 cup chopped green onions",
    "0.25 cup fresh chopped cilantro",
    "1 jalapeno pepper, minced",
    "2 cloves garlic, minced",
    "1 lime, juiced",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 4 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bell peppers on a broiler pan, cut-side-down. Brush with canola oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until charred, 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer peppers to a bowl and cover with plastic wrap for 5 minutes. Peel off and discard skin and chop peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chopped peppers, Roma tomatoes, green onions, cilantro, jalapeno, garlic, and lime juice in a blender. Puree until smooth. Refrigerate salsa at least 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
