  "ingredients": [
    "1 (2 pound) boneless pork loin roast",
    "2 tablespoons chili powder",
    "1 tablespoon GOYA® Adobo All-Purpose Seasoning with Pepper",
    "1 teaspoon ground cumin",
    "1 teaspoon packed dark brown sugar",
    "0.125 teaspoon ground cinnamon",
    "2 tablespoons GOYA® Extra Virgin Olive Oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a roasting pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chili powder, adobo seasoning, cumin, brown sugar, and cinnamon together in a small bowl until well combined. Add olive oil and stir until completely saturated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat pork dry with paper towels. Rub pork all over with spice mixture, then place into the prepared roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven until pork is dark golden brown, about 35 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pork to a platter and tent with foil to keep warm. Let rest for 10 to 15 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with accumulated juices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
