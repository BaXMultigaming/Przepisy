  "ingredients": [
    "1 (21 ounce) can apple filling",
    "1 cup butter, at room temperature",
    "0.5 cup white sugar",
    "0.5 cup (packed) dark brown sugar",
    "2 eggs",
    "1 tablespoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.75 cup raisins",
    "0.75 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Break up apples in filling in a medium bowl using a potato masher; set aside. Cream butter, white sugar, and brown sugar together in a large bowl; stir in apple filling, eggs, and vanilla extract until well blended. Sift flour, baking soda, cinnamon, and salt together in a separate bowl; stir into apple mixture, then stir in raisins and walnuts. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center of loaf comes out clean, about 1 hour. Cool in the pan for 15 minutes, then turn out onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
