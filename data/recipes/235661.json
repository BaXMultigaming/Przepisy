  "ingredients": [
    "1 (9 inch) pie crust pastry",
    "0.5 cup unsalted butter, softened",
    "0.5 cup white sugar",
    "0.25 cup brown sugar",
    "1.5 tablespoons all-purpose flour",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon ground allspice",
    "0.25 teaspoon salt",
    "1 pinch ground cinnamon",
    "2 eggs",
    "5 Bartlett pears, peeled and chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Press pie crust pastry into a 9-inch pie dish and refrigerate while preparing filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, brown sugar, flour, nutmeg, allspice, salt, and cinnamon together in a bowl using an electric mixer until smooth. Beat eggs, 1 at a time, into butter mixture until incorporated; fold in pears. Pour filling into chilled crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is set in the middle, 30 to 35 minutes. Cool completely before serving, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
