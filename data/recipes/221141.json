  "ingredients": [
    "1 pint fresh strawberries, hulled",
    "0.25 cup white sugar, or more to taste",
    "2 tablespoons water",
    "0.5 teaspoon balsamic vinegar",
    "2 tablespoons water",
    "1 teaspoon cornstarch"
  ],
  "steps": [
    {
      "text": "Combine strawberries, sugar, 2 tablespoons water, and balsamic vinegar in a saucepan; bring to a simmer over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium-low, cover, and simmer for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 2 tablespoons water and cornstarch together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cornstarch mixture into strawberry mixture. Cook, stirring constantly, until mixture thickens, 1 to 2 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer mixture to a blender and puree until smooth.",
      "section": null,
      "name": null,
      "url": null,
