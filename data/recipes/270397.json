  "ingredients": [
    "2 tablespoons vegetable oil, or as needed",
    "2 pounds cubed beef stew meat",
    "6 potatoes, peeled and diced",
    "4 medium yellow onions, sliced",
    "1.5 cups water",
    "2 beef bouillon cubes",
    "salt and ground black pepper to taste"
