  "ingredients": [
    "1 tablespoon olive oil",
    "1 cup chopped onions",
    "2 stalks celery, chopped",
    "1.5 pounds ground pork",
    "1.5 pounds ground beef",
    "1 (3 pound) whole cooked chicken, deboned and shredded",
    "3 (14.5 ounce) cans whole peeled tomatoes with liquid, chopped",
    "1 cup ketchup",
    "0.5 cup hickory-flavored barbecue sauce",
    "1 teaspoon hot sauce to taste",
    "salt and pepper to taste",
    "1 medium green bell pepper",
    "3 (14.75 ounce) cans cream style corn"
  ],
  "steps": [
    {
      "text": "Heat oil in a large stockpot over medium heat. Add onions and celery; cook and stir until translucent, about 5 minutes. Mix in pork and beef; cook and stir until evenly browned and crumbly, about 10 minutes. Do not drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add shredded chicken, tomatoes and their liquid, ketchup, barbecue sauce, hot sauce, salt, and pepper. Submerge whole green pepper in the mixture. Reduce the heat to low and cook, stirring occasionally, until thickened, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in corn and continue to cook for 1 hour, or to desired consistency. Remove green pepper; chop and return to the stew or discard.",
      "section": null,
      "name": null,
      "url": null,
