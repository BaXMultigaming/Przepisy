  "ingredients": [
    "0.66666668653488 cup uncooked long-grain white rice",
    "3 cups warm water",
    "2 cinnamon sticks",
    "2 cups milk",
    "0.5 cup white sugar, or more to taste",
    "1 tablespoon vanilla extract",
    "ice",
    "1 pinch ground cinnamon, or to taste"
  ],
  "steps": [
    {
      "text": "Grind rice into very fine, cornmeal-sized pieces using a blender or coffee grinder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer ground rice to a medium bowl, pour warm water on top, and drop in cinnamon sticks. Cover and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the cinnamon sticks. Place mixture back in the blender and puree until as smooth as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a sieve with a couple layers of cheesecloth and strain the mixture. Squeeze cloths to extract as much flavor as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in milk, sugar, and vanilla extract until sugar has dissolved. Chill completely, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve over ice, garnished with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
