  "ingredients": [
    "3 ripe avocados - peeled, pitted, and cubed",
    "0.5 cup unsweetened cocoa powder",
    "0.5 cup maple syrup",
    "1 teaspoon lemon juice",
    "2 teaspoons vanilla extract",
    "1 pinch salt",
    "1 tablespoon water, or as needed"
  ],
  "steps": [
    {
      "text": "Place the avocados, cocoa powder, maple syrup, lemon juice, vanilla extract, and salt in the work bowl of a food processor, and blend until smooth and creamy. Add water, 1 tablespoon at a time, as needed to make the pudding the desired consistency. Eat right away, or chill and serve cold.",
