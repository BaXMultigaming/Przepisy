  "ingredients": [
    "1 lime, quartered",
    "2 sprigs fresh mint leaves",
    "1 tablespoon white sugar",
    "2 slices cucumber",
    "6 cubes ice, or as needed",
    "2 ounces white rum (such as Bacardi®)",
    "4 fluid ounces club soda"
  ],
  "steps": [
    {
      "text": "Squeeze the lime quarters into a highball glass, and drop the limes into the glass. Add the mint leaves and sugar. Muddle well with the back of a spoon or with a muddler. Place the cucumber slices into the glass, and fill with ice cubes. Pour in the rum, then top off with club soda. Stir gently and serve.",
