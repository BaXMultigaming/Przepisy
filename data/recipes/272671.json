  "ingredients": [
    "2 cups white distilled vinegar",
    "2 cups water",
    "2 sticks butter",
    "4 tablespoons Worcestershire sauce",
    "4 tablespoons garlic salt",
    "2 tablespoons ground black pepper",
    "1 tablespoon white sugar",
    "2 teaspoons minced garlic",
    "4 chicken leg quarters",
    "2 (8 ounce) bone-in chicken breasts"
  ],
  "steps": [
    {
      "text": "Combine vinegar, water, butter, Worcestershire sauce, garlic salt, black pepper, sugar, and minced garlic in a large pot; bring to a boil. Cool marinade to room temperature, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour marinade into a resealable plastic bag. Add chicken leg quarters and breasts; coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from marinade and shake off excess; discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until chicken is no longer pink at bones and the juices run clear, 30 to 45 minutes. An instant-read thermometer inserted near, but not touching, bones should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
