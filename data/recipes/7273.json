  "ingredients": [
    "1 cup evaporated milk",
    "1 cup white sugar",
    "3 egg yolks, beaten",
    "0.5 cup butter",
    "1 teaspoon vanilla extract",
    "1.3329999446869 cups flaked coconut",
    "1 cup chopped macadamia nuts"
  ],
  "steps": [
    {
      "text": "Combine milk, sugar, egg yolks, butter and vanilla in a saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on medium heat until thick, approximately 12 minutes. Stir constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat, and add coconut and macadamia nuts. Continue to stir until cool and thick enough to spread on your cake.",
