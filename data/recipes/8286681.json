  "ingredients": [
    "2 pounds lean ground beef",
    "1 cup old-fashioned oats",
    "1 (8 ounce) can tomato sauce",
    "2 large eggs, slightly beaten",
    "2 tablespoons minced dried onion",
    "0.25 teaspoon granulated garlic",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.25 cup ketchup, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together ground beef, oats, tomato sauce, eggs, onion, garlic, salt, and pepper until well combined. Press into a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an instant-read thermometer inserted into the center reads at least 160 degrees F (71 degrees C), about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and spread ketchup over top. Serve with additional ketchup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
