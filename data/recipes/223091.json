    "publisher-tested"
  ],
  "ingredients": [
    "2 skinless, boneless chicken breast halves",
    "0.25 cup olive oil",
    "2 tablespoons white wine vinegar",
    "1 lemon, juiced",
    "4 sprigs fresh dill, chopped",
    "1 tablespoon garlic and herb seasoning blend (such as Mrs. Dash®)",
    "1 teaspoon ground black pepper",
    "2 tablespoons butter",
    "2 tablespoons olive oil",
    "0.125 teaspoon garlic powder",
    "0.125 teaspoon salt",
    "8 thick slices French bread",
    "2 tablespoons mayonnaise, or to taste",
    "4 slices tomato",
    "4 lettuce leaves"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the grill to medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LuVJbzV6evn8UEuNcsePkY6tg7g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-223091-cafe-style-grilled-chicken-sandwiches-VAT-step-01-5fcf9de50f824b119fa8e97cc4fbf7d7.jpg"
      ],
      "image": "assets/images/223091/step_01.webp"
    },
    {
      "text": "Prick chicken breasts all over with a fork, then place in a large bowl. Add 1/4 cup olive oil, white wine vinegar, lemon juice, dill, garlic and herb seasoning, and black pepper to the bowl. Stir to coat chicken breasts thoroughly. Let stand for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DX5Th66TTr85b8KN_dnba6mP6BQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-223091-cafe-style-grilled-chicken-sandwiches-VAT-step-02-55f471e33d034f8886803cb01fdc9676.jpg"
      ],
      "image": "assets/images/223091/step_02.webp"
    },
    {
      "text": "Remove chicken breasts from marinade; discard marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QPb_b3mH5jiolQGmJnmcT1EhT-c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-223091-cafe-style-grilled-chicken-sandwiches-VAT-step-03-d28e1aa1008b4c469b79d7179319d473.jpg"
      ],
      "image": "assets/images/223091/step_03.webp"
    },
    {
      "text": "Cook chicken on the preheated grill until no longer pink in the center and juices run clear, 10 to 15 minutes per side. An instant-read thermometer inserted into the center of a breast should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FaVmhEftyM4OtbpHja88A5xUSOk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-223091-cafe-style-grilled-chicken-sandwiches-VAT-step-04-1ec3f4688f4e4c2fa4ddab0fc42715c6.jpg"
      ],
      "image": "assets/images/223091/step_04.webp"
    },
    {
      "text": "Transfer chicken to a cutting board; let stand for 5 minutes, then cut chicken breasts in half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uF37ALoCOQf5yW3yCBVkyiGX6-g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-223091-cafe-style-grilled-chicken-sandwiches-VAT-step-05-ab4164f049544c51a7f496f5d798214c.jpg"
      ],
      "image": "assets/images/223091/step_05.webp"
    },
    {
      "text": "Melt butter and 2 tablespoons olive oil in a skillet over medium-high heat. Sprinkle garlic powder and salt over butter and oil. Add French bread slices to the skillet; toast until golden brown on one side, about 3 minutes; remove from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HFc20xYYIH7Ca8LcnkMWBRm8398=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-223091-cafe-style-grilled-chicken-sandwiches-VAT-step-06-3a240f76517e4dfa8d548e7a7e27ed64.jpg"
      ],
      "image": "assets/images/223091/step_06.webp"
    },
    {
      "text": "For sandwich assembly, place one French bread slice, toasted-side down, onto a serving plate. Spread mayonnaise on bread; top with a tomato slice, then season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m-aVto8uBpsgkomfQT_oSDr4Ksg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-223091-cafe-style-grilled-chicken-sandwiches-VAT-step-07-550befd57c014e359e7b03ef0fad38e3.jpg"
      ],
      "image": "assets/images/223091/step_07.webp"
    },
    {
      "text": "Cover with a grilled chicken breast half and lettuce leaf. Spread untoasted side of another French bread slice with mayonnaise and place on top to make a sandwich.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KJHF-L2c4Yy11S0J3RLoxBnhCNA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-223091-cafe-style-grilled-chicken-sandwiches-VAT-step-08-9a9e96acaace450f8619526ba31f6f71.jpg"
      ],
      "image": "assets/images/223091/step_08.webp"
    }
  ],
