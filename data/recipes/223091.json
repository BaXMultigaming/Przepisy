  "title": "Grilled Chicken Sandwiches",
  "description": "This juicy grilled chicken sandwich is made with marinated chicken sandwiched between slices of crispy fried bread with lettuce, tomato, and mayo.",
  "authors": [
    "Allrecipes Member"
  ],
  "date_published": "2020-03-27T22:59:31-04:00",
