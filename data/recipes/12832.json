  "ingredients": [
    "0.75 cup olive oil",
    "2 onions, thinly sliced",
    "2 leeks, sliced",
    "3 tomatoes - peeled, seeded and chopped",
    "4 cloves garlic, minced",
    "1 sprig fennel leaf",
    "1 sprig fresh thyme",
    "1 bay leaf",
    "1 teaspoon orange zest",
    "0.75 pound mussels, cleaned and debearded",
    "9 cups boiling water",
    "salt and pepper to taste",
    "5 pounds sea bass",
    "1 pinch saffron threads",
    "0.75 pound fresh shrimp, peeled and deveined"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HoOvnDoR8dN9S-OEjP7I8njk1HI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12832-bouillabaisse-DDMFS-step-01_36309-b4eef528fe16446d9f0f700321932204.jpg"
      ],
      "image": "assets/images/12832/step_01.webp"
    },
    {
      "text": "Heat olive oil in a large saucepan; add onions, leeks, chopped tomatoes, and garlic. Cook and stir over low heat until vegetables have softened, about 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9pTB8Wr4-vucK0726Pyi7fOJfTs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12832-bouillabaisse-DDMFS-step-02_36321-c180958f811d48e6bf8c9bf4777e3bce.jpg"
      ],
      "image": "assets/images/12832/step_02.webp"
    },
    {
      "text": "Stir in fennel, thyme, bay leaf, and orange zest. Add mussels, shrimp, and boiling water; stir to combine. Season to taste with salt and black pepper. Increase the heat to high, and boil for about 3 minutes to allow the oil and water to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A-3EP5YWf0nAZoxP4YcEXdfSoAk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12832-bouillabaisse-DDMFS-step-03_36337-acc8464e389b4969996c3e6f2ec9e936.jpg"
      ],
      "image": "assets/images/12832/step_03.webp"
    },
    {
      "text": "Add seabass and reduce the heat to medium. Continue cooking until fish is opaque and tender, but still firm, about 12 to 15 minutes. Fish should not be falling apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MpGK53XMyY2CytkAnaJDXqqByOw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12832-bouillabaisse-DDMFS-step-04_36342-573cf436e41c4478bf686c0274953428.jpg"
      ],
      "image": "assets/images/12832/step_04.webp"
    },
    {
      "text": "Taste the bouillabaisse and adjust the seasoning. Stir in saffron, and then pour soup into a warmed tureen or soup dishes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c4EG8hNq2kol3rZFPCQQzP264KU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12832-bouillabaisse-DDMFS-step-05_36368-0f33ec8a1f014a9291045195d15569d1.jpg"
      ],
      "image": "assets/images/12832/step_05.webp"
    }
  ],
