  "title": "Bouillabaisse",
  "description": "This classic French Bouillabaisse combines mussels, shrimp, and seabass in a fragrant tomato and saffron broth for a crowd-pleasing, seafood stew.",
  "authors": [
    "Mary Young"
  ],
  "date_published": "1999-07-24T12:18:23-04:00",
