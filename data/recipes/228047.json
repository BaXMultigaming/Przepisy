  "ingredients": [
    "1 1 (9 inch) unbaked pie crust (see footnote for recipe link)",
    "0.5 cup slivered almonds",
    "0.5 cup light brown sugar",
    "0.33333334326744 cup rolled oats",
    "0.33333334326744 cup all-purpose flour",
    "0.75 teaspoon salt",
    "6 tablespoons cold, unsalted butter, cut into pieces",
    "2 pounds cherries, pitted",
    "0.5 lemon, juiced",
    "0.33333334326744 cup white sugar, or more to taste",
    "0.25 cup cornstarch"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out pie crust and lay into a 9-inch pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almonds, brown sugar, oats, flour, and salt in a large bowl. Work butter into the almond mixture with your fingers, breaking up any large pieces, until incorporated completely. Cover and chill for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cherries, lemon juice, white sugar, and cornstarch. Stir until well coated and no dry lumps remain, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cherries and any accumulated juices into the prepared pie pan. Press down into the pan. Crumble oat mixture over the top. Place the pan on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cherries are bubbling and the crust and crumble topping are browned, about 1 hour 15 minutes. Let cool completely.",
      "section": null,
      "name": null,
      "url": null,
