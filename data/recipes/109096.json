  "ingredients": [
    "1 cup heavy cream",
    "1 cup vanilla low-fat yogurt",
    "1 cup frozen dark sweet cherries",
    "0.5 cup fat free milk",
    "0.5 cup white sugar",
    "0.25 cup cherry juice concentrate",
    "2 teaspoons almond extract",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Place heavy cream, yogurt, cherries, milk, sugar, cherry juice concentrate, almond extract, and salt into a blender; blend until only small bits of cherries remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into a 1 ½-quart ice cream maker and freeze according to manufacturer's instructions, about 20 minutes. Transfer to an airtight container and freeze until firm, about 4 hours.",
      "section": null,
