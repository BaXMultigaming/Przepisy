  "ingredients": [
    "1 (15 ounce) can cream-style corn",
    "1 (14 ounce) can whole kernel corn, drained",
    "2 cups shredded Cheddar cheese",
    "2 eggs, beaten",
    "0.5 cup butter, melted",
    "0.25 cup all-purpose flour",
    "0.25 cup diced bell pepper",
    "2 tablespoons white sugar",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease two 5x7-inch casserole dishes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream-style corn, whole kernel corn, Cheddar cheese, eggs, butter, flour, bell pepper, sugar, salt, and black pepper together in a large bowl; divide between prepared casserole dishes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of either casserole comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
