  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "5 Ball Park® Tailgaters Brat Buns",
    "1 pound lean ground beef",
    "0.25 cup milk",
    "1 egg",
    "2 tablespoons grated Parmesan cheese",
    "1 teaspoon Italian seasoning",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "salt and pepper to taste",
    "1 (24 ounce) jar marinara sauce",
    "1 cup arugula",
    "4 tablespoons shredded mozzarella cheese",
    "Chopped fresh basil or crushed red pepper for garnish"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast one bun until golden brown, then place in blender and chop until fine to create crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the bread crumbs in a large bowl and add milk. Let soak for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add ground beef, eggs, Parmesan, Italian seasoning, onion powder, garlic powder, and salt and pepper to the bread crumb mixture and combine well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide the mixture into 16 golf ball-sized meatballs, and place on an oiled baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake meatballs in oven for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While meatballs are baking, heat marinara in a large pot over medium-high heat. Place the cooked meatballs in the marinara and simmer for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, toast the remaining buns, then evenly distribute arugula or spinach, meatballs and mozzarella onto each bun.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with chopped basil and/or crushed red pepper and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
