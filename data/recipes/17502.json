  "ingredients": [
    "3 tablespoons mustard powder",
    "0.25 cup wasabi powder",
    "1 teaspoon salt, or to taste",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon ground black pepper",
    "0.25 cup honey",
    "1 (12 fluid ounce) can or bottle beer",
    "3 cups ketchup",
    "0.5 cup Worcestershire sauce",
    "2 tablespoons lemon juice",
    "0.5 cup finely chopped onion",
    "0.5 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "In a medium saucepan, combine the mustard powder, wasabi powder, salt, cayenne pepper, ground black pepper, honey and 1/4 cup beer. Mix well, then stir in the ketchup, Worcestershire sauce, lemon juice, onion and cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place saucepan on the stovetop and bring to a boil over medium high heat. Reduce heat to low and let simmer for at least 1 to 1 1/2 hours. Pour in beer as needed to keep a consistency slightly thinner than ketchup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
