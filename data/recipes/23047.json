        "https://www.allrecipes.com/thmb/TbLV2rmyhbiiOMqPQ7VVQ3LPvXY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23047-real-sopapillas-DDMFS-Step-5-63e581a4afe04f28a3867c5bb49d1a9a.jpg"
