  "ingredients": [
    "4 cups all-purpose flour",
    "4 tablespoons shortening",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1.5 cups warm water",
    "2 quarts oil for frying"
  ],
  "steps": [
