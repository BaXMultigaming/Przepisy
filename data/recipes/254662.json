  "ingredients": [
    "3 tablespoons olive oil",
    "1 cup sliced fresh mushrooms",
    "0.5 onion, finely chopped",
    "3 cloves garlic, minced",
    "1 bunch Swiss chard, chopped",
    "0.5 roasted red pepper, chopped",
    "1 teaspoon dried oregano",
    "1 teaspoon dried basil",
    "salt and ground black pepper to taste",
    "0.5 cup white wine"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large skillet over medium heat. Add mushrooms, onion, and garlic; cook and stir until onion is translucent and mushrooms soften, about 5 minutes. Stir in Swiss chard, red pepper, oregano, basil, salt, and black pepper. Cook until Swiss chard is wilted, about 3 minutes. Stir in white wine; cook until Swiss chard is tender, 3 to 4 minutes more.",
