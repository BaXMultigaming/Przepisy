  "ingredients": [
    "1 cup all-purpose flour",
    "1 teaspoon cracked black pepper",
    "1 teaspoon seasoned salt",
    "0.25 teaspoon garlic powder",
    "1 pound beef cube steaks",
    "0.5 cup olive oil",
    "2 cups beef broth"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KRQRpmKQKmtFmGdFeYTTsoi4x6c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215620-CountryStyleSteak-ddmfs-Step1-3x4-7713-966ac5f6563d4ae4bc1fd3673a322fbf.jpg"
      ],
      "image": "assets/images/215620/step_01.webp"
    },
    {
      "text": "Mix flour, black pepper, seasoned salt, and garlic powder together in a shallow bowl. Coat cube steaks thoroughly with flour mixture, patting flour onto steaks to get a good coating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CmTlVwBJxcnvzOYxOKhAfbwWTIM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215620-CountryStyleSteak-ddmfs-Step2-3x4-7721-0eac3d30b0c94b2391ea75a37664d348.jpg"
      ],
      "image": "assets/images/215620/step_02.webp"
    },
    {
      "text": "Retain 3 tablespoons of seasoned flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/idvJHgY4Img40Mj2_ldoCcpjc3o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215620-CountryStyleSteak-ddmfs-Step3-3x4-7724-c7aec0c6c3d64579939805e1e7e3de07.jpg"
      ],
      "image": "assets/images/215620/step_03.webp"
    },
    {
      "text": "Heat olive oil in a skillet over medium heat. Pan-fry cube steaks until golden brown on both sides, about 5 minutes per side. Place steaks into a 9x12-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lv4QljkEgT2O-hyYnbl09Co_fQY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215620-CountryStyleSteak-ddmfs-Step4-3x4-7733-5eaaf164b37a45879469186f7455848e.jpg"
      ],
      "image": "assets/images/215620/step_04.webp"
    },
    {
      "text": "Whisk retained seasoned flour into beef broth until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/18HqiQlUZf_Hwc_drw-KCaEdGPY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215620-CountryStyleSteak-ddmfs-Step5-3x4-7736-45be9108d02a4e2896b1e65638a1f54b.jpg"
      ],
      "image": "assets/images/215620/step_05.webp"
    },
    {
      "text": "Pour broth over steaks. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BGk7lWmA3LGZgEds1gGhaZdUhIk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215620-CountryStyleSteak-ddmfs-Step5-3x4-7739-422793f73d6d45fb889c32d77df6fc9d.jpg"
      ],
      "image": "assets/images/215620/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until the meat is tender and the gravy has thickened, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CMLK-2X6qNQDaoi17QQF9g6GETw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/215620-CountryStyleSteak-ddmfs-3x4-7796-198409aa4be845e68c65c93614ef6a3e.jpg"
      ],
      "image": "assets/images/215620/step_07.webp"
    }
