  "ingredients": [
    "0.5 cup olive oil",
    "0.25 cup lemon juice",
    "4 green onions, thinly sliced",
    "1 tablespoon chopped fresh parsley",
    "1 teaspoon chopped fresh rosemary",
    "1 teaspoon chopped fresh thyme",
    "0.5 teaspoon salt",
    "0.125 teaspoon black pepper",
    "0.125 teaspoon garlic powder",
    "3 pounds salmon fillets"
  ],
  "steps": [
    {
      "text": "Combine olive oil, lemon juice, green onions, parsley, rosemary, thyme, salt, black pepper, and garlic powder in a small bowl; reserve 1/4 cup for basting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon fillets in a shallow dish and pour remaining marinade on top. Cover and refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove fillets from the refrigerator; discard marinade. Place fillets on the preheated grill skin-side down. Cook, basting occasionally with reserved marinade, until fish flakes easily with a fork, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
