  "ingredients": [
    "0.75 cup uncooked basmati rice",
    "5 cups water",
    "0.25 cup butter",
    "3 pounds sweet onions, coarsely chopped",
    "1 cup half-and-half cream",
    "1.5 teaspoons salt",
    "2 cups shredded Swiss cheese, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water to a boil in a large saucepan, and sprinkle in rice. Stir, reduce heat to low, and simmer rice until it is half-cooked about 5 minutes. Drain rice, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat, and cook and stir onions until translucent but not browned, about 8 minutes. Mix cooked onions and butter in the skillet with rice; stir in half-and-half, salt, and 1 3/4 cup of Swiss cheese. Transfer mixture to the prepared baking dish, and sprinkle remaining 1/4 cup Swiss cheese over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered in the preheated oven until rice is tender and top is lightly browned, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
