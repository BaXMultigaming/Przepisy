  "ingredients": [
    "1.5 cups oat bran",
    "1.5 cups all-purpose flour",
    "0.5 cup dark brown sugar",
    "2 teaspoons baking powder",
    "2 teaspoons baking soda",
    "0.5 teaspoon salt",
    "1 cup chilled applesauce",
    "2 large eggs",
    "0.25 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Line or grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend together oat bran, flour, brown sugar, baking powder, baking soda, and salt in a large bowl. Add chilled applesauce, eggs, and oil; mix until well blended. Spoon batter into the prepared muffin cups. Let stand for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted into the center of muffins comes out clean, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
