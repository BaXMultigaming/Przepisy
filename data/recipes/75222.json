  "ingredients": [
    "1 quart oil for deep frying",
    "1 cup all-purpose flour",
    "0.66666668653488 cup yellow cornmeal",
    "0.25 cup white sugar",
    "1.5 teaspoons baking powder",
    "1 teaspoon salt",
    "2 tablespoons bacon drippings",
    "1.25 cups buttermilk",
    "1 egg, beaten",
    "0.5 teaspoon baking soda",
    "2 pounds hot dogs",
    "wooden sticks"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer to 365 degrees F (185 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cornmeal, sugar, baking powder, and salt together in a large bowl; stir in bacon drippings. Make a well in center; stir buttermilk, egg, and baking soda into well until smooth and well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat hot dogs dry with paper towels; insert wooden skewers into hot dogs. Dip hot dogs into buttermilk batter, one at a time, shaking off excess. Deep fry in hot oil in batches a few at a time until deep golden brown. Drain on paper towels or serve on paper plates.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
