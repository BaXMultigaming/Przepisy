  "ingredients": [
    "1 (3.5 ounce) package ramen noodles (flavor packet discarded)",
    "1.25 cups water, divided",
    "1 tablespoon sesame oil",
    "1 teaspoon minced fresh ginger root",
    "4 cloves garlic, minced",
    "0.5 teaspoon Sriracha sauce, or to taste",
    "1 teaspoon hoisin sauce",
    "1 pinch red pepper flakes",
    "1 pinch toasted sesame seeds",
    "1 pinch black sesame seeds"
  ],
  "steps": [
    {
      "text": "Add water minus 2 tablespoons to a saute pan and bring to a boil over medium-high heat. Cook ramen in the boiling water until softened, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Keep water at a simmer, using tongs to carefully flip noodles over. Noodles should be soft and come apart fairly easily.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once water has nearly evaporated, add sesame oil, ginger, and garlic. Cook until fragrant, about 1 minute. Add reserved 2 tablespoons water, Sriracha, and hoisin sauce; mix well with noodles. Serve immediately topped with red pepper flakes, toasted sesame seeds, and black sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
