  "ingredients": [
    "6 medium potatoes",
    "0.5 cup white sugar",
    "2 large eggs, beaten",
    "1 teaspoon cornstarch",
    "salt to taste",
    "1 (5 ounce) can evaporated milk",
    "0.5 cup vinegar",
    "1 teaspoon prepared yellow mustard",
    "0.25 cup butter",
    "1 cup mayonnaise",
    "6 large hard-cooked eggs, diced",
    "1 small onion, finely chopped",
    "1 cup celery, chopped",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain and set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SLa4DBzJWV7WDOH1r5SMyO3M1OI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86662-Worlds-Best-Potato-Salad-ddmfs-4x3-step1-8adf9292d721499fa2133dca0d1149c7.jpg"
      ],
      "image": "assets/images/86662/step_01.webp"
    },
    {
      "text": "While the potatoes are cooking, whisk together sugar, 2 beaten eggs, and cornstarch in a saucepan; season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2bGXPsurGhh2s1Weyt24X-fmYAI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86662_WorldsBestPotatoSalad_ddms_4x3_step2.1-80fbbed7471149b3bb114fded0fa1067.jpg"
      ],
      "image": "assets/images/86662/step_02.webp"
    },
    {
      "text": "Stir in milk, vinegar, and mustard. Cook and stir over medium heat until thickened, about 10 minutes. Remove from heat and stir in butter. Refrigerate until cool, then stir in mayonnaise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B5vmb5BCiPWbhXQLIXujJ29cKJQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86662-WorldsBestPotatoSalad-ddms-4x3-step2-3-4716cec7f76d4bca9195844e07f5e1c1.jpg"
      ],
      "image": "assets/images/86662/step_03.webp"
    },
    {
      "text": "Peel and dice potatoes. Transfer to a large bowl; toss with hard-cooked eggs, onion, celery, and 1 teaspoon salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O2EyrW38WbzDd4HVhG8Lq3INGeA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86662-WorldsBestPotatoSalad-ddms-4x3-step3-ba92cd93ea6541128266f9f091354284.jpg"
      ],
      "image": "assets/images/86662/step_04.webp"
    },
    {
      "text": "Stir dressing gently into the bowl of potato salad until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QV2NtZbvHi1m8ArlUfAG6DsqQIo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86662-WorldsBestPotatoSalad-ddms-4x3-step4-087d6c43aff44b6da4141c79bc61b72f.jpg"
      ],
      "image": "assets/images/86662/step_05.webp"
    },
    {
      "text": "Chill before serving, 3 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MsqscGbORNnBEyu4zitZefhGabo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86662_Worlds-Best-Potato-Salad_ddmfs_4x3_0984-c6a9a6eb6b30483b8f8caa731ea77d61.jpg"
      ],
      "image": "assets/images/86662/step_06.webp"
    }
