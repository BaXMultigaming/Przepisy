  "ingredients": [
    "1 pound boneless pork loin, cubed",
    "1 (1 ounce) package taco seasoning mix",
    "2 tablespoons vegetable oil",
    "1 cup salsa",
    "4 tablespoons peach preserves"
  ],
  "steps": [
    {
      "text": "Season pork with taco seasoning. Heat oil in a large skillet over medium-high heat. Add pork; cook until browned, 5 to 7 minutes. Stir in salsa and peach preserves until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the skillet; reduce the heat. Simmer gently for about 10 minutes, then serve.",
