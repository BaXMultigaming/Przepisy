  "ingredients": [
    "1 (3 1/2) pound boneless pork butt, trimmed of excess fat and cut into big chunks",
    "0.75 cup chicken broth",
    "0.5 cup orange juice",
    "0.25 cup lime juice",
    "0.25 cup lemon juice",
    "1 onion, cut into big chunks",
    "1 jalapeno pepper, halved",
    "1 head garlic, cloves separated and peeled",
    "1.5 teaspoons salt",
    "1 teaspoon dried oregano",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon smoked paprika",
    "2 bay leaves"
  ],
  "steps": [
    {
      "text": "Combine pork, chicken broth, orange juice, lime juice, lemon juice, onion, jalapeno, garlic, salt, oregano, black pepper, cumin, paprika, and bay leaves in a slow cooker. Stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until pork shreds easily with a fork, 8 to 10 hours.",
