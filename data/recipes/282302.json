  "ingredients": [
    "avocado oil cooking spray",
    "1.75 cups all-purpose flour",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon pumpkin spice",
    "0.125 teaspoon baking soda",
    "0.125 teaspoon salt",
    "0.25 cup brown sugar",
    "2 tablespoons unsalted butter, softened",
    "0.5 cup pumpkin puree",
    "1 large egg, at room temperature",
    "2 tablespoons pumpkin syrup (such as Torani®)",
    "1 teaspoon vanilla extract",
    "1 tablespoon white sugar",
    "1 teaspoon pumpkin spice",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 350 degrees F (175 degrees C). Line air fryer basket with parchment paper and spray with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, pumpkin spice, baking soda, and salt into a bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter in a second bowl with an electric mixer until fluffy. Beat in pumpkin, egg, pumpkin syrup, and vanilla extract. Add flour mixture and beat until batter is just combined. Drop batter unto the prepared parchment paper using a medium-sized cookie scoop sprayed with nonstick cooking spray, making sure donut holes are not touching.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry until donut holes are cooked, 5 to 9 minutes. Air fry in batches if necessary. Cool for about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, pumpkin spice, and cinnamon in a small bowl. Spritz cooled donut holes with avocado oil and roll in sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
