  "ingredients": [
    "1 egg white",
    "1 teaspoon vanilla extract",
    "3 cups whole almonds",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon chili powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Lightly grease a 10x15-inch jelly roll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white and vanilla together in large bowl until frothy. Add almonds; toss to coat. Drain almonds in a mesh strainer to remove excess liquid, 5 to 10 minutes; return strained almonds to the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, brown sugar, cinnamon, chili powder, and salt in a separate bowl; sprinkle over almonds. Toss to evenly coat; spread in an even layer on the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until seasonings cling to almonds, about 1 hour, stirring every 20 minutes. Cool completely before storing in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
