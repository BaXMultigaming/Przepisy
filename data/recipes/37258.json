  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine pumpkin, apple butter, 1/4 cup brown sugar, cinnamon, nutmeg, and salt. Stir in eggs and evaporated milk. Pour into prepared pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 50 to 60 minutes, or until a knife inserted 2 inches from the center comes out clean. Sprinkle streusel topping over the pie, and bake for an additional 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the streusel topping: In a small bowl, combine butter, flour, and 1/3 cup brown sugar. Stir until mixture resembles coarse crumbs. Stir in pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
