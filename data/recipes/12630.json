  "ingredients": [
    "1 cup all-purpose flour",
    "0.66670000553131 cup white sugar",
    "0.66670000553131 cup chopped pecans",
    "0.5 cup rolled oats",
    "2 eggs",
    "0.5 cup butter, melted",
    "0.25 teaspoon vanilla extract",
    "0.66670000553131 cup semisweet chocolate chips",
    "1 (10 inch) pie crust, baked and cooled"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix flour, sugar, pecans and oatmeal. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, mix eggs, melted butter and vanilla. Add to the dry mixture and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold in chocolate chips. Spoon into a pre baked 10 inch pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (165 degrees C) for 25 minutes. It will still appear quite moist, but it will set up after it is removed from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
