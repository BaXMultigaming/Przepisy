  "ingredients": [
    "0.25 cup unsalted butter",
    "3 cups fresh pumpkin, cut into 1/2-inch cubes",
    "0.33333334326744 cup white sugar",
    "0.75 cup maple syrup",
    "1 tablespoon minced fresh ginger",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Melt the butter in a large skillet over medium-low heat. Cook the pumpkin in the butter until tender, about 20 minutes. Add the sugar and stir until dissolved. Stir in the syrup, ginger, and cinnamon; remove from heat and allow to cool. Transfer to a bowl and cover. Refrigerate at least 2 hours before serving.",
