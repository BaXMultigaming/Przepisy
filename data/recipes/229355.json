  "ingredients": [
    "2 cups all-purpose flour",
    "2 tablespoons white sugar",
    "4 teaspoons baking powder",
    "0.5 teaspoon cream of tartar",
    "0.5 teaspoon salt",
    "0.5 cup vegetable shortening",
    "1 egg",
    "0.66666668653488 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sugar, baking powder, cream of tartar, and salt into a bowl. Use a pastry cutter to chop vegetable shortening into the flour mixture until it resembles coarse crumbs. Whisk egg and milk together in a separate bowl and slowly add milk mixture to flour mixture, stirring as you pour, until dough is moistened and well-mixed. Drop dough by spoonfuls onto an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until biscuits have risen and are golden brown, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
