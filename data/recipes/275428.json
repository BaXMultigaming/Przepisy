  "ingredients": [
    "1 cup sliced green bell pepper",
    "1 cup sliced red bell pepper",
    "1 cup sliced red onion",
    "1 tablespoon olive oil",
    "0.5 teaspoon kosher salt",
    "2 tablespoons chopped fresh cilantro",
    "1 tablespoon fresh lime juice"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine peppers, onion, olive oil, and salt in a large bowl. Transfer mixture to the air fryer basket. Cook, stirring once, until peppers and onion are tender and beginning to brown, 7 to 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a serving bowl. Add cilantro and lime juice; toss to coat.",
