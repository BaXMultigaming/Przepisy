  "ingredients": [
    "1 pound carrots, grated",
    "4 eggs",
    "0.25 cup all-purpose flour",
    "0.25 cup bread crumbs or matzo meal",
    "1 clove garlic, minced",
    "0.5 teaspoon salt",
    "1 pinch ground black pepper",
    "2 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Mix grated carrots, eggs, flour, bread crumbs, garlic, salt, and pepper together in a medium mixing bowl until well combined. Form into patties.",
