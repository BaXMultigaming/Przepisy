  "ingredients": [
    "2 cups all-purpose flour",
    "0.75 teaspoon baking soda",
    "1 pinch salt",
    "0.75 cup shortening",
    "1 cup white sugar",
    "2 (3 ounce) packages instant lemon pudding mix",
    "3 eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour with baking soda and salt. Cream shortening, and then add sugar and pudding mix. Cream until light and fluffy. Add eggs and mix well; then add flour mixture. Mix until well-blended. Drop teaspoonfuls of dough onto greased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
