  "ingredients": [
    "2 cups graham cracker crumbs",
    "0.5 cup butter, melted",
    "0.25 cup white sugar",
    "1 cup semisweet chocolate chips",
    "1 cup flaked coconut",
    "1 cup chopped pecans",
    "1 (14 ounce) can sweetened condensed milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham cracker crumbs, melted butter, and sugar. Press into the bottom of a 9x9-inch baking pan. Layer chocolate chips, coconut, and pecans over the crumbs. Pour sweetened condensed milk over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes. Let cool and cut into squares.",
      "section": null,
      "name": null,
