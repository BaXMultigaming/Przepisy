  "ingredients": [
    "6 green onions, chopped",
    "1 onion, chopped",
    "1 jalapeno pepper, seeded and minced",
    "0.75 cup soy sauce",
    "0.5 cup distilled white vinegar",
    "0.25 cup vegetable oil",
    "2 tablespoons brown sugar",
    "1 tablespoon chopped fresh thyme",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground allspice",
    "1.5 pounds skinless, boneless chicken breast halves",
    "lime wedges"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1adzj_cAcAclAgv50MbZt5JTto4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8667-jays-jerk-chicken-VAT-005-step-01-3edeca5b450641fea04f25d8d68420bc.jpg"
      ],
      "image": "assets/images/8667/step_01.webp"
    },
    {
      "text": "Combine green onions, onion, chile pepper, soy sauce, vinegar, vegetable oil, brown sugar, thyme, cloves, nutmeg, and allspice in a food processor or blender; process for about 15 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/89-SjTWHwpVeNe10uXWrBn1woVU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8667-jays-jerk-chicken-VAT-006-step-02-5bb5c0898b5147ff82c6dcf7c738e97a.jpg"
      ],
      "image": "assets/images/8667/step_02.webp"
    },
    {
      "text": "Place the chicken in a medium bowl, and coat with the marinade. Cover and refrigerate for 4 to 6 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wd3GtDXoEVm7I5zTMWDQCABYm38=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8667-jays-jerk-chicken-VAT-007-step-03-501433b16389463a8e7bb3b65ee614b0.jpg"
      ],
      "image": "assets/images/8667/step_03.webp"
    },
    {
      "text": "Preheat grill for high heat. Lightly oil grill grate. Cook chicken breasts on the prepared grill until no longer pink in the center and the juices run clear, about 8 to 10 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iejvdTmata_PebdzSH9o_qjvYZk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8667-jays-jerk-chicken-VAT-008-step-04-f3befa054ec0452ba4351854ee580c5e.jpg"
      ],
      "image": "assets/images/8667/step_04.webp"
    },
    {
      "text": "Transfer chicken to a platter and serve with lime wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n1fRRnVYITxHZC1CEhAJhlp2zH4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8667-jays-jerk-chicken-VAT-009-step-05-bd6451f228744545952b73b6c5ca6125.jpg"
