  "ingredients": [
    "4 (6 ounce) fillets boneless, skinless rainbow trout",
    "2 teaspoons soy sauce",
    "1 teaspoon white sugar",
    "salt and pepper to taste",
    "1 teaspoon olive oil",
    "4 green onions, chopped",
    "1 teaspoon minced garlic",
    "1 teaspoon minced fresh ginger"
  ],
  "steps": [
    {
      "text": "Rub trout fillets with soy sauce. Season with sugar, salt, and pepper; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium-high heat. Add green onions, garlic, and ginger; cook and stir until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add trout fillets and cook until brown and crispy, about 3 minutes. Flip fillets over and continue cooking until fish flakes easily with a fork, about 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
