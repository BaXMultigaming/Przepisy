  "ingredients": [
    "1.5 tablespoons corn flour",
    "4.5 teaspoons chili powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon seasoned salt",
    "0.5 teaspoon paprika",
    "0.25 teaspoon cumin",
    "0.5 teaspoon garlic salt",
    "0.25 teaspoon sugar",
    "1 teaspoon dried minced onion",
    "0.5 teaspoon beef bouillon granules",
    "0.25 teaspoon ground red pepper",
    "1.3333333730698 pounds lean ground chuck",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "In a medium bowl, combine the corn flour, chili powder, onion powder, garlic powder, and seasoned salt. Stir in the paprika, cumin, garlic salt, and sugar. Blend in the onion, bouillon, and ground red pepper, stirring until all spices are well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble the ground chuck into a large skillet over medium heat. Cook, stirring, until browned. Remove from heat, rinse meat with hot water, and drain water and grease from beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return meat to skillet, and pour in seasoning. Stir in water. Reduce heat to medium-low, and simmer until most of the liquid has cooked away, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
