  "ingredients": [
    "2.5 cups all-purpose flour",
    "2 tablespoons baking powder",
    "1 teaspoon salt",
    "0.25 cup sugar",
    "0.25 cup butter or margarine",
    "1.5 cups leftover mashed potatoes",
    "1 egg, beaten",
    "0.33333334326744 cup cold water",
    "0.33333334326744 cup milk",
    "2 tablespoons milk, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the flour, baking powder, salt, and sugar. Cut in butter, until pieces of butter are no larger than peas. Use a fork to stir in mashed potatoes, breaking them up into chunks. Make a well in the mixture, and pour in egg, water and milk. Stir into a loose dough using the fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a floured surface, and knead for 6 or 8 times so the dough holds together. Pat the dough out to about 3/4 inch thickness, and cut into circles with a biscuit cutter or drinking glass. Place biscuits onto the prepared baking sheet. Brush the tops with 2 tablespoons milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 20 minutes in the preheated oven, or until bottoms are golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
