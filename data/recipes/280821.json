  "ingredients": [
    "1.5 pounds unpeeled golden baby potatoes, rinsed and dried thoroughly",
    "2 tablespoons olive oil",
    "2 cloves garlic, minced",
    "1 teaspoon chopped fresh rosemary, or to taste",
    "sea salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/88PBUZoBenUzD144Ik0W0LH4k9c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-280821-roasted-baby-potatoes-ddmfs-step1-3x4-2781-46704cfc72fd467f97144a34828106e3.jpg"
      ],
      "image": "assets/images/280821/step_01.webp"
    },
    {
      "text": "Combine potatoes, olive oil, garlic, rosemary, sea salt, and pepper in a bowl. Toss until potatoes are covered and garlic is evenly distributed. Transfer to a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/po3tXtv9Vv2mQWTKV8IFAYc1ENo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-280821-roasted-baby-potatoes-ddmfs-step2-3x4-2782-b997b5dc5edf4456ad59ec66034808e7.jpg"
      ],
      "image": "assets/images/280821/step_02.webp"
    },
    {
      "text": "Bake on the bottom rack of the preheated oven, shaking every 5 minutes to prevent burning, until potatoes are crispy on the outsides and fork-tender on the insides, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/68rcV5PcEzcTq2P_X9drjD7rbDs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-280821-roasted-baby-potatoes-ddmfs-step4-3x4-2803-209e7fb136a845cfa9c52e6344e3d727.jpg"
      ],
      "image": "assets/images/280821/step_03.webp"
    },
    {
      "text": "Enjoy!",
