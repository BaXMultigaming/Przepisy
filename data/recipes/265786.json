  "ingredients": [
    "0.5 cup melted butter",
    "2 ripe mangoes - peeled, pitted, and sliced",
    "0.5 cup white sugar",
    "2 tablespoons peach schnapps",
    "1 cup all-purpose flour",
    "0.75 cup white sugar",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1 pinch ground nutmeg",
    "0.75 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Pour melted butter into an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mangoes, 1/2 cup sugar, and peach schnapps together in a bowl. Layer mango slices over the butter in the baking dish and pour remaining juice over all.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, 3/4 cup sugar, baking powder, salt, and nutmeg together in a bowl. Add milk and stir batter to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour or drop batter evenly over the mango in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top layer is browned nicely, 45 to 50 minutes. Let rest about 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
