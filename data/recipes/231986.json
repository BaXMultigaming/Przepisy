  "ingredients": [
    "1 avocado, halved and pitted",
    "2 eggs",
    "1 pinch cayenne pepper",
    "salt and ground black pepper to taste",
    "0.25 cup crumbled cooked bacon",
    "1 tablespoon chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place each avocado half in a ramekin. Crack 1 egg into each avocado half; season with cayenne pepper, salt, and black pepper. Place the ramekins on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until egg is cooked through, about 15 minutes. Sprinkle each avocado with crumbled bacon and chives.",
      "section": null,
      "name": null,
      "url": null,
