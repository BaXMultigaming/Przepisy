  "ingredients": [
    "8 whole graham crackers, or as needed",
    "0.5 cup semisweet chocolate chips",
    "0.75 cup butter",
    "0.75 cup brown sugar",
    "1 teaspoon vanilla extract",
    "2 cups miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place graham crackers side-by-side to cover the bottom of a 9x13-inch pan. Sprinkle chocolate chips evenly over graham crackers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter, brown sugar, and vanilla in a heavy saucepan over medium heat until butter is melted and mixture starts to bubble. Pour mixture over chocolate chips and crackers. Sprinkle miniature marshmallows over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place baking pan under the broiler until lightly browned, 3 to 5 minutes. Remove from broiler, cool completely, and cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
