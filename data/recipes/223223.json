  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "1 cup sugar",
    "0.33333334326744 cup butter, softened",
    "1.25 cups apple butter",
    "1 egg",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x4-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, baking powder, salt, nutmeg, and cloves together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together with an electric mixer in a separate large bowl until smooth. Add apple butter and egg; continue beating until smooth. Stir in flour mixture until just combined. Fold in raisins and walnuts. Pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 40 to 50 minutes. Cool in the pan for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
