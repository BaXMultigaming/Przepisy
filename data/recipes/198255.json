  "ingredients": [
    "2 tablespoons unsweetened cocoa powder",
    "0.33333334326744 cup unsweetened shredded coconut",
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "0.25 cup unsweetened cocoa powder",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 cup very strongly brewed masala chai",
    "0.5 cup canola oil",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Spray an 8x8 inch baking pan with cooking spray, and dust lightly with the 2 tablespoons cocoa powder. Place the coconut in the jar of a blender, and pulse to mince; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together the flour, sugar, 1/4 cup cocoa powder, baking powder, and salt. Stir in the brewed chai, canola oil, and vanilla extract, just until all ingredients are moistened. Fold in the coconut. Spread the batter in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is no longer shiny, about 20 minutes. Allow to cool for 1 hour before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
