  "ingredients": [
    "2 cups all-purpose flour",
    "2 tablespoons seasoned salt",
    "1 tablespoon ground black pepper",
    "4 eggs",
    "80 unopened dandelion blossoms, stems removed",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Combine flour, seasoned salt, and pepper in a mixing bowl until evenly combined; set aside. Beat eggs in a mixing bowl, then stir in dandelion blossoms until completely coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Remove half of the dandelions from egg mixture, and allow the excess egg to drip away. Toss in flour until completely coated, then remove and toss between your hands to allow excess flour to fall away. Cook coated dandelions in the melted butter until golden brown, stirring occasionally, about 5 minutes. Drain on a paper towel-lined plate. Repeat with the remaining dandelions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
