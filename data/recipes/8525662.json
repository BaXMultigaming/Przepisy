  "ingredients": [
    "tablespoon olive oil",
    "1 pound Roma tomatoes",
    "2 medium carrots, peeled and cut into 3-inch pieces",
    "1 onion, diced",
    "1 red bell pepper, cut into strips",
    "1 zucchini, sliced",
    "7 cloves garlic, peeled",
    "1.5 teaspoons Italian seasoning",
    "salt to taste",
    "red pepper flakes to taste",
    "1 (16 ounce) package cavatappi pasta",
    "0.33 cup shredded Italian cheese blend"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread out tomatoes, carrots, onion, bell pepper, zucchini, and garlic on a baking sheet and drizzle with olive oil. Sprinkle with Italian seasoning, salt, and crushed red pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until vegetables are soft, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook cavatappi in the boiling water, stirring occasionally, until tender yet firm to the bite, 9 to 11 minutes. Drain pasta, reserving about 1/2 cup pasta water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cooked vegetables to a high-speed blender (such as a Vitamix®)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend on high until vegetables are smooth, 30 to 45 seconds. Thin vegetable puree with reserved pasta water if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss pasta with vegetable sauce. Sprinkle with cheese and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
