  "ingredients": [
    "2 cups fresh corn kernels",
    "1 habanero pepper, seeded and diced",
    "2 large eggs",
    "0.33 cup water",
    "0.33 cup honey",
    "0.67 cup all-purpose flour",
    "0.5 cup unsalted butter, melted",
    "0.33 cup cornmeal",
    "1 teaspoon kosher salt",
    "0.5 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Gather ingredients. Preheat the oven to 350 degrees F (175 degrees C). Generously butter a 9-inch pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KZm2qsElt_lHnCmSToVPlHH5p4I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8408184-habanero-honey-sweet-corn-cake-step-01-a5a0f34447bf4027a06b0f1a0df973f9.jpg"
      ],
      "image": "assets/images/8408184/step_01.webp"
    },
    {
      "text": "Combine fresh corn kernels, habanero pepper, eggs, water, and honey in a bowl. Puree with an immersion blender until almost smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OL0pAa7k_RLu_b4zInk_Lnv_m8s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8408184-habanero-honey-sweet-corn-cake-step-02-4e59895e59f646ffbcddaed356417ea5.jpg"
      ],
      "image": "assets/images/8408184/step_02.webp"
    },
    {
      "text": "Add flour, melted butter, cornmeal, salt, and baking powder; whisk until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UzBlDEd8AdCoSSvkcnHjqNdiuYQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8408184-habanero-honey-sweet-corn-cake-step-03-8934e0b5f9b940e5a4d12ee65d509074.jpg"
      ],
      "image": "assets/images/8408184/step_03.webp"
    },
    {
      "text": "Transfer mixture into the greased pie dish. Shake gently to settle mixture into the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0N-EkGuv7isDTfYEf3HDPEp3Z7g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8408184-habanero-honey-sweet-corn-cake-step-04-8ff81bc7050942408455fc5dc7eb5d66.jpg"
      ],
      "image": "assets/images/8408184/step_04.webp"
    },
    {
      "text": "Bake in the center of the preheated oven until golden brown and a wooden skewer inserted into the center of the cake comes out clean, 45 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bzH140h4p0CD3g7S_vqsxnn7_v4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8408184-habanero-honey-sweet-corn-cake-step-05-79dc3977672d4271bc487b99715e0547.jpg"
      ],
      "image": "assets/images/8408184/step_05.webp"
    },
    {
      "text": "Let cool until warm or room temperature before garnishing and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EuyIQKAYrhghUUV1DWjxplXz31w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8408184-habanero-honey-sweet-corn-cake-4x3-5b58968219eb490fb5c814db9b53d19a.jpg"
      ],
