  "ingredients": [
    "3 cups sliced fresh peaches",
    "1 cup white sugar",
    "1 tablespoon lemon juice",
    "1 teaspoon grated lemon zest",
    "0.25 teaspoon almond extract",
    "1.5 cups all-purpose flour",
    "1 tablespoon white sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "0.33333334326744 cup shortening",
    "0.5 cup milk",
    "1 egg, beaten",
    "2 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease an 8x8 inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sliced peaches in prepared baking dish. Mix together 1 cup sugar, lemon juice, lemon zest, and almond extract. Place in oven while preparing shortcake (heating peaches first helps prevent dough from getting soggy).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 1 tablespoon sugar, baking powder, and salt in a large bowl. Cut in shortening until mixture resembles coarse crumbs. Add milk and egg; stir just until flour is moistened. Spread over hot peaches. Sprinkle top with remaining sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 35 to 40 minutes, or until top is golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
