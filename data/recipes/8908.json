  "ingredients": [
    "4 cups fresh chopped broccoli",
    "4 skinless, boneless chicken breast halves - grilled",
    "2 cups shredded sharp Cheddar cheese",
    "0.5 cup dry bread crumbs",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1 cup white wine",
    "1 cup mayonnaise",
    "2 tablespoons curry powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C0.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine the cream of chicken soup, white wine, mayonnaise and curry powder. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a lightly greased 9x13 inch baking dish layer the casserole as follows: First, all of the broccoli, then 1/3 of the cheese, then all of the chicken, another 1/3 of the cheese, all of the white wine/soup mixture and, finally, top with the bread crumbs and the last 1/3 of the cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
