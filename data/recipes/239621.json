  "ingredients": [
    "1.5 cups pumpkin seeds",
    "3 tablespoons butter, melted",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "2 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 300 degrees F (150 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fa52nqhDX6P9xLX5IPg5SUZgQhM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-239621-cinnamon-toast-pumpkin-seeds-ddmfs-step01_7689-3034ce112e53421194226edf0595d722.jpg"
      ],
      "image": "assets/images/239621/step_01.webp"
    },
    {
      "text": "Place pumpkin seeds into a large bowl. Mix butter, cinnamon, and salt together in a small bowl; pour over seeds and toss until evenly coated. Spread seeds in a single layer on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MKyhqGPWGNSmSVOMGPQrWF5vexU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-239621-cinnamon-toast-pumpkin-seeds-ddmfs-step02_7692-f3d97088f5714f8e8b7f34e1557ae6bc.jpg"
      ],
      "image": "assets/images/239621/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven, stirring occasionally, until seeds are light golden brown, about 40 minutes. Remove from the oven; sprinkle sugar over warm seeds and stir until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YWpBmrVpt-ga05gU4DgWkx2fekk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-239621-cinnamon-toast-pumpkin-seeds-ddmfs-step04_7730-c82347887705457d92e7c05a7cbe8197.jpg"
      ],
      "image": "assets/images/239621/step_03.webp"
    }
  ],
