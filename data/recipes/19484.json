  "title": "Grilled Marinated Shrimp",
  "description": "A simple shrimp marinade made with lemon, garlic, parsley, and hot sauce adds flavor to juicy shrimp grilled on skewers for a great summer meal.",
  "authors": [
    "Robbie Rice"
  ],
  "date_published": "2000-06-13T06:28:17-04:00",
