  "ingredients": [
    "0.75 cup white sugar",
    "0.75 cup packed brown sugar",
    "2 eggs",
    "2.75 cups all-purpose flour",
    "1 teaspoon vanilla extract",
    "1 cup butter or margarine",
    "1 teaspoon baking soda",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the sugar, brown sugar, and eggs until creamy. Melt the butter or margarine in a saucepan over low heat and mix into the sugar along with the vanilla. Combine the flour and baking soda; stir into the batter until it becomes dough. Mix in chocolate chips. Drop by teaspoonfuls about 2 inches apart on ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 5 to 7 minutes, until browned at the edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
