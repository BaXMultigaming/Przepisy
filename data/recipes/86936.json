  "ingredients": [
    "1.5 pounds ground beef",
    "1 cup quick cooking oats",
    "6.5 ounces evaporated milk",
    "0.5 cup chopped onion",
    "1 egg, lightly beaten",
    "1 tablespoon chili powder",
    "1 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon pepper",
    "1 cup ketchup",
    "1 cup brown sugar",
    "1 tablespoon liquid smoke flavoring",
    "0.25 teaspoon minced garlic"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a medium-sized baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, oats, evaporated milk, 1/2 cup onion, egg, chili powder, salt, garlic powder, and pepper in a bowl. Form into 1 1/2 inch balls; arrange in a single layer in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ketchup, brown sugar, remaining 1/4 cup onion, liquid smoke, and garlic in a separate bowl; pour evenly over meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, uncovered, until an instant-read thermometer inserted into centers reads at least 160 degrees F (72 degrees C), about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
