  "ingredients": [
    "6 eggs",
    "0.5 (1 pound) loaf sourdough bread, cubed",
    "1 pound imitation crabmeat, flaked",
    "3 stalks celery, chopped",
    "0.5 small onion, chopped",
    "1 cup mayonnaise",
    "2 tablespoons sour cream",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Place eggs in a saucepan and cover with cold water. Bring water to a boil. Cover, remove from heat, and let eggs stand in hot water for 10 to 12 minutes. Remove from hot water, cool, peel and chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Trim crust from bread and dice into cubes. Discard crusts or reserve for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread cubes, eggs, imitation crab meat, celery, onion, mayonnaise, sour cream, salt, and pepper in a large bowl; mix well and refrigerate until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
