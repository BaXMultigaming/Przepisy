  "ingredients": [
    "cooking spray",
    "1 cup brown sugar",
    "0.66666668653488 cup vegetable oil",
    "2 eggs",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "3 cups oatmeal",
    "1 cup milk",
    "1 (21 ounce) can blackberry pie filling (such as Comstock®",
    "2 cups fresh strawberries, quartered"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream brown sugar, oil, eggs, baking powder, and salt together in a bowl until smooth. Add oatmeal and milk and mix until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer blackberry pie filling and strawberries in the bottom of the prepared pan. Add oatmeal mixture over fruit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, about 30 minutes.",
      "section": null,
