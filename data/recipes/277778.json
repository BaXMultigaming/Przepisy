  "ingredients": [
    "1 cup butter-flavored shortening",
    "0.5 cup white sugar",
    "0.5 cup light brown sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups rolled oats",
    "1 cup shredded coconut",
    "0.75 cup drained, dried, and chopped maraschino cherries",
    "0.5 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat shortening, white sugar, and brown sugar together in a bowl with an electric mixer until creamy and fluffy. Add eggs and vanilla extract; stir until well incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, baking soda, and salt together in another bowl; add to sugar mixture, blending until an even dough forms. Add oats, coconut, cherries, and chocolate chips until just mixed in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop rounded tablespoons of dough onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the edges are brown, 8 to 10 minutes. Let rest for 5 minutes, then transfer to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
