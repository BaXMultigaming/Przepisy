  "ingredients": [
    "6 large apples - peeled, cored, and cubed",
    "1 tablespoon white sugar",
    "0.25 teaspoon ground cinnamon",
    "0.25 cup rice flour",
    "3 tablespoons almond meal",
    "2 tablespoons white sugar",
    "2 tablespoons flaked coconut",
    "1.5 tablespoons butter or margarine, softened"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Arrange apple pieces in a baking dish. Sprinkle with sugar, and cinnamon; toss well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, combine the rice flour, almond meal, sugar, and coconut. Cut in butter until mixture is fine and crumbly. Sprinkle topping over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake for 1 hour in the preheated oven, until the apples have lost their shape. Uncover, and continue to bake until crumble is crisp and golden in color.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
