  "ingredients": [
    "0.33333334326744 cup peanut butter",
    "3 tablespoons butter, melted",
    "0.25 cup brown sugar",
    "2 tablespoons honey",
    "1 tablespoon corn syrup",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "3 tablespoons unsweetened applesauce",
    "1.6666667461395 cups old-fashioned oats",
    "0.33333334326744 cup all-purpose flour",
    "0.5 cup unsalted peanuts",
    "0.5 cup raisins",
    "0.5 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir peanut butter and melted butter together in a bowl until smooth. Add brown sugar, honey, corn syrup, vanilla extract, cinnamon, and salt; stir. Mix applesauce into peanut butter mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats and flour in a bowl; toss to coat oats with flour. Stir peanuts and raisins into oat mixture. Pour peanut butter mixture over the oat mixture; stir to coat completely. Spread mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Sprinkle chocolate chips over the top and continue baking until chocolate melts and edges begin to brown, about 5 minutes more. Spread melted chocolate chips with the back of a spoon or a rubber spatula to coat the top. Cool completely before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
