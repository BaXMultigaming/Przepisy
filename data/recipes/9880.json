  "ingredients": [
    "2 cups pureed dates",
    "2 cups white sugar",
    "2 teaspoons baking powder",
    "4 eggs",
    "2 cups ground pecans",
    "1.5 cups cake flour",
    "0.5 teaspoon salt",
    "0.5 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix dry ingredients except confectioner's sugar. Add nuts and dates.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Then add eggs which have been lightly beaten. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press mixture into ungreased cookie sheet as thin as possible. Bake for 15-20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut into 1 -2 inch squares while hot. Roll into balls as soon as the squares are cool enough to handle then roll in confectioner's sugar. Allow to cool completely before eating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
