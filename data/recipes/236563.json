  "ingredients": [
    "1 tablespoon olive oil",
    "1 large onion, chopped",
    "2 cloves minced garlic",
    "2 teaspoons grated fresh ginger",
    "1 green chile pepper, chopped",
    "1 tablespoon ground cumin",
    "2 teaspoons paprika",
    "1 teaspoon ground coriander",
    "1 teaspoon garam masala",
    "1 teaspoon ground turmeric",
    "0.5 teaspoon ground cayenne pepper",
    "4 cups chopped tomatoes",
    "4 cups cooked chickpeas (garbanzo beans)",
    "0.5 cup tomato sauce",
    "0.5 cup plain yogurt",
    "1 lemon, juiced",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Heat oil in a large saucepan over medium heat. Sauté onion, garlic, ginger, and green chile pepper in hot oil until onions are translucent, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7OUaHcJL3jVA2tB_bAVFrWoSRfw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236563-DeliciousChanaMasala-ddms-4x3-step1-1d70faccc38741af9d4b9d16d52a57a7.jpg"
      ],
      "image": "assets/images/236563/step_01.webp"
    },
    {
      "text": "Season onion mixture with cumin, paprika, coriander, garam masala, turmeric, and cayenne pepper; stir. Cook onion with spices until fragrant, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8LWiQil9i9GFLhsNMEJoMMTC4E0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236563_DeliciousChanaMasala_ddms_4x3_Step2-ec9d701ee66c4cde90bf1f2d6934ebf3.jpg"
      ],
      "image": "assets/images/236563/step_02.webp"
    },
    {
      "text": "Add tomatoes, chickpeas, and tomato sauce; stir and simmer until tomatoes soften, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vufT5e-iCTW7HdScUlGyoPvHp2g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236563-Delicious-Chana-Masala-ddmfs-4x3-step3-ac5619756a464dc89b3333ab03abe5c1.jpg"
      ],
      "image": "assets/images/236563/step_03.webp"
    },
    {
      "text": "Stir yogurt into mixture until the color of mixture is even; simmer until again hot, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FTLOvPsQz0L67eIG2XtAAnA_h2g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236563_DeliciousChanaMasala_ddms_4x3_Step4-2eae2e9838934d9ca28e3f6dbbfa839d.jpg"
      ],
      "image": "assets/images/236563/step_04.webp"
    },
    {
      "text": "Remove pan from heat; stir lemon juice and salt into mixture.",
      "section": null,
      "name": null,
