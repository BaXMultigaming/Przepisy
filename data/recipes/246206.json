  "ingredients": [
    "1 egg",
    "2 tablespoons all-purpose flour",
    "5 tablespoons dry bread crumbs",
    "2 tablespoons grated Parmesan cheese",
    "12 (1 ounce) sticks string cheese, halved and frozen",
    "olive oil, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a small bowl. Place flour in a separate small bowl. Toss bread crumbs and Parmesan cheese together in a another separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently press each cheese stick into flour to coat and shake off excess flour. Dip into egg, then press into bread crumb mixture. Place the breaded cheese sticks onto a baking sheet while breading the rest; do not stack. Coat each cheese stick with olive oil; cover baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crisp, about 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
