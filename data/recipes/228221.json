  "ingredients": [
    "1 pound broccoli, separated into florets",
    "2 tablespoons water",
    "4 teaspoons fresh lemon juice, divided",
    "3 tablespoons butter",
    "2 cloves garlic, minced",
    "1 pinch salt",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place broccoli florets in a large skillet over medium heat. Mix water and 2 teaspoons lemon juice together in a small bowl; pour mixture over broccoli. Cover and steam until broccoli is bright green and tender, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a small saucepan over medium-low heat; stir in garlic and salt. Reduce heat to low and sauté garlic until golden brown, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain cooked broccoli and return to skillet; sprinkle with remaining 2 teaspoons lemon juice; stir in garlic butter mixture. Sprinkle broccoli with black pepper and toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
