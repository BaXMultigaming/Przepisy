  "ingredients": [
    "0.25 cup butter",
    "2 (8 ounce) whole trout, butterflied and deboned",
    "salt and freshly ground black pepper to taste",
    "2 tablespoons freshly squeezed lemon juice",
    "2 tablespoons chopped fresh flat-leaf parsley"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium-low heat until butter smells toasted and is golden brown, about 1 minute. Turn off heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ta9_322sjabsIhxdnNZ4X6-tWqc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235851-how-to-cook-trout-step-1-0806-4x3-51f86f8bc23f4aa7b3632dad067cd2df.jpg"
      ],
      "image": "assets/images/235851/step_01.webp"
    },
    {
      "text": "Line a baking sheet with a piece of aluminum foil. Place trout onto foil; open trout so skin sides are down. Drizzle each trout with about 1/2 teaspoon melted butter. Generously season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n7xF1auEqbFVXefwDXmYReoDQws=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235851-how-to-cook-trout-step-2-0808-4x3-1c8171c912b944aabb5de51026b07910.jpg"
      ],
      "image": "assets/images/235851/step_02.webp"
    },
    {
      "text": "Move an oven rack to 5 or 6 inches below the heat source and preheat the oven's broiler on high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil trout until opaque and barely firm to the touch, 2 or 3 minutes. Remove from oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ocm8oNbPjC_-KgZpMaYYG2Oz2Zc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235851-how-to-cook-trout-step-3-0809-4x3-bac49a527ea7402e89cd53bc07a1502c.jpg"
      ],
      "image": "assets/images/235851/step_04.webp"
    },
    {
      "text": "Return pan of remaining melted butter over high heat; stir in lemon juice and parsley. Bring butter sauce to a boil; whisk to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h0D_owhzoxM-1o_cFxejkvn4elg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235851-how-to-cook-trout-step-4-0811-4x3-c84a3c59c55445ebab6c5a009fb9fd57.jpg"
      ],
      "image": "assets/images/235851/step_05.webp"
    },
    {
      "text": "Serve trout on plates and drizzle with butter sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/21f52DWZ4o07ZVfYeLdS8YrGzvw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235851-how-to-cook-trout-DDMFS-4x3-eccffaf522f7447c9f7865751624b86a.jpg"
      ],
      "image": "assets/images/235851/step_06.webp"
    }
