  "ingredients": [
    "1 Granny Smith apple, cored and julienned",
    "1 cup balsamic vinaigrette salad dressing",
    "4 slices turkey bacon",
    "6 cups torn romaine lettuce",
    "1 cup crumbled blue cheese",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Place apple into a bowl with balsamic vinaigrette. Refrigerate for at least 1 hour to marinate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in the microwave or in a skillet over medium-high heat until browned. Drain and crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a salad bowl, combine romaine, blue cheese, pecans, and bacon; toss to blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to serve, pour apples and dressing over romaine mixture.",
      "section": null,
