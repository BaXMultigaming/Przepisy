  "ingredients": [
    "1 (15 ounce) can garbanzo beans",
    "4 ounces trimmed arugula",
    "1 tablespoon minced garlic",
    "0.25 cup crumbled feta cheese",
    "5 tablespoons grated Parmesan cheese, divided",
    "0.25 cup olive oil",
    "4 tomatoes, tops and pulp removed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a blender or food processor, blend the garbanzo beans, arugula, garlic, feta cheese, 4 tablespoons Parmesan cheese, and olive oil until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tomatoes in an 8x8 inch baking dish. Stuff the tomatoes with the garbanzo bean mixture. Sprinkle with remaining Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 20 minutes in the preheated oven, until bubbly and lightly browned.",
