    "2 tablespoons brown sugar",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon cider vinegar",
    "1 teaspoon garlic powder",
    "0.25 teaspoon mustard powder",
    "0.25 teaspoon salt",
    "1 dash hot pepper sauce"
