  "ingredients": [
    "1 (14.5 ounce) can chicken broth",
    "1.5 cups diced leftover cooked ham",
    "1 (15 ounce) can corn, drained",
    "1 (15 ounce) can navy beans, undrained",
    "0.25 cup chopped onion",
    "0.5 teaspoon dried parsley",
    "1 pinch ground thyme",
    "salt to taste",
    "1 pinch crushed red pepper flakes, or to taste",
    "2 dashes hot pepper sauce (such as Tabasco®)",
    "1 sprig fresh parsley, chopped"
  ],
  "steps": [
    {
      "text": "Heat broth in a saucepan over high heat. Add ham, corn, navy beans, and onion. Add dried parsley, thyme, salt, red pepper flakes, and hot sauce. Cook over high heat for 5 minutes. Reduce heat to low and cook about 5 minutes more. Finish with fresh parsley before serving.",
