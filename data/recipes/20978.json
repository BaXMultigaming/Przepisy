  "ingredients": [
    "2 quarts cider vinegar",
    "0.25 cup salt",
    "2 tablespoons cayenne pepper",
    "3 tablespoons red pepper flakes",
    "1 cup light brown sugar",
    "1 tablespoon hot pepper sauce"
  ],
  "steps": [
