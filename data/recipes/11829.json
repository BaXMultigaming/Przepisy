  "ingredients": [
    "1 (8 ounce) package angel hair pasta",
    "0.5 cup creamy peanut butter",
    "2 tablespoons soy sauce",
    "1 teaspoon grated fresh ginger",
    "0.5 cup chicken broth",
    "0.5 cup fresh bean sprouts",
    "1 red bell pepper, thinly sliced",
    "4 green onions, chopped",
    "1 pound skinless, boneless chicken breast halves - cut into cubes"
  ],
  "steps": [
    {
      "text": "Cook angel hair pasta in a large pot of boiling water until al dente, 6 to 8 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm a nonstick skillet over medium heat. Sauté bell pepper, green onions, and bean sprouts until tender-crispy. Transfer vegetables to a bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cubed chicken to the skillet; cook and stir over medium heat until done. Transfer chicken to a bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix peanut butter, soy sauce, and ginger in the skillet over medium-low heat. Stir in chicken broth. Add pasta, sautéed vegetables, and chicken. Toss to coat all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
