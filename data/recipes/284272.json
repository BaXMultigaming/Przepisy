  "ingredients": [
    "4 (14.5 ounce) cans green beans, undrained",
    "1 cup water, or as needed",
    "2 ounces fatback, sliced into small rectangles",
    "2 cubes chicken bouillon",
    "1.5 teaspoons onion powder",
    "1 teaspoon garlic powder",
    "1 teaspoon seasoned salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Empty canned green beans with liquid into a large saucepan. Add enough water to just cover beans. Stir in fatback, bouillon, onion powder, garlic powder, seasoned salt, and pepper until well combined; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Boil for 10 minutes, then reduce heat to low and simmer for 30 more minutes.",
