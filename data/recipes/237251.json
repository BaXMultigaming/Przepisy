  "ingredients": [
    "1 tablespoon white wine vinegar",
    "1 tablespoon Dijon mustard",
    "1 tablespoon finely chopped fresh dill",
    "0.25 teaspoon finely chopped garlic",
    "1 squeeze lemon juice, or to taste",
    "2 tablespoons extra-virgin olive oil",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Stir vinegar and mustard together in a small bowl until smooth. Stir dill, garlic, and lemon juice into vinegar mixture. Slowly stream olive oil into mixture while whisking continuously until dressing is creamy and smooth. Season with salt and pepper.",
