  "ingredients": [
    "4 boneless pork loin chops, cut 1/4 inch thick",
    "4 (7 inch) French bread baguettes, split lengthwise",
    "4 teaspoons mayonnaise, or to taste",
    "1 ounce chile sauce with garlic",
    "0.25 cup fresh lime juice",
    "1 small red onion, sliced into rings",
    "1 medium cucumber, peeled and sliced lengthwise",
    "2 tablespoons chopped fresh cilantro",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork chops on a broiling pan. Cook in the preheated broiler until browned on each side, about 5 minutes, flipping once.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide and spread mayonnaise on inside tops and bottoms of rolls. Place one pork chop into each roll; spread chili sauce on top pork. Divide and drizzle with 1/2 lime juice; divide and top with onion, cucumber, cilantro, salt, and black pepper. Divide and drizzle with remaining 1/2 lime juice.",
      "section": null,
      "name": null,
