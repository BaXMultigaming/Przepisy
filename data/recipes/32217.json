  "ingredients": [
    "4 cups water",
    "4 cups distilled white vinegar",
    "2 tablespoons salt",
    "10 drops red food coloring",
    "10 links smoked beef sausage"
  ],
  "steps": [
    {
      "text": "Inspect one quart-sized jar for cracks and ring for rust, discarding any defective ones. Immerse in simmering water for 5 minutes. Wash new, unused lid and ring in warm soapy water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring water, vinegar, salt, and food coloring to a boil in a large pot over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "At the same time, cut sausage links in half or thirds, depending on size.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sausage links into the sterilized jar. Pour in as much hot vinegar mixture as needed to fill the jar, then secure the lid and immediately place into the refrigerator. Serve after 2 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
