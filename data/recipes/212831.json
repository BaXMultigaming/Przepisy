  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 onion, sliced",
    "1 cup mayonnaise",
    "4 eggs",
    "3 tablespoons all-purpose flour",
    "salt and pepper to taste",
    "2 (16 ounce) bags frozen chopped broccoli, thawed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a skillet over medium heat. Add onion; cook and stir until softened and translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium-low; continue cooking and stirring onion until very tender and dark brown, 15 to 20 minutes more. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat mayonnaise, eggs, flour, salt, and pepper together in a large bowl. Stir in broccoli and onion. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until broccoli is tender, about 90 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
