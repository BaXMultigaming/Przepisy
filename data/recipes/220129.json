  "ingredients": [
    "1.5 teaspoons active dry yeast",
    "4.5 cups all-purpose flour, divided",
    "0.5 cup warm water (100 degrees F or 38 degrees C)",
    "1 (12 fluid ounce) can or bottle beer",
    "1.5 teaspoons fine salt",
    "all-purpose flour for dusting",
    "1 tablespoon cornmeal"
  ],
  "steps": [
    {
      "text": "Stir together yeast, 1/2 cup flour and warm water in a large bowl. Cover and let sit in a warm spot for about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir beer, remaining flour and salt into the bowl. Mix until all the flour is incorporated and forms a thick sticky dough that pulls away from the sides of the bowl. Cover and let rise in a warm spot for 2 hours, until doubled in size.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrape all the dough from the bowl with a rubber spatula, and place on a well-floured surface. Generously flour the top of the dough and form into a loaf shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle a baking sheet with cornmeal. Transfer loaf to the baking sheet and sprinkle the top with flour. Cover loosely with a towel and let rise for 30-40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a small loaf pan of warm water on a lower rack to humidify the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slash a long slit in the top of the loaf with a sharp knife or razor. Place the baking sheet on the rack above the pan of warm water in the oven. Bake for 35 minutes, until the loaf is golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a cooling rack. Let cool completely before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
