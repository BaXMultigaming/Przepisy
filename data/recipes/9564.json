  "ingredients": [
    "2 cups white sugar",
    "0.66666698455811 cup light corn syrup",
    "0.5 cup water",
    "3 tablespoons butter",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon baking soda",
    "2 cups crispy rice cereal",
    "1 cup cashews"
  ],
  "steps": [
    {
      "text": "Grease one 10x15 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan over medium heat, combine the sugar, corn syrup and water; bring to a boil, stirring constantly until sugar is dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue to cook, without stirring until a candy thermometer reads 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat; stir in butter, vanilla and baking soda. Add cereal and cashews; pour into prepared pan and allow to cool. Break into pieces and store in air tight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
