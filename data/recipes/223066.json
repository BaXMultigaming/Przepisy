  "title": "Blueberry Banana Nut Bread",
  "description": "Traditional banana nut bread gets fancy with the addition of blueberries. A brown sugar crumble topping is the final touch before it is baked to perfection.",
  "authors": [
    "Bratz"
  ],
  "date_published": "2020-06-18T23:50:06-04:00",
