  "ingredients": [
    "0.5 cup all-purpose flour",
    "1 tablespoon dried parsley",
    "1 teaspoon dried basil",
    "1.5 pounds skinless, boneless chicken breasts, cut into strips",
    "0.25 cup extra-virgin olive oil",
    "1 tablespoon minced garlic",
    "2.25 cups low-sodium chicken stock",
    "1 cup frozen mixed vegetables",
    "1 pint grape tomatoes, halved",
    "1 bunch green onions, diagonally sliced",
    "1 medium zucchini, quartered and sliced",
    "2 tablespoons sun-dried tomato pesto",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Whisk flour, parsley, and basil together in a medium bowl. Add chicken strips and toss well until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat. Add chicken and cook, turning occasionally, until lightly browned on the outside and no longer pink, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in garlic. Add chicken stock, mixed vegetables, grape tomatoes, green onions, zucchini, and pesto. Cook, stirring occasionally, until heated through, about 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
