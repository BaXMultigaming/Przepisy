  "ingredients": [
    "1 teaspoon smoked paprika",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon dried oregano",
    "0.25 teaspoon freshly ground black pepper",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon dried thyme",
    "2 pounds extra large shrimp, peeled and deveined",
    "2 tablespoons olive oil",
    "0.5 cup butter, cubed and at room temperature",
    "2 tablespoons minced fresh parsley",
    "6 lemon wedges (optional)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine smoked paprika, garlic powder, onion powder, salt, oregano, pepper, cayenne pepper, and thyme in a small bowl. Pat shrimp dry and place in a large bowl. Sprinkle with Cajun seasoning mixture and drizzle with olive oil. Toss to coat evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place shrimp in a single layer on a sheet pan without overcrowding.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven until shrimp are opaque in the middle, about 8 minutes. Immediately add butter to the hot pan and toss with shrimp until butter is melted. Sprinkle with parsley, if desired and serve with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
