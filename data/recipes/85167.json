  "ingredients": [
    "2 cups dry small elbow macaroni",
    "0.75 cup chopped celery",
    "0.25 cup chopped sweet onion",
    "1 (2 ounce) jar diced pimentos, drained",
    "1 medium sweet gherkin pickle, diced",
    "0.75 cup creamy salad dressing",
    "0.33333334326744 cup white sugar",
    "3 tablespoons apple cider vinegar",
    "2 tablespoons prepared yellow mustard",
    "1 teaspoon salt",
    "3 hard-cooked eggs, chopped"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook macaroni in boiling water until tender yet firm to the bite, 8 to 10 minutes. Drain and rinse under cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cooked macaroni, celery, sweet onion, pimentos, and pickle in a large serving bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together creamy salad dressing, sugar, vinegar, mustard, and salt in a medium bowl until smooth.; stir into macaroni mixture until evenly coated. Fold in eggs. Chill in the refrigerator for at least 2 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
