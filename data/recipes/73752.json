  "steps": [
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels, reserving bacon drippings in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add squash, onion, and jalapeño to the skillet. Fry until tender, but still firm, stirring frequently. Crumble bacon into the skillet; season with soy sauce, salt, and pepper. Stir to blend in seasonings and serve.",
