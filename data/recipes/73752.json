  "ingredients": [
    "2 slices bacon",
    "2 medium yellow squash, thinly sliced",
    "0.5 medium onion, thinly sliced",
    "1 jalapeno pepper, chopped",
    "1 dash soy sauce",
    "salt and pepper to taste"
