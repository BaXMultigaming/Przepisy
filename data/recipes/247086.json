  "ingredients": [
    "0.5 cup lightly packed brown sugar",
    "2 tablespoons olive oil",
    "3 eggs",
    "0.33333334326744 cup unsweetened applesauce",
    "1 teaspoon vanilla extract",
    "1.75 cups mashed bananas",
    "1.75 cups whole wheat flour",
    "1 teaspoon baking soda",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line the bottom of a 9x5-inch nonstick loaf pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and oil together in a large bowl until well-blended. Add eggs, applesauce, and vanilla extract; mix well to combine. Stir in mashed bananas. Add whole wheat flour and baking soda; stir until incorporated. Fold walnuts into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cover loaf with a clean towel and cool on a wire rack for 30 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
