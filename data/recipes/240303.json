  "ingredients": [
    "1 cup white sugar",
    "0.75 cup butter, softened",
    "1 egg",
    "0.5 cup pumpkin puree",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking powder",
    "2.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Beat sugar and butter together in a bowl using an electric mixer until smooth and creamy; beat in egg until smooth. Beat in pumpkin purée, vanilla extract, cinnamon, salt, and baking powder. Stir in flour just until combined. Refrigerate dough for 2 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough on a floured work surface. Cut into shapes using cookie cutters; arrange on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
