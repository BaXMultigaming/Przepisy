  "ingredients": [
    "2 apples, peeled and diced",
    "2 tablespoons white sugar",
    "1.5 tablespoons ground cinnamon, divided, or more to taste",
    "1 tablespoon melted butter",
    "1 egg white",
    "20 wonton wrappers"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine apples, sugar, 1 tablespoon cinnamon, and butter in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wet all edges of wonton wrappers with water. Place 1 tablespoon of apple mixture in center of each wonton. Fold all 4 corners of wonton to the middle. Squeeze together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush egg white onto the wonton wrappers and sprinkle with remaining cinnamon. Place wontons on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 15 minutes.",
