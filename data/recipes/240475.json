  "ingredients": [
    "1 (14 ounce) can unsweetened coconut milk",
    "2 tablespoons white sugar, or to taste",
    "1 teaspoon pure vanilla extract"
  ],
  "steps": [
    {
      "text": "Refrigerate can of coconut milk, 8 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place metal mixing bowl and beaters in the refrigerator or freezer 1 hour before making whipped cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Open can of coconut milk, taking care not to shake it. Scoop coconut cream solids into cold mixing bowl. Reserve remaining liquid for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat coconut cream using electric mixer with chilled beaters on medium speed; turn to high speed. Beat until stiff peaks form, 7 to 8 minutes. Add sugar and vanilla extract to coconut cream; beat 1 minute more. Taste and add more sugar if desired.",
      "section": null,
      "name": null,
