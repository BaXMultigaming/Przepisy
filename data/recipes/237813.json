  "ingredients": [
    "1 cup chopped cooked chicken",
    "0.5 cup barbeque sauce, divided",
    "1 (13.8 ounce) package refrigerated pizza dough",
    "2 tablespoons olive oil, or as needed",
    "1 cup shredded Colby-Monterey Jack cheese",
    "1 cup diced tomatoes, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chicken and 2 tablespoons barbecue sauce in a medium bowl until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out dough onto a work surface; cut in half to form 2 rectangles. Brush tops of dough with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place dough, oil-sides down, onto the preheated grill; cook until bottom is browned and top is bubbling up, about 5 minutes. Brush tops of dough with oil; flip.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread remaining barbecue sauce over crusts; top with chicken, cheese, and tomatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the grill; cook until cheese is melted, 2 to 3 minutes. Cool before slicing, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
