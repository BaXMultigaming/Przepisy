  "ingredients": [
    "1 cup whole wheat flour",
    "1 cup all-purpose flour",
    "0.33333334326744 cup wheat germ",
    "0.66666668653488 cup white sugar",
    "1 tablespoon baking powder",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "2 eggs, beaten",
    "2 cups half-and-half cream",
    "1 cup fresh blackberries",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Butter muffin pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, whisk together flours, wheat germ, sugar, baking powder, salt, and cinnamon. In another bowl, whisk together half and half cream and eggs. Stir wet ingredients into dry, mixing just to combine. Fold in berries. Scoop batter into muffin pan cups. If there are any empty cups, fill those halfway with water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 minutes, or until done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
