  "ingredients": [
    "3 cups freshly squeezed orange juice",
    "3 cups apple cider",
    "2 oranges, thinly sliced",
    "1 lime, thinly sliced",
    "4 (3 inch) cinnamon sticks",
    "8 whole cloves",
    "1 star anise",
    "2 tablespoons honey"
  ],
  "steps": [
    {
      "text": "Combine orange juice, apple cider, orange slices, lime slices, cinnamon sticks, cloves, and star anise in a large saucepan; bring to a boil over medium-high heat, about 5 minutes. Reduce heat to low, cover, and simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cinnamon sticks, cloves, and star anise. Stir in honey until dissolved. Keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour warm cider into cups. Garnish each with a cinnamon stick for stirring and several orange and lime slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
