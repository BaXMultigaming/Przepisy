  "ingredients": [
    "8 red potatoes, diced",
    "3 hard-boiled eggs, chopped",
    "1 cup mayonnaise, or to taste",
    "0.5 red onion, minced",
    "0.25 cup spicy brown mustard",
    "4 teaspoons sweet pickle relish",
    "1 teaspoon chopped fresh parsley",
    "1 teaspoon chopped fresh dill",
    "1 pinch ground black pepper",
    "1 pinch paprika"
  ],
  "steps": [
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain and run potatoes under cold water to cool.",
      "section": null,
      "name": null,
      "url": null,
