  "ingredients": [
    "1 tablespoon olive oil",
    "2 pounds beef stew meat",
    "0.5 cup beef broth",
    "0.25 cup Thai red curry paste",
    "1 yellow onion, sliced",
    "1 tablespoon light brown sugar",
    "2 teaspoons fish sauce",
    "8 ounces green beans, halved",
    "0.75 cup coconut milk, well shaken",
    "1 (9 ounce) package fresh spinach",
    "0.5 cup chopped fresh cilantro",
    "3 tablespoons lime juice"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Pour oil carefully into the hot skillet. Add beef in 2 batches and cook until browned, about 3 minutes per side. Place browned beef into the bottom of a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour beef broth into the skillet, scraping up browned bits. Transfer broth mixture to the slow cooker and add curry paste, onion, brown sugar, and fish sauce. Stir to combine. Cover and cook on Low for 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add green beans and coconut milk to the slow cooker. Increase temperature to High and cook for 12 minutes. Turn off heat and stir in spinach, cilantro, and lime juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
