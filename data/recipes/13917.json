  "ingredients": [
    "1 tablespoon butter",
    "1 tablespoon all-purpose flour",
    "1 cup half-and-half",
    "1.5 cups vegetable broth",
    "2.5 cups sliced carrots",
    "1 tablespoon chopped fresh parsley",
    "1 tablespoon chopped fresh basil",
    "1 teaspoon red pepper flakes",
    "salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Steam carrots until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a blender or food processor, combine cooked carrots and 3/4 cup broth. Blend until smooth. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan, melt butter over medium heat. Stir in flour, parsley, basil, and red pepper flakes. Add half-and-half cream all at once. Cook and stir until slightly thickened and bubbly. Stir in carrot mixture and remaining broth. Season with salt and black pepper. Thin with milk or water if needed.",
      "section": null,
