  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 teaspoon salt",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon dried marjoram",
    "0.25 teaspoon dried parsley",
    "0.25 teaspoon dried chives",
    "0.125 teaspoon dried dill weed",
    "0.125 teaspoon ground black pepper",
    "2 large eggs",
    "0.5 cup milk",
    "1 tablespoon German or deli-style mustard",
    "1 tablespoon butter",
    "1 tablespoon olive oil",
    "1 medium onion, diced",
    "4 ounces sliced fresh mushrooms",
    "1 quart chicken broth",
    "1 (8 ounce) package fresh spinach, shredded"
  ],
  "steps": [
    {
      "text": "Whisk flour, salt, oregano, marjoram, parsley, chives, dill, and pepper together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, eggs, and mustard together in a small bowl. Gradually mix in flour mixture until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of salted water to a boil over medium heat. Place a spaetzle maker over the boiling water and pour spaetzle dough into the slider basket. Run the basket back and forth until bits of dough fall into the boiling water. Boil spaetzle until firm, 2 to 3 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a Dutch oven over medium heat. Add olive oil, then onion. Sweat the onion for 3 to 4 minutes. Add mushrooms and saute until slightly browned, about 5 minutes. Add spaetzle and stir to combine. Cook until spaetzle is heated through and crispy in spots, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken broth and bring to a simmer. Stir in spinach and cook until wilted, 1 to 2 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
