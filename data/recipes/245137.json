  "ingredients": [
    "2 cups cooked rice",
    "1 (12 ounce) can evaporated milk (such as Carnation ®)",
    "1 cup raisins",
    "2 small eggs",
    "0.25 cup white sugar",
    "0.25 cup brown sugar",
    "1 tablespoon custard powder",
    "1 tablespoon vanilla extract",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk rice, evaporated milk, raisins, eggs, white sugar, brown sugar, custard powder, and vanilla extract together in a bowl; pour into the prepared dish. Sprinkle nutmeg over rice mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center of pudding comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
