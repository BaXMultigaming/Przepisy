  "ingredients": [
    "4 tostada shells",
    "1 (15.25 ounce) can black beans, rinsed and drained",
    "1 medium avocado, peeled and pitted",
    "2 tablespoons lime juice",
    "4 slices pepper Jack cheese",
    "1 tablespoon vegetable oil",
    "4 eggs",
    "0.25 cup salsa",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Divide tostada shells between 4 plates.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine back beans, avocado, and lime juice in a bowl. Gently stir to combine. Divide mixture between tostada shells. Top each tostada with a slice of cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a small skillet over medium-high heat. Crack an egg into the hot oil. Cook for 2 minutes. Flip and cook until set, 2 minutes more. Transfer egg to the top of one of the prepared tostada shells. Repeat with remaining eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top each egg with salsa. Season with salt and pepper to taste. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
