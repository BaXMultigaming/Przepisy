  "ingredients": [
    "2 tablespoons vegetable shortening",
    "0.25 cup all-purpose flour",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "0.5 teaspoon seasoned salt",
    "0.25 teaspoon pepper",
    "0.25 teaspoon salt",
    "4 skinless, boneless chicken breast halves",
    "0.5 cup chicken broth",
    "2 teaspoons brown sugar",
    "0.33333334326744 cup frozen orange juice concentrate"
  ],
  "steps": [
    {
      "text": "Heat the shortening in a skillet over medium-high heat. In a bowl, mix the flour, condensed soup, seasoned salt, pepper, and salt. Dip chicken in the mixture to coat, and fry in the skillet until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in a slow cooker. Mix the chicken broth, brown sugar, and orange juice concentrate in a bowl, and pour over chicken in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook 2 to 3 hours on Low or 1 to 2 hours on High.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
