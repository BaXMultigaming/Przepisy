  "ingredients": [
    "1.25 cups white sugar",
    "1 cup sour cream",
    "3 eggs",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "3 cups chopped fresh rhubarb",
    "1 (9 inch) unbaked pie shell",
    "0.33333334326744 cup white sugar",
    "0.33333334326744 cup all-purpose flour",
    "1 teaspoon ground cinnamon",
    "0.25 cup butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 ¼ cups sugar, sour cream, eggs and 2 tablespoons flour together in a large bowl until smooth; stir in vanilla and salt. Fold in rhubarb until incorporated; pour filling into pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine ⅓ cup sugar, ⅓ cup flour, and cinnamon in a small bowl; cut in butter with a fork or pastry blender until mixture resembles coarse crumbs. Set topping aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pie from the oven. Reduce the oven temperature to 350 degrees F (175 degrees C). Sprinkle topping over pie. Bake until filling is set and topping is golden brown, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
