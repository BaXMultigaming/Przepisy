  "ingredients": [
    "20 chicken wings",
    "2 tablespoons olive oil, or more as needed",
    "3 teaspoons garlic salt",
    "3 teaspoons ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Tuck in chicken wing flaps so wings form a triangle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine olive oil with some garlic salt and black pepper in a large bowl. Add a few chicken wings; toss to coat with seasonings. Add more wings, garlic salt, and black pepper; toss to coat. Repeat with remaining wings, garlic salt, and black pepper until all wings are coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, flipping several times and rearranging so they cook evenly, until wings are well browned, tender, no longer pink at the bones, and juices run clear, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
