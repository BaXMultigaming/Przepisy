  "ingredients": [
    "2 cups Make Ahead Cookie Mix",
    "0.5 cup white sugar",
    "2 tablespoons butter",
    "1 teaspoon vanilla extract",
    "1 egg",
    "0.5 cup chopped walnuts",
    "0.5 cup raisins",
    "0.25 cup maraschino cherries, chopped",
    "24 maraschino cherries, halved"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 cups of Make Ahead Cookie Mix with white sugar, egg, butter, and vanilla. Add nuts if desired. Stir in raisins and chopped maraschino cherries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into balls. Press half of a Maraschino cherry into each cookie and bake 11-16 minutes.",
