  "ingredients": [
    "4 (4 ounce) red snapper fillets",
    "3 tablespoons butter",
    "2 cloves garlic cloves, minced",
    "1 lemon, juiced",
    "1 sprig fresh dill, or more to taste",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place red snapper filets on the prepared baking sheet, skin side down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small saucepan over medium-low heat and saute garlic in the melted butter until softened, about 3 minutes. Squeeze lemon juice on top, straining out the seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush the snapper liberally with garlic butter mixture, coating both pieces and season with salt and pepper of desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish is opaque and firm to the touch, about 20 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
