  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "2 cups heavy cream",
    "1 cup milk",
    "2 (3.5 ounce) packages instant vanilla pudding mix",
    "1 cup water",
    "0.5 cup butter",
    "1 cup all-purpose flour",
    "0.25 teaspoon salt",
    "4 large eggs"
  ],
  "steps": [
    {
      "text": "Combine cream, milk, and pudding mix in a bowl; cover the bowl with plastic wrap and refrigerate to set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2895C_pkaN8ag2tWbKrtYoyqB58=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15869-CreamPuffs-ddmfs-step-1-103463-4x3-a8905ec50ff147a683a8f102a7702296.jpg"
      ],
      "image": "assets/images/15869/step_01.webp"
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and butter to a rolling boil in a large pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9IjGszEhDEFMMeoB4wczZEktwfU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15869-CreamPuffs-ddmfs-step-2-103471-4x3-6da87e290c7945f6b132d97b74d98eb4.jpg"
      ],
      "image": "assets/images/15869/step_03.webp"
    },
    {
      "text": "Stir in flour and salt until the mixture forms a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ft526G0f9YyI7I2G_7bJ23zseUA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15869-CreamPuffs-ddmfs-step-3-103472-4x3-e9e7042963c1483290cb9d41e905ba54.jpg"
      ],
      "image": "assets/images/15869/step_04.webp"
    },
    {
      "text": "Transfer dough to a large bowl; beat in eggs, one at a time, beating well after each using a wooden spoon or stand mixer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gsPKTxo43vw6jy9MSMXJVxL4UCI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15869-CreamPuffs-ddmfs-step-4-103481-4x3-db82d23881814237968b3be1128816e8.jpg"
      ],
      "image": "assets/images/15869/step_05.webp"
    },
    {
      "text": "Drop batter by tablespoonfuls onto an ungreased baking sheet, spaced about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ur8mnRskPbsJo9PlNAbdhX39Vvs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15869-CreamPuffs-ddmfs-step-5-103488-4x3-25c0e095a5cd45b08b921b1bb8058fdb.jpg"
      ],
      "image": "assets/images/15869/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until puffs are golden brown and centers are dry, 20 to 25 minutes. Let puffs cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_9NkTNY2nFIupg_H6gUBS9P0YKU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15869-CreamPuffs-ddmfs-step-6-103489-4x3-3e4f2529d6024332954c54e10a093f6f.jpg"
      ],
      "image": "assets/images/15869/step_07.webp"
    },
    {
      "text": "When puffs are cool, split and fill with pudding mixture, or pipe pudding into shells use a pastry bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wtiyK1gCbJlRbZWrU9pXyj2kRyU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15869-CreamPuffs-ddmfs-step-7-103496-4x3-b6f8de71c0974c37ba7608fe8582abc9.jpg"
      ],
      "image": "assets/images/15869/step_08.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cKAQgHlemMNGNZL5xqvPEwOYwhU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15869-cream-puffs-DDMFS-4x3-1ce08744f7354e81b8c88950f9d93888.jpg"
      ],
      "image": "assets/images/15869/step_09.webp"
    }
  ],
