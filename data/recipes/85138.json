  "ingredients": [
    "4 tablespoons olive oil",
    "2 tablespoons white wine vinegar",
    "1 tablespoon Dijon mustard",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 pinch white sugar",
    "1 teaspoon chopped fresh parsley",
    "1 teaspoon fresh lemon juice",
