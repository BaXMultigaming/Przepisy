  "ingredients": [
    "0.25 cup canola oil",
    "1 tablespoon onion powder",
    "1 tablespoon garlic powder",
    "1 cup uncooked white rice",
    "1.5 cups water",
    "1 (6.5 ounce) can tomato sauce"
  ],
  "steps": [
    {
      "text": "Heat canola oil in a skillet over medium-high heat; season with onion powder and garlic powder. Stir in rice and cook until golden, 2 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in water and tomato sauce; bring to a boil. Reduce heat to medium-low, cover, and simmer until rice is tender, about 15 minutes.",
