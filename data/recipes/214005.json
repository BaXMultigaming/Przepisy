  "ingredients": [
    "2 pounds ground smoked ham",
    "2 pounds ground pork",
    "2 cups crushed graham crackers",
    "1.5 cups evaporated milk",
    "3 eggs, beaten",
    "1 (10.75 ounce) can condensed tomato soup",
    "1 cup brown sugar",
    "0.5 cup white vinegar",
    "0.5 cup water",
    "1 tablespoon ground dry mustard"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a large baking sheet or jellyroll pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine smoked ham and ground pork in a large bowl until thoroughly mixed; lightly stir in graham crackers, evaporated milk, and eggs. Form mixture into two loaves; place loaves onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk tomato soup, brown sugar, vinegar, water, and dry mustard together in a saucepan over medium-low heat until well combined. Bring to a boil, stirring until brown sugar is dissolved. Pour about 1 cup sauce over loaves; reserve remaining sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 2 hours. Slice and serve ham loaves with reserved sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
