  "ingredients": [
    "2 (4 ounce) fillets flounder",
    "2 tablespoons lemon juice",
    "2 tablespoons chopped garlic",
    "2 teaspoons ground cumin",
    "1 teaspoon paprika",
    "0.5 cup all-purpose flour",
    "1 teaspoon dried dill weed",
    "0.25 teaspoon cayenne pepper, or to taste",
    "1 egg, beaten",
    "1 tablespoon water",
    "1 cup vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Place flounder fillets in a small glass dish. Mix lemon juice, garlic, cumin, and paprika in a small bowl; pour over flounder fillets. Cover dish with plastic wrap and marinate flounder in refrigerator for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, dill weed, and cayenne pepper together on a piece of waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg and water together in a wide bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently press the flounder fillets into the flour mixture to coat; shake to remove excess flour. Dip into the beaten egg to coat and immediately return to the flour mixture to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry flounder in hot oil until the fish flakes easily with a fork, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
