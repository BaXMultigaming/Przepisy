  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "1 cup uncooked quick oats",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "2 (8.25 ounce) cans mandarin orange segments, drained, liquid reserved",
    "0.25 cup vegetable oil",
    "0.25 cup milk chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease 12 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, oats, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Measure out 1 cup of reserved mandarin orange liquid; add liquid and vegetable oil to flour mixture and stir until batter is well-combined. Fold oranges and chocolate chips into batter. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
