  "ingredients": [
    "1.125 cups buttermilk",
    "3 cups bread flour",
    "1.5 teaspoons salt",
    "1.5 teaspoons white sugar",
    "0.75 cup shredded sharp Cheddar cheese",
    "1.5 teaspoons active dry yeast"
  ],
