  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "1 teaspoon salt",
    "0.25 teaspoon ground cinnamon",
    "1.5 cups quick cooking oats",
    "1 egg",
    "1 cup packed brown sugar",
    "0.5 cup vegetable oil",
    "0.5 cup milk",
    "1 teaspoon vanilla extract",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift the flour together with the soda, salt, and cinnamon. Stir in the oats. Combine the other ingredients and add them to the flour mixture, stirring thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by tablespoonful onto ungreased cookie sheet. Bake 15 to 18 minutes. Remove to wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
