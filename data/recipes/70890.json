  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "2 cups shredded extra-sharp Cheddar cheese",
    "0.33333334326744 cup mayonnaise",
    "1 pinch garlic powder",
    "1 (4 ounce) jar diced pimentos, drained"
  ],
  "steps": [
    {
      "text": "Beat cream cheese in a large bowl with an electric mixer on medium speed until creamy. Add cheese and mix until light and fluffy. Beat in mayonnaise and garlic powder; stir in pimentos until incorporated. Cover and chill in the refrigerator for at least 1 hour.",
