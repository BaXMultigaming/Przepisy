  "ingredients": [
    "1 (9 inch) prepared pie crust",
    "1 cup diced ham",
    "2.5 cups shredded mild Cheddar cheese",
    "1.25 cups milk",
    "4 eggs, whisked",
    "1 red bell pepper, diced, or more to taste",
    "1 medium onion, diced",
    "1 clove garlic, minced",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon white sugar",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pie crust in a 9-inch glass pie plate. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir ham in a large skillet over medium heat until it no longer looks moist, about 3 minutes. Remove from heat and cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cheese, milk, eggs, bell pepper, onion, garlic, black pepper, sugar, and salt in a large bowl until well combined. Stir in ham. Pour into the prepared pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden, the top is lightly browned, and filling is set, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
