  "ingredients": [
    "1 (16 ounce) package penne pasta",
    "2 medium carrots, shredded",
    "2 cups shredded kale",
    "1.5 cups cherry tomatoes, halved",
    "1 cucumber, chopped",
    "1 medium red bell pepper, chopped",
    "1 cup sliced black olives, drained",
    "0.5 shallot, chopped",
    "1 cup Greek salad dressing",
    "2 tablespoons mayonnaise"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain well.",
      "section": null,
