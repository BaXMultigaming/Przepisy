  "ingredients": [
    "cooking spray",
    "1 (15 ounce) can corned beef hash",
    "1 (14.5 ounce) package nacho-flavor tortilla chips",
    "1 cup shredded sharp Cheddar cheese",
    "1 (14 ounce) can black beans, drained",
    "1 (8 ounce) jar salsa",
    "1 large tomato, diced",
    "1 large yellow onion, diced",
    "1 cup sour cream",
