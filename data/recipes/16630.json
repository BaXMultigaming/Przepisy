  "ingredients": [
    "0.25 cup vegetable oil",
    "2 tablespoons red wine vinegar",
    "1.5 teaspoons white sugar",
    "0.5 teaspoon dried dill weed",
    "0.125 teaspoon salt",
    "0.125 teaspoon onion powder",
    "0.125 teaspoon garlic powder",
    "0.125 teaspoon dry mustard",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "In a blender, combine the oil, vinegar, sugar, dill weed, salt, onion powder, garlic powder, dry mustard and pepper. Blend until smooth, cover and refrigerate until chilled.",
