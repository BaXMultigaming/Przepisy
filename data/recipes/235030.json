  "ingredients": [
    "3 egg whites",
    "1 cup white sugar",
    "0.5 teaspoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a glass or metal bowl with an electric mixer until foamy. Gradually add sugar and lemon juice, continuing to beat until stiff peaks form. Lift the beater or whisk straight up: egg whites should hold sharp peaks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop meringue mixture by heaping teaspoonfuls onto a baking sheet, making little peaked mounds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned and dry on the outside yet soft and no longer gooey on the inside, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
