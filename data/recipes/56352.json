  "ingredients": [
    "1 (10 pound) prime rib roast",
    "10 cloves garlic, minced",
    "2 tablespoons olive oil",
    "2 teaspoons salt",
    "2 teaspoons ground black pepper",
    "2 teaspoons dried thyme"
  ],
  "steps": [
    {
      "text": "Gather all ingredients for marinade.",
      "section": null,
      "name": null,
