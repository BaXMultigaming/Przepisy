  "ingredients": [
    "0.5 cup olive oil",
    "6 fresh basil leaves",
    "8 ounces halloumi cheese, cut into cubes",
    "0.5 cup balsamic vinegar",
    "2 tablespoons honey",
    "20 cherry tomatoes",
    "metal skewers"
  ],
  "steps": [
    {
      "text": "Combine oil and basil leaves in a food processor; pulse to combine. Place halloumi cheese in a flat bowl. Pour basil-infused oil over the cheese. Toss to coat and let marinate 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vinegar and honey in a small saucepan over medium heat. Simmer until sauce begins to thicken, about 7 minutes. Turn heat off and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill to medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cherry tomatoes to the cheese and toss until coated. Thread cheese and tomatoes on skewers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place on the preheated grill. Grill for 3 minutes, flip and grill for 3 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer skewers to a serving platter. Drizzle with vinegar reduction and serve immediately. Garnish with additional basil if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
