  "ingredients": [
    "2 cups semisweet chocolate chips",
    "1 cup peanut butter",
    "4 cups miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Lightly grease a 9-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat chocolate chips and peanut butter over low heat in a medium saucepan until chocolate has completely melted. Remove from heat. Stir in marshmallows.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour chocolate and marshmallow mixture into prepared pan; cool in the refrigerator until set, at least 1 hour. Cut into squares and enjoy!",
