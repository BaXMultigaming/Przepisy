  "title": "Easy Broiled Chicken Breasts",
  "description": "These lemony broiled chicken breasts are a great dinner option when it's too cold or wet to fire up the outdoor grill.",
  "authors": [
    "Lane Baysden"
  ],
  "date_published": "2011-12-07T20:18:02-05:00",
