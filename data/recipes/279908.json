  "ingredients": [
    "0.5 cup salted butter",
    "0.25 cup vegetable oil",
    "1 small yellow onion, chopped",
    "1 clove garlic, minced",
    "2 tablespoons lemon juice",
    "1 teaspoon salt",
    "0.5 teaspoon ground paprika",
    "0.5 teaspoon ground ginger",
    "4 (4 ounce) skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, vegetable oil, onion, garlic, lemon juice, salt, paprika, and ginger in a small saucepan over medium heat. Stir until butter is completely melted, about 3 minutes. Reduce heat to low and simmer until onion is translucent, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in a baking dish and baste with the butter sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven, basting and turning every 10 minutes, until chicken is no longer pink in the center and the juices run clear, 30 to 40 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
