  "ingredients": [
    "4 pounds sweet potatoes, quartered",
    "3 cups miniature marshmallows, divided",
    "1.25 cups margarine",
    "1.25 cups brown sugar",
    "ground cinnamon to taste",
    "ground nutmeg to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7uHRbSF6BNQSKuE0A7LLRwLc8FE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-24330-candied-sweet-potatoes-Step-01-5d8fea307a9141a3b081cabc9f8e59de.jpg"
      ],
      "image": "assets/images/24330/step_01.webp"
    },
    {
      "text": "Bring a large pot of water to a boil. Boil sweet potatoes until almost tender, about 15 minutes. Drain and peel when cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VdKfZMpTMbhnEG4jUhqZhtmogJQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-24330-candied-sweet-potatoes-Step-03-5668553d92894ff3b91ab54a775f2361.jpg"
      ],
      "image": "assets/images/24330/step_02.webp"
    },
    {
      "text": "Combine 2 cups marshmallows, butter, sugar, cinnamon, and nutmeg together in a large saucepan over medium heat; cook, stirring occasionally, until marshmallows melt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PYo4TGbAJrxAA3hZAVxeibDttd8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-24330-candied-sweet-potatoes-Step-02-af97f9a9997e421e8c19ec8fcb48763f.jpg"
      ],
      "image": "assets/images/24330/step_03.webp"
    },
    {
      "text": "Stir sweet potatoes into marshmallow mixture, mashing some potatoes and breaking others into bite-sized chunks. Transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zgwnxEjgCV80-SMkIsqArZStmUA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-24330-candied-sweet-potatoes-Step-04-9a02e767325847bd88925002b9d13bb7.jpg"
      ],
      "image": "assets/images/24330/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WDTJfjNeba_7E3EhOb3RkusU3V0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-24330-candied-sweet-potatoes-Step-05-2f0269b738b74617b2b10dd39726b710.jpg"
      ],
      "image": "assets/images/24330/step_05.webp"
    },
    {
      "text": "Sprinkle remaining 1 cup marshmallows evenly potatoes; continue to bake until marshmallows are golden, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HYEHgI4WkibxfoXjVm8AXtbAHbs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-24330-candied-sweet-potatoes-4x3-2fa9956e26ef42d295516132449bd400.jpg"
      ],
      "image": "assets/images/24330/step_06.webp"
    }
