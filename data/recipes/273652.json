  "ingredients": [
    "1.5 teaspoons shortening (such as Crisco®), or as needed",
    "3 cups rolled oats",
    "1 cup white sugar",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.25 cup butter, melted and cooled",
    "2 eggs",
    "3 tablespoons milk",
    "1 teaspoon pure vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 cookie sheets with shortening.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oats, sugar, flour, baking soda, and salt in a medium bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter, eggs, milk, and vanilla in a large bowl; mix well. Add the oat mixture to the butter mixture; stir until incorporated. Roll the dough into walnut-sized balls and place 2 inches apart on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
