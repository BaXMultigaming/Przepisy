  "title": "Authentic Korean Bulgogi",
  "description": "This authentic Korean bulgogi beef recipe marinates tender beef in a complex sweet and salty blend of pear juice, soy sauce, garlic, and sesame seeds.",
  "authors": [
    "Minyoung"
  ],
  "date_published": "2009-03-17T21:49:17-04:00",
