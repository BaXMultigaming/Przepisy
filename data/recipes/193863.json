  "ingredients": [
    "1.5 pounds beef top sirloin, thinly sliced",
    "1 cup pear juice",
    "2 tablespoons white cooking wine",
    "1 teaspoon ground black pepper",
    "0.25 cup soy sauce",
    "2 tablespoons Asian (toasted) sesame oil",
    "2 tablespoons chopped green onion",
    "1 tablespoon white sugar",
    "1 tablespoon minced garlic",
    "1 tablespoon sesame seeds",
    "0.5 pound fresh mushrooms, halved",
    "0.5 onion, chopped"
  ],
  "steps": [
    {
      "text": "Place beef in a large glass or ceramic bowl. Add pear juice, cooking wine, and black pepper; stir to coat. Marinate for 30 minutes. Add soy sauce, sesame oil, green onion, sugar, garlic, and sesame seeds. Cover the bowl with plastic wrap; marinate in the refrigerator, 2 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove beef from marinade; shake off excess. Discard marinade. Place a sheet of aluminum foil on the preheated grill. Lay beef slices in a single layer on the foil. Place mushrooms and onion on another part of the foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until beef evenly brown, 3 to 5 minutes per side. Serve with cooked mushrooms and onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
