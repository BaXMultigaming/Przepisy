  "title": "Cornell Chicken",
  "description": "Dr. Baker&#39;s Cornell chicken recipe remains a favorite after more than 50 years. An easy seasoned apple cider marinade keeps it moist and flavorful.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-04-10T15:01:48-04:00",
