  "ingredients": [
    "2 large tomatoes, diced",
    "0.5 cup finely chopped red bell pepper",
    "0.25 cup finely chopped red onion",
    "0.25 cup balsamic vinegar",
    "0.25 cup olive oil",
    "10 leaves fresh basil, chopped",
    "2 cloves garlic, minced",
    "1 (1 pound) loaf French bread, cut into 1/4-inch slices",
    "0.25 cup olive oil",
    "0.25 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Combine tomatoes, bell pepper, onion, balsamic vinegar, 1/4 cup olive oil, basil, and garlic in a medium bowl; let tomato mixture rest for 15 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange French bread slices on a large baking sheet; drizzle with 1/4 cup olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast bread under the preheated broiler until lightly browned, about 1 minute per side. Remove from the oven and top bread slices with tomato mixture using a slotted spoon, allowing excess liquid to drain. Sprinkle with mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and broil until cheese melts, about 3 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
