  "ingredients": [
    "3 tablespoons vegetable oil",
    "1 cup long grain white rice",
    "2.5 cups chicken broth",
    "1 (4 ounce) can tomato sauce",
    "1 (4 ounce) can canned chopped green chiles, drained",
    "1 small onion, minced",
    "2 cloves garlic, minced",
    "1.5 teaspoons salt",
    "0.5 teaspoon ground cumin",
    "0.25 teaspoon chili powder",
    "1.5 cups shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a large skillet over medium heat. Stir in rice; cook and stir until rice is lightly browned and gives off a toasted fragrance, 5 to 7 minutes. Stir in the chicken broth, tomato sauce, green chiles, onion, garlic, salt, cumin, and chili powder. Bring to a boil, then reduce heat to low. Cover and simmer until rice is tender, about 25 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread Monterey Jack cheese on top, then replace the lid and allow cheese to melt, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
