  "ingredients": [
    "2 pounds potatoes, sliced into 1/2-inch-thick pieces",
    "1 onion, halved and each half cut into quarters",
    "0.5 cup canola oil",
    "0.5 cup olive oil",
    "4 cloves garlic, chopped",
    "1 envelope onion soup mix",
    "1 tablespoon chopped fresh rosemary, or more to taste",
    "1 tablespoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hoMZU8nSFNMcGXV7Wf0Xg_YOmFo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241713-roasted-potatoes-and-onions-easy-and-delicious-ddmfs-Step1-2027-1043e7d4a60344c8900b799ef7867266.jpg"
      ],
      "image": "assets/images/241713/step_01.webp"
    },
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine potatoes and onion in a roasting pan; cover with canola oil and olive oil. Add garlic, onion soup mix, rosemary, and black pepper; stir until potatoes and onion are evenly coated. Cover roasting pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o-TA9EML3OnHSB5Cqr9xHDxVWkE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241713-roasted-potatoes-and-onions-easy-and-delicious-ddmfs-Step4-2032-a8022870d4e941d39c5ed47483733ce9.jpg"
      ],
      "image": "assets/images/241713/step_03.webp"
    },
    {
      "text": "Roast in the preheated oven for 25 minutes. Remove foil and continue to roast until potatoes and onion are browned and edges are crispy, 15 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/taU9--LSv0oSyMGlSa-TtVr1okc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241713-roasted-potatoes-and-onions-easy-and-delicious-ddmfs-Step8-2059-6c81dd5a05b64751ad617f14432ecc22.jpg"
      ],
      "image": "assets/images/241713/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
