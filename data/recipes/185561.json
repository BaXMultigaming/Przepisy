  "ingredients": [
    "1 cup peanut oil for frying, or as needed",
    "3 eggs",
    "1 tablespoon water",
    "3 (6 ounce) fillets striped bass fillets, skinned",
    "1 teaspoon Cajun seasoning",
    "1 teaspoon lemon pepper",
    "0.5 cup flour",
    "1 (1 ounce) package salt-and-vinegar potato chips, crushed",
    "1 lemon, cut into wedges"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C). Whisk eggs and water together in a bowl; set the egg wash aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle the bass fillets on both sides with Cajun seasoning and lemon pepper. Dredge the fillets in flour, and shake off any excess. Dip the fillets in the egg wash, then dip fillets in the crushed potato chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry the fish in the preheated skillet until lightly browned, about 4 minutes per side. Serve with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
