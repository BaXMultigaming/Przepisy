  "ingredients": [
    "1 (4 pound) whole chicken",
    "2 large bay leaves",
    "1 tablespoon salt, or more to taste",
    "2 teaspoons ground black pepper, or more to taste",
    "1.5 gallons water",
    "2 (28 ounce) cans whole tomatoes and their juices",
    "10 medium potatoes, peeled and cubed",
    "4 large carrots, diced",
    "4 stalks celery, diced",
    "2 medium onions, diced",
    "1.5 cups frozen corn"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vYB96pT9Bq337dKwTpx-tIfjuBE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-286262-alabama-chicken-stew-VAT-step-01-5408ecb7db2d49db86c2592d15d66805.jpg"
      ],
      "image": "assets/images/286262/step_01.webp"
    },
    {
      "text": "Place chicken, bay leaves, 1 tablespoon salt, and 2 teaspoons pepper in a 10-quart stockpot. Cover with water and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/u2MgN0Uu01zKzxLeUPYB23YT6FE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-286262-alabama-chicken-stew-VAT-step-02-5cbc1f1de29b44b3b2f63662e191d359.jpg"
      ],
      "image": "assets/images/286262/step_02.webp"
    },
    {
      "text": "Reduce heat and simmer until chicken is no longer pink at the bone and the juices run clear, about 2 hours. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5thTepiVnZD3-nu9VqpcWozOCiA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-286262-alabama-chicken-stew-VAT-step-03-9fe5728b1fa548ce800d35783d7c73ed.jpg"
      ],
      "image": "assets/images/286262/step_03.webp"
    },
    {
      "text": "Remove from the heat and transfer chicken to a cutting board. Let cool for about 15 minutes. Remove and discard skin and bones. Shred meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x5NpOp0BmEE_HXQnx53TkoG4Cvk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-286262-alabama-chicken-stew-VAT-step-04-1160411ed7334220b10c1f35be825443.jpg"
      ],
      "image": "assets/images/286262/step_04.webp"
    },
    {
      "text": "Empty canned tomatoes and juices into a casserole dish and break up the tomatoes with your hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FWf5U1hZEsRCjkrrrIIxvtGWMTY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-286262-alabama-chicken-stew-VAT-step-05-071095ae2503458f834ac8617e6a2b53.jpg"
      ],
      "image": "assets/images/286262/step_05.webp"
    },
    {
      "text": "Add shredded chicken back to the stockpot along with the crushed tomatoes and juices, potatoes, carrots, celery, onions, and corn. Cook over medium-low heat, stirring often, until vegetables are cooked and potatoes have thickened the stew, 45 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g0nLXPwYPgX1S4fpB_xcD32eZk4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-286262-alabama-chicken-stew-VAT-step-06-b9fe2c085d284cbfa6980c3ac154962a.jpg"
      ],
      "image": "assets/images/286262/step_06.webp"
    }
