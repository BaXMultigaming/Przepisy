  "ingredients": [
    "2 cups almond milk",
    "1 medium ripe banana, mashed",
    "2 teaspoons vanilla extract",
    "3 cups rolled oats",
    "0.25 cup brown sugar",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon baking powder",
    "0.5 teaspoon sea salt",
    "2 cups blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk almond milk, mashed banana, and vanilla extract together in a large mixing bowl until smooth. Add oats, brown sugar, cinnamon, baking powder, and sea salt; mix until well combined. Fold in blueberries. Fill the prepared muffin cups evenly with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 25 minutes. Cool in the tin for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
