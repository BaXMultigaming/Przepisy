  "ingredients": [
    "1 (9.6 ounce) package Jimmy Dean® Original Hearty Pork Sausage Crumbles",
    "2 cups shredded Italian cheese blend, divided",
    "0.5 cup ricotta cheese",
    "2 green onions, thinly sliced",
    "3 tablespoons finely chopped sun-dried tomatoes, rehydrated",
    "12 medium portobello mushroom caps",
    "2 tablespoons olive oil",
    "3 tablespoons balsamic vinegar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Combine sausage, 1 cup shredded cheese, ricotta cheese, onions and tomatoes in large bowl.",
