  "ingredients": [
    "1.5 cups white sugar",
    "3 tablespoons unsweetened cocoa powder",
    "2 eggs",
    "1 (5 ounce) can evaporated milk",
    "0.25 cup melted butter",
    "1 teaspoon vanilla extract",
    "1 (9 inch) unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar and cocoa together in a large bowl. Beat eggs in a medium bowl with an electric mixer until light and fluffy; stir into cocoa mixture. Beat in evaporated milk, butter, and vanilla. Pour mixture into unbaked pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, about 45 minutes. Let cool before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
