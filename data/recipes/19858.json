  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 cup water",
    "2.33 cups all-purpose flour, divided",
    "0.5 cup unsalted butter",
    "0.67 cup unsweetened cocoa powder",
    "2 cups white sugar",
    "1 teaspoon vanilla extract",
    "2.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E16eHLoopphN2uxVUWF_XZRYHzU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19858_Egg-freeBrownies_ddmfs_4x3_step1_gw_0355-402110813cd8491f8890b3a07c8c0772.jpg"
      ],
      "image": "assets/images/19858/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water and 1/3 cup flour in a heavy saucepan over medium heat; cook, whisking constantly, until thick. Transfer mixture to a large mixing bowl and set aside to cool, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lo9A28Ka--F0SjM7UbJz3rjJ5c4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19858_Egg-freeBrownies_ddmfs_4x3_step2_gw_0361-1e2cc80b0dea4c93909579ecd0d5388a.jpg"
      ],
      "image": "assets/images/19858/step_03.webp"
    },
    {
      "text": "Melt butter in a small saucepan over medium heat. Mix in cocoa until smooth; remove from the heat and let cool, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VdlkVkvToYU0I9JoDxgYuQaWLDs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19858_Egg-freeBrownies_ddmfs_4x3_step3_gw_0362-9f2df22a2e424bfdb687701ff39bad40.jpg"
      ],
      "image": "assets/images/19858/step_04.webp"
    },
    {
      "text": "Combine remaining 2 cups flour, baking powder, and salt in a small bowl, set aside. Add sugar and vanilla to cooled flour-water mixture; mix with an electric mixer until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q9kPa4CBOXlBonNlPj5f5z8lvl0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19858_Egg-freeBrownies_ddmfs_4x3_step4_gw_0374-5fe00b8c908e43c2bc9f04b6f5ac8683.jpg"
      ],
      "image": "assets/images/19858/step_05.webp"
    },
    {
      "text": "Add cocoa mixture and mix until incorporated. Add dry flour mixture and stir until just blended; fold in walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vBflG18pW89nZKEz44Zmd-jyYfM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19858_Egg-freeBrownies_ddmfs_4x3_step6_gw_0376-73ef1a6ee67e4761ad1014429ddc1b65.jpg"
      ],
      "image": "assets/images/19858/step_06.webp"
    },
    {
      "text": "Spread evenly in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZP5AJHiRxoWxrwahPXHtbPHnf18=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19858_Egg-freeBrownies_ddmfs_4x3_step7_gw_0379-38b78093ec39410eb7f7d8f05e6d1032.jpg"
      ],
      "image": "assets/images/19858/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes. Cool before cutting into 20 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VEED5sMmn6cz7lLrorOitOGSo1o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19858_Egg-freeBrownies_ddmfs_4x3_step8_gw_0380-d5267b762a6a4a8ba69babdac8523ded.jpg"
      ],
      "image": "assets/images/19858/step_08.webp"
    }
  ],
