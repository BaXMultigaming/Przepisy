  "ingredients": [
    "2 slices white bread",
    "2 tablespoons butter",
    "4 tablespoons peanut butter",
    "1 teaspoon white sugar",
    "1 slice whole wheat bread"
  ],
  "steps": [
    {
      "text": "Butter a slice of white bread. Spread peanut butter on the bread over the layer of butter. Sprinkle sugar over the top of the peanut butter layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a slice of wheat bread on top of the white bread and repeat the layering of butter, peanut butter and sugar. Top the wheat bread with a slice of white bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut the layered slices into 9 pieces. Insert toothpicks into the pieces and serve.",
