  "ingredients": [
    "1 cup cornmeal",
    "1 cup all-purpose flour",
    "0.25 cup white sugar",
    "1 teaspoon salt",
    "1 cup milk",
    "0.25 cup shortening, melted",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cornmeal, flour, sugar, and salt together in a large bowl; make a well in the center. Add milk, shortening, and egg to the well; stir until well combined. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
