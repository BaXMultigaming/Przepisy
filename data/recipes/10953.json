  "ingredients": [
    "0.75 cup shortening",
    "0.75 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 teaspoon butter flavored extract",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup cornmeal"
  ],
  "steps": [
    {
      "text": "Cream together the shortening and the sugar. Add the egg. Sift together the flour, baking powder and cornmeal. Add in the vanilla, butter flavoring and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by spoonful onto greased cookie sheet. Bake at 350 degrees F (175 degrees C) until edges just turning slightly brown. Do not overbake.",
