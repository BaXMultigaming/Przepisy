  "ingredients": [
    "1 bunch fresh asparagus spears",
    "1 cup water",
    "1 cup white wine vinegar",
    "0.25 cup brown sugar",
    "1 jalapeno pepper, seeded and julienned",
    "4 sprigs fresh thyme",
    "4 cloves garlic, crushed",
    "2 tablespoons Old Bay Seasoning TM",
    "2 bay leaves",
    "1 teaspoon salt",
    "6 whole black peppercorns"
  ],
  "steps": [
    {
      "text": "Trim asparagus bottoms; pack loosely into a 1 quart jar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water, vinegar, sugar, jalapeño, thyme, garlic, Old Bay, bay leaves, salt, and peppercorns to a boil in a medium saucepan over medium-high heat. Boil 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour enough hot liquid over asparagus in the jar to completely immerse. Cover; cool to room temperature. Store refrigerated for 24 hours to blend flavors before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
