      ],
      "image": "assets/images/278232/step_03.webp"
    },
    {
      "text": "Add lime juice and pulp, chile peppers, lemongrass, ginger, tom yum paste, fish sauce, sugar, and chile sauce to broth; cook for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
