  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ynV_dyAD79AikgAWQoVlMJQnhDM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259216-instant-pot-frozen-salmon-ddmfs-step-01-4x3-10967-345aeb5f223542629a462623d8576e82.jpg"
      ],
      "image": "assets/images/259216/step_01.webp"
    },
    {
      "text": "Pour cold water and lemon juice into a multi-functional pressure cooker (such as Instant Pot). Place a steamer rack inside; coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place frozen salmon fillets, skin-side down, on the prepared rack. Cover and close the vent.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N149TIpwYt4ljRdcwtvI0Rmcv6A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259216-instant-pot-frozen-salmon-ddmfs-step-03-4x3-10974-ab709b20637a497884d4be589702d373.jpg"
      ],
      "image": "assets/images/259216/step_03.webp"
    },
    {
      "text": "Cook on the Steam setting until fish flakes easily with a fork, 3 to 4 minutes. Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ATQLQUacG0gE4DohPYt6F259C7M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259216-instant-pot-frozen-salmon-ddmfs-step-05-4x3-10980-efe25dd5c73f4a1c9124f2ca091a7563.jpg"
      ],
      "image": "assets/images/259216/step_04.webp"
    },
    {
      "text": "Check salmon for desired doneness. Season with salt and pepper. Cover the pot to keep salmon warm until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kFcv95ZTKoVCha1ky9bvGIlRBWo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259216-instant-pot-frozen-salmon-ddmfs-step-06-4x3-10986-01c44c84351b4038b25ed594047a0e0f.jpg"
