  "ingredients": [
    "5 fresh bratwurst sausages",
    "2 tablespoons olive oil",
    "2 onions, chopped",
    "4 carrots, sliced",
    "4 ribs celery, chopped",
    "2 teaspoons chopped garlic",
    "2 (32 ounce) cartons chicken broth",
    "1 (14.5 ounce) can diced tomatoes",
    "1 cup chopped fresh basil",
    "0.25 cup chopped fresh flat-leaf parsley",
    "2 teaspoons ground thyme",
    "0.5 teaspoon cayenne pepper",
    "6 potatoes, cut into cubes",
    "2 (15 ounce) cans cannellini beans, drained and rinsed",
    "12 ounces spinach, coarsely chopped, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill bratwursts until cooked through, about 5 minutes per side. Cool. Slice each bratwurst into 1/4-inch pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large pot over medium-high heat. Cook and stir onion, carrots, and celery in hot oil until onions are tender, 5 to 8 minutes. Stir garlic into onion mixture and cook until garlic is fragrant, 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chicken broth, tomatoes, sliced bratwurst, basil, parsley, thyme, and cayenne pepper into onion mixture. Bring to a boil, reduce heat to low, cover, and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix potatoes into bratwurst mixture, bring to a boil, reduce heat to low and simmer until potatoes are almost cooked through, 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir beans and spinach into pot; simmer until heated through and potatoes are done, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
