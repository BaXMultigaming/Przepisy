  "ingredients": [
    "1 cup butter flavored shortening",
    "0.75 cup white sugar",
    "0.75 cup brown sugar",
    "2 large eggs",
    "2 teaspoons Mexican vanilla extract",
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 cups milk chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jUNvRBXqLeFVp8-pm87ySt1OWvs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17209-absolutely-the-best-chocolate-chip-cookies-ddmfs-step-1-291-03b4580a4c994acd81f880d7f134ca99.jpg"
      ],
      "image": "assets/images/17209/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together butter-flavored shortening, brown sugar, and white sugar in a large bowl until light and fluffy. Add eggs, one at a time, beating well after each addition; stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TNieeF-aa7RePNTa8c_nf2falBg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17209-absolutely-the-best-chocolate-chip-cookies-ddmfs-step-2-296-30d1f7de6e00406c94dd9164ca3c4075.jpg"
      ],
      "image": "assets/images/17209/step_03.webp"
    },
    {
      "text": "Combine flour, baking soda, and salt in a separate bowl; gradually stir into creamed mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IwucZFwz3Ssix_0AaWSQ0mIjcEw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17209-absolutely-the-best-chocolate-chip-cookies-ddmfs-step-4-299-aab617f5b91c441295f46cd35949f24a.jpg"
      ],
      "image": "assets/images/17209/step_04.webp"
    },
    {
      "text": "Fold in chocolate chips until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XwqPBpWsnA8iC6QIo7Ojx4g927k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17209-absolutely-the-best-chocolate-chip-cookies-ddmfs-step-5-300-2e7ea8d1f0e649919e2a47b8bb4656db.jpg"
      ],
      "image": "assets/images/17209/step_05.webp"
    },
    {
      "text": "Drop by rounded spoonfuls onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d5wa5oscmjGQPdBYAEkQ8xj5FFM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17209-absolutely-the-best-chocolate-chip-cookies-ddmfs-step-6-302-0ba226077804453e9d3b0b4fe446454e.jpg"
      ],
      "image": "assets/images/17209/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until light brown, 8 to 10 minutes. Allow cookies to cool on the baking sheet for 5 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lnB3Pb-oI56_lmetIUDBsQyJQTU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17209-absolutely-the-best-chocolate-chip-cookies-ddmfs-step-7-303-32162997d5f84c708e9e4ba7ff3fa909.jpg"
      ],
      "image": "assets/images/17209/step_07.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wYfV8byqizHAQqfgJsvja369sTQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17209-absolutely-the-best-chocolate-chip-cookie-dianne-616263-A-4x3-b83ab106355c4a6284cf92134899bcd1.jpg"
      ],
      "image": "assets/images/17209/step_08.webp"
    }
