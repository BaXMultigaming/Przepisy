  "title": "Zucchini Cake",
  "description": "This zucchini cake recipe makes three layers of incredibly moist, cinnamon-spiced cake frosted with a decadently delicious cream cheese frosting.",
  "authors": [
    "Suzanne Stull"
  ],
  "date_published": "1998-05-19T08:13:01-04:00",
