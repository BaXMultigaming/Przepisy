  "ingredients": [
    "2.5 cups all-purpose flour",
    "2 teaspoons ground cinnamon",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon salt",
    "1.5 cups white sugar",
    "0.5 cup butter, softened",
    "1 cup canned pumpkin puree",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2 cups confectioners' sugar",
    "3 tablespoons milk",
    "1 tablespoon melted butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PIsmxVWBvWgZb9eMQ-ZSducOKSo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10033-iced-pumpkin-cookies-VAT-step-01-f98b5a0b417748d7bf68891caf487ae6.jpg"
      ],
      "image": "assets/images/10033/step_01.webp"
    },
    {
      "text": "Whisk flour, cinnamon, baking powder, baking soda, nutmeg, cloves, and salt together in a medium bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VyY8JNNTbXQFOq52L1cRXc44pk8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10033-iced-pumpkin-cookies-VAT-step-02-72582e0594ae46ac8bad8742186fc680.jpg"
      ],
      "image": "assets/images/10033/step_02.webp"
    },
    {
      "text": "Cream sugar and butter together in a large bowl until fluffy, 2 to 3 minutes. Add pumpkin, egg, and vanilla extract; beat until creamy. Mix in flour mixture until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v62-c6JpPn5yhIPDwz8Au7GfAtg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10033-iced-pumpkin-cookies-VAT-step-03-d23a4a5514594e3f84813ac40c925ccf.jpg"
      ],
      "image": "assets/images/10033/step_03.webp"
    },
    {
      "text": "Drop tablespoonfuls of cookie dough onto the prepared pans; flatten slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xsLXTEfKtFMQgNQEcKubIrCYr8g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10033-iced-pumpkin-cookies-VAT-step-04-548a44e1bbf64511b5ed84cbd97202f5.jpg"
      ],
      "image": "assets/images/10033/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until centers set, 15 to 20 minutes, switching racks halfway through. Transfer cookies to a wire rack; cool to room temperature, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IyM9OHYwOPKjGg-Nw2gNPS1cOOg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10033-iced-pumpkin-cookies-VAT-step-05-b09bae08a2584096b22703d67d4b5809.jpg"
      ],
      "image": "assets/images/10033/step_05.webp"
    },
    {
      "text": "Stir confectioners' sugar, milk, butter, and vanilla extract togeher in a large bowl until smooth. Add more milk as needed to reach desired drizzling consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Bz0kGGJrzrJDsie-cphPaHBm_9s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10033-iced-pumpkin-cookies-VAT-step-06-575f906e962340b8831ada615a9482b7.jpg"
      ],
      "image": "assets/images/10033/step_06.webp"
    },
    {
      "text": "Drizzle icing over cooled cookies with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Kt1G-ZEBL_QG5dYzFWyNm7rAJ1o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10033-iced-pumpkin-cookies-VAT-hero-04-4x3-df0a4e5c532f4b128a6240395c6e1a15.jpg"
      ],
      "image": "assets/images/10033/step_07.webp"
    }
