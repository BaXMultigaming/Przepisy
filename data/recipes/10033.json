  "title": "Iced Pumpkin Cookies",
  "description": "This iced pumpkin cookies recipe makes soft pumpkin cookies, perfectly spiced with warming cinnamon, nutmeg, and clove spice, then drizzled with icing.",
  "authors": [
    "Gina"
  ],
  "date_published": "1997-10-15T16:56:19-04:00",
