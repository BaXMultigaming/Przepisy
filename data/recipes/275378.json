  "ingredients": [
    "1 CAULIPOWER® Margherita Pizza",
    "1 teaspoon olive oil",
    "4 slices turkey bacon",
    "0.25 cup chopped onion",
    "0.25 cup chopped red bell pepper",
    "1 cup chopped fresh spinach",
    "1 clove garlic, minced",
    "0.5 cup egg whites",
    "0.25 cup shredded Cheddar cheese",
    "1 tablespoon chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place pizza on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 13 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat olive oil in a frying pan. Saute bacon, onion, and bell pepper in the hot oil until tender, 8 to 10 minutes. Drain off any grease and return to the pan. Add chopped spinach and garlic; stir until spinach is wilted. Remove from the pan to a small bowl to let cool for a few minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pizza from oven. Leave oven on. Add egg whites to vegetable mixture; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully top pizza with vegetable-egg mixture. Pour slowly so eggs don't run off the sides. Use a spoon to catch any drips and return to the top of the pizza.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Top with Cheddar cheese and bake for 5 minutes more. Remove from the oven and top with fresh basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
