  "ingredients": [
    "2 tablespoons olive oil",
    "0.5 small onion, diced",
    "2 cloves garlic",
    "1 cup long grain rice",
    "1.5 cups chicken broth",
    "0.5 cup tomato sauce",
    "2 tablespoons chopped fresh parsley",
    "0.5 teaspoon salt",
    "fresh ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat oil in a saucepan over medium heat and cook onion and garlic until soft and translucent, about 3 minutes. Add rice; cook and stir until lightly toasted for 2 minutes. Add chicken broth, tomato sauce, parsley, salt, and pepper; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and reduce heat to low. Cook until all the liquid is absorbed and rice is done, about 20 minutes.",
