  "total_time": "PT70M",
  "yield": [
    "6",
    "1 (9x13-inch) casserole"
  ],
  "categories": [
    "Dinner"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 (16 ounce) package penne pasta",
    "1 tablespoon olive oil",
    "1 pound ground beef",
    "1 small onion, chopped",
    "1 red bell pepper, chopped",
    "1 green bell pepper, chopped",
    "1 tablespoon paprika",
    "2 teaspoons garlic powder",
    "2 teaspoons kosher salt",
    "2 cans tomato sauce",
    "1 cup ketchup",
    "1 teaspoon yellow mustard",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon brown sugar",
    "2 cups frozen whole-kernel corn",
    "1.5 cups shredded Colby-Jack cheese",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Gather ingredients and preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OOsskbRrNB207WxdzZeuAIpdUrk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236925-sloppy-joe-casserole-ddmfs-step1-3x4-2252-f566a6c92537448197b70775ed55d634.jpg"
      ],
      "image": "assets/images/236925/step_01.webp"
    },
    {
      "text": "Bring a large pot of salted water to a boil over high heat. Add pasta and cook according to package directions for al dente. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y_q9LI5Hv8pkMlZlITd0xYjRtws=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236925-sloppy-joe-casserole-ddmfs-step2-3x4-2271-9f01cad332644c39b545a7c89de685b8.jpg"
      ],
      "image": "assets/images/236925/step_02.webp"
    },
    {
      "text": "While pasta cooks, heat oil in a large Dutch oven over medium-high. Add beef and cook, stirring often to crumble, until no longer pink, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9n4H_L4merMbOV6VHeWGbZy9ZL4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236925-sloppy-joe-casserole-ddmfs-step3-3x4-2258-d6570f2cba544728bada9e07c9d33a3d.jpg"
      ],
      "image": "assets/images/236925/step_03.webp"
    },
    {
      "text": "Stir in onion, bell peppers, paprika, garlic powder, and salt; cook, stirring occasionally, until vegetables are softened, about 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b-CSZuqjQlFoHWlOxcqja3mWcfg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236925-sloppy-joe-casserole-ddmfs-step4-3x4-2261-71d071fa13a34f88a43f4755fa58c36c.jpg"
      ],
      "image": "assets/images/236925/step_04.webp"
    },
    {
      "text": "Stir in tomato sauce, ketchup, mustard, Worcestershire, and brown sugar; bring to a boil over medium-high. Reduce heat to medium and cook, stirring occasionally, until slightly thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_RKKR-lI4ZIQTdxADAVuPd-LNf8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236925-sloppy-joe-casserole-ddmfs-step5-3x4-2268-abf8d7928b3c4d1d8971a18224ad5af0.jpg"
      ],
      "image": "assets/images/236925/step_05.webp"
    },
    {
      "text": "Remove from heat, stir in cooked pasta, corn, and 3/4 cup of the cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wXXAiPdEdTTCbr6En8MeSDUkero=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236925-sloppy-joe-casserole-ddmfs-step6-3x4-2272-67c67ee3b0a240b58875eb8cb6b59b84.jpg"
      ],
      "image": "assets/images/236925/step_06.webp"
    },
    {
      "text": "Coat a 9x13-inch baking dish with cooking spray; transfer beef and pasta mixture into the dish. Sprinkle evenly with remaining 3/4 cup cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DdVt3cLCbdjNa099hILIEzOH6QE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236925-sloppy-joe-casserole-ddmfs-step7-3x4-2275-101e461ec85d44f89e9e8bf7f4659b9c.jpg"
      ],
      "image": "assets/images/236925/step_07.webp"
    },
    {
      "text": "Bake in preheated oven until heated through and cheese is melted, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XCUxk0qVgJLPRUgP4HRpiUtPvxE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236925-sloppy-joe-casserole-ddmfs-step8-3x4-2316-fa45d276f55544cb8db3bf63ec26af0d.jpg"
      ],
      "image": "assets/images/236925/step_08.webp"
    },
    {
      "text": "Serve warm and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s-iMF1BxHiJA_doGpBFTGCPyP0U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236925-sloppy-joe-casserole-ddmfs-3x4-2346-43dad92e00ff47a2bac0cad03ebffebf.jpg"
      ],
      "image": "assets/images/236925/step_09.webp"
    }
  ],
