  "ingredients": [
    "cooking spray",
    "1 large eggplant, sliced into 1/4 inch rounds",
    "1 (28 ounce) jar garden vegetable pasta sauce",
    "1 (11 ounce) log goat cheese, sliced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange one fourth of eggplant slices in a layer in the bottom of the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour one fourth of pasta sauce on top of eggplant layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dot pasta sauce layer with one fourth of goat cheese slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Repeat layers three more times with remaining ingredients, ending with a top layer of goat cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until pasta sauce is bubbling and goat cheese is melted, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
