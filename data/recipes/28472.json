  "title": "Spicy Dry Fried Curry Chicken",
  "description": "This recipe is from North India where my mother was born. She gave me the recipe when I was moving out. It has been a favorite dish in my family for years.",
  "authors": [
    "Cooldude"
  ],
  "date_published": "2019-04-03T23:29:03-04:00",
