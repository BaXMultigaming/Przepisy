  "ingredients": [
    "1 (15 ounce) can solid-pack pumpkin",
    "1 (12 fluid ounce) can evaporated milk",
    "1 cup white sugar",
    "3 eggs",
    "4 teaspoons pumpkin pie spice",
    "1 (18.25 ounce) package yellow cake mix",
    "0.75 cup butter, melted",
    "1.5 cups chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pumpkin, evaporated milk, sugar, eggs, and pumpkin pie spice together in a bowl. Pour pumpkin mixture into prepared baking dish. Sprinkle cake mix over pumpkin mixture; drizzle with butter. Sprinkle pecans atop butter layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
