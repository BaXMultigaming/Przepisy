  "ingredients": [
    "1 pound bacon",
    "1 pound sausage",
    "1 tablespoon butter, melted",
    "2 tablespoons grated Parmesan cheese",
    "1 pound shredded Cheddar cheese",
    "8 large eggs",
    "3 cups heavy whipping cream",
    "1 cup half-and-half"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dHW7BVQRDQaTD92g2UiZ2TiMjNQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3231-Easy-Crustless-Quiche-DDMFS-Step-01-2894-af3e3e2aeacc49349a297e581e5f0328.jpg"
      ],
      "image": "assets/images/238640/step_01.webp"
    },
    {
      "text": "Cook chopped bacon and sausage in a large skillet over medium-high heat, stirring often, until evenly browned and the bacon is crisp, about 10 minutes. Drain on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fIhPy1zcwKjWoNiPcH_IoK9zIRc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3231-Easy-Crustless-Quiche-DDMFS-Step-02-2896-0136b3a9206549eba880951950f4b3e4.jpg"
      ],
      "image": "assets/images/238640/step_02.webp"
    },
    {
      "text": "Brush butter on the bottom and sides of a 9x13-inch baking dish. Sprinkle Parmesan cheese into bottom of the dish; top with bacon and sausage. Spread Cheddar cheese over bacon and sausage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t0R2PV9T3XHSqq_-ZYnGdJCd-pQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3231-Easy-Crustless-Quiche-DDMFS-Step-03-b-2898-92c4d65d29a74fd3a507efdb715dbb34.jpg"
      ],
      "image": "assets/images/238640/step_03.webp"
    },
    {
      "text": "Beat eggs, cream, and half-and-half together in a bowl; slowly pour over cheese and sausage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JzNMHYQfq44byIsHXq6XPq-1OFM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3231-Easy-Crustless-Quiche-DDMFS-Step-04-2899-c5361ccd46b747f28bdcbf6d4961b00a.jpg"
      ],
      "image": "assets/images/238640/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, about 1 hour. Cool briefly before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AWIN23rVnB9wXULTj_ygU2jPvZI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3231-Easy-Crustless-Quiche-DDMFS-Step-05-2927-7d0731d3000246b9b53b4829b1915f97.jpg"
      ],
      "image": "assets/images/238640/step_05.webp"
    }
  ],
