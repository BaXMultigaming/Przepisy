  "ingredients": [
    "1.75 cups white sugar",
    "3 tablespoons brown sugar",
    "0.25 cup Hungarian sweet paprika",
    "1 tablespoon ground black pepper",
    "1.5 teaspoons garlic powder",
    "0.5 cup salt",
    "2.5 teaspoons chili powder",
    "1 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Stir together white sugar, brown sugar, paprika, black pepper, garlic powder, salt, chili powder, and cayenne pepper until blended. Store in an airtight container until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To use the rub, remove the membrane on the back of the ribs, and rub both sides of the ribs with the mixture. Don't skimp on the rub! Wrap the ribs with plastic, and refrigerate overnight. Cook the ribs slowly over indirect heat for 2 hours, basting with your favorite barbeque sauce during the last 20 minutes.",
      "section": null,
