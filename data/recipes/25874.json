  "ingredients": [
    "2 pounds medium raw shrimp, shelled, deveined, with tails attached",
    "1 cup butter",
    "2 tablespoons Dijon mustard",
    "1 tablespoon fresh lemon juice",
    "1 tablespoon chopped garlic",
    "1 tablespoon chopped fresh parsley"
  ],
