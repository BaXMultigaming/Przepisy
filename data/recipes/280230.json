  "ingredients": [
    "2 pears - peeled, cored, and diced",
    "1 teaspoon lemon juice",
    "0.75 teaspoon ground cinnamon, divided",
    "2 tablespoons quick-cooking oats",
    "1 tablespoon all-purpose flour",
    "1 tablespoon brown sugar",
    "1 tablespoon salted butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 360 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pears, lemon juice, and 1/4 teaspoon cinnamon in a medium bowl. Toss to coat, then divide the mixture between 2 ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, flour, brown sugar, and remaining 1/2 teaspoon cinnamon in a small bowl. Mix in softened butter using a fork until mixture is crumbly. Sprinkle over the pears.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the ramekins in the air fryer basket and cook until the pears are soft and bubbling, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
