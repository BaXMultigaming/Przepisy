  "ingredients": [
    "0.5 pound sliced bacon",
    "0.25 cup butter",
    "0.66666668653488 cup pine nuts",
    "2 pounds Brussels sprouts, cored and shredded",
    "3 green onions, minced",
    "0.5 teaspoon seasoning salt",
    "pepper to taste"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until crisp. Drain, reserving 2 tablespoons of grease in the skillet, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ygr2JjEA2DMzHcARXJCO3fJ2yqc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/53715-shredded-brussels-sprouts-VAT-step-01-c6fb03b8e35741bbb1066872debbfa1d.jpg"
      ],
      "image": "assets/images/53715/step_01.webp"
    },
    {
      "text": "Melt butter with reserved bacon grease in the same skillet over medium heat. Add pine nuts; cook and stir until browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/onIkLI-DlUG6QRUarEYhGSVU_5A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/53715-shredded-brussels-sprouts-VAT-step-02-e106184c500e4e4692f0c9c8578a6642.jpg"
      ],
      "image": "assets/images/53715/step_02.webp"
    },
    {
      "text": "Add shredded Brussels sprouts and green onions; season with seasoning salt and ground black pepper. Cook and stir until sprouts are wilted and tender, about 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m4jqy2ywMnkNqIG3hT9puYlkY-c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/53715-shredded-brussels-sprouts-VAT-step-03-d8f72e7fafe540358bae173c06bc9df4.jpg"
      ],
      "image": "assets/images/53715/step_03.webp"
    },
    {
      "text": "Stir in crumbled bacon and toss to combine. Serve hot.",
