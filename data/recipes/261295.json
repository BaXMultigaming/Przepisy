  "ingredients": [
    "12 apples, cored and cut into 8 wedges",
    "0.75 cup brown sugar",
    "2 teaspoons ground cinnamon, divided",
    "1 cup all-purpose flour, divided",
    "0.5 cup cold butter",
    "1.5 cups old-fashioned rolled oats",
    "1 cup chopped walnuts",
    "0.33333334326744 cup maple syrup",
    "1 teaspoon pumpkin pie spice",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a large rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place apples wedges in a large bowl. Add brown sugar, and 1 teaspoon cinnamon; toss to combine. Add 1/2 cup flour; mix well. Spread apple mixture evenly on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place remaining 1/2 cup flour in another large bowl. Cut in butter with 2 knives or a pastry blender until small peas form. Add remaining 1 teaspoon cinnamon, oats, walnuts, maple syrup, pumpkin pie spice, vanilla extract, and salt; toss to combine. Spoon mixture evenly over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apple mixture is bubbling, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
