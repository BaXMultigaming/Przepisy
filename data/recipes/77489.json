  "ingredients": [
    "8 chicken thighs",
    "6 small red potatoes, quartered",
    "0.5 cup extra-virgin olive oil, or as needed",
    "1 tablespoon chopped fresh rosemary",
    "1.5 teaspoons chopped fresh oregano",
    "1.5 teaspoons garlic powder",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss chicken and potatoes with oil in a large bowl; transfer to a large baking dish or cookie sheet with sides. Sprinkle with rosemary, oregano, garlic powder, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, uncovered, for 1 hour; baste during last 15 minutes for extra crispness.",
