  "ingredients": [
    "2 cups water",
    "2 teaspoons dried minced onion",
    "1 teaspoon instant beef bouillon granules",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon dried marjoram",
    "0.25 teaspoon dried rosemary",
    "1 cup white rice"
  ],
  "steps": [
    {
      "text": "Combine water, onion, bouillon, thyme, marjoram, and rosemary in a saucepan; bring to a boil. Add rice, reduce heat to medium-low, cover, and simmer until water is absorbed and rice is tender, 15 to 20 minutes.",
