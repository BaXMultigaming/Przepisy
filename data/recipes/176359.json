      ],
      "image": "assets/images/176359/step_02.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pork to a baking dish; pour marinade over the pork.",
      "section": null,
      "name": null,
      "url": null,
