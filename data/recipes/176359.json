  "ingredients": [
    "0.25 cup olive oil",
    "0.25 cup soy sauce",
    "1 clove garlic, minced",
    "3 tablespoons dijon honey mustard",
    "salt and ground black pepper to taste",
    "2 pounds pork tenderloin"
  ],
  "steps": [
    {
      "text": "Whisk olive oil, soy sauce, garlic, mustard, salt, and pepper together in a bowl.",
      "section": null,
      "name": null,
