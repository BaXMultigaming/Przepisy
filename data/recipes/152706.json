  "ingredients": [
    "nonstick cooking spray",
    "1 (14 ounce) can 100% pure pumpkin",
    "2 eggs",
    "0.5 cup applesauce",
    "0.5 teaspoon vanilla extract",
    "1 (18.25 ounce) package spice cake mix",
    "1 teaspoon cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly coat 2 baking sheets with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat pumpkin, eggs, applesauce, and vanilla extract together in a bowl until well combined; stir in cake mix, cinnamon, nutmeg, and cloves until well blended and creamy. Drop dough by spoonfuls onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are firm when lightly pressed, 8 to 10 minutes. Cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
