  "ingredients": [
    "5 cups chicken broth",
    "2 skinless, boneless chicken breast halves",
    "1 cup diced celery",
    "1 cup diced onion",
    "0.25 cup diced carrots",
    "0.25 cup corn",
    "0.25 cup drained and rinsed black beans",
    "1 teaspoon dried sage",
    "1 teaspoon ground black pepper",
    "1 teaspoon salt",
    "1 bay leaf",
    "0.75 cup brown rice"
  ],
  "steps": [
    {
      "text": "Bring chicken broth to a boil in a large pot. Add chicken breasts and boil until no longer pink in the center, about 20 minutes. Remove chicken from broth with a slotted spoon; shred with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir shredded chicken back into broth. Add celery, onion, carrots, corn, black beans, sage, pepper, salt, and bay leaf. Cook until vegetables are slightly softened and flavors of soup have blended, about 20 minutes. Add brown rice and simmer until tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
