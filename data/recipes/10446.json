  "ingredients": [
    "0.75 cup shortening",
    "1 cup packed brown sugar",
    "1 egg",
    "0.5 cup light molasses",
    "2.5 cups all-purpose flour",
    "1 teaspoon salt",
    "2 teaspoons baking soda",
    "0.5 teaspoon ground cloves",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Cream together shortening and brown sugar. Stir in egg and molasses and mix well. Fold in dry ingredients and stir. Cover and chill until firm (1 - 2 hours).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into small balls (I use a small melon baller to help with this) and roll in white sugar. Place on lightly greased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 9 - 10 minutes. Leave on cookie sheet one minute until set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
