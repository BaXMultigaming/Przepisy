  "ingredients": [
    "1.5 pounds cauliflower florets",
    "4 tablespoons Egg substitute, liquid",
    "0.75 cup all-purpose flour",
    "1 teaspoon garlic powder",
    "1 teaspoon paprika",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "nonstick cooking spray",
    "0.5 cup vegan Buffalo wing sauce (such as Frank's®)"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cauliflower florets in a large bowl. Pour egg substitute over florets and stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, garlic powder, paprika, salt, and pepper in a large plastic resealable bag. Seal the bag and shake until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop 1/2 of the florets into seasoned flour in the bag. Seal the bag and shake until evenly coated. Place florets in the air fryer basket. Spray the tops with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 5 minutes. Flip cauliflower over, spray any chalky spots, and cook for 5 minutes more. Repeat with remaining cauliflower florets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat buffalo wing sauce in a small saucepan over medium heat until warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cauliflower to a large bowl. Pour warm sauce over the top and toss until evenly coated. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
