  "ingredients": [
    "4 cups fresh blueberries",
    "1 cup all-purpose flour",
    "0.5 cup white sugar",
    "0.25 cup brown sugar",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup vegan mayonnaise (such as Vegenaise®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place blueberries into an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, white sugar, brown sugar, and cinnamon in a medium bowl. Stir in vegan mayonnaise until the mixture resembles coarse crumbs. Sprinkle the mixture over the top of the berries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the filling is bubbly and the top is lightly browned, 35 to 40 minutes.",
      "section": null,
