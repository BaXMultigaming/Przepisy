  "ingredients": [
    "0.75 cup butter, softened",
    "1.5 cups white sugar",
    "1 egg",
    "1.5 teaspoons vanilla extract",
    "1.5 cups finely chopped zucchini",
    "3.25 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "2 teaspoons ground cinnamon",
    "0.5 cup chopped walnuts",
    "0.75 cup miniature semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter, sugar. Beat in egg and vanilla. Stir in the zucchini. Combine the flour, baking powder, salt and cinnamon; stir into the zucchini mixture. Mix in the chocolate chips and walnuts. Drop by heaping spoonfuls onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes in the preheated oven, until edges are light brown. Remove from baking sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
