  "ingredients": [
    "Reynolds Wrap® Non-Stick Aluminum Foil",
    "0.25 cup fresh lemon juice",
    "2 tablespoons Worcestershire sauce",
    "4 teaspoons seafood seasoning",
    "2 teaspoons lemon pepper",
    "1 teaspoon dried basil",
    "4 cloves garlic, minced",
    "0.5 cup vegetable oil",
    "1 pound medium raw shrimp, peeled and deveined"
  ],
  "steps": [
    {
      "text": "Combine lemon juice, Worcestershire sauce, seafood seasoning, lemon pepper, basil and garlic. Gradually add oil, stirring mixture until thickened. Reserve half of marinade for basting. Add shrimp to remaining marinade stir to coat evenly. Cover shrimp and refrigerate 30 minutes. Drain shrimp discard marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat grill to medium-high (400 degrees to 450 degrees F). Cut slits in a sheet of Reynolds Wrap® Nonstick Aluminum Foil. Place on grill rack with nonstick side toward food. Arrange shrimp on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill uncovered 4 to 6 minutes, turning and basting once with reserved marinade, until shrimp are firm and pink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove shrimp from aluminum foil sheet allow remaining juices to cool before handling foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
