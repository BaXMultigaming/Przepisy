  "ingredients": [
    "2 medium cucumbers",
    "1 (16 ounce) container plain Greek yogurt",
    "3 cloves garlic, minced",
    "2 tablespoons olive oil",
    "1 tablespoon chopped fresh dill",
    "0.5 medium lemon, juiced",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Peel cucumbers; remove seeds with a spoon. Grate cucumber on the large holes of a box grater, then squeeze to drain excess liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a food processor combine the grated cucumber with Greek yogurt, garlic, olive oil, dill, lemon juice, salt, and pepper. Blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve immediately or for best flavor cover and refrigerate for at least 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
