  "ingredients": [
    "0.75 cup white sugar",
    "3 tablespoons butter, softened",
    "2 eggs, beaten",
    "1 (15 ounce) can pumpkin puree",
    "1 (12 fluid ounce) can evaporated milk",
    "2 teaspoons vanilla extract",
    "0.5 cup all-purpose flour",
    "0.75 teaspoon baking powder",
    "0.125 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground allspice",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 9-inch pie pan, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the flour, baking powder, salt, cinnamon, allspice, ginger and nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat together the sugar, butter and eggs. Mix in the pumpkin, milk and vanilla. Add the sifted ingredients, and beat until smooth. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 50 to 55 minutes, or until a toothpick inserted in center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
