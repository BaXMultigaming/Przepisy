  "title": "Creamy Chicken Lasagna",
  "description": "This delicious chicken lasagna is made with tender poached chicken breasts, cream cheese, tomato pasta sauce, and lots of mozzarella cheese.",
  "authors": [
    "Caroline"
  ],
  "date_published": "1999-11-16T20:10:55-05:00",
