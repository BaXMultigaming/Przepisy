  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Measure 1 cup yellow cake mix and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix remaining yellow cake mix, 1/2 cup melted butter, and 1 egg together in a bowl. Spread mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pumpkin puree, brown sugar, 1/4 cup white sugar, milk, 3 eggs, and cinnamon together in a bowl. Spread pumpkin mixture over cake mix layer in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 cup sugar, 1/4 cup butter, and reserved 1 cup yellow cake mix together in a bowl; mash with a fork until crumbly. Spread crumb mixture over pumpkin mixture layer in baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake is lightly browned on top and a knife inserted in the middle comes out clean, 50 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
