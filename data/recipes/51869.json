  "ingredients": [
    "2 cups 2% milk",
    "2 cups heavy cream",
    "1 cup sugar",
    "1 teaspoon vanilla extract",
    "1 teaspoon peppermint extract",
    "0.5 teaspoon salt",
    "3 drops green food coloring",
    "1 cup miniature semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zemOjtGFScvz3Dl4HPg_WtLqK9k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/51869-easy-mint-chocolate-chip-ice-cream-VAT-003-Step-01-ebc0545a8ab74beb91008c51dfd7b1eb.jpg"
      ],
      "image": "assets/images/51869/step_01.webp"
    },
    {
      "text": "Stir milk, cream, sugar, vanilla, peppermint extract, and salt together in a large bowl until the sugar has dissolved. Mix in green food coloring.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2-oWj6KvnU9NRwuGf79GfAZoP0k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/51869-easy-mint-chocolate-chip-ice-cream-VAT-005-Step-02-d9741d26309c42458f22feb9267e484e.jpg"
      ],
      "image": "assets/images/51869/step_02.webp"
    },
    {
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8Vanma1pu92jVeXYqFUg2kqkt44=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/51869-easy-mint-chocolate-chip-ice-cream-VAT-008-Step-03-1e6f16b5b2e848779ca236e77eca2cd7.jpg"
      ],
      "image": "assets/images/51869/step_03.webp"
    },
    {
      "text": "Add chocolate chips about 10 minutes into the freezing. Continue churning until ice cream has thickened, about 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lyCIstOiFn3FmcjDHwA82nfvXhs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/51869-easy-mint-chocolate-chip-ice-cream-VAT-011-Step-04-60e65d8bb9484b73a641dd2a3e9559fe.jpg"
      ],
      "image": "assets/images/51869/step_04.webp"
    },
    {
      "text": "Transfer to an airtight container and freeze until firm, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vbRuR2HD-LdEHbUWPyAqM34Gnmo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/51869-easy-mint-chocolate-chip-ice-cream-VAT-015-Step-05-fd290467193540d59c3c4e89a42d0c63.jpg"
      ],
      "image": "assets/images/51869/step_05.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
