  "ingredients": [
    "cooking spray",
    "3 tablespoons packed brown sugar",
    "0.5 cup ketchup",
    "1.5 pounds lean ground beef",
    "1 small onion, chopped",
    "0.75 cup low-fat (1%) milk",
    "0.75 cup whole wheat bread crumbs",
    "2 eggs",
    "0.25 cup chopped parsley",
    "1.5 teaspoons salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press brown sugar into the bottom of the prepared loaf pan; spread ketchup over sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together ground beef, onion, milk, bread crumbs, eggs, parsley, salt, black pepper, and ginger in a large bowl until thoroughly combined. Shape beef mixture into a loaf and place into the pan on top of ketchup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
