  "ingredients": [
    "1 egg",
    "3 tablespoons white sugar",
    "1 cup quark, well drained",
    "5 tablespoons all-purpose flour, plus extra for dusting",
    "1.5 teaspoons vanilla sugar",
    "0.25 teaspoon salt",
    "oil for frying"
  ],
  "steps": [
    {
      "text": "Beat egg and white sugar together in a bowl until smooth. Whisk in quark cheese, flour, vanilla sugar, and salt. Mix well until dough is thick and sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 5 to 6 portions. Form into balls and coat with some flour. Flatten slightly to form into discs (syrniki).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in skillet over medium-low heat. Add the syrniki; fry until browned, 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
