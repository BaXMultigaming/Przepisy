  "title": "Easy Eggnog Creme Brulee",
  "description": "The flavors of eggnog lend delicious spice and depth to traditional creme brulee in this simple, festive recipe.",
  "authors": [
    "CARRIEANN23"
  ],
  "date_published": "2020-06-19T00:05:10-04:00",
