  "ingredients": [
    "3 cups vegetable oil",
    "0.25 cup all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon dried oregano",
    "0.5 teaspoon ground black pepper",
    "12 squid, cleaned and sliced into rings",
    "1 lemon - cut into wedges, for garnish"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, salt, oregano, and pepper in a medium bowl. Dredge squid in flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry squid in hot oil until light brown, 2 to 3 minutes. Do not overcook, or squid will be tough. Drain squid on a paper towel-lined plate. Serve with lemon wedges.",
      "section": null,
