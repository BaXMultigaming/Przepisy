  "ingredients": [
    "2 (16 ounce) packages dried spaghetti",
    "3.5 cups finely grated Pecorino Romano cheese, or more to taste",
    "6 tablespoons unsalted butter, cut into 6 pieces",
    "2 teaspoons coarsely ground black pepper",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Bring a 12-quart pot of heavily salted water to a boil over high heat. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain pasta, reserving 2 cups of cooking water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return pasta and cooking water to the pot over low heat. Add 3 1/2 cups Pecorino Romano cheese, butter, and pepper. Stir until cheese has melted and formed a creamy sauce, about 5 minutes. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with additional cheese, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
