  "ingredients": [
    "4 (1-inch thick) bone-in pork chops",
    "0.25 cup real maple syrup",
    "0.25 cup water",
    "0.25 cup chopped onion",
    "1 tablespoon white vinegar",
    "1 tablespoon Worcestershire sauce",
    "0.5 teaspoon chili powder",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium-high heat. Sear the pork chops in the preheated skillet until browned, 2 to 3 minutes per side. Arrange seared chops into a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk maple syrup, water, onion, vinegar, Worcestershire sauce, chili powder, salt, and pepper together in a bowl to dissolve the chili powder; pour over the pork chops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the chops are no longer pink in the center, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
