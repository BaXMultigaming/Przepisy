  "ingredients": [
    "cooking spray",
    "2 cups white sugar",
    "1.5 cups vegetable oil",
    "4 eggs",
    "2 teaspoons vanilla extract",
    "1 (16 ounce) can pumpkin puree",
    "3 cups all-purpose flour",
    "1 tablespoon salt",
    "2 teaspoons baking powder",
    "2 teaspoons baking soda",
    "1 teaspoon ginger powder",
    "1 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease 2 mini fluted Bundt® pans with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, vegetable oil, eggs, and vanilla extract in a large bowl; beat with an electric mixer until smooth. Add pumpkin puree; beat until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, salt, baking powder, baking soda, and ginger powder together in another bowl. Mix into pumpkin mixture. Fold chocolate chips into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
