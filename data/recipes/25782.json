  "ingredients": [
    "0.67 cup butter, melted",
    "2 cups quick-cooking oats",
    "0.67 cup all-purpose flour",
    "0.25 teaspoon salt",
    "1 cup white sugar",
    "0.25 cup corn syrup",
    "0.25 cup milk",
    "1 teaspoon vanilla extract",
    "2 cups milk chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 2 cookie sheets with aluminum foil and grease the foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet over medium heat, melt the butter. Stir together the oats, flour, salt and sugar; mix into the melted butter until well blended. Stir in the corn syrup, milk and vanilla. Drop batter by teaspoonfuls 3 inches apart onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 5 to 7 minutes in the preheated oven, until medium brown. Cool completely before removing from the cookie sheets. In the microwave or in a metal bowl over a pan of simmering water, melt chocolate chips, stirring frequently until smooth. Remove from heat. Spread chocolate onto the bottoms of cookies and sandwich them together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
