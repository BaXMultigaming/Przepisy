  "ingredients": [
    "1.5 cups mango nectar",
    "0.25 cup soy sauce",
    "1 tablespoon granulated garlic",
    "1 tablespoon habanero hot sauce",
    "1 pound skirt steak"
  ],
  "steps": [
    {
      "text": "Mix mango nectar, soy sauce, garlic, and hot sauce in a bowl. Add steak and marinate for 8 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill steaks until they are beginning to firm and are hot and slightly pink in the center, 4 to 5 minutes per side for medium. An instant-read thermometer inserted into the center should read 140 degrees F (60 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from grill, cover, and allow to rest for 2 minutes. Cut steak across the grain and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
