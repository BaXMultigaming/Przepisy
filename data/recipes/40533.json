  "ingredients": [
    "0.75 cup water",
    "1 small head red cabbage, finely shredded",
    "3 apples - peeled, cored and chopped",
    "1 cup distilled white vinegar",
    "0.25 cup packed brown sugar",
    "2 tablespoons butter, divided",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Place water in a large saucepan over high heat. Stir in cabbage, apples, vinegar, brown sugar, 1 tablespoon butter, cinnamon, allspice, and cloves. Bring to a boil. Reduce heat, cover, and simmer, stirring occasionally, until cabbage is tender, about 45 minutes.",
