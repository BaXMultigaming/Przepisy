  "ingredients": [
    "1 cup all-purpose flour",
    "1 tablespoon seasoned salt (such as LAWRY'S®)",
    "2 teaspoons ground black pepper",
    "4 thin-cut, boneless pork loin chops",
    "0.5 cup canola oil"
  ],
  "steps": [
    {
      "text": "Mix flour, seasoned salt, and pepper thoroughly in a wide bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge each side of the pork chops in the flour mixture. Set aside on a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour oil into a frying pan over medium-high heat. Drop a pinch of flour in the oil; it will sizzle if the oil is ready. Add 2 pork chops and cook until golden brown on the outside and no longer pink in the center, 3 to 4 minutes per side. Repeat with the remaining chops.",
      "section": null,
