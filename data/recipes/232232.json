  "ingredients": [
    "1 cup creamy peanut butter",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "1 egg",
    "1 teaspoon baking soda",
    "7 slices cooked and diced bacon",
    "2 tablespoons white sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine peanut butter, ½ cup white sugar, and brown sugar in the bowl of a stand mixer fitted with the paddle attachment; beat until well combined. Add egg and baking soda; beat until smooth, 1 minute. Fold in bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into walnut-sized balls. Pour 2 tablespoons white sugar into a bowl. Roll balls in sugar until coated; place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 10 minutes. Cool on the baking sheet for 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
