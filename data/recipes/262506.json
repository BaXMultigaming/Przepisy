  "ingredients": [
    "4 (4 ounce) salmon fillets",
    "1.5 tablespoons fresh lemon juice",
    "salt and ground black pepper to taste",
    "0.5 cup panko bread crumbs",
    "0.25 cup grated Parmesan cheese",
    "1 tablespoon extra-virgin olive oil",
    "1 teaspoon Italian seasoning",
    "0.125 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon fillets into the prepared baking pan. Sprinkle with lemon juice; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine panko bread crumbs, Parmesan cheese, olive oil, Italian seasoning, and garlic powder in a bowl; sprinkle over salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is lightly browned and salmon flakes easily with a fork, 15 to 20 minutes.",
      "section": null,
