  "ingredients": [
    "1 cup water",
    "1 cup white sugar",
    "2 cinnamon sticks",
    "4 fluid ounces ginger ale",
    "3 fluid ounces cranberry juice",
    "1 fluid ounce vodka",
    "ice as needed"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a saucepan over high heat. Stir in sugar until completely dissolved, 1 to 2 minutes. Add cinnamon sticks, reduce heat to low, and let simmer for 8 minutes. Remove from heat and let steep for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cinnamon sticks and pour syrup into a squeeze bottle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ginger ale, cranberry juice, vodka, and 1 teaspoon cinnamon syrup mixture together in a 12-ounce highball glass. Stir or shake thoroughly. Fill with ice to the top of the glass. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
