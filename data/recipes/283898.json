  "ingredients": [
    "1 tablespoon dried oregano",
    "1 teaspoon chili powder",
    "3 tablespoons extra-virgin olive oil",
    "1 (6 ounce) package feta cheese, cubed",
    "1 cup water",
    "1 cup couscous",
    "1 medium cucumber, seeded and chopped",
    "1 medium tomato, chopped",
    "1 medium green bell pepper, chopped",
    "0.25 medium red onion, chopped",
    "0.25 cup pitted black olives",
    "0.25 cup pitted green olives",
    "2 tablespoons extra-virgin olive oil",
    "1 clove garlic, minced",
    "4 tablespoons extra-virgin olive oil",
    "1 tablespoon balsamic vinegar",
    "1 tablespoon white wine vinegar",
    "1 tablespoon soy sauce"
  ],
  "steps": [
    {
      "text": "Heat skillet over low heat. Add dried oregano and chili powder; cook and stir until fragrant and toasted, about 1 minute. Off heat, stir in 3 tablespoons olive oil. Pour seasoned oil over feta cheese in a bowl; marinate for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring 1 cup water to a boil in a saucepan. Off heat, stir in couscous. Cover the saucepan; set aside until water is completely absorbed, about 10 minutes. Fluff couscous with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cucumber, tomato, bell pepper, onion, olives, 2 tablespoons oil, and garlic into warm couscous.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk ¼ cup oil, balsamic vinegar, white wine vinegar, and soy sauce together in a bowl; toss into couscous salad.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place marinated feta on top couscous salad.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
