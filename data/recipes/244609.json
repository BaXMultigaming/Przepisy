  "ingredients": [
    "1 pound skinless, boneless chicken breast halves, cut into cubes",
    "0.5 cup soy sauce, or to taste",
    "0.5 cup olive oil, or to taste",
    "1 lemon, juiced",
    "3 cloves garlic, minced",
    "ground black pepper to taste",
    "3 red potatoes, cubed",
    "2 tomatoes, cubed",
    "2 carrots, chopped",
    "1 onion, sliced",
    "1 green bell pepper, sliced",
    "1 red bell pepper, sliced",
    "1 yellow bell pepper, sliced",
    "1 cup green peas"
  ],
  "steps": [
    {
      "text": "Combine chicken, soy sauce, olive oil, lemon juice, garlic, and black pepper in a slow cooker; marinate for 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir potatoes, tomatoes, carrots, onion, bell peppers, and peas into chicken mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover slow cooker. Cook on Low for 7 to 8 hours or on High for 3 to 4 hours.",
      "section": null,
