  "ingredients": [
    "2 cups white sugar",
    "2 eggs",
    "0.5 cup vegetable oil",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "0.5 teaspoon ground cinnamon, or more to taste",
    "1.5 teaspoons salt",
    "1 teaspoon baking powder",
    "½ teaspoon baking powder",
    "2 cups apples, peeled and diced"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f7c751nZLglmv1S5NJ31n-f6roQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231288-debbies-amazing-apple-bread-ddmfs-5640-01-3x4-3945cab9234a4ea5901f1434bbc2a5a8.jpg"
      ],
      "image": "assets/images/231288/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, eggs, vegetable oil, and vanilla extract in a large mixing bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/StjinYC_Bpq83uOkmlTsT3D3Kdg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231288-debbies-amazing-apple-bread-ddmfs-5646-02-3x4-aefc250f252b4c75af2af72c451926ef.jpg"
      ],
      "image": "assets/images/231288/step_03.webp"
    },
    {
      "text": "Whisk flour, cinnamon, salt, baking powder, and baking soda together in a medium bowl until well combined; add to sugar mixture and stir until just combined. Stir in apples until evenly combined. Spoon batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d8kibQQUM6lEdKiiECq-AQeKn5c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231288-debbies-amazing-apple-bread-ddmfs-5653-03-3x4-4fb1b016ebfe4018889a50590c913ed4.jpg"
      ],
      "image": "assets/images/231288/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Cover loaf pan with aluminum foil; continue baking until a toothpick inserted into the center comes out clean, about 15 minutes more. Cool briefly in the pan before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S6eH03vNv4aqFEU91WA-ePmNQbo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231288-debbies-amazing-apple-bread-ddmfs-5656-04-3x4-c6254ec140174544800542614416e8fc.jpg"
      ],
      "image": "assets/images/231288/step_05.webp"
    },
    {
      "text": "Slice and enjoy!",
      "section": null,
      "name": null,
      "url": null,
