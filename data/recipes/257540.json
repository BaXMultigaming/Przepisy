  "ingredients": [
    "0.75 cup unsalted butter, softened",
    "1 (15 ounce) can peaches in heavy syrup",
    "1.5 cups white sugar, divided",
    "0.5 cup brown sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.25 teaspoon vanilla extract",
    "1 cup milk",
    "1 cup all-purpose flour",
    "1 tablespoon baking powder",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Place 1/2 cup butter in a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place casserole dish in the preheating oven until butter is melted. Remove.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix remaining 1/4 cup butter, peaches, 1/2 cup white sugar, brown sugar, cinnamon, nutmeg, and vanilla extract together in a bowl. Spread over melted butter in the casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix remaining 1 cup white sugar, milk, flour, baking powder, and salt together in a bowl to make a smooth batter. Pour over peach mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 45 minutes. Let stand for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
