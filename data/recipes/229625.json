  "title": "Camille's Buttermilk Pound Cake",
  "description": "A rich and tender pound cake made with buttermilk is baked in a fluted tube pan.",
  "authors": [
    "Gina Ferraro Brown"
  ],
  "date_published": "2020-06-18T23:51:49-04:00",
