  "ingredients": [
    "3 cups Corn Chex® cereal",
    "3 cups Rice Chex® cereal",
    "3 cups Wheat Chex® cereal",
    "1 cup mixed nuts",
    "1 cup bite-size pretzels",
    "1 cup garlic-flavor bite-size bagel chips or regular-size bagel chips, broken into 1-inch pieces",
    "6 tablespoons butter",
    "2 tablespoons Worcestershire sauce",
    "1.5 teaspoons seasoned salt",
    "0.75 teaspoon garlic powder",
    "0.5 teaspoon onion powder"
  ],
  "steps": [
    {
      "text": "Combine cereals, nuts, pretzels, and bagel chips in a large microwave-safe bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HUUU_aB9fS0KZFBSMvgTRT1d6fE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/87605-original-chex-party-mix-ddmfs-001-step1-cb72c23a55104ba9b80f62186e69216a.jpg"
      ],
      "image": "assets/images/87605/step_01.webp"
    },
    {
      "text": "Microwave butter in a small microwave-safe bowl, uncovered, on High until melted. Stir in Worcestershire sauce, seasoned salt, garlic powder, and onion powder. Pour over cereal mixture; stir until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xNn9lFuYKO5tsch3Ow735dLqM6k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/87605-original-chex-party-mix-ddmfs-001-step3-139c0c08699e49c184957bd3c661126f.jpg"
      ],
      "image": "assets/images/87605/step_02.webp"
    },
    {
      "text": "Microwave, uncovered, on High, thoroughly stirring every 2 minutes, until mixture is crisp, 5 to 6 minutes. Spread on paper towels to cool. Let cool completely before storing in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kr0TtGp6p7YRc17vVPyEfWO7ayw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/87605-original-chex-party-mix-ddmfs-001-step4-f01c47ae7f4e4ddd94308d019cfe28e9.jpg"
      ],
      "image": "assets/images/87605/step_03.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
