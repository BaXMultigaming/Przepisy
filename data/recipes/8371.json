  "ingredients": [
    "1 (14 ounce) can sweetened condensed milk",
    "3 egg yolks",
    "0.5 cup butter",
    "1.3333300352097 cups flaked coconut",
    "1 cup chopped pecans",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Place condensed milk, egg yolks, and butter in a heavy 2-quart saucepan; cook over medium heat, stirring constantly, until bubbly, about 10 minutes. Remove from heat; stir in coconut, pecans, and vanilla.",
