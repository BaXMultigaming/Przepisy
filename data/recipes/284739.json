  "ingredients": [
    "cooking spray",
    "2 cups fresh cranberries",
    "1.25 cups white sugar, divided",
    "0.5 cup chopped pecans",
    "1 cup all-purpose flour",
    "0.75 cup unsalted butter, melted",
    "2 large eggs, slightly beaten",
    "1.5 teaspoons almond extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Coat an 8-inch deep-dish pie plate with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cranberries, 1/2 cup sugar, and pecans to the prepared pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat flour, remaining 3/4 cup sugar, butter, eggs, and almond extract together in a bowl with an electric mixer until creamy and white in color. Pour over cranberry mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are slightly crusty, middle is lightly set, and light golden color, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
