  "ingredients": [
    "0.66666668653488 cup butter, softened",
    "1 cup granulated sugar, or more to taste",
    "2 eggs, beaten",
    "1 teaspoon baking soda",
    "1 teaspoon vanilla extract",
    "1.25 teaspoons cream of tartar",
    "0.25 cup milk",
    "4 cups all-purpose flour",
    "1 pinch salt",
    "1 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar with an electric mixer in a large bowl until fluffy. Add 1 egg, allowing it to blend into the butter mixture before adding the next with the vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve cream of tartar in milk; beat into the butter mixture. Add 4 cups flour and pinch of salt; beat until doughy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1 cup flour onto a flat work surface. Roll the dough out on the prepared surface; cut out in desired shapes until all dough is used.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on non-stick baking sheets in preheated oven until cookies are set in the middle, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
