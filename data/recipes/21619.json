  "ingredients": [
    "0.5 cup flax seed",
    "3 bananas, mashed",
    "0.25 cup vegetable oil",
    "0.5 cup white sugar",
    "2 eggs",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 cup flax seed",
    "0.5 cup chopped pitted dates"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8x4-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grind 1/2 cup flax seed in an electric coffee grinder or food processor; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together banana, oil, sugar, and eggs in a large bowl. Mix together flour, baking powder, baking soda, salt, ground flax seed, and 1/4 cup whole flax seed in a separate bowl. Gradually stir flour mixture into banana mixture. Fold in dates. Spoon batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the loaf comes out clean, 55 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
