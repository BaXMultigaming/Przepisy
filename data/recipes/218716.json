  "ingredients": [
    "1 pound red potatoes, cut into 3/4-inch cubes",
    "0.25 cup mayonnaise",
    "2 tablespoons cider vinegar",
    "2 sprigs chopped fresh dill, or to taste",
    "salt and pepper to taste",
    "4 green onions, sliced",
    "0.5 cucumber - peeled, seeded, and finely chopped"
  ],
  "steps": [
    {
      "text": "Place potatoes in a large pot; cover with salted water. Bring to a boil over high heat, then reduce heat to medium-low, cover, and simmer until tender, about 12 minutes. Drain; steam dry while preparing dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, apple cider vinegar, dill, salt, and black pepper together in a large bowl; stir in green onions and cucumber.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add warm potatoes to dressing; toss gently to coat. Cover bowl; refrigerate before serving, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
