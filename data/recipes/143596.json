  "ingredients": [
    "2 eggs",
    "1 (15 ounce) can cream-style corn",
    "1 tablespoon packed brown sugar",
    "2 (8.5 ounce) packages dry corn muffin mix"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat oven to 400 degrees F (200 degrees C). Lightly grease the bottoms only of 12 muffin cups, or line with baking cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gBAOYpeSB3ai5wQrMDJWHUYf3LE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143596-easy-speedy-corn-muffins-VAT-step-01-fce6372d690a4861a9ec083411d1afad.jpg"
      ],
      "image": "assets/images/143596/step_01.webp"
    },
    {
      "text": "Place the eggs in a large bowl, and beat until light colored. Stir in the canned corn and sugar until well blended. Add the muffin mixes, and stir just until dry ingredients are moistened. The batter will be lumpy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7NPbfbKZtrjPvcvaTzdnZXnr1wE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143596-easy-speedy-corn-muffins-VAT-step-02-60377271dab741179b8a8039b05c2ddb.jpg"
      ],
      "image": "assets/images/143596/step_02.webp"
    },
    {
      "text": "Fill muffin cups 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mQ-qWFBb142AIYqjBYf5kP5ey9Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143596-easy-speedy-corn-muffins-VAT-step-03-4367f9d934b04fdca2ded30378e43b7e.jpg"
      ],
      "image": "assets/images/143596/step_03.webp"
    },
    {
      "text": "Bake in preheated oven until toothpick inserted in center of a muffin comes out clean, 16 to 22 minutes. Cool 5 minutes in pan, then turn out on a rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Er3sGhcV1F0ubh349emwE7NMjAM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/143596-easy-speedy-corn-muffins-VAT-step-04-cec50a64880b47f6aa1c3f402b68d096.jpg"
