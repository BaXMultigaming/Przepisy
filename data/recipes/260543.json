  "ingredients": [
    "1 cup whole wheat flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "1 cup low-fat cottage cheese",
    "0.75 cup low-fat milk",
    "2 eggs",
    "2 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Stir flour, baking soda, cinnamon, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cottage cheese, milk, eggs, and oil together in a separate bowl. Pour into the flour mixture; whisk until batter is just combined; it will be thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat an oiled griddle over medium-high heat; when a water drop on the surface dances and sizzles, it's ready. Drop 1/4 cup batter onto the griddle. Cook until golden brown and bubbles break the surface, 1 to 2 minutes. Turn and cook until set, about 1 minute more. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
