    "3 green onions, thinly sliced",
    "8 pepperoni slices, diced",
    "1 egg",
    "0.5 teaspoon garlic powder",
    "1 teaspoon melted butter",
    "0.25 cup grated Romano cheese",
    "1 pinch salt and ground black pepper to taste"
  ],
