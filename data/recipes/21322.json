  "ingredients": [
    "1 teaspoon butter",
    "4 (4 ounce) fillets salmon",
    "2 teaspoons vegetable oil",
    "0.5 red bell pepper, diced",
    "0.5 yellow bell pepper, diced",
    "2 teaspoons garlic, finely chopped",
    "1 lemon"
  ],
  "steps": [
    {
      "text": "In a large skillet, melt the teaspoon of butter and fry the salmon fillets until they are flaky on the inside and a little golden on the outside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium skillet, place the oil, red pepper and yellow pepper; saute for 3 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine garlic and lemon juice. Drizzle over the finished salmon fillets. Place the cooked peppers on top of the filets. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
