  "ingredients": [
    "1 tablespoon olive oil, divided",
    "1 small onion, finely chopped",
    "2 cloves garlic, minced",
    "2 (10 ounce) packages frozen spinach - thawed, drained, and chopped",
    "0.5 cup milk",
    "6 ounces cream cheese",
    "1 cup shredded mozzarella cheese, divided",
    "0.25 cup shredded Cheddar cheese",
    "2 dashes Worcestershire sauce",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a 1 1/2-quart shallow baking dish with 1 teaspoon olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 2 teaspoons olive oil in a large pot over medium heat. Cook and stir onion and garlic in hot oil until lightly browned, 4 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xtaMPppjy5IyeV6qwUwtOv0Qqa4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228778-creamy-cheesy-spinach-dip-mfs-step1-4x3-b2cd31c1425241709f61f0d9f3e12cf0.jpg"
      ],
      "image": "assets/images/228778/step_02.webp"
    },
    {
      "text": "Add spinach and simmer until spinach is hot, about 5 minutes. Drain any liquid from the mixture and transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jwLGUpnfkiLYYINC6m0BmrP8wpk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228778-creamy-cheesy-spinach-dip-mfs-step2-4x3-4d5326887d1c419cb57518847026d7c1.jpg"
      ],
      "image": "assets/images/228778/step_03.webp"
    },
    {
      "text": "Pour milk into the pot and return it to medium heat. Melt cream cheese into milk; cook and stir together, about 3 minutes. Return spinach mixture to pot with 1/2 cup mozzarella cheese and Cheddar cheese; stir to combine. Season the mixture with Worcestershire sauce, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PsUep9BT_hqS4GRZ3fr4dCHsznE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228778-creamy-cheesy-spinach-dip-mfs-step6-4x3-276761ef35f84a95a71a02b02a54f956.jpg"
      ],
      "image": "assets/images/228778/step_04.webp"
    },
    {
      "text": "Pour the mixture into the prepared baking dish and top with remaining 1/2 cup mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O8ZT2gnBhVQ7pw5asAitKyomflg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228778-creamy-cheesy-spinach-dip-mfs-step7-4x3-d3a3daa95225404e9af948a0eaec77ae.jpg"
      ],
      "image": "assets/images/228778/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until bubbly and golden brown on top, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
