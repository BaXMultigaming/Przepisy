  "title": "Corned Beef and Swiss Dip",
  "description": "This warm corned beef dip made with deli corned beef, cream cheese, sour cream, and shredded Swiss cheese is a deliciously creamy party appetizer.",
  "authors": [
    "ArmyWO"
  ],
  "date_published": "2019-04-02T02:56:32-04:00",
