  "ingredients": [
    "1 cup sugar",
    "0.75 cup fresh lime juice",
    "0.25 cup butter",
    "1 tablespoon lime zest",
    "2 large eggs, beaten"
  ],
  "steps": [
    {
      "text": "Place sugar, lime juice, butter, and lime zest in the top of a double boiler; stir over medium-high heat until butter melts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Temper eggs by mixing 2 tablespoons hot lime mixture into eggs, stir to blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium until water simmers. Slowly whisk egg mixture into the lime mixture. Cook over the double boiler until lime mixture thickens and coats the back of a wooden spoon, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool slightly and spoon into a clean, glass jar. Cover and refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
