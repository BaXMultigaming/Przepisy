  "ingredients": [
    "1 tablespoon vegan margarine (such as Earth Balance®)",
    "2 cups canned pinto beans, rinsed and drained",
    "1.5 tablespoons chopped onion",
    "0.25 cup sweet pickle relish",
    "2 tablespoons dill pickle juice",
    "2 tablespoons ketchup",
    "1 tablespoon molasses",
    "1 tablespoon tomato paste",
    "1 tablespoon brown sugar",
    "0.25 teaspoon hot sauce (such as Tabasco®)",
    "1 dash liquid smoke flavoring",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon salt-free seasoning blend",
    "0.25 teaspoon dry mustard"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt vegan margarine in a skillet over medium heat. Add onion. Cook and stir until translucent, about 5 minutes. Mix together with beans in a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir relish, pickle juice, ketchup, molasses, tomato paste, brown sugar, hot sauce, liquid smoke, garlic powder, salt seasoning, and mustard together in a bowl. Add to the bean mixture and mix to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until sauce is thick and casserole is heated through, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
