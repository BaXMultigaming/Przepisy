  "ingredients": [
    "1.5 pounds ground lamb",
    "1 onion, finely chopped",
    "2 cloves garlic, minced",
    "2 tablespoons garam masala",
    "1 teaspoon salt",
    "4 teaspoons tomato paste",
    "0.75 cup beef broth"
  ],
  "steps": [
    {
      "text": "Cook lamb in a large, heavy skillet over medium heat until browned and crumbly, 5 to 7 minutes. Use a slotted spoon to transfer lamb to a bowl; drain off all but 1 tablespoon fat from the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion to the skillet and sauté until soft and translucent, about 5 minutes. Stir in garlic and cook until fragrant, about 1 minute. Stir in garam masala and salt; cook for 1 minute. Return browned lamb to the pan with broth and tomato paste. Reduce the heat and simmer until lamb is fully cooked through and liquid has evaporated, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
