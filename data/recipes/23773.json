  "ingredients": [
    "2 (9 inch) deep dish frozen pie crusts",
    "1 small onion, finely chopped",
    "1 (4.5 ounce) can mushrooms, drained and chopped",
    "1 tablespoon finely chopped green bell pepper",
    "2 cups heavy cream",
    "6 eggs",
    "12 ounces cooked ham, chopped",
    "8 ounces shredded Monterey Jack cheese",
    "8 ounces shredded Swiss cheese",
    "0.5 teaspoon vinegar",
    "0.125 teaspoon dried tarragon",
    "1 pinch garlic powder",
    "1 pinch ground nutmeg",
    "1 pinch dried parsley",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Par-bake crusts in the preheated oven for 10 minutes. Set aside to cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sauté onion, mushrooms, and green pepper in a large skillet until onion is soft and translucent. Remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together cream and eggs in a large bowl until well combined. Stir in ham, Jack cheese, Swiss cheese, and sautéed vegetables. Stir in vinegar and season with tarragon, garlic powder, nutmeg, parsley, salt and pepper. Divide filling evenly between par-baked pie crusts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is set and crusts are golden brown, 55 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
