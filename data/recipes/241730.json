  "ingredients": [
    "1 tablespoon olive oil",
    "1 pound ground beef",
    "1 yellow onion, chopped",
    "3 cups water",
    "2 cups tomato sauce",
    "1 (16 ounce) package shredded white cabbage",
    "0.25 cup light brown sugar, packed",
    "2 tablespoons lemon juice",
    "2 tablespoons white vinegar",
    "2 teaspoons salt",
    "2 teaspoons white sugar",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon onion powder"
  ],
  "steps": [
    {
      "text": "Heat oil in a pot over medium-high heat. Cook and stir ground beef and onion in hot oil until beef is browned and crumbly and onion is soft, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water, tomato sauce, cabbage, brown sugar, lemon juice, vinegar, salt, white sugar, black pepper, and onion powder into ground beef mixture. Bring to a boil, reduce heat to medium-low, cover the pot with a lid, and simmer until flavors combine and cabbage is tender, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
