  "title": "Moist Apple and Walnut Cake",
  "description": "This moist apple and walnut cake recipe is quick and easy to make with chopped fruit and nuts, topped with a buttery glaze. Enjoy it warm or cooled.",
  "authors": [
    "Deb"
  ],
  "date_published": "1999-04-18T08:35:29-04:00",
