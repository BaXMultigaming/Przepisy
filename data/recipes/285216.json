  "ingredients": [
    "4 cups water",
    "2 cups white rice",
    "1 cup frozen corn",
    "1 teaspoon olive oil",
    "0.5 cup chopped onion",
    "1 cup salsa",
    "1 cup shredded pepper Jack cheese"
  ],
  "steps": [
    {
      "text": "Bring water and rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and water has been absorbed, 20 to 25 minutes, adding frozen corn with about 5 minutes remaining.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the rice is cooking, heat oil in a skillet over medium heat; stir in onion. Cook and stir until the onion has softened and turned translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir onions into the cooked rice-corn mixture. Stir in salsa and pepper Jack cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
