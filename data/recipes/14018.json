  "ingredients": [
    "1 (14.5 ounce) can diced tomatoes",
    "1 (6 ounce) can tomato paste",
    "0.75 cup fresh broccoli florets",
    "0.75 cup thinly sliced carrots",
    "0.75 cup sliced onion",
    "0.5 cup zucchini chunks",
    "0.5 cup sliced green bell pepper",
    "0.5 cup red bell pepper, sliced",
    "2 cloves garlic, chopped",
    "2 bay leaf",
    "1 tablespoon olive oil",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon dried rosemary",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried thyme",
    "1.5 teaspoons salt",
    "0.25 teaspoon ground black pepper",
    "1 teaspoon white sugar",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "In a large pot combine tomatoes, tomato paste, broccoli, carrots, onion, zucchini, green bell pepper, red bell pepper, garlic, bay leaves, olive oil, basil, rosemary, oregano, thyme, salt, pepper, sugar, and water. Heat to just boiling, cover and reduce heat to simmer. Cook until all vegetable are tender, approximately 45 minutes. Stir occasionally.",
