  ],
  "steps": [
    {
      "text": "Sift and whisk sugar, cocoa powder, cornstarch, and salt together in a saucepan; heat over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly pour in milk, whisking constantly until incorporated. Cook, stirring often with a metal spoon, until pudding is noticeably thicker and clings to the spoon, about 10 minutes. Off heat, stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
