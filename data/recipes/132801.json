  "ingredients": [
    "2 (9 ounce) packages cheese tortellini",
    "1 (24 ounce) jar marinara sauce",
    "1 (16 ounce) jar Alfredo sauce",
    "1 (10 ounce) box frozen chopped spinach, thawed and squeezed dry",
    "1 tablespoon dried Italian seasoning",
    "1 (8 ounce) package shredded Mozzarella cheese",
    "0.25 cup freshly grated Parmesan cheese",
    "1 teaspoon dried Italian seasoning"
  ],
  "steps": [
    {
      "text": "Preheat the oven broiler; adjust an oven rack to the highest position. Generously butter or grease an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add tortellini and cook according to package directions; drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring marinara and Alfredo sauces, spinach, and 1 tablespoon Italian seasoning to a simmer in a large saucepan over medium-high heat. Reduce heat to medium-low and simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tortellini into sauce, then pour into the prepared baking dish. Sprinkle with mozzarella cheese, Parmesan cheese, and 1 teaspoon Italian seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil until cheese has melted and turned golden brown, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
