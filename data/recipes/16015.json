  "ingredients": [
    "4 pounds Brussels sprouts",
    "0.5 cup unsalted butter",
    "4 small red onions, cut into strips",
    "0.25 cup red wine vinegar",
    "2 tablespoons white sugar",
    "salt and pepper to taste",
    "0.5 cup coarsely chopped pistachios"
  ],
  "steps": [
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add Brussels sprouts, cover, and steam until tender yet crisp, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a deep skillet over medium-high heat. Cook and stir onions and 3 tablespoons vinegar in hot butter until onions brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add steamed Brussels sprouts, sugar, and remaining 1 tablespoon vinegar to onions in the skillet. Sauté over medium heat until Brussels sprouts are lightly caramelized.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with salt and pepper. Garnish with pistachios to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
