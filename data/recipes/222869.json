  "ingredients": [
    "6 medium Yukon Gold potatoes, peeled and quartered",
    "1 small sweet onion, diced",
    "3 large hard-cooked eggs, chopped",
    "0.5 cup diced celery",
    "0.25 cup chopped sweet pickles",
    "salt and ground black pepper to taste",
    "1 cup mayonnaise",
    "0.33333334326744 cup sweet pickle juice",
    "1 teaspoon prepared yellow mustard"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce the heat to medium-low and simmer until tender, about 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer potatoes to a large bowl and mash with a potato masher. Stir in onion, eggs, celery, pickles, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mayonnaise, pickle juice, and mustard together in a separate bowl; pour over potatoes and mix until well combined. Cover and refrigerate for at least 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
