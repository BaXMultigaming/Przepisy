  "ingredients": [
    "2 teaspoons canola oil",
    "0.5 cup chopped onion",
    "0.5 cup chopped green bell pepper",
    "2 (6 inch) flour tortillas",
    "0.25 teaspoon dried oregano",
    "0.125 teaspoon garlic powder",
    "1 tomato, sliced",
    "0.5 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a small skillet over medium heat; cook and stir onion and green pepper until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tortillas on an ungreased baking sheet. Top with onion mixture, oregano, garlic powder, tomato, and mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until cheese is melted, 8 to 10 minutes. Cut each pizza into four wedges.",
