  "ingredients": [
    "2 (6 ounce) packages dry bread stuffing mix",
    "1.5 pounds lean ground beef",
    "0.5 cup chopped onions",
    "0.25 teaspoon chopped garlic",
    "3 large potatoes, chopped",
    "1 tablespoon vegetable oil",
    "0.5 teaspoon ground black pepper",
    "salt to taste",
    "2 (4 ounce) jars chopped pimento peppers",
    "0.5 cup chopped black olives",
    "0.25 cup sweet pickles, finely chopped",
    "0.25 cup dill pickles, diced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare the stuffing according to directions on package.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Over medium-low heat in a large saucepan, place the ground beef, onions and garlic. Slowly cook and stir until the onions are soft and the beef is evenly brown. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a large, deep skillet with oil. Slowly cook and stir 10 minutes, or until evenly brown and tender, but firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the stuffing, ground beef mixture, potatoes, pepper, salt, pimento peppers, olives, sweet pickles and dill pickles in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake 30 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
