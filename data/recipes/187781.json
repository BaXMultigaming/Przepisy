  "ingredients": [
    "1.75 cups chopped Italian flat-leaf parsley leaves",
    "1 cup olive oil",
    "0.25 cup red wine vinegar",
    "2 tablespoons dried oregano",
    "1 teaspoon ground cumin",
    "1 teaspoon kosher salt",
    "1 tablespoon minced garlic",
    "0.5 teaspoon hot sauce (such as Tabasco®)",
    "0.25 teaspoon red pepper flakes",
    "1 tablespoon fresh lemon juice"
  ],
  "steps": [
    {
      "text": "Place the Italian parsley, olive oil, red wine vinegar, oregano, cumin, salt, garlic, hot sauce, red pepper flakes, and lemon juice in the bowl of a food processor. Pulse until the parsley has been minced.",
