  "ingredients": [
    "12 ounces penne pasta",
    "0.25 cup butter",
    "2 tablespoons extra-virgin olive oil",
    "1 onion, diced",
    "1 red bell pepper, diced",
    "0.5 pound portobello mushrooms, diced",
    "2 cloves garlic, minced",
    "1 pound medium shrimp, peeled and deveined",
    "1 (15 ounce) jar Alfredo sauce",
    "0.5 cup grated Romano cheese",
    "0.5 cup cream",
    "1 teaspoon cayenne pepper, or more to taste",
    "salt and ground black pepper to taste",
    "0.25 cup chopped parsley"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter with olive oil in a saucepan over medium heat. Add onion; cook and stir until softened and translucent, about 2 minutes. Stir in bell pepper, mushrooms, and garlic; cook over medium-high heat until soft, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add shrimp; cook until firm and pink. Stir in Alfredo sauce, Romano cheese, and cream; bring to a simmer, stirring constantly, until thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with cayenne pepper, salt, and black pepper. Stir in penne. Sprinkle servings with parsley.",
      "section": null,
      "name": null,
      "url": null,
