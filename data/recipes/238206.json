  "ingredients": [
    "8 hamburger buns, split",
    "2 tablespoons butter",
    "0.5 onion, chopped",
    "2 tablespoons tomato paste",
    "2 cloves garlic, minced",
    "3 tablespoons Thai sweet chili sauce, or more to taste",
    "1 tablespoon Worcestershire sauce",
    "1 teaspoon white sugar",
    "2 pounds boneless, skinless chicken breast, or more to taste, cut in bite-size pieces",
    "2 tablespoons olive oil",
    "3 tablespoons sweet pickle relish",
    "3 tablespoons lemon juice",
    "2 tablespoons honey",
    "2 cups coleslaw mix"
  ],
  "steps": [
    {
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler. Arrange hamburger buns, cut-sides facing up, in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast buns under the preheated broiler until toasted, 30 to 60 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Cook and stir onion, tomato paste, and garlic in hot butter until onion is softened, about 5 minutes. Stir chili sauce, Worcestershire sauce, and sugar into onion mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chicken and olive oil into the skillet; cook and stir until chicken is no longer pink in the center, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk relish, lemon juice, and honey together in a large bowl; add coleslaw blend and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon chicken mixture into toasted buns and top with coleslaw.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
