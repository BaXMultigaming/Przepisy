  "title": "Sour Cream Cut-Out Cookies",
  "description": "Easy cut-out cookies that are wonderful anytime of year. I received this recipe when I was in grade school so it is a good recipe to have kids help with.",
  "authors": [
    "Rhonda Berg"
  ],
  "date_published": "2000-01-04T20:09:00-05:00",
