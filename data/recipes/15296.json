  "ingredients": [
    "1 cup butter",
    "1 cup white sugar",
    "0.5 cup sour cream",
    "1 egg",
    "3.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the butter and sugar. Stir in the egg and sour cream. Then stir in the baking soda and salt. Gradually add the flour until dough becomes too difficult to stir. Turn the dough out onto a floured surface and knead in flour until dough is no longer sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll the dough out to 1/4 to 1/2 inch thickness. Cut into desired shapes with cookie cutters. Place cookies 1 1/2 inches apart on unprepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 6 to 8 minutes in the preheated oven. Cookies should be lightly browned at the edges. Remove from the baking sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
