  "ingredients": [
    "1 (14 ounce) can refried beans",
    "1 teaspoon chili powder",
    "1 tablespoon vegetable oil",
    "0.5 pound frozen tail-off shrimp, thawed",
    "0.5 cup sliced green bell pepper",
    "0.5 cup sliced red bell pepper",
    "0.5 cup sliced onion",
    "2 tablespoons soy sauce",
    "1.5 teaspoons fajita seasoning",
    "1.5 teaspoons lemon pepper",
    "1 (12 ounce) package crispy red tostada shells"
  ],
  "steps": [
    {
      "text": "Mix refried beans and chili powder together in a microwave-safe bowl. Microwave on high until heated through, about 2 minutes. Cover to keep beans hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over high heat. Add shrimp, green bell pepper, red bell pepper, and onion. Stir in soy sauce, fajita seasoning, and lemon pepper. Cook and stir until shrimp is evenly coated and lightly browned, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring shrimp mixture to the table in the hot skillet. Spread refried beans over tostada shells; pile shrimp mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
