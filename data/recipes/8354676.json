  "ingredients": [
    "2 cups chopped leftover smoked chicken",
    "0.67 cup chopped celery",
    "0.5 cup halved seedless red grapes",
    "0.25 cup chopped pecans",
    "3 medium scallions, white and green parts, chopped",
    "0.5 cup mayonnaise",
    "1 teaspoon raspberry vinegar",
    "0.5 teaspoon ground paprika",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine chicken, celery, grapes, pecans, and scallions in a medium bowl.",
      "section": null,
      "name": null,
