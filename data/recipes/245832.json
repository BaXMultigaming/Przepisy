  "ingredients": [
    "1 tablespoon softened butter",
    "2 ripe pears - peeled, cored, and sliced, or more to taste",
    "3 eggs",
    "0.75 cup white sugar",
    "1.5 cups heavy whipping cream",
    "0.5 cup all-purpose flour",
    "2 tablespoons kirsch (cherry brandy)",
    "2 tablespoons grated lemon zest",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cardamom",
    "0.25 teaspoon salt",
    "2 tablespoons confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Butter a 10 1/2-inch round baking dish or pie plate. Fan pear slices out in a single layer in the bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and sugar together using an electric mixer fitted with a paddle attachment on medium speed until light and fluffy, about 3 minutes. Mix in heavy cream, flour, kirsch, lemon zest, vanilla extract, cardamom, and salt on low speed until batter is smooth. Set batter aside to rest, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter over the pears in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and golden brown, 40 to 45 minutes. Let cool briefly, about 15 minutes. Serve warm, sprinkled with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
