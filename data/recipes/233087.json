  "title": "Blueberry Oat Dream Bars",
  "description": "A creamy and dreamy mix of oats, blueberries, and cream cheese are baked into crowd-pleasing bars.",
  "authors": [
    "My Hot Southern Mess"
  ],
  "date_published": "2020-06-18T23:55:09-04:00",
