  "ingredients": [
    "1 cup quick-cooking oats",
    "0.75 cup light brown sugar",
    "0.5 cup all-purpose flour",
    "0.5 cup whole wheat flour",
    "0.5 cup butter",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup white sugar",
    "1 egg",
    "2 tablespoons lemon juice",
    "1 tablespoon lemon zest",
    "1 teaspoon vanilla extract",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, brown sugar, all-purpose flour, and whole wheat flour together in a bowl; cut in butter until mixture resembles coarse crumbs. Press half the oat mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is set, about 12 minutes. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and white sugar together in a bowl using an electric mixer until smooth; add egg, lemon juice, lemon zest, and vanilla extract. Beat mixture until smooth; fold in blueberries. Pour filling onto the baked crust; top with remaining oat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until bars are lightly browned, about 30 minutes. Cool in refrigerator, 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
