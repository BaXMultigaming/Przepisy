  "title": "Fennel Corn Muffin",
  "description": "A corn muffin is enhanced with the flavors of thyme, fennel, and black pepper for a savory treat.",
  "authors": [
    "GENKIANNA"
  ],
  "date_published": "2020-06-18T23:12:37-04:00",
