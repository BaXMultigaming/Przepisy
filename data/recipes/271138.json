  "ingredients": [
    "6 tablespoons olive oil",
    "1 pound Brussels sprouts, trimmed and halved lengthwise",
    "6 cloves garlic, minced",
    "salt and ground black pepper to taste",
    "1 tablespoon balsamic vinegar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a cast iron skillet until shimmering. Carefully place Brussels sprouts, cut-sides down, into hot oil. Sprinkle in garlic, salt, and pepper. Cook until Brussels sprouts begin to brown, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the skillet to the preheated oven; cook until Brussels sprouts are very browned and tender, 10 to 20 minutes. Shake the skillet every 5 minutes to ensure even cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with salt and pepper, stir in balsamic vinegar, and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
