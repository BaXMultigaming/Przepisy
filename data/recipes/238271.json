  "ingredients": [
    "2.3333332538605 cups grated zucchini",
    "1.5 over-ripe bananas, mashed",
    "1 cup applesauce",
    "1 cup brown sugar",
    "0.25 cup vegetable oil",
    "1 tablespoon lemon juice",
    "1.5 teaspoons vanilla extract",
    "3 cups all-purpose flour",
    "1 tablespoon baking soda",
    "1 tablespoon ground cinnamon",
    "2 teaspoons ground nutmeg",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "0.25 teaspoon ground cloves",
    "1 tablespoon white sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 12-cup muffin tins or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine zucchini, mashed bananas, applesauce, brown sugar, oil, lemon juice, and vanilla in a large bowl; mix well. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, 1 tablespoon cinnamon, nutmeg, baking powder, salt, and cloves together in a separate bowl until well combined; slowly stir into zucchini mixture until batter is just combined. Spoon batter into the prepared cups, filling each ¾ full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar and 1 teaspoon cinnamon in a small bowl; sprinkle over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
