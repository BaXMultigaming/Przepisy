  "ingredients": [
    "7 tablespoons butter",
    "2 sweet onions (such as Vidalia®), thinly sliced",
    "1 pound Jarlsberg cheese, shredded",
    "2 cups mayonnaise (such as Hellman's®)",
    "1 pinch paprika, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Cook and stir onions in hot butter until soft and translucent, 7 to 12 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir onions, Jarlsberg cheese, and mayonnaise together in a large bowl. Spread cheese mixture into 2 pie dishes. Sprinkle the tops with paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until dip puffs slightly and cheese is melted, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
