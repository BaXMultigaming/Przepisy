  "ingredients": [
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.5 teaspoons ground cinnamon",
    "0.25 teaspoon ground allspice",
    "0.5 cup butter, softened",
    "0.25 cup white sugar",
    "0.75 cup packed brown sugar",
    "2 eggs",
    "0.33333298563957 cup dark rum",
    "1 teaspoon vanilla extract",
    "1.25 cups applesauce",
    "1 cup dried cranberries",
    "3 tablespoons butter, melted",
    "0.25 cup packed brown sugar",
    "1 cup confectioners' sugar",
    "2 tablespoons dark rum"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray 9 or 10 inch Bundt pan lightly with cooking spray and dust with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine flour, baking soda, salt, cinnamon, and allspice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, cream 1/2 cup butter, white sugar, and 3/4 cup brown sugar. Mix in eggs, 1/3 cup rum, and vanilla. Mix in flour mixture in three additions alternately with applesauce, ending with flour. Stir in dried cranberries. Spoon batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 45 to 55 minutes, or until a toothpick inserted into the cake comes out clean. Cool cake in pan for 15 minutes, remove from pan, and cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small saucepan, melt 3 tablespoons butter. Stir in 1/4 cup brown sugar, confectioners' sugar, and 2 tablespoons rum. Heat until smooth; if mixture is too thick, add water and maybe a little more rum. Drip glaze over cooled cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
