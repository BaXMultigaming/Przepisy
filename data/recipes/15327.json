  "title": "Capirotada (Mexican Bread Pudding)",
  "description": "This capirotada bead pudding is made with sliced white bread, pineapple, raisins, and cheese covered in a cinnamon syrup for a sweet Mexican dessert.",
  "authors": [
    "Gloria A"
  ],
  "date_published": "1998-12-03T13:36:51-05:00",
