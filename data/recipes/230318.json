  "ingredients": [
    "cooking spray",
    "0.5 cup dried porcini mushrooms",
    "1 cup hot tap water",
    "0.75 cup all-purpose flour",
    "0.75 cup yellow cornmeal",
    "0.25 cup white sugar",
    "1 teaspoon fine salt",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon freshly ground black pepper",
    "1 pinch cayenne pepper, or to taste",
    "0.5 cup unsalted butter",
    "2 large eggs",
    "1 cup buttermilk",
    "0.25 cup milk",
    "1 (16 ounce) package frozen corn, thawed and drained",
    "0.25 cup chopped green onions"
  ],
  "steps": [
    {
      "text": "Place mushrooms in a small bowl, cover with hot water, and allow to soak until mushrooms have softened, about 30 minutes. Remove mushrooms from the bowl, squeeze to drain, and chop finely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour, cornmeal, sugar, salt, baking soda, black pepper, and cayenne pepper in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add chopped mushrooms and stir until lightly cooked and softened, 3 to 4 minutes. Remove from heat and allow to cool for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir eggs, buttermilk, and milk into flour mixture. Add mushroom mixture and corn; stir until well mixed. Fold in green onions. Transfer batter to the prepared baking dish and tap on a flat work surface 2 to 3 times to remove any air bubbles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden on top, 30 to 35 minutes. A paring knife inserted into the center should come out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G3hXUMLyohvGNpVM_aYvk1mawJY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/1059930-f7ba1fe1cb884bbcbaa6f281edaddaa9.jpg"
      ],
