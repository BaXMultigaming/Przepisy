  "ingredients": [
    "1 pound Brussels sprouts",
    "1 large Granny Smith apple - peeled, cored, and diced",
    "0.25 cup olive oil",
    "2 tablespoons maple syrup",
    "1 tablespoon balsamic vinegar",
    "salt and ground black pepper to taste",
    "0.25 cup dried cranberries, or more to taste",
    "0.25 cup roasted salted walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Brussels sprouts and apple in a large bowl. Whisk together olive oil, maple syrup, and balsamic vinegar in a small bowl and pour over Brussels sprouts-apple mixture. Toss until well combined and distribute in one layer on a baking sheet. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until Brussels sprouts are tender and browned, 10 to 15 minutes, turning them after about 6 minutes. Toss with cranberries and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
