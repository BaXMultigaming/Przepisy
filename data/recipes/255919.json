        "https://www.allrecipes.com/thmb/wS0jFcf0ot4UOiEYb6tR7mjSLxU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_255919_QuesdillaSalvadorena_Shot7_13237-1d19528ac2344347ad3b14c9660a5f57.jpg"
