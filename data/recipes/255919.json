      ],
      "image": "assets/images/255919/step_03.webp"
    },
    {
      "text": "Combine sugar and melted butter in a large bowl; beat on high speed until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T3s9vhLaWsYE3UUS0xph9bcCMdE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_255919_QuesdillaSalvadorena_Shot3_13222-7e73a5812c034270b736bf2e87dd0b5a.jpg"
      ],
      "image": "assets/images/255919/step_04.webp"
    },
    {
      "text": "Mix in egg yolks until well blended.",
      "section": null,
      "name": null,
      "url": null,
