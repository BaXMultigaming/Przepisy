  "ingredients": [
    "3 large eggs, separated, divided",
    "1 cup white sugar",
    "0.5 cup butter, melted",
    "1 (4 ounce) package Parmesan cheese, finely grated",
    "0.75 cup sour cream",
    "1 teaspoon baking powder",
    "1 cup rice flour",
    "1 tablespoon sesame seeds, or to taste"
  ],
