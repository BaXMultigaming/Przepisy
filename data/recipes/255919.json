      ],
      "image": "assets/images/255919/step_05.webp"
    },
    {
      "text": "Gradually mix in Parmesan cheese. Add sour cream and baking powder; beat until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BFSl8vRr1-e9yr8QFMdyDVCuKj8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_255919_QuesdillaSalvadorena_Shot5_13226-928fed83b8ca4a66b419e86ba15d8283.jpg"
