  "ingredients": [
    "16 vanilla wafer cookies",
    "1 (8 ounce) package cream cheese, softened",
    "0.75 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 16 muffin tin cups with cupcake liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 cookie in the bottom of each cupcake liner.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and sugar together in a medium bowl using an electric mixer until creamy. Beat in eggs and vanilla extract until smooth. Pour batter over the wafers in the cupcake liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and set, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
