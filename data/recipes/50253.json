  "ingredients": [
    "0.25 cup apple cider vinegar",
    "0.25 cup sugar",
    "0.25 cup vegetable oil",
    "0.25 teaspoon paprika",
    "1 dash Worcestershire sauce",
    "1 tablespoon butter",
    "0.5 cup slivered almonds",
    "2 romaine hearts, chopped into bite size pieces",
    "1 quart strawberries"
  ],
  "steps": [
    {
      "text": "Whisk vinegar, sugar, oil, paprika, and Worcestershire sauce together in a small bowl until well combined. Cover and refrigerate vinaigrette for at least 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a medium skillet over medium heat. Add almonds; cook until toasted and golden brown. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss romaine, strawberries, and toasted almonds together in a large bowl until well combined; toss with vinaigrette just before serving.",
