  "ingredients": [
    "1 cup chocolate stout beer",
    "3 green Thai chile peppers",
    "3 cloves garlic, peeled",
    "3 tablespoons brown sugar",
    "2 teaspoons dry mustard",
    "1 teaspoon garam masala",
    "1 teaspoon kosher salt",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon ground nutmeg",
    "1 (5 pound) whole chicken"
  ],
  "steps": [
    {
      "text": "Preheat grill for medium heat. If using charcoal, push coals to the side of the grilling area for indirect heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour stout beer into an empty 12-ounce soda can and drop Thai chilies and garlic cloves into the can. Mix brown sugar, dry mustard, garam masala, kosher salt, black pepper, cayenne pepper, cumin, cinnamon, onion powder, garlic powder, and nutmeg in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse the chicken and coat the skin with the entire batch of spice rub. Place soda can containing beer mixture onto the prepared grill and sit the chicken upright onto the can.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill chicken over indirect heat until juices run clear and an instant-read meat thermometer inserted into the thickest part of the breast, not touching bone, reads at least 165 degrees F (75 degrees C), about 45 minutes. Let chicken rest 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
