  "title": "Salmon en Croûte",
  "description": "Salmon en croûte is easy to make by wrapping a salmon fillet, tender mushrooms, and spinach in puff pastry and baking until the crust is golden and delicious.",
  "authors": [
    "Salvatore A Lenzo"
  ],
  "date_published": "2019-07-10T03:06:40-04:00",
  "date_modified": "2024-12-26T13:33:33-05:00",
  "prep_time": "PT15M",
  "cook_time": "PT60M",
  "total_time": "PT75M",
