    "French Inspired",
    "French"
  ],
  "regions": [
    "French Inspired",
    "French"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 tablespoons olive oil, divided",
    "0.5 onion, chopped",
    "1 cup chopped fresh mushrooms",
    "2 teaspoons minced garlic, divided",
    "salt and ground black pepper to taste",
    "1 cup baby spinach",
    "1 tablespoon all-purpose flour, or as needed",
    "2 sheets frozen puff pastry (such as Pepperidge Farm®), thawed",
    "1 (1 1/2-pound) boned, skinned salmon fillet",
    "0.5 teaspoon smoked paprika, or more to taste",
    "1 egg, beaten",
    "0.5 cup mayonnaise",
    "2 tablespoons fresh lemon juice",
    "2 teaspoons Dijon mustard",
    "0.5 teaspoon dried dill"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zZvRO0Laot6iehUiU7_cRyZTQ7E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-246066-salmon-en-croute-VAT-step-01-7571eb12a5bb4a5d94406a6647270759.jpg"
      ],
      "image": "assets/images/246066/step_01.webp"
    },
    {
      "text": "Heat 1 tablespoon oil in a large skillet over medium heat. Add onion; cook and stir until translucent, about 5 minutes. Add mushrooms and 1 teaspoon garlic; cook and stir until mushrooms are soft, about 5 minutes. Season with salt and black pepper. Transfer onion and mushroom mixture to a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j30dZir895F3IdNJES9E8my0JYo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-246066-salmon-en-croute-VAT-step-02-16c7f5219843456cb2ead2043171948f.jpg"
      ],
      "image": "assets/images/246066/step_02.webp"
    },
    {
      "text": "Heat remaining 1 tablespoon oil in the same skillet. Add remaining 1 teaspoon garlic; cook and stir until fragrant, about 30 seconds. Add spinach; cook and stir until wilted, 3 to 5 minutes. Season with salt and black pepper. Transfer to another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ehU8DJFPduT4lnZ-hGcu4NV0lAU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-246066-salmon-en-croute-VAT-step-03-811dcedf11344fbdb1e3fcc67c9d31e2.jpg"
      ],
      "image": "assets/images/246066/step_03.webp"
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a glass baking dish with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N-b-iq8c060FgbIXtG9kpka0FsI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-246066-salmon-en-croute-VAT-step-04-4671c7f33ed3424f8f9ff09372f2a124.jpg"
      ],
      "image": "assets/images/246066/step_04.webp"
    },
    {
      "text": "Dust work surface with flour. Lay 1 puff pastry sheet out on work surface; spread onion and mushroom mixture evenly across pastry, leaving a 1/2-inch border. Center salmon on top; sprinkle paprika over salmon and top with wilted spinach.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/u3FoBWk_OynbEZ2xyByBf02I4Bw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-246066-salmon-en-croute-VAT-step-05-ad1c50fc13ff40609588e96e4e83aa4a.jpg"
      ],
      "image": "assets/images/246066/step_05.webp"
    },
    {
      "text": "Cover with second puff pastry sheet. Fold over and crimp edges to seal. Brush top with beaten egg. Transfer to prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eOS4NXKSJYSr3NrLXu4oGh9WNCw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-246066-salmon-en-croute-VAT-step-06-3f8d4bcac29149beb2cbf8513d54ae79.jpg"
      ],
      "image": "assets/images/246066/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until pastry is golden, 40 to 45 minutes. Let cool briefly, then slice into 4 portions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QtLsOGfgCutY42Bsq5gq45Vvhcg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-246066-salmon-en-croute-VAT-step-07-3de3da2d643145d7bcefbfaa6af87c01.jpg"
      ],
      "image": "assets/images/246066/step_07.webp"
    },
    {
      "text": "To make the sauce: Whisk mayonnaise, lemon juice, Dijon mustard, and dill together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VRl7dNSseEy9XHc2_v_n-RdCUwQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-246066-salmon-en-croute-VAT-step-08-a903efb00ef3426ba4d95d20a35edcb2.jpg"
      ],
      "image": "assets/images/246066/step_08.webp"
    },
    {
      "text": "Spoon sauce onto 4 plates and place a piece of salmon en croûte on each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t2_ehJAhVOfk7imqurWH9a3IV5g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-246066-salmon-en-croute-VAT-step-09-0ad17be62eb64ec1adf00555fd884e65.jpg"
      ],
      "image": "assets/images/246066/step_09.webp"
    }
  ],
