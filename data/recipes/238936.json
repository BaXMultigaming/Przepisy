  "ingredients": [
    "PAM® No-Stick Cooking Spray",
    "6 large Granny Smith or other tart cooking apples, peeled, cut into 1/4-inch-thick slices",
    "0.5 cup dried cranberries",
    "0.75 cup firmly packed brown sugar",
    "0.5 cup old-fashioned or quick-cooking rolled oats",
    "0.33333334326744 cup all-purpose flour",
    "1 teaspoon ground cinnamon",
    "0.5 cup cold unsalted butter, cut up"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F. Spray 13x9-inch baking dish with cooking spray. Add apples and cranberries; toss lightly. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sugar, oats, flour and cinnamon in food processor container; cover. Process until well blended. Add butter; cover. Process until mixture resembles coarse crumbs, using pulsing action. Sprinkle over fruit. Bake 30 minutes or until topping is browned and filling is hot and bubbly.",
      "section": null,
      "name": null,
      "url": null,
