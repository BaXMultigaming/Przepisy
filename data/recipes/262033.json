  "ingredients": [
    "1 (16 ounce) package dried lima beans",
    "2 quarts water",
    "1 ham bone with meat",
    "1 large onion, sliced",
    "3 tablespoons brown sugar",
    "1 tablespoon Worcestershire sauce",
    "1 teaspoon hot pepper sauce",
    "1 teaspoon dry mustard",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Place lima beans in a large bowl and cover with several inches of water; soak 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water, ham bone, and onion to a boil in a pot. Reduce heat, cover, and simmer until onion is tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain and rinse lima beans and add to the pot with the ham bone. Add brown sugar, Worcestershire sauce, hot sauce, dry mustard, and salt. Simmer, covered, about 2 hours. Uncover and continue simmering soup until beans are tender, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove ham bone from soup; cut the meat into bite-sized pieces. Discard bone and return meat to the soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
