  "ingredients": [
    "0.25 cup almonds",
    "0.25 cup brown sugar",
    "0.25 cup butter, cut into cubes",
    "4 fresh peaches, peeled and halved",
    "0.25 cup brandy-based orange liqueur (such as Grand Marnier®)",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a small skillet over medium heat. Toast almonds in hot skillet until fragrant and lightly browned, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put almonds and brown sugar into a food processor bowl and process until almonds are chopped; add butter and pulse the mixture until completely blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange peaches with the cut sides facing up into the baking dish. Spoon 1 tablespoon almond mixture into the center of each peach. Pour liqueur and water into the baking dish; cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the peaches are tender, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
