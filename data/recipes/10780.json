  "ingredients": [
    "2.5 cups white sugar",
    "5 eggs",
    "1.25 cups vegetable oil",
    "1.5 cups unsweetened cocoa powder",
    "1.25 cups matzo cake meal",
    "1.25 cups chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and eggs together in a bowl with an electric mixer. Beat in oil. Stir in cocoa and matzo cake meal, then stir in nuts (or use the nuts as a topping).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is dry and edges have started to pull away from the sides of the pan, 30 to 35 minutes. (See Cook’s Note.) Let cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
