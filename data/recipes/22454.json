  "ingredients": [
    "cooking spray",
    "3 cups frozen hash brown potatoes",
    "0.75 cup shredded pepper Jack cheese",
    "1 cup cooked ham, diced",
    "0.25 cup chopped green onions",
    "1 (12 fluid ounce) can evaporated milk",
    "4 large eggs, beaten",
    "0.25 teaspoon ground black pepper",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a 2-quart casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange hash brown potatoes evenly in the bottom of the prepared dish. Sprinkle with pepper Jack cheese, then ham, and finally green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk evaporated milk, eggs, pepper, and salt together in a medium bowl; pour over layers in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let rest for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
