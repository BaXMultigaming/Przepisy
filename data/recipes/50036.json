  "ingredients": [
    "1 (10 ounce) package frozen strawberries",
    "0.5 (20 ounce) can crushed pineapple, drained",
    "4 eggs, beaten",
    "1.25 cups vegetable oil",
    "2 cups sugar",
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 teaspoons ground cinnamon",
    "0.75 cup chopped walnuts",
    "0.75 cup chopped macadamia nuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease two 5x9-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix the strawberries, pineapple, eggs, oil, and sugar. In a separate bowl, sift together the flour, baking soda, salt, and cinnamon. Mix the flour mixture into the bowl with the fruit until evenly moist. Fold in walnuts and macadamia nuts. Divide the batter between the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake loaves in the preheated oven until a toothpick inserted in the center of each loaf comes out clean, about 1 hour. Cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
