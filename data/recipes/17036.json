  "ingredients": [
    "1.5 cups milk",
    "1 cup pumpkin puree",
    "1 large egg",
    "2 tablespoons vegetable oil",
    "2 tablespoons vinegar",
    "2 cups all-purpose flour",
    "3 tablespoons brown sugar",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon ground allspice",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon salt",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Whisk milk, pumpkin, egg, oil, and vinegar together in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4SQwP7BY2zNH-ERmcwuGDwAGZAU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17036-pumpkin-pancakes-step-01-5f153106d05146a8a290c07ed053b3b6.jpg"
      ],
      "image": "assets/images/17036/step_01.webp"
    },
    {
      "text": "Whisk flour, sugar, baking powder, baking soda, allspice, cinnamon, ginger, and salt together in a medium bowl. Whisk into pumpkin mixture until no dry streaks remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZBnyIN-tYYX28pA_4wxx8_jO9rs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17036-pumpkin-pancakes-step-02-2-87c07fc746904aef9a9e2ff66365a32e.jpg"
      ],
      "image": "assets/images/17036/step_02.webp"
    },
    {
      "text": "Spray a griddle or skillet with cooking spray; heat over medium-high heat. Pour 3 to 4 tablespoons batter for each pancake onto the griddle; flatten slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eqnJhGJN329hfxjxIRIFwhMsYkk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17036-pumpkin-pancakes-step-04-1-2f8c2b4f06324622911d82d16457e0e2.jpg"
      ],
      "image": "assets/images/17036/step_03.webp"
    },
    {
      "text": "Cook until small bubbles form on surface, and edges look set, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1ukluiOnMvA7dP4QmUUdtF0khBY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17036-pumpkin-pancakes-step-04-2-43a34fab57bb4ecc98d675af8c93c48d.jpg"
      ],
      "image": "assets/images/17036/step_04.webp"
    },
    {
      "text": "Flip and cook until golden, about 2 minutes more. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DIwN5oBpTt3zv5NNLcuCvTk4FMM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17036-pumpkin-pancakes-step-04-3-1d9b305c5c8442ec8afe13d7fec01a52.jpg"
