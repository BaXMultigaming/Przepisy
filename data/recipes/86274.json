  "title": "Wisconsin Native&#39;s Beer Cheese Soup",
  "description": "This beer cheese soup, the pride of the Midwest, is creamy, flavorful, and spicy with beer, sharp Cheddar, milk, mustard, and Worcestershire sauce.",
  "authors": [
    "SAVVYHOSTESS"
  ],
  "date_published": "2018-06-08T09:26:46-04:00",
