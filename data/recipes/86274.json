  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "4 slices thick-cut bacon",
    "1.5 cups diced carrots",
    "1.5 cups diced onion",
    "1.5 cups diced celery",
    "2 cloves garlic, minced",
    "0.5 teaspoon salt",
    "0.25 teaspoon black pepper",
    "0.125 teaspoon cayenne pepper",
    "0.33333334326744 cup butter",
    "0.33333334326744 cup flour",
    "2 cups beer",
    "3 cups chicken broth",
    "4 cups milk or half and half",
    "1 tablespoon Dijon mustard",
    "2 teaspoons Worcestershire sauce",
    "1 teaspoon dry mustard",
    "1 teaspoon hot pepper sauce",
    "6 cups shredded sharp Cheddar cheese",
    "popped popcorn, for garnish"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SH_Eplqc2_Z2KPCLXfWrNQ9k1rs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86274-wisconsin-natives-beer-cheese-soup-DDMFS-001-1be67a8da0a345b9b2f1db14b06a9682.jpg"
      ],
      "image": "assets/images/86274/step_01.webp"
    },
    {
      "text": "Heat bacon in a large Dutch oven over medium heat. Cook, stirring occasionally, until crisp, 8 to 10 minutes. Transfer to a paper towel-lined plate, reserving drippings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d6yDcbiHNu_kJPBnBuOXBLjxZ6c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86274-wisconsin-natives-beer-cheese-soup-DDMFS-002-6a2b7ea566e64beea19be622d33f04b3.jpg"
      ],
      "image": "assets/images/86274/step_02.webp"
    },
    {
      "text": "Add carrots, onion, and celery to drippings and increase heat to medium-high. Cook, stirring occasionally, until softened, 6 to 8 minutes. Stir in garlic, salt, pepper, and cayenne; cook, stirring constantly, until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CQS_DXwiqC4eIwZfNrZuMwz59W4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86274-wisconsin-natives-beer-cheese-soup-DDMFS-003-cd39129c44a841c29c2f703ed63553b0.jpg"
      ],
      "image": "assets/images/86274/step_03.webp"
    },
    {
      "text": "Add butter and cook, stirring constantly, until melted. Add flour and cook, stirring constantly, until lightly browned, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bvSeS9JuEv-qI1QHqderf6h8RyU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86274-wisconsin-natives-beer-cheese-soup-DDMFS-004-0423581dab404ac38205e59c7cd245e7.jpg"
      ],
      "image": "assets/images/86274/step_04.webp"
    },
    {
      "text": "Stir in beer, and cook, stirring occasionally, until thickened, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zKf4dN4iBfIIZtdcDdEgF6UPz04=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86274-wisconsin-natives-beer-cheese-soup-DDMFS-005-f21b76f9a539456a9c617332bdf8a0f2.jpg"
      ],
      "image": "assets/images/86274/step_05.webp"
    },
    {
      "text": "Stir in broth and half-and-half; bring to a boil. Reduce heat to medium to maintain a simmer and cook, stirring occasionally, just until mixture lightly coats the back of a spoon, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RMRWH-UUEoJB-OaxieszHVJi9Jc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86274-wisconsin-natives-beer-cheese-soup-DDMFS-006-3e5efb9ca66f4cceb424f6df5f01211b.jpg"
      ],
      "image": "assets/images/86274/step_06.webp"
    },
    {
      "text": "Stir in Dijon, Worcestershire, dry mustard, and hot sauce until fully incorporated. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EK9vxo6VWb7PJPY2Wq5mPD3Gmsk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86274-wisconsin-natives-beer-cheese-soup-DDMFS-007-91b8f013208044ffab5cc58eefe5d58b.jpg"
      ],
      "image": "assets/images/86274/step_07.webp"
    },
    {
      "text": "Add cheese, 1/2 cup at a time, stirring constantly until melted before adding more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OsYSHsHh7zHHtw-swnKLgRjQITA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86274-wisconsin-natives-beer-cheese-soup-DDMFS-008-b963a712f1674dabaa2716bdcdc2c315.jpg"
      ],
      "image": "assets/images/86274/step_08.webp"
    },
    {
      "text": "Serve hot, topped with popcorn and reserved bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yMYiBHqexx0IaYPLwYC2gFvkjIc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86274-wisconsin-natives-beer-cheese-soup-DDMFS-010-73d724550a7245dea8b9c2a608af0088.jpg"
      ],
      "image": "assets/images/86274/step_09.webp"
    }
  ],
