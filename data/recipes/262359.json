  "ingredients": [
    "1 (12 ounce) package extra-firm tofu, drained",
    "salt to taste",
    "0.5 cup cornmeal",
    "ground cinnamon, or more to taste",
    "olive oil, or more as needed"
  ],
  "steps": [
    {
      "text": "Slice tofu into 1/8-inch-thick slices, laying slices on a paper towel-lined plate; season each side lightly with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cornmeal in a shallow bowl; stir in a pinch of salt and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each side of tofu slices in cornmeal mixture; gently tap off excess. Add tofu to the skillet; cook until golden brown and crisp, 2 to 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
