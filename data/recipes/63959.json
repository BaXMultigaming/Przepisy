      "image_sources": [
        "https://www.allrecipes.com/thmb/tS_UcuMqYdYTwJffdduKNSMebh4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/63959-magic-cookie-bars-from-eagle-brand-DDMFS-step-06-011-a74da3cbd13349598d0a7b4560803ca9.jpg"
