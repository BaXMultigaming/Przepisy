  "ingredients": [
    "1.5 cups graham cracker crumbs",
    "0.5 cup butter or margarine, melted",
    "1 (14 ounce) can EAGLE BRAND® Sweetened Condensed Milk",
    "2 cups semisweet chocolate morsels",
    "1.3333333730698 cups flaked coconut",
    "1 cup chopped nuts"
