  "ingredients": [
    "2 cups biscuit baking mix",
    "0.5 cup white sugar",
    "2 tablespoons grated orange zest",
    "0.67 cup orange juice",
    "1 egg, beaten",
    "1 tablespoon vegetable oil",
    "0.5 cup almonds, chopped",
    "0.5 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together baking mix, sugar and orange zest. Add orange juice, egg and vegetable oil; stir to combine. Fold in almonds and raisins. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 35 minutes, until a toothpick inserted into center of loaf comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
