  "ingredients": [
    "2 peaches, thinly sliced",
    "1 pinch ground cinnamon, or more to taste",
    "4 cups milk",
    "1 cup white sugar",
    "0.66666668653488 cup all-purpose flour",
    "6 egg yolks, beaten",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Place peach slices in a large serving bowl; sprinkle with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, sugar, flour, and egg yolks in a medium saucepan; cook and stir over medium-low heat until thickens and clings to the back of a spoon, about 20 minutes. Off heat, stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour hot pudding over peaches. Refrigerate until chilled, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
