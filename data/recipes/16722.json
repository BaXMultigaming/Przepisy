  "ingredients": [
    "0.75 cup unsweetened cocoa powder",
    "0.5 teaspoon baking soda",
    "0.666 cup vegetable oil, divided",
    "0.5 cup boiling water",
    "2 cups white sugar",
    "2 large eggs",
    "1.3333333730698 cups all-purpose flour",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O2VidvKg126nrRkZkbBlGI2KhSk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16722-fudgy-brownies-ddmfs-steps-4x3_6595-ae627b5d91934abe99e5d41a9be31f6d.jpg"
      ],
      "image": "assets/images/16722/step_01.webp"
    },
    {
      "text": "Stir cocoa and baking soda together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/glLUODEoi8cyPdnyR0pDwfoVDC8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16722-fudgy-brownies-ddmfs-step02-4x3_6600-cdc56dc577594dbc9048c6d9d479c419.jpg"
      ],
      "image": "assets/images/16722/step_02.webp"
    },
    {
      "text": "Mix in boiling water and 1/3 cup oil until well blended and thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7EIGt_ERpq3LRYQxlm4Pt88RUrU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16722-fudgy-brownies-ddmfs-step03-4x3_6602-f9688b576b26400691bfc949ee11c55c.jpg"
      ],
      "image": "assets/images/16722/step_03.webp"
    },
    {
      "text": "Stir in sugar, remaining 1/3 cup oil, and eggs. Mix in flour, vanilla, and salt just until flour is absorbed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V6ydB8g_rnIkG35umieBrfm6ays=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16722-fudgy-brownies-ddmfs-step05-4x3_6604-b67831e041a74434a0bac235234f1352.jpg"
      ],
      "image": "assets/images/16722/step_04.webp"
    },
    {
      "text": "Spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/14HILRoaHc7bghwO80x6NgK3izk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16722-fudgy-brownies-ddmfs-step06-4x3_6605-60a765b2f68a4f6b9543dc00d68dc154.jpg"
      ],
      "image": "assets/images/16722/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 35 to 40 minutes. Let cool completely before cutting into 24 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3lauR2G1f_JZ4P4AKXkIxvEgq64=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16722-fudgy-brownies-ddmfs-step07-4x3_6607-4e0102e5c94d45c38d31ba4c3d8c8d06.jpg"
