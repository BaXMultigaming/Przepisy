  "title": "Real Southern Cornbread",
  "description": "Pure, unsweetened corn bread is first cooked over high heat in a cast-iron skillet before baking into the oven. This is a traditional Southern approach to making this popular bread.",
  "authors": [
    "Jason"
  ],
  "date_published": "1999-08-08T01:30:58-04:00",
