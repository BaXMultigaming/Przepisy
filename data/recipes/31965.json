  "ingredients": [
    "1 pound ground beef",
    "1 (15 ounce) can tomato sauce",
    "1 cup sour cream",
    "1 teaspoon dried thyme",
    "3.5 cups farfalle (bow tie) pasta, uncooked",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "1 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Bring a pan of lightly salted water to a boil. Add the pasta, and cook until tender, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble ground beef into a skillet over medium-high heat. Cook, stirring constantly until evenly browned. Drain excess grease, and stir in the tomato sauce, sour cream and thyme.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the cooked pasta into the bottom of a 2 quart casserole dish. Pour the ground beef mixture over the pasta. Cover with a layer of spinach. Top with shredded cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes in the preheated oven, until heated through and lightly browned on the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
