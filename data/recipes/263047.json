  "ingredients": [
    "1 head savoy cabbage, sliced",
    "3 tablespoons butter",
    "0.25 cup heavy whipping cream, or to taste",
    "0.125 teaspoon ground nutmeg, or to taste",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place cabbage into a pot, cover with cold water, and bring to a boil. Once boiling, cook for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain and rinse cabbage under cold water, then squeeze with your hands until cabbage is as dry as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add cabbage, cream, nutmeg, salt, and pepper. Cook until cabbage is soft and creamy, 2 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
