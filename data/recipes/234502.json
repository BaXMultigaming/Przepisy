  "ingredients": [
    "6 tablespoons water",
    "2 tablespoons flax seed meal",
    "1 cup rolled oats",
    "1.75 cups soy milk",
    "0.5 cup all-purpose flour",
    "0.5 cup whole wheat flour",
    "2 tablespoons canola oil",
    "4 teaspoons baking powder",
    "1 teaspoon vanilla extract",
    "1 tablespoon agave nectar",
    "0.5 teaspoon salt"
