  "steps": [
    {
      "text": "Bring a small saucepan of water to a boil over high. Add hot dogs; reduce heat to medium-low and simmer 5 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small skillet over medium heat. Add onions and saute until onions are soft and have started to brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain hot dogs. Slice each into 8 rounds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange Snack Factory® Pretzel Crisps® on a serving platter. Top with about a teaspoon sauerkraut and a hot dog round. Drizzle with mustard and top with grilled onions.",
      "section": null,
