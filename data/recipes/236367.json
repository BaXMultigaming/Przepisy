  "ingredients": [
    "1.5 pounds lean ground beef",
    "1 (24 ounce) jar RAGÚ® Old World Style® Traditional Sauce",
    "2 cups water",
    "1 cup part-skim ricotta cheese",
    "2 tablespoons grated reduced-fat Parmesan cheese",
    "12 ounces uncooked ziti pasta",
    "0.75 cup shredded part-skim mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, brown ground beef in a large nonstick skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sauce and water in a large bowl. Stir in browned ground beef, ricotta, Parmesan cheese, and uncooked ziti. Pour ziti mixture into a 13x9-inch baking dish. Cover tightly with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 55 minutes. Remove foil and sprinkle with mozzarella cheese. Bake uncovered for an additional 5 minutes. Let stand 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
