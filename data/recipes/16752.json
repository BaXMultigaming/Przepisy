  "ingredients": [
    "1.5 pounds bacon",
    "1 (32 ounce) jar mayonnaise",
    "1 onion, minced",
    "0.5 cup light corn syrup",
    "0.25 cup apple cider vinegar",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large, deep skillet over medium-high heat until evenly browned. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble bacon into a large bowl; stir in mayonnaise, onion, corn syrup, vinegar, and black pepper until well combined. Cover and refrigerate for 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
