  "title": "Easy Salisbury Steak",
  "description": "These easy Salisbury steaks are made with ground beef, oats, ketchup, and minced dried onion and are topped with cream of mushroom soup and onion rings.",
  "authors": [
    "Kendrick"
  ],
  "date_published": "2019-04-03T23:53:47-04:00",
