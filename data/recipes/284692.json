  "ingredients": [
    "2.5 cups all-purpose flour",
    "1.25 cups white sugar",
    "1 (8 ounce) package cream cheese, at room temperature",
    "0.5 cup unsalted butter, melted",
    "2 large eggs",
    "2 teaspoons baking powder",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "0.25 cup sifted powdered sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, cream cheese, butter, eggs, baking powder, vanilla, and salt in a bowl until a dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop rounded tablespoons of dough 2 inches apart onto cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bottoms are very lightly golden brown and tops are just about to turn color, 10 to 14 minutes. Let cool for at least 10 minutes. Sprinkle with powdered sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
