        "https://www.allrecipes.com/thmb/ct8sZg3wLNTWdMeP6m3GZ2Bli3w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_88596_AwesomeBakedSeaScallops_Shot3_11919-1a113ac6c7c14f7796647d5641a83da1.jpg"
