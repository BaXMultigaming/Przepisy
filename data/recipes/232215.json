  "keywords": [],
  "ingredients": [
    "12 ounces pine nuts",
    "0.25 cup white sugar",
    "2 tablespoons water",
    "0.66666668653488 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a baking sheet with parchment paper; spread pine nuts in an even layer on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until most of the pine nuts are light golden brown and fragrant, about 20 minutes. Remove from the oven; keep the oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir sugar and water in a saucepan over medium heat until mixture turns light brown and syrupy, 5 to 10 minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pine nuts to the saucepan; gently mix until coated with syrup. Stir in Parmesan cheese until nuts are coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Replace parchment paper on the baking sheet with a fresh piece. Spread coated pine nuts on top, breaking apart any bunches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake until cheese is melted, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
