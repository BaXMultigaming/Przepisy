  "title": "Artichoke Pie",
  "description": "This artichoke pie features hearts with garlic, bread crumbs, and Parmesan cheese baked in a pie crust and topped with mozzarella.",
  "authors": [
    "Lisa Bianco"
  ],
  "date_published": "1999-12-15T10:26:27-05:00",
