  "ingredients": [
    "1 tablespoon olive oil",
    "1 clove garlic, minced",
    "2 (6 ounce) cans artichoke hearts, drained",
    "0.5 cup Italian seasoned bread crumbs",
    "0.5 cup grated Parmesan cheese, divided",
    "1 (9 inch) unbaked 9 inch pie crust",
    "3 eggs, beaten",
    "1 (8 ounce) package mozzarella cheese, shredded"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat. Sauté garlic in hot oil until garlic starts to brown. Add artichoke hearts and cook, stirring occasionally, for 10 minutes. Stir in bread crumbs and 1/4 cup Parmesan cheese; cook and stir until heated through. Transfer 1/2 of the artichoke mixture to pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour beaten eggs over artichoke mixture in crust and sprinkle with remaining 1/4 cup Parmesan cheese. Spoon remaining artichoke mixture on top and sprinkle with mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust begins to brown, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
