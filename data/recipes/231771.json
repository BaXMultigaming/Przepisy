  "ingredients": [
    "0.75 pound ground beef chuck",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.66666668653488 cup ketchup",
    "2 tablespoons prepared yellow mustard",
    "1 (14 ounce) pre-baked pizza crust",
    "1.5 cups shredded mozzarella cheese",
    "1 cup shredded sharp Cheddar cheese",
    "0.5 cup chopped onions",
    "0.5 cup dill pickle slices",
    "1 cup shredded lettuce",
    "1 cup diced tomatoes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef, salt, and pepper in the hot skillet until meat is browned and crumbly, 5 to 7 minutes; drain and discard grease. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together ketchup and mustard in a small bowl; spread mixture over pizza crust. Sprinkle mozzarella and Cheddar cheese on top and cover with cooked beef and onions. Transfer pizza to a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, about 20 minutes. Top with pickle slices and allow pizza to cool for 5 minutes. Top with lettuce and tomatoes before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
