  "ingredients": [
    "3 large eggs",
    "1 cup all-purpose flour",
    "0.5 cup plain bread crumbs",
    "0.5 cup panko bread crumbs",
    "0.5 tablespoon kosher salt",
    "1 teaspoon onion powder",
    "1 teaspoon garlic powder",
    "1 teaspoon ground black pepper",
    "1 teaspoon paprika",
    "1 teaspoon seafood seasoning (such as Old Bay®)",
    "1 pound small cremini mushrooms",
    "nonstick cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a bowl. Combine flour, plain bread crumbs, panko bread crumbs, kosher salt, onion powder, garlic powder, pepper, paprika, and seafood seasoning in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip mushrooms in beaten eggs, then in seasoned crumb mixture. Dip back into eggs and into crumb mixture again. Place on a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a batch of mushrooms in the air fryer basket, making sure none are overlapping. Spray with nonstick cooking spray. Cook in the preheated air fryer for 6 minutes. Shake the basket and spray any chalky spots with nonstick cooking spray. Cook for 6 minutes more. Repeat with remaining mushrooms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
