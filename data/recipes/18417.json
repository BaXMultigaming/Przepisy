  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "3 tablespoons olive oil",
    "1 large onion, chopped",
    "1 bunch green onions, chopped",
    "2 cloves garlic, minced",
    "2 pounds spinach, rinsed and chopped",
    "0.5 cup chopped fresh parsley",
    "1 cup crumbled feta cheese",
    "0.5 cup ricotta cheese",
    "2 large eggs, lightly beaten",
    "8 sheets phyllo dough",
    "0.25 cup olive oil, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly oil a 9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zw-LCV6mEtJuEF8Z3uKorjUmtD4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18417-spanakopita-greek-spinach-pie-DDMFS-Step-01-24906-1-e01dd3ed4bad4f4188821548fb11b841.jpg"
      ],
      "image": "assets/images/18417/step_01.webp"
    },
    {
      "text": "Heat 3 tablespoons olive oil in a large skillet over medium heat. Add chopped onion, green onions, and garlic; cook and stir until soft and lightly browned, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dZnfzeyjgW-6fdsljbJ7Z0oDDJs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18417-spanakopita-greek-spinach-pie-DDMFS-Step-02-24912-1-d406674b565342f4974780cf412da0e7.jpg"
      ],
      "image": "assets/images/18417/step_02.webp"
    },
    {
      "text": "Stir in spinach and parsley, adding spinach in batches if it doesn't all fit in the skillet at once; cook until spinach is limp and excess liquid has evaporated, about 5 minutes. Remove from the heat; set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8H5HUbnaN5Dmm6_KZo9ktAwmUQo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18417-spanakopita-greek-spinach-pie-DDMFS-Step-03-24913-1-180bc693279d443bbc16f9ab4c718f9b.jpg"
      ],
      "image": "assets/images/18417/step_03.webp"
    },
    {
      "text": "Combine feta cheese, ricotta cheese, and eggs in a large bowl until well combined; stir in spinach mixture. Lay one phyllo dough sheet in the prepared baking pan; brush lightly with olive oil. Lay another phyllo dough sheet on top; brush with olive oil. Repeat with two more phyllo dough sheets; the sheets will overlap the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9nVKj_mmg_qcEJVqryxY7dOG810=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18417-spanakopita-greek-spinach-pie-DDMFS-Step-05-24921-1-33d9d07dfeaa4d1ca73a800f1eeed6d2.jpg"
      ],
      "image": "assets/images/18417/step_04.webp"
    },
    {
      "text": "Spread spinach and cheese mixture into the pan. Fold any overhanging phyllo dough over filling; brush with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vlJkUbPI9eWJncG_COqLP9A_QL8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18417-spanakopita-greek-spinach-pie-DDMFS-Step-06-24922-1-b17af4c5481640dab6bc754dd67dcf02.jpg"
      ],
      "image": "assets/images/18417/step_05.webp"
    },
    {
      "text": "Layer in remaining 4 phyllo dough sheets, brushing each with oil. Tuck overhanging phyllo dough into the pan to seal the filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tRgjLLq9eWQ7lSam7MjShiIIL1I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18417-spanakopita-greek-spinach-pie-DDMFS-Step-07-24925-1-e9d5bf94487d41baaf997377982b95be.jpg"
      ],
      "image": "assets/images/18417/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jSDpKXA-LB66M9d7yRBLeYx0e78=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18417-spanakopita-greek-spinach-pie-DDMFS-Step-08-24935-1-0ece9d48464a419199c974f79b47c57a.jpg"
      ],
      "image": "assets/images/18417/step_07.webp"
    },
    {
      "text": "Cut into squares and serve while hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l7SOxyufEJyTGWsypzRM97oYV3o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18417-spanakopita-greek-spinach-pie-DDMFS-Step-09-24938-1-1492c0e556a44c7ca510db63f6f87745.jpg"
      ],
      "image": "assets/images/18417/step_08.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2xlOb_TWCxRS7mkOO7SnJu52xgM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18417-spanakopita-greek-spinach-pie-DDMFS-Hero-4x3-24958-1-47b06767b5264f78ab74634a3106fcf5.jpg"
      ],
      "image": "assets/images/18417/step_09.webp"
    }
  ],
