  "ingredients": [
    "1 (16 ounce) package macaroni",
    "2 red bell peppers, chopped",
    "1 green bell pepper, chopped",
    "1 stalk celery, chopped",
    "0.5 cup chopped green onions",
    "1 tablespoon olive oil",
    "1 cup mayonnaise",
    "1 packet dry vegetable soup mix"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes. Drain and rinse with cold water until cool; transfer to a large serving bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir bell peppers, celery, green onions, and olive oil into macaroni; mix until well combined. Stir in mayonnaise and soup mix until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill pasta salad in the refrigerator before serving, 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
