  "ingredients": [
    "2 cups water",
    "1 cup uncooked white rice",
    "1 pound medium shrimp, peeled and deveined",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon cayenne pepper",
    "1 clove garlic, minced",
    "1 tablespoon sesame seeds",
    "0.25 teaspoon ground black pepper",
    "2 tablespoons sesame oil",
    "1 red bell pepper, sliced into thin strips",
    "3 green onions, sliced",
    "3 tablespoons teriyaki sauce",
    "0.5 pound sugar snap peas",
    "0.125 cup cornstarch",
    "0.75 cup chicken broth",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "In a medium saucepan, bring salted water to a boil. Add rice, reduce heat, cover and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While rice is simmering, combine shrimp, ginger, cayenne pepper, garlic, sesame seeds and black pepper in a large plastic food storage bag. Allow to marinate in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat sesame oil in a large wok or skillet. Add red bell pepper and green onions; saute 3 to 4 minutes to soften slightly Add teriyaki sauce. Add peas and shrimp with seasoning; saute 4 minutes or until shrimp are opaque.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cornstarch into chicken broth and add to wok; cook, stirring until mixture boils. Sprinkle with salt. Spoon shrimp mixture over rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
