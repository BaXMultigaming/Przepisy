  "title": "Sesame Shrimp Stir-Fry",
  "description": "This quick and tasty main dish has a double hit of sesame oil and seeds that add nutty flavor to crisp peppers and shrimp.",
  "authors": [
    "Debbie"
  ],
  "date_published": "2000-03-12T17:27:32-05:00",
