  "title": "Grilled Teriyaki Salmon",
  "description": "This grilled teriyaki salmon features a marinade of apple juice and garlic that's cooked down to a rich, tasty sauce to drizzle over the cooked fish.",
  "authors": [
    "STELLY"
  ],
  "date_published": "2004-07-28T12:33:53-04:00",
