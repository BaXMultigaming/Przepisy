  "title": "Deep-Fried Panko Shrimp",
  "description": "Panko bread crumbs are used in the breading for these deep-fried shrimp for more flavor and a crispy texture.",
  "authors": [
    "Soup Loving Nicole"
  ],
  "date_published": "2022-03-24T08:26:14-04:00",
