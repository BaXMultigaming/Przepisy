  "ingredients": [
    "2 cups vegetable oil for frying, or as needed",
    "2 medium eggs",
    "1.5 cups panko bread crumbs",
    "1 teaspoon paprika",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon salt",
    "0.13 teaspoon freshly ground black pepper",
    "1 pound large shrimp - peeled, deveined, and tails left on"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine panko bread crumbs, paprika, garlic powder, salt, and pepper in a large resealable plastic bag. Seal and shake to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip shrimp in the beaten egg, shaking off excess. Drop shrimp into the bag of panko mixture and shake to coat. Place shrimp on a plate and repeat with remaining shrimp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop shrimp in batches into the preheated deep fryer and cook until breading is browned and shrimp are opaque, about 1 1/2 minutes per batch.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove with a slotted spoon and drain on a paper towel-lined plate. Repeat with remaining shrimp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
