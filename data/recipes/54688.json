        "https://www.allrecipes.com/thmb/_Zxae_l2VdPsatkSQ_7M-GxnRSc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/54688-kims-macaroni-salad-VAT-008-step-03-02-3f8dd105d12c4c27a57cf96ba775c77e.jpg"
      ],
      "image": "assets/images/54688/step_03.webp"
    },
    {
