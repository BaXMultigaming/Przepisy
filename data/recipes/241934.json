  "ingredients": [
    "1 cup packed brown sugar",
    "1 cup coconut sugar",
    "0.5 cup butter, softened",
    "0.5 cup coconut oil",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2 teaspoons hot water",
    "1 teaspoon baking soda",
    "0.5 teaspoon cream of tartar",
    "3 cups all-purpose flour",
    "1 cup dark chocolate chips (such as Ghirardelli® 60% Cacao)",
    "0.5 cup chopped walnuts",
    "0.25 cup chia seeds",
    "0.25 cup ground flax seeds",
    "0.25 cup cocoa nibs",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, coconut sugar, butter, and coconut oil with an electric mixer in a large bowl until smooth. Beat the first egg into creamed butter mixture until completely blended; beat in vanilla extract with the last egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir hot water and baking soda together in a small bowl until baking soda is dissolved; stir into butter mixture. Add cream of tartar and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour into butter mixture until dough is smooth; fold in walnuts, chia seeds, flax seeds, cocoa nibs, and salt. Drop dough by rounded tablespoons onto prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are lightly browned around the edges, about 12 minutes. Transfer cookies to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
