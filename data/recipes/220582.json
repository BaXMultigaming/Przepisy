  "ingredients": [
    "2 cups water, divided",
    "1 teaspoon brown sugar",
    "1 small lemon, halved and juiced, halves reserved",
    "1 large apple (such as Honey Crisp), peeled and chopped",
    "4 large baking potatoes, peeled and chopped",
    "6 cups water",
    "3 tablespoons butter",
    "3 tablespoons heavy whipping cream",
    "1 teaspoon salt",
    "1 tablespoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Boil 2 cups water, brown sugar, lemon juice, juiced lemon halves, and apple together in a pot over medium-high heat until apples are tender, 10 to 12 minutes. Discard spent lemon halves; drain and keep apples warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Boil potatoes with 6 cups water in a large pot over medium-high heat until tender, 15 to 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash potatoes and apples together with a ricer or hand mixer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir butter, heavy whipping cream, salt, and ground black pepper into mashed potatoes and apples. If desired, keep warm in a 350 degrees F (175 degrees C) oven for up to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
