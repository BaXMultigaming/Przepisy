  "ingredients": [
    "2 cups wild raspberries",
    "0.25 cup white sugar",
    "1.5 cups milk",
    "0.25 teaspoon lemon juice",
    "0.125 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Heat raspberries and sugar in a small saucepan over low heat, stirring until sugar dissolves, about 5 minutes. Press raspberry mixture through a strainer into a bowl; discard seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk, lemon juice, and cinnamon into raspberry mixture; refrigerate until cold, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour raspberry-milk mixture into an ice cream maker and freeze according to manufacturer’s instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
