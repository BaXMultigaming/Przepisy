  "ingredients": [
    "1.75 cups all-purpose flour",
    "2 teaspoons baking soda",
    "0.5 teaspoon salt",
    "1.25 cups peanut butter",
    "1 cup butter, cut into small chunks",
    "0.75 cup white sugar",
    "0.75 cup packed brown sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "1.5 cups quick-cooking oats"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat peanut butter, butter, white sugar, and brown sugar together in a bowl using an electric mixer until smooth and creamy. Beat eggs, 1 at a time, into creamed butter, beating well before adding next egg; mix in vanilla extract and almond extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly stir flour mixture into creamed butter mixture until fully incorporated; fold in oats using a wooden spoon. Roll dough into 1-inch balls and arrange 1-inch apart on a baking sheet. Press a fork into each cookie if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are lightly browned, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
