  "ingredients": [
    "1 tablespoon olive oil",
    "0.5 cup onion, chopped",
    "2 chipotle peppers in adobo sauce, chopped",
    "1 tablespoon adobo sauce from chipotle peppers",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon chili powder",
    "0.25 teaspoon salt",
    "3 cups chicken broth",
    "1 (14.5 ounce) can Hunt's® Fire Roasted Diced Tomatoes with Garlic",
    "0.75 cup heavy cream"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a saucepan over medium heat. Add onion; cook until soft and translucent, 6 to 7 minutes. Stir in chipotle peppers, Adobo sauce, cumin, chili powder, and salt to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chicken broth and tomatoes; bring to a simmer over low heat. Cover; simmer 5 to 6 minutes. Remove from heat; cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée bisque with an immersion blender until smooth. Stir in heavy cream. Taste; season with salt if necessary. Slowly heat bisque but do not boil. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
