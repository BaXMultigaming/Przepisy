  "ingredients": [
    "3.5 cups Italian Tipo \"00\" flour, or more to taste",
    "2 eggs",
    "2 egg yolks, or more as needed",
    "1 teaspoon olive oil",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Pile flour onto a work surface and make a small well in the center; place eggs, egg yolks, olive oil, and salt into the well. Gently stir the egg mixture with a fork, gradually drawing in flour until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead dough with hands until smooth and leathery, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap dough in plastic wrap; let rest until malleable, 1 to 2 hours. Remove plastic wrap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut dough into four pieces; roll out with a rolling pin. Run flattened pieces through a pasta roller to create desired noodle shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
