  "ingredients": [
    "0.5 cup pineapple juice",
    "2 tablespoons gochujang (Korean hot pepper paste), or more to taste",
    "2 tablespoons soy sauce",
    "5 cloves garlic, minced",
    "1 tablespoon sesame oil",
    "1 tablespoon brown sugar",
    "1.5 teaspoons freshly grated ginger",
    "2 pounds chicken wings, separated at joints, tips discarded",
    "1.5 teaspoons toasted sesame seeds",
    "1 teaspoon black sesame seeds"
  ],
  "steps": [
    {
      "text": "Combine pineapple juice, gochujang, soy sauce, garlic, sesame oil, brown sugar, and fresh ginger in a gallon size resealable bag. Add the wings and mix to coat; marinate overnight",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the air fryer to 200 degrees F (95 degrees C) for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain wings from marinade and set inside the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook wings for 20 minutes flipping at the 15 minute mark.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase temperature to 400 degrees F (200 degrees C) and cook for 10 more minutes. Carefully remove wings and sprinkle with sesame seeds. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
