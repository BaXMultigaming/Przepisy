  "ingredients": [
    "0.5 cup granulated sugar",
    "1 teaspoon cinnamon",
    "2 (16.3 ounce) cans Pillsbury® Grands!® Homestyle refrigerated buttermilk biscuits",
    "0.5 cup chopped walnuts",
    "0.5 cup raisins",
    "1 cup firmly packed brown sugar",
    "0.75 cup butter or margarine, melted"
  ],
  "steps": [
    {
      "text": "Heat oven to 350 degrees F. Lightly grease 12-cup fluted tube pan with shortening or cooking spray. In large -storage plastic food bag, mix granulated sugar and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate dough into 16 biscuits; cut each into quarters. Shake in bag to coat. Arrange in pan, adding walnuts and raisins among the biscuit pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In small bowl, mix brown sugar and butter; pour over biscuit pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 28 to 32 minutes or until golden brown and no longer doughy in center. Cool in pan 10 minutes. Turn upside down onto serving plate; pull apart to serve. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
