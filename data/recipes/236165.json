  "ingredients": [
    "0.75 cup milk",
    "2 tablespoons white vinegar",
    "1 cup all-purpose flour",
    "2 tablespoons white sugar",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 egg",
    "2 tablespoons butter, melted",
    "1.5 teaspoons ground cinnamon, or as desired",
    "1 teaspoon vanilla extract",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Stir together milk and vinegar in a small bowl; set aside to curdle, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, baking soda, and salt in a large bowl. Whisk in egg and melted butter. Pour in curdled milk and whisk until batter is smooth. Stir in cinnamon and vanilla until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium heat and coat with cooking spray. Drop batter, 1/4 cup per pancake, onto the hot skillet and cook until bubbles form and the edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
