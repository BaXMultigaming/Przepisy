  "ingredients": [
    "1 cup white sugar",
    "0.75 cup firmly packed brown sugar",
    "0.5 cup butter, softened",
    "0.25 cup milk",
    "2 tablespoons orange juice",
    "1 egg",
    "3 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "2.5 cups cranberries, halved",
    "1 cup chopped walnuts",
    "0.25 cup confectioners' sugar for dusting, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream white sugar, brown sugar, and butter together in a large mixing bowl. Beat milk, orange juice, and egg into the creamed mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, cinnamon, salt, and baking soda together in a separate bowl; blend into the wet ingredients in the mixing bowl to form a cookie dough. Stir cranberries and walnuts into the dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop the dough onto the prepared baking sheet by the teaspoonful.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the edges are golden, 10 to 15 minutes. Allow the cookies to cool on the baking sheet for 1 minute before removing to a wire rack to cool completely. Sprinkle confectioners' sugar over the cookies to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
