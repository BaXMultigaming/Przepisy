  "ingredients": [
    "0.5 cup chopped cranberries",
    "1 tablespoon white sugar",
    "1.5 cups all-purpose flour",
    "1 cup yellow cornmeal",
    "0.5 cup white sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1.3333333730698 cups milk",
    "2 eggs, beaten",
    "3 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss cranberries with 1 tablespoon sugar in a bowl; set aside. Whisk flour, cornmeal, ½ cup sugar, baking powder, baking soda, and salt together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, eggs, and melted butter together in a third bowl; stir into flour mixture just until batter moistened. Stir cranberries into batter; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cornbread is golden brown, 18 to 20 minutes. Cool completely in the pan before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
