  "ingredients": [
    "1 cup white sugar",
    "1 cup shredded coconut",
    "1 tablespoon butter, softened",
    "5 large egg yolks",
    "1 large egg white"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, coconut, and butter in a bowl with an electric mixer until well combined. Add egg yolks and egg white; beat until well combined. Pour mixture into a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the pie plate into a large roasting pan; pour enough boiling water into the bottom of the roasting pan to reach about halfway up the side of the pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the roasting pan in the preheated oven and bake until custard is golden brown on top, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool to room temperature, about 30 minutes. Serve immediately or refrigerate until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
