  "title": "Quindim",
  "description": "Quindim is a popular Brazilian baked dessert. This eggy custard gets its bright yellow color from the number of egg yolks used to make it.",
  "authors": [
    "Katt Lopes Vallee"
  ],
  "date_published": "2020-06-18T23:39:06-04:00",
