  "title": "Sweet Potato Pie with Pecans",
  "description": "A cinnamon, ginger, and nutmeg spiced sweet potato filling is sprinkled with chopped pecans in this pie which is served with a hazelnut liquer whipped cream topping.",
  "authors": [
    "Sandra"
  ],
  "date_published": "1999-10-07T02:21:28-04:00",
