  "ingredients": [
    "2 pounds lean ground beef",
    "0.25 cup olive oil",
    "0.5 onion, chopped",
    "0.5 green bell pepper, chopped",
    "2 tablespoons minced garlic",
    "2 (8 ounce) cans tomato sauce",
    "2 cups water",
    "0.5 cup red cooking wine",
    "3 tablespoons hot sauce (such as Louisiana®)",
    "1 (1.41 ounce) package sazon seasoning (such as Badia® Tropical®)",
    "1 tablespoon chopped fresh parsley",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon ground bay leaf",
    "3 ounces Spanish-style olives",
    "1 small butternut squash, peeled and cut into cubes",
    "1 teaspoon salt, or to taste"
  ],
  "steps": [
    {
      "text": "Cook and stir ground beef in a large stockpot over medium-high heat until crumbly and browned, 5 to 10 minutes. Drain grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5G8N7RPHCPYh-MvmnNrJTZuHMjs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255660-abuellos-picadillo-ddmfs-4x3-ddmfs-step1-0123-3a9f2ed9c54e455aa0070cc13ed01a78.jpg"
      ],
      "image": "assets/images/255660/step_01.webp"
    },
    {
      "text": "Heat olive oil in a small skillet over medium heat. Add onion, bell pepper, and garlic to hot oil; cook and stir until fragrant, 2 to 3 minutes. Add to beef in the stockpot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vmJQXCxFujOuGGFso4NlKOwXOC0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255660-abuellos-picadillo-ddmfs-4x3-ddmfs-step2-0125-e4daee7633c54f0da8cbe75832619e96.jpg"
      ],
      "image": "assets/images/255660/step_02.webp"
    },
    {
      "text": "Pour tomato sauce, water, wine, and hot sauce into the stockpot. Stir in sazón seasoning, parsley, garlic powder, onion powder, cumin, pepper, and bay leaf. Bring to a boil; reduce heat to low and simmer picadillo, uncovered, until slightly thickened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xq0RVpRbll6NVTLr8IsZul3y2zE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255660-abuellos-picadillo-ddmfs-4x3-ddmfs-step3-0127-198fdc2abf294d7fbf06cdbc15b16cb5.jpg"
      ],
      "image": "assets/images/255660/step_03.webp"
    },
    {
      "text": "Split olives in half with your fingers and stir into picadillo. Add squash. Simmer until squash is tender and liquid reduces but picadillo is not dry, 45 to 60 minutes. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9f83eDnmVsWJvroJN090ZcPCp84=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255660-abuellos-picadillo-ddmfs-4x3-ddmfs-step4-0129-2f2adfc05aad4aee8d703f3c0c2c2b6d.jpg"
      ],
