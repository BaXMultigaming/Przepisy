  "ingredients": [
    "0.75 pound fresh green beans, trimmed",
    "0.25 (12 ounce) package firm tofu",
    "1 tablespoon tahini",
    "1 teaspoon white miso paste",
    "1.5 teaspoons soy sauce",
    "0.5 teaspoon white sugar",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add green beans, cover, and steam until tender, 5 to 7 minutes. Drain, allow to cool slightly, and slice on the diagonal. Transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash tofu with a fork as much as possible. Mix in tahini and miso paste. Season with soy sauce, sugar, and salt. Blend with an immersion blender until it is the consistency of yogurt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing over green beans and mix to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
