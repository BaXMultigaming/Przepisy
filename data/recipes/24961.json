  "ingredients": [
    "1 (16 ounce) package penne pasta",
    "6 tablespoons butter",
    "0.5 onion, finely chopped",
    "2 tablespoons all-purpose flour",
    "2 teaspoons garlic powder",
    "2 cups skim milk",
    "0.5 cup grated Romano cheese",
    "1 cup frozen green peas, thawed and drained",
    "0.5 cup canned mushrooms, drained",
    "10 ounces smoked salmon, chopped"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A3huA41CR08A6-ZjPT0YXVXnI98=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24961-Creamy-Smoked-Salmon-Pasta-ddmfs-step-1-010-198710c73e5c443c83748e8533cdced0.jpg"
      ],
      "image": "assets/images/24961/step_01.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Sauté onion in butter until tender, 2 to 3 minutes. Stir flour and garlic powder into onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fyhh5YQP0NR0DM6vFsOcblPIUdY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24961-Creamy-Smoked-Salmon-Pasta-ddmfs-step-2-017-4221a88e8c604b5bb5752e0add9287e2.jpg"
      ],
      "image": "assets/images/24961/step_03.webp"
    },
    {
      "text": "Gradually stir in milk. Heat to just below boiling point, then gradually stir in cheese until sauce is smooth. Stir in peas and mushrooms; cook over low heat until warmed through, about 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ql3YMMzizqOO4lkOUICbf7Kl6Wo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24961-Creamy-Smoked-Salmon-Pasta-ddmfs-step-3-019-8278dfb927f94fda8e375b58f650ba92.jpg"
      ],
      "image": "assets/images/24961/step_04.webp"
    },
    {
      "text": "Toss in smoked salmon and cook until heated through, about 2 minutes. Serve over pasta.",
      "section": null,
      "name": null,
