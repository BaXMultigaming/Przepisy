  "ingredients": [
    "0.25 cup rolled oats",
    "0.25 cup water",
    "1 cup buttermilk, at room temperature",
    "1 egg",
    "3 tablespoons honey",
    "1.5 tablespoons margarine, softened",
    "3 cups bread flour",
    "1 teaspoon salt",
    "0.25 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "2 teaspoons active dry yeast",
    "0.75 cup dried cranberries",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Place all of the ingredients (except the cranberries and the walnuts) in the pan of the bread machine in the order recommended by the manufacturer. Select Light Crust and Sweet Cycle and press Start.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "If your machine has a Fruit setting, add the cranberries and walnuts at the signal, or around 5 minutes before the kneading cycle has finished.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
