  "ingredients": [
    "4 cups fresh raspberries, divided",
    "0.25 cup water, or as needed",
    "0.75 cup white sugar",
    "2 tablespoons cornstarch",
    "1.75 cups quick-cooking oats",
    "1 cup all-purpose flour",
    "1 cup packed brown sugar",
    "0.5 teaspoon baking soda",
    "0.5 cup butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crush 1 cup raspberries with a fork in a bowl; transfer to a 1-cup liquid measuring cup. Add enough water to measure 1 cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar and cornstarch in a saucepan; stir in crushed raspberry mixture and bring to a boil. Cook, stirring occasionally, until thick, about 2 minutes. Reduce heat to a simmer; stir in remaining 3 cups raspberries. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine oats, flour, brown sugar, and baking soda in a bowl; cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press ½ crumb mixture into bottom of the prepared baking dish; spread raspberry mixture on top. Sprinkle with remaining ½ crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
