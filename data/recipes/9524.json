  "ingredients": [
    "0.5 cup butter",
    "0.5 cup shortening",
    "1 cup white sugar",
    "2 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "salt to taste",
    "1 teaspoon vanilla extract",
    "1 cup semi-sweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together the butter, shortening, sugar and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the flour, baking soda and salt. Add to sugar mixture and mix well, being careful not to over mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop heaping teaspoonfuls of dough on ungreased cookie sheet and flatten each with the tines of a fork (dip fork into small bowl of water so that dough doesn't stick to fork). Do this once or twice, depending on the size of cookie and fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 13 to 15 minutes. After each pan is removed from oven, carefully place 5 or 6 chocolate chips on top of each cookie while they are still hot. When chocolate is glossy and soft, spread with knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
