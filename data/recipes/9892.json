  "title": "Food for the Gods",
  "description": "Food for the gods date and walnut bars are easy to make and always well received. They're sweet, buttery, and decadent — what a heavenly treat!",
  "authors": [
    "Cookie de Guzman"
  ],
  "date_published": "1997-08-14T22:00:51-04:00",
  "date_modified": "2026-04-17T14:50:59-04:00",
