  "ingredients": [
    "1.25 cups sifted all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup dates, pitted and chopped",
    "1 cup unsalted butter, softened",
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "3 large eggs",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x13-inch baking pan and line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, baking soda, and salt together in a bowl. Transfer 1/2 cup to a smaller bowl; add dates and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, white sugar, and brown sugar in a large bowl with an electric mixer until light and fluffy. Add eggs, one at a time, beating well after each addition. Gradually stir in flour mixture, then stir in floured dates and walnuts until well combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Reduce the heat to 300 degrees F (150 degrees C) and bake until top is dry and edges have started to pull away from the sides of the pan, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool on a wire rack for 20 minutes before cutting into 36 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
