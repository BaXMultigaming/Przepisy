  "ingredients": [
    "6 eggs",
    "3 zucchinis, shredded",
    "1 zucchini, diced",
    "0.25 cup chopped fresh basil",
    "3 tablespoons grated Parmesan cheese",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1.5 cups all-purpose flour",
    "2 cups vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Whisk eggs together in a large bowl until smooth. Stir in shredded and diced zucchini until well combined. Mix in basil, Parmesan cheese, salt, and pepper. Add flour a little at a time, stirring between additions until no dry lumps remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter spoonfuls of batter into oil, a few at a time; do not overcrowd the skillet. Cook until golden brown, about 4 minutes per side. Drain on a paper towel-lined plate before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
