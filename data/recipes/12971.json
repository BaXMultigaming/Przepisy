        "https://www.allrecipes.com/thmb/JahvTKbrZblD-pU0r439XX7k0is=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12971-navy-bean-soup-i-ddmfs-3X4-0420-20f4f50a8c094bad8cc36a5e434d44f8.jpg"
