  "ingredients": [
    "6 cups water",
    "1 (16 ounce) package dried navy beans",
    "1 (14.5 ounce) can diced tomatoes",
    "0.5 pound chopped ham",
    "1 onion, chopped",
    "2 stalks celery, chopped",
    "2 tablespoons Worcestershire sauce",
    "1 clove garlic, minced",
    "1 cube chicken bouillon",
    "1 tablespoon dried parsley",
    "2 teaspoons garlic powder",
    "1 bay leaf",
    "3 cups water",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g0ceyQqfOlhEzsjVjfs1-l8bAXk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12971-navy-bean-soup-i-Step1-0341-97addb58b2ff48c3bacecbd576927fcc.jpg"
      ],
      "image": "assets/images/12971/step_01.webp"
    },
    {
      "text": "Combine 6 cups of water, beans, tomatoes, ham, onion, celery, Worcestershire sauce, minced garlic, bouillon, parsley, garlic powder, and bay leaf in a stock pot; bring to a boil. Reduce heat, cover, and simmer for two hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UHd20KDQr5KEVLiZWBYWKq1Tk88=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12971-navy-bean-soup-i-Step2-0346-c3b27898b91e401c98505078641655fd.jpg"
      ],
      "image": "assets/images/12971/step_02.webp"
    },
    {
      "text": "Add 3 cups of water; stir in salt and pepper. Simmer for an additional two hours. Discard bay leaf before serving.",
      "section": null,
      "name": null,
