  "ingredients": [
    "6 cups chicken broth",
    "3 cups frozen O'Brien hash brown potatoes",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (12 ounce) package frozen mixed vegetables (corn, peas, carrots, green beans, and lima beans)",
    "1 celery rib, sliced",
    "2 teaspoons Worcestershire sauce",
    "1 teaspoon smoked paprika",
    "1 teaspoon dried oregano",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon freeze-dried dill",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place chicken broth, hash brown potatoes, tomatoes, frozen vegetables, celery, Worcestershire sauce, paprika, oregano, onion powder, salt, dill, and pepper into a multi-functional pressure cooker (such as Instant Pot). Stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Close and lock the lid. Select high pressure according to the manufacturer's instructions; set the timer for 0 minutes. Allow 30 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to the manufacturer's instructions, about 5 minutes. Ladle soup into bowls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
