  "ingredients": [
    "1 (3 pound) pie pumpkin, halved and seeded",
    "cooking spray",
    "1.5 cups white sugar",
    "1.5 cups unsweetened applesauce",
    "1 (14 ounce) can coconut milk",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon ground ginger",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground cloves",
    "3 unbaked pie shells"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray cut sides of pumpkin with cooking spray. Place cut-side down on a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tender when pierced with a fork, about 1 hour. Let cool, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase oven temperature to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop cooked pumpkin into a bowl. Add sugar, applesauce, coconut milk, cinnamon, ginger, allspice, nutmeg, salt, and ground cloves; beat with an electric mixer until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide pumpkin mixture among pie shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 10 minutes. Reduce oven temperature to 350 degrees (175 degrees C) and continue baking until a toothpick inserted into the center comes out clean, 45 to 50 minutes more. Let cool completely on a wire rack, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
