  "ingredients": [
    "1 tablespoon cornstarch",
    "0.5 cup sugar",
    "1 cup water",
    "2 tablespoons butter",
    "1.5 teaspoons lemon juice",
    "0.125 teaspoon ground nutmeg",
    "1 pinch salt",
    "7 ripe bananas"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan over medium-high heat, mix together cornstarch and sugar. Gradually stir in water. Bring to a boil, stirring constantly. Remove from heat, stir in butter, lemon juice, nutmeg, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel bananas, and place in a casserole dish. Drizzle sauce over bananas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated oven for 12 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
