  "title": "Chicken Creole",
  "description": "A simple vegetable sauté with a little cayenne makes a tasty sauce for baked chicken Creole.",
  "authors": [
    "Kathy Sauers"
  ],
  "date_published": "1999-04-23T13:42:51-04:00",
