  "ingredients": [
    "1 tablespoon olive oil",
    "1 clove garlic, minced",
    "1 medium onion, thinly sliced",
    "1 stalk celery, sliced thin",
    "1 medium green bell pepper, minced",
    "2 (14.5 ounce) cans diced tomatoes",
    "1 large bay leaf",
    "0.5 teaspoon salt",
    "0.125 teaspoon cayenne pepper",
    "4 skinless, boneless chicken breasts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, heat oil over medium heat. Add garlic, onion, celery, and bell pepper. Cook, stirring occasionally, until tender (about 4 minutes). Add tomatoes, bay leaf, salt, and cayenne pepper. Cook the sauce 3 minutes longer, stirring often.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange chicken breasts in an 8x11-inch baking dish. Pour the Creole sauce over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 15 to 20 minutes, until chicken is tender and white throughout.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
