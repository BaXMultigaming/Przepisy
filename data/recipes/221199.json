  "ingredients": [
    "1 prepared 9-inch single pie crust",
    "0.25 cup butter",
    "1 bunch green onions, chopped",
    "3 cloves garlic, chopped",
    "1 slice turkey bacon, cut into 1/2-inch pieces",
    "1 (9 ounce) bag fresh spinach",
    "1 (3.5 ounce) package shiitake mushrooms, sliced",
    "0.5 cup chopped broccoli florets",
    "0.25 cup shredded sharp Cheddar cheese",
    "4 eggs, beaten",
    "0.75 cup milk",
    "0.5 teaspoon sea salt",
    "0.5 teaspoon black pepper",
    "0.5 cup shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fit pie crust into a 9-inch pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat; cook and stir green onions and garlic until green onions are softened, about 5 minutes. Cook and stir turkey bacon in green onion mixture until fragrant.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir spinach, shiitake mushrooms, and broccoli into green onion mixture; cook and stir vegetables until softened, 5 to 7 minutes. Mix in 1/4 cup Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon vegetable mixture into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, milk, sea salt, and black pepper together in a bowl; pour egg mixture gently over vegetable filling, slightly stirring eggs into filling to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes; sprinkle 1/2 cup Cheddar cheese over the top of quiche and bake 10 additional minutes. Cover quiche with aluminum foil and bake until quiche has set and a toothpick inserted into it comes out clean, about 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow quiche to cool for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
