  "ingredients": [
    "6 quarts water, and more as needed",
    "0.25 cup seafood seasoning (such as Old Bay®)",
    "1 pound small red potatoes",
    "1 teaspoon seafood seasoning (such as Old Bay®), or to taste",
    "2 pounds king crab legs",
    "2 cups chopped carrots",
    "1.5 cups chopped celery",
    "12 pearl onions",
    "1 pound spicy sausage links, cut into rounds",
    "4 ears corn, husked",
    "2 pounds unpeeled shrimp"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Bring 6 quarts water to a boil in a large stewing pot; add 1/4 cup seafood seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oCf68pNB0thYcIz8IjPOZ88dWJM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-241996-king-crab-and-shrimp-boil-DDMFS-step-01-9946f9d8740d41118e9c91b19a06f213.jpg"
      ],
      "image": "assets/images/241996/step_01.webp"
    },
    {
      "text": "Cook potatoes in seasoned boiling water for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NtcFk9bWIAVugE1QyOo_DI5T4JE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-241996-king-crab-and-shrimp-boil-DDMFS-step-02-80104b596e534a1cb5b41447a70c9db2.jpg"
      ],
      "image": "assets/images/241996/step_02.webp"
    },
    {
      "text": "Meanwhile, bring a second large pot of water to a boil; add 1 teaspoon seafood seasoning. Cook crab legs in seasoned boiling water until meat is tender, about 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cTt9sSPCAB4NOhZkvQ_IpeVNmqs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-241996-king-crab-and-shrimp-boil-DDMFS-step-03-9f0ae7bdbd074621b1fc3148af56d266.jpg"
      ],
      "image": "assets/images/241996/step_03.webp"
    },
    {
      "text": "Add carrots, celery, and onions to potatoes; cook until vegetables are tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jZChAqWpp9Cgqwl90hM7fI87ArQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-241996-king-crab-and-shrimp-boil-DDMFS-step-04-faf22a1b50b6442eb041f003f4666812.jpg"
      ],
      "image": "assets/images/241996/step_04.webp"
    },
    {
      "text": "Add sausage and corn; continue boiling for 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
