    "0.25 cup baby carrots"
  ],
  "steps": [
    {
      "text": "Combine ground beef, onion, bread crumbs, broth, egg, Parmesan cheese, 2 tablespoons ketchup, Worcestershire sauce, Italian seasoning, parsley, and garlic powder in a bowl using your hands.",
      "section": null,
      "name": null,
      "url": null,
