  "ingredients": [
    "1 ground beef, or more to taste",
    "1 small onion, chopped",
    "0.5 cup bread crumbs",
    "0.25 cup beef broth",
    "1 egg",
    "0.25 cup grated Parmesan cheese",
    "2 tablespoons ketchup",
    "1 tablespoon Worcestershire sauce",
