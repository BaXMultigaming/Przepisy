  "ingredients": [
    "1 pound smoked kielbasa sausage, cut into thick slices",
    "0.5 cup brown sugar",
    "4 teaspoons white vinegar",
    "1 tablespoon soy sauce",
    "0.5 cup water",
    "1 tablespoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Combine sausage, brown sugar, vinegar, and soy sauce in a large resealable plastic bag; toss to coat sausage with marinade. Squeeze out excess air and seal the bag. Marinate in the refrigerate 2 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sausage mixture into a large skillet over medium-high heat. Add water and vegetable oil; cook and stir until liquid is reduced and sausage is browned, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
