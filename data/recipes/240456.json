  "ingredients": [
    "3 frozen cherries",
    "1 dash Angostura bitters",
    "1 cup ice, or as needed",
    "2 fluid ounces rye whiskey (such as Michter's®)",
    "1 fluid ounce sweet Italian vermouth",
    "0.5 fluid ounce simple syrup",
    "0.5 teaspoon lemon juice, or to taste"
  ],
  "steps": [
    {
      "text": "Place cherries in an old-fashioned glass; splash with bitters. Mash cherries with a cocktail muddler until desired consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a cocktail shaker with ice; add rye, vermouth, simple syrup, and lemon juice. Cover and shake until the outside of the shaker has frosted. Strain cocktail into glass over cherries.",
      "section": null,
