  "ingredients": [
    "1 (2 pound) pork tenderloin",
    "1 (1 ounce) envelope dry onion soup mix",
    "1 cup water",
    "0.75 cup red wine",
    "3 tablespoons soy sauce",
    "3 tablespoons minced garlic",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
