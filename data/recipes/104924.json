  "ingredients": [
    "0.25 pound extra lean ground beef",
    "2 (1 ounce) slices bread",
    "ketchup",
    "mayonnaise",
    "1 egg",
    "2 slices mozzarella cheese",
    "2 slices ham",
    "1 slice fresh tomato"
  ],
  "steps": [
    {
      "text": "Place a frying pan over medium heat. Form the ground beef into a patty and cook to desired doneness. Fry egg in a small, lightly oiled pan over medium heat. Flip the egg over and cover with cheese. Cook until the yolk has hardened and the cheese has melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread ketchup and mayonnaise onto the bread slices . Place the egg on one of the slices of bread. Heat the ham in the pan, and place on top of the egg. Top with hamburger and tomato slices. Place the other slice of bread on top, and slice in half.",
      "section": null,
