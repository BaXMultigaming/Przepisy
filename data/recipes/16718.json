  "title": "Baked Pancakes with Sausages",
  "description": "This is a quick and yummy recipe where the pancakes and sausage are all ready at the same time! Serve hot with butter and syrup.",
  "authors": [
    "Janet"
  ],
  "date_published": "2000-03-19T14:33:16-05:00",
