  "title": "Mom&#39;s Sponge Cake",
  "description": "This quick and easy sponge sheet cake made with hot milk has a light and delicate texture. It makes a great base for berry shortcakes.",
  "authors": [
    "LOONEYPROFESSOR"
  ],
  "date_published": "2020-06-19T00:06:18-04:00",
