  "title": "Ginger Snap Brownies",
  "description": "Take brownie mix and add cinnamon, ginger, allspice, and nutmeg to make spicy brownies that taste just like the cookies.",
  "authors": [
    "Steven Cutillo"
  ],
  "date_published": "2020-03-05T00:13:33-05:00",
