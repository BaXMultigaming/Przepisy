  "ingredients": [
    "1 cup butter",
    "2 cups white sugar, divided",
    "3 cups cake flour",
    "4 egg yolks, room temperature",
    "4 egg whites, room temperature",
    "2 teaspoons baking powder",
    "1 cup milk, room temperature",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour three 9-inch round pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and 1 cup sugar with an electric mixer in a large bowl until light and fluffy. The mixture should be noticeably lighter in color.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, beat egg yolks well, then add to butter mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour and baking powder. Add alternately with the milk to the butter-sugar mixture. Beat well. Add vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites until stiff but not dry. Add 1 cup sugar to the egg whites. Fold into cake batter. Divide evenly into prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
