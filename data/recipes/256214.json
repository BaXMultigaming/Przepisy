  "ingredients": [
    "2 tablespoons olive oil",
    "1 pound boneless, skinless chicken breasts, cut into 1-inch pieces",
    "1 small onion, chopped",
    "2 cloves garlic, chopped",
    "1 (7 ounce) package Green Giant® Riced Cauliflower - any variety",
    "0.5 cup chicken broth",
    "2 tablespoons grated Parmesan cheese",
    "1 tablespoon lemon juice",
    "1 tablespoon chopped fresh oregano"
  ],
  "steps": [
    {
      "text": "Season chicken with salt and pepper, if desired. Heat olive oil in large nonstick skillet over medium heat and brown chicken. Remove and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion and cook 3 minutes or until softened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add Green Giant® Riced Cauliflower and garlic and cook 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in broth and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return chicken to skillet and simmer 4 minutes or until vegetables are tender and chicken is cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in Parmesan cheese, lemon juice and oregano.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
