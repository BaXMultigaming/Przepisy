  "ingredients": [
    "3 cups all-purpose flour",
    "1 tablespoon ground cinnamon",
    "2 teaspoons allspice",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground cloves",
    "1 teaspoon ground ginger",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.25 teaspoon baking powder",
    "2 cups peeled, cored, and chopped pears",
    "1.75 cups dark brown sugar",
    "1 cup golden raisins",
    "0.75 cup vegetable oil",
    "0.5 cup white sugar",
    "0.25 cup apple cider",
    "3 large eggs",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease two 8x5x3-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cinnamon, allspice, nutmeg, cloves, ginger, baking soda, salt, and baking powder in a large mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pears, brown sugar, raisins, vegetable oil, white sugar, apple cider, eggs, and vanilla in a separate bowl; blend well. Add to dry ingredients and stir just until moistened. Pour batter evenly into the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of each loaf comes out clean, 65 to 70 minutes. Cool in the loaf pans before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
