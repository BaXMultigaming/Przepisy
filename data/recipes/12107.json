  "ingredients": [
    "0.5 cup butter, melted",
    "4 cups fresh peaches - peeled, pitted, and sliced",
    "2 tablespoons white sugar",
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "0.5 cup milk",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour melted butter into the bottom of a 9x13-inch baking dish. Add peaches and 2 tablespoons sugar; toss until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, 1 cup sugar, milk, cinnamon, baking powder, and salt in a large bowl until well combined; spoon batter over peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is golden brown, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
