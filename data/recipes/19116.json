  "ingredients": [
    "1 (18.25 ounce) package chocolate fudge cake mix",
    "0.75 cup unsweetened cocoa powder",
    "1 cup mayonnaise",
    "1.3333300352097 cups water",
    "3 eggs",
    "1 cup chopped almonds",
    "1 (16 ounce) jar maraschino cherries, drained and chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour two 9 inch pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together cake mix and cocoa. Make a well in the center and pour in water, mayonnaise and eggs. Beat on low speed until blended. Scrape bowl, and beat 2 minutes on medium speed. Stir in chopped nuts and cherries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into prepared pan. Bake in the preheated oven for 35 to 40 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
