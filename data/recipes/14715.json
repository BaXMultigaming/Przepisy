  "ingredients": [
    "0.5 cup soy sauce",
    "2 tablespoons red wine vinegar",
    "2 teaspoons honey",
    "2 teaspoons garlic powder",
    "4 pork chops"
  ],
  "steps": [
    {
      "text": "In a shallow dish, combine the soy sauce, vinegar, honey and garlic powder. Place chops in dish, and turn to coat. Cover, and marinate for 2 to 4 hours in the refrigerator.",
