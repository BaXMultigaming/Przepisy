  "ingredients": [
    "1 yellow squash, sliced",
    "1 zucchini, sliced",
    "1 lemon, zested and juiced",
    "1 tablespoon unsalted butter, cut into chunks",
    "1 tablespoon ground black pepper, or to taste",
    "1 teaspoon kosher salt",
    "1 teaspoon cayenne pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the grill to medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place squash and zucchini on a square of aluminum foil; sprinkle with lemon zest, lemon juice, butter, black pepper, salt, and cayenne pepper. Fold aluminum foil over vegetables; seal to enclose completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until tender, about 30 minutes.",
      "section": null,
