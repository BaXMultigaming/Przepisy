  "ingredients": [
    "2 tablespoons salted butter, melted",
    "0.25 cup white sugar",
    "1 egg white",
    "0.25 teaspoon ground cinnamon",
    "1 cup pecan halves"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 300 degrees F (150 degrees C). Line the air fryer basket with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour melted butter into the lined basket. Whisk sugar, egg white, and cinnamon together in a bowl. Add pecans; toss until fully coated. Spread out in the lined basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry for 5 minutes; shake basket and air fry 5 minutes more. Shake basket again; air fry 2 to 4 minutes more.",
      "section": null,
      "name": null,
      "url": null,
