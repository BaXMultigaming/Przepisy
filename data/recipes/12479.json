  "ingredients": [
    "cooking spray",
    "12 slices bacon",
    "1 cup shredded Swiss cheese",
    "0.33333334326744 cup chopped onion",
    "2 cups milk",
    "4 large eggs",
    "1 cup baking mix",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Grease a 10-inch glass pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally until evenly browned, about 10 minutes. Pat dry on paper towels and crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle crumbled bacon, cheese, and onion into the prepared pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk, eggs, baking mix, and pepper with a fork in a medium bowl until blended. Pour into the pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
