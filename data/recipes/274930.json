  "ingredients": [
    "1.5 pounds fresh green beans, trimmed",
    "6 shallots, peeled and thinly sliced",
    "5 large cloves garlic, thinly sliced",
    "0.25 cup sliced almonds",
    "2 tablespoons olive oil, or more as needed",
    "1 teaspoon kosher salt",
    "0.5 teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place green beans in a large bowl. Mix in shallots, garlic, and almonds. Drizzle olive oil over the top; sprinkle salt and pepper evenly on top. Toss until everything is evenly coated with oil. Spread in a single layer on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until beans are slightly shriveled and shallots are lightly browned, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
