  "ingredients": [
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 cup butter, softened",
    "0.75 cup brown sugar, packed",
    "0.75 cup white sugar",
    "0.5 cup tahini",
    "0.25 cup honey",
    "1 tablespoon ground cinnamon",
    "2 large eggs",
    "1 cup coconut",
    "1 cup rolled oats",
    "0.75 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, and salt together in a bowl. Beat butter, brown sugar, white sugar, tahini, honey, and ground cinnamon together in a separate large bowl with an electric mixer until smooth and creamy. Add eggs; mix well. Beat flour mixture in gradually until dough is just combined. Stir in coconut, oats, and almonds. Drop spoonfuls of dough 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until edges are golden, 9 to 11minutes. Cool on baking sheet for 1 minute before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
