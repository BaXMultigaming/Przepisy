  "ingredients": [
    "1 pound Italian sausage",
    "1 clove garlic, minced",
    "2 (14 ounce) cans beef broth",
    "1 (14.5 ounce) can Italian-style stewed tomatoes",
    "1 cup sliced carrots",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 (14.5 ounce) can great Northern beans, undrained",
    "2 small zucchini, cubed",
    "2 cups spinach - packed, rinsed and torn"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ePlaiNZIgspefCz_E48aGw1k1_s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-12942-italian-sausage-soup-DDMFS-step-1-317ffeb78cbd4cccb98b6d46655229a1.jpg"
      ],
      "image": "assets/images/12942/step_01.webp"
    },
    {
      "text": "Heat a stockpot or Dutch oven over medium-high heat. Add sausage and garlic; cook and stir until browned, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I43rVWwCvm-MzNJu68O5X8HV74U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-12942-italian-sausage-soup-DDMFS-step-2-bc51650dfd10443b8563410c1f4aed12.jpg"
      ],
      "image": "assets/images/12942/step_02.webp"
    },
    {
      "text": "Stir in broth, tomatoes, and carrots; season with salt and pepper. Reduce heat to medium-low, cover, and simmer 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jv8B6OHAUVkc8uxaR3IGi4VF7ho=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-12942-italian-sausage-soup-DDMFS-step-3-5fb403b518324fad8954600cd496e6c6.jpg"
      ],
      "image": "assets/images/12942/step_03.webp"
    },
    {
      "text": "Stir in beans with liquid and zucchini; cover and simmer another 15 minutes, or until zucchini is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s9SPs_2fhwI8lfZ9TO0qmsP2RTE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-12942-italian-sausage-soup-DDMFS-step-4-ea28de944da741799cae00d1f219ab6c.jpg"
      ],
      "image": "assets/images/12942/step_04.webp"
    },
    {
      "text": "Remove soup from heat and add spinach; replace the lid and allow spinach to wilt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wgve1xSr6diTsziPaLK0Lwxg2Sg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-12942-italian-sausage-soup-DDMFS-step-5-4ab1adfcd3eb4dea923a33c19a676536.jpg"
      ],
      "image": "assets/images/12942/step_05.webp"
    },
    {
      "text": "Stir until warmed through. Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
