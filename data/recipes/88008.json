  "ingredients": [
    "1 cup white cornmeal",
    "2 cups boiling water",
    "2 cups all-purpose flour",
    "2 cups milk",
    "2 teaspoons yeast",
    "1 tablespoon brown sugar",
    "2 eggs",
    "1 teaspoon salt",
    "0.25 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "In a large bowl, stir together the cornmeal and boiling water. Let soak for about 15 minutes. While still warm but not hot, stir in the flour, sugar, milk and yeast. Cover, and let rise overnight in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the morning, mix in the eggs, baking powder and salt. If the batter seems too thin, add more cornmeal to thicken it up. If desired, set aside a cupful of batter for the next morning's batch of griddle cakes (see Cook's Note).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle over medium heat. Spoon pancakes onto the hot griddle, and cook until browned on each side. Serve at once with butter and syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
