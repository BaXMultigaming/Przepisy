  "ingredients": [
    "1.25 cups margarine, softened",
    "4 cups white sugar",
    "8 eggs",
    "2 teaspoons vanilla extract",
    "4 cups all-purpose flour",
    "1.25 cups cocoa powder",
    "2 cups chopped walnuts",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease a 15x10 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the margarine and the sugar in a large mixing bowl; use an electric mixer to beat until light. Beat in the eggs and vanilla; mix well. Whisk together the flour, cocoa powder, walnuts, and salt in a large bowl. Stir the flour mixture into the egg mixture, mixing just until dry ingredients are incorporated. Spoon batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake brownies in the preheated oven until the edges begin to pull away from the sides of the pan, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
