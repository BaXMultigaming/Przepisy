  "ingredients": [
    "2 cups ketchup",
    "1 cup dark brown sugar",
    "0.33 cup unsweetened applesauce",
    "0.33 cup real maple syrup",
    "0.25 cup molasses",
    "0.25 cup bacon fat",
    "1 tablespoon garlic powder",
    "1 tablespoon onion powder",
    "1 tablespoon ground mustard",
    "1 teaspoon ground allspice",
    "1 teaspoon chili powder",
    "1 teaspoon Worcestershire sauce",
    "0.25 teaspoon ground nutmeg",
    "0.5 cup apple cider"
  ],
  "steps": [
    {
      "text": "Stir ketchup, brown sugar, applesauce, maple syrup, molasses, bacon fat, garlic powder, onion powder, mustard powder, allspice, chili powder, Worcestershire sauce, and nutmeg together in a large saucepan over medium heat until thoroughly combined. Bring to a boil, then reduce heat and let simmer for at least 1 hour, adding apple cider if a thinner consistency is desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat and let cool slightly, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a funnel to pour BBQ sauce into a clean, sterilized 32-ounce bottle or container. Seal and store in the refrigerator for up to one week.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
