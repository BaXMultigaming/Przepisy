  "title": "Chocolate Chip Cookie Ice Cream Cake",
  "description": "A delectable ice cream cookie cake dessert. Use your favorite ice cream flavors and a cookie crust, topped with whipped cream, fudge and cherries.",
  "authors": [
    "Arvilla"
  ],
  "date_published": "2000-06-17T07:43:59-04:00",
