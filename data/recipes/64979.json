  "ingredients": [
    "1 pound ground beef",
    "1 small onion, chopped",
    "1 (16 ounce) bag coleslaw mix",
    "0.75 cup uncooked white rice",
    "2 (10.75 ounce) cans condensed tomato soup",
    "1 (10.75 ounce) can water"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat, and stir in the ground beef and onion. Cook and stir until the beef is crumbly, evenly browned, and no longer pink. Drain and discard any excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer the coleslaw mix, rice, and ground beef in a 9x13 inch baking dish. Combine the soup and water in a medium bowl. Pour the soup over the top of the ground beef. Cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour and 15 minutes, or until the rice is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
