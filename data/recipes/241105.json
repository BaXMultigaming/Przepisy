  "ingredients": [
    "1 pound hot pork sausage",
    "1 cup milk",
    "3 large eggs, beaten",
    "1.5 teaspoons salt, divided",
    "0.5 (30 ounce) package frozen hash brown potatoes, thawed",
    "1 cup shredded Cheddar cheese",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking dish or a 9-inch, deep-dish pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6MfoA7bcojzTZkYSc2NGQSFspL0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241105-SausageHashBrownBreakfastCasserole_241105_ddmfs_Step1_Ingredients_1801-2f70baaa93d94641ab58b0c152a97cbc.jpg"
      ],
      "image": "assets/images/241105/step_01.webp"
    },
    {
      "text": "Cook sausage in a large skillet over medium-high heat until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D6N2Uh28x0UYkTcKFpPKf26_Tbs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241105-SausageHashBrownBreakfastCasserole_241105_ddmfs_Step2_1808-c7567d95daa443bf8814eed871670301.jpg"
      ],
      "image": "assets/images/241105/step_02.webp"
    },
    {
      "text": "Whisk milk, eggs, and 1 teaspoon salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YN_tM10loLC2inl7psc7zJi352M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241105-SausageHashBrownBreakfastCasserole_241105_ddmfs_Step4_1816-61310dac944e48e4a04dcfb500370fbc.jpg"
      ],
      "image": "assets/images/241105/step_03.webp"
    },
    {
      "text": "Transfer cooked sausage to a large bowl. Add hash browns, Cheddar, pepper, and remaining 1/2 teaspoon salt; stir well to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WXTwu0AckG90Bibxl1sfGlyJWvE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241105-SausageHashBrownBreakfastCasserole_241105_ddmfs_Step3_1815-1439e20207ab4996a225b805c9d03e41.jpg"
      ],
      "image": "assets/images/241105/step_04.webp"
    },
    {
      "text": "Spread in an even layer in the prepared baking dish, then pour egg mixture evenly over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dgxDxJOX0Xu_ltlNseZ9iG2t2eE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241105-SausageHashBrownBreakfastCasserole_241105_ddmfs_Step6_1820-9dacef8d89bb46659cb67f3aa9b34604.jpg"
      ],
      "image": "assets/images/241105/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until bubbling and golden, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/62cDsD6df5yzDJunVk6tiuHBdD8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241105-SausageHashBrownBreakfastCasserole_241105_ddmfs_1867-551617bf9c7c49b58e641c69136c406e.jpg"
      ],
      "image": "assets/images/241105/step_06.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e_BK_ByXiTjo79HIF79GAgjPS3A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241105-SausageHashBrownBreakfastCasserole_241105_ddmfs_4x3_1883-a1dd44d8c79f4b7f80c35cc5ba4ef9e0.jpg"
