  "ingredients": [
    "1 extra large zucchini, cubed",
    "2 teaspoons salt",
    "4 roma (plum) tomatoes, chopped",
    "1 (14.5 ounce) can stewed tomatoes",
    "1 (12 ounce) can tomato paste",
    "1 cup water, or as needed",
    "1 (32 ounce) can chicken broth",
    "0.25 cup white sugar",
    "2.5 tablespoons olive oil",
    "1 large green bell pepper, chopped",
    "1 sweet onion, chopped",
    "2 cloves garlic, minced",
    "3 tablespoons chopped fresh dill",
    "1 tablespoon chopped fresh tarragon",
    "1 tablespoon chopped fresh parsley",
    "1 tablespoon lemon juice",
    "3 tablespoons grated Parmesan cheese",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Place zucchini in a colander; sprinkle with 2 teaspoons salt. Set aside to drain, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine Roma tomatoes, stewed tomatoes, tomato paste, and water in a blender; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour tomato mixture and chicken broth into a large stockpot; bring to a boil over medium heat. Reduce heat to low; stir in sugar and simmer, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat. Add zucchini, bell pepper, onion, and garlic; cook and stir until onion is translucent and zucchini is lightly brown, about 10 minutes. Transfer to blender; pulse a few times to chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer zucchini mixture to the stockpot; stir in dill, tarragon, parsley, and lemon juice. Simmer, uncovered, for 35 minutes, stirring occasionally; stir in Parmesan cheese. Season with salt and black pepper; simmer 5 minutes. Let stand before serving, 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
