  "ingredients": [
    "0.5 cup unsalted butter",
    "1.5 cups buttermilk",
    "1 cup cornmeal",
    "2 large eggs",
    "3 tablespoons honey, or to taste",
    "0.5 teaspoon fine salt",
    "1 pinch cayenne pepper",
    "1 cup self-rising flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a 9-inch cast iron skillet. Turn off the heat; set the skillet aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk buttermilk, cornmeal, eggs, honey, salt, and cayenne pepper together in a large bowl. Add flour and 1/2 of the butter from the pan; whisk again. Pour batter over remaining butter in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 25 minutes. Let cool briefly before slicing.",
      "section": null,
      "name": null,
