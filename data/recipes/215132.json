  "ingredients": [
    "7 cups pitted and quartered plums",
    "1.5 cups white sugar",
    "0.66666668653488 cup butter, softened",
    "2 eggs",
    "3 cups sifted all-purpose flour",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "2 cups milk",
    "2 teaspoons vanilla extract",
    "1/2 cup butter",
    "0.25 cup all-purpose flour",
    "1 teaspoon cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place plums into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 ½ cups white sugar and ⅔ cup butter together in a large bowl with an electric mixer until smooth and creamy; beat in eggs, one at a time, beating well after each addition. Stir in 3 cups sifted flour, baking powder, and salt; stir in milk and vanilla extract until smooth. Pour batter over plums.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1 cup sugar, ½ cup butter, ¼ cup flour, and cinnamon in a bowl until it resembles coarse crumbs; sprinkle over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
