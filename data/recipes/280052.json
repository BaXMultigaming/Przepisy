  "ingredients": [
    "4 whole skin-on, bone-in chicken breasts",
    "1 cup barbecue sauce (such as Sweet Baby Ray's®)",
    "kosher salt and coarsely ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VkHjxOxh8DBqcS7js4holD83A1I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/280052-bbq-chicken-breasts-in-the-oven-ddmfs-step1-259-6734e1ac8be7447aa147808f362a6f02.jpg"
      ],
      "image": "assets/images/280052/step_01.webp"
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking pan with heavy-duty foil to make cleanup easier.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare chicken breasts by cutting off the rib meat if you wish; leave the skin on. Season chicken with salt and pepper and put in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SrNQ-_wVkeVdoA6_blX8D1U9orI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/280052-bbq-chicken-breasts-in-the-oven-ddmfs-step2-260-1875fb7e5504436da73f27d7c043e402.jpg"
      ],
      "image": "assets/images/280052/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until juices start to appear, about 10 minutes. Reduce oven temperature to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the pan and generously pour 1/2 of the barbecue sauce over chicken. Continue to bake for 20 minutes. Repeat with remaining barbecue sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3jPkjFTkEi7EZL7QBfvYirtvPf8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/280052-bbq-chicken-breasts-in-the-oven-ddmfs-step4-268-7767b346d7d54dbea08e951a0d152a49.jpg"
      ],
      "image": "assets/images/280052/step_05.webp"
    },
    {
      "text": "Cook until no longer pink in the centers and skin is crispy, 15 to 20 minutes more. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zCceHiXnI62fiCNaP8DOQ6F8A0I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/280052-bbq-chicken-breasts-in-the-oven-ddmfs-step5-331-b0c95b602aba47b482f651170aaceb68.jpg"
      ],
      "image": "assets/images/280052/step_06.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l3ROgWWglWDekcefKyu83aWZh74=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/280052-bbq-chicken-in-the-oven-france-c-9182295-4x3-562283e741de4d53814fe72b0456bcc0.jpg"
      ],
      "image": "assets/images/280052/step_07.webp"
    }
