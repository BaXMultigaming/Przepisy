  "ingredients": [
    "2 large egg yolks",
    "4 cloves garlic, minced",
    "1 cup extra virgin olive oil",
    "salt and ground black pepper to taste",
    "2 teaspoons lemon juice"
  ],
  "steps": [
    {
      "text": "Whisk eggs in a medium bowl until well beaten. Stir in garlic. Gradually add oil in a thin stream, whisking constantly until light and creamy. Season with salt and pepper. Stir in lemon juice.",
