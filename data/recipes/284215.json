  "ingredients": [
    "1.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup Becel® Original margarine",
    "0.5 cup light brown sugar",
    "0.25 cup granulated sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.5 cup semi-sweet chocolate chips",
    "0.25 teaspoon flaked sea salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Combine flour, baking soda, and salt; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large bowl, beat together Becel® Original, brown sugar and granulated sugar. Beat in egg and vanilla until blended. Gradually add flour mixture and beat just until blended. Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop heaping tablespoonfuls of batter onto ungreased baking sheets, about 2 inches (5 cm) apart. Bake for 8 to 10 minutes or until edges are golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven; sprinkle with flaked sea salt. Let cool for 2 minutes in pan on rack; transfer cookies directly to rack and let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
