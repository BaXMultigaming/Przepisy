  "ingredients": [
    "3 cups water",
    "1.5 cups uncooked white rice",
    "4 tablespoons vegetable oil",
    "1 cup fresh bean sprouts",
    "0.5 cup chopped onion",
    "1.5 cups cooked medium shrimp, peeled and deveined without tail",
    "2 large eggs, beaten",
    "0.25 cup chopped green onion",
    "4 tablespoons soy sauce",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon sesame oil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o5iPFTdcrMEtBw52Yt4y9jzJ37Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_21561_ShrimpFriedRice_Shot1_3012-3ae1030d83d6461e88f1eaf0d1bde86a.jpg"
      ],
      "image": "assets/images/21561/step_01.webp"
    },
    {
      "text": "Bring water to a boil in a saucepan. Add rice and stir. Reduce heat, cover, and simmer for 20 minutes. Set aside and allow rice to completely cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet or wok for 2 minutes. When the skillet or wok is hot, pour in vegetable oil, bean sprouts, and onions. Mix well and cook for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/29RmQ7457ILixdfW0FHckdCGCPo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_21561_ShrimpFriedRice_Shot2_13074-bf00b48d52d44ae7b527bd2a55ac07af.jpg"
      ],
      "image": "assets/images/21561/step_03.webp"
    },
    {
      "text": "Mix in cooled rice and shrimp and cook for another 3 minutes. Stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pz7at3o71ScmvlZrtnAjiCFDJdc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_21561_ShrimpFriedRice_Shot3_13078-7c6daa2d8ada47179961edd89bc4a862.jpg"
      ],
      "image": "assets/images/21561/step_04.webp"
    },
    {
      "text": "Add in eggs, green onion, soy sauce, salt, pepper, and sesame oil. Cook for another 4 minutes, stirring continuously, until eggs are cooked and everything is blended evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2sI15_bQPb_LYm-SmQbzidHG_WA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_21561_ShrimpFriedRice_4x3_13119-b29fd221132645f39db69b12a2525998.jpg"
