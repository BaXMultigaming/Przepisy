  "ingredients": [
    "48 fresh, unopened oysters",
    "1.5 cups beer",
    "2 cloves garlic",
    "7 black peppercorns",
    "seasoned salt to taste",
    "0.5 cup butter",
    "1 onion, chopped",
    "1 clove garlic, crushed",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "8 ounces Monterey Jack cheese, shredded",
    "8 ounces fontina cheese, shredded",
    "8 ounces mozzarella cheese, shredded",
    "0.5 cup milk",
    "2 teaspoons salt, or to taste",
    "1 teaspoon ground black pepper",
    "2 tablespoons fine bread crumbs"
  ],
  "steps": [
    {
      "text": "Clean oysters, and place them in a large stockpot. Pour in beer and enough water to cover oysters; add 2 cloves of garlic, peppercorns, and seasoned salt. Bring to a boil. Remove from heat, drain, and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vOZRQEK2EFZsvoBvwnVk_zNS5fE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12801-rockin-oysters-rockefeller-ddmfs-step1-4x3-1c055cc154b242a086259ccd2f31061d.jpg"
      ],
      "image": "assets/images/12801/step_01.webp"
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once oysters are cooled, break off and discard the top shell. Arrange oysters on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pKHA3qCAN3XVHfC9Ig6yBtbMWRo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12801-rockin-oysters-rockefeller-ddmfs-step2-4x3-5ada18b447d34f0a818797fd890b0921.jpg"
      ],
      "image": "assets/images/12801/step_03.webp"
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Cook onion and garlic in butter until soft. Reduce heat to low; stir in spinach, Monterey Jack, fontina, and mozzarella. Cook until cheese melts, stirring frequently. Stir in milk; season with salt and pepper. Spoon sauce over each oyster, just filling the shell. Sprinkle with bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uy9yUUuanrlHAh66XNwIW401RrI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12801-rockin-oysters-rockefeller-ddmfs-step4-4x3-7050ebf128854d789ee4600073b34e93.jpg"
      ],
      "image": "assets/images/12801/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until golden and bubbly, approximately 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IuUgK_hC5X60grn_RTOjf07Y8ck=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12801-rockin-oysters-rockefeller-DDMFS-4x3-af1ac2f512c34e3ea8e2ab75fa4afc05.jpg"
      ],
      "image": "assets/images/12801/step_05.webp"
    }
