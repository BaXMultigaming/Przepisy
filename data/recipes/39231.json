  "ingredients": [
    "1.5 cups granulated sugar",
    "0.66666668653488 cup NESTLE® CARNATION® Evaporated Milk",
    "2 tablespoons butter or margarine",
    "0.25 teaspoon salt",
    "2 cups miniature marshmallows",
    "1.5 cups NESTLE® TOLL HOUSE® Semi-Sweet Chocolate Morsels",
    "0.5 cup chopped pecans",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Line an 8-inch-square baking pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, evaporated milk, butter, and salt in a medium, heavy-duty saucepan over medium heat; bring to a full rolling boil, stirring constantly. Boil, stirring constantly, 4 to 5 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in marshmallows, chocolate morsels, pecans, and vanilla extract, stirring vigorously until marshmallows melted, about 1 minute. Pour into prepared baking pan; refrigerate until firm, about 2 hours. Lift from pan; remove foil. Cut into pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
