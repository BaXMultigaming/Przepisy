  "ingredients": [
    "2 cups water",
    "1 cup farro",
    "0.5 cup chopped celery",
    "0.333 cup crumbled feta cheese",
    "0.25 cup dried cherries",
    "0.25 cup chopped green onions",
    "2 tablespoons chopped toasted pecans",
    "0.5 teaspoon lemon zest",
    "1.5 tablespoons lemon juice",
    "1 tablespoon extra-virgin olive oil",
    "0.25 teaspoon salt",
    "0.25 teaspoon freshly ground black pepper",
    "lemon wedges for serving"
  ],
  "steps": [
    {
      "text": "Combine water, farro, and salt in a small saucepan and bring to a boil. Cover and simmer over low heat until water is absorbed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain, spread on a baking sheet, and chill 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix celery, feta, dried cherries, green onion, pecans, lemon zest, lemon juice, olive oil, salt, and pepper in a bowl. Add farro; toss to combine. Serve with lemon wedges.",
