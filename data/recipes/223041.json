  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "2 large eggs",
    "2 tablespoons vegetable oil",
    "1 cup sour cream",
    "0.5 cup milk",
    "1 tablespoon grated lemon zest",
    "3 cups all-purpose flour",
    "1 tablespoon baking powder",
    "0.5 teaspoon baking soda",
    "0.75 teaspoon salt",
    "2 cups fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 16 muffin cups, or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar in a large bowl until light and fluffy, about 3 minutes. Stir in eggs until well mixed. Add vegetable oil, stir to combine. Whisk sour cream, milk, and lemon zest into butter mixture until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, baking soda, and salt in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir half the flour mixture into the butter mixture until combined. Add remaining half of flour mixture and blueberries into the batter, folding together until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place muffin cups on center rack of the preheated oven and bake until tops are golden and a toothpick inserted into the center of a muffin comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
