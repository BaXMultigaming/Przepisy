  "title": "Chef John’s Blueberry Muffins",
  "description": "A perfect recipe for blueberry muffins made with sour cream and extra blueberries. Great served slightly warm.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-06-06T16:19:37-04:00",
