  "ingredients": [
    "4 cups all-purpose flour",
    "1.5 teaspoons salt, or more to taste",
    "1.5 cups butter",
    "3 eggs",
    "1 cup cold water"
  ],
  "steps": [
    {
      "text": "Mix flour and salt together in a large bowl. Cut butter into the flour mixture until it is the consistency of breadcrumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly beat eggs together in a separate bowl; stir into butter-flour mixture. Add water, a few tablespoons at a time, and mix just until incorporated, using your hands to bring dough together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough onto a floured work surface and cut into 4 portions. Refrigerate dough for 15 to 30 minutes before using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
