  "ingredients": [
    "1 tablespoon unsalted butter or margarine",
    "1 tablespoon olive oil",
    "1 onion, thinly sliced",
    "2 large garlic cloves, peeled and crushed",
    "2 (28 ounce) cans whole peeled tomatoes",
    "1 cup water",
    "1 tablespoon sugar",
    "0.25 teaspoon celery seed",
    "0.25 teaspoon dried oregano",
    "1 pinch red pepper flakes",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gppG0822JppB6PJIK8D9E93p5qQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269276-simple-tomato-soup-step1-1160-4x3-fc71d6d323884eaf815c41691c65764b.jpg"
      ],
      "image": "assets/images/269276/step_01.webp"
    },
    {
      "text": "Heat butter and olive oil in a large saucepan over medium-low heat. Cook onion and garlic until onion is soft and translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pe0Y61TckuAEX-J5RMP6AOsM9PM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269276-simple-tomato-soup-step2-1162-4x3-3919b6c2bb504186aa882a9e0482a83a.jpg"
      ],
      "image": "assets/images/269276/step_02.webp"
    },
    {
      "text": "Add tomatoes, water, sugar, celery seed, oregano, red pepper flakes, salt, and pepper. Bring to a boil. Reduce heat, cover, and simmer for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9AUg6QJ1vIeQvDgkwtawhTnMAnU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269276-simple-tomato-soup-step3-1167-4x3-0116e322b6144bc094e8c564dcf36759.jpg"
      ],
      "image": "assets/images/269276/step_03.webp"
    },
    {
      "text": "Remove from heat and purée with an immersion blender. Reheat soup until warm and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gYC51CMvVLCDyvBvIbph5MVIP2c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269276-simple-tomato-soup-step4-1169-4x3-8e20210048004f2d899ed0ce9a35d89a.jpg"
      ],
