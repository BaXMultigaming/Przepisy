  "ingredients": [
    "0.75 cup butter",
    "1 cup white sugar",
    "1 egg yolk",
    "1 teaspoon orange zest",
    "0.25 cup honey",
    "2.25 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon ground mace",
    "0.5 teaspoon salt",
    "1 egg white"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream butter and sugar until light and fluffy. Gradually blend in the egg yolk, orange zest, and honey. Sift together the flour, baking powder, salt, and mace; stir into the creamed mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop cookie dough by teaspoonfuls about 2 inches apart onto the prepared cookie sheet. Flatten cookies with a fork dipped in flour. Brush lightly with egg white. Bake for 10 to 14 minutes in the preheated oven. Cool on wire racks after removing from oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
