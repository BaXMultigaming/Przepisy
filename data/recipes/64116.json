    "2 tablespoons sugar",
    "2 tablespoons cider vinegar",
    "0.5 teaspoon salt",
    "0.5 teaspoon pepper",
    "0.5 teaspoon celery seed",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
