  "ingredients": [
    "0.75 pound breakfast sausage",
    "0.125 cup minced onion",
    "0.125 cup minced green bell pepper",
    "1 (12 ounce) can refrigerated biscuit dough",
    "3 eggs, beaten",
    "3 tablespoons milk",
    "0.5 cup shredded Colby-Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large, deep skillet over medium-high heat, combine sausage, onion and green pepper. Cook until sausage is evenly brown. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate the dough into 10 individual biscuits. Flatten each biscuit out, then line the bottom and sides of 10 muffin cups. Evenly distribute sausage mixture between the cups. Mix together the eggs and milk, and divide between the cups. Sprinkle tops with shredded cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 18 to 20 minutes, or until filling is set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
