  "ingredients": [
    "1 egg",
    "1.5 tablespoons ground cumin",
    "1 tablespoon chili powder",
    "1 teaspoon chile-garlic sauce (such as Sriracha®)",
    "1 (16 ounce) can black beans, rinsed and drained",
    "1 jalapeno pepper, minced",
    "1 cup canned whole kernel corn, drained",
    "3 cloves garlic, minced",
    "0.5 cup bread crumbs",
    "0.5 cup whole wheat flour",
    "2 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Whisk egg, cumin, chili powder, and chile-garlic sauce together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash black beans in a separate bowl until they reach a paste-like consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir jalapeno pepper, corn, and garlic through the black bean paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the egg mixture into the black bean mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scatter the bread crumbs over the black bean mixture; mix with your hands to evenly incorporate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form the resulting mixture into 4 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour flour into the bottom of a shallow dish; coat the patties in the flour to help them hold shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a skillet over medium heat. Cook the patties in hot oil until cooked through, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
