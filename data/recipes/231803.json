  "ingredients": [
    "1 tablespoon honey barbeque sauce",
    "1 low-carb whole wheat tortilla",
    "4 ounces shredded cooked chicken",
    "0.25 cup diced red onion, divided",
    "1 tablespoon chopped fresh cilantro, divided",
    "0.25 cup low-fat finely shredded mozzarella cheese, or more to taste"
