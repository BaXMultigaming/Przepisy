  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.66666668653488 cup butter",
    "1 cup white sugar",
    "2 eggs",
    "1 cup buttermilk",
    "1 teaspoon vanilla extract",
    "1 cup mango puree",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar till light and fluffy. Add eggs and beat well. Mix together flour and baking soda; blend into creamed mixture. Fold in buttermilk, vanilla, mango puree, and chopped nuts. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
