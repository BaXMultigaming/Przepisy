  "ingredients": [
    "16 ounces dry fusilli/spiral pasta",
    "1.5 pounds lean ground beef",
    "2 green bell peppers, chopped",
    "1 large onion, chopped",
    "48 ounces canned tomato sauce",
    "4 ounces pepperoni sausage, sliced",
    "2 cups shredded Italian cheese blend"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a skillet over medium heat, brown the ground beef until no pink shows; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine in a 9x13 inch casserole dish: pasta, ground beef, bell pepper, onion, tomato sauce and pepperoni; blend well. Top with shredded cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 to 35 minutes or until cheese is melted and casserole is heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
