  "ingredients": [
    "0.5 cup butter",
    "1 cup white sugar",
    "1 egg",
    "0.5 teaspoon almond extract",
    "1.75 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.5 cup sliced almonds",
    "2 tablespoons milk",
    "1 cup confectioners' sugar",
    "0.25 teaspoon almond extract",
    "0.25 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream butter and sugar. Add egg and almond extract; mix until fluffy. Stir in flour, baking powder and salt; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 4 pieces, and roll each one into a log about 12 inches long. Place 2 logs per cookie sheet 4 to 5 inches apart. Flatten each roll by hand until it is about 3 inches wide. Brush flattened roll with milk and sprinkle with sliced almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 12 to 15 minutes or until edges are slightly browned. While the cookies are still warm, cut them crosswise at a diagonal, into slices about 1 inch wide. When cool, drizzle with almond icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Almond icing: In a small bowl, stir together powdered sugar, almond extract, and milk until smooth. Drizzle over the cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
