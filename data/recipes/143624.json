  "ingredients": [
    "6 dried chipotle chili pepper",
    "1 cup extra-virgin olive oil",
    "1.5 cups chopped garlic",
    "5 tablespoons fresh lime juice",
    "0.5 teaspoon salt, or to taste"
  ],
  "steps": [
    {
      "text": "Place the chipotles in a bowl and cover with very hot water. Allow to soak for 3 minutes; drain. Remove the stems and seeds from the peppers and discard. Cut the peppers into thin strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the oil in a large skillet over low heat. Cook the garlic in the oil until golden brown, 4 to 5 minutes. Stir in the peppers and the lime juice; simmer 5 minutes; season with the salt. Transfer the mixture to a bowl and allow to cool. Store in the refrigerator in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
