  "ingredients": [
    "4 eggs",
    "2 tablespoons plain nonfat yogurt",
    "2 tablespoons light mayonnaise",
    "1 teaspoon Dijon mustard",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 cup diced celery",
    "1 green onion, chopped"
  ],
  "steps": [
    {
      "text": "Place eggs in saucepan and fill with cold water to cover. Bring to a boil over medium high heat. Cover, remove from heat and let stand for 15 to 20 minutes. Drain and run under cold water until chilled. Refrigerate for at least 2 hours or up to 7 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place peeled, hard cooked eggs in a bowl and using a fork or potato masher, mash eggs until finely chopped.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in yogurt, mayonnaise, Dijon mustard, salt and pepper until smooth. Add celery and green onion (if using) and stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread over your favorite bread, stuff into pita halves or scoop some onto your favorite salad greens.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
