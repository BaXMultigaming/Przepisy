  "ingredients": [
    "1 tablespoon butter",
    "1 tablespoon olive oil",
    "0.5 cup thinly sliced shallots",
    "2 cloves garlic, minced",
    "1 pound shrimp, peeled and deveined",
    "1 dash dried red pepper flakes",
    "salt and pepper to taste",
    "0.25 cup oil-packed sun-dried tomatoes, drained and diced",
    "0.5 cup cognac",
    "0.5 cup fat free half-and-half"
  ],
  "steps": [
    {
      "text": "Heat butter and olive oil in a large skillet over medium-high heat. Add shallots and garlic; cook until lightly browned. Add shrimp; season with pepper flakes, salt, and black pepper. Add sun-dried tomatoes; cook, stirring occasionally, until shrimp begin to brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cognac into the skillet and bring to a boil while scraping the browned bits of food off the bottom of the skillet with a wooden spoon. Reduce heat to low. Add half-and-half; simmer until slightly thickened, about 5 minutes.",
      "section": null,
