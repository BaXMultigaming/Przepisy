  "ingredients": [
    "4 cups half-and-half",
    "1 cup white sugar",
    "11 egg yolks, beaten",
    "1 teaspoon vanilla extract",
    "2 cups heavy cream",
    "0.66666668653488 cup dark rum",
    "0.5 cup Scotch whiskey",
    "1 pint vanilla ice cream"
