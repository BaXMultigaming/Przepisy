  "ingredients": [
    "3 tablespoons vegetable oil",
    "0.66666668653488 cup diced onion",
    "1.5 cups uncooked white rice",
    "1 cup chopped green bell pepper",
    "1 teaspoon ground cumin",
    "1 teaspoon chili powder",
    "1.5 (8 ounce) cans tomato sauce",
    "2 teaspoons salt",
    "1 clove garlic, minced",
    "0.125 teaspoon powdered saffron",
    "3 cups water"
  ],
  "steps": [
    {
      "text": "In a large saucepan, heat vegetable oil over medium-low heat. Place onions in the pan, and sauté until golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add rice to the pan, and stir to coat grains with oil. Mix in green bell pepper, cumin, chili powder, tomato sauce, salt, garlic, saffron, and water. Cover, bring to a boil, and then reduce heat to simmer. Cook for 30 to 40 minutes, or until rice is tender. Occasionally stir.",
