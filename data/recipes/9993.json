  "ingredients": [
    "1 cup packed brown sugar",
    "0.5 cup shortening",
    "2 (1 ounce) squares unsweetened chocolate, melted",
    "1 egg",
    "0.5 cup buttermilk",
    "1 cup chopped walnuts",
    "0.25 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 teaspoon vanilla extract",
    "1.5 cups cake flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream brown sugar, shortening, melted chocolate, egg and buttermilk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add dry ingredients and beat until smooth.",
      "section": null,
      "name": null,
      "url": null,
