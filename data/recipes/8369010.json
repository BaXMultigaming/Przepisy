  "title": "Marinara-Parmesan Meatball Sliders",
  "description": "Marinara and Parmesan cheese top these meatball sliders for tons of Italian-inspired flavor that&#39;s easy to prepare for parties.",
  "authors": [
    "thedailygourmet"
  ],
  "date_published": "2022-03-17T15:11:45-04:00",
