  "ingredients": [
    "2 cups sifted all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground ginger",
    "1 cup white sugar",
    "1 cup canned pumpkin",
    "0.33333298563957 cup buttermilk",
    "0.33333298563957 cup butter, melted",
    "2 eggs",
    "1 tablespoon molasses",
    "0.5 teaspoon vanilla extract",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 12-cup muffin tins or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, baking powder, cinnamon, nutmeg, and ginger together on wax paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, pumpkin purée, buttermilk, melted butter, eggs, molasses, and vanilla extract together in a bowl; stir in flour mixture until just moistened. Fold in pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter among the prepared muffin cups, filling each almost to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 20 to 25 minutes. Cool in the tins for 5 minutes, before transferring muffins to a wire rack to cool. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
