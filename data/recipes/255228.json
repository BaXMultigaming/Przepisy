  "ingredients": [
    "cooking spray",
    "1 pound Brussels sprouts, trimmed and cut in half",
    "1 tablespoon olive oil",
    "1 teaspoon kosher salt",
    "1 teaspoon fresh cracked black pepper",
    "1 teaspoon red pepper flakes",
    "1 tablespoon honey",
    "1.5 teaspoons sriracha sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a rimmed baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Brussels sprouts, olive oil, salt, pepper, and red pepper flakes in a bowl; toss until coated. Arrange in a single layer on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until Brussels sprouts are golden brown and tender, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix honey and Sriracha sauce together in a small bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place roasted Brussels sprouts in a bowl. Drizzle with honey mixture; toss until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
