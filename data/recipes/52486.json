  "ingredients": [
    "0.5 pound sugar snap peas, trimmed",
    "1 cup fresh raspberries",
    "2 tablespoons raspberry vinegar",
    "2 tablespoons olive oil",
    "1 pinch sugar",
    "salt and pepper to taste",
    "1 cup fresh blueberries",
    "2 cups torn mixed salad greens"
  ],
  "steps": [
    {
      "text": "Bring a pot of water to a boil. Place snap peas in pot, and cook 1 to 2 minutes. Drain, rinse under cold water, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place about 1 1/2 tablespoons raspberries in a strainer over a bowl, and crush with a wooden spoon. Discard pulp. Mix vinegar, olive oil, sugar, salt, and pepper with the strained raspberry juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, gently toss the dressing with the snap peas, remaining raspberries, and blueberries. Cover, and chill at least 30 minutes in the refrigerator. Toss with greens just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
