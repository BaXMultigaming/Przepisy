  "ingredients": [
    "1 cup white sugar",
    "0.5 cup shortening",
    "0.5 cup buttermilk",
    "1 egg",
    "1 teaspoon vanilla extract",
    "3 cups all-purpose flour",
    "1 tablespoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup confectioners' sugar, or more as needed",
    "1 tablespoon milk, or more as needed",
    "colored sprinkles, as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lPB3mvh1H-BqL1_9jxkDooJX5n4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-276802-grandma-amicos-buttermilk-sugar-cookie-cutouts-VAT-step-01-5f4b8c2a3f1d48659d64be39cf8e9ee2.jpg"
      ],
      "image": "assets/images/276802/step_01.webp"
    },
    {
      "text": "Beat white sugar, shortening, buttermilk, egg, and vanilla together in the bowl of a stand mixer (such as KitchenAid) fitted with the paddle attachment until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B731KCA15nxnRsZYKr1KpuuEDKw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-276802-grandma-amicos-buttermilk-sugar-cookie-cutouts-VAT-step-02-60c8820044cc401d925f739eca6cb967.jpg"
      ],
      "image": "assets/images/276802/step_02.webp"
    },
    {
      "text": "Whisk flour, baking powder, baking soda, and salt together in a separate bowl; beat into sugar mixture, ½ cup at a time, beating well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s0mRz7ZRQVTVS_ux8FotExXB1Rc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-276802-grandma-amicos-buttermilk-sugar-cookie-cutouts-VAT-step-03-a2c0753e35214f96bea1112df03f8891.jpg"
      ],
      "image": "assets/images/276802/step_03.webp"
    },
    {
      "text": "Pat dough into a square shape; wrap in plastic wrap. Refrigerate dough, 2 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j1Y2ZL52HP9iq_uG9Kqcquk9azo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-276802-grandma-amicos-buttermilk-sugar-cookie-cutouts-VAT-step-04-6cf39a64cc3e4747a8a244e62348ad6e.jpg"
      ],
      "image": "assets/images/276802/step_04.webp"
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Roll out dough on a lightly floured work surface using a lightly floured rolling pin to desired thickness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1LMuhBUMhcBZNynIaEgEEtWYa28=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-276802-grandma-amicos-buttermilk-sugar-cookie-cutouts-VAT-step-05-1-rollingpininframe-034c0d407734400f9a3c7bdc2a7fdc29.jpg"
      ],
      "image": "assets/images/276802/step_05.webp"
    },
    {
      "text": "Cut dough into shapes using cookie cutters; place onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/27WR3HsLDZhHwMnDAUhIsPiT7n0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-276802-grandma-amicos-buttermilk-sugar-cookie-cutouts-VAT-step-06-1-shapesonboard-240e05231acc4fc582a4a30cf50290a5.jpg"
      ],
      "image": "assets/images/276802/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until bottoms begin to lightly brown, 8 to 12 minutes. Cool cookies completely on wax paper or a wire rack, 15 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8Loin7Hw0KXrnEKJ_CkZyy6dbMw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-276802-grandma-amicos-buttermilk-sugar-cookie-cutouts-VAT-step-07-67ab1cfd35a449be9a5c85412678e5a7.jpg"
      ],
      "image": "assets/images/276802/step_07.webp"
    },
    {
      "text": "Combine confectioners' sugar and milk in a bowl until forms a paste, adding more sugar or milk until frosting reaches desired consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZjeLZJAeGHf1DZA_Cje0bItA7QE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-276802-grandma-amicos-buttermilk-sugar-cookie-cutouts-VAT-step-08-62e54cb3e9d54783a9c145728b6c70ed.jpg"
      ],
      "image": "assets/images/276802/step_08.webp"
    },
    {
      "text": "Thinly spread frosting onto cooled cookies; cover with sprinkles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cpJEtzjciSrZ1xEsgG19Mlpd66Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-276802-grandma-amicos-buttermilk-sugar-cookie-cutouts-VAT-step-09-9754fd2584dd424a8f00032606d45d31.jpg"
      ],
      "image": "assets/images/276802/step_09.webp"
    }
