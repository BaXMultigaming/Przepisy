  "title": "Baked Chicken Leg Quarters",
  "description": "Try this easy recipe for baked chicken leg quarters. The chicken is seasoned with a homemade spice mixture and brushed with butter for extra flavor.",
  "authors": [
    "Bibi"
  ],
  "date_published": "2022-07-25T11:04:04-04:00",
