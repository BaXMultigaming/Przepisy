  "ingredients": [
    "4 potatoes, peeled and quartered",
    "1 pound carrots, cut into large chunks",
    "1 onion, cut into wedges",
    "3 cups water",
    "2 tablespoons sugar",
    "2 tablespoons cider vinegar",
    "3 cloves garlic, minced",
    "0.5 teaspoon ground black pepper",
    "1 bay leaf",
    "1 (3 pound) corned beef brisket with spice packet, cut in half",
    "1 small head cabbage, cut into wedges"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZqdX92FqvDFev1WQt3XsI7Snopk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-222592-easy-corned-beef-and-cabbage-VAT-step-01-0fd685cfe9bb44988cee18009ceccb55.jpg"
      ],
      "image": "assets/images/222592/step_01.webp"
    },
    {
      "text": "Place potatoes, carrots, and onion into a 5-quart slow cooker. Combine water, sugar, vinegar, garlic, black pepper, bay leaf, and contents of spice packet in a small bowl; pour over vegetables. Top with beef brisket and cabbage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IAYQYLYJF1ixsaNKSZv2fsK5gxI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-222592-easy-corned-beef-and-cabbage-VAT-step-02-d98cb5a108104a3683f95d78839aa740.jpg"
      ],
      "image": "assets/images/222592/step_02.webp"
    },
    {
      "text": "Cover and cook on Low until beef and vegetables are tender, 8 to 9 hours. Remove bay leaf before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I79pB4i2ulXmWVbPPWAbl9EESm4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-222592-easy-corned-beef-and-cabbage-VAT-step-03-0684ac28f20544c282b945c2d37acb28.jpg"
