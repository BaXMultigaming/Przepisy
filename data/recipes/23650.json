  "ingredients": [
    "2 cups canned pumpkin puree",
    "1 cup milk",
    "1 cup light cream",
    "0.5 cup brown sugar",
    "0.5 cup white sugar",
    "1.5 teaspoons ground cinnamon",
    "0.25 teaspoon salt",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground cloves",
    "1 tablespoon all-purpose flour",
    "2 eggs, lightly beaten",
    "1 (9 inch) unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin puree, milk, cream, brown sugar, and white sugar in a large bowl; mix in cinnamon, salt, nutmeg, ginger, and cloves. Beat in flour and eggs. Pour filling into prepared pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes, then reduce the temperature to 350 degrees F (175 degrees C) and bake until filling has set, about 50 minutes.",
      "section": null,
