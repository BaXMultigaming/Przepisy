  "ingredients": [
    "4 thick slices bacon",
    "0.5 cup chopped onion",
    "4 (14.5 ounce) cans green beans, drained",
    "1 tablespoon brown sugar",
    "1 teaspoon dry mustard",
    "0.75 cup chili sauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Remove bacon from skillet, leaving grease. Crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir onion into bacon grease, and cook over medium heat until tender; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium baking dish, mix bacon, onion, green beans, brown sugar, dry mustard and chili sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 30 minutes in the preheated oven, until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
