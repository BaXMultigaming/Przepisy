  "ingredients": [
    "1 cup vegetable oil",
    "3 eggs",
    "1.5 cups white sugar",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 teaspoon ground allspice",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 cup buttermilk",
    "1.25 teaspoons vanilla extract",
    "1 cup prunes, pitted and chopped",
    "1.5 cups chopped pecans",
    "0.75 cup butter",
    "0.75 cup buttermilk",
    "1.5 teaspoons dark corn syrup",
    "1.5 cups white sugar",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt or tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, salt, allspice, cinnamon, and nutmeg together in a medium bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat oil, eggs, and sugar together in a large bowl at medium speed until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the flour mixture alternately with buttermilk, beginning and ending with the flour mixture. Beat well after each addition. Fold in prunes, pecans, and 1 1/4 teaspoons vanilla. Spread batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Poke deep holes all over the hot cake with the handle of a wooden spoon or a skewer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the glaze: Combine butter, buttermilk, corn syrup, and sugar in a saucepan over medium heat. Cook, stirring occasionally, until the butter melts and the sugar dissolves. Remove from the heat and stir in 2 teaspoons vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly spoon the warm glaze over the hot cake, allowing it to soak into the holes before adding more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
