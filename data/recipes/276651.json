  "ingredients": [
    "nonstick cooking spray",
    "0.5 cup pumpkin puree",
    "0.5 cup peanut butter",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon pumpkin pie spice",
    "0.5 teaspoon baking soda",
    "2 packets stevia sweetener (such as Truvia®)",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Line the air fryer basket with parchment paper and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin puree, peanut butter, eggs, vanilla, pumpkin pie spice, baking soda, sweetener, and salt in a bowl. Stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches if necessary, place about 3 tablespoons batter for each pancake on the parchment paper in the air fryer basket, leaving about 1/2 inch space in between.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place basket in the air fryer oven and cook at 300 degrees F (150 degrees C), without flipping, until the bottom side is fully cooked, 4 to 6 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
