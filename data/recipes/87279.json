  "ingredients": [
    "1 pound salmon fillets",
    "0.25 cup butter, melted",
    "5 tablespoons lemon juice",
    "1 tablespoon dried dill weed",
    "0.25 teaspoon garlic powder",
    "sea salt to taste",
    "freshly ground black pepper to taste"
  ],
