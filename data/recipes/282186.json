  "ingredients": [
    "0.5 cup Country Crock® Spread",
    "1.75 cups white sugar",
    "0.5 cup milk",
    "0.75 cup creamy peanut butter",
    "2 teaspoons vanilla extract",
    "3.25 cups uncooked quick-cooking oats",
    "1 cup (6 ounces) chocolate chips"
  ],
  "steps": [
    {
      "text": "Line 2 baking sheets with waxed or parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the Country Crock® Spread in a 3 1/2-quart saucepan over medium heat. Stir in the sugar and milk; bring to a full rolling boil. Boil vigorously for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and immediately stir in the peanut butter, vanilla, and oats, stirring to combine. Add chocolate, stirring just until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop the dough into mounds by rounded tablespoonfuls onto the prepared baking sheets. Do not flatten. Let the cookies stand for 30 minutes, or until set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
