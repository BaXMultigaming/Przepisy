  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1.5 cups white sugar, divided",
    "0.5 cup butter, softened",
    "1 cup milk",
    "1 teaspoon vanilla extract",
    "4 cups halved and pitted cherries",
    "1.25 cups cherry juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a deep 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 cup sugar and butter in a separate bowl with an electric mixer until light and fluffy, 4 to 5 minutes. Stir in milk and vanilla. Add flour mixture and mix until batter is well blended and thick, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter in the prepared baking dish. Arrange cherries over the batter, then drizzle cherry juice over top. Sprinkle remaining 1/2 cup sugar over the surface.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
