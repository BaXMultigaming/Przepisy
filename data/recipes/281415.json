  "ingredients": [
    "2 tablespoons extra-virgin olive oil",
    "2 teaspoons packed brown sugar",
    "2 teaspoons onion powder",
    "2 teaspoons garlic powder",
    "2 teaspoons chili powder",
    "2 teaspoons paprika",
    "1 teaspoon sea salt",
    "1 teaspoon ground black pepper",
    "2 pounds frozen chicken wings, thawed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil, brown sugar, onion powder, garlic powder, chili powder, paprika, salt, and black pepper in a bowl. Rub over chicken wings; transfer to the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and no longer pink in the centers, about 25 minutes.",
      "section": null,
