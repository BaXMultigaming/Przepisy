  "ingredients": [
    "1 tablespoon unsalted butter, or as needed",
    "1.5 cups peanut butter",
    "1 cup light corn syrup",
    "1 cup white sugar",
    "6 cups crisp rice cereal",
    "0.5 cup semisweet chocolate chips",
    "0.5 cup butterscotch chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Generously butter a 9x13-inch baking pan; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/408TbpJoFBPmH1K8O9mxGLMLfbI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15585-scotcharoos-DDMFS-4x3-step-01-5e32869b0ac34e7085721cd3faeaf07f.jpg"
      ],
      "image": "assets/images/15585/step_01.webp"
    },
    {
      "text": "Mix peanut butter, corn syrup, and sugar together in a large pot; cook and stir over medium heat until peanut butter melts. Bring mixture to a boil. Remove pot from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2BhayzacdC50NDtt2tjqGWujU6E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15585-scotcharoos-DDMFS-4x3-step-02-2741484356b04c4abd5c998d64cf9854.jpg"
      ],
      "image": "assets/images/15585/step_02.webp"
    },
    {
      "text": "Stir in rice cereal until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rYRM4IEa2qUXq3MItUsAm3w6mqg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15585-scotcharoos-DDMFS-4x3-step-03-0ed149cf888e4065bd287c31f1377da1.jpg"
      ],
      "image": "assets/images/15585/step_03.webp"
    },
    {
      "text": "Transfer mixture into the prepared pan and pat it down with buttered hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X5mTEqQu2YUqUL__uUWqsy7osP8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15585-scotcharoos-DDMFS-4x3-step-04-b8334acb13dd4902b72f1abdbfa8ed80.jpg"
      ],
      "image": "assets/images/15585/step_04.webp"
    },
    {
      "text": "Melt chocolate chips and butterscotch chips in a medium saucepan over medium-low heat; stir until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kw0ip4Wjy0fEuyyqoRS3kYRMyHI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15585-scotcharoos-DDMFS-4x3-step-05-1d6d992cb55c4fe4a07b85cb536547ea.jpg"
      ],
      "image": "assets/images/15585/step_05.webp"
    },
    {
      "text": "Spread over top of bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sshJ_99A2Mm9W1viHpEXDNZD4iQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15585-scotcharoos-DDMFS-4x3-step-06-1-5011540f7c5f41138250f1060a4b9b19.jpg"
