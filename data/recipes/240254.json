  "ingredients": [
    "1 head cauliflower, cut into florets",
    "0.5 cup shredded Cheddar cheese",
    "0.5 cup grated Parmesan cheese",
    "2 large eggs, beaten",
    "0.5 teaspoon cayenne pepper, or to taste",
    "0.25 teaspoon salt, or to taste",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Place cauliflower into a large pot and cover with water; bring to a boil. Reduce heat to medium-low and simmer until tender, 7 to 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash cauliflower in a bowl until smooth. Beat Cheddar cheese, Parmesan cheese, eggs, cayenne pepper, and salt into cauliflower.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium-high heat. Pour cauliflower mixture into hot butter and cook until golden, about 5 minutes. Flip cauliflower mixture; cook and stir until mixture is more crumbly than creamy, about 10 minutes more.",
      "section": null,
