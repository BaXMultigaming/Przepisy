  "ingredients": [
    "1 cup butter, softened",
    "0.66666668653488 cup brown sugar",
    "0.66666668653488 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "2 cups quick-cooking oats",
    "2 cups chocolate chips, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugars with an electric mixer until light and fluffy. Beat in eggs and vanilla extract. Blend in flour, baking powder, cinnamon, and salt. Mix in oats and 1 cup chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter evenly in an ungreased 9x13-inch baking pan. Sprinkle remaining 1 cup chocolate chips evenly on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are browned and center is light brown, 20 to 22 minutes. Do not overbake. Cool completely before cutting into 24 bars.",
      "section": null,
      "name": null,
      "url": null,
