  "title": "Quick Blueberry Sheet Cake",
  "description": "This quick blueberry sheet cake can be made with fresh or frozen blueberries and is great for potlucks or when you're serving lots of people.",
  "authors": [
    "Tinkerbell"
  ],
  "date_published": "2020-06-19T00:25:13-04:00",
