  "ingredients": [
    "4 eggs",
    "0.75 cup white sugar",
    "0.5 cup canola oil",
    "1 individual packet vanilla sugar",
    "2 teaspoons lemon juice",
    "lemon zest",
    "1 pinch salt",
    "2.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "0.25 cup milk",
    "3 cups blueberries",
    "2 tablespoons confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl with an electric mixer until foamy. Mix in sugar, oil, vanilla sugar, lemon juice, lemon zest, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, and cinnamon in a bowl. Stir flour mixture and milk alternately into egg mixture until batter is well blended. Spread batter onto the prepared baking sheet and distribute blueberries evenly on top. Lightly press into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until toothpick comes out clean, 20 to 30 minutes depending on the size of the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool cake completely, 1 to 2 hours. Dust with confectioners' sugar and cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
