  "ingredients": [
    "0.25 cup cranberry sauce",
    "0.25 cup Dijon mustard",
    "1 clove garlic, peeled",
    "salt and ground black pepper to taste",
    "0.25 cup rice vinegar",
    "0.25 cup apple cider vinegar",
    "0.25 cup walnut oil",
    "1 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Place cranberry sauce, Dijon mustard, garlic, salt, black pepper, rice vinegar, and cider vinegar into a blender. Turn the blender on and process until smooth, about 30 seconds. Pour in walnut oil in a steady stream, then vegetable oil. Blend until the salad dressing is thick and creamy, about 1 minute.",
