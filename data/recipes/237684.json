  "ingredients": [
    "1 (2 pound) pork roast",
    "0.33333334326744 cup Chardonnay wine",
    "0.125 teaspoon ground ginger",
    "2 cloves garlic, minced",
    "1 teaspoon rosemary",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pierce pork roast multiple times with a fork and place into a roasting bag. Pour wine over the roast. Sprinkle ginger, garlic, rosemary, and black pepper over the roast, respectively. Seal roasting bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until pork is slightly pink in the center, about 1 hour. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C).",
