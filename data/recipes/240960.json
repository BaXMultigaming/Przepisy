  "ingredients": [
    "12 (3 inch) unbaked tart shells",
    "0.75 cup raisins",
    "0.5 cup chopped walnuts or pecans",
    "0.5 cup brown sugar",
    "0.25 cup corn syrup",
    "3 tablespoons butter, softened",
    "1 egg, beaten",
    "1 tablespoon vanilla extract",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tart shells on a baking sheet; sprinkle raisins and walnuts evenly between shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk brown sugar, corn syrup, butter, egg, vanilla extract, and salt together in a bowl; pour mixture evenly over raisins and walnuts into tart shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
