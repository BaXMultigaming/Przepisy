  "ingredients": [
    "3.5 cups all-purpose flour",
    "0.5 cup white sugar",
    "2 tablespoons caraway seeds",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "2 eggs",
    "1 (16 ounce) container sour cream",
    "0.75 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, caraway seeds, baking powder, salt, and baking soda in a large bowl. In another large bowl, whisk the eggs with the sour cream together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently stir sour cream mixture into flour mixture until dough comes together. Fold in raisins. Spoon dough into the prepared springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until golden brown, 40 to 45 minutes. A toothpick inserted into the center should come out clean. Cool bread in the pan for 10 minutes before removing. Cut into wedges and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
