  "ingredients": [
    "6 slices bacon",
    "4 roma (plum) tomatoes, seeded and chopped",
    "0.33333298563957 cup chopped green bell pepper",
    "0.33333298563957 cup chopped onion",
    "1 teaspoon dried basil",
    "2 tablespoons mayonnaise",
    "1 clove crushed garlic",
    "1 refrigerated pizza crust dough",
    "0.75 cup shredded Swiss cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in a large skillet over medium heat until crisp. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble bacon into a bowl; stir in tomatoes, bell pepper, onion, and basil until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise and garlic together in a small bowl until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll pizza dough into a 12x15-inch baking sheet; spread mayonnaise mixture over dough. Sprinkle bacon mixture over mayonnaise mixture; top with Swiss cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is bubbly and crust is golden brown, 18 to 20 minutes. Cool slightly, then cut pizza into 24 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
