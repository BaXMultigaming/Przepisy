  "title": "Tomato Bacon Squares",
  "description": "This tomato bacon squares recipe features a purchased pizza crust topped with garlic mayo, Roma tomatoes, crumbled bacon, bell peppers, and Swiss cheese.",
  "authors": [
    "April Phillips"
  ],
  "date_published": "1999-12-17T09:23:33-05:00",
