  "ingredients": [
    "2 tablespoons olive oil",
    "1 medium onion, diced",
    "6 cloves garlic, minced",
    "1 pound imitation crabmeat, diced",
    "1 (16 ounce) package rotini pasta",
    "1 cup half-and-half",
    "0.5 cup chopped fresh parsley",
    "0.33333334326744 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "At the same time, heat oil in a large saucepan over medium heat. Add onion and garlic; cook and stir until translucent, about 5 minutes. Stir in imitation crab and heat for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When the water boils, add rotini and cook, stirring occasionally, until tender yet firm to the bite, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the pasta is cooking, add half-and-half and parsley to crab sauce; stir and bring to a simmer. Continue to simmer crab sauce, adding pasta water as necessary, while pasta is finishing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Parmesan cheese into crab sauce and heat until melted, about 2 minutes. Serve over pasta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
