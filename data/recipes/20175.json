  "ingredients": [
    "3 cups all-purpose flour, plus more for kneading",
    "0.5 cup white sugar",
    "5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.75 cup butter",
    "1 cup milk",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E4I8NeTdgNfC-msZSW2dcK9Ztj4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20175-Scones-DDMFS-Step-01-4b8aad89345e4bdb91beac5d7ec98328.jpg"
      ],
      "image": "assets/images/20175/step_01.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IiU_phn3I4c9b3OpzSXk-2VpXIs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20175-Scones-DDMFS-Step-01-1-064a0dbd095a44178e87014fa73a1867.jpg"
      ],
      "image": "assets/images/20175/step_02.webp"
    },
    {
      "text": "Combine flour, sugar, baking powder, and salt in a large bowl; cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-Tt7CZy5sB4oLnmZew6dgtzpnCI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20175-Scones-DDMFS-Step-02-1-d5886495297143878604bfd42442dea8.jpg"
      ],
      "image": "assets/images/20175/step_03.webp"
    },
    {
      "text": "Whisk milk and egg in a small bowl; gradually stir into flour mixture until moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/y9XDR-omHNK_va80FBan_F_p8eo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20175-Scones-DDMFS-Step-03-e31cbc9c4a4d41c6bfc7dc44e21d716e.jpg"
      ],
      "image": "assets/images/20175/step_04.webp"
    },
    {
      "text": "Turn dough out onto a lightly floured surface and knead briefly, 5 or 6 turns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n4I-q4z_8-t5ejnNkzE0-So1Jp8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20175-Scones-DDMFS-Step-04-0caca70ce605461b9fb320095273b712.jpg"
      ],
      "image": "assets/images/20175/step_05.webp"
    },
    {
      "text": "Pat or roll dough out into a 1/2-inch thick round. Cut into 8 wedge-shaped pieces and place onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hDKoxsGhRXWyx9GRGoZuzAkyjMM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20175-Scones-DDMFS-Step-06-734987c8da5b4ebaab41cfd6859b411c.jpg"
      ],
      "image": "assets/images/20175/step_06.webp"
    },
    {
      "text": "Bake scones in the preheated oven until golden brown on top, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QNHISpyhhovPprLArXAV7iAMFdI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20175-Scones-DDMFS-4x3-69f9eccbf35b437c86a9c90e96ef37f9.jpg"
      ],
      "image": "assets/images/20175/step_07.webp"
    }
