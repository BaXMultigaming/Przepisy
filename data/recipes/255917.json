  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup water",
    "0.5 cup vegetable oil",
    "1 egg",
    "0.5 teaspoon salt",
    "2 cups refried beans, warmed",
    "1 avocado, sliced",
    "0.5 cup crumbled queso fresco (fresh white cheese)",
    "0.25 cup crema fresca (fresh cream)"
  ],
  "steps": [
    {
      "text": "Make the tortillas: Mix flour, water, vegetable oil, egg, and salt together in a large bowl. Knead dough until smooth and no longer sticky. Form into eight golf ball-sized balls. Cover and let rest for about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stretch each ball of dough into a thick tortilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook each tortilla until browned and lightly puffed, about 1 minute per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer refried beans, avocado, and queso fresco onto warm tortillas, then drizzle crema over top. Fold tortillas in half to eat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
