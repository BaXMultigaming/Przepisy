  "ingredients": [
    "1 cup packed brown sugar",
    "0.75 cup shortening",
    "1 egg",
    "1 cup applesauce",
    "2.5 cups all-purpose flour",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "1 cup chopped walnuts",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 325 degrees F (165 degrees C). Grease cookie sheets.",
