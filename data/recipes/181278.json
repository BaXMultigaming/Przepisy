  "ingredients": [
    "0.25 cup white sugar",
    "1 teaspoon apple pie spice",
    "1 (12 ounce) can refrigerated biscuit dough, separated and cut into six pieces",
    "0.5 cup brown sugar",
    "3 tablespoons butter",
    "1 teaspoon water"
  ],
