  "ingredients": [
    "cooking spray",
    "2 cups milk",
    "4 eggs",
    "1 cup white sugar",
    "1 tablespoon vanilla extract",
    "4 cups cubed French bread",
    "2 bananas, sliced",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan with cooking spray; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together milk, eggs, sugar, and vanilla in a large bowl until smooth. Stir in bread, bananas, and chocolate chips. Let mixture rest until bread soaks up liquid, about 5 minutes. Pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a roasting pan with a damp kitchen towel. Place the loaf pan on the towel inside the roasting pan, then place the roasting pan on the oven rack. Fill the roasting pan with water to reach halfway up the sides of the loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
