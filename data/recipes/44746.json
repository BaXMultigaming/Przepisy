  "ingredients": [
    "3 tablespoons water",
    "0.25 cup white vinegar",
    "2 tablespoons light corn syrup",
    "1 (12 ounce) jar cherry preserves",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Stir together water, vinegar, corn syrup, preserves, cinnamon, cloves, and nutmeg in a saucepan over medium-high heat. Bring to a boil, then reduce heat to low and simmer for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush 1/4 to 1/3 cup of this glaze over your ham about 30 minutes before it is finished baking. Stir any ham drippings into the remaining glaze and serve alongside the sliced ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
