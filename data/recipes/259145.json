  "ingredients": [
    "0.75 cup white sugar",
    "0.25 cup milk",
    "0.25 cup lime juice",
    "2 quarts fresh strawberries, mashed",
    "1 egg white"
  ],
  "steps": [
    {
      "text": "Mix sugar, milk, and lime juice together in a bowl. Mix in mashed strawberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white in a glass, metal, or ceramic bowl until stiff peaks form. Fold into the strawberry-lime mixture. Pour mixture into a freezer-safe container. Cover with plastic wrap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Freeze until almost firm, about 2 hours. Remove from freezer and stir thoroughly to break up chunks. Return to the freezer for 3 hours, stirring once every hour. Freeze until firm, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
