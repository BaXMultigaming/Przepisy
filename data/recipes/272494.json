  "ingredients": [
    "2 cups long-grain white rice",
    "2 tablespoons canola oil",
    "1 tablespoon sesame oil, or to taste",
    "1 cup diced ham",
    "0.5 cup sliced green onions",
    "0.5 cup diced red bell peppers",
    "0.5 cup diced carrots",
    "0.5 cup green peas",
    "3 cloves garlic, crushed",
    "1 pinch salt",
    "3 cups chicken broth",
    "3 tablespoons soy sauce",
    "2 teaspoons chile paste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place rice in an 8x12-inch baking dish. Drizzle in canola and sesame oils, then toss rice until completely coated. Add ham, green onions, bell peppers, carrots, peas, garlic, and salt. Stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring chicken broth, soy sauce, and chile paste to a boil in a saucepan over high heat. Pour broth over rice and stir briefly. Cover the baking dish tightly with heavy-duty aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 32 minutes. Remove and let stand for 10 minutes. Increase the oven temperature to 475 degrees F (245 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully remove the foil and fluff rice with a fork. Taste and adjust seasoning. Return to the oven and cook until rice is browned and crusty on top, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
