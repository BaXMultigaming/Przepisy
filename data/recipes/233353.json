  "ingredients": [
    "4 large eggs, beaten",
    "1 cup vegetable oil",
    "1 cup white sugar",
    "1 cup brown sugar",
    "2 cups finely chopped pecans",
    "1.5 cups self-rising flour",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, oil, white sugar, and brown sugar together in a bowl until smooth; stir in pecans, flour, and vanilla extract until incorporated. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 30 to 35 minutes. Cool on a wire rack for 10 minutes, then turn cake out onto a platter and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
