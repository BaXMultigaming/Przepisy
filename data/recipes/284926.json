  "ingredients": [
    "nonstick cooking spray",
    "2 pounds skinless, boneless chicken breast halves",
    "2 large eggs, beaten",
    "2 tablespoons water",
    "2 cups plain dry bread crumbs",
    "0.5 cup grated Parmesan cheese",
    "2 teaspoons garlic powder",
    "2 teaspoons dried parsley",
    "0.25 teaspoon black pepper",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with foil; spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut chicken breasts into thin strips, about 1-inch wide.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and water together in a shallow dish. Mix bread crumbs, Parmesan cheese, garlic powder, parsley, pepper, and salt together in another shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chicken into egg mixture, then dredge in crumb mixture. Place coated chicken on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink in the center and coating is crispy on the outside and golden brown, 15 to 20 minutes, turning once halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
