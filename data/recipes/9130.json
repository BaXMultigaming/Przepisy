  "ingredients": [
    "4 cups sliced onion",
    "5 tablespoons butter",
    "1 cup cream",
    "salt to taste",
    "ground black pepper to taste",
    "0.66670000553131 cup Parmesan cheese",
    "2 eggs"
  ],
  "steps": [
    {
      "text": "Saute onions in butter or margarine until transparent. Place in 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, beat eggs well. Stir in cream, and season with salt and pepper. Pour mixture over onions, and sprinkle cheese.",
