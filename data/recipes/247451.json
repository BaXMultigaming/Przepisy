  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "1 tablespoon olive oil",
    "0.5 teaspoon salt and pepper",
    "0.5 cup water",
    "1.5 cups vinegar-based Carolina-style BBQ sauce",
    "1 (14 ounce) package coleslaw mix",
    "0.25 cup mayonnaise",
    "2 tablespoons red wine vinegar",
    "1 teaspoon sugar",
    "16 mini sweet rolls",
    "Reynolds Wrap® Heavy Duty Aluminum Foil",
    "Reynolds® Slow Cooker Liner"
  ],
  "steps": [
    {
      "text": "Preheat the grill to high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a hot grill with Reynolds Wrap® Heavy Duty Aluminum Foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat the chicken breasts with the oil and season on all sides with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the chicken breasts directly on the hot grill lined with foil and cook for 3 to 4 minutes on each side or until grill marks have formed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the chicken in a slow cooker lined with a Reynolds® Slow Cooker Liner and pour in water and BBQ sauce and cook on high heat for 3 hours or low heat for 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pull the chicken apart using two forks until it is shredded and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the coleslaw mix, mayonnaise, vinegar, sugar and salt and pepper until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve the pulled chicken on sweet rolls and top off with some creamy coleslaw.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
