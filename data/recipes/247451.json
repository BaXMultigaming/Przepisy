  "title": "Pulled BBQ Chicken Sliders",
  "description": "Sink your teeth into these Carolina-style Pulled BBQ Chicken Sliders with creamy coleslaw on a delicious sweet roll bun.",
  "authors": [
    "Reynolds KitchensR"
  ],
  "date_published": "2020-06-19T00:07:04-04:00",
