  "ingredients": [
    "1.25 cups chopped pitted prunes",
    "1.25 cups raisins",
    "0.75 cup whole almonds, skin removed",
    "0.75 cup chopped walnuts",
    "0.75 cup toasted hazelnuts",
    "2 tablespoons white sugar",
    "1 tablespoon orange marmalade",
    "2 tablespoons chopped candied orange peel",
    "0.5 teaspoon ground cinnamon, or to taste",
    "2 tablespoons white wine",
    "2 tablespoons extra virgin olive oil",
    "0.75 cup all-purpose flour, or more as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine prunes, raisins, almonds, walnuts, hazelnuts, sugar, orange marmalade, candied orange peel, and cinnamon in a large bowl and stir to combine with a wooden spoon. Pour in wine and olive oil. Add flour and mix everything into a sticky dough, adding more flour if mixture does not stick together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape mixture into 8 similar sized logs with wet hands and place onto prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
