  "ingredients": [
    "cooking spray",
    "1 egg white",
    "1 cup granulated sugar",
    "1.5 teaspoons ground cinnamon",
    "1 tablespoon vanilla extract",
    "0.5 teaspoon salt",
    "4 cups walnut halves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 200 degrees F (95 degrees C). Prepare a jelly roll pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white and sugar together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cinnamon, vanilla, and salt together in a small bowl; stir into the egg mixture. Fold walnuts into the mixture to coat; spread onto the prepared jelly roll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the coating is crusty, about 1 hour 15 minutes. Cool nuts 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
