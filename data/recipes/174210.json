  "ingredients": [
    "1 tablespoon vegetable oil",
    "2 cloves garlic, minced",
    "1 pound shredded cabbage",
    "1 tablespoon soy sauce",
    "1 tablespoon Chinese cooking wine (Shaoxing wine)"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a wok or large skillet over medium heat. Stir in garlic and cook until it begins to brown, 3 to 5 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7UXSgHbz8-dhGdajONisSA2P0Fc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/174210-SuperEasyStir-FriedCabbage-ddmfs-step-2-1104056-3196c317f1624696b61485a39026dc6e.jpg"
      ],
      "image": "assets/images/174210/step_01.webp"
    },
    {
      "text": "Stir in cabbage until coated in oil; cover the wok and cook for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_tQz2oz6HpXZTMoiSelkZtbH3y8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/174210-SuperEasyStir-FriedCabbage-ddmfs-step-3-1104059-2b5c289cba2049a6a3e36db847d6b5e9.jpg"
      ],
      "image": "assets/images/174210/step_02.webp"
    },
    {
      "text": "Pour in soy sauce; cook and stir for another minute. Increase heat to high and stir in Chinese cooking wine. Cook and stir until cabbage is tender, about 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JfKm1CsDMyYU5IGjTpePElp9ib8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/174210-SuperEasyStir-FriedCabbage-ddmfs-step-4-1104064-d882a7745c45458da5857d217cf8a66e.jpg"
      ],
      "image": "assets/images/174210/step_03.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
