  "ingredients": [
    "2 apples, or more to taste, cut into 1-inch pieces",
    "1 (12 ounce) package fresh cranberries",
    "0.5 cup raisins",
    "0.25 cup walnuts",
    "1.25 cups white sugar, divided",
    "ground cinnamon",
    "1 cup all-purpose flour",
    "0.25 cup butter, melted",
    "1 egg",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Butter a 9x9-inch glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine apples, cranberries, raisins, and walnuts in the prepared baking dish. Sprinkle with ¼ cup sugar and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1 cup sugar, flour, butter, egg, baking powder, and salt in a bowl; mix until crumbly. Spread over apple mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is golden and inside is bubbling, about 50 minutes. Cool 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
