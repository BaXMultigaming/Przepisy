  "ingredients": [
    "12 small chicken wings",
    "0.25 teaspoon seasoned salt, or to taste",
    "1 cup all-purpose flour",
    "1 teaspoon coarse salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon ground paprika",
    "2 quarts vegetable oil for frying",
    "1 (12 fluid ounce) bottle Buffalo wing sauce (such as Frank's®), or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WqwLB8wKGSic8H0nwVxq4HnGCQg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241152-fried-chicken-wings-ddmfs-ingredients-3x4-1216-15d4f90c5d294e32b698bb5bf3d8d590.jpg"
      ],
      "image": "assets/images/241152/step_01.webp"
    },
    {
      "text": "Season chicken wings lightly with seasoned salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-cOC2lRFSEHli7xPxREtn38ib64=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241152-fried-chicken-wings-ddmfs-step-01-3x4-1218-c88a5117e88d424ab29c40eb3852e59d.jpg"
      ],
      "image": "assets/images/241152/step_02.webp"
    },
    {
      "text": "Mix flour, salt, black pepper, cayenne pepper, and paprika together in a wide, shallow bowl. Press wings into flour mixture to coat and arrange in a single layer on a large plate. Refrigerate coated wings for 15 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MX1Eom4w8m9kVLkiJ-fX8VprHyk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241152-fried-chicken-wings-ddmfs-step-03-3x4-1223-5d63c0b7ff624f39853b3acc3d3edef0.jpg"
      ],
      "image": "assets/images/241152/step_03.webp"
    },
    {
      "text": "Dredge wings again in flour mixture and return to the plate. Refrigerate wings once more for 15 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QoNBKkqblK_-dN8qxaqjVwwQrS0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241152-fried-chicken-wings-ddmfs-step-04-3x4-1224-94401e725cfb4d53badb812e1bd5f9a5.jpg"
      ],
      "image": "assets/images/241152/step_04.webp"
    },
    {
      "text": "Heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry chicken wings in hot oil until crisp and juices run clear, 10 to 12 minutes. An instant-read thermometer inserted into the thickest part of the meat, near the bone, should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lAu5VNU-ITkDh3KYPypN7cSbEFs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241152-fried-chicken-wings-ddmfs-step-05-3x4-1239-e4d9f66f470e497385f66fd1b617144e.jpg"
      ],
      "image": "assets/images/241152/step_06.webp"
    },
    {
      "text": "Transfer fried wings to a large bowl. Drizzle sauce over wings and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XwZUTgXg_fWdgD-FrNWjx0D86MA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241152-fried-chicken-wings-ddmfs-step-07-3x4-1244-842bc5c119e54d6a984ad5382e24ddc6.jpg"
      ],
      "image": "assets/images/241152/step_07.webp"
    },
