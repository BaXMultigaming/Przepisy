  "title": "Braised Beef Short Ribs",
  "description": "A savory stew including tomatoes, potatoes, carrots, and garlic. This very flavorful and economical cut of meat requires long, slow cooking.",
  "authors": [
    "Jim Stearns"
  ],
  "date_published": "1999-12-13T11:11:52-05:00",
