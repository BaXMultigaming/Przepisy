  "ingredients": [
    "3 cups all-purpose flour",
    "4 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1.5 cups shredded Cheddar cheese",
    "1.5 cups milk",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease an 8x4-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, baking powder, and salt in a large bowl. Stir in Cheddar until incorporated, then add milk and melted butter, and mix until a soft dough forms. Spoon dough into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the loaf comes out clean, about 35 to 40 minutes. Remove from the pan and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
