  "ingredients": [
    "peanut or corn oil for frying",
    "0.75 cup self-rising flour",
    "0.5 cup self-rising cornmeal mix",
    "0.25 cup sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon freshly grated nutmeg",
    "1 egg",
    "0.5 cup buttermilk",
    "1 tablespoon cinnamon",
    "0.5 cup sugar"
  ],
  "steps": [
    {
      "text": "Heat oil in deep-fryer to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, combine the flour, cornmeal mix, sugar, cinnamon, and nutmeg. In a separate bowl, beat the egg together with the buttermilk. Gradually add the egg mixture to the dry ingredients, stirring with a fork or whisk until only slightly lumpy. Be careful not to overmix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully drop batter by the rounded teaspoonful into hot oil, and fry until golden brown. Drain and cool on a paper towel-lined plate. Roll balls in a small amount of cinnamon mixed with sugar, if desired, or just enjoy plain!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
