  "title": "Lemon Squares I",
  "description": "These lemon-walnut bars are a perfect treat for a hot summer day--or any time you want a blast of citrus sunshine.",
  "authors": [
    "Amanda Regis"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
