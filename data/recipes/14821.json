  "ingredients": [
    "1 pound chicken livers",
    "1 medium onion, thinly sliced",
    "0.75 cup butter, softened",
    "0.25 cup chopped onion",
    "3 tablespoons cooking sherry",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.125 teaspoon ground mace"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vnHb9Ky8NE3zI4Py0pta_IXjqm4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14821-liver-pate-ddmfs-step-1-4x3-21cc326545b84b50b0d8147196e5051c.jpg"
      ],
      "image": "assets/images/14821/step_01.webp"
    },
    {
      "text": "Combine livers and sliced onion in a medium saucepan. Pour in about 3 cups water and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hsjfjXbLrKilPeW6tFKu8xrU0D8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14821-liver-pate-ddmfs-step-2-4x3-bbf75330b7c5400893049bcc4654f619.jpg"
      ],
      "image": "assets/images/14821/step_02.webp"
    },
    {
      "text": "Reduce heat to low, cover, and simmer until liver is tender, about 20 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uE-KJD2mfJPaibUjJ1FJASAem_c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14821-liver-pate-ddmfs-step-3-4x3-5759f585c0164a9690cc83e403f2dcb6.jpg"
      ],
      "image": "assets/images/14821/step_03.webp"
    },
    {
      "text": "Remove from heat and drain. Discard sliced onion, and remove and discard any hard portions of the livers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UhIRQPhizVK7TPsPs2yfooOBT2o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14821-liver-pate-ddmfs-step-4-4x3-ee5c1a20745641ebaf1cb39156522638.jpg"
      ],
      "image": "assets/images/14821/step_04.webp"
    },
    {
      "text": "Process cooked livers in a food processor until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0VbSg63PXZtvfwuvdf2TriwaGCc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14821-liver-pate-ddmfs-step-5-4x3-dbd55cceca9544e395bf258d8dc7d008.jpg"
      ],
      "image": "assets/images/14821/step_05.webp"
    },
    {
      "text": "Add butter, chopped onion, sherry, butter, salt, pepper, and mace; pulse to blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HTomatUsKi8lCFPvR-AvuzXx2Ak=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14821-liver-pate-ddmfs-step-6-4x3-bf876d4a41f24e27a6628350a2f34a21.jpg"
      ],
      "image": "assets/images/14821/step_06.webp"
    },
    {
      "text": "Form mixture into a mound with lightly greased hands. Place onto a serving platter; cover and chill for 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uqvk31DPrPB8GlkWNSjrHAqgWiw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14821-liver-pate-ddmfs-step-8-4x3-5222385a2b894733a9ca21736897ee5c.jpg"
      ],
      "image": "assets/images/14821/step_07.webp"
    }
  ],
