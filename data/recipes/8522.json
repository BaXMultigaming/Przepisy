  "ingredients": [
    "4 teaspoons olive oil",
    "2 cups fresh sliced mushrooms",
    "2 cups cooked white rice",
    "1 (16 ounce) jar salsa",
    "8 ounces boneless chicken breast halves, cooked and diced",
    "4 ounces shredded Cheddar cheese",
    "6 tablespoons sour cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat. Add mushrooms; cook and stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mushrooms, rice, salsa, chicken, Cheddar cheese, and sour cream in a bowl; transfer to a greased casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 35 minutes.",
      "section": null,
      "name": null,
