  "ingredients": [
    "0.5 cup butter",
    "1 cup all-purpose flour",
    "0.75 cup white sugar",
    "0.75 cup milk",
    "2 teaspoons baking powder",
    "4 cups fresh blackberries",
    "0.5 cup seedless blackberry jam"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put butter in a 9x13-inch baking dish; place in the oven until butter melts, about 5 minutes. Whisk flour, sugar, milk, and baking powder together in a large bowl until smooth; pour over melted butter without stirring.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir fresh blackberries and blackberry jam together in a separate bowl; spoon mixture and any accumulated juices evenly over batter in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until blackberries are bubbling and cobbler is set, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
