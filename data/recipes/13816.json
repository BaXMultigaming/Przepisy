  "ingredients": [
    "1 (6 ounce) package strawberry flavored Jell-O®",
    "0.5 cup wine",
    "1 (19 ounce) can fruit cocktail, drained",
    "16 ounces sponge cake, cut in cubes",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "1 (8 ounce) container frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "In a large glass bowl, combine the gelatin and 2 cups boiling water. Mix until dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the wine, reserved fruit cocktail syrup and enough cold water to equal 1 3/4 cups. Add to gelatin and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cubed cake and fruit to mixture; stir and refrigerate 4 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare custard according to packaging to equal 2 cups. Pour over gelatin mixture and refrigerate. Top with whipped topping before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
