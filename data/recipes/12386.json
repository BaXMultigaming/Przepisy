      "image_sources": [
        "https://www.allrecipes.com/thmb/8Z69Fj8JmNkzutN-fJ4IvwpR3Ys=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12386-QuickandEasyPeachCobbler-mfs-step4-0105-2c510cd424754c8295bb18be557da48e.jpg"
      ],
      "image": "assets/images/12386/step_03.webp"
    },
    {
      "text": "Carefully pour peaches and syrup into the skillet; spread peaches evenly around the skillet using a spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tDNvL_OvjauzK5I5pWrJZMaCySo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12386-QuickandEasyPeachCobbler-mfs-step5-0107-d4ef3d7d1ea94c1ab4bba385bb16d5ed.jpg"
      ],
      "image": "assets/images/12386/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until the crust turns golden brown, 30 to 45 minutes.",
      "section": null,
