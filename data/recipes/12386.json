  "ingredients": [
    "0.5 cup unsalted butter, melted",
    "1 cup self-rising flour",
    "1 cup white sugar",
    "1 cup milk",
    "2 (16 ounce) cans sliced peaches in heavy syrup"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
