  "ingredients": [
    "2 cups turkey drippings, or as needed",
    "0.25 cup all-purpose flour",
    "1 cup chicken broth, or more as needed",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Separate oil from liquid in turkey drippings by pouring drippings into a clear 4-cup measuring cup; allow drippings to settle and separate into oil on top and juices on the bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WR9AoHaEmTIApvfmfbDY4u56P2I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255731-homemade-turkey-gravy-VAT-step-01-770f8c1b7d8048bba15d6635a48cb119.jpg"
      ],
      "image": "assets/images/255731/step_01.webp"
    },
    {
      "text": "Transfer ¼ cup oil to a saucepan using a kitchen syringe or baster.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JTVNXjXPzxisjwFrblrUtNKwGE4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255731-homemade-turkey-gravy-VAT-step-02-a05d4eb0b88b4d6696a3a89a4f0f7f55.jpg"
      ],
      "image": "assets/images/255731/step_02.webp"
    },
    {
      "text": "Stir flour into oil in the saucepan; cook and stir over medium-low heat until color changes to a light brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fGCpBcH5oLSPCg1Uqvvi947Q404=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255731-homemade-turkey-gravy-VAT-step-03-00b9e398ef294d6ea8efe30dabfc3873.jpg"
      ],
      "image": "assets/images/255731/step_03.webp"
    },
    {
      "text": "Stir 1 cup juice from drippings in the measuring cup into flour mixture (roux); cook and stir, adding more drippings for a thinner gravy, until gravy is heated through and smooth, about 5 minutes. Stir chicken broth into gravy; cook and stir until heated through, adding more broth for a thinner gravy, about 5 minutes.",
      "section": null,
