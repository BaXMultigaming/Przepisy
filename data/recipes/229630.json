  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter",
    "1 egg",
    "1 cup sour cream",
    "1 teaspoon vanilla extract",
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "2 (8 ounce) packages cream cheese, softened",
    "0.5 cup white sugar",
    "1 egg",
    "0.5 cup chopped pecans",
    "0.5 cup brown sugar",
    "0.33333334326744 cup all-purpose flour",
