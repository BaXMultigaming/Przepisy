  "ingredients": [
    "0.5 cup cinnamon red hot candies",
    "1 cup water",
    "1 (3 ounce) package cherry-flavored gelatin (such as JELL-O®)",
    "2 cups applesauce"
  ],
  "steps": [
    {
      "text": "Dissolve cinnamon candies in water in a saucepan over medium heat. Mix in gelatin and allow to dissolve; remove from heat and stir applesauce into mixture. Pour into a serving dish and refrigerate until set, about 2 hours.",
