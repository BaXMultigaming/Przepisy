  "ingredients": [
    "0.33333298563957 cup butter, softened",
    "0.5 cup packed brown sugar",
    "0.75 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 cup buttermilk",
    "1.5 cups mini semi-sweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a medium cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter or margarine, brown sugar and sugar in a large mixer bowl until light and fluffy. Add egg and vanilla; beat well. In a separate bowl, combine flour, baking soda, baking powder and salt; add alternately with buttermilk to creamed mixture. Beat well. Stir in chips. Drop by rounded teaspoons onto the prepared cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10-12 minutes in the preheated oven, or until lightly browned. Remove from cookie sheet and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
