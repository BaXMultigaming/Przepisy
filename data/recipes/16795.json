  "ingredients": [
    "1 tablespoon olive oil",
    "2 cloves garlic, chopped",
    "5 tomatoes, peeled and finely chopped",
    "1 teaspoon white sugar",
    "0.25 cup water",
    "2 teaspoons chopped fresh basil",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a large skillet, heat oil and saute garlic until light brown and softened. Be careful not to burn the garlic. Stir in tomatoes, sugar, water, basil, and salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring contents of the pan to a boil. Cover and simmer on low heat for approximately 45 minutes, stirring occasionally. Serve warm.",
