  "title": "Greek Fried Wontons",
  "description": "Wonton wrappers are stuffed with chicken, feta cheese, and tzatziki sauce and deep-fried in this savory Greek-inspired appetizer recipe.",
  "authors": [
    "william porter"
  ],
  "date_published": "2019-04-04T00:09:11-04:00",
