  "ingredients": [
    "4 cups peeled, cubed sweet potatoes",
    "2 large eggs, beaten",
    "0.5 cup white sugar",
    "0.5 cup milk",
    "4 tablespoons butter, softened",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "0.5 cup packed brown sugar",
    "0.33333334326744 cup all-purpose flour",
    "3 tablespoons butter, softened",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HtRs9a3yoWgq32VOFSbpGKWPzfI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21261-yummy-sweet-potato-casserole-DDMFS-Step-1-f6a52885d00c4c1aa2962b817f08b526.jpg"
      ],
      "image": "assets/images/21261/step_01.webp"
    },
    {
      "text": "Put sweet potatoes in a medium saucepan; cover with water. Cook over medium-high heat until tender, 10 to 15 minutes. Drain and transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2QZQOCQ6dPNiEL2CoZ3-MR14hkk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21261-yummy-sweet-potato-casserole-step-02-0ea21f68af4248c8bd3d7eb081a6fa32.jpg"
      ],
      "image": "assets/images/21261/step_02.webp"
    },
    {
      "text": "Mash sweet potatoes with a fork. Add eggs; mix until well combined. Add sugar, milk, butter, vanilla extract, and salt; mix until smooth. Transfer to a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HCTgsURCsvVDuokUVjoDzCyCoCM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21261-yummy-sweet-potato-casserole-step-04-a0fd16b6721f4e1ca05a697f8d7e0d9f.jpg"
      ],
      "image": "assets/images/21261/step_03.webp"
    },
    {
      "text": "Mix brown sugar and flour together in a medium bowl. Cut in butter with a pastry cutter until mixture resembles coarse crumbs; don't overmix. Stir in pecans. Sprinkle topping over sweet potato mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0RBo6I1kgQoJ9KfA6UKlwEbSB-0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21261-yummy-sweet-potato-casserole-step-10-201049e5f26a4717a001c9580ef17218.jpg"
      ],
      "image": "assets/images/21261/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until topping is lightly browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Oo8S6izwWXBgkcjBYgjv9L4UZWk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21261-yummy-sweet-potato-casserole-step-12-f388dea19dc94cb995b79745bf390113.jpg"
      ],
      "image": "assets/images/21261/step_05.webp"
    }
  ],
