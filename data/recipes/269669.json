  "ingredients": [
    "cooking spray",
    "1 tablespoon olive oil",
    "1 onion, diced",
    "1 clove garlic, minced",
    "1 cup frozen spinach",
    "1 pound lean ground turkey",
    "0.33333334326744 cup pesto",
    "2 egg whites",
    "1.5 (1 ounce) packets plain instant oatmeal",
    "0.25 cup grated Parmesan cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a large baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat. Add onion and garlic; cook and stir until browned, about 5 minutes. Add spinach; mix until fully cooked, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the meantime, combine turkey, pesto, egg whites, oatmeal, Parmesan cheese, salt, and pepper in a large mixing bowl. Add onion-spinach mixture and mix well. Shape mixture into balls using an ice cream scoop. Place in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
