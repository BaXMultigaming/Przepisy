  "ingredients": [
    "2 pounds beef chuck roast, cut into 1/2-inch thick strips",
    "salt and pepper to taste",
    "1 tablespoon vegetable oil",
    "8 ounces sliced mushrooms",
    "0.5 medium onion, sliced or diced",
    "1 tablespoon butter",
    "2 cloves garlic, minced",
    "1.5 tablespoons all-purpose flour",
    "0.5 cup white wine",
    "2 cups beef broth, divided",
    "0.75 cup creme fraiche",
    "1 tablespoon fresh chopped chives",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Season beef generously with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over high heat until nearly smoking. Stir in beef; cook, stirring constantly, for 6 to 7 minutes, until liquid evaporates and meat browns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TGhb4KyKwnOlZzcKSo3OLR2NUH4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220059-ChefJohnsClassicBeefStroganoff-mfs-Step1-0006-4cb28fb2bb6b4edaa4f938489bc2907f.jpg"
      ],
      "image": "assets/images/220059/step_02.webp"
    },
    {
      "text": "Remove meat from the pan and set aside. Stir mushrooms, onions, and butter into the pan; cook and stir over medium heat until vegetables are lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aOPFrN4y3-e9STpN48gf0_LJYPQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220059-ChefJohnsClassicBeefStroganoff-mfs-Step2-0011-825610ce99bf4534ad84b204c44dbb8f.jpg"
      ],
      "image": "assets/images/220059/step_03.webp"
    },
    {
      "text": "Add garlic and stir for 30 seconds. Stir in flour; cook for 1 to 2 minutes until incorporated. Stir in wine and 1 cup of broth, scraping the bottom of the pan to release any browned bits. Bring to a simmer and cook until the sauce thickens, about 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ye7Ww4m8ehtSdCvVzGxIHnG7C9Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220059-ChefJohnsClassicBeefStroganoff-mfs-Step3-0018-26c8c79c459b473a86c57325364b417e.jpg"
      ],
      "image": "assets/images/220059/step_04.webp"
    },
    {
      "text": "Return beef to the pan. Stir in remaining cup of broth; bring to a simmer and cook on low heat for about 1 hour, covered, until beef is tender and sauce is thick. Stir every 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in crème fraîche. Stir in chives. Season with salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GY-YDXJ_yoDMA13uMDzchbbNiHQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220059-ChefJohnsClassicBeefStroganoff-mfs-Step4-0022-5f0256fae7b744a99f9a245b1febb31b.jpg"
      ],
      "image": "assets/images/220059/step_06.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ql4hTdhKYV1eifgS3nShSdSk63I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220059-ChefJohnsClassicBeefStroganoff-mfs-2X3-0032-ee04ff133b334abd98040199454a137a.jpg"
      ],
      "image": "assets/images/220059/step_07.webp"
    }
  ],
