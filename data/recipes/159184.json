  "ingredients": [
    "4 eggs",
    "1 (16 ounce) container sour cream",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "1 cup shredded Cheddar cheese",
    "0.5 cup crumbled feta cheese",
    "0.5 cup shredded Parmesan cheese",
    "0.5 cup chopped onion",
    "0.5 cup chopped tomato",
    "1 (4 ounce) can canned chopped green chiles, drained",
    "1 teaspoon minced garlic",
    "1 teaspoon ground cumin",
    "1 tablespoon paprika",
    "0.25 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 325 degrees F (165 degrees C). Grease a 9 inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl. Whisk in the sour cream; mix until smooth. Mix in the spinach, Cheddar cheese, feta cheese, Parmesan cheese, onion, tomato, green chiles, garlic, cumin, paprika, and cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the egg mixture into the prepared pie plate. Set pie plate on a baking sheet. Bake quiche until a knife inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
