  "ingredients": [
    "1.75 cups all-purpose flour",
    "1 tablespoon baking powder",
    "0.25 teaspoon salt",
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "2 eggs",
    "1 cup milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, baking powder, and salt in a medium bowl until well combined; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together sugar and butter with an electric mixer in a large bowl until smooth. Add 1 egg and blend until incorporated. Add milk, remaining egg, and vanilla and beat until well combined. Mix in flour mixture until just incorporated. Divide batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and the tops spring back when lightly pressed, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
