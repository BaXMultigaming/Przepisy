  "title": "French Crêpes",
  "description": "These French crêpes are thin, delicate, and delicious for breakfast or dessert. Fill as you like with fresh berries, jam, or chocolate spread.",
  "authors": [
    "CYBERCHEF"
  ],
  "date_published": "2000-07-08T12:28:42-04:00",
