  "keywords": [],
  "ingredients": [
    "1 cup all-purpose flour",
    "1 teaspoon white sugar",
    "0.25 teaspoon salt",
    "3 eggs",
    "2 cups milk",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IKwPgLVyQncPNfFZW9GC-BH4RoA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20931-french-crepes-DDMFS-step01-5509c22f743943589ce39e5598f0b6f9.jpg"
      ],
      "image": "assets/images/20931/step_01.webp"
    },
    {
      "text": "Sift flour, sugar, and salt into a bowl; set aside. Beat eggs and milk together in a large bowl with an electric mixer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FbgJz4zsg41WgHEPBFFiASe9Lh0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20931-french-crepes-DDMFS-step03-511cd5fe5e9c47579835d7c798c05ce0.jpg"
      ],
      "image": "assets/images/20931/step_02.webp"
    },
    {
      "text": "Beat in flour mixture until smooth; stir in melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NIpuAhSAzVs-HZAcm6IH23L_xcg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20931-french-crepes-DDMFS-step05-ffde4a65de334a63acc27c6c78f1d1fe.jpg"
      ],
      "image": "assets/images/20931/step_03.webp"
    },
    {
      "text": "Lightly grease a griddle or frying pan; heat over medium-high heat. Pour or scoop the batter onto the griddle, using approximately 2 tablespoons for each crêpe.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uBUo3h0yGYirNCPWRBUxfLsAUKo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20931-french-crepes-DDMFS-step06-b4bb653cd79c4f4b830b76523f11c9f3.jpg"
      ],
      "image": "assets/images/20931/step_04.webp"
    },
    {
      "text": "Immediately rotate the skillet to spread batter out in a thin layer. Cook until the top of the crêpe is no longer wet and the bottom has turned light brown, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zW4OrbelzsDigj_pmym2PhpmLT0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20931-french-crepes-DDMFS-step07-5192ffea01a244bc9f63ee79a511a3b3.jpg"
      ],
      "image": "assets/images/20931/step_05.webp"
    },
    {
      "text": "Shake the pan or loosen with a spatula; turn or flip it over and cook until other side has turned light brown, about 1 minute more. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1bIJOghQoHVXcUwIWuwvUiUL8lI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20931-french-crepes-DDMFS-step08-7d8a2a78f1dc404a82701d2e668fd1be.jpg"
      ],
      "image": "assets/images/20931/step_06.webp"
    },
    {
      "text": "Serve with your choice of fillings or toppings, and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6uq9V4KAgdaAwWeok2SBTMAW-C4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20931-french-crepes-DDMFS-4x3-490f1c34813544df81e495e4fc08a52b.jpg"
      ],
      "image": "assets/images/20931/step_07.webp"
    }
  ],
