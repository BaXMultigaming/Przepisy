    "Indian"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 cup whole wheat flour",
    "1 cup all-purpose flour",
    "1 teaspoon salt",
    "0.75 cup hot water or as needed",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LH94RcxvxY6X-ej3ulL9hz_35r4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-85469-indian-chapati-bread-DDMFS-4x3-step-01-209484b0571246829e669eb18ca8c697.jpg"
      ],
      "image": "assets/images/85469/step_01.webp"
    },
    {
      "text": "Mix whole wheat flour, all-purpose flour, and salt in a large bowl. Use a wooden spoon to stir in water and oil. Mix until a soft, elastic dough forms and add more water, if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/L38fSexEIj_Q0yRrLPELuwwIF6c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-85469-indian-chapati-bread-DDMFS-4x3-step-02-0aea663b16e842dfa274b22d76e075a6.jpg"
      ],
      "image": "assets/images/85469/step_02.webp"
    },
    {
      "text": "Knead dough on a lightly floured surface until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SxDm6-5raoOmu8TrWNto27wyTBo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-85469-indian-chapati-bread-DDMFS-4x3-step-03-45e5fd50112c4a4f9de0185d55089854.jpg"
      ],
      "image": "assets/images/85469/step_03.webp"
    },
    {
      "text": "Divide dough into 10 equal portions, or less if you want larger chapatis. Roll each piece into a ball and let rest for a few minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_zAAeaM4FdIDyJ0PzCroPx0Krxs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-85469-indian-chapati-bread-DDMFS-4x3-step-04-071d35fc51fd480785b77dfa9fc25c13.jpg"
      ],
      "image": "assets/images/85469/step_04.webp"
    },
    {
      "text": "Heat a lightly greased skillet over medium heat. Use a rolling pin to roll dough balls out on a lightly floured surface until very thin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ANoc8LTfRUSb_-es7r_hrr26cbM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-85469-indian-chapati-bread-DDMFS-4x3-step-05-b91fa1029f474051b391395e6f841722.jpg"
      ],
      "image": "assets/images/85469/step_05.webp"
    },
    {
      "text": "When the skillet starts to smoke, place a chapati in it. Cook until bottom has brown spots, about 30 seconds, then flip and cook 30 seconds more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MCrP2D5rA0wRRAeQOXilTfF3xK8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-85469-indian-chapati-bread-DDMFS-4x3-step-06-f293888eeea4424dbd55b82c180a926c.jpg"
      ],
      "image": "assets/images/85469/step_06.webp"
    },
    {
      "text": "Repeat to cook remaining chapatis.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qgfQljqLcHe4Zr_SMWzsB2Gd6E8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-85469-indian-chapati-bread-DDMFS-4x3-d2692c11f56b4546b35dccd42ace1958.jpg"
      ],
      "image": "assets/images/85469/step_07.webp"
    }
  ],
