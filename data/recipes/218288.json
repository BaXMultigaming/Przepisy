  "ingredients": [
    "1 tablespoon unsalted butter",
    "6 cloves garlic, thinly sliced",
    "2 (10 ounce) bags fresh spinach",
    "0.5 medium lemon, juiced",
    "0.5 teaspoon garlic salt, or to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a pot over medium heat. Add garlic; cook and stir until fragrant, about 2 minutes. Add spinach, a few handfuls at a time, stirring until wilted before adding more. Stir in lemon juice and season with garlic salt.",
