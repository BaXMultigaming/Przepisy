  "ingredients": [
    "4 russet potatoes, sliced into 1/4 inch slices",
    "1 onion, sliced into rings",
    "salt and ground black pepper to taste",
    "3 tablespoons butter",
    "0.25 cup all-purpose flour",
    "0.5 teaspoon salt",
    "2 cups low-fat (1%) milk",
    "1.5 cups shredded reduced-fat Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly butter a 1-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer half the potatoes into the bottom of prepared baking dish. Top with onion slices and add remaining potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7l16FjsWMqZiaJHFNSNR3nthpvk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219443-healthier-creamy-au-gratin-potatoes-ddmfs-step1-240-4a7c7b3c47a4467f8eb4124c7b5e804d.jpg"
      ],
      "image": "assets/images/219443/step_02.webp"
    },
    {
      "text": "Season potatoes with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ainOT8Mj4BSPzTlzM2nTbrq69Z8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219443-healthier-creamy-au-gratin-potatoes-ddmfs-step2-244-32bd7a8c07de4499aefd3f1282daffbe.jpg"
      ],
      "image": "assets/images/219443/step_03.webp"
    },
    {
      "text": "Melt butter over medium heat in a saucepan. Mix in flour and salt, stirring constantly with a whisk, for one minute. Stir in milk. Cook until mixture has thickened. Add Cheddar cheese and continue stirring until melted, 30 to 60 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rTQ5Pk-dcXW1VpXsDWXS8MDPEBY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219443-healthier-creamy-au-gratin-potatoes-ddmfs-step3-246-5853c9cde6a34a60a1f479d3cec6eee2.jpg"
      ],
      "image": "assets/images/219443/step_04.webp"
    },
    {
      "text": "Pour cheese sauce over potatoes and cover dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RIyHDSpBmyLPNSU8qTHhTm0hj7w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219443-healthier-creamy-au-gratin-potatoes-ddmfs-step4-0843-b96fca94c1fb4918b0f36eefd77a9443.jpg"
      ],
      "image": "assets/images/219443/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese sauce is bubbling and potatoes are tender, about 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
