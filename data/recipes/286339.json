  "ingredients": [
    "5 slices bacon",
    "1 head broccoli, cut into bite-size pieces",
    "0.5 cup grated sharp Cheddar cheese",
    "0.25 cup chopped green onions",
    "3 tablespoons sunflower seeds",
    "0.5 cup mayonnaise",
    "0.25 cup low-calorie natural sweetener (such as Swerve®)",
    "3 tablespoons apple cider vinegar"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Crumble once cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bacon, broccoli, Cheddar cheese, green onions, and sunflower seeds in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mayonnaise, sweetener, and apple cider vinegar together in a small bowl. Pour dressing over broccoli mixture and toss until well combined.",
      "section": null,
