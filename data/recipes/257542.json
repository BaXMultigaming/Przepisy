  "ingredients": [
    "1 teaspoon olive oil",
    "0.25 cup water",
    "2 tablespoons soy flour",
    "0.33333334326744 cup plain bread crumbs",
    "1 teaspoon herbes de Provence",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon salt",
    "ground black pepper to taste",
    "1 dash cayenne pepper",
    "2 zucchinis, quartered and cut into spears",
    "1 tablespoon vegan mayonnaise",
    "1 tablespoon ketchup"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spread olive oil on a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix water and soy flour together in a bowl to form a thick, pancake-like batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir bread crumbs, herbes de Provence, garlic powder, salt, pepper, and cayenne pepper together on a shallow plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip zucchini spears into the batter. Roll in bread crumb mixture to coat. Place spears cut-side down on the prepared baking sheet, all facing the same direction.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden, about 10 minutes. Turn to other cut side and bake for 10 minutes. Turn spears so they are skin-side down; continue baking until browned, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer zucchini spears to a platter. Serve with vegan mayonnaise and ketchup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
