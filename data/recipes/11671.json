  "ingredients": [
    "1.5 pounds cooked fresh shrimp",
    "6 tablespoons butter",
    "1 tablespoon minced garlic",
    "1 cup heavy whipping cream",
    "0.5 cup chopped parsley",
    "3 tablespoons chopped fresh basil",
    "0.5 teaspoon dried thyme",
    "0.75 cup grated Parmesan cheese",
    "salt to taste",
    "ground black pepper to taste",
    "1 (16 ounce) package linguini pasta"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, about 11 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a large skillet over medium heat. Add garlic, and sauté briefly to release flavor. Add cream; heat just to boiling, stirring frequently. Reduce heat to low; stir in shrimp, parsley, basil, and thyme. Continue cooking until shrimp are just heated through; remove sauce from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta and toss lightly with cream sauce. Add Parmesan cheese, salt, and pepper to taste; toss again and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
