  "ingredients": [
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.25 cups white sugar, divided, or more to taste",
    "0.75 cup unsalted butter, softened",
    "2 tablespoons grated fresh ginger",
    "0.25 cup molasses",
    "1 large egg"
  ],
  "steps": [
    {
      "text": "Combine flour, baking soda, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 cup sugar, butter, and ginger in a large bowl with an electric mixer until light and fluffy. Beat in molasses and egg. Gently fold in flour mixture until just combined. Chill for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll chilled dough into 1 1/2 inch balls. Roll balls in remaining sugar, then place 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until mostly (but not fully) set in the centers and edges are starting to brown, about 15 minutes. Let stand for 1 minute on the baking sheets, then remove to wire racks and let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
