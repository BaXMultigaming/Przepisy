  "ingredients": [
    "0.33333334326744 cup tightly packed brown sugar",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "1.5 tablespoons butter, cut into small pieces",
    "2 cups peeled and finely chopped apples",
    "1 teaspoon fresh lemon juice",
    "0.75 cup white sugar",
    "0.5 cup honey",
    "0.5 cup buttermilk",
    "0.5 cup oil",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "1 cup quick-cooking oats",
    "2 cups whole wheat flour",
    "2.5 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon nutmeg",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 18 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, all-purpose flour, and 1/2 teaspoon cinnamon in a small bowl; press in butter using the back of a spoon or your fingers until crumbly. Set topping aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss apples with lemon juice in a large bowl. Stir in white sugar, honey, buttermilk, oil, eggs, and vanilla until combined. Fold in oats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine whole wheat flour, baking powder, 2 teaspoons cinnamon, baking soda, nutmeg, and salt in a small bowl; gently fold into apple-buttermilk mixture until just combined. Divide batter among the prepared muffin cups; top with crumb topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 20 to 25 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
