  "ingredients": [
    "1 (10 ounce) package frozen chopped spinach, thawed, well drained",
    "1.25 cups KRAFT Shredded Low-Moisture Whole Milk Mozzarella Cheese, divided",
    "4 ounces PHILADELPHIA Cream Cheese, softened",
    "0.25 cup KRAFT Grated Parmesan Cheese",
    "6 lasagna noodles, cooked, drained",
    "2 cups spaghetti sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together spinach, 1 cup mozzarella cheese, cream cheese, and Parmesan cheese in a large bowl until well blended; spread onto noodles and roll up tightly. Place rolls, seam-side down, in a 9-inch square baking dish. Top with sauce and remaining 1/4 cup mozzarella.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through, about 30 minutes.",
