  "ingredients": [
    "3.5 cups all-purpose flour",
    "2.25 cups white sugar",
    "2 cups pumpkin puree",
    "0.25 cup vegetable oil",
    "2 eggs",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon dried orange peel",
    "2 cups white chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, pumpkin puree, oil, eggs, baking powder, baking soda, cinnamon, vanilla extract, cloves, nutmeg, and orange peel together in a bowl until dough is evenly mixed and sticky; fold in white chocolate chips. Drop dough, about 2 tablespoons per cookie, onto a baking sheet about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
