  "ingredients": [
    "12 eggs",
    "1 (15 ounce) can HORMEL® Mary Kitchen® Corned Beef Hash",
    "1 tomato, diced",
    "0.5 cup diced green bell pepper",
    "0.5 cup diced fresh mushrooms",
    "2 tablespoons finely chopped green onion",
    "2 teaspoons salt",
    "0.25 teaspoon pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly oil a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly beat eggs in a large mixing bowl. Add corned beef hash and stir to break up chunks. Mix in tomato, green pepper, mushrooms, green onion, salt, and pepper. Transfer mixture to prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until veggies have softened and eggs are set, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let sit several minutes before cutting into squares and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
