  "ingredients": [
    "12 (3 inch) unbaked tart shells",
    "0.75 cup raisins",
    "0.25 cup butter, softened",
    "0.5 cup packed brown sugar",
    "0.5 cup maple syrup",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "1 egg, lightly beaten",
    "0.5 cup chopped walnuts, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place tart shells onto a baking sheet; sprinkle raisins evenly into the bottom of each shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk butter, brown sugar, maple syrup, vanilla, and salt together in a bowl. Whisk in egg, then pour mixture into tart shells and sprinkle walnuts over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pastry is light brown and filling is bubbly, about 12 minutes. Cool on a wire rack for about 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
