  "ingredients": [
    "2 tablespoons olive oil",
    "1 onion, chopped",
    "2 cloves garlic, minced",
    "2 cups peeled and chopped sweet potatoes",
    "3 cups chicken broth",
    "1 bay leaf",
    "1 teaspoon dried basil",
    "0.5 teaspoon dried thyme",
    "0.25 teaspoon paprika",
    "1 tomato, chopped",
    "1 (10 ounce) package frozen mixed vegetables",
    "1 (15 ounce) can garbanzo beans, drained",
    "salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a soup pot over medium heat. Add onion, garlic, and sweet potatoes; cook and stir until onion has softened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in broth, bay leaf, basil, thyme, and paprika. Bring to a boil, then reduce heat to medium low. Cover and simmer until sweet potatoes are tender but not mushy, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomato, frozen vegetables, and chickpeas. Season with salt and pepper to taste. Simmer uncovered until beans and chickpeas are tender, about 10 minutes more. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
