  "ingredients": [
    "cooking spray",
    "1 tablespoon butter",
    "1 medium onion, chopped",
    "2 cloves garlic, chopped",
    "2 cups chopped fresh broccoli",
    "1.5 cups heavy cream",
    "3 large eggs",
    "1 teaspoon salt",
    "0.5 teaspoon nutmeg",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon Italian seasoning",
    "1 (17.5 ounce) package frozen puff pastry, thawed",
    "1 tablespoon Dijon mustard",
    "1 (8 ounce) round Brie cheese, sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9-inch pie pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Add onion and cook until tender, about 5 minutes. Add garlic and cook until fragrant, about 1 minute. Mix in broccoli and cook until starting to soften, about 3 minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cream, eggs, salt, nutmeg, pepper, and Italian seasoning together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line the prepared pie pan with puff pastry, covering the base and sides. Trim excess pastry. Brush mustard over the bottom. Layer with broccoli mixture and Brie slices, then pour egg mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set in the middle and golden on top, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
