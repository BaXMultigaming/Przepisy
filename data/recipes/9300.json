  "ingredients": [
    "1 (12 ounce) package vanilla wafers",
    "2 (8 ounce) packages cream cheese",
    "0.75 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line miniature muffin tins (tassie pans) with miniature paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crush the vanilla wafers and place 1/2 tablespoon of the crushed vanilla wafers into the paper lined miniature muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together with an electric mixer the cream cheese, sugar, eggs and vanilla. Fill each miniature muffin liner with this mixture, almost to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 15 minutes. Cool and then top with a teaspoonful of cherry (or any other flavor) pie filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
