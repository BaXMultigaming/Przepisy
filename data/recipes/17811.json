  "ingredients": [
    "1 cup red wine",
    "0.5 cup butter",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon poultry seasoning",
    "1 pinch ground sage",
    "2 tablespoons fresh lemon juice",
    "4 drops hot pepper sauce"
  ],
  "steps": [
    {
      "text": "In a small saucepan over medium heat, combine the red wine, butter, garlic powder, poultry seasoning, sage, lemon juice and hot pepper sauce, if desired. Stir all together well and let simmer for about 10 minutes.",
