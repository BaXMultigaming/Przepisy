  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a 9-inch square baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk white wheat flour, baking soda, 1 teaspoon cinnamon, and salt together in a bowl. Beat 1/2 cup brown sugar, honey, and 1/4 cup butter together in another bowl with an electric mixer until creamy; beat in egg. Add sweet potato and vanilla extract to butter mixture and beat until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour mixture into sweet potato mixture until batter is evenly moistened and smooth. Pour batter into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all-purpose flour, 1/3 cup brown sugar, rolled oats, 1/4 cup butter, and 1 teaspoon cinnamon together in a bowl until combined. Sprinkle oats mixture over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
