  "ingredients": [
    "1 pound breakfast sausage",
    "11 large eggs",
    "0.75 cup milk",
    "2 cups shredded sharp Cheddar cheese",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "1 teaspoon dried oregano"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IYTZQ8qjpSqtOzx8N7qKq-X1Lvw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241924-spinach-sausage-and-egg-casserole-step-1-2379edeec9bd455a922cda1291807bd5.jpg"
      ],
      "image": "assets/images/241924/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H1-AdLzjBDO6IL8mNxuHKY-1ww4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241924-spinach-sausage-and-egg-casserole-step-2-c98a1032225843c8a64bea1ef9bacbf9.jpg"
      ],
      "image": "assets/images/241924/step_02.webp"
    },
    {
      "text": "Beat together eggs and milk in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M79K2F7-WB-K3ZKZ-TjVXifMnMQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241924-spinach-sausage-and-egg-casserole-step-3-13ec3cd564dc46b98ea79493966aa4f0.jpg"
      ],
      "image": "assets/images/241924/step_03.webp"
    },
    {
      "text": "Stir in cooked sausage, Cheddar cheese, spinach, and oregano until well combined; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xKCV6f9oIHoEoGjDxBduMohAF7M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241924-spinach-sausage-and-egg-casserole-step-5-f81bb863ed8b4eab8b07b62b577c48c9.jpg"
      ],
      "image": "assets/images/241924/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center of casserole comes out clean, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MNdplUkzCLj0s2sEp-xfSOvCAko=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241924-spinach-sausage-and-egg-casserole-step-6-2-d0412fd58a30410c8ef926a228f007f0.jpg"
