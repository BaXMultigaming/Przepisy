  "ingredients": [
    "1 tablespoon olive oil",
    "1.5 cups peeled and grated Granny Smith apple",
    "0.66666668653488 cup grated onion",
    "1 pound ground goose breast",
    "1 cup fresh bread crumbs",
    "2 egg whites",
    "1 tablespoon dried parsley",
    "2 teaspoons poultry seasoning",
    "0.5 teaspoon salt",
    "0.5 teaspoon dried sage",
    "0.5 teaspoon freshly ground black pepper",
    "0.25 teaspoon crushed red pepper flakes"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Cook apple and onion in the hot oil until soft, 10 to 15 minutes. Remove from heat and place into a mixing bowl. Let cool completely, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooled apple mixture, goose, bread crumbs, egg whites, parsley, poultry seasoning, salt, sage, black pepper, and red pepper flakes in the mixing bowl, stirring until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form sausage mixture into patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook sausage patties in the hot skillet until browned and no longer pink, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
