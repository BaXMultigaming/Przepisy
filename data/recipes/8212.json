  "ingredients": [
    "4 cups peeled, cored and chopped pears",
    "2 cups white sugar",
    "3 cups sifted all-purpose flour",
    "1 teaspoon salt",
    "1.5 teaspoons baking soda",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "4 egg whites",
    "0.66699999570847 cup canola oil",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/L1uaja0AoVbM_ZYGUff28zNu_wI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8212-fresh-pear-cake-VAT-step-01-ecfc089bae18401da7889368dc41f04d.jpg"
      ],
      "image": "assets/images/8212/step_01.webp"
    },
    {
      "text": "Combine pears and sugar in a large bowl; let stand for one hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Oq9duTywedWyrFdTLRHfmof5bWQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8212-fresh-pear-cake-VAT-step-02-1-e0db3f4ded194a9fb0f791f58d0c275c.jpg"
      ],
      "image": "assets/images/8212/step_02.webp"
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Generously spray a 10-inch Bundt pan with non-stick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cKLOtkukqWKWY3OnEfMEjHFVrXk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8212-fresh-pear-cake-VAT-step-03-079dab40270e45648eec2fb6782be629.jpg"
      ],
      "image": "assets/images/8212/step_03.webp"
    },
    {
      "text": "Beat egg whites until combined; mix in oil, chopped pecans, and pear mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6dUyAWSR6kfM7n7oDBTrWON2RFQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8212-fresh-pear-cake-VAT-step-04-fd8544e52af249d1b638d824ef101b3f.jpg"
      ],
      "image": "assets/images/8212/step_04.webp"
    },
    {
      "text": "Mix flour, salt, baking soda, nutmeg, cinnamon, and cloves together; stir into pear mixture. Pour cake batter into the prepared Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jUUcdrwm9VYezBaWTFzV5phuKhw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8212-fresh-pear-cake-VAT-step-05-fb803ea6584e44d38df09d90de5f2586.jpg"
      ],
      "image": "assets/images/8212/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 1 hour and 10 minutes. Let cool on a wire rack for 10 minutes before removing from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UfIxAqnIapsV6a_JghQof01pBWc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8212-fresh-pear-cake-VAT-step-06-e6ef1957bd334be8afcc8299bb5a846c.jpg"
      ],
      "image": "assets/images/8212/step_06.webp"
    },
    {
      "text": "Invert carefully onto a serving plate or rack and let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nuugksY1Lmsx_OaZbTNN_PGqAHE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8212-fresh-pear-cake-VAT-step-07-acb6c8ab51fa4821b97e643e049c17dc.jpg"
      ],
