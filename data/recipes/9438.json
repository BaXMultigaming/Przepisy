  "ingredients": [
    "2.25 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon ground nutmeg, or as needed",
    "0.5 teaspoon ground cinnamon",
    "1.25 cups white sugar",
    "0.75 cup butter, softened",
    "0.5 cup eggnog",
    "2 egg yolks",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P4dx4GipSQ5h8ZCtpRyWj8PNkh4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9438-eggnog-cookies-i-VAT-step-01-b3ac860169d64e938ce398c26bd2977d.jpg"
      ],
      "image": "assets/images/9438/step_01.webp"
    },
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Sift flour, baking powder, nutmeg, and cinnamon into a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xNJaJCbFySl86S-2gx4gxNYDGDQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9438-eggnog-cookies-i-VAT-step-02-5dde55a141fe436699fe07117a210572.jpg"
      ],
      "image": "assets/images/9438/step_02.webp"
    },
    {
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until light and fluffy. Add eggnog, egg yolks, and vanilla; beat at medium speed until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UvNEyx4dU1t2IZ3CG7sCgX0WPvo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9438-eggnog-cookies-i-VAT-step-03-390bdf0a0698454e927a507d1e715206.jpg"
      ],
      "image": "assets/images/9438/step_03.webp"
    },
    {
      "text": "Gradually beat in flour mixture at low speed until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KIIqMz-QHnTKbC3H5UTTabPvH4U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9438-eggnog-cookies-i-VAT-step-04-41748d2fb49b4712953317821e34386f.jpg"
      ],
      "image": "assets/images/9438/step_04.webp"
    },
    {
      "text": "Drop spoonfuls of dough 1 inch apart onto ungreased baking sheets; sprinkle lightly with nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-9lHLZHlpQI-VyI2YT_D8nmB4PU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9438-eggnog-cookies-i-VAT-step-05-0fc473faadf64d18950a3a3d2d51dc9b.jpg"
      ],
      "image": "assets/images/9438/step_05.webp"
    },
    {
      "text": "Bake cookies in the preheated oven until edges are golden, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_l9x8tDuCXxdkHq9e4a8Xz4xa1A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9438-eggnog-cookies-i-VAT-step-06-3b427b8577264a5f915f11b57dd78188.jpg"
      ],
      "image": "assets/images/9438/step_06.webp"
    },
    {
      "text": "Cool on the baking sheet briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e1hRCxL3qEK01m4-hdHlSg7P9is=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9438-eggnog-cookies-i-VAT-step-07-a4fbed18065543a7afc5ed9c9dbb4c48.jpg"
