  "ingredients": [
    "1.5 pounds pork tenderloin, cut into 2 inch strips",
    "1 small onion, coarsely chopped",
    "1 small red bell pepper, coarsely chopped",
    "3 (15 ounce) cans black beans",
    "1 (16 ounce) jar salsa",
    "0.5 cup chicken broth",
    "1 teaspoon dried oregano",
    "1 teaspoon ground cumin",
    "2 teaspoons chili powder"
  ],
  "steps": [
    {
      "text": "Combine pork tenderloin, onion, red pepper, black beans, salsa, chicken broth, oregano, cumin, and chili powder in a slow cooker. Set to Low and cook for 8 to 10 hours.",
