  "ingredients": [
    "1 (8 pound) ham",
    "20 cloves garlic, peeled",
    "10 whole cloves",
    "1 (6 ounce) can pineapple juice",
    "2 tablespoons brown sugar",
    "2 teaspoons dry mustard powder",
    "0.5 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat ham dry with paper towels; arrange ham cut-side down in a shallow roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut 20 slits all over ham with the point of a knife; stuff 1 garlic clove into each slit. Press whole cloves all over ham. Cover ham with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour and 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine pineapple juice, brown sugar, dry mustard, and ginger in a bowl. Remove foil from ham; pour pineapple juice glaze over ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue baking, uncovered, until glaze thickens, about 45 minutes more, basting ham every 15 minutes. Rest ham for 5 to 10 minutes; remove garlic and whole cloves before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
