  "ingredients": [
    "2 slices turkey bacon",
    "1 cooking spray",
    "1 large egg",
    "1 (6 inch) flour tortilla",
    "1 ounce honey-flavored goat cheese",
    "1 tablespoon chopped pitted Kalamata olives",
    "4 leaves baby spinach"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, 5 to 8 minutes. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While bacon cooks, spray a small skillet with cooking spray; warm over medium-high heat. Whisk egg in a bowl. Pour into the skillet; cook, stirring frequently, until scrambled and set, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat tortilla in a microwave until soft and pliable, about 15 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread goat cheese evenly over the tortilla. Layer olives, 1 slice of bacon, egg, spinach, and remaining bacon slice in the center of the tortilla. Wrap up and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
