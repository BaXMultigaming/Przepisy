  "ingredients": [
    "1 sheet heavy-duty aluminum foil, approximately 15 inches long",
    "1 serving cooking spray",
    "4 ounces cauliflower, cut into bite-sized pieces",
    "1 tablespoon salted butter",
    "1 small garlic, chopped",
    "0.25 teaspoon Italian seasoning"
  ],
  "steps": [
    {
      "text": "Preheat the grill to medium heat, about 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread out aluminum foil on a clean work surface, fold in half, and lightly grease one side with cooking spray. Scatter cauliflower pieces onto the foil and dot with butter. Sprinkle with garlic and Italian seasoning. Bring the sides of the foil up and fold twice. Roll the ends towards the centre and press down to seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill, turning occasionally, for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
