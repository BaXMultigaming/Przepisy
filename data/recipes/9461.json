  "ingredients": [
    "2 pounds white chocolate",
    "30 small peppermint candy canes"
  ],
  "steps": [
    {
      "text": "Line a large jellyroll pan with heavy-duty foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place white chocolate in a microwave-safe bowl. Microwave on medium power, stirring occasionally, until melted and smooth, 5 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place candy canes in a plastic bag or between 2 pieces of waxed paper. Using a mallet or rolling pin, break into small pieces. Stir candy pieces into melted white chocolate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread white chocolate mixture evenly in the prepared pan. Chill until set, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Break into pieces by slamming the pan on the counter.",
      "section": null,
      "name": null,
