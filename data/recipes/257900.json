  "ingredients": [
    "1 tablespoon minced garlic",
    "0.25 teaspoon ground cumin",
    "0.25 teaspoon ground coriander",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon salt, or to taste",
    "0.25 teaspoon ground black pepper, or to taste",
    "1 pound ground lamb",
    "8 small slider-size rolls, split",
    "1 cup baby spinach",
    "0.5 cup tzatziki sauce",
    "0.25 cup sliced red onion",
    "0.25 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill to medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix garlic, cumin, coriander, allspice, salt, and pepper together in a bowl; add lamb and mix well. Form mixture into 2-ounce patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill patties on the preheated grill until cooked through, 2 to 3 minutes per side. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Place rolls on the grill and heat until toasted, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer spinach, tzatziki sauce, lamb patty, red onion, and feta cheese in each roll, creating a slider.",
      "section": null,
