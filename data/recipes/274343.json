  "ingredients": [
    "1.25 cups white sugar",
    "1 stick butter",
    "1 teaspoon vanilla extract",
    "3 eggs",
    "1.6666667461395 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.125 teaspoon salt",
    "1.5 cups diced rhubarb",
    "1 apple, thinly sliced",
    "0.33333334326744 cup sliced almonds, or to taste",
    "1 pinch white sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9-inch round pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 1/4 cups sugar and butter together using an electric mixer until well blended, light, and fluffy. Add eggs, one at a time, followed by vanilla extract, mixing well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn mixer to low speed and slowly add in flour, baking powder, and salt, mixing just until combined. Fold in rhubarb.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared baking pan. Smooth the top and place apple slices in a circular pattern on batter. Sprinkle almonds and additional sugar on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 35 to 45 minutes. Let cool, and serve warm or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
