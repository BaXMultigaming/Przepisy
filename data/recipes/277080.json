  "ingredients": [
    "1 pound ground venison",
    "4 ounces bulk hot Italian sausage",
    "0.75 cup panko bread crumbs",
    "2 eggs",
    "1 teaspoon salt",
    "1 teaspoon Italian seasoning",
    "1 teaspoon crushed red pepper",
    "0.5 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil; place a rack on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground venison, Italian sausage, bread crumbs, eggs, salt, Italian seasoning, pepper flakes, and garlic powder in a large bowl; mix until well combined. Form venison mixture into 1 1/2-inch meatballs; place on the prepared rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked though, about 20 minutes. An instant-read thermometer inserted into centers should read at least 160 degrees F (70 degrees C). Rest for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
