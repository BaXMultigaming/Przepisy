  "ingredients": [
    "1.5 cups baby spinach leaves",
    "0.75 cup fresh basil leaves",
    "0.5 cup toasted pine nuts",
    "0.5 cup grated Parmesan cheese",
    "0.5 cup extra-virgin olive oil, divided",
    "4 cloves garlic, peeled and quartered",
    "1 tablespoon fresh lemon juice",
    "0.75 teaspoon kosher salt",
    "0.5 teaspoon lemon zest",
    "0.5 teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Place spinach, basil, pine nuts, Parmesan cheese, 2 tablespoons olive oil, garlic, lemon juice, salt, lemon zest, and pepper into a food processor; blend until nearly smooth, scraping the sides of the bowl with a spatula as necessary.",
