  "ingredients": [
    "1 (16 ounce) package elbow macaroni",
    "1 rotisserie-roasted chicken",
    "6 tablespoons butter",
    "6 tablespoons all-purpose flour",
    "3 cups milk",
    "1 pinch ground black pepper",
    "2 cups shredded Cheddar cheese",
    "2 cups shredded Monterey Jack cheese",
    "0.5 cup hot sauce (such as Frank's® Redhot®), or more to taste",
    "0.5 cup crumbled gorgonzola cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook macaroni in the boiling water, stirring occasionally until tender yet firm to the bite, about 8 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut wings and legs off rotisserie chicken. Remove skin and bones from wings and legs; chop or shred dark meat into bite-sized pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large Dutch oven over medium heat. Gradually whisk in flour until a thick paste forms. Cook until golden, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jTheAHXbc51Sp5niztYgt2Yq76A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245764-buffalo-chicken-mac-and-cheese-ddmfs-Step-002-1e7be69b2b9a4831b283e316520f92c7.jpg"
      ],
      "image": "assets/images/245764/step_03.webp"
    },
    {
      "text": "Pour in milk, whisking constantly, until thickened and bubbling, about 5 minutes. Continue to cook and stir until sauce is smooth, about 1 minute more. Reduce heat and season with pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ItBubd-3G4qwUPXsF-kVRSyYTBU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245764-buffalo-chicken-mac-and-cheese-ddmfs-Step-003-0d29da7861504b1093822eca2499c806.jpg"
      ],
      "image": "assets/images/245764/step_04.webp"
    },
    {
      "text": "Stir Cheddar and Monterey Jack into the sauce until melted and combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4rquG-nZKujULekBtKaMjs9M2R8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245764-buffalo-chicken-mac-and-cheese-ddmfs-Step-009-6a49ae95135743178230b7bc14c04d9f.jpg"
      ],
      "image": "assets/images/245764/step_05.webp"
    },
    {
      "text": "Stir in hot sauce to the desired level of spiciness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lm2682RZD2NPMWeNYfvZILkYK1o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245764-buffalo-chicken-mac-and-cheese-ddmfs-Step-013-9b08abff4ad542bb9af29df73f1fdd85.jpg"
      ],
      "image": "assets/images/245764/step_06.webp"
    },
    {
      "text": "Add Gorgonzola, chicken, and macaroni; mix well to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TA11_r3bodxfd-Op39kq6BWxf68=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245764-buffalo-chicken-mac-and-cheese-ddmfs-Step-016-59e9f027bd3245c29f602275f951d531.jpg"
      ],
      "image": "assets/images/245764/step_07.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kf8OA3fg1DbQiTPT3mBQq7TRzf8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245764-buffalo-chicken-mac-and-cheese-DDMFS-4x3-d254b531a4904717ae4e704f378d9261.jpg"
      ],
      "image": "assets/images/245764/step_08.webp"
    }
