  "ingredients": [
    "2 bunches kale, stemmed and finely chopped",
    "1 lemon, juiced",
    "2 ripe avocados, mashed",
    "1 pint grape tomatoes, quartered",
    "1 bunch green onions, sliced",
    "2 tablespoons olive oil",
    "6 cloves garlic, diced",
    "1 teaspoon salt",
    "0.5 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Combine kale and lemon juice in a bowl. Vigorously massage kale by squeezing handfuls for about 1 minute. Add avocados, tomatoes, and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together olive oil, garlic, salt, and cayenne pepper in a small bowl. Pour dressing over salad and mix well. Serve immediately.",
      "section": null,
