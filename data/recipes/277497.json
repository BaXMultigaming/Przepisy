  "ingredients": [
    "1 teaspoon butter, or as needed",
    "1 (16 ounce) package bacon",
    "1 (16 ounce) can refrigerated biscuit dough",
    "8 frozen hash brown patties, or to taste",
    "8 eggs",
    "0.75 cup milk",
    "2 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Butter a 9x13-inch baking dish and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until crispy but not fully browned, 6 to 8 minutes. Drain bacon slices on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice biscuits lengthwise and place on the bottom of the prepared baking dish, sealing the dough to cover the bottom completely. Top with hash brown patties. Layer bacon over hash browns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and milk together, then pour over the casserole. Top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is bubbling and bacon is crispy, 30 to 35 minutes. Let cool for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
