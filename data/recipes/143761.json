  "ingredients": [
    "4 Granny Smith apples - peeled, cored and sliced",
    "0.5 cup caramel ice cream topping",
    "1 tablespoon all-purpose flour",
    "1 (10 ounce) can refrigerated flaky biscuit dough",
    "2 tablespoons butter",
    "3 tablespoons white sugar",
    "0.75 cup sweetened flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together apples, caramel topping, and flour in a large round baking dish. Pull apart each biscuit into two halves, and arrange over the apples. Drizzle with butter. Stir together the sugar and coconut; sprinkle over the buttered biscuits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the biscuits have puffed, and are lightly browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
