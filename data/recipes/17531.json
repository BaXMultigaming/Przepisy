  "ingredients": [
    "0.25 cup olive oil",
    "1 tablespoon dried parsley",
    "2 tablespoons dried thyme",
    "1 tablespoon dried rosemary",
    "1 clove garlic, minced",
    "4 (6 ounce) fillets salmon",
    "1 lemon, juiced"
  ],
  "steps": [
    {
      "text": "Preheat grill for medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a shallow glass dish, mix the olive oil, parsley, thyme, rosemary, and garlic. Place the salmon in the dish, turning coat. Squeeze lemon juice over each fillet. Cover, and marinate in the refrigerator for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil grill grate. Transfer salmon to the grill, and discard any remaining marinade. Cook salmon on preheated grill over medium heat for 8 to 10 minutes, turning once. Fish is done when it flakes easily with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
