  "title": "Yum",
  "description": "Great golden brown soft cookies with chocolate and peanut butter chips. If you like, you can use white chocolate chips, too!",
  "authors": [
    "Ben"
  ],
  "date_published": "2000-02-27T19:04:58-05:00",
