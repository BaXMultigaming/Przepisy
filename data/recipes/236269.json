  "ingredients": [
    "0.25 cup water",
    "1 cup milk",
    "1 egg",
    "1 tablespoon vanilla extract",
    "3.3333330154419 cups bread flour",
    "0.25 cup sucralose and brown sugar blend (such as Splenda® brown sugar blend)",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "1 teaspoon cocoa powder (such as Hershey's®)",
    "1.5 teaspoons active dry yeast",
