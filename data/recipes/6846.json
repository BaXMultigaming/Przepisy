  "ingredients": [
    "vegetable oil cooking spray",
    "1.5 cups all-purpose flour, divided",
    "1 cup fresh blueberries",
    "1 egg white",
    "1 tablespoon vegetable oil",
    "0.5 cup skim milk",
    "2 tablespoons margarine, melted",
    "0.5 cup white sugar",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Use vegetable oil spray to grease a 12-cup muffin tin. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1/4 cup flour with blueberries and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white and vegetable oil lightly in a bowl. Stir in milk and melted margarine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together remaining 1 1/4 cups flour, sugar, baking powder, and salt in a separate bowl. Sift dry ingredient mixture over egg white mixture. Stir just long enough to moisten flour. The batter will look lumpy but do not overmix. Fold in blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each muffin tin 2/3 full with batter. Bake in the preheated oven until golden brown, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
