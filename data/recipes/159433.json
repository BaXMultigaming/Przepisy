  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lh4GhlqMqCt8T7N0pgrfZR4ON7Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-159433-baked-butternut-squash-ddmfs-step1-3x4-2398-e835c81754ee4f008ed11254626e70f4.jpg"
      ],
      "image": "assets/images/159433/step_01.webp"
    },
    {
      "text": "Place squash, cut-sides down, in a 9x13-inch baking dish. Pour 2 cups water into dish around squash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VjGdzQClDHYRPXnTzNBIUwp27XU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-159433-baked-butternut-squash-ddmfs-step3-3x4-2400-ff15343649e144c3afcd55c67c871e63.jpg"
      ],
      "image": "assets/images/159433/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until tender and easily pierced with a fork, about 1 ½ hours, adding more water as needed if pan looks dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uRQnj4dqNr5RbkExIADJJDxrI2M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-159433-baked-butternut-squash-ddmfs-step4-3x4-2462-fcae53df6b524e5aac7b7c27db475a67.jpg"
      ],
      "image": "assets/images/159433/step_03.webp"
    },
    {
      "text": "Remove from the oven; transfer each half to a plate, cut-side up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0LgKeyW9aINjTjyLBBUHEgeJu1c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-159433-baked-butternut-squash-ddmfs-step5-3x4-2465-4318003ca0a744e88fa35ed047dd0113.jpg"
      ],
      "image": "assets/images/159433/step_04.webp"
    },
    {
      "text": "Top each half with butter and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
