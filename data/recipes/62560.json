  "ingredients": [
    "2 tablespoons unsalted butter",
    "1 large zucchini, chopped",
    "1 large white onion, chopped",
    "4 tomatoes, chopped",
    "1 large green bell pepper, chopped",
    "dried Italian seasoning to taste",
    "1 (8 ounce) package shredded mozzarella cheese"
  ],
  "steps": [
    {
