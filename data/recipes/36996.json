  "ingredients": [
    "1 tablespoon lemon juice",
    "0.5 cup olive oil",
    "1 teaspoon salt",
    "1 teaspoon paprika",
    "0.125 teaspoon white pepper",
    "0.125 teaspoon garlic powder",
    "2 (10 ounce) rock lobster tails"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1m7KviYGYkG8GBdUCGwOdUxV-nk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/36996-Grilled-Rock-Lobsters-101-step1-2d5eda0f28fe4831b4efbca63fb44111.jpg"
      ],
      "image": "assets/images/36996/step_01.webp"
    },
    {
      "text": "Preheat the grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour lemon juice into a small bowl; slowly whisk in olive oil. Whisk in salt, paprika, white pepper, and garlic powder until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IFUeabtToCB3y5efBe4CG-nUAZQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/36996-Grilled-Rock-Lobsters-102-step2-baf38d50f3ed49908918393db60c4298.jpg"
      ],
      "image": "assets/images/36996/step_03.webp"
    },
    {
      "text": "Split lobster tails lengthwise with a large knife, then brush flesh with some marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q55vCr0yQk8JOEDLe3jJOQnOjqA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/36996-Grilled-Rock-Lobsters-103-step3-ff3979aa731e493c98aab1890fbaeb17.jpg"
      ],
      "image": "assets/images/36996/step_04.webp"
    },
    {
      "text": "Place lobster tails flesh-side down on the preheated grill and cook, turning once and basting frequently with marinade, until opaque and firm to the touch, about 5 minutes per side. Discard any remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/46pjTqnIhEFkqjoM_8TayM6gD8g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/36996-Grilled-Rock-Lobsters-105-step5-1bcd9842f47a471b92146d0d084ab2a1.jpg"
      ],
