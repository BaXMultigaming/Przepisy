  "ingredients": [
    "1 guava - peeled, seeded, and chopped",
    "1 (15 ounce) can tomato sauce",
    "1 (6 ounce) can tomato paste",
    "0.5 cup water",
    "0.25 cup brown sugar",
    "2 tablespoons liquid smoke flavoring",
    "2 tablespoons fresh lemon juice",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon habanero hot sauce",
    "1 teaspoon molasses",
    "1 tablespoon garlic powder",
    "1 tablespoon onion powder",
    "1 teaspoon salt",
    "0.5 teaspoon black pepper"
  ],
  "steps": [
    {
      "text": "In a large saucepan over low heat, stir together the guava, tomato sauce, tomato paste, water, and brown sugar until well blended. Stir in liquid smoke, fresh lemon juice, Worcestershire sauce, habanero sauce, and molasses. Season with garlic powder, onion powder, salt, and black pepper. Cover, and cook 30 minutes, stirring occasionally, until thickened.",
