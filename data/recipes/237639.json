  "ingredients": [
    "1 tablespoon butter",
    "2 cups uncooked long-grain white rice",
    "0.33333334326744 cup diced jalapeno pepper",
    "0.33333334326744 cup chopped green onion",
    "1 clove garlic, crushed",
    "1 teaspoon chili powder, or to taste",
    "1 teaspoon ground cumin",
    "0.5 teaspoon salt",
    "0.5 teaspoon chipotle chile powder, or to taste",
    "0.5 teaspoon cayenne pepper, or to taste",
    "2.25 cups chicken stock",
    "0.5 cup tomato sauce",
    "chopped green onion"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RoHbYebn_u7EQY6xjXPCyuH6IoA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237639-spicy-spanish-style-rice-VAT-step-01-c689636618b34f5ebb26400060403750.jpg"
      ],
      "image": "assets/images/237639/step_01.webp"
    },
    {
      "text": "Melt butter in a pot over medium-low heat. Stir rice, jalapeño, green onion, and garlic together in the melted butter until rice is completely coated with butter. Add chili powder, cumin, salt, chipotle chile powder, and cayenne pepper; cook and stir until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cMaar3L1zfER1nGEyMfHk389Auk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237639-spicy-spanish-style-rice-VAT-step-02-cadaa652b82048a79a5d095c53dc8727.jpg"
      ],
      "image": "assets/images/237639/step_02.webp"
    },
    {
      "text": "Stir chicken stock and tomato sauce into rice mixture. Bring to a simmer, cover the pot, reduce heat to low, and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l-PoWCgS00aExhr0HNsc5SvDz6c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237639-spicy-spanish-style-rice-VAT-step-03-d8910284a07243b5a7e9d3c66a67cde2.jpg"
      ],
      "image": "assets/images/237639/step_03.webp"
    },
    {
      "text": "Turn heat off and leave pot covered on the burner for 8 minutes. Remove cover and fluff rice with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kvsF21d3A-KtrKxw_OCOOrs3cYw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237639-spicy-spanish-style-rice-VAT-step-04-721dd59bbf134124ab4888fa0bf2a861.jpg"
      ],
      "image": "assets/images/237639/step_04.webp"
    },
    {
      "text": "Transfer rice to a platter and sprinkle chopped green onion on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X_SVA39nH1EWFRESF-LJ8ZdmQtY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237639-spicy-spanish-style-rice-VAT-Beauty-4x3-37453c39c31e4b9ea6c681b0af76745b.jpg"
