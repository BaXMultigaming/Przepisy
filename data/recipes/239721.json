  "ingredients": [
    "1 (18.4 ounce) package brownie mix (such as Pillsbury®)",
    "0.66666668653488 cup oil",
    "2 large eggs",
    "0.25 cup water",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup white sugar",
    "3 tablespoons butter, softened",
    "2 tablespoons all-purpose flour",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the brownie batter: Mix brownie mix, oil, eggs, and water together in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the cheesecake batter: Mix cream cheese, sugar, butter, flour, and vanilla together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon brownie batter into the prepared muffin cups, filling each 1/2 full. Top with cheesecake batter, then spoon brownie batter over top. Reserve any remaining brownie batter for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the brownie part comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
