  "title": "Czechoslovakian Cookies",
  "description": "These bar cookies are made with a not-too-sweet pecan shortbread spiced with cardamom, with a jam filling. Perfect for holidays or anytime baking.",
  "authors": [
    "Linda K"
  ],
  "date_published": "1999-04-04T10:49:53-04:00",
