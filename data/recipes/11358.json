  "ingredients": [
    "1 cup butter",
    "1 cup white sugar",
    "2 egg yolks",
    "1 teaspoon vanilla extract",
    "0.125 teaspoon ground cardamom",
    "0.25 teaspoon ground allspice",
    "2 cups all-purpose flour",
    "1 cup chopped pecans",
    "0.5 cup strawberry jam"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter until soft and fluffy. Add white sugar gradually, until light and fluffy. Beat in egg yolks and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift cardamom, allspice, and flour together. Gradually add to butter mixture and stir to combine well. Stir in chopped pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon half of the dough into the prepared pan, spreading evenly. Top with strawberry jam and cover with remaining dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 1 hour. Let cool, then cut into 1 ½-inch sized squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
