  "ingredients": [
    "1 tablespoon extra-virgin olive oil",
    "0.25 cup minced onion",
    "2 tablespoons minced red bell pepper",
    "2 tablespoons minced celery",
    "salt and pepper to taste",
    "1 tablespoon capers",
    "1.25 pounds fresh wild salmon, coarsely chopped",
    "0.25 cup mayonnaise",
    "0.25 cup panko bread crumbs",
    "2 cloves garlic, minced",
    "1 teaspoon Dijon mustard",
    "1 pinch cayenne pepper",
    "1 pinch seafood seasoning (such as Old Bay®)",
    "1 tablespoon panko bread crumbs, or to taste",
    "2 tablespoons olive oil, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IQzPSw3ZzfjBovr9HMQgZTt2CzU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239541-Chef-Johns-Fresh-Salmon-Cakes-DDMFS-Step-01a-b9dd5cae02b1444aaa5913a412892990.jpg"
      ],
      "image": "assets/images/239541/step_01.webp"
    },
    {
      "text": "Heat extra virgin olive oil in a skillet over medium heat. Cook and stir onion, red pepper, celery, and a pinch of salt in hot oil until onion is soft and translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Yrv6td2WkEVJ7C4yy36IYyFAzLA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239541-Chef-Johns-Fresh-Salmon-Cakes-DDMFS-Step-01b-2253c30227f741e49ed998ffbfbe545a.jpg"
      ],
      "image": "assets/images/239541/step_02.webp"
    },
    {
      "text": "Add capers; cook and stir until fragrant, about 2 minutes. Remove from heat and cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Dtw7Oq_Hpskj3g1HcagueL575g4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239541-Chef-Johns-Fresh-Salmon-Cakes-DDMFS-Step-02-e2a7c21ce4784594a30c51507b50e64c.jpg"
      ],
      "image": "assets/images/239541/step_03.webp"
    },
    {
      "text": "Stir salmon, onion mixture, mayonnaise, 1/4 cup bread crumbs, garlic, mustard, cayenne, seafood seasoning, salt, and ground black pepper together in a bowl until well-mixed. Cover the bowl with plastic wrap and refrigerate until firmed and chilled, 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d9IH2giL363oj47pOxpQf6KHlok=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239541-Chef-Johns-Fresh-Salmon-Cakes-DDMFS-Step-03-1a3e44bf14d54ceeafb79e423b5c7c07.jpg"
      ],
      "image": "assets/images/239541/step_04.webp"
    },
    {
      "text": "Form salmon mixture into four 1-inch thick patties; sprinkle remaining panko bread crumbs over each patty.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3q3LQwETAciGalesKhEmhjuqqyA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239541-Chef-Johns-Fresh-Salmon-Cakes-DDMFS-Step-05-edd6714bc1f04ea3aa9b511928e1fdf6.jpg"
      ],
      "image": "assets/images/239541/step_05.webp"
    },
    {
      "text": "Heat olive oil in a skillet over medium-heat. Cook patties in hot oil until golden and cooked through, 3 to 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4UyOiE8lSY-tO584DOtK5grbFmk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239541-Chef-Johns-Fresh-Salmon-Cakes-DDMFS-Step-06-5cd88d27aa0447e299b84f15bc218bde.jpg"
      ],
      "image": "assets/images/239541/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8kXGS_HDb5zZnc91-tZty2E63gI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239541-Chef-Johns-Fresh-Salmon-Cakes-DDMFS-4x3-e1b9020783344d21bb19efa8ffeead68.jpg"
      ],
      "image": "assets/images/239541/step_07.webp"
    }
