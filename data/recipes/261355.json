  "ingredients": [
    "2 large egg yolks",
    "0.25 cup heavy whipping cream",
    "2 tablespoons lemon juice",
    "1 teaspoon lemon zest, or to taste",
    "2 tablespoons butter",
    "1.5 cups uncooked jasmine rice",
    "3 cups chicken broth",
    "0.25 cup grated Parmesan cheese",
    "3 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Combine egg yolks, cream, lemon juice, and lemon zest in a bowl; whisk thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium-high heat. Add rice; cook, stirring constantly, until opaque, 3 to 4 minutes. Add chicken broth; stir quickly. Bring to a boil. Reduce heat to low. Cover and simmer until rice is tender and liquid has been absorbed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold lemon-cream mixture into the rice; mix well. Stir in Parmesan cheese and parsley.",
      "section": null,
