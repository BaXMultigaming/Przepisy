  "ingredients": [
    "1 tablespoon butter",
    "0.5 pound ground beef",
    "0.5 cup chopped onion",
    "1 (15.25 ounce) can whole kernel corn, drained",
    "1 (14.5 ounce) can diced tomatoes",
    "0.25 cup vegetable oil",
    "1 tablespoon chili powder",
    "1 teaspoon ground cumin",
    "1 cup milk",
    "0.5 cup yellow cornmeal",
    "2 eggs",
    "1 (6 ounce) can black olives, drained"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter an 8-inch baking or casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef and onion in the hot skillet until beef is browned and crumbly, 5 to 7 minutes. Mix in corn, tomatoes, oil, chili powder, and cumin. Bring to a boil; remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, cornmeal, and eggs in a large bowl. Stir in meat mixture. Mix in olives. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and set, 50 to 60 minutes; mixture should not be mushy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
