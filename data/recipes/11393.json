  "ingredients": [
    "0.5 cup butter, softened",
    "1 (3 ounce) package instant pistachio pudding mix",
    "1.3333300352097 cups baking mix",
    "1 egg",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and pistachio pudding mix in a large bowl with an electric mixer until smooth. Blend in baking mix, egg, and sugar to form a dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough on a lightly floured surface to 3/8-inch thickness; cut out cookies with a shamrock cookie cutter. Place cookies 2 inches apart on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 10 minutes. Cool on the baking sheet briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
