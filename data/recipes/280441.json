  "title": "Nutella®-Stuffed Mocha Muffins",
  "description": "With a light mocha flavor and a ribbon of Nutella® running through, these muffins are a perfect match for your morning cup of coffee.",
  "authors": [
    "Kim's Cooking Now"
  ],
