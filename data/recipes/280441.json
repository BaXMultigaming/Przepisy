  "ingredients": [
    "1.25 cups white sugar",
    "0.5 cup butter, softened",
    "2 tablespoons espresso powder",
    "2 tablespoons hot water",
    "1 cup plain yogurt",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "0.25 cup cocoa powder",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "14 teaspoons chocolate-hazelnut spread (such as Nutella®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line 14 muffin cups with paper liners and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and butter in a large bowl; beat until creamy. Dissolve espresso powder in hot water. Add to the butter mixture along with the yogurt, eggs, and vanilla. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cocoa powder, baking powder, and salt together. Fold into the wet ingredients just until combined. Do not overmix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide 1/2 of the batter evenly among the prepared muffin cups, filling only halfway. Drop a heaping teaspoon of chocolate-hazelnut spread in the center of each. Top with the remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the center springs back lightly touched with your finger, 15 to 18 minutes. Cool for 10 minutes in the pan before transferring muffins to a cooling rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
