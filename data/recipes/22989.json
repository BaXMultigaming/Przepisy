  "title": "Penuche",
  "description": "This penuche candy is a soft, sweet treat made with brown sugar, cream, and flecked with chopped pecans. A perfect light dessert for after dinner.",
  "authors": [
    "Paula"
  ],
  "date_published": "2000-10-21T13:30:03-04:00",
