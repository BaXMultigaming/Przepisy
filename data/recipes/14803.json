  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried parsley",
    "0.25 teaspoon dried basil",
    "1 cup shredded mozzarella cheese",
    "1 cup grated Parmesan cheese",
    "1 cup pizza sauce",
    "2 tablespoons chopped green bell pepper",
    "2 ounces pepperoni sausage, chopped",
    "2 tablespoons sliced black olives"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PnJIGZor47lW5pI9avAlYQnDR5U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-14803-hot-pizza-dip-VAT-step-01-0166266c45ce4a29aa4e202fc2a6e5a0.jpg"
      ],
      "image": "assets/images/14803/step_01.webp"
    },
    {
      "text": "Mix cream cheese, oregano, parsley, and basil together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2wsfc32zYlCBwWUF9UDif9-h9ik=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-14803-hot-pizza-dip-VAT-step-02-1-d07568e4d5d54be5b7066ae24dfd659a.jpg"
      ],
      "image": "assets/images/14803/step_02.webp"
    },
    {
      "text": "Spread mixture in the bottom of a 9-inch pie plate, or a shallow microwave-safe dish. Sprinkle ½ cup of the mozzarella cheese and ½ cup of Parmesan cheese on top of the cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/asdMlqSprG7kCumgrzLorwfzhj8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-14803-hot-pizza-dip-VAT-step-03-f53aafa40b124f9583bf65edb7133da4.jpg"
      ],
      "image": "assets/images/14803/step_03.webp"
    },
    {
      "text": "Spread the pizza sauce over all. Sprinkle with remaining cheese, then top with green pepper, pepperoni and olive slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MAPMu_gpi2zrEiDc0VSmM_1Qe3Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-14803-hot-pizza-dip-VAT-step-04-8bd18e35c31f4edcb6b97cbac492d668.jpg"
      ],
      "image": "assets/images/14803/step_04.webp"
    },
    {
      "text": "Cover, and microwave for 5 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NDuhav4jdN48_RR3ZnBI-LYu2JA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-14803-hot-pizza-dip-VAT-step-05-bc6753efdb434303a94480f4d629b2ef.jpg"
