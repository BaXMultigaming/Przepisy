  "ingredients": [
    "5 cups chopped rhubarb",
    "0.75 cup white sugar, or to taste",
    "0.5 teaspoon ground cinnamon",
    "4 cups cubed cinnamon swirl bread",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Toss rhubarb, sugar, and cinnamon together in a bowl. Add 2 cups bread cubes; toss to coat. Transfer to an ungreased 2-quart microwave-safe baking dish. Top with remaining 2 cups bread cubes; drizzle with melted butter.",
      "section": null,
      "name": null,
      "url": null,
