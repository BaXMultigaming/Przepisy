  "ingredients": [
    "1 cup packed brown sugar",
    "0.75 cup unsalted butter, softened",
    "0.5 cup white sugar",
    "2 large eggs",
    "0.33000001311302 cup peanut butter",
    "0.25 cup water",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "2 cups rolled oats",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, butter, and white sugar in a large bowl with an electric mixer until creamy. Beat in eggs, one at a time, until combined. Stir in peanut butter, water, and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and baking soda in a separate bowl. Stir dry ingredients into the wet ingredients until just combined. Stir in oats and chocolate chips. Drop by teaspoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly toasted on the edges, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and transfer to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
