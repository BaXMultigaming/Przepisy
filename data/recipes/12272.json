  "ingredients": [
    "1 (9 inch) deep dish pie crust",
    "1 cup white sugar",
    "1 tablespoon all-purpose flour",
    "0.75 cup flaked coconut",
    "2 eggs",
    "0.75 cup crushed pineapple, drained",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "In a small bowl, mix sugar and flour. Stir in coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a larger bowl, beat eggs lightly. Mix in pineapple, and then coconut mixture. Add melted butter, and mix well. Pour filling into deep dish pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 45 to 60 minutes.",
