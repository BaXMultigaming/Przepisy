  "ingredients": [
    "1 tablespoon canola oil",
    "1 tablespoon unsalted butter",
    "0.5 cup diced onion",
    "4 cups peeled and cubed butternut squash",
    "0.75 cup diced carrots",
    "3 cups vegetable stock",
    "salt and ground black pepper to taste",
    "ground nutmeg to taste",
    "0.5 cup heavy cream"
  ],
  "steps": [
    {
      "text": "Heat oil and melt butter in a large pot over medium heat. Cook and stir onion in the butter and oil under tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add squash and carrots into the pot. Pour in vegetable stock and season with salt, pepper, and nutmeg. Bring to a boil, reduce heat, and simmer until vegetables are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree soup mixture in a blender or food processor until smooth. Return to the pot and stir in heavy cream. Heat through but do not boil. Serve warm with a dash of nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
