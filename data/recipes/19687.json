  "ingredients": [
    "18 jumbo black olives, pitted",
    "1 (8 ounce) package cream cheese, softened",
    "18 small black olives",
    "1 carrot"
  ],
  "steps": [
    {
      "text": "Cut a slit lengthwise (from top to bottom) into one side of each jumbo olive. Carefully insert about 1 teaspoon cream cheese into slits in each jumbo olive.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice carrot into 18 1/4-inch-thick rounds; cut a small (pie-shaped) notch out of each carrot slice to form feet. Save the cut out pieces; press pieces into centers of small olives to form beaks. If necessary cut a small slit into each small olive before inserting the beak.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set a jumbo olive, large hole side down, onto a carrot slice. Then, set a small olive onto the jumbo olive, adjusting so that the beak, cream cheese chest, and notch in the carrot (feet) slice line up. Secure with a toothpick.",
      "section": null,
      "name": null,
      "url": null,
