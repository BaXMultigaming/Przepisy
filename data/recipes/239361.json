  "ingredients": [
    "0.75 cup Crisco® Butter Flavor All-Vegetable Shortening",
    "0.5 cup firmly packed brown sugar",
    "2 teaspoons grated orange peel",
    "0.33333334326744 cup milk",
    "1 large egg",
    "1.5 cups Pillsbury BEST® All Purpose Flour",
    "1 (4-serving size) package vanilla flavor instant pudding and pie filling mix",
    "1 teaspoon baking powder",
    "1 cup chocolate chips*",
    "1 cup coarsely chopped pecans"
  ],
  "steps": [
    {
      "text": "Heat oven to 350 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat shortening, sugar and orange peel in large bowl at medium speed of electric mixer until well blended. Beat in milk and egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, pudding mix and baking powder in medium bowl. Mix into shortening mixture at low speed until just blended. Stir in chocolate chips and nuts. Drop rounded tablespoonfuls of dough 2-inches apart onto ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "BAKE 12 minutes or until set. Cool 2 minutes on baking sheet. Remove to cooling rack.",
      "section": null,
