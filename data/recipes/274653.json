  "ingredients": [
    "cooking spray",
    "2 pounds chicken wings",
    "0.5 teaspoon salt, or more to taste",
    "0.33333334326744 cup all-purpose flour",
    "6 tablespoons unsalted butter",
    "0.5 cup hot sauce",
    "0.5 tablespoon red wine vinegar",
    "0.5 tablespoon Worcestershire sauce",
    "0.5 tablespoon honey",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon cayenne pepper",
    "2 stalks celery, sliced, or to taste",
    "2 carrots, sliced, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil and coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat dry chicken wings with paper towels. Season with salt. Place flour into a shallow dish. Dredge wings in flour to lightly coat, then place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and no longer pink in the centers, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While wings are baking, melt butter over medium heat in a medium saucepan. Add hot sauce, red wine vinegar, Worcestershire, honey, garlic powder, and cayenne. Let sauce simmer on low heat until wings are done baking, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place wings in a large serving bowl. Pour sauce over wings; toss until evenly coated. Serve with celery and carrots.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
