  "ingredients": [
    "1 tablespoon vegetable oil",
    "0.5 small onion, diced",
    "2 cloves garlic, minced",
    "1 tablespoon grated fresh ginger root",
    "1 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground cumin",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon celery seed",
    "2 cups blueberries",
    "0.25 cup packed brown sugar",
    "2 tablespoons balsamic vinegar"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a saucepan over medium-high heat. Saute onion, garlic, and ginger in hot oil until the onion begins to turn translucent, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir salt, cinnamon, cloves, cumin, cayenne pepper, and celery seed into the onion mixture; continue to cook, stirring frequently, until the onion is completely softened, 2 to 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir blueberries and brown sugar into the onion mixture. Mash the berries as they cook until completely softened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend the blueberry mixture with an immersion blender until the mixture is thick with no large chunks. Stir balsamic vinegar into blueberry mixture, reduce heat to low, and cook at a simmer until thickened to your liking, 10 to 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
