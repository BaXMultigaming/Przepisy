  "ingredients": [
    "1.3333333730698 cups packed brown sugar",
    "0.5 cup butter, softened",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "2 cups shredded zucchini",
    "1 cup chopped walnuts",
    "1 (16 ounce) package cream cheese frosting",
    "0.25 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, ½ cup butter, eggs, and vanilla together in a large bowl until creamy; stir in flour, baking soda, cinnamon, and ½ teaspoon cloves until well combined. Beat in zucchini and walnuts until incorporated; transfer batter to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 30 minutes. Cool completely before frosting, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese frosting and ¼ teaspoon ground cloves in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread frosting over cooled zucchini bars; cut into 16 squares.",
      "section": null,
      "name": null,
      "url": null,
