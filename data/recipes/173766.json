  "ingredients": [
    "1 pound sliced bacon",
    "5 pounds boneless skinless chicken breast halves, cut into 2-inch chunks",
    "60 wooden toothpicks",
    "1 cup white sugar",
    "1 (1 ounce) envelope ranch dressing mix"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the sugar and ranch dressing mix in a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut the bacon slices in half the short way. Wrap half a bacon slice around each chunk of chicken, and secure it with a toothpick. Roll the bacon-wrapped chicken pieces in the sugar-ranch dressing mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the bacon wraps on the prepared baking sheets, and bake in the preheated oven for 30 minutes, until the chicken is cooked through, the bacon is sizzling, and the crust is browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
