  "ingredients": [
    "4 cups Concord grapes",
    "1 cup white sugar",
    "0.25 cup all-purpose flour",
    "1 tablespoon lemon juice",
    "1 recipe pastry for a 9-inch double-crust pie"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Place an aluminum foil-lined sheet pan on a lower oven rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wash and stem grapes. Squeeze pulp out of skins into a saucepan, saving skins in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook pulp in a medium saucepan over medium-low heat, stirring frequently, until seeds are beginning to come out.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain pulp into skins, using a spoon to rub pulp off seeds. Add sugar, flour, and lemon juice to the bowl and mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fit 1 pastry crust into a 9-inch pie plate. Pour grape filling into crust. Use remaining pastry to make a lattice top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven on the prepared sheet pan until crust is golden brown and filling is bubbly, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
