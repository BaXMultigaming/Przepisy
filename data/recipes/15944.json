  "title": "Favorite Concord Grape Pie",
  "description": "This years-old Concord grape pie recipe is simple to make with just five basic ingredients and features a beautiful lattice top over a juicy filling.",
  "authors": [
    "Esther Kenagy"
  ],
  "date_published": "1999-10-09T15:37:40-04:00",
