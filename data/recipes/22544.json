  "ingredients": [
    "2 large eggs, at room temperature",
    "1 cup light brown sugar",
    "0.5 cup unsalted butter, melted and cooled",
    "0.25 cup white sugar",
    "1 tablespoon all-purpose flour",
    "1 tablespoon milk",
    "1 teaspoon vanilla extract",
    "1 cup chopped pecans",
    "1 (9 inch) unbaked pie shell"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DCqMWxH9O3wqjOuX2psgl2tiuMw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22544-pecan-pie-VAT-step-01-00e21fb4dfff42abbfdc991eebd4a30f.jpg"
      ],
      "image": "assets/images/22544/step_01.webp"
    },
    {
      "text": "Whisk eggs in a large bowl until foamy. Whisk in brown sugar, butter, white sugar, flour, milk, and vanilla extract until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E6AdiOLYBCtscZVBg5ZXzs5EUrw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22544-pecan-pie-VAT-step-02-3951d9efc95041efbb075100592c62e8.jpg"
      ],
      "image": "assets/images/22544/step_02.webp"
    },
    {
      "text": "Fold in chopped pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Axk10XPXzSDgBzuvWyR9-Nv_9Z0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22544-pecan-pie-VAT-step-03-998a7f63fbc141d3adf95daf315ee73f.jpg"
      ],
      "image": "assets/images/22544/step_03.webp"
    },
    {
      "text": "Pour mixture into pie shell; decorate with pecan halves, if using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F80AhC41jcxaEKQQwURh5tEF3OI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22544-pecan-pie-VAT-step-04-ecc1f2e163be446aa44012feb0ae6333.jpg"
      ],
      "image": "assets/images/22544/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Reduce heat to 350 degrees F (175 degrees C); continue to bake until filling is set but still slightly wobbly, 30 to 40 minutes more. Remove from the oven and cool completely before slicing; pie will continue to firm up as it cools.",
