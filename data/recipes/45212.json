  "ingredients": [
    "1 (6 ounce) package dry instant long grain and wild rice mix",
    "1 (8 ounce) container sour cream",
    "1 (4 ounce) can chopped green chiles, drained",
    "1 (16 ounce) package shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a medium baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare instant long grain and wild rice mix according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1/2 of the cooked rice mix over the bottom of the prepared baking dish. In a bowl, mix the sour cream and green chiles. Spread 1/2 of the sour cream mixture over rice, and top with 1/2 of the cheese. Repeat the layers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 25 minutes in the preheated oven, or until bubbly.",
