  "ingredients": [
    "0.75 cup aquafaba (liquid from can of chickpeas)",
    "0.25 teaspoon cream of tartar",
    "1 tablespoon vanilla extract",
    "0.66666668653488 cup powdered erythritol sweetener (such as Swerve®)",
    "2 tablespoons melted coconut oil"
  ],
  "steps": [
    {
      "text": "Refrigerate aquafaba for at least 4 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip aquafaba with a mixer until it starts to get foamy, about 2 minutes. Add cream of tartar and continue to mix on high until stiff peaks form, about 2 minutes. Add vanilla and beat for 1 more minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add powdered sweetener and melted coconut oil; whip until fully incorporated, about 1 minute.",
      "section": null,
