  "ingredients": [
    "cooking spray",
    "1 (18.25 ounce) package yellow cake mix",
    "0.33333334326744 cup brown sugar",
    "0.66666668653488 cup milk",
    "1 egg",
    "0.5 cup butterscotch chips",
    "0.25 cup chocolate chips",
    "0.25 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cake mix and brown sugar together in a large bowl. Mix in milk and egg until well blended. Fold in butterscotch chips, chocolate chips, and walnuts. Spread dough evenly in the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges start to pull away from the sides of the pan, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
