  "ingredients": [
    "1 pound bacon",
    "10 eggs",
    "1 (16 ounce) can refried beans",
    "8 ounces shredded Cheddar cheese",
    "10 (10 inch) flour tortillas"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain, and set aside. Wrap tortillas in foil and warm them in the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry eggs in a greased skillet until firm. In a small saucepan, heat refried beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top each tortilla with refried beans, 2 strips of bacon, 1 egg, and a little cheese. Roll tortillas into burritos and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
