  "title": "Banana Apple Bread",
  "description": "This apple banana bread is full of delicious banana flavor. Cubed apples and a cinnamon crumble topping add a sweet taste to this family favorite.",
  "authors": [
    "afcouwen"
  ],
  "date_published": "2020-06-18T23:45:42-04:00",
