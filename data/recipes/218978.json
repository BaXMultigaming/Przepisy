  "ingredients": [
    "2.75 cups all-purpose flour",
    "2 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups white sugar",
    "1 cup unsalted butter, melted",
    "4 large eggs",
    "1 cup plain Greek yogurt",
    "1.5 teaspoons vanilla extract",
    "3 large very ripe bananas, mashed",
    "2 medium apples, cubed",
    "0.75 cup chopped walnuts",
    "0.5 cup packed brown sugar",
    "0.5 cup white sugar",
    "0.25 cup all-purpose flour",
    "3 tablespoons unsalted butter, softened",
    "1 tablespoon ground cinnamon",
    "1 medium banana, sliced",
    "1 medium apple, sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease two 7x3-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the bread: Whisk flour, cinnamon, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and melted butter in a large mixing bowl until smooth. Mix in eggs, one at a time, followed by yogurt and vanilla. Gradually stir in flour mixture just until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold in bananas, apples, and walnuts until combined with small chunks of banana still visible in the batter; do not overmix. Pour 1/2 of the batter into each prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the topping: Mix brown sugar, white sugar, flour, butter, and cinnamon together in a bowl until the mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle 1/2 of the topping over each loaf. Garnish each loaf with banana and apple slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes, then remove and cover each pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven, and bake until a toothpick inserted into the center of each loaf comes out clean, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and allow to cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
