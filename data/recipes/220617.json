  "ingredients": [
    "8 ounces shredded sharp Cheddar cheese",
    "8 ounces shredded Swiss cheese",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 clove garlic, halved",
    "1 (12 fluid ounce) can or bottle beer",
    "1 dash hot pepper sauce (such as Tabasco®)"
  ],
  "steps": [
    {
      "text": "Combine Cheddar cheese, Swiss cheese, flour, salt, and black pepper in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub cut side of garlic clove around bottom and sides of fondue pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour beer into fondue pot and slowly bring to a simmer over medium-low heat, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually stir cheese mixture into beer, adding small amounts at a time, until cheese is melted and blended, 10 to 15 minutes. Stir in hot pepper sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
