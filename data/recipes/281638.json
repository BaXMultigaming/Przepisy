  "ingredients": [
    "6 ounces cream cheese, softened",
    "1 ounce shredded Cheddar cheese, or to taste",
    "6 medium jalapeno peppers, halved and seeded",
    "3 slices salami",
    "6 slices bacon, cut in half lengthwise"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 390 degrees F (199 degrees C) according to manufacturer’s instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese and Cheddar cheese in a small bowl. Divide cheese mixture evenly among jalapeño halves. Top each with a piece of salami, then wrap with a strip of bacon. Secure with a toothpick if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange jalapeño poppers in a single layer in the air fryer basket, working in batches if needed. Air fry until bacon is browned and crisp and cheese is melted, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
