  "ingredients": [
    "2 tablespoons vegetable oil",
    "1 medium onion, chopped",
    "5 cloves garlic, chopped",
    "1 green bell pepper, seeded and chopped",
    "1 teaspoon dried oregano, crushed",
    "1 teaspoon salt",
    "0.25 teaspoon pepper",
    "0.25 teaspoon ground cumin",
    "2 bay leaves",
    "2 tomatoes, chopped",
    "0.75 cup canned tomato sauce"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium-high heat. Add onion and garlic, and cook until onion is translucent. Add bell pepper and sauté until tender. Season with oregano, salt, pepper, cumin, and bay leaves. Continue cooking until mixture looks like a yummy green paste with oil around it.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomatoes; cook and stir until all of the liquid is released. Gradually mix in tomato sauce; simmer until sauce looks really red. Taste and adjust seasonings if desired. Remove bay leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sauce to meat, rice, beans, fish, or potatoes. Thin sauce down if necessary with water, wine, beer, or whatever is handy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
