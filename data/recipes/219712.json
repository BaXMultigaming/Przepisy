  "ingredients": [
    "1.5 cups ketchup",
    "1 cup ginger ale",
    "1 envelope dry onion soup mix",
    "1 cup brown sugar",
    "0.25 cup red wine",
    "1 (3 pound) beef brisket (first cut, or lean flat portion)"
