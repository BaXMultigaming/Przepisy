  "ingredients": [
    "1.5 pounds lean ground beef",
    "3 tablespoons garlic powder",
    "2 tablespoons ground cinnamon",
    "1 tablespoon ground allspice",
    "4 cups water",
    "2 cups long-grain rice",
    "1 teaspoon beef bouillon granules",
    "0.25 cup pine nuts",
    "1 squeeze lemon juice, or to taste"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium heat. Break ground beef into small pieces and add to the skillet. Season beef with garlic powder, ground cinnamon, and allspice; cook and stir until beef is completely browned and crumbly, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water, rice, and beef bouillon with the beef; bring to a simmer and cook until the rice is soft and fluffy, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a small skillet over high heat; toast pine nuts in the skillet, swirling to keep pine nuts moving, until browned, 2 to 4 minutes. Sprinkle toasted pine nuts and lemon juice over the beef and rice mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
