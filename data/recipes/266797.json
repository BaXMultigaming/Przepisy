  "ingredients": [
    "3 cups grated cauliflower",
    "1 cup shredded Cheddar cheese",
    "1 large egg",
    "0.25 cup real bacon bits",
    "1 tablespoon diced chives",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1 pinch cayenne pepper",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place grated cauliflower in a microwave-safe bowl. Cook on high for 2 minutes. Let cool for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wring cauliflower in a clean dish towel, squeezing out as much moisture as possible. Transfer cauliflower to a large mixing bowl. Add Cheddar cheese, egg, bacon bits, chives, salt, pepper, and cayenne. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a large baking sheet with cooking spray. Divide cauliflower mixture into 6 equal portions, making sure to leave space between each one. Flatten with your hands and shape into ovals.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned, about 15 minutes. Turn broiler on low and broil until crispy, about 5 minutes. Let cool for 5 minutes to firm up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
