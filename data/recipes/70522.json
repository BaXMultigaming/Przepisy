  "ingredients": [
    "0.5 cup butter",
    "4 cloves garlic, minced",
    "0.75 cup dry bread crumbs",
    "0.5 cup freshly grated Parmesan cheese",
    "1.5 cups shredded Cheddar cheese",
    "0.25 teaspoon dried parsley",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon ground black pepper",
    "0.125 teaspoon salt",
    "8 skinless, boneless chicken breast halves - pounded thin"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the butter in a saucepan over low heat, and cook the garlic until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a shallow bowl, mix the bread crumbs, Parmesan cheese, Cheddar cheese, parsley, oregano, pepper, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each chicken breast in the garlic butter to coat, then press into the bread crumb mixture. Arrange the coated chicken breasts in a 9x13 inch baking dish. Drizzle with any remaining butter and top with any remaining bread crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 30 minutes in the preheated oven, or until chicken is no longer pink and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
