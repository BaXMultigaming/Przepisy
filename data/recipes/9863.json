  "ingredients": [
    "1 cup butter",
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "2 eggs",
    "1 tablespoon vanilla extract",
    "2.5 cups rolled oats",
    "2 cups all-purpose flour",
    "0.5 teaspoon salt",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "12 ounces semisweet chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, brown sugar, eggs, and vanilla in a large bowl until light, fluffy, and well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pulse rolled oats in a food processor until finely ground. Whisk together ground oats, flour, salt, baking powder, and baking soda in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually add the dry ingredients to the butter mixture, beating just until combined. Fold in chocolate chips and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into golf ball-sized balls and place about 2 inches apart on the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the edges are lightly golden and the centers are just set, 8 to 10 minutes. Let cookies cool on the baking sheet for about 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
