  "title": "Mrs. Fields Cookies",
  "description": "This copycat Mrs. Fields cookie recipe combines ground oats, chocolate chips, and walnuts for soft, chewy cookies with crisp edges that are perfect for sharing.",
  "authors": [
    "Rhonda"
  ],
  "date_published": "1997-08-03T03:32:01-04:00",
