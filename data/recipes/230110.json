  "ingredients": [
    "cooking spray",
    "0.5 cup white sugar",
    "2 large eggs, beaten",
    "1 (15 ounce) can pumpkin puree",
    "0.75 cup evaporated milk",
    "1 teaspoon orange extract",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon salt",
    "1 (9 ounce) package yellow cake mix (such as Jiffy® Golden Yellow cake mix)",
    "0.25 cup unsalted butter, melted"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Spray an 8-inch square baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AGsdiZA9fm5_KLY5-SIj0cjKLcY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-230110-Pumpkin-Cobbler-ddmfs-step-1-0e7c38f71f1b48b385ea92513168711c.jpg"
      ],
      "image": "assets/images/230110/step_01.webp"
    },
    {
      "text": "Combine sugar and eggs in a bowl; whisk until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5kvdvKLd9L-0WUf5OO6ynQgDxKc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-230110-Pumpkin-Cobbler-ddmfs-step-2-657d9590c6514dff8826790f174145db.jpg"
      ],
      "image": "assets/images/230110/step_02.webp"
    },
    {
      "text": "Add pumpkin puree, evaporated milk, orange extract, cinnamon, ginger, cloves, and salt; mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E6mgJSltemiUd_AmkcUuBvROp44=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-230110-Pumpkin-Cobbler-ddmfs-step-3-8230581e46e24892b89ebf71f7b5dadd.jpg"
      ],
      "image": "assets/images/230110/step_03.webp"
    },
    {
      "text": "Pour pumpkin mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-2KwaSV8LD3fw_EqlFPoNab_BOo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-230110-Pumpkin-Cobbler-ddmfs-step-4-90d9e4720d9c4f078afd0001727ed51b.jpg"
      ],
      "image": "assets/images/230110/step_04.webp"
    },
    {
      "text": "Lightly sprinkle cake mix over the pumpkin mixture until completely covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lRDggh4wEKuFeE9XttZiShanm2Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-230110-Pumpkin-Cobbler-ddmfs-step-5-3b66bcb163884cae8590555594731f84.jpg"
