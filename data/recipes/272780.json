  "ingredients": [
    "3 cups all-purpose flour",
    "0.5 cup white sugar",
    "3 teaspoons baking powder",
    "0.25 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup butter",
    "0.66666668653488 cup whole milk",
    "2 eggs, beaten, divided",
    "1 dash vanilla extract",
    "1 cup frozen blueberries",
    "2 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4nWnZSGqxJHluvnvlQRD8ykn0QQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272780-best-blueberry-scones-VAT-005-step-01-35a7c4e3df5246d6a2198539f3402720.jpg"
      ],
      "image": "assets/images/272780/step_01.webp"
    },
    {
      "text": "Mix flour, 1/2 cup white sugar, baking powder, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ldn0no_tg3jBe0rAYx5UW9B3Dv0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272780-best-blueberry-scones-VAT-006-step-02-b142f0cff91248d0a356e877855048e5.jpg"
      ],
      "image": "assets/images/272780/step_02.webp"
    },
    {
      "text": "Cut in butter using a pastry blender or fork until the flour mixture looks like cornmeal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z2oPLG8KRRhokGozaUENi3PgBPw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272780-best-blueberry-scones-VAT-007-step-03-57eb91eef2384ba5a4aa40e59e4e8d45.jpg"
      ],
      "image": "assets/images/272780/step_03.webp"
    },
    {
      "text": "Pour in milk, 1 egg, and vanilla extract. Fold in frozen blueberries and mix sparingly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v8Z-i9-iJfvBTTYHjx7GSvcIhvY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272780-best-blueberry-scones-VAT-008-step-04-14fb90c159a142a8b5745ed52c708aaa.jpg"
      ],
      "image": "assets/images/272780/step_04.webp"
    },
    {
      "text": "Scoop dough onto the prepared baking sheet into 10 equal-sized amounts of dough. Do not flatten. Brush tops with reserved beaten egg. Sprinkle 2 tablespoons sugar evenly over the tops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nqigtKZdtHFK50OzDbHw8jlMGyU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272780-best-blueberry-scones-VAT-009-step-05-051b89d007504f38b01c692b6272de95.jpg"
      ],
      "image": "assets/images/272780/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sdiz4TiNiMqIb5SJu0t9wrnD53o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272780-best-blueberry-scones-VAT-010-step-06-4951061976774e20abf0a379d73fbdb5.jpg"
