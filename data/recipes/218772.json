  "title": "Mile High Green Chile",
  "description": "This green chile is made in the slow cooker with pork, roasted tomatillos, chiles, herbs, and spices. Cream cheese is added for a creamy finish.",
  "authors": [
    "chefclaudiesel"
  ],
  "date_published": "2010-10-20T19:08:20-04:00",
