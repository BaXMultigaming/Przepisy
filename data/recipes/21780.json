  "ingredients": [
    "1 (10 ounce) package refrigerated biscuit dough",
    "8 frankfurters",
    "8 slices American processed cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper or lightly coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate crescent dough into triangles; cut each triangle in half lengthwise to create narrower strips. Place one cocktail sausage on the wide end of each strip. If using cheese, add a small piece underneath the sausage. Roll up tightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/geYhAJR3b6aGI5NrCo7oqEDkKFU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21780-pigs-in-a-blanket-VAT-step-02-f723fa2629a14b0fb882b49999d19024.jpg"
      ],
      "image": "assets/images/21780/step_02.webp"
    },
    {
      "text": "Place rolls, seam-side down, on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZxYS1CE3KTtshQzBKPYe1bXVSdI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21780-pigs-in-a-blanket-VAT-step-03-a8258d99519c4227bb2512ed0efc6d09.jpg"
      ],
      "image": "assets/images/21780/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown and puffed, about 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5FycAATU54ZDPC1zGhdGp5xn9oI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21780-pigs-in-a-blanket-VAT-step-04-da1f4dcf4dd24aee9b60b63404425cbc.jpg"
      ],
      "image": "assets/images/21780/step_04.webp"
    },
    {
      "text": "Serve hot.",
