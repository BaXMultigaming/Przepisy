  "ingredients": [
    "1.75 cups pumpkin seeds",
    "2 teaspoons avocado oil",
    "1 teaspoon smoked paprika",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 350 degrees F (180 degrees C). Rinse pumpkin seeds in a colander.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a large plate with 2 paper towels. Spread pumpkin seeds on plate; cover with 2 more paper towels. Gently press to remove excess water. Let sit at room temperature until dried, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer seeds to a medium bowl. Add oil, paprika, and salt; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pumpkin seeds in the air fryer basket in a thin layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer until golden brown and crispy, shaking the basket frequently, 15 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
