  "ingredients": [
    "3.25 cups old-fashioned oats, divided",
    "0.5 cup chopped walnuts",
    "0.33333334326744 cup raisins",
    "2 tablespoons ground flax seeds",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon salt",
    "2 ripe bananas",
    "2 eggs",
    "0.33333334326744 cup unsweetened applesauce",
    "1 tablespoon honey",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grind 2 1/4 cups oats in a food processor to yield 2 cups ground oats. Add walnuts, raisins, flax seeds, cinnamon, baking powder, and salt. Stir in remaining 1 cup oats. Stir thoroughly with a spoon, but do not grind further.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make a well in the center of oat mixture. Add bananas, eggs, applesauce, honey, and vanilla extract. Mash bananas and stir until dough is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoonfuls of dough onto the prepared baking sheets. Gently flatten each cookie slightly with the back of a spoon, as they will not spread much during baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are set and the bottoms are lightly golden, about 11 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
