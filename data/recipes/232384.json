  "ingredients": [
    "1 cup graham cracker crumbs",
    "0.33333334326744 cup butter, melted",
    "0.25 cup white sugar",
    "2 cups milk",
    "0.5 cup white sugar",
    "2 tablespoons cornstarch",
    "1 tablespoon all-purpose flour",
    "1 pinch salt",
    "3 eggs, separated",
    "1 tablespoon butter",
    "1 teaspoon vanilla extract",
    "0.25 cup white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham cracker crumbs, ⅓ cup melted butter, and ¼ cup sugar in a bowl; press crust into a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, ½ cup sugar, cornstarch, flour, and salt in a saucepan over medium heat; bring to a boil, stirring constantly. Boil 2 minutes. Add egg yolks while continuously whisking; cook and stir until thickened, about 1 minute more. Off heat, stir in 1 tablespoon butter and vanilla extract. Cool pudding 10 minutes before pouring into the prepared crust; cool pie to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a glass or metal bowl until foamy. Gradually beat in ¼ cup sugar, continuing to beat until stiff peaks form. Lift your beater or whisk straight up: the meringue will form sharp peaks. Spread meringue over pudding.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 5 minutes. Cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate before serving, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
