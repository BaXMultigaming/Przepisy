  "ingredients": [
    "3 cups sliced strawberries",
    "3 cups sliced rhubarb",
    "1.5 cups white sugar",
    "0.25 cup instant tapioca",
    "1 squeeze fresh lemon juice",
    "double-crust pie pastry, thawed",
    "2 tablespoons butter, cut into small pieces"
  ],
  "steps": [
