  "ingredients": [
    "1 cup packed brown sugar",
    "1.25 cups water",
    "0.33300000429153 cup shortening",
    "0.25 teaspoon ground cloves",
    "0.5 teaspoon ground nutmeg",
    "2 teaspoons ground cinnamon",
    "2 cups raisins",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "In a saucepan, combine brown sugar, water, shortening, cloves, nutmeg, cinnamon, and raisins. Bring to a boil, then continue boiling for 3 minutes. Remove from the heat and allow to cool for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour an 8x4-inch loaf pan. Sift flour, baking powder, baking soda, and salt together into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine raisin mixture with flour mixture; pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the cake comes out clean, about 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
