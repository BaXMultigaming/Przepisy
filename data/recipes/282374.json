  "title": "Blueberry-Lemon Muffins",
  "description": "Fresh blueberries, lemon extract, and ground ginger give a refreshing kick to these healthier muffins.",
  "authors": [
    "EatAndRun"
  ],
  "date_published": "2020-11-17T18:55:24-05:00",
