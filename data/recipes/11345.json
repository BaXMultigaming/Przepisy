  "ingredients": [
    "1 (8 ounce) container frozen whipped topping, thawed",
    "2 large eggs",
    "1 (15.25 ounce) package lemon cake mix",
    "0.33333334326744 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together whipped topping and eggs in a large bowl. Add cake mix and continue to mix until combined. Dough will be thick. Drop by tablespoonfuls into a bowl of confectioners' sugar and roll to coat. Place on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
