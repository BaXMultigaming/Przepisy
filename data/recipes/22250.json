  "ingredients": [
    "0.33300000429153 cup vegetable oil",
    "2 eggs",
    "1 egg yolk",
    "0.25 cup applesauce",
    "0.25 cup chocolate syrup",
    "1 (13 ounce) package brownie mix",
    "1 tablespoon unsweetened cocoa powder",
    "1 cup semisweet chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 9 inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the vegetable oil, eggs, egg yolk, applesauce and chocolate syrup until well blended. Stir in the brownie mix and cocoa powder. Fold in the chocolate chips and walnuts. Spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 40 to 45 minutes in the preheated oven, until the top of the brownies appear dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
