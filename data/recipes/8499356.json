  "title": "Ghost Cheesecake Brownies",
  "description": "Try Chef John's ghost cheesecake brownies for this year's Halloween festivities.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2022-10-25T09:00:00-04:00",
  "date_modified": "2023-10-04T10:13:01-04:00",
  "prep_time": "PT30M",
  "cook_time": null,
  "total_time": "PT95M",
  "yield": [
    "9",
    "9 brownies"
  ],
