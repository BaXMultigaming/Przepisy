  "ingredients": [
    "1.5 cups warm water (110 degrees F/45 degrees C)",
    "1 cup margarine, melted",
    "0.75 cup white sugar",
    "3 egg, beaten",
    "4.5 teaspoons active dry yeast",
    "1 teaspoon salt",
    "7.5 cups bread flour",
    "1 egg, beaten",
    "2 tablespoons poppy seeds",
    "2 tablespoons sesame seeds"
  ],
  "steps": [
    {
      "text": "In a medium bowl, blend together warm water, melted margarine, sugar, and 3 beaten eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together yeast, salt, and 7 cups of flour. Gradually stir in liquid ingredients, and mix until dough holds together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead dough on a floured surface with remaining flour until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Split dough into 2 large pieces. Split 2 large pieces into 3 pieces each. Roll each third into a rope 3/4 inch thick and braid 3 strands together. Repeat. Place shaped dough onto greased cookie sheets. Brush dough with remaining beaten egg. Add poppy or sesame seeds, if desired. Let rise in a warm place until doubled in size.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 325-degree F (165-degrees C) oven for 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
