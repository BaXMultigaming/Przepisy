  "ingredients": [
    "0.5 cup chopped tomatoes",
    "2 tablespoons white wine vinegar",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon ground mustard"
  ],
  "steps": [
    {
      "text": "In a blender or small food processor, blend or process the tomatoes, vinegar, basil, thyme, and mustard on medium to high speed, about 25 seconds or until well combined. To store, transfer to a jar with a tight-fitting cover and refrigerate for up to 2 days. Shake well before serving.",
