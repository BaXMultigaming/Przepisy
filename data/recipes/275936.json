  "ingredients": [
    "1 pound ground beef",
    "1 tablespoon tomato paste",
    "1 teaspoon salt",
    "1 teaspoon white sugar",
    "1 teaspoon garlic powder",
    "1 teaspoon Italian seasoning",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon dried oregano",
    "4 slices mozzarella cheese",
    "4 fresh hamburger buns"
  ],
  "steps": [
    {
      "text": "Combine beef, tomato paste, salt, sugar, garlic powder, Italian seasoning, pepper, and oregano in a large bowl. Mix thoroughly. Cover and refrigerate to let flavors marry, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form beef mixture into 8 thin patties. Place 1 slice of mozzarella cheese on each of 4 patties; leave at least a 1/2-inch border, breaking up the cheese as needed. Place remaining patties on top and pinch edges to seal in the cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium-low heat. Fry burgers until browned and centers reach 165 degrees F (74 degrees C), 6 to 7 minutes per side. Serve on buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
