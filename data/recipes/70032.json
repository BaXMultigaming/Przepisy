  "title": "Beer Pizza",
  "description": "This is a very filling pizza that my husband loves. My mom and dad use to make it when I was young, and it was always a treat.",
  "authors": [
    "Kristal Conroy-Contaldi"
  ],
  "date_published": "2018-06-08T09:23:12-04:00",
