  "ingredients": [
    "0.25 cup all-purpose flour",
    "salt and pepper to taste",
    "1.5 pounds round steak, cut into small pieces",
    "3 tablespoons vegetable oil",
    "3 stalks celery, chopped",
    "1 onion, chopped",
    "3 carrots, shredded",
    "2 (14.5 ounce) cans diced tomatoes with juice",
    "2 tablespoons brown sugar, or to taste",
    "1 tablespoon Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Mix together flour, salt, and pepper in a shallow bowl. Dredge steak pieces in flour mixture to lightly coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Cook and stir celery, onion, and carrots in hot oil until tender, about 5 minutes. Add coated steak pieces; cook and stir until lightly browned, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer steak-vegetable mixture to the slow cooker. Stir in tomatoes with juice, brown sugar, and Worcestershire sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until steak is very tender, 8 to 10 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
