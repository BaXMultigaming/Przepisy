  "title": "Moist Coconut Cake",
  "description": "This coconut cake recipe makes a soft and moist cake with easy baking ingredients, coconut extract, and flaked coconut for a great coconut flavor.",
  "authors": [
    "dannis"
  ],
  "date_published": "2000-01-02T01:45:21-05:00",
