  "steps": [
    {
      "text": "Mix together 2 cups flour and salt in a large bowl until well combined. Slowly mix in enough warm water to make a thick dough. Mix in oil until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer dough to a cool surface and knead for a few minutes, adding 2 teaspoonfuls flour. Return dough to the same bowl, cover with a clean cloth, and let rest for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 200 degrees F (95 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet or griddle over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into orange-sized balls. Flatten into 6-inch circles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry in batches in the hot skillet, turning once, until golden brown and spotted, 6 to 8 minutes. Repeat with remaining dough. Keep chapatis warm in the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
