  "ingredients": [
    "1 (16 ounce) package macaroni",
    "1 (10.75 ounce) can condensed Cheddar cheese soup",
    "1 cup milk",
    "1 pound shredded Colby cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place macaroni in a 2-quart casserole dish. Stir in cheese soup and milk until well combined. Sprinkle with shredded Colby cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is golden brown and the casserole is bubbly, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
