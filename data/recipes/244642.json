  "ingredients": [
    "0.75 cup brown sugar",
    "1 cup butter, softened",
    "2 large eggs",
    "3 cups all-purpose flour",
    "1 cup semi-sweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter together in a large bowl with an electric mixer until light and fluffier in texture. Beat in eggs, one at at time. Gradually stir in flour until well combined; fold in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded tablespoons 2 inches apart onto ungreased baking sheets. Bake in the preheated oven until edges are golden brown, 10 to 15 minutes. Cool cookies on baking sheets for a few minutes before transferring to wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
