  "ingredients": [
    "1 (12 ounce) package butterscotch chips",
    "0.33333334326744 cup butter",
    "2 cups graham cracker crumbs",
    "1 (14 ounce) can condensed milk",
    "1 (8 ounce) package cream cheese, softened",
    "1 egg",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the butterscotch chips and butter together in a microwave-safe glass or ceramic bowl in 30-second intervals, stirring after each melting, for 1 to 3 minutes (depending on your microwave). Stir butterscotch chip mixture and graham cracker crumbs together in a bowl. Press 1/2 the graham cracker crumb mixture into the bottom of a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat condensed milk, cream cheese, egg, and vanilla extract with an electric mixer until light and fluffy. Pour cream cheese mixture over the graham cracker crumb mixture in the baking dish. Spread remaining 1/2 graham cracker mixture on top of cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, 25 to 30 minutes. Chill completely before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
