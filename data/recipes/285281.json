  "ingredients": [
    "0.75 pound fully cooked breaded chicken breast tenderloins",
    "1 cup mayonnaise",
    "1 cup sour cream",
    "0.5 cup Buffalo sauce, or to taste",
    "4 ounces crumbled blue cheese",
    "4 slices bacon strips, cooked and crumbled",
    "3 stalks green onions, sliced",
    "1 jalapeno pepper, seeded and minced"
  ],
  "steps": [
    {
      "text": "Dice cooked chicken tenders. Transfer to a large bowl and add mayonnaise, sour cream, Buffalo sauce, blue cheese, bacon, green onions, and jalapeno. Stir to combine.",
