  "ingredients": [
    "1 egg",
    "1.3329999446869 cups mashed ripe banana",
    "0.75 cup packed brown sugar",
    "0.33300000429153 cup applesauce",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "2 teaspoons baking powder",
    "1.25 teaspoons salt",
    "1 teaspoon ground cinnamon",
    "1 cup quick cooking oats",
    "0.5 cup semisweet chocolate chips",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease one 12 cup muffin pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine egg, banana, brown sugar, applesauce and vanilla. In a separate bowl, sift together flour, baking soda, baking powder, salt and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently stir flour mixture and oatmeal into banana mixture. Fold in chocolate chips and walnuts. Pour batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven or 15 to 20 minutes, or until light brown. Remove muffins from pan and place on a wire rack to let cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
