  "ingredients": [
    "2 eggs, lightly beaten",
    "0.25 cup canola oil",
    "2 cups buttermilk",
    "2 teaspoons baking soda",
    "0.5 cup wheat germ",
    "0.5 teaspoon salt",
    "1.5 cups whole wheat pastry flour"
  ],
  "steps": [
    {
      "text": "In a medium bowl, mix eggs with oil and buttermilk. Stir in baking soda, wheat germ, salt and flour; mix until blended.",
