  "ingredients": [
    "2 (15 ounce) cans baked beans with pork",
    "0.5 cup packed brown sugar",
    "0.5 medium onion, chopped",
    "0.5 cup ketchup",
    "1 tablespoon prepared mustard",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon red wine vinegar",
    "salt and pepper to taste",
    "2 slices bacon"
  ],
