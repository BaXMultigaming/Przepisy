  "ingredients": [
    "1 (16 ounce) package smoked sausage",
    "2 potatoes, cut into 1/4-inch slices",
    "0.75 cup chopped onion",
    "6 slices bacon",
    "1.5 teaspoons minced garlic",
    "2 cups kale - washed, dried, and shredded",
    "2 tablespoons chicken bouillon powder",
    "1 quart water",
    "0.33333298563957 cup heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange sausage links onto a baking sheet; bake in the preheated oven for 25 minutes, or until cooked through. Cut in half lengthwise, then cut at an angle into 1/2-inch slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place onions and bacon in a large saucepan; cook and stir over medium heat until bacon is crispy and onions are tender. Remove bacon and crumble; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add garlic; cook for 1 minute. Add bouillon powder, water, and potatoes; simmer for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add crumbled bacon, sausage, kale, and cream. Simmer for 4 minutes and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
