  "ingredients": [
    "2 cups shredded zucchini",
    "1 cup shredded carrot",
    "0.25 cup low-fat creamy salad dressing (such as Miracle Whip Light®)",
    "1 teaspoon white sugar",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place zucchini in a colander and let drain thoroughly, about 30 minutes.",
      "section": null,
      "name": null,
