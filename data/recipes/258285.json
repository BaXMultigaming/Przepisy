  "ingredients": [
    "2 tablespoons olive oil, divided",
    "2 sweet potatoes, peeled and diced",
    "1 clove garlic, minced",
    "0.5 teaspoon salt",
    "0.25 cup minced onion",
    "1 cup frozen corn, thawed",
    "1 tablespoon taco sauce",
    "1.5 teaspoons taco seasoning mix",
    "0.25 teaspoon ground coriander",
    "2 tablespoons water",
    "1 (15 ounce) can black beans, drained",
    "4 (8 inch) corn tortillas"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle 4 ½ teaspoons oil over sweet potatoes in a medium bowl. Add garlic and salt; toss to coat. Spread onto a rimmed baking sheet in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven, stirring every 15 minutes, until tender, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining 1 ½ teaspoons oil in a medium skillet over medium heat. Add onion; cook and stir until translucent, 5 to 10 minutes. Add corn; cook until beginning to brown, 5 to 8 minutes. Stir in taco sauce, taco seasoning, and coriander. Add water; bring to a simmer until slightly thickened, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir roasted sweet potatoes and black beans into the skillet until coated with sauce; divide among tortillas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
