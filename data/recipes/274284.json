  "ingredients": [
    "3 cups oats",
    "1.5 cups shredded coconut",
    "0.25 teaspoon ground cloves",
    "1.25 cups white sugar",
    "0.75 cup unsweetened cocoa powder",
    "0.5 cup milk",
    "0.5 cup applesauce",
    "0.25 cup butter",
    "2 teaspoons vanilla extract",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Mix oats, coconut, and cloves together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, cocoa powder, milk, applesauce, butter, vanilla extract, and salt in a pot. Bring mixture to a boil and continue boiling for 1 minute. Remove from heat and mix in the coconut mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop tablespoonfuls onto a parchment paper-lined tray. Refrigerate until set, then transfer to an airtight container and freeze to fully set.",
