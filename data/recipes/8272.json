  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix and peaches with juice in a large bowl until well combined. Pour batter into an ungreased 10x4-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is dark golden brown and cracks feel very dry and not sticky, 37 to 47 minutes.",
