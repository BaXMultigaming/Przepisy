  "ingredients": [
    "2 eggs",
    "0.5 cup white sugar",
    "1 cup chopped dates",
    "1 cup flaked coconut",
    "1 cup chopped walnuts",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl beat eggs with an electric mixer. Beat in sugar. Stir in dates, coconut, walnuts, vanilla and almond extract. Spoon mixture into a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven, and while mixture is still hot, beat well with a wooden spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When mixture is cool enough to handle, form into small balls and roll in granulated sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
