  "title": "Strawberry Shortcake",
  "description": "This strawberry shortcake features a biscuit-style shortcake layered with sweet strawberries and topped with cream for a sensational summertime treat.",
  "authors": [
    "Denyse"
  ],
  "date_published": "1999-04-17T13:25:53-04:00",
  "date_modified": "2026-04-13T12:24:22-04:00",
