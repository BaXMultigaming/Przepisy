  "ingredients": [
    "6 egg yolks",
    "6 tablespoons white sugar, divided",
    "0.5 teaspoon vanilla extract",
    "2.5 cups heavy cream",
    "2 tablespoons brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg yolks, 4 tablespoons white sugar, and vanilla extract in a mixing bowl until thick and creamy; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VGHwv67unNayZ1_SIzlcgipPy94=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19165-creme-brulee-step-1-210-3x4-f6b0c0cfb7d945bbb1c2390e2f13dfcf.jpg"
      ],
      "image": "assets/images/19165/step_02.webp"
    },
    {
      "text": "Pour cream into a saucepan and stir over low heat until it almost comes to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cream into egg yolk mixture; beat until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hbKN3Ne7k1K4hgiEeh2rJvIlwME=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19165-creme-brulee-step-2-221-3x4-cc453cc5341240bb9ae222c6d63e49d6.jpg"
      ],
      "image": "assets/images/19165/step_04.webp"
    },
    {
      "text": "Pour mixture into the top pan of a double boiler. Stir over simmering water until mixture lightly coats the back of a spoon, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-Q7NQh6MnLChwsnDViO3m8flVm8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19165-creme-brulee-step-3-234-3x4-ed6ae83fd9814fbcb643c4f78a5ffc21.jpg"
      ],
      "image": "assets/images/19165/step_05.webp"
    },
    {
      "text": "Pour into a shallow heat-proof dish or individual ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QiN0W1OXz1wLpJ_5JejQPvpCRh0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19165-creme-brulee-step-4-242-3x4-7c482aa1d6b141338ace93b61e2ba53f.jpg"
      ],
      "image": "assets/images/19165/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until custard is set but still slightly jiggly, about 30 minutes. Let cool to room temperature, then refrigerate until chilled, at least 1 hour or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bvb6Zs0AjFeO29K4Zyy83nSdfOg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19165-creme-brulee-step-5-385-3x4-d3986184bca84d55849a8ea36a47f4ee.jpg"
      ],
      "image": "assets/images/19165/step_07.webp"
    },
    {
      "text": "Turn the oven to broil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 2 tablespoons white sugar and brown sugar in a small bowl. Sprinkle mixture evenly over custard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wOazLL0ysavfJyfZiE48_75NXFU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19165-creme-brulee-step-6-393-3x4-2515f4afde904dfbb2d710cdd09da4f7.jpg"
      ],
      "image": "assets/images/19165/step_09.webp"
    },
    {
      "text": "Place dish under the broiler until sugar melts and caramelizes, about 2 minutes. Watch carefully so as not to burn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X_1Ng7eOvyNWwxmRnXEtYInL1ns=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19165-creme-brulee-step-7-399-3x4-bea8b3950001488a80712f36dff9caf8.jpg"
      ],
      "image": "assets/images/19165/step_10.webp"
    },
    {
      "text": "Allow to cool slightly, then refrigerate until custard is set again, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/URIYqea1Fkf0BiqnCspQ8riWvP0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19165-creme-brulee-DDMFS-4x3-87812f93c6bf43829e4f68dc598e7563.jpg"
      ],
      "image": "assets/images/19165/step_11.webp"
    }
  ],
