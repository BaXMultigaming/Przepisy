  "ingredients": [
    "1 cup flour",
    "0.5 cup low-calorie natural sweetener (such as Swerve®)",
    "1.5 teaspoons ground cinnamon",
    "1.25 teaspoons baking powder",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 large egg, at room temperature",
    "0.33 cup canola oil",
    "0.25 cup unsweetened applesauce",
    "0.25 cup honey",
    "1 cup chopped nuts",
    "0.75 cup powdered sugar substitute (such as Swerve®)",
    "2 tablespoons unsalted butter, melted",
    "2 tablespoons honey",
    "1 teaspoon almond milk",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 11x7-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sweetener, cinnamon, baking powder, baking soda, and salt in a large bowl; mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together egg, oil, applesauce, and honey in a second bowl until well combined. Stir into the dry ingredients. Fold in nuts. Transfer batter into the prepared baking dish and smooth out the surface.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 18 to 22 minutes. Remove from oven and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the icing, combine powdered sugar substitute, butter, honey, almond milk, vanilla, and cinnamon in a bowl. Spread or drizzle icing onto the cooled bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
