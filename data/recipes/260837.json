  "ingredients": [
    "1 cup light coconut milk",
    "1 (1 ounce) square dark chocolate, chopped",
    "1.5 teaspoons white sugar",
    "0.125 teaspoon curry powder"
  ],
  "steps": [
    {
      "text": "Heat coconut milk in a saucepan over medium-low heat until warm, 3 to 5 minutes. Add chocolate and sugar; whisk until incorporated and chocolate is melted. Pour mixture into a blender and add curry powder. Cover and hold lid down with a potholder; blend until smooth, about 15 seconds.",
