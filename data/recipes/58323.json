  "ingredients": [
    "1 small onion, finely chopped",
    "1 medium tomato, diced",
    "1 stalk celery, chopped",
    "1 green bell pepper, finely chopped",
    "1 cup shredded Cheddar cheese",
    "0.25 teaspoon chili powder",
    "0.25 teaspoon salt",
    "4 slices white bread"
  ],
  "steps": [
    {
      "text": "Preheat your oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the onion, tomato, celery, bell pepper, cheese, chili powder and salt. Arrange slices of bread on a baking sheet or broiling pan. Top each one with 1/4 of the mixture, spreading out to the edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil for 4 to 5 minutes, or until cheese melts. Watch closely to prevent burning. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
