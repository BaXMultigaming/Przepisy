  "ingredients": [
    "1 medium onion, coarsely chopped",
    "1 stalk celery, coarsely chopped",
    "1 medium carrot, coarsely chopped",
    "1 (12 pound) whole turkey, neck and giblets reserved",
    "2 tablespoons kosher salt",
    "1 tablespoon ground black pepper",
    "1 teaspoon cayenne pepper",
    "3 tablespoons butter",
    "4 sprigs fresh rosemary",
    "0.5 bunch fresh sage, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place onion, celery, and carrot in a large, shallow roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place turkey, breast-side up, on top of vegetables in the roasting pan. Pat outside and inside of turkey dry with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine salt, black pepper, and cayenne pepper in a small bowl. Season inside of turkey with about 1/3 of the salt mixture. Fold wing tips under bird.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small saucepan over medium heat until edges turn golden, about 2 minutes. Add rosemary and sage; cook and stir until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place rosemary and sage inside cavity of turkey; reserve melted butter. Tie turkey legs together with twine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush melted butter over turkey. Season with the remaining salt mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake turkey, uncovered, in the preheated oven until no longer pink at the bone and juices run clear, about 3 hours. An instant-read thermometer inserted into the thickest part of the thigh, near the bone should read 180 degrees F (82 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove turkey from the oven and allow to rest in a warm area for 10 to 15 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WJgwothDXFrpTlw10oi3TiV6tEs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222332-how-to-cook-a-turkey-ddmfs-1x1-1-7560311b7ccc4efc8ef0b065f346d966.jpg"
      ],
