  "ingredients": [
    "1 (5 ounce) skinless, boneless chicken breast half",
    "1 teaspoon olive oil",
    "1 teaspoon balsamic vinegar",
    "1 tablespoon brown sugar",
    "1 cup diced fresh peaches",
    "1 cup diced tomato",
    "0.5 cup sliced, seedless grapes",
    "0.5 cup diced red onion",
    "1 tablespoon lemon juice",
    "1 tablespoon honey"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub chicken breast with olive oil and vinegar; rub on brown sugar until becomes a nice glaze coating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill on the preheated grill until no longer pink in the center and the juices run clear, about 5 minutes per side; be careful not to let the brown sugar stick to the grill. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine peaches, tomato, grapes, onion, lemon juice, and honey in a bowl; mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dice chicken; serve on top of salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
