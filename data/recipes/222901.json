  "ingredients": [
    "2 tablespoons olive oil",
    "1 onion, diced",
    "1 carrot, diced",
    "4 thyme sprigs",
    "3 cloves garlic, minced",
    "0.5 teaspoon kosher salt",
    "0.5 teaspoon crushed red pepper flakes, or to taste",
    "ground black pepper to taste",
    "3 cups chicken broth",
    "1 (14.5 ounce) can diced tomatoes, undrained",
    "0.5 pound green lentils",
    "1 bunch dinosaur kale, stems removed and leaves roughly chopped",
    "1 lemon, zested and juiced"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a skillet over medium heat. Add onion and carrot; cook and stir until softened, about 4 minutes. Add thyme sprigs, garlic, ½ teaspoon salt, pepper flakes, and black pepper; cook and stir for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chicken broth, tomatoes and their juice, and lentils; cover skillet. Simmer until lentils are tender, about 40 minutes. Add kale, lemon zest, and lemon juice; cook until kale is wilted, about 5 minutes. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
