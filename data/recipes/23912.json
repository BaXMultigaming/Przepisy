  "ingredients": [
    "1 pound ground pork breakfast sausage",
    "2 cups shredded Cheddar cheese",
    "2 cups milk",
    "2 eggs",
    "2 pounds tater tots"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fVHMuZEjrEETf7aSSLbL4TuKzNA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23912-Sausage-Tater-Tot-Breakfast-Casserole-step-1-015-9816e578058a4140aa21c13b9c7a17d3.jpg"
      ],
      "image": "assets/images/23912/step_01.webp"
    },
    {
      "text": "Place sausage in a large, deep skillet. Cook over medium-high heat until evenly brown, about 5 to 7 minutes. Drain, and spread evenly in the bottom of a 9x13-inch pan. Sprinkle cheese over sausage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sNGxu7u7GXaQ4Fo806Wc6WYDsjI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23912-Sausage-Tater-Tot-Breakfast-Casserole-step-2-016-9b6bab680b654dc691bf58084c1c2d55.jpg"
      ],
      "image": "assets/images/23912/step_02.webp"
    },
    {
      "text": "Beat milk and eggs together in a large bowl. Pour over cheese. Casserole can be refrigerated overnight at this point if desired. Top with tater tots.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ALJ-whS08gOiBzdXLtSADKeNquQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23912-Sausage-Tater-Tot-Breakfast-Casserole-step-3-018-99c43fabf324404aad0e9e854e3cf7ec.jpg"
      ],
      "image": "assets/images/23912/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 35 to 45 minutes. Cool briefly before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1O4qZB77ist70BKeN4nnHcGigpo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23912-Sausage-Tater-Tot-Breakfast-Casserole-step-4-038-24fa4f91b2bb46eda4088c86e77d179f.jpg"
