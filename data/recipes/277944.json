  "ingredients": [
    "1 serving cooking spray (such as Pam®)",
    "2 pounds large shrimp, peeled and deveined",
    "3 tablespoons melted butter",
    "2 tablespoons Dijon mustard",
    "1 tablespoon lemon juice",
    "1 tablespoon honey",
    "1 teaspoon curry powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a shallow baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer shrimp in the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter, Dijon mustard, lemon juice, honey, curry powder, salt, and paprika together in a bowl. Pour over shrimp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until shrimp are no longer transparent, stirring twice, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
