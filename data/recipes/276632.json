  "title": "Chocolate Yogurt Cake",
  "description": "This chocolate yogurt cake, made with whole wheat flour, cocoa powder, and a touch of black coffee, keeps moist for several days if well wrapped.",
  "authors": [
    "Kristina Kopnisky"
  ],
