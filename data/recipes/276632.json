  "ingredients": [
    "1.5 cups full-fat yogurt",
    "1 cup white sugar",
    "0.5 cup canola oil",
    "3 eggs",
    "2 tablespoons brewed coffee",
    "1 teaspoon vanilla extract",
    "2.5 cups whole wheat flour",
    "0.5 cup cocoa powder",
    "2.5 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together yogurt, sugar, oil, eggs, coffee, and vanilla extract in a bowl. Add flour, cocoa powder, baking powder, cinnamon, baking soda, salt, and nutmeg; whisk until air bubbles form in batter. Pour batter into the prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 to 60 minutes. Cool on a wire rack for 15 minutes. Run a table knife around the edges to loosen. Invert carefully onto a serving plate or cooling rack. Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
