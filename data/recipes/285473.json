  "ingredients": [
    "1 (8 ounce) round Camembert cheese",
    "4 tablespoons orange juice",
    "2 tablespoons peeled, diced apples",
    "2 tablespoons finely chopped pecans",
    "0.25 teaspoon brown sugar",
    "0.125 teaspoon molasses",
    "1 pinch ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a sharp knife to remove the top rind from the Camembert; leave the rind on the sides and bottom. Place the cheese, cut-side up, in a baking dish just larger than the cheese, or in a Brie baker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine orange juice, apples, pecans, brown sugar, molasses, and cinnamon in a small microwave-safe dish and heat for in the microwave for 1 minute. Spread evenly over the top of the Camembert.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on the center rack of the preheated oven until gooey and soft in the middle, 15 to 20 minutes; do not overcook as it will turn buttery. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
