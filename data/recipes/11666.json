  "ingredients": [
    "1 (12 ounce) package farfalle pasta",
    "1 pound chorizo sausage, crumbled",
    "0.25 cup fresh basil leaves, cut into thin strips",
    "0.5 cup pine nuts",
    "2 cloves garlic, minced",
    "0.5 cup grated Parmesan cheese",
    "1 cup diced tomato",
    "0.5 cup olive oil",
    "0.25 cup red wine vinegar"
  ],
  "steps": [
    {
      "text": "Cook pasta in salted, boiling water until al dente.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the pasta is cooking, brown chorizo over medium heat. Add nuts and brown them also; do not burn! Add garlic, and remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta. In a large bowl, toss together pasta, chorizo mixture, basil, cheese, and tomatoes. Whisk together olive oil and vinegar; pour over pasta, and toss. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
