  "ingredients": [
    "cooking spray",
    "1 (6 ounce) can tuna, drained",
    "2 tablespoons all-purpose flour",
    "1 egg white",
    "0.125 teaspoon shredded mild Cheddar cheese",
    "4 peeled, cooked shrimp"
  ],
  "steps": [
