  "ingredients": [
    "1 cup bread flour",
    "1 cup oat flour",
    "2 tablespoons white sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1.6666667461395 cups unsweetened almond milk",
    "0.5 cup unsweetened applesauce",
    "0.33333334326744 cup coconut oil, melted",
    "0.5 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk bread flour, oat flour, sugar, baking powder, cinnamon, and salt together in a bowl. Mix almond milk, applesauce, and coconut oil together in a separate bowl; stir into flour mixture until batter is just combined. Fold chocolate chips into batter; let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop 1/4 to 1/2 cup batter into preheated waffle iron; cook according to manufacturer's instructions, about 4 minutes per waffle.",
