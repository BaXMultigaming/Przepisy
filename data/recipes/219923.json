  "steps": [
    {
      "text": "Place the pineapple chunks, pineapple juice, grape jelly, tomato paste, brown sugar, vinegar, cornstarch, Worcestershire sauce, hot pepper sauce, liquid smoke flavoring, and salt into a saucepan over medium heat. Stirring constantly, bring the sauce to a simmer, and cook until the grape jelly melts, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
