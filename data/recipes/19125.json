  "ingredients": [
    "1 tablespoon olive oil",
    "1 tablespoon minced garlic",
    "3 pounds skinless, boneless chicken breast halves",
    "1 tablespoon paprika",
    "1 cup brown sugar",
    "1 cup red wine",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat. Cook garlic in oil until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wIsjHLnwG_xevYpk2RByMVtCEoc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19125-chicken-and-red-wine-sauce-ddmfs-step-1-002-1d3311c917314db8963f598266677664.jpg"
      ],
      "image": "assets/images/19125/step_01.webp"
    },
    {
      "text": "Place chicken in the skillet, and cook for about 10 minutes on each side, until no longer pink and juices run clear. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7znM86FAqwh08Rl1re3jGHi9Epc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19125-chicken-and-red-wine-sauce-ddmfs-step-2-09-19f7550cd89e404cbdb4a237c4693582.jpg"
      ],
      "image": "assets/images/19125/step_02.webp"
    },
    {
      "text": "Drain oil from the skillet. Sprinkle chicken with paprika and brown sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8tLglvPGCNs6ggYbd-FAa-mGTVE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19125-chicken-and-red-wine-sauce-ddmfs-step-3-10-52a3249adae54188bfa67701fd22cf85.jpg"
      ],
      "image": "assets/images/19125/step_03.webp"
    },
    {
      "text": "Pour red wine around chicken. Cover and simmer, 15 to 20 minutes; lightly baste the chicken with wine sauce while cooking. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EEpNBAfhxCxmBAO51gHjPVLtwqM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19125-chicken-and-red-wine-sauce-ddmfs-step-5-12-60275100cc8b49d9a74fbf107c6e9b5b.jpg"
