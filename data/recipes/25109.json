  "ingredients": [
    "1 cup butter, softened",
    "1.75 cups white sugar",
    "4 eggs",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1 pinch salt",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter and sugar until light and fluffy. Beat in the egg and vanilla. Combine the flour, baking powder and salt; stir into the creamed mixture. Reserve 1 1/2 cups of the dough and spread the rest into the bottom of the prepared pan. Cover this layer evenly with cherry pie filling. Drop the rest of the dough by spoonfuls on top of the cherry layer and spread to cover the best you can.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 to 40 minutes in the preheated oven, until top is golden. Frost with a confectioners' glaze when cool for sweeter bars. Let cool completely before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
