  "ingredients": [
    "1 cup orange marmalade",
    "1 tablespoon curry powder",
    "1 teaspoon salt",
    "0.5 cup water",
    "4 bone-in chicken breast halves, with skin"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl combine the marmalade, curry powder, salt and water. Mix together. Place chicken pieces, cut side down, in a lightly greased 9x13 inch baking dish and spoon marmalade mixture over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered at 350 degrees F (175 degrees C) for 45 minutes, spooning sauce over chicken several times. (Note: If sauce begins to stick to the baking dish, add an additional 1/4 cup water).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from baking dish and skim fat off of the sauce. Serve sauce hot with the chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
