  "title": "Apple Crisp with Instant Oatmeal",
  "description": "Apples are topped with a brown sugar, instant oatmeal crust, sprinkled with walnuts, drizzled with maple syrup and baked until tender.",
  "authors": [
    "Gracia"
  ],
  "date_published": "2000-10-01T12:12:23-04:00",
