  "title": "Beer Battered Onion Rings",
  "description": "These crispy beer battered onion rings are easy to make with sliced onions and this simple batter recipe made with flour, eggs, beer, and seasonings.",
  "authors": [
    "kim"
  ],
  "date_published": "2000-08-21T18:28:37-04:00",
