  "ingredients": [
    "4 cups all-purpose flour",
    "1 cup butter, melted",
    "0.5 cup milk",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "3 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, 1 cup melted butter, milk, baking powder, and salt together in a bowl until begins to pull together. Turn dough out onto a lightly floured surface; knead until smooth and elastic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough out to ⅛-inch thickness; cut into 8-inch circles. Brush circles with remaining 3 tablespoons melted butter. Fold each circle in half, then fold in half again to form triangles. Press firmly to seal the layers; place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 15 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
