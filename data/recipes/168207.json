  "ingredients": [
    "2 cups white sugar",
    "0.5 cup kosher salt",
    "1 tablespoon monosodium glutamate (MSG)",
    "1 tablespoon ground oregano",
    "1 tablespoon ground basil",
    "3 tablespoons lemon pepper",
    "2 teaspoons garlic powder",
    "5 tablespoons onion powder",
    "1 tablespoon paprika",
