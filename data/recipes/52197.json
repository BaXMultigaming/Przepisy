  "ingredients": [
    "2 cups strong brewed coffee, room temperature",
    "2 cups skim milk",
    "1 (.55 ounce) package hot cocoa mix",
    "2 tablespoons white sugar",
    "1 banana, cut into chunks",
    "1 teaspoon vanilla extract",
    "10 ice cubes"
  ],
  "steps": [
    {
      "text": "In the container of a blender, combine the coffee, milk, hot cocoa mix, sugar, banana, vanilla and ice cubes. Cover and blend until smooth and frothy. Pour into glasses and serve immediately.",
