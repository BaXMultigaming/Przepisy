  "ingredients": [
    "1 pound dry great Northern beans",
    "0.5 pound cooked ham, diced",
    "1 small onion, diced",
    "0.5 cup brown sugar",
    "1 tablespoon dried parsley",
    "0.25 teaspoon cayenne pepper",
    "6 cups water, or as needed to cover",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e5JKRg0r1i4fvqMSyCmpTWxB0b8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-21403-ham-and-beans-ddmfs-4x3-step-01-ee21766a822742799233b9fa2b6b76f8.jpg"
      ],
      "image": "assets/images/21403/step_01.webp"
    },
    {
      "text": "Rinse beans; transfer to a large stockpot. Cover with cold water and let stand overnight or at least 8 hours. Drain and rinse beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bzYIuEyaCdLWHvwnutKvT7rKyJY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-21403-ham-and-beans-ddmfs-4x3-step-02-82b726ed2c374074a29829b9225858ff.jpg"
      ],
      "image": "assets/images/21403/step_02.webp"
    },
    {
      "text": "Return beans to stockpot; add ham, onion, sugar, parsley, and cayenne pepper. Pour in enough water to cover and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sIqdNKb6c5egqOgTU1HFkUCaoVg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-21403-ham-and-beans-ddmfs-4x3-step-03-1-6c6ebcdca3cf4518b2bc00d8159681b0.jpg"
      ],
      "image": "assets/images/21403/step_03.webp"
    },
    {
      "text": "Bring to a boil; reduce heat to low and simmer until beans are tender, adding more water if needed, about 1 1/2 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BE5vD3o5sBJHZXft3FePv7aTifU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-21403-ham-and-beans-ddmfs-4x3-step-04-a9fd052611214deab77e3cd5aad193bf.jpg"
      ],
      "image": "assets/images/21403/step_04.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lCPXql_f0CNn0Z5D63ChEok23mI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-21403-ham-and-beans-ddmfs-4x3-beauty-8db84c6c900e45178ac8aae7a94d453b.jpg"
