  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup rolled oats",
    "0.5 cup packed light brown sugar",
    "0.25 teaspoon baking soda",
    "0.125 teaspoon salt",
    "0.5 cup butter, softened",
    "0.75 cup seedless raspberry jam"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch square pan; line with greased foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tJih_QJ2bLHkJFH54AlDE2J-ZCE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11314-delicious-raspberry-oatmeal-cookie-bars-DDMFS-step-01-550ccc5e72ce42b29ad33052689f21e7.jpg"
      ],
      "image": "assets/images/11314/step_01.webp"
    },
    {
      "text": "Combine flour, oats, brown sugar, baking soda, and salt in a large bowl. Rub in butter using your hands or a pastry blender to form a crumbly mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Yz542_jekpzwUvAqqQj_W2d74QE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11314-delicious-raspberry-oatmeal-cookie-bars-DDMFS-step-02-97270d4b81554d5e84325577a95de756.jpg"
      ],
      "image": "assets/images/11314/step_02.webp"
    },
    {
      "text": "Press 2 cups oat mixture into the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Fc1Oe5_tq6b4HHEDeHzVkOUooXI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11314-delicious-raspberry-oatmeal-cookie-bars-DDMFS-step-03-2f94e4bf660b45caa27dc59b1e624a35.jpg"
      ],
      "image": "assets/images/11314/step_03.webp"
    },
    {
      "text": "Spread jam to within 1/4 inch of the edge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7p6rebWj1x467ZJwqJOsCNSimJ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11314-delicious-raspberry-oatmeal-cookie-bars-DDMFS-step-04-1fc318557ed54b1c82ec31ffd1b616a5.jpg"
      ],
      "image": "assets/images/11314/step_04.webp"
    },
    {
      "text": "Sprinkle remaining crumb mixture on top; press down lightly into jam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hzY689LOUsraNomMZZrAvS_Hz8M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11314-delicious-raspberry-oatmeal-cookie-bars-DDMFS-step-05-dc10da1bbb2d4d64a4de3eb71ff5252f.jpg"
      ],
      "image": "assets/images/11314/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 35 to 40 minutes.",
