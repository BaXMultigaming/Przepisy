  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 tablespoon white sugar",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "2 cups milk",
    "2 tablespoons butter, melted",
    "0.5 teaspoon vanilla extract",
    "2 large eggs"
  ],
  "steps": [
    {
      "text": "Sift together flour, sugar, baking powder, and salt in a large bowl. Stir in milk, butter, and vanilla. Add in eggs and mix until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle or frying pan over medium-high heat. Pour or scoop the batter onto the griddle, using approximately 1/4 cup for each crêpe. Tilt the pan with a circular motion so that the batter coats the surface evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook the crêpe for about 2 minutes, until the bottom is light brown. Loosen with a spatula, turn and cook the other side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stack the finished crêpes by putting wax paper between each one. Keep covered with a dry cloth until ready to eat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
