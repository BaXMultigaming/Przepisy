  "title": "Creamy Roasted Parsnip Soup",
  "description": "This parsnip soup is a delicious blend of roasted root vegetables, garlic, warm spices, and cream for a smooth, flavor-packed, cozy cold-weather soup.",
  "authors": [
    "Alan Dorchak"
  ],
  "date_published": "2020-03-05T00:05:29-05:00",
  "date_modified": "2026-04-22T22:34:42-04:00",
