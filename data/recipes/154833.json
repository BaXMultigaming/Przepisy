    "British"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 pounds parsnips, peeled and cut into 1/2 inch pieces",
    "3 carrots, peeled and cut into 1/2-inch pieces",
    "1 tablespoon olive oil",
    "sea salt and ground black pepper to taste",
    "1 large onion, diced",
    "3 stalks celery, diced",
    "1 tablespoon butter",
    "1 tablespoon brown sugar",
    "3 cloves garlic, minced",
    "1 teaspoon ground ginger",
    "0.5 teaspoon ground cardamom",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon cayenne pepper",
    "4 cups chicken stock",
    "1 cup whole milk",
    "0.5 cup heavy cream"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/isDZLZdQnD2z787309qQtS35-rE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-154833-creamy-roasted-parsnip-soup-VAT-step-01-2188f6b9b19c40e2b3940877589aaf4d.jpg"
      ],
      "image": "assets/images/154833/step_01.webp"
    },
    {
      "text": "Place parsnips and carrots in a mixing bowl; sprinkle with 1 tablespoon olive oil and toss to coat. Season with salt and pepper. Spread vegetables evenly onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Zvkug1oEHMx28ZGiEZih9W99gzU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-154833-creamy-roasted-parsnip-soup-VAT-step-02-ae74f5bce73a48399b779c81a6a3d07b.jpg"
      ],
      "image": "assets/images/154833/step_02.webp"
    },
    {
      "text": "Roast in the preheated oven until vegetables are tender and parsnips are golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9PauWCeZhrSWOs-5eCi8pT9vPVc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-154833-creamy-roasted-parsnip-soup-VAT-step-03-ae80f38c8e28421597f99ab4f6490611.jpg"
      ],
      "image": "assets/images/154833/step_03.webp"
    },
    {
      "text": "Heat remaining 1 tablespoon olive oil in a large saucepan over medium heat. Cook and stir onion and celery in hot oil until softened and onion is beginning to turn golden brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ka2I67EFlG5en19IcXt9xOgADrs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-154833-creamy-roasted-parsnip-soup-VAT-step-04-17888eaecc384fc0bb1453422149a5a6.jpg"
      ],
      "image": "assets/images/154833/step_04.webp"
    },
    {
      "text": "Reduce heat to low; stir in butter, brown sugar, garlic, and roasted parsnips and carrots. Continue to cook and stir until vegetables are very soft and beginning to brown, about 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ja8tu12V2Z5MdF3vgCq-sVdD5r4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-154833-creamy-roasted-parsnip-soup-VAT-step-05-7647ba0936614a2c8b183e359552002a.jpg"
      ],
      "image": "assets/images/154833/step_05.webp"
    },
    {
      "text": "Season with ginger, cardamom, allspice, nutmeg, and cayenne pepper; stir for 1 minute. Pour in chicken stock; bring to a boil over medium-high heat. Reduce heat to medium-low, partially cover, and simmer gently for 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MXcafZIGzJ6zs5lVzumR2g3JKHE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-154833-creamy-roasted-parsnip-soup-VAT-step-06-990673530df942718d7e16748586211d.jpg"
      ],
      "image": "assets/images/154833/step_06.webp"
    },
    {
      "text": "Working in batches, pour soup into a blender, filling the pitcher no more than halfway full. Hold down the lid of the blender with a folded kitchen towel and carefully start the blender, using a few quick pulses to get soup moving before leaving it on to purée.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_55NoZRH_3DCvYjVkeSVKbL4sy4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-154833-creamy-roasted-parsnip-soup-VAT-step-07-377511b7144d4246a638726484203ba1.jpg"
      ],
      "image": "assets/images/154833/step_07.webp"
    },
    {
      "text": "Pour blended soup into a clean pot. Stir in milk and cream. Return to a simmer over medium-low heat. Season with salt and pepper to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IzuP7TaRgPpjMw3U9MAP1oBAK5s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-154833-creamy-roasted-parsnip-soup-VAT-step-08-1c82d4982c1d44918bc6b9630603d0d0.jpg"
      ],
      "image": "assets/images/154833/step_08.webp"
    }
  ],
