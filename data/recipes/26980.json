  "ingredients": [
    "1 (12 ounce) package crispy corn and rice cereal (such as Crispix®)",
    "6 ounces toasted, chopped pecans",
    "5 ounces slivered almonds",
    "1.5 cups light brown sugar",
    "0.75 cup butter",
    "0.75 cup dark corn syrup"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 250 degrees F (120 degrees C). Lightly grease a large roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cWcYQu9VkK81ZhnsUzyIsqVQr3w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26980-sweet-party-mix-DDMFS-step-01-0e58f26a9e9b41bdb15c325728da4fa8.jpg"
      ],
      "image": "assets/images/26980/step_01.webp"
    },
    {
      "text": "Mix cereal, pecans, and almonds together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AcIf_ERYU7lKams4KbA_1y6nKa0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26980-sweet-party-mix-DDMFS-step-02-02993a0a05fc4382b92f1dc2a2bb4c08.jpg"
      ],
      "image": "assets/images/26980/step_02.webp"
    },
    {
      "text": "Mix brown sugar, butter, and corn syrup in a saucepan and bring to a boil. Boil 2 minutes, stirring constantly. Pour over cereal and nuts and mix until well coated. Transfer to the prepared roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FPxOsI6oDYJIWz29jXgTk91_QAM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26980-sweet-party-mix-DDMFS-step-03-f2f9824e6ff940338e8c6145bfa9c22b.jpg"
      ],
      "image": "assets/images/26980/step_03.webp"
    },
    {
      "text": "Cook in the preheated oven for 1 hour, stirring every 15 minutes. Remove from the oven and spoon onto parchment paper to cool. Store in airtight containers for up to 2 weeks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F61R0L0XSFxrVTpmLKPP1rKyl4g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26980-sweet-party-mix-DDMFS-step-04-2c8511c00f7e407e9379a75395a0fbd7.jpg"
