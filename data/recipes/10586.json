  "ingredients": [
    "1 cup butter",
    "1 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2 tablespoons milk",
    "2.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together butter or margarine and white sugar. Add egg, vanilla and milk. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually add flour, baking soda and salt. Mix well. Roll spoonfuls of dough in your hands and dip one end in colored sugar. Place on baking sheets and press top down with a glass. Bake for 12 minutes.",
      "section": null,
