  "title": "Easy Gluten-Free Carrot Cake",
  "description": "This gluten-free carrot cake is easy to make with everyday ingredients for a moist and tender cake and a delicious Easter treat everyone can enjoy!",
  "authors": [
    "SueAnne McInnis"
  ],
  "date_published": "2020-06-19T00:21:03-04:00",
  "date_modified": "2026-04-14T23:54:46-04:00",
  "prep_time": "PT20M",
