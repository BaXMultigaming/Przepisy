  "ingredients": [
    "1 (11.5 ounce) can condensed bean with bacon soup",
    "1 cup sour cream",
    "1 cup shredded Cheddar cheese",
    "1 tablespoon minced onion",
    "1 tablespoon taco seasoning mix"
  ],
  "steps": [
    {
      "text": "Stir soup, sour cream, Cheddar cheese, onion, and taco seasoning together in a microwave-safe bowl. Microwave on high until hot, 3 to 5 minutes. Stir and microwave again until cheese melts and mixture is bubbling, 3 to 5 minutes more.",
