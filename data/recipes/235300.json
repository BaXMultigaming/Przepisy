  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 cup butter, softened",
    "0.25 cup white sugar",
    "8 ounces cream cheese",
    "0.25 cup white sugar",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1 (15 ounce) can pumpkin puree",
    "1 (12 ounce) can evaporated milk",
    "0.75 cup white sugar",
    "2 eggs",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, butter, and 1/4 cup sugar together in a bowl until dough is well-blended. Pat dough into the bottom of a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is lightly golden, 10 to 15 minutes. Cool. Reduce oven temperature to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, 1/4 cup sugar, 1 egg, and vanilla together in a bowl with an electric mixer until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk pumpkin puree, evaporated milk, 3/4 cup sugar, 2 eggs, cinnamon, salt, ginger, and cloves together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cream cheese mixture evenly over cooled crust. Pour pumpkin mixture over cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bars are set, about 60 minutes. Cool to room temperature, then refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
