  "ingredients": [
    "1 cup mayonnaise",
    "1 cup buttermilk",
    "1 tablespoon dried parsley",
    "1 teaspoon garlic powder",
    "1 teaspoon salt",
    "0.5 teaspoon onion powder",
    "0.25 teaspoon dried dill weed",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Whisk mayonnaise and buttermilk in a medium bowl until smooth. Add parsley, garlic powder, salt, onion powder, dill, and pepper. Whisk until blended together. Place in the refrigerator until flavors have melded, about 20 minutes.",
