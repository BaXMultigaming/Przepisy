  "ingredients": [
    "0.25 cup brown sugar",
    "0.25 cup light corn syrup",
    "2 tablespoons butter",
    "0.5 cup peanut butter",
    "0.5 cup evaporated milk",
    "4 large marshmallows",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Stir brown sugar, corn syrup, and butter together in a small saucepan over low heat until butter is melted and mixture is combined, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add peanut butter, evaporated milk, and marshmallows; cook, stirring constantly, until marshmallows are melted and mixture is smooth, 3 to 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir vanilla into peanut butter mixture, remove from heat, and transfer mixture to a fondue pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
