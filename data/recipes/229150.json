  "ingredients": [
    "1 pound sliced bacon, diced",
    "1 medium sweet onion, chopped",
    "9 large eggs, lightly beaten",
    "4 cups frozen shredded hash brown potatoes, thawed",
    "2 cups shredded Cheddar cheese",
    "1.5 cups small curd cottage cheese",
    "1.25 cups shredded Swiss cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nQP0zlfEei0_yHEApl9iD4tW4oE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-229150-Cheesy-Amish-Breakfast-Casserole-ddmfs-step-1-9a25138000be4fd6ae0e90924af45b6e.jpg"
      ],
      "image": "assets/images/229150/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat; cook and stir bacon and onion until bacon is evenly browned, about 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/etsYpkb6HuMGIwEuoVFjX5MCLkY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-229150-Cheesy-Amish-Breakfast-Casserole-ddmfs-step-2-519963131a9a4135aa6d9d53ebb5a9bd.jpg"
      ],
      "image": "assets/images/229150/step_02.webp"
    },
    {
      "text": "Transfer bacon and onion to a large bowl. Stir in eggs, potatoes, Cheddar cheese, cottage cheese, and Swiss cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8gkEsEp8e1qcTtw6iNuxzKu7jsI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-229150-Cheesy-Amish-Breakfast-Casserole-ddmfs-step-3-B-a15397503fc54349a575d2f8e49d21ef.jpg"
      ],
      "image": "assets/images/229150/step_03.webp"
    },
    {
      "text": "Pour mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mgmjtXexkpWoifm4qyJeoW9X7m0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-229150-Cheesy-Amish-Breakfast-Casserole-ddmfs-step-4-2b8457592efe46909ce57fe994497c1b.jpg"
      ],
      "image": "assets/images/229150/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until eggs are set and cheese is melted, 45 to 50 minutes. Let stand 10 minutes before cutting and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NwW--lk2SUJDcqIKsf7uZT95Vlw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229150-cheesy-amish-breakfast-casserole-VAT-014-4x3-C-62d6117a7791429fa747326353421891.jpg"
      ],
