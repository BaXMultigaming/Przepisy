  "ingredients": [
    "1 tablespoon canola oil",
    "2 tablespoons minced fresh ginger",
    "1.5 pounds swai fish",
    "0.5 cup reduced-sodium soy sauce",
    "0.5 cup water",
    "0.5 cup chopped scallions",
    "0.5 cup chopped fresh cilantro",
    "1 teaspoon seasoned rice vinegar"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet with high sides over medium heat. Add ginger and sauté until fragrant, 30 to 60 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add fish fillets, soy sauce, water, scallions, cilantro, and vinegar to the skillet. Bring to a boil and cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and let sit until fish flakes easily with a fork, 10 to 15 minutes.",
