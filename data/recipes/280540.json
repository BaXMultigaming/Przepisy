  "ingredients": [
    "2 teaspoons olive oil",
    "1 small zucchini, roughly chopped",
    "1 small yellow squash, roughly chopped",
    "0.5 red bell pepper, roughly chopped",
    "0.5 green bell pepper, roughly chopped",
    "0.25 cup roughly chopped red onion",
    "4 cups fresh corn kernels",
    "2 teaspoons white sugar",
    "1 teaspoon margarine",
    "0.5 teaspoon dried basil",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Heat oil in large pan over medium-high heat. Add zucchini, squash, bell peppers, and red onion and cook until just tender, 5 to 7 minutes. Remove from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir corn, sugar, margarine, basil, and salt into the pan and cook over medium-high heat for 5 minutes. Gently fold in sauteed vegetables using a large spoon. Remove from heat and let cool for 10 minutes before serving.",
      "section": null,
