  "ingredients": [
    "3 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "1 cup butter, at room temperature",
    "1 cup brown sugar, packed",
    "3 eggs",
    "0.5 cup milk",
    "2 tablespoons vanilla-flavored cream sherry",
    "7 cups chopped mixed nuts",
    "1 pound candied pineapple, coarsely chopped",
    "1 pound red and green candied cherries, chopped",
    "2 cups pitted chopped dates",
    "2 cups chopped raisins"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C). Grease several baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IyaVxSzOqaL3fenIrcVKwSfROIU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-212840-my-grandmas-fruitcake-cookies-VAT-step-01-b649f0c53a4b4275a7632e246cc5a4b0.jpg"
      ],
      "image": "assets/images/212840/step_01.webp"
    },
    {
      "text": "Sift flour, cinnamon, and baking soda into a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PZtnwIGPxCp-BhajOwAnQZsuUMs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-212840-my-grandmas-fruitcake-cookies-VAT-step-02-e2660e6713c14aa582166d9b8d8e780b.jpg"
      ],
      "image": "assets/images/212840/step_02.webp"
    },
    {
      "text": "Beat butter and sugar together in a separate large bowl with an electric mixer until fluffy, about 5 minutes. Add eggs one at a time, beating well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jLuRhC2CqMRzRXCAuipHHSbDxsg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-212840-my-grandmas-fruitcake-cookies-VAT-step-03-5eacab4f1d884788a2347c0ac38e7ee2.jpg"
      ],
      "image": "assets/images/212840/step_03.webp"
    },
    {
      "text": "Add flour mixture in batches, alternating with about 2 tablespoons of milk, beating batter briefly after each addition until the mixture is soft. Beat in sherry, then stir in nuts, pineapple, cherries, dates, and raisins until thoroughly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BI013VpXHGcZ9GmNlWcfQlkO-J0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-212840-my-grandmas-fruitcake-cookies-VAT-step-04-8c9f5db144e8462695c8abff93fda2a7.jpg"
      ],
      "image": "assets/images/212840/step_04.webp"
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_Jh8nS-gEtk99MpU81nm4RYONZ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-212840-my-grandmas-fruitcake-cookies-VAT-step-05-fabde748a0974654927d1af3a08cc0b6.jpg"
      ],
      "image": "assets/images/212840/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until the cookies are set and the bottoms are very lightly browned, about 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m8VT4p4CM7aUQA_tD5RSf4_E48g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-212840-my-grandmas-fruitcake-cookies-VAT-step-06-78e47e4883b740e2a81993cabdadc665.jpg"
      ],
      "image": "assets/images/212840/step_06.webp"
    },
    {
      "text": "Cool on the baking sheet briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x1rDVzlGMFLRP2I6YXIAOfNbvqk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-212840-my-grandmas-fruitcake-cookies-VAT-step-07-b45112787e864756bba7fb566299c40e.jpg"
      ],
      "image": "assets/images/212840/step_07.webp"
    }
