  "title": "My Grandma's Fruitcake Cookies",
  "description": "These fruitcake cookies have lots of nuts, dates, candied pineapple and cherries, and sherry. The perfect holiday gift for all fruitcake lovers!",
  "authors": [
    "minky410"
  ],
  "date_published": "2020-03-05T00:07:03-05:00",
