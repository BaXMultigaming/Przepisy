  "ingredients": [
    "0.33333334326744 cup milk",
    "2 tablespoons unsalted butter",
    "15 large marshmallows",
    "1 teaspoon vanilla extract",
    "2 medium lemons, zested and juiced"
  ],
  "steps": [
    {
      "text": "Heat milk and butter in a medium saucepan over medium heat. When mixture starts to steam, whisk in marshmallows and vanilla until completely melted. Whisk in lemon zest and juice; mixture should be bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk continuously for 2 minutes, making sure no burning or sticking occurs, until glaze coats the back of a spoon.",
