  "ingredients": [
    "3 tablespoons white sugar",
    "1 tablespoon ground cinnamon",
    "1 cup dark brown sugar",
    "0.5 cup white sugar",
    "1 cup butter, softened",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "2.5 cups all-purpose flour",
    "0.75 teaspoon baking soda",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1ayfVdcolCnwgbXNKzCUmS-3aZY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11310-cinnamon-sugar-butter-cookies-ddmfs-steps-4x3_6575-4e71837978bd418da4a841f8c50cf04d.jpg"
      ],
      "image": "assets/images/11310/step_01.webp"
    },
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 3 tablespoons white sugar and cinnamon in a small bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ptvU3ksp9l4K4L1zmW1zz8xz6o4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11310-cinnamon-sugar-butter-cookies-ddmfs-step02-4x3_6579-fc312808e3294a69bf0064cc2aaf246f.jpg"
      ],
      "image": "assets/images/11310/step_03.webp"
    },
    {
      "text": "Blend brown sugar and 1/2 cup white sugar in a large bowl with a mixer on medium speed. Add butter and blend until grainy. Add eggs and vanilla, mixing until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hk6BD48WYYxDr_U-M-DLPz0CrpI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11310-cinnamon-sugar-butter-cookies-ddmfs-step05-4x3_6585-6f416d80c667497ebe8dc7a73b29b6d3.jpg"
      ],
      "image": "assets/images/11310/step_04.webp"
    },
    {
      "text": "Whisk flour, baking soda, and salt together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rosiRFw2twi1HPKN26QLUTEwtLc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11310-cinnamon-sugar-butter-cookies-ddmfs-step05-4x3_6586-fbda09c55cf641f091cf7b829d8d74fc.jpg"
      ],
      "image": "assets/images/11310/step_05.webp"
    },
    {
      "text": "Add to butter-sugar mixture, mixing at low speed just long enough to combine. Overmixing makes tough cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vl4KdiFvBRoq4d3CdGRUgwP0XFE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11310-cinnamon-sugar-butter-cookies-ddmfs-step06-4x3_6587-4a691da99d464b708317c0c86a546913.jpg"
      ],
      "image": "assets/images/11310/step_06.webp"
    },
    {
      "text": "Roll dough into 1-inch balls, then roll each ball into cinnamon sugar to coat. Place cookies on ungreased cookie sheets",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vKSIWl_SRRbU4Y6w9NxZ9m0oktg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11310-cinnamon-sugar-butter-cookies-ddmfs-step07-4x3_6593-216cb95a63fa4c72b698c6bf701026ee.jpg"
      ],
      "image": "assets/images/11310/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven for 18 to 20 minutes. Remove from sheets and let cool on racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dDulmu2l-dlck_aeNlZR801Z-Tc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11310-cinnamon-sugar-butter-cookies-ddmfs-step09-4x3_6610-8b2d04d487d44962b93c6a2d56c766c6.jpg"
      ],
      "image": "assets/images/11310/step_08.webp"
    }
  ],
