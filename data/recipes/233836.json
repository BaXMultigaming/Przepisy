  "ingredients": [
    "1 bag Minute® Multi-Grain Medley, uncooked",
    "1 cup vegetable broth",
    "2 tablespoons olive oil",
    "1 tablespoon fresh lemon juice",
    "1 tablespoon shallots, minced",
    "0.25 teaspoon Dijon-style mustard",
    "0.5 cup chopped fresh parsley",
    "0.5 cup cucumber, peeled, seeded, and chopped",
    "0.5 cup cherry tomatoes, halved",
    "2 green onions, sliced",
    "1 tablespoon fresh mint leaves, chopped",
    "Salt and ground black pepper, to taste",
    "0.25 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Prepare Multi-Grain Medley according to package directions, substituting broth for water. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl whisk together olive oil, lemon juice, shallots and mustard. Fold in Multi-Grain Medley and remaining ingredients. Season with salt and pepper to taste. If desired, top with feta cheese.",
      "section": null,
      "name": null,
      "url": null,
