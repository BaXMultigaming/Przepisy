  "ingredients": [
    "1 tablespoon vegetable oil",
    "0.5 pound boneless chicken breasts, thinly sliced",
    "0.25 cup chopped onion",
    "1 tablespoon grated ginger",
    "2 cloves garlic, minced",
    "8 cups chicken broth, or more to taste",
    "12 frozen pot stickers",
    "6 cups chopped mustard cabbage (mustard leaves)",
    "2 (3 ounce) packages ramen noodles (without flavor packet)",
    "1 teaspoon soy sauce, or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a 4-quart pot over medium-high heat. Add chicken, onion, ginger, and garlic. Stir-fry until chicken is no longer pink inside, 6 to 7 minutes. Pour in broth and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pot stickers; cook until heated through, about 5 minutes. Add mustard greens and noodles and cook until tender, about 5 minutes. Season with soy sauce, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
