  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour, divided",
    "1 (15 ounce) can mashed sweet potatoes",
    "1 cup packed light brown sugar",
    "0.5 cup whole milk",
    "0.33333334326744 cup vegetable oil",
    "2 large eggs",
    "1 tablespoon baking powder",
    "1 teaspoon ground cinnamon",
    "1 teaspoon grated orange zest",
    "0.25 teaspoon salt",
    "0.25 teaspoon baking soda",
    "1 (8 ounce) can pineapple tidbits, drained"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a 9x5-inch loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 cup flour, sweet potatoes, brown sugar, milk, vegetable oil, eggs, baking powder, cinnamon, orange zest, salt, and baking soda together in a bowl using an electric mixer until batter is smooth, about 2 minutes. Stir remaining 1 cup flour into batter; fold in pineapple. Pour batter into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center of the bread comes out clean, 55 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
