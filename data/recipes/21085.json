  "ingredients": [
    "1 (10 ounce) jar apple jelly",
    "1 (10 ounce) jar pineapple fruit preserves",
    "1 (8 ounce) jar prepared horseradish",
    "1 tablespoon ground dry mustard",
    "1 teaspoon cracked black pepper",
    "1/4 teaspoon crushed red pepper"
  ],
  "steps": [
    {
      "text": "Mix apple jelly, pineapple fruit preserves, prepared horseradish, ground dry mustard, cracked black pepper, and crushed red pepper together in a small bowl. Cover and refrigerate 8 hours, or overnight, before serving.",
