  "ingredients": [
    "3 cups chopped fresh basil",
    "1 cup extra virgin olive oil",
    "0.5 cup pine nuts",
    "0.125 cup Brazil nuts",
    "0.66666668653488 cup grated Parmesan cheese",
    "2 tablespoons minced garlic",
    "0.5 teaspoon chili powder"
  ],
  "steps": [
    {
      "text": "Place the basil in a blender. Pour in about 1 tablespoon of the oil, and blend basil into a paste. Gradually add pine nuts, Brazil nuts, Parmesan cheese, garlic, chili powder, and remaining oil. Continue to blend until smooth.",
