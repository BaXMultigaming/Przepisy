  "ingredients": [
    "2 teaspoons kosher salt, or more to taste",
    "2 teaspoons paprika",
    "2 teaspoons garam masala",
    "1.5 teaspoons ground cumin",
    "1 teaspoon ground coriander",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon ground turmeric",
    "2 pounds boneless, skinless chicken thighs",
    "1 tablespoon vegetable oil",
    "2 tablespoons butter, divided",
    "1 yellow onion, chopped",
    "4 garlic cloves, minced",
    "2 tablespoons tomato paste",
    "1 tablespoon minced fresh ginger root",
    "1 cup chicken broth",
    "2 cups cold water",
    "0.75 cup whole roasted cashews",
    "0.33333334326744 cup sliced green onions",
    "0.33333334326744 cup freshly chopped cilantro",
    "1 lime, juiced"
  ],
  "steps": [
    {
      "text": "Mix salt, paprika, garam masala, cumin, coriander, cayenne, and turmeric together in a small bowl. Set spice mix aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut one chicken thigh in half lengthwise along the crease. Halve the thicker portion to end up with three 2-inch pieces. Repeat with the remaining chicken thighs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken to a bowl. Add oil and about 1/2 of the spice blend; mix thoroughly. Cover with plastic wrap and marinate in the refrigerator for 4 to 12 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to cook, heat 1 tablespoon butter in a large pan over high heat until melted and golden brown. Add chicken in a single layer and cook until browned, 4 to 5 minutes per side. Return chicken and any accumulated juices to the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining butter in the same pan over medium-high heat. Add onion, garlic, tomato paste, ginger, and the remaining spice blend. Cook and stir until fragrant, 2 to 3 minutes. Pour in chicken broth and bring to a simmer. Add chicken and any accumulated juices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water and cashews in a blender; blend on high speed until very smooth, then stir into the pan. Reduce the heat to medium and simmer until flavors blend, 15 to 20 minutes. Stir in green onions and cilantro; taste for seasoning. Squeeze in lime juice.",
      "section": null,
      "name": null,
      "url": null,
