  "ingredients": [
    "0.5 cup balsamic vinegar",
    "2 tablespoons steak seasoning rub",
    "0.5 cup olive oil",
    "2 pounds boneless pork loin roast"
  ],
  "steps": [
    {
      "text": "Combine vinegar and steak seasoning in a medium bowl; stir until seasoning is dissolved. Stir in olive oil until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork into a resealable plastic bag, then pour marinade over pork. Squeeze out air and seal the bag; marinate in the refrigerator for 2 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to cook, preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork into a glass baking dish along with marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, basting occasionally, until an instant-read thermometer inserted into the center of the tenderloin reaches an internal temperature of 145 degrees F (65 degrees C), about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let rest for 10 minutes before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
