  "ingredients": [
    "4 quarts popped popcorn",
    "1 cup brown sugar",
    "0.5 cup butter or margarine",
    "0.25 cup light corn syrup",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
