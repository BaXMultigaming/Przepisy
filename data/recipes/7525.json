  "title": "Honey Cake II",
  "description": "This honey cake is flavored with coffee, almonds, and raisins. Drizzle with a honey glaze, if desired.",
  "authors": [
    "Sandy in Baltimore"
  ],
  "date_published": "1998-05-19T19:20:49-04:00",
