  "ingredients": [
    "3 cups chicken stock",
    "1 tablespoon tom yum paste",
    "0.5 clove garlic, finely chopped",
    "3 stalks lemon grass, chopped",
    "2 makrut lime leaves",
    "2 skinless, boneless chicken breast halves - shredded",
    "4 ounces fresh mushrooms, thinly sliced",
    "1 tablespoon fish sauce",
    "1 tablespoon lime juice",
    "1 teaspoon chopped green chile pepper",
    "1 bunch fresh coriander, chopped",
    "1 sprig fresh basil, chopped"
  ],
  "steps": [
    {
      "text": "Bring the chicken stock to a boil in a large saucepan. Stir in the tom yum paste and garlic, and cook for about 2 minutes. Stir in the lemon grass and lime leaves. Place the chicken in the saucepan, and cook 5 minutes, or until no longer pink and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in the mushrooms. Add the fish sauce, lime juice, and green chile pepper. Continue cooking until well blended. Remove from heat, and serve warm with the coriander and basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
