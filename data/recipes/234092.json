  "title": "Brined Thanksgiving Turkey",
  "description": "This holiday turkey recipe uses apple juice and chicken stock in a brine and apples, onion, and garlic to stuff the bird, lending a hint of aromatic fruitiness to the centerpiece of your big meal.",
  "authors": [
    "terrwyn"
  ],
  "date_published": "2020-03-05T00:10:57-05:00",
  "date_modified": "2023-12-05T13:05:49-05:00",
  "prep_time": "PT30M",
  "cook_time": "PT390M",
  "total_time": "PT1860M",
  "yield": [
    "12",
    "1 20-pound turkey"
  ],
