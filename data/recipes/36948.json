  "ingredients": [
    "1.5 pounds ground beef",
    "0.5 pound ground pork",
    "3 slices bread, broken up into small pieces",
    "1 small onion, finely chopped",
    "2 stalks celery, finely chopped",
    "2 large eggs, lightly beaten",
    "3 tablespoons soy sauce",
    "2 tablespoons hoisin sauce",
    "1 tablespoon minced fresh ginger",
    "0.5 cup hoisin sauce",
    "2 tablespoons ketchup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the meatloaf: Mix beef, pork, bread crumbs, onion, celery, eggs, soy sauce, hoisin, and ginger together in a bowl until well combined. Pat mixture into a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make the glaze: Mix hoisin sauce and ketchup together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove meatloaf from the oven and drain any grease from the pan. Spread glaze over top and continue baking until no longer pink in the center, about 20 more minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Let rest for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
