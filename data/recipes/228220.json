  "ingredients": [
    "1 (2 pound) package frozen hash brown potatoes, thawed",
    "1 (16 ounce) container sour cream",
    "1 cup chopped onion",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "8 ounces shredded Colby cheese",
    "5.3333334922791 tablespoons butter, melted",
    "salt and ground black pepper to taste",
    "2 tablespoons crushed corn flakes cereal"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together hash brown potatoes, sour cream, onion, cream of chicken soup, Colby cheese, and melted butter in a bowl until well combined; season with salt and black pepper. Transfer mixture to a 9x13-inch baking dish and sprinkle the top with cornflake crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until casserole is bubbling, about 1 hour.",
