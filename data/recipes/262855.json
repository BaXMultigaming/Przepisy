  "ingredients": [
    "2 cups shredded aged sharp Cheddar cheese, at room temperature",
    "0.5 cup jarred pimento peppers, drained and finely chopped",
    "0.25 cup chopped green onions",
    "0.5 cup mayonnaise (such as Duke's®)",
    "1 teaspoon freshly ground black pepper",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon cayenne pepper",
    "1 dash hot pepper sauce"
  ],
  "steps": [
