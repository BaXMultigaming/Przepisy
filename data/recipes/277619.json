  "ingredients": [
    "0.5 cup all-purpose flour",
    "0.5 cup whole wheat flour",
    "2 tablespoons white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "1 mashed banana",
    "0.75 cup milk",
    "0.25 cup pumpkin puree",
    "2 tablespoons vegetable oil",
    "1 large egg"
  ],
  "steps": [
    {
      "text": "Sift all-purpose flour, whole wheat flour, sugar, baking powder, salt, and cinnamon together into a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine banana, milk, pumpkin, oil, and egg in a separate bowl; stir in flour mixture just until moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle over medium heat. Drop batter by large spoonfuls onto the griddle; cook until bubbles form and the edges are dry, 3 to 4 minutes. Flip; cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
