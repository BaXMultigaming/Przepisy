  "ingredients": [
    "12 (10 inch) flour tortillas",
    "1 (8 ounce) package cream cheese",
    "1 head lettuce",
    "1 (6 ounce) package sliced deli-style turkey",
    "2 cups shredded carrots",
    "2 cups minced tomato"
  ],
  "steps": [
    {
      "text": "Working in batches, lay a few tortillas on a work surface. Spread a thin layer of cream cheese evenly over tortillas and top with some lettuce leaves. Cover lettuce with a few turkey slices. Sprinkle some carrots and tomato over turkey. Roll up tortillas into wraps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut wraps diagonally into bite-sized pieces. Secure with toothpicks.",
