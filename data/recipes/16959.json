  "ingredients": [
    "2 tablespoons butter",
    "3 eggs",
    "1 cup all-purpose flour",
    "1 cup milk",
    "1 teaspoon baking powder",
    "1 pound shredded Cheddar cheese",
    "2 (10 ounce) packages frozen chopped spinach",
    "1 tablespoon minced onion"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a 9x13-inch baking dish and melt butter in the oven. Remove the dish when butter is melted, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large mixing bowl. Mix in flour, milk, and baking powder until combined. Mix in cheese, spinach, and onion. Spoon mixture into the buttered baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 35 minutes. Let cool for 45 minutes, then cut into bite-sized squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
