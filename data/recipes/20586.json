  "ingredients": [
    "0.5 cup white sugar",
    "3 tablespoons cornstarch",
    "0.25 teaspoon salt",
    "2 cups milk",
    "1 tablespoon butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Mix sugar, cornstarch, and salt together in a medium heavy-bottomed saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sVvsJbSMvWNIeNPJTvdtRRZdvPI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20586-homemade-vanilla-pudding-PICS-step-01-de69c8a30b99456085dfee67bbb85b66.jpg"
      ],
      "image": "assets/images/20586/step_01.webp"
    },
    {
      "text": "Gradually whisk in milk until smooth. Bring to a boil over medium heat, whisking often, about 8 minutes. Once mixture comes to a boil, cook, whisking constantly, for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B_uKvVXD7BkDosopIUNatCSBhlU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20586-homemade-vanilla-pudding-PICS-step-02-088f72337868434e8c821a1305436911.jpg"
      ],
      "image": "assets/images/20586/step_02.webp"
    },
    {
      "text": "Remove saucepan from heat, and stir in butter and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G4j8o61aGH50J3x6CFOrT4pOizQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20586-homemade-vanilla-pudding-PICS-step-03-7e9f5d1a751b473bac1f5e89e84680cb.jpg"
      ],
      "image": "assets/images/20586/step_03.webp"
    },
    {
      "text": "Spoon pudding evenly into 5 serving dishes. Let stand until slightly cooled, about 10 minutes. For best results, cover with plastic wrap pressed directly on pudding to prevent a skin forming and refrigerate until chilled and set, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/y0c3lovTXzRFuLKco_5ErsEzu24=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20586-homemade-vanilla-pudding-PICS-step-04-1f27e6aa1eb04c489a2035b5d0ee9f8d.jpg"
      ],
      "image": "assets/images/20586/step_04.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/49zi8qapL1gzPXWMivxIuqh1Rgw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20586-homemade-vanilla-pudding-PICS-beauty-4x3-61b92cd6a962486291abb4dc5f4f5a00.jpg"
