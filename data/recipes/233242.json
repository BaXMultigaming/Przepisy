  "ingredients": [
    "3 cups miniature marshmallows",
    "2 cups ground cranberries",
    "0.75 cup white sugar",
    "2 cups diced apple",
    "0.5 cup seedless grapes, halved",
    "0.5 cup chopped walnuts",
    "0.25 teaspoon salt",
    "0.5 cup heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Stir marshmallows, cranberries, and sugar together in a saucepan over low heat; cook and stir until the marshmallows melt completely, about 15 minutes. Transfer marshmallow mixture to a bowl and refrigerate 4 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir apples, grapes, walnuts, and salt into the marshmallow mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat whipping cream in a chilled bowl using an electric mixer until stiff peaks form; fold into the marshmallow mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
