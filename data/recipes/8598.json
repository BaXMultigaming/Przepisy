  "ingredients": [
    "1.25 pounds skinless, boneless chicken breast halves",
    "3 tablespoons all-purpose flour",
    "2 tablespoons olive oil",
    "2 teaspoons butter",
    "2 tablespoons shallots, minced",
    "2 cloves garlic, minced",
    "1 cup water",
    "0.5 cup white wine",
    "1 cube chicken bouillon",
    "0.5 teaspoon dried rosemary, crushed",
    "0.25 teaspoon salt",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nLMm5BxImzAHsVeQjI8YNg_Zf5o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8598-chicken-scarpariello-VAT-4x3-step-01-d74dcd66f775458880638392b3ce676a.jpg"
      ],
      "image": "assets/images/8598/step_01.webp"
    },
    {
      "text": "Cut chicken into 1x3-inch strips; dredge in flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ET5fU4A3qVgiDp3EbAJn6zEsrTU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8598-chicken-scarpariello-VAT-4x3-step-02-600aa4037f6d4709a03392a2cebd3630.jpg"
      ],
      "image": "assets/images/8598/step_02.webp"
    },
    {
      "text": "Heat oil and butter in a 10-inch skillet over medium heat. Add chicken; cook, turning occasionally, until lightly browned, 3 to 4 minutes. Remove chicken with tongs; keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_zpI_v-zfOYY-isuBKoYrO16ulA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8598-chicken-scarpariello-VAT-4x3-step-03-fea25e9126324f8f9c4e03e0b9719e76.jpg"
      ],
      "image": "assets/images/8598/step_03.webp"
    },
    {
      "text": "Add shallots and garlic to skillet; sauté until softened, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qzK2k_97xYRKN-GgEtNW4msXPeo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8598-chicken-scarpariello-VAT-4x3-step-04-f30b42402bb64148b5b3efc3ebd8df05.jpg"
      ],
      "image": "assets/images/8598/step_04.webp"
    },
    {
      "text": "Stir water, wine, bouillon cube, rosemary, salt, and pepper into skillet; cook, stirring frequently, until liquid is reduced by half, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OOGxhkYPYLLVUfv6gPURlTDbIIQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8598-chicken-scarpariello-VAT-4x3-step-05-28268c183200425fb06f92979ad9cfd7.jpg"
      ],
      "image": "assets/images/8598/step_05.webp"
    },
    {
      "text": "Return chicken to skillet; cook until sauce is thickened and chicken is heated through and chicken reaches 165 degrees F (74 degrees C), about 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
