  "ingredients": [
    "1 pound lentils",
    "1 cup extra-virgin olive oil",
    "0.25 cup red wine vinegar",
    "2 teaspoons minced garlic",
    "1 teaspoon dried oregano",
    "0.5 teaspoon red pepper flakes",
    "salt to taste",
    "1 cup chopped fresh parsley",
    "0.5 cup chopped fresh cilantro",
    "2 tablespoons crumbled feta cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add lentils, cover, and steam, adding more water as needed, until tender, 30 to 35 minutes. Transfer cooked lentils to a serving bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend oil, vinegar, garlic, oregano, red pepper flakes, and salt in a blender until well incorporated. Add parsley and cilantro; pulse only long enough to incorporate the herbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle 3 tablespoons chimichurri sauce over lentils; add feta cheese to salad. Toss to evenly coat. Store remaining sauce in an airtight container in the refrigerator for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
