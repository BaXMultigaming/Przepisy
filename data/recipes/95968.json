  "ingredients": [
    "1 French baguette, sliced into 1/4 inch rounds",
    "0.25 cup olive oil or melted butter",
    "2 pears - peeled, cored and sliced",
    "8 ounces crumbled Gorgonzola cheese",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange the baguette slices in a single layer on a baking sheet. Brush the top of each one with olive oil or melted butter. Place a slice of pear onto each piece of bread, then crumble some of the cheese over the top. Sprinkle with walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes in the preheated oven, or until the pears are browned and the cheese has started to melt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
