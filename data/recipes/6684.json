  "ingredients": [
    "0.25 cup chopped sun-dried tomatoes",
    "2.5 cups all-purpose flour",
    "2 tablespoons white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 teaspoon dried rosemary",
    "2 tablespoons dried parsley",
    "1 cup shredded sharp Cheddar cheese",
    "0.25 cup chopped green onions",
    "1 egg",
    "1.5 cups buttermilk",
    "3 tablespoons olive oil",
    "1 clove crushed garlic"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9 x 5 loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together the oil, egg, and buttermilk in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk together flour, sugar, baking powder, soda, salt, and dried herbs. Stir in cheese and onions. Pour buttermilk mixture into the flour mixture, and stir to combine. Add garlic and tomatoes until evenly distributed. Spread batter into prepared pan. Smooth top, and tap pan on counter to remove bubbles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 60 to 65 minutes, until golden. Cool loaf on wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
