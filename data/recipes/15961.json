  "ingredients": [
    "1.5 cups crushed gingersnap cookies",
    "1 tablespoon white sugar",
    "0.25 cup butter, melted",
    "1 cup pumpkin puree",
    "1 cup white sugar",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "2 cups frozen whipped topping, thawed",
    "2 cups vanilla ice cream, softened"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl mix together 1 1/2 cups crushed gingersnaps and 1 tablespoon sugar. Stir in melted butter or margarine. Press mixture evenly into a 9 inch pie plate. Bake for 15 minutes. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine pumpkin, 1 cup sugar, salt, ginger, cinnamon, and nutmeg. Stir until thoroughly mixed. Fold in whipped topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread ice cream in an even layer in bottom of cooled gingersnap crust. Pour pumpkin mixture over ice cream. Freeze at least 2 hours before serving. Garnish with whipped topping and crushed gingersnaps if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
