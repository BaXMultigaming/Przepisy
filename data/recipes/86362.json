  "ingredients": [
    "4 peaches, halved and pitted",
    "1 tablespoon vegetable oil",
    "2 tablespoons clover honey",
    "1 cup soft cream cheese with honey and nuts",
    "chopped nuts"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat an outdoor grill for medium-high heat and light oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9E6Ky6o8feG3Opr9OSaJ2S8YQRw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86362-grilled-peaches-and-cream-VAT-005-step-01-50013fdb04d7424880aec05fc3719fba.jpg"
      ],
      "image": "assets/images/86362/step_01.webp"
    },
    {
      "text": "Lightly brush peaches with oil; place pit-sides down onto the preheated grill. Grill until peaches have nice grill marks, about 5 minutes; flip peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ivBulqWYrYDVwxONkWeelt5f03o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86362-grilled-peaches-and-cream-VAT-006-step-02-5db236624924443eb386a262271945e1.jpg"
      ],
      "image": "assets/images/86362/step_02.webp"
    },
    {
      "text": "Drizzle with honey; place dollop cream cheese where pit was. Grill until cream cheese is warm, 2 to 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NhiHC6mp0V5BPwrwXo8VH7imJzg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86362-grilled-peaches-and-cream-VAT-007-step-03-b1b0e50d18784e30a8b979c75629aac6.jpg"
      ],
      "image": "assets/images/86362/step_03.webp"
    },
    {
      "text": "Serve immediately with additional honey and chopped nuts if desired.",
