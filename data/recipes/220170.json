  "ingredients": [
    "0.5 cup heavy cream",
    "1 (3 ounce) package cream cheese, softened",
    "2 tablespoons milk",
    "1.5 teaspoons strawberry jam",
    "1 tablespoon confectioners' sugar",
    "1.25 cups all-purpose flour",
    "2 tablespoons white sugar",
    "1.75 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.25 cup shortening",
    "0.5 cup buttermilk",
    "1 egg yolk",
    "12 toothpicks",
    "0.5 pound strawberries, cut into 1/2-inch slices"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat heavy cream in a bowl with an electric mixer until stiff peaks form; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, milk, 1 ½ teaspoons strawberry jam, and confectioners' sugar in a separate bowl; fold in whipped cream. Cover the bowl; refrigerate until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, white sugar, baking powder, and salt together in a bowl; cut in shortening with a knife or pastry blender until mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat buttermilk and egg yolk together in a separate bowl; stir into flour mixture until just mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a lightly floured surface; knead 5 to 6 turns. Pat or roll dough into a ½-inch thick round. Cut 1-inch biscuits using a biscuit cutter; place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 10 to 15 minutes. Cool for 10 minutes; transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Halve biscuits. Skewer 1 biscuit bottom, 1 strawberry slice, and 1 biscuit top onto each toothpick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir remaining 1 tablespoon strawberry jam into cream cheese dip; serve with shortcake skewers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
