  "ingredients": [
    "1 (15.5 ounce) can Mexican-seasoned black beans",
    "1 (14 ounce) can light coconut milk",
    "1 (6 ounce) package frozen green peas",
    "2 cups chicken stock or water",
    "1 tablespoon fresh lime juice"
