  "ingredients": [
    "6 cups cold water",
    "1 cup white sugar",
    "4 limes",
    "6 tablespoons cream of coconut"
  ],
  "steps": [
    {
      "text": "Combine cold water and sugar in a bowl until sugar dissolves; chill in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut ends off each lime; cut each lime into 8 segments.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chilled sugar-water mixture and lime segments, in batches, in a blender; pulse several times. Pour lime mixture through a strainer into a pitcher.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream of coconut into lime mixture until well combined. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
