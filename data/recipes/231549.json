  "ingredients": [
    "4 (4 ounce) flounder fillets",
    "4 tablespoons butter, melted, divided",
    "1 cup panko bread crumbs",
    "0.66666668653488 cup grated Parmesan cheese",
    "0.5 teaspoon salt",
    "1 pinch dried thyme",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a large, shallow baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay flounder fillets in the prepared baking dish and brush with 1 tablespoon butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Csyu29ijynk4Yj8ekvdFnUuXoaY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231549-baked-flounder-with-panko-and-parmesan-ddmfs-step2-113-3c03a1ba9d5f40d89fbe40514ff732d5.jpg"
      ],
      "image": "assets/images/231549/step_02.webp"
    },
    {
      "text": "Combine remaining 3 tablespoons butter with bread crumbs, Parmesan cheese, salt, thyme, and pepper in a bowl; sprinkle over flounder and pat down lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ODiwVX5omYdZuzGMUwP-L84FhAU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231549-baked-flounder-with-panko-and-parmesan-ddmfs-step3-116-8615649743ca49d187833ce330d5edb4.jpg"
      ],
      "image": "assets/images/231549/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qEXskWqfmaqPBaz009DxLCUL6GA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231549-baked-flounder-with-panko-and-parmesan-ddmfs-step4-127-939965a69c2c418981bd85d3faaea67f.jpg"
      ],
      "image": "assets/images/231549/step_04.webp"
