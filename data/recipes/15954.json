  "ingredients": [
    "1 (9 inch) pie shell",
    "2 cups white sugar",
    "0.5 cup butter, softened",
    "5 eggs, beaten",
    "1 cup milk",
    "1 tablespoon all-purpose flour",
    "1 tablespoon cornmeal",
    "0.25 cup fresh lemon juice",
    "3 tablespoons lemon zest"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a large mixing bowl until light and fluffy. Beat in eggs and milk. Add flour, cornmeal, lemon juice, and lemon zest. Mix until smooth. Pour mixture into prepared pastry crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pie in the preheated oven until center is set, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
