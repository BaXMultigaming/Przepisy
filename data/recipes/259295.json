  "ingredients": [
    "4 cups peeled, cored, and diced apples",
    "2 cups white sugar",
    "0.5 cup vegetable oil",
    "2 eggs, lightly beaten",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "2 teaspoons ground cinnamon",
    "1.5 teaspoons baking soda",
    "1 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground allspice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch glass baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine apples and sugar in a bowl and toss to coat. Stir in oil, eggs, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, cinnamon, baking soda, salt, nutmeg, and allspice in a separate bowl. Add to the apple mixture and mix well. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes. Let cool in the pan on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
