  "ingredients": [
    "3 tablespoons soybean oil (often labeled \"vegetable oil\")",
    "3 cloves garlic, chopped",
    "1 pound shrimp (30 to 35 per lb.), peeled and deveined",
    "0.5 teaspoon red pepper flakes",
    "1 lemon, juiced and zested",
    "1 (8 ounce) package farfalle or bow-tie pasta, cooked according to package directions",
    "1 cup cherry tomatoes, halved",
    "0.75 cup shelled edamame, thawed",
    "1 carrot, cut into matchstick-size pieces",
    "1 red bell pepper, cut into 1-inch squares",
    "0.25 teaspoon sea salt",
    "0.25 teaspoon freshly ground black pepper",
    "1 tablespoon Italian parsley, chopped",
    "2 tablespoons shredded Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Heat soybean oil in large skillet over medium high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add garlic and cook for 2 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add shrimp, lemon juice and red pepper flakes. Cook for 2 to 3 minutes, stirring frequently, until shrimp is pink and cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add carrots, edamame, bell peppers and tomatoes. Cook, stirring frequently, until the carrots are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pasta, salt, pepper, cheese, parsley and lemon zest. Cook, tossing gently, until thoroughly heated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with Parmesan cheese, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
