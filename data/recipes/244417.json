  "ingredients": [
    "4.25 cups milk",
    "3 egg yolks",
    "5 tablespoons white sugar",
    "3 tablespoons cornstarch",
    "2 tablespoons all-purpose flour",
    "1 cinnamon stick",
    "0.25 cup raisins",
    "1 tablespoon vanilla extract",
    "1 tablespoon butter",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Blend milk, egg yolks, sugar, cornstarch, and flour together in a blender until smooth. Pour milk mixture into a large pot over medium heat; add cinnamon stick and stir with a large wooden spoon. Stir raisins, vanilla extract, and butter into milk mixture; whisk mixture until thickened and smooth, 10 to 15 minutes.",
      "section": null,
