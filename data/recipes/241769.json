  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.75 cup confectioners' sugar",
    "0.5 cup unsalted butter, softened",
    "2 tablespoons brown sugar",
    "1 teaspoon vanilla extract",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Beat cream cheese, confectioners’ sugar, butter, brown sugar, and vanilla extract together in a bowl until creamy; fold in chocolate chips. Refrigerate until chilled, at least 20 minutes.",
