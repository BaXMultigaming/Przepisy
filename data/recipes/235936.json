  "ingredients": [
    "1 cup freekeh",
    "4 cups vegetable broth",
    "1 cup water",
    "1 tablespoon olive oil",
    "2 tablespoons tomato paste",
    "0.5 teaspoon paprika",
    "0.25 teaspoon cumin",
    "0.25 teaspoon ground turmeric",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Rinse and drain freekeh. Place freekeh in a bowl with enough water to cover; soak for 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir vegetable broth, water, and olive oil together in a large pot; bring to a boil. Stir freekeh, tomato paste, paprika, cumin, turmeric, salt, and black pepper into vegetable broth mixture; bring mixture to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium-low and simmer freekeh mixture, stirring occasionally, until most of the liquid is absorbed, about 1 hour. Remove freekeh from heat and let rest for 5 minutes. Fluff with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
