  "ingredients": [
    "2 large baking potatoes",
    "0.5 pound lean bacon",
    "1.5 cups shredded mild Cheddar cheese",
    "0.5 cup sour cream",
    "0.25 cup milk",
    "2 tablespoons unsalted butter, melted",
    "1 teaspoon dried chives",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a toothpick to poke a few holes into each potato.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zjXOPusuR0IcNV5P35l5HpQZNbY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231988-twice-baked-potato-casserole-with-bacon-ddmfs-step1-0060-4x3-2f0e58cb747d4c73b2b7a4adb7b2f9c4.jpg"
      ],
      "image": "assets/images/231988/step_02.webp"
    },
    {
      "text": "Bake potatoes in the preheated oven until fully cooked, about 1 hour. Cool for about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on a paper towel-lined plate; crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ReSFct4ojU3pb8hS-t0RxXTgw7I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231988-twice-baked-potato-casserole-with-bacon-ddmfs-step2-0062-4x3-5fc4df4c57bb40258ee9aeb5cd0ff946.jpg"
      ],
      "image": "assets/images/231988/step_04.webp"
    },
    {
      "text": "Cut a thin slice from one side of each baked potato; carefully scoop out flesh and transfer to a large bowl. Discard skins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1/2 of the Cheddar cheese, sour cream, milk, butter, chives, garlic powder, salt, and black pepper into potatoes until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kIRuq9To0U1HoaiTIcjUCK2UhUs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231988-twice-baked-potato-casserole-with-bacon-ddmfs-step4-0063-4x3-abfdc5302aea467a93e78bff9b56f899.jpg"
      ],
      "image": "assets/images/231988/step_06.webp"
    },
    {
      "text": "Spread potato mixture into the prepared casserole dish; top with remaining Cheddar cheese and crumbled bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hMNA9CwaJir4MYpQRYZe1ij5JR4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231988-twice-baked-potato-casserole-with-bacon-ddmfs-step6-0067-4x3-3ba8c10c97554ab3a6e3e04699175c1a.jpg"
      ],
      "image": "assets/images/231988/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until just bubbling, 10 to 15 minutes. Cool for at least 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1YR27skrrAwdsUyCsrU8SiUHTL0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231988-twice-baked-potato-casserole-with-bacon-DDMFS-4x3-f31b05081ef84fdbbc057a52617b9b25.jpg"
      ],
      "image": "assets/images/231988/step_08.webp"
    }
