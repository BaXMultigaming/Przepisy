  "ingredients": [
    "1 cup butter, softened",
    "0.5 cup confectioners' sugar",
    "0.5 cup cornstarch",
    "1 cup semisweet chocolate chips",
    "1.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "With an electric beater, mix together the butter or margarine and the confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the flour and the corn starch and mix in gradually in the butter mixture. Add the chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into little balls of approximately 1 1/4 inch in diameter. Put on a non-greased cookie sheet. Bake at 330 degrees F (170 degrees C) for approximately 20 minutes.",
      "section": null,
      "name": null,
