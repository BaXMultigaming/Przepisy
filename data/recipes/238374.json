  "ingredients": [
    "3 cups blueberries",
    "1 tablespoon lemon juice",
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "1 egg, beaten",
    "6 tablespoons melted butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
