  "ingredients": [
    "2 tablespoons butter",
    "0.5 cup chopped onion",
    "0.5 cup chopped celery",
    "4.5 cups milk",
    "1 (10.75 ounce) can condensed cream of celery soup",
    "1.5 cups diced potatoes",
    "1 tablespoon dried dill weed",
    "0.5 teaspoon red pepper flakes",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon caraway seeds",
    "3 dashes hot pepper sauce (such as Tabasco®)",
    "salt to taste",
    "1 (8 ounce) salmon fillet, cut into cubes",
    "8 ounces baby shrimp"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium-high heat. Saute onion and celery until tender, 3 to 5 minutes. Add milk, canned soup, potatoes, dill, red pepper flakes, black pepper, caraway seeds, hot pepper sauce, and salt. Bring to a boil. Simmer until potatoes are slightly tender, about 15 minutes. Add salmon and shrimp. Cook until opaque, about 3 minutes.",
