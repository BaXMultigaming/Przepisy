  "ingredients": [
    "1 pound ground beef",
    "1 cup cracker crumbs",
    "0.25 cup chopped onion",
    "0.25 cup milk",
    "2 eggs",
    "0.75 teaspoon salt",
    "0.66666668653488 cup ketchup",
    "0.33333334326744 cup water",
    "6 tablespoons brown sugar",
    "0.5 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef, cracker crumbs, chopped onion, milk, eggs, and salt in a large bowl. Roll out 20 meatballs and arrange on a baking sheet with a rim. Whisk together the ketchup, water, brown sugar, and nutmeg in a bowl. Pour mixture over meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the meatballs are no longer pink in the center, about 45 minutes.",
      "section": null,
