  "ingredients": [
    "1.5 cups white sugar",
    "0.5 cup vegetable oil",
    "3 large eggs",
    "1 teaspoon vanilla extract",
    "2.25 cups all-purpose flour",
    "1 tablespoon baking powder",
    "0.25 teaspoon salt",
    "0.25 cup milk",
    "2 cups finely chopped strawberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, oil, eggs, and vanilla extract in a large bowl and beat thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, and salt in a small bowl. Add to the sugar mixture with milk and combine to make a thick batter. Add strawberries and fold gently to combine. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and the top springs back when lightly pressed, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
