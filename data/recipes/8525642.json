  "ingredients": [
    "3 tablespoons apple cider vinegar",
    "2 tablespoons extra-virgin olive oil",
    "1 tablespoon honey",
    "1 teaspoon Dijon mustard",
    "1 pinch salt",
    "1 pinch ground white pepper",
    "6 cups romaine lettuce - torn, washed and dried",
    "0.33 cup chopped toasted walnuts",
    "0.25 cup crumbled Gorgonzola cheese",
    "1 red pear, cored and sliced",
    "0.25 cup pomegranate arils",
    "1 green onion, chopped"
  ],
  "steps": [
    {
      "text": "Combine apple cider vinegar, extra-virgin olive oil, honey, Dijon mustard, salt, and white pepper in a small container with a lid. Cover tightly and shake until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place lettuce in a salad bowl. Sprinkle with toasted walnut pieces and cheese crumbles. Fan pear slices on the top of the salad and sprinkle with pomegranate arils and chopped scallion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle with vinaigrette and serve.",
      "section": null,
