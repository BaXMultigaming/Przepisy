  "ingredients": [
    "0.5 cup brown sugar",
    "0.25 cup pineapple juice",
    "0.25 cup teriyaki sauce",
    "4 boneless pork chops",
    "4 pineapple slices"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, pineapple juice, and teriyaki sauce together in a bowl. Coat pork chops with 1/2 cup of the mixture. Place in a baking pan and cover each chop with 1 pineapple slice. Pour remaining 1/2 cup of the mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the centers, 35 to 45 minutes. An instant-read thermometer inserted into the center of each chop should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
