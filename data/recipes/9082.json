  "ingredients": [
    "2 cups instant rice",
    "0.25 cup butter",
    "0.75 cup chopped onion",
    "2 (10 ounce) packages frozen chopped broccoli",
    "2 (10.75 ounce) cans condensed cream of mushroom soup",
    "1 (16 ounce) jar process cheese sauce",
    "salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
