  "ingredients": [
    "1 head cauliflower, cut into florets",
    "2 tablespoons butter",
    "0.5 cup milk",
    "0.5 cup sour cream",
    "1 cup Italian-seasoned bread crumbs",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to a boil. Cook cauliflower in the boiling water until tender, about 10 minutes; drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in the same pot over medium heat. Stir cauliflower, milk, and sour cream into melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash cauliflower in the pot using a hand blender until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cauliflower mixture to a baking dish; evenly cover with bread crumbs and season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Baking in the preheated oven until bread crumbs are lightly browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
