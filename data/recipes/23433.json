  "ingredients": [
    "1 (15.25 ounce) package lemon cake mix",
    "1 (3.4 ounce) package instant lemon pudding mix",
    "0.75 cup vegetable oil",
    "4 eggs",
    "1 cup lemon-lime flavored carbonated beverage"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 10-inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix and pudding mix in a large bowl. Stir in oil, then beat in eggs one at a time. Stir in lemon-lime soda until batter is smooth and well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared pan. Bake in the preheated oven until a toothpick inserted into the center comes out clean, 45 to 50 minutes. Let cake cool in the pan before removing. Cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
