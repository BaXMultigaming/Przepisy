  "ingredients": [
    "cooking spray",
    "2 cups multigrain toasted oat cereal (such as Cheerios®)",
    "1.25 cups all-purpose flour",
    "0.25 cup brown sugar",
    "1 teaspoon baking powder",
    "0.75 teaspoon baking soda",
    "1 cup mashed bananas",
    "0.66666668653488 cup skim milk",
    "2 egg whites",
    "0.25 cup unsweetened applesauce",
    "0.25 cup raisins",
    "0.25 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease 12 standard muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cereal in a resealable plastic bag. Crush slightly with a rolling pin to make 1 1/2 cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix crushed cereal, flour, brown sugar, baking powder, and baking soda together in a large bowl. Stir in mashed bananas, milk, egg whites, applesauce, raisins, and chocolate chips until batter is just moistened. Divide batter evenly among muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 18 to 22 minutes. Let stand for 2 minutes in the pan before removing to a cooling rack. Serve warm if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
