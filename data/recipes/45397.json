  "ingredients": [
    "6 apples - peeled, cored and sliced",
    "0.5 cup white sugar",
    "3 tablespoons all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts",
    "0.5 cup whole milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish, or coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place apples in a large bowl. Combine sugar, flour, cinnamon, nutmeg, and cloves in a small bowl; stir into apples until evenly distributed. Stir in raisins and walnuts. Spoon into prepared dish. Pour milk over apple mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until soft and bubbly, 45 to 60 minutes. Allow to cool slightly before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
