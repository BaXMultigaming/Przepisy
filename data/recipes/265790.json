  "title": "Keto Vanilla-Cinnamon Cookies",
  "description": "These simple vanilla-cinnamon cookies are made with a mixture of ground pecans, almond flour, and coconut flour, and sweetened with erythritol.",
  "authors": [
    "Evelyn"
  ],
  "date_published": "2020-04-21T23:21:49-04:00",
