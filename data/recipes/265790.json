  "ingredients": [
    "1 cup almond flour",
    "0.5 cup finely ground pecans",
    "1 teaspoon cinnamon",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.5 cup butter",
    "0.25 cup erythritol",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.5 cup coconut flour"
  ],
  "steps": [
    {
      "text": "Combine almond flour and ground pecans in a skillet over medium heat and cook until golden and fragrant, 3 to 6 minutes. Remove from heat. Whisk cinnamon, salt, and nutmeg into the skillet. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and erythritol in a large bowl; beat using an electric mixer until smooth and creamy. Stir in egg and vanilla extract. Mix in almond flour mixture and coconut flour; stir until dough forms. Form into a roll, wrap in plastic wrap, and refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut dough roll into 24 cookies and place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 12 to 15 minutes",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
