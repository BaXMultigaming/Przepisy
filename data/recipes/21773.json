  "ingredients": [
    "1 (5.1 ounce) package instant vanilla pudding mix",
    "3 cups cold milk",
    "1 (9 inch) angel food cake, cut in cubes",
    "4 medium bananas, sliced",
    "1 (16 ounce) package frozen strawberries, thawed",
    "1 (12 ounce) container frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Place pudding mix into a bowl. Add cold milk and whisk together for 2 minutes. Let rest for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer ½ of the cake cubes in a trifle bowl or other glass serving dish. Layer ½ of the pudding, ½ of the bananas, ½ of the strawberries, and ½ of the whipped topping over top. Repeat all layers once more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover trifle and chill in the refrigerator for at least 4 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
