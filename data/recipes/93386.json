  "ingredients": [
    "1 pound Yukon Gold potatoes, peeled and quartered",
    "0.5 cup whole milk",
    "0.25 cup butter, cut into pieces",
    "1 pinch ground nutmeg",
    "kosher salt to taste",
    "ground white pepper to taste"
  ],
  "steps": [
    {
      "text": "Place the potatoes into a large pot, and cover with salted water. Bring to a boil over high heat, then reduce heat to medium-low, cover, and simmer until tender, about 20 minutes. Drain and allow to steam dry for a minute or two, and place the potatoes in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring the milk to a boil in a small saucepan over low-medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip the potatoes with an electric mixer until smooth; pour the boiling milk over the potatoes, and add butter, nutmeg, salt, and white pepper. Whip on Medium speed until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
