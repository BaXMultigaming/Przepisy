  "ingredients": [
    "1.3333333730698 cups rolled oats",
    "0.5 cup all-purpose flour",
    "0.5 cup vegan semi-sweet chocolate chips",
    "0.5 cup ground unsalted cashews",
    "2 tablespoons shelled unsalted sunflower seeds",
    "1 tablespoon ground flax meal",
    "1 tablespoon wheat germ",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon sea salt",
    "0.5 cup honey, warmed",
    "0.33333334326744 cup almond butter",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a 9x11-inch baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oats, flour, chocolate chips, ground cashews, sunflower seeds, flax meal, wheat germ, cinnamon, and sea salt together in a large shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir warmed honey, almond butter, and vanilla extract together in a bowl until well-mixed. Pour honey mixture into oat mixture; stir until batter is well-combined. Turn batter out into prepared baking dish. Lay a sheet of waxed paper over batter and press firmly to evenly distribute in the baking dish. Remove and discard waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and fragrant, about 12 minutes. Pull aluminum foil from baking dish and cool bars in the aluminum foil for 10 minutes; remove and discard aluminum foil. Cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
