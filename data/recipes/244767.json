  "title": "Cinnamon Roll Pancakes",
  "description": "A cinnamon-brown sugar filling is swirled over a pancake and topped with icing in this clever cinnamon roll pancake recipe the kids will love.",
  "authors": [
    "squeeziebrb"
  ],
  "date_published": "2020-07-01T21:09:28-04:00",
