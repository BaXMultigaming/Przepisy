    "publisher-tested"
  ],
  "ingredients": [
    "0.75 cup milk",
    "2 tablespoons white distilled vinegar",
    "1 cup all-purpose flour",
    "2 tablespoons white sugar",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 large egg",
    "2 tablespoons butter, melted",
    "1.5 teaspoons vanilla extract",
    "5.5 tablespoons packed brown sugar",
    "0.25 cup butter, melted",
    "1.5 teaspoons ground cinnamon",
    "0.25 cup butter, softened",
    "2 ounces cream cheese, at room temperature",
    "0.75 cup confectioners' sugar",
    "0.5 teaspoon vanilla extract",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H2rYIqD-IEKji7MDk0axh40wsHA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244767-cinnamon-roll-pancakes-VAT-004-step-01-7f151e8caef44c8c95136ee0db2fc9e8.jpg"
      ],
      "image": "assets/images/244767/step_01.webp"
    },
    {
      "text": "Stir milk and vinegar together in a bowl; set aside until milk \"sours\", about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zE4Qh84pZCM7UJ0_Nv2EFe9YqCo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244767-cinnamon-roll-pancakes-VAT-005-step-02-1d7c0dba598644c5a5d2612276329ab2.jpg"
      ],
      "image": "assets/images/244767/step_02.webp"
    },
    {
      "text": "Mix flour, white sugar, baking powder, baking soda, and salt together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kfFwbTw8-JXvtcUH03CLmwDmb4I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244767-cinnamon-roll-pancakes-VAT-006-step-03-8aa7655a9da9438994b4ee7be4c3d4a2.jpg"
      ],
      "image": "assets/images/244767/step_03.webp"
    },
    {
      "text": "Whisk egg, 2 tablespoons melted butter, and 1 ½ teaspoons vanilla extract into milk mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s7PjLvitJdYRxg6xEJ90xt33dZo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244767-cinnamon-roll-pancakes-VAT-007-step-04-599594cdd77f4ebcbd29994240e14c65.jpg"
      ],
      "image": "assets/images/244767/step_04.webp"
    },
    {
      "text": "Slowly pour milk mixture into flour mixture while whisking constantly until batter is just moistened and evenly mixed. The batter might have some lumps which is fine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wa_wwoPhXsgDKBACeSqE2ikPtEY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244767-cinnamon-roll-pancakes-VAT-008-step-05-5cf5f40fae9e41f5ae7ea62da84eec31.jpg"
      ],
      "image": "assets/images/244767/step_05.webp"
    },
    {
      "text": "Combine brown sugar, 1/4 cup melted butter, and cinnamon in a small bowl. Place a 1-quart resealable bag into a glass or cup. Pour cinnamon mixture into the bag; refrigerate until filling is thick and spreadable, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t6QaDzWFjNIvsoo29yx5CTeHMGc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244767-cinnamon-roll-pancakes-VAT-009-step-06-e1c910762de94085a324a67afc65905b.jpg"
      ],
      "image": "assets/images/244767/step_06.webp"
    },
    {
      "text": "Mix 1/4 cup softened butter and cream cheese together in a microwave-safe bowl; heat in microwave for 40 seconds. Stir mixture with a whisk or fork until smooth. Continue heating in microwave and stirring until mixture is completely melted. Stir confectioners' sugar and 1/2 teaspoon vanilla extract into cream cheese mixture until icing is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pN_2Zf2e5PV5gmxmA5LGg6bX474=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244767-cinnamon-roll-pancakes-VAT-010-step-07-542cec5b52f2428b85ee5ab573409b34.jpg"
      ],
      "image": "assets/images/244767/step_07.webp"
    },
    {
      "text": "Heat a griddle or skillet over medium heat and spray with cooking spray. Pour about 1/4 cup batter into the center of griddle. Cook pancake until bubbles start to appear, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Bf3VEYcogJiRpCa7TstS9eevryk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244767-cinnamon-roll-pancakes-VAT-011-step-08-88e1dd53dbbe42808af8ad21e7b45131.jpg"
      ],
      "image": "assets/images/244767/step_08.webp"
    },
    {
      "text": "Cut 1 corner off the center of the bag with filling. Swirl filling over pancake, leaving enough space around edges that filling doesn't touch the griddle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O22wO8KeHHITtEmSfvuTUAaTRmg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244767-cinnamon-roll-pancakes-VAT-012-step-09-e0ef7c3b96ca4b9a8886a68085c9caf3.jpg"
      ],
      "image": "assets/images/244767/step_09.webp"
    },
    {
      "text": "Flip pancake and cook until other side is lightly browned, 2 to 3 minutes. Drizzle icing over pancake; remove from pan and set aside. Repeat with remaining ingredients, wiping the pan/griddle with a clean, damp cloth in between each pancake to remove any excess cinnamon mixture, and spraying the griddle with cooking spray between each pancake. Doing this will prevent the residual mixture from scorching as you cook the next batch of pancakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gE0AnlaR0XWO7AGM9jOOm7gxCP8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244767-cinnamon-roll-pancakes-VAT-012-step-10-b0e745f607c84c0ebb6855da10ef0ee7.jpg"
      ],
      "image": "assets/images/244767/step_10.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GQqjtQsUtLjopwbGIjM5PZN0xwE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244767-cinnamon-roll-pancakes-VAT-001-4x3-1-6ddbc75e6d1c4188aba03114f1857701.jpg"
      ],
      "image": "assets/images/244767/step_11.webp"
    }
  ],
