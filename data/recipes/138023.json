  "ingredients": [
    "1 tablespoon dried thyme leaves",
    "1 tablespoon paprika",
    "2 teaspoons freshly ground black pepper",
    "2 teaspoons salt",
    "1 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon ground cumin",
    "3 pounds beef brisket, trimmed of fat",
    "0.5 teaspoon liquid smoke flavoring",
    "2 tablespoons Worcestershire sauce",
    "1.5 cups barbeque sauce"
  ],
  "steps": [
    {
      "text": "Combine thyme, paprika, pepper, salt, onion powder, garlic powder, cayenne, and cumin in a small bowl; set aside. Rub brisket all over with liquid smoke, then rub with spice mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour Worcestershire and barbeque sauces into a slow cooker; place beef on top. Cover, and cook on Low, 8 to 10 hours, until fork-tender.",
      "section": null,
      "name": null,
