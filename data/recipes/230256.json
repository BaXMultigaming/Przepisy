  "title": "Sweet Bourbon Ham",
  "description": "Baste a bone-in ham with a whiskey and brown sugar glaze for a delicious holiday main dish that uses just 5 ingredients.",
  "authors": [
    "AMYDANIELLE1"
  ],
  "date_published": "2012-09-18T13:17:14-04:00",
