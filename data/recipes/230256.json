  "ingredients": [
    "1 (8 1/2 pound) cooked bone-in ham (shank end)",
    "40 whole cloves",
    "1 cup firmly packed brown sugar",
    "0.25 cup bourbon whiskey",
    "1.5 teaspoons freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove skin and excess fat from ham, leaving a fat layer about 1/4-inch thick. Score ham in a diamond pattern with a sharp knife. Push cloves into the center of the scored diamond shapes. Place ham with cut side down into a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fWuQy45fCwuA63uR-af89mwo7cA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230256-SweetBourbonHam-ddmfs-Step2-0066-7c65e6f8d99a4ed4a191d95fe29c5fda.jpg"
      ],
      "image": "assets/images/230256/step_02.webp"
    },
    {
      "text": "Bake ham in the preheated oven until an instant-read meat thermometer inserted into the thickest part of the meat, not touching bone, reads 125 degrees F (52 degrees C), about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nGUDE7sdVu4myAJjdv3G4GZbrHE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230256-SweetBourbonHam-ddmfs-Step3-0071-8d5927ac6250479c9c55a28e1ff4d26c.jpg"
      ],
      "image": "assets/images/230256/step_03.webp"
    },
    {
      "text": "Combine brown sugar, whiskey, and black pepper in a bowl until glaze is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fbiLIOXATjZAFyI_heg5BPGtFK4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230256-SweetBourbonHam-ddmfs-Step4-0069-055f1096b09e45a7bd4d7893dd623123.jpg"
      ],
      "image": "assets/images/230256/step_04.webp"
    },
    {
      "text": "Raise oven temperature to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Baste ham with 1/3 the whiskey glaze. Return to oven and bake until internal temperature reaches 140 degrees F (60 degrees C), basting ham with whiskey glaze every 10 minutes. Cover ham loosely with a tent of aluminum foil if ham browns too quickly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LoOQZcGhpVhIem_ej7bHdrNVA6U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230256-SweetBourbonHam-ddmfs-Step5-0075-5c0aa712a2014c9c8ee92f3954b3d71e.jpg"
      ],
      "image": "assets/images/230256/step_06.webp"
    },
    {
      "text": "Let ham rest for 15 minutes before carving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cCZYpUwiL6pKZE87orSq_cxMB2I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230256-SweetBourbonHam-ddmfs-4X3-0094-eef285c30d814e41998ef86342988bac.jpg"
      ],
