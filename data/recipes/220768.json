  "ingredients": [
    "1.5 cups cold mashed potatoes",
    "1 cup finely chopped cooked ham",
    "3 green onions, finely chopped",
    "1.5 cups panko bread crumbs, divided",
    "1 egg",
    "1 tablespoon Dijon mustard",
    "0.5 teaspoon dried dill weed",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 cup vegetable oil for frying, or as needed"
  ],
  "steps": [
    {
      "text": "Mix together mashed potatoes, ham, green onions, 1/4 cup bread crumbs, egg, Dijon mustard, dill weed, salt, and black pepper in a large bowl until thoroughly combined. If mixture is too moist to hold together, mix in an additional 1/4 cup bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place remaining bread crumbs into a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop about 1/3 cup of the mixture and form into a ball; slightly flatten into a patty. Press both sides of patty into bread crumbs; tap off any loose crumbs. Repeat with remaining mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat until very hot. Fry patties, 2 to 3 at a time, in hot oil until golden brown, 3 to 4 minutes per side. Drain on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
