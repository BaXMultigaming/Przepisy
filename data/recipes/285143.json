  "ingredients": [
    "2 large eggs, beaten",
    "0.5 cup flour",
    "1 teaspoon seasoned salt (such as Lawry's®)",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon black pepper",
    "0.75 cup panko bread crumbs",
    "2 (6 ounce) pork chops, about 1/2-inch to 3/4-inch thick",
    "0.25 cup oil"
  ],
  "steps": [
    {
      "text": "Place beaten eggs on a large plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, seasoned salt, garlic powder, and black pepper on a second plate. Spread out panko bread crumbs on a third plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip pork chops in egg, then in flour mixture, again in egg, and finally press in bread crumbs to coat. Set aside and let rest while oil is heated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Cook pork chops in hot oil, uncovered, until golden brown, 4 to 5 minutes. Flip pork chops over and continue cooking until no longer pink in the center, 3 to 4 minutes more. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
