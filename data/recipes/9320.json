  "steps": [
    {
      "text": "Place white chocolate into the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip pretzels into melted chocolate to completely cover half of each one. Roll in candy sprinkles, then place onto waxed paper. Refrigerate for 15 minutes to harden.",
