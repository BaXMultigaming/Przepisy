  "ingredients": [
    "5 large tomatoes",
    "1 small red onion, thinly sliced",
    "sea salt to taste",
    "1.5 teaspoons dried oregano",
    "1 small green bell pepper, sliced",
    "0.5 medium cucumber, sliced",
    "0.25 cup Greek black olives",
    "3 tablespoons extra-virgin olive oil",
    "1 (8 ounce) package feta cheese"
  ],
  "steps": [
    {
      "text": "Cut tomatoes into wedges over a large serving bowl so that any extra juices land in the bowl with tomato wedges. Add onion slices and oregano, then season liberally with salt; mix to combine. Allow to sit at room temperature until juices have released, at least 20 to 30 minutes or up to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in bell pepper, cucumber, and olives just before serving. Top with slice of feta cheese and drizzle with olive oil.",
