  "ingredients": [
    "0.66670000553131 cup white sugar",
    "0.5 cup margarine",
    "2 eggs",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground allspice",
    "0.5 teaspoon baking soda",
    "1.5 cups all-purpose flour",
    "1 cup applesauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degree F (175 degrees C). Line a mini muffin pan with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and margarine together in a large bowl. Add eggs; beat until smooth. Blend in baking powder, cinnamon, allspice, and baking soda.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 1 cup flour and 1/2 cup applesauce; stir until just combined. Add remaining 1/2 cup flour and remaining 1/2 cup applesauce; stir until just combined. Divide batter between muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated until a toothpick inserted in center comes out mostly clean, about 17 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
