  "ingredients": [
    "1 cup white sugar",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 teaspoon unsweetened lemonade drink mix",
    "0.33329999446869 cup shortening"
  ],
  "steps": [
    {
      "text": "In a medium bowl, combine sugar, flour, baking soda, salt, and lemonade drink mix. Stir to blend. Cut in shortening with a fork or pastry blender until mixture resembles corn meal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon about 1/3 cup mixture into 10 small containers or sealable plastic bags. Label and store in cool, dry place. Use within 12 weeks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat Easy Bake oven. Grease and flour a 4 inch miniature cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make a cake: Empty the contents of one bag cake mix into a small bowl. Using a fork, mix with 4 teaspoons water until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake according to manufacturer's instructions",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
