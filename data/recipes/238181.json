  "ingredients": [
    "6 Yukon Gold potatoes",
    "0.25 cup olive oil",
    "1 clove garlic, pressed",
    "1 teaspoon paprika",
    "1 teaspoon dried oregano",
    "0.25 teaspoon celery salt",
    "1 tablespoon grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thinly slice each potato several times, stopping just short of cutting all the way through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, garlic, paprika, oregano, and celery salt together in a bowl; pour into a resealable plastic bag. Add potatoes, seal the bag, and shake to coat completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer potatoes to a baking dish and reserve oil mixture in a small bowl. Sprinkle Parmesan cheese over potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake potatoes in the preheated oven until layers start to separate and potatoes are slightly tender, about 30 minutes. Brush potatoes with reserved oil mixture, pulling layers apart if they are sticking together. Continue baking until potatoes are crispy on the edges and easily pierced with a knife, 30 to 40 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
