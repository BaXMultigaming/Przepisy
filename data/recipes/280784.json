  "ingredients": [
    "4 sprigs fresh mint, divided, or as needed",
    "0.75 fluid ounce peach nectar",
    "1.5 fluid ounces bourbon",
    "0.75 fluid ounce ginger liqueur (such as Domaine de Canton®)",
