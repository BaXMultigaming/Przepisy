  "ingredients": [
    "0.25 pound lean ground beef",
    "1 tablespoon taco seasoning mix (such as TACO BELL®)",
    "1 10-inch flour tortilla",
    "0.25 cup nacho cheese sauce",
    "1 tostada shell",
    "2 teaspoons sour cream",
    "0.5 cup shredded lettuce",
    "1 tablespoon diced tomatoes",
    "1 small flour tortilla (street taco size)"
  ],
  "steps": [
    {
      "text": "Crumble beef into a skillet over medium heat. Add taco seasoning and cook until brown and crumbly, about 5 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the large tortilla on a clean work surface. Spoon meat onto the center and spread cheese sauce over the meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tostada shell on top of the cheese. Spread sour cream over the tostada. Top with lettuce and tomato.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Center the small street size tortilla on top of the lettuce mixture. Tuck and fold the outer large tortilla around the sides and top of the small tortilla until sealed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sealed side down in a skillet over medium heat and cook for 3 minutes. Using a spatula, flip the crunchwrap and cook for 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
