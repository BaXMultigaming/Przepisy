  "ingredients": [
    "nonstick cooking spray",
    "0.75 cup superfine sugar",
    "2 tablespoons superfine sugar",
    "0.5 cup unsalted butter",
    "1 tablespoon water",
    "0.5 teaspoon coarse salt",
    "0.66666668653488 cup golden syrup (such as Lyle's®)",
    "2 cups chopped roasted pistachios",
    "1 teaspoon baking soda",
    "1 pinch cayenne pepper"
  ],
  "steps": [
    {
      "text": "Line a rimmed baking sheet with parchment paper and lightly coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 3/4 cup plus 2 tablespoons sugar, butter, water, and salt in a saucepan over medium heat. Cook and stir until butter has melted, 3 to 5 minutes. Add syrup and stir until the sugar is completely dissolved and melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow mixture to come to a boil, stirring constantly. Once mixture reaches 310 degrees F (155 degrees C), remove saucepan from heat. Stir in pistachios, baking soda, and cayenne (mixture will foam).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir until mixture is no longer bubbling and caramel is smooth, about 1 minute. Transfer to the prepared baking sheet and spread out with a lightly greased spatula. Let cool until firm, about 15 minutes. Break into pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
