  "ingredients": [
    "2 teaspoons vegetable oil, or to taste",
    "1 pound boneless, skinless chicken thighs, cut into 3/4-inch pieces",
    "2 tablespoons cornstarch",
    "1 onion, sliced",
    "4 medium garlic cloves",
    "2 teaspoons minced fresh ginger",
    "3 cups broccoli florets",
    "2 tablespoons water",
    "0.66666668653488 cup soy sauce",
    "1 tablespoon oyster sauce",
    "0.25 cup brown sugar",
    "1 pinch red pepper flakes, or to taste",
    "¼ teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Tx96tBaO0tMDJ-n6anrMpKdBEh8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240708-chicken-broccoli-stir-fry-ddmfs-step1-3x4-2404-f09176fa88154b51a371bf696424af85.jpg"
      ],
      "image": "assets/images/240708/step_01.webp"
    },
    {
      "text": "Heat oil in a large non-stick skillet over medium-high until shimmery, about 2 minutes. Meanwhile, toss chicken and 1 tablespoon cornstarch together in a medium bowl until chicken is coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/y7P_Y_ZUI4McxeJx756Q7TOOxFc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240708-chicken-broccoli-stir-fry-ddmfs-step2-3x4-2407-111424e413de45dca5460991dcd49cb6.jpg"
      ],
      "image": "assets/images/240708/step_02.webp"
    },
    {
      "text": "Add chicken to the skillet in a single layer; cook, stirring often, until crisp and cooked through, about 6 minutes. Add onions; cook, stirring often, until translucent, about 1 minute. Add garlic and ginger; cook, stirring constantly, until fragrant, about 1 minute. Transfer chicken mixture to a plate; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V23e-UOwEBHy80paRAZdA8CQVFQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240708-chicken-broccoli-stir-fry-ddmfs-step3-3x4-2412-cc2042a99ca847f9838c7b528e2fe4d9.jpg"
      ],
      "image": "assets/images/240708/step_03.webp"
    },
    {
      "text": "Cook broccoli in the same skillet over medium-high heat, stirring occasionally, until bright green and heated through, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5b7IQIzp5dntbWDYMj8f8clejvc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240708-chicken-broccoli-stir-fry-ddmfs-step5-3x4-2421-e4111855c54f488cbb4ca7f412d9601a.jpg"
      ],
      "image": "assets/images/240708/step_04.webp"
    },
    {
      "text": "Meanwhile, whisk water, soy sauce, oyster sauce, brown sugar, red pepper flakes, black pepper, and remaining 2 tablespoons cornstarch together in a small bowl until smooth, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9e4i3Z1z255dnKIGWNZz8X3uHBc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240708-chicken-broccoli-stir-fry-ddmfs-step6-3x4-2422-4a5070715eea4fdca50f43923d38226e.jpg"
      ],
      "image": "assets/images/240708/step_05.webp"
    },
    {
      "text": "Stir chicken mixture into broccoli in the skillet. Add soy sauce mixture; cook, stirring constantly, until broccoli and chicken are well coated, and sauce thickens, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9xy5WSQkyjST5T0uxvTHE0ZgocM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240708-chicken-broccoli-stir-fry-ddmfs-step7-3x4-2426-8914b13cad134668a9d929c8cc6cd276.jpg"
      ],
      "image": "assets/images/240708/step_06.webp"
    },
    {
      "text": "Serve immediately. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zSe9IVrU4wmTCKFWx2jOhEbovqM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240708-chicken-broccoli-stir-fry-ddmfs-3x4-2441-3a0afb6c6a914d64919f93b4c5b53562.jpg"
      ],
      "image": "assets/images/240708/step_07.webp"
    }
