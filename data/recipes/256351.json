  "ingredients": [
    "2 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "1 cup white sugar",
    "0.5 cup butter, melted",
    "2 eggs",
    "1.5 cups mashed bananas",
    "1 cup dried cranberries",
    "0.5 cup chopped walnuts",
    "0.25 cup packed brown sugar",
    "3 tablespoons all-purpose flour",
    "2 tablespoons butter, cut into 1/4-inch cubes",
    "0.33333334326744 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 16 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 cups flour, baking powder, cinnamon, baking soda, nutmeg, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, 1/2 cup melted butter, and eggs in another bowl; whisk until smooth. Stir in bananas, cranberries, and 1/2 cup walnuts; fold in flour mixture and stir until a lumpy batter forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and 3 tablespoons flour in a small bowl. Cut in 2 tablespoons cubed butter with a pastry cutter or two knives until pea-sized crumbles form. Stir in 1/3 cup walnuts; sprinkle streusel over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 20 to 25 minutes. Cool for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
