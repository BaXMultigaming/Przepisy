  "ingredients": [
    "1 pound lean ground beef",
    "1 onion, chopped",
    "1 green bell pepper, chopped",
    "1 teaspoon Italian seasoning",
    "salt and pepper to taste",
    "2 (6 ounce) cans tomato paste",
    "2.25 cups water",
    "1 pint part-skim ricotta cheese",
    "1 egg",
    "2 cups shredded mozzarella cheese",
    "8 lasagne noodles, cooked and drained"
  ],
  "steps": [
    {
      "text": "Brown meat with onions and bell peppers, and season to taste. Add tomato paste and water. Let simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, mix ricotta cheese with beaten egg. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 370 degrees F (190 degrees C). Butter a 9 x 13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Begin layering all ingredients beginning with a few spoonfuls of tomato sauce. Follow with noodles, then ricotta mixture, and shredded mozzarella. Repeat until dish is filled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) about 35 to 45 minutes, until bubbly. Let cool a couple of minutes before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
