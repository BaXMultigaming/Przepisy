  "ingredients": [
    "1 (8 ounce) package linguine pasta",
    "1 tablespoon butter",
    "1 onion, finely chopped",
    "3 cloves garlic, minced",
    "1 cup sliced fresh mushrooms",
    "1.5 cups whipping cream",
    "0.25 pound cooked ham, julienned",
    "1 teaspoon fresh basil leaves, chopped",
    "freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add linguine pasta, and cook for 8 to 10 minutes, or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saute pan over medium heat. Cook and stir onion, garlic, and mushrooms in butter until tender. Reduce heat, and slowly stir in cream. Continue cooking until sauce has thickened, add ham and basil, and simmer for 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, toss linguine with cream sauce, and season with freshly ground black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
