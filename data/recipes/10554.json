  "ingredients": [
    "0.75 cup butter flavored shortening",
    "1 cup packed brown sugar",
    "1 egg",
    "0.25 cup molasses",
    "2 cups all-purpose flour",
    "0.25 teaspoon salt",
    "2 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cloves",
    "1 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Cream together until light and fluffy butter flavored shortening and brown sugar. Add egg and molasses and beat well. Sift together flour, salt, baking soda, cinnamon, ground cloves and ginger. Add to creamed mixture and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill at least 1 hour or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll into 1-inch balls, roll in sugar. Place balls 2 inches apart on ungreased cookie sheet. Bake for 10 minutes. Cool slightly before removing from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
