  "ingredients": [
    "nonstick cooking spray",
    "1.3333300352097 cups quick cooking oats",
    "0.5 cup white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 cup raisins",
    "1 cup mashed bananas",
    "0.25 cup skim milk",
    "2 egg whites",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking pan with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together oats, sugar, baking powder, cinnamon, baking soda, and raisins. In a separate bowl mix together bananas, milk, egg whites, and vanilla. Beat all together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to prepared pan. Bake in preheated oven for about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool and cut into 36 bars. You may sprinkle with cinnamon and sugar, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
