  "ingredients": [
    "1 pound tilapia fillets",
    "1 tablespoon butter",
    "1 garlic clove, minced",
    "1 teaspoon chopped fresh tarragon",
    "0.25 cup apple cider vinegar"
  ],
  "steps": [
    {
      "text": "In a microwavable baking dish, arrange tilapia fillets in a single layer. Dot with pieces of butter, and minced garlic. Sprinkle over fresh tarragon. Cover with waxed paper and microwave on high for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn fillets over, recover, and continue to microwave on high for a further 2 minutes. Remove immediately, sprinkle with apple cider vinegar, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
