  "ingredients": [
    "1 (16 ounce) package uncooked orzo",
    "0.5 cup olive oil",
    "2 tablespoons butter",
    "0.5 teaspoon minced garlic",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon crushed red pepper flakes",
    "1 cup pine nuts",
    "1 (10 ounce) bag baby spinach",
    "0.125 cup balsamic vinegar",
    "1 (8 ounce) package crumbled feta cheese",
    "0.5 fresh tomato, chopped",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes. (Firm or slightly undercooked orzo works best for this dish.) Drain, transfer to a mixing bowl, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil and butter in a large skillet over medium high heat, stirring to blend. Stir in garlic, basil, and red pepper flakes, and reduce heat to medium. Stir in pine nuts and cook until lightly browned. Add spinach, cover, and cook on low heat for 5 minutes, or until spinach is wilted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss spinach mixture with orzo pasta. Portion onto serving plates with a drizzle of balsamic vinegar and a sprinkling of crumbled feta cheese and chopped tomatoes. Allow guests to adjust seasoning with salt, as needed. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
