  "ingredients": [
    "1 cup butter",
    "2 cups white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1 tablespoon molasses",
    "2 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "1 cup chopped walnuts",
    "2 cups quick cooking oats",
    "0.5 cup semisweet chocolate chips",
    "0.66666668653488 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together the butter and sugar. Add eggs, molasses and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, combine the flour, cinnamon, and baking soda. Gradually add to the cream mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in oatmeal, raisins, nuts and chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoonfuls onto greased cookie sheet. Bake for 12 minutes or until light brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
