  "ingredients": [
    "1 pound ground round",
    "1 cup chopped onion",
    "2 (14.5 ounce) cans diced tomatoes with garlic, undrained",
    "1 (15 ounce) can kidney beans, rinsed and drained",
    "1 (15 ounce) can black beans, rinsed and drained",
    "1 (14.5 ounce) can whole kernel corn, drained",
    "1 cup hot water",
    "0.33300000429153 cup semisweet chocolate chips",
    "1 tablespoon ground cumin",
    "2 teaspoons chili powder",
    "1 teaspoon salt",
    "0.5 teaspoon dried oregano"
  ],
  "steps": [
    {
      "text": "Cook and stir ground beef and onion in a large saucepan over medium-high heat until beef is browned and crumbly, about 5 minutes. Transfer beef and onion to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomatoes, kidney beans, black beans, corn, hot water, chocolate chips, cumin, chili powder, salt, and oregano into beef and onion mixture. Cover the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High until chili begins to bubble, about 20 minutes. Reduce heat to Low; cook until thick, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
