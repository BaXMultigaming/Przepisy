  "ingredients": [
    "2 avocados - peeled, pitted, and chopped",
    "1 cup chopped tomatoes",
    "1 tablespoon lime juice or tequila",
    "1 (1 ounce) package McCormick® Guacamole Seasoning Mix",
    "1 (8 ounce) package whipped cream cheese",
    "0.5 cup sour cream",
    "0.25 cup cocktail sauce, divided",
    "0.75 cup small cooked shrimp, cut into bite-size pieces"
  ],
  "steps": [
    {
      "text": "Mix avocados, tomatoes, lime juice and Seasoning Mix in medium bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese and sour cream in small bowl. Spread in 9-inch glass pie plate. Drizzle with half of the cocktail sauce. Top with avocado mixture and shrimp. Drizzle with remaining cocktail sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with sliced baguette or crackers.",
