  "ingredients": [
    "2.5 cups rolled oats",
    "1 cup candy-coated milk chocolate pieces (such as M&M's®)",
    "1 cup all-purpose flour",
    "1 cup flax seed meal",
    "0.33333334326744 cup brown sugar",
    "0.75 teaspoon salt",
    "1 egg",
    "0.5 cup honey",
    "0.5 cup vegetable oil",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oats, milk chocolate pieces, flour, flax seed meal, brown sugar, and salt together in a large bowl. Make a well in the center of the oat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg in a separate bowl until light and fluffy. Add honey, oil, and vanilla; whisk until well-combined. Pour egg mixture into the well in the oat mixture. Stir until evenly combined. Pour mixture into a 9x13-inch glass baking dish; pat down and spread the mixture flat, leaving at least 1-inch of space between the mixture and the sides of the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and set, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
