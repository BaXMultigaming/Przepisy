  "ingredients": [
    "2 tablespoons tandoori masala powder",
    "1 teaspoon onion powder",
    "1 teaspoon garlic powder",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon amchur powder",
    "0.5 teaspoon cayenne pepper, or to taste",
    "1.5 pounds chicken breasts",
    "0.5 cup whole-milk buttermilk"
  ],
  "steps": [
    {
      "text": "Combine tandoori masala, onion powder, garlic powder, ginger, amchur powder, and cayenne pepper in a bowl. Rub mixture onto chicken breasts and coat with buttermilk in a bowl. Cover and let marinate in the refrigerator, 4 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Remove chicken from marinade and arrange over a greased or lined sheet pan. Discard any extra marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast chicken in the preheated oven until no longer pink in the center and an instant-read thermometer inserted into the center reads at least 160 degrees F (71 degrees C), 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
