  "ingredients": [
    "3 cups all-purpose flour",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1 cup shortening",
    "1 cup white sugar",
    "2 large eggs",
    "1.5 teaspoons vanilla extract",
    "0.33333334326744 cup colored sugar for decoration"
  ],
  "steps": [
    {
      "text": "Combine flour, salt, and baking soda in a large bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together shortening, sugar, eggs, and vanilla in a separate large bowl. Mix in flour mixture with your hands until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 3 parts; shape each part into a cylinder, 1 1/2 inches in diameter and about 7 inches long. Roll cylinders in colored sugar. Chill, covered, in the refrigerator for several hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut cylinders into 1/4-inch slices and place on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 8 to 10 minutes. Cool on the baking sheets briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
