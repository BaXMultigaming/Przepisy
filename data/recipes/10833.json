  "title": "Refrigerator Cookies",
  "description": "This refrigerator cookie recipe is made with shortening, sugar, eggs, and flour and keeps well in the freezer for several months.",
  "authors": [
    "Stephanie"
  ],
  "date_published": "1998-04-24T15:18:56-04:00",
