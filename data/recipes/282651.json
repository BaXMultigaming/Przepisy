  "ingredients": [
    "2.25 cups all-purpose flour",
    "0.5 cup unsweetened cocoa",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup unsalted butter, at room temperature",
    "1 cup packed brown sugar",
    "0.5 cup white sugar",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "1.5 cups dried cranberries",
    "1.5 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease two cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cocoa, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, brown sugar, and white sugar together with an electric mixer in a large bowl. Add eggs, one at a time, mixing after each addition. Mix in vanilla extract. Gradually add flour mixture until combined. Mix in cranberries and chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place rounded tablespoonfuls of dough 2 inches apart on the prepared cookie sheets. Flatten each ball slightly with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are soft and tops are no longer glossy, 12 to 14 minutes. Let cool for 5 minutes on the cookie sheet, then remove to a cooling rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
