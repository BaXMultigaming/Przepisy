  "ingredients": [
    "1.6666667461395 cups warm water",
    "4 teaspoons molasses",
    "1 tablespoon active dry yeast",
    "2.6666667461395 cups whole wheat flour",
    "0.75 cup ground flax seed",
    "0.66666668653488 cup bread flour",
    "0.5 cup oat bran",
    "0.33333334326744 cup rolled oats",
    "0.33333334326744 cup amaranth seeds",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Place water, molasses, yeast, wheat flour, ground flax seed, bread flour, oat bran, rolled oats, amaranth seeds, and salt in the pan of a bread machine in the order recommended by the manufacturer. Select dough cycle; press start and allow machine to run complete dough cycle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough onto a lightly floured surface. Form dough into 2 loaves and place on a baking stone. Cover loaves with a damp cloth and let rise until doubled in volume, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, 20 to 25 minutes. Slide loaf onto a work surface and gently tap bottom of loaf. If it sounds hollow, the bread is done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
