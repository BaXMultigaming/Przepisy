  "ingredients": [
    "cooking spray (such as Pam®)",
    "3 cups bite-sized cauliflower florets",
    "1 egg",
    "0.5 tablespoon all-purpose flour",
    "0.5 cup milk",
    "salt and ground black pepper to taste",
    "2 cups shredded sharp Cheddar cheese",
    "1 pinch ground paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cauliflower in a microwave-safe bowl with 1/2 cup water. Microwave until tender-crisp, about 5 minutes. Drain and transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg and flour together in a bowl. Add milk, salt, and pepper. Pour over cauliflower florets. Sprinkle Cheddar cheese and paprika on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and cauliflower is soft, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
