  "title": "Chicken Bog",
  "description": "This chicken bog is the epitome of Lowcountry cooking, made with chicken, smoked sausage, rice, and onion. Perfect comfort food for a cold night!",
  "authors": [
    "MARBALET"
  ],
  "date_published": "1999-12-05T11:30:18-05:00",
