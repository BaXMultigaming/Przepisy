  "title": "German Sweet Chocolate Cake",
  "description": "This German sweet chocolate cake with coconut-pecan frosting is a favorite dish at all our potlucks.",
  "authors": [
    "Cindy Carnes"
  ],
  "date_published": "1999-08-08T15:06:49-04:00",
  "date_modified": "2022-09-25T17:01:37-04:00",
  "prep_time": "PT40M",
