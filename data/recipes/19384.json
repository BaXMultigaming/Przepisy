  "ingredients": [
    "1 pound penne pasta",
    "1 head broccoli, cut into florets",
    "1 red bell pepper, julienned",
    "1 (6.5 ounce) jar marinated artichoke hearts",
    "0.25 cup grated Parmesan cheese",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 minutes. Add broccoli and cook 2 minutes more. Drain pasta and broccoli and rinse with cold water until cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large bowl, combine pasta, broccoli, red bell pepper, the artichoke hearts with their marinade, Parmesan, salt and pepper. Toss, adjust seasoning and serve.",
