  "ingredients": [
    "1 cup all-purpose flour",
    "0.33333334326744 cup packed brown sugar",
    "5 tablespoons butter, softened",
    "0.5 cup finely chopped pecans",
    "1 (8 ounce) package cream cheese",
    "0.75 cup white sugar",
    "0.5 cup pumpkin puree",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground allspice",
    "1.5 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and brown sugar in a bowl. Cut butter into flour mixture until small crumbs form. Stir pecans into the crumbs. Set 3/4 cup of the mixture aside for topping the bars; press remainder of the mixture into the bottom of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake crust in preheated oven until lightly browned, about 15 minutes; remove from oven and set aside to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, white sugar, pumpkin puree, eggs, vanilla extract, allspice, and cinnamon together in a bowl until smooth; pour over the cooled crust. Sprinkle reserved topping over the cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return dish to oven and continue baking until the topping browns, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
