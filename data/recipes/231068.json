  "title": "Easy Pumpkin Cheesecake Bars",
  "description": "Pumpkin-flavored cheesecake bars on a homemade crust studded with pecans make a delightful treat.",
  "authors": [
    "ANGELAH100"
  ],
  "date_published": "2020-06-18T23:53:11-04:00",
