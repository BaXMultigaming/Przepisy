  "title": "Braised Lamb Shoulder Chops",
  "description": "These lamb shoulder chops are baked low and slow with sautéed onion, garlic, and rosemary for tender blade chops served with luscious red wine gravy.",
  "authors": [
    "kalphen"
  ],
  "date_published": "2019-04-03T23:59:23-04:00",
