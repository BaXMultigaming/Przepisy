  "ingredients": [
    "1 tablespoon olive oil",
    "2 pounds lamb shoulder chops, or more to taste",
    "salt and ground black pepper to taste",
    "1 small yellow onion, sliced",
    "4 cloves garlic, minced",
    "2 tablespoons chopped fresh rosemary",
    "1 cup beef broth",
    "1 cup red wine",
    "0.5 cup water",
    "2 tablespoons cornstarch",
    "1 tablespoon Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cgMq3zZgesMn2ys8SrhPssqOaz0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241480-braised-lamb-shoulder-chops-ddmfs-Step-1-1419-f0ceba77ae3b4414a4ab4c6a83418d97.jpg"
      ],
      "image": "assets/images/241480/step_01.webp"
    },
    {
      "text": "Heat olive oil in a skillet over medium-high heat. Season lamb chops with salt and pepper. Sear lamb in hot oil until browned, 1 to 2 minutes per side. Remove chops to a plate, reserving drippings in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HqlTfjXLP2kTLJS8QbrZ4YH7M7E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241480-braised-lamb-shoulder-chops-ddmfs-Step-2-1421-db09d3862ca34c41af5f2e2160028297.jpg"
      ],
      "image": "assets/images/241480/step_02.webp"
    },
    {
      "text": "Sauté onion and garlic in reserved drippings over medium heat until onion is tender, about 5 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DyFQgW7nrEoNdHcBo4vgv5FmLdM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241480-braised-lamb-shoulder-chops-ddmfs-Step-3-1424-0628934bb7564749b473206de55e1cb9.jpg"
      ],
      "image": "assets/images/241480/step_03.webp"
    },
    {
      "text": "Transfer lamb chops to a baking dish; add onion mixture. Sprinkle rosemary over chops. Pour beef broth and red wine into the baking dish. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Xv0dg79tSr7yJRQpwN5tlUE9Ih8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241480-braised-lamb-shoulder-chops-ddmfs-Step-5-1436-57afe6cfde344f67a76e2824a2aca211.jpg"
      ],
      "image": "assets/images/241480/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 3 hours. Remove lamb chops to a serving platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully pour liquid from the baking dish into a saucepan. Whisk together water and cornstarch in a bowl until no lumps remain; stir into liquid in the saucepan. Add Worcestershire sauce and cook over medium heat until thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c_OfJfgjMA4FuUFnFoRVAOkGXMA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241480-braised-lamb-shoulder-chops-ddmfs-Step-6-1440-d66f9e80bfa74b3283129aa35c4a5752.jpg"
      ],
      "image": "assets/images/241480/step_06.webp"
    },
    {
      "text": "Spoon sauce over lamb chops and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T5rtK7ay3QfUochBT_BjNmUpNPM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241480-braised-lamb-shoulder-chops-ddmfs-3X4-1468-53cee20a3fc94ef880f654ab5bfdf88d.jpg"
      ],
