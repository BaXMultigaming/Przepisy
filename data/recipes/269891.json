  "ingredients": [
    "0.5 cup all-purpose flour",
    "0.5 teaspoon salt, divided, or more to taste",
    "0.5 teaspoon ground black pepper",
    "2 eggs",
    "2 tablespoons water",
    "1 cup panko bread crumbs",
    "2 teaspoons vegetable oil",
    "0.5 cup whole green beans",
    "0.5 cup whole asparagus spears",
    "0.5 cup red onion rings",
    "0.5 cup sweet pepper rings",
    "0.5 cup avocado wedges",
    "0.5 cup zucchini slices"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C) and the oven to 200 degrees F (95 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 1/4 teaspoon salt, and pepper in a shallow dish. Whisk eggs and water together in another shallow dish. Stir panko and oil together in a third shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle green beans, asparagus, red onion, sweet pepper, avocado, and zucchini with remaining 1/4 teaspoon salt; dip in flour mixture, then in egg mixture, and finally in panko mixture to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange half of the vegetables in a single layer in the air fryer basket. Cook until golden brown, about 8 to 10 minutes. Sprinkle with additional salt, if desired. Transfer vegetables to oven to keep warm. Repeat with remaining vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
