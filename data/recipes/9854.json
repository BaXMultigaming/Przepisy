  "ingredients": [
    "0.5 cup butter, softened",
    "0.75 cup packed brown sugar",
    "0.5 cup shortening",
    "0.5 cup white sugar",
    "1 egg",
    "1.5 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup white chocolate chips",
    "7 ounces macadamia nuts, chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C). Lightly grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and shortening until soft and creamy. Gradually add the sugars and beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add egg and vanilla and beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, soda and salt; gradually add to butter mixture beating well after each addition. Stir in chips and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded teaspoonfuls onto lightly greased cookie sheets. Bake for 10-12 minutes or until done. Remove to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
