  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup whole wheat flour",
    "2 teaspoons baking soda",
    "1.5 cups brown sugar",
    "0.66666668653488 cup chocolate-hazelnut spread (such as Nutella®)",
    "0.5 cup butter, softened",
    "0.5 cup white sugar",
    "2 eggs",
    "1.5 teaspoons vanilla extract",
    "2 cups milk chocolate chips",
    "0.5 cup rainbow chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 cookie sheets or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk both flours and baking soda together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream the brown sugar, chocolate-hazelnut spread, butter, and white sugar in a large bowl with an electric mixer. Beat in eggs and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the flour mixture to the butter mixture; stir until a stiff dough forms. Mix in chocolate chips and rainbow chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 2-inch balls. Place 1 to 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies have risen, 10 to 12 minutes. Cool on the baking sheet for 5 to 10 minutes; cookies will firm up as they cool. Remove to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
