  "ingredients": [
    "1 tablespoon olive oil",
    "0.5 cup chopped onion",
    "0.5 cup vegetable broth",
    "0.5 cup chopped mushrooms",
    "2 teaspoons minced garlic",
    "1 teaspoon Italian seasoning",
    "1 teaspoon red wine vinegar",
    "0.5 teaspoon salt",
    "0.25 teaspoon crushed red pepper flakes",
    "1 cup cooked brown lentils",
    "1 cup torn baby spinach",
    "2 red bell peppers, tops removed, seeded"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add onion and broth and cook for 3 minutes. Stir in mushrooms, garlic, Italian seasoning, vinegar, salt, and crushed red pepper flakes; cook for 2 minutes. Remove from heat and stir in lentils and spinach.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bell peppers in a baking dish and divide filling between both peppers. Cover dish with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Uncover and continue cooking for 10 minutes, or until peppers reach desired softness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
