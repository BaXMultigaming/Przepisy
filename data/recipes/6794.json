  "ingredients": [
    "1 cup canned sweet potato puree",
    "3 egg yolks",
    "1 cup milk",
    "1.5 cups cake flour",
    "1 tablespoon baking powder",
    "1 tablespoon white sugar",
    "1 teaspoon salt",
    "1 teaspoon ground nutmeg",
    "0.25 cup chopped pecans",
    "3 egg whites",
    "3 tablespoons butter, melted",
    "2 tablespoons pecans, chopped"
  ],
  "steps": [
    {
      "text": "Stir together flour, baking powder, sugar, salt, nutmeg, and 1/4 cup pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sweet potato puree, egg yolks, and milk in a large bowl until well combined. Add flour mixture, and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites until stiff peaks form. Fold 1/4 of the egg whites into batter. Lightly fold remaining whites and melted butter into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in a hot waffle iron. Garnish with more chopped pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
