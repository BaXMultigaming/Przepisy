  "ingredients": [
    "2 egg whites",
    "0.125 teaspoon salt",
    "0.125 teaspoon cream of tartar",
    "1 teaspoon vanilla extract",
    "0.75 cup white sugar",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C). Line cookie sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3GXbTWxbErsU3OY6pssL111xs2o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9847-meringue-cookies-VAT-step-01-3d88580eb168416eb8f0fb25e79d2ed0.jpg"
      ],
      "image": "assets/images/9847/step_01.webp"
    },
    {
      "text": "Beat egg whites, salt, cream of tartar, and vanilla in a clean bowl until soft peaks form. Gradually add sugar while continuing to whip until stiff peaks form, about 5 minutes. Fold in chocolate chips if using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/frXPd-UP63h1ZBeK-7fbFuezjpk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9847-meringue-cookies-VAT-step-02-68bed0e60094429086db88f903a380d7.jpg"
      ],
      "image": "assets/images/9847/step_02.webp"
    },
    {
      "text": "Drop by heaping teaspoonfuls, one inch apart onto the prepared cookie sheets. Bake in the preheated oven until just lightly browned, about 25 minutes. Cool on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O3topDOF2oa1J3XYCfNpvFz2zaE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9847-meringue-cookies-VAT-step-03-5b2d8881885846e5aff6f44121bbfa62.jpg"
      ],
