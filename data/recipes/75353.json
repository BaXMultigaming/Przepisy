  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix the 3/4 cup oats, wheat germ, flour, sugar, walnuts, salt, and baking powder. Stir in the milk, oil, and egg just until dry ingredients are evenly moist. Fold in the blueberries. Scoop batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1/3 cup oats, brown sugar, and cinnamon in a small bowl, and sprinkle over the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 20 minutes in the preheated oven, or until a knife inserted in the center of a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
