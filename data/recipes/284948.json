  "ingredients": [
    "2 small acorn squash, seeded and quartered",
    "1 teaspoon olive oil, or as needed",
    "1 teaspoon coarse salt, or to taste",
    "2 tablespoons unsalted butter, melted",
    "ground black pepper to taste",
    "2 tablespoons freshly grated Parmesan cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly oil a baking sheet with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put quartered squash on the prepared baking sheet, skin-side down. Sprinkle lightly with salt; don't add too much!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast squash in the preheated oven until tender when poked with a fork, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and brush squash pieces with melted butter. Season with pepper, then sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
