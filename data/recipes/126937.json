  "ingredients": [
    "6 ounces dried salted cod fish",
    "cold water, to cover",
    "1 cup all-purpose flour",
    "2 teaspoons ground black pepper",
    "1 teaspoon baking powder",
    "1 large tomato, chopped",
    "2 green onions, chopped",
    "0.5 cup water",
    "vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Soak cod in cold water to rehydrate it and remove excess salt, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove bones and skin from fish. Flake and shred fish into small pieces; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, pepper, and baking powder into a large bowl. Add tomatoes, green onions, and flaked cod. Pour in 1/2 cup water; stir until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1/4 inch of oil in a large, heavy skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop rounded spoonfuls of batter into the skillet; fry in hot oil until golden brown and crisp, about 5 minutes per side. Drain on paper towels and serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
