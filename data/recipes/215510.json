  "ingredients": [
    "8 cups peeled, thinly sliced cucumbers",
    "1 large sweet onion, thinly sliced",
    "1 tomato, seeded and chopped",
    "1.5 cups white sugar",
    "1 cup distilled white vinegar",
    "0.25 cup balsamic vinegar",
    "1.5 tablespoons salt",
    "1 teaspoon celery seed"
  ],
  "steps": [
    {
      "text": "Combine cucumbers, onion, and tomato in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, white vinegar, balsamic vinegar, salt, and celery seeds together in a separate bowl until sugar is dissolved; pour over vegetables and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl; refrigerate before serving, about 12 hours.",
      "section": null,
      "name": null,
      "url": null,
