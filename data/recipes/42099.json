  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup flaked coconut",
    "1 cup chopped dates",
    "0.5 cup white sugar",
    "1 teaspoon baking powder",
    "0.25 cup butter",
    "1 tablespoon golden syrup",
    "1 teaspoon vanilla",
    "0.25 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease and flour a 9 inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine flour, 1 cup coconut, dates, sugar and baking powder. In a saucepan, melt butter, golden syrup and vanilla. Pour over mixture in bowl. Mix until crumbly, then press into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 to 30 minutes. Sprinkle top with 1/8 cup coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
