  "ingredients": [
    "1 medium onion, quartered",
    "0.25 cup vegetable oil",
    "4 cloves garlic",
    "4 tablespoons lemon juice",
    "1 tablespoon dried oregano",
    "1 tablespoon paprika",
    "1 tablespoon kosher salt",
    "1 teaspoon cumin",
    "1 dash Worcestershire sauce",
    "1 pound boneless lamb shoulder, cut into 1-inch cubes"
  ],
  "steps": [
    {
      "text": "Blend onion, vegetable oil, garlic, lemon juice, oregano, paprika, salt, cumin, and Worcestershire sauce together in a blender until smooth and creamy to form marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place lamb cubes in a large, resealable plastic bag. Pour marinade into the bag, making sure each piece is coated. Refrigerate 4 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
