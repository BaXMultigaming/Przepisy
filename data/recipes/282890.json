  "title": "Vegan Southern Greens",
  "description": "Loaded with okra, black-eyed peas, kale, and chard, this spicy, Southern-style side dish is hearty enough to serve as a vegan main course.",
  "authors": [
    "cherimarie"
  ],
  "date_published": "2011-11-12T02:12:10-05:00",
