  "ingredients": [
    "0.25 cup all-purpose flour, or as needed",
    "1/8 teaspoon garlic powder",
    "1/8 teaspoon onion powder",
    "1 pound cube steak",
    "salt and pepper to taste",
    "2 tablespoons vegetable oil",
    "2 cups beef broth",
    "Worcestershire sauce",
    "1 medium onion, sliced",
    "1 medium green bell pepper, sliced",
    "1 cup sliced mushrooms",
    "1 clove garlic, minced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Combine flour, garlic powder, and onion powder in a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season steak with seasoned salt and pepper, then dredge in flour mixture; shake off any excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large frying pan over medium-high heat. Sear steaks in hot oil, then transfer to a large casserole dish. Pour beef broth and Worcestershire sauce into the dish; cover tightly with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Sprinkle onion, pepper, mushrooms, and garlic over top; continue to cook until steak is tender and vegetables are soft, about 20 to 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
