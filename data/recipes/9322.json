  "ingredients": [
    "0.33333334326744 cup butter",
    "0.33333334326744 cup margarine",
    "1 cup packed brown sugar",
    "1 cup shredded coconut",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.125 teaspoon ground allspice",
    "0.5 cup chopped walnuts",
    "0.5 teaspoon salt",
    "2 eggs, beaten",
    "2 teaspoons fresh lemon juice",
    "0.66666668653488 cup dark corn syrup",
    "1 (9 inch) pastry for a 9 inch single crust pie"
  ],
  "steps": [
    {
      "text": "Roll pie dough out to 1/4 inch thickness. Cut out circles of dough to fit cups of standard muffin tin. Gently place into muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan, melt butter and margarine over low heat just until melted. Stir in brown sugar, coconut, spices, nuts, salt, eggs, lemon juice, and corn syrup. Mix well. Fill prepared muffin cups halfway with this mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 12 to 15 minutes, or until golden and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
