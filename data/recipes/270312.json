  "ingredients": [
    "1 teaspoon olive oil",
    "0.5 cup sweet onion, minced",
    "4 skinless, boneless chicken breasts",
    "0.5 cup carrots, chopped",
    "12 ounces champagne",
    "12 ounces heavy cream",
    "1 tablespoon chicken base"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a heavy skillet over medium-high heat and cook onions until soft and translucent, about 5 minutes. Add chicken and carrots and cook until chicken is browned on all sides and carrots are tender, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in champagne and simmer until alcohol has evaporated, 3 to 5 minutes. Add cream and chicken base and simmer until sauce has thickened, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
