  "ingredients": [
    "4 egg yolks",
    "1 (5 ounce) can sweetened condensed milk",
    "1 tablespoon white sugar",
    "1 teaspoon vanilla extract",
    "4.5 cups milk",
    "4 egg whites",
    "1 fluid ounce rum",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "In a large mixing bowl, beat egg yolks until they are thickened and light. Gradually stir in condensed milk, sugar, vanilla, and milk. Beat egg whites until stiff, then add them to milk mixture. Stir rum into mixture to taste. Garnish with nutmeg.",
