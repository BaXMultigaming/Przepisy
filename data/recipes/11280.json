  "ingredients": [
    "1 cup shortening",
    "2 cups white sugar",
    "2 eggs",
    "1 cup buttermilk",
    "0.5 cup orange juice",
    "2 tablespoons orange zest",
    "4.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "0.25 cup butter",
    "4 cups confectioners' sugar",
    "3 tablespoons thawed orange juice concentrate"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease or line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the shortening, white sugar and eggs together until light and fluffy. Beat in the buttermilk, orange juice and grated orange zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the flour, baking powder, salt and baking soda. Stir the flour into the shortening mixture and mix until combined. Drop rounded tablespoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 10 minutes. While still warm spread with orange icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Orange Icing: Combine the butter or margarine, confectioners' sugar and orange juice concentrate and beat until smooth. Add more orange juice concentrate if necessary to reach the desired consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
