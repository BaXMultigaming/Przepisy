  "ingredients": [
    "2 tablespoons butter",
    "1 cup white sugar",
    "0.25 teaspoon salt",
    "0.33333334326744 cup half-and-half cream",
    "1 cup miniature marshmallows",
    "1 cup cherry baking chips",
    "1 cup semisweet chocolate chips",
    "0.5 cup peanut butter",
    "1 cup roasted Spanish peanuts"
  ],
  "steps": [
    {
      "text": "Line an 8x8 or 9x9 inch square pan with waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan, combine butter, sugar, salt and half and half. Heat until boiling, stirring occasionally. Boil for 5 minutes, stirring enough to keep from scorching. Remove from heat and stir in the marshmallows, and cherry chips. Press the mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the microwave or in a metal bowl over a pan of simmering water, melt chocolate chips, and peanut butter together stirring frequently until smooth. Spread over the mixture in the pan. Refrigerate for 2 hours before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
