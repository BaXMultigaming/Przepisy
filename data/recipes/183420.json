  "ingredients": [
    "4 cups fresh or frozen cranberries",
    "1 cup water",
    "2 cups white sugar",
    "2 (4 inch) cinnamon sticks",
    "0.5 teaspoon salt",
    "0.5 cup chopped onion",
    "1 cup raisins",
    "1 cup thin apple slices",
    "1 cup thin pear slices",
    "0.5 cup sliced celery",
    "0.5 cup sliced almonds",
    "2 teaspoons lemon zest"
  ],
  "steps": [
    {
      "text": "Combine cranberries, water, sugar, cinnamon sticks, and salt in a large saucepan. Bring to a boil, reduce heat, and cook until berries begin to burst, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in onion, raisins, apple, pear, and celery. Cook on medium heat 15 minutes, stirring occasionally. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the almonds and lemon zest to combine. Remove cinnamon sticks. Cool before serving, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
