  "ingredients": [
    "1 tablespoon canola oil",
    "1 head cabbage, chopped",
    "2 tablespoons garlic basil spread (see footnote for recipe link)",
    "1 cup sauerkraut",
    "0.5 cup sweet hot mustard",
    "1 pound sliced pastrami",
    "2 cups shredded Swiss cheese",
    "4 Italian-style hoagie buns, split lengthwise and toasted",
    "0.25 cup spicy brown mustard",
    "16 slices Swiss cheese",
    "0.5 onion, diced",
    "2 tomatoes, cut into wedges"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot or Dutch oven over medium heat; cook and stir cabbage and garlic basil spread until cabbage begins to soften, about 5 minutes. Add sauerkraut, sweet hot mustard, and pastrami; cook and stir until hot, 3 to 4 minutes. Stir in 2 cups shredded Swiss cheese and cook until melted, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread each hoagie bun with 1 tablespoon spicy brown mustard. Top with 4 slices Swiss cheese and evenly distribute the pastrami mixture among the sandwiches. Sprinkle with diced onion and top with tomato wedges.",
