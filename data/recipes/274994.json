  "ingredients": [
    "cooking spray",
    "2 (8 ounce) packages refrigerated crescent rolls",
    "1 cup mayonnaise",
    "1 (8 ounce) package cream cheese, softened",
    "0.25 teaspoon garlic salt",
    "1 pound bacon strips, cooked and chopped",
    "2 large tomatoes, chopped and seeded",
    "3 green onions, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a cookie sheet with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll crescent rolls and pat onto the prepared pan. Let stand for 5 minutes; poke in several places using a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 10 minutes. Remove from the oven and let cool, at least 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat mayonnaise, cream cheese, and garlic salt together using an electric mixer in a mixing bowl. Spread onto cooled crescent rolls. Sprinkle bacon on top of cheese spread. Sprinkle tomatoes on top of bacon, followed by green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
