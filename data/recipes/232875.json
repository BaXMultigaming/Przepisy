  "ingredients": [
    "cooking spray",
    "3 cups gluten-free all purpose baking flour",
    "2 cups white sugar",
    "0.33333334326744 cup cocoa powder",
    "2.25 teaspoons baking powder",
    "1.5 teaspoons baking soda",
    "1.5 teaspoons xanthan gum",
    "1.5 cups mayonnaise",
    "1.5 cups hot water",
    "1.5 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray two 9-inch cake pans with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, cocoa powder, baking powder, baking soda, and xanthan gum in a bowl; stir in mayonnaise until well mixed. Gradually pour in hot water and vanilla extract; stir until smooth. Spoon batter into the prepared cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the cake comes out clean and the cake slightly pulls away from the sides of the pan, about 30 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
