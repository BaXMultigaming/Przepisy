  "ingredients": [
    "olive oil for brushing",
    "1 tablespoon honey",
    "1 tablespoon olive oil",
    "2 cloves garlic, grated",
    "1 teaspoon salt",
    "1 teaspoon ground cumin",
    "0.5 teaspoon smoked paprika",
    "0.5 teaspoon dried oregano",
    "0.25 teaspoon ground black pepper",
    "6 (4 ounce) chicken drumsticks",
    "1 cup baby spinach leaves, stems removed",
    "0.75 cup sour cream",
    "0.25 cup cilantro leaves",
    "0.5 jalapeno pepper, seeded",
    "2 tablespoons fresh lime juice",
    "1 clove garlic, smashed",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Brush an air fryer basket with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine honey, 1 tablespoon olive oil, garlic, salt, cumin, paprika, oregano, and pepper in a large bowl. Add drumsticks; toss to coat. Arrange drumsticks vertically in the prepared basket, leaning against the basket wall and one another.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the air fryer at 400 degrees F (200 degrees C) until an instant-read thermometer inserted in the thickest part of drumstick reads 165 degrees F (74 degrees C), 15 to 20 minutes. Rearrange drumsticks with kitchen tongs halfway through cooking for even cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make sauce: Combine spinach, sour cream, cilantro, jalapeño, lime juice, garlic, salt, and pepper in the bowl of a food processor; process until crema sauce is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle some crema sauce over drumsticks and serve with remaining crema.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
