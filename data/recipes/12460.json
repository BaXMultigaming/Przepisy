  "ingredients": [
    "16 chocolate wafer cookies, crushed",
    "4 tablespoons butter, melted",
    "0.75 cup milk, warmed",
    "24 large marshmallows",
    "0.25 cup creme de menthe liqueur",
    "2 tablespoons white creme de cacao",
    "1 cup whipping cream, whipped",
    "1 cup whipped cream for garnish"
  ],
  "steps": [
    {
      "text": "Mix chocolate cookie crumbs and melted butter. Pat into the bottom and sides of 9- or 10-inch pie dish. Refrigerate at least one hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan, melt marshmallows in milk over medium heat. Remove from heat and cool to room temperature. Add the creme de menthe and creme de cacao and mix well. Fold in the whipped cream. Pour the filling into the chilled pie shell and freeze until firm, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice the pie and add an additional dollop of whipped cream for serving, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
