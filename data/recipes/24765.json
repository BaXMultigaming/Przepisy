  "ingredients": [
    "1 onion, diced",
    "4 slices bacon",
    "2 (28 ounce) cans baked beans",
    "0.75 cup brown sugar",
    "0.5 cup diced tomatoes",
    "0.5 cup chopped cooked ham",
    "3 tablespoons molasses",
    "2 tablespoons prepared mustard",
    "1 tablespoon dry mustard",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook onions and bacon in a large, deep skillet over medium-high heat until evenly browned. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beans, onion bacon-mixture, brown sugar, tomatoes, ham, molasses, prepared mustard, dry mustard, and salt in a large bowl; mix well Transfer to a 2-quart casserole dish; cover dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Uncover; bake 1 hour more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
