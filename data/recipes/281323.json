  "ingredients": [
    "5 leaves fresh basil, or more to taste",
    "3 fluid ounces gin (such as Tanqueray®)",
    "1.5 fluid ounces pineapple juice",
    "0.75 fluid ounce lime juice",
    "0.75 fluid ounce simple syrup",
    "0.5 cup ice as needed",
    "0.25 cup club soda, or as needed"
  ],
  "steps": [
    {
      "text": "Place basil and gin into a cocktail shaker and mash well with a cocktail muddler. Add pineapple juice, lime juice, simple syrup, and ice. Cover and shake until the outside of the shaker has frosted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain into an-filled highball glass; top with club soda.",
