  "ingredients": [
    "cooking spray",
    "3 tablespoons butter",
    "0.25 cup flour",
    "1 cup milk",
    "0.5 pound VELVEETA®, cut into 1/2-inch cubes",
    "2 cups elbow macaroni, cooked and drained",
    "0.5 cup KRAFT Shredded Cheddar Cheese",
    "5 tablespoons butter, melted",
    "6 RITZ Crackers, crushed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 2-quart casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 3 tablespoons butter in a medium saucepan over medium heat; whisk in flour. Cook and stir for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/360IGGYpNXedv3LSUx0yPl9usZ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232331-Velveeta-Down-Home-Macaroni-Cheese-ddmfs-Step2-0317-4x3-fb26787635514eafa7dc5321e610c38e.jpg"
      ],
      "image": "assets/images/232331/step_02.webp"
    },
    {
      "text": "Gradually stir in milk and bring to boil; cook and stir until thickened, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AbrSJvCxcmXcCyZVw8KozU6Il28=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232331-Velveeta-Down-Home-Macaroni-Cheese-ddmfs-Step3-0318.-4x3jpg-05c683b7f2e6411a9bc60e4b334d98e0.jpg"
      ],
      "image": "assets/images/232331/step_03.webp"
    },
    {
      "text": "Add Velveeta; cook and stir until melted, about 3 minutes. Stir in cooked macaroni.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d_eg5zfydge8D6XSXr3ZEi8wVLE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232331-Velveeta-Down-Home-Macaroni-Cheese-ddmfs-Step5-0323-4x3-4a4296b4ac7443fbbee965e4dadb935d.jpg"
      ],
      "image": "assets/images/232331/step_04.webp"
    },
    {
      "text": "Transfer mixture to the prepared dish; sprinkle with Cheddar cheese. Combine 5 tablespoons melted butter and cracker crumbs; sprinkle over casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZoyT3_uzxMIOrBmj1Q4GJ1PHWto=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232331-Velveeta-Down-Home-Macaroni-Cheese-ddmfs-Step5-0324-4x3-221554fd9e744818870ba17a62797751.jpg"
      ],
      "image": "assets/images/232331/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until heated through, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eUNV74UfrA2CT6ca_PqPZ5PWvl0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232331-Velveeta-Down-Home-Macaroni-Cheese-ddmfs-beauty-0339-4x3-1a167172ad81474da03ca0d3789ac5b8.jpg"
