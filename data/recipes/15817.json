  "ingredients": [
    "2 cups white sugar",
    "1 cup light corn syrup",
    "0.5 cup butter",
    "0.25 cup water",
    "salt to taste",
    "1 teaspoon vanilla extract",
    "1 teaspoon distilled white vinegar",
    "5 quarts popped popcorn"
  ],
  "steps": [
    {
      "text": "Combine sugar, corn syrup, butter and water in a heavy saucepan over medium heat. Stir and heat to hard-crack stage or 300 degrees F (150 degrees C). Remove from heat, add vanilla or vinegar; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly pour hot syrup over the popcorn while stirring with a long-handled spoon until all kernels are coated. Let mixture cool about 5 minutes until safe to handle. Grease your hands lightly with butter or spray, then form mixture into 3-inch balls. Place on waxed paper to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
