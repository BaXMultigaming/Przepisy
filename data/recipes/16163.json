  "ingredients": [
    "2 pounds ground beef",
    "1.5 cups fresh bread crumbs",
    "2 eggs",
    "0.5 cup milk",
    "0.25 cup chopped onion",
    "1.5 teaspoons salt",
    "1 (18 ounce) bottle barbecue sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, bread crumbs, eggs, milk, onion, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lukwgip6iAt58IOD4dX0M_Ddz4Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16163-barbequed-meatballs-VAT-step-02-5f21c87534634b61be1a03793846e6ed.jpg"
      ],
      "image": "assets/images/16163/step_02.webp"
    },
    {
      "text": "Shape into meatballs, about 1 inch in diameter. Arrange meatballs in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pUtzwDOivnlGBMICOW3Lamb-cOY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16163-barbequed-meatballs-VAT-step-03-4a365ea4cd954894be42e44c903fe267.jpg"
      ],
      "image": "assets/images/16163/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes. Pour barbecue sauce over meatballs and bake for 35 more minutes.",
