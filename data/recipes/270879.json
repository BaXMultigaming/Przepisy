  "ingredients": [
    "0.5 cup ice cubes",
    "4.5 ounces chocolate liqueur (such as Godiva®)",
    "1.25 fluid ounces peppermint schnapps",
    "0.5 cup heavy whipping cream",
    "0.25 teaspoon vanilla extract",
    "1 tablespoon confectioners' sugar",
    "3 drops green food coloring, or as desired",
    "0.5 (1.5 ounce) bar Chocolate shavings"
  ],
  "steps": [
    {
      "text": "Fill a cocktail shaker with ice cubes. Add chocolate liqueur and peppermint schnapps. Shake vigorously for 2 to 3 minutes. Pour into glasses.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat heavy cream and vanilla extract in a chilled glass or metal bowl using an electric mixer until frothy. Add confectioners' sugar gradually, continuing to beat until soft peaks form. Beat in enough food coloring to reach desired shade of green.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a dollop of green whipped cream on top of each shot and garnish with shaved chocolate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
