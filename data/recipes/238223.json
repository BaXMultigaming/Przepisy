  "ingredients": [
    "0.5 cup olive oil",
    "0.5 cup apple cider vinegar",
    "2 tablespoons honey",
    "1 tablespoon tahini",
    "1 clove garlic",
    "1 teaspoon salt",
    "1 teaspoon Italian seasoning",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Blend olive oil, vinegar, honey, tahini, garlic, salt, Italian seasoning, and black pepper together in a blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing into a bowl, cover with plastic wrap, and refrigerate until the flavors blend, at least 1 hour.",
