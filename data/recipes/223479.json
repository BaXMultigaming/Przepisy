  "ingredients": [
    "1 cup milk",
    "1 cup self-rising flour",
    "1 cup white sugar",
    "0.5 cup butter, melted",
    "4 cups sliced peaches",
    "1 tablespoon white sugar, or more to taste (Optional)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease an 11x17-inch baking dish.",
