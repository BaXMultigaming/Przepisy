  "ingredients": [
    "4 eggs",
    "0.25 cup cocoa powder",
    "1 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "1 tablespoon baking powder",
    "1 cup unsalted butter",
    "0.75 cup ground hazelnuts",
    "2 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Whisk the eggs with the sugar and salt until light. Melt the butter and stir in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together all the remaining ingredients except the hazelnuts and fold in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the hazelnuts last.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat Pizzelle iron and place 1 teaspoon of batter on each imprint. Close iron and bake 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool on racks. Sprinkle with powdered sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
