  "ingredients": [
    "4 pounds new potatoes, skinned, cut into 1-inch cubes",
    "1 pound processed cheese food, cubed",
    "2 cups mayonnaise",
    "1 pound bacon, cooked crisp and chopped",
    "1 onion, finely chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a large pan; fill with enough water to cover and bring to a boil. Cook until potatoes are just soft. Drain and place in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently stir processed cheese into hot potatoes without mashing them. Continue to stir every minute or so until cheese is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together mayonnaise, bacon, and onion in a separate bowl. Gently stir into potato-cheese mixture until well combined. Spread into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
