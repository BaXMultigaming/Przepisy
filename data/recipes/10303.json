  "ingredients": [
    "35 graham crackers",
    "1 cup packed brown sugar",
    "1 cup butter",
    "0.25 teaspoon cream of tartar",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (170 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place crackers to cover bottom of a 10x15-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, butter, and cream of tartar in a saucepan; heat to a boil. Add pecans; pour mixture over crackers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Cool in the pan about 3 minutes; remove from pan while still warm.",
      "section": null,
