  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray four 6x6-inch pieces of aluminum foil with cooking spray. Place salmon fillets on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle lemon juice over salmon fillets; sprinkle 1/2 teaspoon of dill weed over each one. Spread 1 tablespoon mustard onto each salmon fillet; top with dill pickle and onion. Wrap aluminum foil around salmon, sealing the edges. Place packets onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until fish flakes easily with a fork, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place packets in shallow bowls; open with heatproof gloves. Top with diced tomatoes and sport peppers; season with celery seed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
