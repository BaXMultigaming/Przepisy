  "ingredients": [
    "2 tablespoons olive oil",
    "2 large onions, cubed",
    "3 carrots, diced",
    "2 stalks celery, diced",
    "1 teaspoon minced garlic",
    "0.5 teaspoon paprika",
    "7 cups chicken stock",
    "3.5 cups crushed tomatoes",
    "1.5 cups lentils - soaked, rinsed and drained",
    "2 bay leaves",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.75 cup white wine",
    "0.5 cup grated Parmesan cheese",
    "1 sprig fresh parsley, chopped"
  ],
  "steps": [
    {
      "text": "Heat oil in a large stockpot. Sauté onions until they are glossy. Stir in carrots, celery, garlic, and paprika, and sauté for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chicken stock, tomatoes, lentils, bay leaves, salt, and pepper. Stir well, then add wine and bring the mixture to a boil. Slowly reduce the heat and cook for 1 hour on low to medium heat; or until lentils are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle soup with Parmesan and parsley before serving.",
      "section": null,
      "name": null,
