  "ingredients": [
    "1 (18.25 ounce) package white cake mix",
    "1 (3 ounce) package strawberry flavored Jell-O® mix",
    "1 cup mashed strawberries",
    "1 cup vegetable oil",
    "4 eggs",
    "0.5 cup sweetened condensed milk",
    "0.5 cup flaked coconut",
    "0.5 cup finely chopped walnuts",
    "4 cups confectioners' sugar",
    "0.5 cup margarine, melted",
    "0.25 cup mashed strawberries",
    "0.25 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease and flour a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together cake mix and gelatin mix. Make a well in the center and pour in 1 cup mashed strawberries, oil, eggs and sweetened condensed milk. Beat on low speed until blended. Scrape bowl, and beat 4 minutes on medium speed. Stir in 1/2 cup coconut and chopped nuts. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 to 45 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the frosting: In a large bowl, combine the confectioners' sugar, melted margarine, 1/4 cup mashed strawberries and 1/4 cup coconut. Beat until smooth and spread over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
