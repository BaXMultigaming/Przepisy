  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "0.5 cup butter",
    "1 (5 ounce) can evaporated milk",
    "1 (10 ounce) package frozen corn kernels",
    "1 (4 ounce) can diced green chiles"
  ],
  "steps": [
    {
