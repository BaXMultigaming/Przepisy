  "ingredients": [
    "0.66666668653488 cup cold heavy whipping cream",
    "1 1-cup canning jar with lid and ring"
  ],
  "steps": [
    {
      "text": "Pour cream into the jar and screw on the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LssDnWidl9ekRueUkYb5dZAGxP4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-234299-How-To-Make-Homemade-Butter-Step-01-986a909f8c224a5d888bc903d08b98c8.jpg"
      ],
      "image": "assets/images/234299/step_01.webp"
    },
    {
      "text": "Shake the jar until butter forms a soft lump, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fwamhxQrARoQrEIQcin-fy_15jg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-234299-How-To-Make-Homemade-Butter-Step-02-cf3ccc1f6f134bbbb7abbad4066566ba.jpg"
      ],
      "image": "assets/images/234299/step_02.webp"
    },
    {
      "text": "Continue to shake until buttermilk separates out of the lump and the jar contains a solid lump of butter and liquid buttermilk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-zv5wLeosIGgWMKDrfssSDSscGM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-234299-How-To-Make-Homemade-Butter-Step-03-1d381655071f4a74a7ee7668fb8420ee.jpg"
      ],
      "image": "assets/images/234299/step_03.webp"
    },
    {
      "text": "Pour the contents of the jar into a fine-mesh strainer and strain out the buttermilk, leaving the solid butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ljfm1I2je0u8sIBIeZouqC5g8hU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-234299-How-To-Make-Homemade-Butter-Step-05-9b674ca16ce04be991dc14d797aaac26.jpg"
      ],
      "image": "assets/images/234299/step_04.webp"
    },
    {
      "text": "Remove the lump of butter and wrap in plastic wrap. Refrigerate until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P6p-5Ycllr8AZ4ewlYLerWtX-OA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-234299-How-To-Make-Homemade-Butter-Step-06-87c1378ed9cb478e9786ec8916a1c6cb.jpg"
      ],
      "image": "assets/images/234299/step_05.webp"
    }
