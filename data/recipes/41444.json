  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 (2 pound) boneless pork roast",
    "salt and pepper to taste",
    "4 sweet potatoes, quartered",
    "1 onion, quartered",
    "6 cloves garlic",
    "1 (14.5 ounce) can chicken broth"
  ],
  "steps": [
    {
      "text": "Heat oil in a large, heavy skillet. Season meat with salt and pepper, and brown in oil.",
