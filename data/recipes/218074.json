  "ingredients": [
    "4 (8 ounce) pork chops",
    "1 lime, juiced",
    "4 cloves garlic, minced",
    "0.25 cup chopped fresh basil",
    "salt and black pepper to taste"
  ],
  "steps": [
    {
      "text": "Toss pork chops with lime juice in a bowl until evenly covered. Toss with garlic and basil. Season chops to taste with salt and pepper. Set aside to marinate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat, and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook pork chops on the preheated grill until no longer pink in the center, 5 to 10 minutes per side. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
