  "ingredients": [
    "0.25 cup extra-virgin olive oil",
    "2 tablespoons dry ranch dressing mix",
    "4 potatoes",
    "1 onion, coarsely chopped"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for low heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine olive oil and ranch dressing mix in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 potato onto a cutting board with a wooden spoon on each side. Make cuts across potato down to the spoons, about ¼-inch apart. Repeat with remaining potatoes. Place potatoes in a heat-proof dish; add onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon oil-ranch mixture evenly over potatoes and onion. Cover the dish tightly with aluminum foil; place on the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until potatoes are golden brown, about 30 minutes, flipping every 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
