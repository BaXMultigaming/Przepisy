  "ingredients": [
    "0.25 cup white sugar",
    "0.25 cup vegetable oil",
    "0.25 cup soy sauce",
    "2 green onions, chopped",
    "2 cloves garlic, minced",
    "1 pound round steak",
    "2 tablespoons sesame seeds"
  ],
  "steps": [
    {
      "text": "Mix together sugar, oil, soy sauce, green onions, and garlic in a large bowl; set marinade aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut steak into strips and add to marinade; stir to coat. Cover the bowl and place in the refrigerator, 30 minutes to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook steak with marinade in a wok or frying pan over medium-high heat, stirring occasionally, until browned, about 5 minutes. Add sesame seeds; cook for 2 more minutes.",
      "section": null,
      "name": null,
