  "ingredients": [
    "3 large egg whites",
    "1 large egg",
    "1 tablespoon grated Parmesan cheese",
    "1 tablespoon shredded reduced-fat Cheddar cheese",
    "0.25 teaspoon salt",
    "0.125 teaspoon red pepper flakes",
    "0.125 teaspoon garlic powder",
    "0.125 teaspoon ground nutmeg",
    "0.125 teaspoon ground black pepper",
    "0.5 teaspoon olive oil",
    "0.5 cup sliced fresh mushrooms",
    "0.25 cup diced green onions",
    "2 tablespoons finely chopped red bell pepper",
    "1 cup torn fresh spinach",
    "0.5 cup diced fresh tomato"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YBU_pF0IvoOlCQouEZVJ6cZ15L4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222618-spinach-mushroom-omelet-ddmfs-step1-3x4-9340-56134831aa41478892d8c5b3b915754f.jpg"
      ],
      "image": "assets/images/222618/step_01.webp"
    },
    {
      "text": "Whisk egg whites and egg together in a small bowl. Mix in Parmesan, Cheddar, salt, red pepper flakes, garlic powder, nutmeg, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k0x0xWIFAo3WXGGyCsvOcxOjMm4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222618-spinach-mushroom-omelet-ddmfs-step2-3x4-9349-f6611f6ea1f34b03a9d63ac5c3c42bef.jpg"
      ],
      "image": "assets/images/222618/step_02.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Sauté mushrooms, green onions, and bell pepper until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kEaPZiPvlJnEQwNhU5TcIlfieBc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222618-spinach-mushroom-omelet-ddmfs-step3-3x4-9344-5f82bd1019314cbdb0d76865f3f5b9a9.jpg"
      ],
      "image": "assets/images/222618/step_03.webp"
    },
    {
      "text": "Add spinach and cook until just wilted, 1 to 2 minutes. Stir in tomato, then pour in egg mixture. As egg mixture starts to set, lift the edges and let the uncooked portion flow underneath.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TOjcY2L8k2omyOEto70yp__Up78=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222618-spinach-mushroom-omelet-ddmfs-step5-3x4-9353-faddbbd2c7d34d28ac97986f6e002760.jpg"
      ],
      "image": "assets/images/222618/step_04.webp"
    },
    {
      "text": "Cook until egg mixture sets, 10 to 15 minutes. Cut into wedges and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/goyAMuOy90a-9lixOwnwxDA9We8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222618-spinach-mushroom-omelet-ddmfs-step6-3x4-9357-597a85b813084ccd87fd07b4eee381d8.jpg"
      ],
