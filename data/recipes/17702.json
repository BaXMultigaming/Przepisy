  "ingredients": [
    "12 ounces dry fettuccine pasta",
    "2 red bell peppers, julienned",
    "3 cloves garlic, minced",
    "0.75 teaspoon cayenne pepper",
    "1 cup reduced fat sour cream",
    "0.75 cup chicken broth",
    "0.75 cup grated Parmesan cheese",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, spray cooking oil in a large skillet and sauté red bell peppers, garlic, and cayenne pepper over medium heat for 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in sour cream and broth; simmer uncovered for 5 minutes. Remove from heat and stir in cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss hot pasta with sauce and season with salt and pepper to taste; serve.",
      "section": null,
      "name": null,
      "url": null,
