  "ingredients": [
    "8 ounces cream cheese, softened",
    "1 cup finely shredded Cheddar cheese",
    "1.5 tablespoons taco seasoning mix",
    "12 medium jalapeno peppers, halved lengthwise and seeded",
    "2 tablespoons fine bread crumbs, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with foil or parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend cream cheese, Cheddar cheese, and seasoning mix together in a bowl. Spread mixture into jalapeño halves and arrange onto the prepared baking sheet. Sprinkle bread crumbs over cheese filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until peppers are just tender, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
