  "steps": [
    {
      "text": "Preheat oven to 375 degrees F. Butter an 8-inch square pan or 9-inch pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In prepared baking dish, toss together cranberries, 1/3 cup Sugar In The Raw, 2 tablespoons Stevia In The Raw®, cornstarch, and zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine flour, oats, 2 tablespoons Sugar In The Raw® 2 tablespoons Stevia In The Raw, salt, and nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add butter and use your fingers to work it into flour until mixture is crumbly. Stir in pecans. Sprinkle crumble mixture over cranberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until fruit is bubbling and crumble is browned, 45 to 50 minutes.",
