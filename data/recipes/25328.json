  "ingredients": [
    "1 cup Basmati rice",
    "3.6670000553131 cups water, divided",
    "2 tablespoons soy margarine",
    "2 tablespoons nutritional yeast",
    "0.5 teaspoon garlic powder",
    "1.5 teaspoons dried basil",
    "salt to taste"
