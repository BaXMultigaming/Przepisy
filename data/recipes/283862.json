  "ingredients": [
    "0.25 cup olive oil",
    "1 (1 ounce) package dry onion soup mix (such as Lipton®)",
    "6 medium red potatoes, quartered",
    "0.5 pound fresh green beans, trimmed",
    "2 portobello mushroom caps, chopped",
    "0.5 cup matchstick carrots",
    "1 tablespoon olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease a shallow baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ¼ cup olive oil and soup mix in a large resealable plastic bag. Add potatoes; toss until well coated. Transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven, uncovered, for 30 minutes. Stir in green beans and portobello mushrooms. Sprinkle in carrots; drizzle with 1 tablespoon olive oil. Roast until potatoes and green beans are tender, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
