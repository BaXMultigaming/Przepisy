  "ingredients": [
    "3 delicata squash, halved lengthwise and seeded",
    "1 onion, chopped",
    "3 cups vegetable broth",
    "1.5 cups heavy whipping cream",
    "2 tablespoons butter",
    "salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Place the squash, cut sides down, in a baking dish. Add 1/8 inch water in baking dish, cover with foil and bake 35-40 minutes or until tender. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan, melt butter. Add onion and cook over low heat, stirring occasionally until onion is softened but not brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrape the squash out of the flesh and add to onions. Add the stock and heavy cream. Cook over moderate heat, stirring occasionally, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree the soup in a blender or food processor. Season with salt and pepper to taste and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
