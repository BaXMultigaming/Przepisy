  "ingredients": [
    "1 pound ground beef",
    "1 small onion, minced",
    "1 teaspoon minced garlic",
    "1 (28 ounce) can crushed tomatoes",
    "0.5 (6 ounce) can tomato paste",
    "1 envelope onion soup mix",
    "2 beef bouillon cubes",
    "1 bay leaf",
    "2 quarts water",
    "1 (16 ounce) package frozen mixed vegetables",
    "0.66666668653488 cup orzo pasta",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Cook and stir ground beef in a large pot over medium heat until crumbly and browned, 7 to 10 minutes; drain as much fat from pot as possible. Add onion and garlic to the pot; cook and stir until onion is softened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in crushed tomatoes, tomato paste, onion soup mix, bouillon cubes, and bay leaf until well combined; stir in water and mixed vegetables. Increase heat to medium-high; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in orzo pasta; cook until pasta is tender yet firm to the bite, about 10 minutes. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
