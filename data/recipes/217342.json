  "ingredients": [
    "1 large egg",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon ground paprika",
    "1 pinch cayenne pepper",
    "1 pinch salt",
    "1 cup ground pecan meal",
    "4 (4 ounce) fillets walleye",
    "1 tablespoon butter",
    "1 tablespoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Beat egg, garlic powder, onion powder, paprika, cayenne pepper, and salt in a bowl until evenly mixed. Spread pecan meal into a shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip walleye fillets into egg mixture, then press into pecan meal to evenly coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter and vegetable oil in a large skillet over medium-high heat. Place walleye fillets into the hot skillet. Cook until golden brown on both sides and the fish flakes easily with a fork, 3 to 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
