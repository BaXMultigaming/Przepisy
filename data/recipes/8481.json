  "ingredients": [
    "2 cups raisins",
    "4 cups water",
    "1 cup butter",
    "1.5 cups white sugar",
    "0.5 cup packed brown sugar",
    "3.25 cups all-purpose flour",
    "2 teaspoons salt",
    "2 teaspoons ground cinnamon",
    "2 teaspoons baking soda",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan, combine raisins and water. Bring to a boil and let boil for 10 minutes. Remove from heat and add butter, sugar and brown sugar. Stir to mix and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix the flour, salt, cinnamon and baking soda. Add the raisin mixture and the nuts. Stir together until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into a 9x13 inch pan. Bake at 350 degrees F (175 degrees C) for 35 to 45 minutes, or until a toothpick inserted into the cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
