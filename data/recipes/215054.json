  "steps": [
    {
      "text": "Heat sugar and water together in a small saucepan over medium-low heat; cook and stir until sugar dissolved. Set simple syrup aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée blackberries in a blender or food processor; strain through a fine-mesh strainer to remove any seeds or pulp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk strained blackberry juice, cooled simple syrup, and red wine together in a large bowl until well combined; chill in the refrigerator until cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer's directions. Transfer to an airtight container and store in the freezer.",
