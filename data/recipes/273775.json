  "ingredients": [
    "0.5 pound ground beef",
    "0.5 (28 ounce) jar spaghetti sauce",
    "1 (14.5 ounce) can diced tomatoes",
    "0.5 onion, chopped",
    "1 clove garlic, minced",
    "2 teaspoons dried basil",
    "2 teaspoons dried oregano",
    "1 teaspoon salt",
    "1 teaspoon black pepper",
    "2 cups dried mafalda noodles",
    "1 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Add spaghetti sauce, tomatoes, onion, garlic, basil, oregano, salt, and pepper. Cook over low heat until sauce is hot, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, fill a large pot with lightly salted water and bring to a rolling boil. Cook mafalda noodles at a boil until tender yet firm to the bite, about 8 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cooked and drained noodles to the sauce and stir until completely coated. Sprinkle mozzarella cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place skillet under the hot broiler and cook until cheese is golden and bubbly, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
