  "ingredients": [
    "3 cups cubed (1-inch) seedless watermelon",
    "1 cup fresh blueberries",
    "1 large white peach, pitted and cut into small cubes",
    "1 large nectarine, pitted and cut into small cubes",
    "1 black plum, pitted and cut into small cubes",
    "0.5 cup seedless red grapes, halved",
    "0.5 cup shredded coconut",
    "1 teaspoon ground cinnamon",
    "0.5 cup nondairy whipped topping"
  ],
  "steps": [
    {
      "text": "Gently fold watermelon, blueberries, peach, nectarine, plum, and grapes together in a large bowl. Sprinkle coconut and cinnamon over fruit; fold together.",
