  "total_time": "PT185M",
  "yield": [
    "20",
    "2 1-pound loaves"
  ],
  "categories": [
    "Snack"
  ],
  "cuisines": [
    "Italian"
  ],
  "regions": [
    "Italian"
  ],
  "breadcrumbs": [],
