    "publisher-tested"
  ],
  "ingredients": [
    "1.3329999446869 cups warm water (110 degrees F/45 degrees C)",
    "1.5 teaspoons olive oil",
    "4 cups unbleached all-purpose flour",
    "1 tablespoon light brown sugar",
    "1.5 teaspoons salt",
    "1 (.25 ounce) package active dry yeast",
    "2 tablespoons cornmeal",
    "1 large egg",
    "1 tablespoon water"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/duyO542JsYb_Rt7fM1k4m1yIZrA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_22823_ItalianBreadUsingaBreadMachine_ddmfs_step1_3x4_5503-01832bfaf76a4b15a4c49e76e0cf424e.jpg"
      ],
      "image": "assets/images/22823/step_01.webp"
    },
    {
      "text": "Place 1 1/3 cups warm water, olive oil, flour, brown sugar, salt, and yeast into a bread machine in the order listed, or follow the order recommended by your manufacturer if different. Run the Dough cycle, about 90 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jioXeB-Cbcm4_Yv8U3gm5arh9KQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_22823_ItalianBreadUsingaBreadMachine_ddmfs_step2_3x4_5506-0a2faf7d31364871abb89ae589e54a61.jpg"
      ],
      "image": "assets/images/22823/step_02.webp"
    },
    {
      "text": "Sprinkle cornmeal onto a cutting board. Punch down dough, turn out onto a lightly floured surface, and form into two loaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m-oF61ZeUbpXKRzQ5AfpJdP1ZmA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_22823_ItalianBreadUsingaBreadMachine_ddmfs_step4_3x4_5655-0f80256b0cf246648ad6db94dab6e2cc.jpg"
      ],
      "image": "assets/images/22823/step_03.webp"
    },
    {
      "text": "Place loaves, seam-side down, onto the cutting board; cover with a damp cloth and let rise until doubled in volume, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZWTtYHpfBE4SmQWiLxGx9546MGg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_22823_ItalianBreadUsingaBreadMachine_ddmfs_step6_3x4_5659-821d2b78d0f94fe99db5ad6fad9ed8fc.jpg"
      ],
      "image": "assets/images/22823/step_04.webp"
    },
    {
      "text": "Meanwhile, preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg and 1 tablespoon water together in a small bowl; brush over risen loaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WJTO5N2nuBeCUWV6GedOiio4_u8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_22823_ItalianBreadUsingaBreadMachine_ddmfs_step8_3x4_5664-c7358431700c4435b618344cfca61478.jpg"
      ],
      "image": "assets/images/22823/step_06.webp"
    },
    {
      "text": "Use a sharp knife to quickly cut one long slash down the center of each loaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_agw4_elLiz3kRL4S5HyOG_VVa0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_22823_ItalianBreadUsingaBreadMachine_ddmfs_step9_3x4_5665-be100869562c433fb1cb5b970b51bc13.jpg"
      ],
      "image": "assets/images/22823/step_07.webp"
    },
    {
      "text": "Gently shake the cutting board to make sure the loaves are not sticking; use a spatula or pastry knife to loosen them if necessary. Slide loaves onto a baking sheet with a quick but careful motion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_RxlPT4mCK0dG9qn63-vqKqabUA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_22823_ItalianBreadUsingaBreadMachine_ddmfs_step11_3x4_5669-a4e3aa5ac2594d87bfb7cb1ba2922ee8.jpg"
      ],
      "image": "assets/images/22823/step_08.webp"
    },
    {
      "text": "Bake in the preheated oven until loaves are golden brown and sound hollow when tapped on the bottom, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BBlyrAmwFmOpgIokbwIVhhOtIyw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_22823_ItalianBreadUsingaBreadMachine_ddmfs_step12_3x4_5671-707ebfd7acc14c5b8093151a64d860fa.jpg"
      ],
      "image": "assets/images/22823/step_09.webp"
    }
  ],
