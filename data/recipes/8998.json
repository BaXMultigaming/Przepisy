  "ingredients": [
    "1 (2 to 3 pound) whole chicken, cut into pieces",
    "0.5 cup honey, warmed slightly",
    "0.5 cup prepared mustard",
    "0.5 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "In a small bowl, combine the warm honey, mustard, and nutmeg and mix until well blended. Smear onto the chicken pieces, coating well. Refrigerate and let sit for 1/2 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes, or until done and chicken juices run clear. You can also grill or broil for 30 minutes, turning chicken pieces after 15 minutes of cooking.",
      "section": null,
      "name": null,
      "url": null,
