  "ingredients": [
    "1 very ripe banana, mashed",
    "0.75 cup peach yogurt",
    "0.5 cup brown sugar",
    "0.5 cup steel cut oats",
    "0.25 cup butter, melted",
    "0.25 cup maple syrup",
    "1 egg, beaten",
    "0.75 cup whole wheat flour",
    "1 cup all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup chopped ripe peach",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine banana, yogurt, ½ cup brown sugar, oats, ¼ cup butter, maple syrup, and egg in a large bowl; set aside until oats soften, 10 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ¾ cup whole wheat flour, all-purpose flour, baking powder, 2 teaspoons cinnamon, baking soda, and salt in a medium bowl; stir into banana mixture along with peaches until just combined. Pour mixture into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pecans, remaining ½ cup whole wheat flour, remaining ¼ cup brown sugar, remaining ¼ cup melted butter, and 1 pinch cinnamon in a bowl; spread over cake batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 40 to 50 minutes. Cool in the pan for 10 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
