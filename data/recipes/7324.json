  "ingredients": [
    "1.5 cups egg whites",
    "1 teaspoon cream of tartar",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "1.25 cups cake flour",
    "1.75 cups white sugar",
    "0.25 teaspoon salt"
  ],
  "steps": [
