  "ingredients": [
    "1 (12 ounce) bottle barbeque sauce",
    "1 (12 ounce) package vegetarian burger crumbles",
    "1 green bell pepper, chopped",
    "0.33333334326744 cup minced onion",
    "1 clove garlic, minced",
    "0.5 cup soft bread crumbs",
    "3 tablespoons Parmesan cheese",
    "1 egg, beaten",
    "0.25 teaspoon dried thyme",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon parsley flakes",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 of the BBQ sauce, vegetarian burger crumbles, green bell pepper, onion, garlic, bread crumbs, Parmesan cheese, and beaten egg in a large bowl. Season with thyme, basil, parsley, salt, and pepper. Transfer mixture into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Pour remaining BBQ sauce over the loaf, and continue baking until loaf is set, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
