  "ingredients": [
    "8 pig feet, split",
    "1 onion, chopped",
    "2 celery ribs, chopped",
    "0.75 cup white vinegar",
    "2 tablespoons red pepper flakes",
    "2 tablespoons seasoned salt",
    "1 tablespoon chopped garlic",
    "1 teaspoon ground black pepper",
    "2 bay leaves"
  ],
  "steps": [
    {
      "text": "Thoroughly wash pig's feet in cold water and place into a large pot or Dutch oven. Add onion, celery, vinegar, red pepper flakes, seasoned salt, garlic, black pepper, and bay leaves, then pour in water to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring to a boil, then reduce the heat to low and braise until pork is tender and falling off the bones, about 2 hours.",
      "section": null,
