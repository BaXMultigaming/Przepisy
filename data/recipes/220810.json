  "ingredients": [
    "4 large portobello mushroom caps, stems and gills removed",
    "1 tablespoon reduced-fat Italian salad dressing",
    "1 egg",
    "1 clove garlic, minced",
    "salt and ground black pepper to taste",
    "1 (10 ounce) bag fresh spinach, chopped",
    "0.25 cup chopped pepperoni",
    "0.25 cup grated Parmesan cheese",
    "0.25 cup shredded mozzarella cheese, divided",
    "0.25 cup seasoned bread crumbs, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush both sides of portobello mushrooms with Italian dressing. Arrange mushroom on a baking sheet, gill-sides up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
