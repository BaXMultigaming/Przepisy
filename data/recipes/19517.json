  "ingredients": [
    "0.5 cup butter, melted",
    "2 tablespoons lemon juice",
    "0.5 teaspoon dried parsley",
    "0.25 teaspoon garlic salt",
    "0.25 teaspoon ground white pepper",
    "0.25 teaspoon paprika, divided",
    "2 pounds grouper fillets",
    "2 tablespoons mayonnaise"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a broiler pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine melted butter and lemon juice in a small bowl. Brush 2 tablespoons butter mixture onto the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together parsley, garlic salt, white pepper, and 1/8 teaspoon paprika in a small bowl. Sprinkle spice mixture on both sides of fillets and lay them on the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, about 10 minutes. Brush fillets with remaining lemon butter and spread with mayonnaise. Sprinkle with remaining 1/8 teaspoon paprika before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
