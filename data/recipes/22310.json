  "ingredients": [
    "1 (18.25 ounce) package lemon cake mix",
    "1 (3 ounce) package lemon flavored Jell-O® mix",
    "1 cup boiling water",
    "1 (8 ounce) container frozen whipped topping, thawed",
    "1 (3 ounce) package instant lemon pudding mix",
    "1 teaspoon vanilla extract",
