  "ingredients": [
    "0.5 cup unsalted butter",
    "1.5 cups chopped fresh mushrooms",
    "3 stalks celery with leaves, diced",
    "1 medium onion, chopped",
    "5 cloves garlic, pressed",
    "1 teaspoon salt",
    "1 teaspoon dried sage",
    "0.5 teaspoon ground thyme",
    "0.5 teaspoon dried marjoram",
    "0.5 teaspoon ground black pepper",
    "3 cups boiling water",
    "1 cup dry white wine",
    "1 (16 ounce) loaf French bread, cubed",
    "6 slices whole wheat bread, cubed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over medium-high heat. Add mushrooms, celery, onion, garlic, salt, sage, thyme, marjoram, and black pepper. Saute for 4 to 5 minutes. Stir in boiling water and wine and turn off heat. Pour in French and whole wheat bread cubes and toss well to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into a 9x13x2-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until cooked through, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
