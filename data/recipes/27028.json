  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "2 eggs",
    "1.5 teaspoons vanilla extract",
    "1.75 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 cup milk",
    "0.25 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9-inch round pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and butter together in a mixing bowl with an electric mixer until light and fluffy. Beat in eggs, one at a time, mixing until fully incorporated after each addition. Stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, and salt in a mixing bowl. Stir dry ingredients into wet ingredients alternately with milk, adding 1 to 2 tablespoons more milk if batter is too stiff. Spread batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 35 minutes. Cool in the pan on a wire rack for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn cake out onto a serving plate and cool to room temperature, 20 to 30 minutes. Dust with confectioners' sugar right before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
