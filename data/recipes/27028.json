  "title": "Irish Tea Cake",
  "description": "This simple Irish tea cake is buttery and moist. Serve as-is, top with berries, or dust with powdered sugar and enjoy alongside a cup of Irish tea.",
  "authors": [
    "Cindy"
  ],
  "date_published": "2020-06-18T23:07:03-04:00",
