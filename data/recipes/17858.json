  "ingredients": [
    "5 potatoes",
    "4 ounces American cheese, sliced into strips",
    "1 tablespoon butter",
    "0.75 cup sour cream"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake potatoes for 1 hour or until soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a microwave safe bowl, combine the cheese and butter. Cook in microwave for 1 1/2 minutes or until melted. Add sour cream and mix together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut potatoes in half, scoop out insides while being careful not to tear the skins. Add to cheese mixture and mix together until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stuff potato mixture back into potato shells and bake at 350 degrees F (175 degrees C) for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
