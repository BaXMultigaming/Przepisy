  "ingredients": [
    "2 pounds Brussels sprouts, trimmed",
    "3 tablespoons olive oil",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "3 tablespoons pure maple syrup",
    "5 slices bacon, crisp-cooked and crumbled"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange Brussels sprouts in a single layer on a foil-lined 10x15-inch baking pan. Drizzle with oil; toss to coat. Sprinkle with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 10 minutes. Drizzle with maple syrup; toss to coat. Roast until tender and beginning to brown, 10 to 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss Brussels sprouts mixture with bacon in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
