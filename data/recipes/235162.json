  "ingredients": [
    "3 (12 fluid ounce) bottles hard apple cider",
    "0.75 cup brown sugar, divided",
    "1 (2 pound) pork tenderloin",
    "0.5 cup butter",
    "1 large onion, cut into strips",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon onion powder",
    "salt and ground black pepper to taste",
    "2 large Granny Smith apples - peeled, cored, and sliced",
    "6 hard rolls, split"
  ],
  "steps": [
    {
      "text": "Combine hard apple cider and 1/4 cup brown sugar in a slow cooker; mix until dissolved. Add pork tenderloin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 6 hours until very tender. Shred pork with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "About 20 minutes before pork is finished, melt butter in a large skillet over medium-low heat. Cook and stir onion in butter until well browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1/2 cup brown sugar, cinnamon, and onion powder in a small bowl; season with salt and pepper. Stir apples and brown sugar mixture into onion in the skillet. Cover and cook until apples are tender and sauce has thickened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon shredded pork and apple-onion sauce over rolls to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
