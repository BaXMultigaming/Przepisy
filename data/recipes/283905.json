  "ingredients": [
    "2 medium English cucumbers, peeled and thinly sliced",
    "1 teaspoon salt",
    "1 medium red onion, thinly sliced",
    "1 cup distilled white vinegar",
    "0.5 cup water",
    "0.5 cup white sugar",
    "2 tablespoons minced fresh dill"
  ],
  "steps": [
    {
      "text": "Combine sliced cucumbers and salt in a large bowl and let sweat for 1 hour. Drain liquid and toss cucumbers with onion slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white vinegar and water in a saucepan over medium-low heat. Stir in sugar until dissolved and simmer until liquid turns clear, 3 to 5 minutes. Pour dressing over cucumbers and onions and stir in dill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
