  "ingredients": [
    "0.5 cup unsalted butter, softened",
    "0.25 cup white sugar",
    "0.5 cup rye flour",
    "1 cup all-purpose flour",
    "0.125 teaspoon baking powder",
    "0.25 teaspoon salt",
    "3 tablespoons water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together butter and sugar until light and fluffy. Stir in rye flour, all-purpose flour, baking powder and salt. Mix well and add enough water to moisten dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out onto floured board. The thinner the dough, the crispier the cookies will be. Cut into 2 1/2-inch rounds using cutter or floured glass. Cut a small hole off center in each cookie using a thimble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on ungreased cookie sheets until slightly browned, 10 to 15 minutes. Cool on a wire rack. Hang on a Christmas tree with ribbon or yarn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
