  "ingredients": [
    "1 (.25 ounce) package active dry yeast",
    "4 tablespoons white sugar",
    "0.5 cup canned sweet potato puree",
    "0.5 cup warm water (110 degrees F/45 degrees C)",
    "3 tablespoons margarine, softened",
    "1 teaspoon salt",
    "2 eggs",
    "3.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Dissolve yeast, warm water, and 1 tablespoon sugar in a mixing bowl. Let stand 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add remaining sugar, sweet potato, butter or margarine, salt, and slightly beaten eggs. Stir to mix well. Stir in 3 cups of flour. Turn out on a lightly floured surface. Knead 2 to 3 minutes, adding just enough of remaining flour to prevent sticking. Do not knead too heavily; when smooth, shape into a ball. Place in an oiled bowl, and turn to coat the surface. Cover, and let raise about 1 hour or longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Punch down, and allow dough to rest for 2 minutes. Divide into 16 to 20 balls, and place on a greased cookie sheet or in a 9x13 inch pan. Allow to rise until doubled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 12 to 20 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
