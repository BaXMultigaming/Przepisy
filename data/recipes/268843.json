    "publisher-tested"
  ],
  "ingredients": [
    "cooking spray",
    "1 pound baby Yukon Gold potatoes, quartered",
    "4 ears corn, husked",
    "4 tablespoons olive oil, divided",
    "3 tablespoons Creole seasoning",
    "1 lemon, juiced",
    "1 tablespoon minced garlic",
    "2 teaspoons Italian seasoning",
    "1 teaspoon paprika, divided",
    "0.5 teaspoon red pepper flakes",
    "1 pinch salt and ground black pepper",
    "1 red bell pepper, cut into 2-inch pieces",
    "1 yellow bell pepper, cut into 2-inch pieces",
    "1 orange bell pepper, cut into 2-inch pieces",
    "1.5 cups cherry tomatoes, halved",
    "1 onion, cut into 2-inch pieces",
    "4 andouille sausages, sliced",
    "1 lemon, cut into wedges",
    "1 pound uncooked medium shrimp, peeled and deveined",
    "0.5 teaspoon Creole seasoning",
    "2 tablespoons chopped fresh parsley, or to taste",
    "finely chopped green onion, or to taste"
  ],
  "steps": [
    {
      "text": "Gather ingredients. Preheat the oven to 425 degrees F (220 degrees C). Spray a large sheet pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t6wEdgBdD7W2BiRmL7gAe_keuOA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268843-SheetPanShrimpandSausageBake-ddmfs-Step1-3x4-7051-fe2e499c2a69486682d3ab8c29c4b9db.jpg"
      ],
      "image": "assets/images/268843/step_01.webp"
    },
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qHscpXGkUN2QCJxF0FWBYPQ09Lk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268843-SheetPanShrimpandSausageBake-ddmfs-Step2-3x4-7052-b52cc1c39b714348b4c34c5db8f47ba2.jpg"
      ],
      "image": "assets/images/268843/step_02.webp"
    },
    {
      "text": "Add corn and boil for an additional 5 minutes. Drain. Cut corn into thirds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d3X8eWeMZjyzIOoLt3RTZo_oh3E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268843-SheetPanShrimpandSausageBake-ddmfs-Step2-3x4-7056-42402868a87f4aec9cf61cd2453d9b4a.jpg"
      ],
      "image": "assets/images/268843/step_03.webp"
    },
    {
      "text": "Meanwhile, whisk 3 tablespoons olive oil, 3 tablespoons Creole seasoning, lemon juice, garlic, Italian seasoning, 1/2 teaspoon paprika, red pepper flakes, salt, and ground black pepper together in a small bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Am8_aerWMIG1ShxFF_tWmC7VwWQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268843-SheetPanShrimpandSausageBake-ddmfs-Step3-3x4-7057-55fd3c85f5c14bb3bd1d8b75e4103226.jpg"
      ],
      "image": "assets/images/268843/step_04.webp"
    },
    {
      "text": "Combine boiled potatoes and corn, all the bell peppers, cherry tomatoes, onion, and sausage slices in a large bowl. Add seasoning mixture and mix evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tnZD4SPjrr1CZ85KUjkAUcw-b6M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268843-SheetPanShrimpandSausageBake-ddmfs-Step4-3x4-7064-f03d62406b7d43cebe02e2d1739c8301.jpg"
      ],
      "image": "assets/images/268843/step_05.webp"
    },
    {
      "text": "Spread potato mixture onto a sheet pan in a single layer. Place lemon wedges evenly on all sides of the sheet pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-t3uR6L32M3d74O6l9Q9HZtqIUk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268843-SheetPanShrimpandSausageBake-ddmfs-Step5-3x4-7068-62386640156a4ea6ad28b8316ddf4f7c.jpg"
      ],
      "image": "assets/images/268843/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven for 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine shrimp, remaining 1 tablespoon olive oil, remaining 1/2 teaspoon paprika, and remaining 1/2 teaspoon Creole seasoning in a bowl. Marinate for a few minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5rQzOfgrQFpS3kDrqA0m7BySXKY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268843-SheetPanShrimpandSausageBake-ddmfs-Step6-3x4-7070-402f043dc39742009d6e5d572f6f99d5.jpg"
      ],
      "image": "assets/images/268843/step_08.webp"
    },
    {
      "text": "Add shrimp to the sheet pan with the potato mixture after 8 minutes of baking and mix to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0x-C_o7hg_BSQaw-rggq3qpNjw8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268843-SheetPanShrimpandSausageBake-ddmfs-Step6-3x4-7072-95c526e799df4e0b90536e9e36dbd7cf.jpg"
      ],
      "image": "assets/images/268843/step_09.webp"
    },
    {
      "text": "Return sheet pan to the oven and bake until shrimp are opaque and reach 145 degrees F (63 degrees C), 6 to 8 minutes. Remove lemon wedges. Garnish with parsley and green onion before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LlwMsZ5wEwvRQFluDHcHm7enFXw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268843-SheetPanShrimpandSausageBake-ddmfs-Step7-3x4-7077-a365f477b18648728f5c7e1ebd4b5182.jpg"
      ],
      "image": "assets/images/268843/step_10.webp"
    }
  ],
