  "title": "Sheet Pan Shrimp and Sausage Bake",
  "description": "This easy shrimp and sausage bake combines andouille, potatoes, corn, and colorful vegetables with bold Creole seasoning, all finished together on a sheet pan.",
  "authors": [
    "ashley"
  ],
  "date_published": "2018-11-03T02:45:35-04:00",
