  "ingredients": [
    "0.5 (8 ounce) package spaghetti",
    "1 tablespoon unsalted butter",
    "4 ounces portobello mushrooms, quartered",
    "1 tablespoon white miso paste",
    "0.25 cup freshly grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a large skillet over medium heat. Add mushrooms but do not crowd the skillet. Brown mushrooms in butter, about 7 minutes. Add miso paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully ladle out 1/2 cup pasta water from the boiling pot. Pour 1/4 cup pasta water to the pan with the mushrooms, stirring until incorporated. Add Parmesan cheese and whisk until cheese has melted. Add remaining 1/4 cup pasta water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain cooked pasta and add to the skillet. Toss to combine and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
