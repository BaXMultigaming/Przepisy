  "ingredients": [
    "4 (6.5 ounce) packages dry corn bread mix",
    "6 cups dry bread crumbs",
    "1 pound sausage",
    "0.5 cup margarine",
    "2 cups chopped onion",
    "4 cloves garlic",
    "0.33333334326744 cup chopped green bell pepper",
    "3 cups chopped celery",
    "0.66666668653488 cup chopped fresh parsley",
    "2 tablespoons poultry seasoning",
    "1 teaspoon dried sage",
    "1 teaspoon salt",
    "8 cups chicken broth",
    "2 eggs, beaten"
  ],
  "steps": [
    {
      "text": "Prepare the cornbread according to package instructions. Once cornbread is cooled, crumble it into a large bowl. Stir in the bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large pot, saute sausage in margarine with the onion, garlic, green bell pepper and celery until tender. Stir parsley, poultry seasoning, sage and salt into the mixture. Pour broth, eggs and cornbread/breadcrumbs into the mixture; mix until the ingredients stick together easily. Transfer to a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake covered in a preheated 350 degrees F (175 degrees C) oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
