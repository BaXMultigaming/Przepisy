  "ingredients": [
    "2 cups unsweetened shredded coconut",
    "1 cup almond flour",
    "0.33333334326744 cup maple syrup",
    "3.5 tablespoons melted coconut oil",
    "0.5 teaspoon vanilla extract",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together coconut, almond flour, maple syrup, coconut oil, vanilla extract, and salt in a bowl until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop cookie dough in tablespoon-sized mounds onto the prepared baking sheets. Cover and refrigerate or freeze until use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "If baking cookies, preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cookies to 2 ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned, 5 to 10 minutes.",
      "section": null,
