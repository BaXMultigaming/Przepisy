  "ingredients": [
    "2 cups white sugar",
    "1 cup butter",
    "5 eggs",
    "2 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 cup milk",
    "3.5 ounces flaked coconut",
    "1 teaspoon coconut extract",
    "1 cup white sugar",
    "0.25 cup water",
    "1 teaspoon coconut extract",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 10 inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together 2 cups sugar and the butter. Fold in the eggs one at a time, fully incorporating each one before adding another.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In separate bowl, mix the flour, baking powder, milk, flaked coconut, and 1 teaspoon coconut extract. Beat into the creamed mixture. Pour the batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 1 hour in the preheated oven, or until a knife inserted in the center comes out clean. Cool on a wire rack for just a few minutes, then place on cake platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the glaze, mix together in a small saucepan 1 cup sugar, water, 1 teaspoon coconut extract, and walnuts. Boil for 1 minute, and pour over still warm cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
