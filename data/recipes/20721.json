  "ingredients": [
    "6 cloves garlic, crushed",
    "2 teaspoons dried tarragon",
    "0.5 teaspoon salt",
    "1 tablespoon freshly ground black pepper",
    "0.5 cup olive oil",
    "4 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, whisk together garlic, dried tarragon, salt, ground black pepper and olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place each chicken breast half on a piece of foil large enough to cover the chicken. Brush chicken with the garlic mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Tightly seal chicken in the foil. Cook on the prepared grill approximately 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from grill. Discard foil and juices. Place unwrapped chicken on the grill. Brushing frequently with remaining garlic mixture and turning often, continue cooking 5 to 10 minutes per side, or to desired doneness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
