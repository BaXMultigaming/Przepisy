  "ingredients": [
    "1 large pasteurized egg, at room temperature",
    "0.25 cup coconut oil, melted",
    "0.25 cup extra-virgin olive oil",
    "1 clove black garlic",
    "2 teaspoons lemon juice",
    "1 teaspoon white vinegar",
    "0.25 teaspoon Dijon mustard",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Place egg, coconut oil, olive oil, garlic, lemon juice, vinegar, mustard, and salt into a wide mouth jar. Using an immersion blender, blend until ingredients begin to emulsify, 30 to 45 seconds.",
