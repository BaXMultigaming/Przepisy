  "ingredients": [
    "0.25 cup ghee",
    "0.75 cup chopped yellow onion",
    "2 pounds crookneck squash, halved or quartered lengthwise, sliced into 1/4-inch slices",
    "salt and ground black pepper to taste",
    "1 teaspoon minced fresh parsley"
  ],
  "steps": [
    {
      "text": "Melt ghee in a large nonstick skillet over medium heat. Add onion and cook, stirring occasionally, until soft and fragrant, about 2 minutes. Add squash, season with salt and pepper, and cook, stirring frequently, for 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Adjust seasoning with salt and pepper and serve warm, garnished with fresh parsley.",
