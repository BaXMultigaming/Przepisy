  "ingredients": [
    "2 skinless, boneless chicken breast halves",
    "0.25 cup Dijon mustard",
    "0.25 cup minced onion",
    "3 tablespoons lemon juice",
    "2 tablespoons maple syrup",
    "1 tablespoon olive oil",
    "2 teaspoons teriyaki sauce",
    "2 teaspoons soy sauce",
    "4 cloves garlic, minced",
    "1 teaspoon dried rosemary"
  ],
  "steps": [
    {
      "text": "Place chicken breasts in a slow cooker. Mix Dijon mustard, onion, lemon juice, maple syrup, olive oil, teriyaki sauce, soy sauce, garlic, and rosemary together in a bowl. Pour into the slow cooker. Ensure sauce covers the chicken.",
      "section": null,
      "name": null,
      "url": null,
