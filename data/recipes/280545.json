  "ingredients": [
    "2 (15 ounce) cans black beans, rinsed and drained",
    "2 (10 ounce) packages frozen corn, thawed",
    "1 green bell pepper, diced",
    "1 red bell pepper, diced",
    "0.5 cup finely chopped red onion",
    "0.5 cup chopped fresh cilantro",
    "0.5 jalapeno pepper, finely chopped",
    "2 cloves garlic, minced",
    "0.5 cup mayonnaise",
    "0.25 cup sour cream",
    "2 tablespoons red wine vinegar",
    "2 tablespoons ground cumin, or to taste",
    "1 lime, juiced",
    "1 tablespoon chili powder",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon salt, or to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine black beans, corn, bell peppers, red onion, cilantro, jalapeño, and garlic in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, sour cream, vinegar, cumin, lime juice, chili powder, cayenne pepper, and salt together in a small bowl; season with black pepper. Pour dressing over corn mixture; toss to coat.",
