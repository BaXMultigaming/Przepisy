  "steps": [
    {
      "text": "Fill a large pot with enough water to cover all eggs; bring to a boil. Use a slotted spoon to lower eggs gently into boiling water. Return to a gentle boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook for 13 to 15 minutes, depending on how firm you want the yolks. Remove the pot from heat and drain water, keeping eggs in the pot. Fill the pot quickly with cold water to cool eggs. Add ice to speed the process.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When eggs are cool enough to handle, remove each one and gently crack the shell on all sides without removing any shell. Return eggs to cold water and let stand for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel and remove egg shells to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
