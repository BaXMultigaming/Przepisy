  "ingredients": [
    "2 tablespoons all-purpose flour",
    "2 tablespoons coconut flour",
    "1 tablespoon cocoa powder",
    "0.25 teaspoon baking powder",
    "3.5 tablespoons almond milk, divided",
    "0.5 teaspoon vanilla extract",
    "3 tablespoons chocolate-hazelnut spread (such as Nutella®)"
  ],
  "steps": [
    {
      "text": "Stir all-purpose flour, coconut flour, cocoa powder and baking powder together in a small bowl; add 3 tablespoons almond milk, vanilla extract, Nutella and 1/2 tablespoon milk, respectively, stirring between each addition until you finally have a smooth batter. Transfer batter to mug.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in microwave for 1 minute. Allow to rest for about 5 seconds and continue cooking until a toothpick inserted in the center comes out clean, about 30 seconds more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cake cool for 2 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
