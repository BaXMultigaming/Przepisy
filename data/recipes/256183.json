  "ingredients": [
    "1 tablespoon butter",
    "1 cup green beans",
    "0.5 teaspoon garlic powder, or to taste",
    "salt to taste",
    "2 tablespoons sliced almonds",
    "2 tablespoons sweetened dried cranberries (such as Craisins®)",
    "1 splash orange juice",
    "ground white pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat butter in a small skillet over medium heat until it starts to brown and smell nutty, 3 to 5 minutes. Add green beans, garlic powder, and salt; cook and stir until beans are tender, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add almonds and cranberries; toss lightly to combine. Add orange juice and season with white pepper.",
