  "ingredients": [
    "1 cup raisins",
    "1 cup water",
    "2 cups rolled oats",
    "1 cup bran cereal (such as Kellogg's® All-Bran®)",
    "1 cup whole wheat flour",
    "0.75 cup white sugar",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1 cup milk",
    "1.5 teaspoons lemon juice",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring raisins and water to a boil in a small saucepan, reduce heat to medium, and boil 5 minutes; set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix rolled oats, bran cereal, whole wheat flour, sugar, and salt in a bowl. Mix milk with lemon juice in a small bowl and let stand 1 or 2 minutes to sour. Stir baking soda into sour milk until dissolved. Pour milk mixture into dry ingredients; beat egg into the mixture. Stir raisins and their liquid into the batter. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the middle comes out clean, about 1 hour. Cool in pan for 15 minutes before removing to finish cooling on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
