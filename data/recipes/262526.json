  "steps": [
    {
      "text": "In a bowl, combine the pineapple, red onion, green pepper, and teriyaki sauce. Cover and refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle 3/4 cup cheese on pizza crust. Top with pineapple mixture and chicken. Sprinkle with remaining cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 20 minutes or until cheese is melted.",
