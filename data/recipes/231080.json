  "ingredients": [
    "1 pound lean ground beef",
    "0.66666668653488 pound ground turkey",
    "1 egg",
    "0.75 cup finely chopped celery",
    "0.75 cup regular rolled oats",
    "0.5 cup skim milk",
    "0.5 cup ketchup",
    "0.5 cup finely chopped onion",
    "0.5 cup finely chopped green bell pepper",
    "1 tablespoon dried parsley",
    "1 teaspoon dry mustard powder",
    "0.66666668653488 teaspoon salt",
    "0.5 teaspoon minced garlic",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, ground turkey, egg, celery, rolled oats, skim milk, ketchup, onion, green pepper, parsley, dry mustard, salt, minced garlic, and black pepper in a bowl until thoroughly combined; mixture will be moist. Transfer mixture into a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an instant-read meat thermometer inserted into the center of the meatloaf reads at least 160 degrees F (70 degrees C), about 1 1/2 hours. Meatloaf may still look pink inside due to ketchup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
