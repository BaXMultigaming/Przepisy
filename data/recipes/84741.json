  "ingredients": [
    "3 cups water",
    "1 pound Brussels sprouts, trimmed",
    "2 tablespoons olive oil",
    "2 cloves garlic, minced",
    "8 ounces pancetta bacon, diced",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring the water to a boil in a large saucepan. Add Brussels sprouts, and cook for 5 to 7 minutes. They should still be slightly firm. Drain, and rinse with cold water. Slice the sprouts in half, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat one tablespoon of olive oil in a large skillet over medium-high heat. Add the garlic and pancetta; cook and stir for about 5 minutes, until garlic is lightly browned. Add the remaining olive oil and Brussels sprouts. Reduce the heat to medium and cook, stirring until the sprouts are well coated with the flavor. Season with salt and pepper, and cook for 5 more minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
