  "ingredients": [
    "3 (12 inch) untreated cedar planks",
    "0.33333334326744 cup soy sauce",
    "0.33333334326744 cup vegetable oil",
    "1.5 tablespoons rice vinegar",
    "1 teaspoon sesame oil",
    "0.25 cup chopped green onions",
    "1 tablespoon grated fresh ginger",
    "1 teaspoon minced garlic",
    "2 (2 pound) salmon fillets, skin removed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t8cTYve8bj1uitlS17FZK9fin_Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-109297-cedar-planked-salmon-DDMFS-step-01-0c7f307de76042f0947a66ac171c6c30.jpg"
      ],
      "image": "assets/images/109297/step_01.webp"
    },
    {
      "text": "Soak cedar planks for at least 1 hour in warm water. Soak longer if you have time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hw4RX2RVcoA-SP9tz_b8sIODo-Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-109297-cedar-planked-salmon-DDMFS-step-02-cf95ebbaf5b04e3ea304c5f3aa88f2a8.jpg"
      ],
      "image": "assets/images/109297/step_02.webp"
    },
    {
      "text": "Stir soy sauce, vegetable oil, rice vinegar, sesame oil, green onions, ginger, and garlic together in a shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PHFO_lk5EgKLzBaWYXptHY3a3BY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-109297-cedar-planked-salmon-DDMFS-step-03-271e809cf28e4f6db3b414ca9ccc1b88.jpg"
      ],
      "image": "assets/images/109297/step_03.webp"
    },
    {
      "text": "Place salmon fillets in soy mixture and turn to coat. Cover and marinate for at least 15 minutes, or up to 1 hour refrigerated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CLufi-M8TjsTYkf_NMTz_2_qF04=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-109297-cedar-planked-salmon-DDMFS-step-04-5585a396306f4d1b83ba617858a9684a.jpg"
      ],
      "image": "assets/images/109297/step_04.webp"
    },
    {
      "text": "Preheat an outdoor grill for medium heat. Place planks on the grill grate. Heat planks until they start to smoke and crackle just a little.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1Bodi9VypA5G7Zz5nvyLRJQDra4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-109297-cedar-planked-salmon-DDMFS-step-05-43965c14fd1342e4b167aab1dff05ff9.jpg"
      ],
      "image": "assets/images/109297/step_05.webp"
    },
    {
      "text": "Remove salmon from marinade and place on planks; discard marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TKMg2-_MANiWaQ30-iN6dVYRI9k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-109297-cedar-planked-salmon-DDMFS-step-06-c5cf314dfe624bf78ba724bca6463359.jpg"
      ],
      "image": "assets/images/109297/step_06.webp"
    },
    {
      "text": "Close grill cover. Grill salmon until it flakes easily with a fork, about 20 minutes; salmon will continue to cook after you remove it from the grill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8oK4P6_yaRlRnJZ8Jyyi0TGvb0Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-109297-cedar-planked-salmon-DDMFS-4x3-591545d0a0b0436bba4830f3c4740ecc.jpg"
      ],
      "image": "assets/images/109297/step_07.webp"
    }
