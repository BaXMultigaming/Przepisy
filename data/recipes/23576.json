  "ingredients": [
    "4 (4 ounce) fillets tilapia (bream)",
    "0.25 cup olive oil",
    "0.25 cup raspberry vinegar",
    "0.25 cup honey",
    "1 teaspoon yellow mustard",
    "0.5 teaspoon dried dill weed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 11x7 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, whisk together the olive oil, raspberry vinegar, honey, mustard and dill weed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange the tilapia filets in a single layer in the prepared baking dish. Pour mixture over the fish filets, coating the filets evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated oven, uncovered for 20 minutes or until fish is flaky with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
