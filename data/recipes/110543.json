  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup chopped walnuts",
    "0.5 cup melted butter or margarine",
    "0.25 cup brown sugar",
    "2 egg whites",
    "1 cup white sugar",
    "2 cups sliced strawberries",
    "2 tablespoons lemon juice",
    "1 cup whipped cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, walnuts, butter, and brown sugar in a medium bowl until well mixed; spread evenly onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crispy, about 20 minutes. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a large glass, metal, or ceramic bowl until soft peaks form. Gradually add sugar, continuing to beat until stiff peaks form. Toss strawberries in lemon juice in a small bowl; stir into meringue until mixture turns slightly pink. Fold in whipped cream until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble walnut mixture; evenly sprinkle ⅔ of it in a 9x13-inch baking dish. Spoon strawberry mixture over crumbs; sprinkle remaining crumbs over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Freeze until hard, about 2 hours. Remove from the freezer several minutes before serving to make it easier to slice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
