  "title": "Pound Cake Bread Pudding with Leftover Halloween Candy",
  "description": "Use store-bought or homemade pound cake to make this delicious bread pudding that takes advantage of all your leftover Halloween candy.",
  "authors": [
    "Sandra Garth"
  ],
  "date_published": "2020-06-19T00:32:06-04:00",
