  "ingredients": [
    "0.5 cup butter, softened",
    "1.125 cups all-purpose flour",
    "1 cup chopped walnuts",
    "0.125 teaspoon salt",
    "1 teaspoon vanilla extract",
    "2 tablespoons white sugar",
    "0.5 cup super fine sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream white sugar and butter in a mixing bowl. Add flour, nuts, salt, and vanilla; mix well. Dough will be very crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 1-inch balls. Place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow cookies to cool on the baking sheet for 3 minutes, then roll in superfine sugar. When cool, roll again in superfine sugar, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
