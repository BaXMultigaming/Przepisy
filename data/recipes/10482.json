  "ingredients": [
    "1 cup butter",
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "2 eggs",
    "1.5 teaspoons vanilla extract",
    "1 tablespoon real maple syrup",
    "1 cup all-purpose flour",
    "0.5 cup whole wheat flour",
    "0.33333298563957 cup graham cracker crumbs",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "3 cups rolled oats",
    "2 cups semisweet chocolate chips",
    "4 ounces finely grated chocolate bar",
    "0.5 cup chopped walnuts",
    "0.5 cup chopped cashews",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Place margarine in a large bowl. With an electric mixer, cream for 30 seconds. Stop and scrape bowl. Add sugars and cream for 2 minutes. Stop and scrape bowl. Add eggs, vanilla, and maple syrup. Mix for 2 minutes. Scrape bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add all-purpose flour, whole wheat flour, graham cracker crumbs, baking soda, baking powder, and salt. Mix on low for 1 minute. Add oatmeal and mix on low for 1 to 1 1/2 minutes, until thoroughly blended. Add chocolate and nuts. Mix on low for 30 seconds, just until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by rounded teaspoonfuls onto greased baking sheets. Bake at 350 degrees F (175 degrees C) for 8 to 10 minutes. Cool completely on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
