  "keywords": [],
  "ingredients": [
    "1 pound chestnuts",
    "0.25 cup butter",
    "1 pinch ground cinnamon",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5MS2B48ARhZNg2dlgrox1qqboak=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9494-RoastedChestnuts-gw-ddmfs-4x3-step-01-3834-35fd4e03cb8f4f79b2e663a0f83cd5e3.jpg"
      ],
      "image": "assets/images/9494/step_01.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wash and dry chestnuts. Place flat-side down on a cutting board. Using a paring knife, score a large \"X\" on the rounded side, covering at least half of the chestnut. Make sure the knife goes through the outer skin and the brown layer underneath. This will aid peeling after being roasted. Place nuts in a shallow baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6md4kyYkLdVUB0iOBXfHR5pOC6Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9494-RoastedChestnuts-gw-ddmfs-4x3-step-02-3835-183277a8fe5140d889ad8858e9577885.jpg"
      ],
      "image": "assets/images/9494/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes. Remove, leaving the oven on, and allow them to cool; peel off the shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I9F1L8XgPaZQLw3KqZPyqnHgd_0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9494-RoastedChestnuts-gw-ddmfs-4x3-step-04-3927-3fa7aec334bc4fdabe75718b520f8410.jpg"
      ],
      "image": "assets/images/9494/step_04.webp"
    },
    {
      "text": "Place nuts in a skillet with butter; sauté over high heat until butter is melted and chestnuts are well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GqRTmPQGwFkJ-E63PWkAqKQYi-0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9494-RoastedChestnuts-gw-ddmfs-4x3-step-05-3930-affd78697e0e46d2bb82259a7589f3eb.jpg"
      ],
      "image": "assets/images/9494/step_05.webp"
    },
    {
      "text": "Return skillet to oven and roast until they are golden on top. Sprinkle with cinnamon and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GCTz9lZuR4V5ow9X18e9y3IK5jk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9494-RoastedChestnuts-gw-ddmfs-4x3-step-06-3931-0a1fd43b47f04c529e41befda0278d30.jpg"
      ],
      "image": "assets/images/9494/step_06.webp"
    }
  ],
