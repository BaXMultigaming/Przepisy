  "ingredients": [
    "1 bunch fresh asparagus, trimmed",
    "0.5 (2.2 pound) wheel Brie cheese, sliced",
    "0.25 cup butter, melted",
    "0.5 cup dry bread crumbs",
    "0.25 cup toasted sesame seeds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place asparagus in a steamer over 1 inch of boiling water, and cover. Cook until tender but still crisp, about 2 to 6 minutes. Drain and place in a shallow baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay cheese slices over asparagus. In a small bowl combine melted butter, bread crumbs and sesame seeds. Sprinkle over cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase oven to broil. Broil just until breadcrumbs are golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
