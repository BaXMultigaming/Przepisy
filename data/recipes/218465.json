  "ingredients": [
    "1 (9 inch) refrigerated pie pastry",
    "0.5 cup grainy brown mustard",
    "6 slices Swiss cheese, about 1/4-inch thick",
    "3 large ripe tomatoes, thinly sliced",
    "1 tablespoon olive oil, or as needed",
    "2 tablespoons herbes de Provence"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Fit pie pastry into a 9-inch pie dish. Poke holes in bottom of crust with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread mustard evenly over bottom of crust. Cover with Swiss cheese, then arrange tomato slices over top to cover cheese in a spiral, from the outer edge to the center. Drizzle oil over tomatoes and sprinkle herbes de Provence over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden brown, cheese is melted, and tomatoes are curled at the edges, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
