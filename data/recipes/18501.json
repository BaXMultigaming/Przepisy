  "ingredients": [
    "4 cups chopped rhubarb",
    "2 (9 inch) unbaked pie crusts",
    "1.25 cups white sugar",
    "0.75 cup all-purpose flour",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
