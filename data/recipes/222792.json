  "ingredients": [
    "1 (8 ounce) package phyllo dough, thawed if frozen",
    "0.5 cup melted butter",
    "0.5 (13 ounce) jar chocolate-hazelnut spread (such as Nutella®)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place one sheet of phyllo dough on a work surface. Brush half the sheet with butter; fold sheet over.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread about 1 tablespoon chocolate-hazelnut spread in a 1/2-inch strip 1 inch from the bottom and sides of the folded phyllo. Spread butter over remaining dough surface.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold the sides of the phyllo dough over the ends of the chocolate layer, and roll into a cigar shape, starting from the bottom. Place on a baking sheet. Repeat with remaining phyllo, butter, and chocolate-hazelnut spread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
