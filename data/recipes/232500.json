  "ingredients": [
    "2 (12 ounce) cans chicken chunks, drained",
    "0.5 cup hot sauce",
    "0.25 cup butter",
    "2 small onions, diced",
    "5 stalks celery, diced",
    "2 cups water",
    "0.75 cup all-purpose flour",
    "0.75 cup milk",
    "2 cubes chicken bouillon",
    "6 ounces processed cheese (such as Velveeta®), cubed"
  ],
  "steps": [
    {
      "text": "Shred chicken with a fork in a bowl and add hot sauce; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small skillet over medium heat; cook and stir onions and celery in melted butter until tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix water, flour, milk, and chicken bouillon in a large pot until smooth. Add processed cheese, shredded chicken, and onion mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat soup over low heat until cheese is melted, about 30 minutes. Stir often.",
