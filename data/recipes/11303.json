  "ingredients": [
    "0.75 cup butter, softened",
    "0.75 cup white sugar",
    "0.75 cup packed brown sugar",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "3 cups rolled oats",
    "1.6666666269302 cups butterscotch chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, and brown sugar together in a large bowl with an electric mixer until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N6m8cqrS9R9TWdH8fvJ0vF3dSI0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11303-oatmealbutterscotchcookies-ddms-4x3-step1-948b1b4e73814d8aa2a562b04a456e3d.jpg"
      ],
      "image": "assets/images/11303/step_02.webp"
    },
    {
      "text": "Add eggs one at a time, beating well after each addition. Beat in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zpXpX4DLKCK4JYReIzCp7pobPGI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11303-oatmealbutterscotchcookies-ddms-4x3-step2-127aa08001ed4547927015c17b65ebb4.jpg"
      ],
      "image": "assets/images/11303/step_03.webp"
    },
    {
      "text": "Stir together flour, baking soda, cinnamon, and salt in a separate bowl. Gradually add flour mixture to butter mixture and mix until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Czjqn2NNAbfZLDzjmncHS4S7ZFY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11303-oatmealbutterscotchcookies-ddms-4x3-step3-0b00be9076a441d4aea27ee7b7df291e.jpg"
      ],
      "image": "assets/images/11303/step_04.webp"
    },
    {
      "text": "Mix in oats and butterscotch chips until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BOIC74RNhiVKGZtWBzA8HJhkbr4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11303-oatmealbutterscotchcookies-ddms-4x3-step5-849f3868ce884c1bb7eaad33dfec53e3.jpg"
      ],
      "image": "assets/images/11303/step_05.webp"
    },
    {
      "text": "Drop dough by teaspoonfuls onto an ungreased cookie sheet. Bake in the preheated oven until the edges begin to brown, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QJ8Z6SP0-_1o5bhgweSpSSGywGo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11303-oatmealbutterscotchcookies-ddms-4x3-step6-a497433f7c394d8a857953fcc302513e.jpg"
      ],
      "image": "assets/images/11303/step_06.webp"
    }
