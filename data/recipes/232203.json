  "ingredients": [
    "0.5 cup vegetable oil",
    "0.5 pound paneer, cut into 1/2-inch cubes",
    "2 tablespoons butter",
    "2 onions, finely chopped",
    "1 teaspoon ginger paste",
    "1 teaspoon garlic paste",
    "1 tablespoon ground cashews",
    "1 teaspoon ground red chiles",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon ground coriander",
    "0.5 teaspoon garam masala",
    "1 (8 ounce) can tomato sauce",
    "0.5 cup half-and-half",
    "0.5 cup milk",
    "0.5 teaspoon white sugar",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_N3J0zLphPzhf73NZ2DuVX6Opzs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232203-paneer-butter-masala-VAT-005-step-01-f5033b2722824f958cf0ac0ff60856ad.jpg"
      ],
      "image": "assets/images/232203/step_01.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium heat; fry paneer in batches until golden, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rOZEVosG5raaijvIm9OV0AcDVk8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232203-paneer-butter-masala-VAT-006-step-02-2c975f8817c844d7a4a40e742b365744.jpg"
      ],
      "image": "assets/images/232203/step_02.webp"
    },
    {
      "text": "Transfer fried paneer to a paper towel-lined plate to drain, retaining vegetable oil in skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-svRgmGjAixz2F6VS2oA5S3954I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232203-paneer-butter-masala-VAT-007-step-03-02plateandpaninframe-be383daec5524c318e8b557c782c8788.jpg"
      ],
      "image": "assets/images/232203/step_03.webp"
    },
    {
      "text": "Melt butter in the same skillet over medium heat; cook and stir onion until golden brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ETJ0eHE4DaTn_EXeb17P8u3lynw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232203-paneer-butter-masala-VAT-008-step-04-d94d0487abf648a68e505e7690e89dae.jpg"
      ],
      "image": "assets/images/232203/step_04.webp"
    },
    {
      "text": "Add ginger paste and garlic paste. Continue to cook until fragrant, about 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AAv53Z6S0EWLBM-BJUCPY2XAFE4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232203-paneer-butter-masala-VAT-009-step-05-f64ad4b6ba7a4cd49a5d69f8c6e0ad01.jpg"
      ],
      "image": "assets/images/232203/step_05.webp"
    },
    {
      "text": "Stir cashews, ground red chiles, cumin, coriander, and garam masala into the onion mixture. Cook and stir for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2wmaXr6T8jHWIxtSnKNu4PAGNiA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232203-paneer-butter-masala-VAT-010-step-06-02nospatula-f7cae5d727254bdf9307829e56b30918.jpg"
      ],
      "image": "assets/images/232203/step_06.webp"
    },
    {
      "text": "Stir tomato sauce, half-and-half, milk, sugar, and salt into spice mixture; simmer until thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fKPAxdZLnkfzcwz36DJ-PzbfH50=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232203-paneer-butter-masala-VAT-011-step-07-02-f9e7dacd92724167919922cb7456daca.jpg"
      ],
      "image": "assets/images/232203/step_07.webp"
    },
    {
      "text": "Reduce heat to low. Add fried paneer and simmer until heated through, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m9GSShIte9R-VkdKjGT50uE1yV4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232203-paneer-butter-masala-VAT-012-step-08-01-5794251411144d69b6b1a5125e1c2b39.jpg"
