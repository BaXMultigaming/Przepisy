  "ingredients": [
    "1 pound dried black-eyed peas",
    "1 tablespoon vegetable oil",
    "1 medium onion, chopped",
    "5 cloves garlic, minced",
    "1 pound smoked ham hocks",
    "6 cups water",
    "1 tablespoon seasoned salt",
    "1 teaspoon onion powder",
    "1 teaspoon ground cumin",
    "1 teaspoon freshly ground black pepper",
    "0.25 teaspoon crushed red pepper",
    "3 bay leaves"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Soak black-eyed peas in a bowl of water for at least 2 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jrSWaWVCqZSy1Z6GxzvjWQbkoZU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/282644-Southern-Style-Black-Eyed-Peas-ddmfs-step-2-2f6e5c56b19c4055b514ed3669ecd00e.jpg"
      ],
      "image": "assets/images/282644/step_02.webp"
    },
    {
      "text": "Heat oil in a large, heavy saucepan over medium heat. Add onion and garlic; sauté until onion is translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tSWmh01L3ytR2wYuwyX--LPxc8M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/282644-Southern-Style-Black-Eyed-Peas-ddmfs-step-3-945a806688624b76b04a9ce2d08c0ec5.jpg"
      ],
      "image": "assets/images/282644/step_03.webp"
    },
    {
      "text": "Add ham hocks and water; bring to a boil. Cover, reduce the heat to a simmer, and cook for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xQNolY0DbPwwuLBLHl7GeLiVTK0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/282644-Southern-Style-Black-Eyed-Peas-ddmfs-step-4-ba651cdee9954f9f8f17df8f2c9ff79b.jpg"
      ],
      "image": "assets/images/282644/step_04.webp"
    },
    {
      "text": "Drain peas; add to the pan along with seasoned salt, onion powder, cumin, black pepper, red pepper, and bay leaves. Bring to a boil. Cover, reduce the heat to a simmer, and cook for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mu0JQZn99Vy9vvhxCzb8zE3s4Ak=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/282644-Southern-Style-Black-Eyed-Peas-ddmfs-step-5-B-9f4f0504e67d46b49e82b0f057ec4bfe.jpg"
      ],
      "image": "assets/images/282644/step_05.webp"
    },
    {
      "text": "Uncover the pan and cook until peas are tender, about 30 more minutes. Remove bay leaves and ham hocks before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vJMv76POVn3KHwnMDvc_-bQ_MJ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/282644-Southern-Style-Black-Eyed-Peas-ddmfs-step-6-a3a77f7526c64c1e87b26f0885599fe2.jpg"
      ],
      "image": "assets/images/282644/step_06.webp"
    }
  ],
