  "ingredients": [
    "1 cup butter, softened",
    "0.75 cup white sugar",
    "0.75 cup packed brown sugar",
    "2 eggs, divided",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "0.5 cup dark cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup chopped walnuts",
    "1 cup white chocolate chips",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, and brown sugar together with an electric mixer in a large bowl until smooth and creamy. Beat 1 egg into butter mixture; beat remaining egg and vanilla extract into butter mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, cocoa powder, baking soda, and salt together in a bowl; add to creamed butter mixture and beat until the dry ingredients are integrated into a dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold walnuts, white chocolate chips, and semisweet chocolate chips into the dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by teaspoonful onto baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until browning along the edges, 9 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
