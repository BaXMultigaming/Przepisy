  "ingredients": [
    "2 cups all-purpose flour",
    "1 pound skinless, boneless chicken breast halves - cut into strips",
    "1 egg, beaten",
    "1 cup vegetable oil for frying",
    "0.5 cup butter",
    "1 cup brown sugar",
    "1 cup maple syrup",
    "0.5 cup chopped pecans",
    "2 teaspoons Creole seasoning"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour in a shallow bowl and press chicken strips into the flour; tap to remove excess flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip floured chicken in the egg and again coat with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a large skillet over medium heat. Pan-fry chicken strips until golden brown and the meat is no longer pink inside, about 5 minutes per side; drain on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat and stir in brown sugar, maple syrup, pecans, and Creole seasoning. Bring the mixture to a boil and cook for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken strips into the prepared casserole dish; pour praline sauce over chicken and toss chicken to coat with sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until sauce is bubbling, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
