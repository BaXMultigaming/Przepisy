  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 tablespoon grated fresh ginger",
    "1 tablespoon minced garlic",
    "1 teaspoon paprika",
    "1 teaspoon ground cinnamon",
    "1 teaspoon grated orange zest",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground cardamom",
    "2 pounds pork chops",
    "2 tablespoons vegetable oil",
    "0.5 cup soy sauce, divided",
    "0.5 cup honey",
    "0.5 cup water",
    "3 zucchinis, thickly sliced",
    "2 carrots, thinly sliced",
    "1 onion, cubed",
    "0.5 green bell pepper, sliced",
    "0.5 stalk celery, thinly sliced"
  ],
  "steps": [
    {
      "text": "Mix together 1 tablespoon vegetable oil, ginger, garlic, paprika, cinnamon, orange zest, cloves, and cardamom in a bowl to form a paste and rub the pork chops with the spice paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 2 tablespoons vegetable oil in a large deep skillet and pan-fry the chops over high heat until browned and no longer pink inside, about 10 minutes per side. Pour in 1/4 cup soy sauce and coat the chops with soy sauce. Pour in honey, remaining 1/4 cup soy sauce, and water; mix thoroughly. Reduce heat to medium.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in zucchinis, carrots, onion, green bell pepper, and celery; cook and stir vegetables until cooked through but still slightly firm, about 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
