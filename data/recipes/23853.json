  "ingredients": [
    "1 (10 ounce) package frozen broccoli",
    "2.5 cups milk",
    "2.5 cups cubed processed cheese",
    "0.33300000429153 cup all-purpose flour",
    "1 cup heavy cream",
    "1 cube chicken bouillon",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place broccoli in a medium saucepan with just enough water to cover. Cook until tender, about 8 minutes. Set aside and do not drain water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan, heat milk. Blend in the flour and cheese until smooth. Stir in the cream and bouillon cube. Add the broccoli and it's water to the mixture and season with salt and pepper. Heat soup to warm and serve immediately.",
      "section": null,
