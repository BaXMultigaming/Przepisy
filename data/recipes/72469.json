  "ingredients": [
    "3 cups fresh blueberries",
    "0.5 lemon",
    "1.125 cups white sugar",
    "4.5 tablespoons butter, softened",
    "1.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.75 cup whole milk",
    "1.5 cups white sugar",
    "1.5 tablespoons cornstarch",
    "0.75 teaspoon salt",
    "1 pinch ground cinnamon",
    "0.75 cup boiling water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 11x7-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread blueberries into the prepared dish; squeeze lemon juice over top. Stir 1 ⅛ cups sugar and butter together in a large bowl until smooth; stir in flour and baking powder, alternately with milk, until smooth; batter will be thin. Spoon evenly over berries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 ½ cups sugar, cornstarch, salt, and cinnamon in a bowl; sprinkle over batter. Pour water over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
