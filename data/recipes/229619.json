  "ingredients": [
    "0.5 cup butter, softened",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "1 egg",
    "1 cup all-purpose flour",
    "1 cup rolled oats",
    "0.33333334326744 cup peanut butter",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "1 cup chocolate chips, or to taste",
    "0.5 cup confectioners' sugar",
    "0.25 cup peanut butter",
    "1 tablespoon milk, or more as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, 1/2 cup white sugar, brown sugar, and egg in a large bowl until smooth. Stir in flour, oats, 1/3 cup peanut butter, baking soda, vanilla extract, and salt until dough is well mixed. Press dough into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden brown, about 20 minutes; sprinkle with chocolate chips immediately. Let chocolate chips melt, about 5 minutes. Spread chocolate over cookie with a spatula or knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix confectioners' sugar, 1/4 cup peanut butter, and milk in a small bowl until smooth. Add more milk if mixture is too thick to pour; drizzle over chocolate and allow to cool. Cut into bars to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
