  "ingredients": [
    "4 cups orange juice",
    "4 apples - peeled, cored and sliced",
    "4 teaspoons ground cinnamon",
    "4 scoops vanilla ice cream",
    "0.25 cup brandy-based orange liqueur (such as Grand Marnier®)",
    "0.25 cup amaretto liqueur",
    "4 chocolate wafer cookies"
  ],
  "steps": [
    {
      "text": "In a saucepan over medium heat, combine orange juice, apples and cinnamon. Simmer for 5 minutes, or until tender.",
