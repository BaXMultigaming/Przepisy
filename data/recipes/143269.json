  "ingredients": [
    "3 fluid ounces brewed espresso",
    "1 tablespoon caramel sauce",
    "2 tablespoons white sugar",
    "0.75 cup milk",
    "1.5 cups ice cubes",
    "2 tablespoons whipped cream"
  ],
  "steps": [
    {
      "text": "Place the espresso, caramel sauce, and sugar into a blender pitcher. Blend on high until the caramel and sugar dissolve into the espresso. Pour in the milk and add the ice; continue blending until smooth and frothy. Top with whipped cream to serve.",
