  "ingredients": [
    "1 (16 ounce) package elbow macaroni",
    "0.5 cup evaporated milk",
    "2 eggs",
    "1 (8 ounce) container sour cream",
    "1 teaspoon seasoning salt",
    "0.5 teaspoon black pepper",
    "1.5 cups shredded Cheddar cheese",
    "0.5 cup grated Parmesan cheese",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes, or until al dente; drain and rinse with cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix milk, eggs, sour cream, seasoning salt, and pepper in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer macaroni, Cheddar cheese, and milk mixture into the prepared casserole dish until full. Sprinkle Parmesan cheese and pour melted butter on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and bubbly, about 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
