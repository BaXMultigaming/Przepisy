  "ingredients": [
    "1 cup white sugar",
    "2 cups all-purpose flour",
    "2 teaspoons baking soda",
    "0.5 cup water",
    "1 cup mashed bananas",
    "1 pinch salt",
    "1 cup mayonnaise",
    "1 (8 ounce) package cream cheese",
    "1 cup butter, softened",
    "4 cups confectioners' sugar",
    "2 teaspoons vanilla extract",
    "0.75 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease two 9 inch round pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, flour, baking soda, water, mashed bananas, salt, and mayonnaise. Mix together, and pour into the cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cake about 45 minutes, or until a toothpick inserted in the center comes out clean. Remove from oven, and cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, blend cream cheese and butter or margarine together. Gradually add sugar and vanilla, and mix well. Stir in nuts. Fill and frost the cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
