  "ingredients": [
    "1 (18 ounce) bottle barbeque sauce",
    "2 tablespoons Scotch whiskey",
    "1.5 teaspoons Worcestershire sauce",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon paprika",
    "0.5 teaspoon chili powder",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion salt",
    "0.5 teaspoon dried oregano",
    "1 tablespoon red pepper flakes",
    "1.5 tablespoons white sugar",
    "0.5 teaspoon ground black pepper, or to taste",
    "0.25 teaspoon hot pepper sauce, or to taste"
  ],
  "steps": [
    {
      "text": "In a medium bowl, stir together the barbeque sauce, whiskey, Worcestershire sauce, ginger, cayenne pepper, paprika, chili powder, garlic powder, onion salt, oregano, red pepper flakes, sugar, ground black pepper, and hot pepper sauce. Cover, and keep refrigerated until ready to use.",
