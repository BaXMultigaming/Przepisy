  "ingredients": [
    "10 slices bacon",
    "1.25 cups shredded Cheddar cheese, divided",
    "1 (8 ounce) can sliced water chestnuts, drained",
    "1 cup diced celery",
    "0.75 cup mayonnaise",
    "0.25 cup shredded carrots",
    "2 tablespoons minced fresh chives",
    "6 cups popped popcorn"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PmL8AFZn3d7MaZMih-uJnlQbY-s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23798-popcorn-salad-ddmfs-4x3-step-01-1600-5981a9b32a4b4795a084e2ae295996f3.jpg"
      ],
      "image": "assets/images/23798/step_01.webp"
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels; crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O7OJa_WRibEvRygcGBKH55gaNDs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23798-popcorn-salad-ddmfs-4x3-step-02-1601-edc1b64c907040e295cbce622d950f3e.jpg"
      ],
      "image": "assets/images/23798/step_02.webp"
    },
    {
      "text": "Combine 1 cup Cheddar cheese, water chestnuts, celery, mayonnaise, 1/2 cup bacon, carrots, and chives together in a large bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xMwKxezD9bQqwhIljNAMONlvtA8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23798-popcorn-salad-ddmfs-4x3-step-03-1603-4a0bffff38b44a0bae133f385821fc85.jpg"
      ],
      "image": "assets/images/23798/step_03.webp"
    },
    {
      "text": "Add popcorn and stir to coat. Sprinkle with remaining cheese and bacon; serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P7FKzH4djV8aTgOHZgZR6YUbmrY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23798-popcorn-salad-ddmfs-4x3-step-04-1604-e552c977bdcd4cf89d716728a9fdfa06.jpg"
