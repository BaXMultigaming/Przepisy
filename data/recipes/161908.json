  "ingredients": [
    "3 tablespoons butter, softened",
    "2 cloves garlic, pressed",
    "1 teaspoon curry powder",
    "0.5 teaspoon ground cumin",
    "0.125 teaspoon salt",
    "2 pounds mussels, scrubbed and debearded",
    "1 cup chopped red bell pepper",
    "0.25 cup chopped fresh parsley",
    "1 lime, thinly sliced",
    "1 lime, cut into 4 wedges"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high medium-heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk butter, garlic, curry powder, cumin, and salt together in a small bowl until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange 4 large sheets aluminum foil on a flat surface. Divide mussels into 4 even portions and place 1 portion in center of each piece of foil. Dot mussels evenly with butter mixture; sprinkle top of each with bell pepper and parsley. Top each with lime slices. Wrap foil tightly around mussels to make 4 packets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the packets on the preheated grill; cook until mussels open, 5 to 10 minutes. Discard any mussels which do not open.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer mussels to small bowls; garnish each with a lime wedge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
