  "ingredients": [
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "1.25 cups vegetable oil",
    "3 eggs",
    "1 (8 ounce) can crushed pineapple with juice",
    "1.5 teaspoons vanilla extract",
    "0.75 cup chopped pecans",
    "0.25 cup chopped black walnuts",
    "0.66666668653488 cup mashed bananas",
    "cream cheese frosting",
    "pecan halves for garnish"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour three 9-inch round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ARLZ3f3_J3wQAScXmv9Gua6eFbk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8200-best-hummingbird-cake-VAT-step-01-ef8126814fd14af0b5a1d4e3a739d313.jpg"
      ],
      "image": "assets/images/8200/step_01.webp"
    },
    {
      "text": "Combine flour, sugar, salt, cinnamon, and baking soda. Stir in oil and beaten eggs until just moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RtYMnmXhBCg-CRqsFiOXyLKsOuk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8200-best-hummingbird-cake-VAT-step-02-9dd9a97205e1413b801f51d40bda1275.jpg"
      ],
      "image": "assets/images/8200/step_02.webp"
    },
    {
      "text": "Stir in vanilla, pineapple with juice, pecans, walnuts, and bananas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OrzPbdzcJ0ND-dsKEdqLN9ncc9o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8200-best-hummingbird-cake-VAT-step-03-bb4cbd7d038d421eaabddbed4532d565.jpg"
      ],
      "image": "assets/images/8200/step_03.webp"
    },
    {
      "text": "Spoon batter into the prepared pans. Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qeSVOqnqrZqAK_WvoFKJg6teeAc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8200-best-hummingbird-cake-VAT-step-04-2d3ee4c90d7045dc9064fbc67b4bcef7.jpg"
      ],
      "image": "assets/images/8200/step_04.webp"
    },
    {
      "text": "Let cakes cool in pans briefly before turning out onto racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/u8j6dAbsODmNxQpsx3P_M9s5vaE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8200-best-hummingbird-cake-VAT-step-05-fc3871448d0f45dca1af76458365b9c5.jpg"
      ],
      "image": "assets/images/8200/step_05.webp"
    },
    {
      "text": "Frost layers, top and sides of cake with your favorite cream cheese frosting. Decorate with pecans.",
