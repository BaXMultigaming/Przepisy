  "title": "Nut and Fruit Bread",
  "description": "This fruit and nut bread is a great holiday recipe to make that belonged to my mother. This bread is good on the first day but even better on the second.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-05-12T13:03:34-04:00",
