  "ingredients": [
    "1 large egg",
    "1 cup milk",
    "2 tablespoons butter, melted",
    "2 cups sifted all-purpose flour",
    "4 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup raisins",
    "0.75 cup chopped walnuts",
    "0.5 cup white sugar",
    "1 tablespoon orange zest"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a small bowl. Mix in milk and melted butter; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and salt into a large bowl. Add raisins, walnuts, sugar, and orange zest; mix well. Blend in egg mixture until flour is just moistened. Transfer batter to the prepared pan and allow to rest for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 55 to 60 minutes. Turn bread out onto a wire rack and cool for several hours before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
