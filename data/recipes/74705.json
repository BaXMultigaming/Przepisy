  "ingredients": [
    "12 chicken drumsticks",
    "1 (5 ounce) bottle hot red pepper sauce",
    "0.25 cup butter, cubed",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "salt and pepper to taste",
    "1.5 cups blue cheese salad dressing"
  ],
  "steps": [
    {
      "text": "Place drumsticks in a slow cooker, and sprinkle evenly with pieces of butter. Pour hot sauce over the chicken, then season with garlic powder, onion powder, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook on High for 3 hours, or until tender. Serve chicken legs with blue cheese dressing on the side.",
