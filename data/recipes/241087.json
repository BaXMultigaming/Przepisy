  "ingredients": [
    "20 (3 inch) unbaked tart shells",
    "0.5 cup packed brown sugar",
    "0.25 cup butter, softened",
    "2 eggs",
    "1 cup golden corn syrup",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon lemon juice",
    "0.25 teaspoon ground cardamom",
    "0.125 teaspoon ground cinnamon",
    "0.125 teaspoon ground nutmeg",
    "0.125 teaspoon ground ginger",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Place tart shells on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter together with an electric mixer until creamy; beat in eggs, corn syrup, vanilla extract, lemon juice, cardamom, cinnamon, nutmeg, and ginger.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide raisins evenly into the bottom of tart shells; pour about 2 tablespoons syrup mixture into each tart shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pastry is golden and filling is set, about 20 minutes; remove to cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
