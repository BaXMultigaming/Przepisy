  "ingredients": [
    "6 bratwurst links, browned and cut into 1/2 inch slices",
    "4 medium potatoes, peeled and cubed",
    "1 tablespoon dried minced onion",
    "1 (15 ounce) can green beans, drained",
    "1 small red bell pepper, seeded and chopped",
