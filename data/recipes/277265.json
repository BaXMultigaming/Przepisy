  "ingredients": [
    "cooking spray",
    "0.25 cup milk, at room temperature",
    "1 tablespoon white vinegar",
    "0.5 cup brown sugar",
    "0.25 cup white sugar",
    "0.5 cup butter, softened",
    "2 eggs, at room temperature",
    "1 egg yolk, at room temperature",
    "1 tablespoon vanilla extract",
    "1.5 cups brown rice flour",
    "1 cup white rice flour",
    "0.5 cup ground flax seeds",
    "4 tablespoons baking powder",
    "1 teaspoon xanthan gum",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1 cup dried cranberries",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray 18 muffin cups with cooking spray or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place milk and vinegar in a small bowl; stir and set soured milk aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, white sugar, and butter together in a bowl using an electric hand mixer or stand mixer until creamy and smooth. Add soured milk, eggs, egg yolk, and vanilla extract; beat until smooth, scraping down the sides of the bowl as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown rice flour, white rice flour, flax seeds, baking powder, xanthan gum, cinnamon, and salt together in another bowl. Stir slowly into creamed butter mixture until just mixed. Stir in cranberries and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
