  "ingredients": [
    "3 eggs",
    "0.5 cup soy sauce",
    "0.33333334326744 cup white sugar",
    "0.75 cup cornstarch",
    "0.33333334326744 cup all-purpose flour",
    "3 tablespoons sesame seeds",
    "1 teaspoon salt",
    "4 green onions, chopped",
    "3 cloves garlic, diced",
    "3 pounds skinless, boneless chicken thighs, cut into bite-sized pieces",
    "oil for frying"
  ],
  "steps": [
    {
      "text": "Whisk eggs, soy sauce, and sugar together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornstarch, flour, sesame seeds, and salt in a separate bowl. Whisk in egg mixture. Fold green onions and garlic into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chicken into the batter until each piece is coated. Cover and marinate in the refrigerator, 8 hours to 2 days. Stir 1 to 2 times per day.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a heavy saucepan with 1 1/2 to 2 inches of oil. Heat on medium-high heat until a small amount of batter sizzles when dropped in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chicken again to coat evenly with batter. Fry in batches until deeply browned, about 3 minutes per batch. Drain on a large plate lined with paper towels or newspapers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
