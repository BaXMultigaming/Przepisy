  "ingredients": [
    "3 tablespoons olive oil",
    "1 tablespoon sesame seeds",
    "0.25 teaspoon wasabi powder",
    "0.125 teaspoon cracked black pepper",
    "1 pound sushi grade tuna, finely diced",
    "sliced French bread"
  ],
  "steps": [
    {
      "text": "Combine olive oil, sesame seeds, wasabi, and black pepper in a bowl. Add tuna and toss until evenly coated. Adjust seasoning as desired with additional wasabi powder or black pepper. Serve on sliced French bread.",
