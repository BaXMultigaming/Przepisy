  "ingredients": [
    "2.5 cups blanched almond flour",
    "2 tablespoons blanched almond flour",
    "5 ounces vegan chocolate chips",
    "0.5 teaspoon Celtic sea salt",
    "0.5 teaspoon baking soda",
    "9 tablespoons grapeseed oil",
    "0.33333334326744 cup agave nectar",
    "2 teaspoons agave nectar",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 1/2 cups plus 2 tablespoons almond flour, chocolate chips, salt, and baking soda in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir grapeseed oil, 1/3 cup plus 2 teaspoons agave nectar, and vanilla extract together in a smaller bowl. Add oil mixture to almond flour mixture and mix into a dough. Shape small portions of the dough into 1/2-inch balls and press onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the the preheated oven until edges are golden, 7 to 10 minutes. Cool on the baking sheet for 1 minute before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
