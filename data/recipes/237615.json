  "ingredients": [
    "0.5 cup pine nuts",
    "2 cups water",
    "1 cup quinoa",
    "2 cups chopped fresh spinach",
    "1 (15 ounce) can kidney beans, rinsed and drained",
    "1 cup halved grape tomatoes",
    "0.5 cup halved Kalamata olives",
    "0.5 cup crumbled feta cheese",
    "0.25 cup minced red onion",
    "0.25 cup olive oil",
    "3 tablespoons red wine vinegar",
    "1 tablespoon lemon juice",
    "0.5 teaspoon dried oregano",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat a skillet over medium-high heat; cook and stir pine nuts in the hot skillet until fragrant and toasted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer, stirring occasionally, until quinoa is tender and water has been absorbed, about 15 minutes. Remove from heat and let stand for 5 minutes; fluff with a fork and cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix quinoa, spinach, kidney beans, tomatoes, olives, feta cheese, and onion together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, vinegar, lemon juice, oregano, salt, and pepper together in a bowl until dressing is smooth; drizzle over quinoa mixture and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
