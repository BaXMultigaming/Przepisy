  "ingredients": [
    "1.75 cups all-purpose flour",
    "0.75 cup white sugar",
    "2 lemons, zested and juiced",
    "2 tablespoons poppy seeds",
    "2.6666667461395 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup buttermilk",
    "0.33333334326744 cup sour cream",
    "0.33333334326744 cup vegetable oil",
    "1 egg",
    "1 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 12 muffin cups with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, white sugar, lemon zest, poppy seeds, baking powder, and salt together in a bowl. Beat buttermilk, sour cream, vegetable oil, and egg together in another bowl. Pour buttermilk mixture into flour mixture and stir until batter is just combined. Pour batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 20 minutes. Cool for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While muffins are cooling, whisk confectioners' sugar and lemon juice together in a bowl until glaze is smooth. Drizzle glaze over muffins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
