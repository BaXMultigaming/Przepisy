  "ingredients": [
    "nonstick cooking spray",
    "2 large eggs",
    "0.75 cup white sugar",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1 cup heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x9-inch square pan with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl until very thick. Mix in sugar and vanilla until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking powder, and salt in a separate bowl. Add flour mixture to egg mixture in 3 parts, alternating with whipping cream, mixing until combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
