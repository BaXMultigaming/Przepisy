  "ingredients": [
    "0.5 cup all-purpose flour",
    "0.25 teaspoon salt",
    "1 dash ground black pepper",
    "1 pound cubed beef stew meat",
    "1 tablespoon olive oil",
    "1 onion, diced",
    "3 cups beef stock",
    "2 tablespoons curry powder",
    "2 bay leaves",
    "3 potatoes, cut into 1/4 inch cubes",
    "2 carrots, diced",
    "0.25 cup rice vinegar",
    "1 tablespoon molasses"
  ],
  "steps": [
    {
      "text": "Combine flour, salt, and black pepper in a bowl. Add beef and toss to coat; shake off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium-high heat. Add beef and onion; cook until browned. Stir in beef stock, curry powder, and bay leaves; bring to a boil, then reduce heat and simmer for 30 minutes. Stir in potatoes, carrots, vinegar, and molasses; simmer until tender, about 1 hour more.",
      "section": null,
