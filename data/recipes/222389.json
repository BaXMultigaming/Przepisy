  "steps": [
    {
      "text": "Place 1/2 cup coarse sea salt, rosemary, and lemon thyme in the bowl of a food processor. Pulse, grinding salt until rosemary and thyme have a fine consistency. Add 1 cup sea salt and pulse to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour salt mixture into a shallow baking dish and let air dry for 2 hours. Transfer salt to a glass jar and screw on lid.",
