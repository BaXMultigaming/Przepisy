  "title": "Mango Cheesecake with Sweet Ginger Crust",
  "description": "Add some flair to a very traditional dessert with this mango cheesecake recipe featuring a sweet crust made from crushed gingersnaps.",
  "authors": [
    "SwtToothPriya"
  ],
