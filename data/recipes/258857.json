  "ingredients": [
    "1.5 cups gingersnap cookie crumbs",
    "5 tablespoons unsalted butter, melted",
    "2 mangoes, peeled and pitted",
    "3 (8 ounce) packages cream cheese, softened",
    "1 cup white sugar",
    "1 tablespoon cornstarch",
    "3 eggs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine gingersnap cookie crumbs and melted butter in a bowl; mix until well combined. Press into the bottom of 9-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes; let cool, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree 1 mango using a food processor. Slice the other mango and arrange in an even layer over the cooled crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the cream cheese, white sugar, and cornstarch in a bowl using an electric mixer on low speed until smooth and fluffy. Beat in the eggs 1 at a time, beating well after each addition. Add mango puree; mix on low speed until combined. Mix by hand to finish. Pour batter into cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, 55 to 65 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn oven off; let cake stand for 30 minutes in the oven with the door open 4 inches. Remove from oven; refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
