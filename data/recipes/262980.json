  "ingredients": [
    "1 pound ground turkey",
    "1 cup Italian-style bread crumbs",
    "2 eggs",
    "0.25 cup finely chopped onion",
    "0.25 cup grated Parmesan cheese",
    "0.25 teaspoon ground black pepper",
    "1 (14 ounce) jar marinara sauce, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine turkey, bread crumbs, eggs, onion, Parmesan cheese, and pepper in a large bowl. Fold in 1 cup marinara sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat turkey mixture firmly into a 8x4-inch loaf pan using wet hands. Pour remaining marinara sauce on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until meatloaf is no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Let stand 20 minutes before cutting.",
      "section": null,
      "name": null,
      "url": null,
