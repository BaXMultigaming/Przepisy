  "ingredients": [
    "1 pound ground beef",
    "0.25 pound sliced pepperoni sausage",
    "1 (14 ounce) can pizza sauce",
    "2 (12 ounce) packages refrigerated buttermilk biscuit dough",
    "0.5 onion, sliced and separated into rings",
    "1 (10 ounce) can sliced black olives",
    "1 (4.5 ounce) can sliced mushrooms",
    "1.5 cups shredded mozzarella cheese",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather ingredients. Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1ohsbS57qJgIMUXcjttVYBEPO-k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-37677-bubble-pizza-VAT-4x3-step-01-c4674dac096f49e29be52c5311c96f01.jpg"
      ],
      "image": "assets/images/37677/step_01.webp"
    },
    {
      "text": "Place ground beef in a large, deep skillet. Cook and stir over medium-high heat until crumbly and evenly browned. Stir in pepperoni; cook and stir until browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oKGZVTrd-1CLLJqglCgiE1kaoFQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-37677-bubble-pizza-VAT-4x3-step-02-e97ef2dfe26a4db381c445a610864c97.jpg"
      ],
      "image": "assets/images/37677/step_02.webp"
    },
    {
      "text": "Drain excess fat. Stir in pizza sauce. Remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CAhIqwZ6aW3qEZGae81QKhpBSeA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-37677-bubble-pizza-VAT-4x3-step-03-00a5c4c119f9432f8a81e21a7903a4e8.jpg"
      ],
      "image": "assets/images/37677/step_03.webp"
    },
    {
      "text": "Cut each dough round into quarters and place in the bottom of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/73FqIoWsbDAghDeTTq_1x6N59OQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-37677-bubble-pizza-VAT-4x3-step-04-6d77a50a873d42698bccd95f10059f43.jpg"
      ],
      "image": "assets/images/37677/step_04.webp"
    },
    {
      "text": "Spread meat mixture evenly over dough. Sprinkle with onion, olives, and mushrooms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Nexa_rBX4nfBrVIhwR1xnrXaN5M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-37677-bubble-pizza-VAT-4x3-step-05-2d967331b53849d796ecbc6f5c9ffd02.jpg"
      ],
      "image": "assets/images/37677/step_05.webp"
    },
    {
      "text": "Bake, uncovered, in the preheated oven for 20 to 25 minutes. Sprinkle top with mozzarella and Cheddar cheese",
      "section": null,
      "name": null,
      "url": null,
