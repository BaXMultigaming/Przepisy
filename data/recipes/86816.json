  "ingredients": [
    "1 pound mild pork sausage",
    "1 (15 ounce) can wax beans, drained",
    "1 (15 ounce) can cut green beans, drained",
    "1 (15 ounce) can lima beans, drained",
    "1 (15 ounce) can black beans, drained",
    "0.5 (28 ounce) can barbeque baked beans, with liquid",
    "1 (15 ounce) can chili beans, with liquid",
    "1 (6 ounce) can tomato paste",
    "1 cup packed light brown sugar",
    "0.25 cup barbeque sauce",
    "1 small green bell pepper, diced",
    "1 small yellow onion, diced",
    "1 teaspoon fennel seed"
  ],
  "steps": [
    {
      "text": "Place sausage in a skillet over medium heat, and cook until evenly brown, about 7 to 10 minutes. Drain grease, and transfer sausage to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add wax beans, green beans, lima beans, and black beans into the slow cooker with sausage. Mix in baked beans with liquid and chili beans with liquid. Stir in tomato paste, brown sugar, barbeque sauce, green bell pepper, onion, and fennel seed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover slow cooker and cook on Low for at least 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
