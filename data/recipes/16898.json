  "ingredients": [
    "1 (10 ounce) package frozen sweetened strawberries, thawed",
    "0.5 cup vegetable oil",
    "2 eggs",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "1 cup white sugar",
    "1.5 cups all-purpose flour",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Drain the strawberries, reserving 1/4 cup of the juice. In a large mixing bowl stir together the oil, eggs, baking soda, baking powder, cinnamon, sugar and flour. Fold in the pecans, strawberries and 1/4 cup of their juice. Pour the mixture into your bread machine pan and place it in the machine. Select the Quick Bread cycle and press Start.",
      "section": null,
      "name": null,
