  "ingredients": [
    "2 (4 ounce) salmon fillets",
    "salt and ground black pepper to taste",
    "3 tablespoons olive oil",
    "2 tablespoons honey",
    "2 tablespoons water",
    "2 tablespoons brown sugar",
    "2 teaspoons sriracha sauce",
    "2 teaspoons soy sauce",
    "1 large clove garlic, minced"
  ],
  "steps": [
    {
      "text": "Season salmon fillets on both sides with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium-high heat. Cook salmon fillets until flesh flakes easily with a fork, 5 to 6 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine honey, water, brown sugar, sriracha sauce, soy sauce, and garlic in a small pot over medium heat; bring to a boil. Cook, stirring frequently, until glaze is thick and smooth, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour glaze over salmon fillets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
