  "title": "Smothered Beef Short Ribs",
  "description": "This beef short ribs recipe skips the oven in favor of the stovetop. Flour-dredged ribs are seared, then simmered with veggies and herbs in a savory stock.",
  "authors": [
    "Michele O'Sullivan"
  ],
  "date_published": "2000-03-01T00:38:27-05:00",
  "date_modified": "2026-05-11T19:13:16-04:00",
  "prep_time": "PT20M",
  "cook_time": "PT150M",
  "total_time": "PT170M",
  "yield": [
    "6"
  ],
