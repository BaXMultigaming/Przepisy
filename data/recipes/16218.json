    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "4 pounds beef short ribs",
    "salt and pepper to taste",
    "1 cup all-purpose flour",
    "0.5 cup olive oil",
    "2 cups chopped onions",
    "1 cup chopped celery",
    "1 cup chopped carrots",
    "2 tablespoons minced garlic",
    "1 tablespoon dried thyme",
    "3 large bay leaves",
    "1 cup red wine",
    "8 cups beef stock",
    "0.25 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_Gc_MQMtVTuECZBD5kYS9OnP6y8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16218-Smothered-Beef-Short-Ribs-ddmds-4x3-step-01-a313e459cc304ae3afc7827b8d1914f6.jpg"
      ],
      "image": "assets/images/16218/step_01.webp"
    },
    {
      "text": "Season ribs with salt and pepper, then dredge in flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GyWZcRHaa0aY95Rav5e-C-OlZRg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16218-Smothered-Beef-Short-Ribs-ddmds-4x3-step-02-a0452a9ef1274ef3b8a2c63f54f24768.jpg"
      ],
      "image": "assets/images/16218/step_02.webp"
    },
    {
      "text": "Heat oil in a large pot over medium-high heat. Sear ribs in hot oil in small batches, adding oil as needed, 2 to 3 minutes per batch. Transfer to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JrBhu-ONCCI3-T3SI90Xl1jk21g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16218-Smothered-Beef-Short-Ribs-ddmds-4x3-step-04-915e992246ec4f41b8f1ccae6442be5a.jpg"
      ],
      "image": "assets/images/16218/step_03.webp"
    },
    {
      "text": "Add onions to the pot and sauté for 2 minutes. Add celery and carrots; sauté for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ubsF8sLTg8kAlGj7N2bhphW5zSc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16218-Smothered-Beef-Short-Ribs-ddmds-4x3-step-06-db99e743950840f896164c764aa74a44.jpg"
      ],
      "image": "assets/images/16218/step_04.webp"
    },
    {
      "text": "Season with salt and pepper, then stir in garlic, thyme, and bay leaves. Cook until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hOkf8lEMNz7mHY5zXuuGPWnX-ew=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16218-Smothered-Beef-Short-Ribs-ddmds-4x3-step-07-61953d3d20934259b0bc6bcc09c14b4f.jpg"
      ],
      "image": "assets/images/16218/step_05.webp"
    },
    {
      "text": "Pour wine into the pot and bring to a boil while scraping the browned bits of food off the bottom of the pan with a wooden spoon. Add stock and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T5MJ2MFV6qKWBJbB0bxy4xRQNvs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16218-Smothered-Beef-Short-Ribs-ddmds-4x3-step-09-7c75314a54744ccd98d97af56e76d549.jpg"
      ],
      "image": "assets/images/16218/step_06.webp"
    },
    {
      "text": "Reduce the heat to low and add ribs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EIC0eiLo-BJ5HHGLhKwl8in5y0A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16218-Smothered-Beef-Short-Ribs-ddmds-4x3-step-10-1-e9782d54a37d41fbb2c81360bd34c62f.jpg"
      ],
      "image": "assets/images/16218/step_07.webp"
    },
    {
      "text": "Simmer until meat pulls away easily from the bone and sauce has thickened, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V42okmudJbCvNQbW0uq6-c9416M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16218-Smothered-Beef-Short-Ribs-ddmds-4x3-step-10-2-edb7f438e9234f71b1677037ed6a22ba.jpg"
      ],
      "image": "assets/images/16218/step_08.webp"
    },
    {
      "text": "Discard bay leaves. Stir in parsley and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kqjWtZ_nknDLtv2Y65-Ic27yES4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16218-Smothered-Beef-Short-Ribs-ddmds-4x3-step-11-b5c417f610314b269c9bd5b3e55e0ed3.jpg"
      ],
      "image": "assets/images/16218/step_09.webp"
    }
  ],
