  "ingredients": [
    "0.25 cup vegetable oil",
    "2 tablespoons vinegar",
    "2 tablespoons lime juice",
    "1.5 teaspoons ground cumin",
    "1.5 teaspoons chili powder",
    "3 cloves garlic, minced",
    "1.5 pounds beef chuck roast, trimmed and cut into 1-inch thick slices",
    "1 cup beef stock",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Whisk vegetable oil, vinegar, lime juice, cumin, chili powder, and garlic together in a bowl; pour into a resealable plastic bag. Add beef, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 4 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove bag with beef from refrigerator; bring to room temperature, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer beef and marinade to a large baking dish. Add beef stock; cover dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until beef is very tender, about 2 1/2 hours. Rest 10 minutes; shred with 2 forks. Drain and discard about 80% of liquid from beef; season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
