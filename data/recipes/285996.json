  "ingredients": [
    "cooking spray",
    "1 pound boneless, skinless chicken breast, cut in bite-sized pieces",
    "1 (14 ounce) bag frozen chopped broccoli",
    "1 (10.5 ounce) can reduced-fat condensed cream of mushroom soup",
    "0.5 cup shredded reduced-fat Cheddar cheese",
    "2 tablespoons light mayonnaise"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly coat a casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a large skillet with cooking spray and place over medium-high heat. Add chicken and cook until no longer pink in the center, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stir frozen broccoli, condensed soup, Cheddar cheese, and mayonnaise in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cooked chicken to the broccoli mixture and stir until everything is evenly coated. Pour into the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
