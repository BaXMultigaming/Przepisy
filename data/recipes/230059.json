  "ingredients": [
    "1 butternut squash, peeled and cubed",
    "2 cloves garlic, minced",
    "2 sprigs fresh rosemary, finely chopped",
    "2 tablespoons olive oil, or more to taste",
    "sea salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
