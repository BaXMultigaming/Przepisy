    "0.5 cup vegetable oil",
    "0.5 cup white vinegar",
    "1 cup white sugar",
    "1 (15 ounce) can green beans, drained",
    "1 (15 ounce) can baby peas",
    "1 (15 ounce) can white corn, drained",
