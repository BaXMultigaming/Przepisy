  "steps": [
    {
      "text": "In a saucepan over medium-high heat, bring oil, vinegar, and sugar to a boil. Reduce to a simmer, and stir until sugar is completely dissolved. Refrigerate 1 hour.",
      "section": null,
      "name": null,
      "url": null,
