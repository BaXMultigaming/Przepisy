  "ingredients": [
    "0.25 cup butter, melted",
    "2 cups pumpkin puree",
    "1.5 cups white sugar, divided",
    "1 cup evaporated milk",
    "0.5 cup all-purpose flour",
    "2 eggs, beaten",
    "1 tablespoon vanilla extract",
    "0.5 teaspoon salt",
    "1 pinch baking soda",
    "2 tablespoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 450 degrees F (230 degrees C). Pour melted butter into a 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk pumpkin, 1 cup sugar, evaporated milk, flour, eggs, vanilla extract, salt, and baking soda in a large bowl; pour into the prepared baking dish. Combine remaining 1/2 cup sugar and cinnamon in a small bowl; sprinkle over pumpkin mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center is set, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
