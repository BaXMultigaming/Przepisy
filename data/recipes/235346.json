  "ingredients": [
    "1 gallon apple juice",
    "1 gallon apple cider",
    "2 cups white sugar",
    "2 cups brown sugar",
    "4 cinnamon sticks, or more to taste",
    "1 pinch apple pie spice",
    "1 (750 milliliter) bottle 190 proof grain alcohol",
    "1 (750 milliliter) bottle vodka"
  ],
  "steps": [
    {
      "text": "Combine juice, cider, white sugar, brown sugar, cinnamon sticks, and apple pie spice in a large pot; bring to a lively simmer over medium heat. Cover, reduce heat to low, and simmer for about 1 hour. Remove from heat; cool completely.",
      "section": null,
      "name": null,
      "url": null,
