  "ingredients": [
    "2 cups white sugar",
    "0.75 cup vegetable oil",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "2 cups all-purpose flour",
    "4 cups peeled and diced apples",
    "1.5 cups chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 8x4-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, oil, eggs, vanilla, cinnamon, salt, baking soda, and baking powder together in a large mixing bowl. Stir in flour just until evenly mixed. Add apples and walnuts; stir until well blended. Pour into the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of each loaf comes out clean, 55 to 65 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
