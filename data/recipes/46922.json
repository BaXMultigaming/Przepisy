  "ingredients": [
    "1 (12 ounce) package dry penne pasta",
    "2 teaspoons olive oil",
    "1 pound mild Italian sausage",
    "1 cup chopped onion",
    "0.5 cup white wine",
    "1 (15 ounce) can tomato sauce",
    "1 (14.5 ounce) can diced tomatoes with garlic",
    "1 (6 ounce) can tomato paste",
    "2 cups shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large, deep skillet. Add sausage and onion; cook over medium-high heat until evenly brown. Drain excess fat. Pour wine into the pan and bring to a boil while scraping the browned bits of food off the bottom of the pan with a wooden spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TilO1Nwya0Wyx0gm_QDY4fTY9Io=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46922-baked-penne-with-italian-sausage-mfs-step-2-040-4x3-8141495ea0b14b5faa016c29e7e72603.jpg"
      ],
      "image": "assets/images/46922/step_03.webp"
    },
    {
      "text": "Stir in tomato sauce, diced tomatoes, and tomato paste. Simmer for 10 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GjaBEDZ2oSrxtwIM9f3P3sJT7K4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46922-baked-penne-with-italian-sausage-mfs-step-3-044-4x3-c9cfa9c2031f491a8cd025a61f3ea358.jpg"
      ],
      "image": "assets/images/46922/step_04.webp"
    },
    {
      "text": "Toss with cooked penne, and place in a 9x13-inch baking dish. Sprinkle top with mozzarella.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Mais-YdA8i40soysG-E6eFnSzSc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46922-baked-penne-with-italian-sausage-mfs-step-4-046-4x3-9516fd43f639404ab617fcb289702b00.jpg"
      ],
      "image": "assets/images/46922/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ICAQcXzZrSWXyx0fFYDqTm13njs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46922-baked-penne-with-italian-sausage-mfs-step-5-047-4x3-bd619b6f5a654406a331a09e525d0de8.jpg"
      ],
      "image": "assets/images/46922/step_06.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
