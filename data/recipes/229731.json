  "ingredients": [
    "0.25 cup melted butter",
    "3 tablespoons all-purpose flour",
    "1 teaspoon all-purpose flour",
    "3 cups cold milk",
    "0.5 teaspoon paprika",
    "0.25 teaspoon ground dried chipotle pepper",
    "0.25 teaspoon ancho chile powder",
    "0.25 teaspoon cayenne pepper",
    "salt to taste",
    "0.5 pound sharp Cheddar cheese, shredded",
    "0.25 pound Monterey Jack cheese, shredded",
    "0.25 pound Muenster cheese, shredded"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot or Dutch oven over medium heat. Sprinkle in 3 tablespoons plus 1 teaspoon flour. Whisk constantly until the mixture is thick and all the flour is incorporated, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly pour cold milk into the butter mixture, whisking constantly until combined. Simmer, stirring occasionally, until slightly thickened, about 5 minutes. Stir in paprika, ground chipotle, ancho chile powder, cayenne pepper, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low and add sharp Cheddar cheese, Monterey Jack cheese, and Muenster cheese, a handful at a time; stir until thoroughly melted. Season with salt to taste.",
      "section": null,
      "name": null,
      "url": null,
