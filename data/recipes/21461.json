  "title": "Ooey-Gooey Cinnamon Buns",
  "description": "Cinnamon buns topped with a sweet and sticky pecan glaze. Enjoy these homemade cinnamon buns when they&#39;re gooey and warm, fresh from the oven!",
  "authors": [
    "dakota kelly"
  ],
  "date_published": "2000-07-27T16:13:00-04:00",
  "date_modified": "2026-03-24T13:00:25-04:00",
  "prep_time": "PT35M",
  "cook_time": "PT25M",
