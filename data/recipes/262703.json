  "ingredients": [
    "9 tablespoons unsalted butter, cut into 1/2-inch cubes",
    "0.75 cup chopped pecans",
    "0.75 cup packed golden brown sugar",
    "1 teaspoon ground cinnamon",
    "0.75 cup all-purpose flour",
    "2 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1.5 cups white sugar",
    "0.5 cup butter, melted",
    "1 cup sour cream",
    "0.5 cup milk",
    "3 eggs, lightly beaten",
    "2 teaspoons vanilla extract",
    "2 medium Granny Smith apples, peeled, cored, and finely diced",
    "8 slices Farmland® Classic Cut Bacon, cooked, roughly chopped"
  ],
  "steps": [
    {
      "text": "Brown Butter Streusel: Cook butter in medium saucepan over medium heat until melted. Once melted, stir often until butter begins to brown and smell nutty, about 5 minutes. Remove from heat and add in pecans, sugar, cinnamon, and flour. Cool and reserve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cake: Heat oven to 350 degrees F. Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour, baking powder, baking soda, cinnamon, salt, and sugar in large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in melted butter, sour cream, milk, eggs, vanilla, and apples until smooth. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle bacon on top of batter, followed by streusel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pan in oven and bake for 30 to 45 minutes or until a toothpick inserted in the center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
