  "ingredients": [
    "12 (3 inch) unbaked tart shells",
    "0.5 cup packed brown sugar",
    "0.5 cup corn syrup",
    "3 tablespoons butter, softened",
    "1 large egg",
    "0.33333334326744 cup chopped pecans",
    "0.25 cup raisins",
    "2 tablespoons coconut",
    "1.5 teaspoons vinegar",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Place tart shells on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, corn syrup, and butter together in a bowl until creamy; beat in egg just until combined. Stir in pecans, raisins, coconut, vinegar, and salt; divide mixture evenly into tart shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is bubbly and crust is golden, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
