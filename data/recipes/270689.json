  "ingredients": [
    "0.25 cup shortening",
    "0.25 cup brown sugar",
    "0.5 cup white sugar",
    "1 egg",
    "3 tablespoons vanilla extract",
    "4 teaspoons instant coffee",
    "0.5 cup warm water",
    "1 teaspoon cocoa powder",
    "0.5 teaspoon baking soda",
    "1.3333333730698 cups all-purpose flour",
    "2 cups quick oats",
    "6 ounces white chocolate chips, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix shortening, brown sugar, white sugar, egg, vanilla extract, instant coffee, warm water, and cocoa powder together in a bowl until smooth. Add baking soda and 1/3 cup flour. Continue adding flour 1/3 cup at a time until fully incorporated. Mix in oats and chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a small cookie scoop to place 12 cookies on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Remove from the oven and let cookies sit 5 minutes. Transfer cookies to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Repeat 2 more times with remaining dough to make 36 cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
