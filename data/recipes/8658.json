  "ingredients": [
    "4 skinless, boneless chicken breasts",
    "1 teaspoon paprika",
    "salt and pepper to taste",
    "1 pinch garlic powder",
    "0.25 cup butter",
    "1 onion, sliced into thin rings",
    "1 pound fresh mushrooms, sliced"
  ],
  "steps": [
    {
      "text": "Pound chicken breasts to 1/2 inch thickness. Sprinkle both sides of each chicken breast liberally with paprika, salt, pepper, and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, melt the butter over medium heat. Arrange chicken breasts in the pan, cover, and cook for 10 minutes. Turn chicken breasts over, and layer the thinly sliced onions and mushrooms on top of the chicken. Cover, and cook for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove lid, and mix onions and mushrooms into the butter sauce. Reduce heat to low, and cook uncovered for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
