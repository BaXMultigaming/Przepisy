  "ingredients": [
    "1.5 pounds cubed beef stew meat",
    "salt and ground black pepper to taste",
    "1 onion, chopped",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "0.25 cup water",
    "1 tablespoon dried chives",
    "2 cloves garlic, minced",
    "1 tablespoon Worcestershire sauce",
    "1 cube beef bouillon",
    "0.5 cup red wine",
    "1 tablespoon cornstarch",
    "1 tablespoon all-purpose flour",
    "1 (8 ounce) container sour cream",
    "1 (8 ounce) package sliced fresh mushrooms",
    "4 ounces cream cheese",
    "0.5 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Spread beef stew meat into bottom of slow cooker crock; season with salt and pepper. Layer onion over the beef. Pour mushroom soup and water over the beef; add chives, garlic, Worcestershire sauce, and beef bouillon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0xDkzEy2EkCIBp77vHbkDMGGbWk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236867-SuperDuperSlowCookerBeefStroganoff-mfs-Step5-0082-ea0fb4c40f5b40588d3deea6f70d871f.jpg"
      ],
      "image": "assets/images/236867/step_01.webp"
    },
    {
      "text": "Whisk red wine, cornstarch, and flour together in a small bowl; pour over the mixture in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 6 to 7 hours. Stir sour cream, mushrooms, cream cheese, and parsley into the beef mixture; continue cooking for 1 hour more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VXGc2COnT4J6__uvHqUbUGfx_l0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236867-SuperDuperSlowCookerBeefStroganoff-mfs-Step6-0083-d934579c44eb48bd917d886bf21b44ce.jpg"
      ],
      "image": "assets/images/236867/step_03.webp"
    },
    {
      "text": "Serve over pasta.",
