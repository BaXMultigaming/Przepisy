  "ingredients": [
    "1 cup water",
    "1.5 teaspoons active dry yeast",
    "1 teaspoon white sugar",
    "3 cups bread flour",
    "1 tablespoon olive oil",
    "1.5 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Mix together water, yeast, and sugar in the bowl of a stand mixer until sugar is dissolved. Add bread flour, olive oil, and salt. Knead using the dough hook attachment until dough is smooth and elastic, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover dough and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Punch dough gently to deflate. Divide into 2 pieces on a lightly floured surface. Shape into balls; cover with a damp cloth and let rest, 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flatten or stretch out dough to desired thickness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
