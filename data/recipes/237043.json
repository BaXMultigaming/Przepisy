  "ingredients": [
    "1.5 cups water",
    "0.75 cup dry lentils",
    "0.5 cup grated carrots",
    "0.33333334326744 cup finely chopped onion",
    "0.5 jalapeno pepper, finely chopped",
    "2 cloves garlic, finely chopped",
    "1.5 cups panko bread crumbs",
    "3 eggs, lightly beaten",
    "2 tablespoons olive oil",
    "1 teaspoon salt",
    "0.5 teaspoon Italian seasoning"
  ],
  "steps": [
    {
      "text": "Combine water and lentils in a saucepan; bring to a boil. Reduce heat, cover saucepan, and simmer for 15 minutes. Add carrots, onion, jalapeno pepper, and garlic to lentils; cook until lentils are tender, about 15 minutes more. Remove saucepan from heat and slightly cool lentil mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease an oven-proof wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs, eggs, olive oil, salt, and Italian seasoning in a bowl; add lentil mixture and stir until well combined. Form mixture into 6 to 8 patties and place on the prepared wire rack; refrigerate for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place wire rack with patties onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until burgers are firm, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
