  "ingredients": [
    "0.667 cup milk",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon",
    "salt to taste",
    "6 thick slices bread",
    "1 tablespoon unsalted butter, or more as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, eggs, vanilla, cinnamon, and salt together in a shallow bowl until combined and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9olcwodF6AZwDD1RYMGrajZ5eFY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7016-French-Toast-I-mfs-Step3_010-7852906bc232427684444b1a745fc542.jpg"
      ],
      "image": "assets/images/7016/step_02.webp"
    },
    {
      "text": "Lightly butter a griddle or skillet and heat over medium-high heat. Soak each slice of bread in egg mixture, about 5 to 10 seconds per side, allowing it to absorb the mixture without becoming soggy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K2RBbXFkTwlmoIeX-1xpoTrOX0s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7016-French-Toast-I-mfs-Step4_013-43dad926f318487db725db1c34f16b1f.jpg"
      ],
      "image": "assets/images/7016/step_03.webp"
    },
    {
      "text": "Transfer to the hot skillet and cook until golden brown and slightly crisp, 3 to 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S6kRZyfmULofmQ2n7zJcJ8WMeVg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7016-French-Toast-I-mfs-Step5_014-deb93811c03f4c1ebeb8d1efa8df5fcd.jpg"
      ],
      "image": "assets/images/7016/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy with butter and syrup.",
      "section": null,
      "name": null,
      "url": null,
