  "ingredients": [
    "0.25 cup butter",
    "0.25 cup sliced onion",
    "0.25 cup sliced carrots",
    "0.25 cup chopped celery",
    "0.25 cup chopped green bell pepper",
    "1 apple - peeled, cored and sliced",
    "1 cup chopped chicken breast meat",
    "0.25 cup all-purpose flour",
    "1 teaspoon curry powder",
    "0.25 teaspoon chopped fresh mace",
    "4 whole cloves",
    "1 tablespoon chopped fresh parsley",
    "1 cup stewed tomatoes",
    "salt and pepper to taste",
    "1 cup cooked white rice",
    "5 cups beef stock"
  ],
  "steps": [
    {
      "text": "Melt butter in large saucepan. Add onion, carrot, celery, pepper, apple, and chicken. Cook until browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour, curry powder, mace, cloves, parsley, and tomatoes. Cover, and simmer over low heat 1 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Take chicken out, set aside, and strain vegetables from broth. Return chicken to pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a food mill, puree vegetables. Return to soup. Season to taste with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cooked rice and boiling stock. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
