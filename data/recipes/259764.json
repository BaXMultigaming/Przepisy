  "ingredients": [
    "1 cup cornstarch",
    "0.5 cup millet flour",
    "0.5 cup tapioca starch",
    "0.25 cup sweet rice flour",
    "0.25 cup teff flour",
    "0.25 cup ground flax",
    "2 tablespoons psyllium husk",
    "2.5 teaspoons guar gum",
    "2 large eggs",
    "1.6666667461395 cups warm water",
    "3 tablespoons canola oil",
    "1 teaspoon white vinegar",
    "2.75 teaspoons active dry yeast",
    "1.5 teaspoons salt",
    "0.5 cup milk powder",
    "3 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Mix cornstarch, millet flour, tapioca flour, rice flour, teff flour, ground flax, psyllium husk, and guar gum in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place eggs, warm water, canola oil, vinegar, sugar, yeast, cornstarch mixture, salt, and milk in a bread machine pan in the order listed, or in the order listed by the manufacturer. Stir gently with a wooden spoon to combine yeast with the rest of the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Run \"rapid bake\" cycle for 2 hours. Select \"dark\" crust setting; bake for 50 minutes.",
