  "ingredients": [
    "3 pounds potatoes, diced",
    "2 tablespoons butter, melted",
    "2 cups chicken stock",
    "2 (8 ounce) packages cream cheese, cubed",
    "4 ounces mozzarella cheese, finely chopped",
    "1 small onion, finely chopped",
    "0.66666668653488 cup sour cream",
    "0.33333334326744 cup powdered milk",
    "2 tablespoons finely chopped fresh chives",
    "1 teaspoon finely chopped fresh tarragon",
    "1 teaspoon sea salt",
    "0.5 teaspoon finely chopped fresh sage",
    "0.25 teaspoon ground black pepper",
    "6 eggs, beaten"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine potatoes and butter in a large bowl; stir to coat. Add chicken stock, cream cheese, mozzarella cheese, onion, sour cream, powdered milk, chives, tarragon, sea salt, sage, and black pepper; stir well. Fold in egg until well incorporated. Pour into a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and eggs are set, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
