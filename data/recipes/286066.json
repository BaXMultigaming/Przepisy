  "ingredients": [
    "1 slice bacon",
    "1 cup chopped romaine lettuce",
    "0.5 cup cooked, shredded chicken",
    "0.25 cup croutons",
    "1 tablespoon Caesar's Salad Dressing",
    "1 tablespoon grated Parmesan cheese",
    "1 large flour tortilla"
  ],
  "steps": [
    {
      "text": "Place bacon slice in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slice on paper towels, cool slightly, and crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bacon, lettuce, shredded chicken, croutons, dressing, and Parmesan cheese for the filling a a bowl. Toss gently to combine and everything is evenly coated with dressing. Adjust dressing amount to your personal preference - for me 1 to 1 1/2 tablespoons is about right.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm tortilla in the microwave for about 15 seconds to make it more pliable.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay filling ingredients down the center, and roll your wrap up! Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
