  "ingredients": [
    "1 pound ground beef",
    "2 cups ketchup",
    "1 large onion, diced",
    "1 (6 ounce) package dry bread stuffing mix",
    "1 large egg",
    "0.5 cup ketchup",
    "1 teaspoon mustard powder",
    "1 tablespoon brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beef, 2 cups ketchup, onion, stuffing mix, and egg in a large bowl using your hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1/2 cup ketchup and mustard powder in a small bowl until glaze is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer beef mixture to the greased loaf pan. Brush the top with the glaze mixture. Sprinkle brown sugar on top of the glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until no longer pink in the center, 35 to 40 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
