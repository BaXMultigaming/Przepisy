  "ingredients": [
    "0.5 cup butter",
    "3 (1 ounce) squares unsweetened chocolate",
    "2 cups white sugar",
    "2 eggs",
    "1 cup water",
    "2.25 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "0.25 teaspoon salt",
    "0.25 cup milk",
    "1 teaspoon distilled white vinegar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease and flour two 9-inch round pans or one 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small pan, melt butter or margarine with unsweetened chocolate. Set aside to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together sugar and eggs until light in color. Add chocolate mixture to eggs and temper mixture by beating well. Add 1 cup boiled water (still warm) and blend well. Mixture will be very liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, baking soda, and salt. Add this mixture to chocolate mixture and blend well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together vinegar and the milk and stir into chocolate batter. Pour into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
