  "ingredients": [
    "2 pounds small potatoes, scrubbed",
    "1 teaspoon butter",
    "3 tablespoons butter, melted",
    "1 teaspoon coarse salt, or to taste",
    "5 tablespoons finely chopped fresh chervil",
    "2 bunches fresh chives, finely chopped",
    "1.25 cups shredded Gruyere cheese"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a baking dish with 1 teaspoon butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel potatoes and cut in half lengthwise. Place in the prepared baking dish. Drizzle with melted butter and season with coarse salt. Sprinkle with chervil and chives. Cover with Gruyere cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and lightly browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
