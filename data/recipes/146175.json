  "ingredients": [
    "2 cups all-purpose flour",
    "0.75 cup unsalted butter",
    "0.5 cup packed light brown sugar",
    "0.5 teaspoon salt",
    "2 (8 ounce) packages cream cheese, softened",
    "1 cup white sugar",
    "3 eggs",
    "1 pint sour cream",
    "zest from 1 lemon",
    "1 teaspoon vanilla extract",
    "1 quart blueberries",
    "3 tablespoons cornstarch"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, butter, brown sugar, and salt in the bowl of a food processor; pulse until begins to form small lumps. Press mixture into the bottom of a 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 20 minutes; remove from oven. Reduce heat to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and 1 cup white sugar in a bowl with an electric mixer until soft and creamy. Beat in eggs, one at a time, until smooth. Gradually beat in sour cream, lemon zest, and vanilla; pour mixture over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm to the touch, 45 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine blueberries, remaining 1 cup sugar, and cornstarch in a large saucepan over medium heat; cook until thickened. Cool topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cooled blueberry topping over cheesecake; chill in the refrigerator, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
