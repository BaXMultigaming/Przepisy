  "ingredients": [
    "3 sweet potatoes",
    "2 bananas",
    "0.5 cup white sugar",
    "0.75 cup packed brown sugar",
    "0.5 cup chopped pecans",
    "0.25 cup evaporated milk",
    "1 teaspoon butter",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 cup shredded coconut",
    "1.5 cups miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Grease one 8x12 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a pot of salted water to a boil. Add potatoes; cook until tender but still firm. Drain, and transfer to a large bowl to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, combine sweet potatoes, bananas, white sugar, brown sugar, pecans, evaporated milk, butter, vanilla, cinnamon and nutmeg. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into baking dish, place coconut on top of potato mixture and top with marshmallows. Bake for 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
