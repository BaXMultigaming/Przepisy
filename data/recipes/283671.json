  "title": "Healthy Strawberry Rhubarb Bread",
  "description": "This strawberry rhubarb bread is made with unsweetened vanilla almond milk, whole wheat flour, coconut oil, and cane sugar to make it healthier.",
  "authors": [
    "Almond Breeze"
  ],
  "date_published": "2021-03-18T19:42:03-04:00",
