  "ingredients": [
    "1.5 cups whole wheat pastry flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.25 cup Unsweetened Vanilla Almond Breeze Almondmilk",
    "2 large eggs",
    "0.75 cup organic cane sugar",
    "3 tablespoons coconut oil, melted",
    "1.25 cups sliced fresh strawberries",
    "0.75 cup chopped rhubarb"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk the flour, baking soda, salt, and nutmeg together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, whisk together the Almond Breeze (either unsweetened vanilla almond milk or unsweetened vanilla almond cashew milk for extra creaminess), eggs, sugar, and coconut oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the strawberries and rhubarb into the batter. Pour batter into a greased loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 40 to 50 minutes, until a toothpick inserted in the center of the bread comes out clean. Cool for 10 to 15 minutes, then remove from the pan and allow to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
