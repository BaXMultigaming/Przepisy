  "ingredients": [
    "4 medium baking potatoes",
    "1 teaspoon salt",
    "3 tablespoons salt-free herb seasoning blend",
    "3 tablespoons butter, melted",
    "6 tablespoons grated Cheddar cheese",
    "1.5 tablespoons Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice potatoes crosswise (the short way) into 1/4-inch slices, leaving about 1/4 inch on the bottom to connect all slices. Place into a baking dish, and slightly fan slices open. Sprinkle with salt and seasoning blend, and drizzle with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 50 minutes in the preheated oven. Sprinkle cheeses over top, and bake for another 10 minutes, or until the cheese has melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
