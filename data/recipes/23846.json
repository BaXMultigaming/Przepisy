  "title": "Cold Macaroni and Tuna Salad",
  "description": "Macaroni, diced hard-boiled eggs, peas, and tuna are tossed together in a satisfying mayonnaise dressing.",
  "authors": [
    "trvlnbarefootingal"
  ],
  "date_published": "2018-06-08T09:15:08-04:00",
