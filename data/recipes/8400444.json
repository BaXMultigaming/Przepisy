  "ingredients": [
    "0.5 cup fresh parsley",
    "0.25 cup toasted pine nuts",
    "0.25 cup freshly grated Parmesan cheese, or more to taste",
    "3 sprigs fresh dill",
    "1 large clove garlic",
    "3 tablespoons olive oil, divided, or as needed",
    "0.25 medium lemon, or to taste",
    "0.125 teaspoon salt, or to taste",
    "0.125 teaspoon ground black pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Combine parsley, pine nuts, Parmesan cheese, dill, and garlic in the bowl of a food processor; pulse until combined, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 1 tablespoon olive oil, small squirt lemon juice, ⅛ teaspoon salt, and ⅛ teaspoon black pepper; pulse.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 1 tablespoon olive oil; pulse. Continue adding olive oil, lemon juice, salt, and black pepper until pesto reaches desired flavor and consistency.",
      "section": null,
