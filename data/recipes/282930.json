  "ingredients": [
    "1 tablespoon salted butter",
    "3 tablespoons finely ground almond flour",
    "1 tablespoon shredded Cheddar cheese",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon baking powder",
    "1 large egg, lightly beaten"
  ],
  "steps": [
    {
      "text": "Microwave butter in a 4-inch ramekin on high until melted, about 25 seconds. Carefully remove from microwave with a pot holder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in almond flour, Cheddar cheese, onion powder, and baking powder until combined. Stir in egg until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on high until set, about 90 seconds. Remove from microwave; let stand for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Run a butter knife around edges; invert onto a plate. Cut horizontally to make 2 slices bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
