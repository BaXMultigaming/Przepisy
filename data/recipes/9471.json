  "ingredients": [
    "1.75 cups all-purpose flour",
    "0.5 teaspoon salt",
    "1 teaspoon baking soda",
    "0.5 cup butter, softened",
    "0.5 cup white sugar",
    "0.5 cup peanut butter",
    "0.5 cup packed brown sugar",
    "1 egg, beaten",
    "1 teaspoon vanilla extract",
    "2 tablespoons milk",
    "40 miniature chocolate covered peanut butter cups, unwrapped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Sift flour, salt, and baking soda together in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, sugar, peanut butter, and brown sugar together in a separate bowl until fluffy. Beat in egg, vanilla, and milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NvD3HMU2L5LW2pAoLlBRm8ErSN0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9471-PeanutButterCupCookies-mfs-step1-1292-76714be133344e509a22ab32be217796.jpg"
      ],
      "image": "assets/images/9471/step_02.webp"
    },
    {
      "text": "Add flour mixture; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BZW0NBd7-9HLEEW3AgYhzta_zR0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9471-PeanutButterCupCookies-mfs-step2-1296-97baa8dcad5e48499b85eb6f006ba242.jpg"
      ],
      "image": "assets/images/9471/step_03.webp"
    },
    {
      "text": "Shape into 40 balls and place each into an ungreased mini muffin pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-Wvoxg5UFyGiTi6GUgEG8FgipAw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9471-PeanutButterCupCookies-mfs-step3-1301-85d18c31ae5e46c2b4bc39b1b50469a3.jpg"
      ],
      "image": "assets/images/9471/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven and immediately press a mini peanut butter cup into each ball. Let cookies cool before carefully removing them from the pan.",
