  "ingredients": [
    "2 teaspoons unsalted butter",
    "2 teaspoons minced fresh ginger",
    "1 clove garlic, minced",
    "1 (3 inch) cinnamon stick",
    "1 cup uncooked jasmine rice",
    "0.75 cup water",
    "0.75 cup light coconut milk",
    "1 teaspoon white sugar",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon grated lime zest",
    "0.125 teaspoon ground white pepper",
    "0.25 cup shredded unsweetened coconut, toasted"
  ],
  "steps": [
    {
      "text": "Melt butter in saucepan over medium heat. Add ginger, garlic, and cinnamon stick; sauté until fragrant, about 1 minute. Stir in rice; sauté until rice grains are opaque, about 2 minutes. Stir in water, coconut milk, sugar, salt, lime zest, and white pepper; bring to a simmer. Stir once, cover, reduce heat to low, and simmer for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fluff rice with a fork, cover, and let rest for 5 minutes. Garnish servings with toasted coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
