  "ingredients": [
    "1 small red onion, halved and sliced into thin half-moons",
    "2 tablespoons lime juice, or more to taste",
    "2 tablespoons extra-virgin olive oil",
    "1 seedless watermelon, cut into cubes",
    "3 baby cucumbers, seeded and cut into cubes",
    "1 cup crumbled feta cheese",
    "0.5 cup mint leaves, sliced thinly"
  ],
  "steps": [
    {
      "text": "Mix red onion with lime juice in a bowl; set aside to marinate at least 10 minutes. Stir olive oil into mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss watermelon, baby cucumbers, and feta cheese together in a large bowl. Pour red onion mixture over watermelon mixture; toss to coat. Sprinkle mint over the salad; toss and serve.",
      "section": null,
