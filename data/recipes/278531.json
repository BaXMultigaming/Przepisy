  "ingredients": [
    "1 drizzle olive oil",
    "1 small sweet onion, diced",
    "3 pounds lean ground beef",
    "1.25 cups ketchup",
    "0.25 cup prepared yellow mustard",
    "0.25 cup white vinegar",
    "0.25 cup brown sugar",
    "1 tablespoon Worcestershire sauce",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "salt and ground black pepper to taste",
    "10 hamburger buns, split"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pan, skillet, or Dutch oven over medium-high heat. Saute onion in the hot oil until softened, about 5 minutes. Add beef; cook and stir until browned and crumbly, 5 to 7 minutes. Drain off any excess fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir ketchup, mustard, vinegar, brown sugar, Worcestershire sauce, garlic powder, onion powder, salt, and pepper into the pan; mix until thoroughly combined. Let simmer over low heat, 15 to 20 minutes. Adjust salt and pepper to your liking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve on hamburger buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
