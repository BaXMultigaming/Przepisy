  "ingredients": [
    "2 cloves garlic, sliced",
    "1 pinch kosher salt",
    "1 tablespoon chopped fresh tarragon",
    "0.5 cup mayonnaise",
    "2 teaspoons fresh lemon juice",
    "1 pinch cayenne pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Crush garlic and salt together in a mortar with a pestle; add tarragon and continue crushing with the pestle until tarragon is pulverized.",
