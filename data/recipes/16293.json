  "ingredients": [
    "0.5 cup ketchup",
    "0.33333334326744 cup brown sugar",
    "0.25 cup lemon juice, divided",
    "1 teaspoon mustard powder",
    "2 pounds ground beef",
    "3 slices bread, broken up into small pieces",
    "0.25 cup chopped onion",
    "1 large egg, beaten",
    "1 teaspoon beef bouillon granules"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ketchup, brown sugar, 1 tablespoon lemon juice, and mustard powder in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, bread, onion, egg, bouillon, and remaining lemon juice in a separate large bowl. Add in 1/3 of the ketchup mixture from the small bowl. Mix well and place in a 5x9-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Drain any excess fat, coat with remaining ketchup mixture, and bake for 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
