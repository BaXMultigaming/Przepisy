  "ingredients": [
    "0.5 cup butter",
    "0.25 cup white sugar",
    "2 (16 ounce) packages frozen corn kernels, thawed",
    "1 (8 ounce) package cream cheese, cubed",
    "1 cup fine dry bread crumbs",
    "3 tablespoons butter, diced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over medium low heat. Mix in sugar and stir until dissolved. Mix in corn and stir to coat. Stir in cream cheese and cook until melted and well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the mixture to the prepared baking dish. Top with bread crumbs and dot with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 20 to 30 minutes, until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
