  "ingredients": [
    "3 tablespoons sour cream",
    "0.5 tablespoon fresh squeezed lemon juice",
    "2 teaspoons Dijon mustard",
    "2 teaspoons cream cheese, softened",
    "0.25 teaspoon salt",
    "0.125 teaspoon pepper",
    "0.125 teaspoon garlic powder",
    "2 cups diced rotisserie chicken meat",
    "0.25 cup finely chopped celery",
    "2 tablespoons finely chopped red onion"
  ],
  "steps": [
    {
      "text": "Combine sour cream, lemon juice, Dijon mustard, cream cheese, salt, pepper, and garlic powder in a bowl; whisk until smooth. Add chicken, celery, and red onion and mix thoroughly. Cover and refrigerate for 1 hour to let flavors blend.",
