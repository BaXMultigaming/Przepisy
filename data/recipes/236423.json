  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup quick cooking oats",
    "1.5 teaspoons baking powder",
    "1 teaspoon ground ginger",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon grated nutmeg",
    "0.5 teaspoon ground cloves",
    "1 cup plain yogurt",
    "1 cup chopped pitted prunes",
    "0.5 cup white sugar",
    "2 eggs, beaten",
    "1 teaspoon maple syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5x3-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, oats, baking powder, ground ginger, baking soda, nutmeg, and cloves together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk yogurt, prunes, sugar, and eggs together in a large bowl; stir in flour mixture. Fold maple syrup into batter; pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 40 minutes. Cool in the pan for 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
