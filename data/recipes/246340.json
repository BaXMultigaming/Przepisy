  "ingredients": [
    "1 cup butter, divided",
    "1 onion, chopped",
    "2.5 cups water, divided",
    "1 (6 ounce) can tomato paste",
    "0.75 cup berbere seasoning",
    "1 teaspoon chopped garlic",
    "0.5 teaspoon ground ginger",
    "4 skinless, boneless chicken breasts, cubed",
    "0.33333334326744 cup sweet white wine",
    "0.5 teaspoon ground cardamom",
    "0.5 teaspoon freshly ground black pepper",
    "4 hard-boiled eggs"
  ],
  "steps": [
    {
      "text": "Melt 1/2 cup butter in a skillet over medium-low heat. Add onion; cook and stir until translucent, 5 to 6 minutes. Add 1/2 cup water and tomato paste; stir until hot, about 2 minutes. Stir in berbere, remaining 1/2 cup butter, garlic, and ginger. Reduce heat to low; cook until mixture thickens to a paste consistency, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir remaining 2 cups water into berbere paste; add chicken. Simmer until thickened to sauce consistency, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir wine, cardamom, and black pepper into sauce; add hard-cooked eggs. Cook until sauce is slightly reduced, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
