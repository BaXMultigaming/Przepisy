  "ingredients": [
    "3 cups rolled oats",
    "1 cup brown sugar",
    "2 teaspoons ground cinnamon",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "2 eggs",
    "1 cup milk",
    "0.5 cup melted butter",
    "2 teaspoons vanilla extract",
    "0.75 cup dried cranberries"
  ],
  "steps": [
