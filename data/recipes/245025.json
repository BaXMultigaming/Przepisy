  "ingredients": [
    "2 teaspoons oil",
    "1 shallot, chopped",
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "1 cup light cream",
    "1 pinch salt",
    "1 pinch ground cinnamon",
    "1 cup pumpkin puree",
    "1 cup chicken broth, or more as needed",
    "1 tablespoon finely chopped fresh sage",
    "1.5 teaspoons chopped fresh thyme"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Add shallot; cook and stir until soft, about 10 minutes. Add butter; stir until melted. Whisk in flour until incorporated. Whisk in cream, salt, and cinnamon until incorporated, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk pumpkin and ½ cup chicken broth into cream mixture, adding more broth, ¼ cup at a time, until reaches desired consistency. Simmer sauce until reaches desired consistency, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sage and thyme into sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
