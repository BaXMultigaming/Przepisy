  "ingredients": [
    "0.25 cup olive oil",
    "0.5 white onion, chopped",
    "1 tomato, chopped",
    "6 basil leaves, chopped",
    "4 cloves garlic, minced",
    "1 (20 ounce) package ground turkey",
    "1 teaspoon Italian seasoning",
    "0.25 teaspoon oregano",
    "2 (15 ounce) cans tomato sauce",
    "0.5 (6 ounce) can tomato paste, or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large pot over medium-high heat. Add onion, tomato, basil, and garlic; sauté until onion begins to soften, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Break ground turkey into small pieces and add to the pot; season with Italian seasoning and oregano. Cook and stir until turkey is completely browned, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomato sauce and bring to a boil. Reduce the heat to low and simmer until sauce has thickened slightly, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomato paste until mixture is evenly colored; season with salt and pepper. Cook for 1 to 2 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
