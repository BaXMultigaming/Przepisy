  "ingredients": [
    "2 tablespoons extra virgin olive oil",
    "1 pound chicken tenders, cut into strips",
    "1 cup chopped onions",
    "1 cup sliced red pepper (1/4-inch x 1 1/2 inch)",
    "1 teaspoon minced fresh garlic",
    "2 cups water",
    "1 (14.5 ounce) can diced tomatoes",
    "1 cup UNCLE BEN'S® Flavor Infusions Chicken & Herb Rice",
    "0.5 cup chiffonade fresh basil leaves",
    "0.25 cup shredded Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Heat olive oil in large skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken strips and cook until they are just done (4 to 6 minutes).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion, red pepper slices, and fresh garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue cooking, stirring occasionally, until vegetables barely tender (4 to 5 minutes).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add water, tomatoes, and rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover pan and continue cooking until mixture just comes to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium low and continue cooking until rice is tender or liquid is absorbed (about 10 minutes).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cover; stir in basil leaves and Parmesan cheese. Refrigerate leftovers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
