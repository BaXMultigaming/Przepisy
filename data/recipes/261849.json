  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 cup butter",
    "0.5 cup packed brown sugar",
    "0.25 teaspoon salt",
    "1 (12 ounce) package semisweet chocolate chips",
    "2 eggs",
    "1.5 cups shredded sweetened coconut",
    "2 tablespoons all-purpose flour",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the crust, mix flour, butter, brown sugar, and salt together in a bowl using a pastry blender until crumbly. Pat crust mixture into a 9x13-inch baking pan. Bake in the preheated oven until set, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle chocolate chips over crust and return to the hot oven until chips are softened, about 1 minute. Remove from oven and gently spread softened chocolate over the crust. Leave oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the filling, beat eggs in a bowl until light and frothy. Add shredded coconut, flour, vanilla, baking powder, and salt. Spread mixture over chocolate-covered crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven until light golden and center is set, 15 to 20 minutes. Cool completely, at least 1 hour. Cut into 1x3-inch bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
