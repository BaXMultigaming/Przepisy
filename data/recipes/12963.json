  "ingredients": [
    "8 cups chicken broth",
    "0.5 cup fresh lemon juice",
    "0.5 cup shredded carrots",
    "0.5 cup finely chopped onion",
    "0.5 cup finely chopped celery",
    "6 tablespoons chicken soup base",
    "0.25 teaspoon ground white pepper",
    "0.25 cup margarine",
    "0.25 cup all-purpose flour",
    "8 egg yolks",
    "1 cup cooked white rice",
    "1 cup diced, cooked chicken meat",
    "16 slices lemon"
  ],
  "steps": [
    {
      "text": "Combine chicken broth, lemon juice, carrots, onions, celery, soup base, and white pepper in a large pot. Bring to a boil over high heat, then reduce heat and simmer for 15 to 20 minutes, or until the vegetables are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w7cOWsGQA9n73ahhFjsTrOKikL4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12963-greek-lemon-chicken-soup-PICS-step-01-51e319e526f24679abc268b82b6ab290.jpg"
      ],
      "image": "assets/images/12963/step_01.webp"
    },
    {
      "text": "Blend butter and flour in a small bowl; gradually stir into soup mixture. Simmer, stirring frequently, for 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EISDkgNqdBVcfF52KuTB3MtpSbQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12963-greek-lemon-chicken-soup-PICS-step-02-6406249ed11f4d0ea2cb0e4a332f92ea.jpg"
      ],
      "image": "assets/images/12963/step_02.webp"
    },
    {
      "text": "Meanwhile, beat egg yolks in a bowl until light in color. Gradually whisk in some hot soup, using a ladle to pour in a thin stream while whisking the egg yolks vigorously. Add egg mixture to the pot in same manner, and heat through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qfW8f4c0qI_yIspptEy8DD08eLA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12963-greek-lemon-chicken-soup-PICS-step-03-0d0b1d3055724bb4a9ef2db08a4978e8.jpg"
      ],
      "image": "assets/images/12963/step_03.webp"
    },
    {
      "text": "Add rice and chicken; cook until warmed through. Ladle hot soup into bowls and garnish with lemon slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MmC-q7rCrD5oexv1gqgErerTyNM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12963-greek-lemon-chicken-soup-PICS-step-04-2adf572f37444e039c6bfd7dbd94d5a2.jpg"
      ],
