  "ingredients": [
    "0.5 cup white sugar",
    "0.5 cup butter",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon baking powder",
    "0.5 teaspoon lemon zest",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Beat 1 cup sugar and butter in a large bowl with an electric mixer until smooth. Beat in egg and vanilla extract until completely blended. Beat in flour, 1 1/2 teaspoons cinnamon, baking powder, lemon zest, and salt until flour is just incorporated. Cover bowl with plastic wrap; refrigerate until firm, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1/2 cup sugar and remaining 1 tablespoon cinnamon in a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop and form dough into about 60 small balls; roll in cinnamon-sugar mixture to coat. Arrange on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
