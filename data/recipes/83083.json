  "ingredients": [
    "0.25 cup all-purpose flour",
    "1 teaspoon ground cumin",
    "0.25 teaspoon cayenne pepper",
    "0.75 teaspoon salt, divided",
    "2 tablespoons vegetable oil",
    "4 boneless pork chops, about 3/4-inch thick",
    "0.33333331346512 cup chicken broth",
    "0.5 cup coconut milk",
    "2 tablespoons peanut butter",
    "1 tablespoon honey",
    "1 teaspoon ground ginger",
    "0.25 cup chopped green onion",
    "0.25 cup sliced red bell pepper",
    "0.25 cup coarsely chopped dry roasted peanuts",
    "0.25 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "On a plate, combine flour, cumin, cayenne pepper, and 1/2 teaspoon of salt. Stir to distribute the spices. Coat pork chops with flour mixture, and shake off any excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Place pork chops in the hot skillet, and fry for about 4 minutes per side, until cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the pork chops cook, stir together chicken broth, coconut milk, peanut butter, honey, ginger, and 1/4 teaspoon of salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pork chops to a serving platter, and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour peanut sauce into the skillet. Cook, stirring constantly, for 2 minutes, or until thickened. Pour peanut sauce over chops, and garnish with green onion, bell pepper, peanuts, and cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
