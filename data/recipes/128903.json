  "ingredients": [
    "1 (1 pound) loaf sourdough bread, cut into 1/2-inch cubes",
    "1.5 cups dried cranberries",
    "1.5 cups golden raisins",
    "1 cup chopped walnuts, toasted",
    "2 tablespoons brown sugar",
    "0.5 cup butter, melted",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the bread, cranberries, raisins, and walnuts in a large bowl. Whisk together the brown sugar and butter in a separate bowl; season with cinnamon, nutmeg, and salt; stir into the bread cubes until evenly distributed. Spread the mixture into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crisp on top, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
