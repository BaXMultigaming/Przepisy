  "title": "Kabob Koobideh (Persian Ground Meat Kabobs)",
  "description": "A mixture of ground beef and lamb is loaded with incredible flavor from grated onions, turmeric, and sumac in these tasty grilled Persian kabobs.",
  "authors": [
    "Nick Perry"
  ],
  "date_published": "2020-03-23T15:58:29-04:00",
