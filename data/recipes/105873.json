  "ingredients": [
    "2 small cucumbers, thinly sliced",
    "0.5 small red onion, thinly sliced",
    "1 large tomato, halved and sliced",
    "3 tablespoons mayonnaise",
    "1 tablespoon white vinegar",
    "0.25 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "In a medium bowl, toss together cucumbers, red onion, and tomato. Gently stir in mayonnaise, vinegar, salt, and pepper until coated. Cover and refrigerate for at least 1 hour before serving.",
