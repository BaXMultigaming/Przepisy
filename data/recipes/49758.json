  "ingredients": [
    "0.5 onion, chopped",
    "2 cloves garlic, crushed",
    "1 cup barbecue sauce",
    "0.25 cup gin",
    "1 tablespoon dry vermouth",
    "1 tablespoon green olive brine",
    "1 teaspoon dried basil",
    "4 (1/2 pound) beef sirloin steaks",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a medium bowl, combine onion, garlic, barbecue sauce, gin, vermouth, olive brine, and basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle each steak with salt and pepper, and place in resealable sandwich bags. Divide marinade between each bag, and seal. Ensure that marinade is evenly distributed around steaks. Refrigerate for 2 to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat grill for medium-high heat, and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove steaks from bags, and discard marinade. Grill steaks for 7 to 8 minutes per side, or to desired doneness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
