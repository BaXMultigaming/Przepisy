  "ingredients": [
    "5 Hatch chile peppers",
    "1.5 tablespoons butter",
    "1 onion, cut into strips",
    "1 cup frozen corn",
    "0.75 tablespoon chicken bouillon granules",
    "0.25 teaspoon ground black pepper",
    "1.5 cups shredded rotisserie chicken",
    "1 cup Mexican crema"
  ],
  "steps": [
    {
      "text": "Place Hatch chiles directly on grates of a gas stove; cook over medium heat, flipping with tongs occasionally, until blackened and charred, about 5 minutes. Place blackened chiles in a resealable plastic bag, seal, and cool for 7 to 8 minutes. Remove and discard skins and seeds; cut flesh into 1-inch squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large sauté pan over medium heat. Add onion; cook until translucent, about 5 minutes. Stir in corn, chiles, bouillon granules, and black pepper until well combined. Stir in chicken and crema; simmer until heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
