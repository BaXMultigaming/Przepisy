  "ingredients": [
    "1 firm peach, halved and pitted",
    "1 teaspoon canola oil",
    "2 tablespoons brown sugar",
    "4 scoops vanilla fat-free frozen yogurt",
    "2 gingersnap cookies, crumbled"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush peach halves with canola oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until tender and warmed through, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place each peach half on a plate, skin-sides down. Sprinkle with brown sugar, allowing sugar to melt. Alternatively, use a small torch to caramelize sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve each peach half with 2 scoops frozen yogurt; sprinkle cookie crumbles on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
