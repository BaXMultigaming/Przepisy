  "ingredients": [
    "2 pounds new potatoes",
    "2 tablespoons water",
    "1 onion, minced",
    "2 tablespoons olive oil",
    "1 pinch seasoned salt, or to taste",
    "1 pinch paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Place new potatoes and water in a microwave-safe bowl. Cover and heat on high in a microwave until soft enough to smash, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor skillet for high heat and lightly oil the grate. Place a cast-iron skillet on the grill to preheat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain water from the potato bowl and add onion and olive oil; mix well. Carefully spread potato mixture into the skillet and smash each potato using the back of a spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill until onions are browned and potatoes are crispy, about 5 minutes per side. Season with seasoned salt and paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
