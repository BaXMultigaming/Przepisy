  "ingredients": [
    "4 tablespoons vegetable oil, divided",
    "2 teaspoons chopped fresh ginger root, divided",
    "1.5 cloves garlic, crushed",
    "1 tablespoon cornstarch",
    "1 small head broccoli, cut into florets",
    "0.75 cup julienned carrots",
    "0.5 cup snow peas",
    "0.5 cup halved green beans",
    "2.5 tablespoons water",
    "2 tablespoons soy sauce",
    "0.25 cup chopped onion",
    "0.5 tablespoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qoTz9nAUo1YovCX1ACBsx-ZO-x8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24712-ginger-veggie-stir-fry-step1-218-e1295058ba2c4398a14ed181a1e595e0.jpg"
      ],
      "image": "assets/images/24712/step_01.webp"
    },
    {
      "text": "Place 2 tablespoons vegetable oil, 1 teaspoon ginger, garlic, and cornstarch in a large bowl; mix until cornstarch is dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b1Xd0Mf1druwGd7HORT3XPiIEaE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24712-ginger-veggie-stir-fry-step2-221-167fc80fe3e2416691ed235a6ccbff38.jpg"
      ],
      "image": "assets/images/24712/step_02.webp"
    },
    {
      "text": "Add broccoli, carrots, snow peas, and green beans; toss lightly to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oAkeAWPhqEFOECnFBSRnXyvNZjo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24712-ginger-veggie-stir-fry-step3-223-fe3ef780bd4d46d293490b3ebf2b8c16.jpg"
      ],
      "image": "assets/images/24712/step_03.webp"
    },
    {
      "text": "Heat remaining 2 tablespoons vegetable oil in a large skillet or wok over medium heat. Add vegetable mixture and cook for 2 minutes, stirring constantly to prevent burning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NXE3bVE7uBtksm9aNSvrgcK6Pko=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24712-ginger-veggie-stir-fry-step4-226-cd5fe2e5f4ea439da75860a86e2be9e4.jpg"
      ],
      "image": "assets/images/24712/step_04.webp"
    },
    {
      "text": "Stir in water and soy sauce; add onion, salt, and remaining 1 teaspoon ginger. Cook and stir until vegetables are tender but crisp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3J36RfsXfkp-JLfHu6lCsMhaKF0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24712-ginger-veggie-stir-fry-step5-230-10ce757545704b569dd9a946113bad1e.jpg"
      ],
      "image": "assets/images/24712/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
