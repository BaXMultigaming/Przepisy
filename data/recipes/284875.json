  "ingredients": [
    "1 teaspoon ground paprika",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 (4 ounce) fillet flounder",
    "0.25 cup cubed fresh mango",
    "0.25 cup cubed fresh pineapple",
    "2 tablespoons diced red onion",
    "2 tablespoons diced yellow bell pepper",
    "1 teaspoon apple cider vinegar",
    "1 teaspoon chili-lime seasoning (such as Tajin®)",
    "1 tablespoon Greek yogurt",
    "1 teaspoon lime juice",
    "0.25 teaspoon hot sauce",
    "cooking spray",
    "1 cup hot cooked rice",
    "1 tablespoon sliced green onion"
  ],
  "steps": [
    {
      "text": "Mix paprika, salt, and pepper together in a small bowl. Rub spice mix onto flounder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mango, pineapple, red onion, bell pepper, vinegar, and chili-lime seasoning in a bowl until combined. Mix yogurt, lime juice, and hot sauce together in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a pan with cooking spray and heat over medium-high heat. Place flounder in the pan and cook, without turning, until blackened, about 4 minutes. Flip, and cook until the other side is blackened, about 3 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flounder on top of hot rice. Top with mango slaw and drizzle lime crema sauce over top. Garnish with green onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
