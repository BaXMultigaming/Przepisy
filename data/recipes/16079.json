  "ingredients": [
    "0.66666668653488 cup cornstarch",
    "2 cups milk",
    "0.5 cup ground almonds",
    "6 whole cardamom seeds",
    "0.25 cup white sugar, or to taste",
    "rosewater to taste",
    "0.25 cup blanched slivered almonds"
  ],
  "steps": [
    {
      "text": "Dissolve cornstarch in 1 cup milk in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1 cup milk, ground almonds, and cardamom seeds in a saucepan; bring to a boil. Reduce heat to medium; whisk in cornstarch mixture until well blended. Stir in sugar and rosewater until incorporated. Bring to a boil, stirring constantly, and boil for about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cardamom seeds; divide pudding among serving dishes. Garnish with slivered almonds. Serve warm or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
