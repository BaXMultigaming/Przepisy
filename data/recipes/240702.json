  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "4 ounces goat cheese, softened",
    "3 tablespoons chopped fresh flat-leaf parsley",
    "2 tablespoons chopped fresh tarragon",
    "1 tablespoon chopped fresh thyme",
    "0.5 clove garlic, minced, or more to taste",
    "1 pinch cayenne pepper, or to taste",
    "salt and ground black pepper to taste",
    "1 cup whole almonds, or as needed",
    "3 large fresh rosemary sprigs"
  ],
  "steps": [
    {
      "text": "Stir cream cheese, goat cheese, parsley, tarragon, thyme, garlic, cayenne pepper, salt, and black pepper together in a bowl until smooth and well-mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oqLNfJwdzfVPyvd3IEOC0lmsJD8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240702-pine-cone-cheese-ball-VAT-step-01-7cfe5e1c7a814fd2a5af2de073905614.jpg"
      ],
      "image": "assets/images/240702/step_01.webp"
    },
    {
      "text": "Turn cheese mixture out onto a serving platter and form into a tapered oval shape to resemble a pine cone.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lDhaTk4cxrm_AWw7xUPrM9nhTz8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240702-pine-cone-cheese-ball-VAT-step-02-7841733194e94345b8410328646820ab.jpg"
      ],
      "image": "assets/images/240702/step_02.webp"
    },
    {
      "text": "Starting at the tapered end, press almonds into the cheese cone so that the tip of the almond is facing out and down, and cheese cone is completely covered with almonds and resembles a pine cone. Place rosemary sprigs at the top to resemble pine needles.",
      "section": null,
      "name": null,
      "url": null,
