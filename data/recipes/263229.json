  "ingredients": [
    "2 salmon fillets",
    "0.5 cup soy sauce",
    "0.5 cup lemon juice",
    "0.25 cup roughly chopped onion",
    "6 slices onion",
    "2 cloves garlic, roughly chopped",
    "1 teaspoon ground black pepper",
    "1 clove garlic, minced",
    "1 tablespoon garlic-pepper seasoning"
  ],
  "steps": [
    {
      "text": "Place salmon fillets into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soy sauce, lemon juice, 1/2 the chopped onion, onion slices, chopped garlic, and black pepper in a separate bowl. Pour marinade over the salmon; add the rest of the chopped onion, minced garlic, and garlic-pepper seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bowl with the salmon and refrigerate, flipping fish over in the last 3 to 4 hours, 12 to 15 hours total.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon on the grill or on planks; top with the marinated onion slices. Cook until nicely browned, 8 to 10 minutes. Reduce heat to medium-low and cook until fish flakes easily with a fork, 3 to 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
