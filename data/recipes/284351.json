  "ingredients": [
    "1 tablespoon olive oil",
    "1 onion, chopped",
    "1 green bell pepper, chopped",
    "0.5 cup chopped celery",
    "4 cloves garlic, chopped",
    "2 cups black beans, rinsed and drained",
    "salt and ground black pepper to taste",
    "3 cups cooked white rice"
  ],
  "steps": [
    {
      "text": "Heat oil in a frying pan over medium heat. Add onion, bell pepper, celery, and garlic and saute until softened, 5 to 7 minutes. Stir in black beans with their juices, salt, and pepper. Saute until some of the liquid evaporates, 3 to 5 minutes. Stir in rice.",
