  "ingredients": [
    "2 cups walnuts",
    "2 cups pitted Medjool dates",
    "1 cup shredded coconut",
    "1 tablespoon sesame oil",
    "1 teaspoon sea salt",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
