  "ingredients": [
    "1 (.25 ounce) package unflavored gelatin",
    "0.75 cup boiling water",
    "0.25 cup white sugar",
    "1 cup whole milk",
    "1 teaspoon almond extract",
    "0.5 (15.25 ounce) can fruit cocktail, including syrup"
