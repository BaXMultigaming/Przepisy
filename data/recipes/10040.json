  "ingredients": [
    "0.5 cup butter",
    "0.25 cup white sugar",
    "5 tablespoons unsweetened cocoa powder",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2 cups graham cracker crumbs",
    "1 cup shredded coconut",
    "0.5 cup chopped walnuts",
    "0.25 cup butter",
    "2 cups confectioners' sugar",
    "2 tablespoons vanilla custard powder",
    "3 tablespoons milk",
    "4 (1 ounce) squares semisweet chocolate, chopped",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Mix 1/2 cup butter or margarine, white sugar, cocoa, egg and vanilla in a heavy sauce pan or double boiler. Stir over low heat until mixture is of custard like consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham crackers, coconut and walnuts and add to the melted mixture. Mix well and pack into buttered 9 inch square cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream 1/4 cup butter, confectioners' sugar, vanilla custard powder and milk. Beat until creamy and spread over melted base.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate till hardened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt semi-sweet chocolate with 1 tablespoon butter and drizzle over custard icing. Refrigerate. When totally hard cut into square bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
