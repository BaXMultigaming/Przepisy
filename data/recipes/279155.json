  "ingredients": [
    "4.5 cups all-purpose flour",
    "1 cup white sugar, or more to taste",
    "1 cup shortening (such as Crisco®)",
    "0.25 cup milk",
    "3 large eggs",
    "4 teaspoons baking powder",
    "1 tablespoon almond extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a cookie sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, shortening, milk, eggs, baking powder, and almond extract in a bowl by hand until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into a 1-inch thick log. Cut small portions and roll into 3-inch long pieces, then shape into \"S\" shapes. Place on the prepared cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 10 to 15 minutes. Cool on the baking sheet briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
