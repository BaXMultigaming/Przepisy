  "ingredients": [
    "1 tablespoon mild paprika",
    "1 tablespoon dried parsley",
    "2 teaspoons brown sugar",
    "1 teaspoon dry mustard powder",
    "2 teaspoons salt",
    "1 teaspoon black pepper",
    "1 (3 1/2) pound whole chicken, cut into pieces",
    "2 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 400 degrees F (200 degrees C). Combine the paprika, parsley, sugar, mustard, salt, and pepper in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the chicken pieces in a 9x13 inch baking dish, and coat with the vegetable oil; arrange skin-side up. Sprinkle evenly with the spice mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake the chicken in the preheated oven until no longer pink at the bone and the juices run clear, about 45 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
