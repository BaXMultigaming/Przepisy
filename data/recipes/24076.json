  "ingredients": [
    "0.5 pound ground beef",
    "1 small onion, chopped",
    "2 (8 ounce) cans tomato sauce",
    "1.5 cups water",
    "1.5 teaspoons salt",
    "1 teaspoon dried parsley",
    "0.5 teaspoon black pepper",
    "0.5 pinch dried basil",
    "4 ounces uncooked spaghetti"
  ],
  "steps": [
    {
      "text": "Brown ground beef with onion in a large skillet over medium heat until all pink is gone; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomato sauce, water, salt, parsley, pepper, and basil; mix well. Heat until sauce boils. Break spaghetti in half and drop into the sauce a little at a time. Cover and turn to low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until spaghetti is tender, approximately 20 to 25 minutes. Stir occasionally to keep from sticking together or to the pan. Add water, 1/2 to 1 cup, if it starts to dry out and noodles are not cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
