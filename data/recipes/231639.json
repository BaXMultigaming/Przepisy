  "ingredients": [
    "1 cup crumbled feta cheese",
    "0.5 cup chopped roasted red peppers",
    "4 pepperoncini peppers, drained and stemmed",
    "1 teaspoon cayenne pepper, or more to taste",
    "1 cup ricotta cheese",
    "1 teaspoon lemon juice"
  ],
  "steps": [
    {
      "text": "Pulse feta cheese in a food processor just enough to get uniformly small crumbles; transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée red peppers, pepperoncini, and cayenne pepper in the food processor until smooth. Add pepper purée to feta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add ricotta cheese and lemon juice to feta-pepper purée mixture; mix until dip is uniform in texture and color. Transfer to a sealed container and refrigerate for at least 2 hours or overnight before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
