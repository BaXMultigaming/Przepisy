  "ingredients": [
    "14 tablespoons butter",
    "1 cup pitted chopped dates",
    "1 cup white sugar",
    "2 cups crispy rice cereal (such as Rice Krispies®)",
    "1 cup chopped pecans",
    "2 tablespoons confectioners' sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium heat; cook and stir dates and white sugar in melted butter until thick and golden brown, 10 to 15 minutes. Remove saucepan from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir crispy rice cereal and pecans into hot date mixture. Let cool until easily handled, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form mixture into small balls with your hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour confectioners' sugar into a resealable plastic bag; add date-nut balls, seal the bag, and lightly shake until well-coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
