  "ingredients": [
    "0.25 cup butter",
    "1 large onion, chopped",
    "3 russet potatoes, peeled and diced",
    "3 skinless, boneless chicken breast halves, diced",
    "8 cups water",
    "2 cups frozen corn",
    "salt to taste",
    "ground black pepper to taste",
    "0.5 cup milk, or to taste",
    "4 (1 ounce) pieces mozzarella cheese sticks, coarsely chopped"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium heat. Add potatoes and onion. Cook, stirring constantly, until tender but not brown, about 5 minutes. Increase heat to medium-high and add chicken. Cook until chicken is white, 7 to 10 minutes. Add water and bring to a simmer. Add corn and bring soup to a simmer again.",
