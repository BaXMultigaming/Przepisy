  "ingredients": [
    "3 cups water",
    "0.5 teaspoon salt",
    "1 cup hominy grits",
    "0.5 cup shredded sharp Cheddar cheese",
    "1 tablespoon butter",
    "freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
