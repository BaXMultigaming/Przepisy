  "ingredients": [
    "2 eggs, separated",
    "1 tablespoon water",
    "2 cups all-purpose flour",
    "1.5 cups brown sugar, divided",
    "1 cup butter, at room temperature",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 (8 ounce) package chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg yolks and water together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine egg yolk mixture, flour, 1/2 cup brown sugar, butter, white sugar, vanilla extract, baking soda, and salt in a large bowl; beat with an electric mixer on low speed until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press dough evenly into the bottom of a 9x13-inch baking pan. Scatter chocolate chips over dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a glass, metal, or ceramic bowl, using clean beaters, until foamy. Gradually add remaining 1 cup brown sugar, continuing to beat until stiff peaks form. Spread beaten egg whites over chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is lightly golden and edges start to pull away from the sides of the pan, 20 to 25 minutes. Cool completely before cutting into squares, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
