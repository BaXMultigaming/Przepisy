  "ingredients": [
    "0.66666668653488 cup white sugar",
    "0.33333334326744 cup brown sugar",
    "2 teaspoons salt",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon cayenne pepper",
    "1 egg white, room temperature",
    "1 tablespoon water",
    "1 pound whole pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix white sugar, brown sugar, salt, cinnamon, and cayenne pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white and water together in a separate large bowl until frothy but not yet stiff; add pecans and stir to coat. Season nuts with the sugar mixture and spread onto the prepared baking sheet in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in oven, turning occasionally, until the nuts are browned and no longer moist, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set baking sheet on a wire rack to cool nuts, breaking apart any nuts stuck together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
