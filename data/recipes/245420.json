  "ingredients": [
    "cooking spray",
    "0.75 cup teff flour",
    "0.75 cup brown rice flour",
    "0.5 cup arrowroot starch",
    "0.5 cup firmly packed dark brown sugar",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "0.66666668653488 cup water",
    "0.33333334326744 cup vegetable oil",
    "2 large eggs",
    "0.5 cup mashed banana",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine teff flour, brown rice flour, arrowroot starch, brown sugar, baking powder, cinnamon, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix water, vegetable oil, and eggs together in a separate bowl; whisk into flour mixture. Stir in bananas and walnuts. Pour batter into muffin cups to 3/4-full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until tops spring back when lightly pressed, 20 to 25 minutes.",
