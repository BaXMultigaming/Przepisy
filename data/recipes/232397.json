  "ingredients": [
    "2 (28 ounce) cans crushed tomatoes",
    "0.5 cup water, divided",
    "0.66666668653488 cup white sugar",
    "0.75 cup distilled white vinegar",
    "1 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "1.75 teaspoons salt",
    "0.125 teaspoon celery salt",
    "0.125 teaspoon mustard powder",
    "0.25 teaspoon finely ground black pepper",
    "1/4 teaspoon cayenne pepper, or to taste",
    "1 whole clove"
  ],
  "steps": [
    {
      "text": "Pour crushed tomatoes into slow cooker. Swirl 1/4 cup water in each emptied can and pour into the slow cooker. Add sugar, vinegar, onion powder, garlic powder, salt, celery salt, mustard powder, black pepper, cayenne pepper, and whole clove; whisk to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SYsJNLr8F3mH4lMBVr1r7HDBhgQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232397-homemade-ketchup-ddmfs-001-step-1.CR3-78dcec85b5ec45d282f4181d9f25418b.jpg"
      ],
      "image": "assets/images/232397/step_01.webp"
    },
    {
      "text": "Cook on High, uncovered, until mixture is reduced by half and very thick, 10 to 12 hours. Stir every hour or so.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MmobThRdf2oVGYuDgWujijDFXMY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232397-homemade-ketchup-ddmfs-003-step-2.CR3-5b9552b30b324a91aaf61dd411c2b17b.jpg"
      ],
      "image": "assets/images/232397/step_02.webp"
    },
    {
      "text": "Use an immersion blender for about 20 seconds to smooth the texture of the ketchup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/U4f0xTwPhE33hGnZkTaflqdYTvo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232397-homemade-ketchup-ddmfs-28-step-3--1359b56336b3457597a115c3cf0e2fe8.jpg"
      ],
      "image": "assets/images/232397/step_03.webp"
    },
    {
      "text": "Ladle ketchup into a fine strainer and press mixture with the back of a ladle to strain out any skins and seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7b5m2WDNWjXSMbrjhUZb0zG_qy8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232397-homemade-ketchup-ddmfs-29-step-4--37120b0b4ff64ab4986d692c989a7cd7.jpg"
      ],
      "image": "assets/images/232397/step_04.webp"
    },
    {
      "text": "Transfer strained ketchup to a bowl. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Taste and adjust salt, black pepper, and cayenne pepper as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xBe7J1i-_2lDXVFHQtqMXktIz1Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232397-homemade-ketchup-ddmfs-28-4x336-4x3.-c50701be22a742b9b0753b7b1ef84163.jpg"
