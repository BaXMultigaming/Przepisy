  "ingredients": [
    "2 cups water",
    "2 cups instant white rice (such as Minute®)",
    "0.5 teaspoon butter",
    "0.125 teaspoon salt",
    "1 cup milk",
    "2 tablespoons brown sugar, or to taste",
    "1 teaspoon cornstarch",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon, or more to taste"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a saucepan. Add rice, butter, and salt; cook and stir until butter melts, then cover the saucepan and remove from the heat. Set aside until water is absorbed, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk, brown sugar, cornstarch, and vanilla into rice; bring to a simmer over medium heat while stirring. Cook until rice has the consistency of loose oatmeal, about 5 minutes. Ladle pudding into bowls and dust with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
