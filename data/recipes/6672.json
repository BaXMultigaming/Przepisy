  "ingredients": [
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1.25 cups vegetable oil",
    "4 large eggs",
    "1 (10 ounce) package frozen strawberries, thawed",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, sugar, cinnamon, salt, and baking soda in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together oil and eggs in a separate bowl until well combined. Mix in strawberries and pecans. Stir into flour mixture until just combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of loaf comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
