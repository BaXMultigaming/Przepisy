  "ingredients": [
    "0.5 cup unsalted butter, at room temperature",
    "0.75 cup white sugar",
    "2 large eggs",
    "4 ripe bananas",
    "1 teaspoon pure vanilla extract",
    "2 cups unbleached all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter in a large bowl until nice and creamy. Add sugar and mix until smooth. Add eggs one at a time, mixing until blended. Mix in bananas and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, and salt together in another bowl. Mix into the banana mixture and fold in blueberries. Pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Remove from the oven and let sit in the pan for 10 minutes before turning out onto a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
