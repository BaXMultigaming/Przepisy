  "ingredients": [
    "1.5 cups mayonnaise",
    "0.5 cup prepared mustard",
    "1 teaspoon chopped fresh thyme",
    "1 teaspoon dried oregano",
    "1 teaspoon chopped fresh basil leaves",
    "1.5 pounds salmon fillets",
    "2 teaspoons dried dill, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, stir together mayonnaise and mustard. Stir in thyme, oregano, and basil. Place salmon fillets on a baking sheet, and spread with the mayonnaise mixture. Sprinkle with dill weed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 to 40 minutes, until the salmon is easily flaked with a fork.",
      "section": null,
