  "ingredients": [
    "4 large baking potatoes",
    "3 tablespoons vegetable oil",
    "1 tablespoon grated Parmesan cheese",
    "0.5 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon paprika",
    "0.125 teaspoon ground black pepper",
    "8 slices cooked bacon, crumbled",
    "1.5 cups shredded Cheddar cheese",
    "0.5 cup sour cream",
    "4 medium green onions, diced"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 450 degrees F (230 degrees C). Prick potatoes several times with a fork and place onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are easily pierced with a fork, 50 minutes to 1 hour. Let cool enough to handle, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase oven temperature to 475 degrees F (245 degrees C). Line a baking sheet with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut the potatoes in half lengthwise; scoop out the flesh using a melon baller leaving 1/4 inch in the shell. Reserve flesh for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil, Parmesan cheese, salt, garlic power, paprika, and pepper in a bowl. Brush over both sides of the potato skins. Place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 7 minutes. Flip and continue to bake until crisp, about 7 minutes more. Remove from the oven; sprinkle with bacon pieces and Cheddar cheese. Bake until cheese is melted, about 2 minutes. Top with sour cream and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
