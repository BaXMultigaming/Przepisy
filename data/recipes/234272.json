  "ingredients": [
    "1.5 tablespoons vegetable or canola oil",
    "0.5 teaspoon Morton® Fine Sea Salt",
    "1 cup extra long grain rice (15 minute)",
    "2 cups frozen mixed vegetables",
    "3 cups chicken stock",
    "1.5 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Heat oil in medium sauce pan over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add remaining ingredients, except for cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring to a boil for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low, cover and simmer for 10 minutes, or until liquid is absorbed.",
      "section": null,
      "name": null,
