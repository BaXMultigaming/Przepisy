  "ingredients": [
    "2 cups white sugar",
    "0.5 cup milk",
    "0.5 cup unsalted butter",
    "2 tablespoons cocoa powder",
    "3 cups old-fashioned oats",
    "0.5 cup peanut butter, or more to taste",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine sugar, milk, butter, and cocoa powder in a large saucepan over medium heat; bring to a boil. Cook and stir until butter is melted and mixture is smooth, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and add oats, peanut butter, and vanilla; mix until thoroughly combined. Drop tablespoonfuls of dough onto sheets of waxed paper. Let cool until solid, 20 to 30 minutes.",
      "section": null,
      "name": null,
