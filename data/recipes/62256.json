  "ingredients": [
    "1.25 pounds ground beef",
    "3 tablespoons Worcestershire sauce",
    "1.5 tablespoons dried basil, or to taste",
    "0.25 teaspoon garlic salt",
    "0.25 teaspoon ground black pepper",
    "4 hamburger buns, split"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, Worcestershire sauce, basil, garlic salt, and black pepper in a bowl; form into 4 equal-sized patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook burgers on the preheated grill, flipping once, until no longer pink in centers and the juices run clear, about 4 minutes per side. An instant-read thermometer inserted into centers should read at least 160 degrees F (71 degrees C). Serve burgers on buns.",
