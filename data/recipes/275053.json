  "ingredients": [
    "3 slices bacon",
    "4 cups chicken broth",
    "1 pound dried pinto beans, rinsed",
    "1.5 cups water",
    "0.5 cup chopped onions, or to taste",
    "2 green chile peppers",
    "1.25 teaspoons garlic powder",
    "1.25 teaspoons kosher salt",
    "1 teaspoon chili powder",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Sauté function. Add bacon and cook, turning once, 4 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken broth, pinto beans, water, onions, chile peppers, garlic powder, salt, chili powder, cumin, and paprika. Close and lock the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Select high pressure according to manufacturer's instructions; set timer for 45 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes. Unlock and remove the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove bacon and chile peppers; chop to desired consistency and return to the pot. Mash beans with a potato masher until they reach desired consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
