  "ingredients": [
    "24 Original Snack Factory® Pretzel Crisps®",
    "0.5 cup strawberry ice cream, or as needed",
    "12 slices fresh strawberries",
    "12 chocolate candy squares (like Hershey's®)"
  ],
  "steps": [
    {
      "text": "Spoon about 2 teaspoons ice cream onto 12 Snack Factory® Pretzel Crisps®, and smooth out over the pretzel. Top with a strawberry slice and a square of chocolate candy bar. Add a small dollop of ice cream on top to hold the sandwich together. Top with remaining Pretzel Crisps®.",
