  "ingredients": [
    "1.5 cups cornmeal",
    "1 cup boiling water",
    "1 cup all-purpose flour",
    "3 tablespoons white sugar",
    "2 tablespoons butter, melted",
    "2 tablespoons baking powder",
    "1 pinch salt",
    "1.5 cups milk",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Pour cornmeal into a large bowl; cover with boiling water. Let stand until slightly softened, about 5 minutes. Stir in flour, sugar, melted butter, baking powder, and salt. Mix in milk and egg until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly greased griddle over medium heat. Drop spoonfuls of batter onto the griddle and cook until edges are dry, 2 to 3 minutes. Flip and cook until browned on the other side, 2 to 3 minutes more. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
