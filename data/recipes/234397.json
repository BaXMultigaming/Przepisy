  "ingredients": [
    "1 pound ground beef",
    "1 tablespoon chopped garlic",
    "1 teaspoon garlic powder",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 (24 ounce) jars prepared pasta sauce",
    "1 teaspoon Italian seasoning",
    "1 teaspoon dried basil",
    "1 teaspoon dried oregano",
    "1 (25 ounce) package frozen cheese ravioli",
    "2 cups shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef, garlic, garlic powder, salt, and pepper in the hot skillet until meat is browned and crumbly, 5 to 7 minutes. Drain and discard grease. Stir pasta sauce, Italian seasoning, basil, and oregano into ground beef mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle a generous layer of meat sauce into the bottom of a slow cooker; add a layer of ravioli. Ladle another layer of meat sauce over ravioli layer; alternate with remaining ravioli and meat sauce until all ingredients are used.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 3 to 5 hours. Sprinkle ravioli mixture with mozzarella cheese and continue cooking until cheese is melted, 45 minutes to 1 hour more.",
      "section": null,
      "name": null,
      "url": null,
