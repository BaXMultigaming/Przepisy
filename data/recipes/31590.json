  "ingredients": [
    "3 cups water",
    "0.5 cup butter, cut into pieces",
    "2 (6 ounce) packages cornbread stuffing mix",
    "1 pound ground pork sausage",
    "4 stalks celery, chopped",
    "1 medium onion, chopped",
    "2 tablespoons butter, melted",
    "1 teaspoon poultry seasoning",
    "1 (14.5 ounce) can chicken broth, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and 1/2 cup butter to boil in a medium saucepan. Remove from the heat and stir in stuffing mix. Cover and let stand for 5 minutes. Fluff with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "At the same time, cook sausage in a large, deep skillet over medium-high heat until browned and crumbly, 5 to 7 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer stuffing mix and sausage to a large bowl; mix in celery, onion, melted butter, and poultry seasoning. Slowly stir in desired amount of chicken broth. Transfer to a medium baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, covered, in the preheated oven until lightly browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
