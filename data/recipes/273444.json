  "ingredients": [
    "2 cups water",
    "1 cup milk",
    "1 cup steel-cut oats",
    "1 apple - peeled, cored, and chopped",
    "2 tablespoons brown sugar",
    "1.5 tablespoons butter, cut into 6 pieces",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Combine water, milk, oats, apple, brown sugar, butter, cinnamon, and salt in a slow cooker; mix well.",
