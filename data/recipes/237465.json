  "ingredients": [
    "1 cup elbow macaroni",
    "1.5 cups shredded Cheddar cheese",
    "0.66666668653488 cup milk",
    "1 egg, beaten",
    "1 tablespoon prepared mustard",
    "1 dash hot pepper sauce (such as Tabasco®)",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until cooked through but firm to the bite, 8 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir macaroni, Cheddar cheese, milk, egg, mustard, hot pepper sauce, salt, and pepper together in a bowl; pour into a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until brown and thickened, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
