  "ingredients": [
    "2.5 cups shredded cooked chicken",
    "1 (4 ounce) can chopped green chilies",
    "0.25 cup green salsa (such as Herdez®)",
    "1 teaspoon chili powder",
    "0.5 teaspoon ground cumin",
    "0.25 teaspoon garlic powder",
    "12 (6 inch) flour tortillas",
    "2 cups shredded Mexican cheese blend"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium-low heat. Add chicken, chilies, salsa, chili powder, cumin, and garlic powder. Cook and stir until heated through, 3 to 5 minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat 2 to 3 tortillas at a time in a microwave until soft and pliable, 20 to 25 seconds. Continue with remaining tortillas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay a tortilla on a work surface. Add some chicken mixture in a line, towards one end of the tortilla, and top with some cheese. Roll tightly, being careful not to tear the tortilla. Secure with two toothpicks. Repeat until all tortillas, chicken, and cheese are used. Transfer tortillas to a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 7 minutes. Flip and continue to bake until golden, about 7 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
