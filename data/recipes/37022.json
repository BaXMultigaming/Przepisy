  "ingredients": [
    "2 pounds ground beef",
    "1 cup chopped onion",
    "1 egg, beaten",
    "0.5 cup ketchup",
    "1 teaspoon salt",
    "0.5 teaspoon pepper",
    "0.25 teaspoon dried oregano",
    "1 tablespoon Worcestershire sauce",
    "0.75 cup shredded Cheddar cheese",
    "6 hamburger buns"
