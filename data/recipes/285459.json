  "ingredients": [
    "0.5 medium head cabbage, shredded",
    "0.5 cup chopped fresh cilantro leaves",
    "0.25 cup thinly sliced red onion",
    "1 medium jalapeno pepper, seeded and diced",
    "0.25 cup olive oil",
    "1.5 tablespoons fresh lime juice",
    "1.5 tablespoons red wine vinegar",
    "0.5 teaspoon salt",
    "1 pinch white sugar"
  ],
  "steps": [
    {
      "text": "Place cabbage in a large bowl with cilantro, onion, and jalapeño; toss to combine.",
      "section": null,
      "name": null,
      "url": null,
