  "ingredients": [
    "3 ounces cream cheese, softened",
    "0.5 cup heavy cream",
    "1 teaspoon vanilla extract",
    "0.25 cup powdered zero-calorie sweetener (such as Swerve®)",
    "2 tablespoons cocoa powder",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Beat cream cheese in a large bowl with an electric mixer until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H9plhDbfleT2eAk_aZGCAwZ51Xk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/270598-quick-keto-chocolate-mousse-ddmfs-step-1-3x4-bd8aedeec9f2413d9096e72dc7d977af.jpg"
      ],
      "image": "assets/images/270598/step_01.webp"
    },
    {
      "text": "Turn mixer to low speed and slowly mix in heavy cream and vanilla. Mix in sweetener, cocoa powder and salt until well incorporated. Turn mixer to high and mix until light and fluffy, 1 to 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2HZuDH-o9yxNprE-6rqI4msxUrM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/270598-quick-keto-chocolate-mousse-ddmfs-step-3-0095-3x4-729518c4226c4b5eb29a9a330032d6a0.jpg"
      ],
      "image": "assets/images/270598/step_02.webp"
    },
    {
      "text": "Serve immediately, or refrigerate for later.",
