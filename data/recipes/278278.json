  "ingredients": [
    "0.5 (16 ounce) package dry fettuccine pasta",
    "0.25 cup mayonnaise",
    "0.25 cup Thai sweet chili sauce",
    "2 tablespoons heavy cream",
    "4 cloves garlic, minced",
    "2 teaspoons Sriracha sauce",
    "1 teaspoon smoked paprika",
    "salt and ground black pepper to taste",
    "1 tablespoon butter",
    "0.5 pound uncooked medium shrimp, peeled and deveined",
    "0.25 cup dry white wine",
    "0.5 lime, juiced",
    "1 pinch red pepper flakes, or to taste"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While pasta is cooking, whisk mayonnaise, chili sauce, cream, garlic, Sriracha sauce, paprika, salt, and pepper in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large nonstick skillet over medium heat. Add shrimp, wine, and lime juice. Cook and stir until shrimp begin to change color, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain fettuccine; add up to 2 tablespoons of pasta water to the shrimp. Stir in the mayonnaise mixture and red pepper flakes. Add the cooked fettuccine; stir to coat with sauce. Divide pasta between serving bowls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
