  "title": "Spicy Vegetable Beef Soup",
  "description": "Chunks of beef are simmered with mixed vegetables, mushrooms, celery, and pasta seasoned with oregano, thyme, basil, parsley, and cayenne.",
  "authors": [
    "Kathy S"
  ],
