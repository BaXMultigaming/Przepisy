  "ingredients": [
    "1 tablespoon butter, or to taste",
    "1 medium onion, diced",
    "10 mushrooms, thickly sliced",
    "2 tablespoons water, or as needed",
    "1 teaspoon beef bouillon",
    "2 slices cooked bacon",
    "0.5 cup sour cream",
    "1 tablespoon cornstarch"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium heat. Stir onion and mushrooms into melted butter. Reduce heat to low and cover the skillet. Cook for 15 minutes. Stir, cover again, and cook until tender, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour enough water into the skillet to moisten onion-mushroom mixture. Add bouillon; stir until dissolved. Cut bacon into small pieces over sauce. Simmer, uncovered, for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase heat to medium. Add sour cream and cornstarch; stir constantly until sauce is blended and thickened, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
