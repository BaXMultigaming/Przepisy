  "ingredients": [
    "2.6666667461395 cups unbleached all-purpose flour",
    "3 tablespoons malted milk powder (such as Carnation®)",
    "2.5 tablespoons white sugar",
    "2.25 teaspoons active dry yeast",
    "1 teaspoon salt",
    "1.75 cups whole milk",
    "0.25 cup water",
    "0.25 cup butter",
    "3 eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Sift flour, milk powder, sugar, yeast, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, water, and butter in a small saucepan over low heat. Heat until an instant-read thermometer inserted into the mixture reads 125 degrees F (52 degrees C), about 5 minutes; butter may not melt completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk mixture over flour mixture in the bowl; add eggs and vanilla extract. Mix until batter is thoroughly blended. Cover bowl loosely with plastic wrap. Refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1 cup batter onto the preheated waffle iron; close and cook until the iron stops steaming, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
