  "title": "Poppy Seed Bread II",
  "description": "This bread teams lemon with a scattering of poppy seeds. A lemon-orange glaze provides a nice finish to this tasty loaf.",
  "authors": [
    "Pat Heldenbrand"
  ],
  "date_published": "1998-07-14T16:22:07-04:00",
