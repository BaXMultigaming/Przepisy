  "ingredients": [
    "3 cups all-purpose flour",
    "1.5 teaspoons salt",
    "1.5 teaspoons baking powder",
    "3 eggs",
    "1.5 cups milk",
    "1 cup vegetable oil",
    "2.25 cups white sugar",
    "1.5 tablespoons poppy seeds",
    "2 teaspoons vanilla extract",
    "2 teaspoons lemon extract",
    "2 teaspoons butter flavored extract",
    "0.25 cup orange juice",
    "0.75 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease two 8x4 inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the flour, salt, baking powder, eggs, milk, vegetable oil, white sugar, poppy seeds, 1 1/2 teaspoons of the vanilla, lemon and butter flavoring. Stir until just combined and pour the batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour. Cool for 5 minutes then poke holes in the top of the bread with a meat fork and pour glaze over tops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Glaze: Mix the orange juice, confectioner's sugar, and the remaining 1/2 teaspoon each of the vanilla, butter and lemon flavorings. Use immediately to pour over the still warm loaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
