  "ingredients": [
    "2 tablespoons olive oil",
    "1 small onion, chopped",
    "4 large fresh mushrooms, chopped",
    "1 Yukon Gold potato, diced",
    "0.5 cup dry brown lentils",
    "1 clove garlic",
    "2 tablespoons chopped fresh parsley",
    "2 tablespoons chopped fennel greens",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon cayenne pepper, or to taste",
    "0.25 teaspoon ground turmeric, or to taste",
    "3 cups water"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large saucepan over medium-high heat. Add onion and mushroom; cook until tender, about 3 minutes. Stir in potato, lentils, garlic, parsley, fennel greens, salt, ground black pepper, cayenne pepper, and turmeric. Pour in water; stir to mix. Turn heat to medium-low and simmer until flavors are combined, about 45 minutes.",
