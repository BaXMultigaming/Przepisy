  "title": "Mom's Pumpkin Rolls",
  "description": "Pumpkin puree adds color and flavor to traditional dinner rolls.",
  "authors": [
    "Rachel Digman"
  ],
  "date_published": "2009-04-10T10:24:06-04:00",
