  "ingredients": [
    "0.25 cup butter",
    "2 carrots, diced",
    "1 onion, chopped",
    "0.5 cup chicken broth",
    "1.5 cups water",
    "1.5 cups uncooked couscous",
    "0.25 cup raisins"
  ],
  "steps": [
    {
      "text": "Heat the butter in a large saucepan over medium heat, and cook and stir the carrots and onion until the carrots begin to soften and the onion is translucent, about 5 minutes. Pour in the chicken broth and water, and bring the mixture to a boil. Stir in the couscous, mixing well to avoid lumps, cover, and remove from the heat. Let the couscous stand covered until the water is absorbed, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the raisins, and serve hot.",
