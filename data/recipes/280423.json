  "steps": [
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place refried beans in a medium bowl. Add taco seasoning and stir until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 cheese slice in the middle of a tortilla. Spoon 1 tablespoon bean mixture over cheese. Place another cheese slice on top of beans. Fold tortilla over and press down to seal taco. Repeat with remaining tortillas, beans, and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray both sides of tacos with nonstick cooking spray. Place tacos in the air fryer basket without overlapping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 3 minutes. Flip tacos and cook for 3 minutes more. Repeat with remaining tacos.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
