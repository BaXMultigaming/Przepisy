  "ingredients": [
    "2 tablespoons butter",
    "2 large onions, diced",
    "2 pounds flank steak",
    "0.125 teaspoon caraway seed",
    "0.25 teaspoon dried marjoram",
    "1 clove garlic, minced",
    "5 tablespoons paprika",
    "2 cups water",
    "4 large potatoes, peeled and cubed",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a large soup pot over medium high heat. Saute onions until soft, then add beef and brown. Stir in caraway seed, marjoram, garlic and paprika. Pour water over all, lower heat to low and simmer for 2 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add potatoes and cook until tender, another 45 minutes to 1 hour. Season with salt and pepper to taste and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
