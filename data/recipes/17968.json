  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "0.5 cup white sugar",
    "1 tablespoon all-purpose flour",
    "1 egg",
    "1 tablespoon orange zest",
    "1.6660000085831 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon pumpkin pie spice",
    "1 cup pumpkin puree",
    "0.5 cup vegetable oil",
    "2 eggs",
    "1.5 cups white sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C). Lightly grease two 8x4 inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r1popfobYzEwHPMAJi-CCjQG1iA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17968-pumpkin-cream-cheese-bread-VAT-step-01-354117bb88d04130bd1837cde11f3d8b.jpg"
      ],
      "image": "assets/images/17968/step_01.webp"
    },
    {
      "text": "Combine cream cheese, 1/2 cup sugar, 1 tablespoon flour, 1 egg and orange zest in a medium bowl; beat until smooth. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X3PcnVyKT-hjzdpgz-PwWfWKFo4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17968-pumpkin-cream-cheese-bread-VAT-step-02-bba873ce48124d09bb3b7ad2a7615e63.jpg"
      ],
      "image": "assets/images/17968/step_02.webp"
    },
    {
      "text": "Sift together 1 ⅔ cups flour, baking soda, salt, cinnamon, cloves, and pumpkin pie spice; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZmibBNw62vS23BgRV4olrsJVgBY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17968-pumpkin-cream-cheese-bread-VAT-step-03-ab025e1bd1c84e3eb0f6a0bdd9f1a950.jpg"
      ],
      "image": "assets/images/17968/step_03.webp"
    },
    {
      "text": "Place pumpkin, vegetable oil, 2 eggs and 1 ½ cups sugar in a large bowl; beat well. Stir the pumpkin mixture into the flour mixture just until combined. Fold in the pecans if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JtRZTbjmsl3ygi2JwNjHVGEsKNw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17968-pumpkin-cream-cheese-bread-VAT-step-04-d5a4b56af84247e5913b10e7afa46158.jpg"
      ],
      "image": "assets/images/17968/step_04.webp"
    },
    {
      "text": "Pour 1/2 of the pumpkin batter into the loaf pans. Spoon cream cheese mixture on top of this layer and then pour on the remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cf0m6cMwK08k6dsfUvjbYVdr6js=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17968-pumpkin-cream-cheese-bread-VAT-step-05-ed97e2ddd2f5487cac6ff6e5bdfc12a2.jpg"
      ],
      "image": "assets/images/17968/step_05.webp"
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted into center of the loaf comes out clean, about 60 to 70 minutes. Cool bread in pans briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AyptHbCB1Qsk28y94SD7Mbep_L8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17968-pumpkin-cream-cheese-bread-VAT-step-06-89cd5ee78d964a37ab464ac487b345b0.jpg"
      ],
      "image": "assets/images/17968/step_06.webp"
    }
