  "ingredients": [
    "5 fresh raspberries",
    "1 sprig fresh thyme",
    "1.5 ounces gin",
    "1 pasteurized egg white",
    "0.75 fluid ounce simple syrup",
    "0.75 fluid ounce lemon juice",
    "ice cubes",
    "1 pinch ground cinnamon",
    "1 lemon zest curl",
    "1 sprig fresh thyme"
  ],
  "steps": [
    {
      "text": "In a cocktail shaker, muddle raspberries and thyme. Add gin, egg white, simple syrup, and lemon juice. Shake until mixture no longer sounds sloshy and you feel a lot of pressure. Add ice to fill shaker half-full. Shake again until very cold. Strain into a coupe or cocktail glass. Dust top with cinnamon, or garnish with lemon zest curl or additional thyme.",
