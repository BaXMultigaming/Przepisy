  "ingredients": [
    "3 tablespoons olive oil",
    "1 small onion, chopped",
    "3 cloves garlic, minced",
    "0.5 teaspoon grated fresh ginger",
    "0.25 teaspoon garlic salt",
    "4 skinless, boneless chicken breast halves",
    "3 tablespoons curry powder",
    "1 teaspoon chicken bouillon granules",
    "1 teaspoon ground thyme",
    "2 cups water",
    "1 potato, cubed",
    "1 green bell pepper, chopped",
    "hot cooked rice to serve"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a saucepan over medium-high heat. Stir in onion, garlic, ginger, and garlic salt. Add chicken breasts. Mix in curry powder; cook chicken until white, about 5 minutes. Add chicken bouillon and thyme.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour water into the saucepan; add potatoes and simmer until softened, about 10 minutes. Stir in green bell pepper and simmer until tender, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve curry over hot cooked rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
