  "title": "Heavenly Hash Cake",
  "description": "This quick and easy recipe makes a nutty chocolate cake with marshmallows and pecans.",
  "authors": [
    "SONIA_DIANA"
  ],
  "date_published": "1999-06-02T17:40:47-04:00",
