  "ingredients": [
    "4 eggs",
    "1 cup butter",
    "4 tablespoons unsweetened cocoa powder",
    "2 teaspoons vanilla extract",
    "2 cups white sugar",
    "1.5 cups self-rising flour",
    "1 cup chopped pecans",
    "1 (16 ounce) package miniature marshmallows",
    "4 tablespoons butter, melted",
    "4 cups confectioners' sugar",
    "4 tablespoons unsweetened cocoa powder",
    "0.5 cup evaporated milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour an 8x12 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream 1 cup butter and sugar. Add eggs one at a time, mixing well with each addition. Add vanilla and mix to incorporate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, mix flour and cocoa together, then add to the egg mixture and mix well to combine. Add nuts and combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into prepared 8x12 inch pan and bake at 350 degrees F (175 degrees C) for 40 minutes. While cake is still hot, cover with marshmallows.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Topping: In a small bowl, combine 4 tablespoons melted butter, confectioners' sugar, 4 tablespoons cocoa and evaporated milk. Spread evenly over top of cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
