  "ingredients": [
    "1 cup buttermilk",
    "0.5 teaspoon hot sauce",
    "0.33333334326744 cup tapioca flour",
    "0.5 teaspoon garlic salt",
    "0.125 teaspoon ground black pepper",
    "1 egg",
    "0.5 cup all-purpose flour",
    "2 teaspoons salt",
    "1.5 teaspoons brown sugar",
    "1 teaspoon garlic powder",
    "0.5 teaspoon paprika",
    "0.5 teaspoon onion powder",
    "0.25 teaspoon oregano",
    "0.25 teaspoon black pepper",
    "1 pound skinless, boneless chicken thighs"
  ],
  "steps": [
    {
      "text": "Combine buttermilk and hot sauce in a shallow dish; mix to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tapioca flour, garlic salt, and 1/8 teaspoon black pepper in a resealable plastic bag and shake to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, salt, brown sugar, garlic powder, paprika, onion powder, oregano, and 1/4 teaspoon black pepper in a gallon-sized resealable bag and shake to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chicken thighs into prepared ingredients in the following order: buttermilk mixture, tapioca mixture, egg, and flour mixture, shaking off excess after each dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 380 degrees F (190 degrees C). Line the air fryer basket with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place coated chicken thighs in batches into the air fryer basket and fry for 10 minutes. Turn chicken thighs and fry until chicken is no longer pink in the center and juices run clear, an additional 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
