  "ingredients": [
    "3 cups all-purpose flour",
    "1 teaspoon salt",
    "0.75 teaspoon cream of tartar",
    "0.5 teaspoon baking soda",
    "1 cup strawberry jam",
    "0.5 cup buttermilk",
    "1.5 cups white sugar",
    "1 cup unsalted butter, softened",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon lemon juice",
    "4 eggs",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, salt, cream of tartar, and baking soda in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir strawberry jam and buttermilk together; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, butter, vanilla extract, and lemon juice in a large mixing bowl. Beat with an electric mixer until light and fluffy. Add eggs one at a time, beating well after each addition. Add dry ingredients alternately with strawberry jam mixture, mixing just until blended. Fold in walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter evenly between the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 55 minutes. Cool for 15 minutes. Remove from pans onto cooling racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
