  "ingredients": [
    "2.5 cups all-purpose flour",
    "1.75 cups white sugar",
    "1.5 teaspoons baking soda",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1.5 cups applesauce",
    "0.5 cup butter",
    "0.5 cup buttermilk",
    "2 eggs",
    "0.75 cup chopped walnuts",
    "4 cups confectioners' sugar",
    "1 (8 ounce) package cream cheese, softened",
    "1.5 teaspoons vanilla extract",
    "0.25 cup butter",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9 x 13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sugar, baking soda, cinnamon, cloves, allspice, baking powder, and salt together into a large bowl. Mix in applesauce, 1/2 cup butter, and buttermilk; beat with an electric mixer on medium speed until combined, about 2 minutes. Beat in eggs. Fold in walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared pan. Bake until a toothpick inserted into middle comes out clean, about 50 minutes; let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix confectioners' sugar, cream cheese, and vanilla together in a large bowl until smooth; set aside. Melt 1/4 cup butter over medium heat; add pecans and stir continuously until brown. Set aside to cool. Stir pecans into cream cheese frosting; frost cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
