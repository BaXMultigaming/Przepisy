  "ingredients": [
    "1 medium sweet potato",
    "3 medium carrots, peeled",
    "1 medium apple, peeled and cored",
    "0.5 medium sweet onion",
    "2 (5 ounce) skinless, boneless chicken breast halves",
    "2 tablespoons barbecue sauce",
    "1 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pierce sweet potato several times with a fork, then cut in half. Place in a microwave-safe dish; pour in about 1/2 inch of water. Microwave on high for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rWmmJ8kXbPRgYzxvl2yj1xylttQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/157872-WinterChickenBake-mfs-step2-0423-4x3-8633d8550c19482ba5512ddd06e4e525.jpg"
      ],
      "image": "assets/images/157872/step_02.webp"
    },
    {
      "text": "Meanwhile, chop carrots, apple, and onion; arrange in the bottom of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DFUrfsZ8lVbSRNgZlbYFWc842wI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/157872-WinterChickenBake-mfs-step3-0424-4x3-7d7cf20fc5b44ed8b9d6953e6f9ed538.jpg"
      ],
      "image": "assets/images/157872/step_03.webp"
    },
    {
      "text": "Brush barbecue sauce on both sides of the chicken breasts and lay atop the vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-hc36uWF_4ADi2zgd7FPpu7HjqU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/157872-WinterChickenBake-mfs-step4-0425-4x3-01bd834c15e1442db1d3aa73f676741f.jpg"
      ],
      "image": "assets/images/157872/step_04.webp"
    },
    {
      "text": "Remove sweet potato from the microwave. Peel and discard skin. Cut sweet potato into large chunks; scatter into the baking dish. Sprinkle cranberries over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LZOE4E750__mX90H6pA2j9WQU28=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/157872-WinterChickenBake-mfs-step5-0426-4x3-ffeb0f1af69b4bffbfdba2823295272d.jpg"
      ],
      "image": "assets/images/157872/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until chicken is tender and no longer pink in the center, 45 to 55 minutes. Remove from the oven and allow to cool for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZXElS5T5ty8DObwmY7SxuRZHRRE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/157872-WinterChickenBake-mfs-0457-4x3-fd02e0cf67b74e57a2284d6e0bb7bd45.jpg"
      ],
      "image": "assets/images/157872/step_06.webp"
    }
  ],
