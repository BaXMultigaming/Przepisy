  "ingredients": [
    "0.5 large head cabbage, thinly sliced",
    "0.5 cup finely shredded carrots",
    "0.5 cup creamy salad dressing (such as Miracle Whip®)",
    "0.5 cup mayonnaise (such as Duke's®)",
    "0.25 cup buttermilk",
    "0.25 cup sour cream",
    "2 tablespoons honey",
    "1 tablespoon apple cider vinegar",
    "1 tablespoon lemon juice",
    "1.5 teaspoons salt, or more to taste",
    "1 teaspoon basil pesto",
    "1 teaspoon Dijon mustard",
    "1 teaspoon ground cayenne pepper",
    "1 teaspoon celery seed",
    "1 teaspoon onion powder",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Combine cabbage and carrots in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk salad dressing, mayonnaise, buttermilk, sour cream, honey, cider vinegar, lemon juice, salt, pesto, mustard, cayenne pepper, celery seeds, onion powder, black pepper, and garlic powder together in a medium bowl until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour ½ dressing over cabbage-carrot mixture; toss to coat. Gradually stir in remaining ½ dressing until coleslaw reaches desired consistency. Cover the bowl with plastic wrap; refrigerate until flavors combine, at least 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
