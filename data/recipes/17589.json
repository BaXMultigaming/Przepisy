  "title": "Albondigas Soup III",
  "description": "Cumin and oregano flavor the broth of this Mexican soup which calls for chunks of potatoes and beef meatballs made with rice.",
  "authors": [
    "Cynthia"
  ],
  "date_published": "2000-02-23T15:08:18-05:00",
