  "ingredients": [
    "2 quarts water",
    "1 pound ground beef",
    "0.5 cup uncooked white rice",
    "1 egg",
    "2 tablespoons dried oregano",
    "2 teaspoons garlic salt",
    "2 teaspoons ground black pepper",
    "0.25 teaspoon ground cumin",
    "0.5 cup all-purpose flour",
    "3 potatoes, peeled and cubed",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Pour the water into a large pot over high heat and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, in a large bowl, combine the ground beef, rice, egg, oregano, garlic salt, ground black pepper and cumin. Mix well and form into 1 inch meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll the meatballs in the flour, coating well, and carefully drop them in the boiling water. Reduce heat to low and simmer for 45 minutes, stirring frequently, and making sure soup does not get too thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add more water, if necessary, and add the potatoes to the soup. Simmer for 1 more hour, or until potatoes are tender. Season with salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
