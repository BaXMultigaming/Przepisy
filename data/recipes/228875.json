  "ingredients": [
    "1 pound whole Brussels sprouts",
    "4 slices bacon, cut into 1/2-inch pieces",
    "0.5 teaspoon salt",
    "0.25 teaspoon freshly ground black pepper",
    "0.25 cup extra-virgin olive oil",
    "3 tablespoons pure maple syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a rimmed baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sNjGZzXvslXzpUhWQwFK-n_cNZQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228875-maple-roasted-brussels-sprouts-with-bacon-VAT-007-step-01-f2b4a5bf7491451d8be137e27ece1bb0.jpg"
      ],
      "image": "assets/images/228875/step_01.webp"
    },
    {
      "text": "Trim and clean Brussels sprouts; halve any large ones. Transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vdCpI0ZJw5P6lf9jTZNr0gmtJh0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228875-maple-roasted-brussels-sprouts-with-bacon-VAT-008-step-02-9ce89af4dac84badac1870e02132948d.jpg"
      ],
      "image": "assets/images/228875/step_02.webp"
    },
    {
      "text": "Add bacon, salt, and pepper; dizzle in oil and syrup. Toss until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QuTrZkNxvdoVw6K16KzH5E4mnTY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228875-maple-roasted-brussels-sprouts-with-bacon-VAT-009-step-03-b4bdfa8a74a84d71ab7252bc3cc7ac9c.jpg"
      ],
      "image": "assets/images/228875/step_03.webp"
    },
    {
      "text": "Transfer to the prepared baking sheet in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yq6mM6zmLOU6jp69qYHkL06gn_E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228875-maple-roasted-brussels-sprouts-with-bacon-VAT-010-step-04-2001b5414606483a84233f54a367e274.jpg"
      ],
      "image": "assets/images/228875/step_04.webp"
    },
    {
      "text": "Roast in the preheated oven until bacon is crispy and Brussels sprouts are caramelized, 20 to 30 minutes, stirring halfway through.",
      "section": null,
      "name": null,
      "url": null,
