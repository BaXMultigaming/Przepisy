  "ingredients": [
    "1 tablespoon olive oil",
    "1 small onion, chopped",
    "1 pound ground beef",
    "1 (12 ounce) can corn, drained",
    "1 (14 ounce) can black beans",
    "1 cup biscuit baking mix (such as Bisquick®)",
    "0.5 cup milk",
    "0.5 cup shredded sharp Cheddar cheese",
    "1 egg",
    "2 tablespoons diced jalapeno peppers",
    "0.5 cup salsa",
    "0.5 cup sour cream"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat. Add onion; cook and stir until softened, about 5 minutes. Add beef; cook and stir until no longer pink, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour onion and beef mixture into an ungreased 8-inch baking dish. Layer corn and black beans on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir biscuit baking mix, milk, Cheddar cheese, egg, and jalapeno peppers together in a bowl until well-blended. Pour evenly over black beans in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve topped with salsa and sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
