  "title": "Spicy Black Bean Taco Bake",
  "description": "Ground beef, corn, and black beans are layered under a spicy biscuit topping in this taco-inspired bake perfect for a weeknight dinner.",
  "authors": [
    "Mathilda Dayan Haniffy"
  ],
  "date_published": "2019-04-03T02:32:20-04:00",
