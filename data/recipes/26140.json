  "ingredients": [
    "3 cups biscuit baking mix",
    "0.33333334326744 cup white sugar",
    "1 teaspoon pumpkin pie spice",
    "0.75 teaspoon ground ginger",
    "0.5 cup molasses",
    "0.5 cup applesauce",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).Grease a cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the baking mix, white sugar, pumpkin pie spice and ginger. Mix in the molasses, applesauce and egg until the mixture forms a ball. Turn out onto a lightly floured surface and knead for 10 turns. Place onto the prepared cookie sheet and pat into a 10 inch circle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 minutes in the preheated oven. Cut into wedges while still warm and serve with vanilla ice cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
