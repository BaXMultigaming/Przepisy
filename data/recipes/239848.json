  "ingredients": [
    "cooking spray",
    "8 frozen hash brown patties",
    "4 cups shredded Cheddar cheese",
    "1 pound cooked ham, cut into cubes",
    "7 large eggs",
    "1 cup milk",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground mustard"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B6k2cKqmzDAM6bvbHOWkSUtnv2s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239848-wake-up-casserole-VAT-step-01-f022f739a9c24bd2a4b7f33800a9bc35.jpg"
      ],
      "image": "assets/images/239848/step_01.webp"
    },
    {
      "text": "Arrange hash brown patties in the prepared baking dish. Sprinkle Cheddar cheese and ham over patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z8qyVAFnba1N0W19Hf3gpmSTXJU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239848-wake-up-casserole-VAT-step-02-3cacb11f1e0e42d1af9285c6f887449f.jpg"
      ],
      "image": "assets/images/239848/step_02.webp"
    },
    {
      "text": "Whisk together eggs, milk, salt, and mustard in a large bowl until well combined; pour over ham. Cover the baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Szz6UjMX4PuZQID-83qiUylRVKY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239848-wake-up-casserole-VAT-step-03-467fbfe9aa9a45cc8f05a6636d9ce543.jpg"
      ],
      "image": "assets/images/239848/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Remove foil and continue baking until the edges are golden brown and a knife inserted into the center comes out clean, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
