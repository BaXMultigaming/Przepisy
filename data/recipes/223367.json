  "ingredients": [
    "4 large fresh peaches - peeled, pitted, and sliced",
    "1 cup hot water",
    "0.5 cup light brown sugar",
    "1 pinch ground cinnamon",
    "2.5 cups dry white wine",
    "0.5 cup triple sec liqueur",
    "1 (750 milliliter) bottle sparkling white wine, chilled"
  ],
  "steps": [
    {
      "text": "Place peaches, water, sugar, and cinnamon in a blender or the bowl of a food processor; blend until smooth. Transfer mixture to a pitcher; stir in dry white wine and triple sec. Cover the pitcher; chill in the refrigerator for at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain peach mixture through a large cheesecloth-lined sieve; squeeze cloth to extrude all juice. Pour juice into a large pitcher; stir in sparkling wine.",
