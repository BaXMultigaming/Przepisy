  "ingredients": [
    "2 pounds sliced frozen peaches, thawed",
    "1.5 cups white sugar",
    "0.5 cup dried lavender flowers",
    "3 cups water",
    "3 tablespoons lemon juice"
  ],
  "steps": [
    {
      "text": "Place peaches and sugar in a blender or the bowl of a food processor; purée until smooth. Transfer purée to a large bowl; stir in lavender blossoms until incorporated. Let stand at room temperature for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water and lemon juice into purée mixture until well combined; refrigerate until cold, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour chilled purée mixture into a 6-quart ice cream maker and freeze according to manufacturer’s instructions. Transfer to an airtight container and store in the freezer until firm or desired consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
