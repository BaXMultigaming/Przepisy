  "ingredients": [
    "2 tablespoons olive oil",
    "4 tablespoons chopped onion",
    "1 teaspoon minced garlic",
    "1 teaspoon lemon juice",
    "4 tablespoons white wine",
    "1.25 cups white clam sauce",
    "0.5 teaspoon crushed red pepper",
    "8 ounces pasta"
  ],
  "steps": [
    {
      "text": "Begin preparing pasta. While preparing pasta, saute onions and garlic in olive oil. Add all ingredients except can of clam sauce. Heat on medium. Once mixture is heated, reduce heat to medium low and add clam sauce. Heat slowly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once pasta is done, combine with sauce mixture and garnish with parmesan cheese. Enjoy!",
