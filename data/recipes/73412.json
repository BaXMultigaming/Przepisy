  "total_time": "PT100M",
  "yield": [
    "32",
    "2 1/2 pounds of toffee"
  ],
  "categories": [
    "Candy"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "2 cups unsalted butter",
    "2 cups white sugar",
    "0.25 teaspoon salt",
    "2 cups semisweet chocolate chips",
    "1 cup finely chopped almonds"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5nCxUM9BfOVj-2qnMYFMu7Hgzu4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-73412-Best-Toffee-Ever-Step-01-02fe8a6c4b114d7193bfe5e27023e60e.jpg"
      ],
      "image": "assets/images/73412/step_01.webp"
    },
    {
      "text": "Combine butter, sugar, and salt in a large, heavy-bottomed saucepan over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iS1oKvMD46UinoeOWg-QawYlg_w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-73412-Best-Toffee-Ever-Step-02-72ff333a3bd7456b8a8b4429f0352656.jpg"
      ],
      "image": "assets/images/73412/step_02.webp"
    },
    {
      "text": "Stir constantly in one direction until butter is melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8ejzM8ggib6MFCam95OGUMwhY9k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-73412-Best-Toffee-Ever-Step-02-1-7ccd94d64d67493fb6d77cb62d5f091e.jpg"
      ],
      "image": "assets/images/73412/step_03.webp"
    },
    {
      "text": "Meanwhile, line a 9x13-inch baking dish with a sheet of parchment paper, letting it overhang two sides of the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BMaUo9Mo2f7SnAzV0bFW7ZPMUMg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-73412-Best-Toffee-Ever-Step-03-7d979bbdd25b4af4908e81c173686cd2.jpg"
      ],
      "image": "assets/images/73412/step_04.webp"
    },
    {
      "text": "Once the butter has melted, stop stirring and bring mixture to a boil. Once boiling, cook, stirring only 2 to 3 times, until it turns a dark amber color and the temperature reaches 300 degrees F (150 degrees C) on a candy thermometer, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8Mlk1yNz7nxDk5C4OG89NeUDRNY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-73412-Best-Toffee-Ever-Step-05-ff6e2a6c6ac242948d8eba0de7c13186.jpg"
      ],
      "image": "assets/images/73412/step_05.webp"
    },
    {
      "text": "Immediately pour toffee into the prepared baking dish. Sprinkle chocolate chips on top and let sit until they soften, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MSSmdr2qFnTJLDKJoyGP71FnQQ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-73412-Best-Toffee-Ever-Step-07-09506cc09a9a4071b925188513ddfc46.jpg"
      ],
      "image": "assets/images/73412/step_06.webp"
    },
    {
      "text": "Use a spatula to spread softened chocolate into a thin, even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WAbUxwCc27ZBHYMb6cExxOasrwc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-73412-Best-Toffee-Ever-Step-08-bdb616f3afbe49688e9dd8ee392bb52d.jpg"
      ],
      "image": "assets/images/73412/step_07.webp"
    },
    {
      "text": "Sprinkle nuts over the chocolate and press down slightly; wearing a plastic bag over your hand will minimize the mess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/buDP_Iv90e0vulwZT4n2qrR5vYU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-73412-Best-Toffee-Ever-Step-09-3c840ac31363419db94e4df29f2d3219.jpg"
      ],
      "image": "assets/images/73412/step_08.webp"
    },
    {
      "text": "Place toffee in the refrigerator until set, about 1 hour. Lift hardened toffee out of the baking dish with the parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eAzZuhV75uMYReky5Ony33eMQNg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-73412-Best-Toffee-Ever-Step-10-2-ac843e3f579c4c7aa90ed9c61fed8b6c.jpg"
      ],
      "image": "assets/images/73412/step_09.webp"
    },
    {
      "text": "Break into pieces and store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CYepGDVzW15Q-rBIZkmxr_IonLk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/73412-best-toffee-ever-super-easy-mfs445-1-f0be2d4a336f42468eccd45bdecf5f94.jpg"
      ],
      "image": "assets/images/73412/step_10.webp"
    }
  ],
