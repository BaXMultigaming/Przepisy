  "ingredients": [
    "1 pound ground beef",
    "0.5 pound ground pork",
    "0.5 pound ground veal",
    "2 teaspoons salt",
    "0.5 teaspoon ground black pepper",
    "2 eggs",
    "0.33333334326744 cup finely chopped onion",
    "0.5 cup heavy cream",
    "1 cup dry bread crumbs",
    "1 cup butter",
    "0.25 cup all-purpose flour",
    "2 cups chicken broth",
    "2 cups sour cream",
    "0.25 cup chopped fresh dill"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix beef, pork, veal, salt, pepper, eggs, onion and heavy cream. With moistened hands, shape the mixture into 1 inch balls. Roll the balls in the bread crumbs until all balls are well coated. Arrange in a single layer on a large, shallow baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1/2 cup butter in a large saucepan over low heat. Stir in the flour. Gradually stir in the chicken broth. Continue stirring until thickened and bubbly, then blend in the sour cream and fresh dill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt remaining butter in a small saucepan, and drizzle over the meatballs. Bake meatballs in the preheated oven 35 minutes, turning occasionally, until evenly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place meatballs in a chafing dish and cover with the sauce to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
