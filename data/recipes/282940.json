  "ingredients": [
    "1 medium onion, chopped",
    "4 slices bacon, chopped",
    "2 bunches turnip greens, chopped",
    "0.5 cup strong brewed coffee",
    "0.25 cup balsamic vinegar",
    "1 pinch garlic powder, or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Cook onion and bacon in a large skillet over medium heat, covered, turning occasionally, until onion is translucent and bacon is evenly browned, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add turnip greens to the skillet, a handful at a time if necessary; cook until wilted down, 5 to 7 minutes. Add coffee, vinegar, garlic powder, salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Taste cooking liquid; adjust seasonings if necessary. Reduce heat to low or medium-low, cover, and simmer for 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Uncover skillet; cook until liquid has reduced and greens are tender, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
