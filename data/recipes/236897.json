  "ingredients": [
    "4 eggs, beaten",
    "0.66666668653488 cup wheat berries",
    "0.5 cup almond milk",
    "0.33333334326744 cup oats",
    "3 tablespoons coconut oil, softened",
    "2 tablespoons vanilla extract",
    "2 tablespoons white sugar",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon ground mace",
    "1 pinch salt",
    "1 cup cottage cheese"
  ],
  "steps": [
    {
      "text": "Blend eggs, wheat berries, almond milk, oats, coconut oil, and vanilla extract together in a blender until smooth, 45 to 50 seconds. Add sugar, cinnamon, baking soda, cloves, mace, and salt; pulse blender until the dry ingredients are incorporated into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into a large bowl and fold cottage cheese into the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium heat and coat with cooking spray. Pour about 1/4 cup batter onto the skillet and cook until bubbles appear on the surface, 2 to 3 minutes. Flip with a spatula and cook until browned on the other side, about 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
