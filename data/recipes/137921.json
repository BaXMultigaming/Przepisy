  "ingredients": [
    "3 tablespoons soy sauce",
    "1 tablespoon orange juice",
    "1 teaspoon hot pepper sauce, or to taste",
    "1 teaspoon vanilla extract",
    "1 tablespoon light brown sugar",
    "1 tablespoon honey",
    "0.5 teaspoon minced garlic",
    "0.5 tablespoon garlic powder",
    "0.5 teaspoon Italian seasoning",
    "0.5 teaspoon sesame oil",
    "0.5 cup vegetable oil",
    "2 pounds skinless, boneless chicken breast meat - cut into strips"
  ],
  "steps": [
    {
      "text": "Stir together soy sauce, orange juice, hot pepper sauce, vanilla, brown sugar, and honey until dissolved. Season with minced garlic, garlic powder, and Italian seasoning. Whisk in sesame oil and vegetable oil until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss chicken with marinade, cover, and refrigerate for at least 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Adjust oven rack to its top position, and turn oven on to Broil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken into a baking dish or baking sheet. Broil until golden brown, 5 to 8 minutes. Turn chicken over, and continue broiling until no longer pink, about 5 minutes more.",
