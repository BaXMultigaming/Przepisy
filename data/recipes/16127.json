  "ingredients": [
    "1 (20 ounce) can pineapple chunks",
    "2 cups miniature marshmallows",
    "1.5 tablespoons white wine vinegar",
    "0.5 cup white sugar",
    "1 egg, beaten",
    "1 tablespoon all-purpose flour",
    "2 cups chopped red apple",
    "1.5 cups raw Spanish peanuts",
    "1 (8 ounce) container frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Drain Pineapple juice into medium saucepan. Combine pineapple chunks and marshmallows into bowl and refrigerate.",
      "section": null,
