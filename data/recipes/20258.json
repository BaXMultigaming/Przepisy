  "ingredients": [
    "0.5 cup butter",
    "1 cup superfine sugar",
    "1.25 cups heavy cream",
    "4 bananas, peeled and halved lengthwise"
  ],
  "steps": [
    {
      "text": "Melt butter in a large, heavy skillet over medium heat. Stir in sugar and cook, stirring, until sugar is melted and light brown. Slowly stir in the cream (mixture will bubble up).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let mixture boil for 1 minute, then reduce heat to low. Carefully add bananas to the pan and cook until just heated through, about 2 minutes. Serve hot.",
      "section": null,
