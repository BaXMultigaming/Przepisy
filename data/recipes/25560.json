  "ingredients": [
    "4 eggs",
    "2 cups white sugar",
    "0.5 cup all-purpose flour",
    "0.5 cup unsweetened cocoa",
    "0.5 teaspoon salt",
    "1 cup butter, melted",
    "2 teaspoons vanilla extract",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease and flour an 8x8 inch pan. In a food processor or blender, beat eggs for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the sugar, flour, cocoa and salt. Slowly beat in the whipped eggs. Beat in the butter and vanilla. Stir in the chopped pecans. Spread batter in prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 to 50 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
