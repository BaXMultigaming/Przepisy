  "ingredients": [
    "3 tablespoons salted butter",
    "1 cup diced onion",
    "0.5 pound ground turkey sausage",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon red pepper flakes",
    "3 tablespoons all-purpose flour",
    "2 cups whole milk"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium-low heat. Add onion; cook and stir until softened and translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sausage, black pepper, salt, garlic powder, and pepper flakes; cook and stir until sausage is browned and crumbly, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour until well blended; cook about 2 minutes. Increase heat to medium. Slowly stir in milk; cook and stir until gravy thickens and is heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
