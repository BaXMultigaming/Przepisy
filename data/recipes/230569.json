  "title": "Chef John's Patatas Bravas",
  "description": "Patatas bravas are a classic Spanish tapa dish of hot and crispy fried potatoes with spicy seasoning, drizzled with a creamy tomato and paprika sauce.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-12-17T17:17:30-05:00",
