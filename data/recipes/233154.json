  "ingredients": [
    "2 (8.5 ounce) packages corn bread mix (such as Jiffy®)",
    "0.5 cup milk",
    "0.5 cup sour cream",
    "2 large eggs",
    "3 tablespoons honey",
    "2 tablespoons white sugar",
    "3 tablespoons melted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 12 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cornbread mix, milk, sour cream, eggs, and honey in a large bowl until well combined yet slightly lumpy; allow batter to rest for 5 minutes. Fill the prepared muffin cups with batter, about 3/4 full. Lightly sprinkle each muffin with sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush tops with melted butter 2 to 3 times. Serve warm or cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
