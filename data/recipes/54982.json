  "ingredients": [
    "1 egg",
    "0.5 cup honey",
    "0.66666668653488 cup white sugar",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon ground cinnamon",
    "1 cup chopped canned plums",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, blend the egg, honey, sugar, and vanilla. Mix in the flour, baking soda, cloves, and cinnamon. Fold in the plums and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the batter to the prepared loaf pan, and bake 50 to 60 minutes in the preheated oven, until a toothpick inserted in the center of the loaf comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
