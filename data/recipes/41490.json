  "ingredients": [
    "1 (9 ounce) package cheese tortellini",
    "1 small red bell pepper, julienned",
    "0.75 cup broccoli florets, blanched",
    "0.33333334326744 cup shredded carrots",
    "0.33333334326744 cup pitted green olives",
    "1 clove garlic, chopped",
    "0.5 cup mayonnaise",
    "0.25 cup prepared basil pesto",
    "0.25 cup milk",
    "2 tablespoons grated Parmesan cheese",
    "1 tablespoon olive oil",
    "1 tablespoon distilled white vinegar",
    "1 bunch fresh spinach leaves"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1UWf8a1JsNNE5bIdfmwrEWZvw_Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/41490-tortellini-pesto-salad-ddmfs-step1-0729-f31356c5066342e19d9f1fc3a101bb06.jpg"
      ],
      "image": "assets/images/41490/step_01.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Place tortellini in the pot and cook until al dente, 7 to 8 minutes. Drain and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cooked tortellini, bell pepper, broccoli, carrots, olives, and garlic in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mPaXVtgaKxqvTb6iQr2Bmel4VG4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/41490-tortellini-pesto-salad-ddmfs-step2-0730-154cef6f63dd429a92e3e28fde1be142.jpg"
      ],
      "image": "assets/images/41490/step_03.webp"
    },
    {
      "text": "Whisk mayonnaise, pesto, milk, Parmesan cheese, oil, and vinegar together in a separate bowl. Pour over tortellini and vegetables and gently toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yKrpVlOlw4JAm_ZuuNyTSA1G32w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/41490-tortellini-pesto-salad-ddmfs-step4-0733-c3dff213b02f4a0a866dd1d39ad9bf9a.jpg"
      ],
      "image": "assets/images/41490/step_04.webp"
    },
    {
      "text": "For best flavor results, cover and place in the refrigerator until chilled. Serve over spinach leaves.",
      "section": null,
      "name": null,
      "url": null,
