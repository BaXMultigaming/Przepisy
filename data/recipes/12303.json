  "ingredients": [
    "1.3333333730698 cups finely chopped peanuts",
    "3 tablespoons margarine, melted",
    "2 tablespoons white sugar",
    "0.25 cup peanut butter",
    "0.25 cup light corn syrup",
    "0.25 cup flaked coconut",
    "3 tablespoons chopped peanuts",
