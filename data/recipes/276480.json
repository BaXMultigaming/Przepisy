  "ingredients": [
    "2 teaspoons butter",
    "2 tablespoons minced garlic",
    "2 teaspoons water",
    "2 cups sliced fresh mushrooms",
    "2 (1 inch) thick slices cooked leftover prime rib, cut into 1-inch cubes",
    "1.5 cups leftover mashed potatoes, or more to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Add garlic and water; cook and stir for 1 minute. Add mushrooms and cover skillet; cook, stirring occasionally, until mushrooms are tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add prime rib and mashed potatoes; reduce heat to low. Cook, stirring occasionally, until heated through, 5 to 7 minutes. Season with salt and black pepper.",
      "section": null,
