  "ingredients": [
    "1 tablespoon vegetable oil",
    "0.5 cup chopped onions",
    "0.5 cup chopped celery",
    "1 pound imitation crabmeat",
    "1 (10.5 ounce) can condensed cream of celery soup",
    "0.5 cup water",
    "2 tablespoons chopped fresh parsley",
    "0.25 teaspoon seafood seasoning",
    "0.25 teaspoon salt",
    "0.125 teaspoon garlic powder",
    "0.125 teaspoon ground black pepper",
    "1 cup shredded Cheddar cheese",
    "1 cup dry bread crumbs",
    "0.25 cup salted butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large saucepan over medium heat; stir in onions and celery. Cook and stir until vegetables have softened and are beginning to turn translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add crab, condensed soup, water, parsley, seafood seasoning, salt, garlic powder, and pepper; mix to combine. Heat until almost bubbling, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat and blend in Cheddar cheese until melted. Transfer to a 9-inch square casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs and melted butter in a small bowl with a fork until combined. Spread over the casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned and bubbly, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
