  "ingredients": [
    "1 (9 x 13 inch) pan cornbread, crumbled",
    "2 cups chopped onion",
    "2 cups chopped celery",
    "0.5 cup butter, melted",
    "1 (10.75 ounce) can cream of chicken soup",
    "1 (10.75 ounce) can cream of mushroom soup",
    "2 eggs, beaten",
    "2 teaspoons dried sage",
    "1.5 teaspoons salt",
    "1 teaspoon poultry seasoning",
    "0.5 teaspoon ground black pepper",
    "1.5 cups chicken broth, or more as needed",
    "3 cups coarsely shredded cooked chicken"
  ],
  "steps": [
    {
      "text": "Combine crumbled cornbread, onion, celery, and butter in a large bowl. Gently stir in chicken soup, mushroom soup, eggs, sage, salt, poultry seasoning, and black pepper until thoroughly combined. Pour chicken broth over dressing to moisten.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer 1/2 dressing into a slow cooker, spread 1/2 cooked chicken over dressing, layer remaining 1/2 dressing over chicken, and top with remaining 1/2 chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover slow cooker. Cook on High for 45 minutes. Reduce heat to Low; cook at least 5 hours more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
