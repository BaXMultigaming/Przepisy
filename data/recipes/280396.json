  "ingredients": [
    "0.66666668653488 cup white sugar",
    "0.25 cup unsalted butter, softened",
    "0.5 teaspoon salt",
    "2 large eggs",
    "1.25 teaspoons vanilla extract",
    "0.5 teaspoon almond extract",
    "0.75 cup unbleached all-purpose flour",
    "0.75 cup whole wheat pastry flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "1.5 cups shredded carrot",
    "0.33333334326744 cup milk",
    "0.33333334326744 cup currants",
    "0.33333334326744 cup chopped almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar, butter, and salt together in a bowl with an electric mixer until combined. Add eggs, 1 at a time, then vanilla and almond extracts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all-purpose flour, whole wheat pastry flour, baking soda, and baking powder together in a medium bowl. Add to butter-egg mixture in 3 additions, alternating with carrots and milk in 2 additions. Stir in currants and almonds; the batter will be quite wet. Pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
