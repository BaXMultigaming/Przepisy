  "ingredients": [
    "1 cup white sugar",
    "0.5 cup orange juice",
    "0.25 cup triple sec",
    "0.25 cup water",
    "12 ounces fresh cranberries, rinsed",
    "0.5 cup chopped walnuts, or to taste"
