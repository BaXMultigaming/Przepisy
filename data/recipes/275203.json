  "ingredients": [
    "1.5 cups strawberry preserves",
    "1.25 cups tomato puree",
    "0.5 cup pomegranate-infused red wine vinegar (such as Pompeian®)",
    "0.25 cup light brown sugar",
    "1 tablespoon chili powder",
    "1 tablespoon red pepper flakes",
    "1 tablespoon ground cumin",
    "2 teaspoons cayenne pepper",
    "2 teaspoons ground black pepper",
    "kosher salt to taste"
  ],
  "steps": [
    {
      "text": "Combine strawberry preserves, tomato puree, vinegar, sugar, chili powder, red pepper flakes, cumin, cayenne, and black pepper in a medium pot. Whisk to remove any lumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring strawberry mixture to a slow simmer over medium-low heat. Cook until sauce evenly coats the back of a metal spoon and is glossy, about 30 minutes, whisking frequently; never allow the bottom of the pot to scorch. Season with kosher salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove sauce from heat and let cool before transferring to a tightly sealed quart-sized container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
