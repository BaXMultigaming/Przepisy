  "ingredients": [
    "1 (3.5 ounce) package cook and serve butterscotch pudding mix",
    "0.5 cup butter",
    "0.5 cup packed brown sugar",
    "1 egg",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "1.5 teaspoons ground ginger",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "In a medium bowl, cream together the dry butterscotch pudding mix, butter, and brown sugar until smooth. Stir in the egg. Combine the flour, baking soda, ginger, and cinnamon; stir into the pudding mixture. Cover, and chill dough until firm, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease baking sheets. On a floured board, roll dough out to about 1/8 inch thickness, and cut into man shapes using a cookie cutter. Place cookies 2 inches apart on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 to 12 minutes in the preheated oven, until cookies are golden at the edges. Cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
