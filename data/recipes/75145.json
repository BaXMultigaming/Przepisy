  "ingredients": [
    "12 3 to 4 inch long pickling cucumbers",
    "2 cups water",
    "1.75 cups white vinegar",
    "1.5 cups chopped fresh dill weed",
    "0.5 cup white sugar",
    "8 cloves garlic, chopped",
    "1.5 tablespoons coarse salt",
    "1 tablespoon pickling spice",
    "1.5 teaspoons dill seed",
    "0.5 teaspoon red pepper flakes, or to taste",
    "4 sprigs fresh dill weed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b9oeugiFB60hyZXtwfaTYFyL5NQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/75145_SpicyRefrigeratorDillPickles_ddmfs_Step1_3x4_3679-feb07ca4346d4e6888442921f3956cc3.jpg"
      ],
      "image": "assets/images/75145/step_01.webp"
    },
    {
      "text": "Combine cucumbers, water, vinegar, chopped dill, sugar, garlic, salt, pickling spice, dill seed, and red pepper flakes in a large bowl. Stir and let sit at room temperature until sugar and salt dissolve, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TFDTnykHyPtwjgiiGZxG5XT7nTQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/75145_SpicyRefrigeratorDillPickles_ddmfs_Step2_3x4_3681-6869edf4d66d43a0955a147dde99fbfe.jpg"
      ],
      "image": "assets/images/75145/step_02.webp"
    },
    {
      "text": "Transfer cucumbers to 3 wide-mouth, 1 1/2-pint jars, placing 4 cucumbers into each jar. Add enough vinegar mixture to cover cucumbers. Place 1 sprig of fresh dill into each jar and seal with lids. Refrigerate for 10 days before eating. Use within 1 month.",
      "section": null,
      "name": null,
