  "ingredients": [
    "1 (32 ounce) package frozen bite-size potato nuggets (such as Tater Tots®)",
    "2 pounds boneless skinless chicken breasts, cubed",
    "1.5 teaspoons celery seed",
    "1 tablespoon olive oil",
    "0.66666668653488 cup buffalo wing sauce",
    "1 cup shredded Monterey Jack cheese",
    "0.5 cup ranch dressing"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread potato nuggets in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place chicken in a large bowl. Add celery seed and olive oil; stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Add chicken and cook until golden brown on all sides, about 15 minutes. Turn heat off and add wing sauce; stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove potatoes from the oven. Set an oven rack about 6 inches from the heat source and preheat the oven's broiler to low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon chicken mixture evenly over potatoes and top with Monterey Jack cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until cheese is melted, about 5 minutes. Remove and drizzle ranch dressing over the top. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
