  "ingredients": [
    "cooking spray",
    "3 skinless, boneless chicken breasts, cut into strips",
    "salt and ground black pepper to taste",
    "0.5 cup all-purpose flour",
    "2 teaspoons Italian seasoning",
    "1 teaspoon ground paprika",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion powder",
    "3 eggs",
    "1 cup bread crumbs",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken strips with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, Italian seasoning, paprika, garlic powder, and onion powder in a resealable plastic bag. Add chicken strips and seal the bag. Shake the bag until chicken strips are well coated with the flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs together in a small bowl. Combine bread crumbs and Parmesan cheese in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each chicken strip into egg until well coated, then dip in bread crumb mixture to coat. Place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, flipping halfway, until golden brown and no longer pink in the center, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
