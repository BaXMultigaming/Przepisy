  "ingredients": [
    "1 (1 ounce) package McCormick® Grill Mates® Baja Citrus Marinade",
    "0.5 cup mango nectar or orange juice",
    "2 tablespoons honey",
    "2 tablespoons lime juice",
    "1 (12 ounce) can canned ham, such as Spam® Classic, cut into small cubes",
    "4 cups finely chopped fresh pineapple",
    "0.5 cup finely chopped red onion",
    "1 jalapeño pepper, finely chopped",
    "0.5 cup chopped macadamia nuts"
  ],
  "steps": [
    {
      "text": "Mix Marinade Mix, mango nectar, honey and lime juice in large bowl. Remove 1/4 cup of the marinade mixture; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook cubed canned ham and 1/4 cup of the reserved marinade mixture in large skillet on medium heat until lightly browned. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pineapple, onion and jalapeno into remaining marinade mixture in large bowl until well blended. Top with ham mixture. Sprinkle with nuts. Serve dip with tortilla chips.",
      "section": null,
