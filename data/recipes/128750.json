    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook Chinese broccoli in boiling water, uncovered, until just tender, about 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SLquWwS8U4VxohOrJKp1PUwvjck=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-128750-chinese-broccoli-step-2-d96499caf1144807812eab78491db2c7.jpg"
      ],
      "image": "assets/images/128750/step_02.webp"
    },
    {
      "text": "Drain and place in a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XgKvx2ifP66k4f5R1tCNiqhGZIc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-128750-chinese-broccoli-step-3-1402e8dc7147482c81a762fcb658805d.jpg"
