  "ingredients": [
    "1 cup rice flour",
    "1 cup cooked rice",
    "0.75 cup white sugar",
    "0.5 cup applesauce",
    "2 tablespoons vegetable oil",
    "1 teaspoon vanilla extract",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking powder",
    "1 cup shredded zucchini"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a muffin tin or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat rice flour, rice, sugar, applesauce, vegetable oil, vanilla extract, baking soda, cinnamon, salt, and baking powder in a large bowl with an electric mixer for 2 minutes. Add zucchini and blend for 1 minute. Fill muffin cups about 2/3 full with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until muffins are browned on top and a toothpick inserted in the center comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
