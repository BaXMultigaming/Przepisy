  "ingredients": [
    "8 ounces dry fettuccine pasta",
    "4.5 tablespoons butter",
    "2.5 tablespoons all-purpose flour",
    "2 cups milk",
    "1 teaspoon minced garlic",
    "5 drops hot pepper sauce",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Cook pasta in a large pot of boiling salted water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter or margarine in a saucepan. Stir in flour. Whisk in milk, garlic, and hot sauce; stir until thickened. Stir in cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta. Serve sauce over noodles.",
