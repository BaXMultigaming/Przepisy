  "ingredients": [
    "1 tablespoon olive oil",
    "1 tablespoon lime juice",
    "1 teaspoon chili powder",
    "1 teaspoon ground cumin",
    "1 teaspoon sea salt",
    "0.25 teaspoon garlic powder",
    "1 (15 ounce) can chickpeas, drained",
    "1 small head cauliflower, cut into bite-sized pieces",
    "1 cup sour cream (such as Daisy®)",
    "0.25 cup chopped fresh cilantro",
    "0.125 cup lime juice",
    "1 tablespoon Sriracha",
    "salt to taste",
    "6 (6 inch) corn tortillas"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 370 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together olive oil, lime juice, chili powder, cumin, salt, and garlic powder in a large bowl. Add chickpeas and cauliflower and stir until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together sour cream, cilantro, lime juice, and Sriracha in a bowl until evenly combined. Season with salt to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cauliflower mixture in the basket of the air fryer. Cook for 10 minutes, stir, and cook for another 10 minutes. Stir once more and cook until desired crispness, about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon cauliflower mixture into corn tortillas and top with sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
