  "ingredients": [
    "0.33333334326744 cup honey",
    "6 cloves garlic",
    "4 chipotle peppers in adobo sauce",
    "6 skinless, boneless chicken breasts, or more to taste",
    "2 (15 ounce) cans black beans, drained and rinsed"
  ],
  "steps": [
    {
      "text": "Blend honey, garlic, and chipotle peppers in adobo sauce together in a food processor until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken breasts in the bottom of a slow cooker and mix in honey-chipotle sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the slow cooker on Low for 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken to a bowl and shred using 2 forks. Return chicken to the slow cooker and stir in black beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue to cook on Low until cooked through, about 30 minutes more.",
      "section": null,
