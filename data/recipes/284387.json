  "ingredients": [
    "2 cups water",
    "0.5 cup cane sugar",
    "1 cup light corn syrup",
    "0.66666668653488 cup freshly squeezed lemon juice"
  ],
  "steps": [
    {
      "text": "Combine water and sugar in a saucepan over medium-high heat; bring to a boil. Reduce heat to low; simmer for 5 minutes. Off heat, stir in light corn syrup and lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool to room temperature, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide cooled mixture among 3 plastic containers; freeze for 1 hour. Scrape ice crystals with a fork; freeze until ice is semi-frozen, 1 to 2 hours more, scraping ice crystals every 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop Italian ice into small serving cups or cones.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
