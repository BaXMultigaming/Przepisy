  "ingredients": [
    "1 cup dry potato flakes",
    "1 cup boiling water",
    "1 egg, beaten",
    "1 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Place potato flakes in a medium-size bowl. Pour in boiling water; stir until blended. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in egg, salt, and pepper. Blend in enough flour to make a fairly stiff dough. Turn dough out on a well floured board. Knead lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough in half. Shape each half into a long thin roll, the thickness of a breadstick. With a knife dipped in flour, cut into bite-size pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a few gnocchi in boiling water. As the gnocchi rise to the top of the pot, remove them with a slotted spoon. Repeat until all are cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
