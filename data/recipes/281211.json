  "ingredients": [
    "1 slice sharp Cheddar cheese",
    "1 slice mozzarella cheese",
    "2 thick bread slices",
    "1 pinch dried oregano, or to taste",
    "1 pinch salt and ground black pepper to taste",
    "2 tablespoons salted butter, at room temperature",
    "1 tablespoon chopped fresh parsley, or to taste",
    "1 teaspoon chopped fresh chives, or to taste"
  ],
  "steps": [
    {
      "text": "Assemble the sandwich by placing Cheddar and mozzarella cheese on the bread. Season with oregano, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a pan over medium-low heat. Add sandwich and cook until cheeses melt, 3 to 5 minutes, increasing heat if needed. Flip and cook until golden brown, 3 to 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut in half and top with parsley and chives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
