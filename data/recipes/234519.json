  "ingredients": [
    "4 large sweet potatoes, cut into cubes",
    "cooking spray",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 lemon, juiced",
    "3 tablespoons olive oil",
    "2 tablespoons brown sugar",
    "1 teaspoon sea salt",
    "0.5 teaspoon ground black pepper",
    "2 large mangoes - peeled, seeded, and chopped",
    "0.75 cup minced onion",
    "0.75 cup chopped fresh cilantro",
    "1 large avocado - peeled, pitted, and chopped",
    "1 green onion, chopped",
    "0.5 habanero pepper, seeded and minced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread sweet potatoes onto a baking sheet; spray with cooking spray and season with 1/2 teaspoon salt and 1/2 teaspoon black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast potatoes in the preheated oven until soft, about 20 minutes. Transfer potatoes to a plate and refrigerate until cooled completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk lemon juice, olive oil, brown sugar, sea salt, and 1/2 teaspoon black pepper together in a bowl; let rest for at least 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chilled sweet potatoes, mangoes, onion, cilantro, avocado, green onion, and habanero pepper together in a large bowl. Drizzle dressing over potato mixture and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
