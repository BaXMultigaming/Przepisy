  "ingredients": [
    "0.5 cup butter, softened",
    "0.5 pound shredded sharp Cheddar cheese",
    "0.25 teaspoon salt",
    "1 pinch ground cayenne pepper",
    "1.125 cups all-purpose flour",
    "2 cups pecan halves"
  ],
  "steps": [
    {
      "text": "Blend the butter, cheese, salt and cayenne pepper together until well combined. Stir in the flour and mix well. Shape dough into 3 rolls about 1 1/2 inches in diameter. Wrap the rolls in plastic wrap and refrigerate until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut rolls into 1/8 to 1/4 inch thick slices. Place on a parchment paper lined baking sheet and press a pecan half or piece onto the top of each cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for about 12 minutes or until set. Let cool on wire wracks before storing in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
