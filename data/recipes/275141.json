    "Southern"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1.5 pounds pork rib tips",
    "1 tablespoon seasoned salt, or to taste",
    "aluminum foil",
    "0.75 cup barbecue sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Remove silver skin from the underside of rib tips if there. Rub seasoned salt all over meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a baking pan with aluminum foil; place seasoned meat into the pan. Cover tightly with another piece of foil and refrigerate for at least 4 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake foil-wrapped ribs in the preheated oven for 2 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the pan from the oven and increase oven temperature to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Uncover and drain the pan, if necessary. Brush barbecue sauce over ribs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flip ribs and brush with additional barbecue sauce; continue baking for another 15 minutes. Repeat this step two more times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut ribs into desired serving size, about 1 1/2 to 2 inches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn on the oven broiler. Set an oven rack about 6 inches from the heat source.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil ribs until slightly charred, 2 to 3 minutes. Watch carefully to make sure they do not burn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
