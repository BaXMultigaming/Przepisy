  "ingredients": [
    "1 (15 ounce) can kidney beans, drained and rinsed",
    "olive oil cooking spray",
    "1 teaspoon sea salt, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 325 degrees F (165 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray kidney beans with olive oil cooking spray and toss with sea salt. Spread out in a single layer in the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry until all of the kidney beans have split open and have become crisp, 25 to 30 minutes. Air-fry for 5 more minutes if they look under-toasted; they all should be varying degrees of brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow to cool and store in airtight container or sandwich bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
