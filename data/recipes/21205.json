  "ingredients": [
    "5.5 pounds apples - peeled, cored and finely chopped",
    "4 cups white sugar",
    "2 teaspoons ground cinnamon",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Place apples in a slow cooker. Combine sugar, cinnamon, cloves, and salt together in a medium bowl; pour over apples and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7nacU3JdLXP1e63G6B6bG2lAz6k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21205_AllDayAppleButter_step1_ddmfs_4x3_1214-9ec5d33469194f79b36c7b22d6d47ce0.jpg"
      ],
      "image": "assets/images/21205/step_01.webp"
    },
    {
      "text": "Cover and cook on High for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZcKTB9--rTMb2AfSFGd5d4QAs1s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21205_AllDayAppleButter_step2_ddmfs_4x3_-c84ee2ecaa6e4fbdb5c48af3648e19e4.jpg"
      ],
      "image": "assets/images/21205/step_02.webp"
    },
    {
      "text": "Reduce heat to Low and cook, stirring occasionally, until mixture is thick and dark brown, 9 to 11 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/12Rw2qOoUGypgB_wTQ_17PL8CK4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21205_AllDayAppleButter_step3_ddmfs_4x3_12141345-cca37bc51d944c1bb65d006e3ec401e5.jpg"
      ],
      "image": "assets/images/21205/step_03.webp"
    },
    {
      "text": "Uncover and continue cooking on Low for 1 hour. Whisk to make smooth, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon mixture into sterile containers, cover; refrigerate or freeze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
