  "ingredients": [
    "0.25 cup olive oil",
    "salt and pepper to taste",
    "6 baking potatoes",
    "0.5 cup shredded Cheddar cheese",
    "1 egg, beaten",
    "0.25 cup butter",
    "1 cup sliced green onions, divided",
    "0.5 cup milk",
    "paprika to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl combine oil, salt, and pepper. Rub potato skins with oil mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake potatoes (do not wrap in foil) in preheated oven for 50 to 60 minutes, or until soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove potatoes from the oven and slice skin off of tops. Scoop flesh into a large bowl, reserving intact skins. Add cheese, egg, butter, and 1/2 of the green onions to potatoes. Mash potatoes while gradually adding milk. Spoon mixture into reserved skins and top with remaining onions and paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for an additional 15 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
