  "ingredients": [
    "1 (14 ounce) can sweetened condensed milk",
    "1 cup chopped walnuts",
    "2 cups shredded coconut",
    "1 (6 ounce) package strawberry flavored Jell-O®",
    "1 (3 ounce) package strawberry flavored Jell-O®"
  ],
  "steps": [
    {
      "text": "Mix all ingredients except 3-ounce box of gelatin. Cover mixture and place in the refrigerator overnight. The next day, roll mixture into strawberry shapes.",
