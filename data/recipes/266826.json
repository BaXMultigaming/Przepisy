  "ingredients": [
    "2 medium russet potatoes",
    "1.5 tablespoons olive oil",
    "0.5 teaspoon ground paprika",
    "0.5 teaspoon parsley flakes",
    "0.5 teaspoon chili powder",
    "0.5 teaspoon sea salt",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GOg_RVaqYfnTR_ASj1v2VFmmDzI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/266826-air-fryer-potato-wedges-DDMFS-Step1_2-18c6ca22e08e4a6e86bdfb6c05de46da.jpg"
      ],
      "image": "assets/images/266826/step_01.webp"
    },
    {
      "text": "Cut each potato in half lengthwise. Cut each half in half lengthwise, and then cut each quarter in half lengthwise. You will have 16 wedges. Pat wedges thoroughly with paper towels to remove surface moisture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cDLK-VXWyarnpX1yWoyAPza2b-I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/266826-air-fryer-potato-wedges-DDFMS-Step2_2-452b0eebb622420580df0810694e9914.jpg"
      ],
      "image": "assets/images/266826/step_02.webp"
    },
    {
      "text": "Place potato wedges in a large bowl. Add olive oil, paprika, parsley, chili, salt, and pepper; toss until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/js9jsByLpBTxvZckmFZC5escFoA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/266826-air-fryer-potato-wedges-DDFMS-Step3_2-0e014043a79546a0a049e63826162490.jpg"
      ],
      "image": "assets/images/266826/step_03.webp"
    },
    {
      "text": "Arrange half the wedges in the air fryer basket in a single layer; cook for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0qj26ZjAf3MtrBkCBrqsTcakfRw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/266826-air-fryer-potato-wedges-DDFMS-Step4_2-0914d81c1d83456387919298ab58e8f6.jpg"
      ],
      "image": "assets/images/266826/step_04.webp"
    },
    {
      "text": "Flip wedges with tongs and cook for an additional 5 minutes. Remove to a plate. Repeat to cook the remaining wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h3jPQigMwcQJXESvZvuI-QQU2Ng=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/266826-air-fryer-potato-wedges-DDFMS-Step5_2-0afc191d04ad40f4a59057c484445f06.jpg"
      ],
      "image": "assets/images/266826/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tOItqaAULf6U0Acl9tv5njtmXCQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/266826-air-fryer-potato-wedges-DDMFS-4x3-62eba5348c6543a6ab09cbdbf65a6c71.jpg"
      ],
      "image": "assets/images/266826/step_06.webp"
    }
