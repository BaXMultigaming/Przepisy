  "ingredients": [
    "4 pounds fresh green beans, trimmed and cut into 2-inch pieces",
    "2 (10.75 ounce) cans cream of mushroom soup",
    "1 pound sharp Cheddar cheese, grated",
    "1 (6 ounce) can French-fried onions"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large saucepan of salted water to a boil; add green beans and cook just until slightly tender, about 5 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix green beans and cream of mushroom soup together in a bowl; spread into a 9x13-inch baking dish. Sprinkle Cheddar cheese over the green bean mixture and top with French-fried onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
