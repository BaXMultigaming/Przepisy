  "ingredients": [
    "3 cups old-fashioned rolled oats (such as Bob's Red Mill® Gluten-Free Oats)",
    "0.5 cup unsweetened coconut flakes",
    "0.25 cup honey",
    "1 tablespoon coconut oil, melted",
    "1 teaspoon vanilla extract",
    "0.75 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread oats and coconut flakes onto a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 8 minutes; stir oats and coconut and rotate baking sheet. Continue baking until oats and coconut are toasted, about 8 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk honey, coconut oil, vanilla extract, and cinnamon together in a bowl until smooth. Add oat mixture to honey mixture and stir until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line the baking sheet with a silicone liner or parchment paper. Spread oat mixture evenly onto baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven until granola is toasted, 8 to 15 minutes. Stir granola and transfer liner and granola to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
