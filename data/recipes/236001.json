  "ingredients": [
    "1 pound sirloin steak, cut into 1-inch cubes",
    "2 tablespoons butter",
    "1 large onion, sliced",
    "1 cup beef stock",
    "2 bay leaves",
    "1 pinch dried thyme",
    "salt and ground black pepper to taste",
    "1 cup frozen peas",
    "1 tablespoon cornstarch",
    "4 cups egg noodles"
  ],
  "steps": [
    {
      "text": "Heat a skillet over medium-high heat; cook steak, working in batches, until seared and browned on all sides, about 5 minutes. Transfer seared steak to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aUPpKdvKZlHvnu65-nsimcWGbnE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236001-beef-and-noodles-ddmfs-Step1-5024-1e495d0cca824905802344d904d576ca.jpg"
      ],
      "image": "assets/images/236001/step_01.webp"
    },
    {
      "text": "Melt butter in the same skillet over medium heat and sauté onion until softened, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_oKwTZDfj2HECX_9Z5o5bFukKZ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236001-beef-and-noodles-ddmfs-Step2-5028-fa0fd76aacab445b810f32aaec9141ec.jpg"
      ],
      "image": "assets/images/236001/step_02.webp"
    },
    {
      "text": "Add steak to onion in the skillet; pour in beef stock and season with bay leaves, thyme, salt, and pepper. Bring to a boil; reduce heat to low, cover, and simmer until steak is tender, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MqWJtM4pWySEXsvaIZDF8wm6lE8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236001-beef-and-noodles-ddmfs-Step3-5032-2785dcfe78ea4c6aa276913fa73ab7ff.jpg"
      ],
      "image": "assets/images/236001/step_03.webp"
    },
    {
      "text": "Stir peas and cornstarch into steak mixture; cook uncovered until liquid thickens, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gWezZPxGu8R6_Ci7ulu1Ud-MEV4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236001-beef-and-noodles-ddmfs-Step4-5033-974066099b70472bbb348526bbcfc199.jpg"
      ],
      "image": "assets/images/236001/step_04.webp"
    },
    {
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook egg noodles in the boiling water, stirring occasionally until cooked through but firm to the bite, about 5 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IlFE6t7YNtY7COQtIAbLvxKD3kU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236001-beef-and-noodles-ddmfs-Step5-5034-e9c49d5f09be44789a66b3d2f67c77a6.jpg"
      ],
      "image": "assets/images/236001/step_05.webp"
    },
    {
      "text": "Serve beef mixture over noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
