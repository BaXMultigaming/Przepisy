  "ingredients": [
    "3 large sweet potatoes, peeled and cut into small pieces",
    "6 cups chicken broth",
    "1 tablespoon orange-flavored liqueur (such as Cointreau®)",
    "0.5 cup fat-free half-and-half",
    "0.75 teaspoon ground nutmeg",
    "0.5 teaspoon freshly grated ginger",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon cayenne pepper",
    "salt and ground black pepper to taste",
    "0.25 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Put sweet potatoes into a large pot. Pour chicken broth over the sweet potatoes; bring to a boil, stir orange liqueur into the boiling broth, and cook until the potatoes are tender, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree the sweet potatoes with the broth using an immersion blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir half-and-half, nutmeg, ginger, cinnamon, and cayenne pepper into the pureed sweet potatoes; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium-high heat. Toast pecans in the hot skillet until fragrant.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle soup into bowls; garnish with toasted pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
