  "ingredients": [
    "0.5 cup butter",
    "2.5 cups confectioners' sugar",
    "2 cups peanut butter",
    "0.5 cup packed brown sugar",
    "1 teaspoon vanilla extract",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Melt butter in a pan over low heat. Add confectioners' sugar, peanut butter, brown sugar, and vanilla. Mix well.",
