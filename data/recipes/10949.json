  "title": "Pumpkin Drop Cookies",
  "description": "These quick and easy pumpkin drop cookies, made with canned pumpkin, milk, and butter, are soft, cake-like cookies topped with a sweet caramel icing.",
  "authors": [
    "Peggy Ackerman"
  ],
  "date_published": "1998-01-04T16:39:43-05:00",
