  "title": "Southern Fried Chicken",
  "description": "This Southern fried chicken recipe seasons chicken pieces with flour and spices, then quickly fries them in hot oil until golden, crispy, and irresistible.",
  "authors": [
    "Cindy Garrick"
  ],
  "date_published": "1999-05-18T21:07:38-04:00",
