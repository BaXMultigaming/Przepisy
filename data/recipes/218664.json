  "ingredients": [
    "4 cups water",
    "4.5 pounds clover honey",
    "4 oranges, quartered",
    "3 lemons, quartered",
    "1 cup raisins",
    "6 cinnamon sticks",
    "1 teaspoon caraway seeds",
    "0.5 teaspoon whole allspice berries",
    "0.5 teaspoon whole cloves",
    "0.5 gallon 190 proof grain alcohol"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PCYRCPkRrwZJDjsk0Ai3jFrkFY8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-218664-coal-region-boilo-VAT-step-01-dc9ffd404f4642cf9b997c4b9ab6351b.jpg"
      ],
      "image": "assets/images/218664/step_01.webp"
    },
    {
      "text": "Pour water and honey into a large pot over medium heat; stir to combine. Stir in orange and lemon quarters, raisins, cinnamon sticks, caraway seeds, allspice berries, and cloves; bring mixture to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I3LlZnXkNhhWFprW_Kr1zl4qvoI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-218664-coal-region-boilo-VAT-step-02-40b2bb6373f14b96b88f7c84a7eec204.jpg"
      ],
      "image": "assets/images/218664/step_02.webp"
    },
    {
      "text": "Reduce heat to a simmer, and cook, stirring occasionally, for 30 minutes. Remove from heat, and strain liquid into a large pot. Allow to cool for a few minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6NL9OdW40F7YUm4mWRx4gs5ncnQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-218664-coal-region-boilo-VAT-step-03-5d096d00d2844eeab5f5d2b568612145.jpg"
      ],
      "image": "assets/images/218664/step_03.webp"
    },
    {
      "text": "Slowly pour the grain alcohol into the honey mixture, and stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/odcXJME1WKHNoBiDW9g586BoEGg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-218664-coal-region-boilo-VAT-step-04-1pouring-ff525d09e6f44dbeaa7d7ee78569b4ad.jpg"
      ],
      "image": "assets/images/218664/step_04.webp"
    },
    {
      "text": "Pour into bottles, and cap; refrigerate until use. Serve gently warmed in shot glasses.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eO70Lu8xJXSK58vVojl17FonZAk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-218664-coal-region-boilo-VAT-step-05-a506b593772947b58b0af8e1f69bfcbb.jpg"
