  "ingredients": [
    "2 tablespoons butter",
    "0.75 cup chopped onion",
    "3 cups frozen whole kernel corn",
    "1 cup water",
    "1 cup frozen hash brown potatoes",
    "1.25 teaspoons ground black pepper",
    "salt to taste",
    "2 cups milk, divided",
    "2 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Melt butter in a large saucepan over medium heat. Add onion; cook and stir until tender, about 5 minutes. Stir in corn, water, hash browns, black pepper, and salt; bring to a boil. Cover saucepan; simmer for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1/2 cup milk and flour together in a small bowl until smooth; pour into the saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in remaining 1 1/2 cups milk; cook, stirring frequently, until thick, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
