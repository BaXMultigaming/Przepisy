  "ingredients": [
    "3 cups cooked rice",
    "0.25 cup butter",
    "0.25 cup all-purpose flour",
    "1.6666667461395 cups half-and-half",
    "1.5 cups chicken broth",
    "0.25 teaspoon rosemary",
    "1 teaspoon salt",
    "3 cups diced cooked chicken",
    "1 (4 ounce) can sliced mushrooms, drained",
    "0.33333334326744 cup chopped green bell pepper",
    "1 (2 ounce) jar pimentos"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 2 1/2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the rice into the bottom of the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Cook and stir flour in melted butter until frothy, 2 to 3 minutes; add half-and-half, chicken broth, rosemary, and salt to the saucepan. Stirring continually, cook the broth mixture until slightly thickened, about 5 minutes. Stir cooked chicken, mushrooms, bell pepper, and pimentos into the sauce; cook until the chicken is hot, 2 to 3 minutes. Pour the chicken mixture over the rice; stir lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until heated through and the rice is very tender, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
