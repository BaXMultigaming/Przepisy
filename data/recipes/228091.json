  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 8 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs together in a large bowl. Mix ham, bell pepper, onion, salt, black pepper, and water into the beaten eggs. Pour egg mixture evenly into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until muffins are set in the middle, 18 to 20 minutes.",
