  "ingredients": [
    "0.33333334326744 cup olive oil",
    "3 day old bagels",
    "2 cloves garlic, minced",
    "1 teaspoon Italian seasoning",
    "0.25 cup freshly grated Parmesan cheese",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a baking sheet with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a serrated knife to slice bagels into 1/8-inch-thick rounds. Arrange in a single layer on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir olive oil, Parmesan cheese, garlic, and Italian seasoning together in a small bowl. Brush flavored oil mixture onto bagel rounds or use a spoon to drizzle over top. If you start to run out of the mixture, you can add a little bit more oil without sacrificing any flavor. Season lightly with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chips are lightly browned, 15 to 20 minutes. Remove from the oven and cool. The chips will become crispier as they cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
