  "ingredients": [
    "1 tablespoon butter",
    "2 eggs",
    "1 cup white sugar",
    "3 tablespoons all-purpose flour",
    "3 cups diced rhubarb",
    "1 (9 inch) prepared 9-inch single pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in microwave oven in a 4-cup microwave-safe measuring cup until melted but not hot, about 1 minute. Beat eggs, sugar, and flour into butter until smooth. Spread rhubarb in unbaked pie crust; pour egg mixture over rhubarb.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is lightly browned, about 45 minutes.",
      "section": null,
