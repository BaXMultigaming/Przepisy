  "ingredients": [
    "cooking spray",
    "0.66666668653488 cup natural peanut butter",
    "0.5 cup honey",
    "0.25 cup brown sugar",
    "0.25 cup nonfat Greek yogurt",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 cup whole wheat flour",
    "0.5 teaspoon baking soda",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a cookie sheet with parchment paper or use cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine peanut butter, honey, and brown sugar in a large bowl; beat with an electric mixer until creamy. Add Greek yogurt, egg, and vanilla extract; mix well. Add whole wheat flour, baking soda, and salt. Mix until dough is blended together. Refrigerate dough for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop 1 tablespoon of chilled dough and roll into a ball. Place cookie balls 2 inches apart on the prepared cookie sheet. Press down with a fork in a criss-cross pattern.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges firm up and start to brown, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
