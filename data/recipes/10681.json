  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "1 cup margarine",
    "0.75 cup white sugar",
    "0.75 cup packed brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "2 cups milk chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease cookie sheets and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, margarine, white sugar, and brown sugar. Blend in egg and vanilla. Add dry ingredients and mix well. Fold in chocolate chips. Drop by rounded teaspoonfuls onto prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 to 18 minutes, or until edges are slightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
