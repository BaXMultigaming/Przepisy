  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "1 (3.4 ounce) package instant lemon pudding mix",
    "0.75 cup water",
    "0.5 cup vegetable oil",
    "4 eggs",
    "0.33333298563957 cup lemon juice",
    "2 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the cake: Stir cake mix and instant pudding together in a large bowl. Add water, oil, and eggs; mix until smooth and well blended. Spread batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted comes out clean, about 40 to 45 minutes. While cake is still hot, poke holes in the top with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the sweet lemon glaze: Mix lemon juice and confectioners sugar together in a small bowl until smooth; pour over hot cake and allow to seep into the holes. Let cake cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
