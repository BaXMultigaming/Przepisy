  "title": "Lemon Poke Cake",
  "description": "This moist lemon poke cake is easy to make with cake mix and instant pudding; poke holes in the warm cake to let it absorb the sweet and tangy lemon glaze.",
  "authors": [
    "MARBALET"
  ],
  "date_published": "1999-01-26T10:20:40-05:00",
