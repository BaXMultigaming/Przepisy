  "ingredients": [
    "6 fresh tomatillos, husks removed",
    "2 serrano peppers",
    "0.5 medium white onion, quartered",
    "0.5 cup sour cream",
    "0.25 cup chopped fresh cilantro",
    "1 small avocado, pitted and peeled",
    "1 clove garlic, peeled",
    "1 pinch salt",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Place tomatillos and serrano peppers into a medium pot and cover with water. Bring to a boil; reduce heat to medium-low and let simmer until tender, 15 to 20 minutes. Remove from heat, drain, and let cool, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cooled tomatillos and serrano peppers, onion, sour cream, cilantro, avocado, garlic, salt, and pepper into an electric blender and puree until almost liquid.",
