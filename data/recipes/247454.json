  "steps": [
    {
      "text": "Preheat the grill to medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold large sheet aluminum grill foil in half to make a rectangle about 8x11-inches; place onto center of the grill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 2 graham cracker squares in center of foil rectangle; place chocolate squares on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Close the grill; cook on the preheated grill until chocolate has melted, 3 to 5 minutes. Transfer crackers to a plate using a spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ice cream onto chocolate; top with remaining cracker squares.",
