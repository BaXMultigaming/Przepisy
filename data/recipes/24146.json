  "ingredients": [
    "3 eggs",
    "0.75 cup milk",
    "0.75 cup all-purpose flour",
    "0.25 cup butter",
    "2 tablespoons confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a 10-inch cast iron skillet; heat the skillet in the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs at high speed with an electric mixer in a large bowl. Slowly add milk and flour. Pour batter into the hot skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return the skillet to the oven and bake until well-risen like a souffle, about 20 minutes. It will fall when removed from the oven. Lightly dust with confectioners' sugar and serve.",
      "section": null,
      "name": null,
      "url": null,
