  "ingredients": [
    "0.66666668653488 cup shortening",
    "1.5 cups white sugar",
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup unsweetened cocoa powder",
    "3 eggs",
    "1.25 teaspoons vanilla extract",
    "1 cup water",
    "0.5 cup drained and chopped sauerkraut"
  ],
  "steps": [
    {
      "text": "Cream shortening and sugar. Add eggs one at a time, beating well after each addition. Stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, whisk together flour, baking soda, baking powder, salt and cocoa. Add flour mixture to creamed ingredients alternately with the water, ending with dry ingredients. Mix well until smooth. Blend in sauerkraut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 30 to 35 minutes. Top with Fluffy Creamy Frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
