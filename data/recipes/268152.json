  "ingredients": [
    "1 package of giblets from a turkey, chopped",
    "2 cups water",
    "1 (8.5 ounce) package corn muffin mix (such as Jiffy®)",
    "0.5 cup milk",
    "5 eggs, divided",
    "2 tablespoons shortening, melted",
    "3 pounds hot Italian sausage",
    "6 cups diced celery, or more to taste",
    "1 large white onion, diced",
    "0.5 cup diced hot peppers",
    "1 (14 ounce) can turkey broth",
    "1 cup dry bread crumbs",
    "3 tablespoons dried sage",
    "1 teaspoon salt, or to taste",
    "1 teaspoon ground black pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gFFzqb4xXx7jF2H7pyZG9gKupec=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268152-moms-sausage-and-cornbread-dressing-VAT-step-01-e7b21298cf2f43e1ab8d16a0bd9edc81.jpg"
      ],
      "image": "assets/images/268152/step_01.webp"
    },
    {
      "text": "Bring water to a boil in a saucepan. Add giblets and boil for 10 to 15 minutes. Remove and discard giblets, reserving water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-8XBHdV92URfM0kLxROhWjtCjlg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268152-moms-sausage-and-cornbread-dressing-VAT-step-02-32575551100343f2830e5668822905f4.jpg"
      ],
      "image": "assets/images/268152/step_02.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease an 8-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YbcL3CliXnTKs-aB8w3h7uKD08o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268152-moms-sausage-and-cornbread-dressing-VAT-step-03-45084942c18c4ca4af0b0c5d4669c9da.jpg"
      ],
      "image": "assets/images/268152/step_03.webp"
    },
    {
      "text": "Mix corn muffin mix, milk, egg, and shortening together in a bowl. Pour into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6vFawVbYaXnPhg_CMebWKgUyWlQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268152-moms-sausage-and-cornbread-dressing-VAT-step-04-0a0b1645325740239372e589c51edee1.jpg"
      ],
      "image": "assets/images/268152/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, 15 to 20 minutes. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7o3CTN9tkDWSZOBJL4tg8vumLtI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268152-moms-sausage-and-cornbread-dressing-VAT-step-05-9ea3c89ce0a043c490094e6a3c86df95.jpg"
      ],
      "image": "assets/images/268152/step_05.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned and crumbly, 5 to 7 minutes. Add celery, onion, and hot peppers and continue cooking 3 to 5 minutes more. Drain and discard grease. Transfer sausage mixture to a large mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J0TCWdRxRWS-1QDmCEvoGTC2GU8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268152-moms-sausage-and-cornbread-dressing-VAT-step-06-129736f4a90d4d6c82ac833c61d8e1bf.jpg"
      ],
      "image": "assets/images/268152/step_06.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch casserole pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rccF1MZAhaicsDyAnSYUnFVbgIk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268152-moms-sausage-and-cornbread-dressing-VAT-step-07-a2704ff33993474984f115e5f04bd519.jpg"
      ],
      "image": "assets/images/268152/step_07.webp"
    },
    {
      "text": "Add giblet water, turkey broth, bread crumbs, cornbread, remaining eggs, sage, salt, and black pepper to the sausage mixture in the mixing bowl. Mix together well and transfer to the prepared casserole pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ydBvWilxMIZgsIOS55W66wA0u4Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268152-moms-sausage-and-cornbread-dressing-VAT-step-08-ced4ed24a15d4bc09041e2cc47a016de.jpg"
      ],
      "image": "assets/images/268152/step_08.webp"
    },
    {
      "text": "Bake in the preheated oven until slightly brown on top with darker brown edges, about 45 minutes, checking often. Let cool 10 to 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wUkElwPD3lwKTvtPnHJnosVG8xs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268152-moms-sausage-and-cornbread-dressing-VAT-step-09-8bb3bb914e5c4662be549e6853ec0edd.jpg"
      ],
      "image": "assets/images/268152/step_09.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_h1dN3VAW4eei66MyENFwaN-tdc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268152-moms-sausage-and-cornbread-dressing-VAT-Beauty-4x3-90033de61dcf43c7bcddcd1361cfdafa.jpg"
      ],
      "image": "assets/images/268152/step_10.webp"
    }
