  "title": "Mom's Sausage and Cornbread Dressing",
  "description": "Try this time-tested recipe for sausage and cornbread dressing this holiday season; it's a bit of work, but worth it.",
  "authors": [
    "4620nellerd"
  ],
  "date_published": "2020-02-01T02:52:13-05:00",
