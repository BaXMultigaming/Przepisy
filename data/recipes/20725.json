  "ingredients": [
    "0.25 cup chopped garlic",
    "0.5 cup chopped onion",
    "1 dash soy sauce",
    "1 tablespoon corn syrup",
    "2 tablespoons apple juice",
    "3 tablespoons Worcestershire sauce",
    "1 teaspoon molasses",
    "0.25 cup wine",
    "0.25 cup Italian-style salad dressing",
    "0.5 cup distilled white vinegar",
    "0.5 teaspoon garlic powder",
    "0.125 teaspoon salt",
    "0.5 teaspoon onion powder",
    "1 tablespoon Cajun seasoning",
    "0.5 teaspoon crushed red pepper",
    "0.25 teaspoon seasoning salt",
    "0.25 cup brown sugar",
    "8 pounds pork shoulder"
  ],
  "steps": [
    {
      "text": "In a large bowl, mix garlic, onion, soy sauce, corn syrup, apple juice, Worcestershire sauce, molasses, wine, Italian-style salad dressing, distilled white vinegar, garlic powder, salt, onion powder, Cajun seasoning, crushed red pepper, seasoning salt and brown sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Score pork shoulder 1/8 to 1/4 inch deep. Place in the bowl with the marinade mixture. Marinate at least 4 hours in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium high heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook marinated pork shoulder on the prepared grill 3 hours, or until the internal temperature has reach a minimum of 165 degrees F (75 degrees C). Marinate frequently with the mixture while grilling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
