  "ingredients": [
    "3 ripe bananas, mashed",
    "1 cup brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.5 cup vegetable oil",
    "2 cups whole wheat flour",
    "1 cup rolled oats",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ginger",
    "1 tablespoon baking powder",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12 cup muffin pan with paper liners or coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the bananas, brown sugar, egg, vanilla and oil. Combine the whole wheat flour, oats, cinnamon, ginger, baking powder and baking soda; stir into the banana mixture until blended. Spoon the batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the tops spring back when lightly pressed, about 25 minutes. Cool for a few minutes in the pan before attempting to remove them.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
