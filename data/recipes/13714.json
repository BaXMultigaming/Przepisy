  "ingredients": [
    "1 cup dry white wine",
    "2 tablespoons all-purpose flour",
    "0.25 teaspoon ground nutmeg",
    "0.5 pound shredded Swiss cheese",
    "0.5 pound shredded Gruyere cheese",
    "0.25 teaspoon salt",
    "1 (1 pound) loaf French bread, cut into 1 inch cubes"
  ],
