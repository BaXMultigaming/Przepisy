  "ingredients": [
    "0.66666668653488 cup white sugar",
    "0.5 cup butter, softened",
    "0.25 cup honey",
    "2 eggs",
    "0.5 teaspoon salt",
    "1.5 cups all-purpose flour",
    "0.75 cup cornmeal",
    "0.5 teaspoon baking powder",
    "0.5 cup milk",
    "0.75 cup frozen corn kernels, thawed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease or line 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, honey, eggs, and salt together in a large bowl until well combined. Mix in flour, cornmeal, and baking powder; blend thoroughly. Stir in milk and corn. Pour or spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center of a muffin comes out clean, about 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
