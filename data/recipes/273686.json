  "ingredients": [
    "0.5 cup chopped onion",
    "0.25 cup olive oil",
    "0.25 cup lime juice",
    "2 teaspoons white vinegar",
    "2 teaspoons ground cumin",
    "2 cloves garlic, smashed",
    "2 small dried red peppers",
    "1 teaspoon sea salt",
    "0.5 teaspoon ground black pepper",
    "4 boneless, skinless chicken breasts"
  ],
  "steps": [
    {
      "text": "Place onion, olive oil, lime juice, vinegar, cumin, garlic, red peppers, salt, and black pepper in a blender. Blend until smooth. Place chicken in a container or resealable plastic bag and pour marinade on top; toss to coat. Marinate in the refrigerator for 2 to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill chicken until no longer pink in the center, 6 to 7 minutes per side, depending on thickness. An instant-read thermometer inserted into the centers should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
