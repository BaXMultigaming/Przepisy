  "ingredients": [
    "3 cups oil for frying",
    "1 cup sifted all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon white sugar",
    "1 large egg, lightly beaten",
    "0.5 cup milk",
    "1 tablespoon shortening, melted",
    "1 (12 ounce) can whole kernel corn, drained"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and heat oil in a heavy pot or deep fryer to 365 degrees F (185 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5zzFnKI9Beq7bpItrFwRLqHKYJg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18040-Corn-Fritters-ddmfs-step-1-320-f4d9657bc01049b0b19637a2eda3250e.jpg"
      ],
      "image": "assets/images/18040/step_01.webp"
    },
    {
      "text": "Combine flour, baking powder, salt, and sugar in a medium bowl. Beat egg, milk, and melted shortening together in a small bowl. Stir egg mixture into flour mixture. Stir in corn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X1dEufbrlV679Op5gO3gwdhp7tw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18040-Corn-Fritters-ddmfs-step-4-323-44276f31eb8b43dc82307bd4932de93c.jpg"
      ],
      "image": "assets/images/18040/step_02.webp"
    },
    {
      "text": "Working in batches, drop fritter batter by spoonfuls into the hot oil. Fry until golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1NEuWyrxFZa-nXaipSEqBO8Eikg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18040-corn-fritters-ddmfs-step-5-340-46ac6e77ea474a2d99858da4bf06ca07.jpg"
      ],
      "image": "assets/images/18040/step_03.webp"
    },
    {
      "text": "Remove fritters with a slotted spoon and drain on paper towels.",
      "section": null,
      "name": null,
