  "ingredients": [
    "2 cups water",
    "0.5 cup distilled white vinegar",
    "1 cup white sugar, or to taste",
    "7 tablespoons hot pepper sauce (such as Frank's RedHot®), or to taste",
    "1.5 teaspoons crushed red pepper flakes",
    "0.66666668653488 cup prepared yellow mustard",
    "3.75 tablespoons ketchup",
    "1 orange, peel and pith removed, chopped",
    "2 pounds chicken wings and drummettes"
  ],
  "steps": [
    {
      "text": "Bring water, vinegar, sugar, hot pepper sauce, and crushed red pepper flakes to a boil in a heavy saucepan over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk yellow mustard and ketchup into the sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the orange. Bring sauce back to a boil, reduce heat to low, and simmer until thickened, 2 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange the chicken wings in a large baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the wings are browned and no longer pink inside, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the baked wings into the sauce to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
