  "ingredients": [
    "1 pound zucchini, cut into 1/2-inch slices",
    "0.5 pound yellow squash, cut into 1/2-inch slices",
    "1 small onion, roughly chopped",
    "1 tablespoon olive oil",
    "1 teaspoon lemon pepper seasoning",
    "0.5 teaspoon seasoned salt"
  ],
  "steps": [
    {
      "text": "Place zucchini, yellow squash, and onion in a large bowl. Add olive oil, lemon pepper seasoning, and seasoned salt. Toss to coat until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place zucchini mixture in the basket of the air fryer making sure to not overcrowd (you may need to do this in two batches depending on the size of your air fryer).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook for 8 minutes. Shake basket and cook until vegetables are soft, about 8 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
