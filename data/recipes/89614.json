  "ingredients": [
    "1 tablespoon extra virgin olive oil",
    "2 pounds cubed pork stew meat",
    "garlic powder to taste",
    "salt to taste",
    "2 tablespoons cornstarch, or as needed",
    "8 red potatoes",
    "1 green bell pepper, chopped",
    "1 red bell pepper, chopped",
    "1 sweet onion, diced",
    "1 (11 ounce) can whole kernel corn",
    "1 (14 ounce) can stewed tomatoes",
    "1 (14 ounce) can beef broth",
    "1 (10.75 ounce) can cream of mushroom soup",
    "1.25 cups milk",
    "1 tablespoon Italian seasoning"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large skillet over medium heat. Sprinkle pork on all sides with garlic powder, salt, and pepper, then lightly coat with cornstarch. Place pork in the skillet and cook in hot oil until lightly browned but not done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pork to a slow cooker. Add potatoes, bell peppers, onion, and corn to pork in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together tomatoes, broth, condensed soup, milk, and Italian seasoning in a medium bowl until combined; pour into the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for 1 hour. Reduce heat to Low and continue cooking for at least 1 more hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
