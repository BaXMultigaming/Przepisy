  "ingredients": [
    "0.66666668653488 cup white sugar",
    "0.5 cup butter, melted",
    "2 large egg yolks",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "1.25 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 pint vanilla ice cream",
    "2 tablespoons colored candy sprinkles (jimmies)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together sugar, melted butter, egg yolks, vanilla extract, and almond extract in a bowl. Add flour, baking soda, salt, and candy sprinkles. Stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop dough with a medium-sized spring-hinged scoop and space evenly on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies spread, start to crackle, and appear dry on top, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let the cookies rest on the baking sheet for 2 minutes, then transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make ice cream sandwiches, place about 1/4 cup ice cream on the bottom of one cookie, press the top cookie in place.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
