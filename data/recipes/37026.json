  "ingredients": [
    "1 cup dark brown sugar",
    "0.66666698455811 cup bourbon",
    "1 cup light soy sauce",
    "4 cloves garlic",
    "3 pounds country style pork ribs"
  ],
  "steps": [
    {
      "text": "Process brown sugar, bourbon, soy sauce, and garlic in a food processor or blender to mince garlic with other ingredients. Pour over ribs, and marinate for several hours in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat, and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ribs on grate, and cover. Cook for 45 minutes to 1 hour depending on thickness of your ribs. When finished, the internal temperature of the ribs should be 160 degrees F (70 degrees C) when taken with a meat thermometer.",
      "section": null,
