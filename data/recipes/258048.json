  "ingredients": [
    "1 (6.0 ounce) package UNCLE BEN'S® Long Grain & Wild Rice Original Recipe",
    "2 tablespoons butter",
    "1 large orange, zested and juiced",
    "0.5 cup toasted, chopped pecans"
  ],
  "steps": [
    {
      "text": "In a saucepan, saute rice in butter until brown, stirring frequently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in contents of seasoning packet and orange zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the orange juice and enough water to equal 2-1/3 cups water and add to rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring to a boil, cover and simmer until liquid is absorbed, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in toasted pecans.",
