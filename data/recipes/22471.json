  "ingredients": [
    "6 skinless, boneless chicken breast halves",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1 (16 ounce) can sauerkraut, drained and pressed",
    "4 slices Swiss cheese",
    "1.25 cups thousand island salad dressing",
    "1 tablespoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in a lightly greased 9x13 inch baking dish. Sprinkle with salt and pepper. Place sauerkraut over chicken and top with cheese slices. Pour dressing over all and cover dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 90 minutes, or until chicken is cooked through (fork can be easily inserted and juices run clear). Sprinkle with chopped parsley and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
