  "ingredients": [
    "8 pounds tomatoes, seeded and diced",
    "0.25 cup chopped fresh basil",
    "0.5 cup olive oil",
    "1 large onion, minced",
    "3 cloves garlic, minced",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
