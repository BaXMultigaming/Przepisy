  "ingredients": [
    "1.5 teaspoons olive oil",
    "0.75 pound pearl onions, peeled",
    "2 cloves garlic, minced",
    "0.33300000429153 cup dry white wine",
    "1 cup beef broth",
    "2 tablespoons tomato paste",
    "2 tablespoons raisins",
    "0.5 teaspoon grated orange zest",
    "0.25 teaspoon dried thyme, crushed",
    "0.125 teaspoon ground black pepper",
    "1 tablespoon minced fresh parsley"
  ],
  "steps": [
    {
      "text": "Heat oil in a medium saucepan over medium heat. Saute onions until golden, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in garlic, wine, broth, tomato paste, raisins, orange zest, thyme, black pepper and parsley. Simmer, uncovered, for 20 minutes, stirring often. When onions are tender increase the heat to high and cook, stirring constantly, until sauce thickens, about 3 minutes.",
