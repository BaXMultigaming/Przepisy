  "title": "Slow-Cooked German Short Ribs",
  "description": "Beef short ribs and onions slow cooked in a spicy red wine sauce. Goes great over wide egg noodles.",
  "authors": [
    "PEG13"
  ],
  "date_published": "2000-10-28T17:34:56-04:00",
