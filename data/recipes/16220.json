  "title": "Lemon Mushroom Herb Chicken",
  "description": "Herbed chicken is blanketed by a cream of mushroom sauce with a lovely lemon-wine accent.",
  "authors": [
    "Valerie Serao"
  ],
  "date_published": "1999-07-02T13:30:33-04:00",
