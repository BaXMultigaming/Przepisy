  "steps": [
    {
      "text": "In a skillet over medium heat, brown the ground beef until no pink shows; drain and remove from skillet. Brown Sausage in skillet until cooked through; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine in skillet with sausage: browned beef, bacon, tomato sauce, tomatoes and sugar. Simmer 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add spaghettini pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cooked spaghettini with tomato-meat mixture. Pour in casserole dish and bake for 30 minutes.",
