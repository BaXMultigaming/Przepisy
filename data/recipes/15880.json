  "ingredients": [
    "3 cups sweetened condensed milk",
    "0.75 cup key lime juice",
    "0.5 cup sour cream",
    "1 tablespoon grated lime zest",
    "1 (9 inch) prepared graham cracker crust"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qBfIaciITB2PhswvBycJ-zgOHjA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15880-Key-Lime-Pie-ddmfs-4x3-Ingredients-0132-7a9928cf1d634aa1b90e49284e93b427.jpg"
      ],
      "image": "assets/images/15880/step_01.webp"
    },
    {
      "text": "Combine condensed milk, key lime juice, sour cream, and lime zest in a bowl; mix well. Pour into graham cracker crust; place pie on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MDd35MYpeyvxcSUd2mfzVazBgNw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15880-Key-Lime-Pie-ddmfs-4x3-Step-01-0134-22d76bd5a0c846e5bc2b5646c0866bce.jpg"
      ],
      "image": "assets/images/15880/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven for 5 to 8 minutes, until tiny pinhole bubbles burst on the surface of the pie. The filling will be wobbly but not browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-c1HD40xW1nErDEYlS2nwgn0XMU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15880-Key-Lime-Pie-ddmfs-4x3-Step-03-0138-4563fd2ef0d94f5b889f7e7ff7b0ae21.jpg"
      ],
      "image": "assets/images/15880/step_03.webp"
    },
    {
      "text": "Transfer pie to a wire rack to cool, then thoroughly chill pie in the refrigerator before serving, about 1 hour. Garnish with lime slices and whipped cream, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vjT9XPXOpvlV5O63sLnBkXD4hmc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15880-Key-Lime-Pie-ddmfs-4x3-Step-04-0226-ae8efa3c648546b98a02e2f534805324.jpg"
      ],
      "image": "assets/images/15880/step_04.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
