  "ingredients": [
    "0.5 cup butter",
    "1 cup packed brown sugar",
    "1 cup finely shredded carrots",
    "1 egg",
    "1.5 cups all-purpose flour",
    "0.5 cup whole wheat flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and brown sugar in a large bowl; mix together with an electric mixer until light and fluffy. Beat in carrots and egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine all-purpose flour, whole wheat flour, cinnamon, baking powder, nutmeg and salt in a bowl. Stir into carrot mixture, a little at a time, blending dough well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto a baking sheet; flatten with a moistened fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are golden and crisp, about 15 minutes. Transfer to wire racks to cool, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
