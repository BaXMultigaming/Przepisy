  "ingredients": [
    "1 cup all-purpose flour, divided",
    "1 cup brown sugar",
    "0.75 cup shortening",
    "0.25 cup molasses",
    "1 egg",
    "1 teaspoon baking soda",
    "1 teaspoon ground ginger",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.25 cup white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 cup flour, brown sugar, shortening, molasses, egg, baking soda, ginger, cinnamon, and cloves in a large bowl until thoroughly combined; stir in remaining 1 ¼ cups flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1-inch balls; roll in white sugar. Place 2 inches apart on ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and tops are crackled, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
