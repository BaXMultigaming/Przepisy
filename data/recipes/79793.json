  "ingredients": [
    "4 cups all-purpose flour",
    "2 cups white sugar",
    "0.25 cup unsweetened cocoa powder",
    "2 tablespoons cornstarch",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "2 teaspoons ground cinnamon",
    "2 teaspoons ground cloves",
    "3 cups unsweetened applesauce",
    "0.75 cup vegetable oil",
    "1 cup raisins",
    "1 cup chopped pitted dates",
    "1 pound candied mixed fruit",
    "2 cups chopped walnuts",
    "0.5 cup walnut halves",
    "1 cup halved candied cherries"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C). Grease a 9-inch tube pan and one 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WtKW2KZcQvzAPb9fwsdawLS-F10=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-79793-grandma-leachs-fruitcake-VAT-step-01-cf2512e6455448129005c66e7e0df51a.jpg"
      ],
      "image": "assets/images/79793/step_01.webp"
    },
    {
      "text": "Sift flour, sugar, cocoa, cornstarch, baking soda, salt, cinnamon, and cloves into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0wlI-W_yORM4Z5OhvhZjo9xw1is=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-79793-grandma-leachs-fruitcake-VAT-step-02-6328fde3899e4b2da600bca4d8b3d774.jpg"
      ],
      "image": "assets/images/79793/step_02.webp"
    },
    {
      "text": "Stir in applesauce and oil, then mix in raisins, dates, mixed fruit, and 2 cups of walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z1FrF0i_iyHB8i92N6VofdpX660=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-79793-grandma-leachs-fruitcake-VAT-step-04-65c80aa5c0634f11bb7d56efff32c29c.jpg"
      ],
      "image": "assets/images/79793/step_03.webp"
    },
    {
      "text": "Pour into the prepared pans, about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fcxk9NIYSmxhIZPNkdcZNIxF-q4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-79793-grandma-leachs-fruitcake-VAT-step-05-2nohand-49d86ef2774149b4aadcb135d62b72c8.jpg"
      ],
      "image": "assets/images/79793/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the crown of the cake comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O-mCmL8vZPwQxih9uT9O8FjSATE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-79793-grandma-leachs-fruitcake-VAT-step-05-1handinframe-7611158b75394c828438b609067d6eb8.jpg"
