  "ingredients": [
    "2.5 cups apples - peeled, cored, and sliced",
    "1 cup sifted all-purpose flour",
    "1 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "0.5 cup butter, softened"
  ],
