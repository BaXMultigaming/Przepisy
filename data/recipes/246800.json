  "ingredients": [
    "0.75 cup white rice flour",
    "0.5 cup brown rice flour",
    "0.5 cup sorghum flour",
    "0.25 cup potato starch",
    "3 tablespoons tapioca starch",
    "1 tablespoon sweet rice flour",
    "1 tablespoon rice starch",
    "1 tablespoon baking powder",
    "2 teaspoons white vanilla powder",
    "1 cup superfine sugar",
    "1 teaspoon fine salt"
  ],
  "steps": [
    {
      "text": "Sift white rice flour, brown rice flour, sorghum flour, potato starch, tapioca starch, sweet rice flour, rice starch, baking powder, and vanilla powder together twice in the bowl of a stand mixer. Add superfine sugar and salt; whisk together using the whisk attachment on medium-low speed, about 2 minutes.",
