  "ingredients": [
    "2 tablespoons vegetable oil",
    "1 cup sliced fresh mushrooms",
    "1 cup snow peas",
    "0.75 cup shredded carrot",
    "4 green onions, sliced",
    "1 clove garlic, minced",
    "0.25 cup reduced-sodium soy sauce",
    "1 teaspoon white sugar",
    "0.25 teaspoon cayenne pepper",
    "8 ounces cooked spaghetti",
    "1 tablespoon toasted sesame seeds"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium-high heat. Add mushrooms, snow peas, carrot, and green onions. Cook, stirring, until crisp-tender, about 4 minutes. Add garlic; cook 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together soy sauce, sugar, and cayenne in a small bowl; pour into skillet. Add cooked spaghetti and toss to coat. Cook until heated through, about 1 minute. Sprinkle with toasted sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
