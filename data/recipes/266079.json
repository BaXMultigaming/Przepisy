  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 medium onion, chopped",
    "2 cloves garlic, chopped",
    "0.5 teaspoon dried parsley",
    "1.5 cups chopped cooked chicken",
    "2 (14 ounce) cans chicken broth",
    "1 (14 ounce) can whole kernel corn, drained",
    "1 (10 ounce) can diced tomatoes with green chile peppers",
    "0.5 (1 ounce) package taco seasoning mix",
    "2 tostada shells, crushed into chips",
    "0.25 cup shredded mild Cheddar cheese",
    "0.25 cup sour cream"
  ],
  "steps": [
    {
      "text": "Heat oil in a 4-quart saucepan over medium-high heat. Saute onion, garlic, and parsley in hot oil until slightly browned, about 5 minutes. Add chicken and stir until well heated, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour chicken broth into the saucepan; bring to a boil. Stir in corn, diced tomatoes, and taco seasoning. Reduce heat, cover, and simmer for 5 minutes. Uncover and stir in tostada chip pieces. Remove from heat and ladle into bowls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish bowls with Cheddar cheese and dollops of sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
