  "ingredients": [
    "1 bunch kale",
    "1 tablespoon olive oil",
    "1 teaspoon minced garlic"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sZ1Qmk_QrIjfrBPotPQCsEDFGxI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241074-EasyGarlicKale-ddmfs-step1-3872-4x3-cda20e9950504ec9bd890fdbbe7ae7fe.jpg"
      ],
      "image": "assets/images/241074/step_01.webp"
    },
    {
      "text": "Soak kale leaves in a large bowl of water until dirt and sand begin to fall to the bottom, about 2 minutes. Lift kale from the bowl without drying the leaves and immediately remove and discard stems. Chop the kale leaves into 1-inch pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EWJ6YCoBqThQhAW0oNxWWlHFhxo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241074-EasyGarlicKale-ddmfs-step3-3892-4x3-af0aa0ca0613430abb1966b45dbd3269.jpg"
      ],
      "image": "assets/images/241074/step_02.webp"
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat; cook and stir garlic until sizzling, about 1 minute. Add kale to the skillet and place a cover over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook, stirring occasionally with tongs, until kale is bright green and slightly tender, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T9BsE4GxuBiSD9I81mFII9CGIoQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241074-EasyGarlicKale-ddmfs-step4-3900-4x3-a1cfe46ea4c7494ca2f2c5450ba2abe8.jpg"
      ],
      "image": "assets/images/241074/step_04.webp"
    },
    {
      "text": "Enjoy!",
