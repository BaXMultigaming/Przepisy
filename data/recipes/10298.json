  "ingredients": [
    "2 cups white sugar",
    "0.5 cup butter",
    "0.5 cup milk",
    "3 cups quick cooking oats",
    "3 tablespoons cocoa powder",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Place sugar, butter, and milk in a medium saucepan. Bring to a rolling boil over medium-low heat; boil for one minute, stirring constantly.",
