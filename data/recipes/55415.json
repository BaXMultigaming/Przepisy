  "ingredients": [
    "2 eggs",
    "0.5 cup milk",
    "1 (15 ounce) can artichoke hearts, drained and quartered",
    "1.5 cups seasoned dry bread crumbs",
    "2 cups oil for frying, or as needed",
    "0.25 cup grated Parmesan cheese for topping"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep-fryer or heavy deep skillet to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, whisk together eggs and milk. Place seasoned bread crumbs in a separate bowl. Dip artichoke hearts in the egg mixture, then roll in bread crumbs until they are fully covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Deep-fry for 2 to 3 minutes, until deep golden brown. Remove to paper towels to drain excess oil. When all the pieces have been fried, place on a serving tray and sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
