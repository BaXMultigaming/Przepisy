  "ingredients": [
    "0.5 loaf multigrain bread, cubed",
    "0.25 cup butter, melted",
    "2 tablespoons Cajun seasoning (such as Emeril's Essence®), divided",
    "2 tablespoons grated Parmesan cheese, divided",
    "1 tablespoon onion powder, divided"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread cubes in a large bowl; drizzle butter over cubes. Toss to evenly coat. Sprinkle half the Cajun seasoning, half the Parmesan cheese, and half the onion powder over cubes; toss to coat. Spread coated bread cubes onto the prepared baking sheet; sprinkle remaining Cajun seasoning, Parmesan cheese, and onion powder onto cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 7 minutes; stir and continue baking until crisp, about 8 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
