  "title": "Swedish Meatballs (Svenska Kottbullar)",
  "description": "Juicy Swedish meatballs made with seasoned ground beef and pork, baked and served with a savory brown gravy sauce for a family-friendly comfort meal.",
  "authors": [
    "Nom Nom Nom"
  ],
  "date_published": "2010-09-25T14:41:07-04:00",
  "date_modified": "2025-11-04T14:22:24-05:00",
  "prep_time": "PT25M",
