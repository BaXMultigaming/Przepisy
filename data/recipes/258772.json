  "ingredients": [
    "6 cups huckleberries",
    "0.5 teaspoon lemon juice",
    "1 cup white sugar",
    "0.5 cup cornstarch",
    "1 teaspoon ground cinnamon, or to taste",
    "1.3333333730698 cups brown sugar",
    "1 cup all-purpose flour",
    "1 cup rolled oats",
    "1.5 teaspoons ground nutmeg",
    "1.5 teaspoons ground cinnamon",
    "0.66666668653488 cup melted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine huckleberries and lemon juice in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, cornstarch, and 1 teaspoon cinnamon in a separate bowl; pour over huckleberries and toss to coat. Pour filling into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss brown sugar, flour, oats, ground nutmeg, and 1 ½ teaspoons cinnamon in a bowl until combined. Stir in butter until clumps begin to form; spread over huckleberry filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 30 minutes. Cool before serving for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
