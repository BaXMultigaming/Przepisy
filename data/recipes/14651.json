  "ingredients": [
    "1.5 pounds lean ground beef",
    "1 (1.25 ounce) package taco seasoning mix",
    "1 (16 ounce) can refried beans",
    "1 (16 ounce) jar salsa",
    "2 cups shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (160 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large, heavy skillet over medium-high heat, brown ground beef, and drain fat. Mix in dry taco seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon browned meat into a 9x13 inch glass baking dish. Spoon a layer of refried beans over meat, then salsa. Top with shredded cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake about 20 to 25 minutes in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
