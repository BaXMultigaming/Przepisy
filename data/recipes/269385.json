  "ingredients": [
    "0.5 cup cream cheese, softened",
    "0.5 cup whole-berry cranberry sauce",
    "4 (10 inch) flour tortillas",
    "12 ounces thinly sliced roast turkey",
    "4 ounces thinly sliced Swiss cheese, chopped",
    "2 ounces thinly sliced Granny Smith apple"
  ],
  "steps": [
    {
      "text": "Mix cream cheese and cranberry sauce together in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1/4 of the cream cheese mixture over the entire surface of each tortilla, then cover with turkey, Swiss, and apple. Roll tortillas tightly over fillings and wrap in plastic wrap; refrigerate for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unwrap tortillas; slice each one into eight pieces and serve.",
