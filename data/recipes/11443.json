  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "1 cup sourdough starter",
    "1 egg",
    "1.75 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon vanilla extract",
    "1 teaspoon salt",
    "0.25 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease baking sheets, or line them with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and butter in a large bowl. Beat in sourdough starter and egg. Stir in flour, baking powder, vanilla extract, salt, and baking soda until smooth. Drop dough by teaspoonfuls onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
