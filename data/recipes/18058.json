  "ingredients": [
    "0.5 cup shortening",
    "1 cup white sugar",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 cup milk",
    "1 pint blueberries",
    "2 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Lightly grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together shortening and 1 cup sugar. Beat in eggs and vanilla. Combine flour, baking powder and salt, and stir into egg mixture alternately with the milk. Fold in blueberries. Spoon batter into prepared muffin cups and sprinkle with sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheat oven for 5 minutes. Reduce heat to 375 degrees F (190 degrees C) and bake for 30 minutes more, until golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
