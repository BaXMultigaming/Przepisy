  "ingredients": [
    "2.125 cups all-purpose flour",
    "2 tablespoons baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.5 cup sugar",
    "0.5 cup reduced-calorie margarine",
    "1 egg",
    "3 medium ripe bananas, mashed",
    "1.5 teaspoons vanilla extract",
    "0.75 cup bran flakes cereal",
    "12 dates, pitted and chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a muffin pan with non-stick spray or line with paper muffin liners. Sift together the flour, baking powder, cinnamon and salt; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the sugar, margarine and egg with an electric mixer until light and fluffy. Mix in bananas, vanilla, cereal and dates. Blend in dry ingredients until just incorporated. Spoon into prepared muffin cups to about 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 to 25 minutes in the preheated oven, until a toothpick inserted into the center comes out clean. Cool in pan over a wire rack for at least 10 minutes before removing muffins from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
