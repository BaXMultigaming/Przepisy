  "ingredients": [
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "0.5 (10.5 ounce) can water",
    "1 pound cubed beef stew meat",
    "4 medium potatoes, peeled and cubed",
    "4 carrots, cut into 1/2-inch slices",
    "2 medium onions, diced",
    "1 cup celery, cut into 1/2-inch slices",
    "1 pinch garlic powder, or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mushroom soup and water in a saucepan over low heat. Cook and stir until hot, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While soup is cooking, place meat in the bottom of a large casserole pan. Pour hot soup over top and toss to combine. Add potatoes, carrots, onions, and celery. Season with garlic powder, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover casserole dish and cook in the preheated oven until meat is cooked through and tender, about 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
