  "ingredients": [
    "2 tablespoons olive oil",
    "1 tablespoon seafood seasoning (such as Old Bay®)",
    "0.5 teaspoon cayenne pepper",
    "8 ounces raw Spanish peanuts",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 320 degrees F (160 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together olive oil, seafood seasoning, and cayenne pepper in a large bowl. Add peanuts and stir to coat. Transfer to the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 10 minutes. Toss and continue cooking for 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the basket from the air fryer. Season peanuts with salt, toss, and cook for 5 minutes more. Transfer peanuts to a paper towel-lined plate and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
