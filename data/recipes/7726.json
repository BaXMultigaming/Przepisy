  "ingredients": [
    "1.5 cups butter",
    "2 cups white sugar",
    "4 eggs",
    "0.5 teaspoon salt",
    "2 teaspoons baking soda",
    "1 (20 ounce) can crushed pineapple, drained",
    "0.25 cup unsweetened pineapple juice",
    "1 (3.5 ounce) package flaked coconut",
    "1 cup chopped walnuts",
    "2 teaspoons vanilla extract",
    "1 (16 ounce) package graham crackers, crushed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and line with parchment paper one 10 inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter or margarine, sugar, and eggs together; add salt, baking soda, crushed pineapple, and pineapple juice. Add coconut, walnuts, and vanilla. Mix in the graham cracker crumbs. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour and 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
