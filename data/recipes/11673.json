  "title": "Easy Crab Linguine",
  "description": "Onion and garlic cooked in butter flavors a simple white sauce. Add Parmesan cheese and real or imitation (surimi) crab and serve over hot linguine.",
  "authors": [
    "Marian Collins"
  ],
  "date_published": "1999-02-03T14:58:58-05:00",
