  "ingredients": [
    "1 (16 ounce) package linguini pasta",
    "0.25 cup butter",
    "1 onion, chopped",
    "2 cloves garlic, minced",
    "0.375 cup all-purpose flour",
    "4 cups milk",
    "0.75 cup grated Parmesan cheese",
    "1 pound imitation crabmeat"
  ],
  "steps": [
    {
      "text": "Cook the pasta in boiling salted water until al dente.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter or margarine in a saucepan over medium heat. Add onion and garlic, and cook till transparent.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour into butter or margarine mixture to make a paste. Add warmed milk, and stir until well mixed. Heat gently, and when milk is quite hot add the parmesan. Stir until cheese is melted and sauce is thick. Don't boil. Stir in the crab, heat through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta. Serve sauce over hot noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
