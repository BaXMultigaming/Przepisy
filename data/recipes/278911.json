  "title": "Swedish Pecan-Topped Dream Cookies",
  "description": "These tiny, buttery Swedish shortbread cookies topped with pecans are perfect for holiday entertaining and sharing at cookie swaps.",
  "authors": [
    "cakeeater567"
  ],
  "date_published": "2020-06-19T00:44:40-04:00",
