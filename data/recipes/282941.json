  "ingredients": [
    "0.5 medium head cabbage",
    "1 clove garlic, minced",
    "1 teaspoon chili powder",
    "0.5 teaspoon salt, or more to taste",
    "1 pinch ground cumin, or to taste",
    "2 tablespoons mayonnaise",
    "1 tablespoon lemon juice, or more to taste",
    "1 teaspoon Sriracha sauce",
    "1 medium carrot, diced",
    "0.5 medium onion, finely sliced",
    "0.5 bunch fresh cilantro, leaves finely chopped"
  ],
  "steps": [
    {
      "text": "Finely chop cabbage, then cut into short strips; place in a bowl. Add garlic, chili powder, salt, and cumin; stir to combine. Stir in mayonnaise, lemon juice, and Sriracha.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add carrot, onion, and cilantro; stir to combine. Taste; add more lemon juice if desired. Refrigerate to blend flavors before serving, 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
