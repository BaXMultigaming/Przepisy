      "url": null,
      "image_sources": []
    },
    {
      "text": "Place squash halves, cut-side down, on a baking sheet. Bake in the preheated oven until flesh begins to soften, about 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
