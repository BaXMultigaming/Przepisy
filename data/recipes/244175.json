  "ingredients": [
    "1.5 cups milk",
    "3 tablespoons brown sugar",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "0.75 cup rolled oats",
    "0.75 cup chopped apples",
    "0.33333334326744 cup dried cranberries",
    "0.33333334326744 cup chopped walnuts, or as desired"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring milk, brown sugar, cinnamon, nutmeg, and cloves to a boil in a saucepan; remove from heat. Combine oats, apples, dried cranberries, and walnuts in a bowl; transfer to the prepared baking dish. Pour milk mixture over oat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 30 to 35 minutes.",
      "section": null,
      "name": null,
