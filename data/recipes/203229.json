  "ingredients": [
    "1 cup flour",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1 large egg",
    "1.125 cups buttermilk",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat and lightly grease a large skillet or electric griddle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, salt, and baking soda together in a bowl. Add egg, buttermilk, and butter; stir together lightly, but keep it lumpy. The batter should look thick, spongy, and puffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop 1/3 cup of the batter onto the cooking surface, spreading lightly with the bottom of the cup. Cook until lightly browned on each side, 1 to 2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
