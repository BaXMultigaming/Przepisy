  "ingredients": [
    "1 sweet potato, peeled",
    "1 teaspoon butter",
    "0.5 medium onion, chopped",
    "1 clove garlic, minced",
    "1 cup chicken stock",
    "1 teaspoon ground cumin",
    "1 teaspoon ground ginger",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon brown sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Place sweet potato into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until barely tender, 15 to 20 minutes. Drain. Let cool until safe to handle. Cut into medium pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Add onion and garlic. Cook and stir until onion is translucent and slightly browned, about 5 minutes. Pour in chicken stock and bring to a boil. Add the sweet potato, cumin, ginger, black pepper, brown sugar, cinnamon, and red pepper flakes. Cook until flavors come together and sweet potato is soft, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree soup with an immersion blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
