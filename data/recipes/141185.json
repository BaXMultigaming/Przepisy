  "ingredients": [
    "0.5 cup orange juice",
    "0.5 cup olive oil",
    "1 teaspoon oregano, dried",
    "1 teaspoon finely chopped fresh parsley",
    "salt and ground black pepper to taste",
    "2 (6 ounce) fresh tuna steaks"
  ],
  "steps": [
    {
      "text": "In a large bowl, combine orange juice, olive oil, oregano, parsley, salt, and pepper. Mix well. Place the tuna steaks in the bowl, turn to coat both sides with marinade; cover and refrigerate 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tuna from the marinade and shake off excess. Place tuna onto preheated grill and cook to desired doneness, about 5 minutes per inch for medium-rare or 10 minutes per inch for medium-well.",
      "section": null,
      "name": null,
      "url": null,
