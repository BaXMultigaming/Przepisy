  "ingredients": [
    "1 cup honey",
    "0.25 cup molasses",
    "3 tablespoons ketchup",
    "0.125 teaspoon ground cinnamon",
    "0.5 teaspoon paprika",
    "0.125 teaspoon ground ginger",
    "1 tablespoon seasoned salt",
    "1 tablespoon meat tenderizer",
    "0.125 teaspoon ground black pepper",
    "0.25 teaspoon salt",
    "0.125 teaspoon dried oregano",
    "0.25 teaspoon minced garlic",
    "0.25 cup steak sauce",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon prepared mustard",
    "1.5 cups brown sugar"
  ],
  "steps": [
    {
      "text": "In a medium bowl, stir together the honey, molasses, ketchup, cinnamon, paprika, ginger, seasoned salt, meat tenderizer, ground black pepper, salt, oregano, garlic, steak sauce, Worcestershire sauce, mustard, and brown sugar until well blended.",
