  "ingredients": [
    "1.5 pounds ground turkey",
    "2 cups dry bread crumbs",
    "1 onion, chopped",
    "1 egg, beaten",
    "1 cup milk",
    "0.5 cup balsamic vinegar",
    "1 clove garlic, minced",
    "1 teaspoon salt",
    "1 teaspoon pepper",
    "1.5 tablespoons chopped fresh rosemary",
    "1 cup canned tomato sauce",
    "0.75 cup brown sugar",
    "1 tablespoon Dijon mustard"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, mix together the ground turkey, bread crumbs, onion, egg and milk. Season with balsamic vinegar, salt, pepper and rosemary. Press into the prepared pan. Blend together the tomato sauce, brown sugar and mustard; pour evenly over the top of the loaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour in the preheated oven, or until juices run clear when pricked with a knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
