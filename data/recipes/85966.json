  "ingredients": [
    "1 tablespoon olive oil",
    "0.5 pound sweet Italian sausage, sliced",
    "1 (8 ounce) boneless, skinless chicken breast, cubed",
    "1 medium onion, chopped",
    "1 medium green bell pepper, chopped",
    "2 cubes chicken bouillon",
    "1.6666699647903 cups hot water",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground thyme",
    "0.25 teaspoon garlic powder",
    "1 cup frozen green peas",
    "1.5 cups instant rice",
    "2 medium tomatoes, diced"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Stir in sausage, and brown well, about 5 minutes. Remove, and drain fat. Stir chicken, onion, and green pepper into skillet, and cook 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, in a small bowl, stir bouillon cubes into hot water to dissolve. Stir in salt, thyme, and garlic powder. Pour into skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir peas into skillet, and bring to a boil. Cover, reduce heat to medium low, and simmer about 5 minutes. Stir in rice and tomatoes; cover, remove from heat, and let stand 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
