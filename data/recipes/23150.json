  "ingredients": [
    "0.5 cup butter",
    "1.5 cups brown sugar",
    "3 eggs",
    "1 (1 pound) loaf bread, crumbled",
    "2 cups heavy cream",
    "1.5 cups milk",
    "1 cup banana liqueur",
    "2 teaspoons ground cinnamon",
    "1 dash vanilla extract",
    "1 cup chopped pecans",
    "6 bananas, sliced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together butter and sugar. Beat in eggs. Blend in bread, cream, milk, banana liqueur, cinnamon and vanilla. Fold in nuts and banana slices. Pour into a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 90 minutes, until set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
