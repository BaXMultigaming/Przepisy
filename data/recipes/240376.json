  "ingredients": [
    "0.5 cup water",
    "0.5 (12 ounce) can CONTADINA® Tomato Paste",
    "1 teaspoon dried oregano, crushed",
    "1 teaspoon dried basil, crushed",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon sugar",
    "0.5 teaspoon salt",
    "0.25 teaspoon black pepper",
    "3.25 cups all-purpose flour, or more as needed",
    "2 (.25 ounce) envelopes FLEISCHMANN'S® Pizza Crust Yeast or RapidRise® Yeast",
    "1 tablespoon sugar",
    "1.5 teaspoons salt",
    "1.3333333730698 cups very warm water (120 degrees F to 130 degrees F)",
    "0.33333334326744 cup oil",
    "1 cup shredded mozzarella cheese, or more to taste",
    "1 (6 ounce) package HORMEL® Pepperoni"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease two 12-inch pizza pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make sauce: Whisk together water, tomato paste, oregano, basil, garlic powder, onion powder, sugar, salt, and pepper in a medium bowl until smooth. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wIL78s1O5rK3LzvOEsIWWV73DZs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240376-homemade-pepperoni-pizza-Step-01-39b5d3028ebd41d598fc2f74fb34007f.jpg"
      ],
      "image": "assets/images/240376/step_02.webp"
    },
    {
      "text": "Make crust: Combine 2 cups flour, yeast, sugar, and salt in a large bowl. Add warm water and oil; mix until well blended, about 1 minute. Gradually add remaining flour, a little at a time, until a soft, sticky dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b6Od1Qa60ubjLqUFRWSNrtwEFq0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240376-homemade-pepperoni-pizza-Step-02-7aea9ec7e02c4939a99a4c1d73ed3405.jpg"
      ],
      "image": "assets/images/240376/step_03.webp"
    },
    {
      "text": "Transfer dough to a floured surface; knead until dough is smooth and elastic, about 4 minutes. Add more flour as needed. (If using RapidRise yeast, let dough rest, covered, for 10 minutes.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough in half. Lightly flour your hands, then pat each piece of dough onto the prepared pizza pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uOfhzns8ohWLuAdbGIytafw04mU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240376-homemade-pepperoni-pizza-Step-03-e08a3981169b42d4a1dc02d322a8db0f.jpg"
      ],
      "image": "assets/images/240376/step_05.webp"
    },
    {
      "text": "Top dough with sauce, cheese, and pepperoni.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0xF7wGS57fFcaCzLRYT3f6wboas=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240376-homemade-pepperoni-pizza-Step-04-809f8a5af87841d8ba2d140b8e967ece.jpg"
      ],
      "image": "assets/images/240376/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until crusts are browned and cheese is bubbly, 18 to 20 minutes. Rotate pizza pans between the top and bottom oven racks halfway through baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fDBQSzj5Bf1S1tAc0PbfH3hH1LQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240376-homemade-pepperoni-pizza-Step-05-b74e11ad20be40b78c73bb40a432be63.jpg"
      ],
      "image": "assets/images/240376/step_07.webp"
    }
