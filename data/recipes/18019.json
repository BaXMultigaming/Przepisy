  "ingredients": [
    "1 (1 pound) loaf frozen bread dough, thawed",
    "1 large egg, beaten",
    "4 ounces sliced pepperoni",
    "1 cup shredded mozzarella cheese",
    "0.25 cup grated Parmesan cheese",
    "1.5 teaspoons Italian seasoning"
  ],
  "steps": [
    {
      "text": "Place thawed dough into a bowl; cover and let rise in a warm place until doubled in volume, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into a rectangle, then brush with beaten egg and arrange pepperoni over top. Sprinkle mozzarella, Parmesan, and Italian seasoning over pepperoni. Roll dough over fillings like a jelly roll and pinch the seam to seal. Place dough, seam-side down, onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a bread knife to cut loaf into slices of your desired size.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
