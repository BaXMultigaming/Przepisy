  "ingredients": [
    "8 hard-boiled eggs, halved lengthwise with yolks and whites separated",
    "0.25 cup Greek yogurt",
    "1 stalk celery, minced",
    "2 tablespoons minced Anaheim chile pepper",
    "2 tablespoons mayonnaise",
    "1.5 tablespoons Dijon mustard",
    "1 tablespoon hot Buffalo wing sauce (such as Frank's® REDHOT Buffalo Wing Sauce), or to taste",
    "0.25 teaspoon garlic salt",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon paprika",
    "2 tablespoons finely grated Cheddar cheese, or more to taste"
  ],
  "steps": [
    {
      "text": "Beat egg yolks, celery, yogurt, Anaheim pepper, mayonnaise, mustard, Buffalo wing sauce, garlic salt, onion powder, black pepper, and paprika together in a bowl with a fork until mixture is creamy and smooth. Mix in Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place egg white halves on a platter. Spoon egg yolk mixture evenly into egg white halves.",
      "section": null,
