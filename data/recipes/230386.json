  "ingredients": [
    "1 cup all-purpose flour",
    "1.25 cups whole-wheat flour",
    "1 tablespoon baking powder",
    "2.5 teaspoons white sugar",
    "0.5 teaspoon cream of tartar",
    "0.25 teaspoon salt",
    "0.33333334326744 cup vegetable oil",
    "0.25 cup butter",
    "0.66666668653488 cup milk",
    "0.33333334326744 cup vegetable oil",
    "1.5 cups chopped walnuts",
    "1 fresh peach, cut into cubes",
    "0.66666668653488 cup maple syrup",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 450 degrees F (230 degrees C). Grease a 9-inch round pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all-purpose flour, whole-wheat flour, baking powder, sugar, cream of tartar, and salt together in a large bowl. Blend 1/3 cup vegetable oil and butter into the flour mixture until it looks like bread crumbs. Stir milk into the mixture to form a dough. Roll the dough into balls smaller than 1 inch in diameter and arrange into the prepared pan. Drizzle 1/3 cup vegetable oil over the dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle chopped walnuts over the dough; top with peach cubes. Stir maple syrup and cinnamon together in a small bowl; drizzle evenly over the peaches and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the edges of the dough is golden brown, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
