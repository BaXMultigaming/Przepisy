  "ingredients": [
    "0.5 cup unpopped popcorn",
    "1 cup white sugar",
    "0.5 cup light corn syrup",
    "0.5 cup butter",
    "0.25 cup water",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Pop popcorn in a hot air popper according to manufacturer's instructions. Transfer to a large bowl; set aside",
