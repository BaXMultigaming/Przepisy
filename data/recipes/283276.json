  "ingredients": [
    "1.5 cups unsalted raw cashews",
    "0.5 cup water",
    "3 tablespoons lemon juice",
    "1 teaspoon apple cider vinegar",
    "0.25 teaspoon salt, or more to taste",
    "3 tablespoons chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Place cashews in a bowl. Add hot water to cover; soak for 5 to 10 minutes. Drain and transfer to a blender.",
      "section": null,
