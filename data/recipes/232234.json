  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 ¼ cups flour, ½ cup white sugar, baking powder, baking soda, and salt together in a bowl using a fork. Stir in ½ cup butter, milk, egg, and vanilla extract until evenly combined; pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ½ cup flour, ¼ cup white sugar, and 3 tablespoons butter in a separate bowl using a fork until mixture resembles crumbs; sprinkle ½ over batter in pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir blueberry pie filling and lemon extract together in a bowl; spread over crumb topping. Sprinkle blueberries over pie filling; top with remaining ½ crumb topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake is golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
