  "ingredients": [
    "1 large plum tomato, coarsely chopped",
    "1 bunch fresh cilantro, stems removed",
    "0.5 small onion, coarsely chopped",
    "1 jalapeno pepper, coarsely chopped",
    "2 cloves garlic, coarsely chopped",
    "2 tablespoons olive oil",
    "0.5 lime, juiced",
    "1 tablespoon white sugar",
    "2 teaspoons apple cider vinegar",
    "1 teaspoon salt",
    "1 bunch green onions, finely chopped"
  ],
  "steps": [
    {
      "text": "Combine tomato, cilantro, onion, jalapeño, and garlic in the bowl of a food processor; add oil, lime juice, sugar, vinegar, and salt. Pulse until a coarse paste forms. Fold in green onions.",
