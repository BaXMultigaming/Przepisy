  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 onion, chopped",
    "1 (15 ounce) can black beans, undrained",
    "1 (14.5 ounce) can stewed tomatoes",
    "1 teaspoon dried oregano",
    "0.5 teaspoon garlic powder",
    "1.5 cups uncooked instant brown rice"
  ],
  "steps": [
    {
      "text": "Heat oil over medium-high in a large saucepan. Add onion; cook and stir until tender. Add beans, tomatoes, oregano, and garlic powder. Bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in rice. Cover; reduce heat and simmer for 5 minutes. Remove from heat; let stand 5 minutes before serving.",
