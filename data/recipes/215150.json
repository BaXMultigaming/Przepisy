  "ingredients": [
    "3 apples - peeled, cored and sliced",
    "3 fresh peaches - peeled, pitted, and sliced",
    "3 ripe plums, peeled, pitted and sliced",
    "4 large strawberries, sliced",
    "1 tablespoon white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup water",
    "0.5 cup melted butter",
    "1 cup white sugar",
    "0.5 cup apricot nectar",
    "1 cup all-purpose flour",
    "0.5 cup quick-cooking rolled oats",
    "0.5 cup graham cracker crumbs",
    "1 tablespoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scatter the apples, peaches, plums, and strawberries into the bottom of the prepared baking dish, mixing the fruit well. Sprinkle with 1 tablespoon of sugar and 1/2 teaspoon of cinnamon if desired. Pour the water over the fruit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the butter, 1 cup of sugar, the apricot nectar, flour, rolled oats, graham cracker crumbs, and 1 tablespoon of cinnamon in a bowl until the mixture is crumbly and well combined. Sprinkle the crumbly mixture over the pan of fruit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the topping is lightly browned and the fruit is tender, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
