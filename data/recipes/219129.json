  "title": "Amazing Spinach Artichoke Casserole",
  "description": "This creamy spinach artichoke casserole with mushrooms, roasted garlic, and cheese is topped with French-fried onions for a flavor everyone will love.",
  "authors": [
    "mharbold"
  ],
  "date_published": "2019-07-10T03:02:56-04:00",
