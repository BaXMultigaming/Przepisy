  "ingredients": [
    "1 teaspoon butter",
    "0.25 cup white sugar",
    "3 tablespoons brown rice flour",
    "2 tablespoons sorghum flour",
    "2 tablespoons potato starch",
    "1 tablespoon tapioca starch",
    "1 teaspoon finely ground powdered milk",
    "0.5 teaspoon baking powder",
    "1 pinch freshly ground nutmeg",
    "0.33333334326744 cup milk, or as needed",
    "2 tablespoons butter, softened",
    "0.5 pound peaches, pitted and cut into eighths",
    "1.5 teaspoons vanilla sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 7x5x2-inch baking dish with 1 teaspoon butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, brown rice flour, sorghum flour, potato starch, tapioca starch, powdered milk, baking powder, and nutmeg together in a bowl. Stir in milk until batter is the consistency of thin pancake batter. Fold in 2 tablespoons softened butter until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared baking dish. Place peaches gently on top in a single layer. Sprinkle vanilla sugar over the peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top and edges are browned, about 45 minutes. Cool before serving, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
