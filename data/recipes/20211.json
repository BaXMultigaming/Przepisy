  "ingredients": [
    "0.75 cup white sugar",
    "0.33333334326744 cup unsweetened cocoa powder",
    "1 pinch salt",
    "0.33333334326744 cup boiling water",
    "3.5 cups milk",
    "0.75 teaspoon vanilla extract",
    "0.5 cup half-and-half cream"
  ],
