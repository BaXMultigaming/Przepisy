  "ingredients": [
    "1.5 cups sifted pastry flour",
    "1 cup white sugar",
    "0.25 cup unsweetened cocoa powder",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup water",
    "0.33333334326744 cup vegetable oil",
    "0.25 cup white vinegar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Have ready an un-greased 8 inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the flour, sugar, cocoa, baking powder, baking soda and salt into an un-greased pan. Make a well in the center and pour in the water, oil, vinegar and vanilla. Mix until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
