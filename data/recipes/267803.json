  "ingredients": [
    "2 eggs",
    "1 egg white",
    "0.25 cup milk",
    "1 teaspoon dried parsley",
    "1 teaspoon dried thyme",
    "1 teaspoon garlic powder",
    "1 teaspoon chili powder",
    "1 small clove garlic, minced",
    "0.5 teaspoon sazon seasoning",
    "0.5 teaspoon adobo seasoning",
    "3 Vienna sausages, diced",
    "2 tablespoons shredded mozzarella cheese",
    "1 teaspoon olive oil, or as needed"
  ],
  "steps": [
    {
      "text": "Beat eggs, egg white, and milk together in a bowl until combined. Add parsley, thyme, garlic powder, chili powder, garlic, sazon, and adobo. Add sausages and mozzarella cheese and stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a skillet over medium heat and coat surface lightly with oil. Pour egg mixture into the hot skillet; cook and stir until firm and no longer runny, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
