  "ingredients": [
    "1 (16 ounce) package egg noodles",
    "1 pound lean ground beef",
    "1 (8 ounce) package cream cheese, cut into pieces",
    "1 (6 ounce) can chopped mushrooms, with liquid",
    "1 (.75 ounce) packet dry brown gravy mix",
    "2 (10.5 ounce) cans condensed cream of mushroom soup",
    "1 (8 ounce) container sour cream",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M5YTbq--lMxCQRrqYSav9NoOTkQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23260-simple-hamburger-stroganoff-DDMFS-step-1-4x3-159-9d436c71d3ee4293ba656e3dc52d1f04.jpg"
      ],
      "image": "assets/images/23260/step_01.webp"
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NNInoG57Kla4vqy-LwuMVLjqf1U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23260-simple-hamburger-stroganoff-DDMFS-step-2-4x3-160-577f178c091d4038a8ebc070eb1a91d9.jpg"
      ],
      "image": "assets/images/23260/step_02.webp"
    },
    {
      "text": "Meanwhile, cook ground beef in a large skillet over medium-high heat, stirring occasionally, until browned and crumbly, 5 to 7 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dj4X5I56hfSv_TVgKReeSMDlbf4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23260-simple-hamburger-stroganoff-DDMFS-step-3-4x3-161-f7800ad15166425ea085316deff2d297.jpg"
      ],
      "image": "assets/images/23260/step_03.webp"
    },
    {
      "text": "Stir in cream cheese, mushrooms with liquid, and gravy mix; cook and stir over medium heat until cream cheese melts, 2 to 3 minutes. Add condensed soup, sour cream, and milk; cook, stirring occasionally, until smooth and creamy, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wIrTN_90oLblZU4L4g0v0vkvPDE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23260-simple-hamburger-stroganoff-DDMFS-step-4-4x3-164-ebc66c6c316b496ca6a3c458caf6d518.jpg"
      ],
      "image": "assets/images/23260/step_04.webp"
    },
    {
      "text": "Drain egg noodles; stir into the beef mixture. Cook until heated through, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HunzVPhUKE0g-_SKlR0DURnYw08=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23260-simple-hamburger-stroganoff-DDMFS-step-6-4x3-166-32a73727d26b4a6ba8d947eb630b0001.jpg"
      ],
      "image": "assets/images/23260/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qkLIH9srLyA4b4ylF7jsPSNEtyY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23260-simple-hamburger-stroganoff-DDMFS-beauty-4x3-172-2e2fe9b6ec174ac2aa944ed2c6361f47.jpg"
      ],
      "image": "assets/images/23260/step_06.webp"
    }
