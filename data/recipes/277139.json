  "ingredients": [
    "1.125 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.75 cup packed brown sugar",
    "0.66666668653488 cup butter",
    "1 tablespoon evaporated milk",
    "0.5 teaspoon vanilla extract",
    "1 large egg",
    "1 cup chocolate chips",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, baking powder, and salt in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, butter, evaporated milk, and vanilla extract in a separate bowl until creamy. Beat in egg. Gradually mix in flour mixture. Stir in chocolate chips and pecans. Spoon into balls and place on cookie sheets about 1 1/2 to 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 10 minutes. Let cool for about 2 minutes before serving.",
