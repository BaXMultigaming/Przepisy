  "ingredients": [
    "1 cup uncooked adzuki beans",
    "1 tablespoon olive oil",
    "2 cloves garlic, peeled and crushed",
    "6 cups roughly chopped kale",
    "2 tablespoons water",
    "0.25 cup tamari",
    "1 teaspoon ground cumin",
    "1 teaspoon ground coriander",
    "salt and pepper to taste"
