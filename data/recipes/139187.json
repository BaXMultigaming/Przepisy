  "ingredients": [
    "2 cups sour cream",
    "0.5 cup confectioners' sugar",
    "2 tablespoons vanilla extract",
    "5 cups green seedless grapes",
    "1 cup butter",
    "1 cup brown sugar"
  ],
  "steps": [
    {
      "text": "Combine sour cream, confectioners' sugar, and vanilla in a large bowl; stir in grapes. Set aside.",
