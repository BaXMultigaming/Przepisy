  "ingredients": [
    "1 cup milk",
    "2 tablespoons unsweetened cocoa powder",
    "1 tablespoon ground cinnamon",
    "1 tablespoon vanilla extract",
    "2 teaspoons brown sugar",
    "0.75 cup quick-cooking oats"
  ],
  "steps": [
    {
      "text": "Combine milk, cocoa powder, cinnamon, vanilla extract, and brown sugar in a small saucepan and bring to a boil over medium-high heat, stirring occasionally. Stir oats into boiling milk and cook over medium heat for 1 to 2 minutes.",
