  "ingredients": [
    "1 cup chopped walnuts",
    "0.5 cup all-purpose flour",
    "0.5 cup butter, softened",
    "2 (3.9 ounce) packages instant chocolate pudding mix",
    "2 cups cold milk",
    "1 (8 ounce) package cream cheese, softened",
    "1 cup confectioners' sugar",
    "0.5 cup heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine walnuts and flour. Mix well, then stir in softened butter or margarine. Stir until ingredients are combined and mixture forms a ball. Press into bottom of a 9x13 inch pan. Bake in preheated oven for 20 minutes, until golden brown. Remove and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pudding mix in a medium bowl and whisk in milk. Mix until smooth. Allow to set up for 5 minutes then spread on top of cooled crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl whip cream cheese until fluffy. Beat in confectioner’s sugar until mixture is smooth. In a separate bowl, whip cream until soft peaks form, then fold into cream cheese mixture. Spread over pudding layer. Chill before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
