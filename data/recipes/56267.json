  "ingredients": [
    "0.75 cup white sugar",
    "8 ounces cream cheese, softened",
    "1 (20 ounce) can crushed pineapple, drained",
    "1 (10 ounce) package frozen strawberries, thawed",
    "2 bananas, diced",
    "1 (8 ounce) tub frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "In a medium bowl, cream together the sugar and cream cheese until smooth. In a separate bowl, mix together the pineapple, strawberries, bananas, and whipped topping. Fold the fruit mixture into the cream cheese mixture until evenly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread into a 9x13 inch glass dish, or divide among several smaller serving dishes. Cover with plastic wrap, and freeze overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thaw for approximately 20 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
