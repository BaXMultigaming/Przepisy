  "ingredients": [
    "1 (5 pound) ready-to-eat ham",
    "0.25 cup whole cloves",
    "2 cups honey",
    "0.66666668653488 cup butter",
    "0.25 cup dark corn syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a roasting pan with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Score ham in a crosshatch pattern; stud with whole cloves. Place ham in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ISxbT_qbMjXMl2tT8y0XM3jb_J4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14745-HoneyGlazedHam-mfs-Step1-1653-0d66ce7ec6a042858a243c070410be0b.jpg"
      ],
      "image": "assets/images/14745/step_02.webp"
    },
    {
      "text": "Heat honey, butter, and corn syrup in the top half of a double boiler on medium heat until butter melts. Keep glaze warm while ham bakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8CTM6Xq-Uizvc_isvyf3rKPun5A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14745-HoneyGlazedHam-mfs-Step2-1654-3f5e8d156ef24057af2722d49f324bc1.jpg"
      ],
      "image": "assets/images/14745/step_03.webp"
    },
    {
      "text": "Brush glaze over ham; bake in the preheated oven for 1 hour and 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Baste ham with glaze every 10 to 15 minutes. Broil to caramelize glaze during last 4 to 5 minutes of cooking time. Remove from oven and let sit a few minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i_heekiNOshBXbevM2ldnYgGTj8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14745-HoneyGlazedHam-mfs-Step4-1730-ef5353a6923e4922b94d9c1c99e92776.jpg"
      ],
      "image": "assets/images/14745/step_05.webp"
    },
    {
