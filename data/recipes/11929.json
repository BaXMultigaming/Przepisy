  "ingredients": [
    "1 (16 ounce) package wide egg noodles",
    "3 cubes chicken bouillon",
    "0.25 cup water",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "0.5 cup chopped onion",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon poppy seeds",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon hot pepper sauce",
    "2 cups cottage cheese",
    "2 cups sour cream",
    "0.25 cup grated Parmesan cheese",
    "1 pinch paprika"
  ],
  "steps": [
    {
      "text": "Cook egg noodles in a large pot with boiling salted water. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl dissolve chicken bouillon cube in boiling water. Mix in the cream of mushroom soup, chopped onion, Worcestershire sauce, poppy seeds, garlic powder, and hot pepper sauce. Stir in cottage cheese, sour cream, and cooked egg noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to lightly greased slow cooker and sprinkle the top with parmesan cheese and paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on high for 3 to 4 hours. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
