  "ingredients": [
    "4 slices bacon, cut into 1x1/2-inch squares",
    "3 eggs",
    "2 tablespoons white sugar",
    "1 teaspoon salt",
    "2 cups milk",
    "1 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread bacon squares into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon under preheated broiler until brown, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, sugar, and salt together in a bowl; add milk and flour alternately while mixing with a spoon to make a thin batter. Pour batter into the hot baking dish with the bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until puffy and brown, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
