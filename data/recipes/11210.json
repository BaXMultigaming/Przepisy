  "ingredients": [
    "3 cups all-purpose flour",
    "1 teaspoon baking powder",
    "3 tablespoons white sugar",
    "1 cup dry red wine",
    "0.5 cup vegetable oil",
    "0.33333298563957 cup granulated sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine the flour, baking powder and sugar. Add the wine and oil. Mix with a large fork and then with your hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll small pieces of dough between hands to make \"logs\" then shape into circles. The circles should be no bigger than the 2 inches in diameter. Roll cookies in extra sugar and place on cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 25 minutes or until slightly brown. After cookies cool they should be hard and crisp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
