  "ingredients": [
    "1 tablespoon olive oil",
    "1 onion, chopped",
    "3 cloves garlic, minced",
    "1 (6.5 ounce) can minced clams, with juice",
    "1 teaspoon dried thyme",
    "1 teaspoon dried oregano",
    "1 egg, beaten",
    "0.5 cup seasoned bread crumbs",
    "2 tablespoons melted butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a saucepan over medium heat. Cook onion in heated oil for 2 to 3 minutes. Add garlic and cook for 1 to 2 minutes more, making sure not to brown the garlic. Stir in the clams, thyme, and oregano. Remove from heat and stir in the beaten egg. Once combined, mix in breadcrumbs and spoon mixture into 4 ramekins; arrange on a baking sheet. Drizzle butter over each ramekin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
