  "ingredients": [
    "2 pounds skinless, boneless chicken breasts, cut into cubes",
    "2 potatoes, peeled and cubed",
    "1 onion, chopped",
    "1 clove garlic, minced",
    "1 (13.5 ounce) can coconut milk",
    "1 cup chicken broth",
    "0.25 cup curry powder",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 red bell pepper, chopped",
    "1 tablespoon cornstarch",
    "1 tablespoon raisins, or to taste",
    "1 tablespoon flaked coconut, or to taste"
  ],
  "steps": [
    {
      "text": "Place chicken, potatoes, onion, garlic, coconut milk, chicken broth, curry powder, salt, and black pepper in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 4 hours. Add red bell pepper and continue to cook for 45 minutes. Stir in cornstarch and cook until thickened, about 15 minutes more. Sprinkle with raisins and coconut flakes to serve.",
      "section": null,
      "name": null,
      "url": null,
