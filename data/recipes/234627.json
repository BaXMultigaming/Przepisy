  "ingredients": [
    "cooking spray",
    "1 pound ground turkey",
    "1 (28 ounce) can crushed tomatoes",
    "1 (15 ounce) can black beans, rinsed and drained",
    "1 (15 ounce) can kidney beans, rinsed and drained",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (6 ounce) can tomato paste",
    "3 tablespoons chili powder",
    "2 teaspoons ground black pepper",
    "1 teaspoon salt",
    "0.5 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Lightly coat the inside of a slow cooker with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground turkey in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Transfer ground turkey to the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir crushed tomatoes, black beans, kidney beans, diced tomatoes, tomato paste, chili powder, black pepper, salt, and garlic powder into ground turkey.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
