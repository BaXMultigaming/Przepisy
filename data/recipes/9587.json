  "ingredients": [
    "1 cup shortening",
    "2 cups packed brown sugar",
    "2 eggs",
    "2 cups thick applesauce, drained",
    "0.5 cup cold, brewed coffee",
    "3.5 cups all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cloves",
    "1 teaspoon ground nutmeg",
    "1 cup raisins",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Cream shortening and sugar together. Add eggs and mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in applesauce and coffee.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In separate bowl, mix remaining ingredients together. Add to applesauce mixture and blend thoroughly. Chill at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oven to 400 degrees F. Lightly grease cookie sheet. Drop rounded tablespoonfuls of dough onto cookie sheet about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 9 to 12 minutes. Cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
