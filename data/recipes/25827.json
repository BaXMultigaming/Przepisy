    "publisher-tested"
  ],
  "ingredients": [
    "0.75 cup brown sugar",
    "0.5 cup honey",
    "0.5 cup dark molasses",
    "1 egg",
    "3 cups sifted all-purpose flour",
    "1.25 teaspoons ground nutmeg",
    "1.25 teaspoons ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon baking soda",
    "0.5 cup slivered almonds",
    "0.5 cup candied mixed fruit peel, finely chopped",
    "1 egg white, beaten",
    "1 tablespoon lemon juice",
    "0.5 teaspoon lemon zest",
    "1.5 cups sifted confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VhTpbwMEhyTD99nv6KSfkfbM8PQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25827-german-lebkuchen-VAT-step-01-5d78223a43bb43fc88ac99555a5669be.jpg"
      ],
      "image": "assets/images/25827/step_01.webp"
    },
    {
      "text": "Beat brown sugar, honey, and egg in a large bowl with an electric mixer until smooth; stir in molasses.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VrLsGlxxy57cc_LFxQMRjxqwfiI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25827-german-lebkuchen-VAT-step-02-bf97b8a9ec48481fbfe548027b6d5c16.jpg"
      ],
      "image": "assets/images/25827/step_02.webp"
    },
    {
      "text": "Combine flour, nutmeg, cinnamon, cloves, allspice, and baking soda in a separate bowl; stir into the molasses mixture to form a sticky dough. Stir in almonds and candied fruit peel. Cover dough and chill overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kmQz9r6EeKKtGJckLO3F-XH8uFA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25827-german-lebkuchen-VAT-step-03-ada6e14a425d4a3eacd3151df9d1d7b6.jpg"
      ],
      "image": "assets/images/25827/step_03.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease or line cookie sheets. Roll out dough on a lightly floured surface to a thickness of 1/4 inch.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VkFdacL55aY0baHlSaoOS7OIiRA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25827-german-lebkuchen-VAT-step-04-9919d4ff9af44a0db3a4df0b8795b5a4.jpg"
      ],
      "image": "assets/images/25827/step_04.webp"
    },
    {
      "text": "Cut into 2x3-inch rectangles. Place cookies 1 ½ inches apart on prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5W-mNaIvSTX1kFOFkzVi1vIFPdM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25827-german-lebkuchen-VAT-step-05-f332180e0b7e4738aeaa9315427a0ff1.jpg"
      ],
      "image": "assets/images/25827/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IURaVYzYikR5jBom1bVhpGhcHSA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25827-german-lebkuchen-VAT-step-06-8550290b26534011896443f113db5f8e.jpg"
      ],
      "image": "assets/images/25827/step_06.webp"
    },
    {
      "text": "While the cookies are baking, make the glaze: Stir egg white, lemon juice, and lemon zest together in a small bowl. Mix in confectioners' sugar until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cMJrpclX1G1-HZKTM0b9QOjXeLk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25827-german-lebkuchen-VAT-step-07-28e80539c07d4d18b0bc4a4dafe41971.jpg"
      ],
      "image": "assets/images/25827/step_07.webp"
    },
    {
      "text": "Brush glaze over cookies while they are still warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SbanT68ViYbgRs32B-sjcfUwXCE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25827-german-lebkuchen-VAT-step-08-6ae143666b634708907bd779fcc74723.jpg"
      ],
      "image": "assets/images/25827/step_08.webp"
    },
    {
      "text": "Transfer cookies to a wire rack to cool and set completely before storing in a single layer in airtight containers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AkDIrr9BhIsoTZGZ6mW8qiGVzTw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25827-german-lebkuchen-VAT-step-09-d413a958457d4fb1bbf7f9cfd7d070bb.jpg"
      ],
      "image": "assets/images/25827/step_09.webp"
    }
  ],
