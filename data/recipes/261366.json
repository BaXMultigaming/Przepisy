  "ingredients": [
    "2 cups water",
    "1 cup long-grain rice",
    "1 teaspoon olive oil",
    "1 small onion, chopped",
    "1 bunch fresh spinach",
    "1 lemon, zested and juiced",
    "0.25 cup crumbled feta cheese",
    "0.25 cup chopped fresh dill",
