  "ingredients": [
    "2 cups vegetable oil for frying",
    "0.5 cup all-purpose flour",
    "0.25 cup cornstarch",
    "2 tablespoons dry potato flakes",
    "0.125 teaspoon cayenne pepper, or to taste",
    "1 cup chilled club soda",
    "2 cups panko bread crumbs, or as needed",
    "2 large onions, cut into 1/4-inch thick slices and separated into rings",
    "fine salt to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour, cornstarch, potato flakes, and cayenne pepper in a large bowl. Whisk in club soda to make a smooth batter. Place bread crumbs in a shallow pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, dip onion rings into batter, then press in bread crumbs to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook coated onion rings, a few at a time, in hot oil until golden brown, 2 to 3 minutes. Transfer to a cooling rack set over paper towels to drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with fine salt and serve hot.",
      "section": null,
      "name": null,
      "url": null,
