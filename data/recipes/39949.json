  "ingredients": [
    "1 cup unsweetened applesauce",
    "0.33333334326744 cup vegetable oil",
    "1 eggs, beaten",
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1 cup fresh or frozen cranberries, chopped",
    "0.5 cup pecans, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a muffin pan, or use paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix together applesauce, oil, and egg. In a large bowl, combine flour, sugar, baking soda, cinnamon, and salt. Make a well in the center, and pour in the egg mixture. Stir until just moistened. Fold in cranberries and pecans. Spoon into muffin cups, 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes, or until a toothpick inserted into the center comes out clean. Cool in pan for 2 minutes before removing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
