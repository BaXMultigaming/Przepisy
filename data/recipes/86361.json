  "ingredients": [
    "8 hard-cooked eggs, diced",
    "1 cup mayonnaise",
    "0.25 cup dried onion flakes",
    "0.5 teaspoon salt",
    "1 teaspoon mustard powder",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon black pepper",
    "1 teaspoon dill weed",
    "8 slices white bread"
  ],
  "steps": [
    {
      "text": "In a bowl, gently mix the eggs, mayonnaise, onion flakes, salt, mustard powder, garlic powder, pepper, and dill. Cover, and refrigerate 8 hours, or overnight. To serve, spread equal amounts on 4 slices bread; top with remaining bread slices to make sandwiches.",
