  "ingredients": [
    "1 butternut squash",
    "1 cup chopped red onion",
    "2 tablespoons olive oil",
    "3 ounces fresh spinach, stems removed and leaves torn in bite-size pieces",
    "0.33333334326744 cup sweetened dried cranberries (such as Craisins®)",
    "0.33333334326744 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice butternut squash cross-wise into 1-inch slices; peel and clean each slice, removing and discarding seeds and stringy pulp from the center. Cut cleaned slices into 1-inch cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss squash cubes, onion, and olive oil together in a bowl until coated; transfer to the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until squash is tender and starting to brown, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss squash mixture, spinach, dried cranberries, and pecans together in a serving bowl and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
