  "ingredients": [
    "8 bacon strips",
    "8 eggs",
    "0.33333334326744 cup milk",
    "3 tablespoons water",
    "salt and pepper to taste",
    "0.33333334326744 cup diced onion",
    "2 large potatoes, peeled and chopped",
