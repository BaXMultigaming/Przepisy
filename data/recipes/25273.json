  "ingredients": [
    "2 cups finely crushed herb-seasoned dry bread stuffing mix",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "3 large eggs, beaten",
    "0.5 cup grated Parmesan cheese",
    "0.5 cup melted butter",
    "2 teaspoons garlic powder",
    "1 teaspoon Italian seasoning",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine stuffing mix, spinach, eggs, Parmesan cheese, melted butter, garlic powder, Italian seasoning, and black pepper in a large bowl; mix well. Use your hands to shape spinach mixture into walnut-sized balls and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through and browned, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
