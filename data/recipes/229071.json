  "ingredients": [
    "2 pounds ground beef",
    "4 carrots, diced",
    "4 celery ribs, chopped",
    "1 onion, chopped",
    "4 potatoes, peeled and cut into 1-inch pieces",
    "1 (15.25 ounce) can whole kernel corn, drained and rinsed",
    "1 (15 ounce) can green beans, drained and rinsed",
    "1 (15 ounce) can peas, undrained",
    "1 (15 ounce) can tomato sauce",
    "1 (14.5 ounce) can whole tomatoes, crushed",
    "ground black pepper to taste",
    "1 bay leaf, or more to taste",
    "0.125 teaspoon ground thyme",
    "0.25 cup water, as needed"
  ],
  "steps": [
    {
      "text": "Crumble ground beef into a stockpot over medium-high heat; cook and stir until beef is crumbly, evenly browned, and no longer pink, 7 to 10 minutes. Drain and discard any excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9j3xbpPXEKvkqcZrgtW5ktNFspY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229071-GroundBeefVegtableSoup-ddmfs-step-1-103729-4x3-a2ffcc2e87bb46e387c326eebe479459.jpg"
      ],
      "image": "assets/images/229071/step_01.webp"
    },
    {
      "text": "Stir in carrots, celery, and onion; cook and stir until vegetables are soft, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pQ7tNGHAg55X_qvK2Vb2QfKHQyY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229071-GroundBeefVegtableSoup-ddmfs-step-2-103734-4x3-ded8a3ec7a6e4794bcf14de08683ea8a.jpg"
      ],
      "image": "assets/images/229071/step_02.webp"
    },
    {
      "text": "Stir in potatoes, corn, green beans, undrained peas, tomato sauce, and crushed whole tomatoes. Season with black pepper; add bay leaf and thyme.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Tut93W5LXBBzYs-wY3ddcjd8aC8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229071-GroundBeefVegtableSoup-ddmfs-step-4-103743-4x3-3b113d717f8d43439b31a6e9b95ed73d.jpg"
      ],
      "image": "assets/images/229071/step_03.webp"
    },
    {
      "text": "Pour in 1/4 cup water if needed, replenishing as needed while cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring soup to a simmer; cover and cook, stirring regularly, until potatoes are tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dfowfqzK-ZWriPxRiXKh4x3_IeA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229071-GroundBeefVegtableSoup-ddmfs-step-5-103791-4x3-b8717a5fbc3244d5897a3e080bffbf75.jpg"
      ],
      "image": "assets/images/229071/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
