  "title": "Ground Beef Vegetable Soup",
  "description": "This hearty ground beef soup is loaded with chunks of potatoes, carrots, tomatoes, peas, and corn for a satisfying, very easy, and delicious meal.",
  "authors": [
    "Sue's recipes"
  ],
  "date_published": "2019-04-13T01:05:53-04:00",
