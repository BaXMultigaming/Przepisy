    "publisher-tested"
  ],
  "ingredients": [
    "2 (12 ounce) packages frozen French cut green beans",
    "8 ounces crimini mushrooms, quartered",
    "3 tablespoons butter",
    "1 small onion, halved and thinly sliced",
    "1 tablespoon chopped fresh parsley",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon lemon zest",
    "0.5 teaspoon salt",
    "1 pinch ground black pepper",
    "0.5 cup milk",
    "1 cup sour cream",
    "0.5 cup shredded Cheddar cheese",
    "1 (2.8 ounce) can French-fried onions"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place green beans in a saucepan and fill with about 1/2 inch water; bring to a boil. Cover and steam until beans are tender but still bright green, about 5 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KDDUfBzA7Q3PO4jMOfAVgLL1UK4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/94570-absolutely-delicious-green-bean-casserole-from-scratch-VAT-step-02-5a1492d49a6c479fa3fb516890d233da.jpg"
      ],
      "image": "assets/images/94570/step_02.webp"
    },
    {
      "text": "Combine drained beans in a bowl with mushrooms; toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bDAH6sU8ejpNO36rJmHL9SQKTkY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/94570-absolutely-delicious-green-bean-casserole-from-scratch-VAT-step-03-282fa3f6fd434bb9a6be37fae1760949.jpg"
      ],
      "image": "assets/images/94570/step_03.webp"
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add onion and parsley; cook and stir until onion is tender, 5 to 7 minutes. Whisk in flour until blended, then mix in lemon zest, salt, and pepper. Gradually whisk in milk, stirring constantly, so that no lumps form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s_P72ELPPlPtb9SgjgptonHtzy8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/94570-absolutely-delicious-green-bean-casserole-from-scratch-VAT-step-04-504e5c4ff1cb44acaa8b8c6d46eca24c.jpg"
      ],
      "image": "assets/images/94570/step_04.webp"
    },
    {
      "text": "Add sour cream and stir until combined. Warm over medium heat until sauce begins to bubble. Dump in green beans and mushrooms, stirring to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4yzPYUhdTne4ndFp43euG-dNJC8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/94570-absolutely-delicious-green-bean-casserole-from-scratch-VAT-step-05-88f0ab6300924cf7ba1a4a02026c493a.jpg"
      ],
      "image": "assets/images/94570/step_05.webp"
    },
    {
      "text": "Remove from the heat and toss briefly with 1/2 of the Cheddar cheese and 1/2 of the French-fried onions. Spoon into a 1 ½-quart casserole dish; top with the remaining Cheddar and onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7qTLONrVm4HdaGd8pAXqjHrw018=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/94570-absolutely-delicious-green-bean-casserole-from-scratch-VAT-step-06-ee7c272b4f414d4cba14ae10df40d125.jpg"
      ],
      "image": "assets/images/94570/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until Cheddar is melted, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HpYsYDmE4_WpMF9QC6y_WVwX73M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/94570-absolutely-delicious-green-bean-casserole-from-scratch-VAT-step-07-b4ca3c99ba1a4ed88786861f70c262c6.jpg"
      ],
      "image": "assets/images/94570/step_07.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mDEHrwsUM8-q-Ll2XcI4ZoJME5c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/94570-absolutely-delicious-green-bean-casserole-from-scratch-VAT-Beauty-4x3-cc5ee854688d44cb886f82b79691d016.jpg"
      ],
      "image": "assets/images/94570/step_08.webp"
    }
  ],
