  "ingredients": [
    "1 (15.25 ounce) package carrot cake mix",
    "1 (8 ounce) can crushed pineapple with juice",
    "3 large eggs",
    "0.5 cup water",
    "0.5 cup vegetable oil",
    "0.5 cup finely chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two (8-inch) round pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cake mix, pineapple with juice, eggs, water, oil, and nuts in a large bowl with an electric mixer at medium speed until well blended, about 2 minutes. Spread batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the centers comes out clean, 35 to 40 minutes. Cool completely before frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
