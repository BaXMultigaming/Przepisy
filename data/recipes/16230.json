  "ingredients": [
    "2 (9 inch) prepared graham cracker crusts",
    "1 (14 ounce) can sweetened condensed milk",
    "0.25 cup lemon juice",
    "1 cup crunchy peanut butter",
    "1 (7 ounce) jar marshmallow creme",
    "1 (16 ounce) package frozen whipped topping, thawed",
    "1 (12 ounce) jar hot fudge topping",
    "0.25 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "In a large mixing bowl, combine condensed milk, lemon juice, peanut butter, and marshmallow creme. Beat until smooth. Fold in whipped topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon 1/4 of peanut butter mixture into each graham cracker crust. Spread half of fudge topping over each peanut butter layer. Spoon half of remaining peanut butter mixture over each fudge layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with chopped nuts. Freeze until firm, then serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
