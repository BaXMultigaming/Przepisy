  "ingredients": [
    "1 cup uncooked elbow macaroni",
    "1 stalk celery, chopped",
    "1 (2.25 ounce) can chopped green olives",
    "0.25 cup mayonnaise",
    "0.25 cup sour cream",
    "2 tablespoons milk",
    "1 (10 ounce) can chicken chunks, drained",
    "1 (1 ounce) package dry Ranch-style dressing mix",
    "2 teaspoons paprika"
  ],
  "steps": [
    {
      "text": "Bring a pot of water to a boil. Add the macaroni, and cook until tender, about 8 minutes. Drain, and pat dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the celery, olives, mayonnaise, sour cream, milk, chicken and Ranch dressing mix. Stir in macaroni until well blended. Refrigerate for 24 hours. Stir, and sprinkle paprika over the top before serving.",
