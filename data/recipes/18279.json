  "ingredients": [
    "2 sliced zucchini",
    "2 yellow squash",
    "0.25 cup butter",
    "salt and pepper to taste",
    "2 teaspoons dried dill weed",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Slice the zucchini and yellow squash. Place the sliced vegetables in a large skillet or saucepan with the butter. Saute over a medium-low heat for 10 minutes before seasoning with salt, pepper and dill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue to saute for 10 additional minutes before adding the lemon juice. Stir the vegetables well and remove from heat. Serve hot.",
