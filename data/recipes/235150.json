  "ingredients": [
    "1 cup ketchup",
    "0.5 cup water",
    "0.33333334326744 cup apple cider vinegar",
    "0.25 cup butter, melted",
    "1 onion, chopped",
    "1 tablespoon paprika",
    "1 tablespoon white sugar",
    "1 tablespoon Worcestershire sauce",
    "1 teaspoon prepared mustard",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 dash steak sauce (such as A.1.®)",
    "3 pounds skinless chicken thighs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk ketchup, water, vinegar, melted butter, onion, paprika, sugar, Worcestershire sauce, mustard, salt, pepper, and steak sauce together in a saucepan. Bring to a simmer; cook for 5 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread chicken thighs in a single layer in a baking dish. Pour sauce over chicken thighs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until sauce is bubbling and chicken is no longer pink in the center and the juices run clear, about 2 hours. An instant-read thermometer inserted into the thickest part of a thigh should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
