  "ingredients": [
    "3 large cucumbers, sliced",
    "0.125 teaspoon salt, or as needed",
    "1.25 cups sour cream",
    "0.75 bunch green onions (white and pale green parts only), chopped",
    "0.25 cup white sugar",
    "2 tablespoons apple cider vinegar",
    "2 cloves garlic, or more to taste, minced",
    "0.25 teaspoon dried dill weed",
    "0.125 teaspoon paprika",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Spread a paper towel on a large platter; arrange cucumber slices in a single layer on the paper towel. Sprinkle ⅛ teaspoon salt over cucumber slices; refrigerate 2 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine sour cream, green onions, sugar, vinegar, garlic, dill, paprika, black pepper, and remaining ⅛ teaspoon salt in a medium bowl; refrigerate 1 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cucumbers to a large serving bowl; pour sour cream dressing over cucumbers and stir gently to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
