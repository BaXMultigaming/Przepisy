  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "3 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.75 cup miniature semisweet chocolate chips",
    "1 egg, beaten",
    "0.75 cup milk",
    "0.33300000429153 cup vegetable oil",
    "3 tablespoons white sugar",
    "2 tablespoons brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease 12 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine flour, 1/2 cup sugar, baking powder, salt and chocolate chips. Add egg, milk and oil; stir just until batter is moistened. Spoon batter into prepared muffin cups, filling about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, stir together 3 tablespoons white sugar and 2 tablespoons brown sugar. Sprinkle sugar mixture over muffins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated for 20 to 25 minutes, until golden brown. Remove immediately from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
