  "ingredients": [
    "0.5 cup sauerkraut, drained",
    "1 (13 ounce) package kielbasa ring"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill kielbasa ring on one side for 4 minutes. Transfer to a cutting board, grilled side up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut a slit down the length of the kielbasa, leaving an inch on both ends. Be careful not to cut all the way through as you are just making a pocket. Stuff sauerkraut into the pocket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully place the kielbasa back on the grill, stuffed side up. Grill for 4 minutes more. Slice into serving portions and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
