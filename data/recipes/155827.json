        "https://www.allrecipes.com/thmb/j9veBI9roxnZ3uFO_cvfJZt7q0M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-155827-milk-chocolate-peppermint-bark-VAT-step-04-4514fe5afbd3470f93d3ceab568ca3eb.jpg"
