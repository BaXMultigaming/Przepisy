  "ingredients": [
    "1 (16 ounce) package ziti pasta",
    "6 cups shredded mozzarella cheese",
    "1 (24 ounce) jar pasta sauce (such as Ragu®)",
    "1 (15 ounce) container ricotta cheese",
    "1 (8 ounce) package cream cheese, softened and cubed",
    "3 tablespoons grated Parmesan cheese",
    "2 tablespoons Italian seasoning",
    "1 tablespoon garlic powder",
    "0.5 teaspoon salt",
    "2 teaspoons dried parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add ziti and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 4 cups mozzarella, pasta sauce, ricotta, cream cheese, 2 tablespoons Parmesan, Italian seasoning, garlic powder, and salt in a large mixing bowl. Add cooked ziti and mix well to coat. Transfer to a 9x13-inch glass baking dish. Sprinkle remaining mozzarella and Parmesan over top, along with parsley. Cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until thoroughly heated and cheese on top is melted, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
