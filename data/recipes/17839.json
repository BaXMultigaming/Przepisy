  "ingredients": [
    "1 prepared 8 inch pie crust",
    "1 cup all-purpose flour",
    "0.66666668653488 cup packed brown sugar",
    "0.25 teaspoon salt",
    "5 tablespoons butter",
    "0.66666668653488 cup hot water",
    "5 tablespoons molasses",
    "1 tablespoon dark brown sugar",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together flour, 2/3 cup brown sugar, and salt. Cut in butter or margarine until mixture resembles rice. Reserve 3 tablespoons of mixture for sprinkling top of pie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, mix together hot water, molasses, dark brown sugar, and baking soda. Stir molasses mixture into remaining crumb mixture. Pour into pastry shell. Sprinkle with reserved crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 35 to 40 minutes, until top springs back when pressed. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
