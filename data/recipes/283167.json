  "ingredients": [
    "1 cup sourdough starter",
    "1 cup milk",
    "1 large egg, beaten",
    "1 tablespoon vegetable oil",
    "1.25 cups all-purpose flour",
    "2 tablespoons white sugar",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "cooking spray"
  ],
  "steps": [
