  "ingredients": [
    "1 cup white sugar",
    "1.5 cups all-purpose flour",
    "0.5 cup butter, cut into pieces",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "1 teaspoon baking soda",
    "1 pinch salt",
    "1 cup buttermilk",
    "1 egg, lightly beaten"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 7x11 inch baking pan or casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, flour and butter. Use a fork to cut butter in until mixture resembles coarse crumbs. Set aside 1/2 cup of this mixture to use as topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To the remaining flour mixture, add cinnamon, cloves, baking soda and salt. Lightly stir in the buttermilk and egg. Pour batter into prepared pan. Sprinkle cake with reserved topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 25 minutes, until a toothpick inserted into center of the cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
