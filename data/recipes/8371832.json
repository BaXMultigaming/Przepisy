  "ingredients": [
    "0.75 cup graham cracker crumbs",
    "3 tablespoons unsalted butter, melted",
    "2 tablespoons white sugar",
    "1.25 cups semisweet chocolate chips",
    "1.5 (8 ounce) packages cream cheese, softened",
    "0.5 cup white sugar",
    "1 large egg",
    "2 tablespoons unsweetened cocoa powder",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix graham cracker crumbs, melted butter, and 2 tablespoons sugar together in a small bowl. Press 1 tablespoon of the crumb mixture into the bottom of each prepared cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Measure 1/2 cup chocolate chips and set aside for topping. Evenly distribute the remaining chips among the cups, sprinkling them over the crust layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, 1/2 cup sugar, egg, cocoa powder, and vanilla in a large mixing bowl until smooth. Spoon about 1/4 cup of the cream cheese mixture into each cup. Sprinkle remaining chocolate chips over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until just set, 17 to 23 minutes. Remove from the oven and let cool completely on a wire rack, 15 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate for at least 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
