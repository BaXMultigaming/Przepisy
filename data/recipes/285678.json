  "ingredients": [
    "2 (15 ounce) cans pure pumpkin puree",
    "0.75 cup white sugar",
    "0.25 cup pure maple syrup",
    "1.5 teaspoons ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon freshly grated nutmeg",
    "1 pinch ground cloves",
    "1 pinch kosher salt",
    "1 pinch cayenne pepper",
    "1 cup apple juice",
    "1 tablespoon apple cider vinegar",
    "1 tablespoon cold unsalted butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M03TYXcD0lZgI4OX2R2tDuPeNcE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-285678-Old-Fashioned-Pumpkin-Butter-VAT-4x3-Step-01-a7dd61fdf8b4492684a2b365110e32b4.jpg"
      ],
      "image": "assets/images/285678/step_01.webp"
    },
    {
      "text": "Combine pumpkin puree, sugar, maple syrup, cinnamon, ginger, nutmeg, cloves, salt, cayenne pepper, apple juice, and apple cider vinegar in a deep, heavy-bottomed saucepan; whisk until thoroughly combined. Place over medium-high heat and stir occasionally until simmering.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fuPUk8OoqC97ciyIroJjKdHLmOM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-285678-Old-Fashioned-Pumpkin-Butter-VAT-4x3-Step-02-9970f9f817a74211a976fc663faa17df.jpg"
      ],
      "image": "assets/images/285678/step_02.webp"
    },
    {
      "text": "Reduce heat to medium-low and cook, stirring occasionally, until the mixture thickens and reduces by about half, 45 to 60 minutes. The sauce will be very hot, so wear an oven mitt and stir carefully. You may also want to use a splatter guard to keep the sauce from dirtying your stove.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nsc7fyQVf2TFptQYluyq8pWD1aE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-285678-Old-Fashioned-Pumpkin-Butter-VAT-4x3-Step-03-3e83dda3491d46b2a6a0146f1870b0ac.jpg"
      ],
      "image": "assets/images/285678/step_03.webp"
    },
    {
      "text": "Once reduced, remove from the stove and let cool for 10 minutes. Toss in butter and whisk until it disappears. Let cool to room temperature, about 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jqPOkWDrgzG7c3t9XmP6F7kveIY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-285678-Old-Fashioned-Pumpkin-Butter-VAT-4x3-Step-04-ecabcfa377f049299dbbe8a6ed1b4f22.jpg"
      ],
      "image": "assets/images/285678/step_04.webp"
    },
    {
      "text": "Transfer pumpkin butter into an airtight container and place in the refrigerator until thoroughly chilled and flavors have developed, 8 hours to overnight. Store in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VLpJKRfP0Z_lHmHfFcy5eXvzTlE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-285678-Old-Fashioned-Pumpkin-Butter-VAT-4x3-Step-05-15f8cec479334aa0b9e0d77753f29f57.jpg"
      ],
      "image": "assets/images/285678/step_05.webp"
    }
