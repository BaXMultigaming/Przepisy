  "ingredients": [
    "0.5 cup butter",
    "1 cup white sugar",
    "2 eggs",
    "2 cups all-purpose flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1 teaspoon baking powder",
    "2 tablespoons buttermilk",
    "1 cup chopped apples",
    "0.5 cup chopped walnuts",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Butter a 9x5x3-inch pan. Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, add sugar slowly, and continue to beat until light and lemon-colored. Beat in eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour with salt, baking soda, and baking powder. Add to the butter mixture alternately with the buttermilk, beginning and ending with the dry ingredients. Stir in the apples, nuts, and vanilla. Spoon batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 350 degree F (175 degrees C) oven for 50-60 minutes, until the loaf pulls away slightly from the sides of the pan or until a cake tester comes out clean. Cool in the pan for about 5 minutes, then loosen from pan and turn onto a rack to cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
