  "ingredients": [
    "0.5 cup pineapple or other tropical fruit preserves",
    "0.25 cup hoisin sauce",
    "2 tablespoons lime juice",
    "1 tablespoon chopped fresh cilantro",
    "1 teaspoon grated fresh ginger",
    "1 teaspoon sesame oil",
    "4 (6 ounce) tuna steaks, about 1 inch thick"
  ],
  "steps": [
    {
      "text": "To prepare marinade, combine preserves, hoisin, lime juice, cilantro, ginger, and sesame oil in a small bowl. Stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into a resealable plastic bag or glass bowl; toss tuna with marinade to coat. Refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tuna steaks from marinade, shake off excess, and discard remaining marinade. Cook on preheated grill for 4 to 5 minutes per side. Be careful not to overcook - the tuna should be lightly browned on the outside but still slightly pink in the middle. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
