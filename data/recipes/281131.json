  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup shredded coconut",
    "0.5 cup white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "3 large eggs",
    "0.25 cup unsalted butter, melted",
    "1 teaspoon vanilla extract",
    "1.5 cups canned mango puree"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper or foil liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, coconut, sugar, baking powder, cinnamon, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend eggs, butter, and vanilla extract to a creamy consistency in a separate bowl. Add flour mixture and stir until smooth. Fold in pureed mango.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter evenly among the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
