  "ingredients": [
    "1 (.25 ounce) package active dry yeast",
    "0.25 cup warm water (110 degrees F/45 degrees C)",
    "5 cups all-purpose flour",
    "0.25 cup white sugar",
    "3 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1.5 teaspoons salt",
    "1 cup shortening",
    "2 cups buttermilk",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Dissolve yeast in warm water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, sugar, soda, baking powder, and salt. Add buttermilk and dissolved yeast. Add shortening and stir. Store dough, covered, in the fridge until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out on a lightly floured surface or shape into balls — these do not need to rise. Brush tops of biscuits with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 400 degrees F (205 degrees C) for 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
