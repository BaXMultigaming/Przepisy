  "ingredients": [
    "4 cups all-purpose flour",
    "1.5 cups water",
    "1 cup salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, water, and salt together in a large bowl; knead dough until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out dough on floured surface about 1/8-inch thick. Cut shapes with cookie cutters. Place on cookie sheets. Make a hole with a toothpick in the top of the ornament for hanging with a ribbon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Cool completely; decorate with paint and varnish to preserve, if desired.",
