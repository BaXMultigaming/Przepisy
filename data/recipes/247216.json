  "ingredients": [
    "1 (10.25 ounce) package brownie mix",
    "1 egg",
    "0.25 cup vegetable oil",
    "3 tablespoons coffee-flavored liqueur (such as Kahlua®)",
    "2 tablespoons instant coffee granules",
    "1 tablespoon water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease an 8-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brownie mix, egg, vegetable oil, coffee-flavored liqueur, instant coffee, and water in a large bowl; mix with a wooden spoon until batter is evenly moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are set and a toothpick inserted in the center comes out with a few moist crumbs attached, about 20 minutes. Let cool for 20 to 30 minutes before cutting.",
      "section": null,
      "name": null,
      "url": null,
