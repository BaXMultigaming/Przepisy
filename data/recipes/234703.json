  "ingredients": [
    "3 cups hot water",
    "2 tablespoons Italian red wine, or more to taste",
    "2 tablespoons white sugar",
    "0.75 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground ginger",
    "4 fresh spearmint leaves",
    "1 leaf fresh mint leaf",
    "0.5 apple, cubed"
  ],
  "steps": [
    {
      "text": "Combine water, red wine, sugar, cinnamon, nutmeg, ginger, spearmint leaves, and mint leaf in a saucepan; bring to a boil. Reduce heat to low and add apple to mixture. Simmer tea until apple breaks easily with a fork, about 5 minutes. Remove apple using a slotted spoon or strainer and pour tea into a mug.",
