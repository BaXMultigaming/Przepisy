  "ingredients": [
    "butter for greasing",
    "1.5 loaves challah, cut into 1-inch pieces",
    "0.75 cup white sugar, divided",
    "1 tablespoon ground cinnamon, or more to taste",
    "3 cups milk",
    "8 large eggs",
    "1 tablespoon vanilla extract",
    "1 teaspoon salt",
    "1 stick unsalted butter, cut into 10 pieces"
  ],
  "steps": [
    {
      "text": "Butter a 9x13-inch baking dish. Place challah in the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1/4 cup sugar with cinnamon; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix milk, eggs, remaining 1/2 cup sugar, vanilla, and salt together in a bowl. Pour over bread and place butter pieces on top. Sprinkle cinnamon-sugar over the top. Cover with foil and place in the refrigerator, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to bake, preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake French toast, uncovered, in the preheated oven until golden brown, 30 to 45 minutes. Remove from the oven and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
