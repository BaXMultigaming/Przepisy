  "ingredients": [
    "2.25 cups all-purpose flour",
    "0.5 cup white sugar",
    "1 cup butter, softened",
    "2 eggs",
    "1 cup packed brown sugar",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking powder",
    "1 teaspoon vanilla extract",
    "0.5 cup chopped walnuts",
    "0.5 cup flaked coconut",
    "1 (4 ounce) jar maraschino cherries",
    "1 teaspoon butter",
    "1 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, white sugar and butter or margarine. Mix until crumbly. Press into a 9 x 13 inch pan. Bake for 20 minutes or until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, sugar, salt, baking powder, and vanilla. Drain and chop cherries, reserving liquid. Stir chopped cherries, nuts, and coconut into egg mixture. Pour on top of crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 25 min. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 teaspoon butter and 1 cup confectioner's sugar with enough liquid from cherries until spreadable. Frost bars. Sprinkle with coconut when icing is set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
