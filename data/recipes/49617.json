  "ingredients": [
    "1 cup packed brown sugar",
    "1 tablespoon all-purpose flour",
    "5 large Granny Smith apples - peeled, cored and thinly sliced",
    "1 cup frozen raspberries, thawed",
    "0.5 cup old-fashioned oats",
    "0.5 cup all-purpose flour",
    "1.5 teaspoons ground cinnamon",
    "0.25 teaspoon salt",
    "6 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and 1 tablespoon flour in a bowl until blended; toss in apples and raspberries to coat. Transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, ½ cup flour, cinnamon, and salt in a bowl; stir in melted butter until crumbly. Sprinkle over apple mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is lightly browned, 50 to 55 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
