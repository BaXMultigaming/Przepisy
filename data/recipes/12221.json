  "ingredients": [
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon salt",
    "1 cup half-and-half",
    "3 eggs",
    "2 slices Swiss cheese",
    "1 recipe pastry for a 9 inch single crust pie",
    "0.5 cup chopped fresh spinach",
    "0.5 cup canned mushrooms",
    "1 (4.5 ounce) can ham, flaked",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together flour, salt, half-and-half and eggs in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place Swiss cheese flat in the pie crust. Arrange spinach evenly over Swiss cheese, then cover with mushrooms. Pour the flour and egg mixture over mushrooms. Cover with flaked ham and top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 45 to 55 minutes, until surface is golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
