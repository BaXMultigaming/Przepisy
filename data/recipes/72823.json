        "https://www.allrecipes.com/thmb/PBxduygFdk7eVXRHbsWelZRH93Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/72823-blt-pasta-salad-VAT-008-step-06-a6db4813a48a4e07a97952c7497bf41b.jpg"
