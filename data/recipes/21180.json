  "ingredients": [
    "1 cup butterscotch topping",
    "2 eggs",
    "1 cup nonfat evaporated milk",
    "2 cups French bread cubes",
    "0.33333334326744 cup golden raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8x8 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, whisk together butterscotch topping, eggs and evaporated milk. Place half of bread cubes in bottom of baking dish. Cover with raisins. Pour half of topping mixture over raisins, and then layer remaining bread cubes and rest of topping over that. Press bread down to soak up butterscotch mixture. Let stand 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 20 minutes, until heated through and set. Let cool 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
