  "ingredients": [
    "0.25 cup unsalted butter, melted",
    "0.25 cup freshly grated Parmesan cheese",
    "1 teaspoon dried basil",
    "1 teaspoon dried oregano",
    "Kosher salt and freshly ground black pepper, to taste",
    "4 zucchini, cut into 1/4-inch rounds",
    "Reynolds Wrap® Heavy Duty Aluminum Foil",
    "2 tablespoons chopped fresh parsley leaves"
  ],
  "steps": [
    {
      "text": "Preheat a gas or charcoal grill over high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together butter, Parmesan, basil, and oregano in a small bowl; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide zucchini among 3 or 4 sheets of foil. Spoon butter mixture over zucchini. Bring up foil sides. Double fold top and ends to seal packet, leaving room for heat circulation inside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place foil packets on the preheated grill and cook until zucchini is just cooked through, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with parsley and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
