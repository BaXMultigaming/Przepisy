  "ingredients": [
    "1.5 cups brown sugar",
    "0.66666668653488 cup vegetable oil",
    "1 egg",
    "1 cup buttermilk",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.5 cups diced rhubarb",
    "0.5 cup white sugar",
    "1 tablespoon butter",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 5x9-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, oil, egg, buttermilk, flour, baking soda, salt, and rhubarb together in a bowl, in exact order, stirring after each addition, until batter is just combined; pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, butter, and cinnamon together in a bowl until crumbly; lightly press on top of batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
