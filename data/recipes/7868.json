  "ingredients": [
    "4.5 cups cake flour",
    "4 cups white sugar",
    "2 teaspoons salt",
    "2 cups boiling water",
    "16 egg whites",
    "2 tablespoons baking powder",
    "2 teaspoons cream of tartar",
    "2 teaspoons vanilla extract",
    "1 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift cake flour, sugar, and salt three times then stir in boiling water. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites, cream of tartar, baking powder, vanilla, and almond flavorings until stiff peaks form. Fold into flour mixture and pour batter into one ungreased 12x18-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 35 minutes. Cool cake inverted in pan, laying a tea towel underneath cake to absorb steam. Frost as desired once cake is cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
