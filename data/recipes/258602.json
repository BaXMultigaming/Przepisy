  "ingredients": [
    "1 (14.5 ounce) can Del Monte® Sliced Carrots, drained",
    "0.75 cup packed light brown sugar",
    "0.33333334326744 cup vegetable oil",
    "1 large egg",
    "1 cup all-purpose flour",
    "0.5 cup uncooked quick oats",
    "1 tablespoon baking powder",
    "1 teaspoon cinnamon",
    "0.5 teaspoon salt",
    "0.5 cup dried cranberries or golden raisins",
    "0.5 cup chopped pecans or walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Place carrots in a large mixing bowl. Using a potato masher, mash carrots until only small pieces remain. Add brown sugar, oil and egg; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour, oats, baking powder, cinnamon and salt. Mix with a wooden spoon just until dry ingredients are moistened. Fold in cranberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into 12 paper-lined medium muffin cups. Top with pecans. Bake 25 minutes or until wooden pick inserted in center comes out clean. Let cool 10 minutes before removing from pan. Muffins may be frozen for up to 3 months.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
