  "ingredients": [
    "4 tart apples, peeled and sliced, or more to taste",
    "2 tablespoons white sugar",
    "2 tablespoons brown sugar",
    "1.5 teaspoons ground cinnamon",
    "0.33333334326744 cup caramel topping",
    "2 tablespoons melted butter",
    "1 (15.25 ounce) package yellow cake mix",
    "1 cup oatmeal",
    "0.75 cup butter"
  ],
  "steps": [
    {
      "text": "Combine apples, white sugar, brown sugar, and cinnamon in a slow cooker; drizzle with caramel topping and 2 tablespoons melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix and oatmeal in a bowl; cut in ¾ cup butter with 2 knives or a pastry blender until mixture resembles coarse crumbs. Sprinkle oat mixture over apple mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the slow cooker. Cook on High until cooked down and golden on top, 2 ½ to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
