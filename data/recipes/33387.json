  "ingredients": [
    "4 pounds ripe tomatoes",
    "1 (1 inch) piece fresh ginger root",
    "3 cloves garlic",
    "2 onions, diced",
    "1.75 cups white sugar",
    "1 cup red wine vinegar",
    "0.25 cup golden raisins",
    "1 tablespoon curry paste",
    "2 teaspoons mixed spice",
    "1 teaspoon chili powder",
    "1 pinch paprika"
  ],
  "steps": [
    {
      "text": "Fill a large saucepan with water; bring to a boil. Place tomatoes in the boiling water until skins begin to crack and peel, 3 to 5 minutes. Remove from water, cool, then peel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add peeled tomatoes, ginger, and garlic to the bowl of a food processor or blender; pulse until puréed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer tomato purée to a large saucepan; add onions, sugar, vinegar, and raisins. Season mixture with curry paste, mixed spice, chili powder, and paprika; simmer over medium heat until thickened, about 30 minutes. Refrigerate until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
