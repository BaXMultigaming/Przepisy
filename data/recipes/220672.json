  "ingredients": [
    "3 teaspoons chicken bouillon granules",
    "3.5 cups water",
    "3 cups uncooked white rice",
    "4 small heads baby bok choy, trimmed and chopped",
    "3 green onions, chopped",
    "1 carrot, chopped",
    "4 mushrooms, chopped",
    "1 teaspoon chicken bouillon granules",
    "0.25 cup water, or more if needed",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Dissolve 3 teaspoons chicken bouillon in 3 1/2 cups water in a rice cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rice, baby bok choy, green onions, carrot, and mushrooms into the bouillon and water mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Start rice cooker and cook until liquid is absorbed and rice is tender, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve 1 teaspoon chicken bouillon and 1/4 cup water in a small bowl; transfer mixture to a blender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop about 1 cup of the rice mixture into the blender with the bouillon mixture; process until mixture becomes a thin paste, adding more water as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the rice paste with the remaining cooked vegetables and rice until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
