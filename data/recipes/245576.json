  "ingredients": [
    "cooking spray",
    "8 ounces chopped dark chocolate",
    "2 eggs",
    "2.5 cups white sugar",
    "1 cup heavy whipping cream",
    "0.5 cup butter, melted",
    "1.5 cups all-purpose flour",
    "1 teaspoon salt",
    "1 cup dark chocolate chips",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray 20 muffin cups with cooking spray and dust with flour, or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chopped dark chocolate in a microwave-safe glass or ceramic bowl in 15-second intervals, stirring after each melting, 1 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl with an electric mixer until light and fluffy; beat in sugar gradually on high speed. Add cream and beat until batter has doubled in volume. Beat in butter until well combined. Beat in flour and salt on low speed until well combined. Beat in melted chocolate on medium speed until well combined. Stir in chocolate chips and pecans. Pour batter into muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until tops spring back when lightly pressed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
