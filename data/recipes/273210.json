  "title": "Chocolate Oaties with Coconut Oil",
  "description": "These soft and sweet dark chocolate chip oaties are made with a combination of butter and coconut oil melted together.",
  "authors": [
    "Jessica Mueller"
  ],
  "date_published": "2020-06-19T00:36:34-04:00",
