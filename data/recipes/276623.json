  "ingredients": [
    "6 cold eggs",
    "1 cup white sugar",
    "1 tablespoon white sugar",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon ground nutmeg",
    "2 cups cold whipping cream",
    "2 cups cold milk",
    "0.75 cup cold brandy",
    "0.33333334326744 cup cold spiced rum"
  ],
  "steps": [
    {
      "text": "Beat eggs in a bowl using an electric mixer on medium speed until very frothy, 2 to 3 minutes. Add 1 cup plus 1 tablespoon sugar, vanilla extract, and nutmeg gradually while beating. Turn the mixer off and manually stir in whipping cream, milk, brandy, and spiced rum. Chill before serving.",
