        "https://www.allrecipes.com/thmb/U1rgFEYzHWX0Us1mo6tXugSuYOs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-9482-scotch-eggs-VAT-step-07-3c80dc53506142158cd91cee3c26c205.jpg"
