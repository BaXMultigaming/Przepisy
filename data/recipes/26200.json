  "ingredients": [
    "0.5 cup butter, softened",
    "0.75 cup brown sugar",
    "0.75 cup white sugar",
    "0.75 cup peanut butter",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.75 cup all-purpose flour",
    "0.25 cup whole wheat flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup rolled oats",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter, brown sugar, white sugar and peanut butter until smooth. Beat in the egg and vanilla. Combine the flour, wheat flour, baking soda and salt; stir into the peanut butter mixture. Finally, mix in the oats and chocolate chips. Drop by rounded spoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 minutes in the preheated oven, or until edges are golden. Remove from cookie sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
