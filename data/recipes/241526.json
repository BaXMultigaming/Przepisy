  "ingredients": [
    "0.5 (14 ounce) package spaghetti",
    "3 tablespoons olive oil, divided",
    "4 eggs, beaten",
    "0.5 onion, diced",
    "0.25 cup chopped baby bella (crimini) mushrooms",
    "0.25 cup frozen peas",
    "0.25 cup shredded carrots",
    "0.5 cup freshly grated Parmesan cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally until cooked through but firm to the bite, about 12 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 tablespoon oil in a skillet over medium heat; cook and stir eggs in the hot oil until set and scrambled, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining 2 tablespoons oil in a separate skillet over medium-high heat; saute onion, mushrooms, peas, and carrots until onion is browned, about 10 minutes. Add pasta to onion mixture and toss. Add eggs and mix well. Sprinkle Parmesan cheese, salt, and pepper over pasta mixture and toss.",
      "section": null,
