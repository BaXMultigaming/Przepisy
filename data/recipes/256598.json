  "ingredients": [
    "1 quart half-and-half",
    "2 cups white sugar",
    "1 (14 ounce) can sweetened condensed milk",
    "1 loaf sliced bread, crusts removed, divided",
    "oil for frying"
  ],
  "steps": [
    {
      "text": "Combine half-and-half, sugar, and condensed milk in a large pot over medium-low heat. Bring to a gentle boil; simmer until reduced by half, about 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve 2 slices of bread in the half-and-half mixture; blend mixture with an immersion blender until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan. Fry remaining bread slices in batches until golden brown, about 1 minute per side. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice bread diagonally; layer slices in a 9x12-inch baking dish. Pour in enough of the half-and-half mixture to evenly soak the slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly, about 20 minutes. Flip bread slices and continue baking, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
