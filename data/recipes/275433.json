  "ingredients": [
    "1 (28 ounce) package frozen bite-size potato nuggets (such as Tater Tots®)",
    "0.25 cup mayonnaise",
    "0.125 cup sour cream",
    "4 tablespoons truffle-infused olive oil, divided",
    "1 teaspoon minced garlic",
    "1 teaspoon lemon juice",
    "0.5 teaspoon ground black pepper",
    "0.25 cup shaved fresh Parmesan cheese",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread potato nuggets in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tots are golden brown, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk mayonnaise, sour cream, 1 tablespoon truffle oil, garlic, lemon juice, and pepper in a mixing bowl. Set aioli aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tots from the oven and transfer to a large bowl. Let cool for 5 minutes. Drizzle with remaining 3 tablespoons truffle oil; toss to combine. Add Parmesan cheese and parsley; toss to combine. Serve tots with reserved aioli.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
