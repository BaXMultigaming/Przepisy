  "ingredients": [
    "1 pound ground beef",
    "1 egg",
    "3 tablespoons crushed buttery round cracker crumbs",
    "2 tablespoons finely chopped onion",
    "0.5 teaspoon salt",
    "0.5 teaspoon pepper",
    "0.25 teaspoon poultry seasoning",
    "2 (4 ounce) cans sliced mushrooms with juice",
    "3 tablespoons butter",
    "3 tablespoons all-purpose flour",
    "3 cups milk",
    "3 cubes beef bouillon"
  ],
  "steps": [
    {
      "text": "Mix together ground beef, egg, cracker crumbs, onion, salt, pepper, and poultry seasoning in a large bowl using your hands until well combined. Shape mixture into 6 patties, about 1-inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry patties in a large skillet over medium-high heat until browned, 3 to 4 minutes per side. Drain off grease and remove patties to a platter; keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in the same skillet. Cook and stir mushrooms in hot butter for about 2 minutes. Sprinkle with flour and mix until blended. Stir in milk and beef bouillon. Cook and stir over medium heat until gravy is smooth and thickens. Return patties to gravy and cook over low heat, uncovered, for 10 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
