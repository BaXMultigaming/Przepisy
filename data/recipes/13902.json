  "ingredients": [
    "1 pound black beans, washed",
    "1 onion, chopped",
    "1 red bell pepper, chopped",
    "1 green bell pepper, chopped",
    "2 bay leaves",
    "1.5 teaspoons paprika",
    "1.5 teaspoons ground cumin",
    "1 tablespoon dried oregano",
    "2 minced hot green chile peppers",
    "3 cloves garlic, minced",
    "0.25 cup balsamic vinegar",
    "salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "In a large bowl, cover beans in water and soak overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse beans and transfer to a large stock pot. Add onion, red and green bell peppers, bay leaves, paprika, cumin, oregano, chile peppers, and enough water to cover. Bring to a boil, reduce heat, and simmer for 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Test beans for tenderness; when tender add garlic and balsamic vinegar. Season to taste with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
