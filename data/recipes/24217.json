  "ingredients": [
    "1 (9 inch) frozen pie crusts, thawed",
    "1 tablespoon olive oil",
    "0.25 cup chopped onion",
    "0.25 cup chopped green bell pepper",
    "1 tablespoon all-purpose flour",
    "1 cup chopped cooked chicken breast",
    "0.25 teaspoon salt",
    "0.25 teaspoon nutmeg",
    "0.25 teaspoon black pepper",
    "0.5 cup shredded Cheddar cheese",
    "0.25 cup shredded Swiss cheese",
    "2 eggs, slightly beaten",
    "0.75 cup milk",
    "0.75 cup sour cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 9-inch pie plate with thawed pie crust. Keep in refrigerator until ready to fill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium frying pan, heat olive oil on medium-high. Add onion and bell pepper. Cook 3 minutes, stirring frequently. Add flour and cook for 2 minutes, stirring frequently. Stir in chicken, salt, nutmeg, and black pepper. Spread this mixture over the bottom of the unbaked pie shell and top with Cheddar and Swiss cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, milk, and sour cream, and mix until smooth. Pour over the chicken mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Reduce temperature to 350 degrees F (175 degrees C) and bake, 30 to 35 minutes until inserted knife comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
