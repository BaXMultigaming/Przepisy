  "ingredients": [
    "cooking spray",
    "0.5 (8 ounce) package cream cheese, at room temperature",
    "0.5 cup butter, at room temperature",
    "0.5 cup light brown sugar",
    "0.25 cup white sugar",
    "1 large egg",
    "1.5 teaspoons vanilla extract",
    "1.25 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 cup white chocolate chips",
    "2 tablespoons Key lime zest"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 cookie sheets with cooking spray or line with silicone baking liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, butter, brown sugar, and white sugar in a mixing bowl. Beat with an electric mixer until light and fluffy. Beat in egg and vanilla extract until smooth. Slowly beat in flour, baking powder, and salt. Fold in white chocolate chips and lime zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop teaspoonfuls of cookie dough onto the prepared cookie sheets, leaving about 1 inch between each cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are set and lightly browned around the edges, 10 to 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
