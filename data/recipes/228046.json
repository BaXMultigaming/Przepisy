  "title": "Veracruz-Style Red Snapper",
  "description": "A zesty Veracruz sauce made with tomatoes, jalapeño peppers, olives, and oregano tops red snapper fillets baked in individual baking dishes.",
  "authors": [
    "John Mitzewich"
  ],
