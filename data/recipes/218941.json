  "ingredients": [
    "3 tablespoons honey",
    "3 tablespoons soy sauce",
    "3 tablespoons balsamic vinegar",
    "1 tablespoon minced garlic",
    "2 (3 ounce) fillets tilapia",
    "cooking spray",
    "1 teaspoon freshly cracked black pepper"
  ],
  "steps": [
    {
      "text": "Mix the honey, soy sauce, balsamic vinegar, and garlic together in a bowl. Place the tilapia fillets in the mixture; allow to marinate in refrigerator at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Spray a baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tilapia from marinade, and discard the marinade. Place fillets into the prepared baking sheet, and sprinkle the black pepper over the fish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the fish flakes easily with a fork, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
