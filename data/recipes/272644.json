  "ingredients": [
    "1 egg, room temperature",
    "1 clove garlic, peeled",
    "1 tablespoon lemon juice",
    "0.5 teaspoon Dijon mustard",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.75 cup olive oil"
  ],
  "steps": [
    {
      "text": "Combine egg, garlic, lemon juice, Dijon mustard, salt, and pepper in a bowl; whisk with a fork until well combined. Using a hand immersion blender, slowly add olive oil in a small stream and blend until creamy.",
