  "ingredients": [
    "1 (4 pound) beef chuck roast, trimmed",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "2 tablespoons olive oil",
    "1.25 cups diced green chile pepper",
    "1 large onion, chopped",
    "1 (5 ounce) bottle hot sauce",
    "0.25 cup taco seasoning",
    "1 teaspoon chili powder",
    "1 teaspoon cayenne pepper",
    "1 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Season chuck roast with salt and pepper. Heat olive oil in a large skillet over medium-high heat; add roast. Cook until entirely browned, 2 to 3 minutes per side; transfer to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle diced chile pepper, onion, hot sauce, taco seasoning, chili powder, cayenne pepper, and garlic powder over roast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until roast is fall-apart tender, 8 to 10 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
