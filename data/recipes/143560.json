  "ingredients": [
    "1 French baguette, cut into 1/2 inch slices",
    "1 (15 ounce) container ricotta cheese",
    "12 fresh basil leaves, cut into thin strips",
    "8 black mission figs, cut in quarters",
    "0.25 cup aged balsamic vinegar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the baguette slices on an ungreased, foil-lined baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake the bread in the preheated oven until the bottoms are brown, about 5 minutes; flip and bake until crisp, 5 minutes. Remove the pan from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1 tablespoon of ricotta on each slice of toasted bread. Place a few ribbons of basil on each, arrange a slice of fig on top, and drizzle the finished crostini with balsamic vinegar.",
