  "ingredients": [
    "2 prepared pie pastries (such as Pillsbury®)",
    "2 cups brown sugar",
    "1 cup white sugar",
    "1 tablespoon ground cinnamon",
    "0.5 teaspoon ginger",
    "1 pinch ground nutmeg, or to taste",
    "2 (15 ounce) cans peach slices, drained, liquid reserved",
    "0.33333334326744 cup water",
    "0.25 cup salted butter, melted",
    "0.25 cup salted butter, cut into small pieces",
    "1 teaspoon white sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a pie plate with 1 of the prepared pie pastries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk brown sugar, 1 cup white sugar, 1 tablespoon cinnamon, ginger, and nutmeg together in a bowl. Stir reserved peach liquid, water, and melted butter into sugar mixture until sugar dissolves into liquid. Stir in peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon peach mixture into prepared pie plate and place remaining pie pastry over the top; pinch and crimp edges together. Dot with butter pieces, remaining sugar, and remaining cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is light brown, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
