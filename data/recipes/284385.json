  "ingredients": [
    "1 cup white sugar",
    "1 (3 ounce) package cherry flavored Jell-O®",
    "1 (0.13 ounce) package unsweetened cherry-flavored soft drink mix (such as Kool-Aid®)",
    "2 cups boiling water",
    "2 cups cold water"
  ],
  "steps": [
    {
      "text": "Add sugar, gelatin mix, and soft drink mix to a bowl; stir in boiling water until sugar and mixes dissolved. Stir in cold water to combine. Divide between 24 individual serving sized paper cups; cool to room temperature, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Freeze until hard, about 6 hours.",
