  "ingredients": [
    "3 cups all-purpose flour",
    "2 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "0.5 teaspoon baking powder",
    "2 cups white sugar",
    "1 cup vegetable oil",
    "3 eggs",
    "2 teaspoons vanilla extract",
    "0.5 cup chopped walnuts",
    "2 cups grated zucchini"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour 4 loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, cinnamon, salt, and baking powder in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, oil, eggs and vanilla with an electric mixer in a large bowl until smooth. Beat in flour mixture until smooth: fold in zucchini and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter into the prepared loaf pans. Bake in preheated oven until toothpick inserted into middle of cake comes out clean, 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
