  "title": "Pickled Asparagus",
  "description": "This pickled asparagus recipe pickles the freshest spring asparagus in vinegar, sugar, dill, and mustard seeds for a crisp, tangy appetizer or snack.",
  "authors": [
    "Behr"
  ],
  "date_published": "2020-06-18T23:10:37-04:00",
