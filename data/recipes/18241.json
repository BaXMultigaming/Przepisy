  "ingredients": [
    "1 pound carrots, cut into 2 inch pieces",
    "0.25 cup packed brown sugar",
    "2 tablespoons butter, diced",
    "1 pinch salt",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JhVz1iJACOntuwC2CypfNPOE9wA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18241-candied-carrots-DDMFS-082-4x3-step-01-fbd1a6da39174acfa511edaa01597b51.jpg"
      ],
      "image": "assets/images/18241/step_01.webp"
    },
    {
      "text": "Place carrots in a pot of salted water; bring to a boil. Reduce heat to a low boil and cook until tender but not mushy, about 15 minutes. Drain and return carrots to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FlD5-fPSW-QB2bA5lumzu-azJOU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18241-candied-carrots-DDMFS-106-4x3-step-02-b236d2c10b5f4b0a8744ded0bb62ad9e.jpg"
      ],
      "image": "assets/images/18241/step_02.webp"
    },
    {
      "text": "Place the pot with carrots over the lowest possible heat setting. Stir in brown sugar, butter, salt, and pepper. Cook until sugar is bubbly, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TrUrl08xmFh9XiFshCtslNBAbzQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18241-candied-carrots-DDMFS-108-4x3-step-03-cb608bdc975f4d3e81c43cc0bdfabfa1.jpg"
      ],
      "image": "assets/images/18241/step_03.webp"
    },
    {
      "text": "Serve hot.",
