  "ingredients": [
    "1 (16 ounce) package cottage cheese",
    "6 eggs",
    "0.5 cup all-purpose flour",
    "0.25 cup sour cream",
    "2 teaspoons salt",
    "0.5 teaspoon ground black pepper",
    "2 (10 ounce) packages frozen chopped spinach, thawed and drained",
    "4 cups shredded Cheddar cheese, divided"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cottage cheese, eggs, flour, sour cream, salt, and pepper in a food processor. Process until smooth. Mix spinach, cottage cheese mixture, and 2 cups of Cheddar cheese in a bowl, then spread into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, about 45 minutes. Top with remaining 2 cups of Cheddar cheese and continue baking until cheese has melted, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
