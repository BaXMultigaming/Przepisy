  "ingredients": [
    "1.5 pounds cubed beef stew meat",
    "0.25 cup all-purpose flour",
    "2 tablespoons vegetable oil",
    "2 (14.5 ounce) cans Italian-style diced tomatoes",
    "1 (14 ounce) can beef broth",
    "4 carrots, chopped",
    "2 potatoes, peeled and chopped",
    "0.75 teaspoon dried thyme",
    "2 tablespoons Dijon-style prepared mustard",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine beef and flour in a large resealable plastic bag and toss to coat evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 6-quart saucepan, brown beef in hot vegetable oil. Season with salt and pepper, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add diced tomatoes, beef broth, carrots, potatoes, and thyme. Bring to a boil; reduce heat to medium-low, cover, and simmer for 1 hour or until beef is tender. Blend in mustard and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
