  "ingredients": [
    "0.33333334326744 cup vegetable oil",
    "2 onions, diced",
    "1.5 teaspoons salt",
    "1 clove garlic, minced",
    "1 teaspoon chile powder",
    "1 teaspoon minced fresh ginger root",
    "0.5 teaspoon ground turmeric",
    "2 cups diced tomatoes",
    "2.25 cups basmati rice",
    "3 cups water"
