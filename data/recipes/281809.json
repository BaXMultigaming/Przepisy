  "ingredients": [
    "2.5 pounds sweet potatoes, peeled and cubed",
    "butter-flavored cooking spray",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground allspice",
    "0.25 cup pure maple syrup",
    "3 tablespoons salted butter, melted"
  ],
  "steps": [
    {
      "text": "Place sweet potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C). Coat an 8-inch square baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cinnamon, salt, black pepper, nutmeg, and allspice in a small bowl. Combine maple syrup and melted butter in a separate small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain sweet potatoes and transfer to a bowl; mash thoroughly. Add cinnamon mixture; stir until well distributed. Transfer potatoes to the prepared baking pan. Drizzle maple syrup mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
