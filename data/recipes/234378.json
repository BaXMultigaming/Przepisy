  "ingredients": [
    "2 pounds ground turkey",
    "1 (1.25 ounce) package taco seasoning mix",
    "1 (15 ounce) can kidney beans, drained and rinsed",
    "1 (14.5 ounce) can crushed tomatoes, drained",
    "1 yellow onion, chopped",
    "1 (10.75 ounce) can condensed tomato soup",
    "0.5 (15 ounce) can black beans, drained and rinsed",
    "0.25 cup chili powder",
    "3 canned green chile peppers, sliced",
    "1 tablespoon diced peppers from adobo sauce with chipotle peppers, or more to taste",
    "2 teaspoons chile-garlic sauce (such as Sriracha®)",
    "1 teaspoon ground black pepper",
    "1 teaspoon salt",
    "1 teaspoon dried basil",
    "1 teaspoon paprika",
    "1 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Add ground turkey; cook and stir until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Stir taco seasoning into ground turkey until evenly coated; transfer to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir crushed tomatoes, kidney beans, onion, tomato soup, black beans, chili powder, green chiles, chipotle peppers, chili garlic sauce, black pepper, salt, basil, paprika, and cayenne pepper into slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover slow cooker. Cook on Low for 8 to 9 hours, or on High for about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
