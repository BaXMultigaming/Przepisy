  "ingredients": [
    "cooking spray",
    "2 cups rolled oats",
    "1 cup whole wheat pastry flour",
    "0.25 cup flax seed meal",
    "2.5 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "0.5 teaspoon sea salt",
    "1 cup honey",
    "2 egg whites",
    "4 teaspoons almond butter",
    "0.5 teaspoon vanilla extract",
    "4 ounces semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Coat two baking sheets with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oats, flour, flax meal, cinnamon, baking soda, and salt together in a large bowl; stir in honey, egg whites, almond butter, and vanilla extract until dough is well blended. Fold in chocolate chips. Drop 36 spoonfuls of dough onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden and set, 8 to 10 minutes. Cool on the baking sheets for 10 minutes, then lightly loosen cookies from baking sheets; continue cooling on the baking sheets 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
