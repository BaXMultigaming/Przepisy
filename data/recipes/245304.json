  "ingredients": [
    "4 cups water",
    "1 cup steel cut oats",
    "1 pinch salt",
    "0.5 cup cashew milk",
    "0.5 banana, chilled",
    "1 mango, diced",
    "0.5 cup coconut flakes",
    "2 teaspoons raw honey"
  ],
  "steps": [
    {
      "text": "Bring a pot of lightly salted water to boil; stir in oats. Reduce heat to medium-low; cook and stir until oats soften and water is absorbed, about 15 minutes. Cool, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, cashew milk, and banana in a blender; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide oat mixture between two bowls; top with diced mango, coconut flakes, and honey.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
