  "ingredients": [
    "1.6666666269302 cups all-purpose flour",
    "0.5 cup white sugar",
    "1 tablespoon matcha green tea powder, or to taste",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup milk",
    "0.33333334326744 cup melted butter",
    "1 large egg",
    "0.25 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 12 muffin cups, or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, matcha, baking powder, and salt together in a mixing bowl; set aside. Whisk together milk, melted butter, and egg in another bowl. Stir the milk mixture into the flour mixture until just moistened. Stir in walnuts. Divide the batter among the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and the tops spring back when lightly pressed, about 25 minutes. Cool in the muffin tin for 5 minutes, then remove to cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
