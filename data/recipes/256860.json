  "ingredients": [
    "3 cups water",
    "0.5 cup quinoa",
    "0.5 cup steel-cut oats",
    "2 tablespoons almond meal",
    "2 tablespoons flaxseed meal",
    "1 tablespoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a saucepan; add quinoa and oats. Simmer, stirring frequently, until water is absorbed and quinoa is tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir almond meal and flaxseed meal into oat-quinoa mixture; pour into a glass container and top with cinnamon. Let cool for about 15 minutes. Transfer to the refrigerator for storage.",
