  "ingredients": [
    "1 large head cauliflower",
    "4 small carrots, peeled and finely chopped",
    "3 large plum tomatoes, seeded and chopped",
    "1 small white onion, finely chopped",
    "8 sprigs cilantro, chopped",
    "1.5 limes, juiced",
    "salt to taste",
    "1 avocado - peeled, pitted, and sliced"
