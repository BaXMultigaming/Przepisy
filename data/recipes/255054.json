  "ingredients": [
    "cooking spray",
    "1 cup canola oil",
    "0.5 cup semisweet chocolate chips",
    "2 cups white sugar",
    "4 eggs",
    "1 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "2 cups sweetened shredded coconut, divided",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine canola oil and 1/2 cup chocolate chips in a saucepan over very low heat; stir until melted, about 5 minutes. Let cool, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, eggs, and vanilla extract in a large bowl until blended. Fold in melted chocolate mixture. Sift in flour, baking powder, and salt; mix until well combined. Fold 1 1/2 cup shredded coconut and chocolate chips into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter in the prepared baking pan. Sprinkle remaining 1/2 cup shredded coconut on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges pull away from the sides of the pan, 35 to 40 minutes. Cool before cutting into squares, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
