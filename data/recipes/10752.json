  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup butter, softened",
    "0.5 cup shortening",
    "2 cups all-purpose flour",
    "0.5 cup any flavor fruit jam"
  ],
  "steps": [
    {
      "text": "Place cream cheese in a mixing bowl, and beat til light and fluffy. Add the rest of the ingredients, except for the fruit preserves, and form into a flat disk. Chill overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough out onto a lightly floured board, and cut circles using a medium sized glass.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the center of each circle, add 1/2 teaspoon of preserves; crimp edges tightly together. Natural preserves have a tendency to spill out due to the lower sugar content, but still make a great cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 15 to 17 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
