  "ingredients": [
    "0.5 cup rolled oats",
    "0.66666668653488 cup Almond Breeze Original almondmilk",
    "3 tablespoons canned pumpkin puree",
    "2 teaspoons brown sugar",
    "0.25 teaspoon pumpkin pie spice",
    "1 tablespoon shelled roasted pepitas"
  ],
  "steps": [
    {
      "text": "In a pint jar or at least 12 ounce glass, mix oats and almondmilk. In a small bowl, mix pumpkin, brown sugar and spice. Spoon over oats. Cover; refrigerate 8 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To serve, stir mixture and top with pepitas.",
      "section": null,
