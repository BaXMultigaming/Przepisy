  "title": "Georgia&#39;s Tennessee Jam Cake",
  "description": "This delicious jam cake is made with buttermilk, blackberry jam, black walnuts, raisins, and warm spices for a memorable holiday dessert.",
  "authors": [
    "Amy"
  ],
  "date_published": "2020-06-18T23:27:55-04:00",
