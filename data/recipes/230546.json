  "ingredients": [
    "0.5 cup butter, softened",
    "0.33333334326744 cup masa harina",
    "0.25 cup water",
    "2 cups frozen corn, thawed, divided",
    "0.25 cup cornmeal",
    "0.33333334326744 cup white sugar",
    "2 tablespoons heavy whipping cream",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter in a medium bowl with an electric mixer until creamy; beat in masa harina and water until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 cup corn in a blender; blend until smooth. Stir blended corn, remaining 1 cup corn, and cornmeal into masa harina mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, cream, baking powder, and salt in a separate bowl; stir into corn mixture to combine. Spoon batter into an ungreased 8-inch square baking dish; smooth top with a spatula. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place covered baking dish in a 9x13-inch casserole dish; add enough hot water to casserole dish to come halfway up sides of baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 50 to 60 minutes. Remove dish from water bath; cool, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
