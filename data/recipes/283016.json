  "ingredients": [
    "1 large red apple",
    "0.5 cup water",
    "0.33333334326744 cup white sugar",
    "4 tablespoons unsalted butter",
    "1 (8 ounce) package refrigerated crescent rolls",
    "2 tablespoons brown sugar",
    "1.5 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Peel and core apple, then cut into 8 slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water, white sugar, and butter in a saucepan over medium heat; bring to a boil, stirring often. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll crescent dough into 8 pieces. Wrap each piece around 1 apple slice; transfer dumplings to a 9-inch square baking dish. Slowly pour sugar water over dumplings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and cinnamon in a small bowl; sprinkle over dumplings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and golden brown, about 30 minutes. Spoon hot sugar mixture over dumplings until glazed, then serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
