  "ingredients": [
    "0.5 cup white sugar",
    "1 tablespoon ground cinnamon",
    "3 (10 ounce) cans refrigerated biscuit dough, separated and cut into quarters",
    "0.75 cup brown sugar",
    "0.5 cup margarine"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix white sugar and cinnamon together in a gallon-size resealable bag; add biscuits and toss to coat. Press coated biscuits into muffin cups, about 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat brown sugar and margarine together in a saucepan over medium-low heat until melted, 3 to 5 minutes; pour over each biscuit muffin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until dough is cooked through, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
