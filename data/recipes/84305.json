  "ingredients": [
    "1 (16 ounce) container sour cream",
    "0.75 cup white sugar",
    "2 tablespoons lemon juice",
    "0.125 teaspoon salt",
    "3 bananas, peeled and diced",
    "1 (8 ounce) can crushed pineapple, with juice",
    "0.25 cup chopped maraschino cherries",
    "0.25 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Line 18 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together sour cream, sugar, lemon juice, and salt in a large bowl until blended. Fold in bananas, pineapple, cherries, and pecans until incorporated. Pour into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Freeze until set, then transfer to resealable freezer bags for storage.",
      "section": null,
