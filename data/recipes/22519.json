  "title": "Chocolate Covered Cherries II",
  "description": "Maraschino cherries with stems are rolled in a sweet coating, then dipped in chocolate. These candies are best left 1-2 weeks before eating.",
  "authors": [
    "Auntylene"
  ],
  "date_published": "2000-09-30T23:06:57-04:00",
