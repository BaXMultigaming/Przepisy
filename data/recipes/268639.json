  "ingredients": [
    "1 cup all-purpose flour",
    "0.75 cup whole wheat pastry flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon sea salt",
    "1 apple, cut into small cubes",
    "0.5 cup crumbled halva",
    "0.5 cup butter, melted and cooled",
    "2 large eggs",
    "0.5 cup buttermilk",
    "0.5 cup packed brown sugar",
    "5.5 tablespoons tahini",
    "1 teaspoon vanilla extract",
    "2 tablespoons turbinado sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all-purpose flour, whole wheat pastry flour, baking powder, baking soda, cinnamon, and salt together. Add apple and halva.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk melted butter, eggs, buttermilk, brown sugar, tahini, and vanilla extract together in another bowl. Fold into the flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared pan. Sprinkle turbinado sugar on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes. Tent with foil after 30 minutes to prevent over-browning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool in the pan for 5 to 10 minutes before inverting onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
