  "ingredients": [
    "2 tablespoons olive oil",
    "1 large onion, chopped",
    "2 cloves garlic, minced, or more to taste",
    "2 pounds lean ground beef",
    "2 (16 ounce) cans kidney beans, rinsed and drained",
    "1 (28 ounce) can diced tomatoes",
    "1 (15 ounce) can tomato puree",
    "1 cup water",
    "1 (4 ounce) can chopped green chile peppers",
    "2 tablespoons mild chili powder",
    "2 teaspoons salt",
    "2 teaspoons ground cumin",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-low heat. Add onion and garlic; cook and stir until onion is translucent, about 5 minutes. Add ground beef; cook and stir until browned, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cKXTtkLUXFFO_LoSz0KflUceNCs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255259-Homemade-Chilli-mfs-step1_1890-755da21ebff24e8b96ec46d99a9b6833.jpg"
      ],
      "image": "assets/images/255259/step_01.webp"
    },
    {
      "text": "Transfer beef mixture to a 6-quart slow cooker. Stir in kidney beans, diced tomatoes, tomato purée, water, green chile peppers, chili powder, salt, cumin, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-1qkVAdLDGFNdewqsH5ma1NQ7o8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255259-Homemade-Chilli-mfs-step3_1897-facf6b5e7fe24d0d811a154d13b6daa3.jpg"
      ],
      "image": "assets/images/255259/step_02.webp"
    },
    {
      "text": "Cover the slow cooker. Cook on Low until flavors combine, 4 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BHFPBRcDsDUqgsYp-LtSaKhOuUA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255259-Homemade-Chilli-mfs-step4_1909-fb1d38216dbe4d85aa22adf636303b92.jpg"
      ],
      "image": "assets/images/255259/step_03.webp"
    },
    {
      "text": "Serve and enjoy.",
