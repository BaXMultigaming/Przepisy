  "ingredients": [
    "2 pounds party chicken wings",
    "1 teaspoon salt, divided",
    "0.25 cup water",
    "0.25 cup balsamic vinegar",
    "2 tablespoons sweet chili sauce",
    "2 teaspoons Sriracha sauce",
    "1 medium green onion, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large baking sheet with parchment paper. Place wings on the baking sheet and sprinkle with 1/2 teaspoon salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Using tongs, flip the wings over and sprinkle remaining salt over the top. Bake for 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring water, vinegar, sweet chili sauce, and Sriracha to a boil in a medium saucepan. Reduce heat and simmer until sauce thickens, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer wings to a large bowl and pour sauce over the top. Toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and turn broiler on high. Place a wire cooling rack on the baking sheet and arrange wings on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil wings for until crispy, about 5 minutes. Garnish with chopped green onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
