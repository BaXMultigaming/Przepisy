  "ingredients": [
    "1 (5 pound) flat-cut corned beef brisket",
    "1 tablespoon browning sauce (such as Kitchen Bouquet®), or as desired",
    "1 tablespoon vegetable oil",
    "1 onion, sliced",
    "6 cloves garlic, sliced",
    "2 tablespoons water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Discard any flavoring packet from corned beef. Brush brisket with browning sauce on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oP66lfwjVSWE7vJqPtrQZknq1mw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231030-BraisedCornedBeefBrisket-mfs-Step1-3394-4x3-b28505554604434a832437106a32527b.jpg"
      ],
      "image": "assets/images/231030/step_02.webp"
    },
    {
      "text": "Heat vegetable oil in a large skillet over medium-high heat and brown brisket on both sides in the hot oil, 5 to 8 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/20uNe3r9EyjLU0d6Zh1IUAT-fQo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231030-BraisedCornedBeefBrisket-mfs-Step2-3395-4x3-8cc35ed00c2440a0a65c745fc39eb9d1.jpg"
      ],
      "image": "assets/images/231030/step_03.webp"
    },
    {
      "text": "Place brisket on a rack set in a roasting pan. Scatter onion and garlic slices over brisket and add water to roasting pan. Cover pan tightly with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uVL_4sO9aUIXhNq6bRie48K4NG4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231030-BraisedCornedBeefBrisket-mfs-Step3-3399-4x3-0975924e8fe5448d87e317c219ccb410.jpg"
      ],
      "image": "assets/images/231030/step_04.webp"
    },
    {
      "text": "Roast in the preheated oven until meat is tender, about 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uIHwhVbtZWq5j1ohXqXe1RB-1qU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231030-BraisedCornedBeefBrisket-mfs-Step4-3403-4x3-ee4922ea8cd04764b5930c86dda2aa2b.jpg"
      ],
      "image": "assets/images/231030/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
