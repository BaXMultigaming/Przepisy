  "ingredients": [
    "nonstick cooking spray",
    "2 large eggs, at room temperature",
    "0.66666668653488 cup pumpkin puree",
    "0.5 cup brown sugar",
    "0.25 cup white sugar",
    "0.25 cup unsalted butter, melted",
    "0.25 cup canola oil",
    "1/2 teaspoon pumpkin pie spice extract",
    "1.3333333730698 cups all-purpose flour",
    "2 teaspoons pumpkin pie spice",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups powdered sugar",
    "0.25 cup milk, or more to taste",
    "1 teaspoon vanilla extract",
    "1/2 teaspoon pumpkin pie spice extract",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray doughnut pan with non-stick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, pumpkin, brown sugar, sugar, butter, oil, and pumpkin pie spice extract in a bowl; mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, pumpkin pie spice, baking powder, baking soda, and salt together in a second bowl. Add to egg mixture and stir until combined. Evenly distribute mixture amongst the 12 donut pans. Wet finger and smooth out the tops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 12 to 16 minutes. Cool completely on wire racks, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together powdered sugar, 1/4 cup milk, vanilla, pumpkin pie spice extract, and salt in a bowl until completely combined. Add more milk, 1 tablespoon at a time, if necessary to reach desired glaze consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip one side of the doughnuts into the glaze and place on a rack over a cookie sheet to allow glaze to set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
