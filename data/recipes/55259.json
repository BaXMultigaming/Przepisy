  "ingredients": [
    "1 cup quick-cooking rolled oats",
    "0.75 cup milk, or as needed",
    "0.5 cup canned pumpkin puree",
    "0.25 teaspoon pumpkin pie spice",
    "1 teaspoon cinnamon sugar"
  ],
  "steps": [
    {
      "text": "Mix together oats and milk in a microwave-safe bowl. Cook on high for 1 to 2 minutes, stirring once. Add more milk or oats to achieve the desired consistency, and cook for another 30 seconds. Stir in pumpkin puree, pumpkin pie spice, and cinnamon sugar. Heat through, and serve.",
