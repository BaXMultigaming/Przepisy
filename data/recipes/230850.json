  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream of chicken soup, cooked chicken, celery, 1 cup cornflakes, water chestnuts, mayonnaise, and onion together in a large bowl; spread mixture into a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1 cup cornflakes and melted butter together in a bowl until coated; sprinkle over casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
