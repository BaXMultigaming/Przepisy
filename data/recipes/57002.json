  "ingredients": [
    "2 pork tenderloins",
    "4 tablespoons Dijon mustard",
    "1 tablespoon oil",
    "2 tablespoons butter",
    "2 shallots, minced",
    "1 cup Marsala wine",
    "1 cup heavy cream",
    "1 tablespoon Dijon mustard"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Oil a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat pork tenderloins generously with ¼ cup Dijon mustard. Heat 1 tablespoon oil in a large skillet over medium-high heat; brown tenderloins, turning to evenly brown. Transfer tenderloins to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes; flip and continue baking until desired doneness, about 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in the same skillet over medium heat. Add shallots; cook until soft. Stir in Marsala, cream, and 1 tablespoon Dijon mustard; cook until reduced by half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice tenderloins; place on a serving dish. Spoon sauce over pork; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
