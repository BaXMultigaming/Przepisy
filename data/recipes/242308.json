  "ingredients": [
    "0.66666668653488 cup all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon ground nutmeg, or more to taste",
    "0.125 teaspoon salt",
    "0.25 cup milk",
    "0.5 teaspoon vanilla extract",
    "5 tablespoons softened butter",
    "0.33333334326744 cup white sugar",
    "1 egg",
    "0.33333334326744 cup white sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease donut baking pans or miniature muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the donuts: Whisk flour, baking powder, nutmeg, and salt together in a bowl. Stir milk and vanilla extract together in a separate bowl. Beat butter and sugar together in a third bowl using an electric mixer until smooth and creamy; beat in egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour mixture, alternating with milk mixture, into butter mixture until batter is smooth. Spoon batter into a piping bag and pipe into donut pans or muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the coating: Mix sugar and cinnamon together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add warm donuts to cinnamon-sugar mixture; gently toss with hands until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
