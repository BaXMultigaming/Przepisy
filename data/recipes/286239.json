  "ingredients": [
    "2 medium zucchini, cut into 3x1/2-inch sticks",
    "1 large egg, beaten",
    "0.5 cup almond flour",
    "0.5 cup grated Parmesan cheese",
    "1 teaspoon Italian seasoning",
    "salt and freshly ground black pepper to taste",
    "olive oil cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add egg to a shallow bowl. Combine almond flour, Parmesan cheese, Italian seasoning, salt, and pepper in a second bowl; mix to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge zucchini first in egg, then in almond flour mixture, and lay out on a baking sheet. Spray zucchini generously with olive oil cooking spray. Spread out zucchini in a single layer in the air fryer basket. You might need to work in batches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until crispy, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
