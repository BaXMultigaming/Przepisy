  "ingredients": [
    "3 cups white sugar",
    "1.5 cups buttermilk",
    "1 cup unsalted butter",
    "2 tablespoons corn syrup (such as Karo®)",
    "2 teaspoons baking soda",
    "4 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Mix sugar, buttermilk, butter, corn syrup, and baking soda together in a large pan over medium heat. It will expand because of the baking soda. Bring to a boil; reduce heat and let simmer for 5 minutes. Take off the heat and stir in vanilla extract. Serve warm.",
