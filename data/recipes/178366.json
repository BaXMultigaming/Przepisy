  "ingredients": [
    "3 cups beer",
    "3 cups distilled white vinegar",
    "0.75 cup seafood seasoning (such as Old Bay®), divided",
    "0.5 cup salt",
    "36 live blue crabs"
  ],
  "steps": [
    {
      "text": "Combine beer, vinegar, ½ cup seafood seasoning, and salt in a large stockpot over high heat; bring to a strong simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully place each crab upside-down and stick a knife through the shell just behind the mouth right before cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fit a screen over simmering beer mixture; layer crabs on the screen.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the pot; steam crabs until they turn bright orange and no blue-green color remains, 20 to 30 minutes. Sprinkle crabs with remaining ¼ cup seafood seasoning before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
