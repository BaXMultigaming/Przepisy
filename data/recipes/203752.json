  "ingredients": [
    "0.5 (16 ounce) package fusilli (spiral) pasta",
    "0.25 cup margarine",
    "1 tablespoon minced onion",
    "0.25 cup all-purpose flour",
    "2 cups milk",
    "4 ounces processed cheese food",
    "0.25 cup blue cheese crumbles",
    "0.25 cup cubed Cheddar cheese",
    "1 teaspoon salt",
    "1 pinch ground black pepper",
    "0.25 teaspoon dry mustard"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a rolling boil over high heat. Stir in fusilli and return to a boil. Cook, uncovered and stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain well in a colander set in the sink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt margarine in a large saucepan over medium heat. Add onion and cook until translucent, about 5 minutes. Whisk in flour and cook for 1 minute. Slowly whisk in milk until entirely incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cheese food, blue cheese, Cheddar, salt, pepper, and mustard; cook and stir continually until cheeses have melted and mixture is thick. Fold in pasta until coated, then pour mixture into the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top begins to brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
