  "ingredients": [
    "1 cup dried rice noodles",
    "0.25 cup chopped peanuts",
    "0.25 cup freeze-dried vegetables",
    "2 tablespoons powdered peanut butter (such as PB2®)",
    "1.5 teaspoons powdered chicken bouillon",
    "1.5 teaspoons freeze-dried cilantro",
    "1 teaspoon chia seeds",
    "0.25 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon garlic powder",
    "0.125 teaspoon ground black pepper",
    "1 dash cayenne pepper",
    "1 cup boiling water"
  ],
  "steps": [
    {
      "text": "Combine rice noodles, peanuts, vegetables, powdered peanut butter, chicken bouillon, cilantro, chia seeds, salt, garlic powder, ginger, garlic powder, black pepper, and cayenne pepper in a resealable plastic bag. Remove air and seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reconstitute rice noodle mixture by pouring in 1 cup boiling water; mix well. Let sit until noodles and vegetables are tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
