  "ingredients": [
    "Reynolds® Parchment Paper",
    "2.5 cups flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "1 cup butter, softened",
    "1 cup packed brown sugar",
    "0.5 cup granulated sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "1 (12 ounce) bag semi-sweet chocolate chips",
    "1 cup coarsely chopped nuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line cookie sheets with Reynolds parchment paper; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, salt, and cinnamon on another sheet of Reynolds parchment paper; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together in a large bowl with an electric mixer until light and fluffy; beat in eggs and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually add flour mixture to butter mixture; beat until well blended. Stir in chocolate chips and nuts. Drop rounded tablespoons of dough onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 10 to 12 minutes. Cool on cookie sheets for 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
