  "ingredients": [
    "0.25 cup butter, melted",
    "0.125 cup all-purpose flour",
    "1.5 cups chicken broth",
    "2.5 cups cubed skinless, boneless chicken breast meat",
    "1.5 cups green peas",
    "1.5 cups canned mushrooms, drained",
    "1 cup cooked, sliced carrots",
    "0.5 onion, chopped",
    "0.25 cup chopped red bell pepper",
    "1 (16 ounce) can refrigerated buttermilk biscuits"
  ],
  "steps": [
    {
      "text": "Melt butter in a medium saucepan over medium heat; stir in flour, then pour in broth and let thicken, stirring. Add chicken, peas, mushrooms, carrots, onion, and bell pepper. Mix together and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour chicken mixture into a 9x13-inch baking dish. Place refrigerated biscuits over top and bake in the preheated oven for 25 to 30 minutes, or until biscuits are done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
