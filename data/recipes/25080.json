  "ingredients": [
    "0.5 cup white sugar",
    "2 tablespoons butter",
    "2 tablespoons water",
    "1.5 cups semisweet chocolate chips",
    "2 large eggs, beaten",
    "0.5 teaspoon vanilla extract",
    "0.66666668653488 cup all-purpose flour",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nozOhj9Pt0XvmJyT1vCeGRug0xk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25080-mmmmm-brownies-ddmfs-4x3-step1-0021-15d1a67125ae4b3a94ac78e2e899db1b.jpg"
      ],
      "image": "assets/images/25080/step_01.webp"
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease an 8-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, butter, and water in a medium saucepan; cook and stir over medium heat until boiling. Remove from heat and stir in chocolate chips until melted and smooth; mix in eggs and vanilla. Combine flour, salt, and baking soda; stir into the chocolate mixture. Spread brownie batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VjmMaCYkHsChvGB33doR_fmSajc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25080-mmmmm-brownies-ddmfs-4x3-step3-0025-00c4f0ad531d4f3ab352db110a6ada3b.jpg"
      ],
      "image": "assets/images/25080/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until top is dry and edges have started to pull away from the sides of the pan, about 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cool completely before cutting into squares.",
      "section": null,
      "name": null,
