  "ingredients": [
    "1 whole whole cooked chicken, de-boned and meat cubed",
    "4 cups chicken broth",
    "2 cups beef broth",
    "1 (14.5 ounce) can stewed tomatoes, chopped",
    "1 onion, chopped",
    "1 (4 ounce) can chopped green chilies",
    "3 tablespoons vegetable oil",
    "1 tablespoon ground cumin",
    "1 clove garlic, chopped",
    "1 pinch chili powder, or to taste",
    "1 (6 inch) corn tortillas, torn, or more to taste"
  ],
  "steps": [
    {
      "text": "Combine chicken meat, chicken broth, beef broth, tomatoes, onion, green chiles, oil, cumin, garlic, and chili powder together in a stockpot; bring to a boil. Reduce heat and simmer until flavors have blended, at least 1 hour. Add tortillas just before serving.",
