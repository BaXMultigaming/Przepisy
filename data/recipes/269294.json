  "ingredients": [
    "6 cups all-purpose flour",
    "4 teaspoons ground cinnamon",
    "3 teaspoons baking powder",
    "1 teaspoon salt",
    "2 cups butter, softened",
    "2 cups dark brown sugar",
    "2 large eggs",
    "6 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine flour, cinnamon, baking powder, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar together using an electric mixture in a second bowl until fluffy. Add eggs 1 at a time and beat well after each addition. Mix in vanilla extract. Add flour mixture to butter mixture and mix everything by hand into a smooth dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 4 pieces and flatten into 1-inch thick rounds. Cover with plastic wrap and chill for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a lightly floured surface, roll dough to 1/4-inch thickness and cut out desired shapes with cookie cutters. Place cookies on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 8 to 10 minutes. Cool on wire racks and decorate as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
