  "title": "Turkey Noodle Soup",
  "description": "This hearty turkey noodle soup is perfect for using leftover Thanksgiving turkey for a flavorsome and warming meal. Use whatever noodles you prefer!",
  "authors": [
    "Tonya Dean"
  ],
  "date_published": "2019-09-19T02:50:03-04:00",
