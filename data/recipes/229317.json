  "ingredients": [
    "1 (32 fluid ounce) container chicken stock",
    "0.25 cup sherry",
    "1 tablespoon dried parsley",
    "1 teaspoon dried summer savory",
    "1 teaspoon dried basil",
    "1 teaspoon salt",
    "0.5 teaspoon coarse ground black pepper",
    "0.5 teaspoon dried thyme",
    "0.125 teaspoon chipotle chile powder",
    "2 carrots, thinly sliced",
    "1 tablespoon butter",
    "1 onion, chopped",
    "2 stalks celery, sliced",
    "1 tablespoon minced garlic",
    "1 pound cubed cooked dark-meat turkey",
    "1 (8 ounce) package egg noodles"
  ],
  "steps": [
    {
      "text": "Combine chicken stock, sherry, parsley, savory, basil, salt, black pepper, thyme, and chipotle powder in a stock pot; bring to a boil. Add carrots, reduce heat to medium-low, and cook until carrots are tender, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Cx9EtmN3XiRnzC-AVrluoLxlwvU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229317-turkey-noodle-soup-VAT-step-01-0d08363b57fa48a796d1213fba2ac321.jpg"
      ],
      "image": "assets/images/229317/step_01.webp"
    },
    {
      "text": "Meanwhile, melt butter in a skillet. Cook and stir onion, celery, and garlic in hot butter until onions are translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6PkM4Wq0CFrZmOV_uHXdK-53C8o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229317-turkey-noodle-soup-VAT-step-02-f5eee96991844be2ae20c4dfb9b0b10a.jpg"
      ],
      "image": "assets/images/229317/step_02.webp"
    },
    {
      "text": "Stir into stock mixture. Add turkey, reduce heat to low, and cook at a simmer until turkey has flavored the soup, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c-pCLP1TAXIPqYuYyWTP02bW7pc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229317-turkey-noodle-soup-VAT-step-03-718fdef4ea1c48a485fc61a785329218.jpg"
      ],
      "image": "assets/images/229317/step_03.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook egg noodles in boiling water, stirring occasionally until cooked through but firm to the bite, about 5 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/52eXwvz57oMcrYDiRjJyygI3apU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229317-turkey-noodle-soup-VAT-step-04-7742a12eb8fb48f1bd1c45d71e9680ce.jpg"
      ],
      "image": "assets/images/229317/step_04.webp"
    },
    {
      "text": "Add noodles to soup. Season with salt and black pepper to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WYbHWtQBZJsqKuS0MtLCrMJB6U4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229317-turkey-noodle-soup-VAT-step-05-3b92704cffa74291ad23a115d5afd45a.jpg"
      ],
      "image": "assets/images/229317/step_05.webp"
    }
