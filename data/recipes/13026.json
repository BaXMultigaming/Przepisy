  "ingredients": [
    "1 gallon boiling water",
    "2 pounds dry great Northern beans",
    "2 onions, chopped",
    "6 cups chopped ham",
    "2 (10.75 ounce) cans condensed cream of mushroom soup",
    "8 ounces processed cheese food (eg. Velveeta), sliced"
  ],
  "steps": [
    {
      "text": "Add beans to boiling water and cook on high. Beans will soak up some water, so you will need to add more water later.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "As soon as beans can be mashed with fork, add ham and onions, let cook until beans and ham are done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn down to medium heat and add soup and cheese. Stir frequently while soup and cheese are mixed into the beans. When cheese is melted turn off heat and serve. Leftovers may be frozen.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
