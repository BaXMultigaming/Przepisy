  "ingredients": [
    "1 apple",
    "2 tablespoons raisins",
    "2 tablespoons chopped walnuts",
    "0.5 tablespoon unsalted butter, melted",
    "1 teaspoon white sugar",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.125 teaspoon ground nutmeg",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut about 1/2 inch off top of apple; spoon out some flesh, leaving at least a 1/4-inch border.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix raisins, walnuts, butter, sugar, vanilla, cinnamon, and nutmeg together in a medium bowl until well combined; spoon into cavity of apple. Place apple in a small oven-safe bowl; add water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer apple to the air fryer basket; cook until fork-tender, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
