  "ingredients": [
    "0.5 gallon apple cider",
    "0.5 gallon apple juice",
    "1 cup white sugar",
    "1 cup brown sugar",
    "4 cinnamon sticks",
    "1 whole clove",
    "3 cups 190 proof grain alcohol (such as Everclear®)",
    "2 cups vanilla vodka"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jbqNKLsSS9CG7X1Iz4XYfC76r-Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218330-grandmas-apple-pie-ala-mode-moonshine-ddmfs-step1-0841-8a270bf8847749768a29d76b2e4fb25d.jpg"
      ],
      "image": "assets/images/218330/step_01.webp"
    },
    {
      "text": "Place apple cider, apple juice, white sugar, brown sugar, cinnamon sticks, and whole clove in a large pot over high heat. Bring to a boil, then reduce heat to medium-low and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LjA26TFA5zRzxntodWc7kXVVNBo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218330-grandmas-apple-pie-ala-mode-moonshine-ddmfs-step2-215-780107c566a1417486aefe081a2d6dfb.jpg"
      ],
      "image": "assets/images/218330/step_02.webp"
    },
    {
      "text": "Remove from heat and allow to cool completely. Stir grain alcohol and vanilla vodka into the cooled mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into clean bottles or jars; store in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
