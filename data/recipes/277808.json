  "ingredients": [
    "1 pound potatoes",
    "0.25 cup olive oil",
    "1 tablespoon ground black pepper",
    "1 tablespoon dried oregano",
    "1 teaspoon garlic powder",
    "1 teaspoon seasoned salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut potatoes into wedges. Rinse and pat dry. Pour olive oil into a large bowl. Add wedges to the oil; mix until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix black pepper, oregano, garlic powder, and seasoned salt together in another bowl or a large zip-top bag. Add potato wedges and mix around until evenly coated. Spread wedges on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and starting to crisp, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
