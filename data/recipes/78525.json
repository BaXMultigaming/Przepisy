  "ingredients": [
    "2 eggs",
    "2 (15 ounce) cans kidney beans, drained",
    "0.5 cup mayonnaise",
    "0.5 onion, diced",
    "1 stalk celery, diced",
    "2 tablespoons sweet pickle relish",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Place eggs in a saucepan and cover with cold water. Bring to a boil, remove from heat, and let eggs stand in hot water for 15 minutes. Remove eggs from hot water, cool under cold running water; peel and chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chopped eggs, kidney beans, mayonnaise, onion, celery, and relish together in a bowl until just combined; season with salt and pepper. For best flavor results, chill salad in the refrigerator before serving, at least 1 hour.",
      "section": null,
      "name": null,
