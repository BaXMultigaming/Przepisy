  "ingredients": [
    "1 (14 ounce) can coconut milk",
    "1 cup rolled oats",
    "2 tablespoons honey",
    "0.25 cup coconut flakes",
    "2 tablespoons brown sugar, or more to taste",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Bring coconut milk to a gentle boil in a small saucepan over medium-low heat. Stir in oats and honey; lower heat and simmer until milk has mostly been absorbed, about 15 minutes.",
