  "ingredients": [
    "1 cup whole oats",
    "1 cup oat flour",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon allspice",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 large apples - peeled, cored, and chopped",
    "0.75 cup plain yogurt",
    "2 eggs",
    "0.5 cup brown sugar",
    "0.25 cup butter, melted",
    "1 teaspoon vanilla extract",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Generously grease muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, oat flour, cinnamon, allspice, baking soda, and salt in a large bowl. Add apples, yogurt, eggs, brown sugar, butter, and vanilla extract to oat mixture until batter is well mixed; fold in walnuts. Pour batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
