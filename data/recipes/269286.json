  "ingredients": [
    "1 cup coconut flakes",
    "0.5 cup chopped pecans",
    "1 cup butter, softened",
    "0.66666668653488 cup lightly packed brown sugar",
    "0.66666668653488 cup white sugar",
    "1 egg",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Heat a small skillet over medium-low heat. Toast coconut flakes and pecans in batches until lightly browned and fragrant, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, brown sugar, and white sugar together in a bowl using an electric mixer until light and fluffy. Mix in egg and vanilla extract. Beat to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and baking soda in a bowl. Add to butter mixture and mix until just combined. Stir in toasted pecans and coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place scoops of dough on the prepared baking sheet using a 1 1/2-tablespoon spring-hinged scoop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 10 to 12 minutes. Cool on baking sheet for 5 minutes. Carefully remove from baking sheet and transfer to a cooling rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
