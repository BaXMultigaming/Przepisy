  "ingredients": [
    "2 tablespoons Maille® Old Style Mustard",
    "12 fresh shrimp",
    "1 onion, sliced",
    "1 green pepper, finely chopped",
    "1 clove garlic, crushed",
    "1 tablespoon sunflower oil"
  ],
  "steps": [
    {
      "text": "Place sunflower oil in a skillet. Add the onion, green pepper and garlic and cook for 5 minutes. Add the Maille® Old Style Mustard and cook for another 2 minutes. Add the shrimp and cook 5 minutes more. Season to taste. Serve with a salad of fine herbs (chives, chervil, parsley, basil).",
