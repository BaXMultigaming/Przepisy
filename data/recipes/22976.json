  "ingredients": [
    "2 medium avocados - peeled, pitted and diced",
    "1.5 teaspoons salt, or to taste",
    "1 large tomato, diced",
    "1 medium onion, diced",
    "2 medium jalapeno peppers, chopped",
    "2 tablespoons fresh lime juice",
    "0.5 tablespoon chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Mash avocados in a medium bowl until desired consistency is reached. Stir in salt. Mix in tomato, onion, jalapeño peppers, lime juice, and cilantro until combined.",
