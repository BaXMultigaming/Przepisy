  "ingredients": [
    "1 teaspoon vegetable oil",
    "2 cloves garlic, minced",
    "1 Thai chile pepper, or more to taste",
    "3 Chinese eggplants, cut into 1-inch cubes, or more to taste",
    "0.5 cup water",
    "1 teaspoon dark soy sauce",
    "0.5 teaspoon white sugar",
    "salt to taste",
    "1 cup fresh basil leaves, roughly chopped"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Add garlic and chile pepper; cook and stir until garlic is golden, about 1 minute. Add eggplant; stir in water and cover. Cook and stir every few minutes, until eggplant softens, 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in soy sauce, sugar, and salt; continue cooking, uncovered, until water has evaporated and eggplant is coated with sauce, about 5 minutes. Stir in basil leaves; remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
