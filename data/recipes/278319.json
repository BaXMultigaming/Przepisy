  "ingredients": [
    "2 sleeves crackers (such as Keebler® Town House®), crumbled",
    "1.5 cups pecan meal",
    "1.5 cups shredded Colby-Monterey Jack cheese",
    "1 cup sweet onion, minced",
    "0.25 cup finely chopped fresh spinach",
    "3 cloves garlic, minced",
    "3 tablespoons finely chopped fresh parsley",
    "0.75 teaspoon poultry seasoning",
    "0.5 teaspoon salt",
    "6 eggs, beaten",
    "0.5 cup vegetable oil for frying",
    "1 tablespoon olive oil",
    "1 (10 ounce) jar grape jelly",
    "1 (12 ounce) jar chili sauce (such as Heinz®)"
  ],
  "steps": [
    {
      "text": "Toss cracker crumbs and pecan meal together in a large bowl. Add Colby-Jack cheese, onion, spinach, garlic, parsley, poultry seasoning, and salt. Beat the eggs together in a bowl; incorporate into the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form meatballs using a 1-inch cookie scoop. Roll smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a deep fryer. Drop meatballs gently into the hot oil until golden brown, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over low heat. Add grape jelly and stir gently until it's completely melted. Stir in chili sauce until well combined. Add cooked meatballs and stir to coat. Heat through, about 5 minutes. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
