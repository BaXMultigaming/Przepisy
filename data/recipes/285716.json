  "ingredients": [
    "2 pounds ground beef (80% lean)",
    "0.5 cup mayonnaise",
    "0.25 cup Italian-style bread crumbs",
    "2 tablespoons Dijon mustard",
    "1 teaspoon granulated onion",
    "0.5 teaspoon kosher salt",
    "0.5 teaspoon ground black pepper",
    "2 tablespoons steak sauce (such as A.1.®)",
    "2 tablespoons ketchup",
    "1 tablespoon brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef, mayonnaise, bread crumbs, mustard, onion, salt, and pepper together in a large bowl until well combined. Transfer mixture to a 9x5-inch loaf pan with high sides. Form into a loaf by picking it up and forcing it down into the pan, making sure to knock out any air and square off all sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Spin pan and bake for an additional 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix steak sauce, ketchup, and sugar together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and spoon sauce over top. Bake until no longer pink in the center, about 10 more minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove form the oven and let rest for 5 minutes. Remove meat loaf to a serving platter and slice into 8 slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
