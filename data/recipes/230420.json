  "ingredients": [
    "1 cup water",
    "1 chai tea bag",
    "3 tablespoons brown sugar",
    "8 cups pineapple juice",
    "2 cups rum, or as needed",
    "1 cup dry vermouth (such as Martini®)",
    "3 tablespoons vanilla-flavored syrup"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a saucepan; pour into a mug and brew chai tea for 5 minutes. Remove tea bag and mix brown sugar into the hot tea until dissolved. Allow tea to cool for about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix tea, pineapple juice, rum, vermouth, and vanilla-flavored syrup together in a large punch bowl; stir well. Chill for at least 2 hours before serving.",
