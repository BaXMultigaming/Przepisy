  "ingredients": [
    "5 pounds potatoes, peeled and quartered",
    "3 cups cauliflower florets",
    "4 cloves garlic",
    "1 large carrots, chopped",
    "0.5 cup skim milk",
    "3 tablespoons butter",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 tablespoon chopped fresh parsley, for garnish"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to a boil. Add potatoes, cauliflower, garlic and carrots. Cook until potatoes are tender but still firm, about 15 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the milk, butter, salt and pepper. Beat until smooth. Sprinkle with parsley and serve.",
      "section": null,
