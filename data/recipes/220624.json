  "ingredients": [
    "1 (12 ounce) box whole wheat rotini pasta",
    "0.25 cup apple cider vinegar",
    "0.25 cup olive oil",
    "0.25 cup crumbled feta cheese, or to taste",
    "6 leaves fresh basil, chopped",
    "salt and ground black pepper to taste",
    "3 tomatoes, chopped",
    "2 large carrots, chopped",
    "1 bunch asparagus, trimmed and chopped",
    "1 bunch green onions",
    "4 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil; cook rotini at a boil until tender yet slightly firm to the bite, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse rotini with cold water until completely chilled; drain completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk apple cider vinegar and olive oil together in a large bowl until blended. Stir in feta cheese, basil, salt, and black pepper .",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss tomatoes, carrots, asparagus, green onions, and garlic in feta vinaigrette to evenly coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cooled pasta into vegetable mixture; toss until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
