  "ingredients": [
    "1.5 pounds ground beef",
    "2 eggs",
    "1 onion, chopped",
    "0.5 cup barbecue sauce",
    "0.75 cup crushed crackers",
    "1 cup crushed potato chips",
    "0.75 teaspoon liquid smoke flavoring",
    "0.75 teaspoon ground black pepper",
    "1 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "1 pinch cayenne pepper",
    "6 slices bacon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the beef, eggs, onion, barbecue sauce, cracker crumbs, potato chips, liquid smoke, ground black pepper, salt, garlic powder, and cayenne pepper; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a lightly greased cookie sheet, shape the mixture into a loaf. Lay the bacon slices across the width of the loaf so that the entire surface is covered. Cover the loaf loosely with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
