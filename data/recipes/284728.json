  "ingredients": [
    "1 cup almond flour",
    "0.5 cup unsalted butter, softened",
    "2 large eggs, divided",
    "1 cup dark chocolate chips",
    "1 cup chopped walnuts",
    "1 cup unsweetened dried cranberries",
    "1 cup unsweetened coconut flakes",
    "0.5 cup raw sunflower seeds",
    "2 tablespoons flax seeds",
    "1 cup heavy cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix almond flour, butter, and 1 egg in a bowl until well combined. Press into the bottom of an 8-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chocolate chips, walnuts, cranberries, coconut flakes, sunflower seeds, and flax seeds together in a large bowl. Cover the almond dough with this mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream and remaining egg thoroughly in a small bowl; pour evenly over the fruit-nut mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes. Remove from the oven and cool to room temperature, 30 to 45 minutes. Chill in the refrigerator for 2 hours before cutting into 16 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
