  "ingredients": [
    "1 large egg, separated, divided",
    "0.5 cup butter, softened",
    "0.25 cup packed brown sugar",
    "1 cup all-purpose flour",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "0.25 cup finely chopped walnuts",
    "0.66666668653488 cup any flavor fruit jam"
  ],
  "steps": [
    {
      "text": "Gather ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WtplIjE4bDPSawJccRULAZI9QkI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9618-thumbprint-cookies-01-092d2ccb5e6046b0ad22523f222450f7.jpg"
      ],
      "image": "assets/images/9618/step_01.webp"
    },
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease two cookie sheets and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg white in a small bowl. Place chopped walnuts in another small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/im3fPhmdY9mB01BIFfF_W5qtSxQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9618-thumbprint-cookies-02-320fed8289c943af95f41186052fdefe.jpg"
      ],
      "image": "assets/images/9618/step_03.webp"
    },
    {
      "text": "Cream butter, brown sugar, and egg yolk in a mixing bowl until light and fluffy, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2o1wGGfRqudbVg71Z-xYoYcKLT0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9618-thumbprint-cookies-03-d5e93378e8b947b6baa662ec53ff5c79.jpg"
      ],
      "image": "assets/images/9618/step_04.webp"
    },
    {
      "text": "Add flour, vanilla, and salt; mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p1B5DQBaVYWWpR4l8w8G6OyH4OY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9618-thumbprint-cookies-04-9bd17bae1c5146519bb06ec05d4bfe1e.jpg"
      ],
      "image": "assets/images/9618/step_05.webp"
    },
    {
      "text": "Scoop dough into 1 ½-inch balls. Dip in egg white, then roll in walnuts until coated. Place 2 inches apart on the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e1zUtItlWH1p5Uf0WpMQrtlSnE0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9618-thumbprint-cookies-07-a9edd5e155fb41b4a2e3746bc582f499.jpg"
      ],
      "image": "assets/images/9618/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until slightly puffed, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cookies from the oven. Use your thumb or the end of a wooden spoon to gently press an indent in the center of each cookie. Spoon jam into each thumbprint, filling it to the brim.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uKkHlrBs7bbc2hoIHNlHTT2KJBM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9618-thumbprint-cookies-09-9e36c9103d0648a9bc68b000ec12b895.jpg"
      ],
      "image": "assets/images/9618/step_08.webp"
    },
    {
      "text": "Return cookies to the oven and bake until set, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IHQHtb31OtAJzCCOPuV06vwjllQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9618-thumbprint-cookies-10-2-51c7962aaddd4f1b916167998990998c.jpg"
      ],
      "image": "assets/images/9618/step_09.webp"
    },
    {
      "text": "Remove from the oven and transfer to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/10t53ucVeL5vqtkMFLPQnbqO_Kg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9618-thumbprint-cookies-vat-hero-11-4x3-c2d7b6e1b0a14f178e4ddf1240ea250c.jpg"
