  "ingredients": [
    "0.75 cup milk",
    "2 tablespoons butter, melted",
    "0.25 cup egg substitute",
    "1 tablespoon white sugar",
    "1 cup all-purpose flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease an 8x8 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, beat together milk, butter and egg substitute. Add the sugar, then gradually beat the flour in. Carefully stir in the baking powder and salt. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes. Cut into 16 square servings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
