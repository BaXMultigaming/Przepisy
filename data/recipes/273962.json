  "ingredients": [
    "2 cups cubed seedless watermelon",
    "2 medium tomatoes, diced",
    "1 large cucumber, halved lengthwise and thinly sliced crosswise",
    "1 small onion, thinly sliced",
    "3 tablespoons red wine vinegar",
    "2 tablespoons olive oil",
    "1 teaspoon sea salt",
    "1 teaspoon white sugar",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon ground thyme",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Combine watermelon, tomatoes, cucumber, and onion in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk vinegar, olive oil, salt, sugar, oregano, basil, thyme, and black pepper together in a separate bowl; pour over salad and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl with plastic wrap; refrigerate before serving for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
