  "ingredients": [
    "2 tablespoons butter",
    "2 tablespoons raw honey",
    "1 tablespoon fresh lemon juice",
    "1 tablespoon pineapple juice",
    "1 large clove garlic, minced",
    "2 teaspoons low-sodium soy sauce (such as Bragg®)",
    "1 pinch red pepper flakes",
    "4 ounces large shrimp, peeled and deveined",
    "8 (1 inch) cubes fresh pineapple",
    "8 (1 inch) pieces red bell pepper",
    "2 bamboo skewers, soaked in water for 20 minutes",
    "1 serving cooking spray"
  ],
  "steps": [
    {
      "text": "Combine butter, honey, lemon juice, pineapple juice, garlic, soy sauce, and red pepper flakes in a small saucepan over medium-low heat. Simmer until sauce begins to thicken, 3 to 4 minutes. Set aside 1/2 of the sauce for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thread pineapple, shrimp, and bell pepper alternately onto both skewers and baste with the remaining sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill until shrimp are cooked through and opaque in color, turning halfway, 5 to 7 minutes. Serve with dipping sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
