  "ingredients": [
    "8 large potatoes, peeled and cubed",
    "4 ounces cream cheese",
    "0.33333334326744 cup butter",
    "8 ounces sour cream",
    "0.5 (1 ounce) package dry Ranch-style dressing mix"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F ( 175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a large pot with enough water to cover. Bring to a boil, and cook until potatoes are tender, about 10 minutes. Drain, then add cream cheese, butter, sour cream, and ranch dressing mix. Mash until creamy using a potato masher or electric mixer. Spread evenly in a large baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is golden brown, about 30 minutes.",
