  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "0.25 teaspoon salt",
    "2 cups fresh cranberries, at room temperature",
    "0.5 cup chopped walnuts",
    "0.5 cup butter, melted",
    "2 eggs, beaten",
    "1 teaspoon almond extract",
    "0.25 cup chopped walnuts",
    "0.25 cup brown sugar",
    "2 tablespoons butter, melted",
    "2 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, and salt in a bowl. Stir in cranberries and walnuts; toss to coat. Stir in butter, eggs, and almond extract. Spread batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine walnuts, brown sugar, butter, and flour for streusel in a small bowl. Crumble streusel on top of cranberry mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes. Serve warm or cold.",
      "section": null,
      "name": null,
      "url": null,
