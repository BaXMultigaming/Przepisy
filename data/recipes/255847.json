  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix",
    "1.5 cups water",
    "4 eggs",
    "0.75 cup graham cracker crumbs",
    "0.33333334326744 cup butter",
    "1.5 teaspoons ground cinnamon",
    "2.5 cups diced apples",
    "0.75 cup packed brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cake mix, water, eggs, graham cracker crumbs, butter, and cinnamon in a large bowl; beat with an electric mixer on medium speed until batter is smooth, about 2 minutes. Fold apples into batter; pour into the baking pan. Sprinkle brown sugar over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake pulls away from sides of the pan, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
