  "ingredients": [
    "1 pound lean ground beef",
    "0.25 cup minced onion",
    "2 cloves garlic, minced",
    "salt and pepper to taste",
    "4 hamburger buns",
    "4 tablespoons wasabi paste",
    "4 tablespoons mayonnaise",
    "4 slices Cheddar cheese"
  ],
  "steps": [
    {
      "text": "In a large bowl, mix ground beef, onion and garlic. Season with salt and pepper, and shape into 4 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat, and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place patties on the prepared grill, and cook 5 minutes per side, or to desired doneness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare buns by spreading 1 tablespoon of wasabi on the bottom half, and 1 tablespoon mayonnaise on the top half. Top burgers with a slice of cheese, and sandwich inside the buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
