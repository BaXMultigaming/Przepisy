  "title": "Vegetable Scrap Stock",
  "description": "Save your vegetable scraps for making a delicious homemade stock you can use in any soup, stew, or braise.",
  "authors": [
    "Jill Lightner"
  ],
  "date_published": "2020-05-13T20:19:21-04:00",
