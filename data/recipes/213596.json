  "ingredients": [
    "1 (9 inch) pie shell, baked",
    "0.75 cup real maple syrup (dark amber)",
    "2.25 cups heavy cream",
    "4 egg yolks",
    "1 egg",
    "1 teaspoon salt",
    "1 teaspoon vanilla extract",
    "1 teaspoon distilled white vinegar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a large baking sheet with foil; place pie crust in its pie plate on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring maple syrup to a boil in a heavy saucepan over medium heat; cook until reduced by about one-fourth, 5 to 7 minutes. Stir in cream; bring to a simmer, then remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg yolks and egg together in a large bowl. Slowly whisk cream mixture into eggs, about ¼ cup at a time, whisking constantly. Stir in salt, vanilla extract, and vinegar; pour into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pie is mostly set but jiggles slightly when moved, about 1 hour. Cool before serving, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
