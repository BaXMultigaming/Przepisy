  "ingredients": [
    "6 cups cubed seedless watermelon",
    "50 fresh mint leaves",
    "1 cup white rum",
    "5 limes, juiced",
    "0.66666668653488 cup simple syrup",
    "2 cups ice cubes, or as needed",
    "1 cup club soda, or as needed"
  ],
  "steps": [
    {
      "text": "Place watermelon cubes into a blender; blend until smooth. Transfer to a mesh strainer set over a bowl to remove pulp. Measure 2 cups strained watermelon juice; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place mint leaves in the bottom of a pitcher. Add ½ watermelon juice to the pitcher; mash mint leaves with a cocktail muddler or bottom of a wooden spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in remaining ½ watermelon juice, rum, lime juice, and simple syrup. Fill pitcher with ice; top with club soda to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
