  "ingredients": [
    "1 head romaine lettuce",
    "6 scallions, finely sliced",
    "0.5 cup chopped fresh dill",
    "4 tablespoons olive oil",
    "2 tablespoons red wine vinegar",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
