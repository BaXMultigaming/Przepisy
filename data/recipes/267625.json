  "ingredients": [
    "4 medium russet potatoes",
    "1 cup water",
    "3 tablespoons canola oil",
    "1 teaspoon paprika",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until fork-tender, about 20 minutes. Drain. Place in a bowl and refrigerate until completely cool, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil, paprika, black pepper, and salt in a mixing bowl. Cut cooled potatoes into quarters and toss into the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 1/2 the potato wedges to the air fryer basket, placing them skin-side down and being careful not to overcrowd.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until golden brown, 13 to 15 minutes. Repeat with remaining wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
