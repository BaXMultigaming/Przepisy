  "ingredients": [
    "1 (12 ounce) package white chocolate chips",
    "0.5 cup heavy whipping cream, or more as needed",
    "0.25 cup light corn syrup",
    "2 tablespoons butter",
    "0.25 teaspoon salt",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Melt white chocolate chips, cream, corn syrup, butter, and salt together in the top of a double boiler over simmering water, stirring frequently, until smooth and glossy, about 5 to 10 minutes. Remove fondue from heat and stir in vanilla extract.",
