  "ingredients": [
    "3 tablespoons unsalted butter",
    "3 tablespoons packed brown sugar",
    "2 bananas, peeled and halved lengthwise and crosswise",
    "2 fluid ounces rum",
    "1 fluid ounce banana liqueur",
    "2 pinches ground cinnamon",
    "2 scoops vanilla ice cream",
    "2 small sprigs of mint"
  ],
  "steps": [
    {
      "text": "Heat butter and brown sugar in a skillet over medium-high heat until butter melts and mixture begins to bubble, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bananas, cut-side down, into the brown sugar mixture. Cook until just golden, about 30 seconds; flip and cook until golden on the other side, about 30 seconds. Turn off the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With the heat off, pour rum and banana liqueur into the skillet. Turn the heat to medium-high or high; cook until alcohol ignites and flames, 1 to 3 minutes. Carefully add cinnamon. When the flames die, remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop vanilla ice cream into two bowls. Divide banana mixture between the bowls and garnish with mint sprigs.",
      "section": null,
      "name": null,
      "url": null,
