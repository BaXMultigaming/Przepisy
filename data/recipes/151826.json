  "ingredients": [
    "4 carrots, peeled and grated",
    "2 apples - peeled, cored, and grated",
    "1 cup raisins",
    "1 cup fine bread crumbs",
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground allspice",
    "4 eggs",
    "0.66666668653488 cup butter",
    "0.5 cup white sugar"
  ],
  "steps": [
    {
      "text": "Combine carrots, apples, raisins, and bread crumbs in a bowl; set aside. Sift flour, baking powder, cinnamon, baking soda, salt, nutmeg, and allspice together in a separate small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, butter, and sugar together in a separate large bowl. Stir in flour mixture, then add carrot mixture; stir well. Transfer to a lightly greased, 2-quart mold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a steamer rack in the bottom of a large, deep pot. Set filled mold on steamer rack. Pour enough water into the pot to cover bottom 2/3 of mold. Bring to a boil over medium heat. Reduce heat to low, cover, and simmer for 2 hours 45 minutes, adding water occasionally to maintain water level. Remove mold from pot; cool 10 minutes before turning out onto a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
