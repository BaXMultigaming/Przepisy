  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup butter, softened",
    "0.5 cup brown sugar",
    "2 cups chopped pecans",
    "1 cup flaked coconut",
    "1 (14 ounce) can sweetened condensed milk",
    "1 (11 ounce) package individually wrapped caramels (such as Hershey's®), unwrapped",
    "2 tablespoons milk",
    "1 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, butter, and brown sugar together in a bowl; press into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is lightly browned, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle pecans and coconut over crust. Pour sweetened condensed milk over pecans and coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat caramels and milk together in a small saucepan over medium-low heat until smooth, 2 to 3 minutes. Pour caramel sauce over baked sweetened condensed milk. Sprinkle chocolate chips over caramel. Cool completely before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
