  "title": "Sweet Chocolate Caramel Squares",
  "description": "Chocolate caramel bars layered with sweetened condensed milk, pecans, and coconut are a sweet treat for those you love on Valentine's Day.",
  "authors": [
    "Rachel"
  ],
  "date_published": "2020-03-05T00:11:41-05:00",
