  "title": "Pistachio Nut Bundt Cake",
  "description": "A green Bundt cake. This is perfect for Christmas or St. Patrick's day.",
  "authors": [
    "Marlene Edwards"
  ],
  "date_published": "2000-01-21T15:26:48-05:00",
