  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix",
    "2 (3.4 ounce) packages instant pistachio pudding mix",
    "1 cup sour cream",
    "0.5 cup vegetable oil",
    "4 eggs",
    "0.5 cup packed brown sugar",
    "0.5 cup chopped walnuts",
    "1 teaspoon ground cinnamon",
    "0.25 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9 inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZtzlYDzz05grnRkvTQVBVeYQ1kU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17854-pistachio-nut-bundt-cake-VAT-005-step-01-58c1cee3ae334bd9a21076173fec1b6c.jpg"
      ],
      "image": "assets/images/17854/step_01.webp"
    },
    {
      "text": "In a medium bowl, stir together the cake mix and instant pudding. Add the sour cream, oil and eggs, mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qC-0Df5CnlywPv6qpCYJVwnRnxg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17854-pistachio-nut-bundt-cake-VAT-006-step-02-1185dd801cb1464bbf5f8f85044c7f6b.jpg"
      ],
      "image": "assets/images/17854/step_02.webp"
    },
    {
      "text": "Pour half of the batter into the prepared pan. Combine the brown sugar, walnuts and cinnamon, sprinkle over the batter in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eLK9lKGIZI6cGG1PL0IKa0JlmF4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17854-pistachio-nut-bundt-cake-VAT-007-step-03-0a844f3e204b40ba9edd6c54668c9a12.jpg"
      ],
      "image": "assets/images/17854/step_03.webp"
    },
    {
      "text": "Cover with the remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dQNWv4C-GepZmU_Gv9V4tcAw3c8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17854-pistachio-nut-bundt-cake-VAT-008-step-04-c3ba33b649a1465ea5dfd94962b4e708.jpg"
      ],
      "image": "assets/images/17854/step_04.webp"
    },
    {
      "text": "Bake for 1 hour in the preheated oven, until cake springs back when lightly touched.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/COs54zL5r_IK6YW00Nl65PO0hJ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17854-pistachio-nut-bundt-cake-VAT-009-step-05-bcbb3621eb5b4df99c2ae2a65f22a8bf.jpg"
      ],
      "image": "assets/images/17854/step_05.webp"
    },
    {
      "text": "Cool for 15 minutes in pan before inverting onto a wire rack to cool completely. When cake is cooled, dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wluEvzxgoTN_jec9mIXQkbEt0m0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17854-pistachio-nut-bundt-cake-VAT-010-step-06-ba28acf181d24394bcf09dd0e90ea810.jpg"
      ],
      "image": "assets/images/17854/step_06.webp"
    }
  ],
