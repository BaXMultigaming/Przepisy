  "ingredients": [
    "0.75 cup all-purpose flour",
    "0.75 cup bread flour",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon fine sea salt",
    "2 tablespoons water",
    "1 tablespoon cornstarch",
    "0.5 cup unsalted butter, softened",
    "0.5 cup white sugar",
    "0.5 cup light brown sugar",
    "0.25 cup plain low-fat yogurt",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk both flours, baking powder, baking soda, and salt together in a medium bowl. Mix water and cornstarch together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and both sugars in a large bowl; beat with an electric mixer until smooth and creamy. Mix in cornstarch mixture, then add yogurt and vanilla and beat thoroughly. Add dry ingredients in small batches, beating well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 10 to 12 minutes. Cool on the baking sheet for 3 to 4 minutes before removing to a wire rack to cool completely, about 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
