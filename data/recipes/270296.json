  "ingredients": [
    "3 pounds ground beef, or more to taste",
    "1 large onion, chopped, or more to taste",
    "2 (16 ounce) cans tomato sauce, or more to taste",
    "2 (6 ounce) cans tomato paste",
    "ground black pepper to taste",
    "1 (16 ounce) can tomato puree, or more to taste",
    "0.5 cup ketchup",
    "1 cup brown sugar",
    "1 tablespoon prepared yellow mustard",
    "1 tablespoon celery salt",
    "1 tablespoon onion salt",
    "1 tablespoon garlic salt",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Cook and stir ground beef and onion in a large pot until beef is no longer pink, about 10 minutes. Drain excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour tomato sauce and tomato paste into the pot; season with pepper. Stir in tomato puree and ketchup. Add brown sugar, mustard, celery salt, onion salt, and garlic salt, stirring after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Simmer sauce over medium-low heat, stirring frequently, until flavors combine, 30 to 45 minutes. Sprinkle in Parmesan cheese during the last 5 minutes of cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
