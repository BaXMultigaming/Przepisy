  "ingredients": [
    "5 potatoes, peeled and cubed",
    "2 onions, chopped",
    "2 cups diced ham",
    "3 stalks celery, chopped",
    "1 (15.25 ounce) can whole kernel corn, undrained",
    "2 tablespoons margarine",
    "salt and pepper to taste",
    "2 cubes chicken bouillon",
    "1 (12 fluid ounce) can evaporated milk"
  ],
  "steps": [
    {
      "text": "Place potatoes, onions, ham, celery, corn, margarine, salt, and pepper in a slow cooker. Add bouillon cubes and enough water to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 8 to 9 hours. Stir in evaporated milk, then cook for 30 more minutes.",
