  "ingredients": [
    "cooking spray",
    "1 (16 ounce) package Jimmy Dean® Premium Pork Regular Sausage",
    "1 cup diced onion",
    "2 teaspoons poultry seasoning",
    "1 teaspoon salt",
    "1 teaspoon ground cumin",
    "1 teaspoon chili powder",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried sage",
    "0.5 teaspoon garlic powder",
    "3 cups stale or toasted cornbread, crumbled",
    "3 (2.6 ounce) bolillo rolls (Mexican bread rolls), diced and toasted",
    "1 (14.75 ounce) can creamed corn",
    "1 cup chicken broth",
    "1 (4 ounce) can diced green chiles",
    "2 large eggs, lightly beaten",
    "0.25 cup chopped cilantro"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sausage to a large frying pan over medium-high heat. Cook and stir with a spatula, breaking apart the sausage until cooked, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix poultry seasoning, salt, cumin, chili powder, black pepper, cayenne, oregano, sage, and garlic powder into the sausage mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornbread crumbles and bolillo pieces in a large bowl. Mix in sausage mixture. Add creamed corn, chicken broth, green chiles, eggs, and cilantro; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer stuffing mixture to the prepared baking dish. Cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes. Uncover and continue to bake until golden, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
