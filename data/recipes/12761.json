  "ingredients": [
    "2 pounds salmon fillets, bones removed",
    "2 lemons, divided",
    "0.5 cup white wine",
    "1.5 cups pesto"
  ],
  "steps": [
    {
      "text": "Lightly oil a baking pan large enough to accommodate the fish. Place salmon in pan skin-side down. Squeeze juice of 1 lemon and white wine over salmon; set aside to marinate for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack about 9 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread a 1/4-inch thick layer of pesto on top of salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook under the preheated broiler until a crust forms and fish flakes easily with a fork, about 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove salmon and set aside for a few minutes. Squeeze juice from 1/2 lemon over fish. Slice the remaining 1/2 lemon into thin slices; arrange on salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
