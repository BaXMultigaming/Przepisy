  "ingredients": [
    "1 fresh pineapple - peeled, cored and cut into 1 inch rings",
    "3 tablespoons melted butter",
    "0.25 teaspoon honey",
    "1 dash hot pepper sauce",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J_HH3j2q8ql8eCayMeFp6XG3uXc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-51294-Grilled-Pineapple-DDMFS-Step-01-ab8bfa963ad74b80912990421dcda65a.jpg"
      ],
      "image": "assets/images/51294/step_01.webp"
    },
    {
      "text": "Place pineapple rings in a large resealable plastic bag. Add butter, honey, hot pepper sauce, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FcFI4orw8UrDsyCNKIIa17qv4Lg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-51294-Grilled-Pineapple-DDMFS-Step-02-34e3c837151f4017b9ab4637867f2ede.jpg"
      ],
      "image": "assets/images/51294/step_02.webp"
    },
    {
      "text": "Seal the bag and shake to coat evenly. Marinate for at least 30 minutes, or preferably overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PSSKIqiq2iDhD3uAecdTOODutec=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-51294-Grilled-Pineapple-DDMFS-Step-03-46dfeb0990f34bc4ab574e1555f94b25.jpg"
      ],
      "image": "assets/images/51294/step_03.webp"
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil grate. Grill pineapple rings until heated through and grill marks appear, 2 to 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
