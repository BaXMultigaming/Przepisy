  "title": "Steamed Christmas Pudding",
  "description": "Mincemeat is steamed with cranberry sauce, pumpkin puree, eggs, flour, butter and sugar, and served with a sweet, creamy frosting.",
  "authors": [
    "Leeza"
  ],
  "date_published": "1998-12-22T20:01:44-05:00",
