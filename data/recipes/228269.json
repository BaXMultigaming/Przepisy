  "ingredients": [
    "1 ear leftover roasted corn, kernels cut from cob",
    "2 tomatoes, diced",
    "0.25 sweet onion, diced",
    "1 lime, juiced",
    "1.5 teaspoons olive oil",
    "1.5 cups cubed seeded watermelon",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Mix tomatoes, corn, and sweet onion in a bowl. Sprinkle lime juice over tomato mixture. Pour olive oil over tomato mixture. Fold watermelon into tomato mixture. Season with salt to serve. Let sit 5 minutes before serving.",
