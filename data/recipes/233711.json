  "ingredients": [
    "1 (12 ounce) can refrigerated biscuit dough (such as Pillsbury Grands Jr.®)",
    "2 tablespoons sweet hot mustard",
    "9 ounces fully cooked sausage links",
    "4 teaspoons finely grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread each biscuit into a 2x4-inch oval using your hands. Brush hot mustard onto each biscuit. Place a sausage link across the short edge of each biscuit oval and roll up lengthwise. Cut each rolled biscuit into 4 round slices. Lay 'bites' onto a baking sheet. Sprinkle each 'bite' with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until biscuits are browned, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
