  "ingredients": [
    "1 tablespoon sour cream",
    "1 (1 ounce) package ranch dressing mix (such as Hidden Valley Ranch ®)",
    "1 (8 ounce) package cream cheese",
    "0.5 pound Cheddar cheese, shredded",
    "0.25 cup finely chopped pecans"
  ],
  "steps": [
    {
      "text": "Mix sour cream with ranch dressing mix in a bowl until smoothly combined. Add cream cheese and Cheddar cheese to the bowl and mix together with your hands until thoroughly blended. Chill mixture for 5 minutes, then shape into a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pecans into a shallow bowl and roll all sides of cheese ball in pecans to coat. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
