  "ingredients": [
    "0.33333334326744 cup soy sauce",
    "0.25 cup olive oil",
    "1 small lime, juiced",
    "3 tablespoons white vinegar",
    "2 cloves garlic, minced",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon ground white pepper",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon smoked paprika",
    "1.5 pounds beef flank steak, trimmed of excess fat",
    "1 medium ripe mango, diced",
    "1 avocado, chopped",
    "1 medium lime, juiced",
    "1 fresh jalapeno pepper, seeded and diced",
    "0.25 cup chopped red onion",
    "0.25 cup chopped fresh cilantro",
    "1 (12 ounce) package tortillas"
  ],
  "steps": [
    {
      "text": "Combine soy sauce, olive oil, lime juice, vinegar, garlic, salt, black pepper, white pepper, garlic powder, oregano, cayenne pepper, cumin, and paprika in a container. Place flank steak in the marinade and refrigerate for 8 to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mango, avocado, lime juice, jalapeno, red onion, and cilantro together to make the salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack at least 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove flank steak from marinade and pat dry with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil flank steak on high, flipping at the halfway mark, until steaks are beginning to firm and are hot and slightly pink in the center, about 18 minutes. An instant-read thermometer inserted into the center should read at least 130 degrees F (54 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut flank steak into small cubes. Wrap 8 tortillas in a paper towel and heat in the microwave until soft, 20 to 30 seconds. Serve steak on tortillas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
