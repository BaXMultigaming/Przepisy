  "ingredients": [
    "1 (14 ounce) can sweetened condensed milk",
    "2 teaspoons vanilla extract",
    "0.5 cup frozen strawberries, partially thawed",
    "10 cups clean fresh snow",
    "0.25 cup milk, or as needed"
  ],
  "steps": [
    {
      "text": "Stir the sweetened condensed milk and vanilla extract together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the strawberries into a blender, and puree until almost smooth. Mix the strawberries into the condensed milk mixture until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With a large spoon, gently mix in the snow, about 1 cup at a time. Mix in the milk, 2 tablespoons at a time, until the snow ice cream is soft and holds its shape when spooned. Serve immediately; store leftover ice cream in an airtight container in the freezer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
