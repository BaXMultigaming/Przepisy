  "ingredients": [
    "4 cups old-fashioned oats",
    "1.5 cups chopped pecans",
    "1.5 cups slivered almonds",
    "1 cup coconut flakes",
    "0.5 cup vegetable oil",
    "0.33333334326744 cup packed brown sugar",
    "0.33333334326744 cup honey",
    "0.25 cup maple syrup",
    "2 teaspoons ground cinnamon",
    "2 teaspoons vanilla extract",
    "0.75 teaspoon salt",
    "2 cups dried cranberries"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 325 degrees F (165 degrees C). Line a large, rimmed baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gnwUufDQNQoqDOQMfQYpqKvDlYk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275749-grandmas-homemade-granola-DDMFS-014-4x3-step-01-04f25c4a06f7429db8c47a6c858df904.jpg"
      ],
      "image": "assets/images/275749/step_01.webp"
    },
    {
      "text": "Mix oats, pecans, almonds, and coconut together in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PL1EqrJbgd2U1n7ktR0B0q6mmGg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275749-grandmas-homemade-granola-DDMFS-015-4x3-step-02-12c526c9db8d446daab4e6f090a70c1e.jpg"
      ],
      "image": "assets/images/275749/step_02.webp"
    },
    {
      "text": "Combine oil, brown sugar, honey, maple syrup, cinnamon, vanilla, and salt in a medium saucepan over medium heat. Stir gently until mixture begins to boil; remove from heat. Pour over oat mixture and fold together until dry ingredients are well coated. Spread granola on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EM2MJQyfuP7iELRwyVcBxeBJJDE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275749-grandmas-homemade-granola-DDMFS-016-4x3-step-03-dc944c6f87a243ee9981896b05fb98fd.jpg"
      ],
      "image": "assets/images/275749/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Stir and continue to bake on the top rack until golden, about 5 minutes more. Remove from the oven and let cool for 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NZLu8LCimPUmS4goY3B7CiOGVKs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275749-grandmas-homemade-granola-DDMFS-034-4x3-step-04-417fe1e208a3426f9a6a4730b1593caa.jpg"
      ],
      "image": "assets/images/275749/step_04.webp"
    },
    {
      "text": "Toss cooled granola with cranberries. Store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XoLa-X10k6WT9oufy-AkUStjp3Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275749-grandmas-homemade-granola-DDMFS-036-4x3-step-05-b42f8d86c9d2433684a7e0ce56b3c5a3.jpg"
      ],
      "image": "assets/images/275749/step_05.webp"
    }
