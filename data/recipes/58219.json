  "ingredients": [
    "2 quarts cranberry juice cocktail",
    "3 cups orange juice",
    "0.25 cup white sugar",
    "0.25 cup brown sugar",
    "2 tablespoons fresh lemon juice",
    "1 pinch salt",
    "2 (3 inch) cinnamon sticks"
  ],
  "steps": [
    {
      "text": "In a 4 quart or larger slow cooker, combine the cranberry juice, orange juice, white sugar, brown sugar, lemon juice, salt and cinnamon sticks. Stir to dissolve sugar. Cook on High for 4 to 6 hours. Turn heat to Low and keep warm for serving.",
