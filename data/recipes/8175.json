  "ingredients": [
    "1 pound light brown sugar",
    "1 cup heavy whipping cream",
    "0.5 teaspoon baking soda",
    "0.5 cup butter",
    "0.25 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "In a medium, heavy saucepan, bring the brown sugar and cream to a rolling boil; boil 1 minute. Add baking soda; boil 1 more minute. Remove from heat. Add butter, but do not stir yet. Let the mixture cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat well. Stir in pecans if desired.",
