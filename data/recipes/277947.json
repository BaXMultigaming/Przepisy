  "ingredients": [
    "1 tablespoon olive oil, or as needed",
    "2 pounds uncooked medium shrimp, peeled and deveined",
    "1 (6 ounce) can tomato paste",
    "1.5 teaspoons chili powder",
    "1 teaspoon dried basil",
    "1 teaspoon garlic powder",
    "1 teaspoon salt",
    "0.5 large lemon, juiced",
    "1 cup chopped cilantro"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a glass or ceramic baking dish with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix shrimp, tomato paste, chili powder, basil, garlic powder, and salt. Add lemon juice and mix well. Add cilantro; mix well. Pour into the prepared baking dish and cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until shrimp are bright pink, 20 to 25 minutes; don't overcook, the shrimp will get hard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
