  "ingredients": [
    "1.5 pounds ground beef",
    "1 egg, beaten",
    "0.5 cup panko bread crumbs",
    "0.25 cup finely chopped onion",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 (14 ounce) can beef consomme"
  ],
  "steps": [
    {
      "text": "Combine ground beef, egg, panko bread crumbs, onion, and 1/4 cup cream of mushroom soup in a large bowl. Divide beef mixture evenly into 6 portions; shape each portion into a 1/2-inch-thick patty.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large nonstick skillet over medium-heat. Cook the burgers until browned, 3 to 4 minutes on each side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together remaining cream of mushroom soup and beef consommé in a bowl until smooth. Pour mixture over patties, then reduce heat to low. Simmer until patties are no longer pink in the center, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
