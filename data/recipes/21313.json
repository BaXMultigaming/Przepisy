  "ingredients": [
    "1 (14 ounce) can sweetened condensed milk",
    "1.5 cups cold water",
    "1 (3.4 ounce) package instant vanilla pudding mix",
    "2 cups heavy cream",
    "3 bananas, sliced",
    "0.5 cup lemon juice",
    "36 vanilla wafers"
  ],
  "steps": [
    {
      "text": "Stir condensed milk and water together in a medium bowl; beat in pudding mix until smooth. Chill mixture in the refrigerator for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip cream in a separate bowl until stiff peaks form. Fold whipped cream into chilled pudding mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip sliced bananas in lemon juice. Shake off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon 1 cup of the pudding mixture into a 2 ½ quart serving bowl. Top with 1/3 each of the wafers, bananas, and remaining pudding. Repeat layers twice. Chill until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
