  "ingredients": [
    "10 cups water",
    "7 ounces pearl sago, rinsed and drained",
    "7 ounces palm sugar",
    "0.5 cup water",
    "2 cups canned coconut milk"
  ],
  "steps": [
    {
      "text": "Bring 10 cups water to a boil in a large pot. Gradually stir in sago so it does not clump. Return to a boil, then reduce heat to low; cook until sago turns translucent, stirring occasionally, about 30 minutes. Pour sago into jelly molds, and refrigerate 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine palm sugar and 1/2 cup water in a small saucepan. Bring to a boil; cook until sugar has dissolved. Strain through a fine-mesh sieve to remove grit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unmold puddings; serve with coconut milk and palm sugar syrup (gula melaka).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
