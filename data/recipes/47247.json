  "ingredients": [
    "cooking spray",
    "2 (7 ounce) cans whole green chile peppers, drained",
    "8 ounces Monterey Jack cheese, shredded",
    "8 ounces Longhorn or Cheddar cheese, shredded",
    "2 large eggs",
    "1 (5 ounce) can evaporated milk",
    "2 tablespoons all-purpose flour",
    "0.5 cup milk",
    "1 (8 ounce) can tomato sauce"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bjl6fv0Arm5yxXmq4i0deuKhA2k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47247-chili-rellenos-casserole-DDMFS-step-01-d6dcd7b735dd4f2094c07b7017a52304.jpg"
      ],
      "image": "assets/images/47247/step_01.webp"
    },
    {
      "text": "Evenly layer poblano peppers from 1 can in the bottom of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PItacXqCkGKi9JuXRQoD_BW-K38=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47247-chili-rellenos-casserole-DDMFS-step-02-80dfb94d43ef4a8ca064eb2d03cd816f.jpg"
      ],
      "image": "assets/images/47247/step_02.webp"
    },
    {
      "text": "Sprinkle with 1/2 of the Jack and Cheddar cheeses, then cover with remaining poblano peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jzNYFmLkMztX6QhFxO9SzfsZyWw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47247-chili-rellenos-casserole-DDMFS-step-03-28e43914c6c14063bb6154e959079537.jpg"
      ],
      "image": "assets/images/47247/step_03.webp"
    },
    {
      "text": "Mix eggs, evaporated milk, and flour together in a bowl; if mixture is too thick, you can add 1/2 cup milk to thin to desired consistency. Pour over chiles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z73df6m3-e37EVWOaWEerqDibmI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47247-chili-rellenos-casserole-DDMFS-step-04-a6a43920bc0347968220c7d45aca9e6b.jpg"
      ],
      "image": "assets/images/47247/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 25 minutes. Pour enchilada sauce evenly over the top; continue baking for 15 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8irZ5NbglTHbsKvrRzeJirsnPL0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47247-chili-rellenos-casserole-DDMFS-step-05-13fccfbf4d3541819b0aba5bf153c842.jpg"
      ],
      "image": "assets/images/47247/step_05.webp"
    },
    {
      "text": "Turn broiler on. Sprinkle top with remaining Jack and Cheddar cheeses. Place under the broiler until cheese is melted, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_3bs2YIfIHqNWEcoBz2bGErS7t4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47247-chili-rellenos-casserole-DDMFS-step-06-778cda1913f3460f8a061bdd6138fbda.jpg"
      ],
      "image": "assets/images/47247/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v_N52hbWsEZwkrDdZS2tTxBsgGE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47247-chili-rellenos-casserole-DDMFS-Beauty-4x3-33833ebd9a154d3bb371337ae3a824cf.jpg"
      ],
