  "ingredients": [
    "2 cups shredded Cheddar cheese",
    "1 (10.75 ounce) can cream of potato soup",
    "1 (8 ounce) container sour cream",
    "0.5 (8 ounce) package cream cheese, softened, or more as needed",
    "0.5 cup chopped green onions",
    "2 cloves garlic, minced",
    "0.5 teaspoon salt, or to taste",
    "1 (16 ounce) package frozen hash brown potatoes",
    "0.5 cup grated Parmesan cheese, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Cheddar cheese, potato soup, sour cream, cream cheese, green onions, garlic, and salt together in a large bowl. Fold potatoes into mixture; pour into the prepared casserole dish. Top with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling and cheese is golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
