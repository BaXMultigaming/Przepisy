  "ingredients": [
    "4 tablespoons olive oil",
    "1 onion, chopped",
    "2 cloves garlic, minced",
    "2 pounds veal, trimmed and cubed",
    "1 (8 ounce) can tomato sauce",
    "0.5 cup white wine",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large pot over medium heat. Cook and stir onion and garlic in hot oil until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add veal to onion and garlic in the pot. Cook and stir until veal is evenly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomato sauce and white wine; bring to a boil. Season with salt and pepper. Reduce heat to low, cover, and simmer until veal is tender, about 1 hour 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
