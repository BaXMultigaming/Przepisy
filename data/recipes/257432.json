  "ingredients": [
    "0.75 cup slivered almonds",
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "0.75 cup whole milk yogurt",
    "2 eggs",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "1 cup chopped dates"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 6-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread almonds on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast almonds in the preheated oven until golden brown and fragrant, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and butter in a large bowl; beat with an electric mixer until creamy. Beat in yogurt and eggs until well combined. Mix in flour, baking soda, nutmeg, and salt until incorporated. Fold in 1/2 cup toasted almonds and dates.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared pan. Top with remaining 1/4 cup toasted almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
