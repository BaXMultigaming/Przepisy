  "ingredients": [
    "0.66666668653488 cup shortening",
    "1.6666667461395 cups white sugar",
    "3 eggs",
    "1.75 cups all-purpose flour",
    "0.66666668653488 cup unsweetened cocoa powder",
    "1 cup sourdough starter",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "1 teaspoon salt",
    "0.75 cup cold water",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, cocoa, baking soda, baking powder, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream shortening, sugar, and eggs together in a large bowl. Blend in sourdough starter. Add flour mixture slowly to creamed mixture, beating until smooth. Stir in water and vanilla; mix well. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
