  "ingredients": [
    "5.5 cups mixed frozen berries",
    "0.25 cup white sugar",
    "2 tablespoons cornstarch",
    "2 cups brown sugar",
    "0.75 cup unsalted butter, melted",
    "1 tablespoon vanilla extract",
    "0.5 cup all-purpose flour",
    "1 teaspoon ground cinnamon",
    "2 cups rolled oats"
  ],
  "steps": [
    {
      "text": "Mix berries, white sugar, and cornstarch together lightly. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream brown sugar, butter, and vanilla extract together in a separate bowl. Mix in flour and cinnamon. Stir in oats just until mixed. Chill topping for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place berries in the bottom of a 9x9-inch baking pan. Place chilled topping on berries, pressing lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
