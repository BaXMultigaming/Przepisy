  "ingredients": [
    "2 pie crust pastries",
    "1 cup frozen blueberries",
    "0.5 cup white sugar",
    "1 teaspoon ground cinnamon",
    "1 egg, beaten",
    "0.25 cup turbinado sugar (such as Sugar in the Raw®)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pie crust pastries onto a flat surface and cut rounds from the dough using a 5-inch round cutter. Spoon 1 tablespoon blueberries into the center of each round; sprinkle 1/4 teaspoon sugar over each portion of blueberries. Dust blueberries with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold dough over the filling and seal edges by pressing with a fork. Arrange pies onto a baking sheet. Brush tops of hand pies with beaten egg. Sprinkle turbinado sugar over the pies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until browned, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
