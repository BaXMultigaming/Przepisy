  "ingredients": [
    "7 (1 ounce) squares semisweet chocolate, chopped",
    "1 (1 ounce) square unsweetened chocolate, chopped",
    "3 tablespoons butter, softened",
    "3 eggs",
    "1 cup white sugar",
    "0.75 cup all-purpose flour",
    "0.5 teaspoon baking powder",
    "1 cup semisweet chocolate chips",
    "0.75 cup chopped walnuts",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the chocolate squares and butter or margarine in a double boiler. Stir well and remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and eggs in medium sized bowl until thick and creamy. Mix in vanilla and melted chocolate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in the flour, baking powder and salt until well blended. Stir in chocolate chips and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoonfuls about 1 1/2 inches apart on cookie sheet. Bake for 8 minutes or until tops crackle and look shiny. Cool 3 to 5 minutes. Remove to racks; cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
