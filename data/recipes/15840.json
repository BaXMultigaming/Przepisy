  "ingredients": [
    "0.5 teaspoon olive oil",
    "2 skinless, boneless chicken breasts, cut into cubes",
    "0.5 teaspoon minced garlic",
    "0.25 teaspoon ground cumin",
    "2 (14.5 ounce) cans chicken broth",
    "1 cup frozen corn kernels",
    "1 cup chopped onion",
    "1 cup chunky salsa",
    "1 tablespoon lemon juice",
    "0.5 teaspoon chili powder",
    "8 ounces corn tortilla chips",
    "0.5 cup shredded Monterey Jack cheese",
    "sour cream"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large pot over medium heat. Cook and stir chicken in hot oil until browned, about 5 minutes. Mix in garlic and cumin. Add broth, corn, onion, salsa, lemon juice, and chili powder; bring to a boil. Reduce heat to low and simmer soup for 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Break up tortilla chips into individual bowls; ladle soup over chips. Top each with Monterey Jack cheese and a dollop of sour cream.",
