  "ingredients": [
    "3 tablespoons salted butter",
    "3 tablespoons all-purpose flour",
    "0.5 cup chicken stock",
    "0.5 cup milk",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a small saucepan over medium heat. Rapidly whisk in flour until thick, about 2 minutes.",
