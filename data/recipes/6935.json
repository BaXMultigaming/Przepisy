  "title": "Cherry Spice Loaf",
  "description": "This is a sweet, fruity quick bread, made with almond extract, dates, cherries and raisins.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-08-30T12:04:23-04:00",
