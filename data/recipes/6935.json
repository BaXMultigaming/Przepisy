  "keywords": [],
  "ingredients": [
    "2 eggs",
    "1 cup white sugar",
    "0.5 cup vegetable oil",
    "0.75 cup milk",
    "0.5 teaspoon almond extract",
    "2 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup dates, pitted and chopped",
    "0.5 cup candied cherries",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 9x5x3 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs slightly. Beat in sugar and oil. Slowly add milk and almond flavoring.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In second bowl put flour, baking powder, soda, and salt. Stir in dates, cherries, raisins, and nuts. Pour into batter, stirring only to moisten. Spoon into greased 9x5x3 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour in 350 degree F (175 degree C) oven until a toothpick inserted in the center comes out clean. After 10 minutes turn loaf out to cool on a rack. Store in plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
