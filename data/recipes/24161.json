  "ingredients": [
    "1 pound ground pork",
    "8 ounces lean ground beef",
    "2 teaspoons minced garlic",
    "1 tablespoon salt",
    "1 tablespoon brown sugar",
    "1 teaspoon freshly ground black pepper",
    "1 teaspoon fresh marjoram",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon liquid smoke flavoring",
    "12 sausage casings"
  ],
  "steps": [
    {
      "text": "In a large bowl, combine pork, beef, and garlic. In another bowl, stir together salt, brown sugar, pepper, marjoram, allspice, and liquid smoke. Combine mixtures and knead with your hands until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill casings with meat mixture and refrigerate, 8 hours to overnight. Boil or grill before serving. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
