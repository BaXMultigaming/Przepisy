  "ingredients": [
    "6 slices white bread",
    "2 (5 ounce) cans tuna, drained",
    "0.25 cup mayonnaise, or to taste",
    "1 tablespoon lemon juice",
    "1 tablespoon finely chopped lemon zest",
    "1 tablespoon finely chopped fresh dill",
    "1 large tomato, thinly sliced",
    "6 slices Swiss cheese"
  ],
  "steps": [
    {
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler. Arrange bread in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast bread lightly on both sides in preheated oven, about 1 minute per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix tuna, mayonnaise, lemon juice, lemon zest, and dill in a bowl. Spread tuna mixture evenly over each slice of bread. Arrange tomato slices over tuna mixture and top with Swiss cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return baking sheet to oven and broil until cheese is melted, 3 to 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
