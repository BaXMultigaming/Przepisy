  "ingredients": [
    "1 (16 ounce) package jumbo pasta shells",
    "4 cups large curd cottage cheese",
    "12 ounces mozzarella cheese, shredded",
    "0.75 cup grated Parmesan cheese, divided",
    "2 large eggs, lightly beaten",
    "1 pinch garlic powder",
    "1 teaspoon dried oregano",
    "1 teaspoon dried parsley",
    "1 (26 ounce) jar spaghetti sauce"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F5HcgNt1F8F8KGGR1tSnGElvRcw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11836-stuffed-shells-ddmfs-4x3-step1-0016-c27664744fb3431c9798da9e9c90da30.jpg"
      ],
      "image": "assets/images/11836/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of salted water to a boil. Add shells and cook, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain, rinse under cold water, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cottage cheese, mozzarella cheese, 1/2 cup Parmesan cheese, eggs, and garlic powder in a large bowl. Rub oregano and parsley between your palms to pulverize them, then stir into cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stuff cheese mixture into pasta shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/edL_SmUCGeCngDNEbWWDHR7u1r4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11836-stuffed-shells-ddmfs-4x3-step2-0020-df75f960c7c546d9b3c4a76221632b0d.jpg"
      ],
      "image": "assets/images/11836/step_05.webp"
    },
    {
      "text": "Spread 1/3 of the spaghetti sauce on the bottom of a 15x10-inch baking dish. Place shells, seam-side up, close together in the dish. Spread remaining sauce on top; sprinkle with remaining 1/4 cup Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jOrSpJUhZ4Sb1pJAM2DTljnheM0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11836-stuffed-shells-ddmfs-4x3-step3-0021-362e7b5859f24b5ea15781c3c1396529.jpg"
      ],
      "image": "assets/images/11836/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until bubbly, 25 to 35 minutes. Let stand 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hKzqDF8zcSnK4LiXHJUk0mEOqoc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11836-stuffed-shells-i-DDMFS-4x3-7a8a77e2eb1e4e3586786dd3391adb23.jpg"
      ],
      "image": "assets/images/11836/step_07.webp"
    }
