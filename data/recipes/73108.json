  "ingredients": [
    "2 cups water",
    "2 cubes chicken bouillon",
    "0.5 cup butter",
    "1 tablespoon dried Italian seasoning",
    "0.5 teaspoon dried dill weed",
    "1 teaspoon garlic salt, or to taste",
    "4 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Pour water into a microwave-safe casserole dish and place it in the microwave. Heat until boiling, about 2 minutes. Stir in bouillon cubes, butter, Italian seasoning, dill, and garlic salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pierce chicken breasts with a fork on one side; place pierced-side down in the casserole dish. Chicken should be almost covered by liquid, if not completely covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the dish; cook in the microwave for 10 minutes, or until chicken is no longer pink, and juices run clear. If chicken is not done after 10 minutes, continue to cook at 1 1/2 minute intervals.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
