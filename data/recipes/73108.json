  "title": "Moist Garlic Chicken",
  "description": "Chicken breasts are cooked in stock with butter, garlic salt, and herbs in this quick and easy microwave recipe for tender, moist garlic chicken.",
  "authors": [
    "MINDERK"
  ],
  "date_published": "2019-04-03T23:32:34-04:00",
