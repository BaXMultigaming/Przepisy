  "ingredients": [
    "nonstick cooking spray",
    "5 eggs",
    "1 cup white sugar",
    "2 teaspoons vanilla extract",
    "1 teaspoon ground cinnamon",
    "2 (16 ounce) containers ricotta cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x13-inch baking dish with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together eggs, sugar, vanilla, and cinnamon in a large bowl until smooth. Add ricotta cheese and mix until well combined. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, about 1 hour. Cool for 10 minutes before serving.",
      "section": null,
