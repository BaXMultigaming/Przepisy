  "ingredients": [
    "2 pounds ground beef or chuck",
    "1 (28 ounce) can whole peeled tomatoes",
    "2 green bell peppers, chopped",
    "1 cup water",
    "1 (8 ounce) can tomato sauce",
    "2 onions, chopped",
    "1 cup uncooked converted rice",
    "2.5 teaspoons salt",
    "2.5 teaspoons chili powder",
    "2 teaspoons Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Place ground beef in a large skillet. Cook and stir over medium-high heat until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Transfer beef to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tomatoes, green pepper, water, tomato sauce, onions, rice, salt, chili powder, and Worcestershire sauce in the slow cooker. Stir thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook until rice is tender, on Low for 6 to 8 hours or High for 3 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
