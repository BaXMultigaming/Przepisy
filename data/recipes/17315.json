  "ingredients": [
    "2 pounds ricotta cheese",
    "6 large eggs",
    "1 pound cooked ham, chopped",
    "0.5 pound Genoa salami, chopped",
    "0.5 pound mozzarella cheese, grated",
    "0.25 pound prosciutto, chopped",
    "4 (9 inch) unbaked pie crusts",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ricotta in a large mixing bowl. Beat in eggs, one at a time, with an electric mixer on low speed. Stir in ham, salami, mozzarella, and prosciutto until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line the bottom and sides of two 9-inch pans with pie crusts. Divide ricotta mixture between the pans. Sprinkle each pie with Parmesan cheese, then cover filling with remaining pie crusts. Crimp the edges and cut several slits in the top crust to allow steam to escape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden brown, about 1 hour. Cool pies on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
