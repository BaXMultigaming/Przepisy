  "ingredients": [
    "1 (12 ounce) package frozen cauliflower rice",
    "2 large eggs",
    "2 slices nopales (fresh cactus leaves)",
    "0.25 cup chopped green onions",
    "2 tablespoons soy sauce"
  ],
  "steps": [
    {
      "text": "Cook cauliflower rice in its bag in the microwave for 5 to 6 minutes. Let stand for 1 minute before carefully opening the bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C). Cover the bottom and 1/2 inch up the sides of the air fryer basket with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cauliflower rice, eggs, nopales, green onions, and soy sauce in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 5 minutes. Remove the basket and stir cauliflower mixture. Return to the air fryer and cook for 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
