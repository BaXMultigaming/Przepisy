  "ingredients": [
    "1 (16 ounce) package edamame in pod, shelled",
    "1 (15 ounce) can black beans, drained",
    "0.25 cup vegetable broth",
    "0.25 cup ricotta cheese",
    "2 egg whites",
    "4 cloves garlic",
    "0.5 cup wheat bran",
    "0.5 cup quick-cooking oats",
    "1 teaspoon ground turmeric",
    "0.5 teaspoon chili powder",
    "0.5 teaspoon ground cloves",
    "1 pinch dried oregano",
    "1 pinch dried basil",
    "1 pinch Italian seasoning",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend shelled edamame, black beans, vegetable broth, ricotta cheese, egg whites, and garlic in a blender or food processor until smooth; transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir wheat bran, oats, turmeric, chili powder, cloves, oregano, basil, Italian seasoning, and salt into bean mixture; form into 7 patties and place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes; flip and continue baking until patties are lightly browned and cooked through, about 20 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
