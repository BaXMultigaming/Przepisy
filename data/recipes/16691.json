  "ingredients": [
    "1 (6 ounce) package herb-seasoned dry bread stuffing mix",
    "0.5 cup butter",
    "1 teaspoon dried sage",
    "1 (4 pound) whole chicken, deboned and cut into bite size pieces",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1 (10.75 ounce) can condensed cream of celery soup",
    "2.5 cups water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter, stuffing mix, and sage in a medium bowl until combined; spread mixture on the bottom of a 9x13-inch baking dish. Spread cooked chicken over mixture. Combine cream of chicken soup, cream of celery soup, and water until blended; pour over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling and golden on top, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
