  "ingredients": [
    "1 cup all-purpose flour",
    "0.66666668653488 cup water",
    "4 cups chopped cabbage",
    "6 strips cooked bacon, crumbled",
    "2 eggs",
    "1 sausage, diced, or more to taste",
    "0.5 cup chopped green onions",
    "0.25 cup cooked shrimp",
    "0.25 cup shredded cheese",
    "0.25 cup tenkasu (tempura pearls)",
    "1 tablespoon vegetable oil, or to taste",
    "2 tablespoons soy sauce",
    "1 tablespoon ketchup",
    "1 teaspoon white vinegar",
    "1 tablespoon panko bread crumbs, or to taste",
    "1 teaspoon mayonnaise, or to taste"
  ],
  "steps": [
    {
      "text": "Mix flour and water together in a bowl until smooth. Stir in cabbage, bacon, eggs, sausage, green onions, shrimp, cheese, and tenkasu.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a griddle to 400 degrees F (200 degrees C) and coat with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/4 of batter onto preheated griddle. Cook until golden brown, about 6 minutes per side. Transfer to a serving plate. Repeat to make a total of 4 pancakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make sauce: Mix soy sauce, ketchup, and vinegar together in a small bowl. Drizzle over pancakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with panko and mayonnaise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
