  "ingredients": [
    "2 cups uncooked elbow macaroni",
    "1 (6 ounce) can water-packed tuna, drained and flaked",
    "0.66666668653488 cup chopped yellow bell pepper",
    "0.66666668653488 cup chopped celery",
    "0.5 cup shredded carrot",
    "0.25 cup sliced radishes",
    "2 green onions, chopped",
    "2 tablespoons minced fresh parsley",
    "0.75 cup mayonnaise",
    "0.5 cup ranch dressing",
    "0.25 cup grated Parmesan cheese",
    "1.5 teaspoons ground black pepper",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine tuna, bell pepper, celery, carrot, radishes, green onions, and parsley in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain macaroni and rinse in cold water. Drain again and add to the bowl with the tuna mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise, ranch dressing, Parmesan cheese, black pepper, and salt in a small bowl. Pour dressing over salad and toss to coat. Refrigerate at least 2 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
