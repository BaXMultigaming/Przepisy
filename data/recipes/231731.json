  "ingredients": [
    "3 cups quick cooking oats",
    "1 cup sweetened flaked coconut",
    "2 cups white sugar",
    "0.5 cup unsweetened cocoa powder",
    "0.5 cup milk",
    "0.5 cup margarine"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats and coconut in a large bowl until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, cocoa powder, milk, and butter together in a saucepan over medium heat until smooth. Bring to a boil and cook, stirring constantly, for 2 minutes. Pour over oats and coconut; mix quickly to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
