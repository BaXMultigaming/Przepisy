  "ingredients": [
    "2 slices raisin bread",
    "peanut butter",
    "0.5 banana, sliced",
    "2 tablespoons chocolate chips, or to taste",
    "0.25 cup ricotta cheese",
    "1 tablespoon white sugar",
    "1 dash ground cinnamon"
  ],
  "steps": [
    {
      "text": "Toast raisin bread in a toaster oven until lightly brown, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread peanut butter onto toasted bread. Top 1 slice with banana; top other slice with chocolate chips. Cover banana and chocolate chips with ricotta cheese. Sprinkle sugar and cinnamon on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast in the toaster oven just until cheese is melted, 3 to 5 minutes. Sandwich slices together.",
      "section": null,
