  "ingredients": [
    "0.5 cup mayonnaise",
    "1 clove garlic, minced",
    "2 teaspoons lemon juice",
    "1 teaspoon lemon zest",
    "0.25 teaspoon kosher salt",
    "0.25 teaspoon ground black pepper",
    "2 (14 ounce) cans whole artichoke hearts, well-drained",
    "0.5 cup all-purpose flour",
    "0.5 cup water",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon kosher salt",
    "1 cup seasoned panko bread crumbs",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon ground paprika",
    "olive oil cooking spray"
  ],
  "steps": [
    {
      "text": "Mix mayonnaise, garlic, lemon juice, lemon zest, salt, and pepper together in a small bowl until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay artichoke hearts in a single layer on a paper towel-lined plate. Pat dry with more paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, water, baking powder, and salt together in a shallow dish until well combined. Mix bread crumbs, garlic powder, and paprika together in a separate shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip an artichoke heart in the flour mixture until lightly coated; allow any excess to drip off. Coat in bread crumbs, then set aside on a plate. Repeat the breading process with remaining artichoke hearts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly spray ½ of the breaded artichoke hearts with cooking spray. Place 1 inch apart in a single layer in the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry until golden and crisp, about 7 minutes, turning halfway through. Repeat to cook remaining batch.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let stand 5 minutes after cooking to cool slightly. Serve with lemony mayo.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
