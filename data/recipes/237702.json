  "ingredients": [
    "1 small watermelon, cut into 1-inch pieces",
    "1 cup cachaca (Brazilian sugar cane spirit)",
    "2 tablespoons turbinado sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Place watermelon in a non-reactive container with a tight-fitting lid. Add cachaca and sugar. Cover container with the lid and shake until watermelon is coated and sugar is dissolved.",
