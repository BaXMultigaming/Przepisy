  "ingredients": [
    "1.3333333730698 cups vegetable oil",
    "2 cups white sugar",
    "4 eggs, whisked",
    "5 cups mashed bananas",
    "1 tablespoon lemon juice",
    "4 cups all-purpose flour",
    "2 tablespoons baking powder",
    "1 teaspoon salt",
    "2 cups chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat vegetable oil and sugar together in a bowl until creamy and smooth; stir in eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash bananas and lemon juice together in a separate bowl; mix into oil mixture until just incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and salt together in a third bowl. Slowly mix into the wet mixture using an electric mixer on low until just incorporated; do not overmix. Fold in walnuts. Pour batter into the two prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the loaf comes out somewhat clean, about 1 hour 15 minutes. If the toothpick comes out clean, you have overcooked the bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
