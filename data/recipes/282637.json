  "ingredients": [
    "1 pound peeled and cubed butternut squash",
    "1 pound pork sausage, sliced",
    "0.5 pound peeled and sliced carrots",
    "3 cups shredded red cabbage",
    "1 cup sliced onion",
    "3 tablespoons minced garlic",
    "2 tablespoons vegetable oil",
    "1 tablespoon salt",
    "2 teaspoons ground black pepper",
    "1 teaspoon herbes de Provence"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a roasting pan or large baking dish with aluminum foil.",
