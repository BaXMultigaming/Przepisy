  "ingredients": [
    "1 cup sifted cake flour",
    "1 cup egg whites",
    "1 teaspoon cream of tartar",
    "0.25 teaspoon salt",
    "1.25 cups white sugar",
    "0.75 teaspoon vanilla extract",
    "0.25 teaspoon almond extract",
    "0.33300000429153 cup maraschino cherries, drained and sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Sift flour three times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites, cream of tartar, and salt in a large glass or metal mixing bowl until foamy. Gradually add sugar, continuing to beat until stiff peaks form. Blend in vanilla and almond extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold sifted flour into egg white mixture until no streaks remain. Pour 1/2 of the batter into a clean, dry 10-inch tube pan, and arrange 1/2 of the cherries overtop. Repeat once more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 50 minutes. Cool cake in the pan, inverted onto a wire rack, empty wine bottle, or thin-necked glass bottle; this will prevent the cake from sinking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
