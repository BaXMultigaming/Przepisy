  "ingredients": [
    "2 cups all-purpose flour",
    "4 large eggs",
    "2 cups milk",
    "0.25 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and eggs together in a large bowl. Whisk in flour, 1 cup at a time, until smooth and well blended. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bhFljDJRGJNCkngl1Rb_3pjUuhM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/95339-sky-high-yorkshire-pudding-VAT-step-02-1b89fdeba50e47839995cbbbd2449fa7.jpg"
      ],
      "image": "assets/images/95339/step_02.webp"
    },
    {
      "text": "Place 1 teaspoon oil into each cup of a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5iaoRgq5LHXoV3zRL9Nf5hcMHf8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/95339-sky-high-yorkshire-pudding-VAT-step-03-88fd217820cc424abd85c8b662af4706.jpg"
      ],
      "image": "assets/images/95339/step_03.webp"
    },
    {
      "text": "Place the tin in the preheated oven until oil is smoking, 5 to 10 minutes. Remove from the oven and working quickly so the oil stays hot, ladle about 1/4 cup batter into each cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1lu2IiI4bLl1gKW45OWMc8w-Ct4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/95339-sky-high-yorkshire-pudding-VAT-step-04-e1fc357fcb694c7dbed83ecfae0b2541.jpg"
      ],
      "image": "assets/images/95339/step_04.webp"
    },
    {
      "text": "Return to the oven and bake for 30 to 35 minutes until puddings have risen and are golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q1A7Q8rCqoKs3IF6GHUWE2Lnx44=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/95339-sky-high-yorkshire-pudding-VAT-step-05-ed3fdd56af524ba99cfb15e2b577e5a3.jpg"
      ],
      "image": "assets/images/95339/step_05.webp"
    },
    {
      "text": "Serve immediately and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KyTTJlZzjP4uOessl-d9Ju_-RcQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/95339-sky-high-yorkshire-pudding-VAT-Beauty-4x3-0c632be9eca646b3a27cae6a12f917f0.jpg"
