  "ingredients": [
    "2 tablespoons vegetable oil",
    "1 pound boneless, skinless chicken breasts, cut in 3/4-inch pieces",
    "2 large red or yellow bell peppers, chopped",
    "1.25 cups chopped red onion",
    "2 cups bean sprouts",
    "1 cup snow peas, cut in 3/4-inch pieces",
    "2 tablespoons water",
    "2 tablespoons light soy sauce",
    "2 tablespoons fish sauce",
    "2 (8.8 ounce) pouches UNCLE BEN'S® READY RICE® - Whole Grain Brown",
    "2 tablespoons sesame seeds"
  ],
  "steps": [
    {
      "text": "In large nonstick skillet, heat oil over medium-high heat. Cook and stir chicken, peppers, and onion 4 to 5 minutes or until vegetables soften and chicken is no longer pink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in bean sprouts and pea pods; cook 1 minute. Stir in water, soy sauce, and fish sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile heat rice as directed on package. Stir into chicken mixture, heating about 2 minutes until thoroughly combined. Garnish with sesame seed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
