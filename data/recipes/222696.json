  "ingredients": [
    "2 pounds ground beef",
    "1 cup quick cooking oats",
    "1 onion, chopped",
    "0.5 cup milk",
    "2 eggs",
    "0.25 cup ketchup",
    "0.25 cup chopped fresh parsley",
    "1 clove garlic, minced",
    "1 teaspoon salt",
    "0.5 teaspoon dried basil",
    "0.25 teaspoon ground black pepper",
    "2 tablespoons ketchup",
    "4 slices Cheddar cheese, halved"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef, quick oats, onion, milk, eggs, 1/4 cup ketchup, parsley, garlic, salt, basil, and black pepper together in a large bowl until thoroughly combined; pat the mixture into a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake meatloaf in the preheated oven until firm and no longer pink inside, 1 to 1 1/4 hours. An instant-read meat thermometer inserted into the center of the meatloaf should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven, spread 2 tablespoons ketchup over loaf, and top with Cheddar cheese slices; return to oven and bake until cheese has melted, about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
