  "ingredients": [
    "2 pounds haddock fillets",
    "1 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "3 tablespoons butter",
    "0.25 cup minced onion",
    "3 tablespoons all-purpose flour",
    "1 teaspoon ground dry mustard",
    "0.5 teaspoon salt",
    "0.66666698455811 cup heavy cream",
    "0.66666698455811 cup half-and-half cream",
    "0.5 cup shredded sharp Cheddar cheese",
    "0.5 cup shredded Monterey Jack cheese",
    "0.25 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly butter a medium or large baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse and dry fillets. Season with 1 teaspoon salt and 1/8 teaspoon pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a skillet or frying pan, melt butter over medium heat. Saute onion in butter until golden. Stir in flour until completely incorporated. Stir in mustard, 1/2 teaspoon salt, light and heavy creams. Cook until thickened, stirring constantly. Remove from heat and stir in cheeses. Pour sauce over fish and sprinkle with paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes, until brown and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
