  "ingredients": [
    "1.25 cups oatmeal",
    "0.5 cup sweetened flaked coconut",
    "1 cup flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup butter, softened",
    "0.5 cup light brown sugar",
    "0.5 cup white sugar",
    "1 egg, at room temperature",
    "0.5 teaspoon vanilla extract",
    "0.5 cup white chocolate chips",
    "3 ounces macadamia nuts, coarsely chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place oatmeal in a blender and process into a fine powder. Transfer to a large bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place coconut in the blender and process until finely chopped. Add to the bowl with the oatmeal. Add flour, baking powder, baking soda, and salt to the bowl; mix well and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, brown sugar, and white sugar together in a bowl. Add egg and vanilla extract. Add butter mixture to the bowl with the flour mixture and mix well. Stir in white chocolate chips and macadamia nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll heaping tablespoons of dough into balls and place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges start to brown lightly, 12 to 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
