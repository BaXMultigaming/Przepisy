  "ingredients": [
    "1 sheet all-butter shortcrust pastry",
    "5 tablespoons semolina flour",
    "1.25 pounds plums, halved and pitted",
    "0.5 cup dark brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll pastry out onto a flat work surface. Line a tart tin with the pastry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Leave oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle semolina evenly over the pastry. Place plum halves on top in a circular pattern. Sprinkle brown sugar over plums.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return tart to the oven and bake until plums are tender and pastry is golden, about 30 minutes. Serve warm or cold.",
      "section": null,
