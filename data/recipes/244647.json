  "ingredients": [
    "2 cups white sugar",
    "2 cups butter, softened",
    "3 cups all-purpose flour",
    "1 cup coconut flakes",
    "1 teaspoon vanilla extract",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a bowl with an electric mixer until smooth and creamy. Mix in flour, coconut flakes, vanilla extract, salt, and baking soda until dough is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough onto a baking sheet.",
