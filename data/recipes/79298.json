  "ingredients": [
    "2 egg whites",
    "0.25 teaspoon salt",
    "0.66666668653488 cup white sugar",
    "0.125 teaspoon cream of tartar",
    "1 cup miniature chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Generously grease a cookie sheet or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend egg whites and salt with an electric mixer until peaks begin to form. With the mixer still running, gradually add sugar, 1 tablespoon at a time, until all is incorporated, then add the cream of tartar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently fold in chocolate chips using a wooden spoon or rubber spatula. Using a teaspoon, drop batter onto prepared cookie sheet. Place in the oven, and turn off heat. Leave in the oven at least 4 hours, or overnight for even better results.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
