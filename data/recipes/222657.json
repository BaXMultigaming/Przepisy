  "ingredients": [
    "1 tablespoon olive oil",
    "1 large onion, minced",
    "6 cloves garlic, minced",
    "1.5 teaspoons garam masala",
    "0.5 teaspoon ground turmeric",
    "2 pinches red pepper flakes",
    "4 cups vegetable broth",
    "1 cup lentils",
    "2 sweet potatoes, peeled and cut into 1/2-inch cubes",
    "4 cups chopped fresh spinach",
    "1 pinch salt to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large pot over medium heat. Cook and stir onion and garlic in hot oil until fragrant, 2 to 4 minutes. Cook and stir garam masala. turmeric, and red pepper flakes into onion mixture until coated, about 2 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir broth and lentils into onion mixture; bring to a boil, reduce heat to low, cover, and cook until lentils are softened but firm to the bite, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in sweet potatoes; bring to a boil, reduce heat to low, cover, and simmer until sweet potatoes are tender and lentils are fully cooked, about 10 minutes. Add spinach; cook until wilted, 3 to 5 minutes. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
