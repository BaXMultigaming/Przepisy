  "ingredients": [
    "5 large Granny Smith apples - peeled, cored, and thinly sliced",
    "0.5 cup white sugar",
    "1 tablespoon all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "1 tablespoon lemon juice",
    "0.25 cup water",
    "1.5 cups all-purpose flour",
    "1 cup brown sugar",
    "1 cup quick cooking oats",
    "1 cup butter, softened",
    "1 (14 ounce) package individually wrapped caramels, unwrapped",
    "1 (5 ounce) can evaporated milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 F (175 degree C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss apples in a medium size bowl with sugar, flour, cinnamon, lemon juice, and water; spread evenly into a 8x8-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, brown sugar, oats, and butter together in another bowl; spoon mixture evenly over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the caramel sauce: Place caramels and evaporated milk in a heavy sauce pan over low heat; cook, stirring frequently, until caramels have melted and sauce is smooth; drizzle over crisp topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apple mixture bubbles and topping is golden brown, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
