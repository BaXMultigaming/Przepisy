  "ingredients": [
    "cracked ice",
    "2 fluid ounces gin",
    "0.5 fluid ounce lemon juice",
    "1 teaspoon simple syrup",
    "5 fluid ounces brut champagne, chilled",
    "1 slice lemon"
  ],
  "steps": [
    {
      "text": "Chill cocktail shaker and glass (Champagne flute or collins glass) in the freezer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill chilled cocktail shaker with ice; add gin, lemon juice, and simple syrup to shaker. Cover and shake until the outside of shaker has frosted. Fill chilled glass half full with ice; strain cocktail into glass. Top with Champagne; garnish with a lemon slice.",
