  "ingredients": [
    "1 pound lean ground beef",
    "1.5 teaspoons hot pepper sauce",
    "2 tablespoons Cajun seasoning",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon dried parsley",
    "0.25 cup finely chopped onion",
    "0.25 cup fresh bread crumbs",
    "0.25 cup milk",
    "1 egg",
    "0.5 cup barbeque sauce",
    "0.5 cup peach preserves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a medium baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix thoroughly the ground beef, hot pepper sauce, Cajun seasoning, Worcestershire sauce, parsley, onion, bread crumbs, milk, and egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form the mixture into golf ball sized meatballs and place on the prepared baking sheet. Bake in preheated oven for 30 to 40 minutes, or until there is no pink left in the middle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine the barbeque sauce and peach preserves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When meatballs are done, place in a serving dish and cover with the barbeque sauce mixture. Toss to coat.",
      "section": null,
      "name": null,
      "url": null,
