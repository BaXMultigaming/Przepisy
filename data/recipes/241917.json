  "title": "Quick Cinnamon Rolls",
  "description": "This quick cinnamon roll recipe makes big, soft, fluffy rolls with a sweet cinnamon filling and homemade cream cheese frosting in just 40 minutes.",
  "authors": [
    "shaunawillman"
  ],
  "date_published": "2020-06-19T00:02:40-04:00",
