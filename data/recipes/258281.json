  "ingredients": [
    "1 pound linguine",
    "1 onion, finely chopped",
    "6 slices bacon, diced",
    "1 pound sea scallops, halved horizontally",
    "3 cloves garlic, minced",
    "0.5 teaspoon red pepper flakes",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "0.5 cup dry white wine",
    "0.33333334326744 cup chopped Italian parsley",
    "1 pinch lemon zest, or more to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to bite, about 11 minutes; Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium heat; Cook and stir onion and bacon until onion is tender and bacon is crisp, about 6 minutes. Add scallops, garlic, red pepper flakes, black pepper, and salt; Cook and stir until scallops are cooked through, about 1 minute. Stir in wine; cook for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the skillet from heat and stir parsley into scallop mixture. Top linguine with scallop mixture and garnish with lemon zest.",
