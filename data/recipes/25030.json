  "ingredients": [
    "32 individually wrapped caramels, unwrapped",
    "5 tablespoons heavy cream",
    "1 cup all-purpose flour",
    "1 cup rolled oats",
    "0.75 cup brown sugar",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.75 cup butter, melted",
    "0.5 cup semisweet chocolate chips",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WZMfk1EPbWahuHlLRbQ19aVNi94=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25030-Caramel-Bars-gw-ddmfs-4x3-step-01-223765fde81f4e768b6431bf929e22c3.jpg"
      ],
      "image": "assets/images/25030/step_01.webp"
    },
    {
      "text": "Make sauce: Melt together caramels and heavy cream in a medium saucepan over low heat; stir occasionally until smooth. Set sauce aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6L03UoykTtFOfd-VRhkHaUwLaTY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25030-Caramel-Bars-gw-ddmfs-4x3-step-02-f6915345d9294ea7b24bfb4ec1fb62a2.jpg"
      ],
      "image": "assets/images/25030/step_02.webp"
    },
    {
      "text": "Make bars: Mix together flour, oats, brown sugar, baking soda, and salt in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w0RMpk9BgAo0djmOuESOxQJbLKQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25030-Caramel-Bars-gw-ddmfs-4x3-step-03-57c96a5506fd46359390dfe935dbcfa5.jpg"
      ],
      "image": "assets/images/25030/step_03.webp"
    },
    {
      "text": "Stir in melted butter until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/02yemg7YMREAx26sJNh8Ka6nsq8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25030-Caramel-Bars-gw-ddmfs-4x3-step-04-48f11abb5dcf4de2b0f043d9c60dcf55.jpg"
      ],
      "image": "assets/images/25030/step_04.webp"
    },
    {
      "text": "Press 1/2 of the oat mixture into the bottom of a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RGQqFA3265j8w__NrcTBBuHKhEI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25030-Caramel-Bars-gw-ddmfs-4x3-step-05-de92838804a74e76aa778c7a6103247c.jpg"
      ],
      "image": "assets/images/25030/step_05.webp"
    },
    {
      "text": "Bake crust in the preheated oven for 8 minutes. Remove from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dWpCv2_4jM6Fifo9wx-3eR8oVk0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25030-Caramel-Bars-gw-ddmfs-4x3-step-06-9282d4f3439c43df8d83c3725e4eea3d.jpg"
      ],
      "image": "assets/images/25030/step_06.webp"
    },
    {
      "text": "Sprinkle crust with chocolate chips and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JbdguOb0hP1hiTzej0zL_CRNZ18=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25030-Caramel-Bars-gw-ddmfs-4x3-step-07-04df0ecf79cb44d787f5c23d496eee82.jpg"
      ],
      "image": "assets/images/25030/step_07.webp"
    },
    {
      "text": "Drizzle with sauce and crumble remaining oat mixture on top.",
      "section": null,
      "name": null,
      "url": null,
