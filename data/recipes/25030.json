        "https://www.allrecipes.com/thmb/tWRVhW6CXgluTpr2jRNWbUQ7wwo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25030-Caramel-Bars-gw-ddmfs-4x3-step-08-500181b754d447fabfa6cb1de9b60798.jpg"
