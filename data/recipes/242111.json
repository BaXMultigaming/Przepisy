  "ingredients": [
    "1 (15 ounce) can black beans, drained and rinsed",
    "1.5 cups cooked quinoa",
    "1 cup frozen corn",
    "1 red bell pepper, diced",
    "0.5 cup chopped green onion",
    "0.5 cup finely chopped cilantro, plus more for garnish",
    "1 teaspoon minced garlic",
    "0.5 cup olive oil",
    "1 lime, juiced",
    "2 tablespoons honey",
    "6 pickled jalapeno pepper slices, chopped",
    "0.25 teaspoon dry mustard",
    "0.25 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Stir black beans, quinoa, corn, red bell pepper, green onion, cilantro, and garlic together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, lime juice, honey, jalapeno, mustard, and paprika together in a bowl until dressing is smooth and creamy. Pour dressing over quinoa mixture and toss to coat. Garnish with cilantro.",
