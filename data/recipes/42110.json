  "ingredients": [
    "2 cups chestnuts",
    "1.5 cups margarine",
    "0.5 cup chopped onion",
    "2 teaspoons poultry seasoning",
    "1 teaspoon salt",
    "0.25 teaspoon pepper",
    "2 (1 pound) loaves day-old bread, cubed",
    "3 large eggs",
    "0.25 cup milk"
  ],
  "steps": [
    {
      "text": "Cut slits in the surface of chestnuts with a sharp knife. Place chestnuts in a medium saucepan with enough water to cover and bring to a boil. Cook until tender, about 25 minutes. Drain, peel, and chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a medium saucepan over medium heat. Stir in chestnuts, onion, poultry seasoning, salt, and pepper, and cook until onions are tender, about 3 minutes. Transfer to a medium baking dish and mix with cubed bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together eggs and milk in a small bowl. Drizzle over cubed bread mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the surface is crisp and lightly browned, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
