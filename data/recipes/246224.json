  "ingredients": [
    "1 sweet potato, peeled and cubed",
    "3 (14.5 ounce) cans chicken stock",
    "3 cups fresh baby spinach leaves",
    "1 cup cooked roast chicken meat",
    "1 clove garlic, minced",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Cook sweet potato in chicken stock in a stockpot over high heat until sweet potato is soft enough to pierce with a fork, about 10 minutes. Stir in spinach, chicken, and garlic; simmer until spinach is wilted and broth is reduced slightly, 10 to 15 minutes more. Season with salt and black pepper.",
