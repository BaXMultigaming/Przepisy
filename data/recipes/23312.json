  "title": "Japanese Chicken Wings",
  "description": "These Japanese chicken wings are coated in egg and flour, fried in butter, then baked in a tangy, garlicky soy sauce for a sweet and sticky appetizer.",
  "authors": [
    "Tracy"
  ],
  "date_published": "2000-10-10T17:25:19-04:00",
