  "ingredients": [
    "0.25 cup balsamic vinegar",
    "1 tablespoon Dijon mustard",
    "1 tablespoon chopped garlic",
    "0.5 teaspoon kosher salt",
    "0.5 teaspoon freshly ground black pepper",
    "0.75 cup olive oil",
    "3 cups 2-inch cubes watermelon",
    "1 cup crumbled feta cheese",
    "0.5 red onion, sliced very thin",
    "coarsely ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Mix the vinegar and Dijon mustard in a bowl. Stir the garlic, salt, and pepper into the mixture. Slowly stream the olive oil into the dressing while whisking vigorously. Place the dressing in the refrigerator until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the watermelon, feta cheese, and red onion in a large bowl; toss lightly to mix. Season with the coarsely ground black pepper. Pour about half the dressing over the salad; gently toss to coat. Refrigerate the salad at least 30 minutes. Drizzle the remaining dressing over the salad just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
