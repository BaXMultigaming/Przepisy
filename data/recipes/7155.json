  "ingredients": [
    "0.33333334326744 cup vegetable oil",
    "0.5 cup honey",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "1 cup mashed bananas",
    "1.75 cups whole wheat flour",
    "0.5 teaspoon salt",
    "1 teaspoon baking soda",
    "0.25 cup hot water",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat oil and honey together. Add eggs, and mix well. Stir in bananas and vanilla. Stir in flour and salt. Add baking soda to hot water, stir to mix, and then add to batter. Blend in chopped nuts. Spread batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until a toothpick inserted in the center of the loaf comes out clean, 55 to 60 minutes. Cool on wire rack for 1/2 hour before slicing.",
      "section": null,
      "name": null,
      "url": null,
