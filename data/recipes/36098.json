  "ingredients": [
    "0.5 cup white sugar",
    "1 tablespoon ground cinnamon",
    "0.125 teaspoon ground nutmeg",
    "0.125 teaspoon ground allspice",
    "1 apple - peeled, cored and cubed",
    "0.33333334326744 cup water",
    "1 (14 ounce) package individually wrapped caramels, unwrapped",
    "1 cup finely chopped walnuts"
  ],
  "steps": [
    {
      "text": "In a small bowl, mix together the sugar, cinnamon, nutmeg and allspice. Toss apple pieces in the mixture until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the top of a double boiler, combine the caramel candies and water. Heat, stirring occasionally until melted and smooth. Place walnuts onto a tray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a fork or toothpick, dip apple pieces into the caramel, then drop them into the walnuts. Roll them around until coated. Place onto a waxed paper lined cookie sheet, and refrigerate until set, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
