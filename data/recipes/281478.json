  "ingredients": [
    "5 large heads broccoli, or more to taste",
    "2 (8 ounce) bottles Caesar dressing",
    "0.5 cup grated Parmesan cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for low heat, 275 to 325 degrees F (135 to 163 degrees C) and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut broccoli into the smallest size pieces that will not fall through the grill grates. Place broccoli in a bowl and pour dressing and Parmesan cheese on top. Toss by hand until broccoli is thoroughly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, quickly tending to any flare-ups to avoid charred broccoli, until lightly browned, 8 to 10 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
