  "ingredients": [
    "1 cup vegetable oil for frying, or as needed",
    "1 cup unbleached flour",
    "1 teaspoon baking powder",
    "1 teaspoon powdered milk",
    "0.25 teaspoon salt",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "Heat oil in a heavy skillet to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, powdered milk, and salt together into a large bowl. Pour water over flour mixture; stir until a sticky dough forms. Form dough into a ball using floured hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 4 even-sized balls; flatten into 1/2-inch-thick patties, and make a small hole in the center of each patty.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry dough in hot oil until golden, about 3 to 4 minutes per side. Drain on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
