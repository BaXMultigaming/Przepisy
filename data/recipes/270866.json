  "ingredients": [
    "3 cups uncooked tri-color rotini pasta",
    "4 cups cubed cooked chicken breast",
    "0.5 cup diced green bell pepper",
    "0.25 cup diced green onions",
    "1.5 cups mayonnaise (such as Hellman's®)",
    "0.75 cup packed brown sugar",
    "1 tablespoon cider vinegar",
    "1.5 teaspoons lemon juice",
    "1.5 teaspoons salt",
    "2 cups salted cashew halves"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil; cook rotini at a boil until tender yet firm to the bite, about 8 minutes. Drain and rinse with cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine rotini, chicken, bell pepper, and green onions in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, brown sugar, vinegar, lemon juice, and salt together in a small bowl until well combined; pour over pasta mixture and stir well to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate until flavors are combined and dressing has thickened, 8 hours to overnight. Stir in cashews just before serving or no more than 2 hours ahead.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
