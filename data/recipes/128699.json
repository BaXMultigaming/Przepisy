  "ingredients": [
    "2 tablespoons vegetable oil",
    "1 (3 pound) chicken, cut into pieces",
    "1 large onion, quartered and sliced",
    "2 tablespoons minced garlic",
    "0.66666668653488 cup low sodium soy sauce",
    "0.33333334326744 cup white vinegar",
    "1 tablespoon garlic powder",
    "2 teaspoons black pepper",
    "1 bay leaf"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a large skillet over medium-high heat. Cook chicken pieces until golden brown, 2 to 3 minutes per side. Transfer chicken to a plate and set aside.",
