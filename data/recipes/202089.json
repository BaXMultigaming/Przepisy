  "ingredients": [
    "1 tablespoon butter",
    "1 onion, chopped",
    "0.5 cup cubed cooked ham",
    "2 garlic scapes, sliced",
    "6 eggs",
    "0.25 cup milk",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.5 cup shredded white Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Add onion, ham, and garlic scapes; cook until onion is tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, milk, salt, and black pepper together in a bowl; pour into the skillet. Cook, and stir continually, until eggs are nearly set, but still moist. Add ¼ cup cheese; cook and stir until eggs are completely set, about 5 minutes. Top with remaining ¼ cup cheese.",
      "section": null,
