  "ingredients": [
    "14 ounces marzipan",
    "1.25 cups blanched almonds, halved",
    "1 large egg white"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 200 degrees F (95 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead marzipan well and divide into about forty 1 1/2-inch cubes of equal size. Roll each cube into a ball and shape into a round cylinder with a point.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Push 3 halved almonds into each marzipan cylinder so the pointy sides of the almonds are facing the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white lightly in a cup and brush each cookie with egg white. Set onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated until the tops of the almonds are lightly browned, about 15 minutes. Cool on a wire rack. Store in airtight containers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
