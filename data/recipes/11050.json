  "ingredients": [
    "1 cup white sugar",
    "1 teaspoon baking powder",
    "3 cups all-purpose flour",
    "1 cup shortening",
    "1 egg",
    "1 pinch salt",
    "1 pinch ground cinnamon",
    "4 cups raspberries",
    "0.5 cup white sugar",
    "3 teaspoons cornstarch"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 13x9-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup sugar, flour, baking powder, salt, ground cinnamon, shortening, and egg. The dough will be crumbly. Pat half of the dough into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1/2 cup sugar, cornstarch, and berries. Place mixture over dough in pan. Crumble the remaining dough over the tops of the berries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is slightly browned, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
