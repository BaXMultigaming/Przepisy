  "ingredients": [
    "2 (9 inch) frozen pie crusts",
    "2 cups sour cream",
    "4 large eggs",
    "3 cups white sugar",
    "4 tablespoons all-purpose flour",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon salt",
    "3 cups sliced strawberries",
    "3 cups chopped rhubarb",
    "0.5 cup packed brown sugar",
    "6 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line 2 pie plates with pie crusts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sour cream and eggs in a large bowl; stir in sugar, ¼ cup flour, vanilla, and salt until well blended. Fold in strawberries and rhubarb until evenly distributed; divide filling between pie crusts. Cover pie crusts with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is lightly browned, about 15 minutes. Reduce heat to 350 degrees F (175 degrees C); continue baking until filling is soft and nicely thickened, about 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine brown sugar and remaining ½ cup flour in a medium bowl; cut in butter until mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle pies with crumb mixture; continue baking until filling is set, 20 to 25 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
