  "ingredients": [
    "1 (8 ounce) package reduced-fat cream cheese, softened",
    "0.5 cup creamy peanut butter",
    "1 (7 ounce) jar marshmallow cream",
    "0.5 ripe banana, mashed",
    "0.5 teaspoon vanilla extract"
