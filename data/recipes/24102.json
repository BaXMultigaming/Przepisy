  "ingredients": [
    "1.25 cups white sugar, divided",
    "0.25 cup unsalted butter, softened",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup milk",
    "2.5 cups huckleberries",
    "0.5 cup boiling water",
    "1 tablespoon unsalted butter, cut into pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C.) Grease the bottom of a 9-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat ½ cup sugar and ¼ cup butter in a large bowl with an electric mixer until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, and salt in a small bowl: stir mixture into butter mixture. Stir in milk until thick and slightly lumpy. Spread batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining ¾ cup sugar, berries, and boiling water in a large bowl; pour over batter in the pan. Dot with butter over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
