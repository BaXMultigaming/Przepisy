  "ingredients": [
    "1 (14 ounce) package coleslaw mix",
    "0.5 small red onion, chopped",
    "0.25 cup apple cider vinegar",
    "0.25 cup olive oil",
    "2 tablespoons Creole mustard",
    "0.5 teaspoon white sugar",
    "0.25 teaspoon celery seed",
    "salt and ground black pepper to taste",
    "2 pounds cod fillets",
    "2 tablespoons blackening seasoning",
    "2 teaspoons paprika",
    "1 tablespoon olive oil",
    "8 hamburger buns"
  ],
  "steps": [
    {
      "text": "Combine coleslaw mix, onion, vinegar, oil, mustard, sugar, celery seed, salt, and pepper in a large bowl. Stir until evenly combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay cod fillets on a clean work surface. Sprinkle 1/2 of the blackening seasoning and 1/2 of the paprika over the fillets. Flip fillets over and sprinkle with remaining blackening seasoning and paprika. Brush olive oil over both sides of the fillets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Grill fish for 3 minutes. Flip and grill for 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut fillets in half and place each half on a hamburger bun. Top with reserved slaw.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
