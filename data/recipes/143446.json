  "ingredients": [
    "5 pounds unpeeled potatoes, cubed",
    "6 large hard-cooked eggs, peeled and finely diced",
    "1.5 cups mayonnaise",
    "1 small red onion, diced",
    "0.5 cup barbeque sauce",
    "0.5 teaspoon garlic powder",
    "salt and ground black pepper to taste",
    "0.5 teaspoon ground paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until just tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain potatoes. Transfer to baking sheets; spread in a single layer. Refrigerate until cold, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cooled potatoes in a large bowl with eggs, mayonnaise, onion, barbecue sauce, and garlic powder; season with salt and pepper. Mix until well combined. Sprinkle with paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
