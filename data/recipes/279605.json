  "ingredients": [
    "16 maraschino cherries",
    "2.25 cups cake flour",
    "3 teaspoons baking powder",
    "1 teaspoon salt",
    "4 large egg whites",
    "1.3333333730698 cups white sugar",
    "0.5 cup shortening",
    "0.5 cup milk",
    "0.25 cup maraschino cherry juice",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a fluted tube pan (such as Bundt).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each maraschino cherry into 8 pieces; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift cake flour, baking powder, and salt into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until foamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and shortening together in a large bowl. Add dry ingredients; mix to combine. Blend in milk and cherry juice. Add egg whites and mix well. Fold in walnuts and cherries. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 45 to 50 minutes. Cool on a wire rack for 15 minutes. Run a table knife around the edges to loosen. Invert carefully onto a serving plate or cooling rack. Let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
