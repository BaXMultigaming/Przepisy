  "ingredients": [
    "1 cup honey",
    "0.5 cup coconut oil",
    "0.5 cup cocoa powder",
    "2 cups rolled oats",
    "1 cup natural peanut butter",
    "1 cup unsweetened flaked coconut",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine honey, coconut oil, and cocoa powder in a small saucepan; bring to a boil and boil for 2 minutes. Off heat, stir in oats, peanut butter, coconut, and vanilla until peanut butter melts and mixture is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of mixture onto waxed paper; cool until firm, about 20 minutes.",
