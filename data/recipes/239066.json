  "ingredients": [
    "2 quarts apple cider, divided",
    "1 (2 inch) piece fresh ginger, sliced",
    "1 cinnamon stick",
    "0.5 teaspoon whole cloves",
    "0.5 cup brown sugar",
    "0.25 cup honey",
    "1 (28 ounce) can pumpkin puree"
  ],
  "steps": [
    {
      "text": "Stir 3 cups apple cider, ginger, cinnamon stick, and cloves together in a saucepan; bring to a boil, reduce heat to low, and simmer until slightly reduced, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove saucepan from heat and immediately stir brown sugar and honey into the cider mixture until dissolved into the liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the liquid into a wide glass dish and refrigerate until chilled completely, at least 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the chilled apple cider mixture with the remaining apple cider and the pumpkin puree in a large pitcher; stir until the puree dissolves into the liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
