  "ingredients": [
    "2 (16 ounce) jars dry-roasted, salted peanuts",
    "1 (12 ounce) bag semisweet chocolate chips",
    "4 (1 ounce) squares unsweetened chocolate, broken into pieces",
    "3 pounds white bark, broken into pieces"
  ],
  "steps": [
    {
      "text": "Layer peanuts, chocolate chips, unsweetened chocolate, and white bark (in the order listed) in a 4- or 5-quart slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low, without removing the lid, for 3 hours. Turn off and cool slightly, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop chocolate mixture by teaspoonfuls onto pieces of waxed paper. Let sit until thoroughly cool, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
