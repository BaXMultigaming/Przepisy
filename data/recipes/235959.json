  "ingredients": [
    "1 tablespoon butter, or as needed",
    "2 cups milk",
    "3 eggs",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground allspice",
    "12 thick slices Texas toast",
    "2 tablespoons confectioners' sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, eggs, sugar, vanilla extract, cinnamon, and allspice together in a large bowl. Dip each slice of bread into egg mixture to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place coated bread into skillet and cook until golden brown on 1 side, about 1 minute. Flip and continue cooking until second side is golden, about 1 minute more. Remove to a plate and repeat with remaining bread slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift confectioners' sugar over top of the French toast, slice diagonally, and serve.",
