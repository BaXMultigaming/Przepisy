  "ingredients": [
    "2 shallots, minced",
    "2 tablespoons chopped garlic",
    "2 tablespoons chopped fresh oregano",
    "2 tablespoons white sugar",
    "2 tablespoons olive oil",
    "2 tablespoons red wine vinegar",
    "2 tablespoons lime juice",
    "2 tablespoons tequila",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "4 tilapia fillets",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Add shallots, garlic, oregano, sugar, olive oil, vinegar, lime juice, tequila, salt, and black pepper to a gallon-sized resealable plastic bag; shake to combine. Add tilapia, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 2 to 4 hours, flipping every 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with aluminum foil; coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tilapia from marinade; shake off excess. Place tilapia on the prepared baking sheet. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tilapia flakes easily with a fork, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
