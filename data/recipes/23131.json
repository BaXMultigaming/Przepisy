  "ingredients": [
    "1.5 cups white sugar",
    "0.5 cup butter",
    "1 cup buttermilk",
    "3 eggs",
    "3 teaspoons all-purpose flour",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon ground nutmeg",
    "1 (9 inch) unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a large bowl until smooth. Mix in buttermilk, eggs, flour, and vanilla. Pour filling into pie shell. Sprinkle top with nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 1 hour.",
