  "steps": [
    {
      "text": "Line a 9x9 inch baking dish with whole graham crackers without overlapping them.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan over medium heat, bring to a boil 1/2 cup butter, brown sugar, and egg. Stir in the graham cracker crumbs, coconut, and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove saucepan from heat. Carefully spread over whole graham crackers, covering entire surface of baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together 1/2 cup butter, evaporated milk, custard powder, powdered sugar, and vanilla. Spread icing evenly on top of crushed graham cracker filling. Cover, and refrigerate.",
      "section": null,
