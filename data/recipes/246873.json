  "ingredients": [
    "2 cups all-purpose flour",
    "1.25 cups 100% tomato juice",
    "0.75 cup milk",
    "1 teaspoon white sugar",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried basil",
    "0.25 teaspoon ground black pepper",
    "9 ounces fully cooked ham, grated",
    "9 ounces Gouda cheese, grated"
  ],
  "steps": [
    {
      "text": "Mix flour, tomato juice, milk, sugar, oregano, basil, and black pepper together in a bowl until batter is smooth. Combine ham and Gouda cheese together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle over medium-high heat. Drop batter, 1 ladle per pancake, onto the griddle and cook until bottom is browned, about 5 minutes. Flip and cook until browned on the other side, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pancake to a serving plate. Sprinkle ham-cheese mixture over pancake. Roll pancake around the filling. Repeat cooking with remaining batter and filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
