  "ingredients": [
    "2 cups all-purpose flour",
    "2.5 teaspoons ground cinnamon",
    "2 teaspoons baking powder",
    "1.5 teaspoons baking soda",
    "1 teaspoon salt",
    "2 cups white sugar",
    "1.5 cups vegetable oil",
    "4 large eggs",
    "2.75 cups shredded carrots",
    "1 (8 ounce) can crushed pineapple, drained",
    "1 cup flaked coconut",
    "0.75 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cinnamon, baking powder, baking soda, and salt together in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, oil, and eggs together in a separate bowl. Beat in flour mixture. Stir in carrots, pineapple, coconut, and walnuts. Pour cake batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 35 to 40 minutes. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
