  "ingredients": [
    "1 cup gluten-free all-purpose flour mix (such as Bob's Red Mill®)",
    "0.5 cup light brown sugar",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "2.5 ripe bananas, mashed",
    "0.25 cup applesauce",
    "0.25 cup extra-virgin olive oil",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 8-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine gluten-free flour, sugar, baking powder, cinnamon, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bananas, applesauce, olive oil, and vanilla extract in a separate bowl. Add banana mixture to flour mixture; mix well until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
