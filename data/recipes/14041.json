  "ingredients": [
    "2 (10 inch) flour tortillas",
    "2 tablespoons vegetable oil",
    "1 small onion, chopped",
    "0.5 red bell pepper, chopped",
    "1 teaspoon minced garlic",
    "1 teaspoon minced jalapeno peppers",
    "1 (15 ounce) can black beans, rinsed and drained",
    "3 ounces cream cheese, cubed",
    "0.5 teaspoon salt",
    "2 tablespoons chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Wrap tortillas in foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SHnxipVfzZ1rR1HdHHsAMNXi7to=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14041-delicious-black-bean-burritos-ddmfs-step-1-92-756cb46189514ea295773989b32b4e32.jpg"
      ],
      "image": "assets/images/14041/step_01.webp"
    },
    {
      "text": "Bake wrapped tortillas in the preheated oven until heated through, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat oil in a 10-inch skillet over medium heat. Add onion, bell pepper, garlic, and jalapeño; cook and stir for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MLDwrV4LWzcs-6N87mfUFtLGZlk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14041-delicious-black-bean-burritos-ddmfs-step-2-93-832a4e791a5d492090877f2c77929be8.jpg"
      ],
      "image": "assets/images/14041/step_03.webp"
    },
    {
      "text": "Stir in beans and cook until heated through, about 3 minutes. Stir in cream cheese and salt; cook, stirring occasionally, for 2 minutes. Stir in cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Kik9aztv0TpFdQp2UDVzYllYLp4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14041-delicious-black-bean-burritos-ddmfs-step-3-94-7ddd8267b2ea4e96a37c5417d6237025.jpg"
      ],
      "image": "assets/images/14041/step_04.webp"
    },
    {
      "text": "Spoon filling in a line across the middle of each tortilla. Fold opposing edges of the tortilla to overlap the filling. Roll 1 of the opposing edges around the filling creating a burrito. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w2WekH0XGb0pxsj0qAXwvFdSwR0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14041-delicious-black-bean-burritos-ddmfs-3x2-008-7fbf871b145f4f35a45650ee903fce73.jpg"
      ],
      "image": "assets/images/14041/step_05.webp"
    }
