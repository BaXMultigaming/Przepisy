  "ingredients": [
    "3 medium russet potatoes, peeled and chopped",
    "1.75 cups chicken broth",
    "0.33333334326744 cup chopped onion",
    "1 teaspoon kosher salt",
    "0.125 teaspoon ground nutmeg",
    "1 (12 ounce) package frozen cut asparagus",
    "1.5 cups heavy cream",
    "4 ounces whipped cream cheese"
  ],
  "steps": [
    {
      "text": "Combine potatoes, chicken broth, onion, salt, and nutmeg in a large pot. Bring to a boil; reduce heat and simmer, covered, until potatoes are just tender, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add asparagus and return to a boil. Reduce heat; simmer, covered, until vegetables are tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in heavy cream and cream cheese until melted; do not boil.",
      "section": null,
