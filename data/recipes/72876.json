  "ingredients": [
    "0.75 cup walnut halves",
    "10 ounces mixed salad greens with arugula",
    "2 large navel oranges, peeled and sectioned",
    "0.5 cup sliced red onion",
    "0.25 cup olive oil",
    "0.25 cup vegetable oil",
    "0.66666668653488 cup orange juice",
    "0.25 cup white sugar",
    "2 tablespoons balsamic vinegar",
    "2 teaspoons Dijon mustard",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon ground black pepper",
    "0.25 cup crumbled Gorgonzola cheese"
  ],
  "steps": [
    {
      "text": "Place the walnuts in a skillet over medium heat. Cook 5 minutes, stirring constantly, until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, toss the toasted walnuts, salad greens, oranges, and red onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large jar with a lid, mix the olive oil, vegetable oil, orange juice, sugar, vinegar, mustard, oregano, and pepper. Seal jar, and shake to mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide the salad greens mixture into individual servings. To serve, sprinkle with Gorgonzola cheese, and drizzle with the dressing mixture.",
