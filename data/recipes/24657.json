  "ingredients": [
    "1 cup distilled white vinegar",
    "1 cup soy sauce",
    "0.5 cup vegetable oil",
    "1 tablespoon sesame oil",
    "1 tablespoon toasted sesame seeds",
    "0.5 teaspoon crushed red pepper flakes",
    "0.5 teaspoon garlic powder",
    "1 pinch ground cayenne pepper"
  ],
  "steps": [
    {
      "text": "Whisk together distilled white vinegar, soy sauce, vegetable oil, sesame oil, toasted sesame seeds, crushed red pepper flakes, garlic powder, and cayenne in a bowl. Allow the mixture to stand at room temperature for 1 hour before serving.",
