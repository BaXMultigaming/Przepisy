  "ingredients": [
    "0.5 cup white sugar",
    "0.5 cup cider vinegar",
    "0.25 cup cold water",
    "1 teaspoon salt",
    "0.5 teaspoon mustard seed",
    "0.5 teaspoon celery seed",
    "8 cups shredded cabbage",
    "0.5 cup chopped celery",
    "0.5 cup chopped green bell pepper",
    "1 tablespoon chopped pimento pepper"
