  "steps": [
    {
      "text": "In a jar with lid, combine the sugar, vinegar, water, salt, mustard seed and celery seed. Cover tightly and shake vigorously until sugar is dissolved. Chill dressing for several hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, toss together the cabbage, celery, green peppers, pimento and dressing until evenly coated. Cover and chill until serving.",
