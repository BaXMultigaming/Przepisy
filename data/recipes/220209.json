  "ingredients": [
    "cooking spray",
    "0.5 cup milk",
    "0.5 cup prepared ranch dressing",
    "0.5 cup all-purpose flour",
    "1 cup dry bread crumbs",
    "0.5 cup grated Parmesan cheese",
    "0.5 teaspoon seasoned salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon celery salt",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon ground paprika",
    "0.5 teaspoon dried parsley",
    "0.25 teaspoon dried basil",
    "cooking spray",
    "8 (6 ounce) tilapia fillets"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line an 11-17-inch baking sheet with aluminum foil and lightly spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix milk and ranch dressing in a shallow bowl. Place flour in a separate shallow bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together bread crumbs, Parmesan cheese, seasoned salt, black pepper, celery salt, garlic powder, onion powder, paprika, parsley, and basil in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray bread crumb mixture with cooking spray until damp, then whisk bread crumbs. Repeat spraying and whisking 3 more times to lightly moisten crumb mixture with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer crumb mixture to a large resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently press tilapia fillets into the flour to coat, and shake off the excess flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip the fillets into the ranch dressing mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place all the fillets into the resealable plastic bag; seal bag and shake to coat fish with bread crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange tilapia on prepared baking sheet. Lightly spray the breaded fish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the fish is easily flaked with a fork, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
