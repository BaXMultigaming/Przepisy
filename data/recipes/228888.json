  "ingredients": [
    "0.5 cup sugar",
    "0.5 teaspoon salt",
    "2 teaspoons Spice Islands® Pumpkin Pie Spice",
    "2 eggs",
    "0.5 cup Karo® Lite Syrup",
    "1 (15 ounce) can pumpkin",
    "1 (12 fluid ounce) can evaporated milk",
    "18 baking cups, size 2 1/2",
    "18 vanilla wafers"
  ],
  "steps": [
    {
      "text": "Mix sugar, salt and spice in a bowl. Add eggs and beat slightly. Stir in corn syrup, pumpkin and evaporated milk; blend well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Portion baking cups in muffin pans and place 1 vanilla wafer in each. Fill each two-thirds full of pumpkin mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 300 degrees F for 25 minutes, or until knife inserted in center comes out clean. Cool in pans for 5 minutes; remove.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool a minimum of 1 hour before serving. Garnish as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
