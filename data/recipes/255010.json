      ],
      "image": "assets/images/255010/step_02.webp"
    },
    {
      "text": "Cover pan immediately, reduce heat to medium-high, and cook for 9 ½ minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HozuVDs2EqxXhPBkKPIcKco1gXQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255010-soft-hard-boiled-eggs-VAT-step-03-5258754784d14fc7af87b6825db21179.jpg"
      ],
      "image": "assets/images/255010/step_03.webp"
    },
    {
