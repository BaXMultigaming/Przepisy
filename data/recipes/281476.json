  "ingredients": [
    "1 cup water",
    "3 fresh jalapeno peppers, sliced",
    "0.33333334326744 cup apple cider vinegar",
    "3 cloves garlic, roughly chopped",
    "1 teaspoon smoked paprika",
    "1 teaspoon salt",
    "1 cup apricot preserves"
