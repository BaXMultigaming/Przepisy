  "steps": [
    {
      "text": "Combine water, jalapeños, vinegar, garlic, paprika, and salt in a small saucepan over medium-high heat; bring to a boil. Reduce heat; simmer for 10 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer mixture to a blender. Add apricot preserves; blend until smooth. Cool sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer sauce to a sterilized glass jar with a lid. Store in the refrigerator.",
