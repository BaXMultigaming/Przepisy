  "ingredients": [
    "1 boneless, skinless chicken breast half",
    "1 pinch Kosher salt, to taste",
    "1 pinch Freshly ground black pepper, to taste",
    "1 pinch Smoky paprika",
    "1 tablespoon olive oil",
    "4 cherry tomatoes, quartered",
    "1 cup chopped lettuce",
    "0.25 cup cooked black beans, rinsed and drained",
    "1 (4 ounce) Libby's® Sweet Corn Vegetable Cup",
    "1 lime, juiced",
    "0.25 cup olive oil",
    "1 teaspoon Bacon bits",
    "1 cup tortilla chips"
  ],
  "steps": [
    {
      "text": "Season chicken breast with salt, freshly ground black pepper and smoky paprika (optional).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a grill pan and add 1 tablespoon olive oil. Add chicken breast and cook 6 minutes on each side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Remove from grill pan and allow chicken to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tomatoes, chopped lettuce, beans, and Libby's corn into bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In separate small bowl whisk together lime juice, olive oil, salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cooled chicken breast onto cutting board and cut into 1-inch pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing over veggies and lettuce and toss. Add chopped chicken to salad. Sprinkle cheese and bacon bits (optional) over salad.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve salad with tortilla chips or add them into salad.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
