  "ingredients": [
    "1 tablespoon butter",
    "1 cup white rice",
    "0.25 cup broken pieces vermicelli pasta",
    "3 cups water",
    "1 tablespoon chicken bouillon granules",
    "2 teaspoons dried parsley",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion powder"
  ],
  "steps": [
    {
      "text": "Melt butter in a large saucepan over medium heat. Cook rice and vermicelli in hot butter until browned, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour water over rice mixture. Stir in chicken bouillon, parsley, garlic powder, and onion powder; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the saucepan, reduce heat to low, and cook until water is absorbed, about 25 minutes.",
