  "ingredients": [
    "1 cup creamy salad dressing, e.g. Miracle Whip ™",
    "0.25 cup sour cream",
    "1 tablespoon lemon juice",
    "1 teaspoon dried basil",
    "1 teaspoon dried parsley",
    "0.5 teaspoon lemon pepper",
    "4 cups cubed, cooked chicken",
    "2 cups sliced snow peas",
    "1 cup finely diced red onion",
    "1 cup shredded lettuce",
    "1 cup blanched slivered almonds, toasted"
  ],
  "steps": [
    {
      "text": "Whisk salad dressing, sour cream, lemon juice, basil, parsley, and lemon pepper together in a large bowl. Add chicken, peas, onion, lettuce, and almonds; stir until evenly coated. Refrigerate until ready to serve.",
