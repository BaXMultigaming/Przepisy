  "ingredients": [
    "1 cup butter, softened",
    "0.33333298563957 cup heavy whipping cream",
    "2 cups sifted all-purpose flour",
    "0.33333298563957 cup granulated sugar for decoration",
    "0.25 cup butter, softened",
    "0.75 cup sifted confectioners' sugar",
    "1 egg yolk",
    "1 teaspoon vanilla extract",
    "2 drops red food coloring"
  ],
  "steps": [
    {
      "text": "Make wafers: Mix butter, cream, and sifted flour with an electric mixer until well combined. Chill for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Sprinkle white sugar over a sheet of waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a floured board, roll out 1/3 of the dough to 1/8 inch thick. Cut about 60 wafers with a 1 1/2-inch round cookie cutter. Press both sides of each wafer into the white sugar, then transfer to ungreased baking sheets. Prick each cookie about 4 times with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 7 to 9 minutes. Let cookies cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make filling while wafers are cooling: Blend butter, confectioners' sugar, egg yolk, and vanilla together with an electric mixer. Tint with food coloring.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread filling onto a cooled wafer and top with a second wafer. Press gently to seal. Repeat with remaining wafers and filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
