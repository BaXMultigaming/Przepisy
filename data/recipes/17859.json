  "title": "Southern Comfort Sweet Potatoes",
  "description": "Canned sweet potatoes are mixed with orange juice, cinnamon, and Southern Comfort liqueur, and topped with a pecan and brown sugar crust.",
  "authors": [
    "Emtmom"
  ],
  "date_published": "1999-12-29T14:05:54-05:00",
