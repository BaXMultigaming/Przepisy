  "title": "BBQ NY Strip",
  "description": "NY strip steaks are tasty and tender on the grill with this quick and easy recipe! Marinate for a minimum of 2 hours.",
  "authors": [
    "RUSS4433"
  ],
  "date_published": "2018-03-21T12:45:35-04:00",
