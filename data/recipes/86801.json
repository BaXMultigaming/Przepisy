  "ingredients": [
    "4 (6 ounce) New York strip steaks",
    "0.5 cup extra virgin olive oil",
    "0.5 cup Worcestershire sauce",
    "0.25 cup steak seasoning",
    "4 tablespoons minced garlic",
    "1 tablespoon red wine vinegar",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon Italian seasoning"
  ],
  "steps": [
    {
      "text": "Pierce steaks on all sides with a fork .",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, Worcestershire sauce, steak seasoning, garlic, vinegar, basil, and Italian seasoning together in a bowl and pour into a resealable plastic bag. Add steaks, coat with the marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to cook, preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove steaks from the marinade and shake off excess. Discard the remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook steaks on the preheated grill for 7 minutes on each side, or to desired doneness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
