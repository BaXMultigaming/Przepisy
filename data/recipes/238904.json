  "ingredients": [
    "0.5 cup ketchup",
    "0.5 cup packed brown sugar",
    "1.5 teaspoons salt",
    "0.5 teaspoon chili powder",
    "1.5 pounds lean ground beef",
    "1.5 cups croutons, crushed",
    "1 small onion, chopped",
    "2 eggs",
    "0.25 cup milk",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
