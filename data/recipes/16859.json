  "ingredients": [
    "1 cup uncooked elbow macaroni",
    "0.75 cup mayonnaise",
    "0.5 cup diced celery",
    "0.25 cup sweet pickle relish",
    "2 ounces cooked salad shrimp",
    "2 tablespoons ketchup",
    "2 tablespoons white wine vinegar",
    "1 tablespoon finely diced onion",
    "1 tablespoon chopped green bell pepper",
    "1 tablespoon chopped fresh parsley",
    "1 teaspoon prepared horseradish",
    "0.5 teaspoon celery seed",
    "0.25 teaspoon hot pepper sauce",
    "0.125 teaspoon chili powder",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise, celery, relish, shrimp, ketchup, vinegar, onion, bell pepper, parsley, horseradish, celery seed, hot pepper sauce, chili powder, salt, and black pepper in a medium-sized bowl. Fold macaroni into mixture. Cover and chill at least 3 hours before serving.",
