  "ingredients": [
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon baking powder",
    "3 eggs",
    "2 cups white sugar",
    "2 cups grated zucchini",
    "1 cup vegetable oil",
    "1 cup chopped walnuts",
    "1 cup semisweet chocolate chips",
    "1 tablespoon orange zest",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, salt, nutmeg, cinnamon, and baking powder together into a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs together in a bowl with an electric mixer until light and fluffy; beat in sugar until well blended. Stir in zucchini, oil, walnuts, chocolate chips, orange zest, and vanilla extract until well combined; blend in flour mixture. Divide batter between the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 50 minutes. Cool slightly in the pans before removing loaves from the pans. Chill loaves in the refrigerator before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
