  "ingredients": [
    "1 tablespoon butter, or as needed",
    "4 eggs, at room temperature",
    "0.75 cup white sugar",
    "0.25 cup white rum",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 (14 ounce) can sweetened condensed milk",
    "1.5 cups eggnog, at room temperature",
    "3 tablespoons white rum"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat an 11x7-inch baking pan with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a bowl until frothy. Add sugar and continue to beat until thick and creamy, 4 to 5 minutes. Add rum and vanilla extract. Add flour, baking powder, and salt and mix until just combined; do not overbeat. Pour batter into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 20 to 23 minutes. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sweetened condensed milk, eggnog, and rum in a bowl and stir until well combined. Poke holes throughout the cooled cake using a skewer or toothpick. Slowly pour sauce over the cake. Cover with aluminum foil and refrigerate until sauce is absorbed, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
