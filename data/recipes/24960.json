  "ingredients": [
    "6 large sweet potatoes, peeled and quartered",
    "0.5 cup butter, melted",
    "0.66666668653488 cup dark brown sugar",
    "0.66666668653488 cup white sugar",
    "4 eggs, beaten",
    "0.66666668653488 cup orange juice",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter a 2 1/2 quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to a boil. Add potatoes and cook until tender, about 20 minutes. Drain and mash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the mashed sweet potatoes, butter, brown sugar, white sugar, eggs, orange juice and vanilla; stir until smooth. Pour into buttered dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
