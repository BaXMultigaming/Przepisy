  "ingredients": [
    "10 slices white bread, cut into cubes",
    "0.5 cup raisins",
    "0.25 cup margarine, melted",
    "1 teaspoon ground cinnamon",
    "6 eggs",
    "0.75 cup white sugar",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon salt",
    "3 cups hot milk",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss bread cubes, raisins, melted margarine, and cinnamon together in a large bowl until well mixed; transfer to a 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in same bowl; stir in sugar, vanilla, and salt until sugar dissolved. Slowly whisk in hot milk; pour over bread cubes, sprinkle with nutmeg, and set aside to soak for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
