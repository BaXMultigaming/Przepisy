  "ingredients": [
    "1 egg white",
    "1 teaspoon water",
    "1 cup bread crumbs",
    "1 teaspoon dried oregano",
    "1 teaspoon dried basil",
    "2 tablespoons freshly grated Parmesan cheese",
    "1 (25 ounce) package cheese ravioli, thawed if frozen",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 400 degrees F (200 degrees C). Place a wire rack on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together the egg white and water in a small bowl. Mix bread crumbs, oregano, basil, and Parmesan cheese in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each ravioli in the beaten egg, and then roll in the bread crumb mixture. Spray both sides of breaded ravioli with cooking spray; place on the wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake breaded ravioli in preheated oven until golden brown and crispy, 15 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
