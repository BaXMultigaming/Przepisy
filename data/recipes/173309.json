  "ingredients": [
    "Mazola Pure® Cooking Spray",
    "4 quarts popped popcorn",
    "1 cup brown sugar",
    "0.5 cup Karo® Light OR Dark Corn Syrup",
    "0.5 cup butter OR margarine",
    "0.5 teaspoon salt",
    "1 teaspoon Spice Islands® Pure Vanilla Extract",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/THKdFcGZI2ixQ5c5fxQXaNOS3tc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-173309-classic-caramel-corn-ddmfs-Step-1-108964ff083e40a68faf77c601a715d8.jpg"
      ],
      "image": "assets/images/173309/step_01.webp"
    },
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Spray a large shallow roasting pan with cooking spray, then fill with popcorn. Place in the preheated oven while preparing caramel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RTBgJPM829lXegAPyoXgohEIdo4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-173309-classic-caramel-corn-ddmfs-Step-2-c686e1a6724d45d187e1a9a224e4b27c.jpg"
      ],
      "image": "assets/images/173309/step_02.webp"
    },
    {
      "text": "Mix brown sugar, corn syrup, butter, and salt together in a heavy 2-quart saucepan over medium heat; stir constantly until mixture comes to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FnM_Jkfx_1Vn-AzqNskqOEJ-3R0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-173309-classic-caramel-corn-ddmfs-Step-3-325a787a1d8e412f92bf4fd1ee598a5c.jpg"
      ],
      "image": "assets/images/173309/step_03.webp"
    },
    {
      "text": "Stop stirring, and boil mixture for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rVj5zezvi2L03ZlKKdV8Jp4osW0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-173309-classic-caramel-corn-ddmfs-Step-4-e1ff8966f31547c5a697c335cafa07ec.jpg"
      ],
      "image": "assets/images/173309/step_04.webp"
    },
    {
      "text": "Remove from the heat and stir in baking soda and vanilla until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0S9hdHsxWgt4WxtmnvBPbaIa-BM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-173309-classic-caramel-corn-ddmfs-Step-5-1-d62c2eef61374f66b7d0d6391d7de2c6.jpg"
      ],
      "image": "assets/images/173309/step_05.webp"
    },
    {
      "text": "Pour syrup over warmed popcorn and stir until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IeoPc53hl5pX-uoBCZTJ3WoqyZY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-173309-classic-caramel-corn-ddmfs-Step-5-2-e8a9adb248d6429e81e94bfd48752fa5.jpg"
      ],
      "image": "assets/images/173309/step_06.webp"
    },
    {
      "text": "Return to the oven and bake for 45 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qV73zyFTIHWw4SuJquFPP2sFMhU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-173309-classic-caramel-corn-ddmfs-Step-5-3-f6226bae02a9484bbdc5ac012d57b530.jpg"
      ],
      "image": "assets/images/173309/step_07.webp"
    },
    {
      "text": "Remove from the oven and spread onto a large foil sheet greased with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nMxXhVAsoWrjgVnH_TlIgqMULYA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-173309-classic-caramel-popcorn-ddmfs-Step-6-8f78d49606884651a10b823eb2677127.jpg"
      ],
      "image": "assets/images/173309/step_08.webp"
    },
    {
      "text": "Cool, then break apart and store in a tightly covered container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IuFlCB6yR-a96bMLnql4nFkVDCE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-1733309-classic-caramel-corn-ddmfs-4x3-f4759e74fb914b40835f49c2f4730ec0.jpg"
      ],
      "image": "assets/images/173309/step_09.webp"
    }
  ],
