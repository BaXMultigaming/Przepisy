  "ingredients": [
    "1 (24 ounce) jar tomato sauce",
    "1 (16 ounce) jar seedless blackberry jam",
    "0.75 (10 ounce) jar jalapeno jelly",
    "0.5 cup brown sugar",
    "0.25 cup mustard",
    "3 tablespoons Worcestershire sauce",
    "2 tablespoons ground black pepper",
    "1.5 teaspoons apple cider vinegar",
    "0.5 teaspoon garlic powder",
    "5 drops liquid smoke"
  ],
  "steps": [
    {
      "text": "Combine tomato sauce, blackberry jam, jalapeño jelly, brown sugar, mustard, Worcestershire sauce, black pepper, vinegar, garlic powder, and liquid smoke in a large saucepan over medium-high heat. Bring to a simmer; cook until flavors combine, 3 to 5 minutes.",
