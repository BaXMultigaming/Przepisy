  "ingredients": [
    "1 cup boiling water",
    "0.25 cup rum",
    "0.66666698455811 cup chopped raisins",
    "0.75 cup butter, melted",
    "1 egg",
    "1.25 cups white sugar",
    "1.6666699647903 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.33333298563957 cup unsweetened cocoa powder",
    "0.66666698455811 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease one 9- or 10-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour boiling water into a small bowl. Add rum and raisins; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour melted butter into a large mixing bowl. Beat in egg. Stir in raisin mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift sugar, flour, baking soda, and cocoa together in a separate bowl. Stir into raisin mixture. Add chopped pecans and stir until just combined. If batter is too thick add a little more water. Pour batter into the prepared tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an inserted toothpick comes out clean, 40 to 50 minutes. Let cake cool in the pan for 10 minutes, then turn out onto a serving dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
