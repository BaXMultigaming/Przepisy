  "ingredients": [
    "2 cups shredded sharp Cheddar cheese",
    "2 (7 ounce) cans Mexican-style corn (such as Green Giant®), drained",
    "1 bunch green onions, thinly sliced",
    "1 (8 ounce) jar mayonnaise",
    "1 (8 ounce) container sour cream",
    "1 (4 ounce) jar diced pimentos, drained",
    "0.5 cup sliced jalapeno peppers",
    "1 tablespoon garlic powder",
    "1 tablespoon flavor enhancer (such as Accent®)"
  ],
  "steps": [
    {
      "text": "Combine Cheddar cheese, corn, green onions, mayonnaise, sour cream, pimentos, jalapeños, garlic powder, and flavor enhancer in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl with plastic wrap; refrigerate 8 hours to overnight.",
      "section": null,
