  "ingredients": [
    "1.5 cups all-purpose flour",
    "1.25 teaspoons baking soda",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 cup solid pack pumpkin puree",
    "1 cup packed brown sugar",
    "0.5 cup buttermilk",
    "1 egg",
    "2 tablespoons butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, salt, cinnamon, and nutmeg into a bowl; mix well. Stir in pumpkin, brown sugar, buttermilk, egg, and butter until well blended. Pour batter into a 9x5-inch loaf pan; smooth the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
