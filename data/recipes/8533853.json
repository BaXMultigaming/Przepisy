  "ingredients": [
    "1 (15 ounce) can chickpeas, drained",
    "2 teaspoons chili-lime seasoning (such as Tajin®)",
    "1 teaspoon olive oil",
    "0.125 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Rinse chickpeas in a colander. Allow to drain and dry for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C) for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chickpeas to a bowl. Add Tajin, olive oil, and cayenne. Stir until evenly combined. Spread out chickpeas in the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook for 5 minutes, shake basket, and cook for 5 minutes more. Shake one more time and continue cooking until chick peas are crisp, about 5 more minute",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a paper towel lined plate and let sit 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
