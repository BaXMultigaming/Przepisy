  "ingredients": [
    "0.25 cup butter",
    "3 stalks celery, diced",
    "1 small onion, diced",
    "0.25 cup all-purpose flour",
    "2 cups chicken broth",
    "1 cup water",
    "0.75 cup half-and-half",
    "2 cups cubed, cooked chicken",
    "1.5 cups shredded Cheddar cheese",
    "0.33333334326744 cup buffalo wing sauce, or more to taste",
    "0.25 cup creamy tomato soup",
    "salt and ground black pepper to taste",
    "0.25 cup crumbled blue cheese, or as needed"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium-high heat. Saute celery and onion in melted butter until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle flour over the celery mixture; cook and stir until the flour absorbs into the butter, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stream chicken broth, water, and half-and-half into the flour mixture while stirring; add chicken, Cheddar cheese, buffalo wing sauce, and tomato soup. Bring mixture to a simmer and cook, stirring occasionally, until the cheese has melted completely into the liquid, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle soup into 8 bowls. Top each serving with blue cheese crumbles to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
