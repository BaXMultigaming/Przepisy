  "ingredients": [
    "1 pound ground beef",
    "0.25 cup diced onion",
    "1 pound bacon, diced",
    "4 (14.5 ounce) cans pork and beans",
    "1 (15 ounce) can kidney beans",
    "1 cup white sugar",
    "0.75 cup ketchup",
    "0.75 cup brown sugar",
    "3 tablespoons vinegar",
    "1 teaspoon liquid smoke flavoring"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef and onion in the hot skillet until browned and crumbly, 5 to 7 minutes; pour into a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir bacon in a large skillet over medium-high heat until evenly browned, about 10 minutes; add to beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pork and beans, kidney beans, white sugar, ketchup, brown sugar, vinegar, and liquid smoke into the beef mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
