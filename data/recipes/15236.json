  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "2 cups white sugar",
    "1 cup vegetable oil",
    "4 large eggs",
    "2 cups all-purpose flour",
    "2 teaspoons ground cinnamon",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7qoQtUwcOISDVmt7rkY1efNirl8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15236-pumpkin-squares-VAT-4x3-step-01-6e0f665c6db8478fa949cf07e93c65b3.jpg"
      ],
      "image": "assets/images/15236/step_01.webp"
    },
    {
      "text": "Mix pumpkin, sugar, oil, and eggs together in a mixing bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xv3cKTeClAQbyBFQwDYS_eiV51M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15236-pumpkin-squares-VAT-4x3-step-02-8956920bd46d4a9aa54a3f46bb78fbcd.jpg"
      ],
      "image": "assets/images/15236/step_02.webp"
    },
    {
      "text": "Sift flour, cinnamon, baking powder, baking soda, cloves, ginger, nutmeg, and salt together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/u51NLKhZmMj1GVGw4cGbS4R4XIk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15236-pumpkin-squares-VAT-4x3-step-03-929f1a8b9f46406cb4558c276a821da6.jpg"
      ],
      "image": "assets/images/15236/step_03.webp"
    },
    {
      "text": "Stir flour mixture into the pumpkin mixture until well combined. Spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a6olh1AnREUYsSiECJam-M-Pbhk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15236-pumpkin-squares-VAT-4x3-step-04-185d5d16d7eb441a9ce7df8569fb38f3.jpg"
      ],
      "image": "assets/images/15236/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until top until tops spring back when lightly pressed, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SRwq7G6MHlroDU7Zn4SBn74oVSY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15236-pumpkin-squares-VAT-4x3-step-05-74ec0079e9b141b3a67f43605455fa04.jpg"
      ],
      "image": "assets/images/15236/step_05.webp"
    },
    {
      "text": "Remove from the oven and cool completely before cutting into 24 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3eH-Zgr-OGJIBqVhsUD8M6AYK2s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15236-pumpkin-squares-VAT-4x3-step-06-3f2e175452e94c4785988871847a2f20.jpg"
      ],
      "image": "assets/images/15236/step_06.webp"
    },
    {
      "text": "Top with cream cheese frosting or glaze, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QYMCdK-bgJrvqeV7OQFHeW-kRiI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15236-pumpkin-squares-VAT-4x3-step-07-6fd03e7d699d48908ccc7ee8e5b501ae.jpg"
      ],
      "image": "assets/images/15236/step_07.webp"
    },
    {
      "text": "Serve and enjoy!",
