  "ingredients": [
    "1 teaspoon olive oil",
    "2 cups sliced mushrooms",
    "2 tablespoons olive oil",
    "6 (3/4 inch thick) pork loin chops",
    "1 cup chopped onion",
    "2 cloves garlic, crushed",
    "1 (14.5 ounce) can diced Italian tomatoes, undrained",
    "1 teaspoon dried basil",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup water",
    "6 large green bell pepper slices"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ypKQw9lKGPD3IGySm7RJrGf-JaY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219005-pork-chops-italiano-VAT-step-01-268178ecc0ea41cd88e428c9eb156c1d.jpg"
      ],
      "image": "assets/images/219005/step_01.webp"
    },
    {
      "text": "Heat 1 teaspoon oil in a skillet over medium heat. Stir in mushrooms; cook and stir until tender, 5 to 7 minutes. Transfer to a bowl and set aside until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-LNSlbRC8uMCWLkia5b9QUjHEXk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219005-pork-chops-italiano-VAT-step-02-3cbe87fffe79467ea595082ded421df2.jpg"
      ],
      "image": "assets/images/219005/step_02.webp"
    },
    {
      "text": "Heat 2 tablespoons oil in the skillet over medium heat. Add pork chops and cook until browned, 3 ½ to 5 minutes per side; transfer to a plate. Drain all but 1 tablespoon drippings from the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lpJnOVcsWE2rzZtDoQjJIKjV46c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219005-pork-chops-italiano-VAT-step-03-2553a03ab8d14637b4ca1f0fccef1eab.jpg"
      ],
      "image": "assets/images/219005/step_03.webp"
    },
    {
      "text": "Add onion and garlic to the skillet; cook and stir until onion has softened and turned translucent, about 5 minutes. Stir in tomatoes, basil, oregano, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YR8_KlvXYknAUDSpkM20gbQq5UY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219005-pork-chops-italiano-VAT-step-04-b7609dbdb32e4ce2846b3f82c90b792e.jpg"
      ],
      "image": "assets/images/219005/step_04.webp"
    },
    {
      "text": "Add pork chops and simmer until tender and no longer pink in the center, about 45 minutes, adding water if mixture becomes too dry. An instant-read thermometer inserted into the center of each pork chop should read at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qbHqVBGe4yKTsV3FakFwVhTs8VA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219005-pork-chops-italiano-VAT-step-05-20098fa607584b33b53b034abe1d1fcd.jpg"
      ],
      "image": "assets/images/219005/step_05.webp"
    },
    {
      "text": "Place a bell pepper slice on top of each pork chop. Add reserved mushrooms and continue to simmer until peppers are tender, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sEm0XEjAoQgxuE_7LKlf-1r8rdI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219005-pork-chops-italiano-VAT-step-06-55611737edd74a8fb45d1ddef7e1caa9.jpg"
      ],
      "image": "assets/images/219005/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CD6BziKMSHQuNAcu8J7m01IznAg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219005-pork-chops-italiano-VAT-Beauty-4x3-b719aafc0e6542b7875ac81088024944.jpg"
      ],
      "image": "assets/images/219005/step_07.webp"
    }
