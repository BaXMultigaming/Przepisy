  "ingredients": [
    "0.5 pound penne pasta",
    "0.5 pound lean ground beef",
    "1 (26 ounce) jar pasta sauce",
    "1 (15 ounce) container ricotta cheese",
    "8 ounces shredded mozzarella cheese, divided",
    "0.25 cup grated Parmesan cheese",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 2 1/2 quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet over medium heat, cook beef until brown; drain. Stir in pasta sauce; remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, combine ricotta, 1 cup mozzarella, Parmesan and beaten egg. Stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the prepared dish layer half the pasta, half the sauce and half the cheese mixture. Repeat. Top with remaining mozzarella.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 34 to 40 minutes, until hot and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
