  "ingredients": [
    "3 potatoes, peeled and quartered",
    "6 carrots, peeled and sliced into 1 inch pieces",
    "1 onion, chopped",
    "2 pounds boneless round steak",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "0.75 cup water",
    "1 (1 ounce) package dry onion soup mix"
  ],
  "steps": [
    {
      "text": "Place potatoes, carrots, and onion in a slow cooker. Cut steak into 6 equal pieces; place on top of vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together condensed soup, water, and onion soup mix in a medium bowl until well combined; pour over steak.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low for 7 to 10 hours.",
      "section": null,
