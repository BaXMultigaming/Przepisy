  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 cup chopped onion",
    "0.5 cup chopped green bell pepper",
    "0.5 cup chopped yellow bell pepper",
    "1 clove garlic, minced",
    "1 pound ground turkey",
    "1 (14.5 ounce) can diced tomatoes",
    "2 cups pumpkin puree",
    "1.5 tablespoons chili powder",
    "0.5 teaspoon ground black pepper",
    "1 dash salt",
    "0.5 cup shredded Cheddar cheese",
    "0.5 cup sour cream"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Add onion, green bell pepper, yellow bell pepper, and garlic; cook and stir until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in turkey and cook until evenly brown; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in tomatoes and pumpkin. Season with chili powder, pepper, and salt. Reduce heat to low, cover, and simmer 15 to 20 minutes. Serve topped with Cheddar cheese and sour cream.",
      "section": null,
      "name": null,
