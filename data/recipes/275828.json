  "ingredients": [
    "6 tablespoons butter",
    "0.25 cup all-purpose flour",
    "1 tablespoon white sugar",
    "4 eggs, beaten",
    "2 (14.75 ounce) cans creamed corn",
    "1 (15.25 ounce) can whole kernel corn, drained"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and sugar together in a bowl; add beaten eggs and beat using an electric mixer until smooth. Stir in creamed corn and whole corn. Pour mixture into melted butter in the baking dish; do not stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is browned, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
