  "ingredients": [
    "1 cup cake flour",
    "1 cup all-purpose flour",
    "0.125 cup baking powder",
    "0.5 teaspoon salt",
    "0.25 cup white sugar",
    "1.5 teaspoons brown sugar",
    "1.25 cups shortening",
    "1 egg",
    "0.25 cup cold water",
    "1.5 teaspoons vanilla extract",
    "3 teaspoons almond extract"
  ],
  "steps": [
    {
      "text": "In a large bowl, stir together the cake flour, all-purpose flour, baking powder, salt, white sugar, and brown sugar. Cut in the shortening by pinching between your fingers or using a pastry blender, until the mixture has lumps no larger than peas. In a separate bowl, whisk together the egg, water, vanilla, and almond extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the wet ingredients into the dry, and mix until the dough comes together. Divide the dough into halves, pat into a ball, and flatten slightly. Wrap each one in plastic wrap. Refrigerate for at least 4 hours, or overnight before rolling out to make a crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
