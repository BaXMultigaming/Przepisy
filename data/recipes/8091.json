  "ingredients": [
    "1 (9 ounce) package chocolate cake mix",
    "5 tablespoons all-purpose flour",
    "1.25 cups milk",
    "1 cup white sugar",
    "0.5 cup margarine",
    "1 cup shortening",
    "0.5 cup margarine",
    "1 teaspoon vanilla extract",
    "1 egg",
    "1.5 teaspoons hot water",
    "3 (1 ounce) squares unsweetened chocolate, melted",
    "1.75 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Prepare and bake cake as directed on the package for a 9 x 13 inch pan. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and milk in saucepan. Cook, stirring constantly, until thick. Cool completely. Cream 1 cup sugar, 1/2 cup margarine, and shortening. Add cooled milk mixture, and beat well. Spread over cake. Refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, beat egg. Stir in vanilla, melted chocolate, hot water, confectioner's sugar, and 1/2 cup margarine. Pour over second layer. Refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
