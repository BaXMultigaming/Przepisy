  "ingredients": [
    "4 cups confectioners' sugar",
    "3.5 cups peanut butter",
    "3.5 cups honey",
    "4 cups dry milk powder"
  ],
  "steps": [
    {
      "text": "Cream together confectioners’ sugar and peanut butter in a large bowl with an electric mixer until well combined. Beat in honey. Mix in milk powder until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 15 equal portions. Store in resealable plastic bags in the refrigerator or freezer until ready to use.",
