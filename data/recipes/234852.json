  "ingredients": [
    "1 acorn squash, halved and seeded",
    "1 cup water",
    "1 maple tea bag",
    "4 ounces kosher turkey sausage, cut into bite-size pieces",
    "1 tablespoon peanuts",
    "0.25 teaspoon vanilla extract",
    "1 tablespoon dried cranberries",
    "1.5 teaspoons golden raisins",
    "1 teaspoon light brown sugar"
  ],
  "steps": [
    {
      "text": "Place acorn squash, water, and tea bag together in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the slow cooker set to High until tender, about 1 hour. Remove squash flesh from skin and return flesh to slow cooker; discard skin and tea bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sausage, peanuts, and vanilla into squash mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the slow cooker set to High for 4 hours. Stir cranberries, raisins, and brown sugar into squash mixture until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
