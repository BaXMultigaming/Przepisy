  "ingredients": [
    "1.25 cups white sugar",
    "1 cup butter",
    "3 egg yolks",
    "1 teaspoon vanilla extract",
    "1 teaspoon orange extract",
    "5 drops yellow food coloring",
    "2 drops red food coloring",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon cream of tartar",
    "1 (12 ounce) package white chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease 2 cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and butter in a large bowl; beat with an electric mixer until creamy. Beat in egg yolks, extracts, and food coloring. Stir in flour, baking soda, and cream of tartar. Add white chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into balls and arrange on the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges turn golden, 10 to 11 minutes. Do not overbake. Cool on the cookie sheets for 1 to 2 minutes before transferring to cooling racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
