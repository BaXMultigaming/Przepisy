  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "2 teaspoons baking soda",
    "1 cup water",
    "1 cup mayonnaise",
    "2.5 tablespoons strawberry preserves",
    "1 teaspoon vanilla extract",
    "12 large fresh strawberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 12 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, sugar, and baking soda together in a large bowl; make a well in the center. Add water, mayonnaise, strawberry preserves, and vanilla extract to the well and mix until batter is just blended. Spoon batter into the prepared muffin cups. Press 1 strawberry into each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when pressed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
