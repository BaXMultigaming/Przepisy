  "ingredients": [
    "3 pounds sweet potatoes, peeled and cut into chunks",
    "1 cup packed brown sugar",
    "1 cup apricot nectar",
    "0.5 cup hot water",
    "5 teaspoons cornstarch",
    "2 teaspoons grated orange peel",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground cinnamon",
    "0.5 cup chopped pecans",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Place sweet potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain; steam dry 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, apricot nectar, water, cornstarch, orange zest, salt, and cinnamon together in a medium saucepan over medium heat; bring to a boil. Reduce heat to medium-low; cook, stirring constantly, until sauce thickens, about 2 minutes. Stir in pecans and butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer sweet potatoes to the prepared baking dish; pour apricot sauce evenly over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tender and bubbling, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
