  "ingredients": [
    "0.75 cup white sugar",
    "0.33333334326744 cup all-purpose flour",
    "0.25 teaspoon salt",
    "2 cups milk",
    "3 egg yolks, beaten",
    "2 tablespoons butter",
    "1.25 teaspoons vanilla extract",
    "1 (9 inch) baked pastry shell, cooled",
    "4 bananas, sliced"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wXP2BtAfapaXIOFaXHsVC9auD4o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12151-banana-cream-pie-ddmfs-4x3-ingredients-0729c8b16eff4a529703e2e1c72bbe55.jpg"
      ],
      "image": "assets/images/12151/step_01.webp"
    },
    {
      "text": "Combine sugar, flour, and salt in a saucepan. Gradually stir in milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8r53gYNSMI0kfHox05NQkyAqLOk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12151-banana-cream-pie-ddmfs-4x3-step-01-04049479c27d42cba2da0e3ca2cb8832.jpg"
      ],
      "image": "assets/images/12151/step_02.webp"
    },
    {
      "text": "Cook, stirring constantly, over medium heat until mixture boils and thickens. Continue to cook and stir for 2 more minutes, then remove from the heat. Place egg yolks in a medium bowl; whisk in a small amount of the hot milk mixture until smooth, then gradually whisk egg yolk mixture into the saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z6Q5Jr6UsYjE-wcATMEvWnl54R8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12151-banana-cream-pie-ddmfs-4x3-step-03-7ba1a1425cd74d928b56ffbd9fb6ad60.jpg"
      ],
      "image": "assets/images/12151/step_03.webp"
    },
    {
      "text": "Cook over medium-low heat, stirring constantly until mixture coats the back of a spoon, about 2 more minutes. Remove from heat and stir in butter and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jR1j7sRJ5EFkKhLL26L7-w6bVZI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12151-banana-cream-pie-ddmfs-4x3-step-04-043a4e519dfe444c89f17770b02569a5.jpg"
      ],
      "image": "assets/images/12151/step_04.webp"
    },
    {
      "text": "Fill pastry shell with sliced bananas; pour pudding mixture on top to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MPYotxaY7cHQ38jFNmPipktsqWk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12151-banana-cream-pie-ddmfs-4x3-step-05a-7aa2e7d1268d4f42b8ebd4c2ba5ab249.jpg"
      ],
      "image": "assets/images/12151/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until filling sets, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aEWamNNNpOl_6Nwr-uLk2bhoJ_8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12151-banana-cream-pie-ddmfs-4x3-steps-07-daa0f25debe74338b378fe7db937143d.jpg"
      ],
      "image": "assets/images/12151/step_06.webp"
    },
    {
      "text": "Let pie cool completely on a wire rack, then chill pie in the refrigerator for at least 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P_1YbN5owkhiObqGJwek5BTI4X8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12151-banana-cream-pie-ddmfs-4x3-hero-d4f7300c765e4d268bfdd6558ad55ea2.jpg"
      ],
      "image": "assets/images/12151/step_07.webp"
