  "ingredients": [
    "cooking spray",
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 cup butter, softened",
    "0.75 cup brown sugar",
    "1 (3.4 ounce) package instant vanilla pudding mix",
    "0.25 cup white sugar",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "1 (12 ounce) bag chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 10-inch springform pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and baking soda together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, pudding mix, white sugar, and vanilla extract together in a large bowl with an electric mixer. Beat in eggs. Stir in flour mixture gradually. Fold chocolate chips and walnuts into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden brown on top, about 25 minutes. Cool before cutting, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
