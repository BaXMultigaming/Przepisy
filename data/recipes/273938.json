  "ingredients": [
    "0.5 cup butter",
    "1 pound helix snails, without shells",
    "4 cloves garlic, minced",
    "1 teaspoon minced fresh parsley, or to taste",
    "0.5 cup shredded Parmesan cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter over medium-low heat in a saucepan. Add snails, garlic, and parsley; cook and stir for 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 snail along with some sauce in each cup of an escargot pan. Sprinkle tops with Parmesan cheese, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, bubbling, and lightly browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
