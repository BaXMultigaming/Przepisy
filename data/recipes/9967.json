  "ingredients": [
    "0.5 cup packed brown sugar",
    "0.5 cup white sugar",
    "0.5 cup shortening",
    "1 egg",
    "2 cups sifted all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon salt",
    "1 cup grated zucchini",
    "1 cup raisins",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together until smooth. Beat in egg. Combine flour, baking soda, salt, cinnamon, nutmeg, and cloves; stir into butter mixture. Mix in zucchini, raisins, and walnuts. Drop by rounded tablespoons onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 15 minutes. Cool on the cookie sheets for a few minutes before removing to wire racks to cool completely.",
