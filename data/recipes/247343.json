  "ingredients": [
    "8 frozen plain waffles (such as Eggo®), cut into bite-size pieces",
    "1.75 cups milk",
    "3 eggs",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread waffle pieces in the bottom of the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk, eggs, sugar, and vanilla extract together in a bowl until well-blended. Pour over waffles in the baking dish, making sure to cover them evenly. Let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center is set and edges start to brown and pull away from the sides, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
