  "ingredients": [
    "1 (16 ounce) container Greek yogurt",
    "0.5 English cucumber",
    "10 fresh mint leaves, chopped",
    "2 tablespoons roasted garlic puree",
    "2 tablespoons lemon juice",
    "2 tablespoons olive oil",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Place yogurt in a paper coffee filter, paper towels, or 4 layers of cheesecloth set in a strainer or colander set over a bowl. Strain yogurt in the refrigerator for 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel and grate cucumber; squeeze out excess water and place into a bowl. Add strained yogurt, mint, garlic purée, lemon juice, and olive oil; stir to combine. Season with salt; chill before serving.",
      "section": null,
