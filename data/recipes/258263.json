  "ingredients": [
    "1 head cauliflower, broken into florets",
    "0.25 cup butter",
    "0.25 cup all-purpose flour",
    "1.75 cups 1% milk",
    "2 ounces Parmesan cheese, grated",
    "salt and ground black pepper to taste",
    "2 ounces mature Cheddar cheese, grated"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cauliflower in a large pot and cover with water. Bring to a boil, then cook until tender yet firm to the bite, 8 to 10 minutes. Drain and transfer to a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small saucepan over low heat. Whisk in flour until smooth and mixture pulls away from the side of the saucepan, 2 to 3 minutes. Pour in milk, a little at a time, and whisk continuously until sauce is thickened but still pourable, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Parmesan cheese into sauce until melted; season with salt and pepper. Pour sauce over cauliflower and sprinkle Cheddar over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is golden brown, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
