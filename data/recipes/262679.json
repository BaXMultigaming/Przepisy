  "ingredients": [
    "0.5 baguette, cut into 1/2-inch slices",
    "0.33333334326744 cup breakfast sausage",
    "0.25 cup diced onion",
    "5 large eggs",
    "0.125 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place baguette slices on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage until browned and crumbly, 5 to 7 minutes. Transfer to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir onion in the same skillet until softened, 3 to 5 minutes. Add eggs and sausage; stir until eggs are set, about 5 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide egg mixture among baguette slices and sprinkle Cheddar cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
