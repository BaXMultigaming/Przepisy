  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup chopped pecans",
    "0.75 cup unsalted butter, melted",
    "3 cups confectioners' sugar",
    "2 (8 ounce) packages cream cheese",
    "1 cup milk",
    "2 (1.3 ounce) envelopes whipped topping mix",
    "0.5 teaspoon vanilla extract",
    "1 (21 ounce) can blueberry pie filling"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, combine flour, pecans, and butter. Press mixture into a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine confectioners’ sugar, cream cheese, milk, whipped topping mix, and vanilla. Beat at high speed using an electric mixer until smooth. Pour over baked crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill in the refrigerator. Before serving, top with blueberry pie filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
