  "ingredients": [
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.125 teaspoon ground nutmeg",
    "2 teaspoons canola oil",
    "1 teaspoon molasses",
    "0.25 cup canned pumpkin",
    "1 cup buttermilk",
    "1 large egg",
    "2 tablespoons SPLENDA® No Calorie Sweetener, Granulated",
    "1.5 cups maple syrup sweetened with SPLENDA® Brand Sweetener"
  ],
  "steps": [
    {
      "text": "Preheat waffle iron according to manufacturer's directions; spray lightly with vegetable cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, soda, salt, cinnamon, ginger, and nutmeg in a large bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil, molasses, pumpkin and buttermilk in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together egg and Splenda Granulated Sweetener until blended. Add buttermilk mixture, whisking until blended. Add to dry ingredients, stirring just until moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into a hot waffle iron and bake approximately 5 minutes*. Serve with maple syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
