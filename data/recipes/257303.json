  "keywords": [],
  "ingredients": [
    "1 cup cake flour",
    "1 teaspoon baking powder",
    "1 (11 ounce) can lychees, drained",
    "0.5 cup white sugar",
    "1 egg",
    "0.33333334326744 cup butter, melted",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cake flour and baking powder together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain lychees into a bowl, reserving canning liquid. Pat lychees dry with a paper towel; cut into small pieces. Add 3/4 of the pieces to the flour mixture; toss lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar and egg together in a bowl until sugar is dissolved, about 1 minute. Stir in 5 tablespoons of the reserved canning liquid, butter, and vanilla extract. Add flour mixture; stir batter until just moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin tin, filling each liner 3/4 full. Scatter remaining lychee pieces on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
