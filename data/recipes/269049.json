  "ingredients": [
    "1 (12 ounce) package extra-firm tofu",
    "3 tablespoons nutritional yeast",
    "2 tablespoons all-purpose flour",
    "2 teaspoons garlic powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Drain and press tofu between paper towels until fairly dry. Slice tofu into strips or 1/2-inch cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine nutritional yeast, flour, garlic powder, salt, and pepper in a resealable plastic bag. Add tofu pieces in batches and gently shake until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat. Add tofu in batches and cook, turning to brown all sides, until golden brown and lightly crispy, 4 to 6 minutes. Drain on a plate lined with a paper towel to absorb excess oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
