  "ingredients": [
    "2 cups water",
    "1.25 cups white sugar",
    "2 teaspoons cream of tartar",
    "28 buttery round crackers",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 tablespoon butter",
    "1 recipe pastry for a 9 inch double crust pie"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a 9 inch pie dish with pastry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan, combine water and sugar. Cook over high heat until boiling. Put in cream of tartar and reduce heat to simmer. Drop the crackers in, one at a time, and stir until mixture is translucent. Remove from heat and sir in cinnamon, nutmeg and butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let filling cool, then put into pie crust. Cover with top crust, seal and flute edges. Bake in the preheated oven for 60 to 75 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
