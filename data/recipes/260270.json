  "ingredients": [
    "2 apples, peeled and diced",
    "0.25 cup water",
    "1 lime, juiced",
    "1.5 teaspoons white sugar",
    "1 teaspoon ground cinnamon",
    "0.5 cup all-purpose flour",
    "0.33333334326744 cup white sugar",
    "0.25 cup rolled oats",
    "2 tablespoons rolled oats",
    "1 teaspoon ground cinnamon",
    "1 pinch salt",
    "0.25 cup butter, cubed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine apples, water, lime juice, and 1 1/2 teaspoons white sugar in a pot over medium heat. Stir until well combined. Add 1 teaspoon cinnamon and cook over medium-low heat, stirring occasionally, until apples are softened and water has evaporated, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 1/3 cup white sugar, 1/4 cup plus 2 tablespoons oats, 1 teaspoon cinnamon, and salt in a bowl. Mix in butter until crumbles form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour apple filling into a 9-inch baking dish. Sprinkle crumble mixture over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is golden brown, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
