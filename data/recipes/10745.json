      "image_sources": [
        "https://www.allrecipes.com/thmb/_cHT4NP4UmvcfVkzttLR0nySuJQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-10745-no-bake-cookies-iii-VAT-step-02-f9107905c88f443186c0d4473a26d3f0.jpg"
      ],
      "image": "assets/images/10745/step_02.webp"
    },
    {
      "text": "Add quick-cooking oats, peanut butter, and vanilla; mix well.",
      "section": null,
