  "ingredients": [
    "2 cups white sugar",
    "0.5 cup margarine",
    "0.5 cup milk",
    "3 tablespoons unsweetened cocoa powder",
    "1 pinch salt",
    "3 cups quick cooking oats",
    "0.5 cup peanut butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
