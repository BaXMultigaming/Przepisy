  "ingredients": [
    "1.5 teaspoons butter",
    "4 cups chopped cooked chicken",
    "1 cup sour cream",
    "0.5 large onion, chopped",
    "1 (10.75 ounce) can cream of chicken soup",
    "0.5 cup milk",
    "0.5 cup shredded Cheddar cheese",
    "1 (10 ounce) package refrigerated biscuit dough",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cooked chicken, sour cream, onion, cream of chicken soup, and milk in a large bowl; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until hot, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir 1/2 cup Cheddar cheese into the mixture and arrange unbaked biscuits over top of casserole. Sprinkle remaining 1/2 cup Cheddar cheese over biscuits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to oven and bake until biscuits are done in the middle and the chicken mixture is bubbling, 25 to 30 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
