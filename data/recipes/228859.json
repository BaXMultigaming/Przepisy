  "title": "Slow Cooker French Onion Soup",
  "description": "This slow cooker French onion soup is simmered until richly flavored, topped with toasted bread and a blend of cheeses, then broiled until bubbly.",
  "authors": [
    "Chandrav"
  ],
  "date_published": "2011-03-27T16:06:57-04:00",
  "date_modified": "2025-10-17T16:46:59-04:00",
