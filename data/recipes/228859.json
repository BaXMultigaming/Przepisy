    "French"
  ],
  "regions": [
    "French"
  ],
  "breadcrumbs": [],
  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "6 tablespoons butter",
    "4 large yellow onions, sliced and separated into rings",
    "1 tablespoon white sugar",
    "2 cloves garlic, minced",
    "0.5 cup cooking sherry",
    "7 cups reduced-sodium beef broth",
    "1 teaspoon sea salt, or to taste",
    "0.25 teaspoon dried thyme",
    "1 bay leaf",
    "8 slices of French bread",
    "0.5 cup shredded Gruyere cheese",
    "0.33333334326744 cup shredded Emmental cheese",
    "0.25 cup freshly shredded Parmesan cheese",
    "2 tablespoons shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aP8MStbP3N-e5K-uaQVq82pjlkY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228859-slow-cooker-french-onion-soup-Step-001-dbaa93bc64974ab4ad7d2840aea8f423.jpg"
      ],
      "image": "assets/images/228859/step_01.webp"
    },
    {
      "text": "Heat butter in a large, heavy pot over medium-high heat. Add onions; cook and stir until translucent, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M14V51zFfYejMWaj8qdT16Br6gc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228859-slow-cooker-french-onion-soup-Step-002-270504db5a994676a7e3d9ce63a2364e.jpg"
      ],
      "image": "assets/images/228859/step_02.webp"
    },
    {
      "text": "Sprinkle onions with sugar; reduce heat to medium. Cook, stirring constantly, until onions are soft and caramelized, at least 30 minutes. Stir in garlic and cook until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Th-NJP6CmPqHe2pcucgtcuCddJY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228859-slow-cooker-french-onion-soup-Step-003-f7a222f74cd848268695d36e519d084d.jpg"
      ],
      "image": "assets/images/228859/step_03.webp"
    },
    {
      "text": "Stir sherry into onion mixture; scrape the bottom to dissolve the small bits of browned food.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/unieaOFG8L86uRxlO1CpktWMLwg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228859-slow-cooker-french-onion-soup-Step-004-f729281fb9e746acbd10609e3efbee67.jpg"
      ],
      "image": "assets/images/228859/step_04.webp"
    },
    {
      "text": "Transfer onions into a slow cooker and pour in beef broth. Season with sea salt; stir in thyme and bay leaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eQKxVDEFyoTXbPTgbH3ouxR4v0Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228859-slow-cooker-french-onion-soup-Step-005-5430205025e24e19aa96881f9660da96.jpg"
      ],
      "image": "assets/images/228859/step_05.webp"
    },
    {
      "text": "Cover and cook on Low for 8 to 10 hours or on High for 4 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9MVmBP6840SCta2gs3ZUVocbT8E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228859-slow-cooker-french-onion-soup-Step-006-2-9c3a24399ddd4b418782391d1e1001fe.jpg"
      ],
      "image": "assets/images/228859/step_06.webp"
    },
    {
      "text": "Preheat the oven broiler about 10 minutes before serving. Set an oven rack about 8 inches from the heat source. Arrange bread slices on a baking sheet; broil until toasted, 1 to 2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g6SjkuiEXFxMAV_UTTycrI24J9c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228859-slow-cooker-french-onion-soup-Step-008-be7a4c1e90a247fb856279ad29e90f0e.jpg"
      ],
      "image": "assets/images/228859/step_07.webp"
    },
    {
      "text": "Lightly toss Gruyere, Emmental, Parmesan, and mozzarella cheeses in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KrOP4QcaTdQToAPvVB3xFJcHiLw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228859-slow-cooker-french-onion-soup-Step-007-94d8e799fc5647ffa81fdd9c81a23f02.jpg"
      ],
      "image": "assets/images/228859/step_08.webp"
    },
    {
      "text": "Fill oven-safe soup crocks 3/4 full with onion soup and float a bread slice in each bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E-pCCXQ4p6NcgRs4L6pg9LmNInA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228859-slow-cooker-french-onion-soup-Step-009-d3df3b8725a94cf9ac2d61264322a0dc.jpg"
      ],
      "image": "assets/images/228859/step_09.webp"
    },
    {
      "text": "Top each with about 2 tablespoons cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aFU61fKu4-mIDa2WxeJkN7IJqYI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228859-slow-cooker-french-onion-soup-Step-010-22f0084daecb419d8ddc347091f7a0b6.jpg"
      ],
      "image": "assets/images/228859/step_10.webp"
    },
    {
      "text": "Place filled bowls onto a baking sheet and broil until cheese topping is lightly browned and bubbling, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9I5dWkICYXrEHH5xls_1WLtyt_c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228859-slow-cooker-french-onion-soup-beauty-4x3-dcfa288bf60e4698a0f526f1dc980926.jpg"
      ],
      "image": "assets/images/228859/step_11.webp"
    }
  ],
