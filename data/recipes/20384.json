  "ingredients": [
    "1 cup all-purpose flour",
    "0.375 cup butter",
    "0.25 cup confectioners' sugar",
    "3 eggs",
    "1 cup white sugar",
    "0.25 cup lemon juice",
    "1 tablespoon grated lemon zest",
    "3 tablespoons all-purpose flour",
    "2 tablespoons confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Process 1 cup flour, butter, and 1/4 cup confectioners' sugar in a food processor for 10 seconds, or blend with a pastry blender until a dough forms. Pat dough evenly into a 9-inch round pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While crust bakes, combine eggs, white sugar, lemon juice, lemon zest, and 3 tablespoons flour; mix until smooth. Pour egg mixture over hot crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm, 15 to 20 minutes more. Let cool completely in pie dish, about 1 to 2 hours. Sprinkle with 2 tablespoons confectioners' sugar and cut into 12 triangles.",
      "section": null,
      "name": null,
      "url": null,
