  "ingredients": [
    "1 cup cornflakes, lightly crushed",
    "1 cup crispy rice cereal",
    "1 cup rolled oats",
    "4 cups all-purpose flour",
    "1 tablespoon baking soda",
    "1 cup unsalted butter, softened",
    "1 cup canola oil",
    "1 cup white sugar",
    "1 cup brown sugar",
    "1 large egg",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornflakes, rice cereal, and oats in a large bowl. Whisk flour and baking soda together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, oil, and both sugars in a very large bowl until smooth. Add egg and vanilla; beat until smooth. Slowly mix in flour mixture. Stir in cereal mixture by hand.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoonfuls of dough 2 inches apart onto the prepared baking sheets. Flatten balls with the bottom of a glass for even cooking and crispier cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in batches in the preheated oven until edges are golden, 10 to 12 minutes. Cool on the baking sheet for 1 minute before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
