  "ingredients": [
    "4 cups chopped cauliflower",
    "2 cups water",
    "1 (8 ounce) package processed American cheese spread",
    "1 (8 ounce) package cream cheese, cubed",
    "0.5 cup dry potato flakes",
    "1.5 teaspoons garlic, minced",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine cauliflower and water in a saucepan over medium-high heat and bring to a boil. Remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a slow cooker on Low. Pour in cauliflower and water. Add processed American cheese spread and cream cheese; stir well to be sure cheese is dissolved and mixed through the cauliflower. Add potato flakes and garlic. Mix well. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the slow cooker and cook on Low for 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
