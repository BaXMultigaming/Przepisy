  "ingredients": [
    "1.25 cups applesauce",
    "1 cup white sugar",
    "0.5 cup vegetable oil",
    "2 large eggs",
    "3 tablespoons milk",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon salt",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine applesauce, sugar, oil, eggs, and milk in a large bowl; beat well. Sift in flour, baking soda, baking powder, cinnamon, nutmeg, allspice, and salt; stir until smooth. Fold in pecans. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the loaf comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
