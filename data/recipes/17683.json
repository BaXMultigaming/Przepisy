  "title": "Spiced Applesauce Bread",
  "description": "This moist applesauce bread is an easy-to-make quick bread with chopped pecans and warm fall spices like cinnamon, nutmeg, and allspice.",
  "authors": [
    "LOUISE"
  ],
  "date_published": "1999-11-03T16:01:49-05:00",
