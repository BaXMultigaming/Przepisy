  "ingredients": [
    "6 skinless, boneless chicken breast halves",
    "2 (11 ounce) cans condensed cream of Cheddar cheese soup",
    "0.5 cup milk",
    "salt and pepper to taste",
    "1 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Spray slow cooker with cooking spray. Place chicken breasts inside. Mix soup and milk together in a medium bowl; pour mixture over chicken. Season with salt and pepper to taste and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for about 6 hours. An instant-read thermometer inserted into the chicken should read 165 degrees F (74 degrees C).",
