  "ingredients": [
    "2 pounds spicy Portuguese sausage, sliced",
    "1 pound ham hocks",
    "1 onion, sliced",
    "2 quarts water",
    "2 carrots, diced",
    "3 potatoes, diced",
    "1 small head cabbage, chopped",
    "1 (8 ounce) can tomato sauce",
    "2 (15 ounce) cans kidney beans",
    "1 (16 ounce) package macaroni"
  ],
