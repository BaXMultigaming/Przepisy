  "ingredients": [
    "1 (12 ounce) package uncooked egg noodles",
    "1 pound lean ground beef",
    "1 large onion, diced",
    "1 (15 ounce) can tomato sauce",
    "4 ounces cream cheese",
    "12 ounces cottage cheese",
    "1 (8 ounce) container sour cream",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook egg noodles according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While noodles are cooking, brown the ground beef and onion in a large skillet over medium high heat. Reduce heat to low, add the tomato sauce, stir well, and let simmer for 1 minute. Add the cream cheese and cottage cheese, stirring together until well blended. Then stir in the egg noodles and sour cream until all ingredients are well mixed. Pour into a 2 quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 30 minutes. Season with salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
