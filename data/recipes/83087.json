  "ingredients": [
    "15 ounces dried soba noodles",
    "0.33333334326744 cup rice vinegar",
    "0.33333334326744 cup soy sauce",
    "1 lime, zested and juiced",
    "1.5 teaspoons dark sesame oil",
    "2 tablespoons brown sugar",
    "2 cloves garlic, minced",
    "2 teaspoons red pepper flakes, or to taste",
    "1 cup finely grated carrot",
    "0.5 cup chopped fresh cilantro",
    "0.25 cup coarsely chopped salted peanuts"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil. Cook soba noodles in boiling water until tender, about 5 minutes. Drain noodles in a colander, rinse with cold water, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour rice vinegar, soy sauce, lime juice, and sesame oil into a large bowl. Mix in brown sugar, lime zest, garlic, and red pepper flakes; stir until sugar dissolves. Toss in carrot, cilantro, and peanuts until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut noodles into 3-inch lengths. Stir into carrot mixture. Cover the bowl and refrigerate for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss salad again before serving. If dry, splash with soy sauce and rice vinegar. Serve cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
