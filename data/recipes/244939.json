  "ingredients": [
    "1 cup chocolate-flavored almond milk",
    "0.75 cup old-fashioned rolled oats (such a Quaker®)",
    "1 tablespoon chia seeds",
    "1 tablespoon packed shredded sweetened coconut",
    "1 tablespoon maple syrup",
    "1 tablespoon unsweetened cocoa powder",
    "1 splash vanilla extract"
  ],
  "steps": [
    {
      "text": "Mix almond milk, oats, chia seeds, coconut, maple syrup, cocoa powder, and vanilla extract in a 12-ounce mason jar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate, 8 hours to overnight. Stir and serve cold.",
      "section": null,
