  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "0.25 cup olive oil",
    "4 large cloves garlic, pressed",
    "2 tablespoons fresh lemon juice",
    "2 tablespoons fresh lemon zest",
    "1 tablespoon dried oregano",
    "0.75 teaspoon salt",
    "0.5 teaspoon coarsely ground black pepper",
    "8 baby red potatoes, halved",
    "1 red bell pepper, cut into 1-inch wide strips",
    "1 red onion, cut into 1-inch wedges",
    "1 lemon, thinly sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place chicken breasts into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, garlic, lemon juice, lemon zest, oregano, salt, and pepper together in a bowl. Brush some of the mixture onto chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes, bell pepper, onion, and lemon slices into a bowl; pour in remaining lemon juice mixture and toss to coat. Arrange vegetables and lemon slices around chicken in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Brush chicken and vegetables with the pan drippings. Continue to bake until chicken is browned, the juices run clear, and an instant-read meat thermometer inserted into the thickest part of a breast reads at least 165 degrees F (74 degrees C), about 30 more minutes.",
      "section": null,
