  "ingredients": [
    "cooking spray",
    "2 cups old-fashioned oats",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "2 large eggs, lightly beaten",
    "0.5 cup light coconut milk",
    "0.33333334326744 cup melted butter",
    "0.33333334326744 cup low-fat vanilla Greek yogurt",
    "0.25 cup honey",
    "0.5 teaspoon vanilla extract",
    "1 (8 ounce) can crushed pineapple, drained",
    "0.5 cup shredded coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray an 8-inch square dish with cooking spray and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, baking powder, salt, and baking soda in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, coconut milk, butter, yogurt, honey, and vanilla extract together in a separate bowl. Pour over the oats and stir until well combined. Fold in pineapple and coconut. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until oatmeal has firmed up but not drying out, 25 to 30 minutes. Remove from the oven. Let cool for about 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
