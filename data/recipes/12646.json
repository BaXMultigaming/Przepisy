  "ingredients": [
    "1 (9 inch) deep dish pie crust",
    "3 vine-ripened tomatoes",
    "1 small onion",
    "0.25 cup chopped green bell pepper",
    "0.75 cup mayonnaise",
    "0.5 cup shredded sharp Cheddar cheese",
    "0.5 cup shredded mozzarella cheese",
    "3 slices bacon",
    "2 slices bacon, for topping"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake the pie shell for 9 to 10 minutes or until browned. Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut the tomatoes into bite size pieces, dice the onion and the green bell pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix the mayonnaise, cheeses, vegetables and bacon. Spoon into the baked pie shell. Top with additional crumbled bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F for 25 minutes or until edges brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
