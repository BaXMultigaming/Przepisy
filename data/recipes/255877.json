  "ingredients": [
    "2 cups Quick Quaker® Oats, uncooked",
    "0.33333334326744 cup white sugar",
    "3.3333332538605 cups fat-free milk",
    "0.5 cup egg substitute with yolk",
    "2 teaspoons vanilla extract",
    "0.33333334326744 cup firmly packed brown sugar"
  ],
  "steps": [
    {
      "text": "Heat oven to 350 degrees F. Spray 8-inch square oven-safe baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large bowl, combine oats and granulated sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In medium bowl, combine milk, egg substitute and vanilla; mix well. Add to oat mixture; mix well. Pour into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 40 to 45 minutes or until center jiggles slightly. Remove from oven to cooling rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle brown sugar evenly over top of oatmeal. Using back of spoon, gently spread sugar into a thin layer across entire surface of oatmeal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to oven; bake just until sugar melts, about 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set oven to broil. Broil 3 inches from heat until sugar bubbles and browns slightly, 1 to 2 minutes. (Watch carefully to prevent burning. It may be necessary to turn baking dish.) Spoon into bowls to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
