  "ingredients": [
    "2 oranges",
    "8 whole cloves",
    "6 cups apple juice",
    "1 cinnamon stick",
    "2.25 cups pineapple juice",
    "0.25 cup honey",
    "3 tablespoons lemon juice",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stud oranges with cloves; place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine apple juice and cinnamon stick in a large saucepan; bring to a boil. Reduce heat to medium; simmer for 5 minutes. Off heat, stir in pineapple juice, honey, lemon juice, and nutmeg until honey is dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve hot in a punch bowl with clove-studded baked oranges floating on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
