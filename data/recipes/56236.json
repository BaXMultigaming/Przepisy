  "ingredients": [
    "2 eggs",
    "1 cup milk",
    "1 cup all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons onion salt",
    "1 quart vegetable oil for frying",
    "4 large onions, peeled and sliced into rings"
  ],
  "steps": [
    {
      "text": "Whisk together eggs, milk, flour, baking powder, and onion salt in a bowl to make a smooth batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the oil in a large saucepan or deep fryer until a thermometer reads 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip the onion rings evenly into the batter, then fry in the oil for 2 to 3 minutes, working in batches if necessary, until the onion rings are golden brown. With a slotted spoon, remove the onion rings to paper towels to drain. Serve hot.",
