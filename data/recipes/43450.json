  "ingredients": [
    "1 small head cabbage, thinly sliced",
    "1 teaspoon white sugar",
    "6 slices bacon",
    "5 tablespoons corn bread mix",
    "0.25 teaspoon cayenne pepper",
    "0.5 cup chopped onion",
    "2 fresh jalapeno peppers, seeded and julienned",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Put cabbage into a large strainer. Sprinkle sugar over cabbage to draw out excess water. Meanwhile, place bacon in a large skillet. Cook over medium-high heat until evenly brown. Drain, crumble, and set aside, reserving grease in skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cabbage to a large bowl. In a small bowl, stir together cornbread mix and cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion and jalapeño to the skillet and sauté until tender. Add cabbage, cornbread mixture, and season with salt and pepper to taste. Cook until cabbage wilts, about 15 minutes. Stir in crumbled bacon, and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
