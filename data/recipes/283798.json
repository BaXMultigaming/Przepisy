  "ingredients": [
    "1 cup white sugar",
    "0.5 cup soy sauce",
    "0.5 cup water",
    "0.25 cup minced onion",
    "2 tablespoons minced garlic",
    "0.5 teaspoon black pepper",
    "0.5 teaspoon sesame oil",
    "4 pounds boneless, skinless chicken thighs"
  ],
  "steps": [
    {
      "text": "Combine sugar, soy sauce, water, onion, garlic, pepper, and sesame oil in a blender; process until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put chicken into a large glass or ceramic bowl. Pour marinade over top and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for 12 to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from the marinade and shake off excess. Discard the remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook chicken on the preheated grill until slightly crisp on the outside, no longer pink in the center, and the juices run clear, about 4 to 8 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
