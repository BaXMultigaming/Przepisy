  "ingredients": [
    "1 (2 pound) loaf processed cheese, cubed",
    "1 cup milk",
    "1 (12 ounce) package ground pork sausage",
    "1 white onion, chopped",
    "1 (24 ounce) jar medium salsa",
    "0.5 (15 ounce) can black beans, drained and rinsed",
    "1 bunch green onions, chopped",
    "1 (12 ounce) package tortilla chips"
  ],
  "steps": [
    {
      "text": "In a slow cooker set to high heat, place the processed cheese and milk. Cover and, stirring occasionally, cook until the cheese has melted and is well blended with the milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ground pork sausage in a medium skillet. Cook over medium high heat until evenly brown. Mix in white onion. Cook and stir until onion is translucent. Remove from heat and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sausage mixture into the cheese mixture. Reduce heat to low. Mix in salsa and black beans. Continue cooking, stirring occasionally, approximately 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with green onions and serve with tortilla chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
