  "ingredients": [
    "0.75 cup plain bread crumbs",
    "0.5 cup milk",
    "2 eggs",
    "1 large onion, grated",
    "1 tablespoon grated fresh ginger",
    "1 tablespoon salt",
    "2 teaspoons ground nutmeg",
    "2 teaspoons minced garlic",
    "1.5 teaspoons ground black pepper",
    "3 pounds 85% lean ground beef",
    "3 tablespoons butter",
    "2 tablespoons minced onion",
    "5 tablespoons all-purpose flour",
    "4 cups beef broth",
    "0.5 cup heavy cream",
    "1 dash cayenne pepper",
    "1 dash white pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a jelly roll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs, milk, eggs, onion, ginger, salt, nutmeg, garlic, and black pepper in a mixing bowl. Let stand until bread crumbs absorb milk, about 5 minutes. Stir until just mixed and add ground beef. Mix until well blended. Shape mixture into 1-inch meatballs and place on the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned, about 18 minutes. Set meatballs aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium-high heat. Sauté onion until tender, about 3 minutes. Stir in flour and cook until lightly browned, about 2 minutes. Slowly add broth; cook and stir gravy until smooth and thickened, 5 to 10 minutes. Blend in cream, cayenne pepper, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently stir cooked meatballs into gravy and heat through, but do not boil, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
