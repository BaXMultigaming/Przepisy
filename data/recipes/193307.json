  "ingredients": [
    "1 cup sweetened red bean paste",
    "1 cup glutinous rice flour",
    "1 teaspoon green tea powder (matcha)",
    "1 cup water",
    "0.25 cup white sugar",
    "0.5 cup cornstarch, for rolling out the dough"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SRbHGddHM3ujF13dghaG1d8LiAU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/193307-Easy-Mochi-DDMFS-Step1-11942-90845dc2eee344d991ff916bb0fc173f.jpg"
      ],
      "image": "assets/images/193307/step_01.webp"
    },
    {
      "text": "Wrap red bean paste in aluminum foil and place in the freezer until solid, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BlRbeP5N5shr5IwGnOqqflQ7zYk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/193307-easy-mochi-step-2-158-4ec87d9dbabc4c4bafe4a547a84c41ea.jpg"
      ],
      "image": "assets/images/193307/step_02.webp"
    },
    {
      "text": "Mix glutinous rice flour and green tea powder thoroughly in a microwave-safe bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lbHqlSk7kSaT1BCC1OtPUHJUfL4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/193307-easy-mochi-step-3-159-f4ccf32b2e784bba8627d8d187ff41a8.jpg"
      ],
      "image": "assets/images/193307/step_03.webp"
    },
    {
      "text": "Stir in water, then sugar; mix until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EU8nYm5pCybNBDYCGa1uuJzoiT8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/193307-easy-mochi-step-4-165-31ee5f87ae8742fc89a019d7d93dd98d.jpg"
      ],
      "image": "assets/images/193307/step_04.webp"
    },
    {
      "text": "Cover the bowl with plastic wrap and microwave for 3 minutes 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, remove red bean paste from the freezer and divide into 8 equal balls. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zy2d_mn7eUmRThWGEtS6_N1Plxk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/193307-easy-mochi-step-5-168-053590c17716439793df14f4e8afe997.jpg"
      ],
      "image": "assets/images/193307/step_06.webp"
    },
    {
      "text": "Remove rice flour mixture from the microwave. Stir and heat, covered, for another 15 to 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l9d5y7zZHdFhRGUJ5s9EHG_MTi8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/193307-easy-mochi-step-6-169-64d11806981c49b1b4aa2cf988beeffe.jpg"
      ],
      "image": "assets/images/193307/step_07.webp"
    },
    {
      "text": "Dust a work surface with cornstarch. Roll about 2 tablespoons of hot rice flour mixture into a ball. Flatten the ball and place one ball of frozen red bean paste in the center. Pinch and press the dough around the bean paste until completely covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BNmEmAXkh7-_9kbWFygkk_ZEld4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/193307-easy-mochi-step-7-173-83183060d7924d838e2c824bcb906cfc.jpg"
      ],
      "image": "assets/images/193307/step_08.webp"
    },
    {
      "text": "Sprinkle with additional cornstarch and place mochi, seam-side down, in a paper muffin liner to prevent sticking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HUVkOYb5AjJI1pLtqXZxSwZu7g0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/193307-easy-mochi-step-8-178-cdbf0a998a464876984b6fa205f8d172.jpg"
      ],
      "image": "assets/images/193307/step_09.webp"
    },
    {
      "text": "Repeat Step 6 to make remaining mochi.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R5cy23AxrgxUAAFdMbPEq3gI7Q4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/193307-easy-mochi-DDMFS-4x3-d68e2c5a886b42ce9c91f83a6abd9298.jpg"
      ],
      "image": "assets/images/193307/step_11.webp"
    }
  ],
