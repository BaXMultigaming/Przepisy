  "ingredients": [
    "1.5 pounds lean ground beef",
    "1 large onion, minced",
    "0.125 teaspoon beef bouillon granules",
    "4 cups water to cover",
    "2 tablespoons cornstarch",
    "0.25 cup water",
    "1 recipe pastry for a 9 inch double crust pie"
  ],
  "steps": [
    {
      "text": "Place the ground beef in a large pot and pour in enough water to cover beef. Boil until beef is cooked through. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add water to cover cooked beef, add onions and enough bouillon granules to taste. Cook until the onions are soft. Season with salt and pepper to your taste and make sure the filling has enough bouillon to have a nice beef flavor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the 1/4 cup water with the cornstarch and stir until smooth. Add to the beef mixture and cook until mixture has thickened. Allow to cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out pastry to fit a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour beef mixture into the pastry crust and cover the top with pastry. Crimp edges and prick top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until pie crust is lightly browned, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
