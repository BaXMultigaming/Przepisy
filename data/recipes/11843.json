  "ingredients": [
    "2 (10.75 ounce) cans condensed cream of chicken soup",
    "3 cups water",
    "1 cup chopped celery",
    "2 onions, quartered",
    "1 teaspoon salt",
    "0.5 teaspoon poultry seasoning",
    "0.5 teaspoon ground black pepper",
    "4 skinless, boneless chicken breast halves",
    "5 carrots, sliced",
    "1 (10 ounce) package frozen green peas",
    "4 potatoes, quartered",
    "3 cups baking mix",
    "1.3333333730698 cups milk"
  ],
  "steps": [
    {
      "text": "Combine soup, water, chicken, celery, onion, salt, poultry seasoning, and pepper in a large, heavy pot. Cover and cook over low heat for 1 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add potatoes and carrots; cover and cook for another 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from pot, shred it, and return to pot. Add peas and cook only 5 minutes longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add dumplings. To make dumplings: Mix baking mix and milk until a soft dough forms. Drop by tablespoonfuls onto boiling stew. Simmer covered for 10 minutes, then uncover and simmer an additional 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
