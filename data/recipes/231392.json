  "ingredients": [
    "0.75 cup whole wheat flour",
    "0.25 cup almond meal",
    "0.25 cup old-fashioned oats",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1 egg, beaten",
    "1 cup milk",
    "1 ripe banana, mashed",
    "1 tablespoon canola oil"
  ],
  "steps": [
    {
      "text": "Preheat griddle to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix whole wheat flour, almond meal, oats, baking powder, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat an egg in a separate bowl. Beat milk, banana, and canola oil into the beaten egg; pour into flour mixture and stir until just combined into a lumpy batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter 1/2-cupful at a time onto the hot griddle; cook until edges become crisp and bubbles have formed on the top, 3 to 5 minutes. Flip the pancakes and continue cooking until the bottom of the pancakes are browned, 3 to 5 minutes more.",
      "section": null,
