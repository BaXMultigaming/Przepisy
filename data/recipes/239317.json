  "ingredients": [
    "6 tablespoons peanut butter",
    "6 tablespoons mixed berry jam",
    "12 slices challah bread",
    "1 cup milk",
    "4 eggs",
    "0.25 cup white sugar",
    "2 tablespoons raspberry-flavored liqueur",
    "0.5 teaspoon vanilla extract",
    "1 tablespoon vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Spread 1 tablespoon peanut butter and 1 tablespoon jam each onto one side of 6 bread slices; top each with 1 bread slice to make 6 sandwiches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, eggs, sugar, raspberry liqueur, and vanilla extract together in a bowl until smooth. Dip each sandwich into egg mixture, turning to coat both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat; cook sandwiches, working in batches, until golden brown, 3 to 4 minutes per side.",
      "section": null,
