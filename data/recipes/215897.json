  "ingredients": [
    "1 (8 ounce) package elbow macaroni",
    "2 cups cucumber, peeled and thinly sliced",
    "2 cups diced tomato",
    "2 (5 ounce) cans tuna, drained",
    "0.5 cup diced green bell pepper",
    "0.33333334326744 cup mayonnaise",
    "0.33333334326744 cup Italian-style salad dressing",
    "0.25 cup chopped green onion",
    "1 hard-boiled egg, chopped",
    "1 tablespoon prepared yellow mustard",
    "1 teaspoon salt",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain, rinse with cold water; drain again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cucumber, tomato, tuna, bell pepper, mayonnaise, dressing, green onion, egg, mustard, salt, and black pepper in a large bowl; stir in macaroni. Cover the bowl; chill in the refrigerator before serving, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
